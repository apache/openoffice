load("@rules_java//java:defs.bzl", "java_library")

package(default_visibility = ["//visibility:public"])

# Apache Lucene 2.9.4 — the full-text index behind the office help's search.
# Used twice: at BUILD time by HelpIndexerTool (//main/l10ntools), which writes
# each help module's .idxl index, and at RUN time by LuceneHelpWrapper.jar
# (//main/xmlhelp), which searches it.  Upstream: ext_libraries/modules/lucene
# (dmake), Ant over contrib/analyzers/build.xml, producing the two jars below.
#
# Patches: only long_path.patch changes behaviour — FSDirectory skips
# getCanonicalPath() for \\?\ long paths, which throws on Windows.  It is
# applied here (regenerated byte-exact as patches/aoo-lucene-long-path.patch;
# see the bzlmod patch landmines in .agent).  lucene.patch (drop the svnversion
# stamp) and lucene-java-version.patch (javac source/target 1.4 -> 1.6) touch
# only the Ant build, which this replaces.
#
# Encoding: Lucene's own build declares utf-8 and every source is valid UTF-8,
# so — unlike saxon — nothing needs transcoding.

_JAVACOPTS = ["--release", "8", "-nowarn", "-XepDisableAllChecks"]

# LICENSE/NOTICE go into META-INF of BOTH jars, as Lucene's jar task does.  A
# resource-only library, merged into each jar by the consumer's uno_jar,
# because one java_library cannot take resources under two strip prefixes.
genrule(
    name = "meta_inf_legal",
    srcs = ["LICENSE.txt", "NOTICE.txt"],
    outs = ["legal/META-INF/LICENSE.txt", "legal/META-INF/NOTICE.txt"],
    cmd = "cp $(location LICENSE.txt) $(location legal/META-INF/LICENSE.txt) && " +
          "cp $(location NOTICE.txt) $(location legal/META-INF/NOTICE.txt)",
)

java_library(
    name = "lucene_legal",
    resources = [":meta_inf_legal"],
    resource_strip_prefix = "legal",
)

java_library(
    name = "lucene_core",
    srcs = glob(["src/java/**/*.java"]),
    javacopts = _JAVACOPTS,
)

java_library(
    name = "lucene_analyzers",
    srcs = glob(["contrib/analyzers/common/src/java/**/*.java"]),
    resources = glob(["contrib/analyzers/common/src/resources/**"]),
    resource_strip_prefix = "contrib/analyzers/common/src/resources",
    javacopts = _JAVACOPTS,
    deps = [":lucene_core"],
)
