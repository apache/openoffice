# ── freebl3.dll ──────────────────────────────────────────────────────────────
# Pure-C build; x86 hardware-AES asm is excluded for simplicity.

cc_binary(
    name = "freebl3",
    srcs = [
        # hashes
        "nss/lib/freebl/md2.c",
        "nss/lib/freebl/md5.c",
        "nss/lib/freebl/sha512.c",
        "nss/lib/freebl/sha_fast.c",
        "nss/lib/freebl/alghmac.c",
        "nss/lib/freebl/rawhash.c",
        "nss/lib/freebl/hmacct.c",
        "nss/lib/freebl/blake2b.c",
        # symmetric ciphers
        "nss/lib/freebl/arcfour.c",
        "nss/lib/freebl/arcfive.c",
        "nss/lib/freebl/des.c",
        "nss/lib/freebl/desblapi.c",
        "nss/lib/freebl/rijndael.c",
        # rijndael_tables.c is textually #include'd by rijndael.c when RIJNDAEL_INCLUDE_TABLES is set
        "nss/lib/freebl/camellia.c",
        "nss/lib/freebl/seed.c",
        "nss/lib/freebl/alg2268.c",
        # block modes / AEAD
        "nss/lib/freebl/ctr.c",
        "nss/lib/freebl/cts.c",
        "nss/lib/freebl/gcm.c",
        "nss/lib/freebl/chacha20poly1305.c",
        "nss/lib/freebl/aeskeywrap.c",
        # asymmetric
        "nss/lib/freebl/rsa.c",
        "nss/lib/freebl/rsapkcs.c",
        "nss/lib/freebl/dsa.c",
        "nss/lib/freebl/dh.c",
        "nss/lib/freebl/ec.c",
        "nss/lib/freebl/ecdecode.c",
        "nss/lib/freebl/pqg.c",
        "nss/lib/freebl/jpake.c",
        # ECL
        "nss/lib/freebl/ecl/ecl.c",
        "nss/lib/freebl/ecl/ecl_mult.c",
        "nss/lib/freebl/ecl/ecl_gf.c",
        "nss/lib/freebl/ecl/ec_naf.c",
        "nss/lib/freebl/ecl/ecp_aff.c",
        "nss/lib/freebl/ecl/ecp_jac.c",
        "nss/lib/freebl/ecl/ecp_jm.c",
        "nss/lib/freebl/ecl/ecp_mont.c",
        "nss/lib/freebl/ecl/ecp_256.c",
        "nss/lib/freebl/ecl/ecp_256_32.c",
        "nss/lib/freebl/ecl/ecp_384.c",
        "nss/lib/freebl/ecl/ecp_521.c",
        "nss/lib/freebl/ecl/ecp_25519.c",
        "nss/lib/freebl/ecl/curve25519_32.c",
        # MPI (portable C; skip mpi_amd64.c, mpi_arm.c, mpi_sparc.c, mpi_x86_asm.c)
        "nss/lib/freebl/mpi/mpi.c",
        "nss/lib/freebl/mpi/mplogic.c",
        "nss/lib/freebl/mpi/mpmontg.c",
        "nss/lib/freebl/mpi/mpprime.c",  # includes primes.c internally
        "nss/lib/freebl/mpi/mp_gf2m.c",
        "nss/lib/freebl/mpi/mpcpucache.c",
        "nss/lib/freebl/mpi/montmulf.c",
        # mulsqr.c has a standalone main() at line 19; excluded like mp_comba.c
        # mp_comba.c is AMD64 GCC inline asm only; not usable with MSVC/x86
        # RNG / DRBG
        "nss/lib/freebl/sysrand.c",
        # win_rand.c is #include'd by sysrand.c; listing it separately causes duplicate RNG symbols
        # det_rng.c: C99 mixed-decl + Hacl_Chacha20 dep; not in gyp build
        "nss/lib/freebl/drbg.c",
        # TLS / misc crypto
        "nss/lib/freebl/tlsprfalg.c",
        "nss/lib/freebl/crypto_primitives.c",
        # verified implementations (Hacl*)
        "nss/lib/freebl/verified/FStar.c",
        "nss/lib/freebl/verified/Hacl_Chacha20.c",
        "nss/lib/freebl/verified/Hacl_Chacha20_Vec128.c",  # scalar fallback via vec128.h; no SSSE3 needed
        "nss/lib/freebl/verified/Hacl_Poly1305_32.c",
        "nss/lib/freebl/verified/Hacl_Curve25519.c",
        # library infrastructure
        "nss/lib/freebl/blinit.c",
        "nss/lib/freebl/blname.c",
        "nss/lib/freebl/fipsfreebl.c",
        "nss/lib/freebl/freeblver.c",
        "nss/lib/freebl/nsslowhash.c",
        "nss/lib/freebl/shvfy.c",
        # stubs.c is POSIX-only (unistd.h/dlfcn.h); not needed on Windows
        "nss/lib/freebl/ldvector.c",
    ],
    copts = WIN_COPTS + FREEBL_INCLUDES,
    defines = WIN_DEFINES + [
        "FREEBL_LOWHASH",
        "NSS_ENABLE_ECC",
        "RIJNDAEL_INCLUDE_TABLES",
        "MP_API_COMPATIBLE",
        # NSS_X86_OR_X64 / NSS_X86 intentionally omitted: those defines pull in
        # extern declarations for hw AES-NI / CLMUL / ChaCha20-Vec128 symbols that
        # live in assembly files we don't compile.  MPI digit-width is set
        # explicitly via MP_USE_UINT_DIGIT below.
        "MP_CHAR_STORE_SLOW",
        "MP_USE_UINT_DIGIT",
        "KRML_NOUINT128",  # MSVC has no __int128; use FStar struct emulation
        "USE_UTIL_DIRECTLY",  # resolves PORT_*/SECITEM_*/SECOID_* via nssutil rename scheme
        "SHLIB_PREFIX=",
        "SHLIB_VERSION=\\\"3\\\"",
        "SHLIB_SUFFIX=\\\"dll\\\"",
    ],
    linkshared = True,
    win_def_file = "nss/lib/freebl/freebl.def",
    additional_linker_inputs = [
        ":nspr4_implib",
        ":nssutil3_implib",
    ],
    linkopts = [
        "$(execpath :nspr4_implib)",
        "$(execpath :nssutil3_implib)",
        "advapi32.lib",
        "/MANIFEST:NO",
    ],
)

filegroup(name = "freebl3_implib", srcs = [":freebl3"], output_group = "interface_library")

# ── freebl_loader (static) ────────────────────────────────────────────────────
# loader.c provides all freebl API wrappers (SHA*, AES*, BL_Init, HMAC_*, …)
# via vector dispatch: it dlopen's freebl3.dll at runtime via FREEBL_GetVector.
# softokn3 and nss3 link this object directly instead of against freebl3.if.lib.

cc_library(
    name = "freebl_loader",
    srcs = ["nss/lib/freebl/loader.c"],
    copts = WIN_COPTS + FREEBL_INCLUDES,
    defines = WIN_DEFINES + [
        "FREEBL_LOWHASH",
        "USE_UTIL_DIRECTLY",
        "SHLIB_PREFIX=",
        "SHLIB_VERSION=\\\"3\\\"",
        "SHLIB_SUFFIX=\\\"dll\\\"",
        "SOFTOKEN_SHLIB_VERSION=\\\"3\\\"",
    ],
)

# ── softokn3.dll ─────────────────────────────────────────────────────────────

cc_binary(
    name = "softokn3",
    srcs = [
        "nss/lib/softoken/fipsaudt.c",
        "nss/lib/softoken/fipstest.c",
        "nss/lib/softoken/fipstokn.c",
        "nss/lib/softoken/jpakesftk.c",
        "nss/lib/softoken/lgglue.c",
        "nss/lib/softoken/lowkey.c",
        "nss/lib/softoken/lowpbe.c",
        "nss/lib/softoken/padbuf.c",
        "nss/lib/softoken/pkcs11.c",
        "nss/lib/softoken/pkcs11c.c",
        "nss/lib/softoken/pkcs11u.c",
        "nss/lib/softoken/sdb.c",
        "nss/lib/softoken/sftkdb.c",
        "nss/lib/softoken/sftkhmac.c",
        "nss/lib/softoken/sftkpars.c",
        "nss/lib/softoken/sftkpwd.c",
        "nss/lib/softoken/softkver.c",
        "nss/lib/softoken/tlsprf.c",
        # bundled SQLite3
        "nss/lib/sqlite/sqlite3.c",
    ],
    copts = WIN_COPTS + SOFTOKN_INCLUDES + [
        "/Zm500",  # SQLite3 is large; raise compiler heap limit
    ],
    defines = WIN_DEFINES + [
        'SHLIB_SUFFIX=\\"dll\\"',
        'SHLIB_PREFIX=\\"\\\"',
        'SHLIB_VERSION=\\"3\\"',
        'SOFTOKEN_LIB_NAME=\\"softokn3.dll\\"',
        "USE_UTIL_DIRECTLY",
        "FREEBL_LOWHASH",
        "NSS_ENABLE_ECC",
        # SQLite compile-time options
        "SQLITE_NO_SYNC",
        "SQLITE_OMIT_TRACE",
        "SQLITE_OMIT_DEPRECATED",
        "SQLITE_OMIT_LOOKASIDE",
        "SQLITE_OS_WIN=1",
        "SQLITE_TEMP_STORE=1",
    ],
    linkshared = True,
    win_def_file = "nss/lib/softoken/softokn.def",
    deps = [":freebl_loader"],
    additional_linker_inputs = [
        ":nspr4_implib",
        ":plds4_implib",
        ":plc4_implib",
        ":nssutil3_implib",
        # freebl3 is loaded at runtime by loader.c; no .if.lib needed at link time
    ],
    linkopts = [
        "$(execpath :nspr4_implib)",
        "$(execpath :plds4_implib)",
        "$(execpath :plc4_implib)",
        "$(execpath :nssutil3_implib)",
        "/MANIFEST:NO",
    ],
)

