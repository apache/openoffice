load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

# ── Common flags ─────────────────────────────────────────────────────────────

WIN_DEFINES = [
    "WIN32",
    "_WIN32_WINNT=0x0501",
    "WINNT",
    "XP_WIN",
    "XP_WIN32",
    "_WINDOWS",
    "NDEBUG",
    "_USRDLL",
    "IEEE_8087",   # x86/x64 little-endian IEEE 754; required by nspr/dtoa.c
]

WIN_COPTS = [
    "/W3",
    "/wd4996", "/wd4244", "/wd4267", "/wd4018", "/wd4090", "/wd4028",
    "/wd4005",  # macro redefinition
    "/wd4133",  # incompatible pointer types
    "/wd4057",  # pointer target type mismatch
    "/wd4117",
]

# Canonical external-repo root path.
# includes= on cc_binary does NOT prepend external/<repo>/ automatically;
# copts must use full execroot-relative paths instead.
_R = "external/nss+"

NSPR_INCLUDES = [
    "/I" + _R + "/nspr/pr/src",
    "/I" + _R + "/nspr/pr/include",
    "/I" + _R + "/nspr/pr/include/md",
    "/I" + _R + "/nspr/pr/include/obsolete",
    "/I" + _R + "/nspr/pr/include/private",
    "/I" + _R + "/nspr/lib/ds",
    "/I" + _R + "/nspr/lib/libc/include",
]

PLDS4_INCLUDES = [
    "/I" + _R + "/nspr/pr/include",
    "/I" + _R + "/nspr/lib/ds",
]

PLC4_INCLUDES = [
    "/I" + _R + "/nspr/pr/include",
    "/I" + _R + "/nspr/lib/libc/include",
]

NSSUTIL_INCLUDES = [
    "/I" + _R + "/nspr/pr/include",
    "/I" + _R + "/nspr/lib/ds",
    "/I" + _R + "/nspr/lib/libc/include",
    "/I" + _R + "/nss/lib/util",
]

FREEBL_INCLUDES = NSSUTIL_INCLUDES + [
    "/I" + _R + "/nss/lib/freebl",
    "/I" + _R + "/nss/lib/freebl/mpi",
    "/I" + _R + "/nss/lib/freebl/ecl",
    "/I" + _R + "/nss/lib/freebl/verified",
    "/I" + _R + "/nss/lib/softoken",
]

SOFTOKN_INCLUDES = NSSUTIL_INCLUDES + [
    "/I" + _R + "/nss/lib/freebl",
    "/I" + _R + "/nss/lib/freebl/ecl",
    "/I" + _R + "/nss/lib/softoken",
    "/I" + _R + "/nss/lib/sqlite",
]

NSS3_INCLUDES = NSSUTIL_INCLUDES + [
    "/I" + _R + "/nss/lib/base",
    "/I" + _R + "/nss/lib/certdb",
    "/I" + _R + "/nss/lib/certhigh",
    "/I" + _R + "/nss/lib/cryptohi",
    "/I" + _R + "/nss/lib/dev",
    "/I" + _R + "/nss/lib/pk11wrap",
    "/I" + _R + "/nss/lib/pki",
    "/I" + _R + "/nss/lib/freebl",
    "/I" + _R + "/nss/lib/freebl/ecl",
    "/I" + _R + "/nss/lib/ssl",
    "/I" + _R + "/nss/lib/nss",
    "/I" + _R + "/nss/lib/smime",
    "/I" + _R + "/nss/lib/pkcs7",
    "/I" + _R + "/nss/lib/libpkix/include",
    "/I" + _R + "/nss/lib/libpkix/pkix/util",
    "/I" + _R + "/nss/lib/libpkix/pkix/checker",
    "/I" + _R + "/nss/lib/libpkix/pkix/certsel",
    "/I" + _R + "/nss/lib/libpkix/pkix/crlsel",
    "/I" + _R + "/nss/lib/libpkix/pkix/params",
    "/I" + _R + "/nss/lib/libpkix/pkix/results",
    "/I" + _R + "/nss/lib/libpkix/pkix/store",
    "/I" + _R + "/nss/lib/libpkix/pkix/top",
    "/I" + _R + "/nss/lib/libpkix/pkix_pl_nss/module",
    "/I" + _R + "/nss/lib/libpkix/pkix_pl_nss/pki",
    "/I" + _R + "/nss/lib/libpkix/pkix_pl_nss/system",
]

SMIME_INCLUDES = NSSUTIL_INCLUDES + [
    "/I" + _R + "/nss/lib/smime",
    "/I" + _R + "/nss/lib/certdb",
    "/I" + _R + "/nss/lib/certhigh",
    "/I" + _R + "/nss/lib/cryptohi",
    "/I" + _R + "/nss/lib/pk11wrap",
    "/I" + _R + "/nss/lib/pki",
    "/I" + _R + "/nss/lib/base",
    "/I" + _R + "/nss/lib/dev",
    "/I" + _R + "/nss/lib/freebl",
    "/I" + _R + "/nss/lib/freebl/ecl",
    "/I" + _R + "/nss/lib/nss",
    "/I" + _R + "/nss/lib/pkcs7",
    "/I" + _R + "/nss/lib/pkcs12",
]

