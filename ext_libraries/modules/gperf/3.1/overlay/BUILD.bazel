load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

# gperf 3.1 — perfect-hash generator, built with MSVC VS2008.
#
# All POSIX-specific includes in lib/getopt.c are guarded by __GLIBC__ /
# __GNU_LIBRARY__ — they are skipped automatically on Windows.
# config.h is provided via the overlay/include/ directory.
# .icc files are textually #included by .cc files — must be in textual_hdrs.

_COPTS = [
    "/W3",
    "/wd4018",   # signed/unsigned mismatch
    "/wd4100",   # unreferenced formal parameter
    "/wd4101",   # unreferenced local variable
    "/wd4244",   # int conversion (possible loss of data)
    "/wd4267",   # size_t → int
    "/wd4305",   # truncation from double to float
    "/wd4706",   # assignment within conditional expression
    "/wd4800",   # int forced to bool
    "/wd4996",   # deprecated CRT functions
]

_INCLUDES = [
    "include",  # overlay config.h
    "src",      # intra-src includes ("options.h", "version.h", etc.)
    "lib",      # "getopt.h", "getline.h", "hash.h"
]

cc_library(
    name = "gperf_srcs",
    srcs = glob([
        "src/*.cc",
        "src/*.h",
        "lib/*.cc",
        "lib/*.c",
        "lib/*.h",
    ]),
    textual_hdrs = glob(["src/*.icc"]),
    includes = _INCLUDES,
    copts = _COPTS,
)

cc_binary(
    name = "gperf",
    deps = [":gperf_srcs"],
    visibility = ["//visibility:public"],
)
