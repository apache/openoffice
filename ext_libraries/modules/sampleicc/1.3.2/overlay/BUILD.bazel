load("@rules_cc//cc:defs.bzl", "cc_library")

_WINDOWS_COPTS = [
    "/W3",
    "/wd4244",  # possible loss of data
    "/wd4267",  # size_t -> int
    "/wd4996",  # deprecated POSIX names
    "/wd4800",  # int -> bool
    "/wd4018",  # signed/unsigned mismatch
    "/wd4305",  # truncation from double to float
]

_WINDOWS_DEFINES = [
    "WIN32",
    "_CRT_SECURE_NO_WARNINGS",
]

# ── IccProfLib ────────────────────────────────────────────────────
# Core SampleICC 1.3.2 profile library.
cc_library(
    name = "iccproflib",
    srcs = [
        "IccProfLib/IccCmm.cpp",
        "IccProfLib/IccIO.cpp",
        "IccProfLib/IccMpeACS.cpp",
        "IccProfLib/IccMpeBasic.cpp",
        "IccProfLib/IccMpeFactory.cpp",
        "IccProfLib/IccProfile.cpp",
        "IccProfLib/IccTagBasic.cpp",
        "IccProfLib/IccTagFactory.cpp",
        "IccProfLib/IccTagLut.cpp",
        "IccProfLib/IccTagMPE.cpp",
        "IccProfLib/IccTagProfSeqId.cpp",
        "IccProfLib/IccUtil.cpp",
        "IccProfLib/md5.cpp",
    ],
    hdrs = [
        "IccProfLib/IccCmm.h",
        "IccProfLib/IccDefs.h",
        "IccProfLib/IccIO.h",
        "IccProfLib/IccMpeACS.h",
        "IccProfLib/IccMpeBasic.h",
        "IccProfLib/IccMpeFactory.h",
        "IccProfLib/IccProfLibConf.h",
        "IccProfLib/IccProfile.h",
        "IccProfLib/IccTag.h",
        "IccProfLib/IccTagBasic.h",
        "IccProfLib/IccTagFactory.h",
        "IccProfLib/IccTagLut.h",
        "IccProfLib/IccTagMPE.h",
        "IccProfLib/IccTagProfSeqId.h",
        "IccProfLib/IccUtil.h",
        "IccProfLib/MainPage.h",
        "IccProfLib/icProfileHeader.h",
        "IccProfLib/md5.h",
    ],
    includes = ["IccProfLib"],
    copts = select({
        "@platforms//os:windows": _WINDOWS_COPTS,
        "//conditions:default": ["-w"],
    }),
    defines = select({
        "@platforms//os:windows": _WINDOWS_DEFINES,
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)

# ── ICC_utils ─────────────────────────────────────────────────────
# SampleICC contrib utilities (CAT, CLUT, Vetters, etc.).
cc_library(
    name = "icc_utils",
    srcs = [
        "Contrib/ICC_utils/CAT.cpp",
        "Contrib/ICC_utils/CLUT.cpp",
        "Contrib/ICC_utils/CLUT_stuffer.cpp",
        "Contrib/ICC_utils/ICC_tool_exception.cpp",
        "Contrib/ICC_utils/Stubs.cpp",
        "Contrib/ICC_utils/Vetters.cpp",
    ],
    hdrs = [
        "Contrib/ICC_utils/CAT.h",
        "Contrib/ICC_utils/CLUT.h",
        "Contrib/ICC_utils/CLUT_stuffer.h",
        "Contrib/ICC_utils/ICC_tool_exception.h",
        "Contrib/ICC_utils/Stubs.h",
        "Contrib/ICC_utils/Vetters.h",
    ],
    includes = ["Contrib/ICC_utils"],
    copts = select({
        "@platforms//os:windows": _WINDOWS_COPTS,
        "//conditions:default": ["-w"],
    }),
    defines = select({
        "@platforms//os:windows": _WINDOWS_DEFINES,
        "//conditions:default": [],
    }),
    deps = [":iccproflib"],
    visibility = ["//visibility:public"],
)
