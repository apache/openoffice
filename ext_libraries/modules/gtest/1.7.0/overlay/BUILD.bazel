load("@rules_cc//cc:defs.bzl", "cc_library")

# GoogleTest 1.7.0 — built with MSVC VS2008 (32-bit), self-contained.
#
# AOO's C++ unit-test foundation (//main/test:test links this; per-module qa/
# gtest suites link it too).  Matches the dmake ext_libraries/modules/gtest
# recipe: a single static lib built from src/gtest-all.cc.
#
# gtest-all.cc textually #includes the other src/*.cc (gtest.cc,
# gtest-death-test.cc, …) and src/gtest-internal-inl.h — those must be
# textual_hdrs, NOT srcs, or they compile twice → duplicate symbols.
# `includes = ["."]` puts the module root on -I so gtest-all.cc's
# `#include "src/gtest-internal-inl.h"` resolves; `include/` is for consumers'
# `#include "gtest/gtest.h"`.
#
# THE TUPLE CHOICE IS LEFT TO gtest-port.h's OWN DETECTION, and must stay that
# way: it is the one setting here that differs per toolchain, and gtest gets it
# right on all three.
#   * VC9 (_MSC_VER 1500, no /Zc:__cplusplus): neither GTEST_ENV_HAS_TR1_TUPLE_
#     (needs _MSC_VER >= 1600) nor GTEST_ENV_HAS_STD_TUPLE_ (needs
#     GTEST_LANG_CXX11) is set, so GTEST_USE_OWN_TR1_TUPLE comes out 1 -- the
#     bundled tuple, which is what use-own-tuple.patch forced in the dmake
#     recipe, because VS2008's own <tr1/tuple> is incomplete.
#   * VS2019 (_MSC_VER 1929, /std:c++14 /Zc:__cplusplus): both are set, so
#     GTEST_USE_OWN_TR1_TUPLE comes out 0 and gtest-port.h includes the real
#     <tuple> and aliases it into ::std::tr1.
# Hardcoding `defines = ["GTEST_USE_OWN_TR1_TUPLE=1"]` here was correct while VC9
# was the only compiler, and became a build break the moment a modern one
# appeared: it forces the bundled tuple into a std::tr1 that the modern STL no
# longer has, and gtest-tuple.h then collides with the real <tuple> (~100 errors
# in gtest-tuple.h, "type is not a member of std::tuple_element").
#
# Whatever it resolves to, it is a PROPAGATED property, not a local one:
# gtest-port.h is included by consumers too, and the tuple choice must be
# identical on both sides of the ABI.  Detection gives that for free, since every
# TU in one configuration sees the same compiler.

_COPTS = [
    "/EHsc",     # gtest uses try/catch (exception tests)
    # AOO compiles the whole tree (incl. gtest, via solenv) with /Zc:wchar_t-,
    # so wchar_t == unsigned short.  Tests that touch sal_Unicode build with the
    # same flag; if gtest were built with native wchar_t, gtest's
    # PrintTo(wchar_t) would mangle differently from the test's
    # PrintTo(unsigned short) → LNK2019.  Keep gtest's wchar_t ABI aligned.
    "/Zc:wchar_t-",
    "/wd4127",   # conditional expression is constant
    "/wd4244",   # conversion, possible loss of data
    "/wd4267",   # size_t → int
    "/wd4996",   # deprecated CRT functions (sprintf, fopen, …)
    "/wd4068",   # unknown pragma
    "/wd4275",   # non dll-interface base
]

cc_library(
    name = "gtest",
    srcs = ["src/gtest-all.cc"],
    hdrs = glob(["include/**/*.h"]),
    textual_hdrs = glob(
        ["src/*.cc", "src/*.h"],
        exclude = ["src/gtest-all.cc", "src/gtest_main.cc"],
    ),
    includes = [
        "include",  # consumers: #include "gtest/gtest.h"
        ".",        # gtest-all.cc: #include "src/gtest-internal-inl.h"
    ],
    copts = _COPTS,
    visibility = ["//visibility:public"],
)

# Optional default main() — most AOO suites provide their own, but expose it for
# the trivial cc_test case.
cc_library(
    name = "gtest_main",
    srcs = ["src/gtest_main.cc"],
    copts = _COPTS,
    deps = [":gtest"],
    visibility = ["//visibility:public"],
)
