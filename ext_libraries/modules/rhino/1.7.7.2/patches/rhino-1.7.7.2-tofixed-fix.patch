         if (mode == DTOSTR_FIXED && (d >= 1e21 || d <= -1e21))
             mode = DTOSTR_STANDARD; /* Change mode here rather than below because the buffer may not be large enough to hold a large integer. */

+        /* Fast path: if the fixed-point result rounds to zero, return immediately
+           without invoking the arbitrary-precision JS_dtoa path.  This bounds the
+           cost of toFixed for tiny and subnormal values.
+
+           toFixed(precision) rounds to zero exactly when abs(d) < 0.5 * 10^(-precision)
+           (the boundary rounds away from zero per ECMAScript round-half-up).  We test
+           the equivalent condition abs(d) < 0.5 * 10^(-precision) rather than computing
+           abs(d) * 10^precision < 0.5, so the multiplication cannot overflow and the
+           comparison remains well conditioned for every legal precision value
+           (num_to restricts precision to [-20,100], hence 10^(-precision) is always a
+           normal double and never underflows to zero).
+
+           Proof that JS_dtoa is bounded when this test does not fire:
+           When abs(d) >= 0.5 * 10^(-precision), we have
+               k = floor(log10(abs(d))) >= -precision - 1
+           hence, in JS_dtoa's fixed mode, ilim = precision + k + 1 >= 0.  Since
+           values with abs(d) >= 1e21 are switched to standard mode above, k <= 20
+           and ilim <= precision + 21 <= 121.  pow5mult exponents are bounded by
+           ~324 (smallest positive subnormal).  The digit-emission loop runs at most
+           ~121 iterations.  No pathological computation can occur. */
+        if (mode == DTOSTR_FIXED && !Double.isNaN(d) && !Double.isInfinite(d)) {
+            double threshold = 0.5 * Math.pow(10.0, -precision);
+            if (Math.abs(d) < threshold) {
+                boolean negative = (d < 0);
+                if (precision <= 0) {
+                    buffer.append(negative ? "-0" : "0");
+                } else {
+                    buffer.append(negative ? "-0." : "0.");
+                    for (int i = 0; i < precision; i++) buffer.append('0');
+                }
+                return;
+            }
+        }
+
         decPt = JS_dtoa(d, dtoaModes[mode], mode >= DTOSTR_FIXED, precision, sign, buffer);
