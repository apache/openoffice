+    public void openFile(URL scriptUrl, Scriptable scope, Runnable closeCallback) {
+        if (scope == null) {
+            javax.swing.JOptionPane.showMessageDialog(this,
+                "Can't compile scripts: no scope available",
+                "Open", javax.swing.JOptionPane.ERROR_MESSAGE);
+        } else if (scriptUrl != null) {
+            String fileName = getFileName(scriptUrl);
+            // Avoid duplicating an already-open editor window.
+            if (getFileWindow(fileName) != null) {
+                showScriptWindow(scriptUrl);
