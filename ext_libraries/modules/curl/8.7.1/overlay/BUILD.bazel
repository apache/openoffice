load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all_srcs",
    srcs = glob(["**"], exclude = ["*.bazel"]),
)

# curl 8.7.1 — static lib, OpenSSL for TLS, no zlib (avoids Z_PREFIX conflict)
#
# Replicates AOO legacy Windows build intent (winbuild/Makefile.vc VC=9).
# Using cmake instead of winbuild nmake so rules_foreign_cc can wire OpenSSL
# paths automatically via CMAKE_PREFIX_PATH.
#
# Zlib is disabled here: AOO's zlib is compiled with Z_PREFIX (all symbols
# prefixed z_) for internal use; curl expects the standard symbol names.
cmake(
    name = "curl",
    lib_source = ":all_srcs",
    deps = ["@openssl//:ssl"],
    cache_entries = {
        # Static build
        "BUILD_SHARED_LIBS": "OFF",
        "BUILD_CURL_EXE": "OFF",
        # TLS via OpenSSL (rules_foreign_cc wires CMAKE_PREFIX_PATH)
        "CURL_USE_OPENSSL": "ON",
        "CMAKE_USE_OPENSSL": "ON",
        # Disable features that pull in extra deps or require Vista+
        "CURL_ZLIB": "OFF",
        "USE_ZLIB": "OFF",
        "CURL_USE_LIBPSL": "OFF",
        "CURL_USE_LIBSSH2": "OFF",
        "CURL_USE_LIBRTMP": "OFF",
        "CURL_DISABLE_LDAP": "ON",
        "CURL_DISABLE_LDAPS": "ON",
        "ENABLE_MANUAL": "OFF",
        "BUILD_TESTING": "OFF",
        # VS2008: suppress C4127/C4244/C4267 noise, no /std: flag
        "CMAKE_C_FLAGS": "/Zc:wchar_t- /wd4127 /wd4244 /wd4267 /wd4996",
        # Force Release so the output is always libcurl.lib regardless of
        # Bazel compilation_mode. rules_foreign_cc drops empty-string cache
        # entries, so CMAKE_DEBUG_POSTFIX="" does not suppress the -d suffix;
        # fixing CMAKE_BUILD_TYPE is the reliable approach.
        "CMAKE_BUILD_TYPE": "Release",
    },
    out_static_libs = ["libcurl.lib"],
)
