# ── Defines ────────────────────────────────────────────────────

RAPTOR2_COMMON_DEFINES = [
    "PACKAGE=\\\"raptor2\\\"",
    "VERSION=\\\"2.0.15\\\"",
    "RAPTOR_VERSION_MAJOR=2",
    "RAPTOR_VERSION_MINOR=0",
    "RAPTOR_VERSION_RELEASE=15",
    "RAPTOR_VERSION_DECIMAL=20015",
    "RAPTOR_XML_LIBXML=1",
    "RAPTOR_WWW_LIBXML=1",
    "RAPTOR_PARSER_RDFXML=1",
    "RAPTOR_PARSER_NTRIPLES=1",
    "RAPTOR_PARSER_TURTLE=1",
    "RAPTOR_PARSER_TRIG=1",
    "RAPTOR_PARSER_GUESS=1",
    "RAPTOR_PARSER_RSS=1",
    "RAPTOR_RSS_COMMON=1",
    "RAPTOR_PARSER_NQUADS=1",
    "RAPTOR_SERIALIZER_RDFXML=1",
    "RAPTOR_SERIALIZER_NTRIPLES=1",
    "RAPTOR_SERIALIZER_NQUADS=1",
    "RAPTOR_SERIALIZER_RDFXML_ABBREV=1",
    "RAPTOR_SERIALIZER_TURTLE=1",
    "RAPTOR_SERIALIZER_RSS_1_0=1",
    "RAPTOR_SERIALIZER_DOT=1",
    "RAPTOR_SERIALIZER_HTML=1",
    "RAPTOR_SERIALIZER_JSON=1",
    "RAPTOR_XML_1_1=1",
    "STDC_HEADERS=1",
    "HAVE_STDINT_H=1",
    "HAVE_STRING_H=1",
]

RAPTOR2_WINDOWS_DEFINES = [
    "WIN32=1",
    "_WINDOWS=1",
    "_CRT_SECURE_NO_WARNINGS=1",
    "HAVE_STRCASECMP=0",
    "RAPTOR_STATIC=1",            # static lib on Windows
]

RAPTOR2_LINUX_DEFINES = [
    "HAVE_STRCASECMP=1",
    "HAVE_PTHREAD_H=1",
    "HAVE_SYS_TIME_H=1",
    "TIME_WITH_SYS_TIME=1",
    "_FILE_OFFSET_BITS=64",
]

RAPTOR2_MACOS_DEFINES = [
    "HAVE_STRCASECMP=1",
    "HAVE_PTHREAD_H=1",
    "HAVE_SYS_TIME_H=1",
    "TIME_WITH_SYS_TIME=1",
    "_DARWIN_USE_64_BIT_INODE=1",
]

# ── Compiler options ───────────────────────────────────────────

RAPTOR2_WINDOWS_COPTS = [
    "/W3",
    "/wd4996",
    "/wd4244",
    "/wd4267",
    "/wd4305",
    "/wd4018",
]

RAPTOR2_UNIX_COPTS = [
    "-w",
    "-std=c99",
    "-fPIC",
]

# ── Main library target ────────────────────────────────────────

cc_library(
    name = "raptor2",
    srcs = RAPTOR2_CORE_SRCS + select({
        "@platforms//os:windows": RAPTOR2_WINDOWS_SRCS,
        "@platforms//os:linux":   RAPTOR2_UNIX_SRCS,
        "@platforms//os:macos":   RAPTOR2_UNIX_SRCS,
    }),
    hdrs = glob(["src/*.h"]) + [":raptor_config_h"],
    includes = ["src"],
    defines = RAPTOR2_COMMON_DEFINES + select({
        "@platforms//os:windows": RAPTOR2_WINDOWS_DEFINES,
        "@platforms//os:linux":   RAPTOR2_LINUX_DEFINES,
        "@platforms//os:macos":   RAPTOR2_MACOS_DEFINES,
    }),
    copts = select({
        "@platforms//os:windows": RAPTOR2_WINDOWS_COPTS,
        "//conditions:default":   RAPTOR2_UNIX_COPTS,
    }),
    linkopts = select({
        "@platforms//os:windows": ["ws2_32.lib"],
        "@platforms//os:linux":   ["-lpthread", "-lm"],
        "@platforms//os:macos":   ["-lpthread", "-lm"],
    }),
    deps = ["@libxml2//:libxml2"],
    visibility = ["//visibility:public"],
)
