RAPTOR2_WINDOWS_DEFINES = [
    "WIN32=1",
    "_WINDOWS=1",
    "_CRT_SECURE_NO_WARNINGS=1",
    # NB: do NOT define HAVE_STRCASECMP — raptor_internal.h tests it with #ifdef,
