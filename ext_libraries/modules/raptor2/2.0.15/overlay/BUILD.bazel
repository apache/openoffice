    # No HTTP backend: ODF metadata is local-file only, and our libxml2 was built
    # without NanoHTTP (xmlNanoHTTP* missing).  Use RAPTOR_WWW_NONE so
    # raptor_www_libxml.c compiles to nothing.
    "#undef RAPTOR_WWW_LIBXML":     "/* #undef RAPTOR_WWW_LIBXML */",
    # Also inject the POSIX S_ISREG macro MSVC lacks (raptor_uri.c); _S_IFMT/_S_IFREG
    # come from <sys/stat.h>, which raptor_uri.c includes before using S_ISREG.
    "#undef RAPTOR_WWW_NONE":       "#define RAPTOR_WWW_NONE 1\n#ifndef S_ISREG\n#define S_ISREG(m) (((m) & _S_IFMT) == _S_IFREG)\n#endif",
}

