# ── prep build environment ────────────────────────────────────────
genrule(
    name = "raptor_config_h",
    srcs = select({
        "@platforms//os:windows": [":raptor_config_h_windows"],
        "//conditions:default":   [":raptor_config_h_unix"],
    }),
    outs = ["src/raptor_config.h"],
    cmd = "cp $< $@",
    # NB: cmd.exe `copy` treats `+` as the file-concatenation operator, and the
    # bzlmod repo dir is named "raptor2+", so `copy ...raptor2+\src\x` is mis-parsed
    # as a concat of a nonexistent file. `type > ` does not special-case `+`.
    cmd_bat = "type \"$<\" > \"$@\"",  # Windows
)
# ── Main library target ────────────────────────────────────────

cc_library(
    name = "raptor2",
    srcs = RAPTOR2_CORE_SRCS + select({
        "@platforms//os:windows": RAPTOR2_WINDOWS_SRCS,
        "@platforms//os:linux":   RAPTOR2_UNIX_SRCS,
        "@platforms//os:macos":   RAPTOR2_UNIX_SRCS,
    }),
    hdrs = glob(["src/*.h"], exclude = [
                "src/raptor2.h.in",
                "src/raptor_config.h.in",
            ]) +
        [":raptor2_h", ":raptor_config_h"],
    includes = ["src"],
    # Build-private macros (HAVE_*, PACKAGE, VERSION, RAPTOR_INTERNAL, parser/
    # serializer flags, …) MUST be local_defines, not defines: as `defines` they
    # propagate to every dependent (rasqal/redland/unordf) and clobber their own
    # config — e.g. HAVE_STDINT_H=1 forced rasqal to #include <stdint.h>, which
    # VS2008 lacks.  Only RAPTOR_STATIC must reach consumers (raptor2.h dllimport guard).
    local_defines = RAPTOR2_COMMON_DEFINES + select({
        "@platforms//os:windows": RAPTOR2_WINDOWS_DEFINES,
        "@platforms//os:linux":   RAPTOR2_LINUX_DEFINES,
        "@platforms//os:macos":   RAPTOR2_MACOS_DEFINES,
    }),
    defines = ["RAPTOR_STATIC=1"],
    copts = select({
        "@platforms//os:windows": RAPTOR2_WINDOWS_COPTS,
        "//conditions:default":   RAPTOR2_UNIX_COPTS,
    }),
    linkopts = select({
        "@platforms//os:windows": ["ws2_32.lib"],
        "@platforms//os:linux":   ["-lpthread", "-lm"],
        "@platforms//os:macos":   ["-lpthread", "-lm"],
    }),
    deps = ["@libxml2//:libxml2"],
    visibility = ["//visibility:public"],
)
