# The generated headers live in the output tree under Python/frozen_modules/.
# "." serves Programs/_bootstrap_python.c's
# "Python/frozen_modules/importlib._bootstrap.h"; "Python" serves
# Modules/getpath.c's "../Python/frozen_modules/getpath.h", which reaches the
# output tree through that include directory once the source directories
# next to getpath.c and its PC/aoo_getpath.c wrapper have come up empty.
cc_library(
    name = "frozen_headers",
    hdrs = [
        ":frozen_getpath",
        ":frozen_modules",
    ],
    includes = [
        ".",
        "Python",
    ],
)

cc_binary(
    name = "_bootstrap_python",
    # PC/aoo_dllhmodule_static.c: PyWin_DLLhModule, which PC/dl_nt.c defines
    # only for the DLL.  _freeze_module gets it from PC/config_minimal.c.
    # PC/aoo_bootstrap_python.c wraps Programs/_bootstrap_python.c so that it
    # honours PYTHONHOME (see that file).
    srcs = [
        "PC/aoo_bootstrap_python.c",
        "PC/aoo_dllhmodule_static.c",
        "PC/aoo_getpath.c",
    ],
    copts = _COPTS,
    local_defines = _CORE_STATIC_DEFINES,
    deps = [
        ":core_headers",
        ":core_min_static",
        ":core_rest_static",
        ":frozen_headers",
