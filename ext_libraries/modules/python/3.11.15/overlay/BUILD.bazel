        "Objects/**/*.h",
        "Parser/**/*.c",
        "Parser/**/*.h",
        "PC/**/*.c",
        "PC/**/*.h",
        "Programs/**/*.c",
        "Programs/**/*.h",
        "Python/**/*.c",
        "Python/**/*.h",
        "Include/**/*.h",
    ]),
    tool = ":_bootstrap_python",
)

# ── python311.dll ─────────────────────────────────────────────────────────────
# Exports come from __declspec(dllexport): Py_BUILD_CORE + Py_ENABLE_SHARED
# make PyAPI_FUNC/PyAPI_DATA dllexport (Include/pyport.h).  No .def file.
cc_binary(
    name = "python311",
    srcs = _CORE_MIN_SRCS + _CORE_REST_SRCS + _CORE_DLL_ONLY_SRCS + [
        "PC/pathcch_win7.c",
        ":deepfreeze",
    ],
    copts = _COPTS,
    local_defines = _CORE_DLL_DEFINES,
    deps = [
        ":core_headers",
        ":frozen_headers",
        "@zlib",
    ],
    linkshared = True,
    linkopts = _CORE_LINKOPTS,
    visibility = ["//visibility:public"],
)

# Consumers put this in additional_linker_inputs and name it in linkopts with
# $(execpath @python//:python311_implib).  PC/pyconfig.h also asks for
# "python311.lib" by #pragma comment(lib) in every translation unit outside
# the core; no file of that name exists (Bazel's is python311.if.lib), so
# consumers add /NODEFAULTLIB:python311.lib, or the link fails with LNK1104.
filegroup(
    name = "python311_implib",
    srcs = [":python311"],
    output_group = "interface_library",
    visibility = ["//visibility:public"],
)

# ── Headers for consumers (pyuno) ─────────────────────────────────────────────
# Include/ for Python.h, PC/ for pyconfig.h.  PC/ also holds the overlay
# pathcch.h; nothing outside this module includes <pathcch.h>.
cc_library(
    name = "python_headers",
    hdrs = glob(["Include/**/*.h"]) + ["PC/pyconfig.h"],
    includes = [
        "Include",
        "PC",
    ],
    visibility = ["//visibility:public"],
)

# ── python.exe ────────────────────────────────────────────────────────────────
# PCbuild/python.vcxproj: Programs/python.c, defining Py_BUILD_CORE and
# _CONSOLE.  Staged as program/python-core-<ver>/bin/python.exe and run by the
# office's own launcher (main/pyuno zipcore).
cc_binary(
    name = "python",
    srcs = ["Programs/python.c"],
    copts = _COPTS,
    local_defines = _BASE_DEFINES + [
        "Py_BUILD_CORE",
        "_CONSOLE",
    ],
    deps = [":core_headers"],
    additional_linker_inputs = [":python311_implib"],
    linkopts = [
        "$(execpath :python311_implib)",
        "/SUBSYSTEM:CONSOLE",
    ],
    visibility = ["//visibility:public"],
)

