    linkopts = _CORE_LINKOPTS + ["/SUBSYSTEM:CONSOLE"],
)

python_deepfreeze(
    name = "deepfreeze",
    frozen = [":frozen_modules"],
    module_names = [name for name, _ in _FROZEN],
    script = "Tools/scripts/deepfreeze.py",
    os_py = "Lib/os.py",
    read_inputs = glob([
        "Lib/**/*.py",
        "Tools/scripts/*.py",
        # generate_global_objects.py scans these for _Py_ID() uses.
        "Modules/**/*.c",
        "Modules/**/*.h",
