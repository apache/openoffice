        [":expat_headers"],
    ),
    "select": (["Modules/selectmodule.c"], [], ["ws2_32.lib"]),
    "unicodedata": (["Modules/unicodedata.c"], [], []),
    "winsound": (["PC/winsound.c"], [], ["winmm.lib"]),
}

[
    cc_binary(
        name = name,
        srcs = spec[0],
        copts = _COPTS,
        local_defines = _BASE_DEFINES + spec[1],
        deps = [":core_headers"] + (spec[3] if len(spec) > 3 else []),
        additional_linker_inputs = [":python311_implib"],
        linkshared = True,
        linkopts = _PYD_LINKOPTS + spec[2],
    )
    for name, spec in _PYDS.items()
]

# The bundled expat and libmpdec directories, which PCbuild puts on the include
# path of the projects that use them and of no other.  Not of every extension
# module: libmpdec has an io.h, which then shadows the CRT's <io.h> that
# PC/pyconfig.h includes ("define CONFIG_64 or CONFIG_32" from _asyncio).
cc_library(
    name = "libmpdec_headers",
    includes = [
        "Modules/_decimal",
        "Modules/_decimal/libmpdec",
    ],
    deps = [":core_headers"],
)

cc_library(
    name = "expat_headers",
    includes = ["Modules/expat"],
    deps = [":core_headers"],
)

[
    rename_file(
        name = name + "_pyd",
        src = ":" + name,
        out = "pyd/%s.pyd" % name,
    )
    for name in _PYDS
]

# Staged flat into program/python-core-<ver>/lib, which is on sys.path
# (trunk's d.lst delivers them to the same lib/python directory).
filegroup(
    name = "python_pyds",
    srcs = [":%s_pyd" % name for name in _PYDS],
    visibility = ["//visibility:public"],
)

# ── Standard library ──────────────────────────────────────────────────────────
# Lib/ as is; installed under program/python-core-<ver>/lib.  Left out: the
# test suite, and the IDLE/turtle/tkinter GUI packages, which need _tkinter
# (not built) and are not part of an office runtime.
filegroup(
    name = "python_lib",
    srcs = glob(
        ["Lib/**"],
        exclude = [
            "Lib/test/**",
            "Lib/idlelib/**",
            "Lib/tkinter/**",
            "Lib/turtledemo/**",
            "Lib/**/__pycache__/**",
        ],
    ),
    visibility = ["//visibility:public"],
)
