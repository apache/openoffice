# ── Python 3.11.15 — Windows x64, VS2019 toolset ─────────────────────────────
#
# The Bazel port of what trunk builds with PCbuild + MSBuild
# (ext_libraries/modules/python/makefile.mk, COMEX 14 branch): pythoncore as
# python311.dll, python.exe, and the extension modules trunk ships -- the
# PYTHON_PROJECTS list there, minus _freeze_module, pythoncore, python and
# pythonw.  Source lists are PCbuild's own .vcxproj item lists; the defines
# are PCbuild's release ones.  Trunk's four patches are all for the Unix
# build (setup.py, Modules/Setup, configure) and none applies here.
#
# Two things differ from PCbuild, and both are Bazel-only overlay files; no
# file of the CPython tarball is modified:
#
#   * WINDOWS 7.  Python 3.9+ targets Windows 8.1 (Doc/using/windows.rst):
#     PC/pyconfig.h asks for _WIN32_WINNT 0x0602, and pythoncore links
#     pathcch.lib, whose API set does not exist on Windows 7 -- python311.dll
#     would not even load there.  Our floor is Windows 7 SP1.  So:
#       - the toolchain's _WIN32_WINNT=0x0601 stands (pyconfig.h only sets it
#         #ifndef), with WINVER/NTDDI_VERSION matched to it below;
#       - PC/aoo_win7_compat.h (force-included) supplies the few Windows 8
#         constants CPython uses without depending on Windows 8;
#       - PC/pathcch.h shadows the SDK header and PC/pathcch_win7.c supplies
#         the three PathCch functions Python calls: the real ones from
#         KernelBase.dll where they exist, documented-behaviour fallbacks on
#         Windows 7.  pathcch.lib is not linked.
#     dynload_win.c loads every .pyd with LOAD_LIBRARY_SEARCH_* flags, which
#     Windows 7 SP1 accepts once KB2533623 is installed -- the same class of
#     prerequisite as the UCRT update (KB2999226) the VS2019 runtime needs.
#
#   * NO HOST PYTHON.  PCbuild runs deepfreeze.py with a Python found on the
#     machine.  Here it runs under _bootstrap_python, built from this tree,
#     the way the Unix build does it -- see build_defs.bzl.
#
# Not built: _ctypes (libffi), _ssl/_hashlib (OpenSSL), _bz2, _lzma,
# _sqlite3, _tkinter -- trunk's PCbuild flags switch all of them off too.

# ── Compile settings ──────────────────────────────────────────────────────────

_COPTS = [
    # The toolchain defines MSC on every command line (it names the compiler
    # for OpenOffice's sources).  CPython never tests it, and the SDK uses it
    # as a member name -- ws2bth.h's RFCOMM_COMMAND has `RFCOMM_MSC_DATA MSC;`,
    # which the define turns into a syntax error in socketmodule.c (C2143).
    "/UMSC",
    # Windows 8 constants CPython uses without depending on Windows 8; found
    # through PC/, on every target's include path.  See the file.
    "/FIaoo_win7_compat.h",
    "/W3",
    "/wd4005",  # macro redefinition (WIN32 et al. from the toolchain)
    "/wd4996",  # deprecated CRT functions
]

# Every target.  PCbuild/pyproject.props defines WIN32 and _WIN32 (the
# toolchain and cl.exe already do).  The Windows API level: see the header.
# NTDDI_VERSION must agree with _WIN32_WINNT or sdkddkver.h refuses.
#
# NDEBUG in every compilation mode: what is built is always PCbuild's Release
# configuration (python311.dll, not the Py_DEBUG python311_d.dll), and Release
# defines it.  The toolchain adds it only under -c opt, so a fastbuild left the
# core's assert()s live -- and pyuno, which runs Python on thread states of its
# own rather than through PyGILState_Ensure, trips PyErr_Occurred's
# assert(PyGILState_Check()) on the first macro call.
_BASE_DEFINES = [
    "NDEBUG",
    "WINVER=0x0601",
    "NTDDI_VERSION=0x06010000",
]

# The interpreter core, in python311.dll (PCbuild/pythoncore.vcxproj).
# USE_ZLIB_CRC32 is per-file there (binascii.c, its only reader).
_CORE_DLL_DEFINES = _BASE_DEFINES + [
    "_USRDLL",
    "Py_BUILD_CORE",
    "Py_BUILD_CORE_BUILTIN",
    "Py_ENABLE_SHARED",
    "_Py_HAVE_ZLIB",
    "USE_ZLIB_CRC32",
]

# The same core linked statically into the build tools
# (PCbuild/_freeze_module.vcxproj).
_CORE_STATIC_DEFINES = _BASE_DEFINES + [
    "Py_NO_ENABLE_SHARED",
    "Py_BUILD_CORE",
    "Py_BUILD_CORE_BUILTIN",
    "_CONSOLE",
    "_Py_HAVE_ZLIB",
    "USE_ZLIB_CRC32",
]

# pathcch.lib deliberately absent -- see the header.  shlwapi for the
# PathCombineW fallback in PC/pathcch_win7.c.
_CORE_LINKOPTS = [
    "version.lib",
    "ws2_32.lib",
    "bcrypt.lib",
    "shlwapi.lib",
    "advapi32.lib",
    "shell32.lib",
    "ole32.lib",
    "oleaut32.lib",
    "user32.lib",
]

# ── Headers ───────────────────────────────────────────────────────────────────
# Every header, and every .c file some other .c file #includes (expat's
# xmltok_impl.c, _sha3's kcp/*.c, _blake2's impl/*.c, and the four originals
# the PC/aoo_*.c wrappers include).  Declared so Bazel tracks them.

cc_library(
    name = "core_headers",
    hdrs = glob([
        "Include/**/*.h",
        "PC/*.h",
        "Python/**/*.h",
        "Objects/**/*.h",
        "Parser/**/*.h",
        "Modules/**/*.h",
    ]),
    textual_hdrs = glob([
        "Modules/**/*.c",
        "Python/**/*.c",
        "PC/*.c",
        "Programs/_bootstrap_python.c",
    ]),
    includes = [
        "Include",
        "Include/internal",
        "PC",
        "Python",
    ],
)

