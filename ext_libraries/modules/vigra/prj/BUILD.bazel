load("@rules_foreign_cc//foreign_cc:defs.bzl", "foreign_cc_library")

# Apply the patch to the source
patch(
    name = "vigra_patch",
    strip = 1,
    patch = "vigra1.6.0.patch",
    base = "//ext_libraries/vigra:vigra_1.6.0",
)

# Define the foreign cc library
foreign_cc_library(
    name = "vigra",
    patch = ":vigra_patch",
    # You'll need to specify the actual source files here
    # This is just a template - you'll need to adjust based on the actual source files
    srcs = glob(["src/**/*.cpp", "src/**/*.h"]),
    hdrs = glob(["include/**/*.h"]),
    visibility = ["//visibility:public"],
)