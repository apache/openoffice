# clangd configuration for the AOO tree.
#
# compile_commands.json is generated by build/tools/gen_compile_commands.py and
# carries the real Bazel flags, so the global defines (MSC, CPPU_ENV,
# _HAS_ITERATOR_DEBUGGING=0) and the generated-header include paths are correct.
#
# Diagnostics are deliberately damped.  MSVC is the real compiler here; clang
# rejects two things it accepts, neither of which affects the index:
#   - boost 1.55's preprocessor pastes invalid tokens (fixed in later boost)
#   - cppuhelper puts exception specifications in typedefs, an MSVC extension
# clangd still builds a complete AST and answers navigation/completion through
# both, so this only quiets squiggles that no MSVC build would ever show.
CompileFlags:
  Add:
    - -Wno-invalid-token-paste
    - -Wno-microsoft-exception-spec
    - -Wno-unknown-warning-option
Diagnostics:
  Suppress:
    - invalid_token_paste
    - err_exception_spec_in_typedef
  UnusedIncludes: None
