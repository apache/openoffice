package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary")

_DEFINES = [
    "WNT", "GUI", "WIN32",
    "WINVER=0x0500", "_WIN32_WINNT=0x0500", "_WIN32_IE=0x0500",
    "CPPU_ENV=msci", "INTEL", "_X86_=1",
    "FULL_DESK",
    "SHAREDLIB", "_DLL_",
]

_COPTS = [
    "/Zc:wchar_t-",
    "/Dsnprintf=_snprintf",
    "/wd4996",
]

# ── evtatt.dll ────────────────────────────────────────────────────
# UNO EventAttacher service component.
cc_binary(
    name = "evtatt",
    srcs = ["source/eventattacher.cxx"],
    copts = _COPTS,
    defines = _DEFINES,
    linkshared = True,
    win_def_file = "util/evtatt.def",
    deps = [
        "//main/cppuhelper:cppuhelper_headers",
        "//main/offapi:offapi_idl_headers",
    ],
    additional_linker_inputs = [
        "//main/sal:sal_implib",
        "//main/cppu:cppu3_implib",
        "//main/cppuhelper:cppuhelper_implib",
    ],
    linkopts = [
        "$(execpath //main/sal:sal_implib)",
        "$(execpath //main/cppu:cppu3_implib)",
        "$(execpath //main/cppuhelper:cppuhelper_implib)",
        "/MANIFEST:NO",
    ],
    visibility = ["//visibility:public"],
)

exports_files(glob(["**/*.component"]))

