package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary")

_DEFINES = [
    "WNT", "GUI", "WIN32",
    "WINVER=0x0500", "_WIN32_WINNT=0x0500", "_WIN32_IE=0x0500",
    "CPPU_ENV=msci", 
    "FULL_DESK", "SHAREDLIB", "_DLL_",
    "snprintf=_snprintf",
]

# ── embobj.dll (generic embedded object factory) ────────────────────
cc_binary(
    name = "embobj",
    srcs = [
        "inc/pch/precompiled_embeddedobj.hxx",
        "source/commonembedding/embedobj.cxx",
        "source/commonembedding/inplaceobj.cxx",
        "source/commonembedding/miscobj.cxx",
        "source/commonembedding/persistence.cxx",
        "source/commonembedding/register.cxx",
        "source/commonembedding/specialobject.cxx",
        "source/commonembedding/visobj.cxx",
        "source/commonembedding/xfactory.cxx",
        "source/commonembedding/xfactory.hxx",
        "source/general/docholder.cxx",
        "source/general/dummyobject.cxx",
        "source/general/intercept.cxx",
        "source/general/xcreator.cxx",
    ] + glob([
        "source/inc/*.hxx",
    ]),
    copts = [
        "/Imain/embeddedobj/inc/pch",
        "/Imain/embeddedobj/source/inc",
        "/Imain/embeddedobj/source/commonembedding",
        "/Zc:wchar_t-",
    ],
    defines = _DEFINES,
    linkshared = True,
    win_def_file = "util/embobj.def",
    deps = [
        "//main/sal:sal_headers",
        "//main/cppu:cppu_headers",
        "//main/cppuhelper:cppuhelper_headers",
        "//main/comphelper:comphelper_headers",
        "//main/tools:tools_headers",
        "//main/udkapi:udkapi_idl_headers",
        "//main/offapi:offapi_idl_headers",
        "//main/stlport:stlport",
    ],
    additional_linker_inputs = [
        "//main/sal:sal_implib",
        "//main/cppu:cppu3_implib",
        "//main/cppuhelper:cppuhelper_implib",
        "//main/comphelper:comphelpMSC_implib",
    ],
    linkopts = [
        "$(execpath //main/sal:sal_implib)",
        "$(execpath //main/cppu:cppu3_implib)",
        "$(execpath //main/cppuhelper:cppuhelper_implib)",
        "$(execpath //main/comphelper:comphelpMSC_implib)",
        "user32.lib", "uuid.lib", "/MANIFEST:NO",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "embobj_implib",
    srcs = [":embobj"],
    output_group = "interface_library",
    visibility = ["//visibility:public"],
)

