        "source/win32/shlxthandler/propsheets/listviewbuilder.hxx",
        "source/win32/shlxthandler/propsheets/document_statistic.cxx",
        "source/win32/shlxthandler/propsheets/document_statistic.hxx",
        # infotips
        "source/win32/shlxthandler/infotips/infotips.cxx",
