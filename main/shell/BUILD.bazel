    win_def_file = "util/shlxthdl.def",
    additional_linker_inputs = [],
    linkopts = [
        "oleaut32.lib",
        "advapi32.lib",
        "ole32.lib",
        "uuid.lib",
        "shell32.lib",
        "kernel32.lib",
        "user32.lib",
        "gdi32.lib",
        "gdiplus.lib",
