package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

# ── Common settings ───────────────────────────────────────────────
# Defines shared by all shlxthandler targets (XML parser + ZIP reader
# + COM shell extension DLLs).  They don't use UNO at all.
_SHLXT_DEFINES = [
    "WNT", "WIN32",
    "ISOLATION_AWARE_ENABLED",
    "WIN32_LEAN_AND_MEAN",
    "XML_UNICODE",          # expat: Unicode (wchar_t) character type
    "_NTSDK",
    "UNICODE", "_UNICODE",
    "_WIN32_WINNT=0x0501",
    "_WIN32_IE=0x501",
    "Z_PREFIX",             # zlib: all symbols prefixed with z_
    "SYSTEM_ZLIB",          # consume <zlib.h> directly, not the OOo wrapper path
    "snprintf=_snprintf",
    # The toolchain sets NOMINMAX globally, so windows.h never defines the
    # min/max macros.  Map them to MSVC intrinsics so GdiplusTypes.h and the
    # shlxthandler sources that use bare `min(a,b)` / `max(a,b)` still work.
    "min=__min",
    "max=__max",
]

_SHLXT_COPTS = [
    "/Zc:wchar_t-",
    "/Imain/shell/inc",
    "/Imain/shell/inc/pch",
    # suppress noise warnings throughout the module
    "/wd4710", "/wd4711", "/wd4514", "/wd4619", "/wd4217", "/wd4820",
]

# Defines for the UNO component DLLs (syssh, localebe, wininetbe).
# These use the full sal/cppu/cppuhelper stack.
_UNO_DEFINES = [
    "WNT", "GUI", "WIN32",
    "WINVER=0x0500", "_WIN32_WINNT=0x0500", "_WIN32_IE=0x0500",
    "CPPU_ENV=msci", "INTEL", "_X86_=1",
    "FULL_DESK",
    "SHAREDLIB", "_DLL_",
    "snprintf=_snprintf",
]

_UNO_COPTS = [
    "/Zc:wchar_t-",
    "/Imain/shell/inc",
    "/Imain/shell/inc/pch",
]

# ── xmlparser (internal) ──────────────────────────────────────────
# Wraps expat with a C++ event-handler interface.
# Used by ooofilereader to parse ODF meta.xml / content.xml.
cc_library(
    name = "xmlparser",
    srcs = ["source/all/xml_parser.cxx"],
    hdrs = ["inc/pch/precompiled_shell.hxx"],
    copts = _SHLXT_COPTS,
    defines = _SHLXT_DEFINES,
    deps = [
        "@expat//:expat_utf16",         # XML_UNICODE build of expat
        "@zlib//:minizip",              # ioapi.h used transitively via basereader.hxx
        "@zlib//:zlib_compat_hdrs",     # <external/zlib/zlib.h>
    ],
)

# ── zipfile (internal) ────────────────────────────────────────────
# Thin C++ wrapper around minizip unzip API.
# Reads ODF/ZIP archives for the shell integration.
cc_library(
    name = "zipfile",
    srcs = [
        "source/all/zipfile/zipfile.cxx",
        "source/all/zipfile/zipexcptn.cxx",
    ],
    hdrs = ["inc/pch/precompiled_shell.hxx"],
    copts = _SHLXT_COPTS,
    defines = _SHLXT_DEFINES,
    deps = [
        "@zlib//:minizip",
        "@zlib//:zlib",
        "@zlib//:zlib_compat_hdrs",   # <external/zlib/zlib.h> path used by types.hxx
    ],
)

# ── ooofilereader (internal) ──────────────────────────────────────
# Reads ODF document metadata (title, author, keywords, …) by parsing
# the meta.xml and content.xml streams inside the ODF ZIP archive.
cc_library(
    name = "ooofilereader",
    srcs = [
        "source/all/ooofilereader/basereader.cxx",
        "source/all/ooofilereader/metainforeader.cxx",
        "source/all/ooofilereader/contentreader.cxx",
        "source/all/ooofilereader/simpletag.cxx",
        "source/all/ooofilereader/keywordstag.cxx",
        "source/all/ooofilereader/autostyletag.cxx",
    ],
    hdrs = ["inc/pch/precompiled_shell.hxx"],
    copts = _SHLXT_COPTS,
    defines = _SHLXT_DEFINES,
    deps = [
        ":xmlparser",
        ":zipfile",
    ],
)

# ── shlxt_util (internal) ─────────────────────────────────────────
# Registry helpers, file-extension mapping, ISO 8601 date conversion,
# and debug utilities shared by the three shlxthandler DLLs.
cc_library(
    name = "shlxt_util",
    srcs = [
        "source/win32/shlxthandler/util/dbgmacros.cxx",
        "source/win32/shlxthandler/util/fileextensions.cxx",
        "source/win32/shlxthandler/util/registry.cxx",
        "source/win32/shlxthandler/util/utilities.cxx",
        "source/win32/shlxthandler/util/iso8601_converter.cxx",
    ],
    hdrs = ["inc/pch/precompiled_shell.hxx"],
    copts = _SHLXT_COPTS,
    defines = _SHLXT_DEFINES,
    deps = [
        "@zlib//:minizip",            # ioapi.h (zlib_filefunc_def) used by types.hxx
        "@zlib//:zlib_compat_hdrs",   # <external/zlib/zlib.h> used by types.hxx
    ],
)

