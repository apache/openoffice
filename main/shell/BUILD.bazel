# ── propertyhdl.dll ───────────────────────────────────────────────
# Windows shell extension: IPropertyStore handler for Windows Vista+.
# Exposes ODF document properties (title, author, …) in Explorer's
# Details pane and Details column via the Windows property system.
cc_binary(
    name = "propertyhdl",
    srcs = [
        "source/win32/shlxthandler/prophdl/propertyhdl.cxx",
        # PrepareIStream is defined in ooofilt's stream_helper.cxx.
        # In the original build, prophdl reused the shared $(SLO)/stream_helper.obj
        # produced by ooofilt.  Bazel compiles from source, so include it directly.
        "source/win32/shlxthandler/ooofilt/stream_helper.cxx",
        "inc/pch/precompiled_shell.hxx",
    ],
    copts = _SHLXT_COPTS + ["/wd4100"],
    defines = _SHLXT_DEFINES,
    linkshared = True,
    win_def_file = "util/propertyhdl.def",
    additional_linker_inputs = [],
    linkopts = [
        "oleaut32.lib",
        "advapi32.lib",
        "ole32.lib",
        "uuid.lib",
        "shell32.lib",
        "kernel32.lib",
        "user32.lib",
        "gdi32.lib",
        "gdiplus.lib",
        "shlwapi.lib",
        "propsys.lib",
        "/MANIFEST:NO",
    ],
    deps = [
        ":ooofilereader",
        ":shlxt_util",
    ],
    visibility = ["//visibility:public"],
)

