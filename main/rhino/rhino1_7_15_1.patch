+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+name: rhino
+version: 1.7.15.1
+
+build.dir: build
+rhino.jar: js.jar
+
+# compilation destination
+classes: ${build.dir}/classes
+
+# compilation settings
+debug: on
+target-jvm: 1.8
+source-level: 1.8
+
+# jar generation settings
+jar-compression: true
diff -ruN -x build -x DefiningClassLoader.java a/b/rhino1.7.15.1/build.xml b/b/rhino1.7.15.1/build.xml
--- a/b/rhino1.7.15.1/build.xml	1969-12-31 19:00:00
+++ b/b/rhino1.7.15.1/build.xml	2026-11-06 14:50:16
@@ -0,0 +1,51 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- This Source Code Form is subject to the terms of the Mozilla Public
+   - License, v. 2.0. If a copy of the MPL was not distributed with this
+   - file, You can obtain one at http://mozilla.org/MPL/2.0/. -->
+
+<!-- Ant replacement for the upstream Gradle build. Builds js.jar the same
+     way Gradle's "jar" task does: everything under src, minus the JSR-223
+     engine. -->
+<project name="rhino" default="jar" basedir=".">
+
+  <property file="build.properties"/>
+
+  <target name="compile">
+    <mkdir dir="${classes}"/>
+    <javac srcdir="src"
+           destdir="${classes}"
+           debug="${debug}"
+           target="${target-jvm}"
+           source="${source-level}"
+           includeantruntime="false"
+           encoding="UTF-8">
+      <compilerarg value="-Xlint:-options"/>
+    </javac>
+  </target>
+
+  <target name="jar" depends="compile">
+    <jar destfile="${build.dir}/${rhino.jar}"
+         compress="${jar-compression}">
+      <manifest>
+        <attribute name="Manifest-Version" value="1.0"/>
+        <attribute name="Main-Class" value="org.mozilla.javascript.tools.shell.Main"/>
+        <attribute name="Automatic-Module-Name" value="org.mozilla.rhino"/>
+        <attribute name="Implementation-Title" value="Rhino"/>
+        <attribute name="Implementation-Version" value="${version}"/>
+      </manifest>
+      <fileset dir="${classes}">
+        <exclude name="org/mozilla/javascript/engine/**"/>
+      </fileset>
+      <fileset dir="src">
+        <exclude name="**/*.java"/>
+        <exclude name="org/mozilla/javascript/engine/**"/>
+        <exclude name="META-INF/services/**"/>
+      </fileset>
+    </jar>
+  </target>
+
+  <target name="clean">
+    <delete dir="${build.dir}"/>
+  </target>
+
+</project>
