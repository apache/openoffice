@@ -0,0 +1,55 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- This Source Code Form is subject to the terms of the Mozilla Public
+   - License, v. 2.0. If a copy of the MPL was not distributed with this
+   - file, You can obtain one at http://mozilla.org/MPL/2.0/. -->
+
+<!-- Upstream builds with Gradle only; this replaces it for the AOO build. -->
+<project name="rhino" default="jar" basedir=".">
+
+  <property name="version" value="1.7.15.1"/>
+  <property name="src.dir" value="src"/>
+  <property name="build.dir" value="build"/>
+  <property name="classes.dir" value="${build.dir}/classes"/>
+  <property name="rhino.jar" value="js.jar"/>
+  <property name="ant.build.javac.source" value="1.8"/>
+  <property name="ant.build.javac.target" value="1.8"/>
+
+  <target name="init">
+    <mkdir dir="${classes.dir}"/>
+  </target>
+
+  <target name="compile" depends="init">
+    <javac srcdir="${src.dir}"
+           destdir="${classes.dir}"
+           debug="on"
+           source="${ant.build.javac.source}"
+           target="${ant.build.javac.target}"
+           includeantruntime="false"
+           encoding="UTF-8">
+      <!-- the JSR-223 engine ships as a separate rhino-engine jar upstream -->
+      <exclude name="org/mozilla/javascript/engine/**"/>
+      <compilerarg value="-Xlint:-options"/>
+      <compilerarg value="-nowarn"/>
+    </javac>
+  </target>
+
+  <target name="jar" depends="compile">
+    <tstamp>
+      <format property="built.date" pattern="yyyy-MM-dd"/>
+    </tstamp>
+    <jar destfile="${build.dir}/${rhino.jar}" compress="true">
+      <manifest>
+        <attribute name="Implementation-Title" value="Mozilla Rhino"/>
+        <attribute name="Implementation-Version" value="${version}"/>
+        <attribute name="Built-Date" value="${built.date}"/>
+      </manifest>
+      <fileset dir="${classes.dir}"/>
+      <fileset dir="${src.dir}" includes="**/*.properties"/>
+    </jar>
+  </target>
+
+  <target name="clean">
+    <delete dir="${build.dir}"/>
+  </target>
+
+</project>
