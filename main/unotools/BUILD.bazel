# ── utl.dll ───────────────────────────────────────────────────────
cc_binary(
    name = "utl",
    srcs = _SRCS,
    copts = [
        "/Imain/unotools/inc",
        "/Imain/unotools/inc/pch",
        "/Imain/unotools/source/config",
        "/Imain/unotools/source/ucbhelper",
        "/Zc:wchar_t-",
    ],
    defines = _DEFINES,
    linkshared = True,
    deps = [
        ":unotools_headers",
        "//main/sal:sal_headers",
        "//main/cppu:cppu_headers",
        "//main/cppuhelper:cppuhelper_headers",
        "//main/salhelper:salhelper_headers",
