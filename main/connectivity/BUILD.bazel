        "//main/tools:tools_headers",
        "//main/unotools:unotools_headers",
        "//main/comphelper:comphelper_headers",
        "//main/ucbhelper:ucbhelper_headers",
        "//main/svl:svl_headers",
        "//main/i18nutil:i18nutil_headers",
        "//main/salhelper:salhelper_headers",
        "//main/jvmaccess:jvmaccess_headers",
        "//main/jvmfwk:jvmfwk_headers",
        "//main/vos:vos_headers",
    ],
    visibility = ["//visibility:public"],
)

# Pre-generated SQL parser (bison -d -pSQLyy -o sqlbison.cxx sqlbison.y
#                           flex -i -8 -PSQLyy -L -o sqlflex.cxx sqlflex.l)
