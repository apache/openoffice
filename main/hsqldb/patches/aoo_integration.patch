+
+    // oj@openoffice.org - the database files are accessed through a class
+    // named in the connection properties, with a key identifying the storage
+    static final String url_fileaccess_class_name = "fileaccess_class_name";
+    static final String url_storage_class_name    = "storage_class_name";
+    static final String url_storage_key           = "storage_key";
+
+    static Class<?> loadStorageClass(String name) throws ClassNotFoundException {
+
+        ClassLoader loader = Thread.currentThread().getContextClassLoader();
+
+        if (loader != null) {
+            try {
+                return loader.loadClass(name);
+            } catch (ClassNotFoundException e) {}
+        }
+
+        return Class.forName(name);
     }
 
+    private FileAccess newStoredFileAccess() {
+
+        String className =
+            database.urlProperties.getProperty(url_fileaccess_class_name);
+
+        if (className == null) {
+            return null;
+        }
+
+        try {
+            Class<?> fileAccessClass = loadStorageClass(className);
+
+            if (!FileAccess.class.isAssignableFrom(fileAccessClass)) {
+                throw new ClassCastException(className);
+            }
+
+            Constructor<?> constructor =
+                fileAccessClass.getConstructor(Object.class);
+            FileAccess access = (FileAccess) constructor.newInstance(
+                database.urlProperties.getProperty(url_storage_key));
+
+            isStoredFileAccess = true;
+
+            return access;
+        } catch (Throwable t) {
+            throw Error.error(t, ErrorCode.FILE_IO_ERROR,
+                              ErrorCode.M_Message_Pair, new Object[] {
+                t.toString(), className
+            });
+        }
+    }
