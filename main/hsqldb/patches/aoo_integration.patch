+
+        try {
+            Class<?> storageClass = Logger.loadStorageClass(className);
+
+            if (!Storage.class.isAssignableFrom(storageClass)) {
+                throw new ClassCastException(className);
+            }
+
+            Constructor<?> constructor =
+                storageClass.getConstructor(String.class, Boolean.class,
+                                            Object.class);
+            Storage storage = (Storage) constructor.newInstance(name,
+                Boolean.valueOf(readonly),
+                database.urlProperties.getProperty(Logger.url_storage_key));
+
+            return new RAStorageWrapper(storage);
