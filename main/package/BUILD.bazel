package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary")

_DEFINES = [
    "WNT", "GUI", "WIN32",
    "WINVER=0x0500", "_WIN32_WINNT=0x0500", "_WIN32_IE=0x0500",
    "CPPU_ENV=msci", "INTEL", "_X86_=1",
    "FULL_DESK",
    "SHAREDLIB", "_DLL_",
    "PACKAGE_DLLIMPLEMENTATION",
    "Z_PREFIX",     # match zlib Z_PREFIX build
    "SYSTEM_ZLIB",  # use <zlib.h> directly (avoids external/zlib/zlib.h path)
]

_COMMON_DEPS = [
    "//main/sal:sal_headers",
    "//main/cppu:cppu_headers",
    "//main/cppuhelper:cppuhelper_headers",
    "//main/salhelper:salhelper_headers",
    "//main/comphelper:comphelper_headers",
    "//main/ucbhelper:ucbhelper_headers",
    "//main/sax:sax_headers",
    "//main/udkapi:udkapi_idl_headers",
    "//main/offapi:offapi_idl_headers",
    "//main/vos:vos_headers",
    "//main/stlport:stlport",
    "@boost.legacy//:boost.legacy",
]

_COMMON_COPTS = [
    "/Imain/package/inc",
    "/Imain/package/inc/pch",
    "/Imain/package/source/package/zippackage",
    "/Imain/package/source/package/zipapi",
    "/Imain/package/source/package/manifest",
    "/Imain/package/source/xstor",
    "/Zc:wchar_t-",
]

