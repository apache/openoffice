# ── package2.dll ──────────────────────────────────────────────────
# ZIP/ODF package handling component. Uses zlib for compression.
# Exports via SAL_DLLPUBLIC_EXPORT — no DEF file.
cc_binary(
    name = "package2",
    srcs = _PACKAGE2_SRCS,
    copts = _COMMON_COPTS,
    defines = _DEFINES,
    linkshared = True,
    deps = _COMMON_DEPS + [
        "@zlib//:zlib",
    ],
    additional_linker_inputs = [
        "//main/sal:sal_implib",
        "//main/cppu:cppu3_implib",
        "//main/cppuhelper:cppuhelper_implib",
        "//main/comphelper:comphelpMSC_implib",
        "//main/ucbhelper:ucbhelperMSC_implib",
        "//main/sax:sax_implib",
    ],
    linkopts = [
        "$(execpath //main/sal:sal_implib)",
        "$(execpath //main/cppu:cppu3_implib)",
        "$(execpath //main/cppuhelper:cppuhelper_implib)",
        "$(execpath //main/comphelper:comphelpMSC_implib)",
        "$(execpath //main/ucbhelper:ucbhelperMSC_implib)",
        "$(execpath //main/sax:sax_implib)",
        "/MANIFEST:NO",
    ],
    visibility = ["//visibility:public"],
)

# ── xstor.dll ─────────────────────────────────────────────────────
# Compound document storage component.
# Exports via SAL_DLLPUBLIC_EXPORT — no DEF file.
cc_binary(
    name = "xstor",
    srcs = _XSTOR_SRCS,
    copts = _COMMON_COPTS,
    defines = _DEFINES,
    linkshared = True,
    deps = _COMMON_DEPS,
    additional_linker_inputs = [
        "//main/sal:sal_implib",
        "//main/cppu:cppu3_implib",
        "//main/cppuhelper:cppuhelper_implib",
        "//main/comphelper:comphelpMSC_implib",
    ],
    linkopts = [
        "$(execpath //main/sal:sal_implib)",
        "$(execpath //main/cppu:cppu3_implib)",
        "$(execpath //main/cppuhelper:cppuhelper_implib)",
        "$(execpath //main/comphelper:comphelpMSC_implib)",
        "/MANIFEST:NO",
    ],
    visibility = ["//visibility:public"],
)

exports_files(glob(["**/*.component"]))

