package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//build/rules:rsc_pipeline.bzl", "rename_file", "rsc_res")

_DEFINES = [
    "WNT", "GUI", "WIN32",
    "WINVER=0x0500", "_WIN32_WINNT=0x0500", "_WIN32_IE=0x0500",
    "CPPU_ENV=msci", "INTEL", "_X86_=1",
    "FULL_DESK", "SHAREDLIB", "_DLL_",
    "snprintf=_snprintf",
    "snwprintf=_snwprintf",
    "SUPD=680",
]

# Include paths shared by all four DLLs
_COMMON_COPTS = [
    "/Imain/chart2/source/inc",
    "/Imain/chart2/inc/pch",
    "/Zc:wchar_t-",
]

# ── public headers ──────────────────────────────────────────────────
cc_library(
    name = "chart2_headers",
    hdrs = glob([
        "source/inc/**/*.hxx",
        "source/inc/**/*.hrc",
    ]),
    strip_include_prefix = "source/inc",
    deps = [
        "//main/sal:sal_headers",
        "//main/cppu:cppu_headers",
        "//main/cppuhelper:cppuhelper_headers",
        "//main/udkapi:udkapi_idl_headers",
        "//main/offapi:offapi_idl_headers",
        "//main/tools:tools_headers",
        "//main/basegfx:basegfx_headers",
        "//main/comphelper:comphelper_headers",
        "//main/vcl:vcl_headers",
        "//main/svl:svl_headers",
        "//main/svtools:svtools_headers",
        "//main/unotools:unotools_headers",
        "//main/editeng:editeng_headers",
    ],
    visibility = ["//visibility:public"],
)

# ── charttools.dll ──────────────────────────────────────────────────
# Core utility library: regression, scaling, data helpers, property wrappers.
# Uses OOO_DLLIMPLEMENTATION_CHARTTOOLS → __declspec(dllexport); no DEF file.
cc_binary(
    name = "charttools",
    srcs = glob(
        ["source/tools/*.cxx", "source/tools/*.hxx"],
        exclude = [
            "source/tools/NamedFillProperties.cxx",
            "source/tools/NamedLineProperties.cxx",
            "source/tools/NamedProperties.cxx",
        ],
    ),
    copts = _COMMON_COPTS + [
        "/Imain/chart2/source/tools",
    ],
    defines = _DEFINES + ["OOO_DLLIMPLEMENTATION_CHARTTOOLS"],
    linkshared = True,
    deps = [
        ":chart2_headers",
        "//main/stlport:stlport",
    ],
    additional_linker_inputs = [
        "//main/sal:sal_implib",
        "//main/cppu:cppu3_implib",
        "//main/cppuhelper:cppuhelper_implib",
        "//main/comphelper:comphelpMSC_implib",
        "//main/tools:tl_implib",
        "//main/svl:svl_implib",
        "//main/vcl:vcl_implib",
        "//main/i18npool:i18nisolang1MSC_implib",
        "//main/basegfx:basegfx_implib",
        "//main/unotools:utl_implib",
    ],
    linkopts = [
        "$(execpath //main/sal:sal_implib)",
        "$(execpath //main/cppu:cppu3_implib)",
        "$(execpath //main/cppuhelper:cppuhelper_implib)",
        "$(execpath //main/comphelper:comphelpMSC_implib)",
        "$(execpath //main/tools:tl_implib)",
        "$(execpath //main/svl:svl_implib)",
        "$(execpath //main/vcl:vcl_implib)",
        "$(execpath //main/i18npool:i18nisolang1MSC_implib)",
        "$(execpath //main/basegfx:basegfx_implib)",
        "$(execpath //main/unotools:utl_implib)",
        "user32.lib", "uuid.lib", "/MANIFEST:NO",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "charttools_implib",
    srcs = [":charttools"],
    output_group = "interface_library",
    visibility = ["//visibility:public"],
)

