        "$(execpath //main/basegfx:basegfx_implib)",
        "$(execpath //main/vcl:vcl_implib)",
        "$(execpath //main/sfx2:sfx_implib)",
        "user32.lib", "uuid.lib", "/MANIFEST:NO",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "chartview_implib",
    srcs = [":chartview"],
    output_group = "interface_library",
    visibility = ["//visibility:public"],
)

# ── controller .hrc resources ───────────────────────────────────────
# Using hdrs + strip_include_prefix creates explicit symlinks in
# bazel-out/_virtual_includes/, which MSVC can reliably find.  Plain
# textual_hdrs relies on source-tree junctions that MSVC sometimes
# doesn't follow for quoted includes.
cc_library(
    name = "chartcontroller_inc_hrc",
    hdrs = glob(["source/controller/inc/*.hrc"]),
    strip_include_prefix = "source/controller/inc",
)

cc_library(
    name = "chartcontroller_dialogs_hrc",
    hdrs = glob(["source/controller/dialogs/*.hrc"]),
    strip_include_prefix = "source/controller/dialogs",
)

cc_library(
    name = "chartcontroller_main_hrc",
    hdrs = glob(["source/controller/main/*.hrc"]),
    strip_include_prefix = "source/controller/main",
)

# ── chartcontroller.dll ─────────────────────────────────────────────
