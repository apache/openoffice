    copts = _COMMON_COPTS + [
        "/Imain/chart2/source/model/inc",
        "/Imain/chart2/source/model/main",
        "/Imain/chart2/source/model/template",
        "/Imain/chart2/source/model/filter",
    ],
    defines = _DEFINES,
    linkshared = True,
    win_def_file = "util/chartmodel.def",
    deps = [
        ":chart2_headers",
        "//main/framework:framework_headers",
        "//main/stlport:stlport",
    ],
    additional_linker_inputs = [
        ":charttools_implib",
