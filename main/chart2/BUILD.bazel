            "source/view/main/*.cxx",
            "source/view/main/*.hxx",
            "source/view/inc/*.hxx",
        ],
        exclude = ["source/view/axes/TickmarkHelper.cxx"],
    ),
    copts = _COMMON_COPTS + [
        "/Imain/chart2/source/view/inc",
        "/Imain/chart2/source/view/main",
        "/Imain/chart2/source/view/axes",
        "/Imain/chart2/source/view/charttypes",
        "/Imain/chart2/source/view/diagram",
