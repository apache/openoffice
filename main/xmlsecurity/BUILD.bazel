# ── _nss_objs (internal) ────────────────────────────────────────────────
# NSS backend compiled separately so it can use /FInss_akmngr.hxx which:
#   • pulls in prerror.h  → PRErrorCode / PR_GetError visible in all TUs
#   • declares xmlSecNssApplied*  → provided by nss_akmngr.cxx stub
cc_library(
    name = "_nss_objs",
    srcs = [
        "inc/pch/precompiled_xmlsecurity.hxx",
        "source/xmlsec/nss/nssinitializer.cxx",
        "source/xmlsec/nss/nssinitializer.hxx",
        "source/xmlsec/nss/digestcontext.cxx",
        "source/xmlsec/nss/digestcontext.hxx",
        "source/xmlsec/nss/ciphercontext.cxx",
        "source/xmlsec/nss/ciphercontext.hxx",
        "source/xmlsec/nss/securityenvironment_nssimpl.cxx",
        "source/xmlsec/nss/securityenvironment_nssimpl.hxx",
        "source/xmlsec/nss/seinitializer_nssimpl.cxx",
        "source/xmlsec/nss/seinitializer_nssimpl.hxx",
        "source/xmlsec/nss/xmlencryption_nssimpl.cxx",
        "source/xmlsec/nss/xmlencryption_nssimpl.hxx",
        "source/xmlsec/nss/xmlsecuritycontext_nssimpl.cxx",
        "source/xmlsec/nss/xmlsecuritycontext_nssimpl.hxx",
        "source/xmlsec/nss/xmlsignature_nssimpl.cxx",
        "source/xmlsec/nss/xmlsignature_nssimpl.hxx",
        "source/xmlsec/nss/x509certificate_nssimpl.cxx",
        "source/xmlsec/nss/x509certificate_nssimpl.hxx",
        "source/xmlsec/nss/sanextension_nssimpl.cxx",
        "source/xmlsec/nss/sanextension_nssimpl.hxx",
        "source/xmlsec/nss/xsec_nss.cxx",
        "source/xmlsec/nss/nss_akmngr.cxx",
        "source/xmlsec/nss/nss_akmngr.hxx",
        "source/xmlsec/nss/secerror.hxx",
        "source/xmlsec/nss/secerror.cxx",
        "source/xmlsec/nss/certerrors.h",
    ],
    copts = [
        "/Imain/xmlsecurity/inc/pch",
        "/Imain/xmlsecurity/inc",
        "/Imain/xmlsecurity/source/xmlsec",
        "/Imain/xmlsecurity/source/xmlsec/mscrypt",
        "/Imain/xmlsecurity/source/xmlsec/nss",
        "/Zc:wchar_t-",
        # Suppress VS2008 manifest-consistency check in crtdefs.h / use_ansi.h.
        # prerror.h → prtypes.h → <stddef.h> → crtdefs.h runs while _DEBUG is set
        # (from /MDd), recording _CRT_MANIFEST_DEBUG.  The NSS source files then
        # #undef _DEBUG, so when use_ansi.h first runs it sees the inconsistency.
        # We use /MANIFEST:NO at link time so the manifest pragmas are irrelevant.
        "/D_CRT_NOFORCE_MANIFEST",
        "/D_STL_NOFORCE_MANIFEST",
        # Force-include our shim header: supplies prerror.h + xmlSecNssApplied* decls
        "/FInss_akmngr.hxx",
    ],
    defines = _DEFINES + [
        "XMLSEC_CRYPTO_MSCRYPTO",
        "XMLSEC_NO_XSLT",
        "XMLSEC_STATIC",
    ],
    deps = [
        "//main/sal:sal_headers",
        "//main/cppu:cppu_headers",
        "//main/cppuhelper:cppuhelper_headers",
        "//main/comphelper:comphelper_headers",
        "//main/tools:tools_headers",
        "//main/svl:svl_headers",
        "//main/xmloff:xmloff_headers",
        "//main/udkapi:udkapi_idl_headers",
        "//main/offapi:offapi_idl_headers",
        "//main/stlport:stlport",
        "@libxmlsec1//:libxmlsec1",
        "@nss//:nss",
    ],
)

