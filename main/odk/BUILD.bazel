load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//build/rules:extension.bzl", "ext_files", "oxt_package")
load("//build/rules:gendocu.bzl", "autodoc_html", "javadoc_html")
load("//build/rules:java_pipeline.bzl", "javac_classes")

# odk — the Office Development Kit (SDK).  Mirrors prj/build.lst.
#
# This file so far holds the three things odk COMPILES (source/); the SDK tree
# itself (pack/copying: tools, import libs, headers, IDL, settings, examples,
# docs) and the generated reference (pack/gendocu, needs autodoc) are not yet
# migrated.  See readme.md.

_DEFINES = [
    "WNT",
    "WIN32",
]

# Both native targets link the STATIC CRT.  sal/config.h pulls in
# systools/win32/snprintf.h, which declares snprintf -- renamed _snprintf by
# the VC9 toolchain's crt_defines -- as __declspec(dllimport), matching only
# the DLL CRT; against libcmt's plain declaration that is C2375.  An empty
# _SNPRINTF_DLLIMPORT is the header's own switch for that.
_STATIC_CRT_DEFINES = _DEFINES + ["_SNPRINTF_DLLIMPORT="]

# ── com.sun.star.lib.loader — source/com/sun/star/lib/loader ─────────────────
# The class loader an SDK client application ships inside its own jar: it finds
# an office installation (registry via unowinreg.dll, or UNO_PATH) and puts its
# UNO jars on a custom class loader.  Loose classes, not a jar: the SDK copies
# them into a client's jar under com/sun/star/lib/loader/.
#
# --release 8: these run inside the CLIENT's JRE, not the build JDK.
javac_classes(
    name = "loader_classes",
    srcs = glob(["source/com/sun/star/lib/loader/*.java"]),
    outs = ["com/sun/star/lib/loader/" + c + ".class" for c in [
        "InstallationFinder",
        "InstallationFinder$StreamGobbler",
        "Loader",
        "Loader$CustomURLClassLoader",
        "Loader$Drain",
        "WinRegKey",
        "WinRegKeyException",
    ]],
    visibility = ["//visibility:public"],
)

# ── unowinreg.dll — source/unowinreg/win ─────────────────────────────────────
# The JNI half of WinRegKey above.  Loaded by the CLIENT's java.exe, never by
# the office, so it links the static CRT (upstream: STDSHL= + LIBCMT) and needs
# no manifest at all.  Exports are the undecorated Java_* names; the .def is
# unowinreg.dxp as a DEF (same trick as jurt's jpipe.def -- on x86 link.exe
# binds each name to its __stdcall _Java_...@N symbol).
cc_binary(
    name = "unowinreg",
    srcs = ["source/unowinreg/win/unowinreg.cxx"],
    copts = [
        "/EHsc",
        "/Imain/odk/inc/pch",
    ],
    defines = _STATIC_CRT_DEFINES,
    features = ["static_link_msvcrt"],
    linkshared = True,
    win_def_file = "util/unowinreg.def",
    deps = ["@rules_java//toolchains:jni"],
    linkopts = [
        "advapi32.lib",
        "/MANIFEST:NO",
    ],
    visibility = ["//visibility:public"],
)

# ── unoapploader.exe — source/unoapploader/win ───────────────────────────────
# Copied by an SDK client next to its own exe under the client's name; finds
# the office (findsofficepath.c, shared with cppuhelper), puts it on PATH and
# starts the client's real exe.  Static CRT (upstream DYNAMIC_CRT= is empty),
# so it runs before any office -- and any VC runtime -- has been found.
cc_binary(
    name = "unoapploader",
    srcs = [
        "source/unoapploader/win/unoapploader.c",
        "//main/cppuhelper:source/findsofficepath.c",
    ],
    copts = ["/TC"],
    defines = _STATIC_CRT_DEFINES,
    features = ["static_link_msvcrt"],
    deps = [
        "//main/cppuhelper:cppuhelper_headers",
        "//main/sal:sal_headers",
    ],
    linkopts = [
        "advapi32.lib",
        "/SUBSYSTEM:WINDOWS",
        "/MANIFEST:NO",
    ],
    visibility = ["//visibility:public"],
)

# ── uno_loader_classes.zip ────────────────────────────────────────────────────
# Upstream pack/copying: zip -r of the SDK's classes/ dir, "com/* win/*" -- the
# loader classes plus win/unowinreg.dll, the layout InstallationFinder expects
# when it loads the DLL from beside the classes.  Delivered to solver bin/ by
# prj/d.lst.  oxt_package is a plain zip-by-archive-path; nothing about it is
# extension-specific.
ext_files(
    name = "_loader_zip_classes",
    srcs = [":loader_classes"],
    strip_prefix = "main/odk",
)

ext_files(
    name = "_loader_zip_win",
    srcs = [":unowinreg"],
    dest = "win",
)

oxt_package(
    name = "uno_loader_classes",
    out = "uno_loader_classes.zip",
    contents = [
        ":_loader_zip_classes",
        ":_loader_zip_win",
    ],
    visibility = ["//visibility:public"],
)

# ═══════════════════════════════════════════════════════════════════════════
# The SDK tree and its zips — pack/copying + util/makefile.mk
# ═══════════════════════════════════════════════════════════════════════════
#
# Upstream pack/copying lays a solver-shaped tree under $(OUT)/bin/odkcommon/
# (bin, lib, include, idl, classes, settings, docs, examples) from the file
# lists in pack/copying/makefile.mk + util/makefile.pmk, then util/makefile.mk
# zips the tree to odkcommon.zip and examples/ to odkexamples.zip -- the two
# deliverables prj/d.lst hands to solver bin/.  oxt_package works in archive
# paths, so there is no on-disk tree to assemble: each ext_files group below
# places one part of pack/copying's lists at its archive path, and the two
# oxt_package targets zip them.
#
# NOT YET, and deliberately absent (see readme.md):
#   - bin/autodoc + docs/common/ref (the IDL reference) -- blocked on autodoc.
#   - cli/ + bin/climaker -- blocked on cli_ure/.NET.
#   - lib/irmcxt.lib -- no module in this source tree produces `rmcxt`
#     (bridges/version.mk's RMCXT_TARGET is a vestigial version stamp nothing
#     consumes); shipped without it rather than guessing a mapping.

_PRODUCT_RELEASE = "4.5.0"       # util/makefile.pmk PRODUCT_RELEASE (= MODULE.bazel version)
_SDKDIRNAME = "OpenOffice_4.5.0_SDK"  # util/makefile.pmk SDKDIRNAME, WNT branch

# ── bin/ — the SDK tools (EXELIST) ───────────────────────────────────────────
# autodoc and climaker are omitted (blocked); unoapploader is this module's.
ext_files(
    name = "_sdk_bin",
    srcs = [
        "//main/codemaker:cppumaker",
        "//main/codemaker:javamaker",
        "//main/idlc:idlc",
        "//main/registry:regcompare",
        "//main/unodevtools:uno-skeletonmaker",
        "@ucpp//:ucpp",
        ":unoapploader",
    ],
    dest = "bin",
)

# ── lib/ — import libraries under their SDK names (LIBLIST) ───────────────────
# Each DLL's interface library (<stem>.if.lib) renamed to the SDK's i<name>.lib.
ext_files(
    name = "_sdk_lib",
    srcs = [
        "//main/sal:sal_implib",
        "//main/salhelper:salhelper_implib",
        "//main/cppu:cppu3_implib",
        "//main/cppu:purpenvhelper_implib",
        "//main/cppuhelper:cppuhelper_implib",
        "//main/store:store_implib",
        "//main/registry:reg_implib",
    ],
    dest = "lib",
    rename = {
        "sal3.if.lib": "isal.lib",
        "salhelper3MSC.if.lib": "isalhelper.lib",
        "cppu3.if.lib": "icppu.lib",
        "purpenvhelper3MSC.if.lib": "ipurpenvhelper3MSC.lib",
        "cppuhelper3MSC.if.lib": "icppuhelper.lib",
        "store.if.lib": "istore.lib",
        "reg.if.lib": "ireg.lib",
    },
)

# ── include/ — the public C++ API headers (INCLUDELIST) ───────────────────────
# Each owning module exposes exactly its SDK subtree as :sdk_headers (no
# inc/pch, no inc/internal); strip_prefix re-roots inc/<dir> onto include/<dir>.
ext_files(
    name = "_sdk_inc_sal",
    srcs = ["//main/sal:sdk_headers"],
    strip_prefix = "main/sal/inc",
    dest = "include",
)

ext_files(
    name = "_sdk_inc_salhelper",
    srcs = ["//main/salhelper:sdk_headers"],
    strip_prefix = "main/salhelper/inc",
    dest = "include",
)

ext_files(
    name = "_sdk_inc_store",
    srcs = ["//main/store:sdk_headers"],
    strip_prefix = "main/store/inc",
    dest = "include",
)

ext_files(
    name = "_sdk_inc_cppu",
    srcs = ["//main/cppu:sdk_headers"],
    strip_prefix = "main/cppu/inc",
    dest = "include",
)

ext_files(
    name = "_sdk_inc_cppuhelper",
    srcs = ["//main/cppuhelper:sdk_headers"],
    strip_prefix = "main/cppuhelper/inc",
    dest = "include",
)

ext_files(
    name = "_sdk_inc_registry",
    srcs = ["//main/registry:sdk_headers"],
    strip_prefix = "main/registry/inc",
    dest = "include",
)

# include/stl -- the systemstl shim forwarders + the two guard headers,
# re-rooted from their two source dirs onto the single stl/ destination.
ext_files(
    name = "_sdk_inc_stl",
    srcs = ["//main/stlport:sdk_headers_stl"],
    strip_prefix = "main/stlport/systemstl",
    dest = "include/stl",
)

ext_files(
    name = "_sdk_inc_stl_guards",
    srcs = ["//main/stlport:sdk_headers_guards"],
    strip_prefix = "main/stlport/systemstlguards",
    dest = "include/stl",
)

# include/udkversion.mk (DESTINCLUDELIST appends it explicitly).
ext_files(
    name = "_sdk_inc_udkversion",
    srcs = ["//main/solenv/inc:udkversion.mk"],
    dest = "include",
)

# ── idl/ — the raw UNO IDL source tree (DESTIDLLIST) ──────────────────────────
ext_files(
    name = "_sdk_idl_udkapi",
    srcs = ["//main/udkapi:sdk_idl"],
    strip_prefix = "main/udkapi",
    dest = "idl",
)

ext_files(
    name = "_sdk_idl_offapi",
    srcs = ["//main/offapi:sdk_idl"],
    strip_prefix = "main/offapi",
    dest = "idl",
)

# ── classes/ — the loader classes + win/unowinreg.dll (DESTCLASSESLIST) ───────
ext_files(
    name = "_sdk_classes",
    srcs = [":loader_classes"],
    strip_prefix = "main/odk",
    dest = "classes",
)

ext_files(
    name = "_sdk_classes_win",
    srcs = [":unowinreg"],
    dest = "classes/win",
)

# ── settings/ — the SDK makefile fragments (SETTINGSLIST) ─────────────────────
ext_files(
    name = "_sdk_settings",
    srcs = glob(["settings/*.mk"]) + ["settings/component.uno.def"],
    dest = "settings",
)

# dk.mk carries the version stamp; @@BUILDID@@/@@SCMREVISION@@ are left empty
# (a wall-clock/VCS stamp defeats a reproducible build -- see the frontier's
# release-identity note; they become a stable provenance key when that lands).
ext_files(
    name = "_sdk_settings_dk",
    srcs = ["pack/copying/dk.mk"],
    dest = "settings",
    substitutions = {
        "@@RELEASE@@": _PRODUCT_RELEASE,
        "@@BUILDID@@": "",
        "@@SCMREVISION@@": "",
    },
)

# ── docs/ + root install files (DOCUFILES, INSTALLSCRIPT, index.html) ──────────
ext_files(
    name = "_sdk_docs_html",
    srcs = [
        "docs/install.html",
        "docs/notsupported.html",
        "docs/tools.html",
    ],
    dest = "docs",
    substitutions = {"%PRODUCT_RELEASE%": _PRODUCT_RELEASE},
)

ext_files(
    name = "_sdk_docs_css",
    srcs = ["docs/sdk_styles.css"],
    dest = "docs",
)

ext_files(
    name = "_sdk_docs_images",
    srcs = glob(["docs/images/*"]),
    dest = "docs/images",
)

ext_files(
    name = "_sdk_index",
    srcs = ["index.html"],
    dest = "",
    substitutions = {"%PRODUCT_RELEASE%": _PRODUCT_RELEASE},
)

ext_files(
    name = "_sdk_scripts",
    srcs = [
        "setsdkenv_windows.template",
        "setsdkname.bat",
        "cfgWin.js",
    ],
    dest = "",
)

ext_files(
    name = "_sdk_setsdkenv",
    srcs = ["setsdkenv_windows.bat"],
    dest = "",
    substitutions = {"__SDKNAME__": _SDKDIRNAME},
)

# examples.html pair -- the DOCUFILES entries that live under examples/ (the
# examples SOURCES ship separately in odkexamples.zip).
ext_files(
    name = "_sdk_examples_html",
    srcs = [
        "examples/examples.html",
        "examples/DevelopersGuide/examples.html",
    ],
    strip_prefix = "main/odk",
    dest = "",
    substitutions = {"%PRODUCT_RELEASE%": _PRODUCT_RELEASE},
)

# ── odkcommon.zip — the whole SDK tree (util PRODUCTZIPFILE) ───────────────────
oxt_package(
    name = "odkcommon",
    out = "odkcommon.zip",
    contents = [
        ":_sdk_bin",
        ":_sdk_lib",
        ":_sdk_inc_sal",
        ":_sdk_inc_salhelper",
        ":_sdk_inc_store",
        ":_sdk_inc_cppu",
        ":_sdk_inc_cppuhelper",
        ":_sdk_inc_registry",
        ":_sdk_inc_stl",
        ":_sdk_inc_stl_guards",
        ":_sdk_inc_udkversion",
        ":_sdk_idl_udkapi",
        ":_sdk_idl_offapi",
        ":_sdk_classes",
        ":_sdk_classes_win",
        ":_sdk_settings",
        ":_sdk_settings_dk",
        ":_sdk_docs_html",
        ":_sdk_docs_css",
        ":_sdk_docs_images",
        ":_sdk_index",
        ":_sdk_scripts",
        ":_sdk_setsdkenv",
        ":_sdk_examples_html",
    ],
    visibility = ["//visibility:public"],
)

# ── odkexamples.zip — the example SOURCES (util ZIP1TARGET) ────────────────────
# ZIP1LIST: examples/ minus build scaffolding and the few samples upstream drops.
ext_files(
    name = "_odkexamples_files",
    srcs = glob(
        ["examples/**"],
        exclude = [
            "examples/**/CVS/**",
            "examples/**/makefile.mk",
            "examples/**/examples.html",
            "examples/**/*Inspector*",
            "examples/**/*Inspector*/**",
            "examples/**/*Container1*",
            "examples/**/*Container1*/**",
            "examples/**/*Storage*",
            "examples/**/*Storage*/**",
            "examples/**/*register_component*",
            "examples/**/*ConverterServlet*",
            "examples/**/*NotesAccess*",
            "examples/**/*NotesAccess*/**",
            "examples/**/*delphi*",
            "examples/**/*delphi*/**",
        ],
    ),
    strip_prefix = "main/odk",
    dest = "",
)

oxt_package(
    name = "odkexamples",
    out = "odkexamples.zip",
    contents = [":_odkexamples_files"],
    visibility = ["//visibility:public"],
)

# ═══════════════════════════════════════════════════════════════════════════
# The generated API reference — pack/gendocu + pack/copying (needs autodoc)
# ═══════════════════════════════════════════════════════════════════════════
#
# autodoc.exe is now available, so the reference trees that were held back can
# be generated.  First the IDL reference -- pack/copying's IDL_DOCU_INDEX_FILE
# (the one piece of pack/copying deferred when autodoc was unmigrated).  Output
# is a TREE artifact (its HTML file set depends on the API), so it is not yet
# folded into odkcommon.zip -- that needs a tree->zip step (zipper cannot
# recurse a directory).  See readme.md for the remaining gendocu work (the C++
# reference, the Java reference, the idl.css overlay, and the packaging).
#
# Matches the pack/copying recipe:
#   autodoc -html <docs/common/ref> -dvgroot <wiki> -name "<OFFICENAME REL> API"
#           -lg idl -dvgfile idl_chapter_refs.txt -t <idl tree>
# with the udkapi + offapi source IDL as the two -t roots (autodoc merges them,
# which is required: offapi types reference udkapi types).
autodoc_html(
    name = "idl_reference",
    out_dir = "docs/common/ref",
    srcs = [
        "//main/udkapi:sdk_idl",
        "//main/offapi:sdk_idl",
        "pack/copying/idl_chapter_refs.txt",
    ],
    roots = [
        "main/udkapi",
        "main/offapi",
    ],
    args = [
        "-dvgroot",
        "https://wiki.openoffice.org/wiki",
        "-name",
        "OpenOffice 4.5.0 API",
        "-lg",
        "idl",
        "-dvgfile",
        "main/odk/pack/copying/idl_chapter_refs.txt",
    ],
    visibility = ["//visibility:public"],
)

# The C++ reference -- gendocu's CPP_DOCU_INDEX_FILE.  Same autodoc_html rule,
# but the C++ `-p <proj> <root> -t <sub>` sequence goes entirely in `args`
# (roots = []): each project's root is that module's own inc/ dir (upstream uses
# one INCOUT holding every subtree; here they are separate), and the -t subdirs
# are relative to the preceding -p root.  -name uses UDK 3.2.7 (udkversion.mk).
# The two -ignoredefine flags drop the DLL-export macros so autodoc's C++ parser
# does not trip on them.  cpp.css overlay deferred (as for the IDL ref).
autodoc_html(
    name = "cpp_reference",
    out_dir = "docs/cpp/ref",
    srcs = [
        "//main/sal:sdk_headers",
        "//main/store:sdk_headers",
        "//main/registry:sdk_headers",
        "//main/cppu:sdk_headers",
        "//main/cppuhelper:sdk_headers",
        "//main/salhelper:sdk_headers",
        "//main/bridges:sdk_headers",
    ],
    roots = [],
    args = [
        "-name",
        "UDK 3.2.7 C/C++ API Reference",
        "-ignoredefine",
        "CPPUHELPER_DLLPUBLIC",
        "-ignoredefine",
        "SAL_DLLPUBLIC_EXPORT",
        "-lg",
        "c++",
        "-p", "sal", "main/sal/inc", "-t", "sal", "-t", "osl", "-t", "rtl",
        "-p", "store", "main/store/inc", "-t", "store",
        "-p", "registry", "main/registry/inc", "-t", "registry",
        "-p", "cppu", "main/cppu/inc", "-t", "cppu", "-t", "com", "-t", "typelib", "-t", "uno",
        "-p", "cppuhelper", "main/cppuhelper/inc", "-t", "cppuhelper",
        "-p", "salhelper", "main/salhelper/inc", "-t", "salhelper",
        "-p", "bridges", "main/bridges/inc", "-t", "bridges",
    ],
    visibility = ["//visibility:public"],
)

# The Java reference -- gendocu's JAVA_DOCU_INDEX_FILE.  javadoc over the UNO
# Java runtime sources (the JAVA_PACKAGES set), from each module's source root.
# Upstream unzips *_src.zip into one JAVA_SRC_DIR; here javadoc reads the source
# trees in place via a multi-root -sourcepath, and ridl/jurt/juh jars on the
# classpath resolve referenced types.  The -linkoffline cross-links and the
# index.html patch are dropped (they only add external links); the generated
# output is otherwise the same focused runtime reference.
javadoc_html(
    name = "java_reference",
    out_dir = "docs/java/ref",
    srcs = [
        "//main/jurt:sdk_javadoc_srcs",
        "//main/javaunohelper:sdk_javadoc_srcs",
        "//main/ridljar:sdk_javadoc_srcs",
    ],
    sourcepath = [
        "main/jurt/java/jurt/src/main/java",
        "main/javaunohelper",
        "main/ridljar/java/unoloader/src/main/java",
    ],
    classpath = [
        "//main/ridljar:ridl_jar",
        "//main/jurt:jurt",
        "//main/javaunohelper:juh_jar",
    ],
    args = [
        "-use",
        "-splitindex",
        "-windowtitle",
        "Java UNO Runtime Reference",
        "-header",
        "UDK 3.2.7 Java API Reference",
    ],
    tail = [
        "com.sun.star.comp.helper",
        "com.sun.star.lib.uno.helper",
        "com.sun.star.lib.unoloader",
        "com.sun.star.uno",
        "main/jurt/java/jurt/src/main/java/com/sun/star/lib/util/UrlToFileMapper.java",
    ],
    visibility = ["//visibility:public"],
)
