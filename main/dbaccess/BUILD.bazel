# ── dbaccess_headers — public inc/ headers ─────────────────────────────
# strip_include_prefix + include_prefix expose files as <dbaccess/dataview.hxx>
# (dbu/dba binaries still use their own /Imain/dbaccess/inc copts for unqualified includes)
cc_library(
    name = "dbaccess_headers",
    hdrs = glob(["inc/**/*.hxx", "inc/**/*.h", "inc/**/*.hrc"]),
    strip_include_prefix = "inc",
    include_prefix = "dbaccess",
    visibility = ["//visibility:public"],
)

# registrationhelper.cxx is #include'd inside dbu_reghelper.cxx / flt_reghelper.cxx
cc_library(
    name = "_registrationhelper",
    textual_hdrs = ["source/shared/registrationhelper.cxx"],
)

# .hrc files cannot go in cc_binary srcs; expose them as textual_hdrs
cc_library(
    name = "_hrc_headers",
    textual_hdrs = glob(["source/**/*.hrc"]),
)

