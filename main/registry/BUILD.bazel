package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

_COPTS = [
    "/Zm500", "/Zc:forScope", "/GR", "/nologo", "/Gs",
    "/EHsc",
    "/wd4061", "/wd4063", "/wd4127",
]

_DEFINES = [
    "WNT", "GUI", "WIN32", "_MT",
    "WINVER=0x0500", "_WIN32_WINNT=0x0500", "_WIN32_IE=0x0500",
    "FULL_DESK",
]

_SLO_DEFINES = _DEFINES + ["SHAREDLIB", "_DLL_", "REGISTRY_DLLIMPLEMENTATION"]

# ── Public headers ────────────────────────────────────────────────
cc_library(
    name = "registry_headers",
    hdrs = glob(["inc/**/*.h", "inc/**/*.hxx"]),
    strip_include_prefix = "inc",
    includes = ["inc/pch"],
    deps = ["//main/sal:sal_headers"],
    visibility = ["//visibility:public"],
)

# ── reg.dll ───────────────────────────────────────────────────────
cc_binary(
    name = "reg",
    srcs = [
        "source/keyimpl.cxx",
        "source/keyimpl.hxx",
        "source/reflcnst.hxx",
        "source/reflread.cxx",
        "source/reflwrit.cxx",
        "source/regimpl.cxx",
        "source/regimpl.hxx",
        "source/registry.cxx",
        "source/regkey.cxx",
        "source/regkey.hxx",
    ],
    copts = _COPTS,
    defines = _SLO_DEFINES,
    deps = [
        ":registry_headers",
        "//main/sal:sal_headers",
        "//main/salhelper:salhelper_headers",
        "//main/store:store_headers",
        "//main/stlport:stlport",
    ],
    additional_linker_inputs = [
        "//main/sal:sal_implib",
        "//main/salhelper:salhelper_implib",
        "//main/store:store_implib",
    ],
    linkshared = True,
    win_def_file = "util/reg.def",
    linkopts = [
        "$(execpath //main/sal:sal_implib)",
        "$(execpath //main/salhelper:salhelper_implib)",
        "$(execpath //main/store:store_implib)",
    ],
    visibility = ["//visibility:public"],
)

# Expose reg's import library for downstream (idlc, regmerge, codemaker etc.)
filegroup(
    name = "reg_implib",
    srcs = [":reg"],
    output_group = "interface_library",
    visibility = ["//visibility:public"],
)

# ── regmerge executable ───────────────────────────────────────────
cc_binary(
    name = "regmerge",
    srcs = [
        "tools/regmerge.cxx",
        "tools/fileurl.cxx",
        "tools/fileurl.hxx",
        "tools/options.cxx",
        "tools/options.hxx",
    ],
    copts = _COPTS + ["/Imain/registry/tools"],
    defines = _DEFINES,
    deps = [
        ":registry_headers",
        "//main/sal:sal_headers",
        "//main/stlport:stlport",
    ],
    additional_linker_inputs = [
        "//main/sal:sal_implib",
        "//main/registry:reg_implib",
    ],
    linkopts = [
        "$(execpath //main/sal:sal_implib)",
        "$(execpath //main/registry:reg_implib)",
        "/MANIFEST:NO",
    ],
    visibility = ["//visibility:public"],
)

# ── regview executable ────────────────────────────────────────────
# Dumps an .rdb registry as text.  Used by //build/tools:uno_graph.py to
# recover the UNO type graph (services, interfaces, methods, parameters)
# without re-parsing IDL — see build/tools/unograph_schema.md.
cc_binary(
    name = "regview",
    srcs = [
        "tools/regview.cxx",
        "tools/fileurl.cxx",
        "tools/fileurl.hxx",
    ],
    copts = _COPTS + ["/Imain/registry/tools"],
    defines = _DEFINES,
    deps = [
        ":registry_headers",
        "//main/sal:sal_headers",
        "//main/stlport:stlport",
    ],
    # regview is run by a developer (via //build/tools:uno_graph.py), not by a
    # build action that could stage an external <exe>.manifest beside it, so it
    # has to carry its own VC90-CRT activation context: the manifest is compiled
    # to a .res and linked in at RT_MANIFEST id 1.  Without it the /MD CRT is
    # unresolvable and the process dies 0xC0000135 before main.  Same reasoning
    # as //main/unodevtools:uno-skeletonmaker.
    additional_linker_inputs = [
        "//main/sal:sal_implib",
        "//main/registry:reg_implib",
        "//main/external/msvcp90:vc90_app_manifest_res",
    ],
    linkopts = [
        "$(execpath //main/sal:sal_implib)",
        "$(execpath //main/registry:reg_implib)",
        "$(execpath //main/external/msvcp90:vc90_app_manifest_res)",
        "/MANIFEST:NO",
    ],
    visibility = ["//visibility:public"],
)
