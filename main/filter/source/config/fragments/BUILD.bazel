# main/filter/source/config/fragments — FCFGMerge outputs
#
# Each fcfg_<pkg>_<set> target merges fragment .xcu files into a combined
# XCU ready for inclusion in a packregistry .xcd package.
# Fragment fragment data comes from the fcfg_*.mk package definition files.
#
# Sets: _types → xmlpackage=Types
#       _filters → xmlpackage=Filter  (or GraphicFilter for internalgraphics)
#       _others → xmlpackage=Misc  (frame-loaders + content-handlers)

load("//main/postprocess:postprocess.bzl", "fcfg_merge")

# Filter UIName fragments (filters/<name>_ui.xcu).  Filters keep their
# localized UIName in a separate _ui.xcu (types embed it inline); these are
# injected into the matching filter node by fcfg_merge.pl.  Passing the full
# set to every filter target is harmless: injection is matched by oor:name.
_FILTER_UI = glob(["filters/*_ui.xcu"])

# ── fcfg_base ─────────────────────────────────────────────────────────────────

fcfg_merge(
    name       = "fcfg_base_types",
    xmlpackage = "Types",
    types = [
        "types/writer_web_HTML_help.xcu",
        "types/oxt_OpenOffice_Extension.xcu",
        "types/wav_Wave_Audio_File.xcu",
        "types/component_Bibliography.xcu",
        "types/component_DB.xcu",
    ],
    visibility = ["//visibility:public"],
)

fcfg_merge(
    name       = "fcfg_base_filters",
    ui       = _FILTER_UI,
    xmlpackage = "Filter",
    filters = [
        "filters/writer_web_HTML_help.xcu",
    ],
    visibility = ["//visibility:public"],
)

fcfg_merge(
    name       = "fcfg_base_others",
