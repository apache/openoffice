load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//build/rules:rsc_pipeline.bzl", "rsc_res")

_DEFINES = [
    "WNT", "GUI", "WIN32",
    "WINVER=0x0500", "_WIN32_WINNT=0x0500", "_WIN32_IE=0x0500",
    "CPPU_ENV=msci", "INTEL", "_X86_=1",
    "FULL_DESK",
    "SHAREDLIB", "_DLL_",
    "ACCESSIBILITY_DLLIMPLEMENTATION",
]

_COPTS = [
    "/Zc:wchar_t-",
    "/Dsnprintf=_snprintf",
    "/wd4996",
    "/Imain/accessibility/inc",
    "/Imain/accessibility/inc/pch",
    "/Imain/accessibility/source/inc",
]

# ── Public headers ─────────────────────────────────────────────────────
cc_library(
    name = "accessibility_headers",
    hdrs = glob([
        "inc/accessibility/**/*.hxx",
        "inc/accessibility/**/*.h",
        "inc/accessibility/**/*.hrc",
    ]),
    includes = ["inc"],
    visibility = ["//visibility:public"],
)

# ── acc.dll ─────────────────────────────────────────────────────────────
# Accessibility factory library: VCL widget a11y + svt browse-box a11y
cc_binary(
    name = "acc",
    srcs = [
        # helper
        "source/helper/acc_factory.cxx",
        "source/helper/accresmgr.cxx",
        "source/helper/characterattributeshelper.cxx",
        # private header
        "source/inc/floatingwindowaccessible.hxx",
        # standard — VCL control wrappers
        "source/standard/accessiblemenubasecomponent.cxx",
        "source/standard/accessiblemenucomponent.cxx",
        "source/standard/accessiblemenuitemcomponent.cxx",
        "source/standard/floatingwindowaccessible.cxx",
        "source/standard/vclxaccessiblebox.cxx",
        "source/standard/vclxaccessiblebutton.cxx",
        "source/standard/vclxaccessiblecheckbox.cxx",
        "source/standard/vclxaccessiblecombobox.cxx",
        "source/standard/vclxaccessibledropdowncombobox.cxx",
        "source/standard/vclxaccessibledropdownlistbox.cxx",
        "source/standard/vclxaccessibleedit.cxx",
        "source/standard/vclxaccessiblefixedhyperlink.cxx",
        "source/standard/vclxaccessiblefixedtext.cxx",
        "source/standard/vclxaccessiblelist.cxx",
        "source/standard/vclxaccessiblelistbox.cxx",
        "source/standard/vclxaccessiblelistitem.cxx",
        "source/standard/vclxaccessiblemenu.cxx",
        "source/standard/vclxaccessiblemenubar.cxx",
        "source/standard/vclxaccessiblemenuitem.cxx",
        "source/standard/vclxaccessiblemenuseparator.cxx",
        "source/standard/vclxaccessiblepopupmenu.cxx",
        "source/standard/vclxaccessibleradiobutton.cxx",
        "source/standard/vclxaccessiblescrollbar.cxx",
        "source/standard/vclxaccessiblestatusbar.cxx",
        "source/standard/vclxaccessiblestatusbaritem.cxx",
        "source/standard/vclxaccessibletabcontrol.cxx",
        "source/standard/vclxaccessibletabpage.cxx",
        "source/standard/vclxaccessibletabpagewindow.cxx",
        "source/standard/vclxaccessibletextcomponent.cxx",
        "source/standard/vclxaccessibletextfield.cxx",
        "source/standard/vclxaccessibletoolbox.cxx",
        "source/standard/vclxaccessibletoolboxitem.cxx",
        # extended — BrowseBox, GridControl, TabBar, ListBox, etc.
        "source/extended/AccessibleBrowseBox.cxx",
        "source/extended/AccessibleBrowseBoxBase.cxx",
        "source/extended/AccessibleBrowseBoxCheckBoxCell.cxx",
        "source/extended/AccessibleBrowseBoxHeaderBar.cxx",
        "source/extended/AccessibleBrowseBoxHeaderCell.cxx",
        "source/extended/AccessibleBrowseBoxTable.cxx",
        "source/extended/AccessibleBrowseBoxTableBase.cxx",
        "source/extended/AccessibleBrowseBoxTableCell.cxx",
        "source/extended/AccessibleGridControl.cxx",
        "source/extended/AccessibleGridControlBase.cxx",
        "source/extended/AccessibleGridControlHeader.cxx",
        "source/extended/AccessibleGridControlHeaderCell.cxx",
        "source/extended/AccessibleGridControlTable.cxx",
        "source/extended/AccessibleGridControlTableBase.cxx",
        "source/extended/AccessibleGridControlTableCell.cxx",
        "source/extended/AccessibleToolPanelDeck.cxx",
        "source/extended/AccessibleToolPanelDeckTabBar.cxx",
        "source/extended/AccessibleToolPanelDeckTabBarItem.cxx",
        "source/extended/accessiblebrowseboxcell.cxx",
        "source/extended/accessibleeditbrowseboxcell.cxx",
        "source/extended/accessibleiconchoicectrl.cxx",
        "source/extended/accessibleiconchoicectrlentry.cxx",
        "source/extended/accessiblelistbox.cxx",
        "source/extended/accessiblelistboxentry.cxx",
        "source/extended/accessibletabbar.cxx",
        "source/extended/accessibletabbarbase.cxx",
        "source/extended/accessibletabbarpage.cxx",
        "source/extended/accessibletabbarpagelist.cxx",
        "source/extended/accessibletablistbox.cxx",
        "source/extended/accessibletablistboxtable.cxx",
        "source/extended/listboxaccessible.cxx",
        "source/extended/textwindowaccessibility.cxx",
    ],
    copts = _COPTS,
    defines = _DEFINES,
    linkshared = True,
    win_def_file = "util/acc.def",
    deps = [
        ":accessibility_headers",
        "//main/comphelper:comphelper_headers",
        "//main/cppuhelper:cppuhelper_headers",
        "//main/offapi:offapi_idl_headers",
        "//main/sot:sot_headers",
        "//main/svl:svl_headers",
        "//main/svtools:svtools_headers",
        "//main/toolkit:toolkit_headers",
        "//main/tools:tools_headers",
        "//main/unotools:unotools_headers",
        "//main/vcl:vcl_headers",
        "//main/stlport:stlport",
    ],
    additional_linker_inputs = [
        "//main/sal:sal_implib",
        "//main/cppu:cppu3_implib",
        "//main/cppuhelper:cppuhelper_implib",
        "//main/comphelper:comphelp_implib",
        "//main/tools:tl_implib",
        "//main/unotools:utl_implib",
        "//main/sot:sot_implib",
        "//main/svl:svl_implib",
        "//main/svtools:svt_implib",
        "//main/vcl:vcl_implib",
        "//main/toolkit:ootk_implib",
    ],
    linkopts = [
        "$(execpath //main/sal:sal_implib)",
        "$(execpath //main/cppu:cppu3_implib)",
        "$(execpath //main/cppuhelper:cppuhelper_implib)",
        "$(execpath //main/comphelper:comphelp_implib)",
        "$(execpath //main/tools:tl_implib)",
        "$(execpath //main/unotools:utl_implib)",
        "$(execpath //main/sot:sot_implib)",
        "$(execpath //main/svl:svl_implib)",
        "$(execpath //main/svtools:svt_implib)",
        "$(execpath //main/vcl:vcl_implib)",
        "$(execpath //main/toolkit:ootk_implib)",
        "/MANIFEST:NO",
    ],
    visibility = ["//visibility:public"],
)

# ── acc_implib ──────────────────────────────────────────────────────────
filegroup(
    name = "acc_implib",
    srcs = [":acc"],
    output_group = "interface_library",
    visibility = ["//visibility:public"],
)

rsc_res(
    name     = "accessibility_res",
    srcs     = glob(["source/**/*.src"]),
    hdrs     = glob(["inc/**/*.hrc"]),
    includes = ["main/accessibility/inc"],
    visibility = ["//visibility:public"],
)
