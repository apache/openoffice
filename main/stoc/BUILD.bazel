        # implementationregistration
        "source/implementationregistration/implreg.cxx",
        "source/implementationregistration/mergekeys.cxx",
        # loader
        "source/loader/dllcomponentloader.cxx",
        # registry_tdprovider
        "source/registry_tdprovider/functiondescription.cxx",
        "source/registry_tdprovider/functiondescription.hxx",
        "source/registry_tdprovider/methoddescription.cxx",
        "source/registry_tdprovider/methoddescription.hxx",
        "source/registry_tdprovider/rdbtdp_tdenumeration.cxx",
        "source/registry_tdprovider/rdbtdp_tdenumeration.hxx",
        "source/registry_tdprovider/structtypedescription.cxx",
        "source/registry_tdprovider/structtypedescription.hxx",
        "source/registry_tdprovider/base.hxx",
        "source/registry_tdprovider/td.cxx",
        "source/registry_tdprovider/tdcomp.cxx",
        "source/registry_tdprovider/tdconsts.cxx",
        "source/registry_tdprovider/tdef.cxx",
        "source/registry_tdprovider/tdenum.cxx",
        "source/registry_tdprovider/tdiface.cxx",
        "source/registry_tdprovider/tdmodule.cxx",
        "source/registry_tdprovider/tdprop.cxx",
        "source/registry_tdprovider/tdprovider.cxx",
        "source/registry_tdprovider/tdservice.cxx",
