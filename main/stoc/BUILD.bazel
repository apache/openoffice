package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary")

_COPTS = [
    "/Zm500", "/Zc:forScope", "/GR", "/nologo", "/Gs",
    "/EHsc",
    "/Dsnprintf=_snprintf",
    "/wd4061", "/wd4063", "/wd4127",
    "/Imain/stoc/inc",
    "/Imain/stoc/inc/pch",
    # uriproc local headers
    "/Imain/stoc/source/uriproc",
    # dummy unistd.h stub for MSVC (implreg.cxx includes it unconditionally)
    "/Imain/soltools/winunistd",
]

_DEFINES = [
    "WNT", "GUI", "WIN32",
    "WINVER=0x0500", "_WIN32_WINNT=0x0500", "_WIN32_IE=0x0500",
    "FULL_DESK",
    "SHAREDLIB", "_DLL_",
]

_DEPS = [
    "//main/sal:sal_headers",
    "//main/cppu:cppu_headers",
    "//main/cppuhelper:cppuhelper_headers",
    "//main/salhelper:salhelper_headers",
    "//main/registry:registry_headers",
    "//main/udkapi:udkapi_idl_headers",
    "//main/xmlreader:xmlreader_headers",
    "//main/stlport:stlport",
    "@boost.legacy//:boost.legacy",
]

