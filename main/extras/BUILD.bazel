# extras — static data files for user profile and shared share/ directories.
#
# Destination mapping (relative to the staging install root):
#   autotext_files  → share/autotext/<lang>/     (shared autocorrect data)
#                   → presets/autotext/<lang>/    (initial user profile copy)
#   wordbook_files  → share/wordbook/             (shared spelling wordbooks)
#   gallery_files   → share/gallery/              (shared gallery objects)
#   template_files  → share/template/             (shared document templates)
#   palette_files   → presets/config/             (initial user palette files)
#   misc_config_files → share/config/             (wizard CSS/images, autotbl.fmt)
#   database_files  → share/database/             (bibliography sample database)
#   opensymbol_ttf  → share/fonts/truetype/       (OpenSymbol math/symbol font)

filegroup(
    name = "autotext_files",
    srcs = glob(
        ["source/autotext/**"],
        exclude = ["**/makefile.mk", "**/delzip"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "wordbook_files",
    srcs = glob(
        ["source/wordbook/**"],
        exclude = ["**/makefile.mk", "**/delzip"],
    ),
    visibility = ["//visibility:public"],
)

