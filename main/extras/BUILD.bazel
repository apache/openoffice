# OpenSymbol is the OOo symbol/math font — needed for bullet points and
# Math formula rendering.  It lives in extras/ rather than more_fonts/
# because it is part of the OOo source distribution, not an external download.
filegroup(
    name = "opensymbol_ttf",
    srcs = ["source/truetype/symbol/opens___.ttf"],
    visibility = ["//visibility:public"],
)
