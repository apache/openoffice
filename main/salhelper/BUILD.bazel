package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//build/rules:gtest_test.bzl", "gtest_test")

_COPTS = [
    "/Zm500", "/Zc:forScope", "/GR", "/nologo", "/Gs",
    "/EHsc",
    "/wd4061", "/wd4063", "/wd4127",
]

_DEFINES = [
    "WNT", "GUI", "WIN32", "_MT",
    "WINVER=0x0500", "_WIN32_WINNT=0x0500", "_WIN32_IE=0x0500",
    "FULL_DESK",
]

_SLO_DEFINES = _DEFINES + ["SHAREDLIB", "_DLL_", "SALHELPER_DLLIMPLEMENTATION"]

# ── Public headers ────────────────────────────────────────────────
cc_library(
    name = "salhelper_headers",
    hdrs = glob(["inc/**/*.hxx", "inc/**/*.h"]),
    strip_include_prefix = "inc",
    deps = ["//main/sal:sal_headers"],
    visibility = ["//visibility:public"],
)

# ── salhelper3MSC.dll ─────────────────────────────────────────────
cc_binary(
    name = "salhelper3MSC",
    srcs = [
        "source/condition.cxx",
        "source/dynload.cxx",
        "source/simplereferenceobject.cxx",
    ],
    copts = _COPTS,
    defines = _SLO_DEFINES,
    deps = [
        ":salhelper_headers",
        "//main/sal:sal_headers",
    ],
    additional_linker_inputs = ["//main/sal:sal_implib"],
    linkshared = True,
    # x64 uses a .def with x64 C++ name mangling (mscx.map: __cdecl __ptr64
    # QEAA/PEAV/AEBV, size_t=_K), vs x86's __thiscall QAE/AAV (msci.map).
    win_def_file = select({
        "//build:arch_x64": "util/salhelperx64.def",
        "//conditions:default": "util/salhelper.def",
    }),
    linkopts = [
        "$(execpath //main/sal:sal_implib)",
    ],
    visibility = ["//visibility:public"],
)

# Expose salhelper's import library for downstream DLLs (registry etc.)
filegroup(
    name = "salhelper_implib",
    srcs = [":salhelper3MSC"],
    output_group = "interface_library",
    visibility = ["//visibility:public"],
)

# ── salhelper_test — RTTI/type_info checks for salhelper's public API ──
# Standalone GoogleTest (own main()), no UNO runtime.  Links sal + salhelper
# import libs; needs sal3.dll + salhelper3MSC.dll at run time.  Mirrors
# qa/makefile.mk (test_api.obj + main.obj, GTESTLIB + SALLIB + SALHELPERLIB).
gtest_test(
    name = "salhelper_test",
    srcs = [
        "qa/main.cxx",
        "qa/test_api.cxx",
    ],
    copts = _COPTS,
    defines = _DEFINES,
    deps = [
        ":salhelper_headers",
        "//main/sal:sal_headers",
    ],
    additional_linker_inputs = [
        "//main/sal:sal_implib",
        ":salhelper_implib",
    ],
    linkopts = [
        "$(execpath //main/sal:sal_implib)",
        "$(execpath :salhelper_implib)",
    ],
    runtime_dlls = [
        "//main/sal:sal3",
        ":salhelper3MSC",
    ],
)