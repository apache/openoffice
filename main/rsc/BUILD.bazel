load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

# ── public headers (rscsfx.hxx needed by svl and others) ─────────
cc_library(
    name = "rsc_headers",
    hdrs = ["inc/rsc/rscsfx.hxx"],
    strip_include_prefix = "inc",
    deps = ["//main/sal:sal_headers"],
    visibility = ["//visibility:public"],
)

# Common defines matching the rest of the first-party build
_DEFINES = [
    "WNT", "GUI", "WIN32",
    "WINVER=0x0500", "_WIN32_WINNT=0x0500", "_WIN32_IE=0x0500",
    "CPPU_ENV=msci", "INTEL", "_X86_=1",
    "FULL_DESK",
    "snprintf=_snprintf",
]

_COPTS = [
    "/Zc:wchar_t-",
    "/EHsc", "/GR",
    "/Imain/rsc/inc",
    "/Imain/rsc/inc/pch",
    "/Imain/rsc/source/parser",
]

# Shared tool sources used by both rsc and rsc2
_TOOLS_SRCS = [
    "source/tools/rschash.cxx",
    "source/tools/rsctree.cxx",
    "source/tools/rsctools.cxx",
    "source/tools/rscchar.cxx",
    "source/tools/rscdef.cxx",
]

_TOOLS_DEPS = [
    "//main/sal:sal_headers",
    "//main/tools:tools_headers",
    "//main/stlport:stlport",
]

_TOOLS_LINKER_INPUTS = [
    "//main/sal:sal_implib",
    "//main/tools:tl_implib",
    "//main/i18npool:i18nisolang1_implib",
    "//main/vos:vos3_implib",
]

_TOOLS_LINKOPTS = [
    "$(execpath //main/sal:sal_implib)",
    "$(execpath //main/tools:tl_implib)",
    "$(execpath //main/i18npool:i18nisolang1_implib)",
    "$(execpath //main/vos:vos3_implib)",
    "/MANIFEST:NO",
    "kernel32.lib",
    "user32.lib",
    "advapi32.lib",
    "msvcrt.lib",
]

# ── rscpp — standalone C preprocessor ────────────────────────────
# Pure C sources; defines SOLAR on Windows (no -Dunix branch).
cc_binary(
    name = "rscpp",
    srcs = [
        "source/rscpp/cpp1.c",
        "source/rscpp/cpp2.c",
        "source/rscpp/cpp3.c",
        "source/rscpp/cpp4.c",
        "source/rscpp/cpp5.c",
        "source/rscpp/cpp6.c",
        # cppmain.c is only for the library variant (NOMAIN); on MSVC cpp1.c
        # already defines main() directly via the MAIN macro, so cppmain.c
        # would cause a duplicate main() link error.
    ],
    copts = ["/Imain/rsc/inc"],
    defines = _DEFINES + ["SOLAR"],
    additional_linker_inputs = _TOOLS_LINKER_INPUTS,
    linkopts = _TOOLS_LINKOPTS,
    deps = _TOOLS_DEPS,
    visibility = ["//visibility:public"],
)

# ── rsc2 parser (cc_library needed for textual_hdrs) ─────────────
# rscyacc.cxx wraps the bison output yyrscyacc.cxx via #include.
# yyrscyacc.cxx is pre-generated (checked in); never regenerated by Bazel.
cc_library(
    name = "rsc2_parser",
    srcs = ["source/parser/rscyacc.cxx"],
    textual_hdrs = [
        "source/parser/yyrscyacc.cxx",
        "source/parser/yyrscyacc.hxx",
        "source/parser/rsclex.hxx",
    ],
    copts = _COPTS,
    defines = _DEFINES,
    deps = _TOOLS_DEPS,
)

# ── rsc2 — the resource compiler ─────────────────────────────────
cc_binary(
    name = "rsc2",
    srcs = _TOOLS_SRCS + [
        "source/misc/rsclst.cxx",
        "source/misc/rscdbl.cxx",
        "source/parser/rscpar.cxx",
        "source/parser/rsclex.cxx",
        "source/parser/erscerr.cxx",
        "source/parser/rsckey.cxx",
        "source/parser/rscinit.cxx",
        "source/parser/rscibas.cxx",
        "source/parser/rscdb.cxx",
        "source/parser/rscicpx.cxx",
        "source/prj/gui.cxx",
        "source/res/rscclobj.cxx",
        "source/res/rsctop.cxx",
        "source/res/rscrange.cxx",
        "source/res/rscconst.cxx",
        "source/res/rscflag.cxx",
        "source/res/rscstr.cxx",
        "source/res/rscall.cxx",
        "source/res/rsccont.cxx",
        "source/res/rscclass.cxx",
        "source/res/rscmgr.cxx",
        "source/res/rscarray.cxx",
        "source/rsc/rsc.cxx",
    ],
    copts = _COPTS,
    defines = _DEFINES,
    additional_linker_inputs = _TOOLS_LINKER_INPUTS,
    linkopts = _TOOLS_LINKOPTS,
    deps = _TOOLS_DEPS + [":rsc2_parser"],
    visibility = ["//visibility:public"],
)

# ── rsc — thin launcher that calls rscpp then rsc2 ────────────────
cc_binary(
    name = "rsc",
    srcs = _TOOLS_SRCS + [
        "source/prj/start.cxx",
    ],
    copts = _COPTS,
    defines = _DEFINES,
    additional_linker_inputs = _TOOLS_LINKER_INPUTS,
    linkopts = _TOOLS_LINKOPTS,
    deps = _TOOLS_DEPS,
    visibility = ["//visibility:public"],
)
