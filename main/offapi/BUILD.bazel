# ── IDL pipeline ──────────────────────────────────────────────────
# Compiles all 3718 offapi IDL files (matching UnoApi_offapi.mk) →
# .urd → .rdb, then cppumaker → header tree.
# Depends on udkapi.rdb for type resolution (UNO base types).
idl_library(
    name = "offapi_idl",
    srcs = glob(
        ["com/sun/star/**/*.idl"],
        exclude = _OFFAPI_EXCLUDED,
    ),
    include_dirs = ["main/offapi", "main/udkapi"],
    extra_rdbs = ["//main/udkapi:udkapi_idl"],
    visibility = ["//visibility:public"],
)

# ── Generated headers as a cc_library dep ─────────────────────────
cc_library(
    name = "offapi_idl_headers",
    hdrs = [":offapi_idl"],
    includes = ["offapi_idl_inc"],
    visibility = ["//visibility:public"],
)

# ── types.rdb — merged UNO type library (udkapi + offapi) ─────────
# Mirrors UnoApi_types.mk: regmerge udkapi.rdb + offapi.rdb → types.rdb.
# Installed to program/types.rdb alongside services.rdb and oovbaapi.rdb.
merge_rdb(
    name = "types_rdb",
    rdbs = [
        "//main/udkapi:udkapi_idl",
        ":offapi_idl",
    ],
    out  = "types.rdb",
    visibility = ["//visibility:public"],
)
