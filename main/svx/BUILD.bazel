# ── SDI slot header generation ───────────────────────────────────────────────
sdi_target(
    name = "svxslots_sdi",
    main_sdi = "sdi/svxslots.sdi",
    exports  = "sdi/svx.sdi",
    srcs     = glob(["sdi/*.sdi", "sdi/*.hrc"]) + [
        "//main/sfx2:sfx2_source_hrc",
        "//main/svl:svl_hrc",
    ],
    slot_name    = "svxslots",
    include_dirs = [
        "main/svx/sdi",
        "main/svx/inc",
        "main/sfx2/sdi",
        "main/sfx2/inc/sfx2",
        "main/sfx2/inc",
        "main/svl/inc",
        "main/editeng/inc",
    ],
    pkg_deps = ["//main/sfx2:sfx2_sdi_pkg"],
)

cc_library(
    name = "svxslots_headers",
    hdrs     = [":svxslots_sdi"],
    includes = ["svxslots_sdi_inc"],
    visibility = ["//visibility:public"],
)

# Stages svx SDI files so downstream modules (e.g. sw) can resolve
# include "svx/svxitems.sdi" etc. via pkg_deps.
sdi_package(
    name = "svx_sdi_pkg",
    srcs = ["sdi/svxitems.sdi", "sdi/xoitems.sdi", "sdi/svx.sdi"],
    prefix = "svx",
    visibility = ["//visibility:public"],
)

rename_file(
    name = "globlmn_hrc",
    src  = "inc/globlmn_tmpl.hrc",
    out  = "inc/svx/globlmn.hrc",
)

# ── Public headers ───────────────────────────────────────────────────────────
cc_library(
    name = "svx_headers",
    hdrs = glob(["inc/svx/**", "inc/*.hxx", "inc/*.hrc"]) + [":globlmn_hrc"],
    strip_include_prefix = "inc",
    deps = [
        ":svxslots_headers",
        "//main/sal:sal_headers",
