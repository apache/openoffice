load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

_COPTS = [
    "/Zm500", "/Zc:forScope", "/GR", "/nologo", "/Gs",
    "/EHsc",
    "/Zc:wchar_t-",
    "/Dsnprintf=_snprintf",
    "/Imain/jvmaccess/inc",
]

_DEFINES = [
    "WNT", "GUI", "WIN32",
    "WINVER=0x0500", "_WIN32_WINNT=0x0500", "_WIN32_IE=0x0500",
    "FULL_DESK",
    "SHAREDLIB", "_DLL_",
    "SOLAR_JAVA",
    "JVMACCESS_DLLIMPLEMENTATION",
]

# ── jvmaccess public headers (for downstream consumers) ──────────────
cc_library(
    name = "jvmaccess_headers",
    hdrs = glob(["inc/jvmaccess/*.hxx", "inc/jvmaccess/*.h"]),
    strip_include_prefix = "inc",
    deps = [
        "//main/sal:sal_headers",
        "@rules_java//toolchains:jni",
    ],
    visibility = ["//visibility:public"],
)

# ── jvmaccess.dll ────────────────────────────────────────────────────
cc_binary(
    name = "jvmaccess3MSC",
    srcs = [
        "source/classpath.cxx",
        "source/unovirtualmachine.cxx",
        "source/virtualmachine.cxx",
    ],
    copts = _COPTS,
    defines = _DEFINES,
    linkshared = True,
    # x86 uses explicit x86-mangled exports; x64 has no mscx.map, but the source
    # uses JVMACCESS_DLLPUBLIC (__declspec(dllexport)) so an empty def suffices on
    # x64 (dllexport emits all 16 exports with x64 mangling — like cppuhelper).
    win_def_file = select({
        "//build:arch_x64": "util/jvmaccessx64.def",
        "//conditions:default": "util/jvmaccess.def",
    }),
    deps = [
        ":jvmaccess_headers",
        "//main/sal:sal_headers",
        "//main/salhelper:salhelper_headers",
        "//main/cppu:cppu_headers",
        "//main/udkapi:udkapi_idl_headers",
        "@rules_java//toolchains:jni",
    ],
    additional_linker_inputs = [
        "//main/sal:sal_implib",
        "//main/cppu:cppu3_implib",
        "//main/salhelper:salhelper_implib",
    ],
    linkopts = [
        "$(execpath //main/sal:sal_implib)",
        "$(execpath //main/cppu:cppu3_implib)",
        "$(execpath //main/salhelper:salhelper_implib)",
        "/MANIFEST:NO",
    ],
    visibility = ["//visibility:public"],
)

# ── import library for downstream consumers ──────────────────────────
filegroup(
    name = "jvmaccess3MSC_implib",
    srcs = [":jvmaccess3MSC"],
    output_group = "interface_library",
    visibility = ["//visibility:public"],
)
