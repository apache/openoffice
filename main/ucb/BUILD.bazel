    name = "_ucb_internal_inc",
    textual_hdrs = [
        "source/inc/regexp.hxx",
        "source/inc/regexpmap.hxx",
        "source/inc/regexpmap.tpt",
        "source/core/providermap.hxx",
    ],
    copts = _COPTS,
    deps = _COMMON_DEPS,
)

