# ── comphelp.dll ──────────────────────────────────────────────────
# Comphelper utility library.
# Exports via COMPHELPER_DLLPUBLIC (SAL_DLLPUBLIC_EXPORT) — no DEF file.
cc_binary(
    name = "comphelp",
    srcs = _SRCS,
    copts = [
        "/Imain/comphelper/inc/pch",
        "/Imain/comphelper/source/inc",
        "/Zc:wchar_t-",
    ],
    defines = _DEFINES,
    linkshared = True,
    deps = [
        ":comphelper_headers",
        "//main/sal:sal_headers",
        "//main/cppu:cppu_headers",
        "//main/cppuhelper:cppuhelper_headers",
        "//main/salhelper:salhelper_headers",
        "//main/ucbhelper:ucbhelper_headers",
        "//main/vos:vos_headers",
        "//main/udkapi:udkapi_idl_headers",
        "//main/offapi:offapi_idl_headers",
        "//main/stlport:stlport",
        "@boost.legacy//:boost.legacy",
    ],
    additional_linker_inputs = [
        "//main/sal:sal_implib",
        "//main/cppu:cppu3_implib",
        "//main/cppuhelper:cppuhelper_implib",
        "//main/salhelper:salhelper_implib",
        "//main/ucbhelper:ucbhelper_implib",
        "//main/vos:vos3_implib",
    ],
    linkopts = [
        "$(execpath //main/sal:sal_implib)",
        "$(execpath //main/cppu:cppu3_implib)",
        "$(execpath //main/cppuhelper:cppuhelper_implib)",
        "$(execpath //main/salhelper:salhelper_implib)",
        "$(execpath //main/ucbhelper:ucbhelper_implib)",
        "$(execpath //main/vos:vos3_implib)",
        "/MANIFEST:NO",
    ],
    visibility = ["//visibility:public"],
)

# ── import library for downstream ─────────────────────────────────
filegroup(
    name = "comphelp_implib",
    srcs = [":comphelp"],
    output_group = "interface_library",
    visibility = ["//visibility:public"],
)

exports_files(glob(["**/*.component"]))

