setup_osl_target(
    name = "setup_osl",
    scp_modules = [
        ":ooo", ":calc", ":writer", ":impress", ":draw", ":base", ":math",
        ":canvas", ":graphicfilter", ":xsltfilter", ":python",
        ":activex", ":quickstart", ":winexplorerext",
    ],
    par_names = _SETUP_OSL_PAR_NAMES,
    par2script_srcs = "//main/solenv/bin:par2script_srcs",
)
