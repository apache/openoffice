+PRJ=..$/..$/..$/..$/..
+
+PRJNAME=expat
+TARGET=expat
+LIBTARGET=NO
+EXTERNAL_WARNINGS_NOT_ERRORS=TRUE
+
+# --- Settings -----------------------------------------------------
+.INCLUDE :  settings.mk
+# --- Files --------------------------------------------------------
+
+CFLAGS+=-I..
+
+.IF "$(OS)"=="WNT"
+CDEFS+=-DWIN32
+.ELSE
+CDEFS+=-DHAVE_EXPAT_CONFIG_H
+.ENDIF
+
+.IF "$(OS)"=="MACOSX" && "$(SYSBASE)"!=""
+CDEFS+=-DHAVE_MEMMOVE -DHAVE_BCOPY
+.ENDIF # "$(OS)"=="MACOSX"
+
+# Entropy sources. Same selection as lib/Makefile.am; on Unix it is read from
+# the expat_config.h that configure has just written.
+.IF "$(OS)"=="WNT"
+RANDOM_OBJS=$(SLO)$/random_rand_s.obj
+.ELSE
+RANDOM_OBJS=$(SLO)$/random_dev_urandom.obj
+.IF "$(shell grep -c 'define HAVE_ARC4RANDOM 1' ..$/expat_config.h || true)"!="0"
+RANDOM_OBJS+=$(SLO)$/random_arc4random.obj
+.ENDIF
+.IF "$(shell grep -c 'define HAVE_ARC4RANDOM_BUF 1' ..$/expat_config.h || true)"!="0"
+RANDOM_OBJS+=$(SLO)$/random_arc4random_buf.obj
+.ENDIF
+.IF "$(shell grep -c 'define HAVE_GETENTROPY 1' ..$/expat_config.h || true)"!="0"
+RANDOM_OBJS+=$(SLO)$/random_getentropy.obj
+.ENDIF
+.IF "$(shell grep -c -E 'define (HAVE_GETRANDOM|HAVE_SYSCALL_GETRANDOM) 1' ..$/expat_config.h || true)"!="0"
+RANDOM_OBJS+=$(SLO)$/random_getrandom.obj
+.ENDIF
+.ENDIF
+
+SECOND_BUILD=UNICODE
+UNICODE_SLOFILES=$(SLO)$/xmlparse.obj
+UNICODECDEFS+=-DXML_UNICODE
+
+LIB1ARCHIV=$(LB)$/libascii_$(TARGET)_xmlparse.a
+LIB1TARGET=$(SLB)$/ascii_$(TARGET)_xmlparse.lib
+LIB1OBJFILES=$(SLO)$/xmlparse.obj
+
+LIB2ARCHIV=$(LB)$/lib$(TARGET)_xmlparse.a
+LIB2TARGET=$(SLB)$/$(TARGET)_xmlparse.lib
+LIB2OBJFILES =$(REAL_UNICODE_SLOFILES)
+
+# xmlparse calls the entropy functions, and both xmlparse libraries are
+# always linked ahead of this one, so they live here.
+LIB3ARCHIV=$(LB)$/lib$(TARGET)_xmltok.a
+LIB3TARGET=$(SLB)$/$(TARGET)_xmltok.lib
+LIB3OBJFILES=$(SLO)$/xmlrole.obj $(SLO)$/xmltok.obj $(RANDOM_OBJS)
+
+.IF "$(BUILD_X64)"!=""
+# ---------------- X64 stuff special ---------------------
+#  use UNICODE only because shell/shlxthandler
+#  doesn't link against ascii_expat_xmlparse
+#---------------------------------------------------------
+SLOFILES_X64=$(SLO_X64)$/xmlparse.obj \
+             $(SLO_X64)$/xmlrole.obj \
+             $(SLO_X64)$/xmltok.obj \
+             $(SLO_X64)$/random_rand_s.obj
+CDEFS_X64+=-DXML_UNICODE -DWIN32
+CFLAGS_X64+=-I..
+LIB1TARGET_X64=$(SLB_X64)$/$(TARGET)_xmlparse.lib
+LIB1OBJFILES_X64=$(SLO_X64)$/xmlparse.obj
+LIB2TARGET_X64=$(SLB_X64)$/$(TARGET)_xmltok.lib
+LIB2OBJFILES_X64=$(SLO_X64)$/xmlrole.obj $(SLO_X64)$/xmltok.obj $(SLO_X64)$/random_rand_s.obj
+.ENDIF # "$(BUILD_X64)"!=""
+
+# --- Targets ------------------------------------------------------
+.INCLUDE :  set_wntx64.mk
+.INCLUDE :	target.mk
+.INCLUDE :  tg_wntx64.mk
