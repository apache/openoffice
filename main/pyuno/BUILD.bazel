package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//build/rules:copy_file.bzl", "copy_file")

_DEFINES = [
    "WNT", "GUI", "WIN32",
    "WINVER=0x0500", "_WIN32_WINNT=0x0500", "_WIN32_IE=0x0500",
    "FULL_DESK",
    "SHAREDLIB", "_DLL_",
]

_COPTS = [
    "/Zm500", "/Zc:forScope", "/GR", "/nologo", "/Gs",
    "/EHsc",
    # wchar_t as typedef (unsigned short) — matches sal_Unicode ABI
    "/Zc:wchar_t-",
    "/Imain/pyuno/inc",
    "/Imain/pyuno/source/module",
] + select({
    # In dbg builds /MDd causes _DEBUG to be defined; Python headers on Windows
    # check _DEBUG and expect python27_d.lib when set, but we always link the
    # release library — undefine to keep the CRT consistent.
    "//build:dbg_build": ["/U_DEBUG", "/D_HAS_ITERATOR_DEBUGGING=0", "/D_SECURE_SCL=0"],
    "//conditions:default": [],
})

_DEPS = [
    "//main/sal:sal_headers",
    "//main/cppu:cppu_headers",
    "//main/cppuhelper:cppuhelper_headers",
    "//main/udkapi:udkapi_idl_headers",
    # hash_map / hash_set used as std:: — requires stlport
    "//main/stlport:stlport",
    "@python//:python_headers",
]

_LINK_DEPS = [
    "//main/sal:sal_implib",
    "//main/cppu:cppu3_implib",
    "//main/cppuhelper:cppuhelper_implib",
    "@python//:python27_implib",
]

_LINKOPTS = [
    "$(execpath //main/sal:sal_implib)",
    "$(execpath //main/cppu:cppu3_implib)",
    "$(execpath //main/cppuhelper:cppuhelper_implib)",
    "$(execpath @python//:python27_implib)",
    "/MANIFEST:NO",
]

# ── public headers ────────────────────────────────────────────────
# Provides <pyuno/pyuno.hxx> for consumers (e.g. pythonloader).
cc_library(
    name = "pyuno_headers",
    hdrs = ["inc/pyuno/pyuno.hxx"],
    strip_include_prefix = "inc",
    deps = [
        "//main/sal:sal_headers",
        "//main/cppu:cppu_headers",
        "@python//:python_headers",
    ],
    visibility = ["//visibility:public"],
)

# ── pyuno.pyd ─────────────────────────────────────────────────────
# Core Python-UNO bridge.  Windows Python extension modules MUST use the .pyd
# extension — Python 2.7's _PyImport_DynLoadFiletab (Python/dynload_win.c) lists
# only {".pyd"} ({"_d.pyd"} under _DEBUG), NOT ".dll".  uno.py starts with
# `import pyuno`, so with a pyuno.dll that import raises ImportError, `import
# pythonloader` fails with it, and ScriptProviderForPython can never be
# instantiated (macro dialog shows the Python node from pyuno.xcd but lists
# nothing and offers no Create).  Upstream: DLLPOST=.pyd in
# source/module/makefile.mk, scp2 ships "pyuno.pyd".
#
# Bazel names a linkshared cc_binary "<target>.dll" unconditionally, so the file
# is produced as pyuno.dll and re-exposed as pyuno.pyd by :pyuno_pyd below;
# util/pyuno.def carries `LIBRARY pyuno.pyd` so consumers' import tables name
# the .pyd.  Only ONE of the two may be staged — see util/pyuno.def for why.
#
# Exports: initpyuno (Python 2.x), Runtime, PyRef, PyThreadAttach,
#          PyThreadDetach via PY_DLLEXPORT = SAL_DLLPUBLIC_EXPORT.
# pyuno_dlopenwrapper.c is *nix-only (uses dlopen); omitted on Windows.
cc_binary(
    name = "pyuno",
    srcs = [
        "source/module/pyuno_runtime.cxx",
        "source/module/pyuno.cxx",
        "source/module/pyuno_callable.cxx",
        "source/module/pyuno_module.cxx",
        "source/module/pyuno_type.cxx",
        "source/module/pyuno_util.cxx",
        "source/module/pyuno_except.cxx",
        "source/module/pyuno_adapter.cxx",
        "source/module/pyuno_gc.cxx",
        "source/module/pyuno_impl.hxx",
    ],
    copts = _COPTS,
    defines = _DEFINES,
    deps = _DEPS,
    additional_linker_inputs = _LINK_DEPS,
    linkshared = True,
    linkopts = _LINKOPTS,
    win_def_file = "util/pyuno.def",
    visibility = ["//visibility:public"],
)

# The staged artifact: same file, the name Python's importer will accept.
copy_file(
    name = "pyuno_pyd",
    src  = ":pyuno",
    out  = "pyuno.pyd",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "pyuno_implib",
    srcs = [":pyuno"],
    output_group = "interface_library",
    visibility = ["//visibility:public"],
)

# ── pythonloader.dll ──────────────────────────────────────────────
# UNO component: loads Python-based UNO components.
# Exports: component_getImplementationEnvironment, component_getFactory
#          via SAL_DLLPUBLIC_EXPORT — no DEF file required.
cc_binary(
    name = "pythonloader",
    srcs = ["source/loader/pyuno_loader.cxx"],
    copts = _COPTS,
    defines = _DEFINES,
    deps = _DEPS + [":pyuno_headers"],
    additional_linker_inputs = _LINK_DEPS + [":pyuno_implib"],
    linkshared = True,
    linkopts = _LINKOPTS + [
        "$(execpath :pyuno_implib)",
    ],
    visibility = ["//visibility:public"],
)

# ── Python-side runtime modules → staged flat into program/ ───────────────────
# pyuno_loader.cxx imports the "pythonloader" module, which imports "uno";
# unohelper is pulled in by most Python components.  PYUNO_LOADER_PYTHONPATH
# ends with $ORIGIN (= program/), so all three must sit there as plain files.
# Equivalent of Package_py.mk / scp2 file_python.scp (Dir = program).
filegroup(
    name = "pyuno_py",
    srcs = [
        "source/loader/pythonloader.py",
        "source/module/uno.py",
        "source/module/unohelper.py",
    ],
    visibility = ["//visibility:public"],
)

exports_files(glob(["**/*.component"]))


# ── program/python.exe — the Python launcher (zipcore/python.cxx) ────────────
# What a user runs to script the office from an external Python.  It is NOT
# Python itself: it sets PATH (program/ first, for python27.dll and the UNO
# DLLs), PYTHONPATH (program/ for uno.py + pyuno.pyd, then the core lib dirs),
# PYTHONHOME, UNO_PATH and URE_BOOTSTRAP (program/fundamental.ini), all relative
# to its own location, then runs python-core-<ver>/bin/python.exe with the same
# arguments and returns its exit code.  Upstream: zipcore/makefile.mk APP1.
#
# Before this, program/ held the raw CPython exe from @python, which (a) set
# none of that environment and (b) had no CRT manifest, so it could not even
# start (0xC0000135, MSVCR90.dll unresolvable).  This one embeds the VC90
# manifest at RT_MANIFEST id 1 like every other /MD exe here.
genrule(
    name = "pyversion_hxx",
    srcs = ["zipcore/pyversion.inc"],
    outs = ["zipcore/pyversion.hxx"],
    # zipcore/makefile.mk: sed s/@/$(PYVERSION)/g.  Keep in step with the
    # python-core-<ver> directory name in //main/staging.
    cmd = "sed 's/@/2.7.18/g' < $< > $@",
)

cc_library(
    name = "pyversion_hdr",
    hdrs = [":pyversion_hxx"],
    includes = ["zipcore"],
)

_APP_MANIFEST_RES = "//main/external/msvcp90:vc90_app_manifest_res"

cc_binary(
    name = "python",
    srcs = ["zipcore/python.cxx"],
    defines = ["WNT", "WIN32", "UNICODE", "_UNICODE"],
    copts = ["/EHsc", "/Zc:wchar_t-"],
    deps = [
        ":pyversion_hdr",
        "//main/tools:ooopathutils",
        "//main/tools:tools_headers",
        "//main/sal:sal_headers",
    ],
    additional_linker_inputs = [_APP_MANIFEST_RES],
    linkopts = [
        "$(execpath %s)" % _APP_MANIFEST_RES,
        "user32.lib",  # wsprintfW
        "/SUBSYSTEM:CONSOLE",
        "/MANIFEST:NO",
    ],
)

# ── python-core-<ver>/bin/python.exe — CPython, with a CRT manifest ──────────
# @python links its python.exe /MANIFEST:NO and embeds none, so as staged it
# cannot resolve MSVCR90.dll.  The external module cannot name a main-repo
# label, so the VC90 application manifest is embedded here, into a copy, with
# the SDK's mt.exe (resource id 1, the EXE slot).
genrule(
    name = "python_core_exe",
    srcs = [
        "@python//:python",
        "//main/external/msvcp90:vc90_app_manifest",
    ],
    outs = ["python-core/python.exe"],
    cmd_bat = (
        "copy /y \"$(location @python//:python)\" \"$(OUTS)\" > nul&&" +
        "set \"_MT=C:\\Program Files\\Microsoft SDKs\\Windows\\v7.0\\Bin\\mt.exe\"&&" +
        "\"!_MT!\" -nologo" +
        " -manifest \"$(location //main/external/msvcp90:vc90_app_manifest)\"" +
        " \"-outputresource:$(OUTS);#1\""
    ),
)
