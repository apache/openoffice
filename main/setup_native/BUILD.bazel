load("@rules_cc//cc:defs.bzl", "cc_binary")

# setup_native — the Windows installer's own tools and MSI custom actions.
# Mirrors prj/build.lst.  So far only the build tool the installer step needs
# first; the custom-action DLLs (source/win32/customactions) are not migrated.
# See readme.md.

exports_files([
    # make_installer's -msilanguage input is converted with this table.
    "source/win32/msi-encodinglist.txt",
])

# ── ulfconv.exe — source/ulfconv ─────────────────────────────────────────────
# Converts the installer's UTF-8 .ulf string files into .mlf, each language in
# its MSI codepage (rules.mk %.mlf: ulfconv -t msi-encodinglist.txt).  A BUILD
# tool: the installer step runs it, nothing installs it.
cc_binary(
    name = "ulfconv",
    srcs = ["source/ulfconv/ulfconv.cxx"],
    copts = [
        "/EHsc",
        "/Imain/soltools/winunistd",
    ],
    defines = ["WNT", "WIN32"],
    deps = ["//main/sal:sal_headers"],
    additional_linker_inputs = ["//main/sal:sal_implib"],
    linkopts = [
        "$(execpath //main/sal:sal_implib)",
        "/SUBSYSTEM:CONSOLE",
        "/MANIFEST:NO",
    ],
    visibility = ["//visibility:public"],
)
