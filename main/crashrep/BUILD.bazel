package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//build/rules:lngconvex_rule.bzl", "lngconvex_rc")

# ── versionlist.hrc — parsed from version.lst ────────────────────────────────
# version.hrc (pulled into soreport.rc via rcheader.txt) does
# #include "versionlist.hrc".  The dmake build generated this from
# minormkchanged.flg; here we derive it from the same source (version.lst).
genrule(
    name = "versionlist_hrc",
    srcs = ["//main/solenv/inc:version.lst"],
    outs = ["versionlist.hrc"],
    cmd_bat = (
        "perl \"$(execpath //main/solenv/bin:gen_versionlist_hrc_pl)\"" +
        " \"$(execpath //main/solenv/inc:version.lst)\"" +
        " \"$(OUTS)\""
    ),
    tools = ["//main/solenv/bin:gen_versionlist_hrc_pl"],
)

# ── soreport.rc — generated by lngconvex from the .ulf + RC templates ────────
# Mirrors the dmake rule:
#   $(LNGCONVEX) -ulf crashrep.ulf -rc soreport.rc \
#                -rct rctemplate.txt -rch rcheader.txt -rcf rcfooter.txt
# Uses lngconvex_rc (custom rule) instead of genrule so that lngconvex.exe
# runs with its DLL dependencies staged alongside it (see lngconvex_bundle).
lngconvex_rc(
    name = "soreport_rc",
    out  = "soreport.rc",
    ulf  = "source/all/crashrep.ulf",
    rct  = "source/win32/rctemplate.txt",
    rch  = "source/win32/rcheader.txt",
    rcf  = "source/win32/rcfooter.txt",
)

# ── soreport.res — Windows resource binary compiled by RC.Exe ────────────────
# RC.Exe needs three include directories:
#   1. Windows SDK Include  — for <winresrc.h> and <winver.h>
#   2. main/solenv/inc      — for version.hrc and verinfo.hrc
#   3. main/crashrep/source/win32  — for resource.h (quoted include in rcheader.txt)
# versionlist.hrc (generated above) is placed in $(RULEDIR) which is added last
# so it shadows the non-existent copy in solenv/inc that version.hrc looks for.
genrule(
    name = "soreport_res",
    srcs = [
        ":soreport_rc",
        ":versionlist_hrc",
        "source/win32/resource.h",
        "//main/solenv/inc:version.hrc",
        "//main/solenv/inc:verinfo.hrc",
    ],
    outs = ["soreport.res"],
    cmd_bat = (
        "set \"_RC=C:\\Program Files\\Microsoft SDKs\\Windows\\v7.0\\Bin\\RC.Exe\"&&" +
        "set \"_SDK_INC=C:\\Program Files\\Microsoft SDKs\\Windows\\v7.0\\Include\"&&" +
        # sal.h lives in VC/include, not in the SDK — dmake inherited it via
        # the INCLUDE env var set by vcvarsall.bat; pass it explicitly here.
        "set \"_VC_INC=C:\\Program Files (x86)\\Microsoft Visual Studio 9.0\\VC\\include\"&&" +
        "set \"_SOLENV=main/solenv/inc\"&&" +
        "set \"_CR_INC=main/crashrep/source/win32\"&&" +
        # versionlist.hrc lives in $(RULEDIR); RC.exe searches /I paths in order,
        # so list $(RULEDIR) before _SOLENV so it finds the generated file.
        "\"!_RC!\" /nologo /DWIN32" +
        " /I \"$(RULEDIR)\"" +
        " /I \"!_SDK_INC!\"" +
        " /I \"!_VC_INC!\"" +
        " /I \"!_SOLENV!\"" +
        " /I \"!_CR_INC!\"" +
        " /fo \"$(OUTS)\"" +
        " \"$(execpath :soreport_rc)\""
    ),
)

_DEFINES = [
    "WNT", "WIN32", "INTEL", "_X86_=1",
    "WINVER=0x0500", "_WIN32_WINNT=0x0500", "_WIN32_IE=0x0500",
    "snprintf=_snprintf",
    "SUPD=680",
    "MSC",
    # UNICODE/_UNICODE are already #define'd inside soreport.cpp; omit here.
]

_COPTS = [
    "/Zc:wchar_t-",
    # Provides <_version.h> (empty stub; soreport.cpp includes it but uses no
    # macros from it — version info is read at runtime from version.ini).
    "/Imain/crashrep/source/win32",
    # OOo build-env platform identifier used in crash report XML (platform= attribute).
    "/D_INPATH=\\\"wntmsci9\\\"",
]

# ── crashrep.exe — Windows GUI crash reporter (= soreport.exe in dmake) ──────
# d.lst delivers soreport.exe as bin/crashrep.exe; naming the target "crashrep"
# achieves the rename without a post-build step.
# APP1NOSAL=TRUE in the dmake makefile means no SAL startup wrapper; the EXE has
# its own _tWinMain entry point and links sal.lib directly.
cc_binary(
    name = "crashrep",
    srcs = [
        "source/win32/soreport.cpp",
        "source/win32/base64.cpp",
        "source/win32/base64.h",
        "source/win32/resource.h",
        "source/win32/_version.h",
    ],
    copts = _COPTS,
    defines = _DEFINES,
    additional_linker_inputs = [
        ":soreport_res",
        "//main/sal:sal_implib",
    ],
    linkopts = [
        "$(execpath :soreport_res)",
        "$(execpath //main/sal:sal_implib)",
        "user32.lib",
        "gdi32.lib",
        "comctl32.lib",
        "comdlg32.lib",
        "advapi32.lib",
        "wsock32.lib",
        "shell32.lib",
        "dbghelp.lib",
        "psapi.lib",
        "/SUBSYSTEM:WINDOWS",
        "/MANIFEST:NO",
    ],
    deps = [
        "//main/sal:sal_headers",
        "//main/stlport:stlport",
    ],
)
