load("//build/rules:rsc_pipeline.bzl", "rename_file")

filegroup(
    name = "vcl_images",
    srcs = glob(["vcl/res/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "shared_images",
    srcs = glob(["res/*.png", "res/*.bmp"], allow_empty = True),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "minimizer_images",
    srcs = glob(["minimizer/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "presenter_images",
    srcs = glob(["presenter/**"]),
    visibility = ["//visibility:public"],
)

# editbrowsebox.src has `IMG_EBB_NEW;IMG_EBB_DELETED;IMG_EBB_CURRENTNEW;` on one
# line (no spaces).  rscpp expands it to `3;4;5;`; rsc2 strips `;` and gets the
# single string "345", which it treats as image ID 345 → looks for ed0345.png.
# Provide a placeholder so rsc2 does not abort with ERR_NOIMAGE.
rename_file(
    name = "ed0345_png",
    src  = "svtools/res/ed01.png",
    out  = "ed0345.png",
)
rename_file(
    name = "edh0345_png",
    src  = "svtools/res/edh01.png",
    out  = "edh0345.png",
)

filegroup(
    name = "svtools_res_images",
    srcs = glob(["svtools/res/**"]) + [":ed0345_png", ":edh0345_png"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "framework_res_images",
    srcs = glob(["framework/res/**"]),
    visibility = ["//visibility:public"],
)

