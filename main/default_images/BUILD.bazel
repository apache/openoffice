# ── images.zip ────────────────────────────────────────────────────────────────
# Toolbar and UI icons loaded at runtime from share/config/images.zip.
# In the dmake build this is assembled by packimages.pl using .ilst files
# generated by the RSC pipeline.  Here we take a simpler approach: zip all
# PNG/BMP images from default_images/ preserving their relative paths.
# NOTE: vcl/res/** ARE required here.  The RSC pipeline does NOT embed bitmap
# data into .res — it stores the image *filename*; VCL's BitmapEx(ResId) then
# looks that name up in images.zip at runtime (radio.png/check.png indicators,
# etc.).  vcl_res now sets images_root="main/default_images" so it bakes the
# full path "vcl/res/radio.png", which must exist as a zip entry below.
_images_srcs = glob(
    [
        "vcl/res/**/*.png",
        "vcl/res/**/*.bmp",
        "avmedia/res/**/*.png",
        "avmedia/res/**/*.bmp",
        "basctl/res/**/*.png",
        "basctl/res/**/*.bmp",
        "chart2/res/**/*.png",
        "database/**/*.png",
        "dbaccess/res/**/*.png",
        "desktop/res/**/*.png",
        "desktop/res/**/*.bmp",
        "extensions/res/**/*.png",
        "extensions/source/**/*.png",
        "formula/res/**/*.png",
        "fpicker/res/**/*.png",
        "framework/res/**/*.png",
        "framework/res/**/*.bmp",
        "introabout/**/*.png",
        "minimizer/**/*.png",
        "presenter/**/*.png",
        "reportdesign/res/**/*.png",
        "res/**/*.png",
        "res/**/*.bmp",
        "sc/res/**/*.png",
        "sd/**/*.png",
        "sd/**/*.bmp",
        "sfx2/res/**/*.png",
        "starmath/res/**/*.png",
        "svtools/res/**/*.png",
        "svtools/res/**/*.bmp",
        "svx/res/**/*.png",
        "sw/res/**/*.png",
        "sw/res/**/*.bmp",
        "sw/imglst/**/*.png",
        "xmlsecurity/res/**/*.png",
    ],
    allow_empty = True,
)

images_zip(
    name = "images",
    srcs = _images_srcs,
    strip_prefix = "main/default_images",
    visibility = ["//visibility:public"],
)
