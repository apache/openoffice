    "WNT", "GUI", "WIN32",
    "WINVER=0x0500", "_WIN32_WINNT=0x0500", "_WIN32_IE=0x0500",
    "CPPU_ENV=msci", "INTEL", "_X86_=1",
    "FULL_DESK", "SHAREDLIB", "_DLL_",
    "snprintf=_snprintf",
    "snwprintf=_snwprintf",
    "SUPD=680",
    "Z_PREFIX",
    "SYSTEM_ZLIB",
]

_COPTS = [
    "/Imain/writerfilter/inc",
    "/Imain/writerfilter/source/dmapper",
    "/Imain/writerfilter/source/doctok",
    "/Imain/writerfilter/source/filter",
    "/Imain/writerfilter/source/ooxml",
    "/Imain/writerfilter/source/resourcemodel",
    "/Zc:wchar_t-",
]

# ── doctok XSL generation ────────────────────────────────────────────────────
# All four outputs are derived from resources.xmi using different XSL stylesheets.

genrule(
    name = "gen_doctok_sprmids_hxx",
    srcs = [
        "source/doctok/sprmids.xsl",
        "source/doctok/resources.xmi",
    ],
    outs = ["doctok/sprmids.hxx"],
    tools = ["@libxslt//:xsltproc"],
    cmd_bat = (
        "$(location @libxslt//:xsltproc) --novalid " +
        "\"$(location source/doctok/sprmids.xsl)\" " +
        "\"$(location source/doctok/resources.xmi)\" > \"$@\""
    ),
)

genrule(
    name = "gen_doctok_resourceids_hxx",
    srcs = [
        "source/doctok/resourceids.xsl",
        "source/doctok/resources.xmi",
        "source/doctok/resourcetools.xsl",
    ],
    outs = ["doctok/resourceids.hxx"],
    tools = ["@libxslt//:xsltproc"],
    cmd_bat = (
        "$(location @libxslt//:xsltproc) --novalid " +
        "\"$(location source/doctok/resourceids.xsl)\" " +
        "\"$(location source/doctok/resources.xmi)\" > \"$@\""
    ),
)

genrule(
    name = "gen_doctok_resources_hxx",
    srcs = [
        "source/doctok/resources.xsl",
        "source/doctok/resources.xmi",
        "source/doctok/resourcetools.xsl",
    ],
    outs = ["doctok/resources.hxx"],
    tools = ["@libxslt//:xsltproc"],
    cmd_bat = (
        "$(location @libxslt//:xsltproc) --novalid " +
        "\"$(location source/doctok/resources.xsl)\" " +
        "\"$(location source/doctok/resources.xmi)\" > \"$@\""
    ),
)

genrule(
    name = "gen_resources_cxx",
    srcs = [
        "source/doctok/resourcesimpl.xsl",
        "source/doctok/resources.xmi",
        "source/doctok/resourcetools.xsl",
    ],
    outs = ["resources.cxx"],
    tools = ["@libxslt//:xsltproc"],
    cmd_bat = (
        "$(location @libxslt//:xsltproc) --novalid " +
        "\"$(location source/doctok/resourcesimpl.xsl)\" " +
        "\"$(location source/doctok/resources.xmi)\" > \"$@\""
    ),
