# ── OOXML model preprocessing ────────────────────────────────────────────────
# Step 1: perl namespace_preprocess.pl namespaces.txt > namespacesmap.xsl
#         (namespacesmap.xsl includes ./modelpreprocess.xsl)
# Step 2: copy modelpreprocess.xsl alongside namespacesmap.xsl
# Step 3: xsltproc namespacesmap.xsl model.xml > model_preprocessed.xml

genrule(
    name = "gen_model_preprocessed",
    srcs = [
        "source/ooxml/model.xml",
        "source/ooxml/modelpreprocess.xsl",
        "source/resourcemodel/namespace_preprocess.pl",
        # indexed format (numeric-id name url) required by namespace_preprocess.pl;
        # generated by oox namespaces.pl mode 3 from the raw namespaces.txt
        "//main/oox:oox_namespaces_indexed_txt",
    ],
    outs = ["model_preprocessed.xml"],
    tools = ["@libxslt//:xsltproc"],
    cmd_bat = (
        "perl \"$(location source/resourcemodel/namespace_preprocess.pl)\" " +
        "\"$(location //main/oox:oox_namespaces_indexed_txt)\" > \"$(@D)\\namespacesmap.xsl\" && " +
        "copy \"$(location source/ooxml/modelpreprocess.xsl)\" " +
        "\"$(@D)\\modelpreprocess.xsl\" > nul && " +
        "$(location @libxslt//:xsltproc) --novalid " +
        "\"$(@D)\\namespacesmap.xsl\" " +
        "\"$(location source/ooxml/model.xml)\" > \"$@\""
    ),
)

# ── OOXML resource IDs header ────────────────────────────────────────────────

genrule(
    name = "gen_ooxml_resourceids_hxx",
    srcs = [
        "source/ooxml/resourceids.xsl",
        ":gen_model_preprocessed",
        "source/ooxml/factorytools.xsl",
    ],
    outs = ["ooxml/resourceids.hxx"],
    tools = ["@libxslt//:xsltproc"],
    cmd_bat = (
        "$(location @libxslt//:xsltproc) --novalid " +
        "\"$(location source/ooxml/resourceids.xsl)\" " +
        "\"$(location :gen_model_preprocessed)\" > \"$@\""
    ),
)

# ── OOXML OOXMLFactory_generated.hxx/.cxx ────────────────────────────────────
# factoryinc.xsl → OOXMLFactory_generated.hxx
# factoryimpl.xsl → OOXMLFactory_generated.cxx

genrule(
    name = "gen_ooxml_factory_generated",
    srcs = [
        "source/ooxml/factoryinc.xsl",
        "source/ooxml/factoryimpl.xsl",
        "source/ooxml/factorytools.xsl",
        ":gen_model_preprocessed",
    ],
    outs = [
        "OOXMLFactory_generated.hxx",
        "OOXMLFactory_generated.cxx",
    ],
    tools = ["@libxslt//:xsltproc"],
    cmd_bat = (
        "$(location @libxslt//:xsltproc) --novalid " +
        "\"$(location source/ooxml/factoryinc.xsl)\" " +
        "\"$(location :gen_model_preprocessed)\" " +
        "> \"$(location OOXMLFactory_generated.hxx)\" && " +
        "$(location @libxslt//:xsltproc) --novalid " +
        "\"$(location source/ooxml/factoryimpl.xsl)\" " +
        "\"$(location :gen_model_preprocessed)\" " +
        "> \"$(location OOXMLFactory_generated.cxx)\""
    ),
)

# ── OOXML OOXMLFactory_values.hxx/.cxx ───────────────────────────────────────

genrule(
    name = "gen_ooxml_factory_values",
    srcs = [
        "source/ooxml/factory_values.xsl",
        "source/ooxml/factoryimpl_values.xsl",
        "source/ooxml/factorytools.xsl",
        ":gen_model_preprocessed",
    ],
    outs = [
        "OOXMLFactory_values.hxx",
        "OOXMLFactory_values.cxx",
    ],
    tools = ["@libxslt//:xsltproc"],
    cmd_bat = (
        "$(location @libxslt//:xsltproc) --novalid " +
        "\"$(location source/ooxml/factory_values.xsl)\" " +
        "\"$(location :gen_model_preprocessed)\" " +
        "> \"$(location OOXMLFactory_values.hxx)\" && " +
        "$(location @libxslt//:xsltproc) --novalid " +
        "\"$(location source/ooxml/factoryimpl_values.xsl)\" " +
        "\"$(location :gen_model_preprocessed)\" " +
        "> \"$(location OOXMLFactory_values.cxx)\""
    ),
)

# ── token.xml (wraps oox tokens.txt in <fasttoken> XML) ──────────────────────
# token.tmp: sed "s/\(.*\)/<fasttoken>\1<\/fasttoken>/" tokens.txt
# token.xml: tokenxmlheader + token.tmp + tokenxmlfooter
# Perl reads the file via 3-arg open to avoid shell redirection of < and >.

genrule(
    name = "gen_token_xml",
    srcs = [
        "//main/oox:oox_tokens_txt",
        "source/ooxml/tokenxmlheader",
        "source/ooxml/tokenxmlfooter",
    ],
    outs = ["token.xml"],
    cmd_bat = (
        "type \"$(location source/ooxml/tokenxmlheader)\" > \"$@\" && " +
        "perl -e \"open(my $$h,'<','$(location //main/oox:oox_tokens_txt)') or die; " +
        "while(<$$h>){chomp; print '<fasttoken>' . $$_ . '</fasttoken>' . chr(10);} " +
        "close $$h;\" >> \"$@\" && " +
        "type \"$(location source/ooxml/tokenxmlfooter)\" >> \"$@\""
    ),
)

# ── ooxml/OOXMLFastTokens.hxx ────────────────────────────────────────────────

genrule(
    name = "gen_ooxml_fasttokens_hxx",
    srcs = [
        "source/ooxml/fasttokens.xsl",
        ":gen_token_xml",
    ],
    outs = ["ooxml/OOXMLFastTokens.hxx"],
    tools = ["@libxslt//:xsltproc"],
    cmd_bat = (
        "$(location @libxslt//:xsltproc) --novalid " +
        "\"$(location source/ooxml/fasttokens.xsl)\" " +
        "\"$(location :gen_token_xml)\" > \"$@\""
    ),
)

# ── ooxml/OOXMLnamespaceids.hxx ──────────────────────────────────────────────

genrule(
    name = "gen_ooxml_namespaceids_hxx",
    srcs = [
        "source/ooxml/namespaceids.xsl",
        ":gen_model_preprocessed",
    ],
    outs = ["ooxml/OOXMLnamespaceids.hxx"],
    tools = ["@libxslt//:xsltproc"],
    cmd_bat = (
        "$(location @libxslt//:xsltproc) --novalid " +
        "\"$(location source/ooxml/namespaceids.xsl)\" " +
        "\"$(location :gen_model_preprocessed)\" > \"$@\""
    ),
)

# ── gperffasttoken.hxx ───────────────────────────────────────────────────────
# xsltproc gperffasttokenhandler.xsl model_preprocessed.xml | gperf flags

genrule(
    name = "gen_gperffasttoken_hxx",
    srcs = [
        "source/ooxml/gperffasttokenhandler.xsl",
        ":gen_model_preprocessed",
    ],
    outs = ["gperffasttoken.hxx"],
    tools = [
        "@libxslt//:xsltproc",
        "@gperf//:gperf",
    ],
    cmd_bat = (
        "$(location @libxslt//:xsltproc) --novalid " +
        "\"$(location source/ooxml/gperffasttokenhandler.xsl)\" " +
        "\"$(location :gen_model_preprocessed)\" > \"$(@D)\\gperffasttoken.gperf\" && " +
        "$(location @gperf//:gperf) -I -t -E -S1 -c -G -LC++ " +
        "\"$(@D)\\gperffasttoken.gperf\" > \"$@\""
    ),
)

# ── qnametostr.cxx ───────────────────────────────────────────────────────────
# = qnametostrheader + OOXMLqnameToStr.tmp + DOCTOKqnameToStr.tmp + footer

genrule(
    name = "gen_qnametostr_cxx",
    srcs = [
        "source/ooxml/qnametostr.xsl",
        "source/doctok/qnametostr.xsl",
        "source/doctok/resources.xmi",
        "source/resourcemodel/qnametostrheader",
        "source/resourcemodel/qnametostrfooter",
        ":gen_model_preprocessed",
    ],
    outs = ["qnametostr.cxx"],
    tools = ["@libxslt//:xsltproc"],
    cmd_bat = (
        "$(location @libxslt//:xsltproc) --novalid " +
        "\"$(location source/ooxml/qnametostr.xsl)\" " +
        "\"$(location :gen_model_preprocessed)\" > \"$(@D)\\ooxml_qnametostr.tmp\" && " +
        "$(location @libxslt//:xsltproc) --novalid " +
        "\"$(location source/doctok/qnametostr.xsl)\" " +
        "\"$(location source/doctok/resources.xmi)\" > \"$(@D)\\doctok_qnametostr.tmp\" && " +
        "copy /y " +
        "\"$(location source/resourcemodel/qnametostrheader)\"+" +
        "\"$(@D)\\ooxml_qnametostr.tmp\"+" +
        "\"$(@D)\\doctok_qnametostr.tmp\"+" +
        "\"$(location source/resourcemodel/qnametostrfooter)\" " +
        "\"$@\" > nul"
    ),
)

# ── sprmcodetostr.cxx ─────────────────────────────────────────────────────────
# = sprmcodetostrheader + sprmcodetostr.tmp + footer

genrule(
    name = "gen_sprmcodetostr_cxx",
    srcs = [
        "source/doctok/sprmcodetostr.xsl",
        "source/doctok/resources.xmi",
        "source/resourcemodel/sprmcodetostrheader",
        "source/resourcemodel/sprmcodetostrfooter",
    ],
    outs = ["sprmcodetostr.cxx"],
    tools = ["@libxslt//:xsltproc"],
    cmd_bat = (
        "$(location @libxslt//:xsltproc) --novalid " +
        "\"$(location source/doctok/sprmcodetostr.xsl)\" " +
        "\"$(location source/doctok/resources.xmi)\" > \"$(@D)\\sprmcodetostr.tmp\" && " +
        "copy /y " +
        "\"$(location source/resourcemodel/sprmcodetostrheader)\"+" +
        "\"$(@D)\\sprmcodetostr.tmp\"+" +
        "\"$(location source/resourcemodel/sprmcodetostrfooter)\" " +
        "\"$@\" > nul"
    ),
)

# ── OOXMLFactory_<ns>.cxx and .hxx (one genrule per namespace) ───────────────
# Generates gen_ooxml_factory_<safe_ns>_cxx and _hxx targets for all 24 namespaces.
# The macro is in ooxml_ns_rules.bzl because top-level for loops are forbidden
# in BUILD files.

ooxml_ns_factory_rules()

# ── Generated headers library ─────────────────────────────────────────────────
# includes = [".", "ooxml", "doctok"] provides three include search roots:
#   bazel-bin/main/writerfilter/            for OOXMLFactory_generated.hxx,
#                                               gperffasttoken.hxx,
#                                               OOXMLFactory_<ns>.hxx,
#                                               <ooxml/...>, <doctok/...>
#   bazel-bin/main/writerfilter/ooxml/      for "OOXMLnamespaceids.hxx",
#                                               "OOXMLFastTokens.hxx",
#                                               "resourceids.hxx" in generated .cxx
#   bazel-bin/main/writerfilter/doctok/     for "resources.hxx" in doctok sources

cc_library(
    name = "writerfilter_gen_headers",
    hdrs = [
        ":gen_doctok_sprmids_hxx",
        ":gen_doctok_resourceids_hxx",
        ":gen_doctok_resources_hxx",
        ":gen_ooxml_resourceids_hxx",
        # Only the .hxx outputs from dual-output genrules
        ":OOXMLFactory_generated.hxx",
        ":OOXMLFactory_values.hxx",
        ":gen_ooxml_fasttokens_hxx",
        ":gen_ooxml_namespaceids_hxx",
        ":gen_gperffasttoken_hxx",
    ] + [
        ":gen_ooxml_factory_%s_hxx" % _ns.replace("-", "_")
        for _ns in OOXML_NS
    ],
    includes = ["..", ".", "ooxml", "doctok"],
    visibility = ["//visibility:public"],
)

# ── Public headers ────────────────────────────────────────────────────────────

cc_library(
    name = "writerfilter_headers",
    hdrs = glob(["inc/**/*.hxx"]),
    strip_include_prefix = "inc",
    deps = [
        ":writerfilter_gen_headers",
        "//main/sal:sal_headers",
        "//main/cppu:cppu_headers",
        "//main/cppuhelper:cppuhelper_headers",
        "//main/udkapi:udkapi_idl_headers",
        "//main/offapi:offapi_idl_headers",
        "//main/oox:oox_headers",
        "//main/tools:tools_headers",
        "//main/i18npool:i18npool_headers",
        "//main/sot:sot_headers",
        "//main/stlport:stlport",
        "@boost.legacy//:boost.legacy",
    ],
    visibility = ["//visibility:public"],
)

# ── writerfilter.dll ──────────────────────────────────────────────────────────
# Document format import/export DLL: .doc (doctok), .docx (ooxml), .rtf
# Registered as UNO component providing WriterFilter, WriterFilterDetection,
# and RtfFilter services.

cc_binary(
    name = "writerfilter",
    srcs = glob([
        "source/dmapper/*.cxx",
        "source/dmapper/*.hxx",
        "source/doctok/*.cxx",
        "source/doctok/*.hxx",
        "source/filter/*.cxx",
        "source/filter/*.hxx",
        "source/ooxml/*.cxx",
        "source/ooxml/*.hxx",
        "source/resourcemodel/*.cxx",
        "source/resourcemodel/*.hxx",
        "source/rtftok/*.cxx",
    ]) + [
        ":gen_resources_cxx",
        # Only the .cxx outputs from dual-output genrules
        ":OOXMLFactory_generated.cxx",
        ":OOXMLFactory_values.cxx",
        ":gen_qnametostr_cxx",
        ":gen_sprmcodetostr_cxx",
    ] + [
        ":gen_ooxml_factory_%s_cxx" % _ns.replace("-", "_")
        for _ns in OOXML_NS
    ],
    copts = _COPTS,
    defines = _DEFINES + ["WRITERFILTER_DLLIMPLEMENTATION"],
    linkshared = True,
    win_def_file = "util/writerfilter.def",
    deps = [
        ":writerfilter_headers",
        "//main/stlport:stlport",
        "@boost.legacy//:boost.legacy",
    ],
    additional_linker_inputs = [
        "//main/oox:oox_implib",
        "//main/sal:sal_implib",
        "//main/cppu:cppu3_implib",
        "//main/cppuhelper:cppuhelper_implib",
        "//main/comphelper:comphelpMSC_implib",
        "//main/tools:tl_implib",
        "//main/unotools:utl_implib",
        "//main/sot:sot_implib",
        "//main/i18npool:i18nisolang1MSC_implib",
        "//main/i18npool:i18npaper_implib",
    ],
    linkopts = [
        "$(execpath //main/oox:oox_implib)",
        "$(execpath //main/sal:sal_implib)",
        "$(execpath //main/cppu:cppu3_implib)",
        "$(execpath //main/cppuhelper:cppuhelper_implib)",
        "$(execpath //main/comphelper:comphelpMSC_implib)",
        "$(execpath //main/tools:tl_implib)",
        "$(execpath //main/unotools:utl_implib)",
        "$(execpath //main/sot:sot_implib)",
        "$(execpath //main/i18npool:i18nisolang1MSC_implib)",
        "$(execpath //main/i18npool:i18npaper_implib)",
        "kernel32.lib", "user32.lib", "advapi32.lib",
        "ole32.lib", "oleaut32.lib", "shell32.lib",
        "/MANIFEST:NO",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "writerfilter_implib",
    srcs = [":writerfilter"],
    output_group = "interface_library",
    visibility = ["//visibility:public"],
)

