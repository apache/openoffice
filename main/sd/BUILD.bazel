package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//build/rules:rsc_pipeline.bzl", "rsc_res")
load("//build/rules:sdi_target.bzl", "sdi_target")

_DEFINES = [
    "WNT", "GUI", "WIN32",
    "WINVER=0x0500", "_WIN32_WINNT=0x0500", "_WIN32_IE=0x0500",
    "CPPU_ENV=msci", 
    "FULL_DESK", "SHAREDLIB", "_DLL_",
    "snprintf=_snprintf",
    "snwprintf=_snwprintf",
    "SUPD=680",
    "MSC",
]

_COPTS = [
    "/Imain/sd/inc",
    "/Imain/sd/inc/pch",
    "/Imain/sd/inc/helper",
    "/Imain/sd/inc/undo",
    "/Imain/sd/sdi",
    "/Imain/sd/source/ui/inc",
    "/Imain/sd/source/ui/inc/framework",
    "/Imain/sd/source/ui/inc/taskpane",
    "/Imain/sd/source/ui/inc/view",
    "/Imain/sd/source/ui/inc/tools",
    "/Imain/sd/source/ui/slidesorter/inc",
    "/Imain/sd/source/ui/slideshow",
    "/Imain/sd/source/ui/unoidl",
    "/Zc:wchar_t-",
]

# ── Public headers ────────────────────────────────────────────────────────────
cc_library(
    name = "sd_headers",
    hdrs = glob(["inc/**"]),
    strip_include_prefix = "inc",
    deps = [
        "//main/sal:sal_headers",
        "//main/cppu:cppu_headers",
        "//main/cppuhelper:cppuhelper_headers",
        "//main/udkapi:udkapi_idl_headers",
        "//main/offapi:offapi_idl_headers",
        "//main/tools:tools_headers",
        "//main/unotools:unotools_headers",
        "//main/comphelper:comphelper_headers",
        "//main/svl:svl_headers",
        "//main/sot:sot_headers",
        "//main/vcl:vcl_headers",
        "//main/svtools:svtools_headers",
        "//main/basegfx:basegfx_headers",
        "//main/editeng:editeng_headers",
        "//main/sfx2:sfx2_headers",
        "//main/svx:svx_headers",
        "//main/drawinglayer:drawinglayer_headers",
        "//main/animations:animations_headers",
        "//main/avmedia:avmedia_headers",
        "//main/filter:filter_msfilter_headers",
        "//main/canvas:canvas_headers",
        "//main/cppcanvas:cppcanvas_headers",
        "//main/basic:basic_headers",
        "//main/vos:vos_headers",
        "//main/ucbhelper:ucbhelper_headers",
        "//main/salhelper:salhelper_headers",
        "//main/stlport:stlport",
        "@boost.legacy//:boost.legacy",
    ],
    visibility = ["//visibility:public"],
)

# ── Private source-tree headers ───────────────────────────────────────────────
cc_library(
    name = "sd_source_ui_inc",
    textual_hdrs = glob(["source/ui/inc/**"]),
    strip_include_prefix = "source/ui/inc",
)

cc_library(
    name = "sd_slidesorter_inc",
    textual_hdrs = glob(["source/ui/slidesorter/inc/**"]),
    strip_include_prefix = "source/ui/slidesorter/inc",
)

cc_library(
    name = "sd_source_hdrs",
    textual_hdrs = glob(
        [
            "source/**/*.hxx",
            "source/**/*.hrc",
            "sdi/*.hrc",
        ],
        exclude = [
            "source/ui/inc/**",
            "source/ui/slidesorter/inc/**",
        ],
    ),
)

# ── SDI slot header generation ────────────────────────────────────────────────
sdi_target(
    name = "sdslots_sdi",
    main_sdi  = "sdi/sdslots.sdi",
    exports   = "sdi/sdraw.sdi",
    srcs      = glob(["sdi/*.sdi", "sdi/*.hrc", "inc/*.hrc"]),
    slot_name = "sdslots",
    include_dirs = [
        "main/sd/sdi",
        "main/sd/inc",
        "main/sfx2/sdi",
        "main/sfx2/inc/sfx2",
        "main/sfx2/inc",
        "main/svx/sdi",
        "main/svx/inc",
        "main/svl/inc",
        "main/editeng/inc",
    ],
    pkg_deps = [
        "//main/sfx2:sfx2_sdi_pkg",
        "//main/svx:svx_sdi_pkg",
    ],
)

cc_library(
    name = "sdslots_headers",
    hdrs     = [":sdslots_sdi"],
    includes = ["sdslots_sdi_inc"],
    visibility = ["//visibility:public"],
)

sdi_target(
    name = "sdgslots_sdi",
    main_sdi  = "sdi/sdgslots.sdi",
    exports   = "sdi/sdraw.sdi",
    srcs      = glob(["sdi/*.sdi", "sdi/*.hrc", "inc/*.hrc"]),
    slot_name = "sdgslots",
    include_dirs = [
        "main/sd/sdi",
        "main/sd/inc",
        "main/sfx2/sdi",
        "main/sfx2/inc/sfx2",
        "main/sfx2/inc",
        "main/svx/sdi",
        "main/svx/inc",
        "main/svl/inc",
        "main/editeng/inc",
    ],
    pkg_deps = [
        "//main/sfx2:sfx2_sdi_pkg",
        "//main/svx:svx_sdi_pkg",
    ],
)

cc_library(
    name = "sdgslots_headers",
    hdrs     = [":sdgslots_sdi"],
    includes = ["sdgslots_sdi_inc"],
    visibility = ["//visibility:public"],
)

# Common deps shared by sd, sdui, sdfilt
_SD_DEPS = [
    ":sd_headers",
    ":sdslots_headers",
    ":sdgslots_headers",
    ":sd_source_ui_inc",
    ":sd_slidesorter_inc",
    ":sd_source_hdrs",
    "//main/stlport:stlport",
    "@boost.legacy//:boost.legacy",
]

# ── sdd.dll — format detector ─────────────────────────────────────────────────
cc_binary(
    name = "sdd",
    srcs = [
        "source/filter/sddetect.cxx",
    ],
    copts = [
        "/Imain/sd/inc",
        "/Imain/sd/inc/pch",
        "/Zc:wchar_t-",
    ],
    defines = _DEFINES,
    linkshared = True,
    deps = [
        ":sd_headers",
        "//main/stlport:stlport",
    ],
    additional_linker_inputs = [
        "//main/sal:sal_implib",
        "//main/cppu:cppu3_implib",
        "//main/cppuhelper:cppuhelper_implib",
        "//main/comphelper:comphelpMSC_implib",
        "//main/tools:tl_implib",
        "//main/unotools:utl_implib",
        "//main/svl:svl_implib",
        "//main/svtools:svt_implib",
        "//main/vcl:vcl_implib",
        "//main/ucbhelper:ucbhelperMSC_implib",
        "//main/sot:sot_implib",
        "//main/sfx2:sfx_implib",
    ],
    linkopts = [
        "$(execpath //main/sal:sal_implib)",
        "$(execpath //main/cppu:cppu3_implib)",
        "$(execpath //main/cppuhelper:cppuhelper_implib)",
        "$(execpath //main/comphelper:comphelpMSC_implib)",
        "$(execpath //main/tools:tl_implib)",
        "$(execpath //main/unotools:utl_implib)",
        "$(execpath //main/svl:svl_implib)",
        "$(execpath //main/svtools:svt_implib)",
        "$(execpath //main/vcl:vcl_implib)",
        "$(execpath //main/ucbhelper:ucbhelperMSC_implib)",
        "$(execpath //main/sot:sot_implib)",
        "$(execpath //main/sfx2:sfx_implib)",
        "ole32.lib", "user32.lib", "advapi32.lib",
        "/MANIFEST:NO",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sdd_implib",
    srcs  = [":sdd"],
    output_group = "interface_library",
    visibility = ["//visibility:public"],
)

