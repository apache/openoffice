exports_files(["classic/classic_images.tar.gz"])

# images_industrial.zip is //main/packimages:images_industrial -- a complete
# set, these overrides merged over default_images.

# The industrial theme's own images, for //main/packimages (which merges them
# over default_images into a complete images_industrial.zip).
filegroup(
    name = "industrial_png",
    srcs = glob(["industrial/**/*.png"]),
    visibility = ["//visibility:public"],
)

# ── nologo intro screen ───────────────────────────────────────────────────────
# Single intro.png for builds without the OOo logo splash screen.
filegroup(
    name = "nologo_intro",
    srcs = glob(["nologo/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "dev_nologo_intro",
    srcs = glob(["dev_nologo/**"]),
    visibility = ["//visibility:public"],
)

# classic_images.tar.gz is a pre-packaged archive; extraction and conversion to
# images_classic.zip requires a tar + zip step.  Deferred until packimages is
# fully migrated.
filegroup(
    name = "classic_images_tar",
    srcs = ["classic/classic_images.tar.gz"],
    visibility = ["//visibility:public"],
)
