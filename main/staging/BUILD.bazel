# ── Profile INI files (equivalent to scp2-generated profiles in dmake) ────────
# All ini files land in program/ alongside the DLLs and EXEs.
filegroup(
    name = "profile_ini",
    srcs = [
        "bootstrap.ini",
        "fundamental.ini",
        "soffice.ini",
        "uno.ini",
    ],
)

# ── Debug-mode application manifest ──────────────────────────────────────────
# When --compilation_mode=dbg, toolchain uses /MDd which requires MSVCR90D.dll.
# Without an EXE manifest, Windows can't activate the debug CRT SxS assembly
# and raises R6034.  This manifest declares Microsoft.VC90.DebugCRT as a
# private assembly dependency so Windows resolves it from program/ instead of
# WinSxS (which doesn't carry the debug CRT on non-developer machines).
# Must be paired with Microsoft.VC90.DebugCRT.manifest (from @msvc_debug_crt).
filegroup(
    name = "soffice_exe_manifest",
    srcs = [
        # EXE application manifest — declares Microsoft.VC90.DebugCRT dependency.
        "soffice.exe.manifest",
        # Private SxS assembly manifest — tells Windows to resolve msvcr90d.dll
        # and msvcp90d.dll from program\ rather than WinSxS.
        "Microsoft.VC90.DebugCRT.manifest",
    ],
)

