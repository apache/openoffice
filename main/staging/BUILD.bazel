    name = "_install_registry",
    src  = "//main/postprocess:all_xcd",
    strip_prefix = "main/postprocess",
    dst  = "share/registry",
)

# ── share/setup — scp2 installer script ──────────────────────────────────────
# setup_osl.inf is consumed by instsetoo_native (still deferred) to produce the
# Windows MSI installer.  Staged here so the artifact is reachable alongside the
# rest of the install layout.
tree_install(
    name = "_install_scp2",
    src  = "//main/scp2:setup_osl",
    strip_prefix = "main/scp2/setup",
    dst  = "share/setup",
)

# ── program/resource/ — OOo binary resource (.res) files ────────────────────
# ResMgrContainer::init() scans $OOO_BASE_DIR/program/resource/ on startup.
# Files must be named <prefix><lang>-<country>.res (e.g. vclen-US.res).
# Prefix comes from CreateResMgr("vcl",...) calls in each module.
res_stage(
    name = "_install_resources",
    res_files = RES_BUNDLES,
)

