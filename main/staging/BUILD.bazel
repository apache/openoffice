        ":_install_presets_autotext",
        ":_install_presets_config",
        ":_install_presets_basic",
        ":_install_presets_basic_standard",
        ":_install_basic_index",
        ":_install_basic_depot",
        ":_install_basic_euro",
        ":_install_basic_formwizard",
        ":_install_basic_gimmicks",
        ":_install_basic_importwizard",
        ":_install_basic_schedule",
        ":_install_basic_template",
        ":_install_basic_tools",
        ":_install_basic_tutorials",
        ":_install_basic_scriptbinding",
        ":_install_images_zips",
        ":_install_uiconfig",
        ":_install_classes",
        ":_install_xslt",
        ":_install_xslt_odf2xhtml",
        ":_install_xslt_docbook",
        ":_install_help",
        ":_install_helpxsl",
        ":_install_java_config",
        ":_install_python_scripts",
        # The Python stdlib tree is NOT optional: pythonloader.dll calls
        # Py_Initialize(), and CPython exit()s the process if it cannot find
        # its stdlib.  Anything that instantiates com.sun.star.loader.Python
        # (Tools > Macros, script-provider enumeration) would kill soffice.
        ":install_python_lib",
        ":install_python_pyds",
        ":install_python_bin",
    ],
    visibility = ["//visibility:public"],
)

# ── Python standard library tree → program/python-core-<ver>/lib/ ───────────
# Strip the "Lib" prefix so "Lib/abc.py" → "python-core-<ver>/lib/abc.py".
tree_install(
    name = "install_python_lib",
    src          = "@python//:python_lib",
    strip_prefix = "Lib",
    dst          = "program/python-core-%s/lib" % PYTHON_VERSION,
)

# ── CPython extension modules → program/python-core-<ver>/lib/*.pyd ─────────
# _socket, select, pyexpat, unicodedata, ... -- the stdlib modules written in
# C that are not built into python311.dll.  lib/ is on sys.path, which is
# where trunk's d.lst delivers them too.
tree_install(
    name = "install_python_pyds",
    src     = "@python//:python_pyds",
    flatten = True,
    dst     = "program/python-core-%s/lib" % PYTHON_VERSION,
)

# ── CPython → python-core-<ver>/bin/python.exe ──────────────────────────────
# The real interpreter, run by the program/python.exe launcher.  It finds
# python311.dll in program/, which the launcher puts first on PATH.
tree_install(
    name = "install_python_bin",
    src     = "@python//:python",
    flatten = True,
    dst     = "program/python-core-%s/bin" % PYTHON_VERSION,
)

# ── install_all: kept as an alias for :install ────────────────────────────────
# The python-core tree used to live only here; it is now part of :install itself
# (see above), so the two are identical.  Retained so existing invocations and
# docs referring to //main/staging:install_all keep working.
filegroup(
    name = "install_all",
    srcs = [":install"],
)
