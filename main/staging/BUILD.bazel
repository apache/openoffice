tree_install(
    name = "install_python_bin",
    src          = "@python//:python",
    strip_prefix = "",
    dst          = "program/python-core-2.7.18/bin",
)

# ── install_all: build everything in one shot ─────────────────────────────────
filegroup(
    name = "install_all",
    srcs = [
        ":install",
        ":install_python_lib",
        ":install_python_bin",
    ],
)
