    name = "install_python_lib",
    src          = "@python//:python_lib",
    strip_prefix = "Lib",
    dst          = "program/python-core-2.7.18/lib",
)

# ── python.exe inside the core tree → python-core-2.7.18/bin/python.exe ──────
