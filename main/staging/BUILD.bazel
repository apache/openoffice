        # ATL-gated modules (VS Professional/Enterprise only; not Express/BuildTools).
        # Enable with:  build --//build:atl_available=True  in user.bazelrc
        "//build:has_atl": [
            "//main/embedserv:emser",
            "//main/embedserv:inprocserv",
            "//main/winaccessibility:uacccom",
            "//main/winaccessibility:winaccessibility",
        ],
        "//conditions:default": [],
