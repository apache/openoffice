flat_install(
    name = "install",
    srcs = [":all_files"],
    install_pdb = select({
        # Stage .pdb debug-info files alongside DLLs/EXEs.
        # Also requires --compilation_mode=dbg (or --features=generate_pdb_file)
        # so the toolchain actually produces PDB files.
        # Enable with:  build --//build:debug_info=True --compilation_mode=dbg
        "//build:has_debug": True,
        "//conditions:default": False,
    }),
)

# ── Python standard library tree → program/python-core-2.7.18/lib/ ───────────
# Strip the "Lib" prefix so "Lib/abc.py" → "python-core-2.7.18/lib/abc.py".
tree_install(
    name = "install_python_lib",
    src          = "@python//:python_lib",
    strip_prefix = "Lib",
    dst          = "program/python-core-2.7.18/lib",
)

# ── python.exe inside the core tree → python-core-2.7.18/bin/python.exe ──────
# Same binary as in program/ root; installed again under the versioned tree.
tree_install(
    name = "install_python_bin",
    src          = "@python//:python",
    strip_prefix = "",
    dst          = "program/python-core-2.7.18/bin",
)

# ── install_all: build everything in one shot ─────────────────────────────────
filegroup(
    name = "install_all",
    srcs = [
        ":install",
        ":install_python_lib",
        ":install_python_bin",
    ],
)
