load("//main/staging:collect_files_aspect.bzl", "collect_outputs", "flat_install", "tree_install")

# ── Profile INI files (equivalent to scp2-generated profiles in dmake) ────────
# All ini files land in program/ alongside the DLLs and EXEs.
filegroup(
    name = "profile_ini",
    srcs = [
        "bootstrap.ini",
        "fundamental.ini",
        "soffice.ini",
        "uno.ini",
    ],
)

