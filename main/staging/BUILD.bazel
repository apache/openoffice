load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@product_info//:defs.bzl", "PRODUCT_BASE_VERSION", "PRODUCT_KEY", "PRODUCT_USERDIR_VERSION", "PRODUCT_VERSION")
load("//main/staging:res_bundles.bzl", "RES_BUNDLES")
load("//main/staging:collect_files_aspect.bzl", "collect_outputs", "flat_install", "res_stage", "tree_install")
load("//main/pyuno:python_version.bzl", "PYTHON_VERSION")

# ── program/version.ini ───────────────────────────────────────────────────────
# scp2's gid_Brand_Profile_Version_Ini (common_brand.scp), the [Version] keys
# that are a pure function of the product version: openoffice.lst sets
# OOOBASEVERSION to <major>.<minor> and OOOPACKAGEVERSION to the full version,
# which here is MODULE.bazel's module(version).  The extension manager checks
# every extension's OpenOffice.org-minimal/maximal-version dependency against
# exactly these two (dp_dependencies.cxx), and the update dialogs read the
# second.  Without the file both expand to "", so EVERY extension declaring a
# version range -- the Wiki Publisher, for one -- is refused with "unsatisfied
# dependencies".
# Not written: buildid, ProductCode, UpgradeCode, UpdateID, MsiProductVersion
# and the other installer-time values; they are release identity, which this
# build does not invent (see the frontier's release-identity item).
write_file(
    name = "version_ini",
    out = "version.ini",
    content = [
        "[Version]",
        "OOOBaseVersion=" + PRODUCT_BASE_VERSION,
        "OOOPackageVersion=" + PRODUCT_VERSION,
        "",
    ],
)

# ── program/pythonloader.uno.ini ──────────────────────────────────────────────
# Read by pyuno/source/loader/pyuno_loader.cxx CreateInstance() from
# $OOO_BASE_DIR/program/pythonloader.uno.ini (SAL_CONFIGFILE("pythonloader.uno")).
# Both keys MUST be set before Py_Initialize(); without them CPython finds no
# stdlib (no os.py/encodings), calls Py_FatalError and exit()s the whole
# soffice process the instant com.sun.star.loader.Python is instantiated.
#
# Equivalent of scp2/source/python/profileitem_python.scp (WNT, non-gcc
# branch).  PYTHONPATH entries are space-separated file URLs; the loader
# converts each to a system path and joins them with ';'.  The extension
# modules (.pyd) are in lib/ itself (:install_python_pyds), so the lib/ entry
# covers them.  Generated so the python-core-<ver> name has one source,
# //main/pyuno:python_version.bzl.
write_file(
    name = "pythonloader_uno_ini",
    out = "pythonloader.uno.ini",
    content = [
        "[Bootstrap]",
        "PYUNO_LOADER_PYTHONHOME=$ORIGIN/python-core-" + PYTHON_VERSION,
        "PYUNO_LOADER_PYTHONPATH=" + " ".join([
            "$ORIGIN/python-core-%s/lib" % PYTHON_VERSION,
            "$ORIGIN/python-core-%s/lib/site-packages" % PYTHON_VERSION,
            "$ORIGIN",
        ]),
        "",
    ],
)

# ── program/bootstrap.ini, program/fundamental.ini ───────────────────────────
# The version-derived keys come from @product_info, as scp2 fills them from
# openoffice.lst: ProductKey is scriptitems.pm's "<PRODUCTNAME> <PRODUCTVERSION>"
# (both files), and the profile folder is common_brand.scp's
# $SYSUSERCONFIG/<name>/<USERDIRPRODUCTVERSION> -- with a "bazel" suffix, so a
# staged build never shares a profile with an installed office.
_PRODUCT_SUBSTITUTIONS = {
    "@PRODUCTKEY@": PRODUCT_KEY,
    "@USERDIRPRODUCTVERSION@": PRODUCT_USERDIR_VERSION,
}

[
    expand_template(
        name = ini + "_ini",
        out = ini + ".ini",
        substitutions = _PRODUCT_SUBSTITUTIONS,
        template = ini + ".ini.in",
    )
    for ini in ["bootstrap", "fundamental"]
]

# ── Profile INI files (equivalent to scp2-generated profiles in dmake) ────────
# All ini files land in program/ alongside the DLLs and EXEs.
filegroup(
    name = "profile_ini",
    srcs = [
        ":version_ini",
        ":bootstrap_ini",
        ":fundamental_ini",
        "soffice.ini",
        "uno.ini",
        # PYUNO_LOADER_PYTHONHOME / PYTHONPATH for pythonloader.dll.
        ":pythonloader_uno_ini",
        # Vendor settings + JRE-selection data paths for jvmfwk.dll.  Name fixed
        # by fwkutil.hxx, not by us — see the file's own header.
        "jvmfwk3.ini",
    ],
)

# Application manifest for soffice.exe: Common-Controls 6 (visual styles).
# Wrapped in a filegroup because collect_outputs.deps does not accept raw
# source files.
filegroup(
    name = "soffice_app_manifest",
    srcs = ["//main/desktop:util/amd64/soffice.exe.manifest"],
)

