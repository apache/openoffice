package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//build/rules:idl_pipeline.bzl", "idl_library")
load("//build/rules:gtest_test.bzl", "gtest_test")

# ── Compiler / preprocessor options (mirrors sal conventions) ────
_COPTS = [
    "/Zm500", "/Zc:forScope", "/GR", "/nologo", "/Gs",
    "/EHsc",  # exception handling — ENABLE_EXCEPTIONS=TRUE for cppu
    "/wd4061", "/wd4063", "/wd4127",
]

_DEFINES = [
    "WNT", "GUI", "WIN32", "_MT",
    "WINVER=0x0500", "_WIN32_WINNT=0x0500", "_WIN32_IE=0x0500",
    "FULL_DESK",
]

_SLO_DEFINES = _DEFINES + ["SHAREDLIB", "_DLL_"]

# ── Public headers ────────────────────────────────────────────────
# Exports inc/ so consumers can write #include <typelib/typedescription.h>
# etc.  inc/pch is added to -I so sources can #include "precompiled_cppu.hxx".
cc_library(
    name = "cppu_headers",
    hdrs = glob(["inc/**/*.h", "inc/**/*.hxx"]),
    strip_include_prefix = "inc",
    includes = ["inc/pch"],
    deps = ["//main/sal:sal_headers"],
    visibility = ["//visibility:public"],
)

# ── source/uno ───────────────────────────────────────────────────
# Private headers (constr.hxx, destr.hxx, …) live in source/uno/;
# /Imain/cppu/source/uno puts them on the include path.
cc_library(
    name = "cppu_uno",
    srcs = glob([
        "source/uno/*.cxx",
        "source/uno/*.c",
        "source/uno/*.hxx",
    ]),
    copts = _COPTS,
    defines = _SLO_DEFINES,
    deps = [
        ":cppu_headers",
        "//main/sal:sal_headers",
        "//main/udkapi:udkapi_idl_headers",
        "//main/stlport:stlport",
        "@boost.legacy//:boost.legacy",
    ],
)

# ── source/threadpool ────────────────────────────────────────────
cc_library(
    name = "cppu_threadpool",
    srcs = glob([
        "source/threadpool/*.cxx",
        "source/threadpool/*.hxx",
    ]),
    copts = _COPTS,
    defines = _SLO_DEFINES,
    deps = [
        ":cppu_headers",
        "//main/sal:sal_headers",
        "//main/stlport:stlport",
        "//main/udkapi:udkapi_idl_headers",
        "@boost.legacy//:boost.legacy",
    ],
)

# ── source/typelib ────────────────────────────────────────────────
cc_library(
    name = "cppu_typelib",
    srcs = glob(["source/typelib/*.cxx"]),
    copts = _COPTS,
    defines = _SLO_DEFINES,
    deps = [
        ":cppu_headers",
        "//main/sal:sal_headers",
        "//main/stlport:stlport",
        "//main/udkapi:udkapi_idl_headers",
    ],
)

# ── source/cppu ───────────────────────────────────────────────────
cc_library(
    name = "cppu_cppu",
    srcs = glob(["source/cppu/*.cxx"]),
    copts = _COPTS,
    defines = _SLO_DEFINES,
    deps = [
        ":cppu_headers",
        "//main/sal:sal_headers",
        "//main/udkapi:udkapi_idl_headers",
    ],
)

# ── cppu3.dll ─────────────────────────────────────────────────────
# Main UNO runtime library.  The DEF file is hand-derived from cppu.map
# (only 14 exported C symbols; everything else is local).
cc_binary(
    name = "cppu3",
    srcs = [],
    deps = [
        ":cppu_uno",
        ":cppu_threadpool",
        ":cppu_typelib",
        ":cppu_cppu",
    ],
    additional_linker_inputs = ["//main/sal:sal_implib"],
    linkshared = True,
    win_def_file = "util/cppu.def",
    linkopts = ["$(execpath //main/sal:sal_implib)"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "cppu3_implib",
    srcs = [":cppu3"],
    output_group = "interface_library",
    visibility = ["//visibility:public"],
)

# ── purpenvhelper3MSC.dll ─────────────────────────────────────────
# Pure-environment helper: implements the Enterable/Mapping interfaces.
# Depends on cppu3 for typelib symbols.
cc_binary(
    name = "purpenvhelper3MSC",
    srcs = glob([
        "source/helper/purpenv/*.cxx",
        "source/helper/purpenv/*.hxx",
    ]),
    copts = _COPTS,
    defines = _SLO_DEFINES,
    deps = [
        ":cppu_headers",
        "//main/sal:sal_headers",
        "//main/udkapi:udkapi_idl_headers",
    ],
    additional_linker_inputs = [
        "//main/sal:sal_implib",
        ":cppu3_implib",
    ],
    linkshared = True,
    win_def_file = "util/purpenvhelper3MSC.def",
    linkopts = [
        "$(execpath //main/sal:sal_implib)",
        "$(execpath :cppu3_implib)",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "purpenvhelper_implib",
    srcs = [":purpenvhelper3MSC"],
    output_group = "interface_library",
    visibility = ["//visibility:public"],
)

# ── Bridge DLLs ───────────────────────────────────────────────────
# Each bridge exports uno_initEnvironment / uno_ext_getMapping via
# SAL_DLLPUBLIC_EXPORT, so no explicit DEF symbols are needed.
# empty.def keeps the linker happy without exporting anything extra.

cc_binary(
    name = "unsafe_uno_uno",
    srcs = ["source/UnsafeBridge/UnsafeBridge.cxx"],
    copts = _COPTS,
    defines = _SLO_DEFINES,
    deps = [
        ":cppu_headers",
        "//main/sal:sal_headers",
        "//main/udkapi:udkapi_idl_headers",
    ],
    additional_linker_inputs = [
        "//main/sal:sal_implib",
        ":purpenvhelper_implib",
    ],
    linkshared = True,
    linkopts = [
        "/DEF:main/cppu/util/empty.def",
        "$(execpath //main/sal:sal_implib)",
        "$(execpath :purpenvhelper_implib)",
    ],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "affine_uno_uno",
    srcs = ["source/AffineBridge/AffineBridge.cxx"],
    copts = _COPTS,
    defines = _SLO_DEFINES,
    deps = [
        ":cppu_headers",
        "//main/sal:sal_headers",
        "//main/udkapi:udkapi_idl_headers",
    ],
    additional_linker_inputs = [
        "//main/sal:sal_implib",
        ":purpenvhelper_implib",
    ],
    linkshared = True,
    linkopts = [
        "/DEF:main/cppu/util/empty.def",
        "$(execpath //main/sal:sal_implib)",
        "$(execpath :purpenvhelper_implib)",
    ],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "log_uno_uno",
    srcs = ["source/LogBridge/LogBridge.cxx"],
    copts = _COPTS,
    defines = _SLO_DEFINES,
    deps = [
        ":cppu_headers",
        "//main/sal:sal_headers",
        "//main/udkapi:udkapi_idl_headers",
    ],
    additional_linker_inputs = [
        "//main/sal:sal_implib",
        ":purpenvhelper_implib",
        ":cppu3_implib",
    ],
    linkshared = True,
    linkopts = [
        "/DEF:main/cppu/util/empty.def",
        "$(execpath //main/sal:sal_implib)",
        "$(execpath :purpenvhelper_implib)",
        "$(execpath :cppu3_implib)",
    ],
    visibility = ["//visibility:public"],
)

# ── qa unit tests ─────────────────────────────────────────────────
# Four standalone GoogleTest apps (qa/main.cxx + qa/test_<x>.cxx), each linking
# cppu + sal only.  They exercise UNO type machinery against private test types
# defined in qa/types.idl (Enum1/Struct1/Interface1/Exception1/Poly/Rec, mostly
# in the global namespace) — generated to C++ headers and #include'd by bare
# name (e.g. "Enum1.hpp"), so the generated inc dir goes on the include path.

# qa/types.idl → headers.  Exception1 etc. derive from com::sun::star::uno::
# Exception, so idlc needs udkapi on -I and cppumaker the udkapi rdb.
idl_library(
    name = "cppu_qa_idl",
    srcs = ["qa/types.idl"],
    include_dirs = ["main/udkapi"],
    extra_rdbs = ["//main/udkapi:udkapi_idl"],
)

cc_library(
    name = "cppu_qa_idl_headers",
    hdrs = [":cppu_qa_idl"],
    includes = ["cppu_qa_idl_inc"],
)

_QA_DEPS = [
    ":cppu_qa_idl_headers",
    ":cppu_headers",
    "//main/sal:sal_headers",
    "//main/udkapi:udkapi_idl_headers",
    "@boost.legacy//:boost.legacy",
]

_QA_LINKER_INPUTS = [
    "//main/sal:sal_implib",
    ":cppu3_implib",
]

_QA_LINKOPTS = [
    "$(execpath //main/sal:sal_implib)",
    "$(execpath :cppu3_implib)",
]

_QA_RUNTIME_DLLS = [
    "//main/sal:sal3",
    ":cppu3",
]

[
    gtest_test(
        name = "cppu_qa_" + t,
        srcs = ["qa/test_%s.cxx" % t, "qa/main.cxx"],
        copts = ["/Zc:wchar_t-"],
        defines = _DEFINES,
        deps = _QA_DEPS,
        additional_linker_inputs = _QA_LINKER_INPUTS,
        linkopts = _QA_LINKOPTS,
        runtime_dlls = _QA_RUNTIME_DLLS,
    )
    for t in ["any", "unotype", "reference", "recursion"]
]