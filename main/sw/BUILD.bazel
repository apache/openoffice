# Per-subdir /I entries are needed for angle-bracket includes of .hrc files
# that live in source sub-directories (e.g. <undo.hrc> from source/core/undo/).
# Quoted relative includes like "../rtf/swparrtf.hxx" are resolved by MSVC
# cl.exe automatically relative to the including source file's directory —
# no /I flag is needed for those; Bazel just needs them declared as textual
# inputs so they are available in the build sandbox (see sw_source_hdrs).
_COPTS = [
    "/Imain/sw/inc",
    "/Imain/sw/inc/pch",
    "/Imain/sw/sdi",
    "/Imain/sw/source/core/inc",
