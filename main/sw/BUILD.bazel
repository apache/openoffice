# ── Private source-tree headers ───────────────────────────────────────────────
# source/core/inc, source/filter/inc, source/ui/inc — exposed via strip so
# the /Imain/sw/source/{core,filter,ui}/inc copts resolve them correctly.
cc_library(
    name = "sw_source_core_inc",
    textual_hdrs = glob(["source/core/inc/**"]),
    strip_include_prefix = "source/core/inc",
)

cc_library(
    name = "sw_source_filter_inc",
    textual_hdrs = glob(["source/filter/inc/**"]),
    strip_include_prefix = "source/filter/inc",
)

cc_library(
    name = "sw_source_ui_inc",
    textual_hdrs = glob(["source/ui/inc/**"]),
    strip_include_prefix = "source/ui/inc",
)

# All remaining source-subdirectory headers (non-inc-dir .hxx/.hrc/.h).
# These are declared as textual inputs so Bazel includes them in every
# compile action's sandbox.  MSVC cl.exe resolves quoted relative includes
# (e.g. "../rtf/swparrtf.hxx") relative to the including source file's own
# directory, so no extra /I flags are needed — only sandbox availability.
cc_library(
    name = "sw_source_hdrs",
    textual_hdrs = glob(
        [
            "source/**/*.hxx",
            "source/**/*.hrc",
            "source/**/*.h",
            "util/*.hrc",
            "sdi/*.hrc",
        ],
        exclude = [
            "source/core/inc/**",
            "source/filter/inc/**",
            "source/ui/inc/**",
        ],
    ),
)

# ── SDI slot header generation ────────────────────────────────────────────────
sdi_target(
    name = "swslots_sdi",
    main_sdi    = "sdi/swslots.sdi",
    exports     = "sdi/swriter.sdi",
    srcs        = glob(["sdi/*.sdi", "sdi/*.hrc", "inc/*.hrc"]),
    slot_name   = "swslots",
    include_dirs = [
        "main/sw/sdi",
        "main/sw/inc",
        "main/sfx2/sdi",
        "main/sfx2/inc/sfx2",
        "main/sfx2/inc",
        "main/svx/sdi",
        "main/svx/inc",
        "main/svl/inc",
        "main/editeng/inc",
    ],
    pkg_deps = [
        "//main/sfx2:sfx2_sdi_pkg",
        "//main/svx:svx_sdi_pkg",
    ],
)

cc_library(
    name = "swslots_headers",
    hdrs     = [":swslots_sdi"],
    includes = ["swslots_sdi_inc"],
    visibility = ["//visibility:public"],
)

# ── swd.dll — format detector ─────────────────────────────────────────────────
