package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//build/rules:rsc_pipeline.bzl", "rsc_res")

_DEFINES = [
    "WNT", "GUI", "WIN32",
    "WINVER=0x0500", "_WIN32_WINNT=0x0500", "_WIN32_IE=0x0500",
    "CPPU_ENV=msci", 
    "FULL_DESK", "SHAREDLIB", "_DLL_",
    "snprintf=_snprintf",
]

_COPTS = [
    "/Imain/editeng/inc",
    "/Imain/editeng/inc/pch",
    "/Imain/editeng/source/editeng",
    "/Imain/editeng/source/outliner",
    "/Imain/editeng/source/misc",
    "/Imain/editeng/source/accessibility",
    "/Imain/editeng/source/xml",
    "/Zc:wchar_t-",
]

# ── public headers ──────────────────────────────────────────────────
cc_library(
    name = "editeng_headers",
    hdrs = glob([
        "inc/editeng/**",
        "inc/pch/**",
        "inc/*.hxx",
        "inc/*.hrc",
    ]),
    strip_include_prefix = "inc",
    deps = [
        "//main/sal:sal_headers",
        "//main/cppu:cppu_headers",
        "//main/cppuhelper:cppuhelper_headers",
        "//main/udkapi:udkapi_idl_headers",
        "//main/offapi:offapi_idl_headers",
        "//main/tools:tools_headers",
        "//main/unotools:unotools_headers",
        "//main/comphelper:comphelper_headers",
        "//main/svl:svl_headers",
        "//main/sot:sot_headers",
        "//main/basegfx:basegfx_headers",
        "//main/vcl:vcl_headers",
        "//main/svtools:svtools_headers",
        "//main/toolkit:toolkit_headers",
        "//main/linguistic:linguistic_headers",
        "//main/xmloff:xmloff_headers",
        "//main/i18nutil:i18nutil_headers",
        "//main/vos:vos_headers",
        "//main/ucbhelper:ucbhelper_headers",
        "@icu//:icuuc_headers",
    ],
    visibility = ["//visibility:public"],
)

# ── editeng.dll ─────────────────────────────────────────────────────
cc_binary(
    name = "editeng",
    srcs = glob([
        "source/accessibility/*.cxx",
        "source/accessibility/*.hxx",
        "source/editeng/*.cxx",
        "source/editeng/*.hxx",
        "source/items/*.cxx",
        "source/misc/*.cxx",
        "source/misc/*.hxx",
        "source/outliner/*.cxx",
        "source/outliner/*.hxx",
        "source/rtf/*.cxx",
        "source/uno/*.cxx",
        "source/xml/*.cxx",
        "source/xml/*.hxx",
    ]),
    copts = _COPTS,
    defines = _DEFINES + ["EDITENG_DLLIMPLEMENTATION"],
    linkshared = True,
    deps = [
        ":editeng_headers",
        "//main/stlport:stlport",
        "@icu//:icuuc_headers",
    ],
    additional_linker_inputs = [
        "//main/sal:sal_implib",
        "//main/cppu:cppu3_implib",
        "//main/cppuhelper:cppuhelper_implib",
        "//main/comphelper:comphelpMSC_implib",
        "//main/ucbhelper:ucbhelperMSC_implib",
        "//main/tools:tl_implib",
        "//main/unotools:utl_implib",
        "//main/sot:sot_implib",
        "//main/svl:svl_implib",
        "//main/basegfx:basegfx_implib",
        "//main/vcl:vcl_implib",
        "//main/toolkit:ootk_implib",
        "//main/svtools:svt_implib",
        "//main/linguistic:lng_implib",
        "//main/xmloff:xo_implib",
        "//main/i18npool:i18nisolang1MSC_implib",
        "//main/i18npool:i18npaper_implib",
        "//main/vos:vos3MSC_implib",
        "@icu//:icuuc_implib",
    ],
    linkopts = [
        "$(execpath //main/sal:sal_implib)",
        "$(execpath //main/cppu:cppu3_implib)",
        "$(execpath //main/cppuhelper:cppuhelper_implib)",
        "$(execpath //main/comphelper:comphelpMSC_implib)",
        "$(execpath //main/ucbhelper:ucbhelperMSC_implib)",
        "$(execpath //main/tools:tl_implib)",
        "$(execpath //main/unotools:utl_implib)",
        "$(execpath //main/sot:sot_implib)",
        "$(execpath //main/svl:svl_implib)",
        "$(execpath //main/basegfx:basegfx_implib)",
        "$(execpath //main/vcl:vcl_implib)",
        "$(execpath //main/toolkit:ootk_implib)",
        "$(execpath //main/svtools:svt_implib)",
        "$(execpath //main/linguistic:lng_implib)",
        "$(execpath //main/xmloff:xo_implib)",
        "$(execpath //main/i18npool:i18nisolang1MSC_implib)",
        "$(execpath //main/i18npool:i18npaper_implib)",
        "$(execpath //main/vos:vos3MSC_implib)",
        "$(execpath @icu//:icuuc_implib)",
        "advapi32.lib", "gdi32.lib", "ole32.lib", "oleaut32.lib",
        "user32.lib", "uuid.lib", "/MANIFEST:NO",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "editeng_implib",
    srcs = [":editeng"],
    output_group = "interface_library",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "editeng_inc_hrc",
    srcs = glob(["inc/editeng/**/*.hrc", "inc/editeng/**/*.hxx", "inc/**/*.hrc"]),
    visibility = ["//visibility:public"],
)

rsc_res(
    name     = "editeng_res",
    srcs     = glob(["source/**/*.src"]),
    hdrs     = glob(["inc/**/*.hrc"]) + ["//main/svl:svl_hrc"],
    includes = ["main/editeng/inc", "main/svl/inc"],
    visibility = ["//visibility:public"],
)
