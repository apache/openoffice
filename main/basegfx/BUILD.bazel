# ── basegfx.dll ───────────────────────────────────────────────────
# Base graphics primitives: 2D/3D geometry, polygons, colour, matrix math.
# Uses boost (shared_ptr, scoped_ptr, bind, tuple) — no hash_map, so no stlport.
# sal_Unicode usage requires /Zc:wchar_t-.
cc_binary(
    name = "basegfx",
    srcs = _SRCS + glob(["source/inc/**"]),
    copts = _COMMON_COPTS,
    defines = _DEFINES,
    linkshared = True,
    deps = [
        ":basegfx_headers",
        "//main/sal:sal_headers",
        "//main/cppu:cppu_headers",
        "//main/cppuhelper:cppuhelper_headers",
        "//main/udkapi:udkapi_idl_headers",
        "//main/offapi:offapi_idl_headers",
        "//main/o3tl:o3tl",
        "@boost.legacy//:boost.legacy",
    ],
    additional_linker_inputs = [
        "//main/sal:sal_implib",
        "//main/cppu:cppu3_implib",
        "//main/cppuhelper:cppuhelper_implib",
    ],
    linkopts = [
        "$(execpath //main/sal:sal_implib)",
        "$(execpath //main/cppu:cppu3_implib)",
        "$(execpath //main/cppuhelper:cppuhelper_implib)",
        "/MANIFEST:NO",
    ],
    visibility = ["//visibility:public"],
)

# ── import library for downstream ─────────────────────────────────
filegroup(
    name = "basegfx_implib",
    srcs = [":basegfx"],
    output_group = "interface_library",
    visibility = ["//visibility:public"],
)
