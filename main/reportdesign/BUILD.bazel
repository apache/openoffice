# CondFormat.src uses FileList = { < "path"; SID; >; } syntax which rsc2 cannot
# parse directly (the original rsc.exe PreprocessSrsFile corrupted these blocks
# into empty FileList = {}; before compilation, producing empty image lists).
# Replicate that behavior: replace every FileList block with an empty IdList.
genrule(
    name = "condformat_src_patched",
    srcs = ["source/ui/dlg/CondFormat.src"],
    outs = ["condformat_fixed/CondFormat.src"],
    cmd_bat = "perl -0777 -pe \"s/FileList\\s*=\\s*\\{[^}]*\\}/IdList = {}/g\" \"$(location source/ui/dlg/CondFormat.src)\" > \"$(OUTS)\"",
)

# rptui.res — UI dialog/inspection/report resources (AllLangResTarget_rptui.mk)
rsc_res(
    name        = "rptui_res",
    srcs        = [
        "source/ui/dlg/dlgpage.src",
        "source/ui/dlg/PageNumber.src",
        "source/ui/dlg/DateTime.src",
        ":condformat_src_patched",
        "source/ui/dlg/Navigator.src",
        "source/ui/dlg/GroupsSorting.src",
        "source/ui/inspection/inspection.src",
        "source/ui/report/report.src",
    ],
    hdrs        = glob(["inc/**/*.hrc", "source/ui/**/*.hrc"]) + [
        "//main/svl:svl_hrc",
        "//main/svx:svx_inc_hrc",
        "//main/editeng:editeng_inc_hrc",
        "//main/sfx2:sfx2_inc_hrc",
    ],
    includes    = [
