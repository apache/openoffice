--- misc/rasqal-0.9.33/src/win32_rasqal_config.h
+++ misc/build/rasqal-0.9.33/src/win32_rasqal_config.h
@@ -45,7 +45,12 @@
 /* MS names for these functions */
 // next line breaks build on wntmsci12
 //#define vsnprintf _vsnprintf
+#if !defined(_MSC_VER) || (_MSC_VER < 1900)
+/*  The UCRT -- VS2015 and every toolset since -- declares a real, conforming
+    snprintf.  Defining the name away here rewrites that declaration as it is
+    being parsed, so the shim has to stop at the runtime that gained one. */
 #define snprintf _snprintf
+#endif
 #define access _access
 #define stricmp _stricmp
 #define strnicmp _strnicmp
@@ -69,9 +74,16 @@
 #undef HAVE_GETTIMEOFDAY
 
 #include <float.h>
+#ifndef isnan
 #define isnan(n) _isnan(n)
-/* no round function available */
+#endif
+#if !defined(_MSC_VER) || (_MSC_VER < 1900)
+/*  no round function available.  On the UCRT there is one, and it is
+    DECLARED in corecrt_math.h -- so a function-like macro of the same
+    name mangles that declaration and the header stops parsing
+    (C2059/C2143), some distance from anything that mentions round. */
 #define round(x) floor(x+0.5)
+#endif
 
 /* These are SPARQL token definitions */
 #ifdef OPTIONAL
