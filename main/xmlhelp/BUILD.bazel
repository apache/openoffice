package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_java//java:defs.bzl", "java_library")
load("//build/rules:java_pipeline.bzl", "uno_jar")

# ── xmlhelp — XML help runtime ────────────────────────────────────────────────
# Two DLLs:
#   tvhlp1.dll      — TreeView help hierarchy data source
#   ucpchelp1.dll   — UCB content provider for compiled help
#
# build.lst: comphelper ucbhelper LIBXSLT:libxslt unoil l10ntools

exports_files(glob([
    "**/*.component",
    "util/*.xsl",
]))

_DEFINES = [
    "WNT", "GUI", "WIN32",
    "WINVER=0x0500", "_WIN32_WINNT=0x0500", "_WIN32_IE=0x0500",
    "FULL_DESK", "SHAREDLIB", "_DLL_",
]

# Common header deps for both DLLs
_COMMON_DEPS = [
    "//main/sal:sal_headers",
    "//main/cppu:cppu_headers",
    "//main/cppuhelper:cppuhelper_headers",
    "//main/comphelper:comphelper_headers",
    "//main/vos:vos_headers",
    "//main/ucbhelper:ucbhelper_headers",
    "//main/udkapi:udkapi_idl_headers",
    "//main/offapi:offapi_idl_headers",
    "//main/stlport:stlport",
]

_COMMON_LINKINPUTS = [
    "//main/sal:sal_implib",
    "//main/cppu:cppu3_implib",
    "//main/cppuhelper:cppuhelper_implib",
    "//main/comphelper:comphelpMSC_implib",
    "//main/vos:vos3MSC_implib",
    "//main/ucbhelper:ucbhelperMSC_implib",
]

_COMMON_LINKOPTS = [
    "$(execpath //main/sal:sal_implib)",
    "$(execpath //main/cppu:cppu3_implib)",
    "$(execpath //main/cppuhelper:cppuhelper_implib)",
    "$(execpath //main/comphelper:comphelpMSC_implib)",
    "$(execpath //main/vos:vos3MSC_implib)",
    "$(execpath //main/ucbhelper:ucbhelperMSC_implib)",
    "/MANIFEST:NO",
    "kernel32.lib",
    "user32.lib",
    "advapi32.lib",
    "msvcrt.lib",
]

# ── tvhlp1.dll — TreeView help hierarchy data source ─────────────────────────
cc_binary(
    name = "tvhlp1",
    srcs = [
        "source/treeview/tvfactory.cxx",
        "source/treeview/tvread.cxx",
        # local headers (included with "" form)
        "source/treeview/tvfactory.hxx",
        "source/treeview/tvread.hxx",
    ],
    copts = [
        "/Zc:wchar_t-",
        "/EHsc", "/GR",
        "/Imain/xmlhelp/inc",
        "/Imain/xmlhelp/inc/pch",
        "/Imain/xmlhelp/source/treeview",
    ],
    defines = _DEFINES,
    linkshared = True,
    win_def_file = "util/tvhlp1.def",
    additional_linker_inputs = _COMMON_LINKINPUTS,
    linkopts = _COMMON_LINKOPTS,
    deps = _COMMON_DEPS + [
        "@expat//:expat_utf8",
    ],
)

filegroup(
    name = "tvhlp1_implib",
    srcs = [":tvhlp1"],
    output_group = "interface_library",
)

# ── ucpchelp1.dll — UCB content provider for compiled help ───────────────────
cc_binary(
    name = "ucpchelp1",
    srcs = [
        # provider sources
        "source/cxxhelp/provider/bufferedinputstream.cxx",
        "source/cxxhelp/provider/content.cxx",
        "source/cxxhelp/provider/contentcaps.cxx",
        "source/cxxhelp/provider/databases.cxx",
        "source/cxxhelp/provider/db.cxx",
        "source/cxxhelp/provider/inputstream.cxx",
        "source/cxxhelp/provider/provider.cxx",
        "source/cxxhelp/provider/resultset.cxx",
        "source/cxxhelp/provider/resultsetbase.cxx",
        "source/cxxhelp/provider/resultsetforroot.cxx",
        "source/cxxhelp/provider/resultsetforquery.cxx",
        "source/cxxhelp/provider/services.cxx",
        "source/cxxhelp/provider/urlparameter.cxx",
        # qe sources
        "source/cxxhelp/qe/DocGenerator.cxx",
        # util sources
        "source/cxxhelp/util/Decompressor.cxx",
        # local provider headers (included with "" form)
        "source/cxxhelp/provider/bufferedinputstream.hxx",
        "source/cxxhelp/provider/content.hxx",
        "source/cxxhelp/provider/databases.hxx",
        "source/cxxhelp/provider/db.hxx",
        "source/cxxhelp/provider/inputstream.hxx",
        "source/cxxhelp/provider/provider.hxx",
        "source/cxxhelp/provider/resultset.hxx",
        "source/cxxhelp/provider/resultsetbase.hxx",
        "source/cxxhelp/provider/resultsetfactory.hxx",
        "source/cxxhelp/provider/resultsetforroot.hxx",
        "source/cxxhelp/provider/resultsetforquery.hxx",
        "source/cxxhelp/provider/urlparameter.hxx",
    ],
    copts = [
        "/Zc:wchar_t-",
        "/EHsc", "/GR",
        "/Imain/xmlhelp/inc",
        "/Imain/xmlhelp/inc/pch",
        "/Imain/xmlhelp/source/cxxhelp/inc",
        "/Imain/xmlhelp/source/cxxhelp/provider",
    ],
    defines = _DEFINES + ["HAVE_EXPAT_H"],
    linkshared = True,
    win_def_file = "util/ucpchelp1.def",
    additional_linker_inputs = _COMMON_LINKINPUTS,
    linkopts = _COMMON_LINKOPTS,
    deps = _COMMON_DEPS + [
        "//main/l10ntools:helplinker_headers",
        "@expat//:expat_utf8",
        "@libxslt//:libxslt",
        "@libxml2//:libxml2",
    ],
)

filegroup(
    name = "ucpchelp1_implib",
    srcs = [":ucpchelp1"],
    output_group = "interface_library",
)

# ── Help full-text search: Lucene + LuceneHelpWrapper ────────────────────────
# All three jars go to program/classes (scp2 STD_JAR_FILE).  LuceneHelpWrapper
# names the two Lucene jars by relative Class-Path, so they must sit beside it.
# The classes are compiled in the @lucene bzlmod module; these targets give
# them upstream's file names and manifests (Ant's Created-By/Ant-Version
# omitted, as for every jar here).
uno_jar(
    name = "lucene_core_jar",
    out = "lucene-core-2.9.4-dev.jar",
    jars = ["@lucene//:lucene_core", "@lucene//:lucene_legal"],
    manifest_lines = [
        "Specification-Title: Lucene Search Engine: core",
        "Specification-Version: 2.9.4-dev",
        "Specification-Vendor: The Apache Software Foundation",
        "Implementation-Title: org.apache.lucene",
        "Implementation-Version: 2.9.4-dev",
        "Implementation-Vendor: The Apache Software Foundation",
    ],
)

uno_jar(
    name = "lucene_analyzers_jar",
    out = "lucene-analyzers-2.9.4-dev.jar",
    jars = ["@lucene//:lucene_analyzers", "@lucene//:lucene_legal"],
    manifest_lines = [
        "Specification-Title: Lucene Search Engine: analyzers",
        "Specification-Version: 2.9.4-dev",
        "Specification-Vendor: The Apache Software Foundation",
        "Implementation-Title: org.apache.lucene",
        "Implementation-Version: 2.9.4-dev",
        "Implementation-Vendor: The Apache Software Foundation",
    ],
)

# com.sun.star.help.HelpSearch / HelpIndexer — the UNO component the help
# viewer's Find tab calls.  Upstream copies the indexer classes from
# l10ntools/source/help into this jar (build.xml import-helpindexer), so the
# runtime HelpIndexer service and the build-time HelpIndexerTool are the same
# code; here the jar simply merges //main/l10ntools:help_indexer.
java_library(
    name = "lucene_help_wrapper_classes",
    srcs = glob(["java/LuceneHelpWrapper/src/main/java/**/*.java"]),
    javacopts = ["--release", "8", "-XepDisableAllChecks"],
    deps = [
        "//main/javaunohelper:juh_jar",
        "//main/jurt:jurt",
        "//main/l10ntools:help_indexer",
        "//main/ridljar:ridl",
        "//main/unoil:unoil",
        "@lucene//:lucene_analyzers",
        "@lucene//:lucene_core",
    ],
)

uno_jar(
    name = "LuceneHelpWrapper_jar",
    out = "LuceneHelpWrapper.jar",
    jars = [
        ":lucene_help_wrapper_classes",
        "//main/l10ntools:help_indexer",
    ],
    manifest_lines = [
        "RegistrationClassName: com.sun.star.help.HelpComponent",
        "Class-Path: lucene-core-2.9.4-dev.jar lucene-analyzers-2.9.4-dev.jar",
    ],
)

# helpxsl.zip upstream (Zip_helpxsl.mk) — unpacked by the installer into
# help/.  The help viewer renders every page through main_transform.xsl.
filegroup(
    name = "helpxsl",
    srcs = [
        "util/idxcaption.xsl",
        "util/idxcontent.xsl",
        "util/main_transform.xsl",
    ],
)
