# ── The 4 data DLLs (target config) ──────────────────────────────────────────
# Pure data: generated functions only return static const sal_Unicode arrays, so
# no external link deps (just sal headers for sal/types.h + /Zc:wchar_t-).
_LD_DLL_COPTS = ["/Zc:wchar_t-"]

cc_binary(
    name = "localedata_en",
    srcs = [":localedata_en_gen"],
    copts = _LD_DLL_COPTS,
    defines = _DEFINES,
    linkshared = True,
    deps = ["//main/sal:sal_headers"],
    linkopts = ["/MANIFEST:NO"],
    visibility = ["//visibility:public"],
)

# en's import library — es/euro/others import getXxx_en_US() from localedata_en.dll.
filegroup(
    name = "localedata_en_implib",
    srcs = [":localedata_en"],
    output_group = "interface_library",
    visibility = ["//visibility:public"],
)

[
    cc_binary(
        name = "localedata_" + grp,
        srcs = [":localedata_" + grp + "_gen"],
        copts = _LD_DLL_COPTS,
        defines = _DEFINES,
        linkshared = True,
        deps = ["//main/sal:sal_headers"],
        additional_linker_inputs = [":localedata_en_implib"],
        linkopts = [
            "$(execpath :localedata_en_implib)",
            "/MANIFEST:NO",
        ],
        visibility = ["//visibility:public"],
    )
    for grp in ["es", "euro", "others"]
]

