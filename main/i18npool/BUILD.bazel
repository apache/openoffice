package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//main/postprocess:postprocess.bzl", "services_rdb")
load("//build/rules:localedata_pipeline.bzl", "localedata_gen")

_DEFINES = [
    "WNT", "GUI", "WIN32",
    "WINVER=0x0500", "_WIN32_WINNT=0x0500", "_WIN32_IE=0x0500",
    "FULL_DESK",
    "SHAREDLIB", "_DLL_",
    "I18NPOOL_DLLIMPLEMENTATION",
]

_COMMON_DEPS = [
    "//main/sal:sal_headers",
    "//main/cppu:cppu_headers",
    "//main/cppuhelper:cppuhelper_headers",
    "//main/udkapi:udkapi_idl_headers",
    "//main/offapi:offapi_idl_headers",
    "//main/stlport:stlport",
]

_COMMON_COPTS = [
    "/Imain/i18npool/inc",
    "/Imain/i18npool/inc/pch",
    "/Zc:wchar_t-",
]

# ── public headers ────────────────────────────────────────────────
cc_library(
    name = "i18npool_headers",
    hdrs = glob(["inc/**"]),
    strip_include_prefix = "inc",
    deps = ["//main/sal:sal_headers"],
    visibility = ["//visibility:public"],
)

# inwnt.cxx is #included by insys.cxx via platform guard — declare as
# textual_hdrs so Bazel makes the file available without compiling it separately.
cc_library(
    name = "_isolang_impl",
    textual_hdrs = [
        "source/isolang/inwnt.cxx",
        "source/isolang/inunx.cxx",
    ],
    copts = _COMMON_COPTS,
    deps = _COMMON_DEPS,
)

# ── i18nisolang1.dll ──────────────────────────────────────────────
# Language/locale identification; no ICU dependency.
# Exports class MsLangId via I18NPOOL_DLLPUBLIC (SAL_DLLPUBLIC_EXPORT).
cc_binary(
    name = "i18nisolang1MSC",
    srcs = [
        "source/isolang/insys.cxx",   # includes inwnt.cxx on WNT
        "source/isolang/isolang.cxx",
        "source/isolang/mslangid.cxx",
    ],
    copts = _COMMON_COPTS,
    defines = _DEFINES,
    linkshared = True,
    deps = _COMMON_DEPS + [":_isolang_impl"],
    additional_linker_inputs = [
        "//main/sal:sal_implib",
        "//main/cppu:cppu3_implib",
    ],
    linkopts = [
        "$(execpath //main/sal:sal_implib)",
        "$(execpath //main/cppu:cppu3_implib)",
        "/MANIFEST:NO",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "i18nisolang1MSC_implib",
    srcs = [":i18nisolang1MSC"],
    output_group = "interface_library",
    visibility = ["//visibility:public"],
)

# ── i18npaper.dll ─────────────────────────────────────────────────
# Paper size information; no ICU dependency.
cc_binary(
    name = "i18npaper",
    srcs = ["source/paper/paper.cxx"],
    copts = _COMMON_COPTS,
    defines = _DEFINES,
    linkshared = True,
    deps = _COMMON_DEPS + [
        ":i18npool_headers",
        "//main/comphelper:comphelper_headers",
    ],
    additional_linker_inputs = [
        "//main/sal:sal_implib",
        "//main/cppu:cppu3_implib",
        "//main/comphelper:comphelpMSC_implib",
        ":i18nisolang1MSC_implib",
    ],
    linkopts = [
        "$(execpath //main/sal:sal_implib)",
        "$(execpath //main/cppu:cppu3_implib)",
        "$(execpath //main/comphelper:comphelpMSC_implib)",
        "$(execpath :i18nisolang1MSC_implib)",
        "/MANIFEST:NO",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "i18npaper_implib",
    srcs = [":i18npaper"],
    output_group = "interface_library",
    visibility = ["//visibility:public"],
)

# ── Source exports for //main/i18npool/pool ───────────────────────
# Expose .cxx sources and breakiterator .txt files to the pool package.
exports_files(
    glob([
        "source/**/*.cxx",
        "source/breakiterator/data/*.txt",
    ]),
    visibility = ["//main/i18npool/pool:__pkg__"],
)

filegroup(
    name = "i18npool_lang_h",
    srcs = glob(["inc/i18npool/*.h"]),
    visibility = ["//visibility:public"],
)

# ── i18npool.uno.dll, i18nsearch.dll ─────────────────────────────
# ICU-dependent targets — see main/i18npool/pool/BUILD.bazel.

exports_files(glob(["**/*.component"]))

# ══════════════════════════════════════════════════════════════════════════════
# localedata — per-locale data libraries (localedata_{en,es,euro,others}.dll)
# ══════════════════════════════════════════════════════════════════════════════
# Mirrors i18npool/source/localedata/{makefile.mk,data/makefile.mk}.
#
# LocaleDataImpl::getLocaleItem() (compiled into i18npool.dll) osl_loadModule()s
# these DLLs by bare name and looks up getXxx_<lang>_<CC>() data functions.  For
# en-US the group is localedata_en.dll.  Without them every locale lookup throws,
# so Writer/Calc text + caret init fails while the Start Center (which lays out no
# editable text) still works — the exact symptom this restores.
#
# Pipeline:  data/<lang>_<CC>.xml --saxparser--> localedata_<lang>_<CC>.cxx
#            grouped + linked into 4 DLLs.  The generated functions are
#            SAL_DLLPUBLIC_EXPORT (__declspec(dllexport)) → no .def needed.
#
# Group membership is copied verbatim from data/makefile.mk SHL{1,2,3,4}OBJS.
# localedata_en is the base library; es/euro/others import getXxx_en_US() from it
# (data/makefile.mk SHL{2,3,4}STDLIBS = LINK_LOCALEDATA_EN_LIB), so they link its
# import library.

# ── saxparser — UNO tool: <locale>.xml → localedata_<locale>.cxx ──────────────
# APP1 in source/localedata/makefile.mk (saxparser + LocaleNode + filewriter).
# Bootstraps a UNO service manager (createRegistryServiceFactory) and runs the
# SAX parser (expwrap.dll) over each locale XML.  Built default-config but pulled
# cfg="exec" by localedata_gen.
cc_binary(
    name = "saxparser",
    srcs = [
        "source/localedata/saxparser.cxx",
        "source/localedata/LocaleNode.cxx",
        "source/localedata/filewriter.cxx",
        "source/localedata/LocaleNode.hxx",
    ],
    copts = _COMMON_COPTS + ["/Imain/i18npool/source/localedata"],
    defines = _DEFINES,
    deps = _COMMON_DEPS + [
        ":i18npool_headers",
        "//main/vos:vos_headers",
    ],
    additional_linker_inputs = [
        "//main/sal:sal_implib",
        "//main/cppu:cppu3_implib",
        "//main/cppuhelper:cppuhelper_implib",
    ],
    linkopts = [
        "$(execpath //main/sal:sal_implib)",
        "$(execpath //main/cppu:cppu3_implib)",
        "$(execpath //main/cppuhelper:cppuhelper_implib)",
        "/MANIFEST:NO",
    ],
    visibility = ["//visibility:public"],
)

# ── saxparser.rdb — registers com.sun.star.xml.sax.Parser → expwrap.dll ───────
# Build-time (NONE-layer) URI: resolved against -env:OOO_INBUILD_SHAREDLIB_DIR
# (the staged tools dir) at codegen time.  Mirrors the expwrap.inbuild.component
# that dmake feeds packcomponents.xslt.
services_rdb(
    name       = "saxparser_rdb",
    components = {
        "//main/sax:source/expatwrap/expwrap.component":
            "vnd.sun.star.expand:$OOO_INBUILD_SHAREDLIB_DIR/expwrap.dll",
    },
    out        = "saxparser.rdb",
    xslt       = "//main/solenv/bin:packcomponents.xslt",
)

