# ── lrl_include.hxx ──────────────────────────────────────────────
# Defines LOCAL_RULE_LANGS for collator_unicode.cxx.
# Language list derived from collator/data/ .txt file prefixes (unique, sorted):
#   dz_* hu_* ja_* ko_* ku_* ln_* my_* ne_* zh_*
genrule(
    name = "lrl_include_hxx",
    outs = ["lrl_include.hxx"],
    cmd_bat = "@echo #define LOCAL_RULE_LANGS \"dz hu ja ko ku ln my ne zh\" > \"$@\"",
)

# Wrap the generated header in a cc_library so Bazel creates a _virtual_includes
# symlink and propagates the correct -I path to dependents.
# strip_include_prefix strips "main/i18npool/pool" from the repo-root path
# so the header is includable as just "lrl_include.hxx".
cc_library(
    name = "lrl_include_lib",
    hdrs = [":lrl_include_hxx"],
    strip_include_prefix = "/main/i18npool/pool",
)

# ── Breakiterator data pipeline ───────────────────────────────────
# char_in.txt defines $Prepend = [\p{Grapheme_Cluster_Break = Prepend}] which was
# empty in Unicode 6.0 (ICU 49). ICU 4.6+ treats empty property sets as an error.
# Patch char_in-icu49.patch removes the Prepend definition and its two rules (no-ops).
# line.txt and sent.txt are dropped entirely: BreakIterator_Unicode::loadICUBreakIterator()
# falls back to ICU's own built-in break rules when OpenOffice-specific files are absent.
genrule(
    name = "char_in_txt_patched",
    srcs = ["//main/i18npool:source/breakiterator/data/char_in.txt"],
    outs = ["char_in_patched.txt"],
    # char_in-icu49.patch (sibling file) documents the change as a proper unified diff.
    # findstr /v filters out every line that contains the literal string "$Prepend":
    #   - the variable definition  ($Prepend = [...])
    #   - the forward rule         ($Prepend [^...])
    #   - the reverse rule         ([^...] $Prepend)
    # $$Prepend → $Prepend after Bazel make-variable escaping.
    cmd_bat = "findstr /v /c:\"$$Prepend\" \"$(execpath //main/i18npool:source/breakiterator/data/char_in.txt)\" > \"$@\"",
)

breakiter_data(
    name = "breakiter_generated",
    srcs = [
        ":char_in_txt_patched",
        "//main/i18npool:source/breakiterator/data/count_word.txt",
        "//main/i18npool:source/breakiterator/data/count_word_fi.txt",
        "//main/i18npool:source/breakiterator/data/dict_word.txt",
        "//main/i18npool:source/breakiterator/data/dict_word_ca.txt",
        "//main/i18npool:source/breakiterator/data/dict_word_fi.txt",
        "//main/i18npool:source/breakiterator/data/dict_word_he.txt",
        "//main/i18npool:source/breakiterator/data/dict_word_hu.txt",
        "//main/i18npool:source/breakiterator/data/dict_word_nodash.txt",
        "//main/i18npool:source/breakiterator/data/dict_word_prepostdash.txt",
        "//main/i18npool:source/breakiterator/data/edit_word.txt",
        "//main/i18npool:source/breakiterator/data/edit_word_he.txt",
        "//main/i18npool:source/breakiterator/data/edit_word_hu.txt",
        # line.txt and sent.txt omitted: per ext_libraries/modules/icu/Readme.md,
        # BreakIterator_Unicode::loadICUBreakIterator() falls back to ICU's own
        # built-in break rules when the custom files cannot be loaded.  The
        # OpenOffice-specific rules do not compile cleanly against ICU 49 anyway.
    ],
    genbrk    = "@icu//:genbrk",
    gencmn    = "@icu//:gencmn",
    genccode  = "@icu//:genccode",
    icudt_dat = "@icu//:icudt49l_dat",
)

# ── Per-subsystem object libraries ───────────────────────────────
# indexentry, nativenumber, and transliteration each carry a local
# data/ subdirectory with headers that must be found via their own
# parent directory on the include path.  The two data/numberchar.h
# files differ between nativenumber and transliteration, so they
# cannot share a single -I path — each gets its own cc_library.

_SUBSYSTEM_DEPS = _COMMON_DEPS + [
    "//main/i18npool:i18npool_headers",
    "//main/i18nutil:i18nutil_headers",
    "//main/comphelper:comphelper_headers",
    "@icu//:icuuc_headers",
    "@icu//:icui18n_headers",
    ":lrl_include_lib",
]

