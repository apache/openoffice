# ── Private source-tree headers ───────────────────────────────────────────────
cc_library(
    name = "sc_source_ui_inc",
    textual_hdrs = glob(["source/ui/inc/**"]),
    strip_include_prefix = "source/ui/inc",
)

cc_library(
    name = "sc_source_core_inc",
    textual_hdrs = glob(["source/core/inc/**"]),
    strip_include_prefix = "source/core/inc",
)

cc_library(
    name = "sc_source_filter_inc",
    textual_hdrs = glob(["source/filter/inc/**"]),
    strip_include_prefix = "source/filter/inc",
)

cc_library(
    name = "sc_source_hdrs",
    textual_hdrs = glob(
        [
            "source/**/*.hxx",
            "source/**/*.hrc",
            "sdi/*.hrc",
        ],
        exclude = [
            "source/ui/inc/**",
            "source/core/inc/**",
            "source/filter/inc/**",
        ],
    ),
)

# ── SDI slot header generation ────────────────────────────────────────────────
sdi_target(
    name = "scslots_sdi",
    main_sdi  = "sdi/scslots.sdi",
    exports   = "sdi/scalc.sdi",
    srcs      = glob(["sdi/*.sdi", "sdi/*.hrc", "inc/*.hrc"]),
    slot_name = "scslots",
    include_dirs = [
        "main/sc/inc",
        "main/sc/sdi",
        "main/sc/source/ui/inc",
        "main/sfx2/sdi",
        "main/sfx2/inc/sfx2",
        "main/sfx2/inc",
        "main/svx/sdi",
        "main/svx/inc",
        "main/svl/inc",
        "main/editeng/inc",
    ],
    pkg_deps = [
        "//main/sfx2:sfx2_sdi_pkg",
        "//main/svx:svx_sdi_pkg",
    ],
)

cc_library(
    name = "scslots_headers",
    hdrs     = [":scslots_sdi"],
    includes = ["scslots_sdi_inc"],
    visibility = ["//visibility:public"],
)

# ── Common deps shared by sc, scfilt, scui, vbaobj ───────────────────────────
_SC_DEPS = [
    ":sc_headers",
    ":scslots_headers",
    ":sc_source_ui_inc",
    ":sc_source_core_inc",
    ":sc_source_filter_inc",
    ":sc_source_hdrs",
    "//main/sax:sax_headers",
    "//main/oox:oox_headers",
    "//main/stlport:stlport",
    "@boost.legacy//:boost.legacy",
    "@mdds//:mdds",
]

