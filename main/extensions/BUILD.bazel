# main/extensions — UNO extension infrastructure (abpilot, bibliography, dbpilots,
# logging, oooimprovecore, oooimprovement, preload, propctrlr, resource, scanner,
# update/feed, update/check, update/ui, xmlextract)
# Windows-only ATL component: ole/oleautobridge.uno
# Deferred: config/ldap (needs LDAP SDK), mozbootstrap (Linux/macOS only),
#            activex/msidl, activex/main (ActiveX/COM, needs special tooling)

package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//build/rules:rsc_pipeline.bzl", "rsc_res")

# ── Component XML files (for services.rdb via postprocess) ────────────────────
exports_files(glob([
    "**/*.component",
]))

# ── uiconfig — bibliography browser form UI ───────────────────────────────────
filegroup(
    name = "uiconfig_files",
    srcs = glob(["source/bibliography/uiconfig/**/*.xml"]),
    visibility = ["//main/postprocess:__pkg__"],
)

# ─────────────────────────────────────────────────────────────────────────────
# Common build settings
# ─────────────────────────────────────────────────────────────────────────────

_DEFINES = [
    "WNT", "GUI", "WIN32",
    "WINVER=0x0500", "_WIN32_WINNT=0x0500", "_WIN32_IE=0x0500",
    "CPPU_ENV=msci", "INTEL", "_X86_=1",
    "FULL_DESK", "SHAREDLIB", "_DLL_",
    "snprintf=_snprintf",
    "snwprintf=_snwprintf",
    "SUPD=680",
    "MSC",
]

_COPTS = [
    "/Imain/extensions/inc",
    "/Imain/extensions/inc/pch",
    "/Zc:wchar_t-",
]

_COMMON_DEPS = [
    "//main/sal:sal_headers",
    "//main/cppu:cppu_headers",
