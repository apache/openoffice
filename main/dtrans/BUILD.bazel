        "source/win32/ftransl/ftransl.cxx",
        "source/win32/ftransl/ftranslentry.cxx",
        "source/win32/misc/ImplHelper.cxx",
        "source/win32/ftransl/ftransl.hxx",
        "source/win32/misc/ImplHelper.hxx",
        "source/win32/misc/WinClip.hxx",
        "inc/pch/precompiled_dtrans.hxx",
    ],
    copts = _COPTS + [
        "/Imain/dtrans/inc/pch",
        "/Imain/dtrans/source/win32/ftransl",
        "/Imain/dtrans/source/win32/misc",
    ],
    defines = _DEFINES,
    linkshared = True,
    win_def_file = "util/ftransl.def",
    deps = _COMMON_DEPS,
    additional_linker_inputs = _COMMON_IMPLIBS,
    linkopts = _COMMON_LINKOPTS + [
        "advapi32.lib", "gdi32.lib", "ole32.lib",
    ],
    visibility = ["//visibility:public"],
)

# dtobj + misc compiled WITHOUT UNICODE: these files call narrow Win32 APIs
# (e.g. RegisterClipboardFormatA) and break when UNICODE is defined globally.
# The original makefile compiled them with only -GR -Ob0, no -DUNICODE.
cc_library(
    name = "_sysdtrans_dtobj",
    srcs = [
        "source/win32/dtobj/DtObjFactory.cxx",
        "source/win32/dtobj/APNDataObject.cxx",
        "source/win32/dtobj/DOTransferable.cxx",
        "source/win32/dtobj/DTransHelper.cxx",
        "source/win32/dtobj/XTDataObject.cxx",
        "source/win32/dtobj/TxtCnvtHlp.cxx",
        "source/win32/dtobj/DataFmtTransl.cxx",
        "source/win32/dtobj/FmtFilter.cxx",
        "source/win32/dtobj/FetcList.cxx",
        "source/win32/dtobj/Fetc.cxx",
        "source/win32/dtobj/XNotifyingDataObject.cxx",
        "source/win32/misc/ImplHelper.cxx",
        "source/win32/dtobj/APNDataObject.hxx",
        "source/win32/dtobj/DOTransferable.hxx",
        "source/win32/dtobj/DTransHelper.hxx",
        "source/win32/dtobj/DataFmtTransl.hxx",
        "source/win32/dtobj/Fetc.hxx",
        "source/win32/dtobj/FetcList.hxx",
        "source/win32/dtobj/FmtFilter.hxx",
        "source/win32/dtobj/MimeAttrib.hxx",
        "source/win32/dtobj/TxtCnvtHlp.hxx",
        "source/win32/dtobj/XNotifyingDataObject.hxx",
        "source/win32/dtobj/XTDataObject.hxx",
        "source/win32/misc/ImplHelper.hxx",
        "source/win32/misc/WinClip.hxx",
        "source/inc/DtObjFactory.hxx",
        "source/inc/MtaOleClipb.hxx",
        "inc/pch/precompiled_dtrans.hxx",
    ],
    copts = _COPTS + [
        "/Imain/dtrans/inc/pch",
        "/Imain/dtrans/source/win32/dtobj",
        "/Imain/dtrans/source/win32/misc",
        "/GR",
    ],
    defines = _DEFINES,
    deps = _COMMON_DEPS,
)

# ── sysdtrans.dll ─────────────────────────────────────────────────────────────
# Windows system clipboard UNO service (ClipboardW32).
# clipb + mtaole compiled WITH UNICODE; dtobj compiled without (see above).
cc_binary(
    name = "sysdtrans",
    srcs = [
        # clipboard (UNICODE W-API callers)
        "source/win32/clipb/WinClipboard.cxx",
        "source/win32/clipb/WinClipbImpl.cxx",
        "source/win32/clipb/wcbentry.cxx",
        # MTA OLE clipboard thread (UNICODE)
        "source/win32/mtaole/MtaOleClipb.cxx",
        # headers — clipb
        "source/win32/clipb/APNDataObject.hxx",
        "source/win32/clipb/WinClipbImpl.hxx",
        "source/win32/clipb/WinClipboard.hxx",
        # dtobj headers needed by clipb relative includes ("..\dtobj\...")
        "source/win32/dtobj/APNDataObject.hxx",
        "source/win32/dtobj/XNotifyingDataObject.hxx",
        # shared internal headers reached via "..\..\inc\..." relative includes
        "source/inc/DtObjFactory.hxx",
        "source/inc/MtaOleClipb.hxx",
        # pch
        "inc/pch/precompiled_dtrans.hxx",
    ],
    copts = _COPTS + [
        "/Imain/dtrans/inc/pch",
        "/Imain/dtrans/source/win32/clipb",
        "/Imain/dtrans/source/win32/dtobj",
        "/Imain/dtrans/source/win32/misc",
    ],
    defines = _DEFINES + ["UNICODE", "_UNICODE"],
    linkshared = True,
    win_def_file = "util/sysdtrans.def",
    deps = _COMMON_DEPS + [":_sysdtrans_dtobj"],
    additional_linker_inputs = _COMMON_IMPLIBS,
    linkopts = _COMMON_LINKOPTS + [
        "advapi32.lib", "gdi32.lib", "ole32.lib", "oleaut32.lib",
        "shell32.lib", "user32.lib", "uuid.lib",
    ],
    visibility = ["//visibility:public"],
)
