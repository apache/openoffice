# ── Targets ───────────────────────────────────────────────────────────────────

services_rdb(
    name       = "services_rdb",
    components = _SERVICES_COMPONENTS,
    out        = "services.rdb",
    xslt       = "//main/solenv/bin:packcomponents.xslt",
    visibility = ["//visibility:public"],
)

uiconfig_zip(
    name       = "uiconfig_zip",
    srcs       = _UICONFIG_SRCS,
    visibility = ["//visibility:public"],
)

# Convenience: build all postprocess outputs in one shot.
filegroup(
    name = "all",
    srcs = [
        ":services_rdb",
        ":uiconfig_zip",
    ],
    visibility = ["//visibility:public"],
)

# ── XCD registry packages ─────────────────────────────────────────────────────
# Each pack_registry target corresponds to one .xcd file produced by the old
# packregistry make target.  XCS files must come first (configmgr requirement).
#
# File categories:
#   XCS     : static schema files from //main/officecfg:registry/schema/...
#   XCU-raw : static data files  from //main/officecfg:registry/data/...
#   XCU-mod : module extractions from //main/officecfg:spool_module/...
#   XCU-fcfg: FCFGMerge outputs  from //main/filter/source/config/fragments:...
#   XCU-da  : DataAccess XCU     from //main/connectivity:source/drivers/...
#   XCU-ext : static from other modules (sdext, extensions, lingucomponent)

_XSLT = "//main/solenv/bin:packregistry.xslt"

