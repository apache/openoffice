# main/postprocess — post-build registry and configuration packaging
#
# Outputs
# ───────
#   services_rdb      → services.rdb  + services.input
#   uiconfig_zip      → uiconfig.zip
#
# How to build
# ────────────
#   bazel build //main/postprocess:services_rdb
#   bazel build //main/postprocess:uiconfig_zip
#   bazel build //main/postprocess:all          # all three
#
# Deferred
# ────────
#   packregistry (.xcd files) — requires spool-generated .xcu files from
#   officecfg module-extraction and filter/FCFGMerge pipelines.
#   Implement after those pipelines are in place.

load(":postprocess.bzl", "services_rdb", "uiconfig_zip", "uiconfig_tree", "pack_registry",
     "oc_xcs", "oc_xcu", "oc_mod", "fcfg",
     "basis_native", "basis_java", "ure_java", "pymodule")
load("@product_info//:defs.bzl", "PRODUCT_NAME", "PRODUCT_FULLNAME", "PRODUCT_VERSION")

# ── Component files — Windows build ──────────────────────────────────────────
# Mirrors packcomponents/makefile.mk my_components for OS=WNT.
# Java-only components (ScriptFramework, hsqldb, jdbc, postgresql, wizards,
# XMergeBridge, LuceneHelpWrapper, XSLTValidate) are omitted — Java build
# is deferred.  ENABLE_ONLINE_UPDATE components (updchk.uno) are included.

# Map each .component file to its full URI string (injected via createcomponent.xslt).
# Native DLLs:  basis_native("foo.dll")
# Java JARs:    basis_java("Foo.jar") or ure_java("foo.jar")
# Python mods:  pymodule("module_name")
