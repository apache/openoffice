# ── Targets ───────────────────────────────────────────────────────────────────

services_rdb(
    name       = "services_rdb",
    components = _SERVICES_COMPONENTS,
    xslt       = "//main/solenv/bin:packcomponents.xslt",
    visibility = ["//visibility:public"],
)

services_rdb(
    name       = "ooo_services_rdb",
    components = _OOO_SERVICES_COMPONENTS,
    xslt       = "//main/solenv/bin:packcomponents.xslt",
    visibility = ["//visibility:public"],
)

uiconfig_zip(
    name       = "uiconfig_zip",
    srcs       = _UICONFIG_SRCS,
    visibility = ["//visibility:public"],
)

# Convenience: build all postprocess outputs in one shot.
filegroup(
    name = "all",
    srcs = [
        ":services_rdb",
        ":ooo_services_rdb",
        ":uiconfig_zip",
    ],
    visibility = ["//visibility:public"],
)
