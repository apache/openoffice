# main/postprocess — post-build registry and configuration packaging
#
# Outputs
# ───────
#   services_rdb      → services.rdb  + services.input
#   uiconfig_zip      → uiconfig.zip
#
# How to build
# ────────────
#   bazel build //main/postprocess:services_rdb
#   bazel build //main/postprocess:uiconfig_zip
#   bazel build //main/postprocess:all          # all three
#
# Deferred
# ────────
#   packregistry (.xcd files) — requires spool-generated .xcu files from
#   officecfg module-extraction and filter/FCFGMerge pipelines.
#   Implement after those pipelines are in place.

load(":postprocess.bzl", "services_rdb", "uiconfig_zip", "pack_registry",
     "oc_xcs", "oc_xcu", "oc_mod", "fcfg")

