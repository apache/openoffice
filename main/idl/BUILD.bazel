load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//build/rules:sdi_target.bzl", "svidl_bundle")

_DEFINES = [
    "WNT", "GUI", "WIN32",
    "WINVER=0x0500", "_WIN32_WINNT=0x0500", "_WIN32_IE=0x0500",
    "CPPU_ENV=msci", "INTEL", "_X86_=1",
    "snprintf=_snprintf",
    "IDL_COMPILER",
]

_COPTS = [
    "/Imain/idl/inc",
    "/Imain/idl/inc/pch",
    "/Zc:wchar_t-",
    "/MD",
    "/Od",
]

_SRCS = [
    "source/cmptools/char.cxx",
    "source/cmptools/hash.cxx",
    "source/cmptools/lex.cxx",
    "source/objects/basobj.cxx",
    "source/objects/bastype.cxx",
    "source/objects/module.cxx",
    "source/objects/object.cxx",
    "source/objects/slot.cxx",
    "source/objects/types.cxx",
    "source/prj/command.cxx",
    "source/prj/database.cxx",
    "source/prj/globals.cxx",
    "source/prj/svidl.cxx",
]

cc_binary(
    name = "svidl",
    srcs = _SRCS + glob(["inc/**"]),
    copts = _COPTS,
    defines = _DEFINES,
    # Disable the toolchain's opt feature so /O2 is never added in exec config.
    # svidl has a use-after-free in SvMetaSlot::Insert that only manifests
    # under optimization; /Od in copts alone does not reliably override /O2
    # in MSVC 2008.
    features = ["-opt"],
    deps = [
        "//main/sal:sal_headers",
        "//main/tools:tools_headers",
        "//main/stlport:stlport",
    ],
    additional_linker_inputs = [
        "//main/sal:sal_implib",
        "//main/tools:tl_implib",
    ],
    linkopts = [
        "$(execpath //main/sal:sal_implib)",
        "$(execpath //main/tools:tl_implib)",
        "/MANIFEST:NO",
    ],
    # Runtime DLLs for svidl_bundle — staged once in main/idl/svidl_bundle/.
    # svidl is /MD; sal3.dll and the others are also /MD — all share the same
    # msvcr90.dll instance from crt_dlls, so no CRT conflict occurs.
    data = [
        "//main/sal:sal3",
        "//main/tools:tl",
        "//main/cppu:cppu3",
        "//main/comphelper:comphelp",
        "//main/cppuhelper:cppuhelper3MSC",
        "//main/salhelper:salhelper3MSC",
        "//main/ucbhelper:ucbhelper",
        "//main/vos:vos3",
        "//main/basegfx:basegfx",
        "//main/i18npool:i18nisolang1",
        "//main/external/msvcp90:crt_dlls",
    ],
    visibility = ["//visibility:public"],
)

# One shared tool directory: svidl.exe + all runtime DLLs staged once.
# Every sdi_target instance uses this bundle; no per-module tool staging.
svidl_bundle(
    name = "svidl_bundle",
    svidl = ":svidl",
    visibility = ["//visibility:public"],
)
