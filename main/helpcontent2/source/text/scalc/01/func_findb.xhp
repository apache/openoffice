<helpdocument version="1.0">
<meta>
<topic id="textscalc01func_findbxml" indexer="include" status="PUBLISH">
<title id="tit" xml-lang="en-US">FINDB</title>
<filename>/text/scalc/01/func_findb.xhp</filename>
</topic>
</meta>
<body>
<bookmark xml-lang="en-US" branch="index" id="bm_id3155611">
<bookmark_value>FINDB function</bookmark_value>
<bookmark_value>find text; byte position</bookmark_value>
</bookmark>
<bookmark xml-lang="en-US" branch="hid/SC_HID_FUNC_FINDB" id="bm_id3155612" localize="false"/>
<paragraph role="heading" id="hd_id3155610" xml-lang="en-US" level="2" l10n="U"><variable id="findb"><link href="text/scalc/01/func_findb.xhp">FINDB</link>
</variable></paragraph>
<paragraph role="paragraph" id="par_id3155613" xml-lang="en-US" l10n="U"><ahelp hid="HID_FUNC_FINDB">Finds a text string within another text string and returns the starting position as a byte count. The search is case-sensitive.</ahelp></paragraph>
<paragraph role="heading" id="hd_id3155614" xml-lang="en-US" level="3" l10n="U">Syntax</paragraph>
<paragraph role="code" id="par_id3155615" xml-lang="en-US" l10n="U">FINDB(FindText; Text; StartPosition)</paragraph>
<paragraph role="paragraph" id="par_id3155616" xml-lang="en-US" l10n="U"><emph>FindText</emph> is the text to search for.</paragraph>
<paragraph role="paragraph" id="par_id3155617" xml-lang="en-US" l10n="U"><emph>Text</emph> is the text in which to search.</paragraph>
<paragraph role="paragraph" id="par_id3155618" xml-lang="en-US" l10n="U"><emph>StartPosition</emph> (optional) is the byte position in Text at which to start the search. Default is 1.</paragraph>
<paragraph role="paragraph" id="par_id3155619" xml-lang="en-US" l10n="U">Returns a byte position (1-based). Double-byte characters count as 2 bytes; single-byte characters count as 1 byte.</paragraph>
<paragraph role="heading" id="hd_id3155620" xml-lang="en-US" level="3" l10n="U">Examples</paragraph>
<paragraph role="paragraph" id="par_id3155621" xml-lang="en-US" l10n="U"><item type="input">=FINDB("b";"abc")</item> returns 2.</paragraph>
<paragraph role="paragraph" id="par_id3155622" xml-lang="en-US" l10n="U"><item type="input">=FINDB("B";"abc")</item> returns #VALUE! (case-sensitive).</paragraph>
</body>
</helpdocument>
