<helpdocument version="1.0">
<meta>
<topic id="textscalc01func_searchbxml" indexer="include" status="PUBLISH">
<title id="tit" xml-lang="en-US">SEARCHB</title>
<filename>/text/scalc/01/func_searchb.xhp</filename>
</topic>
</meta>
<body>
<bookmark xml-lang="en-US" branch="index" id="bm_id3155631">
<bookmark_value>SEARCHB function</bookmark_value>
<bookmark_value>search text; byte position</bookmark_value>
</bookmark>
<bookmark xml-lang="en-US" branch="hid/SC_HID_FUNC_SEARCHB" id="bm_id3155632" localize="false"/>
<paragraph role="heading" id="hd_id3155630" xml-lang="en-US" level="2" l10n="U"><variable id="searchb"><link href="text/scalc/01/func_searchb.xhp">SEARCHB</link>
</variable></paragraph>
<paragraph role="paragraph" id="par_id3155633" xml-lang="en-US" l10n="U"><ahelp hid="HID_FUNC_SEARCHB">Finds a text string within another text string and returns the starting position as a byte count. The search is not case-sensitive and supports wildcards.</ahelp></paragraph>
<paragraph role="heading" id="hd_id3155634" xml-lang="en-US" level="3" l10n="U">Syntax</paragraph>
<paragraph role="code" id="par_id3155635" xml-lang="en-US" l10n="U">SEARCHB(FindText; Text; StartPosition)</paragraph>
<paragraph role="paragraph" id="par_id3155636" xml-lang="en-US" l10n="U"><emph>FindText</emph> is the text to search for. Wildcard characters ? (any single character) and * (any sequence of characters) are supported.</paragraph>
<paragraph role="paragraph" id="par_id3155637" xml-lang="en-US" l10n="U"><emph>Text</emph> is the text in which to search.</paragraph>
<paragraph role="paragraph" id="par_id3155638" xml-lang="en-US" l10n="U"><emph>StartPosition</emph> (optional) is the byte position in Text at which to start the search. Default is 1.</paragraph>
<paragraph role="paragraph" id="par_id3155639" xml-lang="en-US" l10n="U">Returns a byte position (1-based). Double-byte characters count as 2 bytes; single-byte characters count as 1 byte.</paragraph>
<paragraph role="heading" id="hd_id3155640" xml-lang="en-US" level="3" l10n="U">Examples</paragraph>
<paragraph role="paragraph" id="par_id3155641" xml-lang="en-US" l10n="U"><item type="input">=SEARCHB("B";"abc")</item> returns 2.</paragraph>
<paragraph role="paragraph" id="par_id3155642" xml-lang="en-US" l10n="U"><item type="input">=SEARCHB("a?c";"abc")</item> returns 1.</paragraph>
</body>
</helpdocument>
