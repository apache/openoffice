<helpdocument version="1.0">
<meta>
<topic id="textscalc01func_bitxxml" indexer="include" status="PUBLISH">
<title id="tit" xml-lang="en-US">BITXOR</title>
<filename>/text/scalc/01/func_bitxor.xhp</filename>
</topic>
</meta>
<body>
<bookmark xml-lang="en-US" branch="index" id="bm_id3160401">
<bookmark_value>BITXOR function</bookmark_value>
<bookmark_value>bitwise XOR</bookmark_value>
</bookmark>
<bookmark xml-lang="en-US" branch="hid/SC_HID_FUNC_BITXOR" id="bm_id3160402" localize="false"/>
<paragraph role="heading" id="hd_id3160401" xml-lang="en-US" level="2" l10n="U"><variable id="bitxor"><link href="text/scalc/01/func_bitxor.xhp">BITXOR</link>
</variable></paragraph>
<paragraph role="paragraph" id="par_id3160403" xml-lang="en-US" l10n="U"><ahelp hid="HID_FUNC_BITXOR">Returns the bitwise XOR (exclusive OR) of two integers.</ahelp> Each bit of the result is 1 if the corresponding bits of the two arguments differ.</paragraph>
<paragraph role="heading" id="hd_id3160404" xml-lang="en-US" level="3" l10n="U">Syntax</paragraph>
<paragraph role="code" id="par_id3160405" xml-lang="en-US" l10n="U">BITXOR(Number1; Number2)</paragraph>
<paragraph role="paragraph" id="par_id3160406" xml-lang="en-US" l10n="U"><emph>Number1</emph> and <emph>Number2</emph> are integers greater than or equal to 0 and less than 2^48 (281474976710656).</paragraph>
<paragraph role="heading" id="hd_id3160407" xml-lang="en-US" level="3" l10n="U">Remarks</paragraph>
<paragraph role="paragraph" id="par_id3160408" xml-lang="en-US" l10n="U">Arguments are truncated to integers before the operation. Non-integer, negative, or out-of-range values return an error (Err:502).</paragraph>
<paragraph role="paragraph" id="par_id3160409" xml-lang="en-US" l10n="U">Example: decimal 6 is binary <quote>110</quote>, decimal 3 is binary <quote>011</quote>. BITXOR(6; 3) returns 5 (binary <quote>101</quote>).</paragraph>
<paragraph role="heading" id="hd_id3160410" xml-lang="en-US" level="3" l10n="U">Example</paragraph>
<paragraph role="paragraph" id="par_id3160411" xml-lang="en-US" l10n="U"><item type="input">=BITXOR(6; 3)</item> returns 5.</paragraph>
<embed href="text/shared/00/00000001.xhp#siehe"/>
<paragraph role="paragraph" id="par_id3160412" xml-lang="en-US" l10n="U"><link href="text/scalc/01/func_bitand.xhp" name="BITAND">BITAND</link>, <link href="text/scalc/01/func_bitor.xhp" name="BITOR">BITOR</link>.</paragraph>
</body>
</helpdocument>
