<helpdocument version="1.0">
<meta>
<topic id="textscalc01func_bitorxml" indexer="include" status="PUBLISH">
<title id="tit" xml-lang="en-US">BITOR</title>
<filename>/text/scalc/01/func_bitor.xhp</filename>
</topic>
</meta>
<body>
<bookmark xml-lang="en-US" branch="index" id="bm_id3160301">
<bookmark_value>BITOR function</bookmark_value>
<bookmark_value>bitwise OR</bookmark_value>
</bookmark>
<bookmark xml-lang="en-US" branch="hid/SC_HID_FUNC_BITOR" id="bm_id3160302" localize="false"/>
<paragraph role="heading" id="hd_id3160301" xml-lang="en-US" level="2" l10n="U"><variable id="bitor"><link href="text/scalc/01/func_bitor.xhp">BITOR</link>
</variable></paragraph>
<paragraph role="paragraph" id="par_id3160303" xml-lang="en-US" l10n="U"><ahelp hid="HID_FUNC_BITOR">Returns the bitwise OR of two integers.</ahelp> Each bit of the result is 1 if the corresponding bit of either argument is 1.</paragraph>
<paragraph role="heading" id="hd_id3160304" xml-lang="en-US" level="3" l10n="U">Syntax</paragraph>
<paragraph role="code" id="par_id3160305" xml-lang="en-US" l10n="U">BITOR(Number1; Number2)</paragraph>
<paragraph role="paragraph" id="par_id3160306" xml-lang="en-US" l10n="U"><emph>Number1</emph> and <emph>Number2</emph> are integers greater than or equal to 0 and less than 2^48 (281474976710656).</paragraph>
<paragraph role="heading" id="hd_id3160307" xml-lang="en-US" level="3" l10n="U">Remarks</paragraph>
<paragraph role="paragraph" id="par_id3160308" xml-lang="en-US" l10n="U">Arguments are truncated to integers before the operation. Non-integer, negative, or out-of-range values return an error (Err:502).</paragraph>
<paragraph role="paragraph" id="par_id3160309" xml-lang="en-US" l10n="U">Example: decimal 6 is binary <quote>110</quote>, decimal 3 is binary <quote>011</quote>. BITOR(6; 3) returns 7 (binary <quote>111</quote>).</paragraph>
<paragraph role="heading" id="hd_id3160310" xml-lang="en-US" level="3" l10n="U">Example</paragraph>
<paragraph role="paragraph" id="par_id3160311" xml-lang="en-US" l10n="U"><item type="input">=BITOR(6; 3)</item> returns 7.</paragraph>
<embed href="text/shared/00/00000001.xhp#siehe"/>
<paragraph role="paragraph" id="par_id3160312" xml-lang="en-US" l10n="U"><link href="text/scalc/01/func_bitand.xhp" name="BITAND">BITAND</link>, <link href="text/scalc/01/func_bitxor.xhp" name="BITXOR">BITXOR</link>.</paragraph>
</body>
</helpdocument>
