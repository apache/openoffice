<helpdocument version="1.0">
<meta>
<topic id="textscalc01func_numbervaluexml" indexer="include" status="PUBLISH">
<title id="tit" xml-lang="en-US">NUMBERVALUE</title>
<filename>/text/scalc/01/func_numbervalue.xhp</filename>
</topic>
</meta>
<body>
<bookmark xml-lang="en-US" branch="index" id="bm_id3155591">
<bookmark_value>NUMBERVALUE function</bookmark_value>
<bookmark_value>text to number conversion</bookmark_value>
</bookmark>
<bookmark xml-lang="en-US" branch="hid/SC_HID_FUNC_NUMBERVALUE" id="bm_id3155592" localize="false"/>
<paragraph role="heading" id="hd_id3155590" xml-lang="en-US" level="2" l10n="U"><variable id="numbervalue"><link href="text/scalc/01/func_numbervalue.xhp">NUMBERVALUE</link>
</variable></paragraph>
<paragraph role="paragraph" id="par_id3155593" xml-lang="en-US" l10n="U"><ahelp hid="HID_FUNC_NUMBERVALUE">Converts text to a number, using explicitly specified decimal and group separators.</ahelp></paragraph>
<paragraph role="heading" id="hd_id3155594" xml-lang="en-US" level="3" l10n="U">Syntax</paragraph>
<paragraph role="code" id="par_id3155595" xml-lang="en-US" l10n="U">NUMBERVALUE(Text; DecimalSeparator; GroupSeparator)</paragraph>
<paragraph role="paragraph" id="par_id3155596" xml-lang="en-US" l10n="U"><emph>Text</emph> is the text to be converted to a number.</paragraph>
<paragraph role="paragraph" id="par_id3155597" xml-lang="en-US" l10n="U"><emph>DecimalSeparator</emph> is the character used as the decimal separator. If omitted, the system locale default is used.</paragraph>
<paragraph role="paragraph" id="par_id3155598" xml-lang="en-US" l10n="U"><emph>GroupSeparator</emph> is the character used as the group (thousands) separator. If omitted, the system locale default is used.</paragraph>
<paragraph role="heading" id="hd_id3155599" xml-lang="en-US" level="3" l10n="U">Examples</paragraph>
<paragraph role="paragraph" id="par_id3155600" xml-lang="en-US" l10n="U"><item type="input">=NUMBERVALUE("1.234";".";",")</item> returns 1.234.</paragraph>
<paragraph role="paragraph" id="par_id3155601" xml-lang="en-US" l10n="U"><item type="input">=NUMBERVALUE("1.234,56";",";".")</item> returns 1234.56.</paragraph>
<paragraph role="paragraph" id="par_id3155602" xml-lang="en-US" l10n="U"><item type="input">=NUMBERVALUE("123%")</item> returns 1.23.</paragraph>
</body>
</helpdocument>
