<helpdocument version="1.0">
<meta>
<topic id="textscalc01func_replacebxml" indexer="include" status="PUBLISH">
<title id="tit" xml-lang="en-US">REPLACEB</title>
<filename>/text/scalc/01/func_replaceb.xhp</filename>
</topic>
</meta>
<body>
<bookmark xml-lang="en-US" branch="index" id="bm_id3155651">
<bookmark_value>REPLACEB function</bookmark_value>
<bookmark_value>replace text; byte position</bookmark_value>
</bookmark>
<bookmark xml-lang="en-US" branch="hid/SC_HID_FUNC_REPLACEB" id="bm_id3155652" localize="false"/>
<paragraph role="heading" id="hd_id3155650" xml-lang="en-US" level="2" l10n="U"><variable id="replaceb"><link href="text/scalc/01/func_replaceb.xhp">REPLACEB</link>
</variable></paragraph>
<paragraph role="paragraph" id="par_id3155653" xml-lang="en-US" l10n="U"><ahelp hid="HID_FUNC_REPLACEB">Replaces part of a text string, based on byte positions, with a different text string.</ahelp></paragraph>
<paragraph role="heading" id="hd_id3155654" xml-lang="en-US" level="3" l10n="U">Syntax</paragraph>
<paragraph role="code" id="par_id3155655" xml-lang="en-US" l10n="U">REPLACEB(OldText; StartPosition; ByteCount; NewText)</paragraph>
<paragraph role="paragraph" id="par_id3155656" xml-lang="en-US" l10n="U"><emph>OldText</emph> is the text in which to replace characters.</paragraph>
<paragraph role="paragraph" id="par_id3155657" xml-lang="en-US" l10n="U"><emph>StartPosition</emph> is the byte position at which to start replacing. The first byte is position 1.</paragraph>
<paragraph role="paragraph" id="par_id3155658" xml-lang="en-US" l10n="U"><emph>ByteCount</emph> is the number of bytes to replace.</paragraph>
<paragraph role="paragraph" id="par_id3155659" xml-lang="en-US" l10n="U"><emph>NewText</emph> is the text to insert.</paragraph>
<paragraph role="paragraph" id="par_id3155660" xml-lang="en-US" l10n="U">Double-byte characters count as 2 bytes; single-byte characters count as 1 byte.</paragraph>
<paragraph role="heading" id="hd_id3155661" xml-lang="en-US" level="3" l10n="U">Examples</paragraph>
<paragraph role="paragraph" id="par_id3155662" xml-lang="en-US" l10n="U"><item type="input">=REPLACEB("abc";2;1;"x")</item> returns "axc".</paragraph>
<paragraph role="paragraph" id="par_id3155663" xml-lang="en-US" l10n="U"><item type="input">=REPLACEB("abc";4;0;"d")</item> returns "abcd".</paragraph>
</body>
</helpdocument>
