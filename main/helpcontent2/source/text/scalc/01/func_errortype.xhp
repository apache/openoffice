<helpdocument version="1.0">
<meta>
<topic id="textscalc01func_errortypexml" indexer="include" status="PUBLISH">
<title id="tit" xml-lang="en-US">ERROR.TYPE</title>
<filename>/text/scalc/01/func_errortype.xhp</filename>
</topic>
</meta>
<body>
<bookmark xml-lang="en-US" branch="index" id="bm_id3155541">
<bookmark_value>ERROR.TYPE function</bookmark_value>
<bookmark_value>error type</bookmark_value>
</bookmark>
<bookmark xml-lang="en-US" branch="hid/SC_HID_FUNC_FEHLERTYP" id="bm_id3155542" localize="false"/>
<paragraph role="heading" id="hd_id3155540" xml-lang="en-US" level="2" l10n="U"><variable id="errortype"><link href="text/scalc/01/func_errortype.xhp">ERROR.TYPE</link>
</variable></paragraph>
<paragraph role="paragraph" id="par_id3155543" xml-lang="en-US" l10n="U"><ahelp hid="HID_FUNC_FEHLERTYP">Returns a number corresponding to the error type of the error value.</ahelp></paragraph>
<paragraph role="heading" id="hd_id3155544" xml-lang="en-US" level="3" l10n="U">Syntax</paragraph>
<paragraph role="code" id="par_id3155545" xml-lang="en-US" l10n="U">ERROR.TYPE(Reference)</paragraph>
<paragraph role="paragraph" id="par_id3155546" xml-lang="en-US" l10n="U"><emph>Reference</emph> is the cell reference or error value to be checked.</paragraph>
<paragraph role="heading" id="hd_id3155547" xml-lang="en-US" level="3" l10n="U">Return values</paragraph>
<table id="tbl_id3155548">
<tablerow>
<tablecell>
<paragraph role="tablehead" id="par_id3155549" xml-lang="en-US" l10n="U">Return value</paragraph>
</tablecell>
<tablecell>
<paragraph role="tablehead" id="par_id3155550" xml-lang="en-US" l10n="U">Error type</paragraph>
</tablecell>
</tablerow>
<tablerow>
<tablecell>
<paragraph role="tablecontent" id="par_id3155551" xml-lang="en-US" l10n="U">1</paragraph>
</tablecell>
<tablecell>
<paragraph role="tablecontent" id="par_id3155552" xml-lang="en-US" l10n="U">#NULL!</paragraph>
</tablecell>
</tablerow>
<tablerow>
<tablecell>
<paragraph role="tablecontent" id="par_id3155553" xml-lang="en-US" l10n="U">2</paragraph>
</tablecell>
<tablecell>
<paragraph role="tablecontent" id="par_id3155554" xml-lang="en-US" l10n="U">#DIV/0!</paragraph>
</tablecell>
</tablerow>
<tablerow>
<tablecell>
<paragraph role="tablecontent" id="par_id3155555" xml-lang="en-US" l10n="U">3</paragraph>
</tablecell>
<tablecell>
<paragraph role="tablecontent" id="par_id3155556" xml-lang="en-US" l10n="U">#VALUE!</paragraph>
</tablecell>
</tablerow>
<tablerow>
<tablecell>
<paragraph role="tablecontent" id="par_id3155557" xml-lang="en-US" l10n="U">4</paragraph>
</tablecell>
<tablecell>
<paragraph role="tablecontent" id="par_id3155558" xml-lang="en-US" l10n="U">#REF!</paragraph>
</tablecell>
</tablerow>
<tablerow>
<tablecell>
<paragraph role="tablecontent" id="par_id3155559" xml-lang="en-US" l10n="U">5</paragraph>
</tablecell>
<tablecell>
<paragraph role="tablecontent" id="par_id3155560" xml-lang="en-US" l10n="U">#NAME?</paragraph>
</tablecell>
</tablerow>
<tablerow>
<tablecell>
<paragraph role="tablecontent" id="par_id3155561" xml-lang="en-US" l10n="U">6</paragraph>
</tablecell>
<tablecell>
<paragraph role="tablecontent" id="par_id3155562" xml-lang="en-US" l10n="U">#NUM!</paragraph>
</tablecell>
</tablerow>
<tablerow>
<tablecell>
<paragraph role="tablecontent" id="par_id3155563" xml-lang="en-US" l10n="U">7</paragraph>
</tablecell>
<tablecell>
<paragraph role="tablecontent" id="par_id3155564" xml-lang="en-US" l10n="U">#N/A</paragraph>
</tablecell>
</tablerow>
</table>
<paragraph role="paragraph" id="par_id3155565" xml-lang="en-US" l10n="U">If <emph>Reference</emph> is not an error value, the function returns the #N/A error.</paragraph>
<paragraph role="heading" id="hd_id3155566" xml-lang="en-US" level="3" l10n="U">Examples</paragraph>
<paragraph role="paragraph" id="par_id3155567" xml-lang="en-US" l10n="U"><item type="input">=ERROR.TYPE(1/0)</item> returns 2.</paragraph>
<paragraph role="paragraph" id="par_id3155568" xml-lang="en-US" l10n="U"><item type="input">=ERROR.TYPE(#VALUE!)</item> returns 3.</paragraph>
</body>
</helpdocument>
