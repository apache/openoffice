load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

# ── create_sRGB_profile ───────────────────────────────────────────
# Builds the sRGB ICC profile generator binary, linking against
# @icc (SampleICC-1.3.2 patched for OOo/VS2008).
cc_binary(
    name = "create_sRGB_profile",
    srcs = ["source/create_sRGB_profile/create_sRGB_profile.cpp"],
    copts = [
        "/W3",
        "/wd4244",
        "/wd4267",
        "/wd4996",
        "/wd4800",
        "/wd4018",
    ],
    defines = [
        "WIN32",
        "_CRT_SECURE_NO_WARNINGS",
    ],
    deps = [
        "@sampleicc//:iccproflib",
        "@sampleicc//:icc_utils",
    ],
)

# ── sRGB-IEC61966-2.1.hxx generation ─────────────────────────────
# Runs create_sRGB_profile in its output directory so both generated
# files land in $(RULEDIR).  Only the .hxx is consumed downstream.
genrule(
    name = "gen_srgb",
    outs = [
        "sRGB-IEC61966-2.1.hxx",
        "sRGB-IEC61966-2.1.icc",
    ],
    tools = [":create_sRGB_profile"],
    cmd_bat = "set \"_WS=%cd%\"&& cd /d \"$(RULEDIR)\"&& \"!_WS!\\$(location :create_sRGB_profile)\"",
)

# ── srgb_icc ──────────────────────────────────────────────────────
# Exposes the generated header as <icc/sRGB-IEC61966-2.1.hxx> for VCL.
cc_library(
    name = "srgb_icc",
    hdrs = ["sRGB-IEC61966-2.1.hxx"],
    include_prefix = "icc",
    visibility = ["//visibility:public"],
)
