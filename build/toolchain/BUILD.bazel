load("@rules_cc//cc/toolchains:cc_toolchain.bzl", "cc_toolchain")
load(":windows_cc_toolchain_config.bzl", "cc_toolchain_config")
load(
    "@vs_config//:paths.bzl",
    _MSVC_BIN = "MSVC_BIN",
    _MSVC_INCLUDE = "MSVC_INCLUDE",
    _MSVC_LIB = "MSVC_LIB",
    _MSVC_TMP = "MSVC_TMP",
    _SDK10_BIN = "SDK10_BIN",
    _SDK10_INCLUDE = "SDK10_INCLUDE",
    _SDK10_LIB = "SDK10_LIB",
)

# The MSVC toolchain for Apache OpenOffice on Windows.
#
# ── NAMING CONVENTION ────────────────────────────────────────────────────────
# Every target here — and every toolchain_identifier — is
#
#     aoo_msvc_<compiler>_<arch>
#
# and the two components exist to answer two different questions in Bazel's own
# output (--toolchain_resolution_debug, crosstool errors, `bazel config`):
#
#   aoo_       WHOSE toolchain this is.  Bazel/rules_cc auto-configures its own
#              MSVC toolchains and names them `msvc_x64` / `msvc_x86` — near
#              enough to be misread at a glance.  Anything without this prefix is
#              NOT ours.  Today that distinction cannot actually go wrong, because
#              .bazelrc sets BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1 and the stock
#              @local_config_cc is generated empty — but the prefix is what keeps
#              it unambiguous if auto-detection is ever switched back on.
#   <compiler> WHICH compiler: vs2019 = the modern toolset + Windows 10 SDK.
#              Named after the compiler rather than after the target Windows
#              floor because the two axes can decouple — the floor is carried by
#              //build/constraints:win_version, which is what resolution actually
#              keys on.  A further compiler slots in beside this one without a
#              rename.
#
# The two VS2008 (VC9) toolchains, x86 and x64, were retired 2026-11-01 together
# with the winXP platforms: Windows 7 SP1 on x64 is the only target.
#
# The exec platform is this x64 Windows host (@platforms//cpu:x86_64).
# Paths are discovered by //build:vs_config_repo.bzl; see user.bazelrc.

filegroup(name = "empty", srcs = [])

# ==================== x64 (win7, modern MSVC + Win10 SDK) ====================
#
# Paths come from //build:vs_config_repo.bzl's discovery rather than being
# spelled out: MSVC_BIN/MSVC_LIB/MSVC_INCLUDE for the toolset under
# VS_MODERN_PATH, SDK10_* for the Windows 10 SDK.  INCLUDE is five directories
# (the toolset's own headers plus the SDK's ucrt, um, shared and winrt trees)
# and LIB is three (the toolset's, plus the SDK's ucrt and um, each already
# arch-qualified by discovery) — hence the ";".join() over lists.

_VS2019_BIN = _MSVC_BIN["x64"]

_VS2019_INCLUDE_DIRS = [_MSVC_INCLUDE] + _SDK10_INCLUDE

_VS2019_LIB_DIRS = [_MSVC_LIB["x64"]] + _SDK10_LIB["x64"]

cc_toolchain_config(
    name = "aoo_msvc_vs2019_x64_config",
    cpu = "x64_windows",  # MSVC toolchain-config selector (not the platform cpu)
    compiler = "msvc-cl",
    host_system_name = "local",
    target_system_name = "local",
    target_libc = "msvcrt",
    abi_version = "local",
    abi_libc_version = "local",
    toolchain_identifier = "aoo_msvc_vs2019_x64",
    msvc_env_tmp  = _MSVC_TMP,
    # Host-x64 tools resolve their own c1/c2 DLLs from their own directory, so
    # there is no second bin dir to add.  The SDK bin is on PATH for rc.exe/mt.exe.
    msvc_env_path = _VS2019_BIN + ";" + _SDK10_BIN["x64"],
    msvc_env_include = ";".join(_VS2019_INCLUDE_DIRS),
    msvc_env_lib     = ";".join(_VS2019_LIB_DIRS),
    tool_bin_path  = _VS2019_BIN,
    msvc_cl_path   = _VS2019_BIN + "/cl.exe",
    msvc_ml_path   = _VS2019_BIN + "/ml64.exe",
    # No mspdbsrv wrapper and no separate PDB linker: the modern link.exe writes
    # its own PDBs in parallel unaided (VC9's single mspdbsrv could not, LNK1318).
    msvc_link_path = _VS2019_BIN + "/link.exe",
    pdb_link_path  = _VS2019_BIN + "/link.exe",
    msvc_lib_path  = _VS2019_BIN + "/lib.exe",
    cxx_builtin_include_directories = _VS2019_INCLUDE_DIRS,
    tool_paths = {
        "ar":      _VS2019_BIN + "/lib.exe",
        "cpp":     _VS2019_BIN + "/cl.exe",
        "gcc":     _VS2019_BIN + "/cl.exe",
        "gcov":    "wrapper/bin/msvc_nop.bat",
        # Already forward-slashed by discovery — rules_foreign_cc runs
        # paths.dirname() on this value and only recognizes '/'.
        "ld":      _VS2019_BIN + "/link.exe",
        "ml":      _VS2019_BIN + "/ml64.exe",
        "nm":      "wrapper/bin/msvc_nop.bat",
        "objcopy": "wrapper/bin/msvc_nop.bat",
        "objdump": "wrapper/bin/msvc_nop.bat",
        "strip":   "wrapper/bin/msvc_nop.bat",
    },
    archiver_flags     = ["/MACHINE:X64"],
    default_link_flags = ["/MACHINE:X64"],
    # The C++/UNO environment and CPU defines are properties of the TARGET, not
    # of the compiler that produced it.
    arch_defines       = ["_AMD64_=1", "X86_64", "CPPU_ENV=mscx"],
    # Only the wide half of the old VC9 CRT shim.  The UCRT declares a real
    # snprintf and refuses to be compiled with that name taken (C1189), so that
    # mapping must NOT be added here.  It declares no snwprintf at all —
    # the wide C99 name never existed in any MSVC CRT, only _snwprintf does — so
    # the sources calling it bare (svx sendreportw32.cxx, framework
    # spinfieldtoolbarcontroller.cxx) need the mapping.  Verified: -Dsnwprintf=_snwprintf compiles clean
    # against the UCRT with the STL included, i.e. it triggers no C1189.
    crt_defines        = ["snwprintf=_snwprintf"],
    # ml64 rejects the x86 /coff and /Cx flags — assemble with /c only.
    masm_flags         = ["/c"],
    # x64 has no SafeSEH — drop /SAFESEH:NO from the generate_pdb link.
    pdb_link_flags     = ["/DEBUG:FASTLINK"],
    # The two flags the M0 measurement was taken with.  /std:c++14 is passed
    # explicitly rather than relying on the compiler default, and goes in
    # cxx_flags (not all_compile_flags) so C compiles never see a C++ std flag.
    # NOT c++17: the tree's ~46,000 dynamic exception specifications are legal at
    # c++14 and ill-formed at c++17 — the single measurement that keeps the
    # conformance tail short.  The config rule's own default_cpp_std feature is
    # left disabled; it hardcodes /std:c++17.
    cxx_flags          = ["/std:c++14"],
    # _SILENCE_STDEXT_HASH_DEPRECATION_WARNINGS: the tree uses <hash_map> and
    # <hash_set> widely (via the stlport shims), and a modern MSVC turns their
    # inclusion into a hard #error unless this is defined -- 113 of these in one
    # full-tree pass.  They are the SGI/stdext containers, not std::unordered_map;
    # replacing them tree-wide is a refactor, not a build fix, so acknowledge the
    # deprecation instead.
    all_compile_flags  = ["/Zc:__cplusplus", "/D_SILENCE_STDEXT_HASH_DEPRECATION_WARNINGS"],
    dbg_mode_debug_flag       = "",
    fastbuild_mode_debug_flag = "",
    # Kept False, as it was for the retired VC9 toolchains.  A modern cl.exe CAN
    # drive Bazel's /showIncludes header-dependency checking — worth revisiting
    # on its own, with its own evidence.
    supports_parse_showincludes = False,
    conly_flags = [],
    link_flags  = [],
)

cc_toolchain(
    name = "aoo_msvc_vs2019_x64",
    toolchain_identifier = "aoo_msvc_vs2019_x64",
    toolchain_config     = ":aoo_msvc_vs2019_x64_config",
    all_files      = ":empty",
    ar_files       = ":empty",
    as_files       = ":empty",
    compiler_files = ":empty",
    dwp_files      = ":empty",
    linker_files   = ":empty",
    objcopy_files  = ":empty",
    strip_files    = ":empty",
    supports_param_files = 1,
)

toolchain(
    name = "aoo_msvc_vs2019_x64_def",
    exec_compatible_with = [
        # Exec = this x64 Windows host.
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
    target_compatible_with = [
        # Resolved against //build/platforms:win7-x64 (the default config).  The
        # floor pin keeps a future toolchain for another floor from matching.
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "//build/constraints:win7",
    ],
    toolchain      = ":aoo_msvc_vs2019_x64",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)
