load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load(":langs.bzl", "OOO_LANGS", "lang_id")

# ATL availability flag — requires Visual Studio Professional/Enterprise (VC\ATLMFC\INCLUDE).
# VS Express and BuildTools do not include ATLMFC; affected modules (embedserv,
# winaccessibility, extensions/activex) are skipped when this is False, mirroring
# the old build system's DISABLE_ATL guard.
# On a Pro/Enterprise install, add to user.bazelrc:
#   build --//build:atl_available=True
bool_flag(
    name = "atl_available",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "has_atl",
    flag_values = {":atl_available": "True"},
    visibility = ["//visibility:public"],
)

# Architecture config_settings for select() in module BUILD files (Win64 Phase 2).
# Resolved from the target platform's cpu constraint (--config=x86 / --config=x64).
# The common arch defines (_X86_/INTEL vs _AMD64_/X86_64) are injected by the
# toolchain, not here; these are for the residual per-module arch conditionals
# (bridge sources, .def decoration, x64-only libs, etc.).
config_setting(
    name = "arch_x86",
    constraint_values = ["@platforms//cpu:x86_32"],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "arch_x64",
    constraint_values = ["@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
)

# Debug-info staging flag — when True, flat_install also copies .pdb files.
# Complement with --compilation_mode=dbg (or --features=generate_pdb_file) so
# the toolchain actually produces PDB files; without that flag the .pdb output
# group is empty and nothing extra is staged.
# Add to user.bazelrc when debugging:
#   build --//build:debug_info=True --compilation_mode=dbg
bool_flag(
    name = "debug_info",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "has_debug",
    flag_values = {":debug_info": "True"},
    visibility = ["//visibility:public"],
)

# Matches --compilation_mode=dbg; used to suppress _DEBUG for Python headers.
config_setting(
    name = "dbg_build",
    values = {"compilation_mode": "dbg"},
    visibility = ["//visibility:public"],
)

# One bool_flag per OOo locale.
# en-US is always enabled; all others default to False.
#
# To build German and French in addition to English:
#   build --//build:lang_de=True --//build:lang_fr=True
#
# In user.bazelrc:
#   build --//build:lang_de=True

[
    bool_flag(
        name = "lang_" + lang_id(lang),
        build_setting_default = (lang == "en-US"),
        visibility = ["//visibility:public"],
    )
    for lang in OOO_LANGS
]

# config_setting per locale — consumed by select() in package BUILD files.
[
    config_setting(
        name = "build_" + lang_id(lang),
        flag_values = {":lang_" + lang_id(lang): "True"},
        visibility = ["//visibility:public"],
    )
    for lang in OOO_LANGS
]
