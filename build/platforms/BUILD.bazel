# Target platform for the Windows build.
# Selected via --platforms (wired to --config=win7-x64, the default, in .bazelrc);
# the cpu and //build/constraints:win_version constraints pick which
# //build/toolchain cc_toolchain resolves.
#
#   win7-x64 → @platforms//cpu:x86_64 + :win7 → aoo_msvc_vs2019_x64
#
# The winXP-x86 / winXP-x64 platforms (VC9 / VS2008 + SDK v7.0) were retired
# 2026-11-01.  A further target is a new platform here, plus a new constraint
# value when it is a different Windows floor.

platform(
    name = "win7-x64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
        "//build/constraints:win7",
    ],
    visibility = ["//visibility:public"],
)
