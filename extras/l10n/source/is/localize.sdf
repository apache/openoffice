helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id956834773				0	is	e([:digit:])?    -- finds 'e' followed by zero or one digit. Note that currently all named character classes like [:digit:] must be enclosed in parentheses.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id952368773				0	is	^([:digit:])$    -- finds lines or cells with exactly one digit.				20181231 09:50:43
