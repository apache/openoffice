helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166056				0	is	MIN				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143316				0	is	6				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143339				0	is	PRODUCT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143366				0	is	7				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143389				0	is	STDEV				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143416				0	is	8				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143439				0	is	STDEVP				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143466				0	is	9				20181231 09:50:43
