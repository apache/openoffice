helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165731				0	is	\<emph\>Function\</emph\> is a number that stands for one of the following functions:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165782				0	is	Function index				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165806				0	is	Aðgerð				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165833				0	is	1				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165856				0	is	AVERAGE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165883				0	is	2				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165906				0	is	COUNT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165933				0	is	3				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165956				0	is	COUNTA				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165983				0	is	4				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166006				0	is	MAX				20181231 09:50:43
