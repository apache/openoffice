helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163966				0	is	\<item type=\"input\"\>=FLOOR( -11;-2;0)\</item\> skilar -12				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163988				0	is	\<item type=\"input\"\>=FLOOR( -11;-2;1)\</item\> skilar -10				20181231 09:50:43
