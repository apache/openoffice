desktop	source\migration\wizard.src	0	fixedtext	TP_UPDATE_CHECK	FT_UPDATE_CHECK_BODY			0	mn	%PRODUCTNAME автоматаар тогтмол интервалаар шинэ хувилбарыг хайна.\nОнлайн шинэчлэлийг хийж байхад хэрэглэгчийн хувийн өгөгдлийг дамжуулахгүй.\nШинэ хувилбар бэлэн болмогц танд сонордуулна.\n\nТа энэ боломжийг Хэрэгсэл / Тохиргоо... / %PRODUCTNAME / Онлайн шинэчлэлт хэсэгт тохируулж болно.				2002-02-02 02:02:02
