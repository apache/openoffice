helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156267				0	uz	\<item type=\"input\"\>=MINUTE(8.999)\</item\> returns 58				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147323				0	uz	\<item type=\"input\"\>=N(123)\</item\> returns 123				2002-02-02 02:02:02
