helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3150866				0	uz	\<ahelp hid=\".uno:GraphicFilterRemoveNoise\"\>Removes noise by applying a median filter.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3154938				0	uz	\<image id=\"img_id3153797\" src=\"res/commandimagelist/sc_graphicfilterremovenoise.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3153797\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
