crashrep	source\all\crashrep.ulf	0	LngText	%OK_BUTTON%				0	uz	Ok				2002-02-02 02:02:02
crashrep	source\all\crashrep.ulf	0	LngText	%REPORT_CAPTION%				0	uz	%PRODUCTNAME% %PRODUCTVERSION% Xatolik hisoboti				2002-02-02 02:02:02
crashrep	source\all\crashrep.ulf	0	LngText	%REPORT_HEADER%				0	uz	%PRODUCTNAME% %PRODUCTVERSION% ishga tushirilayotganda xatolik yuz berdi				2002-02-02 02:02:02
crashrep	source\all\crashrep.ulf	0	LngText	%REPORT_BODY%				0	uz	%PRODUCTNAME% %PRODUCTVERSION% xatoligi hisoboti Sun Microsystems %PRODUCTNAME%ni yanada takomillashtirish uchun maʼlumotlarni toʻpladi.\nQuyida keltirilgan maydonlarda sarlavha kiritishingiz va xatolik paytida nima qilayotganingiz haqida maʼlumot berishingiz mumkin. Soʻngra «Joʻnatish» tugmasini bosing.\n				2002-02-02 02:02:02
