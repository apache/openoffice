helpcontent2	source\text\sbasic\shared\03102101.xhp	0	help	par_id3149106				0	uz	For iCount = 1 To 5				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03102101.xhp	0	help	par_id3155174				0	uz	iVar(iCount) = iCount				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03102101.xhp	0	help	par_id3163805				0	uz	Next iCount				2002-02-02 02:02:02
