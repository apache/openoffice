helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3151309				0	uz	\<ahelp hid=\"HID_AAI_FUNC_FACTDOUBLE\"\>Returns the double factorial of a number.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3154666				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3155121				0	uz	FACTDOUBLE(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3158440	40			0	uz	Returns \<emph\>Number\</emph\>\<emph\>!!\</emph\>, the double factorial of \<emph\>Number\</emph\>, where \<emph\>Number\</emph\> is an integer greater than or equal to zero.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id2480849				0	uz	For even numbers FACTDOUBLE(n) returns:				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id4181951				0	uz	2*4*6*8* ... *n				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id2927335				0	uz	For odd numbers FACTDOUBLE(n) returns:				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id2107303				0	uz	1*3*5*7* ... *n				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id4071779				0	uz	FACTDOUBLE(0) returns 1 by definition.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3154622				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id7844477				0	uz	\<item type=\"input\"\>=FACTDOUBLE(5)\</item\> returns 15.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3154116	43			0	uz	\<item type=\"input\"\>=FACTDOUBLE(6)\</item\> returns 48.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id6478469				0	uz	\<item type=\"input\"\>=FACTDOUBLE(0)\</item\> returns 1.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	tit				0	uz	Add-in Functions				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3150870				0	uz	\<bookmark_value\>add-ins; functions\</bookmark_value\>\<bookmark_value\>functions; add-in functions\</bookmark_value\>\<bookmark_value\>Function Wizard; add-ins\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3150870				0	uz	Add-in Functions				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3147427	2			0	uz	\<variable id=\"addintext\"\>The following describes and lists some of the available add-in functions. \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3163713				0	uz	\<link href=\"text/scalc/01/04060112.xhp#addinconcept\"\>Add-in concept\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3146120	5			0	uz	You will also find a \<link href=\"text/scalc/01/04060112.xhp\"\>description of the $[officename] Calc add-in interface\</link\> in the Help. In addition, important functions and their parameters are described in the Help for the \<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>Shared Library \</caseinline\>\<defaultinline\>$[officename] Calc add-in DLL\</defaultinline\>\</switchinline\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3151075				0	uz	Add-ins supplied				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3156285				0	uz	$[officename] contains examples for the add-in interface of $[officename] Calc.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3159267				0	uz	\<link href=\"text/scalc/01/04060115.xhp\"\>Analysis Functions Part One\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3154703				0	uz	\<link href=\"text/scalc/01/04060116.xhp\"\>Analysis Functions Part Two\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3149566				0	uz	\<bookmark_value\>ISLEAPYEAR function\</bookmark_value\>\<bookmark_value\>leap year determination\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3149566				0	uz	ISLEAPYEAR				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150297				0	uz	\<ahelp hid=\".\"\>Determines whether a year is a leap year.\</ahelp\> If yes, the function will return the value 1 (TRUE); if not, it will return 0 (FALSE).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3148487				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150205				0	uz	ISLEAPYEAR("Date")				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3159239				0	uz	\<emph\>Date\</emph\> specifies whether a given date falls within a leap year. The Date parameter must be a valid date according to the locale settings of %PRODUCTNAME.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3149817				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150786				0	uz	=ISLEAPYEAR(A1) returns 1, if A1 contains 1968-02-29, the valid date 29th of February 1968 in your locale setting.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_idN107E7				0	uz	You may also use =ISLEAPYEAR("1968-02-29") or =ISLEAPYEAR("2/29/68").				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_idN107EA				0	uz	Never use =ISLEAPYEAR(2/29/68), because this would first evaluate 2 divided by 29 divided by 68, and then calculate the ISLEAPYEAR function from this small number as a serial date number.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3154656				0	uz	\<bookmark_value\>YEARS function\</bookmark_value\>\<bookmark_value\>number of years between two dates\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3154656				0	uz	YEARS				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150886				0	uz	\<ahelp hid=\"HID_DAI_FUNC_DIFFYEARS\"\>Calculates the difference in years between two dates.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3154370				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3146114				0	uz	YEARS(StartDate; EndDate; Type)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3145387				0	uz	\<emph\>StartDate\</emph\> is the first date				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3156290				0	uz	\<emph\>EndDate\</emph\> is the second date				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3152893				0	uz	\<emph\>Type\</emph\> calculates the type of difference. Possible values are 0 (interval) and 1 (in calendar years).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3152898				0	uz	\<bookmark_value\>MONTHS function\</bookmark_value\>\<bookmark_value\>number of months between two dates\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3152898				0	uz	MONTHS				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153066				0	uz	\<ahelp hid=\"HID_DAI_FUNC_DIFFMONTHS\"\>Calculates the difference in months between two dates.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3151240				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3146869				0	uz	MONTHS(StartDate; EndDate; Type)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3145075				0	uz	\<emph\>StartDate\</emph\> is the first date				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3157981				0	uz	\<emph\>EndDate\</emph\> is the second date				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150111				0	uz	\<emph\>Type\</emph\> calculates the type of difference. Possible values include 0 (interval) and 1 (in calendar months).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3159094				0	uz	\<bookmark_value\>ROT13 function\</bookmark_value\>\<bookmark_value\>encrypting text\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3159094				0	uz	ROT13				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3146781				0	uz	\<ahelp hid=\"HID_DAI_FUNC_ROT13\"\>Encrypts a character string by moving the characters 13 positions in the alphabet.\</ahelp\> After the letter Z, the alphabet begins again (Rotation). By applying the encryption function again to the resulting code, you can decrypt the text.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3150893				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3159205				0	uz	ROT13(Text)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153249				0	uz	\<emph\>Text\</emph\> is the character string to be encrypted. ROT13(ROT13(Text)) decrypts the code.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3151300				0	uz	\<bookmark_value\>DAYSINYEAR function\</bookmark_value\>\<bookmark_value\>number of days; in a specific year\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3151300				0	uz	DAYSINYEAR				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3143220				0	uz	\<ahelp hid=\"HID_DAI_FUNC_DAYSINYEAR\"\>Calculates the number of days of the year in which the date entered occurs.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3145358				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3154651				0	uz	DAYSINYEAR(Date)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153803				0	uz	\<emph\>Date\</emph\> is any date in the respective year. The Date parameter must be a valid date according to the locale settings of %PRODUCTNAME.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3153487				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153811				0	uz	=DAYSINYEAR(A1) returns 366 days if A1 contains 1968-02-29, a valid date for the year 1968.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3154737				0	uz	\<bookmark_value\>DAYSINMONTH function\</bookmark_value\>\<bookmark_value\>number of days;in a specific month of a year\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3154737				0	uz	DAYSINMONTH				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3149316				0	uz	\<ahelp hid=\"HID_DAI_FUNC_DAYSINMONTH\"\>Calculates the number of days of the month in which the date entered occurs.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3145114				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150955				0	uz	DAYSINMONTH(Date)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3147501				0	uz	\<emph\>Date\</emph\> is any date in the respective month of the desired year. The Date parameter must be a valid date according to the locale settings of %PRODUCTNAME.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3149871				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3155742				0	uz	=DAYSINMONTH(A1) returns 29 days if A1 contains 1968-02-17, a valid date for February 1968.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3149048				0	uz	\<bookmark_value\>WEEKS function\</bookmark_value\>\<bookmark_value\>number of weeks;between two dates\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3149048				0	uz	WEEKS				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153340				0	uz	\<ahelp hid=\"HID_DAI_FUNC_DIFFWEEKS\"\>Calculates the difference in weeks between two dates.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3150393				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3147402				0	uz	WEEKS(StartDate; EndDate; Type)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3151387				0	uz	\<emph\>StartDate\</emph\> is the first date				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3146324				0	uz	\<emph\>EndDate\</emph\> is the second date				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3166467				0	uz	\<emph\>Type\</emph\> calculates the type of difference. The possible values are 0 (interval) and 1 (in numbers of weeks).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3145237				0	uz	\<bookmark_value\>WEEKSINYEAR function\</bookmark_value\>\<bookmark_value\>number of weeks;in a specific year\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3145237				0	uz	WEEKSINYEAR				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3147410				0	uz	\<ahelp hid=\"HID_DAI_FUNC_WEEKSINYEAR\"\>Calculates the number of weeks of the year in which the date entered occurs.\</ahelp\> The number of weeks is defined as follows: a week that spans two years is added to the year in which most days of that week occur.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3149719				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3145638				0	uz	WEEKSINYEAR(Date)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3149946				0	uz	\<emph\>Date\</emph\> is any date in the respective year. The Date parameter must be a valid date according to the locale settings of %PRODUCTNAME.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3150037				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3147614				0	uz	WEEKSINYEAR(A1) returns 53 if A1 contains 1970-02-17, a valid date for the year 1970.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3157901				0	uz	Add-ins through %PRODUCTNAME API				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3149351				0	uz	Add-ins can also be implemented through the %PRODUCTNAME \<link href=\"http://api.openoffice.org/\"\>API\</link\>.				2002-02-02 02:02:02
