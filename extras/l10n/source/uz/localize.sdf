helpcontent2	source\text\scalc\01\01120000.xhp	0	help	hd_id1918698				0	uz	\<link href=\"text/scalc/01/01120000.xhp\"\>Page Preview\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\01120000.xhp	0	help	par_id3831598				0	uz	\<ahelp hid=\".uno:PrintPreview\"\>Displays a preview of the printed page or closes the preview.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\01120000.xhp	0	help	par_id3145847				0	uz	Use the icons on the \<emph\>Page Preview Bar\</emph\> to scroll through the pages of the document or to print the document.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\01120000.xhp	0	help	par_id9838862				0	uz	You can also press \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+Page Up and Ctrl+Page Down keys to scroll through the pages.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\01120000.xhp	0	help	par_id7211828				0	uz	You cannot edit your document while you are in the page preview.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\01120000.xhp	0	help	par_id460829				0	uz	\<ahelp hid=\".\" visibility=\"hidden\"\>To exit the page preview, click the \<emph\>Close Preview\</emph\> button.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\01120000.xhp	0	help	par_id3155829				0	uz	\<link href=\"text/scalc/main0210.xhp\" name=\"Page View Object Bar\"\>Page View Object Bar\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	tit				0	uz	WEEKNUM_ADD 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	bm_id3166443				0	uz	\<bookmark_value\>WEEKNUM_ADD function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	hd_id3166443				0	uz	\<variable id=\"weeknumadd\"\>\<link href=\"text/scalc/01/func_weeknumadd.xhp\"\>WEEKNUM_ADD\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	par_id3152945				0	uz	\<ahelp hid=\"HID_AAI_FUNC_WEEKNUM\"\>The result indicates the number of the calendar week for a date.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	par_idN105DD				0	uz	The WEEKNUM_ADD function is designed to calculate week numbers exactly as Microsoft Excel does. Use the \<link href=\"text/scalc/01/func_weeknum.xhp\"\>WEEKNUM\</link\> function, or format your date cells using the WW formatting code, when you need ISO 8601 week numbers.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	hd_id3153745				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	par_id3153685				0	uz	WEEKNUM_ADD(Date; ReturnType)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	par_id3159277				0	uz	\<emph\>Date\</emph\> is the date within the calendar week.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	par_id3154098				0	uz	\<emph\>ReturnType\</emph\> is 1 for week beginning on a Sunday, 2 for week beginning on a Monday.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	hd_id3152886				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	par_id3149973				0	uz	In which week number does 12.24.2001 fall?				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	par_id3149914				0	uz	\<item type=\"input\"\>=WEEKNUM_ADD(24.12.2001;1)\</item\> returns 52.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	tit				0	uz	Text Functions				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3145389				0	uz	\<bookmark_value\>text in cells; functions\</bookmark_value\>\<bookmark_value\>functions; text functions\</bookmark_value\>\<bookmark_value\>Function Wizard;text\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3145389				0	uz	Text Functions				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3152986				0	uz	\<variable id=\"texttext\"\>This section contains descriptions of the \<emph\>Text\</emph\> functions. \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149384				0	uz	\<bookmark_value\>ARABIC function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149384				0	uz	ARABIC				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153558				0	uz	\<ahelp hid=\"HID_FUNC_ARABISCH\"\>Calculates the value of a Roman number. The value range must be between 0 and 3999.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153011				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155523				0	uz	ARABIC("Text")				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151193	243			0	uz	\<emph\>Text\</emph\> is the text that represents a Roman number.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155758				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154621	245			0	uz	\<item type=\"input\"\>=ARABIC("MXIV")\</item\> returns 1014				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147553	246			0	uz	\<item type=\"input\"\>=ARABIC("MMII")\</item\> returns 2002				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id8796349				0	uz	\<bookmark_value\>ASC function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id7723929				0	uz	ASC				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id8455153				0	uz	\<ahelp hid=\".\"\>The ASC function converts full-width to half-width ASCII and katakana characters. Returns a text string.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id9912411				0	uz	See \<link href=\"http://wiki.services.openoffice.org/mwiki/index.php?title=Calc/Features/JIS_and_ASC_functions\"\>http://wiki.services.openoffice.org/mwiki/index.php?title=Calc/Features/JIS_and_ASC_functions\</link\> for a conversion table.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id9204992				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id1993774				0	uz	ASC("Text")				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id2949919				0	uz	\<emph\>Text\</emph\> is the text that contains characters to be converted.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id2355113				0	uz	See also JIS function.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id9323709				0	uz	\<bookmark_value\>BAHTTEXT function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id6695455				0	uz	BAHTTEXT				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id354014				0	uz	Converts a number to Thai text, including the Thai currency names.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id9942014				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id8780785				0	uz	BAHTTEXT(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id1539353				0	uz	\<emph\>Number\</emph\> is any number. "Baht" is appended to the integral part of the number, and "Satang" is appended to the decimal part of the number.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id9694814				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3289284				0	uz	\<item type=\"input\"\>=BAHTTEXT(12.65)\</item\> returns a string in Thai characters with the meaning of "Twelve Baht and sixty five Satang".				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3153072				0	uz	\<bookmark_value\>BASE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153072				0	uz	BASE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153289				0	uz	\<ahelp hid=\"HID_FUNC_BASIS\"\>Converts a positive integer to a specified base into a text from the \<link href=\"text/shared/00/00000005.xhp#zahlensystem\" name=\"numbering system\"\>numbering system\</link\>.\</ahelp\> The digits 0-9 and the letters A-Z are used.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146097				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155743				0	uz	BASE(Number; Radix; [MinimumLength])				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151339	217			0	uz	\<emph\>Number\</emph\> is the positive integer to be converted.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3159262	218			0	uz	\<emph\>Radix\</emph\> indicates the base of the number system. It may be any positive integer between 2 and 36.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148746	219			0	uz	\<emph\>MinimumLength\</emph\> (optional) determines the minimum length of the character sequence that has been created. If the text is shorter than the indicated minimum length, zeros are added to the left of the string.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146323				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3156399				0	uz	\<bookmark_value\>decimal system; converting to\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156399	221			0	uz	\<item type=\"input\"\>=BASE(17;10;4)\</item\> returns 0017 in the decimal system.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3157871				0	uz	\<bookmark_value\>binary system; converting to\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3157871	222			0	uz	\<item type=\"input\"\>=BASE(17;2)\</item\> returns 10001 in the binary system.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3145226				0	uz	\<bookmark_value\>hexadecimal system; converting to\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145226	223			0	uz	\<item type=\"input\"\>=BASE(255;16;4)\</item\> returns 00FF in the hexadecimal system.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149321				0	uz	\<bookmark_value\>CHAR function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149321				0	uz	CHAR				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149150				0	uz	\<ahelp hid=\"HID_FUNC_ZEICHEN\"\>Converts a number into a character according to the current code table.\</ahelp\> The number can be a two-digit or three-digit integer number.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149945				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145634				0	uz	CHAR(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155906	205			0	uz	\<emph\>Number\</emph\> is a number between 1 and 255 representing the code value for the character.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152982				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149890	208			0	uz	\<item type=\"input\"\>=CHAR(100)\</item\> returns the character d.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149009				0	uz	\<bookmark_value\>CLEAN function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149009				0	uz	CLEAN				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150482				0	uz	\<ahelp hid=\"HID_FUNC_SAEUBERN\"\>All non-printing characters are removed from the string.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146880				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147472				0	uz	CLEAN("Text")				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150695	136			0	uz	\<emph\>Text\</emph\> refers to the text from which to remove all non-printable characters.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3155498				0	uz	\<bookmark_value\>CODE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155498				0	uz	CODE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3152770				0	uz	\<ahelp hid=\"HID_FUNC_CODE\"\>Returns a numeric code for the first character in a text string.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155830				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149188				0	uz	CODE("Text")				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154383	7			0	uz	\<emph\>Text\</emph\> is the text for which the code of the first character is to be found.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3154394				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3159209	9			0	uz	\<item type=\"input\"\>=CODE("Hieronymus")\</item\> returns 72, \<item type=\"input\"\>=CODE("hieroglyphic")\</item\> returns 104.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150280				0	uz	The code used here does not refer to ASCII, but to the code table currently loaded.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149688				0	uz	\<bookmark_value\>CONCATENATE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149688				0	uz	CONCATENATE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154524				0	uz	\<ahelp hid=\"HID_FUNC_VERKETTEN\"\>Combines several text strings into one string.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149542				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155954				0	uz	CONCATENATE("Text1"; ...; "Text30")				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146847	171			0	uz	\<emph\>Text 1; Text 2; ...\</emph\> represent up to 30 text passages which are to be combined into one string.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153110				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150008	173			0	uz	\<item type=\"input\"\>=CONCATENATE("Good ";"Morning ";"Mrs. ";"Doe")\</item\> returns: Good Morning Mrs. Doe.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3145166				0	uz	\<bookmark_value\>DECIMAL function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3145166				0	uz	DECIMAL				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156361				0	uz	\<ahelp hid=\"HID_FUNC_DEZIMAL\"\>Converts text with characters from a \<link href=\"text/shared/00/00000005.xhp#zahlensystem\" name=\"number system\"\>number system\</link\> to a positive integer in the base radix given.\</ahelp\> The radix must be in the range 2 to 36. Spaces and tabs are ignored. The \<emph\>Text\</emph\> field is not case-sensitive.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3157994				0	uz	If the radix is 16, a leading x or X or 0x or 0X, and an appended h or H, is disregarded. If the radix is 2, an appended b or B is disregarded. Other characters that do not belong to the number system generate an error.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150014				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154328				0	uz	DECIMAL("Text"; Radix)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150128	230			0	uz	\<emph\>Text\</emph\> is the text to be converted. To differentiate between a hexadecimal number, such as A1 and the reference to cell A1, you must place the number in quotation marks, for example, "A1" or "FACE".				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145241	231			0	uz	\<emph\>Radix\</emph\> indicates the base of the number system. It may be any positive integer between 2 and 36.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3156062				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145355	233			0	uz	\<item type=\"input\"\>=IMREAL("1+3j")\</item\> returns 1.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155622	234			0	uz	\<item type=\"input\"\>=DECIMAL("FACE";16)\</item\> returns 64206.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151015	235			0	uz	\<item type=\"input\"\>=DECIMAL("0101";2)\</item\> returns 5.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3148402				0	uz	\<bookmark_value\>DOLLAR function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148402				0	uz	DOLLAR				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153049	12			0	uz	\<ahelp hid=\"HID_FUNC_DM\"\>Converts a number to an amount in the currency format, rounded to a specified decimal place.\</ahelp\> In the \<item type=\"literal\"\>Value\</item\> field enter the number to be converted to currency. Optionally, you may enter the number of decimal places in the \<item type=\"literal\"\>Decimals\</item\> field. If no value is specified, all numbers in currency format will be displayed with two decimal places. 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151280				0	uz	You set the currency format in your system settings.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150569				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154188				0	uz	DOLLAR(Value; Decimals)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145299	15			0	uz	\<emph\>Value\</emph\> is a number, a reference to a cell containing a number, or a formula which returns a number.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145629	16			0	uz	\<emph\>Decimals\</emph\> is the optional number of decimal places.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149030				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153546	18			0	uz	\<item type=\"input\"\>=DOLLAR(255)\</item\> returns $255.00.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154635	19			0	uz	\<item type=\"input\"\>=DOLLAR(367.456;2)\</item\> returns $367.46. Use the decimal separator that corresponds to the \<link href=\"text/shared/optionen/01140000.xhp\" name=\"current locale setting\"\>current locale setting\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3150685				0	uz	\<bookmark_value\>EXACT function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150685				0	uz	EXACT				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3158413				0	uz	\<ahelp hid=\"HID_FUNC_IDENTISCH\"\>Compares two text strings and returns TRUE if they are identical.\</ahelp\> This function is case-sensitive.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152817				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148594				0	uz	EXACT("Text1"; "Text2")				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153224	82			0	uz	\<emph\>Text1\</emph\> refers to the first text to compare.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148637	83			0	uz	\<emph\>Text2\</emph\> is the second text to compare.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149777				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156263	85			0	uz	\<item type=\"input\"\>=EXACT("Sun microsystems";"Sun Microsystems")\</item\> returns FALSE.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3152589				0	uz	\<bookmark_value\>FIND function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152589				0	uz	FIND				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146149				0	uz	\<ahelp hid=\"HID_FUNC_FINDEN\"\>Looks for a string of text within another string.\</ahelp\> You can also define where to begin the search. The search term can be a number or any string of characters. The search is case-sensitive.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3083284				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3083452				0	uz	FIND("FindText"; "Text"; Position)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150608	48			0	uz	\<emph\>FindText\</emph\> refers to the text to be found.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3152374	49			0	uz	\<emph\>Text\</emph\> is the text where the search takes place.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3152475	50			0	uz	\<emph\>Position\</emph\> (optional) is the position in the text from which the search starts.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3154812				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156375	52			0	uz	\<item type=\"input\"\>=FIND(76;998877665544)\</item\> returns 6.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149268				0	uz	\<bookmark_value\>FIXED function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149268				0	uz	FIXED				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155833				0	uz	\<ahelp hid=\"HID_FUNC_FEST\"\>Returns a number as text with a specified number of decimal places and optional thousands separators.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152470				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147567				0	uz	FIXED(Number; Decimals; NoThousandsSeparators)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151272	38			0	uz	\<emph\>Number\</emph\> refers to the number to be formatted.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156322	39			0	uz	\<emph\>Decimals\</emph\> refers to the number of decimal places to be displayed.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150877	40			0	uz	\<emph\>NoThousandsSeparators\</emph\> (optional) determines whether the thousands separator is used. If the parameter is a number not equal to 0, the thousands separator is suppressed. If the parameter is equal to 0 or if it is missing altogether, the thousands separators of your \<link href=\"text/shared/optionen/01140000.xhp\" name=\"current locale setting\"\>current locale setting\</link\> are displayed.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149040				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145208	42			0	uz	\<item type=\"input\"\>=FIXED(1234567.89;3)\</item\> returns 1,234,567.890 as a text string. 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id5282143				0	uz	\<item type=\"input\"\>=FIXED(1234567.89;3;1)\</item\> returns 1234567.890 as a text string.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id7319864				0	uz	\<bookmark_value\>JIS function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3666188				0	uz	JIS				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id964384				0	uz	\<ahelp hid=\".\"\>The JIS function converts half-width to full-width ASCII and katakana characters. Returns a text string.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id1551561				0	uz	See \<link href=\"http://wiki.services.openoffice.org/mwiki/index.php?title=Calc/Features/JIS_and_ASC_functions\"\>http://wiki.services.openoffice.org/mwiki/index.php?title=Calc/Features/JIS_and_ASC_functions\</link\> for a conversion table.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id2212897				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id2504654				0	uz	JIS("Text")				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id5292519				0	uz	\<emph\>Text\</emph\> is the text that contains characters to be converted.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3984496				0	uz	See also ASC function.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3147083				0	uz	\<bookmark_value\>LEFT function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3147083				0	uz	LEFT				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153622				0	uz	\<ahelp hid=\"HID_FUNC_LINKS\"\>Returns the first character or characters of a text.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3156116				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146786				0	uz	LEFT("Text"; Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147274	99			0	uz	\<emph\>Text\</emph\> is the text where the initial partial words are to be determined.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153152	100			0	uz	\<emph\>Number\</emph\> (optional) specifies the number of characters for the start text. If this parameter is not defined, one character is returned.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150260				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149141	102			0	uz	\<item type=\"input\"\>=LEFT("output";3)\</item\> returns “out”.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3156110				0	uz	\<bookmark_value\>LEN function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3156110				0	uz	LEN				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150147				0	uz	\<ahelp hid=\"HID_FUNC_LAENGE\"\>Returns the length of a string including spaces.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155108				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154063				0	uz	LEN("Text")				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146894	108			0	uz	\<emph\>Text\</emph\> is the text whose length is to be determined.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153884				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156008	110			0	uz	\<item type=\"input\"\>=LEN("Good Afternoon")\</item\> returns 14.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154300	111			0	uz	\<item type=\"input\"\>=INT(5.7)\</item\> returns 5.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3153983				0	uz	\<bookmark_value\>LOWER function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153983				0	uz	LOWER				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3152791				0	uz	\<ahelp hid=\"HID_FUNC_KLEIN\"\>Converts all uppercase letters in a text string to lowercase.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155902				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150121				0	uz	LOWER("Text")				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153910	91			0	uz	\<emph\>Text\</emph\> refers to the text to be converted.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3159343				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155329	93			0	uz	\<item type=\"input\"\>=LOG(7^4;7)\</item\> returns 4.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3154589				0	uz	\<bookmark_value\>MID function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3154589				0	uz	MID				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154938				0	uz	\<ahelp hid=\"HID_FUNC_TEIL\"\>Returns a text string of a text. The parameters specify the starting position and the number of characters.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148829				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150526				0	uz	MID("Text"; Start; Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148820	152			0	uz	\<emph\>Text\</emph\> is the text containing the characters to extract.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150774	153			0	uz	\<emph\>Start\</emph\> is the position of the first character in the text to extract.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153063	154			0	uz	\<emph\>Number\</emph\> specifies the number of characters in the part of the text.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150509				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3158407	156			0	uz	\<item type=\"input\"\>=RIGHT("Sun";2)\</item\> returns un.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3159143				0	uz	\<bookmark_value\>PROPER function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3159143				0	uz	PROPER				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149768				0	uz	\<ahelp hid=\"HID_FUNC_GROSS2\"\>Capitalizes the first letter in all words of a text string.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153573				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154260				0	uz	PROPER("Text")				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147509	74			0	uz	\<emph\>Text\</emph\> refers to the text to be converted.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3147529				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149171				0	uz	\<bookmark_value\>REPLACE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149171				0	uz	REPLACE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148925				0	uz	\<ahelp hid=\"HID_FUNC_ERSETZEN\"\>Replaces part of a text string with a different text string.\</ahelp\> This function can be used to replace both characters and numbers (which are automatically converted to text). The result of the function is always displayed as text. If you intend to perform further calculations with a number which has been replaced by text, you will need to convert it back to a number using the \<link href=\"text/scalc/01/04060110.xhp\" name=\"VALUE\"\>VALUE\</link\> function.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3158426				0	uz	Any text containing numbers must be enclosed in quotation marks if you do not want it to be interpreted as a number and automatically converted to text.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149159				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147286				0	uz	REPLACE("Text"; Position; Length; "NewText")				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149797	27			0	uz	\<emph\>Text\</emph\> refers to text of which a part will be replaced.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3166451	28			0	uz	\<emph\>Position\</emph\> refers to the position within the text where the replacement will begin.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156040	29			0	uz	\<emph\>Length\</emph\> is the number of characters in \<emph\>Text\</emph\> to be replaced.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3159188	30			0	uz	\<emph\>NewText\</emph\> refers to the text which replaces \<emph\>Text\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146958				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154096	32			0	uz	\<item type=\"input\"\>=REPLACE("1234567";1;1;"444")\</item\> returns "444234567". One character at position 1 is replaced by the complete \<item type=\"literal\"\>NewText\</item\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149741				0	uz	\<bookmark_value\>REPT function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149741				0	uz	REPT				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153748				0	uz	\<ahelp hid=\"HID_FUNC_WIEDERHOLEN\"\>Repeats a character string by the given \<emph\>number\</emph\> of copies.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152884				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150494				0	uz	REPT("Text"; Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154859	197			0	uz	\<emph\>Text\</emph\> is the text to be repeated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150638	198			0	uz	\<emph\>Number\</emph\> is the number of repetitions.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149922				0	uz	The result can be a maximum of 255 characters.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3156213				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148626	200			0	uz	\<item type=\"input\"\>=REPT("Good morning";2)\</item\> returns Good morningGood morning.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149805				0	uz	\<bookmark_value\>RIGHT function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149805				0	uz	RIGHT				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145375				0	uz	\<ahelp hid=\"HID_FUNC_RECHTS\"\>Returns the last character or characters of a text.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150837				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154344				0	uz	RIGHT("Text"; Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149426	117			0	uz	\<emph\>Text\</emph\> is the text of which the right part is to be determined.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153350	118			0	uz	\<emph\>Number\</emph\> (optional) is the number of characters from the right part of the text.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148661				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151132	120			0	uz	\<item type=\"input\"\>=RIGHT("Sun";2)\</item\> returns un.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3153534				0	uz	\<bookmark_value\>ROMAN function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153534				0	uz	ROMAN				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151256				0	uz	\<ahelp hid=\"HID_FUNC_ROEMISCH\"\>Converts a number into a Roman numeral. The value range must be between 0 and 3999, the modes can be integers from 0 to 4.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149299				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150593				0	uz	ROMAN(Number; Mode)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156139	252			0	uz	\<emph\>Number\</emph\> is the number that is to be converted into a Roman numeral.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153318	253			0	uz	\<emph\>Mode\</emph\> (optional) indicates the degree of simplification. The higher the value, the greater is the simplification of the Roman number.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3145306				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151371	255			0	uz	\<item type=\"input\"\>=ROMAN(999)\</item\> returns CMXCIX				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153938	256			0	uz	\<item type=\"input\"\>=ROMAN(999;0)\</item\> returns CMXCIX				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148412	257			0	uz	\<item type=\"input\"\>=ROMAN (999;1)\</item\> returns LMVLIV				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155421	258			0	uz	\<item type=\"input\"\>=COMBIN(3;2)\</item\> returns 3.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149235	259			0	uz	\<item type=\"input\"\>=COMBIN(3;2)\</item\> returns 3.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150624	260			0	uz	\<item type=\"input\"\>=COMBIN(3;2)\</item\> returns 3.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3151005				0	uz	\<bookmark_value\>SEARCH function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3151005				0	uz	SEARCH				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148692				0	uz	\<ahelp hid=\"HID_FUNC_SUCHEN\"\>Returns the position of a text segment within a character string.\</ahelp\> You can set the start of the search as an option. The search text can be a number or any sequence of characters. The search is not case-sensitive.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152964				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154671				0	uz	SEARCH("FindText"; "Text"; Position)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146080	126			0	uz	\<emph\>FindText\</emph\> is the text to be searched for.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154111	127			0	uz	\<emph\>Text\</emph\> is the text where the search will take place.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149559	128			0	uz	\<emph\>Position\</emph\> (optional) is the position in the text where the search is to start.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3147322				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154564	130			0	uz	\<item type=\"input\"\>=SEARCH(54;998877665544)\</item\> returns 10.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3154830				0	uz	\<bookmark_value\>SUBSTITUTE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3154830				0	uz	SUBSTITUTE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153698				0	uz	\<ahelp hid=\"HID_FUNC_WECHSELN\"\>Substitutes new text for old text in a string.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150994				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147582				0	uz	SUBSTITUTE("Text"; "SearchText"; "NewText"; Occurrence)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153675	178			0	uz	\<emph\>Text\</emph\> is the text in which text segments are to be exchanged.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156155	179			0	uz	\<emph\>SearchText \</emph\>is the text segment that is to be replaced (a number of times).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145779	180			0	uz	\<emph\>NewText\</emph\> is the text that is to replace the text segment.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150348	181			0	uz	\<emph\>Occurrence\</emph\> (optional) indicates which occurrence of the search text is to be replaced. If this parameter is missing the search text is replaced throughout.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150946				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150412	183			0	uz	\<item type=\"input\"\>=SUBSTITUTE("123123123";"3";"abc")\</item\> returns 12abc12abc12abc.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154915	238			0	uz	\<item type=\"input\"\>=SUBSTITUTE("123123123";"3";"abc";2)\</item\> returns 12312abc123.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3148977				0	uz	\<bookmark_value\>T function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148977				0	uz	T				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154359				0	uz	\<ahelp hid=\"HID_FUNC_T\"\>This function returns the target text, or a blank text string if the target is not text.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155858				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155871				0	uz	T(Value)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154726				0	uz	If \<emph\>Value\</emph\> is a text string or refers to a text string, T returns that text string; otherwise it returns a blank text string.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155544				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151062	146			0	uz	\<item type=\"input\"\>=T(12345)\</item\> returns an empty string. 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id4650105				0	uz	\<item type=\"input\"\>=T("12345")\</item\> returns the string 12345.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3147132				0	uz	\<bookmark_value\>TEXT function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3147132				0	uz	TEXT				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147213				0	uz	\<ahelp hid=\"HID_FUNC_TEXT\"\>Converts a number into text according to a given format.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153129				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147377				0	uz	TEXT(Number; Format)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147389	162			0	uz	\<emph\>Number\</emph\> is the number to be converted.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156167	163			0	uz	\<emph\>Format\</emph\> is the text which defines the format. Use decimal and thousands separators according to the language set in the cell format.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id1243629				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id9044770				0	uz	\<item type=\"input\"\>=TEXT(12.34567;"###.##")\</item\> returns the text 12.35				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3674123				0	uz	\<item type=\"input\"\>=TEXT(12.34567;"000.00")\</item\> returns the text 012.35				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3151039				0	uz	\<bookmark_value\>TRIM function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3151039				0	uz	TRIM				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3157888				0	uz	\<ahelp hid=\"HID_FUNC_GLAETTEN\"\>Removes spaces from a string, leaving only a single space character between words.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152913				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151349				0	uz	TRIM("Text")				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151362	58			0	uz	\<emph\>Text\</emph\> refers to text in which spaces are removed.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146838				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156074	60			0	uz	\<item type=\"input\"\>=TRIM("hello")\</item\> returns hello.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id0907200904030935				0	uz	\<bookmark_value\>CHAR function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id0907200904123753				0	uz	Syntax				2002-02-02 02:02:02
