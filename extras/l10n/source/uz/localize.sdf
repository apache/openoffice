helpcontent2	source\text\shared\02\24010000.xhp	0	help	hd_id3153003				0	uz	Charcoal Sketch				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3152971				0	uz	\<ahelp hid=\".uno:GraphicFilterSobel\"\>Displays the image as a charcoal sketch. The contours of the image are drawn in black, and the original colors are suppressed.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3150327				0	uz	\<image id=\"img_id3154636\" src=\"res/commandimagelist/sc_graphicfiltersobel.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3154636\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
