helpcontent2	source\text\scalc\01\12050200.xhp	0	help	hd_id3154758				0	uz	\<link href=\"text/scalc/01/12050200.xhp\" name=\"Options\"\>Options\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12050200.xhp	0	help	par_id3154124				0	uz	\<ahelp hid=\"HID_SCPAGE_SUBT_OPTIONS\"\>Specify the settings for calculating and presenting subtotals.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12050200.xhp	0	help	hd_id3156422				0	uz	Page break between groups				2002-02-02 02:02:02
