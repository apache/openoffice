helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3154098				0	uz	MsgBox "elementInserted"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3155601				0	uz	MsgBox oEvent.Dbg_Properties				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3153415				0	uz	End Sub				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3154272				0	uz	Sub ContListener_elementRemoved( oEvent )				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3153947				0	uz	MsgBox "elementRemoved"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3146914				0	uz	MsgBox oEvent.Dbg_Properties				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3150749				0	uz	End Sub				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3145642				0	uz	Sub ContListener_elementReplaced( oEvent )				2002-02-02 02:02:02
