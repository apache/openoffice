helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3147072				0	uz	\<variable id=\"rz\"\>\<link href=\"text/scalc/01/04060185.xhp\" name=\"Statistical Functions Part Five\"\>Statistical Functions Part Five\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3155071				0	uz	\<bookmark_value\>RANK function\</bookmark_value\>\<bookmark_value\>numbers;determining ranks\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3155071				0	uz	RANK				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153976				0	uz	\<ahelp hid=\"HID_FUNC_RANG\"\>Returns the rank of a number in a sample.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3159206				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153250				0	uz	RANK(Value; Data; Type)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154543	6			0	uz	\<emph\>Value\</emph\> is the value, whose rank is to be determined.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149130	7			0	uz	\<emph\>Data\</emph\> is the array or range of data in the sample.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150215	8			0	uz	\<emph\>Type\</emph\> (optional) is the sequence order.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id9305398				0	uz	Type = 0 means descending from the last item of the array to the first (this is the default), 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id9996948				0	uz	Type = 1 means ascending from the first item of the range to the last.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3143223				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3155919	10			0	uz	\<item type=\"input\"\>=RANK(A10;A1:A50)\</item\> returns the ranking of the value in A10 in value range A1:A50. If \<item type=\"literal\"\>Value\</item\> does not exist within the range an error message is displayed.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3153556				0	uz	\<bookmark_value\>SKEW function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3153556				0	uz	SKEW				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153485				0	uz	\<ahelp hid=\"HID_FUNC_SCHIEFE\"\>Returns the skewness of a distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3154733				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3151191				0	uz	SKEW(Number1; Number2; ...Number30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3155757	16			0	uz	\<emph\>Number1, Number2...Number30\</emph\> are numerical values or ranges.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3153297				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3145118	18			0	uz	\<item type=\"input\"\>=SKEW(A1:A50)\</item\> calculates the value of skew for the data referenced.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3149051				0	uz	\<bookmark_value\>regression lines;FORECAST function\</bookmark_value\>\<bookmark_value\>extrapolations\</bookmark_value\>\<bookmark_value\>FORECAST function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3149051				0	uz	FORECAST				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153290				0	uz	\<ahelp hid=\"HID_FUNC_SCHAETZER\"\>Extrapolates future values based on existing x and y values.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3151343				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3147404				0	uz	FORECAST(Value; DataY; DataX)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3148743	24			0	uz	\<emph\>Value\</emph\> is the x value, for which the y value on the linear regression is to be returned.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3146325	25			0	uz	\<emph\>DataY\</emph\> is the array or range of known y's.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150536	26			0	uz	\<emph\>DataX\</emph\> is the array or range of known x's.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3147416				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3157874	28			0	uz	\<item type=\"input\"\>=FORECAST(50;A1:A50;B1;B50)\</item\> returns the Y value expected for the X value of 50 if the X and Y values in both references are linked by a linear trend.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3149143				0	uz	\<bookmark_value\>STDEV function\</bookmark_value\>\<bookmark_value\>standard deviations in statistics;based on a sample\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3149143				0	uz	STDEV				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3146888				0	uz	\<ahelp hid=\"HID_FUNC_STABW\"\>Estimates the standard deviation based on a sample.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3146815				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149946	33			0	uz	STDEV(Number1; Number2; ...Number30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3157904	34			0	uz	\<emph\>Number1, Number2, ... Number30\</emph\> are numerical values or ranges representing a sample based on an entire population.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3150650				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149434	36			0	uz	\<item type=\"input\"\>=STDEV(A1:A50)\</item\> returns the estimated standard deviation based on the data referenced.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3144745				0	uz	\<bookmark_value\>STDEVA function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3144745				0	uz	STDEVA				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3151234				0	uz	\<ahelp hid=\"HID_FUNC_STABWA\"\>Calculates the standard deviation of an estimation based on a sample.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3148884				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3147422				0	uz	STDEVA(Value1;Value2;...Value30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154547	190			0	uz	\<emph\>Value1, Value2, ...Value30\</emph\> are values or ranges representing a sample derived from an entire population. Text has the value 0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3155829				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3148581	192			0	uz	\<item type=\"input\"\>=STDEVA(A1:A50)\</item\> returns the estimated standard deviation based on the data referenced.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3149734				0	uz	\<bookmark_value\>STDEVP function\</bookmark_value\>\<bookmark_value\>standard deviations in statistics;based on a population\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3149734				0	uz	STDEVP				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149187				0	uz	\<ahelp hid=\"HID_FUNC_STABWN\"\>Calculates the standard deviation based on the entire population.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3154387				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154392				0	uz	STDEVP(Number1;Number2;...Number30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3155261	42			0	uz	\<emph\>Number 1,Number 2,...Number 30\</emph\> are numerical values or ranges representing a sample based on an entire population.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3145591				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153933	44			0	uz	\<item type=\"input\"\>=STDEVP(A1:A50)\</item\> returns a standard deviation of the data referenced.				2002-02-02 02:02:02
