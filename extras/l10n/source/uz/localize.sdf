helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3145172				0	uz	const b1=12.345e12				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3159254				0	uz	const b2=1.345e34				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3147287				0	uz	dValue=Exp( Log(b1)+Log(b2) )				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3161832				0	uz	MsgBox "" & dValue & chr(13) & (b1*b2) ,0,"Multiplication by logarithm"				2002-02-02 02:02:02
