helpcontent2	source\text\scalc\01\05040000.xhp	0	help	par_id3148946				0	uz	\<ahelp hid=\".\"\>Sets the column width and hides or shows selected columns.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05040000.xhp	0	help	hd_id3150398				0	uz	\<link href=\"text/shared/01/05340200.xhp\" name=\"Width\"\>Width\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05040000.xhp	0	help	hd_id3145171				0	uz	\<link href=\"text/scalc/01/05040200.xhp\" name=\"Optimal Width\"\>Optimal Width\</link\>				2002-02-02 02:02:02
