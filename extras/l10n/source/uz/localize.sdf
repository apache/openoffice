helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3144842				0	uz	\<bookmark_value\>SUMX2MY2 function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3144842				0	uz	SUMX2MY2				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3144871				0	uz	\<ahelp hid=\"HID_FUNC_SUMMEX2MY2\"\>Returns the sum of the difference of squares of corresponding values in two arrays.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3144889				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3144903				0	uz	SUMX2MY2(ArrayX; ArrayY)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3144916				0	uz	\<emph\>ArrayX\</emph\> represents the first array whose elements are to be squared and added.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3144936				0	uz	\<emph\>ArrayY\</emph\> represents the second array whose elements are to be squared and subtracted.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11D6B				0	uz	\<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3145026				0	uz	\<bookmark_value\>SUMX2PY2 function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3145026				0	uz	SUMX2PY2				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3145055				0	uz	\<ahelp hid=\"HID_FUNC_SUMMEX2PY2\"\>Returns the sum of the sum of squares of corresponding values in two arrays.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3163390				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163404				0	uz	SUMX2PY2(ArrayX; ArrayY)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163417				0	uz	\<emph\>ArrayX\</emph\> represents the first array whose arguments are to be squared and added.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163437				0	uz	\<emph\>ArrayY\</emph\> represents the second array whose elements are to be squared and subtracted.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11E45				0	uz	\<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3163527				0	uz	\<bookmark_value\>SUMXMY2 function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3163527				0	uz	SUMXMY2				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163556				0	uz	\<ahelp hid=\"HID_FUNC_SUMMEXMY2\"\>Adds the squares of the variance between corresponding values in two arrays.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3163574				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163588				0	uz	SUMXMY2(ArrayX; ArrayY)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163601				0	uz	\<emph\>ArrayX\</emph\> represents the first array whose elements are to be subtracted and squared.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163621				0	uz	\<emph\>ArrayY\</emph\> represents the second array, whose elements are to be subtracted and squared.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11F1F				0	uz	\<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3166062				0	uz	\<bookmark_value\>TREND function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3166062				0	uz	TREND				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166091				0	uz	\<ahelp hid=\"HID_FUNC_TREND\"\>Returns values along a linear trend.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3166109				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166122				0	uz	TREND(DataY; DataX; NewDataX; LinearType)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166137				0	uz	\<emph\>DataY\</emph\> represents the Y Data array.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166156				0	uz	\<emph\>DataX\</emph\> (optional) represents the X Data array.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166176				0	uz	\<emph\>NewDataX\</emph\> (optional) represents the array of the X data, which are used for recalculating values.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166196				0	uz	\<emph\>LinearType\</emph\>(Optional). If LinearType = 0, then lines will be calculated through the zero point. Otherwise, offset lines will also be calculated. The default is LinearType <> 0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11D2F				0	uz	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN12019				0	uz	\<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3166231				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166245				0	uz	Select a spreadsheet range in which the trend data will appear. Select the function. Enter the output data or select it with the mouse. Mark the \<emph\>Array\</emph\> field. click \<emph\>OK\</emph\>. The trend data calculated from the output data is displayed.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3166317				0	uz	\<bookmark_value\>GROWTH function\</bookmark_value\>\<bookmark_value\>exponential trends in arrays\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3166317				0	uz	GROWTH				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166346				0	uz	\<ahelp hid=\"HID_FUNC_VARIATION\"\>Calculates the points of an exponential trend in an array.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3166364				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166377				0	uz	GROWTH(DataY; DataX; NewDataX; FunctionType)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166392				0	uz	\<emph\>DataY\</emph\> represents the Y Data array.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166411				0	uz	\<emph\>DataX\</emph\> (optional) represents the X Data array.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3173797				0	uz	\<emph\>NewDataX\</emph\> (optional) represents the X data array, in which the values are recalculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3173817				0	uz	\<emph\>FunctionType\</emph\>(optional). If FunctionType = 0, functions in the form y = m^x will be calculated. Otherwise, y = b*m^x functions will be calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11DFD				0	uz	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN12113				0	uz	\<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3173839				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3173852				0	uz	This function returns an array and is handled in the same way as the other array functions. Select a range where you want the answers to appear and select the function. Select DataY. Enter any other parameters, mark \<emph\>Array\</emph\> and click \<emph\>OK\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140400.xhp	0	help	tit				0	uz	Left				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140400.xhp	0	help	hd_id3153896				0	uz	\<link href=\"text/scalc/01/02140400.xhp\" name=\"Left\"\>Left\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140400.xhp	0	help	par_id3150793				0	uz	\<ahelp hid=\".uno:FillLeft\" visibility=\"visible\"\>Fills a selected range of at least two columns with the contents of the far right cell.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140400.xhp	0	help	par_id3156280				0	uz	If a selected range has only one row, the content of the far right cell is copied into all other cells of the range. If several rows are selected, the far right cells are copied into the cells to the left.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	tit				0	uz	Text to Columns				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	bm_id8004394				0	uz	\<bookmark_value\>text to columns\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	hd_id2300180				0	uz	\<link href=\"text/scalc/01/text2columns.xhp\"\>Text to Columns\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	par_id655232				0	uz	\<variable id=\"text2columns\"\>Opens the Text to Columns dialog, where you enter settings to expand the contents of selected cells to multiple cells. \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	hd_id9599597				0	uz	To expand cell contents to multiple cells				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	par_id2021546				0	uz	You can expand cells that contain comma separated values (CSV) into multiple cells in the same row. 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	par_id2623981				0	uz	For example, cell A1 contains the comma separated values \<item type=\"literal\"\>1,2,3,4\</item\>, and cell A2 contains the text \<item type=\"literal\"\>A,B,C,D\</item\>. 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	par_id7242042				0	uz	Select the cell or cells that you want to expand.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	par_id6999420				0	uz	Choose \<emph\>Data - Text to Columns\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	par_id6334116				0	uz	You see the Text to Columns dialog.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	par_id9276406				0	uz	Select the separator options. The preview shows how the current cell contents will be transformed into multiple cells.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	par_id8523819				0	uz	You can select a fixed width and then click the ruler on the preview to set cell breakup positions.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	par_id1517380				0	uz	You can select or enter separator characters to define the positions of breaking points. The separator characters are removed from the resulting cell contents.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	par_id7110812				0	uz	In the example, you select the comma as a delimiter character. Cells A1 and B1 will be expanded to four columns. A1 contains 1, A2 contains 2, and so on.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05030200.xhp	0	help	tit				0	uz	Optimal Row Heights				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05030200.xhp	0	help	bm_id3148491				0	uz	\<bookmark_value\>sheets; optimal row heights\</bookmark_value\>\<bookmark_value\>rows; optimal heights\</bookmark_value\>\<bookmark_value\>optimal row heights\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05030200.xhp	0	help	hd_id3148491				0	uz	Optimal Row Heights				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05030200.xhp	0	help	par_id3154758				0	uz	\<variable id=\"optitext\"\>\<ahelp hid=\".uno:SetOptimalRowHeight\"\>Determines the optimal row height for the selected rows.\</ahelp\>\</variable\> The optimal row height depends on the font size of the largest character in the row. You can use various \<link href=\"text/shared/00/00000003.xhp#metrik\" name=\"units of measure\"\>units of measure\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05030200.xhp	0	help	hd_id3154908				0	uz	Add				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05030200.xhp	0	help	par_id3151044				0	uz	\<ahelp hid=\"SC:METRICFIELD:RID_SCDLG_ROW_OPT:ED_VALUE\"\>Sets additional spacing between the largest character in a row and the cell boundaries.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05030200.xhp	0	help	hd_id3150439				0	uz	Default value				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05030200.xhp	0	help	par_id3146984				0	uz	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_ROW_OPT:BTN_DEFVAL\"\>Restores the default value for the optimal row height.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	tit				0	uz	Spreadsheet Functions				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3148522				0	uz	\<bookmark_value\>spreadsheets; functions\</bookmark_value\>\<bookmark_value\>Function Wizard; spreadsheets\</bookmark_value\>\<bookmark_value\>functions; spreadsheets\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3148522				0	uz	Spreadsheet Functions				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3144508				0	uz	\<variable id=\"tabelletext\"\>This section contains descriptions of the \<emph\>Spreadsheet\</emph\> functions together with an example. \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3146968				0	uz	\<bookmark_value\>ADDRESS function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3146968				0	uz	ADDRESS				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155762				0	uz	\<ahelp hid=\"HID_FUNC_ADRESSE\"\>Returns a cell address (reference) as text, according to the specified row and column numbers.\</ahelp\> You can determine whether the address is interpreted as an absolute address (for example, $A$1) or as a relative address (as A1) or in a mixed form (A$1 or $A1). You can also specify the name of the sheet.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301348				0	uz	For interoperability the ADDRESS and INDIRECT functions support an optional parameter to specify whether the R1C1 address notation instead of the usual A1 notation should be used.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301445				0	uz	In ADDRESS, the parameter is inserted as the fourth parameter, shifting the optional sheet name parameter to the fifth position.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id102720080230153				0	uz	In INDIRECT, the parameter is appended as the second parameter.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id102720080230151				0	uz	In both functions, if the argument is inserted with the value 0, then the R1C1 notation is used. If the argument is not given or has a value other than 0, then the A1 notation is used. 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301556				0	uz	In case of R1C1 notation, ADDRESS returns address strings using the exclamation mark '!' as the sheet name separator, and INDIRECT expects the exclamation mark as sheet name separator. Both functions still use the dot '.' sheet name separator with A1 notation.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301521				0	uz	When opening documents from ODF 1.0/1.1 format, the ADDRESS functions that show a sheet name as the fourth paramater will shift that sheet name to become the fifth parameter. A new fourth parameter with the value 1 will be inserted.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301650				0	uz	When storing a document in ODF 1.0/1.1 format, if ADDRESS functions have a fourth parameter, that parameter will be removed.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id102720080230162				0	uz	Do not save a spreadsheet in the old ODF 1.0/1.1 format if the ADDRESS function's new fourth parameter was used with a value of 0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301756				0	uz	The INDIRECT function is saved without conversion to ODF 1.0/1.1 format. If the second parameter was present, an older version of Calc will return an error for that function.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3151196				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154707				0	uz	ADDRESS(Row; Column; Abs; A1; "Sheet")				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147505	7			0	uz	\<emph\>Row\</emph\> represents the row number for the cell reference				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3145323	8			0	uz	\<emph\>Column\</emph\> represents the column number for the cell reference (the number, not the letter)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153074	9			0	uz	\<emph\>Abs\</emph\> determines the type of reference:				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153298				0	uz	1: absolute ($A$1)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150431				0	uz	2: row reference type is absolute; column reference is relative (A$1)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3146096				0	uz	3: row (relative); column (absolute) ($A1)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153334				0	uz	4: relative (A1)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802465915				0	uz	\<emph\>A1\</emph\> (optional) - if set to 0, the R1C1 notation is used. If this parameter is absent or set to another value than 0, the A1 notation is used.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153962	14			0	uz	\<emph\>Sheet\</emph\> represents the name of the sheet. It must be placed in double quotes.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3147299				0	uz	Example:				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148744	16			0	uz	\<item type=\"input\"\>=ADDRESS(1;1;2;"Sheet2")\</item\> returns the following: Sheet2.A$1				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3159260				0	uz	If the cell A1 in sheet 2 contains the value \<item type=\"input\"\>-6\</item\>, you can refer indirectly to the referenced cell using a function in B2 by entering \<item type=\"input\"\>=ABS(INDIRECT(B2))\</item\>. The result is the absolute value of the cell reference specified in B2, which in this case is 6.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3150372				0	uz	\<bookmark_value\>AREAS function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3150372				0	uz	AREAS				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150036				0	uz	\<ahelp hid=\"HID_FUNC_BEREICHE\"\>Returns the number of individual ranges that belong to a multiple range.\</ahelp\> A range can consist of contiguous cells or a single cell.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3145222				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155907				0	uz	AREAS(Reference)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153118				0	uz	Reference represents the reference to a cell or cell range.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3148891				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3146820	26			0	uz	\<item type=\"input\"\>=AREAS(All)\</item\> returns 1 if you have defined an area named All under \<emph\>Data - Define Range\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3148727				0	uz	\<bookmark_value\>DDE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3148727				0	uz	DDE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149434				0	uz	\<ahelp hid=\"HID_FUNC_DDE\"\>Returns the result of a DDE-based link.\</ahelp\> If the contents of the linked range or section changes, the returned value will also change. You must reload the spreadsheet or choose \<emph\>Edit - Links\</emph\> to see the updated links. Cross-platform links, for example from a \<item type=\"productname\"\>%PRODUCTNAME\</item\> installation running on a Windows machine to a document created on a Linux machine, are not allowed.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3150700				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148886				0	uz	DDE("Server"; "File"; "Range"; Mode)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154842	32			0	uz	\<emph\>Server\</emph\> is the name of a server application. \<item type=\"productname\"\>%PRODUCTNAME\</item\>applications have the server name "Soffice".				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153034	33			0	uz	\<emph\>File\</emph\> is the complete file name, including path specification.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147472	34			0	uz	\<emph\>Range\</emph\> is the area containing the data to be evaluated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3152773	184			0	uz	\<emph\>Mode\</emph\> is an optional parameter that controls the method by which the DDE server converts its data into numbers.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154558				0	uz	0 or missing				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3145596				0	uz	Number format from the "Default" cell style				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3152785				0	uz	1				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154380				0	uz	Data are always interpreted in the standard format for US English				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150279				0	uz	2				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153775				0	uz	Data are retrieved as text; no conversion to numbers				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3149546				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148734	36			0	uz	\<item type=\"input\"\>=DDE("soffice";"c:\\office\\document\\data1.sxc";"sheet1.A1")\</item\> reads the contents of cell A1 in sheet1 of the \<item type=\"productname\"\>%PRODUCTNAME\</item\> Calc spreadsheet data1.sxc.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153081	37			0	uz	\<item type=\"input\"\>=DDE("soffice";"c:\\office\\document\\motto.sxw";"Today's motto")\</item\> returns a motto in the cell containing this formula. First, you must enter a line in the motto.sxw document containing the motto text and define it as the first line of a section named \<item type=\"literal\"\>Today's Motto\</item\> (in \<item type=\"productname\"\>%PRODUCTNAME\</item\> Writer under \<emph\>Insert - Section\</emph\>). If the motto is modified (and saved) in the \<item type=\"productname\"\>%PRODUCTNAME\</item\> Writer document, the motto is updated in all \<item type=\"productname\"\>%PRODUCTNAME\</item\> Calc cells in which this DDE link is defined.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3153114				0	uz	\<bookmark_value\>ERRORTYPE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153114				0	uz	ERRORTYPE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148568				0	uz	\<ahelp hid=\"HID_FUNC_FEHLERTYP\"\>Returns the number corresponding to an \<link href=\"text/scalc/05/02140000.xhp\" name=\"error value\"\>error value\</link\> occurring in a different cell.\</ahelp\> With the aid of this number, you can generate an error message text.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149877				0	uz	The Status Bar displays the predefined error code from \<item type=\"productname\"\>%PRODUCTNAME\</item\> if you click the cell containing the error.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3154327				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3151322				0	uz	ERRORTYPE(Reference)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150132	43			0	uz	\<emph\>Reference\</emph\> contains the address of the cell in which the error occurs.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3145248				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3146904				0	uz	If cell A1 displays Err:518, the function \<item type=\"input\"\>=ERRORTYPE(A1)\</item\> returns the number 518.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3151221				0	uz	\<bookmark_value\>INDEX function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3151221				0	uz	INDEX				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150268				0	uz	\<ahelp hid=\"HID_FUNC_INDEX\"\>INDEX returns a sub range, specified by row and column number, or an optional range index. Depending on context, INDEX returns a reference or content.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3156063				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149007				0	uz	INDEX(Reference; Row; Column; Range)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153260	51			0	uz	\<emph\>Reference\</emph\> is a reference, entered either directly or by specifying a range name. If the reference consists of multiple ranges, you must enclose the reference or range name in parentheses.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3145302	52			0	uz	\<emph\>Row\</emph\> (optional) represents the row index of the reference range, for which to return a value. In case of zero (no specific row) all referenced rows are returned.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154628	53			0	uz	\<emph\>Column\</emph\> (optional) represents the column index of the reference range, for which to return a value. In case of zero (no specific column) all referenced columns are returned.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155514	54			0	uz	\<emph\>Range\</emph\> (optional) represents the index of the subrange if referring to a multiple range.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3145264				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3159112	56			0	uz	\<item type=\"input\"\>=INDEX(Prices;4;1)\</item\> returns the value from row 4 and column 1 of the database range defined in \<emph\>Data - Define\</emph\> as \<emph\>Prices\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150691	57			0	uz	\<item type=\"input\"\>=INDEX(SumX;4;1)\</item\> returns the value from the range \<emph\>SumX\</emph\> in row 4 and column 1 as defined in \<emph\>Insert - Names - Define\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id4109012				0	uz	\<item type=\"input\"\>=INDEX(A1:B6;1)\</item\> returns a reference to the first row of A1:B6.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id9272133				0	uz	\<item type=\"input\"\>=INDEX(A1:B6;0;1)\</item\> returns a reference to the first column of A1:B6.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3158419	58			0	uz	\<item type=\"input\"\>=INDEX((multi);4;1)\</item\> indicates the value contained in row 4 and column 1 of the (multiple) range, which you named under \<emph\>Insert - Names - Set\</emph\> as \<emph\>multi\</emph\>. The multiple range may consist of several rectangular ranges, each with a row 4 and column 1. If you now want to call the second block of this multiple range enter the number \<item type=\"input\"\>2\</item\> as the \<emph\>range\</emph\> parameter.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148595	59			0	uz	\<item type=\"input\"\>=INDEX(A1:B6;1;1)\</item\> indicates the value in the upper-left of the A1:B6 range.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id9960020				0	uz	\<item type=\"input\"\>=INDEX((multi);0;0;2)\</item\> returns a reference to the second range of the multiple range.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3153181				0	uz	\<bookmark_value\>INDIRECT function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153181				0	uz	INDIRECT				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147169				0	uz	\<ahelp hid=\"HID_FUNC_INDIREKT\"\>Returns the \<emph\>reference\</emph\> specified by a text string.\</ahelp\> This function can also be used to return the area of a corresponding string.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153717				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149824				0	uz	INDIRECT(Ref; A1)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154317	66			0	uz	\<emph\>Ref\</emph\> represents a reference to a cell or an area (in text form) for which to return the contents.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802470312				0	uz	\<emph\>A1\</emph\> (optional) - if set to 0, the R1C1 notation is used. If this parameter is absent or set to another value than 0, the A1 notation is used.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN10CAE				0	uz	If you open an Excel spreadsheet that uses indirect addresses calculated from string functions, the sheet addresses will not be translated automatically. For example, the Excel address in INDIRECT("filename!sheetname"&B1) is not converted into the Calc address in INDIRECT("filename.sheetname"&B1).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3150389				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150608	68			0	uz	\<item type=\"input\"\>=INDIRECT(A1)\</item\> equals 100 if A1 contains C108 as a reference and cell C108 contains a value of \<item type=\"input\"\>100\</item\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3083286	181			0	uz	\<item type=\"input\"\>=SUM(INDIRECT("a1:" & ADDRESS(1;3)))\</item\> totals the cells in the area of A1 up to the cell with the address defined by row 1 and column 3. This means that area A1:C1 is totaled.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3154818				0	uz	\<bookmark_value\>COLUMN function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3154818				0	uz	COLUMN				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149711				0	uz	\<ahelp hid=\"HID_FUNC_SPALTE\"\>Returns the column number of a cell reference.\</ahelp\> If the reference is a cell the column number of the cell is returned; if the parameter is a cell area, the corresponding column numbers are returned in a single-row \<link href=\"text/scalc/01/04060107.xhp#wasmatrix\" name=\"array\"\>array\</link\> if the formula is entered \<link href=\"text/scalc/01/04060107.xhp#somatrixformel\" name=\"as an array formula\"\>as an array formula\</link\>. If the COLUMN function with an area reference parameter is not used for an array formula, only the column number of the first cell within the area is determined.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3149283				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149447				0	uz	COLUMN(Reference)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3156310	74			0	uz	\<emph\>Reference\</emph\> is the reference to a cell or cell area whose first column number is to be found.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155837				0	uz	If no reference is entered, the column number of the cell in which the formula is entered is found. \<item type=\"productname\"\>%PRODUCTNAME\</item\> Calc automatically sets the reference to the current cell.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3152932				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147571	76			0	uz	\<item type=\"input\"\>=COLUMN(A1)\</item\> equals 1. Column A is the first column in the table.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147079	77			0	uz	\<item type=\"input\"\>=COLUMN(C3:E3)\</item\> equals 3. Column C is the third column in the table.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3146861	195			0	uz	\<item type=\"input\"\>=COLUMN(D3:G10)\</item\> returns 4 because column D is the fourth column in the table and the COLUMN function is not used as an array formula. (In this case, the first value of the array is always used as the result.)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3156320	196			0	uz	\<item type=\"input\"\>{=COLUMN(B2:B7)}\</item\> and \<item type=\"input\"\>=COLUMN(B2:B7)\</item\> both return 2 because the reference only contains column B as the second column in the table. Because single-column areas have only one column number, it does not make a difference whether or not the formula is used as an array formula.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150872	197			0	uz	\<item type=\"input\"\>=COLUMN()\</item\> returns 3 if the formula was entered in column C.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153277	198			0	uz	\<item type=\"input\"\>{=COLUMN(Rabbit)}\</item\> returns the single-row array (3, 4) if "Rabbit" is the named area (C1:D3).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3154643				0	uz	\<bookmark_value\>COLUMNS function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3154643				0	uz	COLUMNS				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3151182				0	uz	\<ahelp hid=\"HID_FUNC_SPALTEN\"\>Returns the number of columns in the given reference.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3149141				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154047				0	uz	COLUMNS(Array)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154745	83			0	uz	\<emph\>Array\</emph\> is the reference to a cell range whose total number of columns is to be found. The argument can also be a single cell.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153622				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149577	200			0	uz	\<item type=\"input\"\>=COLUMNS(B5)\</item\> returns 1 because a cell only contains one column.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3145649	85			0	uz	\<item type=\"input\"\>=COLUMNS(A1:C5)\</item\> equals 3. The reference comprises three columns.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155846	201			0	uz	\<item type=\"input\"\>=COLUMNS(Rabbit)\</item\> returns 2 if \<item type=\"literal\"\>Rabbit\</item\> is the named range (C1:D3).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3153152				0	uz	\<bookmark_value\>vertical search function\</bookmark_value\>\<bookmark_value\>VLOOKUP function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153152				0	uz	VLOOKUP				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149984				0	uz	\<ahelp hid=\"HID_FUNC_SVERWEIS\"\>Vertical search with reference to adjacent cells to the right.\</ahelp\> This function checks if a specific value is contained in the first column of an array. The function then returns the value in the same row of the column named by \<item type=\"literal\"\>Index\</item\>. If the \<item type=\"literal\"\>SortOrder\</item\> parameter is omitted or set to TRUE or one, it is assumed that the data is sorted in ascending order. In this case, if the exact \<item type=\"literal\"\>SearchCriterion\</item\> is not found, the last value that is smaller than the criterion will be returned. If \<item type=\"literal\"\>SortOrder\</item\> is set to FALSE or zero, an exact match must be found, otherwise the error \<emph\>Error: Value Not Available\</emph\> will be the result. Thus with a value of zero the data does not need to be sorted in ascending order.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3146898				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150156				0	uz	=VLOOKUP(SearchCriterion; Array; Index; SortOrder)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149289	91			0	uz	\<emph\>SearchCriterion\</emph\> is the value searched for in the first column of the array.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153884	92			0	uz	\<emph\>Array\</emph\> is the reference, which is to comprise at least two columns.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3156005	93			0	uz	\<emph\>Index\</emph\> is the number of the column in the array that contains the value to be returned. The first column has the number 1.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3151208	94			0	uz	\<emph\>SortOrder\</emph\> is an optional parameter that indicates whether the first column in the array is sorted in ascending order. Enter the Boolean value FALSE or zero if the first column is not sorted in ascending order. Sorted columns can be searched much faster and the function always returns a value, even if the search value was not matched exactly, if it is between the lowest and highest value of the sorted list. In unsorted lists, the search value must be matched exactly. Otherwise the function will return this message: \<emph\>Error: Value Not Available\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3147487				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154129				0	uz	You want to enter the number of a dish on the menu in cell A1, and the name of the dish is to appear as text in the neighboring cell (B1) immediately. The Number to Name assignment is contained in the D1:E100 array. D1 contains \<item type=\"input\"\>100\</item\>, E1 contains the name \<item type=\"input\"\>Vegetable Soup\</item\>, and so forth, for 100 menu items. The numbers in column D are sorted in ascending order; thus, the optional \<item type=\"literal\"\>SortOrder\</item\> parameter is not necessary.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3145663				0	uz	Enter the following formula in B1:				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149200				0	uz	As soon as you enter a number in A1 B1 will show the corresponding text contained in the second column of reference D1:E100. Entering a nonexistent number displays the text with the next number down. To prevent this, enter FALSE as the last parameter in the formula so that an error message is generated when a nonexistent number is entered.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3153905				0	uz	\<bookmark_value\>sheet numbers; looking up\</bookmark_value\>\<bookmark_value\>SHEET function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153905				0	uz	SHEET				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150309				0	uz	\<ahelp hid=\"HID_FUNC_TABELLE\"\>Returns the sheet number of a reference or a string representing a sheet name.\</ahelp\> If you do not enter any parameters, the result is the sheet number of the spreadsheet containing the formula.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3148564				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153095				0	uz	SHEET(Reference)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154588	219			0	uz	\<emph\>Reference\</emph\> is optional and is the reference to a cell, an area, or a sheet name string.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3155399				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3146988	221			0	uz	\<item type=\"input\"\>=SHEET(Sheet2.A1)\</item\> returns 2 if Sheet2 is the second sheet in the spreadsheet document.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3148829				0	uz	\<bookmark_value\>number of sheets; function\</bookmark_value\>\<bookmark_value\>SHEETS function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3148829				0	uz	SHEETS				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148820				0	uz	\<ahelp hid=\"HID_FUNC_TABELLEN\"\>Determines the number of sheets in a reference.\</ahelp\> If you do not enter any parameters, it returns the number of sheets in the current document.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3154220				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150777				0	uz	SHEETS(Reference)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153060	226			0	uz	\<emph\>Reference\</emph\> is the reference to a sheet or an area. This parameter is optional.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3149766				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150507	228			0	uz	\<item type=\"input\"\>=SHEETS(Sheet1.A1:Sheet3.G12)\</item\> returns 3 if Sheet1, Sheet2, and Sheet3 exist in the sequence indicated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3158407				0	uz	\<bookmark_value\>MATCH function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3158407				0	uz	MATCH				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154896				0	uz	\<ahelp hid=\"HID_FUNC_VERGLEICH\"\>Returns the relative position of an item in an array that matches a specified value.\</ahelp\> The function returns the position of the value found in the lookup_array as a number.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153834				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3159152				0	uz	MATCH(SearchCriterion; LookupArray; Type)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149336	105			0	uz	\<emph\>SearchCriterion\</emph\> is the value which is to be searched for in the single-row or single-column array.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3159167	106			0	uz	\<emph\>LookupArray\</emph\> is the reference searched. A lookup array can be a single row or column, or part of a single row or column.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147239	107			0	uz	\<emph\>Type\</emph\> may take the values 1, 0, or -1. If Type = 1 or if this optional parameter is missing, it is assumed that the first column of the search array is sorted in ascending order. If Type = -1 it is assumed that the column in sorted in descending order. This corresponds to the same function in Microsoft Excel.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154265				0	uz	If Type = 0, only exact matches are found. If the search criterion is found more than once, the function returns the index of the first matching value. Only if Type = 0 can you search for regular expressions.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147528				0	uz	If Type = 1 or the third parameter is missing, the index of the last value that is smaller or equal to the search criterion is returned. This applies even when the search array is not sorted. For Type = -1, the first value that is larger or equal is returned.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3155119				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155343	109			0	uz	\<item type=\"input\"\>=MATCH(200;D1:D100)\</item\> searches the area D1:D100, which is sorted by column D, for the value 200. As soon as this value is reached, the number of the row in which it was found is returned. If a higher value is found during the search in the column, the number of the previous row is returned.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3158430				0	uz	\<bookmark_value\>OFFSET function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3158430				0	uz	OFFSET				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149167				0	uz	\<ahelp hid=\"HID_FUNC_VERSCHIEBUNG\"\>Returns the value of a cell offset by a certain number of rows and columns from a given reference point.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3146952				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3159194				0	uz	OFFSET(Reference; Rows; Columns; Height; Width)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3152360	115			0	uz	\<emph\>Reference\</emph\> is the reference from which the function searches for the new reference.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3156032	116			0	uz	\<emph\>Rows\</emph\> is the number of rows by which the reference was corrected up (negative value) or down.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3166458	117			0	uz	\<emph\>Columns\</emph\> (optional) is the number of columns by which the reference was corrected to the left (negative value) or to the right.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150708	118			0	uz	\<emph\>Height\</emph\> (optional) is the vertical height for an area that starts at the new reference position.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147278	119			0	uz	\<emph\>Width\</emph\> (optional) is the horizontal width for an area that starts at the new reference position.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id8662373				0	uz	Arguments \<emph\>Rows\</emph\> and \<emph\>Columns\</emph\> must not lead to zero or negative start row or column				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id9051484				0	uz	Arguments \<emph\>Height\</emph\> and \<emph\>Width\</emph\> must not lead to zero or negative count of rows or columns.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3155586				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149744	121			0	uz	\<item type=\"input\"\>=OFFSET(A1;2;2)\</item\> returns the value in cell C3 (A1 moved by two rows and two columns down). If C3 contains the value \<item type=\"input\"\>100\</item\> this function returns the value 100.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id7439802				0	uz	\<item type=\"input\"\>=OFFSET(B2:C3;1;1)\</item\> returns a reference to B2:C3 moved down by 1 row and one column to the right (C3:D4).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3009430				0	uz	\<item type=\"input\"\>=OFFSET(B2:C3;-1;-1)\</item\> returns a reference to B2:C3 moved up by 1 row and one column to the left (A1:B2).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id2629169				0	uz	\<item type=\"input\"\>=OFFSET(B2:C3;0;0;3;4)\</item\> returns a reference to B2:C3 resized to 3 rows and 4 columns (B2:E4).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id6668599				0	uz	\<item type=\"input\"\>=OFFSET(B2:C3;1;0;3;4)\</item\> returns a reference to B2:C3 moved down by one row resized to 3 rows and 4 columns (B2:E4).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153739	122			0	uz	\<item type=\"input\"\>=SUM(OFFSET(A1;2;2;5;6))\</item\> determines the total of the area that starts in cell C3 and has a height of 5 rows and a width of 6 columns (area=C3:H7).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3159273				0	uz	\<bookmark_value\>LOOKUP function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3159273				0	uz	LOOKUP				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153389				0	uz	\<ahelp hid=\"HID_FUNC_VERWEIS\"\>Returns the contents of a cell either from a one-row or one-column range.\</ahelp\> Optionally, the assigned value (of the same index) is returned in a different column and row. As opposed to \<link href=\"text/scalc/01/04060109.xhp\" name=\"VLOOKUP\"\>VLOOKUP\</link\> and \<link href=\"text/scalc/01/04060109.xhp\" name=\"HLOOKUP\"\>HLOOKUP\</link\>, search and result vector may be at different positions; they do not have to be adjacent. Additionally, the search vector for the LOOKUP must be sorted ascending, otherwise the search will not return any usable results.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id4484084				0	uz	If LOOKUP cannot find the search criterion, it matches the largest value in the search vector that is less than or equal to the search criterion.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3152947				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154104				0	uz	LOOKUP(SearchCriterion; SearchVector; ResultVector)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150646	127			0	uz	\<emph\>SearchCriterion\</emph\> is the value to be searched for; entered either directly or as a reference.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154854	128			0	uz	\<emph\>SearchVector\</emph\> is the single-row or single-column area to be searched.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149925	129			0	uz	\<emph\>ResultVector\</emph\> is another single-row or single-column range from which the result of the function is taken. The result is the cell of the result vector with the same index as the instance found in the search vector.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3148624				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149809	131			0	uz	\<item type=\"input\"\>=LOOKUP(A1;D1:D100;F1:F100)\</item\> searches the corresponding cell in range D1:D100 for the number you entered in A1. For the instance found, the index is determined, for example, the 12th cell in this range. Then, the contents of the 12th cell are returned as the value of the function (in the result vector).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3149425				0	uz	\<bookmark_value\>STYLE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3149425				0	uz	STYLE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150826				0	uz	\<ahelp hid=\"HID_FUNC_VORLAGE\"\>Applies a style to the cell containing the formula.\</ahelp\> After a set amount of time, another style can be applied. This function always returns the value 0, allowing you to add it to another function without changing the value. Together with the CURRENT function you can apply a color to a cell regardless of the value. For example: =...+STYLE(IF(CURRENT()>3;"red";"green")) applies the style "red" to the cell if the value is greater than 3, otherwise the style "green" is applied. Both cell formats have to be defined beforehand.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3145373				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149302				0	uz	STYLE("Style"; Time; "Style2")				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150596	137			0	uz	\<emph\>Style\</emph\> is the name of a cell style assigned to the cell. Style names must be entered in quotation marks.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3156149	138			0	uz	\<emph\>Time\</emph\> is an optional time range in seconds. If this parameter is missing the style will not be changed after a certain amount of time has passed.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149520	139			0	uz	\<emph\>Style2\</emph\> is the optional name of a cell style assigned to the cell after a certain amount of time has passed. If this parameter is missing "Default" is assumed.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3159254				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3151374	141			0	uz	\<item type=\"input\"\>=STYLE("Invisible";60;"Default")\</item\> formats the cell in transparent format for 60 seconds after the document was recalculated or loaded, then the Default format is assigned. Both cell formats have to be defined beforehand.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id8056886				0	uz	Since STYLE() has a numeric return value of zero, this return value gets appended to a string. This can be avoided using T() as in the following example 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3042085				0	uz	See also CURRENT() for another example.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3150430				0	uz	\<bookmark_value\>CHOOSE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3150430				0	uz	CHOOSE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3143270				0	uz	\<ahelp hid=\"HID_FUNC_WAHL\"\>Uses an index to return a value from a list of up to 30 values.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153533				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155425				0	uz	CHOOSE(Index; Value1; ...; Value30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3144755	146			0	uz	\<emph\>Index\</emph\> is a reference or number between 1 and 30 indicating which value is to be taken from the list.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149939	147			0	uz	\<emph\>Value1...Value30\</emph\> is the list of values entered as a reference to a cell or as individual values.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3151253				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150625	149			0	uz	\<item type=\"input\"\>=CHOOSE(A1;B1;B2;B3;"Today";"Yesterday";"Tomorrow")\</item\>, for example, returns the contents of cell B2 for A1 = 2; for A1 = 4, the function returns the text "Today".				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3151001				0	uz	\<bookmark_value\>HLOOKUP function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3151001				0	uz	HLOOKUP				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148688				0	uz	\<ahelp hid=\"HID_FUNC_WVERWEIS\"\>Searches for a value and reference to the cells below the selected area.\</ahelp\> This function verifies if the first row of an array contains a certain value. The function returns then the value in a row of the array, named in the \<emph\>Index\</emph\>, in the same column.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3154661				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3146070				0	uz	HLOOKUP(SearchCriteria; Array; Index; Sorted)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148672				0	uz	See also:\<link href=\"text/scalc/01/04060109.xhp\" name=\"VLOOKUP\"\>VLOOKUP\</link\> (columns and rows are exchanged)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3147321				0	uz	\<bookmark_value\>ROW function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3147321				0	uz	ROW				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154564				0	uz	\<ahelp hid=\"HID_FUNC_ZEILE\"\>Returns the row number of a cell reference.\</ahelp\> If the reference is a cell, it returns the row number of the cell. If the reference is a cell range, it returns the corresponding row numbers in a one-column \<link href=\"text/scalc/01/04060107.xhp#wasmatrix\" name=\"Array\"\>Array\</link\> if the formula is entered \<link href=\"text/scalc/01/04060107.xhp#somatrixformel\" name=\"as an array formula\"\>as an array formula\</link\>. If the ROW function with a range reference is not used in an array formula, only the row number of the first range cell will be returned.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3158439				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154916				0	uz	ROW(Reference)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3156336	161			0	uz	\<emph\>Reference\</emph\> is a cell, an area, or the name of an area.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3151109				0	uz	If you do not indicate a reference, the row number of the cell in which the formula is entered will be found. \<item type=\"productname\"\>%PRODUCTNAME\</item\> Calc automatically sets the reference to the current cell.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3155609				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154830	205			0	uz	\<item type=\"input\"\>=ROW(B3)\</item\> returns 3 because the reference refers to the third row in the table.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147094	206			0	uz	\<item type=\"input\"\>{=ROW(D5:D8)}\</item\> returns the single-column array (5, 6, 7, 8) because the reference specified contains rows 5 through 8.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153701	207			0	uz	\<item type=\"input\"\>=ROW(D5:D8)\</item\> returns 5 because the ROW function is not used as array formula and only the number of the first row of the reference is returned.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150996	208			0	uz	\<item type=\"input\"\>{=ROW(A1:E1)}\</item\> and \<item type=\"input\"\>=ROW(A1:E1)\</item\> both return 1 because the reference only contains row 1 as the first column in the table. (Because single-row areas only have one row number it does not make any difference whether or not the formula is used as an array formula.)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153671	209			0	uz	\<item type=\"input\"\>=ROW()\</item\> returns 3 if the formula was entered in row 3.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153790	210			0	uz	\<item type=\"input\"\>{=ROW(Rabbit)}\</item\> returns the single-column array (1, 2, 3) if "Rabbit" is the named area (C1:D3).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3145772				0	uz	\<bookmark_value\>ROWS function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3145772				0	uz	ROWS				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148971				0	uz	\<ahelp hid=\"HID_FUNC_ZEILEN\"\>Returns the number of rows in a reference or array.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3156051				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154357				0	uz	ROWS(Array)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155942	170			0	uz	\<emph\>Array\</emph\> is the reference or named area whose total number of rows is to be determined.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3155869				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154725	212			0	uz	\<item type=\"input\"\>=Rows(B5)\</item\> returns 1 because a cell only contains one row.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150102	172			0	uz	\<item type=\"input\"\>=ROWS(A10:B12)\</item\> returns 3.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155143	213			0	uz	\<item type=\"input\"\>=ROWS(Rabbit)\</item\> returns 3 if "Rabbit" is the named area (C1:D3).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id9959410				0	uz	\<bookmark_value\>HYPERLINK function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11798				0	uz	HYPERLINK				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN117F1				0	uz	\<ahelp hid=\"HID_FUNC_HYPERLINK\"\>When you click a cell that contains the HYPERLINK function, the hyperlink opens.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11800				0	uz	If you use the optional \<emph\>cell text\</emph\> parameter, the formula locates the URL, and then displays the text.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11803				0	uz	To open a hyperlinked cell with the keyboard, select the cell, press F2 to enter the Edit mode, move the cursor in front of the hyperlink, press Shift+F10, and then choose \<emph\>Open Hyperlink\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN1180A				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN1180E				0	uz	HYPERLINK("URL") or HYPERLINK("URL"; "CellText")				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11811				0	uz	\<emph\>URL\</emph\> specifies the link target. The optional \<emph\>CellText\</emph\> parameter is the text that is displayed in the cell and the result of the function. If the \<emph\>CellText\</emph\> parameter is not specified, the \<emph\>URL\</emph\> is displayed in the cell text and in the result of the function.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11823				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11827				0	uz	\<item type=\"input\"\>=HYPERLINK("http://www.example.org")\</item\> displays the text "http://www.example.org" in the cell and executes the hyperlink http://www.example.org when clicked.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN1182A				0	uz	\<item type=\"input\"\>=HYPERLINK("http://www.example.org";"Click here")\</item\> displays the text "Click here" in the cell and executes the hyperlink http://www.example.org when clicked.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN1182D				0	uz	\<item type=\"input\"\>=HYPERLINK($B4)\</item\> where cell B4 contains \<item type=\"input\"\>http://www.example.org\</item\>. The function adds http://www.example.org to the URL of the hyperlink cell and returns the same text which is used as formula result.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11830				0	uz	\<item type=\"input\"\>=HYPERLINK("http://www.";"Click ") & "example.org"\</item\> displays the text Click example.org in the cell and executes the hyperlink http://www.example.org when clicked.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id8859523				0	uz	\<item type=\"input\"\>=HYPERLINK("#Sheet1.A1";"Go to top")\</item\> displays the text Go to top and jumps to cell Sheet1.A1 in this document.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id2958769				0	uz	\<item type=\"input\"\>=HYPERLINK("file:///C:/writer.odt#Specification";"Go to Writer bookmark")\</item\> displays the text Go to Writer bookmark, loads the specified text document and jumps to bookmark "Specification".				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id7682424				0	uz	\<bookmark_value\>GETPIVOTDATA function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3747062				0	uz	GETPIVOTDATA				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id9741508				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id909451				0	uz	Two different syntax definitions can be used:				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1672109				0	uz	The second syntax is assumed if exactly two parameters are given, of which the first parameter is a cell or cell range reference. The first syntax is assumed in all other cases. The Function Wizard shows the first syntax.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id9464094				0	uz	First Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3144016				0	uz	Second Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id5616626				0	uz	\<emph\>Constraints\</emph\> is a space-separated list. Entries can be quoted (single quotes). The whole string must be enclosed in quotes (double quotes), unless you reference the string from another cell.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3168736				0	uz	A function name can be added in the form \<emph\>Field[Item;Function]\</emph\>, which will cause the constraint to match only subtotal values which use that function. The possible function names are Sum, Count, Average, Max, Min, Product, Count (Numbers only), StDev (Sample), StDevP (Population), Var (Sample), and VarP (Population), case-insensitive.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	tit				0	uz	Options				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	hd_id2794274				0	uz	Options				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	par_id6776940				0	uz	The Options dialog for the \<link href=\"text/scalc/01/solver.xhp\"\>Solver\</link\> is used to set some options.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	par_id393993				0	uz	\<ahelp hid=\".\" visibility=\"hidden\"\>Select a solver engine. The listbox is disabled if only one solver engine is installed. Solver engines can be installed as extensions.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	par_id5871761				0	uz	\<ahelp hid=\".\" visibility=\"hidden\"\>Configure the current solver.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	par_id6531266				0	uz	\<ahelp hid=\".\" visibility=\"hidden\"\>If the current entry in the Settings listbox allows to edit a value, you can click the Edit button. A dialog opens where you can change the value.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	par_id3912778				0	uz	\<ahelp hid=\".\" visibility=\"hidden\"\>Enter or change the value.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	par_id3163853				0	uz	Use the Options dialog to configure the current solver engine.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	par_id121158				0	uz	You can install more solver engines as extensions, if available. Open Tools - Extension Manager and browse to the Extensions web site to search for extensions.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	par_id3806878				0	uz	Select the solver engine to use and to configure from the listbox. The listbox is disabled if onle one solver engine is installed.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	par_id130619				0	uz	In the Settings box, check all settings that you want to use for the current goal seeking operation. If the current option offers different values, the Edit button is enabled. Click Edit to open a dialog where you can change the value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	par_id9999694				0	uz	Click OK to accept the changes and to go back to the \<link href=\"text/scalc/01/solver.xhp\"\>Solver\</link\> dialog.				2002-02-02 02:02:02
