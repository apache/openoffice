helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3159399				0	uz	\<ahelp hid=\".uno:GraphicFilterSmooth\"\>Softens or blurs the image by applying a low pass filter.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3149514				0	uz	\<image id=\"img_id3154285\" src=\"res/commandimagelist/sc_graphicfiltersmooth.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3154285\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
