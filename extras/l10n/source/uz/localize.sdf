helpcontent2	source\text\shared\01\05190000.xhp	0	help	bm_id3147366				0	uz	\<bookmark_value\>objects; naming\</bookmark_value\>\<bookmark_value\>groups;naming\</bookmark_value\>\<bookmark_value\>names;objects\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05190000.xhp	0	help	hd_id3147366				0	uz	Name				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05190000.xhp	0	help	par_id3147588				0	uz	\<variable id=\"name\"\>\<ahelp hid=\".uno:RenameObject\"\>Assigns a name to the selected object, so that you can quickly find the object in the Navigator.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05190000.xhp	0	help	par_id3155364				0	uz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\</caseinline\>\<defaultinline\>The name is also displayed in the Status Bar when you select the object.\</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05190000.xhp	0	help	hd_id3156027				0	uz	Name				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05190000.xhp	0	help	par_id3152924				0	uz	\<ahelp hid=\"HID_SD_NAMEDIALOG_OBJECT\"\>Enter a name for the selected object. The name will be visible in the Navigator.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	tit				0	uz	General				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	bm_id3149955				0	uz	\<bookmark_value\>version numbers of documents\</bookmark_value\>\<bookmark_value\>documents; version numbers\</bookmark_value\>\<bookmark_value\>files; version numbers\</bookmark_value\>\<bookmark_value\>editing time of documents\</bookmark_value\>\<bookmark_value\>documents; editing time\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3148668				0	uz	\<link href=\"text/shared/01/01100200.xhp\" name=\"General\"\>General\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3154863				0	uz	\<ahelp hid=\"HID_DOCINFODOC\"\>Contains basic information about the current file.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3149999				0	uz	File				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3153114				0	uz	\<ahelp hid=\"SFX2:EDIT:TP_DOCINFODOC:ED_FILE_NAME\"\>Displays the file name.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3156136				0	uz	Type:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3155552				0	uz	Displays the file type for the current document.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3145314				0	uz	Location:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3150506				0	uz	Displays the path and the name of the directory where the file is stored.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3155892				0	uz	Size:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3153311				0	uz	Displays the size of the current document in bytes.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3149178				0	uz	Created:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3153748				0	uz	Displays the date and time and author when the file was first saved.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3149182				0	uz	Modified:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3150355				0	uz	Displays the date and time and author when the file was last saved in a $[officename] file format.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_idN106C5				0	uz	Digitally signed:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_idN106C9				0	uz	Displays the date and the time when the file was last signed as well as the name of the author who signed the document.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_idN106CC				0	uz	Digital Signature				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_idN106D0				0	uz	Opens the \<link href=\"text/shared/01/digitalsignatures.xhp\"\>Digital Signatures\</link\> dialog where you can manage digital signatures for the current document.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3156346				0	uz	Last printed:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3152780				0	uz	Displays the date and time and user name when the file was last printed.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3149955				0	uz	Displays the number of times that the file has been saved.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3155342				0	uz	 Editing time:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3149795				0	uz	Displays the amount of time that the file has been open for editing since the file was created. The editing time is updated when you save the file.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3154810				0	uz	Apply User Data				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3154046				0	uz	Delete				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3152349				0	uz	\<ahelp hid=\"SFX2:PUSHBUTTON:TP_DOCINFODOC:BTN_DELETE\"\>Resets the editing time to zero, the creation date to the current date and time, and the version number to 1. The modification and printing dates are also deleted.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3149576				0	uz	Template:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3147530				0	uz	Displays the template that was used to create the file.				2002-02-02 02:02:02
