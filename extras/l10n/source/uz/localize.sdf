helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149169				0	uz	\<item type=\"input\"\>=CELL("Sheet";Sheet3.D2)\</item\> returns 3.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149431				0	uz	ADDRESS				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156054				0	uz	Returns the absolute address of the referenced cell.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154136				0	uz	\<item type=\"input\"\>=CELL("ADDRESS";D2)\</item\> returns $D$2.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3159198				0	uz	\<item type=\"input\"\>=CELL("ADDRESS";Sheet3.D2)\</item\> returns $Sheet3.$D$2.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150245				0	uz	\<item type=\"input\"\>=CELL("ADDRESS";'X:\\dr\\test.sxc'#$Sheet1.D2)\</item\> returns 'file:///X:/dr/test.sxc'#$Sheet1.$D$2.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3146811				0	uz	FILENAME				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151328				0	uz	Returns the file name and the sheet number of the referenced cell.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3148896				0	uz	\<item type=\"input\"\>=CELL("FILENAME";D2)\</item\> returns 'file:///X:/dr/own.sxc'#$Sheet1, if the formula in the current document X:\\dr\\own.sxc is located in Sheet1.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155144				0	uz	\<item type=\"input\"\>=CELL("FILENAME";'X:\\dr\\test.sxc'#$Sheet1.D2)\</item\> returns 'file:///X:/dr/test.sxc'#$Sheet1.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151381				0	uz	COORD				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151004				0	uz	Returns the complete cell address in Lotus(TM) notation.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3159104				0	uz	\<item type=\"input\"\>=CELL("COORD"; D2)\</item\> returns $A:$D$2.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3163720				0	uz	\<item type=\"input\"\>=CELL("COORD"; Sheet3.D2)\</item\> returns $C:$D$2.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155910				0	uz	CONTENTS				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156041				0	uz	Returns the contents of the referenced cell, without any formatting.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151069				0	uz	TYPE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155344				0	uz	Returns the type of cell contents.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3145217				0	uz	b = blank. empty cell				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155176				0	uz	l = label. Text, result of a formula as text				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3147280				0	uz	v = value. Value, result of a formula as a number				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156348				0	uz	WIDTH				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154920				0	uz	Returns the width of the referenced column. The unit is the number of zeros (0) that fit into the column in the default text and the default size.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3152355				0	uz	PREFIX				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154230				0	uz	Returns the alignment of the referenced cell.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155946				0	uz	' = align left or left-justified				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3147220				0	uz	" = align right				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149038				0	uz	^ = centered				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153129				0	uz	\\ = repeating (currently inactive)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154406				0	uz	PROTECT				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3145127				0	uz	Returns the status of the cell protection for the cell.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155794				0	uz	1 = cell is protected				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155072				0	uz	0 = cell is not protected				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156178				0	uz	FORMAT				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150220				0	uz	Returns a character string that indicates the number format.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153824				0	uz	, = number with thousands separator				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153837				0	uz	F = number without thousands separator				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150318				0	uz	C = currency format				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153168				0	uz	S = exponential representation, for example, 1.234+E56				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153515				0	uz	P = percentage				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154375				0	uz	In the above formats, the number of decimal places after the decimal separator is given as a number. Example: the number format #,##0.0 returns ,1 and the number format 00.000% returns P3				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150575				0	uz	D1 = MMM-D-YY, MM-D-YY and similar formats				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150589				0	uz	D2 = DD-MM				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151034				0	uz	D3 = MM-YY				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156371				0	uz	D4 = DD-MM-YYYY HH:MM:SS				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3157881				0	uz	D5 = MM-DD				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3157894				0	uz	D6 = HH:MM:SS AM/PM				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154068				0	uz	D7 = HH:MM AM/PM				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150286				0	uz	D8 = HH:MM:SS				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3145756				0	uz	D9 = HH:MM				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3145768				0	uz	G = All other formats				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153375				0	uz	- (Minus) at the end = negative numbers are formatted in color				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155545				0	uz	() (brackets) at the end = there is an opening bracket in the format code				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154594				0	uz	COLOR				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3152922				0	uz	Returns 1, if negative values have been formatted in color, otherwise 0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3145563				0	uz	PARENTHESES				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156072				0	uz	Returns 1 if the format code contains an opening bracket (, otherwise 0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156090				0	uz	\<emph\>Reference\</emph\> (list of options) is the position of the cell to be examined. If \<emph\>Reference\</emph\> is a range, the cell moves to the top left of the range. If \<emph\>Reference\</emph\> is missing, $[officename] Calc uses the position of the cell in which this formula is located. Microsoft Excel uses the reference of the cell in which the cursor is positioned.				2002-02-02 02:02:02
