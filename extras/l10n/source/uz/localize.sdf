helpcontent2	source\text\swriter\01\04020100.xhp	0	help	par_id3150110				0	uz	\<ahelp hid=\"SW:TRISTATEBOX:MD_EDIT_REGION:CB_PROTECT\"\>Prevents the selected section from being edited.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04020100.xhp	0	help	hd_id3145261				0	uz	Maxfiy soʻz bilan				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04020100.xhp	0	help	par_id3149555				0	uz	\<ahelp hid=\"SW_CHECKBOX_TP_INSERT_SECTION_CB_PASSWD\"\>Protects the selected section with a password. The password must have a minimum of 5 characters.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04020100.xhp	0	help	hd_id3150549				0	uz	...				2002-02-02 02:02:02
