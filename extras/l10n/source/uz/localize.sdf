helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3147548				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156205				0	uz	GCD_ADD(Number(s))				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145150				0	uz	\<emph\>Number(s)\</emph\> is a list of up to 30 numbers.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150239				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159192				0	uz	\<item type=\"input\"\>=GCD_ADD(5;15;25)\</item\> returns 5.				2002-02-02 02:02:02
