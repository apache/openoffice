helpcontent2	source\text\scalc\01\02110000.xhp	0	help	par_idN10A7B				0	uz	\<ahelp hid=\"HID_SC_SCENARIO_DELETE\"\>Deletes the selected scenario.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02110000.xhp	0	help	par_idN10A92				0	uz	Properties				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02110000.xhp	0	help	par_idN10A96				0	uz	\<ahelp hid=\"HID_SC_SCENARIO_EDIT\"\>Opens the \<link href=\"text/scalc/01/06050000.xhp\"\>Edit scenario\</link\> dialog, where you can edit the scenario properties.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02110000.xhp	0	help	hd_id3150037				0	uz	Drag Mode				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02110000.xhp	0	help	par_id3157876				0	uz	\<ahelp hid=\"HID_SC_NAVIPI_DROP\"\>Opens a submenu for selecting the drag mode. You decide which action is performed when dragging and dropping an object from the Navigator into a document. Depending on the mode you select, the icon indicates whether a hyperlink, link or a copy is created.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02110000.xhp	0	help	par_id3150656				0	uz	Drag Mode				2002-02-02 02:02:02
