helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105A9				0	uz	\<ahelp hid=\".\"\>Use escape sequences for outer joins. The syntax for this escape sequence is {oj outer-join}\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105BE				0	uz	Example:				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105C1				0	uz	select Article.* from {oj item LEFT OUTER JOIN orders ON item.no=orders.ANR}				2002-02-02 02:02:02
