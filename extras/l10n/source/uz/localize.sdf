helpcontent2	source\text\shared\guide\navpane_on.xhp	0	help	hd_id3150178				0	uz	\<variable id=\"navpane_on\"\>\<link href=\"text/shared/guide/navpane_on.xhp\" name=\"Showing Navigation Pane of the Help\"\>Showing Navigation Pane of the Help\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\navpane_on.xhp	0	help	par_id3147571				0	uz	In the Help window, you can show or hide the navigation pane as needed.				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\navpane_on.xhp	0	help	par_id3156411				0	uz	\<image id=\"img_id3153345\" src=\"sfx2/res/indexon_small.png\" width=\"5.64mm\" height=\"5.64mm\"\>\<alt id=\"alt_id3153345\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
