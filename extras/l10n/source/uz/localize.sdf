helpcontent2	source\text\scalc\01\04060182.xhp	0	help	tit				0	uz	Statistical Functions Part Two				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3154372				0	uz	\<variable id=\"fh\"\>\<link href=\"text/scalc/01/04060182.xhp\" name=\"Statistical Functions Part Two\"\>Statistical Functions Part Two\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3145388				0	uz	\<bookmark_value\>FINV function\</bookmark_value\>\<bookmark_value\>inverse F probability distribution\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3145388				0	uz	FINV				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155089				0	uz	\<ahelp hid=\"HID_FUNC_FINV\"\>Returns the inverse of the F probability distribution.\</ahelp\> The F distribution is used for F tests in order to set the relation between two differing data sets.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3153816				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153068				0	uz	FINV(Number; DegreesFreedom1; DegreesFreedom2)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146866	6			0	uz	\<emph\>Number\</emph\> is probability value for which the inverse F distribution is to be calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153914	7			0	uz	\<emph\>DegreesFreedom1\</emph\> is the number of degrees of freedom in the numerator of the F distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3148607	8			0	uz	\<emph\>DegreesFreedom2\</emph\> is the number of degrees of freedom in the denominator of the F distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3156021				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145073	10			0	uz	\<item type=\"input\"\>=FINV(0.5;5;10)\</item\> yields 0.93.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3150888				0	uz	\<bookmark_value\>FISHER function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150888				0	uz	FISHER				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155384				0	uz	\<ahelp hid=\"HID_FUNC_FISHER\"\>Returns the Fisher transformation for x and creates a function close to a normal distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3149898				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3143220				0	uz	FISHER(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3159228	16			0	uz	\<emph\>Number\</emph\> is the value to be transformed.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3154763				0	uz	Example				2002-02-02 02:02:02
