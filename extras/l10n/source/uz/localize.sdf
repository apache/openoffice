helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3153760				0	uz	\<ahelp hid=\".uno:GraphicFilterSharpen\"\>Sharpens the image by applying a high pass filter.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3153480				0	uz	\<image id=\"img_id3156023\" src=\"res/commandimagelist/sc_graphicfiltersharpen.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3156023\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
