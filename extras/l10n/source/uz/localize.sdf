helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN105A7				0	uz	\<ahelp hid=\".\"\>Enter your serial number or copy and paste the number from the online web page.\</ahelp\>				2002-02-02 02:02:02
