helpcontent2	source\text\scalc\01\05020600.xhp	0	help	par_id3154510				0	uz	\<ahelp hid=\"SC:TRISTATEBOX:RID_SCPAGE_PROTECTION:BTN_HIDE_FORMULAR\"\>Hides formulas in the selected cells.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05020600.xhp	0	help	hd_id3155602				0	uz	Print				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05020600.xhp	0	help	par_id3153836				0	uz	Defines print options for the sheet.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05020600.xhp	0	help	hd_id3155065				0	uz	Hide when printing				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05020600.xhp	0	help	par_id3155443				0	uz	\<ahelp hid=\"SC:TRISTATEBOX:RID_SCPAGE_PROTECTION:BTN_HIDE_PRINT\"\>Keeps the selected cells from being printed.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	tit				0	uz	Sheet				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	bm_id3150542				0	uz	\<bookmark_value\>pages; order when printing\</bookmark_value\>\<bookmark_value\>printing; page order\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3156329				0	uz	\<link href=\"text/scalc/01/05070500.xhp\" name=\"Sheet\"\>Sheet\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3151384				0	uz	\<ahelp hid=\"HID_SCPAGE_TABLE\"\>Specifies the elements to be included in the printout of all sheets with the current Page Style. Additionally, you can set the print order, the first page number, and the page scale.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3150542				0	uz	Print				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3125863				0	uz	Defines which elements of the spreadsheet are to be printed.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3151041				0	uz	Column and row headers				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3147228				0	uz	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_TABLE:BTN_HEADER\"\>Specifies whether you want the column and row headers to be printed.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3150439				0	uz	Toʻr				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3145750				0	uz	Comment				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3150010				0	uz	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_TABLE:BTN_NOTES\"\>Prints the notes defined in your spreadsheet.\</ahelp\> They will be printed on a separate page, along with the corresponding cell reference.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3154944				0	uz	Objects/graphics				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3149581				0	uz	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_TABLE:BTN_OBJECTS\"\>Includes all inserted objects (if printable) and graphics with the printed document.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3149377				0	uz	Charts				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3148455				0	uz	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_TABLE:BTN_CHARTS\"\>Prints the charts that have been inserted into your spreadsheet.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3153418				0	uz	Drawing Objects				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3149122				0	uz	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_TABLE:BTN_DRAWINGS\"\>Includes all drawing objects in the printed document.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3150330				0	uz	Formulas				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3153715				0	uz	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_TABLE:BTN_FORMULAS\"\>Prints the formulas contained in the cells, instead of the results.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3156385				0	uz	Zero Values				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3149258				0	uz	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_TABLE:BTN_NULLVALS\"\>Specifies that cells with a zero value are printed.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3154022				0	uz	Page Order				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3166423				0	uz	Defines the order in which data in a sheet is numbered and printed when it does not fit on one printed page.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3152580				0	uz	Top to bottom, then right				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3150205				0	uz	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCPAGE_TABLE:BTN_TOPDOWN\"\>Prints vertically from the left column to the bottom of the sheet.\</ahelp\>				2002-02-02 02:02:02
