helpcontent2	source\text\sbasic\shared\03120403.xhp	0	help	hd_id3147574				0	uz	Return value:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120403.xhp	0	help	par_id3156152				0	uz	Integer				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120403.xhp	0	help	hd_id3150984				0	uz	Parameter:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120403.xhp	0	help	par_id3153061				0	uz	\<emph\>Text1:\</emph\> Any string expression				2002-02-02 02:02:02
