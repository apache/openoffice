helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3149393				0	uz	13				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3153544				0	uz	\<item type=\"input\"\>Name\</item\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3158414				0	uz	\<item type=\"input\"\>Grade\</item\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3152820				0	uz	\<item type=\"input\"\>Age\</item\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3154866				0	uz	\<item type=\"input\"\>Distance to School\</item\>				2002-02-02 02:02:02
