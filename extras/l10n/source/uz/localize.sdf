helpcontent2	source\text\swriter\01\04020100.xhp	0	help	par_id3151373				0	uz	Tarkibida bogʻlama boʻlgan hujjatni ochganingizda, bogʻlamalarni yangilash haqidagi ogohlantirish koʻrsatiladi.				2002-02-02 02:02:02
