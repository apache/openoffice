helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155614				0	uz	\<item type=\"input\"\>=ISNUMBER(C3)\</item\> returns TRUE if the cell C3 contains the number \<item type=\"input\"\>4\</item\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154417				0	uz	\<item type=\"input\"\>=ISNUMBER(C2)\</item\> returns FALSE if the cell C2 contains the text \<item type=\"input\"\>abcdef\</item\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3153694				0	uz	\<bookmark_value\>N function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3153694				0	uz	N				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150405				0	uz	\<ahelp hid=\"HID_FUNC_N\"\>Returns the numeric value of the given parameter. Returns 0 if parameter is text, FALSE or #NA.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id9115573				0	uz	If an error occurs, other than #NA, the function returns the error value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3145774				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153883				0	uz	N(Value)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151101				0	uz	\<emph\>Value\</emph\> is the parameter to be converted into a number. N() returns the numeric value if it can. It returns the logical values TRUE and FALSE as 1 and 0 respectively. It returns text and errors as 0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3147097				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154117				0	uz	\<item type=\"input\"\>=N(123)\</item\> returns 123				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id2337717				0	uz	\<item type=\"input\"\>=N(TRUE)\</item\> returns 1				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153781				0	uz	\<item type=\"input\"\>=N(FALSE)\</item\> returns 0				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154670				0	uz	\<item type=\"input\"\>=N("abc")\</item\> returns 0				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3519089				0	uz	=N(1/0) returns #DIV/0!				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3156275				0	uz	\<bookmark_value\>NA function\</bookmark_value\>\<bookmark_value\>#N/A error;assigning to a cell\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3156275				0	uz	NA				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156161				0	uz	\<ahelp hid=\"HID_FUNC_NV\"\>Returns the error value #N/A.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3147532				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149563				0	uz	NA()				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3155128				0	uz	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154481				0	uz	\<item type=\"input\"\>=NA()\</item\> converts the contents of the cell into #N/A.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3151255				0	uz	\<bookmark_value\>TYPE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3151255				0	uz	TYPE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155900				0	uz	\<ahelp hid=\"HID_FUNC_TYP\"\>Returns the type of value.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3149992				0	uz	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3148400				0	uz	TYPE(Value)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150830				0	uz	\<emph\>Value\</emph\> is a specific value for which the data type is determined. Value 1 = number, value 2 = text, value 4 = Boolean value, value 8 = formula, value 16 = error value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3154363				0	uz	Example (see example table above)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153357				0	uz	\<item type=\"input\"\>=TYPE(C2)\</item\> returns 2 as a result.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3148980				0	uz	\<item type=\"input\"\>=TYPE(D9)\</item\> returns 1 as a result.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3155509				0	uz	\<bookmark_value\>CELL function\</bookmark_value\>\<bookmark_value\>cell information\</bookmark_value\>\<bookmark_value\>information on cells\</bookmark_value\>				2002-02-02 02:02:02
