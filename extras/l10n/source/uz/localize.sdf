helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3145345				0	uz	\<ahelp hid=\".uno:GraphicFilterInvert\"\>Inverts the color values of a color image, or the brightness values of a grayscale image. Apply the filter again to revert the effect.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3153681				0	uz	\<image id=\"img_id3145313\" src=\"res/commandimagelist/sc_graphicfilterinvert.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3145313\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
