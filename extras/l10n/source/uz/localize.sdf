helpcontent2	source\text\shared\01\06050600.xhp	0	help	par_id1015655				0	uz	\<ahelp hid=\".\"\>Enter the distance from the left page margin at which the numbering symbol will be aligned.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06050600.xhp	0	help	hd_id2336191				0	uz	Indent at				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06050600.xhp	0	help	par_id6081728				0	uz	\<ahelp hid=\".\"\>Enter the distance from the left page margin to the start of all lines in the numbered paragraph that follow the first line.\</ahelp\>				2002-02-02 02:02:02
