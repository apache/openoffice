helpcontent2	source\text\shared\02\24010000.xhp	0	help	hd_id3144760				0	uz	Solarization				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3159150				0	uz	\<ahelp hid=\".uno:GraphicFilterSolarize\"\>Opens a dialog for defining solarization. Solarization refers to an effect that looks like what can happen when there is too much light during photo development. The colors become partly inverted.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3148453				0	uz	\<image id=\"img_id3154329\" src=\"res/commandimagelist/sc_graphicfiltersolarize.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3154329\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3150439				0	uz	Solarization				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	hd_id3145785				0	uz	Parameters				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3147352				0	uz	Specifies the degree and type of solarization.				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	hd_id3153370				0	uz	Threshold Value				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3083443				0	uz	\<ahelp hid=\"SVX_METRICFIELD_RID_SVX_GRFFILTER_DLG_SOLARIZE_DLG_FILTERSOLARIZE_MTR_THRESHOLD\"\>Specifies the degree of brightness, in percent, above which the pixels are to be solarized.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	hd_id3152596				0	uz	Invert				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3146921				0	uz	\<ahelp hid=\"SVX_CHECKBOX_RID_SVX_GRFFILTER_DLG_SOLARIZE_DLG_FILTERSOLARIZE_CBX_INVERT\"\>Specifies to also invert all pixels.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	hd_id3150875				0	uz	Aging				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3163712				0	uz	\<ahelp hid=\".uno:GraphicFilterSepia\"\>All pixels are set to their gray values, and then the green and blue color channels are reduced by the amount you specify. The red color channel is not changed.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3153139				0	uz	\<image id=\"img_id3159196\" src=\"res/commandimagelist/sc_graphicfiltersepia.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3159196\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3145365				0	uz	Aging				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	hd_id3156443				0	uz	Aging Degree				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3155411				0	uz	\<ahelp hid=\"SVX_METRICFIELD_RID_SVX_GRFFILTER_DLG_SEPIA_DLG_FILTERSEPIA_MTR_SEPIA\"\>Defines the intensity of aging, in percent. At 0% you see the gray values of all pixels. At 100% only the red color channel remains.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	hd_id3146119				0	uz	Posterize				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3147396				0	uz	\<ahelp hid=\".uno:GraphicFilterPoster\"\>Opens a dialog to determine the number of poster colors.\</ahelp\> This effect is based on the reduction of the number of colors. It makes photos look like paintings.				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3155851				0	uz	\<image id=\"img_id3150658\" src=\"res/commandimagelist/sc_graphicfilterposter.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3150658\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
