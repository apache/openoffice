helpcontent2	source\text\swriter\01\mm_cusaddlis.xhp	0	help	par_idN10540				0	ko	\<link href=\"text/swriter/01/mm_newaddlis.xhp\"\>편지 병합\</link\> 문서의 주소록을 사용자 정의합니다.				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_cusaddlis.xhp	0	help	par_idN10551				0	ko	주소록 필드				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_cusaddlis.xhp	0	help	par_idN10555				0	ko	\<ahelp hid=\".\"\>이동, 삭제 또는 이름을 바꿀 필드를 선택합니다.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_cusaddlis.xhp	0	help	par_idN10560				0	ko	추가				20200411 15:09:53
