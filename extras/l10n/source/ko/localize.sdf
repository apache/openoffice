helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3149582				0	ko	dAlpha = InputBox$ ("Enter the Alpha angle (in degrees): ","Alpha")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3154016				0	ko	Print "the length of the side adjacent the angle is"; (d1 / tan (dAlpha * Pi / 180))				20200411 15:09:53
