helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3147427				0	ko	if Mid(sText,iRun,1 )<> " " then Mid( sText ,iRun, 1, Chr( 1 + Asc( Mid(sText,iRun,1 )) )				20200411 15:09:53
