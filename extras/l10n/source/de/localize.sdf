helpcontent2	source\text\shared\01\02210101.xhp	0	help	hd_id3155628	16			0	de	Aus				20130618 17:22:18
helpcontent2	source\text\shared\01\02210101.xhp	0	help	par_id3150669	17			0	de	\<ahelp hid=\"SFX2:RADIOBUTTON:TP_FRAMEPROPERTIES:RB_SCROLLINGOFF\"\>Verbirgt die Bildlaufleiste des schwebenden Rahmens.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\01\02210101.xhp	0	help	hd_id3150503	18			0	de	Automatisch				20130618 17:22:18
helpcontent2	source\text\shared\01\02210101.xhp	0	help	par_id3152909	19			0	de	\<ahelp hid=\"SFX2:RADIOBUTTON:TP_FRAMEPROPERTIES:RB_SCROLLINGAUTO\"\>Wählen Sie diese Option, wenn der aktuelle schwebende Rahmen nach Bedarf automatisch eine Bildlaufleiste erhalten soll.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\01\02210101.xhp	0	help	hd_id3156156	20			0	de	Rahmen				20130618 17:22:18
helpcontent2	source\text\shared\01\02210101.xhp	0	help	par_id3150943	21			0	de	Blendet die Umrandung des schwebenden Rahmens ein oder aus.				20130618 17:22:18
helpcontent2	source\text\shared\01\02210101.xhp	0	help	hd_id3146774	22			0	de	Ein				20130618 17:22:18
helpcontent2	source\text\shared\01\02210101.xhp	0	help	par_id3159147	23			0	de	\<ahelp hid=\"SFX2:RADIOBUTTON:TP_FRAMEPROPERTIES:RB_FRMBORDER_ON\"\>Blendet die Umrandung des schwebenden Rahmens ein.\</ahelp\>				20130618 17:22:18
