helpcontent2	source\text\schart\01\wiz_chart_elements.xhp	0	help	par_id6070436				0	de	Datenbeschriftung				20130618 17:22:18
helpcontent2	source\text\schart\01\wiz_chart_elements.xhp	0	help	par_id7564012				0	de	Statistische Angaben, wie zum Beispiel Mittelwerte, Y-Fehlerbalken und Trendlinien				20130618 17:22:18
