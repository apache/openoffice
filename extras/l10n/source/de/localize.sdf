helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152651	642			0	de	POTENZREIHE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152688	643			0	de	\<ahelp hid=\".\"\>Summiert die ersten Glieder einer Potenzreihe.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152708	644			0	de	POTENZREIHE(X;N;M;Koeffizienten) = Koeffizient_1*X^N + Koeffizient_2*X^(N+M) + Koeffizient_3*X^(N+2M) +...+ Koeffizient_i*X^(N+(i-1)M)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152724	645			0	de	Syntax				20130618 17:22:18
