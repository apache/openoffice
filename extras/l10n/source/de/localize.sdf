helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3154330	48			0	de	\<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>setenv STAR_SPOOL_DIR /usr/local/tmp (in der csh/tcsh) oder\</caseinline\>\</switchinline\>				20130618 17:22:18
