helpcontent2	source\text\shared\explorer\database\02010100.xhp	0	help	par_id3151265	236			0	de	=1 liefert alle Datensätze, bei denen das Ja/Nein-Feld den Zustand "Ja" oder "an" hat (schwarze Markierung).				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\02010100.xhp	0	help	par_id3152450	238			0	de	Nein				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\02010100.xhp	0	help	par_id3150997	239			0	de	0				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\02010100.xhp	0	help	par_id3155331	240			0	de	=0 liefert alle Datensätze, bei denen das Ja/Nein-Feld den Zustand "Nein" oder "aus" hat (keine Markierung).				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\02010100.xhp	0	help	par_id3154179	241			0	de	Leer				20130618 17:22:18
