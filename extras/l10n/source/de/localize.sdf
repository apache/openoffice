helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155622	234			0	de	\<item type=\"input\"\>=DEZIMAL("FACE";16)\</item\> ergibt 64206.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151015	235			0	de	\<item type=\"input\"\>=DEZIMAL("0101";2)\</item\> ergibt 5.				20130618 17:22:18
