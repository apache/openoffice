helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163297				0	sl	\<ahelp hid=\"HID_FUNC_AUFRUNDEN\"\>Zaokroži številko navzgor, stran od nič, na določeno natančnost.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163315				0	sl	Skladnja				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163328				0	sl	ROUNDUP(število; števec)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163342				0	sl	Vrne \<emph\>število\</emph\>, zaokroženo navzgor (stran od nič) na \<emph\>števec\</emph\> decimalnih mest. Če števec izpustite ali ima vrednost nič, funkcija zaokroži na celoštevilčno vrednost. Če je števec negativno število, funkcija zaokroži navzdol na naslednje 10, 100, 1000 itn.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9573961				0	sl	Ta funkcija zaokroži stran od nič. Poglejte si tudi ROUNDDOWN in ROUND.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163381				0	sl	Primer				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144786				0	sl	\<item type=\"input\"\>=ROUNDUP(1,1111;2)\</item\> vrne 1,12.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7700430				0	sl	\<item type=\"input\"\>=ROUNDUP(1,2345;1)\</item\> vrne 1,3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1180455				0	sl	\<item type=\"input\"\>=ROUNDUP(45,67;0)\</item\> vrne 46.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3405560				0	sl	\<item type=\"input\"\>=ROUNDUP(-45,67)\</item\> vrne -46.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3409527				0	sl	\<item type=\"input\"\>=ROUNDUP(987,65;-2)\</item\> vrne 1000.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144877				0	sl	\<bookmark_value\>funkcija SIN\</bookmark_value\>				20200411 15:09:53
