helpcontent2	source\text\swriter\01\04090003.xhp	0	help	par_id3147455	65			0	sl	To pogovorno okno se prikaže, ko v dokumentu kliknete na polje\<emph\>Vhodni seznam\</emph\>. 				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090003.xhp	0	help	par_id3149837				0	sl	\<ahelp hid=\"SW_LISTBOX_DLG_FLD_DROPDOWN_LB_LISTITEMS\"\>Izberite element, ki ga želite prikazati v dokumentu, in nato kliknite \<emph\>V redu\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090003.xhp	0	help	hd_id3147602				0	sl	Uredi				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090003.xhp	0	help	par_id3148855				0	sl	\<ahelp hid=\"SW_PUSHBUTTON_DLG_FLD_DROPDOWN_PB_EDIT\"\>Prikaže pogovorno okno \<emph\>Uredi Polja: Funkcije\</emph\>, kjer lahko urejate \<emph\>Vhodni seznam\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090003.xhp	0	help	hd_id3155558				0	sl	Naslednji				20200411 15:09:53
