helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_id4490188				0	sl	\<ahelp hid=\".\"\>Izberite za izvoz v datoteko PDF, ki pokaže paleto zaznamkov in vsebino strani.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	hd_id3581041				0	sl	Sličice strani in strani				20200411 15:09:53
