helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148910				0	sl	\<emph\>NPer\</emph\> je celotno število obdobij, v katerih so opravljena plačila (plačilno obdobje).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148925				0	sl	\<emph\>Pmt\</emph\> je konstantno plačilo (redno plačilo), plačano v vsakem obdobju.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149160				0	sl	\<emph\>PV\</emph\> je trenutna gotovinska vrednost zaporednih plačil.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3166456				0	sl	\<emph\>FV\</emph\> (neobvezno) je prihodnja vrednost, dosežena ob koncu periodičnih plačil.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153243				0	sl	\<emph\>Vrsta\</emph\> (neobvezno) je datum zapadlosti plačila po obdobjih, na začetku ali na koncu obdobja.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3146949				0	sl	\<emph\>Ocena\</emph\>  (neobvezno) določa ocenjeno vrednost obresti s ponavljalnim izračunom.				20200411 15:09:53
