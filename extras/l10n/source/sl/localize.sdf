helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id5154576				0	sl	Standardna napaka: Prikaže standardno napako.				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id3157979				0	sl	\<ahelp hid=\".\"\>Varianca: Prikaže varianco, izračunano iz števila podatkovnih točk in njihovih vrednosti.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id3153249				0	sl	\<ahelp hid=\".\"\>Standardni odklon: Prikaže standardni odklon (kvadratni koren variance).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id3149870				0	sl	\<ahelp hid=\".\"\>Toleranca napake: Prikaže najvišjo toleranco napake v odstotkih glede na najvišjo vrednost skupine podatkov. Odstotke nastavite v območju Parametri.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	hd_id350962				0	sl	Obseg celic				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id6679586				0	sl	\<ahelp hid=\".\"\>Kliknite Obseg celic, nato določite obseg celic, od koder naj bodo vzete pozitivne in negativne vrednosti stolpca napake.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id3872188				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>S klikom gumba skrčite pogovorno okno, nato uporabite miško in z njo izberite obseg celic v preglednici. Znova kliknite gumb, pogovorno okno se prikaže v polni velikosti.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	hd_id2633747				0	sl	Iz podatkovne tabele				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id6633503				0	sl	\<ahelp hid=\".\"\>Za grafikon z lastnimi podatki lahko vrednosti stolpca napake vnesete v podatkovno tabelo grafikona. Pogovorno okno Podatkovna tabela prikazuje dodatne stolpce z naslovi Pozitivni stolpci napake Y in Negativni stolpci napake Y.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id0428200810573839				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Vnesite vrednost za prištevanje prikazani vrednosti kot pozitivne vrednosti napake.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id0428200810573862				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Vnesite vrednost za odštevanje od prikazane vrednosti kot negativne vrednosti napake.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id0428200810573844				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Vnesite obseg naslovov, iz katerih želite pridobiti pozitivne vrednosti napake. Uporabite gumb Skrči za izbor obsega iz delovnega lista.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id0428200810573970				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Vnesite obseg naslovov, iz katerih želite pridobiti negativne vrednosti napake. Uporabite gumb Skrči za izbor obsega iz delovnega lista.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	hd_id0428200810573977				0	sl	Enaka vrednost za oba				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id0428200810573991				0	sl	\<ahelp hid=\".\"\>Omogočite za rabo pozitivnih vrednosti napake tudi kot negativnih vrednosti napake. Spremenite lahko le vrednosti polja "Pozitivno (+)". Ta vrednost se samodejno kopira v polje "Negativno (-)".\</ahelp\>				20200411 15:09:53
