helpcontent2	source\text\swriter\01\04090006.xhp	0	help	par_idN107FF				0	sl	Tiskanje tipskega pisma				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090006.xhp	0	help	par_idN10803				0	sl	\<ahelp hid=\".\"\>Ko želite natisniti dokument, ki vsebuje polja zbirke podatkov, vas pogovorno okno vpraša, če želite natisniti tipsko pismo. Odgovorite Da, odpre se pogovorno okno \<link href=\"text/swriter/01/01150000.xhp\"\>Spajanje dokumentov\</link\>, kjer izberete zapise zbirke podatkov za natis.\</ahelp\>				20200411 15:09:53
