helpcontent2	source\text\swriter\01\04090004.xhp	0	help	par_id3149956				0	sl	V vrste polj "Ustvarjeno", "Spremenjeno" in "Zadnjič natisnjeno" lahko vključite avtorja, datum in čas ustrezne operacije.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090004.xhp	0	help	par_id0902200804290382				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Kliknite obliko, ki jo želite uporabiti za izbrano polje ali pa kliknite "Dodatne oblike" za določitev oblike po meri.\</ahelp\>				20200411 15:09:53
