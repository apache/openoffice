helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3149771				0	sl	_parent				20200411 15:09:53
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3159143				0	sl	Naslednji dokument bo ustvarjen v matičnem okvirju. Če matični okvir ne obstaja, bo dokument ustvarjen v istem okvirju.				20200411 15:09:53
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3151374				0	sl	_self				20200411 15:09:53
