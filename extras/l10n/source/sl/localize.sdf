helpcontent2	source\text\swriter\01\06030000.xhp	0	help	hd_id3154195				0	sl	Leva/desna puščica				20200411 15:09:53
helpcontent2	source\text\swriter\01\06030000.xhp	0	help	par_id3155174				0	sl	\<ahelp hid=\"SVX:IMAGEBUTTON:RID_SVXDLG_HYPHENATE:BTN_RIGHT\"\>Nastavite položaj vezaja. Ta možnost je na voljo samo, če je prikazanih več predlogov za deljenje.\</ahelp\>				20200411 15:09:53
