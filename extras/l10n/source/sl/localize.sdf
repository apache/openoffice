helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149277				0	sl	\<emph\>Mera\</emph\> je obrestna mera za vsako obdobje.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149270				0	sl	\<emph\>NPer\</emph\> je skupno število plačilnih obdobij. Mera in NPer se morata nanašati na isto enoto in se tako morata izračunati letno ali mesečno.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3152967				0	sl	\<emph\>PV\</emph\> je trenutna vrednost.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156308				0	sl	\<emph\>Začetno_obdobje\</emph\> je prvo plačilno obdobje za izračun.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149453				0	sl	\<emph\>Končno_obdobje\</emph\> je zadnje plačilno obdobje za izračun.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150962				0	sl	\<emph\>Vrsta\</emph\> je zapadlost plačila na koncu vsakega obdobja (vrsta = 0) ali na začetku obdobja (vrsta = 1).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3152933				0	sl	Primer				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156324				0	sl	Za hišo najamemo naslednjo hipoteko:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147566				0	sl	Mera: 9,00 odstotka na leto (9% / 12 = 0,0075), trajanje: 30 let (NPer = 30 * 12 = 360), Pv: 125000 denarnih enot.				20200411 15:09:53
