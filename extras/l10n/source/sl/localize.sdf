helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150026				0	sl	PPMT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146942				0	sl	\<ahelp hid=\"HID_FUNC_KAPZ\"\>Vrne plačilo na glavnico za določeno obdobje za naložbo, ki temelji na rednih plačilih po obdobjih in konstantni obrestni meri.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150459				0	sl	Skladnja				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146878				0	sl	PPMT(mera; obdobje; NPer; PV; FV; vrsta)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151228				0	sl	\<emph\>Mera\</emph\> je periodična obrestna mera.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148887				0	sl	\<emph\>Obdobje\</emph\> je obdobje odplačevanja. P=1 za prvo in P=NPer za zadnjo obdobje.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148436				0	sl	\<emph\>NPer\</emph\> je skupno število obdobij, v katerih se plačujejo redna plačila.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153035				0	sl	\<emph\>PV\</emph\> je trenutna gotovinska vrednost zaporednih plačil.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147474				0	sl	\<emph\>FV\</emph\> (neobvezno) je želena (prihodnja) vrednost.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3144744				0	sl	\<emph\>Vrsta\</emph\> (neobvezno) določa datum zapadlosti. F=1 za plačilo na začetku in F=0 za plačilo na koncu obdobja.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_idN1067C				0	sl	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3148582				0	sl	Primer				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154811				0	sl	Kako visoko je mesečno plačilo po obdobjih pri letni obrestni meri 8,75% v obdobju treh let? Gotovinska vrednost je 5,000 denarnih enot in je vedno plačana na začetku obdobja. Prihodnja vrednost je 8,000 denarnih enot.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149246				0	sl	\<item type=\"input\"\>=PPMT(8,75%/12;1;36;5000;8000;1)\</item\> = -350,99 denarnih enot.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3146139				0	sl	\<bookmark_value\>računanje; skupne mere odplačevanja\</bookmark_value\>\<bookmark_value\>skupne mere odplačevanja\</bookmark_value\>\<bookmark_value\>odplačilo amortizacije\</bookmark_value\>\<bookmark_value\>odplačilo obroka\</bookmark_value\>\<bookmark_value\>funkcija CUMPRINC\</bookmark_value\>"				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3146139				0	sl	CUMPRINC				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150140				0	sl	\<ahelp hid=\"HID_FUNC_KUMKAPITAL\"\>Vrne kumulativne obresti za naložbeno obdobje s konstantno obrestno mero.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149188				0	sl	Skladnja				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148733				0	sl	CUMPRINC(mera; NPer; PV; S; E; vrsta)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150864				0	sl	\<emph\>Mera\</emph\> je periodična obrestna mera.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3166052				0	sl	\<emph\>NPer\</emph\> je plačilno obdobje s skupnim številom obdobij. NPer je lahko tudi vrednost, ki ni celo število.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150007				0	sl	\<emph\>PV\</emph\> je trenutna gotovinska vrednost zaporednih plačil.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153112				0	sl	\<emph\>S\</emph\> je prvo obdobje.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146847				0	sl	\<emph\>E\</emph\> je zadnje obdobje (perioda).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145167				0	sl	\<emph\>Vrsta\</emph\> je datum zapadlosti plačila na začetku ali na koncu vsakega obdobja.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154502				0	sl	Primer				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153570				0	sl	Kako visoko je izplačilo, če je letna obrestna mera 5,5% za 36 mescev? Gotovinska vrednost je 15.000 denarnih enot. Višina izplačila se izračuna med 10. in 18. obdobjem. Datum zapadlosti je na koncu obdobja.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149884				0	sl	\<item type=\"input\"\>=CUMPRINC(5,5%/12;36;15000;10;18;0)\</item\> = -3669,74 denarnih enot. Višina izplačila med 10. in 18. obdobjem je 3669,74 denarnih enot.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3150019				0	sl	\<bookmark_value\>funkcija CUMPRINC_ADD\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150019				0	sl	CUMPRINC_ADD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145246				0	sl	\<ahelp hid=\"HID_AAI_FUNC_CUMPRINC\"\> Izračuna kumulativni odkup za posojilo v nekem obdobju.\</ahelp\>				20200411 15:09:53
