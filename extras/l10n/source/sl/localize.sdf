helpcontent2	source\text\schart\01\04050000.xhp	0	help	hd_id3159204				0	sl	Odstotek				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id3150048				0	sl	\<ahelp hid=\"SCH:METRICFIELD:TP_STAT:MTR_FLD_PERCENT\"\>Prikaže odstotke. Prikaz se nanaša na odgovarjajočo podatkovno točko. Odstotke nastavite v območju Parametri.\</ahelp\>				20200411 15:09:53
