helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3150482				0	sl	Če ne vnesete vrednosti, bo vstavljen trenutni čas.				20200411 15:09:53
helpcontent2	source\text\shared\02\01170101.xhp	0	help	hd_id1727347				0	sl	Privzeti datum				20200411 15:09:53
