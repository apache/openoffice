helpcontent2	source\text\swriter\guide\wrap.xhp	0	help	par_id3155859				0	sl	Trenutni slog oblivanja je označen s kljukico.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\wrap.xhp	0	help	hd_id3149834				0	sl	Določanje lastnosti oblivanja				20200411 15:09:53
