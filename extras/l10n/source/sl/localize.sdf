helpcontent2	source\text\simpress\01\06060000.xhp	0	help	par_idN107A9				0	sl	Drugi stolpec prikaže zaporedno številko izvajanja animacije.				20200411 15:09:53
helpcontent2	source\text\simpress\01\06060000.xhp	0	help	par_idN107AD				0	sl	Tretji stolpec prikaže ikono miške, če se animacija zažene s klikom miške, ali ure, če se animacija začne po koncu predhodne animacije.				20200411 15:09:53
helpcontent2	source\text\simpress\01\06060000.xhp	0	help	par_idN107B1				0	sl	V četrtem stolpcu ikona prikazuje učinek animacije.				20200411 15:09:53
helpcontent2	source\text\simpress\01\06060000.xhp	0	help	par_idN107B5				0	sl	Peti stolpec pokaže ime oblike za ta učinek animacije in po možnosti tudi prve znake animiranega besedila.				20200411 15:09:53
