helpcontent2	source\text\shared\00\00000200.xhp	0	help	par_id10				0	sl	Datotekam JPEG lahko določite barvno globino in kakovost.				20200411 15:09:53
helpcontent2	source\text\shared\00\00000200.xhp	0	help	par_id435923952				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Izberite barvno globino od 8-bitne s sivinami do 24-bitne z realističnimi barvami.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000200.xhp	0	help	par_id355152952				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Nastavi stiskanje in kakovost izvoza. Izbirajte od nizke kakovosti z najmanjšo datoteko do visoke kakovosti z največjo datoteko. Visoko stiskanje pomeni nizko kakovost, nizko stiskanje pomeni visoko kakovost.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000200.xhp	0	help	par_id11				0	sl	Datotekam BMP lahko določite stiskanje in kodiranje RLE.				20200411 15:09:53
helpcontent2	source\text\shared\00\00000200.xhp	0	help	par_id312346798				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Uporabi kodiranje RLE (Run Length Encoding) pri slikah BMP.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000200.xhp	0	help	par_id12				0	sl	Datotekam PBM, PGM in PPM lahko določite kodiranje.				20200411 15:09:53
helpcontent2	source\text\shared\00\00000200.xhp	0	help	par_id344441				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Izvozi datoteko v dvojiško obliko. Izhodna datoteka je manjša kot besedilna datoteka (ASCII).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000200.xhp	0	help	par_id3555783				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Izvozi datoteko v besedilno obliko ASCII. Izhodna datoteka je večja kot v dvojiški obliki.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000200.xhp	0	help	par_id13				0	sl	Datotekam PNG lahko določite stiskanje in prepleteni način.				20200411 15:09:53
helpcontent2	source\text\shared\00\00000200.xhp	0	help	par_id35674840				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Določa, ali naj bo grafika shranjena v prepletenem načinu.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000200.xhp	0	help	par_id14				0	sl	Datotekam GIF lahko določite prosojnost in prepleteni način.				20200411 15:09:53
helpcontent2	source\text\shared\00\00000200.xhp	0	help	par_id31456456938				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Določa, ali naj bo ozadje slike shranjeno kot prosojno. Na sliki GIF bodo vidni le predmeti. Za nastavitev prosojne barve v sliki uporabite Menjalnico barv.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000200.xhp	0	help	par_id15				0	sl	Datotekam EPS lahko določite predogled, vrsto barv, stiskanje in različico zapisa.				20200411 15:09:53
helpcontent2	source\text\shared\00\00000200.xhp	0	help	par_id3147779948				0	sl	\<switchinline select=\"sys\"\>\<caseinline select=\"WIN\"\>Datoteko EPS morate natisniti s tiskalnikom, ki podpira PostScript. Drugi tiskalniki bodo natisnili le vdelani predogled.\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000200.xhp	0	help	par_id993155271				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Določa, ali naj se skupaj z dejansko datoteko PostScript izvozi tudi predogledna slika v zapisu TIFF.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000200.xhp	0	help	par_id993144740				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Določa, ali naj se skupaj z datoteko PostScript izvozi tudi monokromatski predogled v zapisu EPSI. Ta oblika vsebuje le natisljive znake iz 7-bitnega nabora znakov ASCII.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000200.xhp	0	help	par_id993150935				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Na tej ravni stiskanje ni na voljo. Izberite možnost Raven 1, če vaš tiskalnik PostScript ne ponuja možnosti Ravni 2.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000200.xhp	0	help	par_id993159201				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Izberite možnost Raven 2, če vaša izhodna naprava podpira barvne bitne slike, paletne slike in stiskanje slik.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000200.xhp	0	help	par_id319947250				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Izvozi datoteko v barvah.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000200.xhp	0	help	par_id993147088				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Izvozi datoteko v sivinskih odtenkih.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000200.xhp	0	help	par_id399153683				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Stiskanje LZW je stiskanje datoteke v manjšo z uporabo algoritma tabelaričnega sklicevanja.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000200.xhp	0	help	par_id319952780				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Določa, da ne želite uporabiti stiskanja.\</ahelp\>				20200411 15:09:53
