helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3157970				0	sl	CUMPRINC_ADD(mera; NPer; PV; začetno_obdobje; končno_obdobje; vrsta)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145302				0	sl	\<emph\>Mera\</emph\> je obrestna mera za vsako obdobje.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151017				0	sl	\<emph\>NPer\</emph\> je skupno število plačilnih obdobij. Mera in NPer se morata nanašati na isto enoto in se tako morata izračunati letno ali mesečno.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155620				0	sl	\<emph\>PV\</emph\> je trenutna vrednost.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145352				0	sl	\<emph\>Začetno_obdobje\</emph\> je prvo plačilno obdobje za izračun.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3157986				0	sl	\<emph\>Končno_obdobje\</emph\> je zadnje plačilno obdobje za izračun.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150570				0	sl	\<emph\>Vrsta\</emph\> je zapadlost plačila na koncu vsakega obdobja (vrsta = 0) ali na začetku obdobja (vrsta = 1).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150269				0	sl	Primer				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148774				0	sl	Za hišo najamemo naslednjo hipoteko:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150661				0	sl	Mera: 9,00 odstotka na leto (9% / 12 = 0,0075), trajanje: 30 let (plačilna obdobja = 30 * 12 = 360), NPV: 125000 denarnih enot.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155512				0	sl	Koliko povrnete v drugem letu hipoteke (torej od 13. do 24. obdobja)?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149394				0	sl	\<item type=\"input\"\>=CUMPRINC_ADD(0,0075;360;125000;13;24;0)\</item\> vrne -934,1071				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149026				0	sl	V prvem mescu odplačate naslednjo količino:				20200411 15:09:53
