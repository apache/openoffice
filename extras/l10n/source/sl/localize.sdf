helpcontent2	source\text\schart\01\04070000.xhp	0	help	par_id3146974				0	sl	\<variable id=\"gitter\"\>\<ahelp hid=\".\"\>Osi lahko razdelite na odseke tako, da jim dodelite mrežne črte. To omogoča boljši pregled nad grafikonom, še posebej, če delate z večjimi grafikoni.\</ahelp\>\</variable\> Glavna mreža osi Y je privzeto omogočena.				20200411 15:09:53
helpcontent2	source\text\schart\01\04070000.xhp	0	help	hd_id3156286				0	sl	Glavne mreže				20200411 15:09:53
helpcontent2	source\text\schart\01\04070000.xhp	0	help	par_id3154511				0	sl	Določa os, ki naj bo nastavljena kot glavna mreža.				20200411 15:09:53
