helpcontent2	source\text\scalc\01\12070100.xhp	0	help	hd_id3153191				0	sl	Možnosti				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	hd_id3159154				0	sl	Poveži z izvornimi podatki				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	par_id3146986				0	sl	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_CONSOLIDATE:BTN_REFS\" visibility=\"visible\"\>Podakte v obsegu uskladitve poveže z izvornimi podatki in samodejno posodobi rezultate uskladitve, ko se izvorni podatki spremenijo.\</ahelp\>				20200411 15:09:53
