helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id9887081				0	sl	\<ahelp hid=\".\"\>Vnesite URL datoteke, ki jo želite odpreti s klikom hiperpovezave. Če ne navedete ciljnega okvira, se datoteka odpre v trenutnem dokumentu ali okviru.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	hd_id3155628				0	sl	Spletni brskalnik				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id3153760				0	sl	\<ahelp hid=\"SVX:IMAGEBUTTON:RID_SVXPAGE_HYPERLINK_INTERNET:BTN_BROWSE\"\>Odpre spletni brskalnik, v katerega lahko naložite želeni URL.\</ahelp\> URL lahko nato kopirate in prilepite v polje \<emph\>Cilj\</emph\>.				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	hd_id3155421				0	sl	Cilj v dokumentu				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id3147618				0	sl	\<ahelp hid=\"SVX:IMAGEBUTTON:RID_SVXPAGE_HYPERLINK_INTERNET:BTN_TARGET\"\>Odpre pogovorno okno \<emph\>Cilj v dokumentu\</emph\>.\</ahelp\> Tam lahko izberete cilj znotraj dokumenta in ga dodate ciljnemu URL-ju z gumbom \<emph\>Vstavi\</emph\>.				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id3147335				0	sl	\<ahelp hid=\"HID_HYPERLINK_MARKWND_TREE\" visibility=\"hidden\"\>Določi položaj v ciljnem dokumentu, kamor želite skočiti.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id3149164				0	sl	\<ahelp hid=\"HID_HYPERLINK_MARKWND_APPLY\" visibility=\"hidden\"\>Vstavi cilj v polje \<emph\>Cilj\</emph\> pogovornega okna \<emph\>Hiperpovezava\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id3155388				0	sl	\<ahelp hid=\"HID_HYPERLINK_MARKWND_CLOSE\" visibility=\"hidden\"\>Ko je hiperpovezava v celoti vnesena, kliknite \<emph\>Zapri\</emph\>, da se nastavi povezava in zapre pogovorno okno.\</ahelp\>				20200411 15:09:53
