helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3153134				0	sl	Vstavi številko strani, ki vsebuje cilj sklica.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3150681				0	sl	Sklic				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3154040				0	sl	Vstavi popolno ciljno besedilo sklica. Pri sprotnih opombah vstavi številko sprotne opombe.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3149972				0	sl	Zgoraj/spodaj				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3149619				0	sl	Vstavi "nad" ali "pod", odvisno od mesta referenčnega cilja glede na položaj referenčnega polja.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3148705				0	sl	Kot slog strani				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3148728				0	sl	Vstavi številko strani, ki vsebuje cilj sklica ter z obliko, določeno v slogu strani.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id5699942				0	sl	Številka				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id6420484				0	sl	Vstavi številko naslova ali oštevilčenega odstavka, vključno z višjimi ravnmi, odvisno od konteksta. Za več podrobnosti si oglejte opombo pod to tabelo.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id6986602				0	sl	Številka (brez konteksta)				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id616779				0	sl	Vstavi le številko naslova ali oštevilčenega odstavka.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id791039				0	sl	Številka (polni kontekst)				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id1953489				0	sl	Vstavi številko naslova ali oštevilčenega odstavka, vključno z vsemi višjimi ravnmi.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3154635				0	sl	Poglavje				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3149646				0	sl	Vstavi številko poglavja, ki vsebuje cilj sklica.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3155553				0	sl	Kategorija in številka				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3155356				0	sl	Vstavi kategorijo (vrsta napisa) in številko cilja sklica. Ta možnost je na voljo, če je cilj sklica predmet z napisom.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3154224				0	sl	Besedilo napisa				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3145105				0	sl	Vstavi oznako napisa cilja sklica. Ta možnost je na voljo, če je cilj sklica predmet z napisom.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3149587				0	sl	Oštevilčevanje				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3146883				0	sl	Vstavi številko napisa cilj sklica. Ta možnost je na voljo, če je cilj sklica predmet z napisom.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id757469				0	sl	Oblika "Številka" vstavi številko naslova ali oštevilčenega odstavka. Višje ravni so po potrebi vključene glede na kontekst. 				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id5189062				0	sl	Če se npr. nahajate v poglavju 1, podpoglavju 2, podrazdelku 5, je to mogoče oštevilčiti kot 1.2.5. Če semkaj vstavite sklic na prejšnji podrazdelek "1.2.4" in uporabite obliko "Številka", bo sklic prikazan kot "4". Če je v tem primeru oštevilčenje nastavljeno na prikaz več podravni, bo isti sklic prikazan kot "2.4" ali "1.2.4", odvisno od nastavitve. Če uporabite obliko "Številka (polni kontekst)", boste vedno videli "1.2.4", ne glede na to, kako je oblikovano številčenje odstavka.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	hd_id3156242				0	sl	Ime				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3156259				0	sl	\<ahelp hid=\"SW:EDIT:TP_FLD_REF:ED_REFNAME\"\>Vnesite ime uporabniško določenega polja, ki ga želite ustvariti.\</ahelp\> Za nastavitev cilja kliknite "Nastavi sklic" v seznamu \<emph\>Vrsta\</emph\>, v polje vnesite ime in nato kliknite \<emph\>Vstavi\</emph\>. Za sklicevanje na ime cilja kliknite ime cilja v seznamu \<emph\>Izbor\</emph\>.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3156032	17			0	sl	V glavnem dokumentu se cilji, ki so v različnih poddokumentih, ne prikažejo na seznamu \<emph\> Izbor\</emph\>. Če želite v cilj vstaviti sklic, morate vnesti pot in ime v polje \<emph\>Ime\</emph\>.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id0903200802250745				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Vnesite vsebino, ki jo želite dodati v uporabniško določena polja.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3159216				0	sl	Če v dokumentu izberete besedilo in zatem vstavite sklic, bo izbrano besedilo postalo vsebina polja, ki ga vstavite.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id6501968				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Uredite vrednost.\</ahelp\>				20200411 15:09:53
