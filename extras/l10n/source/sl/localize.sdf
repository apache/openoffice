helpcontent2	source\text\scalc\01\05110000.xhp	0	help	hd_id3150044				0	sl	Dodatno				20200411 15:09:53
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	par_id3146920				0	sl	\<ahelp hid=\"SC:MOREBUTTON:RID_SCDLG_AUTOFORMAT:BTN_MORE\"\>Odpre razdelek \<emph\>Oblikovanje\</emph\>, ki prikazuje razveljavitelje oblikovanja, ki jih lahko uveljavite v preglednici. Če pustite možnost neizbrano, se ohrani oblika za trenutno preglednico za to vrsto oblike.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	hd_id3155961				0	sl	Oblikovanje				20200411 15:09:53
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	par_id3153965				0	sl	V tem razdelku lahko izberete ali ne razpoložljive možnosti oblikovanja. Če želite ohraniti katere od trenutnih nastavitev za preglednico, pustite ustrezno možnost prazno.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	hd_id3154021				0	sl	Oblika številk				20200411 15:09:53
