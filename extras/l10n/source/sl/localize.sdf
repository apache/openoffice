helpcontent2	source\text\sbasic\shared\03060200.xhp	0	help	par_id3147434				0	sl	A = 10: B = 8: C = 6: D = Null				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03060200.xhp	0	help	par_id3152462				0	sl	vOut = A > B Eqv B > C REM vrne -1				20200411 15:09:53
