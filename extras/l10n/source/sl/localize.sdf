helpcontent2	source\text\shared\02\03110000.xhp	0	help	par_id3156211	2			0	sl	\<ahelp hid=\".uno:ParaspaceIncrease\"\>Kliknite ikono \<emph\>Povečaj razmik\</emph\>, če želite povečati razmik med izbranim in predhodnim stavkom.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\03110000.xhp	0	help	par_id3150178				0	sl	\<image id=\"img_id3152425\" src=\"res/commandimagelist/sc_paraspaceincrease.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3152425\"\>Ikona\</alt\>\</image\>				20200411 15:09:53
