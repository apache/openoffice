helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3148448				0	sl	DURATION				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153056				0	sl	\<ahelp hid=\"HID_FUNC_LAUFZEIT\"\>Izračuna število obdobij, ki jih potrebuje naložba, da doseže želeno vrednost.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3145421				0	sl	Skladnja				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148933				0	sl	DURATION(mera; PV; FV)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148801				0	sl	\<emph\>Mera\</emph\> je konstanta. Obrestno mero se izračuna za celotno trajanje (obdobje trajanja). Obrestna mera na obdobje se izračuna z deljenjem obrestne mere z izračunanim trajanjem. Notranja mera za redno plačilo se vnese kot Mera/12.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147239				0	sl	\<emph\>PV\</emph\> je trenutna vrednost. Gotovinska vrednost je polog gotovine ali trenutna gotovinska vrednost tega plačila. Kot vrednost pologa morate vnesti pozitivno vrednost; polog ne sme biti 0 ali manjši od 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147515				0	sl	\<emph\>FV\</emph\> je pričakovana vrednost. Prihodnja vrednost določa želeno (prihodnjo) vrednost pologa.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153579				0	sl	Primer				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148480				0	sl	Pri obrestni meri 4,75%, gotovinski vrednosti 25.000 denarnih enot in prihodnji vrednosti 1.000.000 denarnih enot je izračunano trajanje 79.49. Plačilo po obdobjih je nastali koeficient prihodnje vrednosti in trajanja, v tem primeru 1.000.000/79.49=12,850.20.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3148912				0	sl	\<bookmark_value\>računanje; linearne amortizacije\</bookmark_value\>\<bookmark_value\>amortizacije; linearne\</bookmark_value\>\<bookmark_value\>linearne amortizacije\</bookmark_value\>\<bookmark_value\>premočrtne amortizacije\</bookmark_value\>\<bookmark_value\>funkcija SLN\</bookmark_value\>"				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3148912				0	sl	SLN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149154	291			0	sl	\<ahelp hid=\"HID_FUNC_LIA\"\>Vrne linearno amortizacijo sredstva na obdobje.\</ahelp\>Velikost amortizacije se med obdobjem amortizacije ne spreminja.				20200411 15:09:53
