helpcontent2	source\text\swriter\01\mailmerge04.xhp	0	help	par_idN10553				0	sl	Določite lastnosti pozdrava. Če spojena zbirka podatkov vsebuje podatke o spolu, lahko določite različne pozdrave glede na spol prejemnika.				20200411 15:09:53
helpcontent2	source\text\swriter\01\mailmerge04.xhp	0	help	par_idN10556				0	sl	Ta dokument naj vsebuje pozdrav				20200411 15:09:53
