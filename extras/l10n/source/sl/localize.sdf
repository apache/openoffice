helpcontent2	source\text\swriter\01\mailmerge00.xhp	0	help	par_idN10549				0	sl	\<link href=\"text/swriter/01/mailmerge00.xhp\"\>Čarovnik za spajanje dokumentov\</link\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\mailmerge00.xhp	0	help	par_idN10559				0	sl	\<ahelp hid=\".\"\>Zažene čarovnika za spajanje dokumentov za tvorbo tipskih pisem ali pošiljanje e-poštnih sporočil več prejemnikom.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\mailmerge00.xhp	0	help	par_idN105CC				0	sl	\<link href=\"text/swriter/01/mailmerge01.xhp\" name=\"Čarovnik za spajanje dokumentov - Začetni dokument\"\>Čarovnik za spajanje dokumentov - Začetni dokument\</link\>				20200411 15:09:53
