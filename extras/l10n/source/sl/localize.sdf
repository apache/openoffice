helpcontent2	source\text\shared\autopi\01120400.xhp	0	help	hd_id3149748				0	sl	\<link href=\"text/shared/autopi/01120400.xhp\" name=\"Čarovnik za skupinske elemente: Polje zbirke podatkov\"\>Čarovnik za skupinske elemente: Polje zbirke podatkov\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01120400.xhp	0	help	par_id3154094				0	sl	Ta stran je vidna le, če je dokument povezan z zbirko podatkov. Na strani določite, ali naj se referenčne vrednosti shranijo v zbirko podatkov.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01120400.xhp	0	help	par_id3153255				0	sl	Določite, ali naj se \<link href=\"text/shared/02/01170101.xhp\" name=\"referenčne vrednosti\"\>referenčne vrednosti\</link\> shranijo. Referenčna vrednost lahko predstavlja trenutno stanje skupinskega polja v zbirki podatkov.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01120400.xhp	0	help	par_id3149828				0	sl	Ta stran je prikazana le, če je dokument že povezan z zbirko podatkov.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01120400.xhp	0	help	hd_id3152551				0	sl	Ali želite shraniti vrednost v polje zbirke podatkov?				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01120400.xhp	0	help	hd_id3154823				0	sl	Da, želim jo shraniti v sledeče polje zbirke podatkov:				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01120400.xhp	0	help	par_id3156346				0	sl	\<ahelp hid=\"DBP_RADIOBUTTON_RID_PAGE_OPTION_DBFIELD_RB_STOREINFIELD_YES\"\>Določa, ali želite shraniti referenčne vrednosti v zbirko podatkov.\</ahelp\> Vrednosti bodo zapisane v podatkovno polje, izbrano na seznamu. Seznamsko polje prikazuje vsa imena polj v tabeli zbirke podatkov, s katero je povezan obrazec.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01120400.xhp	0	help	hd_id3145382				0	sl	Seznamsko polje				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01120400.xhp	0	help	par_id3149398				0	sl	\<ahelp hid=\"DBP_LISTBOX_RID_PAGE_OPTION_DBFIELD_LB_STOREINFIELD\" visibility=\"hidden\"\>Izberite podatkovno polje, v katerega bodo shranjene referenčne vrednosti.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01120400.xhp	0	help	hd_id3153881				0	sl	Ne, vrednost želim shraniti samo v obrazcu.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01120400.xhp	0	help	par_id3153146				0	sl	\<ahelp hid=\"DBP_RADIOBUTTON_RID_PAGE_OPTION_DBFIELD_RB_STOREINFIELD_NO\"\>Določa, da želite shraniti referenčne vrednosti le v obrazec, ne pa tudi v zbirko podatkov.\</ahelp\>				20200411 15:09:53
