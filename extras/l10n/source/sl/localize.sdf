helpcontent2	source\text\shared\main0227.xhp	0	help	par_id3155812				0	sl	\<ahelp hid=\".uno:BezierSymmetric\"\>Ta ikona pretvori vogalno točko ali gladko točko v simetrično točko.\</ahelp\> Obe kontrolni točki vogalne točke sta poravnani vzporedno in imata enako dolžino. Premikate jih lahko le hkrati in stopnja ukrivljenosti je enaka v obeh smereh.				20200411 15:09:53
helpcontent2	source\text\shared\main0227.xhp	0	help	par_id3153818				0	sl	\<image id=\"img_id3159218\" src=\"res/commandimagelist/sc_beziersymmetric.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3159218\"\>Ikona\</alt\>\</image\>				20200411 15:09:53
