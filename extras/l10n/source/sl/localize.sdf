helpcontent2	source\text\smath\01\03050000.xhp	0	help	hd_id3147338				0	sl	\<link href=\"text/smath/01/03050000.xhp\" name=\"Pomanjšaj\"\>Pomanjšaj\</link\>				20200411 15:09:53
helpcontent2	source\text\smath\01\03050000.xhp	0	help	par_id3150249				0	sl	\<ahelp hid=\".\"\>Pomanjša merilo prikaza formul za 25%.\</ahelp\> Trenutna povečava je prikazana v vrstici stanja. Merilo lahko spremenite tudi v \<link href=\"text/shared/00/00000001.xhp#kontextmenue\" name=\"kontekstni meni\"\>kontekstnem meniju\</link\> vrstice stanja. Tudi kontekstni meni delovnega prostora nudi možnosti za pomanjšavo.				20200411 15:09:53
