helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3156024				0	sl	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Na začetku in koncu odstavka se razmiki in tabulatorji odstranijo. Če želite uporabiti to možnost, morate izbrati tudi možnost \<emph\>Uporabi sloge\</emph\>.\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3147303				0	sl	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Izbriši presledke in tabulatorje na začetku n koncu vrstice\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3150866				0	sl	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Na začetku in koncu vrstice se razmiki in tabulatorji odstranijo. Če želite uporabiti to možnost, morate izbrati možnost \<emph\>Uporabi sloge\</emph\>.\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3150400				0	sl	Prezri dvojne razmike				20200411 15:09:53
