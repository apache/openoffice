helpcontent2	source\text\shared\01\06030000.xhp	0	help	par_id3149903				0	sl	\<ahelp hid=\".\"\>V izbrani sliki se prikaže barva, ki jo želite zamenjati. Če želite nastaviti izvorno barvo, kliknite tukaj, nato pa Menjalnico barv in barvo v izbrani sliki.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06030000.xhp	0	help	hd_id3150085				0	sl	Toleranca				20200411 15:09:53
helpcontent2	source\text\shared\01\06030000.xhp	0	help	par_id3144438				0	sl	\<ahelp hid=\"SVX:METRICFIELD:RID_SVXDLG_BMPMASK:SP_4\"\>Nastavite toleranco za zamenjavo izvorne barve v izvirni sliki. Če želite zamenjati barve, ki so podobne barvi, ki ste jo izbrali, vnesite nizko vrednost. Če želite zamenjati širši spekter barv, vnesite večjo vrednost.\</ahelp\>				20200411 15:09:53
