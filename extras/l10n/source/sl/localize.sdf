helpcontent2	source\text\sbasic\shared\01170101.xhp	0	help	par_id3154200				0	sl	\<ahelp hid=\".\"\>Izberite "Da", če želite trenutni gumb - kontrolnik kot privzeto izbiro za okno. Kadar pritisnete na \<emph\>Return\</emph\> v pogovornem oknu, se aktivira privzeti gumb.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01170101.xhp	0	help	par_idN108BA				0	sl	Zakasnitev				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01170101.xhp	0	help	par_idN108D0				0	sl	\<ahelp hid=\".\"\>Navaja zakasnitev v milisekundah med dogodki, ki jih sproža drsni trak.\</ahelp\> Dogodek se sproži, če kliknete na puščico na drsnem traku ali pa če kliknete na njegovo ozadje. Sproženi dogodek se ponavlja, če med tem, ko ste kliknili na puščico na drsnem traku ali pa na njegovo ozadje, držite gumb na miški pritisnjen. Če želite, lahko vnesete skupaj s številko tudi veljavno enoto za čas, npr. 2 s ali 500 ms.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01170101.xhp	0	help	hd_id3151278				0	sl	Spustno polje				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01170101.xhp	0	help	par_id3155113				0	sl	\<ahelp hid=\".\"\>Izberite "Da", če hočete za seznamska ali kombinirana polja aktivirati spustno opcijo. Kontrolnik v obliki spustnega polja ima gumb s puščico, s katero lahko, če nanj kliknete, odprete seznam z obstoječimi vnosi v kontrolnik.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01170101.xhp	0	help	hd_id3151216				0	sl	Omogočeno				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01170101.xhp	0	help	par_id3150517				0	sl	\<ahelp hid=\".\"\>Izberite "Da", da kontrolnik aktivirate. Če je kontrolnik deaktiviran, se bo v pogovornem oknu kazal v sivi barvi.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01170101.xhp	0	help	hd_id3155379				0	sl	Uredi masko				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01170101.xhp	0	help	par_id3155509				0	sl	\<ahelp hid=\".\"\>Določite obliko, ki ga želite za kontrolnik z vzorcem. Gre za kodo iz znakov, s katero se definira vhodna oblika za kontrolnik.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01170101.xhp	0	help	par_id3154485				0	sl	Za vsak znak, ki ga vnese uporabnik, morate v urejevalni maski navesti maskirni znak, da vnesene vrednosti omejite na vrednosti v spodnjem seznamu:				20200411 15:09:53
