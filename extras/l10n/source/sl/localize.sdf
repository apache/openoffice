helpcontent2	source\text\simpress\02\10050000.xhp	0	help	par_id3163709				0	sl	\<ahelp hid=\".uno:TextToolbox\"\>Orodna vrstica \<emph\>Besedilo\</emph\> vsebuje več ikon, ki omogočajo vnos različnih vrst okvirov z besedilom.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\simpress\02\10050000.xhp	0	help	hd_id3151243				0	sl	Besedilo				20200411 15:09:53
helpcontent2	source\text\simpress\02\10050000.xhp	0	help	par_id3156019				0	sl	\<ahelp hid=\".uno:Text\"\>Nariše polje z besedilom, kjer kliknete in povlečete v trenutnem dokumentu. Kliknite kamor koli v dokumentu in nato vnesite ali prilepite besedilo.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\simpress\02\10050000.xhp	0	help	par_id3149875				0	sl	\<image id=\"img_id3153070\" src=\"res/commandimagelist/sc_drawtext.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3153070\"\>Ikona\</alt\>\</image\>				20200411 15:09:53
