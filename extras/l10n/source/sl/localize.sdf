helpcontent2	source\text\sdraw\guide\gradient.xhp	0	help	hd_id3150792	3			0	sl	\<variable id=\"gradient\"\>\<link href=\"text/sdraw/guide/gradient.xhp\" name=\"Ustvarjanje prelivov\"\>Ustvarjanje prelivov\</link\> \</variable\>				20200411 15:09:53
helpcontent2	source\text\sdraw\guide\gradient.xhp	0	help	par_id3154012				0	sl	Preliv je naraščajoča mešanica dveh različnih barv ali odtenkov iste barve, ki jo lahko dodelite risanemu predmetu.				20200411 15:09:53
helpcontent2	source\text\sdraw\guide\gradient.xhp	0	help	hd_id3147436				0	sl	Za dodelitev preliva:				20200411 15:09:53
helpcontent2	source\text\sdraw\guide\gradient.xhp	0	help	par_id3146974				0	sl	Izberite risani predmet.				20200411 15:09:53
helpcontent2	source\text\sdraw\guide\gradient.xhp	0	help	par_id3154491				0	sl	Izberite \<emph\>Oblika - Področje\</emph\> in izberite \<emph\>Prelivi\</emph\> med možnostmi \<emph\>Zapolni\</emph\>.				20200411 15:09:53
helpcontent2	source\text\sdraw\guide\gradient.xhp	0	help	par_id3153415				0	sl	Izberite vrsto preliva s seznama in kliknite \<emph\>V redu\</emph\>.				20200411 15:09:53
helpcontent2	source\text\sdraw\guide\gradient.xhp	0	help	hd_id3154702				0	sl	Ustvarjanje prelivov po meri				20200411 15:09:53
helpcontent2	source\text\sdraw\guide\gradient.xhp	0	help	par_id3145791				0	sl	Določite lahko svoje in spreminjate obstoječe prelive ter shranjujete in nalagate sezname datotek prelivov.				20200411 15:09:53
helpcontent2	source\text\sdraw\guide\gradient.xhp	0	help	hd_id3145384				0	sl	Za izdelavo preliva po meri:				20200411 15:09:53
helpcontent2	source\text\sdraw\guide\gradient.xhp	0	help	par_id3151242				0	sl	Izberite \<emph\>Oblika - Področje\</emph\> in kliknite zavihek \<emph\>Prelivi\</emph\>.				20200411 15:09:53
helpcontent2	source\text\sdraw\guide\gradient.xhp	0	help	par_id3150046				0	sl	Preliv, ki ga boste uporabili za osnovo svojega preliva, izberite s seznama in kliknite \<emph\>Dodaj\</emph\>.				20200411 15:09:53
helpcontent2	source\text\sdraw\guide\gradient.xhp	0	help	par_id3145116				0	sl	Vnesite ime preliva v polje z besedilom in kliknite \<emph\>V redu\</emph\>.				20200411 15:09:53
helpcontent2	source\text\sdraw\guide\gradient.xhp	0	help	par_id6535843				0	sl	Ime preliva se pojavi na koncu seznama in je označeno za urejanje.				20200411 15:09:53
helpcontent2	source\text\sdraw\guide\gradient.xhp	0	help	par_id3150391				0	sl	Nastavite lastnosti preliva in kliknite \<emph\>Spremeni\</emph\>, da se preliv shrani.				20200411 15:09:53
helpcontent2	source\text\sdraw\guide\gradient.xhp	0	help	par_id3156396	16			0	sl	Kliknite \<emph\>V redu.\</emph\> 				20200411 15:09:53
