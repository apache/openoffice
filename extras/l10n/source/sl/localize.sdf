helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144950				0	sl	Vrne (trigonometrični) sinus \<emph\>števila\</emph\>, to je kot v radianih.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8079470				0	sl	Če želite vrnjeno vrednost sinusa kota v stopinjah, uporabite funkcijo RADIANS.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144969				0	sl	Primer				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144983				0	sl	\<item type=\"input\"\>=SIN(PI()/2)\</item\> vrne 1, kar je sinus PI/2 radianov.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3916440				0	sl	\<item type=\"input\"\>=SIN(RADIANS(30))\</item\> vrne 0,5, sinus 30 stopinj.				20200411 15:09:53
