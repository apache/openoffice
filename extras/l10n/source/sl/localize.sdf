helpcontent2	source\text\swriter\01\04070300.xhp	0	help	hd_id3150123				0	sl	Trenutni tiskalnik				20200411 15:09:53
helpcontent2	source\text\swriter\01\04070300.xhp	0	help	par_id3150696				0	sl	Prikaže ime trenutnega tiskalnika.				20200411 15:09:53
