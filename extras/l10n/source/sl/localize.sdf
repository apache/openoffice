helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148804				0	sl	RRI(P; PV; FV)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154901				0	sl	\<emph\>P\</emph\> je število obdobij, potrebnih za izračun obrestne mere.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3159149				0	sl	\<emph\>PV\</emph\> je trenutna vrednost. Gotovinska vrednost je polog gotovine ali trenutna gotovinska vrednost tega plačila. Kot vrednost pologa morate vnesti pozitivno vrednost; polog ne sme biti 0 ali manjši od 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149771				0	sl	\<emph\>FV\</emph\> določa, kaj je zaželeno kot gotovinska vrednost pologa.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3148941				0	sl	Primer				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154212				0	sl	Za štiri obdobja (leta) in gotovinsko vrednost 7,500 denarnih enot se izračuna obrestna mera, če je prihodnja vrednost 10,000 denarnih enot.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150775	246			0	sl	\<item type=\"input\"\>=RRI(4;7500;10000)\</item\> = 7,46 %				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145413	247			0	sl	Obrestna mera mora biti 7.46%, da 7,500 denarnih enot postane 10,000 denarnih enot.				20200411 15:09:53
