helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143606				0	sl	\<emph\>Obseg\</emph\> je obseg celic, ki so vključene vanj.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3143625				0	sl	Primer				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143638				0	sl	Imate tabelo v celičnem obsegu A1:B5, ki vsebujejo mesta v stolpcu A in vzporedne številke v stolpcu B. Uporabili ste samodejni filter, tako da vidite le vrste, ki vsebujejo mesto Hamburg. Želite videti vsoto prikazanih številk, ki je le delna vsota izbranih vrst. V tem primeru je pravilna formula naslednja:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143658				0	sl	\<item type=\"input\"\>=SUBTOTAL(9;B2:B5)\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3143672				0	sl	\<bookmark_value\>evro; pretvarjanje v\</bookmark_value\>\<bookmark_value\>funkcija EUROCONVERT\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3143672				0	sl	EUROCONVERT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143708				0	sl	\<ahelp hid=\"HID_FUNC_UMRECHNEN\"\>Pretvarja med vrednostmi v starih evropskih nacionalnih valutah in evrih.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143731				0	sl	\<emph\>Skladnja\</emph\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143748				0	sl	EUROCONVERT(vrednost; "iz_valute"; "v_valuto", polna_natančnost, triangularna_natančnost)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143763				0	sl	\<emph\>Vrednost\</emph\> je količina denarnih enot valute za pretvorbo.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143782				0	sl	\<emph\>Iz_valute\</emph\> in \<emph\>v_valuto\</emph\> sta denarni enoti za pretvorbo iz prve v drugo. To mora biti besedilo, ki je uradna kratica valute (npr. "EUR" ali "SIT"). Menjalni tečaj (prikazan v evrih) je določila Evropska komisija.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0119200904301810				0	sl	\<emph\>Polna_natančnost\</emph\> je neobvezen parameter. Če je izpuščen ali False, je rezultat zaokrožen glede na decimalke parametra v_valuto. Če je polna_natančnost True, rezultat ni zaokrožen.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0119200904301815				0	sl	\<emph\>Triangularna_natančnost\</emph\> je neobvezen parameter. Če je triangularna_natančnost podana in je >=3, je vmesni rezultat triangularne konverzije (valuta1,EUR,valuta2) zaokrožen na to natančnost. Če je triangularna_natančnost izpuščena, vmesni rezultat ni zaokrožen. Tudi če je v_valuto enako "EUR", je triangularna_natančnost uporabljena, kot da je triangulacija potrebna in da je bila pretvorba iz EUR v EUR izvršena.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143819				0	sl	\<emph\>Primeri\</emph\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143837				0	sl	\<item type=\"input\"\>=EUROCONVERT(100;"SIT";"EUR")\</item\> pretvori 100 slovenskih tolarjev v evre.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143853				0	sl	\<item type=\"input\"\>=EUROCONVERT(100;"EUR";"DEM")\</item\> pretvori 100 evrov v nemške marke.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id0908200902090676				0	sl	\<bookmark_value\>funkcija CONVERT\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id0908200902074836				0	sl	CONVERT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902131122				0	sl	\<ahelp hid=\".\"\>Pretvori vrednost iz enih merskih enot v druge. Faktorji pretvorbe so podani v seznamu nastavitev.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902475420				0	sl	Nekoč je ta seznam faktorjev pretvorbe vključevala nekdanje evropske valute in evro (glejte spodnje primere). Če želite pretvoriti te valute, predlagamo uporabo nove funkcije EUROCONVERT.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id0908200902131071				0	sl	Skladnja				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902131191				0	sl	CONVERT(vrednost;"besedilo";"besedilo")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id0908200902131152				0	sl	Primer				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id090820090213112				0	sl	\<item type=\"input\"\>=CONVERT(100;"SIT";"EUR")\</item\> pretvori 100 slovenskih tolarjev v evre.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902475431				0	sl	=CONVERT(100;"EUR";"DEM") pretvori 100 evrov v nemške marke. 				20200411 15:09:53
