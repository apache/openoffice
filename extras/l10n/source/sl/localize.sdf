helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154933	126			0	sl	\<emph\>X\</emph\> je število rezultatov, pridobljenih v naključnem vzorcu.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153106	127			0	sl	\<emph\>Št_vzorcev\</emph\> je velikost naključnega vzorca.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146992	128			0	sl	\<emph\>Uspehi\</emph\> je število možnih rezultatov v celotni populaciji.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3148826	129			0	sl	\<emph\>Št_populacije \</emph\>je velikost celotne populacije.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150529				0	sl	Primer				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154904	131			0	sl	\<item type=\"input\"\>=HYPGEOMDIST(2;2;90;100)\</item\> vrne 0,81. Če pade 90 od 100 z maslom namazanih kosov kruha z mize na tla z namazano stranjo navzdol in če zatem spustimo na tla 2 kosa kruha, je verjetnost, da bosta oba padla z namazano stranjo navzdol, 81%.				20200411 15:09:53
