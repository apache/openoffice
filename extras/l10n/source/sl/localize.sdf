helpcontent2	source\text\shared\02\01140000.xhp	0	help	par_idN10EA5				0	sl	Vklopi ali izklopi učinke 3D za izbrane predmete.				20200411 15:09:53
helpcontent2	source\text\shared\02\01140000.xhp	0	help	hd_id3149735				0	sl	Navpični oblački				20200411 15:09:53
helpcontent2	source\text\shared\02\01140000.xhp	0	help	par_id3156068				0	sl	\<image id=\"img_id3154818\" src=\"res/commandimagelist/sc_verticalcaption.png\" width=\"0.1665in\" height=\"0.1665in\"\>\<alt id=\"alt_id3154818\"\>Ikona\</alt\>\</image\>				20200411 15:09:53
helpcontent2	source\text\shared\02\01140000.xhp	0	help	par_id3150492				0	sl	\<ahelp hid=\".uno:VerticalCaption\"\>Nariše črto, ki se konča v pravokotnem oblačku z navpično usmerjenostjo besedila, kjer povlečete v trenutnem dokumentu. Za spremembo velikosti oblačka povlecite ročico oblačka. Za dodajanje besedila kliknite rob oblačka in vnesite ali prilepite besedilo. Če želite spremeniti pravokotni oblaček v okroglega, povlecite ročico največjega kota, ko se le-ta spremeni v roko. To je na voljo le, če je omogočena podpora za azijske jezike.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\01140000.xhp	0	help	hd_id3166437				0	sl	Navpično besedilo				20200411 15:09:53
helpcontent2	source\text\shared\02\01140000.xhp	0	help	par_id3146929				0	sl	\<image id=\"img_id3154372\" src=\"res/commandimagelist/sc_verticaltext.png\" width=\"0.1665in\" height=\"0.1665in\"\>\<alt id=\"alt_id3154372\"\>Ikona\</alt\>\</image\>				20200411 15:09:53
helpcontent2	source\text\shared\02\01140000.xhp	0	help	par_id3152989				0	sl	\<ahelp hid=\".uno:VerticalText\"\>Nariše okvir z besedilom z navpično usmerjenostjo besedila, kjer povlečete v trenutnem dokumentu. Kliknite kamor koli v dokument, nato vnesite ali prilepite besedilo. Lahko tudi pomaknete kazalko na mesto, kamor želite dodati besedilo, in besedilo vnesite ali prilepite. To je na voljo le, ko je omogočena podpora za azijske jezike.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\01140000.xhp	0	help	par_id3155555				0	sl	\<link href=\"text/shared/guide/insert_graphic_drawit.xhp\" name=\"Nasveti\"\>Nasveti za delo z vrstico z vrstico \<emph\>Risanje\</emph\>.\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\02\01170901.xhp	0	help	tit				0	sl	Čarovnik za kombinirana/seznamska polja: Izbor tabele				20200411 15:09:53
helpcontent2	source\text\shared\02\01170901.xhp	0	help	hd_id3154228				0	sl	\<link href=\"text/shared/02/01170901.xhp\" name=\"Čarovnik za kombinirana/seznamska polja: Izbor tabele\"\>Čarovnik za kombinirana/seznamska polja: Izbor tabele\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\02\01170901.xhp	0	help	par_id3149716				0	sl	Tukaj izberete tabelo iz razpoložljivih tabel zbirke podatkov, ki vsebuje podatkovno polje, katerega vsebina bo prikazana kot vnos na seznam.				20200411 15:09:53
helpcontent2	source\text\shared\02\01170901.xhp	0	help	par_id3153114				0	sl	Pri seznamskih poljih je prikazana tabela, ki jo lahko povežete s trenutno tabelo obrazca. Povezana tabela in tabela trenutnega obrazca morata imeti vsaj eno skupno polje. To omogoča, da se vzpostavi jasen sklic.				20200411 15:09:53
helpcontent2	source\text\shared\02\01170901.xhp	0	help	par_id3155555				0	sl	Pri kombiniranih poljih mora obstajati razmerje med tabelo obrazca in tabelo, ki vsebuje podatke za prikaz v kombiniranem polju.				20200411 15:09:53
helpcontent2	source\text\shared\02\01170901.xhp	0	help	hd_id3147226				0	sl	Tabela				20200411 15:09:53
helpcontent2	source\text\shared\02\01170901.xhp	0	help	par_id3155338	7			0	sl	\<ahelp hid=\"DBP_LISTBOX_RID_PAGE_LCW_CONTENTSELECTION_TABLE_LB_SELECTTABLE\"\>V polju\<emph\> Tabela \</emph\> izberite tabelo, ki vsebuje podatkovno polje, katerega vsebino bi radi prikazali v kontrolnem polju.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\01170901.xhp	0	help	par_id3159233				0	sl	Ta tabela se prikaže v \<link href=\"text/shared/02/01170102.xhp\" name=\"Lastnosti kontrolnikov\"\>Lastnostih kontrolnikov\</link\> kot element izjave SQL v polju \<emph\>Vsebina seznama\</emph\>.				20200411 15:09:53
helpcontent2	source\text\shared\02\01171300.xhp	0	help	tit				0	sl	Pripni na mrežo				20200411 15:09:53
helpcontent2	source\text\shared\02\01171300.xhp	0	help	hd_id3151262				0	sl	\<link href=\"text/shared/02/01171300.xhp\" name=\"Pripni na mrežo\"\>Pripni na mrežo\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\02\01171300.xhp	0	help	par_id3149495				0	sl	\<ahelp hid=\".\"\>S tem ukazom določite, ali želite premikati okvire, risane predmete in kontrolnike le med točkami v mreži.\</ahelp\>				20200411 15:09:53
