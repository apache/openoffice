helpcontent2	source\text\smath\01\05020000.xhp	0	help	bm_id3153816				0	sl	\<bookmark_value\>velikosti pisav; v $[officename] Math\</bookmark_value\>\<bookmark_value\>velikosti; pisav v $[officename] Math\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\smath\01\05020000.xhp	0	help	hd_id3153816				0	sl	Velikosti pisave				20200411 15:09:53
helpcontent2	source\text\smath\01\05020000.xhp	0	help	par_id3150213				0	sl	\<variable id=\"schriftgroessentext\"\>\<ahelp hid=\"SID_FONTSIZE\"\>S tem pogovornim oknom določite velikosti pisave v svoji formuli. Izberite osnovno velikost in vsi elementi v formuli se bodo spremenili v skladu z novo osnovno velikostjo.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\smath\01\05020000.xhp	0	help	hd_id3146968				0	sl	Osnovna velikost				20200411 15:09:53
helpcontent2	source\text\smath\01\05020000.xhp	0	help	par_id3145115				0	sl	\<ahelp hid=\"STARMATH:METRICFIELD:RID_FONTSIZEDIALOG:1\"\>Velikost vseh elementov formule je sorazmerna osnovni velikosti. Za spremembo osnovne velikosti izberite ali vnesite želeno velikost v slikovnih točkah (pt). Lahko uporabite tudi druge enote ali drugo \<link href=\"text/shared/00/00000001.xhp#metrik\" name=\"metrika\"\>metriko\</link\>, sprememba v pt se izvede samodejno.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\smath\01\05020000.xhp	0	help	par_id3153005				0	sl	Za stalno spremembo privzete velikosti (12 pt), ki se uporablja v $[officename] Math, morate najprej izbrati želeno vrednost (npr. 11 pt), nato pa klikniti na gumb \<emph\>Privzeto\</emph\>.				20200411 15:09:53
helpcontent2	source\text\smath\01\05020000.xhp	0	help	hd_id3153735				0	sl	Relativne velikosti				20200411 15:09:53
helpcontent2	source\text\smath\01\05020000.xhp	0	help	par_id3145241				0	sl	V tem delu lahko določite relativne velikosti za vsak tip elementa glede na osnovno velikost.				20200411 15:09:53
helpcontent2	source\text\smath\01\05020000.xhp	0	help	hd_id3150935				0	sl	Besedilo				20200411 15:09:53
helpcontent2	source\text\smath\01\05020000.xhp	0	help	par_id3148774				0	sl	\<ahelp hid=\"STARMATH:METRICFIELD:RID_FONTSIZEDIALOG:4\"\>Velikost besedila v formuli izberite relativno glede na osnovno velikost.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\smath\01\05020000.xhp	0	help	hd_id3148392				0	sl	Indeksi				20200411 15:09:53
helpcontent2	source\text\smath\01\05020000.xhp	0	help	par_id3149029				0	sl	\<ahelp hid=\"STARMATH:METRICFIELD:RID_FONTSIZEDIALOG:5\"\>Velikost indeksov formule izberite relativno na osnovno velikost.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\smath\01\05020000.xhp	0	help	hd_id3155371				0	sl	Funkcije				20200411 15:09:53
helpcontent2	source\text\smath\01\05020000.xhp	0	help	par_id3153923				0	sl	\<ahelp hid=\"STARMATH:METRICFIELD:RID_FONTSIZEDIALOG:6\"\>Velikost imen in drugih elementov funkcij v formuli izberite relativno na osnovno velikost.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\smath\01\05020000.xhp	0	help	hd_id3147171				0	sl	Operatorji				20200411 15:09:53
helpcontent2	source\text\smath\01\05020000.xhp	0	help	par_id3083280				0	sl	\<ahelp hid=\"STARMATH:METRICFIELD:RID_FONTSIZEDIALOG:7\" visibility=\"visible\"\>Izberite velikost matematičnih operatorjev v formuli relativno glede na osnovno velikost.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\smath\01\05020000.xhp	0	help	hd_id3154638				0	sl	Meje				20200411 15:09:53
helpcontent2	source\text\smath\01\05020000.xhp	0	help	par_id3151189				0	sl	\<ahelp hid=\"STARMATH:METRICFIELD:RID_FONTSIZEDIALOG:8\"\>Izberite velikost mej v formuli relativno glede na osnovno velikost.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\smath\01\05020000.xhp	0	help	hd_id3156320				0	sl	Privzeto				20200411 15:09:53
