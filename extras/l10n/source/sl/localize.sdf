helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154046				0	sl	\<ahelp hid=\".\"\>Pokaže predogled trenutnega izbora.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3145609				0	sl	Naprej				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3152473	71			0	sl	\<ahelp hid=\".\"\>Kliknite gumb\<emph\> Naprej \</emph\>in čarovnik uporabi trenutne nastavitve pogovornega okna ter nadaljuje z naslednjim korakom. Če ste pri zadnjem koraku, se ta gumb imenuje \<emph\>Ustvari\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3149670				0	sl	Nazaj				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3145068				0	sl	\<ahelp hid=\"OFFMGR_PUSHBUTTON_RID_OFADLG_OPTIONS_TREE_PB_BACK\"\>Ponastavi spremenjene vrednosti nazaj na privzete vrednosti $[officename].\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3148755				0	sl	Ponastavi				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3149651				0	sl	\<ahelp hid=\"HID_TABDLG_RESET_BTN\"\>Ponastavi spremembe v trenutnem zavihku na tiste, ki so veljale, ko je bilo to pogovorno okno odprto. Ko zaprete pogovorno okno, se potrditveno okno ne pojavi.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3143278				0	sl	Ponastavi				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3150791				0	sl	\<ahelp hid=\"HID_TABDLG_RESET_BTN\"\>Ponastavi spremenjene vrednosti nazaj na privzete vrednosti.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154331				0	sl	Potrditveno okno se ne pojavi. Če pogovorno okno potrdite z V redu, se ponastavijo vse nastavitve v tem pogovornem oknu.				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3145173				0	sl	Standardno				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154153				0	sl	\<ahelp hid=\"HID_TABDLG_STANDARD_BTN\"\>Ponastavi vrednosti, vidne v pogovornem oknu, nazaj na privzete vrednosti namestitve.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154299				0	sl	Potrditev se ne pojavi, dokler niso ponovno naložene privzete vrednosti.				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3147502				0	sl	Nazaj				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3150439				0	sl	\<ahelp hid=\"HID_TABDLG_STANDARD_BTN\"\>Ogled izbir v pogovornem oknu iz prejšnjih korakov. Trenutne nastavitve ostanejo nespremenjene.\</ahelp\> Ta gumb je mogoče aktivirati samo od druge strani naprej.				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3147352				0	sl	Dodatno				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3155314	53			0	sl	\<ahelp hid=\"HID_TABDLG_STANDARD_BTN\"\>Za razširitev pogovornega okna kliknite gumb\<emph\> Dodatno\</emph\>, da se prikažejo nadaljnje možnosti. Ponovno kliknite za obnovitev pogovornega okna.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3161659	41			0	sl	\<variable id=\"siehe\"\>Glejte tudi naslednje funkcije: \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3147418				0	sl	\<variable id=\"regulaer\"\>Iskanje podpira \<link href=\"text/shared/01/02100001.xhp\" name=\"regularni izrazi\"\>regularne izraze\</link\>. Vnesete lahko npr. "vse.*", da najdete prvo mesto, kjer se nahaja "vse" in kateremu sledi karkoli. Če želite iskati besedilo, ki je tudi običajen izraz, morate pred vsak znak vnesi znak \\. Samodejno vrednotenje regularnega izraza lahko vklopite in izklopite v \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Nastavitve\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - \<link href=\"text/shared/optionen/01060500.xhp\"\>%PRODUCTNAME Calc - Izračuni\</link\>.\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3163714	56			0	sl	\<variable id=\"wahr\"\>Če se pojavi napaka, funkcija vrne logično ali številsko vrednost. \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154145	54			0	sl	\<variable id=\"kontext\"\>(Ta ukaz je dostopen le prek \<link href=\"text/shared/00/00000005.xhp#kontextmenue\" name=\"kontekstni meni\"\>kontekstnega menija\</link\>). \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3152791	61			0	sl	\<variable id=\"wiederholen\"\>Z dvoklikom na orodje ga lahko uporabljate za več opravil. Če prikličete orodje z enim samim klikom, se povrne nazaj na zadnji izbor po končanem opravilu. \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id9345377				0	sl	\<variable id=\"ShiftF1\"\>Pritisnite Shift+F1 in pokažite na kontrolnik, da izveste več o njem. \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\icon_alt.xhp	0	help	tit				0	sl	Standardne ikone besedil Alt za vdelavo				20200411 15:09:53
