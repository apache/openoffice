helpcontent2	source\text\shared\01\01190000.xhp	0	help	hd_id3147243				0	sl	Shrani novo različico				20200411 15:09:53
helpcontent2	source\text\shared\01\01190000.xhp	0	help	par_id3149149	7			0	sl	\<ahelp hid=\"SFX2:PUSHBUTTON:DLG_VERSIONS:PB_SAVE\"\>Shrani trenutno stanje dokumenta kot novo različico. Če želite, lahko v pogovorno okno \<emph\>Vstavi komentar k različici\</emph\> vnesete tudi komentar, preden shranite novo različico.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01190000.xhp	0	help	hd_id3153348				0	sl	Vstavi komentar k različici				20200411 15:09:53
helpcontent2	source\text\shared\01\01190000.xhp	0	help	par_id3150466	9			0	sl	\<ahelp hid=\"SFX2:MULTILINEEDIT:DLG_COMMENTS:ME_VERSIONS\"\>Sem vnesete komentar, ko shranjujete novo različico. Če ste za odpiranje tega pogovornega okna kliknili \<emph\>Pokaži\</emph\>, komentarja ne morete urejati.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01190000.xhp	0	help	hd_id3149514				0	sl	Vedno shrani različico ob izhodu				20200411 15:09:53
