helpcontent2	source\text\shared\02\01170202.xhp	0	help	hd_id3151076				0	sl	Izpolni parametre				20200411 15:09:53
helpcontent2	source\text\shared\02\01170202.xhp	0	help	par_id3147396				0	sl	\<ahelp hid=\"HID_EVT_APPROVEPARAMETER\"\>Dogodek \<emph\>Izpolnitev parametrov\</emph\> nastopi, kadar naloženi obrazec vsebuje parametre, ki morajo biti izpolnjeni.\</ahelp\> Vir podatkov za obrazec je lahko naslednji ukaz SQL:				20200411 15:09:53
helpcontent2	source\text\shared\02\01170202.xhp	0	help	par_id3148773				0	sl	SELECT * FROM naslov WHERE ime=:ime				20200411 15:09:53
helpcontent2	source\text\shared\02\01170202.xhp	0	help	par_id3149581				0	sl	:ime je tisti parameter, ki mora biti pri nalaganju izpolnjen. Če je le mogoče, bo parameter samodejno izpolnjen iz glavnega obrazca. V nasprotnem primeru bo priklican ta dogodek in parameter bo izpolnjen s pomočjo makra.				20200411 15:09:53
helpcontent2	source\text\shared\02\01170202.xhp	0	help	hd_id3146926				0	sl	Nastala je napaka				20200411 15:09:53
helpcontent2	source\text\shared\02\01170202.xhp	0	help	par_id3149485	10			0	sl	\<ahelp hid=\"HID_EVT_ERROROCCURED\"\>Dogodek \<emph\>Nastala je napaka\</emph\> se sproži, če pri dostopu do vira podatkov pride do napake.\</ahelp\> To velja za obrazce ter seznamska in kombinirana polja.				20200411 15:09:53
