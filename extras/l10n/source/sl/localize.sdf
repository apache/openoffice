helpcontent2	source\text\simpress\02\10070000.xhp	0	help	par_id3155179				0	sl	\<ahelp hid=\".uno:EllipseCut_Unfilled\"\>V trenutnem dokumentu nariše nezapolnjen lik, ki ga določata lok elipse in črta premera. Za risanje odseka elipse povlecite elipso do želene velikosti in nato kliknite za določitev začetne točke črte premera. Premaknite kazalec na mesto, kjer želite postaviti končno točko premera, in kliknite. Na elipso ni potrebno klikniti. Za risanje krožnega odseka držite med vleko pritisnjeno tipko Shift.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\simpress\02\10070000.xhp	0	help	par_id3149483				0	sl	\<image id=\"img_id3149490\" src=\"res/commandimagelist/sc_ellipsecut_unfilled.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3149490\"\>Ikona\</alt\>\</image\>				20200411 15:09:53
