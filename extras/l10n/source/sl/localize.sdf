helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152651				0	sl	SERIESSUM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152688				0	sl	\<ahelp hid=\".\"\>Sešteje prve člene potenčnega zaporedja.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152708				0	sl	SERIESSUM(x;n;m;koeficient) = koeficient_1*x^n + koeficient_2*x^(n+m) + koeficient_3*x^(n+2m) +...+ koeficient_i*x^(n+(i-1)m)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152724				0	sl	Skladnja				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_idN11BD9				0	sl	SERIESSUM(X; N; M; koeficienti)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152737				0	sl	\<emph\>X\</emph\> je vhodna vrednost potenčnega zaporedja.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144344				0	sl	\<emph\>N\</emph\> je začetna stopnja potence.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144357				0	sl	\<emph\>M\</emph\> je prirastek za povečanje N-ja.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144370				0	sl	\<emph\>Koeficienti\</emph\> je niz koeficientov. Za vsak koeficient je niz vsote povečan za en razdelek.				20200411 15:09:53
