helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3149393				0	sl	13				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3153544				0	sl	\<item type=\"input\"\>Ime\</item\>				20200411 15:09:53
