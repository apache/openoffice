helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	hd_id3147242				0	sl	Mrežne črte				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	par_id3153088				0	sl	\<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_GRID\"\>Določa, ali naj prikaže mrežne črte med celicami.\</ahelp\>\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\> Za tiskanje izberite \<emph\>Oblika - Stran - \</emph\>\<link href=\"text/scalc/01/05070500.xhp\" name=\"Delovni list\"\>\<emph\>Delovni list\</emph\>\</link\> in označite potrditveno polje \<emph\>Mreža\</emph\>. \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	hd_id3156326				0	sl	Barva				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	par_id3154286				0	sl	\<ahelp hid=\"SC_LISTBOX_RID_SCPAGE_CONTENT_LB_COLOR\"\>Določa barvo mrežnih črt v trenutno odprtem dokumentu.\</ahelp\> Če želite videti barvo mrežnih črt, ki je bila shranjena z dokumentom, pojdite v \<emph\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Nastavitve\</caseinline\>\<defaultinline\>Orodja - Možnosti\</defaultinline\>\</switchinline\> - %PRODUCTNAME\</emph\>\<emph\> - Prikaz\</emph\>, v območju \<emph\>Shema\</emph\> poiščite vnos \<emph\>Preglednica - Mrežne črte\</emph\> in nastavite barvo na "Samodejno".				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	hd_id3152349				0	sl	Prelomi strani				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	par_id3151245				0	sl	\<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_PAGEBREAKS\"\>Določa, ali bodo prelomi strani vidni v določenem področju tiskanja.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	hd_id3149669				0	sl	Vodila med premikanjem				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	par_id3148550				0	sl	\<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_GUIDELINE\"\>Določa, ali naj bodo vodila med premikanjem risb, okvirov, grafik in ostalih predmetov vidna.\</ahelp\> Ta vodila vam pomagajo pri poravnavi predmetov.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	hd_id3150358	38			0	sl	Enostavne ročice				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	par_id3154140	39			0	sl	\<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_HANDLES\"\>Določa, ali naj prikaže ročice (osem točk na izbirnem okviru) kot enostavne kvadrate brez 3D-učinka.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	hd_id3149202				0	sl	Velike ročice				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	par_id3154123				0	sl	\<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_BIGHANDLES\"\>Določa, da so prikazane večje od običajnih ročic (osem točk na izbirnem okviru).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	hd_id3152920				0	sl	Prikaz				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	par_id3125864				0	sl	Izberite različne možnosti prikaza na zaslonu.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	hd_id3154218				0	sl	Formule				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	par_id3150440				0	sl	\<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_FORMULA\"\>Določa, ali naj bodo v celicah prikazane formule namesto rezultatov.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	hd_id3155132				0	sl	Ničelne vrednosti				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	par_id3147318				0	sl	\<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_NIL\"\>Določa, ali naj bodo številke z vrednostjo 0 prikazane.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	hd_id3147348				0	sl	Indikator komentarja				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	par_id3146974				0	sl	\<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_ANNOT\"\>Določa, da majhen pravokotnik v desnem zgornjem kotu celice nakazuje, da obstaja komentar. Komentar bo prikazan le, če omogočite namige pod \<emph\>%PRODUCTNAME - Splošno\</emph\> v pogovornem oknu Možnosti.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	par_id3150487				0	sl	\<ahelp hid=\".uno:NoteVisible\"\>Za stalen prikaz komentarja izberite ukaz \<emph\>Pokaži komentar\</emph\> v kontekstnem meniju celice.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	par_id3149667				0	sl	Komentarje lahko vnesete in urejate z ukazom \<link href=\"text/shared/01/04050000.xhp\" name=\"Vstavi - Komentar\"\>\<emph\>Vstavi - Komentar\</emph\>\</link\>. Komentarje, ki so prikazane trajno, lahko urejate s klikom v polje komentarja. Kliknite Krmarja in pod vnosom \<emph\>Komentarji\</emph\> lahko vidite vse komentarje v trenutnem dokumentu. Z dvoklikom komentarja v Krmarju kazalka skoči na ustrezno celico, ki vsebuje komentar.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	hd_id3150872				0	sl	Poudarjanje vrednosti				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	par_id3154792				0	sl	\<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_VALUE\"\>Označite potrditveno polje \<emph\>Poudarjanje vrednosti\</emph\>, če želite poudariti vsebino celic v različnih barvah glede na vrsto. Celice z besedilom so oblikovane s črno barvo, formule z zeleno in celice s številkami z modro, ne glede na to, kako je oblikovan njihov prikaz.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	par_id3151319				0	sl	Ko je aktiven ta ukaz, ne bo prikazana nobena od dodeljenih barv v dokumentu, dokler te možnosti ne izklopite.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	hd_id3157846				0	sl	Sidro				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	par_id3147494				0	sl	\<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_ANCHOR\"\>Določa, ali je prikazana ikona sidra, ko je izbran vstavljen predmet, npr. slika.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	hd_id3146898				0	sl	Prekoračitev besedila				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	par_id3153707				0	sl	\<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_CLIP\"\>Če celica vsebuje besedilo, ki je širše od širine celice, bo besedilo prikazano preko prazne sosednje celice v isti vrstici. Če ni nobene prazne sosednje celice, bo majhen trikotnik, ki se pojavi na robu celice, označeval, da se besedilo nadaljuje.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	hd_id3150327				0	sl	Pokaži sklice v barvah				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	par_id3153766				0	sl	\<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_RFIND\"\>Določa, da je vsak sklic v formuli poudarjen z barvo. Območje celice je obdano z obarvanim robom takoj, ko celico, ki vsebuje sklic, izberete za urejanje.\</ahelp\>				20200411 15:09:53
