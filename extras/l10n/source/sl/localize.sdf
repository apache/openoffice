helpcontent2	source\text\scalc\05\empty_cells.xhp	0	help	par_id9094515				0	sl	=ISNUMBER(C1) => FALSE (prej TRUE)				20200411 15:09:53
helpcontent2	source\text\scalc\05\empty_cells.xhp	0	help	par_id396740				0	sl	=ISNUMBER(VLOOKUP(1;A1:C1;2)) => FALSE (B1)				20200411 15:09:53
helpcontent2	source\text\scalc\05\empty_cells.xhp	0	help	par_id3859675				0	sl	=ISNUMBER(VLOOKUP(1;A1:C1;3)) => FALSE (C1, prej TRUE)				20200411 15:09:53
