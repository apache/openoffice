helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3146119				0	sl	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Ko ste vtipkali niz vezajev ( -) ali tabulatorjev, ki so ločeni z znakom za seštevanje, torej +-----+---+, pritisnite Enter, da se ustvari tabela. Znaki za seštevanje označujejo ločilo stolpcev, vezaji in tabulatorji pa širino stolpcev.\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3147219				0	sl	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>+-----------------+---------------+------+\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3153334				0	sl	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Uporabi sloge\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3147396				0	sl	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Slog odstavka "Privzeto" samodejno zamenja eden izmed slogov odstavka Naslov 1 do Naslov 8. Če želite uveljaviti slog odstavka Naslov 1, vtipkajte besedilo, pri katerem želite uporabiti naslov (brez pike), nato pa dvakrat pritisnite Enter. Če želite uveljaviti podnaslov, enkrat ali večkrat pritisnite tabulatorsko tipko, vtipkajte besedilo (brez pike), nato pa pritisnite Enter.\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3151075				0	sl	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Odstrani prazne odstavke\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3145728				0	sl	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Ko izberete \<emph\>Oblika - Samopopravki - Uporabi\</emph\>, se iz trenutnega dokumenta odstranijo prazni odstavki.\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3152375				0	sl	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Zamenjaj sloge po meri\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3156299				0	sl	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Slog odstavka po meri v trenutnem dokumentu zamenja eden izmed naslednjih slogov odstavka: "Privzeto", "Telo besedila", ali "Zamik telesa besedila".\</caseinline\>\</switchinline\>				20200411 15:09:53
