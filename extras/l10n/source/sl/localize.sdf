helpcontent2	source\text\shared\main0227.xhp	0	help	par_id3151248				0	sl	\<ahelp hid=\".uno:BezierCutLine\"\>Ikona\<emph\> Razdeli krivuljo \</emph\>razdeli krivuljo na več delov. Izberite točko ali točke, kjer želite razdeliti krivuljo, nato kliknite ikono.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\main0227.xhp	0	help	par_id3153788				0	sl	\<image id=\"img_id3148489\" src=\"res/commandimagelist/sc_beziercutline.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3148489\"\>Ikona\</alt\>\</image\>				20200411 15:09:53
