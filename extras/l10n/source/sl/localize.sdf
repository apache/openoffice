helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	par_id9701528				0	sl	%PRODUCTNAME uporablja za barvno tiskanje samo način RGB. Kontrolniki CMYK so na voljo samo za enostavnejši vnos vrednosti barv v zapisu CMYK.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	hd_id5566778801				0	sl	Polje barv				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	par_id5566778801				0	sl	\<ahelp hid=\"cui:Control:ColorPicker:ColorField\"\>V velikem polju barv s klikom izberite novo barvo.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	hd_id5566778802				0	sl	Drsni barvni trak				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	par_id5566778802				0	sl	Kliknite poljubnega izmed šestih gumbov, Rdeča, Zelena, Modra, Odtenek, Nasičenost ali Svetlost. Drsni trak barv se spremeni s prikazom obsega vrednosti, ki so na voljo. \<ahelp hid=\"cui:Control:ColorPicker:ColorSlider\"\>Na drsnem traku barv boste videli obseg vrednosti, ki jih lahko spreminjate glede na izbrani gumb oz. možnost. S klikom drsnega barvnega traku spreminjate vrednosti v velikem barvnem polju.\</ahelp\>  				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	hd_id5566778803				0	sl	Predogled trenutne barve				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	par_id5566778803				0	sl	\<ahelp hid=\"cui:Control:ColorPicker:ColorPreview\"\>V levem delu predoglednega polja boste vedno videli trenutni rezultat svojega dela v tem pogovornem oknu.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	hd_id5566778803b				0	sl	Prejšnja barva				20200411 15:09:53
