helpcontent2	source\text\sbasic\shared\01170101.xhp	0	help	hd_id3153072				0	sl	Besedilo pomoči				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01170101.xhp	0	help	par_id3147502				0	sl	\<ahelp hid=\".\"\>Vnesite besedilo za pomoč, ki se prikazuje kot namig (pomoč v oblačku), če se z miško ustavite nad kontrolnikom.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01170101.xhp	0	help	hd_id3154400				0	sl	URL pomoči				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01170101.xhp	0	help	par_id3150431				0	sl	\<ahelp hid=\".\"\>Navedite URL za pomoč, ki jo pokličete, če pritisnete F1 s pozornostjo na konkretnem kontrolniku. Uporabite npr. obliko HID:1234, da pokličete pomoč z ID 1234.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01170101.xhp	0	help	par_id4171269				0	sl	Okoljsko spremenljivko HELP_DEBUG nastavite na vrednost 1, če želite namesto razširjenih namigov videti številke pomoči Help-ID.				20200411 15:09:53
