helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3149319				0	sl	\<ahelp hid=\"HID_SMA_ALIGNCX\"\>Dodeli sredinsko poravnavo "a" in vstavi ogrado.\</ahelp\> Vtipkate lahko tudi \<emph\>alignc<?>\</emph\> neposredno v okno \<emph\>Ukazi\</emph\>.				20200411 15:09:53
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_idN10352				0	sl	\<image id=\"img_id3155583\" src=\"starmath/res/co21911.png\" width=\"0.3335inch\" height=\"0.3335inch\"\>\<alt id=\"alt_id3155583\"\>Ikona\</alt\>\</image\>				20200411 15:09:53
