helpcontent2	source\text\simpress\guide\table_insert.xhp	0	help	par_id0916200804080063				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Če ni trenutno izbrana nobena celica, bodo izbrane vse vrstice. Če so izbrane celice, bodo izbrane vse vrstice, ki vsebujejo izbrane celice.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\simpress\guide\table_insert.xhp	0	help	par_id091620080408008				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Če ni trenutno izbrana nobena celica, bo nova vrstica vstavljena na dno tabele. Če so izbrane celice, bo vstavljenih natanko toliko vrstic, kolikor jih obsega izbor, in sicer bodo vstavljene pod izborom.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\simpress\guide\table_insert.xhp	0	help	par_id0916200804080050				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Vse vrstice v trenutnem izboru bodo izbrisane.\</ahelp\>				20200411 15:09:53
