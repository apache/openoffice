helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3154142				0	sl	\<ahelp hid=\"SVX_CHECKBOX_RID_SVX_MDLG_HANGULHANJA_CB_HANGUL_ONLY\"\>Označite, če želite pretvoriti le hangulske znake. Ne pretvori znakov Hanja.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06200000.xhp	0	help	hd_id3150823				0	sl	Samo Hanja				20200411 15:09:53
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3156023				0	sl	\<ahelp hid=\"SVX_CHECKBOX_RID_SVX_MDLG_HANGULHANJA_CB_HANJA_ONLY\"\>Označite, če želite pretvoriti le Hanja. Ne pretvori hangulskih znakov.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06200000.xhp	0	help	hd_id3152360				0	sl	Prezri				20200411 15:09:53
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3153896				0	sl	\<ahelp hid=\"HID_HANGULDLG_BUTTON_IGNORE\"\>V trenutnem izboru ne pride do sprememb. Naslednja beseda ali znak bo izbran za pretvorbo.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06200000.xhp	0	help	hd_id3148550				0	sl	Vedno prezri				20200411 15:09:53
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3154937				0	sl	\<ahelp hid=\"HID_HANGULDLG_BUTTON_IGNOREALL\"\>Trenutni izbor ne bo spremenjen in vsakič, ko bo zaznan enak izbor, ga program samodejno preskoči.\</ahelp\> Naslednja beseda ali znak bo izbran za pretvorbo. Seznam prezrtega besedila je veljaven le za trenutno sejo $[officename].				20200411 15:09:53
