helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149025				0	sl	VDB(stroški; rešeno; življenjska_doba; S; konec; faktor; vrsta)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150692				0	sl	\<emph\>Strošek\</emph\> je začetna vrednost premoženja.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155369				0	sl	\<emph\>Rešeno\</emph\> je vrednost sredstva na koncu njegove življenjske dobe.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154954				0	sl	\<emph\>Življenjska_doba\</emph\> je amortizacijska doba vrednostnega papirja.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3152817				0	sl	\<emph\>S\</emph\> je začetek amortizacije. A morate vnesti v istih datumskih enotah kot trajanje.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153221				0	sl	\<emph\>Konec\</emph\> je konec amortizacijske dobe.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3147536				0	sl	\<emph\>Faktor\</emph\> (neobvezno) je faktor, za katerega se amortizacija zmanjšuje. Če ne vnesete vrednosti, je privzeti faktor 2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154865	232			0	sl	\<emph\>Vrsta \</emph\>je neobvezen parameter. Vrsta=1 pomeni preklop na linearno amortizacijo. Pri Vrsta=0 ni preklopa.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_idN10A0D				0	sl	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3148429				0	sl	Primer				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153927				0	sl	Kaj je dvojna amortizacija pri padajoči metodi za obdobje, če so začetni stroški 35.000 denarnih enot in vrednost amortizacije na koncu 7.500 denarnih enot? Obdobje amortizacije je 3 leta. Izračuna se amortizacija od 10. do 20. obdobja.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155991				0	sl	\<item type=\"input\"\>=VDB(35000;7500;36;10;20;2)\</item\> = 8603,80 denarnih enot. Amortizacija med 10. in 20. obdobjem je 8.603,80 denarnih enot.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3147485				0	sl	\<bookmark_value\>računanje;notranja stopnja donosa, neredna plačila\</bookmark_value\>\<bookmark_value\>notranje stopnje donosa;neredna plačila\</bookmark_value\>\<bookmark_value\>funkcija XIRR\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3147485				0	sl	XIRR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145614				0	sl	\<ahelp hid=\"HID_AAI_FUNC_XIRR\"\>Izračuna notranjo stopnjo donosa za seznam plačil z različnimi datumi.\</ahelp\> Izračun temelji na osnovi 365 dni na leto, brez prestopnih let.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_idN10E62				0	sl	Če so plačila opravljena ob rednih intervalih, uporabite funkcijo IRR.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3146149				0	sl	Skladnja				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149826				0	sl	XIRR(vrednosti; datumi; ocena)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3163821				0	sl	\<emph\>Vrednosti\</emph\> in \<emph\>datumi\</emph\> se nanašata na niz plačil in niz sorodnih datumskih vrednosti. Prvi datumski par določa začetek načrta za odplačevanje. Vse druge datumske vrednosti morajo biti poznejše, ne rabijo pa biti v vrstnem redu. Niz vrednosti mora vsebovati vsaj eno negativno in eno pozitivno vrednost (računi in pologi).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149708				0	sl	\<emph\>Ocena\</emph\> (neobvezno) je ocena, ki jo lahko vnesete za notranjo stopnjo donosa. Prizeto znaša 10%.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3145085				0	sl	Primer				20200411 15:09:53
