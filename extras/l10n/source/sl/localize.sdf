helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	tit				0	sl	WEEKNUM				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	bm_id3159161				0	sl	\<bookmark_value\>funkcija WEEKNUM\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	hd_id3159161				0	sl	\<variable id=\"weeknum\"\>\<link href=\"text/scalc/01/func_weeknum.xhp\"\>WEEKNUM\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3149770				0	sl	\<ahelp hid=\"HID_FUNC_KALENDERWOCHE\"\>WEEKNUM izračuna številko tedna v letu za notranjo datumsko vrednost.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_idN105E4				0	sl	Mednarodni standard ISO 8601 določa, da je ponedeljek prvi dan v tednu. Teden, ki leži na meji med dvema letoma, dobi številko v tistem letu, kjer je največ njegovih dni. To pomeni, da je številka tedna 1 v kateremkoli letu tisti teden, ki vsebuje \<emph\>4. januar\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	hd_id3153055				0	sl	Skladnja				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3147236				0	sl	WEEKNUM(število; način)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3147511				0	sl	\<emph\>Število\</emph\> je notranja datumska številka.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3154269				0	sl	\<emph\>Način\</emph\> nastavi začetek tedna in vrsto izračuna.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3148930				0	sl	1 = nedelja				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3154280				0	sl	2 = ponedeljek				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	hd_id3146948				0	sl	Primeri				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3150704				0	sl	=WEEKNUM("01.01.1995";1) vrne 1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3149792				0	sl	=WEEKNUM("01.01.1995";2) vrne 52. Če se teden začne s ponedeljkom, nedelja pripada zadnjemu tednu prejšnjega leta.				20200411 15:09:53
