helpcontent2	source\text\shared\explorer\database\rep_navigator.xhp	0	help	par_id9141819				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Če je vključena Globoka prečesava, so funkcije ovrednotene z upoštevanjem vseh nižjih ravni hierarhije. To je uporabno npr. za oštevilčevanje vrstic. Če Globoka prečesava ni vključena, je ocenjena le prva raven hierarhije.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\explorer\database\rep_navigator.xhp	0	help	par_id6354869				0	sl	\<ahelp hid=\".\" visibility=\"hidden\"\>Če je vključena Predocenitev, so funkcije ocenjene šele tedaj, ko je poročilo dokončano.\</ahelp\>				20200411 15:09:53
