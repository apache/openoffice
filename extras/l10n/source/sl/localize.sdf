helpcontent2	source\text\shared\05\00000120.xhp	0	help	bm_id3150672				0	sl	\<bookmark_value\>pomoč; namigi pomoči\</bookmark_value\>\<bookmark_value\>namigi pomoči; pomoč\</bookmark_value\>\<bookmark_value\>Pomočnik; pomoč\</bookmark_value\>\<bookmark_value\>nasveti pomoči, glejte namigi pomoči\</bookmark_value\>\<bookmark_value\>sponkica, glejte Pomočnik\</bookmark_value\>				20200411 15:09:53
