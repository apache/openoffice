helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3150603				0	sl	\<ahelp hid=\".\"\>Obreže ali prilagodi izbrano grafiko. Grafiko lahko tudi povrnete v prvotno velikost.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3148585				0	sl	Obreži				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3152372				0	sl	To področje uporabite, če želite obrezati ali prilagoditi izbrano grafiko ali če želite okoli grafike dodati bel presledek.				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3145669				0	sl	Obdrži merilo				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3149346				0	sl	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_GRFCROP_RB_ZOOMCONST\"\>Če grafiko obrežete, se ohrani njeno prvotno merilo, tako da se spremeni le njena velikost.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3156426				0	sl	Obdrži velikost podobe				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3155892				0	sl	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_GRFCROP_RB_SIZECONST\"\>Če grafiko obrežete, se ohrani njena prvotna velikost, tako da se spremeni le njeno merilo. Če želite zmanjšati merilo grafike, izberite to možnost, v polja za obrezovanje pa vnesite negativne vrednosti. Če želite povečati merilo grafike, izberite to možnost, v polja za obrezovanje pa vnesite pozitivne vrednosti.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3153683				0	sl	Levo				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3145313				0	sl	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_LEFT\"\>Če izberete možnost \<emph\>Ohrani merilo\</emph\>, vnesite pozitivno količino, če želite obrezati levi rob grafike, ali negativno količino, če želite levo od grafike dodati bel presledek. Če izberete možnost \<emph\>Obdrži velikost podobe\</emph\>, vnesite pozitivno količino, če želite povečati vodoravno merilo grafike, ali negativno količino, če želite zmanjšati vodoravno merilo grafike.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3163803				0	sl	Desno				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3145382				0	sl	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_RIGHT\"\>Če izberete možnost \<emph\>Ohrani merilo\</emph\>, vnesite pozitivno količino, če želite obrezati desni rob grafike, ali negativno količino, če želite desno od grafike dodati bel presledek. Če izberete možnost \<emph\>Obdrži velikost podobe\</emph\>, vnesite pozitivno količino, če želite povečati vodoravno merilo grafike, ali negativno količino, če želite zmanjšati vodoravno merilo grafike.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3156153				0	sl	Zgoraj				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3154514				0	sl	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_TOP\"\>Če izberete možnost \<emph\>Ohrani merilo\</emph\>, vnesite pozitivno količino, če želite obrezati zgornji rob grafike, ali negativno količino, če želite nad grafiko dodati bel presledek. Če izberete možnost \<emph\>Obdrži velikost podobe\</emph\>, vnesite pozitivno količino, če želite povečati navpično merilo grafike, ali negativno količino, če želite zmanjšati navpično merilo grafike.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3149956				0	sl	Spodaj				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3150084				0	sl	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_BOTTOM\"\>Če izberete možnost \<emph\>Ohrani merilo\</emph\>, vnesite pozitivno količino, če želite obrezati spodnji rob grafike, ali negativno količino, če želite pod grafiko dodati bel presledek. Če izberete možnost \<emph\>Obdrži velikost podobe\</emph\>, vnesite pozitivno količino, če želite povečati navpično merilo grafike, ali negativno količino, če želite zmanjšati navpično merilo grafike.\</ahelp\>				20200411 15:09:53
