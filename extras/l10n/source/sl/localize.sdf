helpcontent2	source\text\swriter\01\04090200.xhp	0	help	tit				0	sl	Določanje pogojev				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	bm_id3145828				0	sl	\<bookmark_value\>logični izrazi\</bookmark_value\>\<bookmark_value\>formuliranje pogojev\</bookmark_value\>\<bookmark_value\>pogoji; v poljih in odsekih\</bookmark_value\>\<bookmark_value\>polja;določanje pogojev\</bookmark_value\>\<bookmark_value\>odseki;določanje pogojev\</bookmark_value\>\<bookmark_value\>spremenljivke; v pogojih\</bookmark_value\>\<bookmark_value\>uporabniški podatki;v pogojih\</bookmark_value\>\<bookmark_value\>zbirke podatkov;v pogojih\</bookmark_value\>\<bookmark_value\>skrivanje; polja zbirke podatkov\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	hd_id3145828				0	sl	\<variable id=\"defining_conditions\"\>\<link href=\"text/swriter/01/04090200.xhp\"\>Določanje pogojev\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3145242				0	sl	Pogoji so logični izrazi, ki jih lahko uporabite za nadzor prikaza \<link href=\"text/swriter/01/04090000.xhp\"\>polj\</link\> in \<link href=\"text/swriter/01/04020000.xhp\"\>odsekov\</link\> v dokumentu. Čeprav naslednje primere uporabljamo pri poljih, jih lahko uporabite tudi pri odsekih.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3147171				0	sl	Pogoje lahko določite za naslednje vrste polj:				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3151185				0	sl	Pogojno besedilo: prikaže besedilo A, če je pogoj izpolnjen, ali pa besedilo B, če pogoj ni izpolnjen.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3149289				0	sl	Skrito besedilo: skrije vsebino polja, če je pogoj izpolnjen.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3145412				0	sl	Skriti odstavek: skrije odstavek, če je pogoj izpolnjen.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3147515				0	sl	Poljubni zapis in naslednji zapis: nadzorujeta dostop do zapisov zbirke podatkov.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3149802	18			0	sl	Najlažji način za določitev pogoja je, da vnesete logični izraz direktno v polje \<emph\>Pogoj \</emph\>in pri tem uporabite naslednje vrednosti:				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3153677				0	sl	TRUE				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3152960				0	sl	Pogoj je vedno izpolnjen. Lahko vnesete katerokoli vrednost, ki ni enaka 0, kot pogojno besedilo.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3155900				0	sl	FALSE				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3154191				0	sl	Pogoj ni izpolnjen. Vedno lahko vnesete vrednost 0.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3147090	23			0	sl	Če pustite polje \<emph\>Pogoj \</emph\>prazno, se pogoj razume kot neizpolnjen.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3148980				0	sl	Ko določite pogoj, uporabite enake \<link href=\"text/swriter/02/14020000.xhp\"\>elemente\</link\> za določitev formule, in sicer primerjalne operatorje, matematične in statistične funkcije, obliko številk, spremenljivke in konstante.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3153638				0	sl	Uporabite lahko naslednje vrste spremenljivk, potem ko določite pogoj:				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3155135				0	sl	Vnaprej določene \<link href=\"text/swriter/02/14020000.xhp\"\>$[officename] spremenljivke\</link\>, ki uporabljajo statistiko za lastnosti dokumenta				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3156273				0	sl	Spremenljivke po meri, ki se jih ustvari s poljem "Nastavi spremenljivko"				20200411 15:09:53
