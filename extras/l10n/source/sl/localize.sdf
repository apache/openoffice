helpcontent2	source\text\shared\02\02160000.xhp	0	help	par_idN10743				0	sl	Če želite poudariti samo eno besedo, nanjo dvakrat kliknite.				20200411 15:09:53
helpcontent2	source\text\shared\02\02160000.xhp	0	help	par_idN10757				0	sl	Če želite izklopiti poudarjanje, pritisnite Esc.				20200411 15:09:53
