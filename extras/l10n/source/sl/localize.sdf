helpcontent2	source\text\shared\01\06050600.xhp	0	help	par_id1015655				0	sl	\<ahelp hid=\".\"\>Vnesite razdaljo od levega roba strani, na katero bo poravnan simbol oštevilčevanja.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	hd_id2336191				0	sl	Zamaknjeno na				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	par_id6081728				0	sl	\<ahelp hid=\".\"\>Vnesite razdaljo od levega roba strani do začetka vseh vrstic oštevilčenega odstavka, ki sledijo prvi vrstici.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	hd_id3154422				0	sl	Odmik				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	par_id3144438				0	sl	\<ahelp hid=\"SW:METRICFIELD:TP_NUM_POSITION:MF_BORDERDIST\"\>Določite presledek, ki naj ostane med levim robom strani (ali levim robom predmeta besedila) in levim robom besedila oštevilčenega simbola. Če trenutni odstavek uporablja zamik, se vrednost, ki jo tukaj vnesete, doda temu zamiku.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	hd_id3155179				0	sl	Relativno				20200411 15:09:53
