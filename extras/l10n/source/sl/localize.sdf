helpcontent2	source\text\swriter\01\04070100.xhp	0	help	par_id3147172				0	sl	\<ahelp hid=\"HID_ENV_ENV\" visibility=\"visible\"\>Vnesite naslovnika s polnim naslovom in povratni naslov, kot bosta izpisana na kuverti. Vnesete lahko tudi polja naslova iz zbirke podatkov (npr. iz zbirke podatkov Naslovi).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04070100.xhp	0	help	hd_id3149295				0	sl	Naslovnik				20200411 15:09:53
helpcontent2	source\text\swriter\01\04070100.xhp	0	help	par_id3145415	4			0	sl	\<ahelp hid=\"SW:MULTILINEEDIT:TP_ENV_ENV:EDT_ADDR\" visibility=\"visible\"\>Vnesite naslovnika s polnim naslovom.\</ahelp\> Lahko kliknete tudi v to polje in izberete podatkovno zbirko, tabelo in polje ter nato kliknete gumb s puščico, da vstavite polje v naslov. Če želite, lahko uporabite oblikovanje za besedilo naslova (npr. krepki tisk, podčrtano).				20200411 15:09:53
helpcontent2	source\text\swriter\01\04070100.xhp	0	help	hd_id3154102				0	sl	Pošiljatelj				20200411 15:09:53
helpcontent2	source\text\swriter\01\04070100.xhp	0	help	par_id3153527	6			0	sl	\<ahelp visibility=\"visible\" hid=\"SW:MULTILINEEDIT:TP_ENV_ENV:EDT_SEND\"\>Povratni naslov vključi na kuverto. Izberite potrditveno polje \<emph\>Pošiljatelj \</emph\>in nato vnesite povratni naslov.\</ahelp\> $[officename] samodejno vstavi vaše uporabniške podatke v polje \<emph\>Pošiljatelj\</emph\>, lahko pa tudi vnesete podatke, ki jih želite.				20200411 15:09:53
