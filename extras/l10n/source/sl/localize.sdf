helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3151180				0	sl	\<ahelp hid=\"HID_DLG_CREATE_AUTOMARK\"\>Ustvarite ali uredite seznam besed, ki jih boste vključili v abecedno kazalo.\</ahelp\> Konkordančna datoteka naniza besede, ki naj bodo navedene v abecednem kazalu, skupaj s številkami strani pojavitev.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id837427				0	sl	Z gumbom Najdi vse v pogovornem oknu Najdi in zamenjaj označite vse pojavitve besede, nato pa odprite pogovorno okno Vstavi vnos kazala, kjer besedo in vse njene pojavitve dodate v abecedno kazalo. Če želite uporabiti isto množico vnosov abecednih kazal za več dokumentov, lahko s pomočjo konkordančne datoteke vsako besedo vnesete le enkrat in seznam uporabite večkrat.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	hd_id3154645				0	sl	Za dostop do pogovornega okna Uredi konkordančno datoteko:				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3149292				0	sl	Izberite \<emph\>Vstavi - Kazala vsebine - Kazala vsebine - Kazalo/tabela\</emph\>.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3145420	21			0	sl	V polju \<emph\>Vrsta \</emph\> izberite "Abecedno kazalo".				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3154107	22			0	sl	Na področju \<emph\>Možnosti \</emph\>izberite potrditveno polje \<emph\>Konkordančna datoteka\</emph\>.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3153668				0	sl	Kliknite gumb \<emph\>Datoteka\</emph\> in nato izberite\<emph\>Nov\</emph\> ali \<emph\>Uredi\</emph\>.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3154470	24			0	sl	Konkordančna datoteka vsebuje naslednja polja: 				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3152953				0	sl	"Iskani izraz" se nanaša na vnos v kazalo, ki ga želite v dokumentu označiti.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3155896				0	sl	"Alternativni vnos" se nanaša na vnos v kazalo, za katerega želite, da se prikaže v kazalu.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3154194				0	sl	1. in 2. ključ sta matična vnosa v kazalo. "Iskani izraz" ali "Alternativni vnos" se pojavi kot podvnos pod 1. in 2. ključem.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3155184				0	sl	"Razlikuj velike in male črke" - to pomeni, da upošteva razlikovanje med velikimi in malimi črkami.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3143282				0	sl	"Samo beseda" - išče izraz kot eno samo besedo.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3147220				0	sl	Če želite omogočiti "Razlikuj velike in male črke" in "Samo beseda", kliknite na ustrezno celico in nato izberite potrditveno polje.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	hd_id3153629				0	sl	Če želite ustvariti konkordančno datoteko brez pogovornega okna Uredi konkordančno datoteko:				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3153644				0	sl	Uporabite naslednja navodila za oblikovanje, ko ustvarjate konkordančno datoteko:				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3152770				0	sl	Vsak vnos v konkordančni datoteki je v posebni vrstici.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3155142				0	sl	Vrstice s komentarji se začnejo z #.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3153354				0	sl	Za vnose uporabite naslednjo obliko:				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3149172				0	sl	Iskani izraz; Alternativni vnos, 1. ključ; 2. ključ; Razlikuj velike in male črke; Samo beseda				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3156270				0	sl	Vnosi "Razlikuj velike in male črke" in "Samo beseda" se obravnavajo kot "Ne" ali NE DRŽI, če so prazni ali ničelni (0). Vsa druga vsebina je obravnavana kot "Da" ali DRŽI.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	hd_id3145778				0	sl	Primer				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3155907				0	sl	Primer: če želite v svoje abecedno kazalo vključiti besedo "Butale" pod vnos "Mesta", vnesite naslednjo vrstico v konkordančno datoteko:				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3151370				0	sl	Butale;Butale;Mesta;;0;0 				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3151383				0	sl	 "Butale" najde tudi, če je napisan z malo začetnico.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3155866				0	sl	Za vključitev okrožja "Butalski hrib" v Butalah pod vnos "Mesta", vnesite naslednjo vrstico:				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3150116	18			0	sl	Butalski hrib;Butale;Mesta; 				20200411 15:09:53
