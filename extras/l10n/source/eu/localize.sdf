helpcontent2	source\text\sbasic\guide\show_dialog.xhp	0	help	par_id3147349				0	eu	End Sub				20200411 15:09:53
helpcontent2	source\text\sbasic\guide\show_dialog.xhp	0	help	par_id3152596				0	eu	"LoadDialog" erabili gabe, kodeari honela dei diezaiokezu:				20200411 15:09:53
helpcontent2	source\text\sbasic\guide\show_dialog.xhp	0	help	par_id3163710				0	eu	Sub Dialog1Show				20200411 15:09:53
helpcontent2	source\text\sbasic\guide\show_dialog.xhp	0	help	par_id3146985				0	eu	DialogLibraries.LoadLibrary( "Standard" )				20200411 15:09:53
helpcontent2	source\text\sbasic\guide\show_dialog.xhp	0	help	par_id3155418				0	eu	oDialog1 = CreateUnoDialog( DialogLibraries.Standard.Dialog1 )				20200411 15:09:53
