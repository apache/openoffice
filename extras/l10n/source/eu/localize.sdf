helpcontent2	source\text\schart\01\04020000.xhp	0	help	par_id3150206				0	eu	\<ahelp hid=\"SCH_CHECKBOX_DLG_LEGEND_CBX_SHOW\"\>Diagramako legenda bistaratuko den edo ez zehazten du.\</ahelp\> Aukera hau ikusgai egoteko, elkarrizketa-koadroa ireki behar da \<emph\>Txertatu - Legenda\</emph\> hautatuz.				20200411 15:09:53
helpcontent2	source\text\schart\01\04020000.xhp	0	help	hd_id3150201				0	eu	Kokalekua				20200411 15:09:53
helpcontent2	source\text\schart\01\04020000.xhp	0	help	par_id3155376				0	eu	Hautatu legendaren kokalekua:				20200411 15:09:53
helpcontent2	source\text\schart\01\04020000.xhp	0	help	hd_id3152988				0	eu	Ezkerrean				20200411 15:09:53
