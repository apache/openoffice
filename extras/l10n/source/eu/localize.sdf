helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	hd_id3149012				0	eu	\<variable id=\"workday\"\>\<link href=\"text/scalc/01/func_workday.xhp\"\>WORKDAY\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	par_id3149893				0	eu	\<ahelp hid=\"HID_AAI_FUNC_WORKDAY\"\> Data gisa formatea daitekeen data-zenbakia izango da emaitza. \<emph\>Hasierako data\</emph\>tik hainbat \<emph\>Lanegun\</emph\>etara dagoen data agertuko da.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	hd_id3146944				0	eu	Sintaxia				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	par_id3154844				0	eu	WORKDAY (Hasiera-data;Egunak;Jaiegunak)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	par_id3147469				0	eu	\<emph\>Hasiera-data\</emph\>: kalkulua egiteko abiapuntu gisa erabiliko den data. Hasierako data laneguna bada, egun hori kalkuluan sartuko da.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	par_id3153038				0	eu	\<emph\>Egunak\</emph\>: lanegun kopurua. Balio positiboa sartzen bada, hasiera-data baino beranduagokoa izango da emaitza; balio negatiboa sartzen bada, aldiz, hasiera-data baino lehenagokoa izango da.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	par_id3150693				0	eu	\<emph\>Jaiegunak\</emph\>: aukerako jaiegunen zerrenda. Egun hauetan ez da lanik egiten. Sartu jaiegunen zerrenda duen gelaxka-area.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	hd_id3150141				0	eu	Adibidea				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	par_id3152782				0	eu	Zein egun izango da 2001eko abenduaren 1aren ondoren 17 lanegun igarotakoan? Sartu "2001/12/1" hasierako data gisa C3 gelaxkan eta lanegunen kopurua D3 gelaxkan. F3 eta J3 arteko gelaxkek ondorengo Eguberri eta Urte berri jaiegunak dituzte:"2001/12/24", "2001/12/25", "2001/12/26", "2001/12/31", "2002/01/01".				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	par_id3146142				0	eu	=WORKDAY(C3;D3;F3;J3) formulak 2001/12/28 ematen du emaitza gisa. Formateatu dataren serie-zenbakia data gisa.				20200411 15:09:53
