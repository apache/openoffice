helpcontent2	source\text\scalc\guide\numbers_text.xhp	0	help	par_id0908200901265374				0	eu	CCYY-MM-DDThh:mm:ss,s				20200411 15:09:53
helpcontent2	source\text\scalc\guide\numbers_text.xhp	0	help	par_id0908200901265327				0	eu	CCYY-MM-DDThh:mm:ss.s				20200411 15:09:53
helpcontent2	source\text\scalc\guide\numbers_text.xhp	0	help	par_id0908200901265399				0	eu	hh:mm				20200411 15:09:53
helpcontent2	source\text\scalc\guide\numbers_text.xhp	0	help	par_id0908200901265347				0	eu	hh:mm:ss				20200411 15:09:53
