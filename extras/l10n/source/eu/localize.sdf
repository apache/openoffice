helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3157849				0	eu	\<emph\>Matrizea\</emph\>: alderantzikatu beharreko matrize karratua.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN113EE				0	eu	\<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3157868				0	eu	Adibidea				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149638				0	eu	Hautatu area karratu bat eta hautatu MINVERSE. Hautatu emaitza-matrizea, hautatu \<emph\>Matrizea\</emph\> eremua eta egin klik \<emph\>Ados\</emph\> botoian.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3148546				0	eu	\<bookmark_value\>MMULT funtzioa\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3148546				0	eu	MMULT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3148518				0	eu	\<ahelp hid=\"HID_FUNC_MMULT\"\>Bi matrizeren matrize-biderketa kalkulatzen du.\</ahelp\> 1. matrizearen zutabe kopuruak bat etorri behar du 2. matrizeko errenkada kopuruarekin. Matrize karratuak errenkada eta zutabeen kopuru bera edukiko du.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3146767				0	eu	Sintaxia				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3150798				0	eu	MMULT(matrizea; matrizea)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3150812				0	eu	\<emph\>Matrizeak\</emph\>, lehen posizioan, adierazten du matrize-biderketan erabilitako lehen matrizea.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3152553				0	eu	\<emph\>Matrizeak\</emph\>, bigarren posizioan, adierazten du errenkada kopuru bereko bigarren matrizea.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN114C3				0	eu	\<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3152574				0	eu	Adibidea				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3146826				0	eu	Hautatu area karratu bat. Hautatu MMULT funtzioa. Hautatu lehen \<emph\>Matrizea\</emph\>, eta, ondoren, hautatu bigarren \<emph\>matrizea\</emph\>. \<emph\>Funtzioen morroia\</emph\> erabiliz, hautatu \<emph\>Matrizea\</emph\> kontrol-laukia. Egin klik \<emph\>Ados\</emph\> botoian.  Emaitza-matrizea hautatutako lehen arean agertuko da.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3154970				0	eu	\<bookmark_value\>TRANSPOSE funtzioa\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3154970				0	eu	TRANSPOSE				20200411 15:09:53
