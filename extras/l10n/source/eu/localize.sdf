helpcontent2	source\text\swriter\01\04120100.xhp	0	help	hd_id3154480				0	eu	1. gakoa				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	par_id3152953				0	eu	\<ahelp hid=\"HID_INSERT_IDX_MRK_PRIM_KEY\"\>Hemen sartu duzun hitzaren azpisarrera bihurtzen du uneko hautapena. Adibidez, "cold" hautatu eta "weather" sartzen baduzu 1. gako gisa, indize-sarrera "weather, cold" izango da.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	hd_id3154572				0	eu	2. gakoa				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	par_id3155904				0	eu	\<ahelp hid=\"HID_INSERT_IDX_MRK_SEC_KEY\"\>Uneko hautapena 1. gakoaren azpi-azpisarrera bihurtzen du. Adibidez, "cold" hautatu eta "weather" sartzen baduzu 1. gako gisa eta "winter" 2. gako gisa, indize-sarrera "weather, winter, cold" izango da.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	hd_id3155174				0	eu	Irakurketa fonetikoa				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	par_id3149484				0	eu	\<ahelp hid=\"HID_INSERT_IDX_MRK_PHONETIC_READING\"\>Sartu dagokion sarrerarentzako irakurketa fonetikoa. Adibidez, japonierako kanji hitz batek ahoskera bat baino gehiago baditu, sartu dagokion ahoskera katakana hitz gisa. Kanji hitza irakurketa fonetikoaren sarreraren arabera ordenatzen da.\</ahelp\> Aukera hori hizkuntza asiarrak onartzen badira bakarrik egongo da erabilgarri.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	hd_id3143284				0	eu	Sarrera nagusia				20200411 15:09:53
