helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3153222				0	eu	\<item type=\"menuitem\"\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Hobespenak\</caseinline\>\<defaultinline\>Tresnak - Aukerak\</defaultinline\>\</switchinline\> - $[officename] - Orokorra\</item\> aukeran bi digituko zenbakizko sarrera batek zein 20xx urte adieraziko duen ezar dezakezu.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3155817				0	eu	\<emph\>Hilabetea\</emph\> 1 eta 12 arteko osoko zenbakia da eta hilabetea adierazten du.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3153183				0	eu	\<emph\>Eguna\</emph\> 1 eta 31 arteko osoko zenbakia da eta hilabeteko eguna adierazten du.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3156260				0	eu	Hilabete eta egunaren balioak behar baino handiagoak badira, hurrengo zifrara pasatzen dira. \<item type=\"input\"\>=DATE(00;12;31)\</item\> funtzioa sartzen baduzu, "00/12/31" izango da emaitza. Bestela, \<item type=\"input\"\>=DATE(00;13;31)\</item\> sartzen baduzu, "01/01/31."				20200411 15:09:53
