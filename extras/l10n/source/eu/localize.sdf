helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN106F0				0	eu	\<ahelp hid=\".\"\>Elkarrizketa-koadroa zabaltzen edo murrizten du. \<emph\>Gehiago\</emph\> botoia datu-eremuentzat bakarrik egongo da ikusgai.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN106F3				0	eu	Aukerak				20200411 15:09:53
