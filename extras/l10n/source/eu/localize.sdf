helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3938413				0	eu	\<emph\>Urtea\</emph\> 1583 eta 9956 edo 0 eta 99 arteko osoko zenbakia izango da. Beste opor batzuk ere kalkula ditzakezu besterik gabe data hau gehituz.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3156156				0	eu	Pazko Bigarrena = EASTERSUNDAY(Urtea) + 1				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3147521				0	eu	Ostiral Santua = EASTERSUNDAY(Urtea) - 2				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3146072				0	eu	Mendekoste Igandea = EASTERSUNDAY(Urtea) + 49				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3149553				0	eu	Mendekoste Astelehena = EASTERSUNDAY(Urtea) +50				20200411 15:09:53
