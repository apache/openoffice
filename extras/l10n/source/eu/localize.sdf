helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_id3150718				0	eu	Baldintzari dagozkion zenbaki guztiak. Elkarrizketa-koadroa irekitzen den hurrengoan, formateatu egingo dira sartutako balioak.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_id3146969				0	eu	Ordua				20200411 15:09:53
