helpcontent2	source\text\swriter\guide\pagebackground.xhp	0	help	par_idN10812				0	eu	$[officename] aplikazioak orrialde-estiloak erabiltzen ditu dokumentuko orrialdeen atzeko planoa zehazteko. Adibidez, dokumentuko orrialde baten edo gehiagoren atzeko planoa ur-marka bihurtzeko, Ur-marka atzeko planoa erabiltzen duen orrialde-estiloa sortu behar duzu, eta ondoren, aplikatu orrialde-estiloa orrialdeei.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\pagebackground.xhp	0	help	par_idN10820				0	eu	Orrialdearen atzeko planoa aldatzeko				20200411 15:09:53
