helpcontent2	source\text\schart\01\04020000.xhp	0	help	hd_id3153816				0	eu	Goian				20200411 15:09:53
helpcontent2	source\text\schart\01\04020000.xhp	0	help	par_id3153912				0	eu	\<ahelp hid=\"SCH:RADIOBUTTON:TP_LEGEND_POS:RBT_TOP\"\>Diagramaren goiko aldean kokatuko da legenda.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04020000.xhp	0	help	hd_id3144773				0	eu	Eskuinean				20200411 15:09:53
helpcontent2	source\text\schart\01\04020000.xhp	0	help	par_id3155268				0	eu	\<ahelp hid=\"SCH:RADIOBUTTON:TP_LEGEND_POS:RBT_RIGHT\"\>Diagramaren eskuinaldean kokatuko da legenda.\</ahelp\>				20200411 15:09:53
