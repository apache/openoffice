helpcontent2	source\text\shared\02\01170000.xhp	0	help	par_id3153927				0	eu	\<ahelp hid=\".uno:CheckBox\"\>Kontrol-laukia sortzen du.\</ahelp\> Inprimakietan funtzio bat aktibatu edo desaktibatzeko aukera emango dizu kontrol-laukiak.				20200411 15:09:53
helpcontent2	source\text\shared\02\01170000.xhp	0	help	hd_id3153794				0	eu	Testu-koadroa				20200411 15:09:53
helpcontent2	source\text\shared\02\01170000.xhp	0	help	par_id3163665				0	eu	\<image id=\"img_id3153266\" src=\"res/commandimagelist/sc_edit.png\" width=\"0.2228in\" height=\"0.2228in\"\>\<alt id=\"alt_id3153266\"\>Icon\</alt\>\</image\>				20200411 15:09:53
helpcontent2	source\text\shared\02\01170000.xhp	0	help	par_id3158444				0	eu	\<ahelp hid=\".uno:Edit\"\>Testu-koadro bat sortzen du.\</ahelp\> Testu-koadroak erabiltzaileak testuak sartzeko eremuak dira. Inprimakietan, testu-koadroek datuak bistaratzen dituzte edo datu berriak sartzeko aukera eskaintzen dute.				20200411 15:09:53
helpcontent2	source\text\shared\02\01170000.xhp	0	help	hd_id3151218				0	eu	Eremu formatuduna				20200411 15:09:53
