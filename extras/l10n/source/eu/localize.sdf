helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3149168	6			0	eu	\<ahelp hid=\"HID_GRID_TRAVEL_NEW\" visibility=\"hidden\"\>Erregistro berri bat txertatzen du uneko taulan.\</ahelp\>Erregistro bat sortzeko, egin klik taula-ikuspegiaren behealdean dagoen asteriskoa (*) botoian. Errenkada huts bat gehituko da taularen amaieran.				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3152920				0	eu	\<ahelp hid=\".\" visibility=\"hidden\"\>Hautatu sortu nahi duzun erregistro mota. $[officename](e)k zenbaki bat txertatzen du, hemen hautatutako motari dagokion erregistroaren \<emph\>Mota\</emph\> zutabean.\</ahelp\>				20200411 15:09:53
