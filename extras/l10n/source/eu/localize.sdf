helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3151030				0	eu	\<bookmark_value\>MDETERM funtzioa\</bookmark_value\>\<bookmark_value\>determinanteak\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3151030				0	eu	MDETERM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154073				0	eu	\<ahelp hid=\"HID_FUNC_MDET\"\>Matrizearen determinantea ematen du.\</ahelp\> Funtzio honek balio bat ematen du uneko gelaxkan; ez da beharrezkoa emaitzentzako area bat definitzea.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3156366				0	eu	Sintaxia				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3156380				0	eu	MDETERM(matrizea)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3150290				0	eu	\<emph\>Matrizea\</emph\>: determinanteak definitzen dituen matrize-karratua.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11035				0	eu	Matrize-funtzioei buruzko sarrera orokor bat aurki dezakezu orri honen goialdean.				20200411 15:09:53
