helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3152473	71			0	eu	\<ahelp hid=\".\"\>Click the\<emph\> Next \</emph\>button, and the wizard uses the current dialog settings and proceeds to the next step. If you are on the last step, this button becomes \<emph\>Create\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3149670				0	eu	Atzera				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3145068				0	eu	\<ahelp hid=\"OFFMGR_PUSHBUTTON_RID_OFADLG_OPTIONS_TREE_PB_BACK\"\>Aldatutako balioak baztertu eta $[officename](e)ko balio lehenetsiak berrezartzen ditu.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3148755				0	eu	Leheneratu				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3149651				0	eu	\<ahelp hid=\"HID_TABDLG_RESET_BTN\"\>Uneko fitxan egindako aldaketak baztertu, eta elkarrizketa hau ireki denean aplikagarri zirenak ezartzen ditu. Elkarrizketa ixtean ez da segurtasun-galderarik agertzen.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3143278				0	eu	Leheneratu				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3150791				0	eu	\<ahelp hid=\"HID_TABDLG_RESET_BTN\"\>Aldatutako balioak baztertu, eta lehenetsitako balioak berrezartzen ditu. \</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154331				0	eu	Ez da segurtasun-galderarik agertzen. Ados sakatuz elkarrizketa berresten baduzu, berrezarri egingo dira elkarrizketa-koadroko ezarpen guztiak.				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3145173				0	eu	Estandarra				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154153				0	eu	\<ahelp hid=\"HID_TABDLG_STANDARD_BTN\"\>Elkarrizketa-koadroan dauden balioen ordez, lehenetsitako instalazio-balioak berrezartzen ditu.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154299				0	eu	Ez da segurtasun-galderarik egiten balio lehenetsiak berrezarri aurretik.				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3147502				0	eu	Atzera				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3150439				0	eu	\<ahelp hid=\"HID_TABDLG_STANDARD_BTN\"\>Aurreko urratsean elkarrizketa-koadroan egindako aukerak ikusi ahal izan dituzu. Uneko ezarpenak ez dira aldatuko. \</ahelp\> Bigarren orrialdetik aurrera soilik egongo da aktibatuta botoi hau.				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3147352				0	eu	Gehiago				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3155314	53			0	eu	\<ahelp hid=\"HID_TABDLG_STANDARD_BTN\"\>Egin klik\<emph\> Gehiago\</emph\> botoian, elkarrizketa-koadroa zabaldu eta aukera gehiago ikusi ahal izateko. Egin klik berriz ere, elkarrizketa-koadroa leheneratzeko.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3161659	41			0	eu	\<variable id=\"siehe\"\>Ikus itzazu, halaber, ondoko funtzioak: \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3147418				0	eu	\<variable id=\"regulaer\"\>The search supports \<link href=\"text/shared/01/02100001.xhp\" name=\"regular expressions\"\>regular expressions\</link\>. You can enter "all.*", for example to find the first location of "all" followed by any characters. If you want to search for a text that is also a regular expression, you must precede every character with a \\ character. You can switch the automatic evaluation of regular expression on and off in \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - \<link href=\"text/shared/optionen/01060500.xhp\"\>%PRODUCTNAME Calc - Calculate\</link\>.\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3163714	56			0	eu	\<variable id=\"wahr\"\>Errorea gertatzen bada, balio logiko bat edo zenbakizko bat emango du funtzioak. \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154145	54			0	eu	\<variable id=\"kontext\"\>(Komando hau \<link href=\"text/shared/00/00000005.xhp#kontextmenue\" name=\"context menu\"\>laster-menua\</link\>ren bidez bakarrik erabil daiteke). \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3152791	61			0	eu	\<variable id=\"wiederholen\"\>Tresna batean klik bikoitza egiten baduzu, tresna hori behin eta berriz erabili ahal izango duzu. Klik bakar bat egiten baduzu tresnan, azkeneko hautapenera itzuliko da, ataza osatu ondoren. \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id9345377				0	eu	\<variable id=\"ShiftF1\"\>Press Shift+F1 and point to a control to learn more about that control. \</variable\>				20200411 15:09:53
