helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3145669				0	eu	Mantendu eskala				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3149346				0	eu	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_GRFCROP_RB_ZOOMCONST\"\>Mozten ari zarenean grafikoaren jatorrizko eskala mantentzen du. Horrela, grafikoaren tamaina aldatzen da soilik.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3156426				0	eu	Mantendu irudi-tamaina				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3155892				0	eu	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_GRFCROP_RB_SIZECONST\"\>Mozten ari zarenean grafikoaren jatorrizko tamaina mantentzen du. Horrela, eskalaren tamaina aldatzen da soilik. Grafikoaren eskala txikitzeko, hautatu aukera hau eta sartu balio negatiboak mozketa-koadroetan. Grafikoaren eskala handitzeko, sartu balio positiboak mozketa-koadroetan.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3153683				0	eu	Ezkerrean				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3145313				0	eu	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_LEFT\"\> \<emph\>Mantendu eskala\</emph\> aukera hautatzen bada, sartu kopuru positibo bat grafikoaren ezker ertza mozteko edo kopuru negatibo bat zuriunea gehitzeko grafikoaren ezkerraldean. \<emph\>Mantendu irudi-tamaina\</emph\> aukeratzen bada, sartu kopuru positibo bat grafikoaren eskala horizontala handitzeko edo kopuru negatibo bat grafikoaren eskala horizontala txikitzeko.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3163803				0	eu	Eskuinean				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3145382				0	eu	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_RIGHT\"\>\<emph\>Mantendu eskala\</emph\> aukera hautatzen bada, sartu kopuru positibo bat grafikoaren eskuin ertza mozteko edo kopuru negatibo bat zuriunea gehitzeko grafikoaren eskuinaldean. \<emph\>Mantendu irudi-tamaina\</emph\> aukeratzen bada, sartu kopuru positibo bat grafikoaren eskala horizontala handitzeko edo kopuru negatibo bat grafikoaren eskala horizontala txikitzeko.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3156153				0	eu	Goian				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3154514				0	eu	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_TOP\"\> \<emph\>Mantendu eskala\</emph\> aukera hautatzen bada, sartu kopuru positibo bat grafikoaren goi ertza mozteko edo kopuru negatibo bat zuriunea gehitzeko grafikoaren goialdean. \<emph\>Mantendu irudi-tamaina\</emph\> aukeratzen bada, sartu kopuru positibo bat grafikoaren eskala bertikala handitzeko edo kopuru negatibo bat grafikoaren eskala bertikala txikitzeko.\</ahelp\>				20200411 15:09:53
