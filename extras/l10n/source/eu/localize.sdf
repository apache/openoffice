helpcontent2	source\text\swriter\01\04120221.xhp	0	help	hd_id3147569				0	eu	Egitura eta formatua				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120221.xhp	0	help	par_id3154638	7			0	eu	\<emph\>Egitura\</emph\> lerroak aurkibidearen kodea bistaratzen du hautatutako izenburu-mailarentzat. Izenburu-mailaren itxura aldatzeko, kodeak edo testua sar ditzakezu lerro honetako koadro hutsetan. Koadro huts batean edo kode batean ere egin dezakezu klik, eta ondoren, sakatu kode-botoia.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120221.xhp	0	help	par_id3149292	35			0	eu	\<ahelp hid=\".\" visibility=\"hidden\"\>\<emph\>Egitura\</emph\> lerroan dagoen gainerakoa bistaratzen du.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120221.xhp	0	help	par_id3147512	8			0	eu	Kode bat \<emph\>Egitura\</emph\> lerrotik ezabatzeko, egin klik kodean eta sakatu \<item type=\"keycode\"\>Ezabatu\</item\> tekla.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120221.xhp	0	help	par_id3149806	9			0	eu	\<emph\>Egitura\</emph\> lerroko kode bat ordezteko, egin klik kodean eta ondoren, sakatu kode-botoia.				20200411 15:09:53
