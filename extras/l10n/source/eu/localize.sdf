helpcontent2	source\text\schart\01\04010000.xhp	0	help	hd_id3147345				0	eu	Tituluak				20200411 15:09:53
helpcontent2	source\text\schart\01\04010000.xhp	0	help	par_id3150298				0	eu	\<variable id=\"titel\"\>\<ahelp hid=\".uno:InsertMenuTitles\"\>Opens a dialog to enter or modify the titles in a chart.\</ahelp\>\</variable\> You can define the text for the main title, subtitle and the axis labels, and specify if they are displayed.				20200411 15:09:53
helpcontent2	source\text\schart\01\04010000.xhp	0	help	hd_id3150207				0	eu	Titulu nagusia				20200411 15:09:53
helpcontent2	source\text\schart\01\04010000.xhp	0	help	par_id3150371				0	eu	\<ahelp hid=\"SCH:EDIT:DLG_TITLE:EDT_MAINTITLE\"\>\<emph\>Titulu nagusia\</emph\>ren aukera markatzen baduzu, titulu nagusia aktibatuko da. Sartu erabili nahi duzun titulua dagokion testu-eremuan.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04010000.xhp	0	help	hd_id3146980				0	eu	Azpititulua				20200411 15:09:53
helpcontent2	source\text\schart\01\04010000.xhp	0	help	par_id3149404				0	eu	\<ahelp hid=\"SCH:EDIT:DLG_TITLE:EDT_SUBTITLE\"\>\<emph\>Azpititulua\</emph\>ren aukera markatzen baduzu, azpititulua aktibatuko da. Sartu erabili nahi duzun titulua dagokion testu-eremuan.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04010000.xhp	0	help	par_id3152901				0	eu	\<variable id=\"sytexttitel\"\>\<ahelp hid=\".uno:ToggleTitle\"\>Titulua eta azpititulua erakusteko edo ezkutatzeko, egin klik Formatu-barrako \<emph\>Erakutsi/Ezkutatu titulua\</emph\> aukeran.\</ahelp\>\</variable\>				20200411 15:09:53
