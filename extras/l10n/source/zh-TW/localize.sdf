helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3148863				0	zh-TW	<SDFIELD TYPE=DOCINFO SUBTYPE=COMMENT SDFIXED>描述</SDFIELD>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3151083				0	zh-TW	產生日期				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3153298				0	zh-TW	<SDFIELD TYPE=DOCINFO SUBTYPE=CREATE FORMAT=DATE SDNUM="1031;1031;QQ YY">1. Quartal 98</SDFIELD>				20200411 15:09:53
