helpcontent2	source\text\shared\00\00000021.xhp	0	help	par_idN107A9				0	zh-TW	*.ots				20200411 15:09:53
helpcontent2	source\text\shared\00\00000021.xhp	0	help	par_idN107AF				0	zh-TW	ODF 繪圖				20200411 15:09:53
helpcontent2	source\text\shared\00\00000021.xhp	0	help	par_idN107B4				0	zh-TW	*.odg				20200411 15:09:53
helpcontent2	source\text\shared\00\00000021.xhp	0	help	par_idN107BA				0	zh-TW	ODF 繪圖範本				20200411 15:09:53
helpcontent2	source\text\shared\00\00000021.xhp	0	help	par_idN107BF				0	zh-TW	*.otg				20200411 15:09:53
helpcontent2	source\text\shared\00\00000021.xhp	0	help	par_idN107C5				0	zh-TW	ODF 簡報				20200411 15:09:53
helpcontent2	source\text\shared\00\00000021.xhp	0	help	par_idN107CA				0	zh-TW	*.odp				20200411 15:09:53
helpcontent2	source\text\shared\00\00000021.xhp	0	help	par_idN107D0				0	zh-TW	ODF 簡報範本				20200411 15:09:53
helpcontent2	source\text\shared\00\00000021.xhp	0	help	par_idN107D5				0	zh-TW	*.otp				20200411 15:09:53
