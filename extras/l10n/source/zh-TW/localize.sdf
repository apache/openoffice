helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143516				0	zh-TW	10				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143539				0	zh-TW	VAR				20200411 15:09:53
