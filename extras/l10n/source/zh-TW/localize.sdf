helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152370				0	zh-TW	\<item type=\"input\"\>=PI()\</item\> 傳回 3.14159265358979。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152418				0	zh-TW	\<bookmark_value\>MULTINOMIAL 函數\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152418				0	zh-TW	MULTINOMIAL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152454				0	zh-TW	\<ahelp hid=\"HID_AAI_FUNC_MULTINOMIAL\"\> 傳回引數階乘的乘積所除引數小計的階乘。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155646				0	zh-TW	語法				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155660				0	zh-TW	MULTINOMIAL(Number(s))				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155673				0	zh-TW	\<emph\>Number(s)\</emph\> 是指可多達 30 個數字的清單。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155687				0	zh-TW	範例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155701				0	zh-TW	若 F11 到 H11 包含值 \<item type=\"input\"\>2\</item\>、\<item type=\"input\"\>3\</item\> 與 \<item type=\"input\"\>4\</item\>，則 \<item type=\"input\"\>=MULTINOMIAL(F11:H11)\</item\> 傳回 1260。對應的公式為 =(2+3+4)! / (2!*3!*4!)。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3155717				0	zh-TW	\<bookmark_value\>POWER 函數\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155717				0	zh-TW	POWER				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159495				0	zh-TW	\<ahelp hid=\"HID_FUNC_POTENZ\"\>得出乘冪之後的數字。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3159513				0	zh-TW	語法				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159526				0	zh-TW	POWER(基數; 指數)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159540				0	zh-TW	傳回\<emph\>基數\</emph\>的\<emph\>指數\</emph\>次方。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5081637				0	zh-TW	使用乘冪運算子 ^ 可能得到相同的結果：				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9759514				0	zh-TW	\<item type=\"literal\"\>基數^指數\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3159580				0	zh-TW	範例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159594				0	zh-TW	\<item type=\"input\"\>=POWER(4;3)\</item\> 傳回 64，表示 4 的 3 次方。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1614429				0	zh-TW	=4^3 也傳回 4 的 3 次方。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152651				0	zh-TW	\<bookmark_value\>SERIESSUM 函數\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152651				0	zh-TW	SERIESSUM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152688				0	zh-TW	\<ahelp hid=\".\"\>計算第一次乘冪級數的總和。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152708				0	zh-TW	SERIESSUM(x;n;m;coefficients) = coefficient_1*x^n + coefficient_2*x^(n+m) + coefficient_3*x^(n+2m) +...+ coefficient_i*x^(n+(i-1)m)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152724				0	zh-TW	語法				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_idN11BD9				0	zh-TW	SERIESSUM(X; N; M; Coefficients)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152737				0	zh-TW	\<emph\>X\</emph\> 是指乘冪級數的輸入值。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144344				0	zh-TW	\<emph\>N\</emph\> 是指初始乘冪。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144357				0	zh-TW	\<emph\>M\</emph\> 是指增加 N 的增量				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144370				0	zh-TW	\<emph\>Coefficients\</emph\> 是指係數序列。每加入一個係數，序列總和會擴展一部分。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144386				0	zh-TW	\<bookmark_value\>PRODUCT 函數\</bookmark_value\>\<bookmark_value\>數字; 相乘\</bookmark_value\>\<bookmark_value\>相乘; 數字\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144386				0	zh-TW	PRODUCT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144414				0	zh-TW	\<ahelp hid=\"HID_FUNC_PRODUKT\"\>將作為引數指定的所有數字相乘並傳回乘積。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144433				0	zh-TW	語法				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144446				0	zh-TW	PRODUCT(Number1; Number2; ...; Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144460				0	zh-TW	\<emph\>Number1 到 30\</emph\> 是指可多達 30 個將計算其乘積的引數。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1589098				0	zh-TW	PRODUCT 傳回 number1 * number2 * number3 * ...				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144480				0	zh-TW	範例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144494				0	zh-TW	\<item type=\"input\"\>=PRODUCT(2;3;4)\</item\> 傳回 24。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3160340				0	zh-TW	\<bookmark_value\>SUMSQ 函數\</bookmark_value\>\<bookmark_value\>數字平方加法\</bookmark_value\>\<bookmark_value\>總和; 數字平方\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160340				0	zh-TW	SUMSQ				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160368				0	zh-TW	\<ahelp hid=\"HID_FUNC_QUADRATESUMME\"\>如果您要計算數字平方的總合 (引數平方的總計)，將這些輸入文字欄位。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160388				0	zh-TW	語法				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160402				0	zh-TW	SUMSQ(Number1; Number2; ...; Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160415				0	zh-TW	\<emph\>Number1 到 30\</emph\> 是指可多達 30 個將計算其平方和的引數。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160436				0	zh-TW	範例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160449				0	zh-TW	若在 Number 1、Number 2 與 Number 3 文字方塊中，分別輸入數字 \<item type=\"input\"\>2\</item\>、\<item type=\"input\"\>3\</item\> 與 \<item type=\"input\"\>4\</item\>，則會傳回結果 29。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3158247				0	zh-TW	\<bookmark_value\>MOD 函數\</bookmark_value\>\<bookmark_value\>除法的餘數\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158247				0	zh-TW	MOD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158276				0	zh-TW	\<ahelp hid=\"HID_FUNC_REST\"\>得出某一整數除以另一整數時的餘數。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158294				0	zh-TW	語法				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158308				0	zh-TW	MOD(Dividend; Divisor)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158321				0	zh-TW	 若是整數引數，此函數會傳回被除數除以除數的餘數，亦即\<emph\>Dividend\</emph\> 除以 \<emph\>Divisor\</emph\> 的餘數。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158341				0	zh-TW	此函數的執行方式為 \<item type=\"literal\"\>Dividend - Divisor * INT(Dividend/Divisor)\</item\>，若引數不是整數，則此公式可得出結果。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158361				0	zh-TW	範例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158374				0	zh-TW	\<item type=\"input\"\>=MOD(22;3)\</item\> 傳回 1，22 除以 3 的餘數。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1278420				0	zh-TW	\<item type=\"input\"\>=MOD(11.25;2.5)\</item\> 傳回 1.25。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144592				0	zh-TW	\<bookmark_value\>QUOTIENT 函數\</bookmark_value\>\<bookmark_value\>除法\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144592				0	zh-TW	QUOTIENT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144627				0	zh-TW	\<ahelp hid=\"HID_AAI_FUNC_QUOTIENT\"\>得出除法運算的整數部分。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144646				0	zh-TW	語法				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144659				0	zh-TW	QUOTIENT(Numerator; Denominator)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9038972				0	zh-TW	傳回 \<emph\>Numerator\</emph\> 除以 \<emph\>Denominator\</emph\> 的整數部分。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7985168				0	zh-TW	QUOTIENT 相當於 \<item type=\"literal\"\>INT(分子/分母)\</item\>，所不同者為其可能使用不同的錯誤碼報告錯誤。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144674				0	zh-TW	範例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144687				0	zh-TW	\<item type=\"input\"\>=QUOTIENT(11;3)\</item\> 傳回 3。捨去餘數 2。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144702				0	zh-TW	\<bookmark_value\>RADIANS 函數\</bookmark_value\>\<bookmark_value\>轉換; 角度, 為弧度\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144702				0	zh-TW	RADIANS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158025				0	zh-TW	\<ahelp hid=\"HID_FUNC_RAD\"\>將度轉換為弧度。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158042				0	zh-TW	語法				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158055				0	zh-TW	RADIANS(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158069				0	zh-TW	\<emph\>Number\</emph\> 是指要轉換為弧度的角度度數。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id876186				0	zh-TW	範例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3939634				0	zh-TW	\<item type=\"input\"\>=RADIANS(90)\</item\> 傳回 1.5707963267949，此為接近 Calc 精準度的 PI/2。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3158121				0	zh-TW	\<bookmark_value\>ROUND 函數\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158121				0	zh-TW	ROUND				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158150				0	zh-TW	\<ahelp hid=\"HID_FUNC_RUNDEN\"\>將一個數四捨五入為一定小數點位數的數字。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158169				0	zh-TW	語法				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158182				0	zh-TW	ROUND(Number; Count)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158196				0	zh-TW	傳回捨入到 \<emph\>Count\</emph\> 個小數點位數的 \<emph\>Number\</emph\>。若 Count 省略或為零，函數會捨入為最接近的整數。若 Count 為負值，則函數會捨入為最接近的 10、100、1000 等。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id599688				0	zh-TW	此函數會四捨五入至最接近的數字。另可使用 ROUNDDOWN 和 ROUNDUP。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145863				0	zh-TW	範例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145876				0	zh-TW	\<item type=\"input\"\>=ROUND(2.348;2)\</item\> 傳回 2.35。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145899				0	zh-TW	\<item type=\"input\"\>=ROUND(-32.4834;3)\</item\> 傳回 -32.483。變更儲存格格式可檢視所有小數。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1371501				0	zh-TW	\<item type=\"input\"\>=ROUND(2.348;0)\</item\> 傳回 2。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id4661702				0	zh-TW	\<item type=\"input\"\>=ROUND(2.5)\</item\> 傳回 3。 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7868892				0	zh-TW	\<item type=\"input\"\>=ROUND(987.65;-2)\</item\> 傳回 1000。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3145991				0	zh-TW	\<bookmark_value\>ROUNDDOWN 函數\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145991				0	zh-TW	ROUNDDOWN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146020				0	zh-TW	\<ahelp hid=\"HID_FUNC_ABRUNDEN\"\>按指定位數向下捨入 (沿絕對值減小的方向) 數字。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146037				0	zh-TW	語法				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146051				0	zh-TW	ROUNDDOWN(Number; Count)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146064				0	zh-TW	傳回趨向零而向下捨入到 \<emph\>Count\</emph\> 個小數點位數的 \<emph\>Number\</emph\>。若 Count 省略或為零，函數會向下捨入為整數。若 Count 為負值，函數會向下捨入到下一個 10、100、1000 等。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2188787				0	zh-TW	此函數會 (沿絕對值減小的方向) 進行四捨五入。另可使用 ROUNDUP 和 ROUND。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163164				0	zh-TW	範例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163178				0	zh-TW	\<item type=\"input\"\>=ROUNDDOWN(1.234;2)\</item\> 傳回 1.23。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5833307				0	zh-TW	\<item type=\"input\"\>=ROUNDDOWN(45.67;0)\</item\> 傳回 45。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7726676				0	zh-TW	\<item type=\"input\"\>=ROUNDDOWN(-45.67)\</item\> 傳回 -45。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3729361				0	zh-TW	\<item type=\"input\"\>=ROUNDDOWN(987.65;-2)\</item\> 傳回 900。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3163268				0	zh-TW	\<bookmark_value\>ROUNDUP 函數\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163268				0	zh-TW	ROUNDUP				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163297				0	zh-TW	\<ahelp hid=\"HID_FUNC_AUFRUNDEN\"\>按指定位數向上 (沿絕對值增大的方向) 捨入數字。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163315				0	zh-TW	語法				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163328				0	zh-TW	ROUNDUP(Number; Count)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163342				0	zh-TW	傳回 (背離零) 向上捨入到 \<emph\>Count\</emph\> 個小數點位數的 \<emph\>Number\</emph\>。若 Count 省略或為零，函數會向上捨入為整數。若 Count 為負值，函數會向上捨入到下一個 10、100、1000 等。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9573961				0	zh-TW	此函數沿絕對值增大的方向四捨五入。另可使用 ROUNDDOWN 和 ROUND。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163381				0	zh-TW	範例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144786				0	zh-TW	\<item type=\"input\"\>=ROUNDUP(1.1111;2)\</item\> 傳回 1.12。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7700430				0	zh-TW	\<item type=\"input\"\>=ROUNDUP(1.2345;1)\</item\> 傳回 1.3。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1180455				0	zh-TW	\<item type=\"input\"\>=ROUNDUP(45.67;0)\</item\> 傳回 46。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3405560				0	zh-TW	\<item type=\"input\"\>=ROUNDUP(-45.67)\</item\> 傳回 -46。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3409527				0	zh-TW	\<item type=\"input\"\>=ROUNDUP(987.65;-2)\</item\> 傳回 1000。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144877				0	zh-TW	\<bookmark_value\>SIN 函數\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144877				0	zh-TW	SIN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144906				0	zh-TW	\<ahelp hid=\"HID_FUNC_SIN\"\>得出指定角度 (弧度) 的正弦值。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144923				0	zh-TW	語法				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144937				0	zh-TW	SIN(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144950				0	zh-TW	傳回 \<emph\>Number\</emph\> 的 (三角) 正弦值，此為弧度的角度。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8079470				0	zh-TW	若要以角度得出正弦值，請使用 RADIANS 函數。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144969				0	zh-TW	範例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144983				0	zh-TW	\<item type=\"input\"\>=SIN(PI()/2)\</item\> 傳回 1，PI/2 弧度的正弦值。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3916440				0	zh-TW	\<item type=\"input\"\>=SIN(RADIANS(30))\</item\> 傳回 0.5，30 度的正弦值。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3163397				0	zh-TW	\<bookmark_value\>SINH 函數\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163397				0	zh-TW	SINH				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163426				0	zh-TW	\<ahelp hid=\"HID_FUNC_SINHYP\"\>傳回一個數字的雙曲正弦值。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163444				0	zh-TW	語法				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163457				0	zh-TW	SINH(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163471				0	zh-TW	傳回 \<emph\>Number\</emph\> 的雙曲正弦值。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163491				0	zh-TW	範例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163504				0	zh-TW	\<item type=\"input\"\>=SINH(0)\</item\> 傳回 0，0 的雙曲正弦值。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3163596				0	zh-TW	\<bookmark_value\>SUM 函數\</bookmark_value\>\<bookmark_value\>相加; 儲存格範圍內的數字\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163596				0	zh-TW	SUM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163625				0	zh-TW	\<ahelp hid=\"HID_FUNC_SUMME\"\>將某一儲存格範圍中的所有數字相加。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163643				0	zh-TW	語法				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163656				0	zh-TW	SUM(Number1; Number2; ...; Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163671				0	zh-TW	\<emph\>Number 1 到 Number 30\</emph\> 是指可多達 30 個將計算其總和的引數。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163690				0	zh-TW	範例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163704				0	zh-TW	若在 Number 1、Number 2 與 Number 3 文字方塊中，分別輸入數字 \<item type=\"input\"\>2\</item\>、\<item type=\"input\"\>3\</item\> 與 \<item type=\"input\"\>4\</item\>，則會傳回結果 9。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151740				0	zh-TW	\<item type=\"input\"\>=SUM(A1;A3;B5)\</item\> 計算三個儲存格的總和。\<item type=\"input\"\>=SUM (A1:E10)\</item\> 計算 A1 至 E10 儲存格範圍內所有儲存格的總和。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151756				0	zh-TW	由 AND 連結的條件可以依以下方式與函數 SUM() 一同使用：				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151774				0	zh-TW	範例假設：您在表格中輸入發票。欄 A 包含發票的日期值，欄 B 包含金額。您想尋找可用以傳回特定月份所有金額總計的公式，例如僅限 >=2008-01-01 到 <2008-02-01 期間的金額。包含日期值的範圍涵蓋 A1:A40，包含要加總的金額之範圍為 B1:B40。C1 是要包含的發票開始日期 2008\<item type=\"input\"\>-01-01\</item\>，C2 是不再包含的日期 2008\<item type=\"input\"\>-02-01\</item\>。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151799				0	zh-TW	輸入以下公式作為矩陣公式：				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151813				0	zh-TW	\<item type=\"input\"\>=SUM((A1:A40>=C1)*(A1:A40<C2)*B1:B40)\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151828				0	zh-TW	為將此輸入為陣列公式，您必須按 Shift\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>+Command \</caseinline\>\<defaultinline\>+ Ctrl\</defaultinline\>\</switchinline\>+ Enter 組合鍵，而非只按 Enter 鍵關閉公式。然後在 \<emph\>[公式]\</emph\> 列中將會顯示此公式，且前後括有大括號。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151869				0	zh-TW	{=SUM((A1:A40>=C1)*(A1:A40<C2)*B1:B40)}				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151884				0	zh-TW	公式指出，若符合條件，則比較結果為 1；若不符合條件，則比較結果為 0。個別比較結果會視為陣列並用於矩陣乘法中，最後再加總個別值以得出結果矩陣。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3151957				0	zh-TW	\<bookmark_value\>SUMIF 函數\</bookmark_value\>\<bookmark_value\>相加; 指定的數字\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3151957				0	zh-TW	SUMIF				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151986				0	zh-TW	\<ahelp hid=\"HID_FUNC_SUMMEWENN\"\>增加給定條件所指定的儲存格。\</ahelp\> 當您搜尋特定值時，此函數用於瀏覽區域。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152015				0	zh-TW	語法				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152028				0	zh-TW	SUMIF(Range; Criteria; SumRange)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152043				0	zh-TW	\<emph\>Range\</emph\> 是要套用條件的範圍。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152062				0	zh-TW	\<emph\>Criteria\</emph\> 是要在其中顯示搜尋條件的儲存格，或搜尋條件本身。若將條件寫成公式，則該條件必須括在雙引號內。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152083				0	zh-TW	\<emph\>SumRange\</emph\> 是加總值的範圍。若尚未指定此參數，則會加總「範圍」中找到的值。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8347422				0	zh-TW	SUMIF 僅支援 Criteria 參數中的參照連結運算子 (~)，而且只有在未指定選擇性的 SumRange 參數時才支援。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152110				0	zh-TW	範例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152148				0	zh-TW	僅加總負數：\<item type=\"input\"\>=SUMIF(A1:A10;"<0")\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6670125				0	zh-TW	\<item type=\"input\"\>=SUMIF(A1:A10;">0";B1:10)\</item\> - 只有在範圍 A1:A10 的對應值 >0 時，才加總範圍 B1:B10 的值。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6062196				0	zh-TW	請參閱 COUNTIF() 以取得更多可與 SUMIF() 一起使用的語法範例。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3151957K				0	zh-TW	\<bookmark_value\>SUMIFS function\</bookmark_value\>\<bookmark_value\>adding;specified numbers\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3151957K				0	zh-TW	SUMIFS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151986K				0	zh-TW	\<ahelp hid=\"HID_FUNC_SUMMEWNRNG\"\>Sum the values of cells in a range that meet multiple criteria in multiple ranges.\</ahelp\> 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152015K				0	zh-TW	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152028K				0	zh-TW	SUMIFS( Reference R ; Reference R1 ; Criterion C1 [ ; Reference R2 ; Criterion C2 ]... )				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152043K				0	zh-TW	Sums the value of cells in range R that meet the Criterion C1 in the reference range R1, and the Criterion C2 in the reference range R2, and so on. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152062K				0	zh-TW	A \<emph\>Criterion\</emph\> is a single cell Reference, Number or Text. If the criterion is written into the formula, it has to be surrounded by double quotes.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152083K				0	zh-TW	All \<emph\>Reference\</emph\> ranges shall have the same dimension and size, else an Error is returned.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152110K				0	zh-TW	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152148K				0	zh-TW	Sum up cells in range A1:10 if the entries in B1:B10 are positive, and the entries in D1:D10 are the letter "A": \<item type=\"input\"\>=SUMIFS(A1:A10;B1:B10;">0";D1:D10;"A")\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6062196K				0	zh-TW	See COUNTIFS() for some more syntax examples that can be used with SUMIFS().				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152195				0	zh-TW	\<bookmark_value\>TAN 函數\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152195				0	zh-TW	TAN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152224				0	zh-TW	\<ahelp hid=\"HID_FUNC_TAN\"\>得出指定角度 (弧度) 的正切值。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152242				0	zh-TW	語法				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152255				0	zh-TW	TAN(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152269				0	zh-TW	傳回 \<emph\>Number\</emph\> 的 (三角) 正切值，此為弧度的角度。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5752128				0	zh-TW	若要以角度得出正切值，請使用 RADIANS 函數。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152287				0	zh-TW	範例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152301				0	zh-TW	\<item type=\"input\"\>=TAN(PI()/4) \</item\> 傳回 1，PI/4 弧度的正切值。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1804864				0	zh-TW	\<item type=\"input\"\>=TAN(RADIANS(45))\</item\> 傳回 1，45 度的正切值。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3165434				0	zh-TW	\<bookmark_value\>TANH 函數\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165434				0	zh-TW	TANH				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165462				0	zh-TW	\<ahelp hid=\"HID_FUNC_TANHYP\"\>傳回一個數字的雙曲正切值。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165480				0	zh-TW	語法				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165494				0	zh-TW	TANH(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165508				0	zh-TW	傳回 \<emph\>Number\</emph\> 的雙曲正切值。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165527				0	zh-TW	範例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165541				0	zh-TW	\<item type=\"input\"\>=TANH(0)\</item\> 傳回 0，0 的雙曲正切值。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3165633				0	zh-TW	\<bookmark_value\>AutoFilter 函數; 小計\</bookmark_value\>\<bookmark_value\>總和; 篩選資料\</bookmark_value\>\<bookmark_value\>篩選資料; 總和\</bookmark_value\>\<bookmark_value\>SUBTOTAL 函數\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165633				0	zh-TW	SUBTOTAL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165682				0	zh-TW	\<ahelp hid=\"HID_FUNC_TEILERGEBNIS\"\>計算小計。\</ahelp\> 如果一個範圍已包含小計，則其不能用於進一步計算。將此函數和 [自動篩選] 同時使用，以僅對篩選出的資料條目進行計算。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165704				0	zh-TW	語法				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165717				0	zh-TW	SUBTOTAL(Function; Range)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165731				0	zh-TW	\<emph\>Function\</emph\> 是指代表下列其中一個函數的數值：				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165782				0	zh-TW	\<emph\>函數索引\</emph\>				20200411 15:09:53
