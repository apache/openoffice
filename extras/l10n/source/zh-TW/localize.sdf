helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166056				0	zh-TW	MIN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143316				0	zh-TW	6				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143339				0	zh-TW	PRODUCT				20200411 15:09:53
