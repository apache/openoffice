helpcontent2	source\text\scalc\05\empty_cells.xhp	0	help	par_id7458723				0	zh-TW	=ISNUMBER(C1) => FALSE (MS-Excel：TRUE)				20200411 15:09:53
helpcontent2	source\text\scalc\05\empty_cells.xhp	0	help	par_id2753379				0	zh-TW	=ISTEXT(C1) => FALSE				20200411 15:09:53
