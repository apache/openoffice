helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143389				0	zh-TW	STDEV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143416				0	zh-TW	8				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143439				0	zh-TW	STDEVP				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143466				0	zh-TW	9				20200411 15:09:53
