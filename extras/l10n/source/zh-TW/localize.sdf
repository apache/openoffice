helpcontent2	source\text\swriter\01\05060200.xhp	0	help	hd_id3150451				0	zh-TW	最適				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060200.xhp	0	help	par_id3154716	24			0	zh-TW	\<variable id=\"dynamischertext\"\>\<ahelp hid=\".uno:WrapIdeal\"\>自動在物件的左側、右側或邊框四周環繞文字。如果物件與頁面邊距的間隔小於 2 cm，則文字不會環繞。 \</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060200.xhp	0	help	par_id3150904				0	zh-TW	\<image id=\"img_id3150910\" src=\"sw/imglst/wr06.png\" width=\"0.82cm\" height=\"0.82cm\"\>\<alt id=\"alt_id3150910\"\>圖示\</alt\>\</image\>				20200411 15:09:53
