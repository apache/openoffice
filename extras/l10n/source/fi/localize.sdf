helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3145669				0	fi	Säilytä skaala				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3149346				0	fi	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_GRFCROP_RB_ZOOMCONST\"\>Rajattaessa kuvan alkuperäiset suhteet säilytetään, niin että vain kuvan koko muuttuu.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3156426				0	fi	Säilytä kuvan koko				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3155892				0	fi	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_GRFCROP_RB_SIZECONST\"\>Rajattaessa kuvan alkuperäinen koko säilytetään, niin että vain kuvan suhteet muuttuvat. Kuvan skaalan pienentämiseksi valitaan tämä asetus ja annetaan negatiivisia arvoja rajauskenttiin. Kuvan osittaissuurennoksen saa antamalla positiivisia arvoja rajauskenttiin.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3153683				0	fi	Vasen				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3145313				0	fi	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_LEFT\"\>Jos \<emph\>Säilytä skaala\</emph\> -asetus on valittu, positiivisen arvon syöttäminen leikkaa kuvan vasenta reunaa ja negatiivinen arvo lisää kuvaan vasemmalle valkoista reunaa. Jos \<emph\>Säilytä kuvan koko\</emph\> -asetus on valittu, positiivinen arvo lisää kuvan osittaista vaakasuurennosta ja negatiivinen arvo pienentää kuvan vaakaskaalaa.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3163803				0	fi	Oikea				20200411 15:09:53
