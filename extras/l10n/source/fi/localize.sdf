helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3151221				0	fi	INDEX				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150268				0	fi	\<ahelp hid=\"HID_FUNC_INDEX\"\>INDEX antaa tulokseksi osa-alueen, joka on määritetty rivi- ja sarakenumeroilla tai valinnaisen alueindeksin. Tilanteesta riippuen INDEX palauttaa joko viitteen tai sisällön.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3156063				0	fi	Syntaksi				20200411 15:09:53
