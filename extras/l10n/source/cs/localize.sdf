helpcontent2	source\text\scalc\01\04060115.xhp	0	help	bm_id3153034				0	cs	\<bookmark_value\>BIN2DEC\</bookmark_value\>\<bookmark_value\>převod; dvojková čísla na desítková\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3153034				0	cs	BIN2DEC				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3144744				0	cs	\<ahelp hid=\"HID_AAI_FUNC_BIN2DEC\"\>Převede zadané číslo v binární soustavě do desítkové soustavy.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3145593				0	cs	Syntaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3149726				0	cs	BIN2DEC(Číslo)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3150142				0	cs	\<emph\>Number\</emph\> is a binary number. The number can have a maximum of 10 places (bits). The most significant bit is the sign bit. Negative numbers are entered as two's complement.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3149250				0	cs	Příklad				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3145138				0	cs	\<item type=\"input\"\>=BIN2DEC(1100100)\</item\> vrátí 100.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	bm_id3149954				0	cs	\<bookmark_value\>BIN2HEX\</bookmark_value\>\<bookmark_value\>převod; dvojková čísla na šestnáctková\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3149954				0	cs	BIN2HEX				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3148585				0	cs	\<ahelp hid=\"HID_AAI_FUNC_BIN2HEX\"\>Převede určené číslo ve dvojkové soustavě do šestnáctkové soustavy.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3153936				0	cs	Syntaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3148753				0	cs	BIN2HEX(Číslo; Místa)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3155255				0	cs	\<emph\>Číslo\</emph\> je dvojkové číslo. Číslo může mít maximálně 10 míst (bitů). Nejvýznamnější bit je znaménkový bit. Záporná čísla jsou zadána ve formátu dvojkového doplňku.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3150860				0	cs	Místa znamená počet míst, která mají být na výstupu.				20200411 15:09:53
