helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154940				0	cs	\<ahelp hid=\"HID_FUNC_QUANTIL\"\>Vrací alfa-procentní hodnoty dat v matici.\</ahelp\>Funkce PERCENTILE vrací stupnici hodnot pro série dat, která jdou od nejmenší (Alpha=0) po největší hodnotu (alpha=1). Pro \<item type=\"literal\"\>Alpha\</item\> = 25%,percentile počítá první čtvrtinu; \<item type=\"literal\"\>Alpha\</item\> = 50% je MEDIAN.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150531				0	cs	Syntaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148813				0	cs	PERCENTILE(Data; Alfa)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153054				0	cs	\<emph\>Data\</emph\> jsou údaje, se kterými se operuje.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154212				0	cs	\<emph\>Alfa\</emph\> je v rozsahu od 0 do 1 a určuje procentuální polohu požadované hodnoty na stupnici velikostí prvků v poli údajů.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154290				0	cs	Příklad				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159147				0	cs	\<item type=\"input\"\>=PERCENTILE(A1:A50;0.1)\</item\> reprezentuje hodnotu v sadě dat, která se rovná 10% celkové datové stupnice v A1:A50.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148807				0	cs	\<bookmark_value\>funkce PERCENTRANK\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148807				0	cs	PERCENTRANK				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153573				0	cs	\<ahelp hid=\"HID_FUNC_QUANTILSRANG\"\>Vrátí procentuální polohu hodnoty ve vzorku dat.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147512				0	cs	Syntaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147238				0	cs	PERCENTRANK(Data;Hodnota)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154266				0	cs	\<emph\>Data\</emph\> jsou zkoumané údaje (v poli).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148475				0	cs	\<emph\>Hodnota\</emph\> je číslo, jehož umístění ve vzorku chceme zjistit.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155364				0	cs	Příklad				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149163				0	cs	\<item type=\"input\"\>=PERCENTRANK(A1:A50;50)\</item\> vrací procentuální pořadí hodnoty 50 z celkového pořadí všech hodnot nalezených v A1:A50. Pokud hodnota 50 padne mimo celkové pořadí, program skončí chybou..				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3166442				0	cs	\<bookmark_value\>funkce QUARTILE\</bookmark_value\>				20200411 15:09:53
