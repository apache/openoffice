helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3149346				0	cs	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_GRFCROP_RB_ZOOMCONST\"\>Zachová původní měřítko, mění se jen rozměry obrázku.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3156426				0	cs	Zachovat velikost obrázku				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3155892				0	cs	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_GRFCROP_RB_SIZECONST\"\>Zachová původní velikost ořezávaného obrázku, takže se mění jen měřítko obrázku. Chcete-li zmenšit měřítko obrázku, zaškrtněte tuto možnost a zadejte do polí záporné hodnoty. Chcete-li zvětšit měřítko obrázku, zadejte kladné hodnoty.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3153683				0	cs	Vlevo				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3145313				0	cs	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_LEFT\"\>Je-li zvolena volba \<emph\>Zachovat měřítko\</emph\>, zadáním kladné hodnoty oříznete levý okraj obrázku nebo zadáním záporné hodnoty přidáte k levému okraji bílé místo. Je-li zvolena volba \<emph\>Zachovat velikost obrázku\</emph\>, zadáním kladné hodnoty zvětšíte vodorovné měřítko obrázku nebo zadáním záporné hodnoty zmenšíte vodorovné měřítko.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3163803				0	cs	Vpravo				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3145382				0	cs	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_RIGHT\"\>Je-li zvolena volba \<emph\>Zachovat měřítko\</emph\>, zadáním kladné hodnoty oříznete pravý okraj obrázku nebo zadáním záporné hodnoty přidáte k pravému okraji bílé místo. Je-li zvolena volba \<emph\>Zachovat velikost obrázku\</emph\>, zadáním kladné hodnoty zvětšíte vodorovné měřítko obrázku nebo zadáním záporné hodnoty zmenšíte vodorovné měřítko.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3156153				0	cs	Nahoře				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3154514				0	cs	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_TOP\"\>Je-li zvolena volba \<emph\>Zachovat měřítko\</emph\>, zadáním kladné hodnoty oříznete horní okraj obrázku nebo zadáním záporné hodnoty přidáte k hornímu okraji bílé místo. Je-li zvolena volba \<emph\>Zachovat velikost obrázku\</emph\>, zadáním kladné hodnoty zvětšíte svislé měřítko obrázku nebo zadáním záporné hodnoty zmenšíte svislé měřítko.\</ahelp\>				20200411 15:09:53
