helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id0119200902395679				0	cs	CHISQDIST(Number; Degrees Of Freedom; Cumulative)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id011920090239564				0	cs	            \<emph\>Number\</emph\> is the number for which the function is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id0119200902395660				0	cs	            \<emph\>Degrees Of Freedom\</emph\> is the degrees of freedom for the chi-square function.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id0119200902395623				0	cs	            \<emph\>Cumulative\</emph\> (optional): 0 or False calculates the probability density function. Other values or True or omitted calculates the cumulative distribution function.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	bm_id3150603				0	cs	\<bookmark_value\>EXPONDIST function\</bookmark_value\>         \<bookmark_value\>exponential distributions\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3150603				0	cs	EXPONDIST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3149563				0	cs	\<ahelp hid=\"HID_FUNC_EXPONVERT\"\>Vrátí exponenciální rozdělení.\</ahelp\>				20200411 15:09:53
