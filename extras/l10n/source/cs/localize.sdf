helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145355	233			0	cs	            \<item type=\"input\"\>=DECIMAL("17";10)\</item\> returns 17.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155622	234			0	cs	            \<item type=\"input\"\>=DECIMAL("FACE";16)\</item\> returns 64206.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151015	235			0	cs	            \<item type=\"input\"\>=DECIMAL("0101";2)\</item\> returns 5.				20200411 15:09:53
