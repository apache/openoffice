helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3150162				0	cs	Podmínka je splněna, pokud proměnná "x" obsahuje řetězec "ABC".				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3153301				0	cs	x == "" nebo x EQ ""				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3156120				0	cs	nebo				20200411 15:09:53
