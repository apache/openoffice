helpcontent2	source\text\scalc\01\func_second.xhp	0	help	par_id3155904				0	cs	\<emph\>Číslo\</emph\> jako hodnota času je desetinné číslo, pro které chcete zjistit sekundy.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_second.xhp	0	help	hd_id3149992				0	cs	Příklady				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_second.xhp	0	help	par_id3153350				0	cs	\<item type=\"input\"\>=SECOND(NOW())\</item\> vrátí aktuální počet sekund.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_second.xhp	0	help	par_id3150831				0	cs	\<item type=\"input\"\>=SECOND(C4)\</item\> vrátí 17, pokud obsah buňky C4 = \<item type=\"input\"\>12:20:17\</item\>.				20200411 15:09:53
