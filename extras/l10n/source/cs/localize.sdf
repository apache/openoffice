helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3158446				0	cs	\<bookmark_value\>funkce MUNIT\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3158446				0	cs	MUNIT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154121				0	cs	\<ahelp hid=\"HID_FUNC_EINHEITSMATRIX\"\>Vrátí jednotkovou čtvercovou matici dané velikosti.\</ahelp\> Jednotková matice je čtvercová matice, která má na diagonále jedničky a její ostatní prvky mají hodnotu 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3155123				0	cs	Syntaxe				20200411 15:09:53
