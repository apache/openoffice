helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3158423				0	cs	RATE(NPer; Pmt; PV; FV; Typ; Odhad)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148910				0	cs	\<emph\>NPer\</emph\> je celkové množství období, během kterých jsou prováděny splátky (platební období).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148925				0	cs	\<emph\>Pmt\</emph\> je konstantní platba (anuita) splacená v průběhu každého období.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149160				0	cs	\<emph\>PV\</emph\> je hodnota hotovosti v sérii splátek.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3166456				0	cs	\<emph\>FV\</emph\> (volitelně) je budoucí hodnota,která bude dosažena na konci splátek.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153243				0	cs	\<emph\>Typ\</emph\> (volitelně) je termín splatnosti splátek, buď na začátku nebo na konci období.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3146949				0	cs	\<emph\>Odhad\</emph\> (volitelně) určuje očekávanou hodnotu úroku pomocí iterativního výpočtu.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_idN10E2A				0	cs	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				20200411 15:09:53
