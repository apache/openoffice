helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10579				0	cs	Tradiční čínština na zjednodušenou čínštinu				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1057D				0	cs	\<ahelp hid=\".\"\>Converts traditional Chinese text characters to simplified Chinese text characters. Click \<emph\>OK\</emph\> to convert the selected text. If no text is selected, the whole document is converted.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10580				0	cs	Zjednodušená čínština na tradiční čínštinu				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10584				0	cs	\<ahelp hid=\".\"\>Converts simplified Chinese text characters to traditional Chinese text characters. Click \<emph\>OK\</emph\> to convert the selected text. If no text is selected, the whole document is converted.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1058E				0	cs	Běžné pojmy				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10592				0	cs	\<ahelp hid=\".\"\>Běžné pojmy jsou slova, která mají stejný význam v tradiční i zjednodušené čínštině, ale zapisují se jinými znaky.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10595				0	cs	Convert Common Terms				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10599				0	cs	\<ahelp hid=\".\"\>Converts words with two or more characters that are in the list of common terms. After the list is scanned, the remaining text is converted character by character.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1059C				0	cs	Upravit pojem				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN105A0				0	cs	\<ahelp hid=\".\"\>Opens the \<link href=\"text/shared/01/06010601.xhp\"\>Edit Dictionary\</link\> dialog where you can edit the list of conversion terms.\</ahelp\>				20200411 15:09:53
