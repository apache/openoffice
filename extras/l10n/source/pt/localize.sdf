helpcontent2	source\text\sbasic\shared\03030205.xhp	0	help	par_id3156286	23			0	pt	dataD = TimeSerial(8,30,15)				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03030205.xhp	0	help	par_id3148456	24			0	pt	dataC = TimeSerial(8,30,15)				20130618 17:22:18
