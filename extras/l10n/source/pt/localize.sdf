helpcontent2	source\text\shared\optionen\01010200.xhp	0	help	par_id3145652				0	pt	../imagens/img.jpg				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010200.xhp	0	help	par_id3155064				0	pt	absoluto				20200411 15:09:53
