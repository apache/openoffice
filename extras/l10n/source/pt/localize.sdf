helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3154011				0	pt	execi = 1				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3147215				0	pt	while execi < Len(textoC)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3147427				0	pt	if Mid(textoC,execi,1 )<> " " then Mid(textoC ,execi, 1, Chr( 1 + Asc( Mid(textoC,execi,1 )) )				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3149665				0	pt	execi = execi + 1				20200411 15:09:53
