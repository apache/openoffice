helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id354014				0	pt	Converte um número em texto tailandês, incluindo os nomes da moeda tailandesa.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id9942014				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id8780785				0	pt	BAHTTEXT(Número)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id1539353				0	pt	            \<emph\>Número\</emph\> corresponde a qualquer número. "Baht" é anexado à parte inteira do número e "Satang" é anexado à parte decimal do número.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id9694814				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3289284				0	pt	            \<item type=\"input\"\>=BAHTTEXT(12,65)\</item\> devolve uma cadeia em caracteres tailandeses com o significado "Doze Baht e sessenta e cinco Satang".				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3153072				0	pt	\<bookmark_value\>função BASE\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153072				0	pt	BASE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153289				0	pt	\<ahelp hid=\"HID_FUNC_BASIS\"\>Converte um número inteiro positivo para uma base especificada, com o resultado mostrado como texto do \<link href=\"text/shared/00/00000005.xhp#zahlensystem\" name=\"sistema de numeração\"\>sistema de numeração\</link\>.\</ahelp\> Utilizam-se os dígitos 0-9 e as letras A-Z.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146097				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155743				0	pt	BASE(Número; Raiz; [ComprimentoMínimo])				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151339	217			0	pt	            \<emph\>Número\</emph\> corresponde ao número inteiro positivo a ser convertido.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3159262	218			0	pt	            \<emph\>Raiz\</emph\> indica a base do sistema numérico. Pode ser qualquer número inteiro positivo entre 2 e 36.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148746	219			0	pt	            \<emph\>ComprimentoMínimo\</emph\> (opcional) determina o comprimento mínimo da sequência de caracteres criada. Se o texto for mais pequeno do que o comprimento mínimo indicado, são adicionados zeros à esquerda da cadeia.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146323				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3156399				0	pt	\<bookmark_value\>sistema decimal; converter para\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156399	221			0	pt	            \<item type=\"input\"\>=BASE(17;10;4)\</item\> devolve 0017 no sistema decimal.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3157871				0	pt	\<bookmark_value\>sistema binário; converter para\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3157871	222			0	pt	            \<item type=\"input\"\>=BASE(17;2)\</item\> devolve 10001 no sistema binário.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3145226				0	pt	\<bookmark_value\>sistema hexadecimal; converter para\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145226	223			0	pt	            \<item type=\"input\"\>=BASE(255;16;4)\</item\> devolve 00FF no sistema hexadecimal.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149321				0	pt	\<bookmark_value\>função CARÁCTER\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149321				0	pt	CARÁCTER				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149150				0	pt	\<ahelp hid=\"HID_FUNC_ZEICHEN\"\>Converte um número num carácter de acordo com a tabela de código activa.\</ahelp\> O número pode ser um inteiro com dois ou três dígitos.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149945				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145634				0	pt	CARÁCTER(Número)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155906	205			0	pt	            \<emph\>Número\</emph\> corresponde a um número entre 1 e 255 que representa o valor do código do carácter.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152982				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149890	208			0	pt	            \<item type=\"input\"\>=CARÁCTER(100)\</item\> devolve o carácter d.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id0907200910283297				0	pt	="abc" & CARÁCTER(10) & "def" insere um carácter de nova linha na cadeia.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149009				0	pt	\<bookmark_value\>função LIMPARB\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149009				0	pt	LIMPARB				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150482				0	pt	\<ahelp hid=\"HID_FUNC_SAEUBERN\"\>Todos os caracteres não imprimíveis são eliminados da cadeia.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146880				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147472				0	pt	LIMPARB("Texto")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150695	136			0	pt	            \<emph\>Texto\</emph\> refere-se ao texto do qual se quer remover todos os caracteres não imprimíveis.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3155498				0	pt	\<bookmark_value\>função CÓDIGO\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155498				0	pt	CÓDIGO				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3152770				0	pt	\<ahelp hid=\"HID_FUNC_CODE\"\>Devolve um código numérico correspondente ao primeiro carácter de uma cadeia.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155830				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149188				0	pt	CÓDIGO("Texto")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154383	7			0	pt	            \<emph\>Texto\</emph\> corresponde ao texto em relação ao qual se quer encontrar o código do primeiro carácter.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3154394				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3159209	9			0	pt	            \<item type=\"input\"\>=CÓDIGO("Helsínquia")\</item\> devolve 72, \<item type=\"input\"\>=CÓDIGO("hieroglífico")\</item\> devolve 104.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150280				0	pt	O código utilizado não corresponde ao ASCII, mas à tabela de código activa.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149688				0	pt	\<bookmark_value\>função CONCATENAR\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149688				0	pt	CONCATENAR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154524				0	pt	\<ahelp hid=\"HID_FUNC_VERKETTEN\"\>Combina várias cadeias de texto numa única cadeia.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149542				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155954				0	pt	CONCATENAR("Texto1"; ...; "Texto30")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146847	171			0	pt	            \<emph\>Texto 1; Texto 2; ...\</emph\> representa um máximo de 30 passagens de texto que se quer combinar numa só cadeia de texto.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153110				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150008	173			0	pt	            \<item type=\"input\"\>=CONCATENAR("Bom ";"Dia ";"Sra. ";"Joana")\</item\> devolve: Bom Dia Sra. Joana.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3145166				0	pt	\<bookmark_value\>função DECIMAL\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3145166				0	pt	DECIMAL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156361				0	pt	\<ahelp hid=\"HID_FUNC_DEZIMAL\"\>Converte texto com caracteres de um \<link href=\"text/shared/00/00000005.xhp#zahlensystem\" name=\"sistema numérico\"\>sistema numérico\</link\> para um número inteiro positivo na base da raiz especificada.\</ahelp\> A raiz tem de se encontrar no intervalo entre 2 e 36. Os espaços e tabulações são ignorados. O campo \<emph\>Texto\</emph\> não é sensível a maiúsculas e minúsculas.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3157994				0	pt	Se a raiz for 16, um x, X, 0x ou 0X à esquerda da sequência ou um h ou H à direita será ignorado. Se a raiz for 2, será ignorado qualquer b ou B à direita da sequência. Quaisquer outros caracteres que não pertençam ao sistema numérico geram um erro.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150014				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154328				0	pt	DECIMAL("Texto"; Raiz)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150128	230			0	pt	            \<emph\>Texto\</emph\> corresponde ao texto a ser convertido. Para diferenciar entre um número hexadecimal, tal como A1, e a referência à célula A1, tem de colocar o número entre aspas, por exemplo, "A1" ou "FACE".				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145241	231			0	pt	            \<emph\>Raiz\</emph\> indica a base do sistema numérico. Pode ser qualquer número inteiro positivo entre 2 e 36.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3156062				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145355	233			0	pt	            \<item type=\"input\"\>=DECIMAL("17";10)\</item\> devolve 17.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155622	234			0	pt	            \<item type=\"input\"\>=DECIMAL("FACE";16)\</item\> devolve 64206.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151015	235			0	pt	            \<item type=\"input\"\>=DECIMAL("0101";2)\</item\> devolve 5.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3148402				0	pt	\<bookmark_value\>função MOEDA\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148402				0	pt	MOEDA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153049	12			0	pt	\<ahelp hid=\"HID_FUNC_DM\"\>Converte um número num montante em formato de moeda, arredondado a uma casa decimal especificada.\</ahelp\> No campo \<item type=\"literal\"\>Valor\</item\> insira o número a ser convertido para o formato de moeda. Opcionalmente, pode inserir o número de casas decimais no campo \<item type=\"literal\"\>Decimais\</item\>. Se não especificar qualquer valor, serão mostrados todos os números no formato de moeda com duas casas decimais. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151280				0	pt	O formato de moeda está definido nas definições do sistema.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150569				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154188				0	pt	MOEDA(Valor; Decimais)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145299	15			0	pt	            \<emph\>Valor\</emph\> corresponde a um número, a uma referência a uma célula com um número ou a uma fórmula que devolve um número.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145629	16			0	pt	            \<emph\>Decimais\</emph\> corresponde ao número opcional de casas decimais.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149030				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153546	18			0	pt	            \<item type=\"input\"\>=MOEDA(255)\</item\> devolve 255,00 €.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154635	19			0	pt	            \<item type=\"input\"\>=MOEDA(367,456;2)\</item\> devolve 367,46 €. Utilize o separador decimal que corresponde à \<link href=\"text/shared/optionen/01140000.xhp\" name=\"configuração regional actual\"\>configuração regional actual\</link\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3150685				0	pt	\<bookmark_value\>função EXACTO\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150685				0	pt	EXACTO				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3158413				0	pt	\<ahelp hid=\"HID_FUNC_IDENTISCH\"\>Compara duas cadeias de texto e devolve VERDADEIRO se forem idênticas.\</ahelp\> Esta função é sensível a maiúsculas e minúsculas.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152817				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148594				0	pt	EXACTO("Texto1"; "Texto2")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153224	82			0	pt	            \<emph\>Texto1\</emph\> refere-se ao primeiro texto a comparar.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148637	83			0	pt	            \<emph\>Texto2\</emph\> corresponde ao segundo texto a comparar.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149777				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156263	85			0	pt	            \<item type=\"input\"\>=EXACTO(" microsystems";" Microsystems")\</item\> devolve FALSO.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3152589				0	pt	\<bookmark_value\>função LOCALIZAR\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152589				0	pt	LOCALIZAR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146149				0	pt	\<ahelp hid=\"HID_FUNC_FINDEN\"\>Procura uma cadeia de texto dentro de outra cadeia.\</ahelp\> É possível definir onde quer iniciar a procura. O termo de procura pode ser um número ou qualquer cadeia de caracteres. A procura é sensível a maiúsculas e minúsculas.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3083284				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3083452				0	pt	LOCALIZAR("LocalizarTexto"; "Texto"; Posição)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150608	48			0	pt	            \<emph\>LocalizarTexto\</emph\> refere-se ao texto a ser localizado.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3152374	49			0	pt	            \<emph\>Texto\</emph\> corresponde ao texto onde a procura é efectuada.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3152475	50			0	pt	            \<emph\>Posição\</emph\> (opcional) corresponde à posição no texto onde a procura é iniciada.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3154812				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156375	52			0	pt	            \<item type=\"input\"\>=LOCALIZAR(76;998877665544)\</item\> devolve 6.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149268				0	pt	\<bookmark_value\>função FIXA\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149268				0	pt	FIXA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155833				0	pt	\<ahelp hid=\"HID_FUNC_FEST\"\>Devolve um número como texto com um número especificado de casas decimais e separadores de milhares opcionais.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152470				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147567				0	pt	FIXA(Número; Decimais; SemSeparadorDeMilhares)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151272	38			0	pt	            \<emph\>Número\</emph\> refere-se ao número a ser formatado.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156322	39			0	pt	            \<emph\>Decimais\</emph\> refere-se ao número de casas decimais a mostrar.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150877	40			0	pt	            \<emph\>SemSeparadorDeMilhares\</emph\> (opcional) determina se o separador de milhares é utilizado. Se o parâmetro corresponder a um número diferente de 0, o separador de milhares é suprimido. Se o parâmetro for igual a 0 ou se estiver em falta, são mostrados os separadores dos milhares da \<link href=\"text/shared/optionen/01140000.xhp\" name=\"configuração regional actual\"\>configuração regional actual\</link\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149040				0	pt	Exemplo				20200411 15:09:53
