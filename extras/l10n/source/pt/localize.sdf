helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165731				0	pt	\<emph\>Função\</emph\> corresponde a um número que representa uma das seguintes funções:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165782				0	pt	Índice de funções				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165806				0	pt	Função				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165833				0	pt	1				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165856				0	pt	MÉDIA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165883				0	pt	2				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165906				0	pt	CONTAR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165933				0	pt	3				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165956				0	pt	CONTAR.VAL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165983				0	pt	4				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166006				0	pt	MÁXIMO				20200411 15:09:53
