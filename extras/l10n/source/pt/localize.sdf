helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3154754	25			0	pt	MsgBox "A data de expiração é hoje"				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3154361	26			0	pt	end if				20130618 17:22:18
