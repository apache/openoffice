helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3154866				0	pt	\<item type=\"input\"\>Distância para a escola\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3150471				0	pt	\<item type=\"input\"\>Peso\</item\>				20200411 15:09:53
