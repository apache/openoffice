helpcontent2	source\text\schart\01\wiz_chart_elements.xhp	0	help	par_id206610				0	pt	\<ahelp hid=\".\" visibility=\"hidden\"\>Mostra linhas de grelha perpendiculares ao eixo-y.\</ahelp\>				20200411 15:09:53
