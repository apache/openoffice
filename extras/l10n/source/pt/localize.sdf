helpcontent2	source\text\sbasic\shared\03120103.xhp	0	help	par_id3145069	14			0	pt	vari = 123.123				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03120103.xhp	0	help	par_id3153897	15			0	pt	varC = LTrim(Str(vari))				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03120103.xhp	0	help	par_id3154924	16			0	pt	Msgbox varC & chr(13) & Str(varC)				20130618 17:22:18
