helpcontent2	source\text\shared\00\00000003.xhp	0	help	par_idN106D4				0	pt	cm				20130618 17:22:18
helpcontent2	source\text\shared\00\00000003.xhp	0	help	par_idN106DA				0	pt	Centímetro				20130618 17:22:18
helpcontent2	source\text\shared\00\00000003.xhp	0	help	par_idN106E1				0	pt	pol ou "				20130618 17:22:18
helpcontent2	source\text\shared\00\00000003.xhp	0	help	par_idN106E7				0	pt	Polegada				20130618 17:22:18
