helpcontent2	source\text\sbasic\shared\03030103.xhp	0	help	par_id3149260	14			0	pt	Print "Dia " & Day(DateSerial(1994, 12, 20)) & " do mês"				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03030103.xhp	0	help	par_id3148645	15			0	pt	end sub				20130618 17:22:18
