helpcontent2	source\text\shared\01\05340500.xhp	0	help	par_id3155620				0	pt	\<ahelp hid=\".\"\>Oculta as colunas seleccionadas. Para ver colunas ocultas, clique com o botão direito do rato no cabeçalho de qualquer coluna e depois escolha \<emph\>Mostrar colunas\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	tit				0	pt	Conversão para chinês				20200411 15:09:53
