helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3154490				0	pt	dataC = InputBox("Insira a data de expiração (MM.DD.AAAA)")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3154943				0	pt	dataC = Right$(dataC, 4) + Mid$(dataC, 4, 2) + Left$(dataC, 2)				20200411 15:09:53
