helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145710	339			0	pt	\<item type=\"input\"\>=ARRED.EXCESSO(-11;-2)\</item\> devolve -10				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145725	340			0	pt	\<item type=\"input\"\>=ARRED.EXCESSO(-11;-2;0)\</item\> devolve -10				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145740	341			0	pt	\<item type=\"input\"\>=ARRED.EXCESSO(-11;-2;1)\</item\> devolve -12				20130618 17:22:18
