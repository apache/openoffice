helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143316	481			0	pt	6				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143339	482			0	pt	PRODUTO				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143366	483			0	pt	7				20130618 17:22:18
