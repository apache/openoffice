helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3144765				0	pt	hojeC = Right$(hojeC, 4)+ Mid$(hojeC, 4, 2) + Left$(hojeC, 2)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3154792				0	pt	If dataC < hojeC Then				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3155601				0	pt	MsgBox "A data de expiração já passou"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3146972				0	pt	ElseIf dataC > hojeC Then				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3146912				0	pt	MsgBox "A data de expiração ainda não passou"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3153710				0	pt	Else				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3154754				0	pt	MsgBox "A data de expiração é hoje"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3154361				0	pt	End If				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3148405				0	pt	End Sub				20200411 15:09:53
