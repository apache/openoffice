helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146093	120			0	pt	            \<item type=\"input\"\>=MÉDIA.HARMÓNICA(23;46;69)\</item\> = 37,64. Assim, a média harmónica deste exemplo aleatório é 37,64				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3152801				0	pt	\<bookmark_value\>função DIST.HIPERGEOM\</bookmark_value\>         \<bookmark_value\>exemplificar sem substituição\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3152801				0	pt	DIST.HIPERGEOM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3159341				0	pt	\<ahelp hid=\"HID_FUNC_HYPGEOMVERT\"\>Devolve a distribuição hiper-geométrica.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3154697				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155388				0	pt	DIST.HIPERGEOM(X; NExemplo; Sucessos; NPopulação)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154933	126			0	pt	            \<emph\>X\</emph\> corresponde ao número de resultados obtidos na amostra aleatória.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153106	127			0	pt	            \<emph\>NExemplo\</emph\> corresponde ao tamanho do exemplo aleatório.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146992	128			0	pt	            \<emph\>Sucessos\</emph\> corresponde ao número de resultados possíveis na população total.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3148826	129			0	pt	            \<emph\>NPopulação\</emph\> corresponde ao tamanho da população total.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150529				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154904	131			0	pt	            \<item type=\"input\"\>=DIST.HIPERGEOM(2;2;90;100)\</item\> devolve 0,81. Se 90 em 100 torradas com manteiga caírem da mesa com a face com manteiga virada para o chão, então se deixarmos cair 2 torradas com manteiga da mesa, há 81% de probabilidade de ambas caírem com a face com manteiga virada para o chão.				20200411 15:09:53
