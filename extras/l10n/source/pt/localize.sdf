helpcontent2	source\text\sbasic\shared\03030205.xhp	0	help	par_id3156286				0	pt	dataD = TimeSerial(8,30,15)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030205.xhp	0	help	par_id3148456				0	pt	dataC = TimeSerial(8,30,15)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030205.xhp	0	help	par_id3155600				0	pt	MsgBox dDate,64,"Hora como um número"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030205.xhp	0	help	par_id3153417				0	pt	MsgBox sDate,64,"Hora formatada"				20200411 15:09:53
