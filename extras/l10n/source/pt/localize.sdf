helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165883	473			0	pt	2				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165906	474			0	pt	CONTAR				20130618 17:22:18
