helpcontent2	source\text\sbasic\shared\03120104.xhp	0	help	par_id3154126				0	pt	msgbox Val("A123.123")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120104.xhp	0	help	par_id3147229				0	pt	end Sub				20200411 15:09:53
