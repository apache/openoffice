helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154654	394			0	pt	            \<emph\>Liquidação\</emph\> corresponde à data da compra do título.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153011	395			0	pt	            \<emph\>Vencimento\</emph\> corresponde à data de vencimento (expiração) do título.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155525	396			0	pt	            \<emph\>Investimento\</emph\> corresponde à soma da compra.				20130618 17:22:18
