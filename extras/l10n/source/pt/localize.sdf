helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3148499				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148511				0	pt	TRUNCAR(Número; Contar)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150796				0	pt	Devolve \<emph\>Número\</emph\> com um máximo de \<emph\>Contar\</emph\> casas decimais. As casas decimais em excesso são removidas, independentemente do sinal.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150816				0	pt	\<item type=\"literal\"\>TRUNCAR(Número; 0)\</item\> age como \<item type=\"literal\"\>INT(Número)\</item\> para números positivos, mas arredonda em direcção a zero para números negativos.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148548				0	pt	As casas decimais \<emph\>visíveis\</emph\> do resultado são especificadas em \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferências\</caseinline\>\<defaultinline\>Ferramentas - Opções\</defaultinline\>\</switchinline\> - \<link href=\"text/shared/optionen/01060500.xhp\"\>%PRODUCTNAME Calc - Calcular\</link\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152555				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152569				0	pt	\<item type=\"input\"\>=TRUNCAR(1,239;2)\</item\> devolve 1,23. O 9 desaparece.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7050080				0	pt	\<item type=\"input\"\>=TRUNCAR(-1,234999;3)\</item\> devolve -1,234. Todos os 9s desaparecem.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3153601				0	pt	\<bookmark_value\>função LN\</bookmark_value\>\<bookmark_value\>logaritmo natural\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153601				0	pt	LN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154974				0	pt	\<ahelp hid=\"HID_FUNC_LN\"\>Devolve o logaritmo natural com base na constante \<emph\>e\</emph\> de um número.\</ahelp\> A constante \<emph\>e\</emph\> possui um valor de aproximadamente 2,71828182845904.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154993				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155284				0	pt	LN(Número)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155297				0	pt	\<emph\>Número\</emph\> corresponde ao valor cujo logaritmo natural será calculado.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153852				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153866				0	pt	\<item type=\"input\"\>=LN(3)\</item\> devolve o logaritmo natural de 3 (aproximadamente 1,0986).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5747245				0	pt	\<item type=\"input\"\>=LN(EXP(321))\</item\> devolve 321.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3109813				0	pt	\<bookmark_value\>função LOG\</bookmark_value\>\<bookmark_value\>logaritmos\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3109813				0	pt	LOG				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3109841				0	pt	\<ahelp hid=\"HID_FUNC_LOG\"\>Devolve o logaritmo de um número para a base especificada.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144719				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144732				0	pt	LOG(Número; Base)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144746				0	pt	\<emph\>Número\</emph\> corresponde ao valor cujo logaritmo será calculado.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152840				0	pt	\<emph\>Base\</emph\> (opcional) corresponde à base para o cálculo do logaritmo. Se for omitida, é assumida a Base 10.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152860				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154429				0	pt	\<item type=\"input\"\>=LOG(10;3)\</item\> devolve o logaritmo para a base 3 de 10 (aproximadamente 2,0959).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5577562				0	pt	\<item type=\"input\"\>=LOG(7^4;7)\</item\> devolve 4.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3154187				0	pt	\<bookmark_value\>função LOG10\</bookmark_value\>\<bookmark_value\>logaritmo de base 10\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154187				0	pt	LOG10				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155476				0	pt	\<ahelp hid=\"HID_FUNC_LOG10\"\>Devolve o logaritmo de base 10 de um número.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155494				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159294				0	pt	LOG10(Número)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159308				0	pt	Devolve o logaritmo para a base 10 de \<emph\>Número\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3159328				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157916				0	pt	\<item type=\"input\"\>=LOG10(5)\</item\> devolve o logaritmo de base 10 de 5 (aproximadamente 0,69897).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152518				0	pt	\<bookmark_value\>função ARRED.EXCESSO\</bookmark_value\>\<bookmark_value\>arredondar;por excesso para múltiplos de significância\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152518				0	pt	ARRED.EXCESSO				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153422				0	pt	\<ahelp hid=\"HID_FUNC_OBERGRENZE\"\>Arredonda um número até ao múltiplo de significância mais próximo.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153440				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153454				0	pt	ARRED.EXCESSO(Número; Significância; Modo)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153467				0	pt	\<emph\>Número\</emph\> corresponde ao número que será arredondado para cima.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155000				0	pt	\<emph\>Significância\</emph\> é o número para o múltiplo do qual o valor será arredondado para cima.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155020				0	pt	\<emph\>Modo\</emph\> corresponde a um valor opcional. Se o valor Modo for especificado e não for igual a zero, e se Número e Significância forem negativos, o arredondamento é efectuado com base no valor absoluto de Número. Este parâmetro é ignorado ao exportar para MS Excel, uma vez que o Excel não reconhece terceiros parâmetros.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163792				0	pt	Se ambos os parâmetros Número e Significância forem negativos e o valor Modo for igual a zero ou não tiver sido especificado, os resultados no $[officename] e no Excel serão diferentes após a conclusão da importação. Se exportar a folha de cálculo para o Excel, utilize Modo=1 para ver os mesmos resultados no Excel e no Calc.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145697				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145710				0	pt	\<item type=\"input\"\>=ARRED.EXCESSO(-11;-2)\</item\> devolve -10				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145725				0	pt	\<item type=\"input\"\>=ARRED.EXCESSO(-11;-2;0)\</item\> devolve -10				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145740				0	pt	\<item type=\"input\"\>=ARRED.EXCESSO(-11;-2;1)\</item\> devolve -12				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3157762				0	pt	\<bookmark_value\>função PI\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157762				0	pt	PI				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157790				0	pt	\<ahelp hid=\"HID_FUNC_PI\"\>Devolve 3.14159265358979, o valor da constante matemática PI para 14 casas decimais.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157809				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157822				0	pt	PI()				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157836				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152370				0	pt	\<item type=\"input\"\>=PI()\</item\> devolve 3,14159265358979.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152418				0	pt	\<bookmark_value\>função POLINOMIAL\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152418				0	pt	POLINOMIAL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152454				0	pt	\<ahelp hid=\"HID_AAI_FUNC_MULTINOMIAL\"\> Devolve o factorial da soma dos argumentos dividido pelo produto dos factoriais dos argumentos.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155646				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155660				0	pt	POLINOMIAL(Número(s))				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155673				0	pt	\<emph\>Número(s)\</emph\> corresponde a uma lista de um máximo de 30 números.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155687				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155701				0	pt	\<item type=\"input\"\>=POLINOMIAL(F11:H11)\</item\> devolve 1260 se o intervalo F11 a H11 incluir os valores \<item type=\"input\"\>2\</item\>, \<item type=\"input\"\>3\</item\> e \<item type=\"input\"\>4\</item\>. Corresponde à fórmula =(2+3+4)! / (2!*3!*4!)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3155717				0	pt	\<bookmark_value\>função POTÊNCIA\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155717				0	pt	POTÊNCIA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159495				0	pt	\<ahelp hid=\"HID_FUNC_POTENZ\"\>Devolve o número elevado a outro número.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3159513				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159526				0	pt	POTÊNCIA(Base; expoente)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159540				0	pt	Devolve a \<emph\>Base\</emph\> elevada à potência do \<emph\>Expoente\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5081637				0	pt	O mesmo resultado pode ser obtido utilizando o operador de exponenciação ^:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9759514				0	pt	\<item type=\"literal\"\>Base^Expoente\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3159580				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159594				0	pt	\<item type=\"input\"\>=POTÊNCIA(4;3)\</item\> devolve 64, que corresponde a 4 elevado à potência de 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1614429				0	pt	=4^3 também devolve 4 à potência de 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152651				0	pt	\<bookmark_value\>função SOMASÉRIE\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152651				0	pt	SOMASÉRIE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152688				0	pt	\<ahelp hid=\".\"\>Soma os primeiros termos de uma série de potências.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152708				0	pt	SOMASÉRIE(x;n;m;coeficientes) = coeficiente_1*x^n + coeficiente_2*x^(n+m) + coeficiente_3*x^(n+2m) +...+ coeficiente_i*x^(n+(i-1)m)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152724				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_idN11BD9				0	pt	SOMASÉRIE(X; N; M; Coeficientes)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152737				0	pt	\<emph\>X\</emph\> corresponde ao valor de entrada da série de potências.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144344				0	pt	\<emph\>N\</emph\> corresponde à potência inicial				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144357				0	pt	\<emph\>M\</emph\> é o incremento para aumentar N				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144370				0	pt	\<emph\>Coeficientes\</emph\> corresponde a um conjunto de coeficientes. Para cada coeficiente, a soma do conjunto é aumentada por uma secção.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144386				0	pt	\<bookmark_value\>função PRODUTO\</bookmark_value\>\<bookmark_value\>números;multiplicar\</bookmark_value\>\<bookmark_value\>multiplicar;números\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144386				0	pt	PRODUTO				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144414				0	pt	\<ahelp hid=\"HID_FUNC_PRODUKT\"\>Multiplica todos os números atribuídos como argumentos e devolve o produto.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144433				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144446				0	pt	PRODUTO(Número1; Número2; ...; Número30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144460				0	pt	\<emph\>Número1 a 30\</emph\> correspondem a um máximo de 30 argumentos cujo produto deve ser calculado.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1589098				0	pt	PRODUTO devolve número1 * número2 * número3 * ...				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144480				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144494				0	pt	\<item type=\"input\"\>=PRODUTO(2;3;4)\</item\> devolve 24.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3160340				0	pt	\<bookmark_value\>função SOMARQUAD\</bookmark_value\>\<bookmark_value\>adições de números ao quadrado\</bookmark_value\>\<bookmark_value\>somas;de números ao quadrado\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160340				0	pt	SOMARQUAD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160368				0	pt	\<ahelp hid=\"HID_FUNC_QUADRATESUMME\"\>Se quiser calcular a soma das raízes quadradas dos números (total das raízes quadradas dos argumentos), insira os números nos campos de texto.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160388				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160402				0	pt	SOMARQUAD(Número1; Número2; ...; Número30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160415				0	pt	\<emph\>Número1 a 30\</emph\> corresponde a um máximo de 30 argumentos, cujas raízes quadradas serão somadas.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160436				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160449				0	pt	Se inserir os números \<item type=\"input\"\>2\</item\>; \<item type=\"input\"\>3\</item\> e \<item type=\"input\"\>4\</item\> nas caixas de texto Número 1; 2 e 3, será devolvido 29 como resultado.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3158247				0	pt	\<bookmark_value\>função RESTO\</bookmark_value\>\<bookmark_value\>restos das divisões\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158247				0	pt	RESTO				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158276				0	pt	\<ahelp hid=\"HID_FUNC_REST\"\>Devolve o resto quando um número inteiro é dividido por outro.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158294				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158308				0	pt	RESTO(Dividendo; Divisor)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158321				0	pt	 Para argumentos de número inteiro esta função devolve Dividendo por Divisor, que corresponde ao resto quando \<emph\>Dividendo\</emph\> é dividido pelo \<emph\>Divisor\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158341				0	pt	Esta função é implementada como \<item type=\"literal\"\>Dividendo - Divisor * INT(Dividendo/Divisor)\</item\>, pelo que esta fórmula devolve o resultado se os argumentos não forem números inteiros.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158361				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158374				0	pt	\<item type=\"input\"\>=RESTO(22;3)\</item\> devolve 1, o resto quando 22 é divido por 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1278420				0	pt	\<item type=\"input\"\>=RESTO(11,25;2,5)\</item\> devolve 1,25.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144592				0	pt	\<bookmark_value\>função QUOCIENTE\</bookmark_value\>\<bookmark_value\>divisões\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144592				0	pt	QUOCIENTE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144627				0	pt	\<ahelp hid=\"HID_AAI_FUNC_QUOTIENT\"\>Devolve a parte inteira de uma operação de divisão.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144646				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144659				0	pt	QUOCIENTE(Numerador; Denominador)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9038972				0	pt	Devolve a parte inteira de \<emph\>Numerador\</emph\> dividida por \<emph\>Denominador\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7985168				0	pt	QUOCIENTE é equivalente a \<item type=\"literal\"\>INT(numerador/denominador)\</item\>, excepto o facto de que poderá reportar erros com diferentes códigos de erro.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144674				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144687				0	pt	\<item type=\"input\"\>=QUOCIENTE(11;3)\</item\> devolve 3. O resto de 2 é perdido.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144702				0	pt	\<bookmark_value\>função RADIANOS\</bookmark_value\>\<bookmark_value\>converter;graus em radianos\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144702				0	pt	RADIANOS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158025				0	pt	\<ahelp hid=\"HID_FUNC_RAD\"\>Converte graus em radianos.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158042				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158055				0	pt	RADIANOS(Número)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158069				0	pt	\<emph\>Número\</emph\> corresponde ao ângulo em graus a ser convertido em radianos.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id876186				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3939634				0	pt	\<item type=\"input\"\>=RADIANOS(90)\</item\> devolve 1,570796326794, que corresponde a PI/2 para precisão do Calc.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3158121				0	pt	\<bookmark_value\>função ARRED\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158121				0	pt	ARRED				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158150				0	pt	\<ahelp hid=\"HID_FUNC_RUNDEN\"\>Arredonda um número para um determinado número de casas decimais.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158169				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158182				0	pt	ARRED(Número; Contar)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158196				0	pt	Devolve \<emph\>Número\</emph\> arredondado para \<emph\>Contar\</emph\> casas decimais. Se Contar for omitido ou zero, a função arredonda para o número inteiro mais próximo. Se Contar for negativo, a função arredonda para o 10, 100, 1000, etc. mais próximo.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id599688				0	pt	Esta função arredonda para o número mais próximo. Consulte ARRED.PARA.BAIXO e ARRED.PARA.CIMA para obter alternativas.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145863				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145876				0	pt	\<item type=\"input\"\>=ARRED(2,348;2)\</item\> devolve 2,35				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145899				0	pt	\<item type=\"input\"\>=ARRED(-32,4834;3)\</item\> devolve -32,483. Altere o formato da célula para ver todas as casas decimais.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1371501				0	pt	\<item type=\"input\"\>=ARRED(2,348;0)\</item\> devolve 2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id4661702				0	pt	\<item type=\"input\"\>=ARRED(2,5)\</item\> devolve 3. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7868892				0	pt	\<item type=\"input\"\>=ARRED(987,65;-2)\</item\> devolve 1000.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3145991				0	pt	\<bookmark_value\>função ARRED.PARA.BAIXO\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145991				0	pt	ARRED.PARA.BAIXO				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146020				0	pt	\<ahelp hid=\"HID_FUNC_ABRUNDEN\"\>Arredonda um número por defeito, em direcção a zero, para uma determinada precisão.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146037				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146051				0	pt	ARRED.PARA.BAIXO(Número; Contar)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146064				0	pt	Devolve \<emph\>Número\</emph\> arredondado por defeito (em direcção a zero) para \<emph\>Contar\</emph\> casas decimais. Se Contar for omitido ou zero, a função arredonda por defeito para um número inteiro. Se Contar for negativo, a função arredonda por defeito para o 10, 100, 1000, etc. seguinte.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2188787				0	pt	Esta função arredonda em direcção a zero. Consulte ARRED.PARA.CIMA e ARRED para obter alternativas.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163164				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163178				0	pt	\<item type=\"input\"\>=ARRED.PARA.BAIXO(1,234;2)\</item\> devolve 1,23.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5833307				0	pt	\<item type=\"input\"\>=ARRED.PARA.BAIXO(45,67;0)\</item\> devolve 45.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7726676				0	pt	\<item type=\"input\"\>=ARRED.PARA.BAIXO(-45,67)\</item\> devolve -45.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3729361				0	pt	\<item type=\"input\"\>=ARRED.PARA.BAIXO(987,65;-2)\</item\> devolve 900.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3163268				0	pt	\<bookmark_value\>função ARRED.PARA.CIMA\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163268				0	pt	ARRED.PARA.CIMA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163297				0	pt	\<ahelp hid=\"HID_FUNC_AUFRUNDEN\"\>Arredonda um número por excesso, afastado de zero, para uma determinada precisão.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163315				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163328				0	pt	ARRED.PARA.CIMA(Número; Contar)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163342				0	pt	Devolve \<emph\>Número\</emph\> arredondado por excesso (afastado de zero) para \<emph\>Contar\</emph\> casas decimais. Se Contar for omitido ou zero, a função arredonda por excesso para um número inteiro. Se Contar for negativo, a função arredonda por excesso para o 10, 100, 1000, etc. seguinte.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9573961				0	pt	Esta função arredonda afastando de zero. Consulte ARRED.PARA.BAIXO e ARRED para obter alternativas.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163381				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144786				0	pt	\<item type=\"input\"\>=ARRED.PARA.CIMA(1,1111;2)\</item\> devolve 1,12.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7700430				0	pt	\<item type=\"input\"\>=ARRED.PARA.CIMA(1,2345;1)\</item\> devolve 1,3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1180455				0	pt	\<item type=\"input\"\>=ARRED.PARA.CIMA(45,67;0)\</item\> devolve 46.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3405560				0	pt	\<item type=\"input\"\>=ARRED.PARA.CIMA(-45,67)\</item\> devolve -46.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3409527				0	pt	\<item type=\"input\"\>=ARRED.PARA.CIMA(987,65;-2)\</item\> devolve 1000.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144877				0	pt	\<bookmark_value\>função SEN\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144877				0	pt	SEN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144906				0	pt	\<ahelp hid=\"HID_FUNC_SIN\"\>Devolve o seno do ângulo especificado (em radianos).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144923				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144937				0	pt	SEN(Número)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144950				0	pt	Devolve o seno (trigonométrico) de \<emph\>Número\</emph\>, o ângulo em radianos.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8079470				0	pt	Para devolver o seno de um ângulo em graus, utilize a função RADIANOS.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144969				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144983				0	pt	\<item type=\"input\"\>=SEN(PI()/2)\</item\> devolve 1, o seno em radianos de PI/2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3916440				0	pt	\<item type=\"input\"\>=SEN(RADIANOS(30))\</item\> devolve 0,5, o seno de 30 graus.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3163397				0	pt	\<bookmark_value\>função SENH\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163397				0	pt	SENH				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163426				0	pt	\<ahelp hid=\"HID_FUNC_SINHYP\"\>Devolve o seno hiperbólico de um número.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163444				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163457				0	pt	SENH(Número)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163471				0	pt	Devolve o seno hiperbólico de \<emph\>Número\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163491				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163504				0	pt	\<item type=\"input\"\>=SENH(0)\</item\> devolve 0, o seno hiperbólico de 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3163596				0	pt	\<bookmark_value\>função SOMA\</bookmark_value\>\<bookmark_value\>adicionar;números em intervalos de células\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163596				0	pt	SOMA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163625				0	pt	\<ahelp hid=\"HID_FUNC_SUMME\"\>Adiciona todos os números de uma série de células.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163643				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163656				0	pt	SOMA(Número1; Número2; ...; Número30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163671				0	pt	\<emph\>Número 1 a Número 30\</emph\> corresponde a um máximo de 30 argumentos, cuja soma será calculada.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163690				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163704				0	pt	Se inserir os números \<item type=\"input\"\>2\</item\>; \<item type=\"input\"\>3 \</item\>e \<item type=\"input\"\>4\</item\> nas caixas de texto Número 1; 2 e 3, será devolvido 9 como resultado.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151740				0	pt	\<item type=\"input\"\>=SOMA(A1;A3;B5)\</item\> calcula a soma das três células. \<item type=\"input\"\>=SOMA (A1:E10)\</item\> calcula a soma de todas as células no intervalo de células A1 a E10.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151756				0	pt	As condições ligadas por E podem ser utilizadas com a função SOMA() da seguinte forma:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151774				0	pt	Hipótese de exemplo: inseriu facturas numa tabela. A coluna A contém o valor da data da factura, a coluna B contém os montantes. Quer encontrar uma fórmula que possa utilizar para devolver o total de todos os montantes para um mês específico, por ex. só o montante correspondente ao período a partir de 01-01-2008 e anterior a 01-02-2008. O intervalo com os valores das datas abrange A1:A40, o intervalo que contém os montantes que serão calculados é B1:B40. C1 contém a data de início \<item type=\"input\"\>-01-01\</item\>-2008 das facturas a incluir e C2 a data \<item type=\"input\"\>01-02\</item\>-2008, que já não será incluída.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151799				0	pt	Insira a seguinte fórmula como fórmula de matriz:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151813				0	pt	\<item type=\"input\"\>=SOMA((A1:A40>=C1)*(A1:A40<C2)*B1:B40)\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151828				0	pt	Para inserir esta fórmula como uma fórmula de matriz, tem de premir as teclas Shift\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>+Command \</caseinline\>\<defaultinline\>+ Ctrl\</defaultinline\>\</switchinline\>+ Enter em vez de premir só a tecla Enter para fechar a fórmula. A fórmula será então mostrada na barra \<emph\>Fórmula\</emph\> entre chavetas.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151869				0	pt	{=SOMA((A1:A40>=C1)*(A1:A40<C2)*B1:B40)}				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151884				0	pt	A fórmula é baseada no facto de o resultado de uma comparação corresponder a 1, se o critério for obedecido e a 0 se não for obedecido. Os resultados da comparação individual serão tratados como uma matriz e utilizados na multiplicação de matrizes e, no final, os valores individuais serão somados para que seja obtida a matriz de resultados.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3151957				0	pt	\<bookmark_value\>função SOMA.SE\</bookmark_value\>\<bookmark_value\>adicionar;números especificados\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3151957				0	pt	SOMA.SE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151986				0	pt	\<ahelp hid=\"HID_FUNC_SUMMEWENN\"\>Adiciona as células especificadas por determinados critérios.\</ahelp\> Esta função é utilizada para pesquisar um intervalo quando procurar um determinado valor.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152015				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152028				0	pt	SOMA.SE(Intervalo; Critérios; IntervaloSoma)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152043				0	pt	\<emph\>Intervalo\</emph\> corresponde ao intervalo ao qual serão aplicados os critérios.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152062				0	pt	\<emph\>Critérios\</emph\> corresponde à célula na qual é mostrado o critério de procura ou ao próprio critério de procura. Se os critérios forem registados na fórmula, terão de ser delimitados por aspas.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152083				0	pt	\<emph\>IntervaloSoma\</emph\> corresponde ao intervalo a partir do qual os valores são somados. Se este parâmetro não tiver sido indicado, são somados os valores localizados no Intervalo.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8347422				0	pt	SOMA.SE só suporta o operador de concatenação de referências (~) no parâmetro Critério e só se o parâmetro adicional IntervaloSoma não for indicado.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152110				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152148				0	pt	Para somar só números negativos: \<item type=\"input\"\>=SOMAR.SE(A1:A10;"<0")\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6670125				0	pt	\<item type=\"input\"\>=SOMA.SE(A1:A10;">0";B1:10)\</item\> - soma os valores do intervalo B1:B10 só se os valores correspondentes no intervalo A1:A10 forem >0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6062196				0	pt	Veja CONTAR.SE() para obter mais alguns exemplos de sintaxe que podem ser utilizados com SOMA.SE().				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3151957K				0	pt	\<bookmark_value\>função SOMA.SES\</bookmark_value\>\<bookmark_value\>adicionar;números especificados\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3151957K				0	pt	SOMA.SES				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151986K				0	pt	\<ahelp hid=\"HID_FUNC_SUMMEWNRNG\"\>Soma valores de células num intervalo que cumprem múltiplos critérios em múltiplos intervalos.\</ahelp\> 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152015K				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152028K				0	pt	SOMA.SES( Referência R ; Referência R1 ; Critério C1 [ ; Referência R2 ; Critério C2 ]... )				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152043K				0	pt	Soma o valor de células no intervalo R que cumprem o critério C1 no intervalo de referência R1 e o critério C2 no intervalo de referência R2, e assim por diante. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152062K				0	pt	Um \<emph\> critério\</emph\> é uma referência de célula única, um número ou um texto. Se o critério está escrito na fórmula, tem de estar entre aspas duplas.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152083K				0	pt	Todos os intervalos de \<emph\>referência\</emph\> têm de ter a mesma dimensão e tamanho, senão é devolvido um erro.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152110K				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152148K				0	pt	Soma as células no intervalo A1:A10 se os valores em B1:B10 forem positivos e os valores em D1:D10 forem a letra "A": \<item type=\"input\"\>=SOMA.SES(A1:A10;B1:B10;">0";D1:D10;"A")\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6062196K				0	pt	Veja CONTAR.SES() para obter mais alguns exemplos de sintaxe que podem ser utilizados com SOMA.SES().				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152195				0	pt	\<bookmark_value\>função TAN\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152195				0	pt	TAN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152224				0	pt	\<ahelp hid=\"HID_FUNC_TAN\"\>Devolve a tangente do ângulo especificado (em radianos).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152242				0	pt	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152255				0	pt	TAN(Número)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152269				0	pt	Devolve a tangente (trigonométrica) de \<emph\>Número\</emph\>, o ângulo em radianos.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5752128				0	pt	Para devolver a tangente de um ângulo em graus, utilize a função RADIANOS.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152287				0	pt	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152301				0	pt	\<item type=\"input\"\>=TAN(PI()/4) \</item\>devolve 1, a tangente em radianos de PI/4.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1804864				0	pt	\<item type=\"input\"\>=TAN(RADIANOS(45))\</item\> devolve 1, a tangente de 45 graus.				20200411 15:09:53
