helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id2136295				0	pt	O identificador de versão do produto, por exemplo "300m25(Build:9876)"				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id9200109				0	pt	"numfile"				20200411 15:09:53
