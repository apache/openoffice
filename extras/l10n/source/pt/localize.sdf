helpcontent2	source\text\sbasic\guide\show_dialog.xhp	0	help	par_id3146985				0	pt	DialogLibraries.LoadLibrary( "Standard" )				20200411 15:09:53
helpcontent2	source\text\sbasic\guide\show_dialog.xhp	0	help	par_id3155418				0	pt	oDialog1 = CreateUnoDialog( DialogLibraries.Standard.Dialog1 )				20200411 15:09:53
