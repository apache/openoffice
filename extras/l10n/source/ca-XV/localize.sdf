helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3149879				0	ca-XV	\<bookmark_value\>funció DISTBINOMNEG\</bookmark_value\>\<bookmark_value\>distribució binomial negativa\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149879				0	ca-XV	DISTBINOMNEG				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155437				0	ca-XV	\<ahelp hid=\"HID_FUNC_NEGBINOMVERT\"\>Retorna la distribució binomial negativa.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3145351				0	ca-XV	Sintaxi				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150935				0	ca-XV	DISTBINOMNEG(X; R; PE)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153044				0	ca-XV	\<emph\>X\</emph\> és el valor retornat per a les proves fallides.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151018				0	ca-XV	\<emph\>R\</emph\> és el valor retornat per a les proves satisfactòries.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148878				0	ca-XV	\<emph\>PE\</emph\> és la probabilitat d'èxit d'un intent.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149539				0	ca-XV	Exemple				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148770				0	ca-XV	\<item type=\"input\"\>=DISTBINOMNEG(1;1;0,5)\</item\> retorna 0,25.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3155516				0	ca-XV	\<bookmark_value\>funció INVNORM\</bookmark_value\>\<bookmark_value\>distribució normal;inversa de la\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155516				0	ca-XV	INVNORM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154634				0	ca-XV	\<ahelp hid=\"HID_FUNC_NORMINV\"\>Retorna la inversa de la distribució normal acumulada.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153227				0	ca-XV	Sintaxi				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147534				0	ca-XV	INVNORM(Nombre; Mitjana; DesvEst)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154950				0	ca-XV	\<emph\>Nombre\</emph\> representa el valor de probabilitat que s'utilitza per determinar la distribució normal inversa.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150690				0	ca-XV	\<emph\>Mitjana\</emph\> representa el valor mitjà a la distribució normal.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148594				0	ca-XV	\<emph\>DesvEst\</emph\> és la desviació estàndard de la distribució normal.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155822				0	ca-XV	Exemple				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153921				0	ca-XV	\<item type=\"input\"\>=INVNORM(0,9;63;5)\</item\> retorna 69,41. Si l'ou mitjà pesa 63 grams amb una desviació estàndard de 5, hi haurà una probabilitat del 90% que l'ou no pesi més de 69,41 grams.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153722				0	ca-XV	\<bookmark_value\>funció DISTNORM\</bookmark_value\>\<bookmark_value\>funció de densitat\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153722				0	ca-XV	DISTNORM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150386				0	ca-XV	\<ahelp hid=\"HID_FUNC_NORMVERT\"\>Retorna la funció de densitat o la distribució normal acumulada.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3083282				0	ca-XV	Sintaxi				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150613				0	ca-XV	DISTNORM(Nombre; Mitjana; DesvEst; C)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149820				0	ca-XV	\<emph\>Nombre\</emph\> és el valor de la distribució a partir del qual s'ha de calcular la distribució normal.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146063				0	ca-XV	\<emph\>Mitjana\</emph\> és el valor mitjà de la distribució.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156295				0	ca-XV	\<emph\>DesvEst\</emph\> és la desviació estàndard de la distribució.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145080				0	ca-XV	\<emph\>C\</emph\> és opcional. \<emph\>C\</emph\> = 0 calcula la funció de densitat; \<emph\>C\</emph\> = 1 calcula la distribució.				20200411 15:09:53
