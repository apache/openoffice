helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144786				0	ca-XV	\<item type=\"input\"\>=ARRODAMUNT(1,1111;2)\</item\> retorna 1,12.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7700430				0	ca-XV	\<item type=\"input\"\>=ARRODAMUNT(1,2345;1)\</item\> retorna 1,3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1180455				0	ca-XV	\<item type=\"input\"\>=ARRODAMUNT(45,67;0)\</item\> retorna 46.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3405560				0	ca-XV	\<item type=\"input\"\>=ARRODAMUNT(-45,67)\</item\> retorna -46.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3409527				0	ca-XV	\<item type=\"input\"\>=ARRODAMUNT(987,65;-2)\</item\> retorna 1000.				20200411 15:09:53
