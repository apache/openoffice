helpcontent2	source\text\shared\02\06120000.xhp	0	help	par_id3148520				0	ca-XV	\<ahelp hid=\".uno:DefaultBullet\"\>Assigna pics als paràgrafs seleccionats, o els elimina dels paràgrafs amb pics.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\06120000.xhp	0	help	par_id3155150				0	ca-XV	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Les opcions de pics com el tipus i la posició es defineixen al diàleg \<link href=\"text/shared/01/06050000.xhp\" name=\"Pics i numeració\"\>\<emph\>Pics i numeració\</emph\>\</link\>. Per obrir el diàleg, feu clic a la icona \<emph\>Pics i numeració\</emph\> de la \<link href=\"text/swriter/main0206.xhp\" name=\"barra Pics i numeració\"\>barra Pics i numeració\</link\>\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\02\06120000.xhp	0	help	par_id3145669	8			0	ca-XV	\<switchinline select=\"appl\"\>\<caseinline select=\"IMPRESS\"\>Les opcions de pics com el tipus i la posició es defineixen al diàleg \<link href=\"text/shared/01/06050000.xhp\" name=\"Pics i numeració\"\>Pics i numeració\</link\>. Per obrir el diàleg, feu clic a la icona \<emph\>Pics i numeració\</emph\> de la barra\<emph\>Formatació del text\</emph\>. \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\02\06120000.xhp	0	help	par_id3147576	3			0	ca-XV	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Al \<link href=\"text/swriter/01/03120000.xhp\" name=\"Format web\"\>Format web\</link\>, algunes opcions de pics i numeració no estan disponibles. \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\02\06120000.xhp	0	help	par_id3154317	5			0	ca-XV	\<switchinline select=\"appl\"\>\<caseinline select=\"IMPRESS\"\>La distància entre el text, el marc de text esquerre i la posició dels pics es pot determinar al diàleg \<link href=\"text/shared/01/05030100.xhp\" name=\"Format - Paràgraf\"\>\<emph\>Format - Paràgraf\</emph\>\</link\> introduint el sagnat esquerre i el sagnat de la primera línia.\</caseinline\>\</switchinline\>				20200411 15:09:53
