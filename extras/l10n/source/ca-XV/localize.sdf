helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id0428200810574039				0	ca-XV	\<ahelp hid=\".\"\>Mostra les barres d'error positiu i negatiu.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	hd_id0428200810574031				0	ca-XV	Positiu				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id042820081057411				0	ca-XV	\<ahelp hid=\".\"\>Mostra només les barres d'error positiu.\</ahelp\>				20200411 15:09:53
