helpcontent2	source\text\shared\guide\scripting.xhp	0	help	par_idN1072B				0	ca-XV	L'%PRODUCTNAME admet internament els llenguatges script següents:				20200411 15:09:53
helpcontent2	source\text\shared\guide\scripting.xhp	0	help	par_idN10731				0	ca-XV	%PRODUCTNAME Basic				20200411 15:09:53
