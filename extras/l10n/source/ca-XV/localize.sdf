helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155673				0	ca-XV	\<emph\>Nombre(s)\</emph\> és una llista de fins a 30 nombres.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155687				0	ca-XV	Exemple				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155701				0	ca-XV	\<item type=\"input\"\>=MULTINOMIAL(F11:H11)\</item\> retorna 1260, si F11 a H11 contenen els valors \<item type=\"input\"\>2\</item\>, \<item type=\"input\"\>3\</item\> i \<item type=\"input\"\>4\</item\>. Este resultat correspon a la fórmula =(2+3+4)! / (2!*3!*4!).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3155717				0	ca-XV	\<bookmark_value\>funció POTENCIA\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155717				0	ca-XV	POTENCIA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159495				0	ca-XV	\<ahelp hid=\"HID_FUNC_POTENZ\"\>Retorna un nombre elevat a un altre nombre.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3159513				0	ca-XV	Sintaxi				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159526				0	ca-XV	POTENCIA(Base; Exponent)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159540				0	ca-XV	Retorna la \<emph\>Base\</emph\> elevada a la potència que s'indica a \<emph\>Exponent\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5081637				0	ca-XV	Podeu obtindre el mateix resultat si utilitzeu l'operador d'exponent ^:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9759514				0	ca-XV	\<item type=\"literal\"\>Base^Exponent\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3159580				0	ca-XV	Exemple				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159594				0	ca-XV	\<item type=\"input\"\>=POTENCIA(4;3)\</item\> retorna 64, que és 4 elevat a la potència de 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1614429				0	ca-XV	=4^3 també retorna la potència de 4 elevat a 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152651				0	ca-XV	\<bookmark_value\>funció SUMASERIES\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152651				0	ca-XV	SUMASERIES				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152688				0	ca-XV	\<ahelp hid=\".\"\>Suma els primers termes d'una sèrie de potències.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152708				0	ca-XV	SUMASERIES(x;n;m;coeficients) = coeficient_1*x^n + coeficient_2*x^(n+m) + coeficient_3*x^(n+2m) +...+ coeficient_i*x^(n+(i-1)m)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152724				0	ca-XV	Sintaxi				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_idN11BD9				0	ca-XV	SUMASERIES(X; N; M; Coeficients)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152737				0	ca-XV	\<emph\>X\</emph\> és el valor d'entrada de la sèrie de potències.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144344				0	ca-XV	\<emph\>N\</emph\> és la potència inicial.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144357				0	ca-XV	\<emph\>M\</emph\> és la potència a la qual s'eleva N.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144370				0	ca-XV	\<emph\>Coeficients\</emph\> és una sèrie de coeficients. La suma de sèries s'amplia una secció per a cada coeficient.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144386				0	ca-XV	\<bookmark_value\>funció PRODUCTE\</bookmark_value\>\<bookmark_value\>nombres;multiplicació\</bookmark_value\>\<bookmark_value\>multiplicació;nombres\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144386				0	ca-XV	PRODUCTE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144414				0	ca-XV	\<ahelp hid=\"HID_FUNC_PRODUKT\"\>Multiplica tots els nombres que s'han indicat com a arguments i en retorna el producte.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144433				0	ca-XV	Sintaxi				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144446				0	ca-XV	PRODUCTE(Nombre1; Nombre2; ...; Nombre30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144460				0	ca-XV	\<emph\>Nombre1 fins a 30\</emph\> són fins a 30 arguments el producte dels quals s'ha de calcular.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1589098				0	ca-XV	PRODUCTE retorna nombre1 * nombre2 * nombre3 * ...				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144480				0	ca-XV	Exemple				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144494				0	ca-XV	\<item type=\"input\"\>=PRODUCTE(2;3;4)\</item\> retorna 24.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3160340				0	ca-XV	\<bookmark_value\>funció SUMAQUAD\</bookmark_value\>\<bookmark_value\>addicions de nombres quadrats\</bookmark_value\>\<bookmark_value\>sumes;de nombres quadrats\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160340				0	ca-XV	SUMAQUAD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160368				0	ca-XV	\<ahelp hid=\"HID_FUNC_QUADRATESUMME\"\>Si voleu calcular la suma dels quadrats dels nombres (el total dels quals correspondrà als quadrats dels arguments), introduïu-los en els camps de text.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160388				0	ca-XV	Sintaxi				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160402				0	ca-XV	SUMAQUAD(Nombre1; Nombre2; ...; Nombre30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160415				0	ca-XV	\<emph\>Nombre1 a 30\</emph\> són fins a 30 arguments dels quals s'ha de calcular la suma dels quadrats.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160436				0	ca-XV	Exemple				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160449				0	ca-XV	Si introduïu els nombres \<item type=\"input\"\>2\</item\>, \<item type=\"input\"\>3\</item\> i \<item type=\"input\"\>4\</item\> en els quadres de text Nombre 1, 2 i 3, es retornarà 29 com a resultat.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3158247				0	ca-XV	\<bookmark_value\>funció MOD\</bookmark_value\>\<bookmark_value\>residus de les divisions\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158247				0	ca-XV	MOD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158276				0	ca-XV	\<ahelp hid=\"HID_FUNC_REST\"\>Retorna el residu quan es divideix un enter per un altre.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158294				0	ca-XV	Sintaxi				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158308				0	ca-XV	MOD(Dividend; Divisor)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158321				0	ca-XV	 Per als arguments enters, esta funció retorna el residu quan el \<emph\>Dividend\</emph\> es divideix pel \<emph\>Divisor\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158341				0	ca-XV	Esta funció s'implementa \<item type=\"literal\"\>Dividend - Divisor * ENT(Dividend/Divisor)\</item\>, i esta fórmula dóna el resultat si els arguments no són enters.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158361				0	ca-XV	Exemple				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158374				0	ca-XV	\<item type=\"input\"\>=MOD(22;3)\</item\> retorna 1, el residu quan es divideix 22 entre 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1278420				0	ca-XV	\<item type=\"input\"\>=MOD(11,25;2,5)\</item\> retorna 1,25.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144592				0	ca-XV	\<bookmark_value\>funció QUOCIENT\</bookmark_value\>\<bookmark_value\>divisions\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144592				0	ca-XV	QUOCIENT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144627				0	ca-XV	\<ahelp hid=\"HID_AAI_FUNC_QUOTIENT\"\>Retorna la part entera d'una divisió.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144646				0	ca-XV	Sintaxi				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144659				0	ca-XV	QUOCIENT(Numerador; Denominador)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9038972				0	ca-XV	Retorna la part entera de \<emph\>Numerador\</emph\> dividida entre \<emph\>Denominador\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7985168				0	ca-XV	QUOCIENT és equivalent a \<item type=\"literal\"\>ENT(Numerador/Denominador)\</item\>, però pot ser que mostre errors amb codis d'error diferents.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144674				0	ca-XV	Exemple				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144687				0	ca-XV	\<item type=\"input\"\>=QUOCIENT(11;3)\</item\> retorna 3. El residu de 2 es perd.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144702				0	ca-XV	\<bookmark_value\>funció RADIANS\</bookmark_value\>\<bookmark_value\>conversió;graus, en radians\</bookmark_value\>				20200411 15:09:53
