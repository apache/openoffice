helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1057D				0	ca-XV	\<ahelp hid=\".\"\>Converteix els caràcters del xinés tradicional als caràcters del xinés simplificat. Feu clic a \<emph\>D'acord\</emph\> per convertir el text seleccionat. Si no heu seleccionat text, es convertirà tot el document.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10580				0	ca-XV	De xinés simplificat a xinés tradicional				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10584				0	ca-XV	\<ahelp hid=\".\"\>Converteix els caràcters del xinés simplificat als caràcters del xinés tradicional. Feu clic a \<emph\>D'acord\</emph\> per convertir el text seleccionat. Si no heu seleccionat text, es convertirà tot el document.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1058E				0	ca-XV	Termes comuns				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10592				0	ca-XV	\<ahelp hid=\".\"\>Els termes comuns són paraules que tenen el mateix significat en xinés tradicional i xinés simplificat però que s'escriuen amb caràcters diferents.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10595				0	ca-XV	Converteix els termes comuns				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10599				0	ca-XV	\<ahelp hid=\".\"\>Converteix les paraules amb dos o més caràcters que hi haja a llista de termes comuns. Una vegada comprovada la llista, la resta del text es convertirà caràcter per caràcter.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1059C				0	ca-XV	Edita els termes				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN105A0				0	ca-XV	\<ahelp hid=\".\"\>Obri el diàleg \<link href=\"text/shared/01/06010601.xhp\"\>Edita el diccionari\</link\>, que vos permet editar la llista de termes per a la conversió.\</ahelp\>				20200411 15:09:53
