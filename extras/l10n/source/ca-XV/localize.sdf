helpcontent2	source\text\shared\02\01170101.xhp	0	help	hd_id3155440				0	ca-XV	Valor màxim de desplaçament				20200411 15:09:53
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3148877				0	ca-XV	\<ahelp hid=\"HID_PROP_SCROLLVALUE_MAX\"\>Indica el valor màxim d'un control de la barra de desplaçament.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_idN111E4				0	ca-XV	Valor mínim de desplaçament				20200411 15:09:53
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_idN111E8				0	ca-XV	\<ahelp hid=\"HID_PROP_SCROLLVALUE_MIN\"\>Indica el valor mínim d'un control de la barra de desplaçament.\</ahelp\>				20200411 15:09:53
