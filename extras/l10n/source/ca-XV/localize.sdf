helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_idN11B55				0	ca-XV	\<ahelp hid=\".\"\>Indica el valor que s'ha d'afegir o eliminar quan l'usuari fa clic a la icona de fletxa de la barra de desplaçament.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_idN11B6F				0	ca-XV	Canvi gran				20200411 15:09:53
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_idN11B73				0	ca-XV	\<ahelp hid=\".\"\>Indiqueu el valor que voleu afegir o restar quan l'usuari faça clic al botó lliscant de la barra de desplaçament.\</ahelp\>				20200411 15:09:53
