helpcontent2	source\text\scalc\01\05080000.xhp	0	help	par_id3155855				0	ca-XV	\<ahelp hid=\".\"\>Gestiona les àrees d'impressió. Nomes s'imprimiran les cel·les que es troben dins les àrees d'impressió.\</ahelp\>				20200411 15:09:53
