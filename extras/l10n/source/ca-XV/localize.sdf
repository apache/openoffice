helpcontent2	source\text\schart\01\05040202.xhp	0	help	par_id1006200801024970				0	ca-XV	\<ahelp hid=\".\"\>Seleccioneu on s'ha de creuar l'altre eix: al començament, al final, en un valor indicat o en una categoria.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\05040202.xhp	0	help	par_id1006200801024957				0	ca-XV	\<ahelp hid=\".\" visibility=\"hidden\"\>Introduïu el valor on la línia d'eix s'ha de creuar amb l'altre eix.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\05040202.xhp	0	help	par_id100620080102503				0	ca-XV	\<ahelp hid=\".\" visibility=\"hidden\"\>Seleccioneu la categoria on la línia d'eix s'ha de creuar amb l'altre eix.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\05040202.xhp	0	help	hd_id100620080102509				0	ca-XV	Etiquetes				20200411 15:09:53
