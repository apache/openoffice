helpcontent2	source\text\shared\explorer\database\rep_navigator.xhp	0	help	par_id1111484				0	ca-XV	\<ahelp hid=\".\"\>El Navegador d'informes mostra l'estructura de l'informe. Podeu utilitzar el Navegador d'informes per inserir funcions a l'informe.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\explorer\database\rep_navigator.xhp	0	help	par_id8314157				0	ca-XV	\<ahelp hid=\".\"\>Feu clic a una entrada en el Navegador d'informes. L'objecte o l'àrea corresponents quedaran seleccionats a la vista del Constructor d'informes. Feu clic amb el botó dret a una entrada per obrir-ne el menú contextual.\</ahelp\>				20200411 15:09:53
