helpcontent2	source\text\shared\02\09070100.xhp	0	help	hd_id3149095				0	ca-XV	Telnet				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id3151110				0	ca-XV	\<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXPAGE_HYPERLINK_INTERNET:RB_LINKTYP_TELNET\"\>Crea un enllaç Telnet.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	hd_id3150443				0	ca-XV	Destí				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id9887081				0	ca-XV	\<ahelp hid=\".\"\>Introduïu un URL per al fitxer que voleu obrir quan feu clic a l'enllaç. Si no indiqueu un marc de destinació, el fitxer s'obri al document o marc actual.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	hd_id3155628				0	ca-XV	Navegador WWW				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id3153760				0	ca-XV	\<ahelp hid=\"SVX:IMAGEBUTTON:RID_SVXPAGE_HYPERLINK_INTERNET:BTN_BROWSE\"\>Obri un navegador web en el qual podeu carregar l'URL desitjat.\</ahelp\> Després podeu copiar i enganxar l'URL al camp \<emph\>Destinació\</emph\>.				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	hd_id3155421				0	ca-XV	Objectiu en el document				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id3147618				0	ca-XV	\<ahelp hid=\"SVX:IMAGEBUTTON:RID_SVXPAGE_HYPERLINK_INTERNET:BTN_TARGET\"\>Obri el diàleg \<emph\>Objectiu en el document\</emph\>.\</ahelp\> Ací podeu seleccionar la destinació dins d'un document i afegir-la a l'URL de destinació amb el botó \<emph\>Insereix\</emph\>.				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id3147335				0	ca-XV	\<ahelp hid=\"HID_HYPERLINK_MARKWND_TREE\" visibility=\"hidden\"\>Indica la posició al document de destinació on voleu saltar.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id3149164				0	ca-XV	\<ahelp hid=\"HID_HYPERLINK_MARKWND_APPLY\" visibility=\"hidden\"\>Insereix la destinació al camp \<emph\>Destinació\</emph\> del diàleg \<emph\>Enllaç\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id3155388				0	ca-XV	\<ahelp hid=\"HID_HYPERLINK_MARKWND_CLOSE\" visibility=\"hidden\"\>Un cop s'ha introduït l'enllaç, feu clic a \<emph\>Tanca\</emph\> per definir l'enllaç i eixir del diàleg.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	hd_id3153320				0	ca-XV	Nom d'entrada				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id3151384				0	ca-XV	\<ahelp hid=\"SVX:EDIT:RID_SVXPAGE_HYPERLINK_INTERNET:ED_LOGIN\"\>Indica el vostre nom d'inici de sessió si esteu treballant amb adreces FTP.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	hd_id3148944				0	ca-XV	Contrasenya				20200411 15:09:53
