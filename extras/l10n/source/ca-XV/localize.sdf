helpcontent2	source\text\simpress\guide\table_insert.xhp	0	help	par_id0916200803551581				0	ca-XV	\<ahelp hid=\".\" visibility=\"hidden\"\>Definiu l'alineació vertical del contingut de les cel·les seleccionades o de totes les cel·les. Dividiu o fusioneu cel·les.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\simpress\guide\table_insert.xhp	0	help	par_id0916200803551553				0	ca-XV	\<ahelp hid=\".\" visibility=\"hidden\"\>Es fusionen totes les cel·les seleccionades en una de sola.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\simpress\guide\table_insert.xhp	0	help	par_id0916200803551535				0	ca-XV	\<ahelp hid=\".\" visibility=\"hidden\"\>Es divideix la cel·la seleccionada en diverses cel·les. Apareix el quadre de diàleg Divideix les cel·les.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\simpress\guide\table_insert.xhp	0	help	par_id0916200803551651				0	ca-XV	\<ahelp hid=\".\" visibility=\"hidden\"\>El contingut de la cel·la s'alinea a la part superior de les cel·les.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\simpress\guide\table_insert.xhp	0	help	par_id0916200803551697				0	ca-XV	\<ahelp hid=\".\" visibility=\"hidden\"\>El contingut de la cel·la se centra verticalment a les cel·les.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\simpress\guide\table_insert.xhp	0	help	par_id0916200803551632				0	ca-XV	\<ahelp hid=\".\" visibility=\"hidden\"\>El contingut de la cel·la s'alinea a la part inferior de les cel·les.\</ahelp\>				20200411 15:09:53
