helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146063				0	br	\<emph\>Mean\</emph\> is the mean value of the distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146093				0	br	POISSON(Number; Mean; C)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146098				0	br	\<emph\>Value 1; Value 2;...Value 30\</emph\> are values or ranges. Text has the value of 0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146958				0	br	\<ahelp hid=\"HID_FUNC_QUARTILE\"\>Returns the quartile of a data set.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146964				0	br	MIN(Number 1; Number 2; ...Number 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147238				0	br	PERCENTRANK(Data; Value)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147249				0	br	\<ahelp hid=\"HID_FUNC_MINA\"\>Returns the minimum value in a list of arguments. Here you can also enter text. The value of the text is 0.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147253				0	br	\<emph\>Number\</emph\> represents the value based on which the Poisson distribution is calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147295				0	br	=MINA(A1:B100) returns the smallest value in the list.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147340				0	br	MAX(Number 1; Number 2; ...Number 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147343				0	br	=MAX(A1;A2;A3;50;100;200) returns the largest value from the list.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147401				0	br	=MINA(1; "Text"; 20) returns 0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147534				0	br	NORMINV(Number; Mean; STDEV)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148475				0	br	\<emph\>Value\</emph\> represents the value whose percentile rank must be determined.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148485				0	br	=MAX(A1:B100) returns the largest value from the list.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148594				0	br	\<emph\>STDEV\</emph\> represents the standard deviation of the normal distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148770				0	br	=NEGBINOMDIST(1; 1; 0.5) returns 0.25.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148813				0	br	PERCENTILE(Data;Alpha)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148878				0	br	\<emph\>SP\</emph\> is the probability of the success of an attempt.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149126				0	br	for an even number: =MEDIAN(1; 5; 9; 20) returns the average of the two middle values 5 and 9, thus 7.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149163				0	br	=PERCENTRANK(A1:A50; 50) returns the percentage rank of the value 50 from the total range of all values found in A1:A50. If 50 falls outside the total range, an error message will appear.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149200				0	br	\<emph\>C\</emph\> = 0 calculates the density function; \<emph\>C\</emph\> = 1 calculates the distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149283				0	br	=NORMDIST(70; 63; 5; 0) returns 0.03.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149286				0	br	PHI(0) = 0.4				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149404				0	br	=MAXA(A1:B100) returns the largest value from the list.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149448				0	br	=NORMDIST(70; 63; 5; 1) returns 0.92.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149568	6			0	br	\<emph\>Number 1; Number 2;...Number 30\</emph\> are numerical values or ranges. 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149734				0	br	AVERAGEA(Value 1; Value 2; ... Value 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149820				0	br	\<emph\>Number\</emph\> is the value of the distribution based on which the normal distribution is to be calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149976				0	br	PHI(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150109				0	br	\<emph\>Number 1; Number 2;...Number 30\</emph\> are values or ranges, which represent a sample. Each number can also be replaced by a reference.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150113				0	br	=POISSON(60;50;1) returns 0.93.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150202				0	br	\<emph\>Value 1; Value 2;...Value 30\</emph\> are values or ranges. Text has the value of 0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150254				0	br	\<ahelp hid=\"HID_FUNC_PHI\"\>Returns the values of the distribution function for a standard normal distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150337				0	br	\<emph\>Number 1; Number 2;...Number 30\</emph\> are numerical values or ranges.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150363				0	br	\<ahelp hid=\"HID_FUNC_MAXA\"\>Returns the maximum value in a list of arguments. In opposite to MAX, here you can enter text. The value of the text is 0.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150373				0	br	\<ahelp hid=\"HID_FUNC_MITTELABW\"\>Returns the average of the absolute deviations of data points from their mean.\</ahelp\> Displays the diffusion in a data set.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150386				0	br	\<ahelp hid=\"HID_FUNC_NORMVERT\"\>Returns the density function or the normal cumulative distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150482				0	br	\<ahelp hid=\"HID_FUNC_MITTELWERT\"\>Returns the average of the arguments.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150613				0	br	NORMDIST(Number; Mean; STDEV; C)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150690				0	br	\<emph\>Mean\</emph\> represents the mean value in the normal distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150741				0	br	\<emph\>Number 1; Number 2;...Number 30\</emph\> are numerical values or ranges.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150864				0	br	=AVERAGEA(A1:A50)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150935				0	br	NEGBINOMDIST(X; R; SP)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151018				0	br	\<emph\>R\</emph\> represents the value returned for successful tests.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151177				0	br	\<emph\>Mean\</emph\> represents the middle value of the Poisson distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151187				0	br	=PEARSON(A1:A30; B1:B30) returns the Pearson correlation coefficient of both data sets.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151232				0	br	=AVERAGE(A1:A50)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151241				0	br	\<ahelp hid=\"HID_FUNC_MEDIAN\"\>Returns the median of a set of numbers. In a set containing an uneven number of values, the median will be the number in the middle of the set and in a set containing an even number of values, it will be the mean of the two values in the middle of the set.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151272				0	br	\<emph\>Data_1\</emph\> represents the array of the first data set.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153044				0	br	\<emph\>X\</emph\> represents the value returned for unsuccessful tests.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153054				0	br	\<emph\>Data\</emph\> represents the array of data.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153085				0	br	\<ahelp hid=\"HID_FUNC_MODALWERT\"\>Returns the most common value in a data set.\</ahelp\> If there are several values with the same frequency, it returns the smallest value. An error occurs when a value doesn't appear twice.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153122				0	br	=AVEDEV(A1:A50)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153216				0	br	\<ahelp hid=\"HID_FUNC_PEARSON\"\>Returns the Pearson product moment correlation coefficient r.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153279				0	br	\<emph\>Data_2\</emph\> represents the array of the second data set.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153336				0	br	MINA(Value 1; Value 2; ... Value 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153387				0	br	\<emph\>Data\</emph\> represents the array of data in the sample.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153486				0	br	\<emph\>Number 1; Number 2;...Number 30\</emph\> are numerical values or ranges.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153573				0	br	\<ahelp hid=\"HID_FUNC_QUANTILSRANG\"\>Returns the percentage rank of a value in a sample.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153684				0	br	QUARTILE(Data; Type)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153709				0	br	\<ahelp hid=\"HID_FUNC_MAX\"\>Returns the maximum value in a list of arguments.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153733				0	br	=MODE(A1:A50)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153921				0	br	=NORMINV(0.9; 63; 5) returns 69.41. If the average egg weighs 63 grams with a standard deviation of 5, then there will be 90% probability that the egg will not be heavier than 69.41g grams.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154212				0	br	\<emph\>Alpha\</emph\> represents the percentage of the scale between 0 and 1.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154266				0	br	\<emph\>Data\</emph\> represents the array of data in the sample.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154298				0	br	\<ahelp hid=\"HID_FUNC_POISSON\"\>Returns the Poisson distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154634				0	br	\<ahelp hid=\"HID_FUNC_NORMINV\"\>Returns the inverse of the normal cumulative distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154679				0	br	AVERAGE(Number 1; Number 2; ...Number 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154734				0	br	=MIN(A1:B100) returns the smallest value in the list.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154940				0	br	\<ahelp hid=\"HID_FUNC_QUANTIL\"\>Returns the alpha-percentile of data values in an array.\</ahelp\> A percentile returns the scale value for a data series which goes from the smallest (Alpha=0) to the largest value (alpha=1) of a data series. For \<emph\>Alpha\</emph\> = 25%, the percentile means the first quartile; \<emph\>Alpha\</emph\> = 50% is the MEDIAN.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154950				0	br	\<emph\>Number\</emph\> represents the probability value used to determine the inverse normal distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155260				0	br	\<emph\>Value 1; Value 2;...Value 30\</emph\> are values or ranges. Text has the value of 0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155264				0	br	MEDIAN(Number 1; Number 2; ...Number 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155437				0	br	\<ahelp hid=\"HID_FUNC_NEGBINOMVERT\"\>Returns the negative binomial distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155589				0	br	\<emph\>Type\</emph\> represents the type of quartile. (0 = MIN, 1 = 25%, 2 = 50% (MEDIAN), 3 = 75% and 4 = MAX.)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155849				0	br	PHI(2.25) = 0.03				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155950				0	br	MODE(Number 1; Number 2; ...Number 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156108				0	br	\<emph\>Number\</emph\> represents the value based on which the standard normal distribution is calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156133				0	br	PEARSON(Data_1; Data_2)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156295				0	br	\<emph\>STDEV\</emph\> is the standard deviation of the distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156446				0	br	=MAXA(A1;A2;A3;50;100;200;"Text") returns the largest value from the list.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3157871				0	br	\<emph\>Number 1, Number 2,...Number 30\</emph\> are values or ranges that represent a sample. Each number can also be replaced by a reference.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159147				0	br	=PERCENTILE(A1:A50; 0.1) represents the value in the data set, which equals 10% of the total data scale in A1:A50.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159276				0	br	=QUARTILE(A1:A50; 2) returns the value of which 50% of the scale corresponds to the lowest to highest values in the range A1:A50.				2002-02-02 02:02:02
