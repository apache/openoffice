helpcontent2	source\text\shared\autopi\webwizard04.xhp	0	help	par_idN10585				0	br	\<ahelp hid=\"34241\"\>Displays the file format icon on the index page.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard04.xhp	0	help	par_idN10588				0	br	No. of pages				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard04.xhp	0	help	par_idN1058C				0	br	\<ahelp hid=\"34242\"\>Displays the number of pages in your site on the index page.\</ahelp\>				2002-02-02 02:02:02
