helpcontent2	source\text\swriter\guide\subscript.xhp	0	help	hd_id3155174				0	br	\<variable id=\"subscript\"\>\<link href=\"text/swriter/guide/subscript.xhp\" name=\"Making Text Superscript or Subscript\"\>Making Text Superscript or Subscript\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\guide\subscript.xhp	0	help	par_id3149829				0	br	Choose \<emph\>Format - Character - Position\</emph\>, and then select \<emph\>Superscript\</emph\> or \<emph\>Subscript\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\guide\subscript.xhp	0	help	par_id3153416				0	br	\<link href=\"text/shared/01/05020500.xhp\" name=\"Format - Character - Position\"\>Format - Character - Position\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\guide\subscript.xhp	0	help	par_id3154705				0	br	\<link href=\"text/shared/01/06040200.xhp\" name=\"Tools - AutoCorrect - Replace\"\>Tools - AutoCorrect - Replace\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\guide\subscript.xhp	0	help	par_id3155865				0	br	Do one of the following:				2002-02-02 02:02:02
helpcontent2	source\text\swriter\guide\subscript.xhp	0	help	par_id3155917				0	br	Select the text that you want to make superscript or subscript.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\guide\subscript.xhp	0	help	par_id3156111				0	br	Press Ctrl+Shift+P to make the text superscript, and Ctrl+Shift+B to make the text subscript.				2002-02-02 02:02:02
