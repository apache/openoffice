helpcontent2	source\text\swriter\01\05090300.xhp	0	help	par_id3145245				0	br	\<ahelp hid=\"HID_TABLE_TEXTFLOW\"\>Set the text flow options for the text before and after the table.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090300.xhp	0	help	par_id3147577				0	br	\<ahelp hid=\"SW:CHECKBOX:TP_TABLE_TEXTFLOW:CB_KEEP\"\>Keeps the table and the following paragraph together when you insert the break.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090300.xhp	0	help	par_id3148978				0	br	\<ahelp hid=\"SW:NUMERICFIELD:TP_TABLE_TEXTFLOW:NF_PAGENUM\"\>Enter the page number for the first page that follows the break.\</ahelp\>				2002-02-02 02:02:02
