helpcontent2	source\text\shared\01\05210100.xhp	0	help	par_id3152940				0	br	\<ahelp hid=\"SVX:CHECKBOX:RID_SVXPAGE_AREA:CB_HATCHBCKGRD\"\>Applies a background color to the hatching pattern. Select this checkbox, and then click a color in the list.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05210100.xhp	0	help	par_id3153147	57			0	br	To add a color to the list, choose \<link href=\"text/shared/optionen/01010500.xhp\" name=\"Format - Area\"\>\<emph\>Format - Area\</emph\>\</link\>, click the\<emph\> Colors\</emph\> tab, and then click \<emph\>Edit\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05210100.xhp	0	help	par_id3153626				0	br	\<ahelp hid=\"SVX:LISTBOX:RID_SVXPAGE_AREA:LB_BITMAP\"\>Click the fill that you want to apply to the selected object.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05210100.xhp	0	help	par_id3153698				0	br	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_AREA_RBT_HATCH\"\>Fills the selected object with the hatching pattern that you click in the list. To apply a background color to the hatching pattern, select the \<emph\>Background color\</emph\> box, and then click a color in the list.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05210100.xhp	0	help	par_id3153716				0	br	\<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXPAGE_AREA:RBT_GRADIENT\"\>Fills the selected object with the gradient that you click in the list.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05210100.xhp	0	help	par_id3153970				0	br	\<ahelp hid=\"SVX:TRISTATEBOX:RID_SVXPAGE_AREA:TSB_ORIGINAL\"\>Retains the original size of the bitmap when filling the selected object. To resize the bitmap, clear this checkbox, and then click \<emph\>Relative\</emph\>.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05210100.xhp	0	help	par_id3154673				0	br	\<variable id=\"sytext\"\>\<ahelp hid=\".uno:FillStyle\"\>Select the type of fill that you want to apply to the selected drawing object.\</ahelp\>\</variable\>				2002-02-02 02:02:02
