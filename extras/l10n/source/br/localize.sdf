helpcontent2	source\text\shared\02\06120000.xhp	0	help	par_id3145669	8			0	br	\<switchinline select=\"appl\"\>\<caseinline select=\"IMPRESS\"\>Bullet options such as type and position are defined in the \<link href=\"text/shared/01/06050000.xhp\" name=\"Bullets and Numbering\"\>Bullets and Numbering\</link\> dialog. To open this dialog, click the \<emph\>Bullets and Numbering\</emph\> icon on the \<emph\>Text Formatting\</emph\> Bar. \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\06120000.xhp	0	help	par_id3147576	3			0	br	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>In the \<link href=\"text/swriter/01/03120000.xhp\" name=\"Web Layout\"\>Web Layout\</link\>, some numbering/bullet options are not available. \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\06120000.xhp	0	help	par_id3148520				0	br	\<ahelp hid=\".uno:DefaultBullet\"\>Assigns bullet points to the selected paragraphs, or removes them from bulleted paragraphs.\</ahelp\>				2002-02-02 02:02:02
