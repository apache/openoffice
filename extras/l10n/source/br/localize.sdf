helpcontent2	source\text\shared\optionen\01011000.xhp	0	help	hd_id3156212				0	br	Cache for inserted objects				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01011000.xhp	0	help	hd_id3157909				0	br	\<link href=\"text/shared/optionen/01011000.xhp\" name=\"Memory\"\>Memory\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01011000.xhp	0	help	par_id3145069				0	br	The graphics cache saves the graphics contained in a document in your computer's main memory. This means that the attributes of a graphic stored in the cache do not have to be re-calculated if you return to the page containing the graphic after scrolling through a document.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01011000.xhp	0	help	par_id3145673				0	br	Defines the maximum number of reverse steps allowed.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01011000.xhp	0	help	par_id3148674				0	br	\<ahelp hid=\"OFFMGR_TIMEFIELD_OFA_TP_MEMORY_TF_GRAPHICOBJECTTIME\"\>Specifies the time that each graphic remains in the cache in hours and minutes.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01011000.xhp	0	help	par_id3148685				0	br	\<ahelp hid=\"OFFMGR_NUMERICFIELD_OFA_TP_MEMORY_ED_UNDO\"\>You can specify the number of steps which can be undone by selecting a number from the list.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01011000.xhp	0	help	par_id3148797				0	br	\<ahelp hid=\"OFFMGR_NUMERICFIELD_OFA_TP_MEMORY_NF_GRAPHICOBJECTCACHE\"\>Specifies that objects which are larger than the selected megabytes will not be placed in the cache.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01011000.xhp	0	help	par_id3152813				0	br	\<ahelp hid=\"OFFMGR_NUMERICFIELD_OFA_TP_MEMORY_NF_GRAPHICCACHE\"\>Specifies the total cache size for all graphics.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01011000.xhp	0	help	par_id3152940				0	br	\<switchinline select=\"sys\"\>\<caseinline select=\"WIN\"\>\<ahelp hid=\"OFFMGR_CHECKBOX_OFA_TP_MEMORY_CB_QUICKLAUNCH\"\>Mark this check box if you want $[officename] to enable quickstart at system start-up.\</ahelp\>\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01011000.xhp	0	help	par_id3153192				0	br	\<ahelp hid=\"OFFMGR_NUMERICFIELD_OFA_TP_MEMORY_NF_OLECACHE\"\>Choose the maximum number of OLE objects that are pooled in the cache.\</ahelp\>				2002-02-02 02:02:02
