helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3147299				0	br	\<emph\>Text Extension From Lower Cell Border:\</emph\> Writes the rotated text from the bottom cell edge outwards.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3148458				0	br	\<ahelp hid=\"SVX_TRISTATEBOX_RID_SVXPAGE_ALIGNMENT_BTN_HYPH\"\>Enables word hyphenation for text wrapping to the next line.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3148538				0	br	\<variable id=\"rechtstext\"\>\<ahelp hid=\".uno:AlignRight\"\>Aligns the contents of the cell to the right.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3148555				0	br	\<ahelp hid=\"SVX:TRISTATEBOX:RID_SVXPAGE_ALIGNMENT:BTN_WRAP\"\>Wraps text onto another line at the cell border. The number of lines depends on the width of the cell. To enter a manual line break, press \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command \</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+Enter in the cell.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3148924				0	br	\<ahelp hid=\"SVX_LISTBOX_RID_SVXPAGE_ALIGNMENT_LB_VERALIGN\"\>Select the vertical alignment option that you want to apply to the cell contents.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3149561				0	br	\<emph\>Text Extension From Upper Cell Border:\</emph\> Writes the rotated text from the top cell edge outwards.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3150010				0	br	This checkbox is only available if Asian language support is enabled and the text direction is set to vertical. \<ahelp hid=\"SVX_TRISTATEBOX_RID_SVXPAGE_ALIGNMENT_BTN_ASIAN_VERTICAL\"\>Aligns Asian characters one below the other in the selected cell(s). If the cell contains more than one line of text, the lines are converted to text columns that are arranged from right to left. Western characters in the converted text are rotated 90 degrees to the right. Asian characters are not rotated.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3150506				0	br	\<variable id=\"linkstext\"\>\<ahelp hid=\".uno:AlignLeft\"\>Aligns the contents of the cell to the left.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3150822				0	br	\<ahelp hid=\"SVX_LISTBOX_RID_SVXPAGE_ALIGNMENT_LB_VERALIGN\"\>Aligns the cell contents to the bottom of the cell.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3151210				0	br	\<variable id=\"mittetext\"\>\<ahelp hid=\".uno:AlignVCenter\"\>Vertically centers the contents of the cell.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3151380				0	br	\<ahelp hid=\".uno:AlignVCenter\"\>Sets the text orientation of the cell contents.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3152813				0	br	\<variable id=\"untentext\"\>\<ahelp hid=\".\"\>Aligns the contents of the cell to the lower edge of the cell.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3153194				0	br	\<ahelp hid=\"SVX_NUMERICFIELD_RID_SVXPAGE_ALIGNMENT_NF_DEGREES\"\>Enter the rotation angle for the text in the selected cell(s). A positive number rotates the text to the left and a negative number rotates the text to the right.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3153665				0	br	\<variable id=\"blocktext\"\>\<ahelp hid=\".uno:AlignBlock\"\>Aligns the contents of the cell to the left and to the right cell borders.\</ahelp\>\</variable\>				2002-02-02 02:02:02
