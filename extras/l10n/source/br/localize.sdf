helpcontent2	source\text\scalc\01\12090300.xhp	0	help	tit				0	br	Delete				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1054D				0	br	Grouping				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10551				0	br	Grouping DataPilot tables displays the \<emph\>Grouping\</emph\> dialog for either values or dates.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10568				0	br	Start				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1056C				0	br	Specifies the start of the grouping.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1056F				0	br	Automatically				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10573				0	br	Specifies whether to start grouping at the smallest value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10576				0	br	Manually at				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1057A				0	br	Specifies whether to enter the start value for grouping yourself.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1057D				0	br	End				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10581				0	br	Specifies the end of the grouping.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10584				0	br	Automatically				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10588				0	br	Specifies whether to end grouping at the largest value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1058B				0	br	Manually at				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1058F				0	br	Specifies whether to enter the end value for grouping yourself.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10592				0	br	Group by				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10596				0	br	Specifies the value range by which every group's limits are calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10599				0	br	Number of days				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1059D				0	br	In the case of grouping date values, specifies the number of days to group by.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN105A0				0	br	Intervals				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN105A4				0	br	In the case of grouping date values, specifies the intervals to group by.				2002-02-02 02:02:02
