helpcontent2	source\text\swriter\01\06180000.xhp	0	help	par_id3145246				0	br	\<ahelp hid=\"SW:LISTBOX:TP_LINENUMBERING:LB_FORMAT\" visibility=\"visible\"\>Select the numbering style that you want to use.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06180000.xhp	0	help	par_id3145412				0	br	\<ahelp hid=\"SW:NUMERICFIELD:TP_LINENUMBERING:NF_DIV_INTERVAL\" visibility=\"visible\"\>Enter the number of lines to leave between the separators.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06180000.xhp	0	help	par_id3147295				0	br	\<ahelp hid=\"SW:CHECKBOX:TP_LINENUMBERING:CB_NUMBERING_ON\" visibility=\"visible\"\>Adds line numbers to the current document.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06180000.xhp	0	help	par_id3149286				0	br	\<ahelp hid=\"SW:EDIT:TP_LINENUMBERING:ED_DIVISOR\" visibility=\"visible\"\>Enter the text that you want to use as a separator.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06180000.xhp	0	help	par_id3149685				0	br	\<ahelp hid=\"SW_CHECKBOX_TP_LINENUMBERING_CB_RESTART_PAGE\" visibility=\"visible\"\>Restarts line numbering at the top of each page in the document.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06180000.xhp	0	help	par_id3150249	2			0	br	\<variable id=\"zeinum\"\>Adds or removes and formats line numbers in the current document. To exclude a paragraph from line numbering, click in the paragraph, choose \<emph\>Format - Paragraph\</emph\>, click the \<emph\>Numbering \</emph\>tab, and then clear the \<emph\>Include this paragraph in line numbering\</emph\> check box.\</variable\> You can also exclude a paragraph style from line numbering.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06180000.xhp	0	help	par_id3150358				0	br	Specify whether to include empty paragraphs or lines in text frames in the line count.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06180000.xhp	0	help	par_id3150765				0	br	You can enter a separator character to display between line numbers if the counting interval is more than one.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06180000.xhp	0	help	par_id3150932				0	br	\<ahelp hid=\"SW:LISTBOX:TP_LINENUMBERING:LB_POS\" visibility=\"visible\"\>Select where you want the line numbers to appear.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06180000.xhp	0	help	par_id3150973				0	br	\<ahelp hid=\"SW:CHECKBOX:TP_LINENUMBERING:CB_COUNT_EMPTYLINES\" visibility=\"visible\"\>Includes empty paragraphs in the line count.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06180000.xhp	0	help	par_id3150995				0	br	\<ahelp hid=\"SW:CHECKBOX:TP_LINENUMBERING:CB_COUNT_FRAMELINES\" visibility=\"visible\"\>Adds line numbers to text in text frames. The numbering restarts in each text frame, and is excluded from the line count in the main text area of the document.\</ahelp\> In \<link href=\"text/swriter/02/03210000.xhp\" name=\"linked frames\"\>linked frames\</link\>, the numbering is not restarted.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06180000.xhp	0	help	par_id3151272				0	br	\<ahelp hid=\"SW:NUMERICFIELD:TP_LINENUMBERING:NF_NUM_INVERVAL\" visibility=\"visible\"\>Enter the counting interval for the line numbers.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06180000.xhp	0	help	par_id3153000				0	br	\<ahelp hid=\"SW:LISTBOX:TP_LINENUMBERING:LB_CHAR_STYLE\" visibility=\"visible\"\>Select the formatting style that you want to use for the line numbers.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06180000.xhp	0	help	par_id3153532				0	br	Separators are only displayed in lines that are not numbered.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06180000.xhp	0	help	par_id3153719				0	br	\<ahelp hid=\"SW:METRICFIELD:TP_LINENUMBERING:MF_OFFSET\" visibility=\"visible\"\>Enter the amount of space that you want to leave between the line numbers and the text.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06180000.xhp	0	help	par_id3155621				0	br	Set the properties of the line numbering.				2002-02-02 02:02:02
