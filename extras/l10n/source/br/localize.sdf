helpcontent2	source\text\swriter\01\05060200.xhp	0	help	par_id3147100				0	br	\<variable id=\"keinumlauftext\"\>\<ahelp hid=\"SW:IMAGERADIOBUTTON:TP_FRM_WRAP:RB_NO_WRAP\"\>Places the object on a separate line in the document. The Text in the document appears above and below the object, but not on the sides of the object.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060200.xhp	0	help	par_id3147284				0	br	\<ahelp hid=\"SW:METRICFIELD:TP_FRM_WRAP:ED_TOP_MARGIN\"\>Enter the amount of space that you want between the top edge of the object and the text.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060200.xhp	0	help	par_id3147377				0	br	\<ahelp hid=\"SW:CHECKBOX:TP_FRM_WRAP:CB_ONLYOUTSIDE\"\>Wraps text only around the contour of the object, but not in open areas within the object shape.\</ahelp\> This option is not available for frames.				2002-02-02 02:02:02
