helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3154014				0	br	REM the CBool function is applied as follows:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3155132				0	br	sText = InputBox("Please enter a short sentence:")				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3155413				0	br	If CBool(Instr(sText, "and")) Then				2002-02-02 02:02:02
