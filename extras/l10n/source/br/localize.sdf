helpcontent2	source\text\scalc\02\02130000.xhp	0	help	par_id3146776				0	br	\<link href=\"text/shared/01/05020300.xhp\" name=\"Format - Cell - Numbers\"\>Format - Cell - Numbers\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\02\02130000.xhp	0	help	par_id3148837				0	br	\<ahelp hid=\".uno:NumberFormatCurrency\" visibility=\"visible\"\>Applies the default currency format to the selected cells.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\02\02130000.xhp	0	help	par_id3150214				0	br	Number Format: Currency				2002-02-02 02:02:02
