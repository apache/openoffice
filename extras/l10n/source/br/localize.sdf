helpcontent2	source\text\shared\02\12070200.xhp	0	help	hd_id3152551				0	br	>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070200.xhp	0	help	hd_id3153257				0	br	Paragraph Style				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070200.xhp	0	help	hd_id3153345				0	br	Database columns				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070200.xhp	0	help	hd_id3156136				0	br	Fields				2002-02-02 02:02:02
