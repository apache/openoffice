helpcontent2	source\text\shared\00\01020000.xhp	0	help	par_id3145629	22			0	br	\<ahelp hid=\"HID_MN_READONLY_LOADGRAPHIC\"\>If you have deactivated the graphics display, choose the\<emph\> Load Graphics \</emph\>command to make them visible.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\01020000.xhp	0	help	par_id3148548				0	br	\<ahelp hid=\"HID_MN_READONLY_SAVEBACKGROUND\"\>Allows you to save the background of a Web page.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\01020000.xhp	0	help	par_id3150902				0	br	\<ahelp hid=\"HID_MN_READONLY_GRAPHICOFF\"\>Sets all graphics in the document to be invisible.\</ahelp\> This speeds up the screen display.				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\01020000.xhp	0	help	par_id3151262				0	br	\<ahelp hid=\"HID_MN_READONLY_COPYLINK\"\>Copies the link at the mouse pointer to the clipboard.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\01020000.xhp	0	help	par_id3153910				0	br	\<ahelp hid=\"HID_MN_READONLY_PLUGINOFF\"\>Disables inserted plug-ins.\</ahelp\> Click this command again to reactivate the \<link href=\"text/shared/00/00000002.xhp#plugin\" name=\"plug-ins\"\>plug-ins\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\01020000.xhp	0	help	par_id3155934				0	br	\<ahelp hid=\"HID_MN_READONLY_COPYGRAPHIC\"\>Copies a selected graphic to the clipboard.\</ahelp\>				2002-02-02 02:02:02
