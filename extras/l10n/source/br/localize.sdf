helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3154938				0	br	\<image id=\"img_id3153797\" src=\"res/commandimagelist/sc_graphicfilterremovenoise.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3153797\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3155411				0	br	\<ahelp hid=\"SVX_METRICFIELD_RID_SVX_GRFFILTER_DLG_SEPIA_DLG_FILTERSEPIA_MTR_SEPIA\"\>Defines the intensity of aging, in percent. The higher the value, the more the image ages.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3155805				0	br	Filter				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3155851				0	br	\<image id=\"img_id3150658\" src=\"res/commandimagelist/sc_graphicfilterposter.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3150658\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3155901				0	br	Mosaic				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3156183				0	br	\<ahelp hid=\".uno:GraphicFilterToolbox\"\>Opens the \<emph\>Graphic Filter\</emph\> bar, where you can use various filters on the selected graphic image.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3156284				0	br	Posterize				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3159150				0	br	\<ahelp hid=\".uno:GraphicFilterSolarize\"\>Opens a dialog for defining solarization.\</ahelp\> Solarization refers to an effect that looks like what can happen when there is too much light during photo development. The colors become partly inverted.				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3159399				0	br	\<ahelp hid=\".uno:GraphicFilterSmooth\"\>Softens the contrast in an image.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3163712				0	br	\<ahelp hid=\".uno:GraphicFilterSepia\"\>Opens a dialog for setting the aging function.\</ahelp\> Each time you call this function, the image appears a little bit darker; the colors can be made more gray or brown.				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3163807				0	br	\<ahelp hid=\".uno:GraphicFilterMosaic\"\>Joins small groups of pixels into rectangular areas of the same color.\</ahelp\> The larger the individual rectangles are, the fewer details the graphic image has.				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3163825				0	br	Charcoal Sketch				2002-02-02 02:02:02
