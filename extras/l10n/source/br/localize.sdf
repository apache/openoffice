helpcontent2	source\text\shared\autopi\webwizard00.xhp	0	help	par_idN1054D				0	br	\<link href=\"text/shared/autopi/webwizard00.xhp\"\>Web Wizard\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard00.xhp	0	help	par_idN1055D				0	br	\<ahelp hid=\"34200\"\>The Web Wizard helps you to maintain a web site on an Internet server.\</ahelp\>The Web Wizard converts files in a local folder to a web format and uploads the files to the server. The wizard also uses one of the supplied templates to create an index page that contains hyperlinks to the uploaded files.				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard00.xhp	0	help	par_idN10574				0	br	The wizard involves the following steps:				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard00.xhp	0	help	par_idN105C4				0	br	The Web Wizard uses the File Transfer Protocol (FTP) to upload files to a server. You cannot use the wizard to upload the files if you connect to the internet through a proxy server.				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard00.xhp	0	help	tit				0	br	Web Wizard				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard01.xhp	0	help	par_idN10544				0	br	\<link href=\"text/shared/autopi/webwizard01.xhp\"\>Web Wizard - Introduction\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard01.xhp	0	help	par_idN10554				0	br	\<ahelp hid=\".\"\>You can use the Web Wizard to maintain a web page on server.\</ahelp\> You can also load previously saved Web Wizard settings to maintain an existing web page. These settings include information about the local folder and the ftp server.				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard01.xhp	0	help	par_idN10557				0	br	Choose Web Wizard settings				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard01.xhp	0	help	par_idN1055B				0	br	\<ahelp hid=\"34207\"\>Select the settings that you want to load and then click \<emph\>Load\</emph\>. To start the wizard with the default settings, select "none".\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard01.xhp	0	help	par_idN1055E				0	br	Delete				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard01.xhp	0	help	par_idN10562				0	br	\<ahelp hid=\"34209\"\>Deletes the selected settings.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard01.xhp	0	help	par_idN10565				0	br	\<link href=\"text/shared/autopi/webwizard02.xhp\"\>Web Wizard - Documents\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard01.xhp	0	help	tit				0	br	Web Wizard - Introduction				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN10547				0	br	\<link href=\"text/shared/autopi/webwizard02.xhp\"\>Web Wizard - Documents\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN10557				0	br	Select the files that you want to upload to your web site. You can upload the files to a server or to a local directory.				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN1055A				0	br	Documents				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN1055E				0	br	\<ahelp hid=\"34210\"\>Lists the documents that you want to publish to your web site. The wizard can convert %PRODUCTNAME documents to HTML, PDF, or, in some cases, Flash format before the documents are uploaded. All other files are uploaded in their original file format.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN10561				0	br	Add				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN10565				0	br	\<ahelp hid=\"34211\"\>Opens a dialog where you can select the files that you want to have to your web site. The order of the list determines the order in which the hyperlinks to the documents are displayed on the index page of your web site.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN10568				0	br	Remove				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN1056C				0	br	\<ahelp hid=\"34212\"\>Removes the selected file from the list.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN10577				0	br	Export to file format				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN1057B				0	br	\<ahelp hid=\"34218\"\>Select the file format that you want to export the selected file to.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN1057E				0	br	Title				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN10582				0	br	\<ahelp hid=\"34215\"\>Enter the title for the selected document. The title appears as a hyperlink to the selected document on the index page of your web site.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN10585				0	br	Summary				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN10589				0	br	\<ahelp hid=\"34216\"\>Enter a description for the selected document.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN1058C				0	br	Author				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN10590				0	br	\<ahelp hid=\"34217\"\>Enter the name of the author for the selected document.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN10593				0	br	\<link href=\"text/shared/autopi/webwizard03.xhp\"\>Web Wizard - Main layout\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	tit				0	br	Web Wizard - Documents				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard03.xhp	0	help	par_idN10544				0	br	\<link href=\"text/shared/autopi/webwizard03.xhp\"\>Web Wizard - Main Layout\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard03.xhp	0	help	par_idN10554				0	br	Select the formatting template that you want to use for the layout of the index page of your site. The template defines the text formatting and the position of elements on the page. Some of the available layouts use frames.				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard03.xhp	0	help	par_idN10557				0	br	Layouts				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard03.xhp	0	help	par_idN1055B				0	br	\<ahelp hid=\"34220\"\>Select the layout for the index page.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard03.xhp	0	help	par_idN1055E				0	br	\<link href=\"text/shared/autopi/webwizard04.xhp\"\>Web Wizard - Layout details\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard03.xhp	0	help	tit				0	br	Web Wizard - Main Layout				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard04.xhp	0	help	par_idN10544				0	br	\<link href=\"text/shared/autopi/webwizard04.xhp\"\>Web Wizard - Layout Details\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard04.xhp	0	help	par_idN10554				0	br	Use this page of the wizard to customize the layout options for the index page of your web site.				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard04.xhp	0	help	par_idN10557				0	br	File name				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard04.xhp	0	help	par_idN1055B				0	br	\<ahelp hid=\"34235\"\>Includes the file names of the documents on the index page.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard04.xhp	0	help	par_idN1055E				0	br	Description				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard04.xhp	0	help	par_idN10562				0	br	\<ahelp hid=\"34236\"\>Includes the summary information of the documents on the index page.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard04.xhp	0	help	par_idN10565				0	br	Author				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard04.xhp	0	help	par_idN10569				0	br	\<ahelp hid=\"34237\"\>Includes the names of the people who created the documents on the index page.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard04.xhp	0	help	par_idN1056C				0	br	Creation date				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard04.xhp	0	help	par_idN10570				0	br	\<ahelp hid=\"34238\"\>Includes the creation dates of the documents on the index page.\</ahelp\>				2002-02-02 02:02:02
