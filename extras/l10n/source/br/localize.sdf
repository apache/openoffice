helpcontent2	source\text\shared\optionen\serverauthentication.xhp	0	help	par_idN10602				0	br	\<ahelp hid=\".\"\>Enter the password for the user name.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\serverauthentication.xhp	0	help	par_idN10615				0	br	The outgoing mail server uses the same authentication as the incoming mail server.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\serverauthentication.xhp	0	help	par_idN1061A				0	br	\<ahelp hid=\".\"\>Select if you are required to first read your e-mail before you can send e-mail.\</ahelp\> This method is also called "SMTP after POP3".				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\serverauthentication.xhp	0	help	par_idN10629				0	br	Server name				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\serverauthentication.xhp	0	help	par_idN1062C				0	br	\<ahelp hid=\".\"\>Enter the server name of your POP 3 or IMAP mail server.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\serverauthentication.xhp	0	help	par_idN1063B				0	br	Port				2002-02-02 02:02:02
