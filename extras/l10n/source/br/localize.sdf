helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3152460				0	br	Contents				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3153821				0	br	\<link href=\"text/scalc/01/12120300.xhp\" name=\"Error Alert\"\>Error Alert\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3153876				0	br	Title				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3154510				0	br	Error message				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3156280				0	br	Show error message when invalid values are entered.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3156441				0	br	Browse				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3146984	5			0	br	In both cases, if you select "Stop", the invalid entry is deleted and the previous value is reentered in the cell. The same applies if you close the "Warning" and "Information" dialogs by clicking the \<emph\>Cancel \</emph\>button. If you close the dialogs with the \<emph\>OK\</emph\> button, the invalid entry is not deleted.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3149122				0	br	\<ahelp hid=\"SC:MULTILINEEDIT:TP_VALIDATION_ERROR:EDT_ERROR\"\>Enter the message that you want to display when invalid data is entered in a cell.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3149410				0	br	\<ahelp hid=\"SC:EDIT:TP_VALIDATION_ERROR:EDT_TITLE\"\>Enter the title of the macro or the error message that you want to display when invalid data is entered in a cell.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3150752				0	br	\<emph\>Sample macro:\</emph\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3150768				0	br	\<ahelp hid=\"SC:TRISTATEBOX:TP_VALIDATION_ERROR:TSB_SHOW\"\>Displays the error message that you enter in the \<emph\>Contents\</emph\> area when invalid data is entered in a cell.\</ahelp\> If unchecked, the message is displayed to prevent an invalid entry.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3151115				0	br	\<ahelp hid=\"SC:LISTBOX:TP_VALIDATION_ERROR:LB_ACTION\"\>Select the action that you want to occur when invalid data is entered in a cell.\</ahelp\> The "Stop" action rejects the invalid entry and displays a dialog that you have to close by clicking \<emph\>OK\</emph\>. The "Warning" and "Information" actions display a dialog that can be closed by clicking \<emph\>OK\</emph\> or \<emph\>Cancel\</emph\>. The invalid entry is only rejected when you click \<emph\>Cancel\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3153160				0	br	\<ahelp hid=\"SC:PUSHBUTTON:TP_VALIDATION_ERROR:BTN_SEARCH\"\>Opens the \<link href=\"text/shared/01/06130000.xhp\" name=\"Macro\"\>Macro\</link\> dialog where you can select the macro that is executed when invalid data is entered in a cell. The macro is executed after the error message is displayed.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3153379				0	br	\<ahelp hid=\"SC:TABPAGE:TP_VALIDATION_ERROR\"\>Define the error message that is displayed when invalid data is entered in a cell.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3154138				0	br	You can also start a macro with an error message. A sample macro is provided at the end of this page.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	tit				0	br	Error Alert				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\format_graphic.xhp	0	help	par_id1650440				0	br	\<link href=\"text/shared/01/05990000.xhp\"\>Define Text Attributes\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\format_graphic.xhp	0	help	par_id2480544				0	br	\<ahelp hid=\".\"\>Switches \<emph\>Edit Points\</emph\> mode for an inserted freeform line on and off.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\format_graphic.xhp	0	help	par_id363475				0	br	Sets the layout and anchoring properties for text in the selected drawing or text object.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\format_graphic.xhp	0	help	par_id9746696				0	br	Points				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\format_graphic.xhp	0	help	par_idN10548				0	br	\<link href=\"text/scalc/01/format_graphic.xhp\"\>Graphic\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\format_graphic.xhp	0	help	par_idN10558				0	br	\<ahelp hid=\".\"\>Opens a submenu to edit the properties of the selected object.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\format_graphic.xhp	0	help	tit				0	br	Graphic				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	bm_id3155511				0	br	\<bookmark_value\>DATE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	hd_id3147477				0	br	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	hd_id3148590				0	br	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	hd_id3155511				0	br	\<variable id=\"date\"\>\<link href=\"text/scalc/01/func_date.xhp\"\>DATE\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3150474				0	br	DATE(year; month; day)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3152589				0	br	DATE("00;1;1") yields 1/1/00				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3152815				0	br	\<emph\>Year\</emph\> is an integer between 1583 and 9956 or 0 and 99.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3153183				0	br	\<emph\>Day\</emph\> is a number between 1 and 31 indicating the day of the month.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3153222				0	br	In \<emph\>Tools - Options - $[officename] - General \</emph\>you can set from which year a two-digit number entry is recognized as 20xx.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3153551				0	br	\<ahelp hid=\"HID_FUNC_DATUM\"\>This function converts a date written as year, month, day to an internal serial number and displays it in the cell's formatting.\</ahelp\> The default format of a cell containing the DATE function is the date format, but you can format the cells with the \<emph\>0\</emph\> number format, which displays the internal serial number of the date as a number.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3155817				0	br	\<emph\>Month\</emph\> is an integer between 1 and 12 indicating the month.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3156260				0	br	If the values for month and day are higher, they are carried over to the next digit. If you enter =DATE(00;12;31) the result will be "12/31/00." If, on the other hand, you enter =DATE(00;13;31) the result will be "1/31/01."				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	tit				0	br	DATE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	bm_id3145621				0	br	\<bookmark_value\>DATEVALUE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	hd_id3145621				0	br	\<variable id=\"datevalue\"\>\<link href=\"text/scalc/01/func_datevalue.xhp\"\>DATEVALUE\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	hd_id3156294				0	br	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	hd_id3156309				0	br	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	par_id3145087				0	br	\<ahelp hid=\"HID_FUNC_DATWERT\"\>Returns the internal date number for text in quotes.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	par_id3149268				0	br	DATEVALUE("Text")				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	par_id3149281				0	br	The internal date number is returned as a number. The number is determined by the date system that is used by $[officename] to calculate dates.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	par_id3154819	23			0	br	\<emph\>Text\</emph\> is a valid date expression and must be entered with quotation marks.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	par_id3155841	25			0	br	DATEVALUE("7/20/54") yields 19925				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	tit				0	br	DATEVALUE 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	bm_id3147317				0	br	\<bookmark_value\>DAY function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	hd_id3147317				0	br	\<variable id=\"day\"\>\<link href=\"text/scalc/01/func_day.xhp\"\>DAY\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	hd_id3150487				0	br	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	hd_id3163809	111			0	br	Examples 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3147584				0	br	\<ahelp hid=\"HID_FUNC_TAG\"\>Returns the day of given date value.\</ahelp\> The day is returned as an integer between 1 and 31. You can also enter a negative date/time value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3149430				0	br	DAY(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3149443				0	br	\<emph\>Number\</emph\>, as a time value, is a decimal, for which the day is to be returned.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3151200				0	br	DAY(1) returns 31 (since $[officename] starts counting at zero from December 30, 1899)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3154130				0	br	DAY(NOW()) returns the current day.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3159190				0	br	DAY(C4) returns 5 if the contents of C4 = 8/5/1901.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	tit				0	br	DAY 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	bm_id3151328				0	br	\<bookmark_value\>DAYS function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	hd_id3151001				0	br	Examples				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	hd_id3151328				0	br	\<variable id=\"days\"\>\<link href=\"text/scalc/01/func_days.xhp\"\>DAYS\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	hd_id3155184				0	br	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3149578				0	br	DAYS(Date_2;Date_1)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3151376				0	br	\<emph\>Date_1\</emph\> is the start date, \<emph\>Date_2\</emph\> is the end date. If \<emph\>Date_2\</emph\> is an earlier date than \<emph\>Date_1\</emph\> the result is a negative number.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3155139				0	br	\<ahelp hid=\"HID_FUNC_TAGE\"\>Calculates the difference between two date values.\</ahelp\> The result returns the number of days between the two days.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3159101				0	br	DAYS("1/1/2010"; NOW()) returns the number of days from today until January 1, 2010.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3163720				0	br	DAYS("10/10/1990";"10/10/1980") returns 3652.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	tit				0	br	DAYS 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_days360.xhp	0	help	bm_id3148555				0	br	\<bookmark_value\>DAYS360 function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_days360.xhp	0	help	hd_id3148555				0	br	\<variable id=\"days360\"\>\<link href=\"text/scalc/01/func_days360.xhp\"\>DAYS360\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_days360.xhp	0	help	hd_id3148641				0	br	Examples				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_days360.xhp	0	help	hd_id3155347				0	br	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_days360.xhp	0	help	par_id3145263				0	br	If Date_2 is earlier than Date_1, the function will return a negative number.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_days360.xhp	0	help	par_id3151064				0	br	The optional argument \<emph\>Type\</emph\> determines the type of difference calculation. If Type = 0 or if the argument is missing, the US method (NASD, National Association of Securities Dealers) is used. If Type <> 0, the European method is used.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_days360.xhp	0	help	par_id3155313				0	br	DAYS360(Date_1;Date_2;Type)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_days360.xhp	0	help	par_id3156032				0	br	\<ahelp hid=\"HID_FUNC_TAGE360\"\>Returns the difference between two dates based on the 360 day year used in interest calculations.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_days360.xhp	0	help	par_id3156348				0	br	DAYS360("1/1/2000";NOW()) returns the number of interest days from January 1, 2000 until today.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_days360.xhp	0	help	tit				0	br	DAYS360 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	bm_id3152960				0	br	\<bookmark_value\>EASTERSUNDAY function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	hd_id3152960				0	br	\<variable id=\"eastersunday\"\>\<link href=\"text/scalc/01/func_eastersunday.xhp\"\>EASTERSUNDAY\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	hd_id3155120				0	br	Examples				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	hd_id9460127				0	br	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id2113711				0	br	EASTERSUNDAY(Year)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3146072				0	br	Pentecost Sunday = EASTERSUNDAY() + 49				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3147521				0	br	Good Friday = EASTERSUNDAY() - 2				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3149553				0	br	Pentecost Monday = EASTERSUNDAY() + 50				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3150940				0	br	EASTERSUNDAY(2000)+49 returns the internal serial number 36688. If you use the MMDDYY date format, the result is 06/11/00.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3154472				0	br	EASTERSUNDAY(2000) returns 4/23/00				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3154570				0	br	\<ahelp hid=\"HID_FUNC_OSTERSONNTAG\"\>Returns the date of Easter Sunday for the entered year.\</ahelp\> Year is an integer between 1583 and 9956 or 0 and 99. You can also calculate other holidays by simple addition with this date.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3156156				0	br	Easter Monday = EASTERSUNDAY() + 1				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3938413				0	br	\<emph\>Year\</emph\> is an integer between 1583 and 9956 or 0 and 99. You can also calculate other holidays by simple addition with this date.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	tit				0	br	EASTERSUNDAY				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_edate.xhp	0	help	bm_id3151184				0	br	\<bookmark_value\>EDATE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_edate.xhp	0	help	hd_id3151184				0	br	\<variable id=\"edate\"\>\<link href=\"text/scalc/01/func_edate.xhp\"\>EDATE\</link\>\</variable\>				2002-02-02 02:02:02
