helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3145244				0	br	\<ahelp hid=\"SW:EDIT:TP_FORMAT_TABLE:ED_NAME\"\>Enter an internal name for the table. You can use this name to quickly locate the table in the Navigator.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3145412				0	br	Set the alignment options for the selected table.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3145763				0	br	\<ahelp hid=\"SW:METRICFIELD:TP_FORMAT_TABLE:ED_BOTTOM_DIST\"\>Enter the amount of space that you want to leave between the bottom edge of the table and the text below the table.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3145782				0	br	To insert a paragraph before a table at the beginning of a document, header or footer, place the cursor before any content in the first cell, and then press Enter.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3146322				0	br	\<ahelp hid=\"HID_FORMAT_TABLE\"\>Specify the size, position, spacing, and alignment options for the selected table.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3147220	30			0	br	\<ahelp hid=\"SW:METRICFIELD:TP_FORMAT_TABLE:ED_RIGHT_DIST\"\>Enter the amount of space that you want to leave between the right page margin and the edge of the table.\</ahelp\> This option is not available if the \<emph\>Automatic \</emph\>or the \<emph\>Right\</emph\> option is selected in the \<emph\>Alignment\</emph\> area.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3149026				0	br	\<ahelp hid=\"SW:METRICFIELD:TP_FORMAT_TABLE:ED_WIDTH\"\>Enter the width of the table.\</ahelp\> This check box is only available if the \<emph\>Automatic\</emph\> option in the \<emph\>Alignment\</emph\> area is not selected.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3149696				0	br	\<ahelp hid=\"SW:RADIOBUTTON:TP_FORMAT_TABLE:RB_CENTER\"\>Centers the table horizontally on the page.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3151183				0	br	\<ahelp hid=\"SW:CHECKBOX:TP_FORMAT_TABLE:CB_REL_WIDTH\"\>Displays the width of the table as a percentage of the page width.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3152771				0	br	\<ahelp hid=\"SW:METRICFIELD:TP_FORMAT_TABLE:ED_TOP_DIST\"\>Enter the amount of space that you want to leave between the top edge of the table and the text above the table.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3153540				0	br	\<ahelp hid=\"SW:RADIOBUTTON:TP_FORMAT_TABLE:RB_LEFT\"\>Aligns the left edge of the table to the left page margin.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3153672	37			0	br	\<ahelp hid=\"SW:RADIOBUTTON:TP_FORMAT_TABLE:RB_FROM_LEFT\"\>Aligns the left edge of the table to the indent that you enter in the \<emph\>Left \</emph\>box in the \<emph\>Spacing \</emph\>area.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3154108				0	br	\<ahelp hid=\"SW:RADIOBUTTON:TP_FORMAT_TABLE:RB_FULL\"\>Extends the table horizontally to the left and to the right page margins.\</ahelp\> This is the recommended setting for tables in HTML documents.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3154567				0	br	\<ahelp hid=\"SW:RADIOBUTTON:TP_FORMAT_TABLE:RB_RIGHT\"\>Aligns the right edge of the table to the right page margin.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3154836	28			0	br	\<ahelp hid=\"SW:METRICFIELD:TP_FORMAT_TABLE:ED_LEFT_DIST\"\>Enter the amount of space that you want to leave between the left page margin and the edge of the table.\</ahelp\> This option is not available if the \<emph\>Automatic \</emph\>or the \<emph\>Left\</emph\> option is selected in the \<emph\>Alignment\</emph\> area.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3155180	24			0	br	\<ahelp hid=\"SW:RADIOBUTTON:TP_FORMAT_TABLE:RB_FREE\"\>Horizontally aligns the table based on the values that you enter in the \<emph\>Left\</emph\> and \<emph\>Right\</emph\> boxes in the\<emph\> Spacing\</emph\> area.\</ahelp\> $[officename] automatically calculates the table width. Select this option if you want to specify the individual \<link href=\"text/swriter/01/05090200.xhp\" name=\"column widths\"\>column widths\</link\>.				2002-02-02 02:02:02
