helpcontent2	source\text\shared\00\00000007.xhp	0	help	par_id3151370	7			0	br	\<variable id=\"objektleiste\"\>Icon on the Formatting Bar: \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000007.xhp	0	help	par_id3152352	5			0	br	\<variable id=\"textobjektleiste\"\>Icon on the Formatting Bar: \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000007.xhp	0	help	par_id3152823	4			0	br	\<variable id=\"werkzeugleiste\"\>Icon on the Tools bar: \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000007.xhp	0	help	par_id3153551				0	br	Asian Language Support				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000007.xhp	0	help	par_id3156326				0	br	These commands can only be accessed after you enable support for Asian languages in \<emph\>Tools - Options - Language Settings - Languages\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000007.xhp	0	help	par_id3156553				0	br	\<variable id=\"symbolleistenneu\"\>This overview describes the default toolbar configuration for $[officename].\</variable\>				2002-02-02 02:02:02
