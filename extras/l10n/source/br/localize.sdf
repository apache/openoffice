helpcontent2	source\text\shared\01\05030300.xhp	0	help	par_id3143231				0	br	\<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXPAGE_TABULATOR:BTN_FILLCHAR_NO\"\>Inserts no fill characters, or removes existing fill characters to the left of the tab stop.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030300.xhp	0	help	par_id3144422				0	br	\<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXPAGE_TABULATOR:BTN_TABTYPE_DECIMAL\"\>Aligns the decimal point of a number to the center of the tab stop and text to the left of the tab.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030300.xhp	0	help	par_id3145660				0	br	\<ahelp hid=\"SVX:PUSHBUTTON:RID_SVXPAGE_TABULATOR:BTN_DELALL\"\>Removes all of the tab stops that you defined under \<emph\>Position\</emph\>. Sets \<emph\>Left\</emph\> tab stops at regular intervalls as the default tab stops.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030300.xhp	0	help	par_id3146847				0	br	The name of this tab stop is \<emph\>Left/Top\</emph\> if Asian language support is enabled.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030300.xhp	0	help	par_id3147653				0	br	If you want, you can also use the ruler to set the tab positions.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030300.xhp	0	help	par_id3148491				0	br	This name of this tab stop is \<emph\>Right/Bottom\</emph\> if Asian language support is enabled.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030300.xhp	0	help	par_id3149514				0	br	Select the type of tab stop that you want to modify.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030300.xhp	0	help	par_id3150441				0	br	\<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXPAGE_TABULATOR:BTN_FILLCHAR_OTHER\"\>Allows you to specify a character to fill the empty space to the left of the tab stop.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030300.xhp	0	help	par_id3151043				0	br	\<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXPAGE_TABULATOR:BTN_FILLCHAR_UNDERSCORE\"\>Draws a line to fill the empty space to the left of the tab stop.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030300.xhp	0	help	par_id3151384				0	br	\<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXPAGE_TABULATOR:BTN_TABTYPE_RIGHT\"\>Aligns the right edge of the text to the tab stop and extends the text to the left of the tab stop.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030300.xhp	0	help	par_id3153192				0	br	\<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXPAGE_TABULATOR:BTN_FILLCHAR_POINTS\"\>Fills the empty space to the left of the tab stop with dots.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030300.xhp	0	help	par_id3153331				0	br	\<ahelp hid=\"SVX:METRICBOX:RID_SVXPAGE_TABULATOR:ED_TABPOS\"\>Select a tab stop type, enter a new measurement, and then click \<emph\>New\</emph\>. If you want, you can also specify the measurement units to use for the tab (cm for centimeter, or " for inches). Existing tabs to the left of the first tab that you set are removed.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030300.xhp	0	help	par_id3153577				0	br	\<ahelp hid=\"HID_TABULATOR\"\>Set the position of a tab stop in a paragraph.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030300.xhp	0	help	par_id3153698				0	br	\<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXPAGE_TABULATOR:BTN_TABTYPE_LEFT\"\>Aligns the left edge of the text to the tab stop and extends the text to the right.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030300.xhp	0	help	par_id3153778				0	br	\<ahelp hid=\"SVX:EDIT:RID_SVXPAGE_TABULATOR:ED_TABTYPE_DECCHAR\"\>Enter a character that you want the decimal tab to use as a decimal separator.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030300.xhp	0	help	par_id3154153				0	br	Specify the characters to use as leader to the left of the tab stop.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030300.xhp	0	help	par_id3154347				0	br	\<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXPAGE_TABULATOR:BTN_TABTYPE_CENTER\"\>Aligns the center of the text to the tab stop.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030300.xhp	0	help	par_id3154388	19			0	br	\<switchinline select=\"sys\"\>\<caseinline select=\"WIN\"\>The character that is used as a decimal separator depends on the regional setting of your operating system. \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030300.xhp	0	help	par_id3156212				0	br	\<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXPAGE_TABULATOR:BTN_FILLCHAR_DASHLINE\"\>Fills the empty space to the left of the tab stop with dashes.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030300.xhp	0	help	par_id3163717				0	br	\<ahelp hid=\"SVX:PUSHBUTTON:RID_SVXPAGE_TABULATOR:BTN_NEW\"\>Adds the tab stop that you defined to the current paragraph.\</ahelp\>				2002-02-02 02:02:02
