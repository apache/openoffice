helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3145313				0	br	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_LEFT\"\>If the \<emph\>Keep Scale\</emph\> option is selected, enter a positive amount to trim the left edge of the graphic, or a negative amount to add white space to the left of the graphic. If the \<emph\>Keep image size\</emph\> option is selected, enter a positive amount to increase the horizontal scale of the graphic, or a negative amount to decrease the horizontal scale of the graphic.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3145382				0	br	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_RIGHT\"\>If the \<emph\>Keep Scale\</emph\> option is selected, enter a positive amount to trim the right edge of the graphic, or a negative amount to add white space to the right of the graphic. If the \<emph\>Keep image size\</emph\> option is selected, enter a positive amount to increase the horizontal scale of the graphic, or a negative amount to decrease the horizontal scale of the graphic.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3148755				0	br	Changes the size of the selected graphic.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3148943				0	br	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_WIDTHZOOM\"\>Enter the width for the selected graphic as a percentage.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3149346				0	br	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_GRFCROP_RB_ZOOMCONST\"\>Maintains the original scale of the graphic when you crop, so that only the size of the graphic changes.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3150084				0	br	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_BOTTOM\"\>If the \<emph\>Keep Scale\</emph\> option is selected, enter a positive amount to trim the bottom of the graphic, or a negative amount to add white space below the graphic. If the \<emph\>Keep image size\</emph\> option is selected, enter a positive amount to increase the vertical scale of the graphic, or a negative amount to decrease the vertical scale of the graphic.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3150543				0	br	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_WIDTH\"\>Enter a width for the selected graphic.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3150603				0	br	\<ahelp hid=\".\"\>Trims or scales the selected graphic. You can also restore the graphic to its original size.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3152372				0	br	Use this area to trim or scale the selected graphic, or to add white space around the graphic.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3153257				0	br	Changes the scale of the selected graphic.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3154068				0	br	\<ahelp hid=\"SVX_PUSHBUTTON_RID_SVXPAGE_GRFCROP_PB_ORGSIZE\"\>Returns the selected graphic to its original size.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3154348				0	br	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_HEIGHTZOOM\"\>Enter the height of the selected graphic as a percentage.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3154514				0	br	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_TOP\"\>If the \<emph\>Keep Scale\</emph\> option is selected, enter a positive amount to trim the top of the graphic, or a negative amount to add white space above the graphic. If the \<emph\>Keep image size\</emph\> option is selected, enter a positive amount to increase the vertical scale of the graphic, or a negative amount to decrease the vertical scale of the graphic.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3154686				0	br	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_HEIGHT\"\>Enter a height for the selected graphic.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3155892				0	br	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_GRFCROP_RB_SIZECONST\"\>Maintains the original size of the graphic when you crop, so that only the scale of the graphic changes. To reduce the scale of the graphic, select this option and enter negative values in the cropping boxes. To increase the scale of the graphic, enter positive values in the cropping boxes.\</ahelp\>				2002-02-02 02:02:02
