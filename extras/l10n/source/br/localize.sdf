helpcontent2	source\text\shared\01\05280000.xhp	0	help	par_id3156344				0	br	\<ahelp hid=\"HID_FONTWORK_TBI_STYLE_ROTATE\"\>Uses the top or the bottom edge of the selected object as the text baseline.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05280000.xhp	0	help	par_id3157844				0	br	\<ahelp hid=\"SVX:METRICFIELD:RID_SVXDLG_FONTWORK:MTR_FLD_DISTANCE\"\>Enter the amount of space that you want to leave between the text baseline and the base of the individual characters.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05280000.xhp	0	help	par_id3159103				0	br	\<image id=\"img_id3149242\" src=\"svx/res/fw016.png\" width=\"0.1772inch\" height=\"0.1665inch\"\>\<alt id=\"alt_id3149242\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
