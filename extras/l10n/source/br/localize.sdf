helpcontent2	source\text\swriter\01\04210000.xhp	0	help	hd_id3151315				0	br	Selection				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04210000.xhp	0	help	par_id3149806	5			0	br	The horizontal lines that are displayed here belong to the \<emph\>Rulers \</emph\>\<link href=\"text/shared/01/gallery.xhp\" name=\"Gallery\"\>Gallery\</link\> theme. If you want to add more lines to the selection, open the \<emph\>Gallery\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04210000.xhp	0	help	par_id3150758				0	br	\<variable id=\"horizontaltext\"\>\<ahelp hid=\".uno:InsertGraphicRuler\"\>Inserts a horizontal line at the current cursor position.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04210000.xhp	0	help	par_id3152960				0	br	\<ahelp hid=\"HID_VS_RULER\"\>Select the type of line that you want to insert, and then click \<emph\>OK\</emph\>.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04210000.xhp	0	help	par_idN10667				0	br	\<embedvar href=\"text/swriter/guide/insert_line.xhp#insert_line\"/\>				2002-02-02 02:02:02
