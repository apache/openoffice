helpcontent2	source\text\shared\autopi\01100500.xhp	0	help	hd_id3157910				0	br	Static report				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\01100500.xhp	0	help	par_id3149580				0	br	\<ahelp hid=\"HID_DLGREPORT_5_OPTSTATDOCUMENT\"\>Saves the report as a static report. When you open a static report, it will always display the data from the time the report was created.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\01100500.xhp	0	help	par_id3155805				0	br	\<ahelp hid=\"HID_DLGREPORT_5_OPTDYNTEMPLATE\"\>Saves the report as a template. When you open a dynamic report, it will display with the current data contents.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\01100500.xhp	0	help	par_id3156136				0	br	\<ahelp hid=\"HID_DLGREPORT_4_TITLE\"\>Specifies the title that is printed at the title line of each page.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\01100500.xhp	0	help	par_id3156194				0	br	\<ahelp hid=\"HID_DLGREPORT_5_OPTUSETEMPLATE\"\>When you click \<emph\>Finish\</emph\>, the report will be saved.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\01100500.xhp	0	help	par_id3159224				0	br	\<ahelp hid=\".\"\>You can create the report as a static or dynamic report. When you open a dynamic report, it will display with the current data contents. When you open a static report, it will always display the same data from the time when the static report was created.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\01100500.xhp	0	help	par_id3163802				0	br	\<ahelp hid=\"HID_DLGREPORT_5_OPTEDITTEMPLATE\"\>When you click \<emph\>Finish\</emph\>, the report will be saved and opened for edit.\</ahelp\>				2002-02-02 02:02:02
