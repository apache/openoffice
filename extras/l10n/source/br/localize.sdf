helpcontent2	source\text\swriter\01\05090300.xhp	0	help	par_id3149286				0	br	\<ahelp hid=\"SW:RADIOBUTTON:TP_TABLE_TEXTFLOW:RB_BREAKPAGE\"\>Inserts a page break before or after the table.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090300.xhp	0	help	par_id3149695				0	br	\<ahelp hid=\"SW:RADIOBUTTON:TP_TABLE_TEXTFLOW:RB_PAGEBREAKBEFORE\"\>Inserts a page or column break before the table.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090300.xhp	0	help	par_id3151310				0	br	\<ahelp hid=\"SW:RADIOBUTTON:TP_TABLE_TEXTFLOW:RB_BREAKCOLUMN\"\>Inserts a column break before or after the table on a multi-column page.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090300.xhp	0	help	par_id3153350				0	br	\<ahelp hid=\"SW:CHECKBOX:TP_TABLE_TEXTFLOW:CB_HEADLINE\"\>Repeats the table heading on a new page when the table spans more than one page.\</ahelp\>				2002-02-02 02:02:02
