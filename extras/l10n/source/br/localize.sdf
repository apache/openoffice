helpcontent2	source\text\shared\01\02100000.xhp	0	help	par_id3150506	190			0	br	\<ahelp hid=\"SVX:MULTILINEEDIT:RID_SVXDLG_SEARCH:ED_REPLACE_FORMATS\"\>Replacement options are listed in the \<emph\>Options \</emph\>area of the dialog.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100000.xhp	0	help	par_id3150771				0	br	\<ahelp hid=\"SVX:CHECKBOX:RID_SVXDLG_SEARCH:BTN_BACKWARDS\"\>Search starts at the current cursor position and goes backwards to the beginning of the file.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100000.xhp	0	help	par_id3150866				0	br	\<ahelp hid=\"SVX:CHECKBOX:RID_SVXDLG_SEARCH:BTN_SELECTIONS\"\>\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>Searches only the selected cells. \</caseinline\>\<defaultinline\>Searches only the selected text.\</defaultinline\>\</switchinline\>\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100000.xhp	0	help	par_id3151101				0	br	After you close the \<emph\>Find & Replace\</emph\> dialog, you can still search using the last search criteria that you entered, by pressing Shift+\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command \</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+F.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100000.xhp	0	help	par_id3151170				0	br	\<ahelp hid=\"SVX:PUSHBUTTON:RID_SVXDLG_SEARCH:BTN_REPLACE\"\>Replaces the selected text or format that you searched for, and then searches for the next occurrence.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100000.xhp	0	help	par_id3153683	189			0	br	\<ahelp hid=\"SVX:MULTILINEEDIT:RID_SVXDLG_SEARCH:ED_SEARCH_FORMATS\"\>Search options are listed in the \<emph\>Options \</emph\>area of the dialog\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100000.xhp	0	help	par_id3153947				0	br	\<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXDLG_SEARCH:BTN_NOTES\"\>\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>Searches for the characters that you specify in the notes that are attached to the cells. \</caseinline\>\</switchinline\>\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100000.xhp	0	help	par_id3154760				0	br	\<variable id=\"exakt\"\>\<ahelp hid=\"SVX_CHECKBOX_RID_SVXDLG_SEARCH_CB_MATCH_CASE\"\>Distinguishes between uppercase and lowercase characters.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100000.xhp	0	help	par_id3155103	50			0	br	\<ahelp hid=\"SVX:CHECKBOX:RID_SVXDLG_SEARCH:BTN_LAYOUTS\"\>Searches for text formatted with the style that you specify. Select this checkbox, and then select a style from the \<emph\>Search for \</emph\>list. To specify a replacement style, select a style from the \<emph\>Replace with\</emph\> list.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100000.xhp	0	help	par_id3155342				0	br	\<switchinline select=\"appl\"\>\<caseinline select=\"DRAW\"\>\</caseinline\>\<caseinline select=\"IMPRESS\"\>\</caseinline\>\<defaultinline\>\<ahelp hid=\"SVX:CHECKBOX:RID_SVXDLG_SEARCH:BTN_REGEXP\"\>Allows you to use wildcards in your search.\</ahelp\>\</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100000.xhp	0	help	par_id3155805				0	br	\<ahelp hid=\"SVX:LISTBOX:RID_SVXDLG_SEARCH:LB_SEARCH\"\>Enter the text that you want to search for, or select a previous search from the list.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100000.xhp	0	help	par_id3156332				0	br	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>Determines the order for searching the cells. \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100000.xhp	0	help	par_id3156426				0	br	\<ahelp hid=\"SVX:LISTBOX:RID_SVXDLG_SEARCH:LB_REPLACE\"\>Enter the replacement text, or select a recent replacement text or style from the list.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100000.xhp	0	help	par_id3159155	136			0	br	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<ahelp hid=\"SVX:PUSHBUTTON:RID_SVXDLG_SEARCH:BTN_NOFORMAT\"\>Click in the \<emph\>Search for \</emph\>or the \<emph\>Replace with \</emph\>box, and then click this button to remove the search criteria based on formats.\</ahelp\>\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100000.xhp	0	help	par_idN109CC				0	br	After you select the attributes that you want to search for, the \<emph\>Search for Styles\</emph\> box in the \<emph\>Options \</emph\>area of the %PRODUCTNAME Writer \<emph\>Find & Replace \</emph\>dialog changes to \<emph\>Including Styles\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100000.xhp	0	help	par_idN109DF				0	br	If you want to search for text in which attributes were set by using direct formatting and styles, select the \<emph\>Including Styles\</emph\> box.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100000.xhp	0	help	tit				0	br	Find & Replace				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	bm_id3146765				0	br	\<bookmark_value\>regular expressions; list of\</bookmark_value\>\<bookmark_value\>lists;regular expressions\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	hd_id3146765				0	br	\<variable id=\"02100001\"\>\<link href=\"text/shared/01/02100001.xhp\"\>List of Regular Expressions\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	hd_id5311441				0	br	Examples				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	hd_id71413				0	br	To find three-digit numbers alone in a paragraph				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id2366100				0	br	\\n in the \<emph\>Replace with\</emph\> text box stands for a paragraph break that can be entered with the Enter or Return key.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id2367931				0	br	You can also use () to group terms, for example, "a(bc)?d" finds "ad" or "abcd".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id2701803				0	br	In the Search for box:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id2924283				0	br	^[:digit:]{3}$				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3143267				0	br	?				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145313				0	br	The longest possible string that matches this search pattern in a paragraph is always found. If the paragraph contains the string "AX 4 AX4", the entire passage is highlighted.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145318				0	br	[^a-s]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145419				0	br	[abc123]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145730				0	br	Represents a lowercase character if \<emph\>Match case\</emph\> is selected in \<emph\>Options\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3146775	33			0	br	\\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147209				0	br	Search interprets the special character that follows the "\\" as a normal character and not as a regular expression (except for the combinations \\n, \\t, \\>, and \\<). For example, "tree\\." finds "tree.", not "treed" or "trees".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147282				0	br	&				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147317				0	br	Defines the number of times that the character in front of the opening bracket can occur. For example, "tre{1,2}" finds both "tree" and "treated".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147376				0	br	{2}				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147397				0	br	Represents an alphabetic character.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147399				0	br	+				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148455				0	br	[:upper:]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148550				0	br	^.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148616				0	br	( )				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148644	34			0	br	Only finds the search term if it appears at the end of a word. For example, "book\\>" finds "checkbook", but not "bookmark".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148676				0	br	Represents any of the characters that are between a-e and h-x.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149031				0	br	Represents any single character except for a line break or paragraph break. For example, the search term "sh.rt" returns both "shirt" and "short".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149167				0	br	Represents any of the characters that are between a and e.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149576				0	br	^$				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149650				0	br	For example, if you enter "window" in the \<emph\>Search for\</emph\> box and "&frame" in the \<emph\>Replace with\</emph\> box, the word "window" is replaced with "windowframe".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149741				0	br	Character				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149958				0	br	[:lower:]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150010				0	br	Represents a decimal digit.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150092	231			0	br	Represents an uppercase character if \<emph\>Match case\</emph\> is selected in \<emph\>Options.\</emph\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150103				0	br	Defines the number of times that the character in front of the opening bracket occurs. For example, "tre{2}" finds "tree".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150486				0	br	[:print:]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150543				0	br	You can also enter an "&" in the \<emph\>Replace with\</emph\> box to modify the \<emph\>Attributes\</emph\> or the \<emph\>Format\</emph\> of the string found by the search criteria.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150670				0	br	\\<				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150872				0	br	Represents a printable character.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150961				0	br	Represents a white space character such as space.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3151245				0	br	Finds an empty paragraph.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3151289				0	br	{1,2}				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152427				0	br	.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152542				0	br	Only finds the search term if the term appears at the end of a paragraph. Special objects such as empty fields or character-anchored frames at the end of a paragraph are ignored. Example: "Peter$".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152576				0	br	Represents a nonprinting character.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152885				0	br	[:digit:]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152945				0	br	\\n				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153258				0	br	\\t				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153281				0	br	Represents an alphanumeric character ([:alpha:] and [:digit:]).				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153351				0	br	Represents any character that is not between a and s.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153573				0	br	Defines the characters inside the parentheses as a reference. You can then refer to the first reference in the current expression with "\\1", to the second reference with "\\2", and so on.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153666				0	br	Only finds the search term if it appears at the beginning of a word. For example, "\\<book" finds "bookmark", but not "checkbook".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153684				0	br	Finds zero or one of the characters in front of the "?". For example, "Texts?" finds "Text" and "Texts" and "x(ab|c)?y" finds "xy", "xaby", or "xcy".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153700				0	br	Represents a line break that was inserted with the Shift+Enter key combination. To change a line break into a paragraph break, enter \<emph\>\\n\</emph\> in the \<emph\>Search for\</emph\> and \<emph\>Replace with\</emph\> boxes, and then perform a search and replace.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153726				0	br	[:space:]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153743				0	br	[:alnum:]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153768				0	br	Represents a special character based on its four-digit hexadecimal code (XXXX).				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153951				0	br	|				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153961				0	br	Adds the string that was found by the search criteria in the \<emph\>Search for\</emph\> box to the term in the \<emph\>Replace with\</emph\> box when you make a replacement.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154630				0	br	Represents one of the characters that are between the brackets.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154682				0	br	^				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154790				0	br	[:alpha:]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154985				0	br	Finds the terms that occur before or after the "|". For example, "this|that" finds "this" and "that".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155351				0	br	Only finds the search term if the term is at the beginning of a paragraph. Special objects such as empty fields or character-anchored frames, at the beginning of a paragraph are ignored. Example: "^Peter".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155555				0	br	Finds zero or more of the characters in front of the "*". For example, "Ab*c" finds "Ac", "Abc", "Abbc", "Abbbc", and so on.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155577				0	br	Result/Use				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155854				0	br	[:cntrl:]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155994				0	br	[a-eh-x]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156061				0	br	For example, if your text contains the number 13487889 and you search using the regular expression (8)7\\1\\1, "8788" is found.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156293				0	br	[a-e]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156414				0	br	*				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156543				0	br	\\xXXXX				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3157809				0	br	Represents a tab. You can also use this expression in the \<emph\>Replace with\</emph\> box.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3157958				0	br	Finds one or more of the characters in front of the "+". For example, "AX.+4" finds "AXx4", but not "AX4".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3159194				0	br	$				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3159252				0	br	The code for the special character depends on the font used. You can view the codes by choosing \<emph\>Insert - Special Character\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3159413				0	br	Finds the first character of a paragraph.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3166410				0	br	\\				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id4721823				0	br	{3} means there must be exactly 3 copies of "digit", 				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id4870754				0	br	{1,}				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id5766472				0	br	Use $ (dollar) instead of \\ (backslash) to replace references. Use $0 to replace the whole found string.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id5781731				0	br	^ means the match has to be at the start of a paragraph, 				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id5806756				0	br	$ means the match must end a paragraph. 				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id6600543				0	br	Any character				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id6942045				0	br	[:digit:] matches any decimal digit, 				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id843836				0	br	Defines the minimum number of times that the character in front of the opening bracket can occur. For example, "tre{2,}" finds "tree", "treee", and "treeeee".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9200109				0	br	In the \<emph\>Replace with\</emph\> box:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9262672				0	br	\\n in the \<emph\>Search for\</emph\> text box stands for a line break that was inserted with the Shift+Enter key combination.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9568773				0	br	You can combine the search terms to form complex searches.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9824518.00000001				0	br	Represents any single character unless otherwise specified.				2002-02-02 02:02:02
