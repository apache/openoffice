helpcontent2	source\text\scalc\01\02150000.xhp	0	help	par_id3145367				0	br	Pressing Backspace deletes content without calling the dialog or changing formats.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	par_id3146134				0	br	\<ahelp hid=\"SC_CHECKBOX_RID_SCDLG_DELCONT_BTN_DELATTRS\"\>Deletes format attributes applied to cells. All cell content remains unchanged.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	par_id3148405				0	br	\<ahelp hid=\"SC_CHECKBOX_RID_SCDLG_DELCONT_BTN_DELNUMBERS\"\>Deletes numbers only. Formats and formulas remain unchanged.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	par_id3148485				0	br	\<ahelp hid=\"SC_CHECKBOX_RID_SCDLG_DELCONT_BTN_DELFORMULAS\"\>Deletes formulas. Text, numbers, formats, dates and times remain unchanged.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	par_id3149456				0	br	\<variable id=\"inhalteloeschentext\"\>\<ahelp hid=\".uno:Delete\"\>Specifies the contents to be deleted from the active cell or from a selected cell range.\</ahelp\>\</variable\> If several sheets are selected, all selected sheets will be affected.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	par_id3149567				0	br	\<ahelp hid=\"SC_CHECKBOX_RID_SCDLG_DELCONT_BTN_DELDATETIME\"\>Deletes date and time values. Formats, text, numbers and formulas remain unchanged.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	par_id3149665				0	br	This area lists the options for deleting contents.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	par_id3152990				0	br	\<ahelp hid=\"SC_CHECKBOX_RID_SCDLG_DELCONT_BTN_DELOBJECTS\"\>Deletes objects. All cell content remains unchanged.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	par_id3153951				0	br	Use \<emph\>Cut\</emph\> on the Standard bar to delete contents and formats without the dialog.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	par_id3154015				0	br	\<ahelp hid=\"SC_CHECKBOX_RID_SCDLG_DELCONT_BTN_DELSTRINGS\"\>Deletes strings only. Formats, formulas, numbers and dates are not affected.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	par_id3154658				0	br	\<ahelp hid=\"SC_CHECKBOX_RID_SCDLG_DELCONT_BTN_DELNOTES\"\>Deletes notes added to cells. All other elements remain unchanged.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	par_id3154729				0	br	\<ahelp hid=\"SC_CHECKBOX_RID_SCDLG_DELCONT_BTN_DELALL\"\>Deletes all content from the selected cell range.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	par_id3159154				0	br	This dialog is also called by pressing Del after the cell cursor has been activated on the sheet.				2002-02-02 02:02:02
