helpcontent2	source\text\swriter\01\02110000.xhp	0	help	par_id3150707				0	br	\<ahelp hid=\"HID_NAVI_TBX15\"\>Decreases the outline level of the selected heading, and the headings that occur below the heading, by one. To only decrease the outline level of the selected heading, hold down Ctrl, and then click this icon.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02110000.xhp	0	help	par_id3150767				0	br	\<image id=\"img_id3150773\" src=\"sw/imglst/sc20175.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3150773\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
