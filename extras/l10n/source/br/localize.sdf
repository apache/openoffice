helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143466				0	br	9				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143489				0	br	SUM				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143516				0	br	10				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143539				0	br	VAR				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143566				0	br	11				2002-02-02 02:02:02
