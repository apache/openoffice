helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	par_id1085238				0	br	\<ahelp hid=\".\"\>Inserts an invisible space within a word that will keep the word together at the end of a line. Available when complex text layout (CTL) is enabled.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	par_id1536301				0	br	\<ahelp hid=\".\"\>Inserts an invisible space within a word that will insert a line break once it becomes the last character in a line. Available when complex text layout (CTL) is enabled.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	par_id6690878				0	br	\<ahelp hid=\".\"\>Inserts a text direction mark that affects the text direction of any text following the mark. Available when complex text layout (CTL) is enabled.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	par_id8326975				0	br	\<ahelp hid=\".\"\>Inserts a space that will keep bordering characters together on line breaks.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	par_id8469191				0	br	\<ahelp hid=\".\"\>Inserts a hyphen that will keep bordering characters together on line breaks.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	par_id923184				0	br	\<ahelp hid=\".\"\>Inserts a text direction mark that affects the text direction of any text following the mark. Available when complex text layout (CTL) is enabled.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	par_id9305398				0	br	\<ahelp hid=\".\"\>Opens a submenu to insert special formatting marks.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	par_id9407330				0	br	\<ahelp hid=\".\"\>Inserts an invisible hyphen within a word that will appear and create a line break once it becomes the last character in a line.\</ahelp\>				2002-02-02 02:02:02
