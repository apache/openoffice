helpcontent2	source\text\shared\01\grid.xhp	0	help	par_id4372692				0	br	Set the grid color on Tools - Options - %PRODUCTNAME - \<link href=\"text/shared/optionen/01012000.xhp\"\>Appearance\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\grid.xhp	0	help	par_idN10565				0	br	\<link href=\"text/shared/01/grid.xhp\"\>Grid\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\grid.xhp	0	help	par_idN1057E				0	br	Display Grid				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\grid.xhp	0	help	par_idN10582				0	br	Displays or hides grid lines that you can use to align objects such as graphics on a page.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\grid.xhp	0	help	par_idN10585				0	br	Snap to Grid				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\grid.xhp	0	help	par_idN10589				0	br	Automatically aligns objects to vertical and horizontal grid lines. To override this feature, hold down the \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Control key \</caseinline\>\<defaultinline\>Ctrl key\</defaultinline\>\</switchinline\> when you drag an object.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\grid.xhp	0	help	par_idN105C9				0	br	Grid to Front				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\grid.xhp	0	help	par_idN105CD				0	br	\<ahelp hid=\".\"\>Displays the grid lines in front of the objects on the slide or page.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\grid.xhp	0	help	tit				0	br	Grid				2002-02-02 02:02:02
