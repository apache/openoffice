helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3151280				0	br	\<ahelp hid=\"SVX_NUMERICFIELD_RID_SVX_GRFFILTER_DLG_POSTER_DLG_FILTERPOSTER_NUM_POSTER\"\>Specifies the number of colors to which the image is to be reduced.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3152971				0	br	\<ahelp hid=\".uno:GraphicFilterSobel\"\>Displays the image as a charcoal sketch.\</ahelp\> The contours of the image are drawn in black, and the original colors are suppressed. You can apply this function to the whole image or to a part of it.				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3153139				0	br	\<image id=\"img_id3159196\" src=\"res/commandimagelist/sc_graphicfiltersepia.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3159196\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3153480				0	br	\<image id=\"img_id3156023\" src=\"res/commandimagelist/sc_graphicfiltersharpen.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3156023\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3153512				0	br	\<ahelp hid=\".uno:GraphicFilterPopart\"\>Converts an image to a pop-art format.\</ahelp\> By applying color alienation, the image acquires a completely new character. This function can be applied to the whole image or to parts of it.				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3153681				0	br	\<image id=\"img_id3145313\" src=\"res/commandimagelist/sc_graphicfilterinvert.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3145313\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3153714				0	br	\<ahelp hid=\".uno:GraphicFilterRelief\"\>Displays a dialog for creating reliefs.\</ahelp\> You can choose the position of the imaginary light source that determines the type of shadow created, and how the graphic image looks in relief.				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3153760				0	br	\<ahelp hid=\".uno:GraphicFilterSharpen\"\>Increases the contrast in an image.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3154673				0	br	\<image id=\"img_id3152924\" src=\"res/commandimagelist/sc_graphicfiltertoolbox.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3152924\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
