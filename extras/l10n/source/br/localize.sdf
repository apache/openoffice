helpcontent2	source\text\swriter\01\06060100.xhp	0	help	par_id3150930				0	br	Specify the formatting for the select outline level.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06060100.xhp	0	help	par_id3151023				0	br	\<ahelp hid=\"SW:NUMERICFIELD:TP_OUTLINE_NUM:ED_START\"\>Enter the number that you want to restart the chapter numbering at.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06060100.xhp	0	help	par_id3151314				0	br	I, II, III, ...				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06060100.xhp	0	help	par_id3151332				0	br	Alphabetical numbering with identical capital letters, where the number of letters indicates the chapter level. For example, the second number in level three is "BBB".				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06060100.xhp	0	help	par_id3152960				0	br	Roman numerals (lower)				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06060100.xhp	0	help	par_id3153358				0	br	\<ahelp hid=\"SW:EDIT:TP_OUTLINE_NUM:ED_SUFFIX\"\>Enter the text that you want to display after the chapter number.\</ahelp\> For example, type a period (.) to display "1."				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06060100.xhp	0	help	par_id3153533				0	br	Lowercase letters				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06060100.xhp	0	help	par_id3153722				0	br	\<ahelp hid=\"SW:LISTBOX:TP_OUTLINE_NUM:LB_COLL\"\>Select the paragraph style that you want to assign to the selected outline level.\</ahelp\> If you click "None", the selected outline level is not defined.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06060100.xhp	0	help	par_id3154104				0	br	a, b, c, ...				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06060100.xhp	0	help	par_id3154191				0	br	Arabic numerals				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06060100.xhp	0	help	par_id3154470				0	br	Roman numerals (upper)				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06060100.xhp	0	help	par_id3154834				0	br	None				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06060100.xhp	0	help	par_id3155142				0	br	\<ahelp hid=\"SW:EDIT:TP_OUTLINE_NUM:ED_PREFIX\"\>Enter the text that you want to display before the chapter number.\</ahelp\> For example, type "Chapter " to display "Chapter 1".				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06060100.xhp	0	help	par_id3155620				0	br	Specifies the number format and the hierarchy for chapter numbering in the current document.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06060100.xhp	0	help	par_id3155899				0	br	1, 2, 3, ...				2002-02-02 02:02:02
