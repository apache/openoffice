helpcontent2	source\text\swriter\02\06130000.xhp	0	help	hd_id3154501				0	br	\<link href=\"text/swriter/02/06130000.xhp\" name=\"Move Down with Subpoints\"\>Move Down with Subpoints\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\06130000.xhp	0	help	par_id3145086				0	br	\<image src=\"res/commandimagelist/sc_movedownsubitems.png\" id=\"img_id3156377\"\>\<alt id=\"alt_id3156377\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\06130000.xhp	0	help	par_id3148770				0	br	\<ahelp hid=\".uno:MoveDownSubItems\" visibility=\"visible\"\>Moves a paragraph with all its subpoints below the following paragraph.\</ahelp\> This is only visible when the cursor is positioned within numbered or bulleted text.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\06130000.xhp	0	help	par_id3150749				0	br	Move Down with Subpoints				2002-02-02 02:02:02
