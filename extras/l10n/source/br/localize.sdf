helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN10550				0	br	\<variable id=\"mediaplayertitle\"\>\<link href=\"text/shared/01/mediaplayer.xhp\"\>Media Player\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN10560				0	br	\<ahelp hid=\"6694\"\>Opens the Media Player window where you can preview movie and sound files as well as insert these files into the current document.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN10577				0	br	The Media Player supports many different media formats. You can also insert media files from the Media Player into your document.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN1057A				0	br	Open				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN1057E				0	br	Opens a movie file or a sound file that you want to preview.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN10581				0	br	Apply				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN10585				0	br	Inserts the current movie file or sound file as a media object into the current document. 				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN10588				0	br	Play				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN1058C				0	br	Plays the current file.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN1058F				0	br	Pause				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN10593				0	br	Pauses or resumes the playback of the current file.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN10596				0	br	Stop				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN1059A				0	br	Stops the playback of the current file.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN1059D				0	br	Repeat				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN105A1				0	br	Plays the file repeatedly.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN105A4				0	br	Mute				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN105A8				0	br	Turns sound off and on.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN105AB				0	br	Volume slider				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN105AF				0	br	Adjusts the volume.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN105B2				0	br	Zoom				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN105B6				0	br	Adjusts the size of the movie playback.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN105B9				0	br	Position slider				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN105BD				0	br	Moves to a different position in the file.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN105EF				0	br	On UNIX systems, the Media Player requires the Java Media Framework API (JMF). Download and install the JMF files, and add the path to the installed jmf.jar to the class path in Tools - Options - %PRODUCTNAME - Java.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN10605				0	br	Only a link to the media file is inserted into the current document.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	par_idN1064F				0	br	On Windows systems, the Media Player uses DirectShow, which should be installed on your system by default.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\mediaplayer.xhp	0	help	tit				0	br	Media Player				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\moviesound.xhp	0	help	bm_id1907712				0	br	\<bookmark_value\>inserting;movies/sounds\</bookmark_value\>\<bookmark_value\>sounds;inserting and playing\</bookmark_value\>\<bookmark_value\>playing movies and sound files\</bookmark_value\>\<bookmark_value\>videos\</bookmark_value\>\<bookmark_value\>audio; inserting\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\moviesound.xhp	0	help	par_idN1065C				0	br	\<variable id=\"moviesoundtitle\"\>\<link href=\"text/shared/01/moviesound.xhp\"\>Movie and Sound\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\moviesound.xhp	0	help	par_idN1066C				0	br	\<ahelp hid=\".\"\>Inserts a video or sound file into your document.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\moviesound.xhp	0	help	par_idN10683				0	br	To insert a movie or sound file into your document				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\moviesound.xhp	0	help	par_idN1068A				0	br	Click where you want to insert the file.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\moviesound.xhp	0	help	par_idN1068E				0	br	Choose \<emph\>Insert - Movie and Sound\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\moviesound.xhp	0	help	par_idN10696				0	br	In the File Open dialog, select the file that you want to insert.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\moviesound.xhp	0	help	par_idN10699				0	br	The file types that are listed in this dialog are not supported by all operating systems.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\moviesound.xhp	0	help	par_idN1069C				0	br	To play a movie or sound file in an Impress presentation				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\moviesound.xhp	0	help	par_idN106A3				0	br	Open the slide that contains the movie or sound file.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\moviesound.xhp	0	help	par_idN106A7				0	br	Click the object icon for the movie or sound file on the slide.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\moviesound.xhp	0	help	par_idN106BF				0	br	To play a movie or sound file in a Writer, Calc, or Draw document				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\moviesound.xhp	0	help	par_idN106C6				0	br	Open the document that contains the movie or sound file.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\moviesound.xhp	0	help	par_idN106CD				0	br	Click Play on the Media Playback toolbar.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\moviesound.xhp	0	help	par_idN106D0				0	br	You can also use the Media Playback Bar to pause, to stop, to loop, as well as to adjust the volume or to mute the playback of the file. The current playback position in the file is indicated on the left slider. Use the right slider to adjust the playback volume. For movie files, the bar also contains a list box where you can select the zoom factor for the playback.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\moviesound.xhp	0	help	par_idN106D7				0	br	Click \<emph\>Open\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\moviesound.xhp	0	help	par_idN10788				0	br	Click \<emph\>Play\</emph\> on the \<emph\>Media Playback\</emph\> toolbar.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\moviesound.xhp	0	help	tit				0	br	Movie and Sound				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update.xhp	0	help	bm_id7647328				0	br	\<bookmark_value\>updates;checking manually\</bookmark_value\>\<bookmark_value\>online updates;checking manually\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update.xhp	0	help	hd_id315256				0	br	\<variable id=\"online_update\"\>\<link href=\"text/shared/01/online_update.xhp\"\>Check for Updates\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id3174230				0	br	\<ahelp hid=\".\" visibility=\"hidden\"\>Mark to enable the automatic check for updates. Choose Tools - Options - %PRODUCTNAME - Online Update to disable or enable this feature.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id3422345				0	br	If an update is available, an icon \<image id=\"img_id3155415\" src=\"extensions/source/update/ui/onlineupdate_16.png\" width=\"0.4598inch\" height=\"0.1402inch\"\>\<alt id=\"alt_id3155415\"\>Icon\</alt\>\</image\> on the menu bar will notify you of the update. Click the icon to open a dialog with more information.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id3639027				0	br	Choose \<item type=\"menuitem\"\>Check for Updates\</item\> to check for the availability of a newer version of your office suite.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id3722342				0	br	If a newer version is available and %PRODUCTNAME is not set up for automatic downloading, then you can select any of the following actions:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id4931485				0	br	Install the downloaded files.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id5106662				0	br	Download the new version.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id6081728				0	br	If no update was found, you can close the dialog.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id6479384				0	br	If you need a proxy server, enter the proxy settings in Tools - Options - Internet - Proxy.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id6797082				0	br	Your can check for updates manually and automatically. 				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id702230				0	br	You can disable or enable the automatic check in Tools - Options - %PRODUCTNAME - \<link href=\"text/shared/optionen/online_update.xhp\"\>Online Update\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id8132267				0	br	Choose \<item type=\"menuitem\"\>Help - Check for Updates\</item\> to check manually.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id9168980				0	br	Abort this check for updates for now.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id9219641				0	br	You need Administrator rights to update %PRODUCTNAME.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id927152				0	br	For StarOffice, automatic downloads are currently disabled. Start the download manually.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id9313638				0	br	You will see the \<link href=\"text/shared/01/online_update_dialog.xhp\"\>Check for Updates\</link\> dialog with some information about the online update of %PRODUCTNAME.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id9766533				0	br	If %PRODUCTNAME is configured to download the files automatically, the download starts immediately. A download continues even when you minimize the dialog.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id9951780				0	br	Enable an Internet connection for %PRODUCTNAME.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update.xhp	0	help	tit				0	br	Online Update				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update_dialog.xhp	0	help	hd_id4959257				0	br	\<link href=\"text/shared/01/online_update_dialog.xhp\"\>Check for Updates\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update_dialog.xhp	0	help	par_id1502121				0	br	By default, downloads will be stored to your desktop. You can change the folder where the downloaded file will be stored in Tools - Options - %PRODUCTNAME - Online Update.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update_dialog.xhp	0	help	par_id1906491				0	br	\<ahelp hid=\".\"\>Checks for available updates to your version of %PRODUCTNAME. If a newer version is available, you can choose to download the update. After downloading, if you have write permissions for the installation directory, you can install the update.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update_dialog.xhp	0	help	par_id2733542				0	br	After installation of the update you can delete the download file to save space.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update_dialog.xhp	0	help	par_id2871181				0	br	Under some operation systems, it may be required to manually go to the download folder, unzip the download file, and start the setup script.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update_dialog.xhp	0	help	par_id3067110				0	br	\<ahelp hid=\".\" visibility=\"hidden\"\>Aborts the download and deletes the partly downloaded file.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update_dialog.xhp	0	help	par_id4086428				0	br	\<ahelp hid=\".\" visibility=\"hidden\"\>Pauses the download. Later click Resume to continue downloading.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update_dialog.xhp	0	help	par_id4238715				0	br	\<ahelp hid=\".\" visibility=\"hidden\"\>Downloads and saves the update files to the desktop or a folder of your choice. Select the folder in Tools - Options - %PRODUCTNAME - Online Update.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update_dialog.xhp	0	help	par_id4799340				0	br	Once the download starts, you see a progress bar and three buttons on the dialog. You can pause and resume the download by clicking the Pause and Resume buttons. Click Cancel to abort the download and delete the partly downloaded file.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update_dialog.xhp	0	help	par_id8266853				0	br	After the download is complete, you can click Install to start the installation of the update. You see a confirmation dialog, where you can choose to close %PRODUCTNAME.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update_dialog.xhp	0	help	par_id8277230				0	br	\<ahelp hid=\".\" visibility=\"hidden\"\>Installs the downloaded update.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update_dialog.xhp	0	help	par_id8841822				0	br	\<link href=\"text/shared/01/online_update.xhp\"\>Starting online updates\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\online_update_dialog.xhp	0	help	par_id9024628				0	br	\<ahelp hid=\".\" visibility=\"hidden\"\>Continues a paused download.\</ahelp\>				2002-02-02 02:02:02
