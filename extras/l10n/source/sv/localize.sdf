helpcontent2	source\text\schart\01\wiz_chart_type.xhp	0	help	par_id3860896				0	sv	\<ahelp hid=\".\" visibility=\"hidden\"\>Välj en typ av 3D-utseende.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\schart\01\wiz_chart_type.xhp	0	help	par_id4041871				0	sv	\<ahelp hid=\".\" visibility=\"hidden\"\>Välj en form i listan.\</ahelp\>				20130618 17:22:18
