helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3145859	143			0	sv	E4: RKV				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3145880	144			0	sv	F4: Standardfelet för regressionen som beräknats för y-värdet.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3145894	145			0	sv	E5: F-värdet från variansanalysen.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3145915	146			0	sv	F5: Frihetsgraden från variansanalysen.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3145937	147			0	sv	E6: Summan av kvadratavvikelsen för de uppskattade y-värdena från det linjära medelvärdet.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3145952	148			0	sv	F6: Summan av kvadratavvikelsen för det uppskattade y-värdet från givna y-värden.				20130618 17:22:18
