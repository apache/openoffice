helpcontent2	source\text\shared\00\00000007.xhp	0	help	par_id3152352	5			0	sv	\<variable id=\"textobjektleiste\"\>Ikon på verktygsraden Formatering: \</variable\>				20130618 17:22:18
helpcontent2	source\text\shared\00\00000007.xhp	0	help	par_id3151370	7			0	sv	\<variable id=\"objektleiste\"\>Ikon på formateringsraden: \</variable\>				20130618 17:22:18
