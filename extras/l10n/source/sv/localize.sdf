helpcontent2	source\text\schart\01\wiz_chart_type.xhp	0	help	par_id5749687				0	sv	\<ahelp hid=\".\" visibility=\"hidden\"\>I stapelserier visas värdena ovanpå varandra.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\schart\01\wiz_chart_type.xhp	0	help	par_id79348				0	sv	\<ahelp hid=\".\" visibility=\"hidden\"\>I stapelserier visas värdena som procent.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\schart\01\wiz_chart_type.xhp	0	help	par_id2414014				0	sv	\<ahelp hid=\".\" visibility=\"hidden\"\>Linjerna visas som kurvor.\</ahelp\>				20130618 17:22:18
