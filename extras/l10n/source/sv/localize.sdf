helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3154014	18			0	sv	REM används funktionen CBool på följande sätt:				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3155413	19			0	sv	If CBool(Instr(sText, "och")) Then				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3152940	20			0	sv	MsgBox "Ordet "och" finns med i meningen!"				20130618 17:22:18
