helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149771	268			0	sv	\<item type=\"input\"\>95\</item\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3158407	269			0	sv	\<item type=\"input\"\>17\</item\>				20130618 17:22:18
