helpcontent2	source\text\shared\01\05020700.xhp	0	help	par_id3147834				0	sk	Set the options for line breaks in Asian language documents.				20200411 15:09:53
helpcontent2	source\text\shared\01\05020700.xhp	0	help	hd_id3145072				0	sk	Apply list of forbidden characters to the beginning and end of line				20200411 15:09:53
helpcontent2	source\text\shared\01\05020700.xhp	0	help	par_id3153683				0	sk	\<ahelp hid=\"SVX_TRISTATEBOX_RID_SVXPAGE_PARA_ASIAN_CB_AS_FORBIDDEN\"\>Prevents the characters in the list from starting or ending a line. The characters are relocated to either the previous or the next line.\</ahelp\> To edit the list of restricted characters, choose \<emph\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - Language Settings - \<link href=\"text/shared/optionen/01150100.xhp\" name=\"Asian Layout\"\>Asian Layout\</link\>\</emph\>.				20200411 15:09:53
helpcontent2	source\text\shared\01\05020700.xhp	0	help	hd_id3149751				0	sk	Povoliť zavesenú interpunkciu				20200411 15:09:53
helpcontent2	source\text\shared\01\05020700.xhp	0	help	par_id3149096				0	sk	\<ahelp hid=\"SVX_TRISTATEBOX_RID_SVXPAGE_PARA_ASIAN_CB_AS_HANG_PUNC\"\>Prevents commas and periods from breaking the line. Instead, these characters are added to the end of the line, even in the page margin.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05020700.xhp	0	help	par_id3147275				0	sk	\<emph\>Apply spacing between Asian, Latin and Complex text\</emph\>				20200411 15:09:53
