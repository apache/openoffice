helpcontent2	source\text\sbasic\shared\03030103.xhp	0	help	par_id3155413				0	sk	sub ExampleDay				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030103.xhp	0	help	par_id3149260				0	sk	Print "Day " & Day(DateSerial(1994, 12, 20)) & " of the month"				20200411 15:09:53
