helpcontent2	source\text\shared\01\05030700.xhp	0	help	par_id3147399				0	sk	\<ahelp hid=\"HID_FORMAT_PARAGRAPH_ALIGN\"\>Sets the alignment of the paragraph relative to the margins of page.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030700.xhp	0	help	hd_id3143268				0	sk	Zarovnanie				20200411 15:09:53
helpcontent2	source\text\shared\01\05030700.xhp	0	help	par_id3147008				0	sk	Set the alignment options for the current paragraph.				20200411 15:09:53
helpcontent2	source\text\shared\01\05030700.xhp	0	help	hd_id3153681				0	sk	Vľavo				20200411 15:09:53
helpcontent2	source\text\shared\01\05030700.xhp	0	help	par_id3153031				0	sk	\<variable id=\"linkstext\"\>\<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXPAGE_ALIGN_PARAGRAPH:BTN_LEFTALIGN\"\>Aligns the paragraph to the left page margin.\</ahelp\>\</variable\> If Asian language support is enabled, this option is named Left/Top.				20200411 15:09:53
helpcontent2	source\text\shared\01\05030700.xhp	0	help	hd_id3154142				0	sk	Vpravo				20200411 15:09:53
helpcontent2	source\text\shared\01\05030700.xhp	0	help	par_id3156326				0	sk	\<variable id=\"rechtstext\"\>\<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXPAGE_ALIGN_PARAGRAPH:BTN_RIGHTALIGN\"\>Aligns the paragraph to the right page margin.\</ahelp\>\</variable\> If Asian language support is enabled, this option is named Right/Bottom.				20200411 15:09:53
helpcontent2	source\text\shared\01\05030700.xhp	0	help	hd_id3148642				0	sk	Na stred				20200411 15:09:53
helpcontent2	source\text\shared\01\05030700.xhp	0	help	par_id3153257				0	sk	\<variable id=\"zentrierttext\"\>\<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXPAGE_ALIGN_PARAGRAPH:BTN_CENTERALIGN\"\>Centers the contents of the paragraph on the page.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030700.xhp	0	help	hd_id3149415				0	sk	Do bloku				20200411 15:09:53
helpcontent2	source\text\shared\01\05030700.xhp	0	help	par_id3152474				0	sk	\<variable id=\"blocksatztext\"\>\<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXPAGE_ALIGN_PARAGRAPH:BTN_JUSTIFYALIGN\"\>Aligns the paragraph to the left and to the right page margins.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030700.xhp	0	help	hd_id3145068	13			0	sk	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Last Line \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030700.xhp	0	help	par_id3154280				0	sk	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<ahelp hid=\"SVX:LISTBOX:RID_SVXPAGE_ALIGN_PARAGRAPH:LB_LASTLINE\"\>Specify the alignment for the last line in the paragraph.\</ahelp\>\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030700.xhp	0	help	hd_id3154936	15			0	sk	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Expand single word \</caseinline\>\</switchinline\>				20200411 15:09:53
