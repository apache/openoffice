helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id2113711				0	sk	EASTERSUNDAY(Year)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3938413				0	sk	\<emph\>Year\</emph\> is an integer between 1583 and 9956 or 0 and 99. You can also calculate other holidays by simple addition with this date.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3156156				0	sk	Easter Monday = EASTERSUNDAY(Year) + 1				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3147521				0	sk	Good Friday = EASTERSUNDAY(Year) - 2				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3146072				0	sk	Pentecost Sunday = EASTERSUNDAY(Year) + 49				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3149553				0	sk	Pentecost Monday = EASTERSUNDAY(Year) + 50				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	hd_id3155120				0	sk	Príklady				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3154472				0	sk	=EASTERSUNDAY(2000) returns 2000-04-23.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3150940				0	sk	EASTERSUNDAY(2000)+49 returns the internal serial number 36688. The result is 2000-06-11. Format the serial date number as a date, for example in the format YYYY-MM-DD.				20200411 15:09:53
