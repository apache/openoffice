helpcontent2	source\text\scalc\01\04060115.xhp	0	help	bm_id3153034				0	sk	\<bookmark_value\>BIN2DEC function\</bookmark_value\>\<bookmark_value\>converting;binary numbers, into decimal numbers\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3153034				0	sk	BIN2DEC				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3144744				0	sk	\<ahelp hid=\"HID_AAI_FUNC_BIN2DEC\"\>The result is the decimal number for the binary number entered.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3145593				0	sk	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3149726				0	sk	BIN2DEC(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3150142				0	sk	\<emph\>Number\</emph\> is a binary number. The number can have a maximum of 10 places (bits). The most significant bit is the sign bit. Negative numbers are entered as two's complement.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3149250				0	sk	Príklad				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3145138				0	sk	\<item type=\"input\"\>=BIN2DEC(1100100)\</item\> returns 100.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	bm_id3149954				0	sk	\<bookmark_value\>BIN2HEX function\</bookmark_value\>\<bookmark_value\>converting;binary numbers, into hexadecimal numbers\</bookmark_value\>				20200411 15:09:53
