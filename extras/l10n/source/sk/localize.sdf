helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_idN107FE				0	sk	Prvý záznam				20200411 15:09:53
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_idN10803				0	sk	Moves the current form to the first record.				20200411 15:09:53
