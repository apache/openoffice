helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3152934				0	sk	B				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154638				0	sk	C				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3147083				0	sk	1				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3151187				0	sk	2001-01-01				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145212				0	sk	-\<item type=\"input\"\>10000\</item\>				20200411 15:09:53
