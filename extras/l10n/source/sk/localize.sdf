helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3156382				0	sk	sEntry(3) = "Thomas"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3155174				0	sk	sEntry(4) = "Michael"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3166448				0	sk	sEntry(5) = "David"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3149255				0	sk	sEntry(6) = "Cathy"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3149565				0	sk	sEntry(7) = "Susie"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3145148				0	sk	sEntry(8) = "Edward"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3145229				0	sk	sEntry(9) = "Christine"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3149107				0	sk	For iCount = 0 To 9				20200411 15:09:53
