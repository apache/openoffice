helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3146939				0	sk	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3150030				0	sk	FALSE()				20200411 15:09:53
