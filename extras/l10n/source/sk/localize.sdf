helpcontent2	source\text\shared\02\06120000.xhp	0	help	par_id3148520				0	sk	\<ahelp hid=\".uno:DefaultBullet\"\>Assigns bullet points to the selected paragraphs, or removes them from bulleted paragraphs.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\06120000.xhp	0	help	par_id3155150				0	sk	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Bullet options such as type and position are defined in the \<link href=\"text/shared/01/06050000.xhp\" name=\"Bullets and Numbering\"\>\<emph\>Bullets and Numbering\</emph\>\</link\> dialog. To open this dialog, click the \<emph\>Bullets and Numbering\</emph\> icon on the \<link href=\"text/swriter/main0206.xhp\" name=\"Bullets and Numbering Bar\"\>Bullets and Numbering Bar\</link\>\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\02\06120000.xhp	0	help	par_id3145669	8			0	sk	\<switchinline select=\"appl\"\>\<caseinline select=\"IMPRESS\"\>Bullet options such as type and position are defined in the \<link href=\"text/shared/01/06050000.xhp\" name=\"Bullets and Numbering\"\>Bullets and Numbering\</link\> dialog. To open this dialog, click the \<emph\>Bullets and Numbering\</emph\> icon on the \<emph\>Text Formatting\</emph\> Bar. \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\02\06120000.xhp	0	help	par_id3147576	3			0	sk	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>In the \<link href=\"text/swriter/01/03120000.xhp\" name=\"Web Layout\"\>Web Layout\</link\>, some numbering/bullet options are not available. \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\02\06120000.xhp	0	help	par_id3154317	5			0	sk	\<switchinline select=\"appl\"\>\<caseinline select=\"IMPRESS\"\>The distance between the text and the left text frame and the position of the bullets can be determined in the dialog under \<link href=\"text/shared/01/05030100.xhp\" name=\"Format - Paragraph\"\>\<emph\>Format - Paragraph\</emph\>\</link\> by entering the left indent and the first-line indent. \</caseinline\>\</switchinline\>				20200411 15:09:53
