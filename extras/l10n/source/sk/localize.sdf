helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10579				0	sk	Traditional Chinese to Simplified Chinese				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1057D				0	sk	\<ahelp hid=\".\"\>Converts traditional Chinese text characters to simplified Chinese text characters. Click \<emph\>OK\</emph\> to convert the selected text. If no text is selected, the whole document is converted.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10580				0	sk	Simplified Chinese to Traditional Chinese				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10584				0	sk	\<ahelp hid=\".\"\>Converts simplified Chinese text characters to traditional Chinese text characters. Click \<emph\>OK\</emph\> to convert the selected text. If no text is selected, the whole document is converted.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1058E				0	sk	Bežné výrazy				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10592				0	sk	\<ahelp hid=\".\"\>Common terms are words that have the same meaning in traditional and simplified Chinese but are written with different characters.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10595				0	sk	Convert Common Terms				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10599				0	sk	\<ahelp hid=\".\"\>Converts words with two or more characters that are in the list of common terms. After the list is scanned, the remaining text is converted character by character.\</ahelp\>				20200411 15:09:53
