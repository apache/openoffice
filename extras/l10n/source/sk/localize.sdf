helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3154491				0	sk	dAngle = InputBox$ ("Enter the angle Alpha (in degrees): ","Alpha")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3151074				0	sk	Print "The length of the hypothenuse is"; (d1 / cos (dAngle * Pi / 180))				20200411 15:09:53
