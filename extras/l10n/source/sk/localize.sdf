helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156054				0	sk	Returns the absolute address of the referenced cell.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154136				0	sk	\<item type=\"input\"\>=CELL("ADDRESS";D2)\</item\> returns $D$2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3159198				0	sk	\<item type=\"input\"\>=CELL("ADDRESS";Sheet3.D2)\</item\> returns $Sheet3.$D$2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150245				0	sk	\<item type=\"input\"\>=CELL("ADDRESS";'X:\\dr\\test.sxc'#$Sheet1.D2)\</item\> vracia 'file:///X:/dr/test.sxc'#$Sheet1.$D$2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3146811				0	sk	FILENAME				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151328				0	sk	Returns the file name and the sheet number of the referenced cell.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3148896				0	sk	\<item type=\"input\"\>=CELL("FILENAME";D2)\</item\> returns 'file:///X:/dr/own.sxc'#$Sheet1, if the formula in the current document X:\\dr\\own.sxc is located in Sheet1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155144				0	sk	\<item type=\"input\"\>=CELL("FILENAME";'X:\\dr\\test.sxc'#$Sheet1.D2)\</item\> vracia 'file:///X:/dr/test.sxc'#$Sheet1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151381				0	sk	COORD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151004				0	sk	Returns the complete cell address in Lotus(TM) notation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3159104				0	sk	\<item type=\"input\"\>=CELL("COORD"; D2)\</item\> returns $A:$D$2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3163720				0	sk	\<item type=\"input\"\>=CELL("COORD"; Sheet3.D2)\</item\> returns $C:$D$2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155910				0	sk	CONTENTS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156041				0	sk	Returns the contents of the referenced cell, without any formatting.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151069				0	sk	TYPE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155344				0	sk	Returns the type of cell contents.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3145217				0	sk	b = blank. empty cell				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155176				0	sk	l = label. Text, result of a formula as text				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3147280				0	sk	v = value. Value, result of a formula as a number				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156348				0	sk	WIDTH				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154920				0	sk	Returns the width of the referenced column. The unit is the number of zeros (0) that fit into the column in the default text and the default size.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3152355				0	sk	PREFIX				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154230				0	sk	Returns the alignment of the referenced cell.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155946				0	sk	' = align left or left-justified				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3147220				0	sk	" = align right				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149038				0	sk	^ = centered				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153129				0	sk	\\ = repeating (currently inactive)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154406				0	sk	PROTECT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3145127				0	sk	Returns the status of the cell protection for the cell.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155794				0	sk	1 = cell is protected				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155072				0	sk	0 = cell is not protected				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156178				0	sk	FORMAT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150220				0	sk	Returns a character string that indicates the number format.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153824				0	sk	, = number with thousands separator				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153837				0	sk	F = number without thousands separator				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150318				0	sk	C = currency format				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153168				0	sk	S = exponential representation, for example, 1.234+E56				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153515				0	sk	P = percentage				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154375				0	sk	In the above formats, the number of decimal places after the decimal separator is given as a number. Example: the number format #,##0.0 returns ,1 and the number format 00.000% returns P3				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150575				0	sk	D1 = MMM-D-YY, MM-D-YY and similar formats				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150589				0	sk	D2 = DD-MM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151034				0	sk	D3 = MM-YY				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156371				0	sk	D4 = DD-MM-YYYY HH:MM:SS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3157881				0	sk	D5 = MM-DD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3157894				0	sk	D6 = HH:MM:SS AM/PM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154068				0	sk	D7 = HH:MM AM/PM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150286				0	sk	D8 = HH:MM:SS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3145756				0	sk	D9 = HH:MM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3145768				0	sk	G = All other formats				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153375				0	sk	- (Minus) at the end = negative numbers are formatted in color				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155545				0	sk	() (brackets) at the end = there is an opening bracket in the format code				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154594				0	sk	COLOR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3152922				0	sk	Returns 1, if negative values have been formatted in color, otherwise 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3145563				0	sk	PARENTHESES				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156072				0	sk	Returns 1 if the format code contains an opening bracket (, otherwise 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156090				0	sk	\<emph\>Reference\</emph\> (list of options) is the position of the cell to be examined. If \<emph\>Reference\</emph\> is a range, the cell moves to the top left of the range. If \<emph\>Reference\</emph\> is missing, $[officename] Calc uses the position of the cell in which this formula is located. Microsoft Excel uses the reference of the cell in which the cursor is positioned.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140200.xhp	0	help	tit				0	sk	Vpravo				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140200.xhp	0	help	hd_id3153896				0	sk	\<link href=\"text/scalc/01/02140200.xhp\" name=\"Right\"\>Right\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140200.xhp	0	help	par_id3153361				0	sk	\<ahelp hid=\".uno:FillRight\" visibility=\"visible\"\>Fills a selected range of at least two columns with the contents of the left most cell.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140200.xhp	0	help	par_id3154684				0	sk	If a range of only one row is selected, the contents of the far left cell are copied to all the other selected cells. If you have selected several rows, each of the far left cells is copied into those cells to the right.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	tit				0	sk	Spreadsheet Functions				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3148522				0	sk	\<bookmark_value\>spreadsheets; functions\</bookmark_value\>      \<bookmark_value\>Function Wizard; spreadsheets\</bookmark_value\>      \<bookmark_value\>functions; spreadsheets\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3148522				0	sk	Spreadsheet Functions				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3144508				0	sk	\<variable id=\"tabelletext\"\>This section contains descriptions of the \<emph\>Spreadsheet\</emph\> functions together with an example.\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3146968				0	sk	\<bookmark_value\>ADDRESS function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3146968				0	sk	ADDRESS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155762				0	sk	\<ahelp hid=\"HID_FUNC_ADRESSE\"\>Returns a cell address (reference) as text, according to the specified row and column numbers.\</ahelp\> You can determine whether the address is interpreted as an absolute address (for example, $A$1) or as a relative address (as A1) or in a mixed form (A$1 or $A1). You can also specify the name of the sheet.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301348				0	sk	For interoperability the ADDRESS and INDIRECT functions support an optional parameter to specify whether the R1C1 address notation instead of the usual A1 notation should be used.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301445				0	sk	In ADDRESS, the parameter is inserted as the fourth parameter, shifting the optional sheet name parameter to the fifth position.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id102720080230153				0	sk	In INDIRECT, the parameter is appended as the second parameter.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id102720080230151				0	sk	In both functions, if the argument is inserted with the value 0, then the R1C1 notation is used. If the argument is not given or has a value other than 0, then the A1 notation is used. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301556				0	sk	In case of R1C1 notation, ADDRESS returns address strings using the exclamation mark '!' as the sheet name separator, and INDIRECT expects the exclamation mark as sheet name separator. Both functions still use the dot '.' sheet name separator with A1 notation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301521				0	sk	When opening documents from ODF 1.0/1.1 format, the ADDRESS functions that show a sheet name as the fourth paramater will shift that sheet name to become the fifth parameter. A new fourth parameter with the value 1 will be inserted.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301650				0	sk	When storing a document in ODF 1.0/1.1 format, if ADDRESS functions have a fourth parameter, that parameter will be removed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id102720080230162				0	sk	Do not save a spreadsheet in the old ODF 1.0/1.1 format if the ADDRESS function's new fourth parameter was used with a value of 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301756				0	sk	The INDIRECT function is saved without conversion to ODF 1.0/1.1 format. If the second parameter was present, an older version of Calc will return an error for that function.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3151196				0	sk	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154707				0	sk	ADDRESS(Row; Column; Abs; A1; "Sheet")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147505	7			0	sk	            \<emph\>Row\</emph\> represents the row number for the cell reference				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3145323	8			0	sk	            \<emph\>Column\</emph\> represents the column number for the cell reference (the number, not the letter)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153074	9			0	sk	            \<emph\>Abs\</emph\> determines the type of reference:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153298				0	sk	1: absolute ($A$1)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150431				0	sk	2: row reference type is absolute; column reference is relative (A$1)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3146096				0	sk	3: row (relative); column (absolute) ($A1)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153334				0	sk	4: relative (A1)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802465915				0	sk	            \<emph\>A1\</emph\> (optional) - if set to 0, the R1C1 notation is used. If this parameter is absent or set to another value than 0, the A1 notation is used.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153962	14			0	sk	            \<emph\>Sheet\</emph\> represents the name of the sheet. It must be placed in double quotes.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3147299				0	sk	Príklad:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148744	16			0	sk	            \<item type=\"input\"\>=ADDRESS(1;1;2;;"Sheet2")\</item\> returns the following: Sheet2.A$1				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3159260				0	sk	If the cell A1 in sheet 2 contains the value \<item type=\"input\"\>-6\</item\>, you can refer indirectly to the referenced cell using a function in B2 by entering \<item type=\"input\"\>=ABS(INDIRECT(B2))\</item\>. The result is the absolute value of the cell reference specified in B2, which in this case is 6.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3150372				0	sk	\<bookmark_value\>AREAS function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3150372				0	sk	AREAS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150036				0	sk	\<ahelp hid=\"HID_FUNC_BEREICHE\"\>Returns the number of individual ranges that belong to a multiple range.\</ahelp\> A range can consist of contiguous cells or a single cell.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id061020090307073				0	sk	The function expects a single argument. If you state multiple ranges, you must enclose them into additional parentheses. Multiple ranges can be entered using the semicolon (;) as divider, but this gets automatically converted to the tilde (~) operator. The tilde is used to join ranges.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3145222				0	sk	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155907				0	sk	AREAS(Reference)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153118				0	sk	Reference represents the reference to a cell or cell range.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3148891				0	sk	Príklad				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149946	25			0	sk	            \<item type=\"input\"\>=AREAS((A1:B3;F2;G1))\</item\> returns 3, as it is a reference to three cells and/or areas. After entry this gets converted to =AREAS((A1:B3~F2~G1)).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3146820	26			0	sk	            \<item type=\"input\"\>=AREAS(All)\</item\> returns 1 if you have defined an area named All under \<emph\>Data - Define Range\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3148727				0	sk	\<bookmark_value\>DDE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3148727				0	sk	DDE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149434				0	sk	\<ahelp hid=\"HID_FUNC_DDE\"\>Returns the result of a DDE-based link.\</ahelp\> If the contents of the linked range or section changes, the returned value will also change. You must reload the spreadsheet or choose \<emph\>Edit - Links\</emph\> to see the updated links. Cross-platform links, for example from a \<item type=\"productname\"\>%PRODUCTNAME\</item\> installation running on a Windows machine to a document created on a Linux machine, are not allowed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3150700				0	sk	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148886				0	sk	DDE("Server"; "File"; "Range"; Mode)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154842	32			0	sk	            \<emph\>Server\</emph\> is the name of a server application. \<item type=\"productname\"\>%PRODUCTNAME\</item\>applications have the server name "Soffice".				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153034	33			0	sk	            \<emph\>File\</emph\> is the complete file name, including path specification.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147472	34			0	sk	            \<emph\>Range\</emph\> is the area containing the data to be evaluated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3152773	184			0	sk	            \<emph\>Mode\</emph\> is an optional parameter that controls the method by which the DDE server converts its data into numbers.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154383	185			0	sk	                     \<emph\>Mode\</emph\>                  				20200411 15:09:53
