helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149426	117			0	pt-BR	\<emph\>Texto\</emph\> é o texto cuja parte direita será determinada.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153350	118			0	pt-BR	\<emph\>Número\</emph\> (opcional) é o número de caracteres da parte direita do texto.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148661				0	pt-BR	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151132	120			0	pt-BR	\<item type=\"input\"\>=DIREITA("Sun";2)\</item\> retorna un.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3153534				0	pt-BR	\<bookmark_value\>função ROMANO\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153534				0	pt-BR	ROMANO				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151256				0	pt-BR	\<ahelp hid=\"HID_FUNC_ROEMISCH\"\>Converte um número em algarismos romanos. O intervalo de valores deve ser entre 0 e 3999, os modos podem ser números inteiros de 0 a 4.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149299				0	pt-BR	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150593				0	pt-BR	ROMANO(Número; Modo)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156139	252			0	pt-BR	\<emph\>Número\</emph\> é o número que será convertido em algarismos romanos.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153318	253			0	pt-BR	\<emph\>Modo\</emph\> (opcional) indica o grau de simplificação. Quanto maior for o valor, maior será a simplificação do número romano.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3145306				0	pt-BR	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151371	255			0	pt-BR	\<item type=\"input\"\>=ROMANO(999)\</item\> retorna CMXCIX				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153938	256			0	pt-BR	\<item type=\"input\"\>=ROMANO(999;0)\</item\> retorna CMXCIX				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148412	257			0	pt-BR	\<item type=\"input\"\>=ROMANO(999;1)\</item\> retorna LMVLIV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155421	258			0	pt-BR	            \<item type=\"input\"\>=ROMANO(999;2)\</item\> retorna XMIX				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149235	259			0	pt-BR	            \<item type=\"input\"\>=ROMANO(999;3)\</item\> retorna VMIV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150624	260			0	pt-BR	            \<item type=\"input\"\>=ROMANO(999;4)\</item\> retorna IM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3151005				0	pt-BR	\<bookmark_value\>função PESQUISAR\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3151005				0	pt-BR	PESQUISAR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148692				0	pt-BR	\<ahelp hid=\"HID_FUNC_SUCHEN\"\>Retorna a posição de um segmento de texto dentro de uma cadeia de caracteres.\</ahelp\> Você pode definir o início da pesquisa como uma opção. O texto de pesquisa pode ser um número ou qualquer cadeia de caracteres. A pesquisa não distingue maiúsculas e minúsculas.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152964				0	pt-BR	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154671				0	pt-BR	PESQUISAR("ProcurarTexto"; "Texto"; Posição)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146080	126			0	pt-BR	\<emph\>ProcurarTexto\</emph\> é o texto a ser localizado.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154111	127			0	pt-BR	\<emph\>Texto\</emph\> é o texto onde a pesquisa ocorrerá.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149559	128			0	pt-BR	\<emph\>Posição\</emph\> (opcional) é a posição no texto onde a pesquisa deve começar.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3147322				0	pt-BR	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154564	130			0	pt-BR	\<item type=\"input\"\>=PESQUISAR(54;998877665544)\</item\> retorna 10.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3154830				0	pt-BR	\<bookmark_value\>função SUBSTITUIR\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3154830				0	pt-BR	SUBSTITUIR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153698				0	pt-BR	\<ahelp hid=\"HID_FUNC_WECHSELN\"\>Substitui o texto antigo pelo novo em uma cadeia de caracteres.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150994				0	pt-BR	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147582				0	pt-BR	SUBSTITUIR("Texto"; "PesquisarTexto"; "NovoTexto"; Ocorrência)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153675	178			0	pt-BR	\<emph\>Texto\</emph\> é o texto no qual os segmentos de texto serão trocados.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156155	179			0	pt-BR	\<emph\>PesquisarTexto\</emph\> é o segmento de texto que será substituído (repetidas vezes).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145779	180			0	pt-BR	\<emph\>NovoTexto\</emph\> é o texto que deve substituir o trecho de texto.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150348	181			0	pt-BR	\<emph\>Ocorrência\</emph\> (opcional) indica qual ocorrência do texto de pesquisa deve ser substituído. Se o parâmetro for omitido, o texto de pesquisa é substituído em todo o texto.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150946				0	pt-BR	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150412	183			0	pt-BR	\<item type=\"input\"\>=SUBSTITUIR("123123123";"3";"abc")\</item\> retorna 12abc12abc12abc.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154915	238			0	pt-BR	\<item type=\"input\"\>=SUBSTITUIR("123123123";"3";"abc";2)\</item\> retorna 12312abc123.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3148977				0	pt-BR	\<bookmark_value\>função T\</bookmark_value\>				20200411 15:09:53
