helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3154866				0	pt-BR	\<item type=\"input\"\>Distância até a Escola\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3150471				0	pt-BR	\<item type=\"input\"\>Peso\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3153920				0	pt-BR	14				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3148429				0	pt-BR	\<item type=\"input\"\>>600\</item\>				20200411 15:09:53
