helpcontent2	source\text\shared\explorer\database\02010100.xhp	0	help	par_id3151265				0	pt-BR	=1 retorna todos os registros em que o campo Yes/No (Sim/Não) possui o status "Yes" (Sim) ou "On" (Ativado) (selecionados em preto),				20200411 15:09:53
helpcontent2	source\text\shared\explorer\database\02010100.xhp	0	help	par_id3152450				0	pt-BR	Não				20200411 15:09:53
