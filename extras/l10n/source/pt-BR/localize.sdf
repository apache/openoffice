helpcontent2	source\text\swriter\guide\fields_userdata.xhp	0	help	par_id3147110				0	pt-BR	Significado				20200411 15:09:53
helpcontent2	source\text\swriter\guide\fields_userdata.xhp	0	help	par_id3150508				0	pt-BR	== ou EQ				20200411 15:09:53
