helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3150630	151			0	pt-BR	                     \<item type=\"input\"\>183\</item\>                  				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3150423	152			0	pt-BR	                     \<item type=\"input\"\>170\</item\>                  				20200411 15:09:53
