helpcontent2	source\text\schart\01\wiz_chart_type.xhp	0	help	par_id5749687				0	pt-BR	\<ahelp hid=\".\" visibility=\"hidden\"\>Empilhar séries mostra valores uns sobre os outros.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\wiz_chart_type.xhp	0	help	par_id79348				0	pt-BR	\<ahelp hid=\".\" visibility=\"hidden\"\>Empilha as série exibe valores como porcentagem.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\wiz_chart_type.xhp	0	help	par_id2414014				0	pt-BR	\<ahelp hid=\".\" visibility=\"hidden\"\>As linhas são mostradas como curvas.\</ahelp\>				20200411 15:09:53
