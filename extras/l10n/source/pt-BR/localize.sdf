helpcontent2	source\text\simpress\02\10070000.xhp	0	help	par_id3148725				0	pt-BR	\<ahelp hid=\".uno:Circle\"\>Desenha um círculo preenchido no local onde você arrastar o ponteiro no documento atual. Clique onde deseja desenhar o círculo e arraste até o tamanho desejado. Para desenhar uma elipse, mantenha pressionada a tecla Shift enquanto arrasta.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\simpress\02\10070000.xhp	0	help	par_id3153930				0	pt-BR	\<image id=\"img_id3153936\" src=\"res/commandimagelist/sc_circle.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3153936\"\>Ícone\</alt\>\</image\>				20200411 15:09:53
