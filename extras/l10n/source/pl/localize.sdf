helpcontent2	source\text\shared\02\09070100.xhp	0	help	hd_id3153683				0	pl	FTP				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id3150693				0	pl	\<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXPAGE_HYPERLINK_INTERNET:RB_LINKTYP_FTP\"\>Tworzy hiperłącze FTP.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	hd_id3149095				0	pl	Telnet				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id3151110				0	pl	\<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXPAGE_HYPERLINK_INTERNET:RB_LINKTYP_TELNET\"\>Tworzy hiperłącze Telnet.\</ahelp\>				20200411 15:09:53
