helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3154754				0	pl	MsgBox "Termin przydatności mija dzisiaj."				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3154361				0	pl	End If				20200411 15:09:53
