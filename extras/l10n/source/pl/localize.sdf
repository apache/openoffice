helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152688				0	pl	\<ahelp hid=\".\"\>Zwraca sumę potęg liczby.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152708				0	pl	SERIESSUM(x;n;m;współczynniki) = współczynnik_1*x^n + współczynnik_2*x^(n+m) + współczynnik_3*x^(n+2m) +...+ współczynnik_i*x^(n+(i-1)m)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152724				0	pl	Składnia				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_idN11BD9				0	pl	SERIESSUM(x; n; m; współczynniki)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152737				0	pl	\<emph\>X\</emph\> to liczba będąca zmienną niezależną.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144344				0	pl	n: potęga początkowa				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144357				0	pl	\<emph\>M\</emph\> to przyrost wartości N.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144370				0	pl	\<emph\>Współczynniki\</emph\> są serią współczynników. Dla każdego współczynnika suma serii jest rozszerzana o jedną sekcję.				20200411 15:09:53
