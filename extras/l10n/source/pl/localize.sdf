helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3149289				0	pl	Składnia				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3156009				0	pl	ROZKŁAD.DWUM(X; N; P; skumulowany)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3154304	80			0	pl	            \<emph\>X\</emph\> oznacza liczbę sukcesów w zbiorze prób.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3147492	81			0	pl	            \<emph\>N\</emph\> oznacza liczbę niezależnych prób.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3146085	82			0	pl	            \<emph\>SP\</emph\> oznacza prawdopodobieństwo powodzenia próby.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3149760	83			0	pl	            \<emph\>C\</emph\> = 0 pozwala na obliczenie prawdopodobieństwa pojedynczego zdarzenia, \<emph\>C\</emph\> = 1 pozwala na obliczenie prawdopodobieństwa skumulowanego.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3151171				0	pl	Przykład				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3145666	85			0	pl	            \<item type=\"input\"\>=ROZKŁAD.DWUM(A1;12;0,5;0)\</item\> pozwala obliczyć prawdopodobieństwo, że podczas 12 rzutów monetą \<emph\>orzeł\</emph\> wypadnie tyle razy, ile wprowadzono w komórce A1 (jeśli w komórce A1 wprowadzono wartości od \<item type=\"input\"\>0\</item\> do \<item type=\"input\"\>12\</item\>).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3150120	86			0	pl	            \<item type=\"input\"\>=ROZKŁAD.DWUM(A1;12;0.5;1)\</item\> oblicza prawdopodobieństwo skumulowane dla tej samej serii zdarzeń. Na przykład jeśli komórka A1 = \<item type=\"input\"\>4\</item\>, prawdopodobieństwo skumulowane serii oznacza, że 0, 1, 2, 3 lub 4 razy wypadnie \<emph\>orzeł\</emph\> (niewyłączny operator LUB).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	bm_id0119200902432928				0	pl	\<bookmark_value\>ROZKŁAD.CHI.KW.ODW, funkcja\</bookmark_value\>				20200411 15:09:53
