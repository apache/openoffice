helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3147287				0	pl	dValue=Exp( Log(b1)+Log(b2) )				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3161832				0	pl	MsgBox "" & dValue & chr(13) & (b1*b2) ,0,"Mnożenie razy logarytm"				20200411 15:09:53
