helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156316				0	pl	\<ahelp hid=\"HID_FUNC_ISTFEHLER\"\>Funkcja CZY.BŁĄD sprawdza, czy komórki zawierają ogólne wartości błędu. Funkcja CZY.BŁĄD rozpoznaje wartość błędu #NIE DOTYCZY.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3147569				0	pl	Składnia				20200411 15:09:53
