helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159594				0	pl	\<item type=\"input\"\>=POTĘGA(4;3)\</item\> zwraca wartość 64, tzn. 4 podniesione do potęgi 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1614429				0	pl	4^3 również zwraca 4 do potęgi 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152651				0	pl	\<bookmark_value\>SERIESSUM;funkcja\</bookmark_value\>				20200411 15:09:53
