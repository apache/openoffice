helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3148943	267			0	pl	2				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149771	268			0	pl	\<item type=\"input\"\>95\</item\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3158407	269			0	pl	\<item type=\"input\"\>17\</item\>				20130618 17:22:18
