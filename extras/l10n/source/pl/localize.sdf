helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3155306				0	pl	sText ="To jest krótki tekst"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3154011				0	pl	iRun = 1				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3147215				0	pl	while iRun < Len(sText)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3147427				0	pl	if Mid(sText,iRun,1 )<> " " then Mid( sText ,iRun, 1, Chr( 1 + Asc( Mid(sText,iRun,1 )) )				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3149665				0	pl	iRun = iRun + 1				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3152939				0	pl	Wend				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3153189				0	pl	MsgBox sText,0,"Tekst zakodowany"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3145251				0	pl	end sub				20200411 15:09:53
