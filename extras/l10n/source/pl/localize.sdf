helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145725				0	pl	\<item type=\"input\"\>=ZAOKR.W.GÓRĘ(-11;-2;0)\</item\> zwraca wartość -10.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145740				0	pl	\<item type=\"input\"\>=ZAOKR.W.GÓRĘ(-11;-2;1)\</item\> zwraca wartość -12.				20200411 15:09:53
