helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3147088	4			0	en-GB	\<ahelp hid=\"SD:RADIOBUTTON:DLG_PUBLISHING:PAGE2_STANDARD\"\>Creates standard HTML pages from export pages.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3145071	5			0	en-GB	Standard HTML with frames				20130618 17:22:18
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3154824	6			0	en-GB	\<ahelp hid=\"SD:RADIOBUTTON:DLG_PUBLISHING:PAGE2_FRAMES\"\>Creates standard HTML pages with frames. The exported page will be placed in the main frame, and the frame to the left will display a table of contents in the form of hyperlinks.\</ahelp\>				20130618 17:22:18
