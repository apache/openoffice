helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150482	133			0	en-GB	\<ahelp hid=\"HID_FUNC_SAEUBERN\"\>All non-printing characters are removed from the string.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146880	134			0	en-GB	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147472	135			0	en-GB	CLEAN("Text")				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150695	136			0	en-GB	\<emph\>Text\</emph\> refers to the text from which to remove all non-printable characters.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3155498				0	en-GB	\<bookmark_value\>CODE function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155498	3			0	en-GB	CODE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3152770	4			0	en-GB	\<ahelp hid=\"HID_FUNC_CODE\"\>Returns a numeric code for the first character in a text string.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155830	5			0	en-GB	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149188	6			0	en-GB	CODE("Text")				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154383	7			0	en-GB	\<emph\>Text\</emph\> is the text string for which the code of the first character is to be found.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3154394	8			0	en-GB	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3159209	9			0	en-GB	\<item type=\"input\"\>=CODE("Hieronymus")\</item\> returns 72, \<item type=\"input\"\>=CODE("hieroglyphic")\</item\> returns 104.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150280	211			0	en-GB	The code used here does not refer to ASCII, but to the code table currently loaded.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149688				0	en-GB	\<bookmark_value\>CONCATENATE function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149688	167			0	en-GB	CONCATENATE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154524	168			0	en-GB	\<ahelp hid=\"HID_FUNC_VERKETTEN\"\>Combines several text strings into one string.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149542	169			0	en-GB	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155954	170			0	en-GB	CONCATENATE("Text1"; "Text2"; ...)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146847	171			0	en-GB	\<emph\>Text1; Text2; ...\</emph\> are 1 to 30 text passages which are to be concatenated together into one string.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153110	172			0	en-GB	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150008	173			0	en-GB	\<item type=\"input\"\>=CONCATENATE("Good ";"Morning ";"Mrs. ";"Doe")\</item\> returns \<emph\>Good Morning Mrs. Doe\</emph\>.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3145166				0	en-GB	\<bookmark_value\>DECIMAL function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3145166	225			0	en-GB	DECIMAL				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156361	226			0	en-GB	\<ahelp hid=\"HID_FUNC_DEZIMAL\"\>Converts a text string with characters from a \<link href=\"text/shared/00/00000005.xhp#zahlensystem\" name=\"number system\"\>number system\</link\> to a positive integer in the base radix given.\</ahelp\> The radix must be in the range 2 to 36. Spaces and tabs are ignored. The \<emph\>Text\</emph\> field is not case-sensitive.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3157994	227			0	en-GB	If the radix is 16, a leading x or X or 0x or 0X, and an appended h or H, is disregarded. If the radix is 2, an appended b or B is disregarded. Other characters that do not belong to the number system generate an error.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150014	228			0	en-GB	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154328	229			0	en-GB	DECIMAL("Text"; Radix)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150128	230			0	en-GB	\<emph\>Text\</emph\> is the text string to be converted. To differentiate between a hexadecimal number, such as A1 and the reference to cell A1, you must place the number in quotation marks, for example, "A1" or "FACE".				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145241	231			0	en-GB	\<emph\>Radix\</emph\> indicates the base of the number system. It may be any positive integer in the range 2 to 36.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3156062	232			0	en-GB	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145355	233			0	en-GB	\<item type=\"input\"\>=DECIMAL("17";10)\</item\> returns 17.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155622	234			0	en-GB	\<item type=\"input\"\>=DECIMAL("FACE";16)\</item\> returns 64206.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151015	235			0	en-GB	\<item type=\"input\"\>=DECIMAL("0101";2)\</item\> returns 5.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3148402				0	en-GB	\<bookmark_value\>DOLLAR function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148402	11			0	en-GB	DOLLAR				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153049	12			0	en-GB	\<ahelp hid=\"HID_FUNC_DM\"\>Converts a number to an amount in the currency format, rounded to a specified decimal place.\</ahelp\> In the \<item type=\"literal\"\>Value\</item\> field enter the number to be converted to currency. Optionally, you may enter the number of decimal places in the \<item type=\"literal\"\>Decimals\</item\> field. If no value is specified, all numbers in currency format will be displayed with two decimal places. 				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151280	263			0	en-GB	You set the currency format in your system settings.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150569	13			0	en-GB	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154188	14			0	en-GB	DOLLAR(Value; Decimals)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145299	15			0	en-GB	\<emph\>Value\</emph\> is a number, a reference to a cell containing a number, or a formula which returns a number.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145629	16			0	en-GB	\<emph\>Decimals\</emph\> is the optional number of decimal places.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149030	17			0	en-GB	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153546	18			0	en-GB	\<item type=\"input\"\>=DOLLAR(255)\</item\> returns \<emph\>£255.00\</emph\>.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154635	19			0	en-GB	\<item type=\"input\"\>=DOLLAR(367.456;2)\</item\> returns \<emph\>£367.46\</emph\>. Uses the currency symbol and decimal separator that correspond to the \<link href=\"text/shared/optionen/01140000.xhp\" name=\"current locale setting\"\>current locale setting\</link\>.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3150685				0	en-GB	\<bookmark_value\>EXACT function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150685	78			0	en-GB	EXACT				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3158413	79			0	en-GB	\<ahelp hid=\"HID_FUNC_IDENTISCH\"\>Compares two text strings and returns TRUE if they are identical.\</ahelp\> This function is case-sensitive.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152817	80			0	en-GB	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148594	81			0	en-GB	EXACT("Text1"; "Text2")				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153224	82			0	en-GB	\<emph\>Text1\</emph\> refers to the first text to compare.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148637	83			0	en-GB	\<emph\>Text2\</emph\> is the second text to compare.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149777	84			0	en-GB	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156263	85			0	en-GB	\<item type=\"input\"\>=EXACT("microsystems";"Microsystems")\</item\> returns FALSE.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3152589				0	en-GB	\<bookmark_value\>FIND function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152589	44			0	en-GB	FIND				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146149	45			0	en-GB	\<ahelp hid=\"HID_FUNC_FINDEN\"\>Looks for a text string within another.\</ahelp\> You can also define where to begin the search. The search term can be a number or any string of characters. The search is case-sensitive.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3083284	46			0	en-GB	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3083452	47			0	en-GB	FIND("FindText"; "Text"; Position)				20130618 17:22:18
