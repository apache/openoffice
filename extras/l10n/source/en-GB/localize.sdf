helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149169	246			0	en-GB	\<ahelp hid=\"HID_FUNC_ISTGERADE\"\>Returns TRUE if the value is an even integer, or FALSE if the value is odd.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146928	247			0	en-GB	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151203	248			0	en-GB	ISEVEN(Value)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150491	249			0	en-GB	\<emph\>Value\</emph\> is the value to be checked.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3445844				0	en-GB	If Value is not an integer any digits after the decimal point are ignored. The sign of Value is also ignored.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154136	250			0	en-GB	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163813	251			0	en-GB	\<item type=\"input\"\>=ISEVEN(48)\</item\> returns TRUE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8378856				0	en-GB	\<item type=\"input\"\>=ISEVEN(33)\</item\> returns FALSE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7154759				0	en-GB	\<item type=\"input\"\>=ISEVEN(0)\</item\> returns TRUE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1912289				0	en-GB	\<item type=\"input\"\>=ISEVEN(-2.1)\</item\> returns TRUE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5627307				0	en-GB	\<item type=\"input\"\>=ISEVEN(3.999)\</item\> returns FALSE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3156034				0	en-GB	\<bookmark_value\>ISODD function\</bookmark_value\>\<bookmark_value\>odd integers\</bookmark_value\>				20130618 17:22:18
