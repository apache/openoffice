helpcontent2	source\text\swriter\01\02110100.xhp	0	help	par_idN10795				0	en-GB	\<ahelp hid=\".\" visibility=\"hidden\"\>Sets the cursor to the next object of the selected type.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\02110100.xhp	0	help	par_idN107AF				0	en-GB	\<ahelp hid=\".\" visibility=\"hidden\"\>Select this icon to browse through OLE objects.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\02110100.xhp	0	help	par_idN107C6				0	en-GB	\<ahelp hid=\".\" visibility=\"hidden\"\>Select this icon to browse through headings.\</ahelp\>				20130618 17:22:18
