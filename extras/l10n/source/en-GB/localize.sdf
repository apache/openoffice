helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3147548	679			0	en-GB	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156205	680			0	en-GB	GCD_ADD(Number(s))				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145150	681			0	en-GB	\<emph\>Number(s)\</emph\> is a list of 1 to 30 numbers.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150239	682			0	en-GB	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159192	683			0	en-GB	\<item type=\"input\"\>=GCD_ADD(5;15;25)\</item\> returns 5.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3156048				0	en-GB	\<bookmark_value\>ISEVEN function\</bookmark_value\>\<bookmark_value\>even integers\</bookmark_value\>				20130618 17:22:18
