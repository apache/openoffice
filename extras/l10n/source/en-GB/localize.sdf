helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3150791	10			0	en-GB	The following example converts a date in YYYY.MM.DD format to MM/DD/YYYY format.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	hd_id3125863	11			0	en-GB	Example:				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3144761	12			0	en-GB	Sub ExampleUSDate				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3153194	13			0	en-GB	Dim sInput As String				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3154217	14			0	en-GB	Dim sUS_date As String				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3150448	15			0	en-GB	sInput = InputBox("Please input a date in the international format 'YYYY-MM-DD'")				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3149203	16			0	en-GB	sUS_date = Mid(sInput, 6, 2)				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3150439	17			0	en-GB	sUS_date = sUS_date & "/"				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3153770	18			0	en-GB	sUS_date = sUS_date & Right(sInput, 2)				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3161833	19			0	en-GB	sUS_date = sUS_date & "/"				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3147215	20			0	en-GB	sUS_date = sUS_date & Left(sInput, 4)				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3149666	21			0	en-GB	MsgBox sUS_date				20130618 17:22:18
