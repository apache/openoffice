helpcontent2	source\text\sbasic\shared\03120104.xhp	0	help	par_id3159150	12			0	en-GB	msgbox Val("123.123")				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03120104.xhp	0	help	par_id3154126	13			0	en-GB	msgbox Val("A123.123")				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03120104.xhp	0	help	par_id3147229	14			0	en-GB	end Sub				20130618 17:22:18
