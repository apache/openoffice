helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3149877	205			0	en-GB	US method (NASD), 12 months of 30 days each				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3148766	250			0	en-GB	1				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3154326	206			0	en-GB	Exact number of days in months, exact number of days in year				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3145245	251			0	en-GB	2				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3155620	207			0	en-GB	Exact number of days in month, year has 360 days				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3145297	252			0	en-GB	3				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3148394	208			0	en-GB	Exact number of days in month, year has 365 days				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3151022	253			0	en-GB	4				20130618 17:22:18
