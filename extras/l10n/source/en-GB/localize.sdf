helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3149582	23			0	en-GB	dAlpha = InputBox$ ("Enter the Alpha angle (in degrees): ","Alpha")				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3154016	24			0	en-GB	Print "the length of the side adjacent the angle is"; (d1 / tan (dAlpha * Pi / 180))				20130618 17:22:18
