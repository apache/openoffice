helpcontent2	source\text\sbasic\shared\03030206.xhp	0	help	par_id3149378	33			0	en-GB	a1 = "start time"				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03030206.xhp	0	help	par_id3145800	34			0	en-GB	b1 = "end time"				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03030206.xhp	0	help	par_id3151074	35			0	en-GB	c1 = "total time"				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03030206.xhp	0	help	par_id3154492	37			0	en-GB	a2 = "8:34"				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03030206.xhp	0	help	par_id3155602	38			0	en-GB	b2 = "18:12"				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03030206.xhp	0	help	par_id3150715	39			0	en-GB	daDT = TimeValue(b2) - TimeValue(a2)				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03030206.xhp	0	help	par_id3153838	40			0	en-GB	c2 = a1 & ": " & a2 & chr(13)				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03030206.xhp	0	help	par_id3150749	41			0	en-GB	c2 = c2 & b1 & ": " & b2 & chr(13)				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03030206.xhp	0	help	par_id3154755	42			0	en-GB	c2 = c2 & c1 & ": " & trim(Str(Hour(daDT))) & ":" & trim(Str(Minute(daDT))) & ":" & trim(Str(Second(daDT)))				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03030206.xhp	0	help	par_id3153714	43			0	en-GB	Msgbox c2				20130618 17:22:18
