helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3145313	3			0	en-GB	                  \<emph\>Comparative operator\</emph\>               				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3147089	4			0	en-GB	                  \<emph\>Effect\</emph\>               				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3147209	5			0	en-GB	Equal (=)				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3146797	6			0	en-GB	Shows values equal to the condition.				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3143271	7			0	en-GB	Less than (<)				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3153761	8			0	en-GB	Shows values less than the condition.				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3146807	9			0	en-GB	Greater than (>)				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3154852	10			0	en-GB	Shows values greater than the condition.				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3155342	11			0	en-GB	Less than or equal to (< =)				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3154381	12			0	en-GB	Shows values that are less than or equal to the condition.				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3153823	13			0	en-GB	Greater than or equal to (> =)				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3154143	14			0	en-GB	Shows values that are greater than or equal to the condition.				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3154811	15			0	en-GB	Not equal (< >)				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3148944	16			0	en-GB	Shows the values not equal to the condition.				20130618 17:22:18
