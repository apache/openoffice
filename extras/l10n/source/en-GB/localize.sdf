helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	hd_id3159154	39			0	en-GB	Breaks				20130618 17:22:18
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3150874	40			0	en-GB	\<ahelp hid=\"SW_CHECKBOX_TP_OPTSHDWCRSR_CB_BREAK\"\>Displays all line breaks inserted with the Shift+Enter shortcut. These breaks create a new line, but do not start a new paragraph.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_idN108E5				0	en-GB	Hidden text				20130618 17:22:18
