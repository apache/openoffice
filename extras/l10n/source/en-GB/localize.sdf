helpcontent2	source\text\sbasic\shared\03080301.xhp	0	help	par_id3150870	10			0	en-GB	Dim iSpectral(10) As Integer				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03080301.xhp	0	help	par_id3148673	12			0	en-GB	Randomise 2^14-1				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03080301.xhp	0	help	par_id3156423	13			0	en-GB	For iCount = 1 To 1000				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03080301.xhp	0	help	par_id3147288	14			0	en-GB	iVar = Int((10 * Rnd) ) REM Range from 0 to 9				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03080301.xhp	0	help	par_id3155132	15			0	en-GB	iSpectral(iVar) = iSpectral(iVar) +1				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03080301.xhp	0	help	par_id3153143	16			0	en-GB	Next iCount				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03080301.xhp	0	help	par_id3154011	18			0	en-GB	sText = " | "				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03080301.xhp	0	help	par_id3151114	19			0	en-GB	For iCount = 0 To 9				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03080301.xhp	0	help	par_id3145748	20			0	en-GB	sText = sText & iSpectral(iCount) & " | "				20130618 17:22:18
