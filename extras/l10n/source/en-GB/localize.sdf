helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	par_id3148576	12			0	en-GB	lVar = rgb(128,0,200)				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	par_id3154012	13			0	en-GB	MsgBox "The colour " & lVar & " consists of:" & Chr(13) &_				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	par_id3148645	14			0	en-GB	"red= " & Red(lVar) & Chr(13)&_				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	par_id3159155	15			0	en-GB	"green= " & Green(lVar) & Chr(13)&_				20130618 17:22:18
