helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3156134				0	hr	<SDFIELD TYPE=DOCINFO SUBTYPE=CREATE FORMAT=TIME SDVAL="0" SDNUM="1031;1031;HH:MM:SS AM/PM" SDFIXED>03:58:35 PM</SDFIELD>				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3155077				0	hr	Modification date				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3154330				0	hr	<SDFIELD TYPE=DOCINFO SUBTYPE=CHANGE FORMAT=DATE SDNUM="1031;1031;NN DD MMM, YY">Mo 23 Feb, 98</SDFIELD>				20181231 09:50:43
