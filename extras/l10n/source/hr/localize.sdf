helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3150587				0	hr	\<ahelp hid=\"HID_SMA_NEWLINE\"\>Inserts a new line in your document.\</ahelp\> You can also type \<emph\>newline\</emph\> directly in the \<emph\>Commands\</emph\> window.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_idN101B2				0	hr	\<image id=\"img_id3155117\" src=\"starmath/res/co21912.png\" width=\"0.3335inch\" height=\"0.3335inch\"\>\<alt id=\"alt_id3155117\"\>Icon\</alt\>\</image\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3148760				0	hr	Subscript left				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3147309				0	hr	\<ahelp hid=\"HID_SMA_LSUBX\"\>Inserts a subscript to the left of a placeholder.\</ahelp\> You can also type \<emph\><?>lsub{<?>}\</emph\> in the \<emph\>Commands\</emph\> window.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_idN101EB				0	hr	\<image id=\"img_id3149544\" src=\"starmath/res/co21917.png\" width=\"0.3335inch\" height=\"0.3335inch\"\>\<alt id=\"alt_id3149544\"\>Icon\</alt\>\</image\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3150687				0	hr	Subscript bottom				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3150699				0	hr	\<ahelp hid=\"HID_SMA_CSUBX\"\>Inserts a subscript directly under a placeholder.\</ahelp\> You can also type \<emph\><?>csub<?>\</emph\> directly in the \<emph\>Commands\</emph\> window.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_idN10226				0	hr	\<image id=\"img_id3145265\" src=\"starmath/res/co21904.png\" width=\"0.3335inch\" height=\"0.3335inch\"\>\<alt id=\"alt_id3145265\"\>Icon\</alt\>\</image\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3145136				0	hr	Subscript right				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3146913				0	hr	\<ahelp hid=\"HID_SMA_RSUBX\"\>Inserts a subscript to the right of a placeholder.\</ahelp\> You can also type \<emph\><?>_{<?>}\</emph\> in the \<emph\>Commands\</emph\> window, and the subscript dash can be replaced by \<emph\>rsub\</emph\> or \<emph\>sub\</emph\>.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_idN10265				0	hr	\<image id=\"img_id3149220\" src=\"starmath/res/co21906.png\" width=\"0.3335inch\" height=\"0.3335inch\"\>\<alt id=\"alt_id3149220\"\>Icon\</alt\>\</image\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3147116				0	hr	Vertical stack (3 elements)				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3146332				0	hr	\<ahelp hid=\"HID_SMA_STACK\"\>Inserts a vertical stack with three placeholders.\</ahelp\> You can also type \<emph\>stack {<?>#<?>#<?>}\</emph\> in the \<emph\>Commands\</emph\> window.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_idN102A0				0	hr	\<image id=\"img_id3149848\" src=\"starmath/res/co21902.png\" width=\"0.3335inch\" height=\"0.3335inch\"\>\<alt id=\"alt_id3149848\"\>Icon\</alt\>\</image\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3155572				0	hr	Small gap				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3147056				0	hr	\<ahelp hid=\"HID_SMA_SBLANK\"\>Inserts a small gap between a placeholder and the next element.\</ahelp\> You can also type \<emph\>`\</emph\> directly in the Commands window. The command must appear to the left or right of a symbol, variable, number or complete command.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_idN102DC				0	hr	\<image id=\"img_id3154094\" src=\"starmath/res/co21909.png\" width=\"0.3335inch\" height=\"0.3335inch\"\>\<alt id=\"alt_id3154094\"\>Icon\</alt\>\</image\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3154580				0	hr	Lijevo poravnato				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3154592				0	hr	\<ahelp hid=\"HID_SMA_ALIGNLX\"\>This icon assigns left-alignment to "a" and inserts a placeholder.\</ahelp\> You can type \<emph\>alignl<?>\</emph\> directly in the \<emph\>Commands\</emph\> window.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_idN10317				0	hr	\<image id=\"img_id3156130\" src=\"starmath/res/co21910.png\" width=\"0.3335inch\" height=\"0.3335inch\"\>\<alt id=\"alt_id3156130\"\>Icon\</alt\>\</image\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3154723				0	hr	Align to horizontal center				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3149319				0	hr	\<ahelp hid=\"HID_SMA_ALIGNCX\"\>Assigns horizontal central alignment to "a" and inserts a placeholder.\</ahelp\> You can also type \<emph\>alignc<?>\</emph\> directly in the \<emph\>Commands\</emph\> window.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_idN10352				0	hr	\<image id=\"img_id3155583\" src=\"starmath/res/co21911.png\" width=\"0.3335inch\" height=\"0.3335inch\"\>\<alt id=\"alt_id3155583\"\>Icon\</alt\>\</image\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3149768				0	hr	Desno poravnato				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3149780				0	hr	\<ahelp hid=\"HID_SMA_ALIGNRX\"\>Inserts the command for right alignment and a placeholder.\</ahelp\> You can also type \<emph\>alignr<?>\</emph\> in the \<emph\>Commands\</emph\> window.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_idN1038D				0	hr	\<image id=\"img_id3155085\" src=\"starmath/res/co21907.png\" width=\"0.3335inch\" height=\"0.3335inch\"\>\<alt id=\"alt_id3155085\"\>Icon\</alt\>\</image\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3154338				0	hr	Matrix stack				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3146941				0	hr	\<ahelp hid=\"HID_SMA_MATRIX\"\>This icon inserts a matrix with four placeholders.\</ahelp\> You can also type \<emph\>matrix{<?>#<?>##<?>#<?>}\</emph\> directly in the \<emph\>Commands\</emph\> window. The position of an element inside this diagram is indicated by two coordinates; the first specifies the line number and the second the column number. You can expand this matrix in any direction in the \<emph\>Commands\</emph\> window by adding characters.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_idN103C9				0	hr	\<image id=\"img_id3150027\" src=\"starmath/res/co21903.png\" width=\"0.3335inch\" height=\"0.3335inch\"\>\<alt id=\"alt_id3150027\"\>Icon\</alt\>\</image\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3149358				0	hr	Prepreka				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3149370				0	hr	\<ahelp hid=\"HID_SMA_BLANK\"\>This icon inserts a gap or space between placeholders.\</ahelp\> You can also type \<emph\>~\</emph\> directly in the \<emph\>Commands\</emph\> window. The command must appear to the left or right of a symbol, variable, number or complete command.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3155394	48			0	hr	For alignment, the \<emph\>alignl, alignc\</emph\> and \<emph\>alignr\</emph\> commands are especially effective, if you are 				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3151009				0	hr	aligning numbers and denominators, for example \<emph\>{alignl a}over{b+c}\</emph\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3148812				0	hr	constructing binomials or stacks, for example \<emph\>binom{2*n}{alignr k}\</emph\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3154360				0	hr	aligning the elements in a matrix, for example \<emph\>matrix{alignr a#b+2##c+1/3#alignl d}\</emph\> and				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3155946				0	hr	beginning a new line, for example \<emph\>a+b-c newline alignr x/y\</emph\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3154621				0	hr	When using the align instructions, note that				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3147382				0	hr	they can only placed at the beginning of expressions and can only occur once. Therefore you can type \<emph\>a+b alignr c\</emph\>, but not \<emph\>a+alignr b\</emph\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3154004				0	hr	they affect each other, which means that typing \<emph\>{alignl{alignr a}}over{b+c}\</emph\> aligns \<emph\>a\</emph\> on the right.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	hd_id8036133				0	hr	To align using the "matrix" command				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_idN10F70				0	hr	Aligning to the left				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3149645				0	hr	If a line or an expression begins with text, it is aligned on the left by default. You can change this with any of the \<emph\>align\</emph\> commands. An example is \<emph\>stack{a+b-c*d#alignr "text"}\</emph\>, where "text" appears aligned to the right. Note that text must always be surrounded by quotation marks.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3149966				0	hr	The standard centralized formulas can be aligned to the left without using the \<emph\>Format - Alignment\</emph\> menu. To do this, place an empty character string, that is, the inverted commas which surround any text "", before the section of formula that you want to align. For example, typing \<emph\>"" a+b newline "" c+d\</emph\> results in both equations being left-aligned instead of centered.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3145654				0	hr	When typing information in the Commands window, note that some formats require spaces for the correct structure. This is especially true when entering values (for example, a lsup{3}) instead of placeholders.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3148708				0	hr	Click \<link href=\"text/smath/01/03091100.xhp\" name=\"Brackets and Grouping\"\>Brackets and Grouping\</link\> for more information about formatting in \<emph\>$[officename] Math\</emph\>.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3155340				0	hr	Useful information about \<link href=\"text/smath/01/03091200.xhp\" name=\"Indexes and Exponents\"\>Indexes and Exponents\</link\> and \<link href=\"text/smath/01/03091400.xhp\" name=\"Scaling\"\>Scaling\</link\>, helps you organize your document in the best possible way.				20181231 09:50:43
helpcontent2	source\text\smath\01\03091200.xhp	0	help	tit				0	hr	Indexes and Exponents				20181231 09:50:43
helpcontent2	source\text\smath\01\03091200.xhp	0	help	bm_id3150746				0	hr	\<bookmark_value\>indexes and exponents in $[officename] Math\</bookmark_value\>\<bookmark_value\>exponents and indexes in $[officename] Math\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03091200.xhp	0	help	hd_id3150746				0	hr	\<link href=\"text/smath/01/03091200.xhp\" name=\"Indexes and Exponents\"\>Indexes and Exponents\</link\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03091200.xhp	0	help	par_id3153730				0	hr	Here, you will find basic information about indexes and exponents in \<emph\>$[officename] Math\</emph\>. You can try the examples described here to help you understand the details discussed. (The quotation marks in this text are for emphasis purposes only and are not part of the examples.)				20181231 09:50:43
helpcontent2	source\text\smath\01\03091200.xhp	0	help	par_id3149884				0	hr	The index and exponent for a character are displayed one on top of the other, left-justified to the base character. For example, type \<emph\>a_2^3\</emph\> or \<emph\>a^3_2\</emph\>. This can be in any order. Instead of \<emph\>'_'\</emph\> and \<emph\>'^'\</emph\>, you can use \<emph\>'sub'\</emph\> and \<emph\>'sup'\</emph\>.				20181231 09:50:43
helpcontent2	source\text\smath\01\03091200.xhp	0	help	par_id3148387				0	hr	However, it is no longer possible to use the following patterns				20181231 09:50:43
helpcontent2	source\text\smath\01\03091200.xhp	0	help	par_id3149029				0	hr	a_2_3				20181231 09:50:43
helpcontent2	source\text\smath\01\03091200.xhp	0	help	par_id3155985				0	hr	a^2^3				20181231 09:50:43
helpcontent2	source\text\smath\01\03091200.xhp	0	help	par_id3153923				0	hr	a_2^3_4				20181231 09:50:43
helpcontent2	source\text\smath\01\03091200.xhp	0	help	par_id3153724				0	hr	Each sub-/superscript position of a base character can only be used once. You must use brackets to indicate the desired result. The following examples illustrate this				20181231 09:50:43
helpcontent2	source\text\smath\01\03091200.xhp	0	help	par_id3151185				0	hr	a_{2_3}				20181231 09:50:43
helpcontent2	source\text\smath\01\03091200.xhp	0	help	par_id3151272				0	hr	a^{2^3}				20181231 09:50:43
helpcontent2	source\text\smath\01\03091200.xhp	0	help	par_id3156316				0	hr	a_2^{3_4}				20181231 09:50:43
helpcontent2	source\text\smath\01\03091200.xhp	0	help	par_id3145207				0	hr	a_{2^3}^{4_5}				20181231 09:50:43
helpcontent2	source\text\smath\01\03091200.xhp	0	help	par_id3151173	13			0	hr	Unlike other formula editors where "\<emph\>_\</emph\>" and " \<emph\>^\</emph\> " only refer to the next character ("a_24" refers only to the "2"), $[officename] Math refers to the entire number(s)/name(s)/text. If you want to put superscripts and subscripts in sequence, the expression can be written as follows: a_2{}^3 or a^3{}_2				20181231 09:50:43
helpcontent2	source\text\smath\01\03091200.xhp	0	help	par_id3154260				0	hr	To write tensors, \<emph\>$[officename] Math\</emph\> provides several options. In addition to the notation "R_i{}^{jk}{}_l", common in other applications, additional notations can be used, namely "R_i{}^jk{}_l" and "{{R_i}^jk}_l."				20181231 09:50:43
helpcontent2	source\text\smath\01\03091200.xhp	0	help	par_id3147516				0	hr	Super- and subscripts to the left of the base character can also be right-justified. To do this, the new commands "lsub" and "lsup" are used. Both commands have the same effect as "sub" and "sup", except that they are left of the base character. See also "a lsub 2 lsup 3."				20181231 09:50:43
helpcontent2	source\text\smath\01\03091200.xhp	0	help	par_id3154276				0	hr	The rules governing unambiguity and the necessity of using brackets remain the same. In principle, this can be achieved with \<emph\>{}_2^3 a\</emph\>.				20181231 09:50:43
helpcontent2	source\text\smath\01\03091200.xhp	0	help	par_id3152961				0	hr	The commands "sub" and "sup" are also available as "rsub" and "rsup".				20181231 09:50:43
helpcontent2	source\text\smath\01\03091200.xhp	0	help	par_id3158437				0	hr	Using the "csub" and "csup" commands, you can write super- and subscripts directly above or below a character. An example is "a csub y csup x". Combinations of indexes and exponents together are also possible: "abc_1^2 lsub 3 lsup 4 csub 55555 csup 66666."				20181231 09:50:43
helpcontent2	source\text\smath\01\03091200.xhp	0	help	par_id3154570				0	hr	Super- and subscripts can be attached to most unary and binary operators. Two examples: "a div_2 b a<csub n b +_2 h" and "a toward csub f b x toward csup f y."				20181231 09:50:43
helpcontent2	source\text\smath\01\03091200.xhp	0	help	par_id3155904				0	hr	Be sure to also enter all spaces between characters when entering these examples into the \<emph\>Commands\</emph\> window.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090100.xhp	0	help	tit				0	hr	Unarni/binarni operatori				20181231 09:50:43
helpcontent2	source\text\smath\01\03090100.xhp	0	help	bm_id3150342				0	hr	\<bookmark_value\>unary operators\</bookmark_value\>\<bookmark_value\>binary operators\</bookmark_value\>\<bookmark_value\>operators; unary and binary\</bookmark_value\>\<bookmark_value\>plus signs\</bookmark_value\>\<bookmark_value\>plus/minus signs\</bookmark_value\>\<bookmark_value\>minus/plus signs\</bookmark_value\>\<bookmark_value\>multiplication signs\</bookmark_value\>\<bookmark_value\>NOT operator\</bookmark_value\>\<bookmark_value\>AND operator\</bookmark_value\>\<bookmark_value\>logical operators\</bookmark_value\>\<bookmark_value\>Boolean operators\</bookmark_value\>\<bookmark_value\>OR operator\</bookmark_value\>\<bookmark_value\>concatenating math symbols\</bookmark_value\>\<bookmark_value\>addition signs\</bookmark_value\>\<bookmark_value\>subtraction signs\</bookmark_value\>\<bookmark_value\>minus signs\</bookmark_value\>\<bookmark_value\>slash division sign\</bookmark_value\>\<bookmark_value\>backslash division sign\</bookmark_value\>\<bookmark_value\>indexes; adding to formulas\</bookmark_value\>\<bookmark_value\>powers\</bookmark_value\>\<bookmark_value\>division signs\</bookmark_value\>\<bookmark_value\>user-defined operators;unary and binary\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090100.xhp	0	help	hd_id3150342				0	hr	\<link href=\"text/smath/01/03090100.xhp\" name=\"Unary/Binary Operators\"\>Unary/Binary Operators\</link\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090100.xhp	0	help	par_id3151241				0	hr	\<ahelp hid=\"HID_SMA_UNBINOPS_CAT\"\>You can choose various unary and binary operators to build your $[officename] Math formula. Unary refers to operators that affect one placeholder. Binary refers to operators that connect two placeholders. The lower area of the Selection window displays the individual operators.\</ahelp\> The \<link href=\"text/shared/00/00000001.xhp#kontextmenue\" name=\"context menu\"\>context menu\</link\> of the \<emph\>Commands\</emph\> window also contains a list of these operators, as well as additional operators. If you need an operator that is not contained in the Selection window, use the context menu or type it directly in the \<emph\>Commands\</emph\> window.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090100.xhp	0	help	par_id3146963				0	hr	The following is a complete list of the unary and binary operators. The symbol next to the operator indicates that it can be accessed through the Selection window (choose \<emph\>View - Selection\</emph\>) or through the context menu of the Commands window.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090100.xhp	0	help	hd_id3147405				0	hr	Unary and Binary Operators				20181231 09:50:43
helpcontent2	source\text\smath\01\03090100.xhp	0	help	par_idN10085				0	hr	\<image id=\"img_id3156399\" src=\"starmath/res/un21201.png\" width=\"0.3335inch\" height=\"0.3335inch\"\>\<alt id=\"alt_id3156399\"\>Icon\</alt\>\</image\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090100.xhp	0	help	par_id3154555				0	hr	Plus				20181231 09:50:43
helpcontent2	source\text\smath\01\03090100.xhp	0	help	par_id3153003				0	hr	\<ahelp hid=\"HID_SMA_PLUSX\"\>Inserts a \<emph\>plus\</emph\> with one placeholder.\</ahelp\> You can also type \<emph\>+ <?>\</emph\> in the \<emph\>Commands\</emph\> window.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090100.xhp	0	help	par_idN100C1				0	hr	\<image id=\"img_id3148776\" src=\"starmath/res/un21202.png\" width=\"0.3335inch\" height=\"0.3335inch\"\>\<alt id=\"alt_id3148776\"\>Icon\</alt\>\</image\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090100.xhp	0	help	par_id3155991				0	hr	Minus				20181231 09:50:43
helpcontent2	source\text\smath\01\03090100.xhp	0	help	par_id3153717				0	hr	\<ahelp hid=\"HID_SMA_MINUSX\"\>Inserts a \<emph\>minus\</emph\> with one placeholder.\</ahelp\> You can also type \<emph\>-<?>\</emph\> in the \<emph\>Commands\</emph\> window.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090100.xhp	0	help	par_idN100FD				0	hr	\<image id=\"img_id3150757\" src=\"starmath/res/un21203.png\" width=\"0.3335inch\" height=\"0.3335inch\"\>\<alt id=\"alt_id3150757\"\>Icon\</alt\>\</image\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090100.xhp	0	help	par_id3153150				0	hr	Plus/Minus				20181231 09:50:43
helpcontent2	source\text\smath\01\03090100.xhp	0	help	par_id3150260				0	hr	\<ahelp hid=\"HID_SMA_PLUSMINUSX\"\>Inserts a \<emph\>plus/minus\</emph\> with one placeholder.\</ahelp\> You can also type \<emph\>+-<?>\</emph\> in the \<emph\>Commands\</emph\> window.				20181231 09:50:43
