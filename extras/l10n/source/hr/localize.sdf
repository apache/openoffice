helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_id3154939				0	hr	\<ahelp hid=\"HID_HELP_TOOLBOXITEM_BOOKMARKS\"\>Adds this page to your bookmarks\</ahelp\>				20181231 09:50:43
