helpcontent2	source\text\swriter\guide\text_nav_keyb.xhp	0	help	par_id3156260				0	hr	Moves the cursor to the beginning of the contents in the current cell.				20181231 09:50:43
helpcontent2	source\text\swriter\guide\text_nav_keyb.xhp	0	help	par_id3145409				0	hr	Moves the cursor to the beginning of the contents of the current cell. Press again to move the cursor to the first cell in the table. Press again to move the cursor to the beginning of the document.				20181231 09:50:43
helpcontent2	source\text\swriter\guide\text_nav_keyb.xhp	0	help	par_id3154410				0	hr	Kraj				20181231 09:50:43
helpcontent2	source\text\swriter\guide\text_nav_keyb.xhp	0	help	par_id3153372				0	hr	Moves the cursor to the end of the current line.				20181231 09:50:43
helpcontent2	source\text\swriter\guide\text_nav_keyb.xhp	0	help	par_id3154235				0	hr	Moves the cursor to the end of the document				20181231 09:50:43
helpcontent2	source\text\swriter\guide\text_nav_keyb.xhp	0	help	par_id3154262				0	hr	Kraj				20181231 09:50:43
helpcontent2	source\text\swriter\guide\text_nav_keyb.xhp	0	help	par_id3154850				0	hr	In a table				20181231 09:50:43
helpcontent2	source\text\swriter\guide\text_nav_keyb.xhp	0	help	par_id3154873				0	hr	Moves to the end of the contents in the current cell.				20181231 09:50:43
helpcontent2	source\text\swriter\guide\text_nav_keyb.xhp	0	help	par_id3155894				0	hr	Moves the cursor to the end of the contents of the current cell. Press again to move the cursor to the last cell in the table. Press again to move the cursor to the end of the document.				20181231 09:50:43
