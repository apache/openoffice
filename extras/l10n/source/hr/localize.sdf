helpcontent2	source\text\scalc\05\empty_cells.xhp	0	help	par_id9604480				0	hr	=ISTEXT(B1) => FALSE				20181231 09:50:43
helpcontent2	source\text\scalc\05\empty_cells.xhp	0	help	par_id2298959				0	hr	=B1=0 => TRUE				20181231 09:50:43
helpcontent2	source\text\scalc\05\empty_cells.xhp	0	help	par_id4653767				0	hr	=B1="" => TRUE (MS-Excel: FALSE)				20181231 09:50:43
helpcontent2	source\text\scalc\05\empty_cells.xhp	0	help	par_id8801538				0	hr	C1: =VLOOKUP(...) with empty cell result => displays empty (MS-Excel: displays 0)				20181231 09:50:43
helpcontent2	source\text\scalc\05\empty_cells.xhp	0	help	par_id6746421				0	hr	=ISNUMBER(VLOOKUP(...)) => FALSE				20181231 09:50:43
