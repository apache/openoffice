helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_id3149797				0	hr	\<image id=\"img_id3155434\" src=\"res/commandimagelist/sc_print.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3155434\"\>Icon\</alt\>\</image\>				20181231 09:50:43
