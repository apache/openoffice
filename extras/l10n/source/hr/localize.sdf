helpcontent2	source\text\swriter\guide\text_nav_keyb.xhp	0	help	par_id3156220	25			0	hr	\<emph\>+\</emph\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>\<emph\>Command key\</emph\>\</caseinline\>\<defaultinline\>\<emph\>Ctrl key\</emph\>\</defaultinline\>\</switchinline\>				20181231 09:50:43
helpcontent2	source\text\swriter\guide\text_nav_keyb.xhp	0	help	par_id3156113				0	hr	Right, left arrow keys				20181231 09:50:43
helpcontent2	source\text\swriter\guide\text_nav_keyb.xhp	0	help	par_id3150105				0	hr	Moves the cursor one character to the left or to the right.				20181231 09:50:43
helpcontent2	source\text\swriter\guide\text_nav_keyb.xhp	0	help	par_id3153418				0	hr	Moves the cursor one word to the left or to the right.				20181231 09:50:43
helpcontent2	source\text\swriter\guide\text_nav_keyb.xhp	0	help	par_id3149629				0	hr	Up, down arrow keys				20181231 09:50:43
helpcontent2	source\text\swriter\guide\text_nav_keyb.xhp	0	help	par_id3149949				0	hr	Moves the cursor up or down one line.				20181231 09:50:43
helpcontent2	source\text\swriter\guide\text_nav_keyb.xhp	0	help	par_id3149972				0	hr	(Ctrl+Alt) Moves the current paragraph up or down.				20181231 09:50:43
helpcontent2	source\text\swriter\guide\text_nav_keyb.xhp	0	help	par_id3149624				0	hr	Polazno				20181231 09:50:43
helpcontent2	source\text\swriter\guide\text_nav_keyb.xhp	0	help	par_id3149871				0	hr	Moves the cursor to the beginning of the current line.				20181231 09:50:43
helpcontent2	source\text\swriter\guide\text_nav_keyb.xhp	0	help	par_id3145108				0	hr	Moves the cursor to the beginning of the document.				20181231 09:50:43
