helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165956				0	hr	COUNTA				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165983				0	hr	4				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166006				0	hr	MAX				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166033				0	hr	5				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166056				0	hr	MIN				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143316				0	hr	6				20181231 09:50:43
