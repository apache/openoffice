helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3147209				0	hr	Equal (=)				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3146797				0	hr	Shows values equal to the condition.				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3143271				0	hr	Less than (<)				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3153761				0	hr	Shows values less than the condition.				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3146807				0	hr	Greater than (>)				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3154852				0	hr	Shows values greater than the condition.				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3155342				0	hr	Less than or equal to (< =)				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3154381				0	hr	Shows values that are less than or equal to the condition.				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3153823				0	hr	Greater than or equal to (> =)				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3154143				0	hr	Shows values that are greater than or equal to the condition.				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3154811				0	hr	Not equal (< >)				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3148944				0	hr	Shows the values not equal to the condition.				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3149669				0	hr	Najveće				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3159413				0	hr	Shows the N (numeric value as parameter) largest values.				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3151054				0	hr	Najmanje				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3161657				0	hr	Shows the N (numeric value as parameter) smallest values.				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3150400				0	hr	Najveći %				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3161645				0	hr	Shows the largest N% (numeric value as parameter) of the total values.				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3149202				0	hr	Najmanji %				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3151176				0	hr	Shows the smallest N% (numeric value as parameter) of the entire values.				20181231 09:50:43
