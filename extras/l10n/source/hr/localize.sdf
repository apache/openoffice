helpcontent2	source\text\shared\01\06200000.xhp	0	help	hd_id3148826				0	hr	Konverzija				20181231 09:50:43
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3159157				0	hr	Normally in a mixed text selection made of Hangul and Hanja characters, all Hangul characters will be converted to Hanja and all Hanja characters will be converted to Hangul. If you want to convert a mixed text selection only in one direction, use the following conversion options.				20181231 09:50:43
helpcontent2	source\text\shared\01\06200000.xhp	0	help	hd_id3153585				0	hr	Hangul only				20181231 09:50:43
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3154142				0	hr	\<ahelp hid=\"SVX_CHECKBOX_RID_SVX_MDLG_HANGULHANJA_CB_HANGUL_ONLY\"\>Check to convert only Hangul. Do not convert Hanja.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\01\06200000.xhp	0	help	hd_id3150823				0	hr	Hanja only				20181231 09:50:43
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3156023				0	hr	\<ahelp hid=\"SVX_CHECKBOX_RID_SVX_MDLG_HANGULHANJA_CB_HANJA_ONLY\"\>Check to convert only Hanja. Do not convert Hangul.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\01\06200000.xhp	0	help	hd_id3152360				0	hr	Zanemari				20181231 09:50:43
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3153896				0	hr	\<ahelp hid=\"HID_HANGULDLG_BUTTON_IGNORE\"\>No changes will be made to the current selection. The next word or character will be selected for conversion.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\01\06200000.xhp	0	help	hd_id3148550				0	hr	Always Ignore				20181231 09:50:43
