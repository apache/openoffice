helpcontent2	source\text\scalc\01\02190200.xhp	0	help	par_id3154124				0	hr	\<ahelp hid=\".uno:DeleteColumnbreak\"\>Removes a manual column break to the left of the active cell.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\02190200.xhp	0	help	par_id3145173				0	hr	Position the cursor in the cell to the right of the column break indicated by a vertical line and choose \<emph\>Edit - Delete Manual Break - Column Break\</emph\>. The manual column break is removed.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	tit				0	hr	WEEKNUM				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	bm_id3159161				0	hr	\<bookmark_value\>WEEKNUM function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	hd_id3159161				0	hr	\<variable id=\"weeknum\"\>\<link href=\"text/scalc/01/func_weeknum.xhp\"\>WEEKNUM\</link\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3149770				0	hr	\<ahelp hid=\"HID_FUNC_KALENDERWOCHE\"\>WEEKNUM calculates the week number of the year for the internal date value.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_idN105E4				0	hr	The International Standard ISO 8601 has decreed that Monday shall be the first day of the week. A week that lies partly in one year and partly in another is assigned a number in the year in which most of its days lie. That means that week number 1 of any year is the week that contains the January 4\<emph\>th\</emph\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	hd_id3153055				0	hr	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3147236				0	hr	WEEKNUM(number; mode)				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3147511				0	hr	\<emph\>Number\</emph\> is the internal date number.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3154269				0	hr	\<emph\>Mode\</emph\> sets the start of the week and the calculation type.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3148930				0	hr	1 = Sunday				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3154280				0	hr	2 = Monday				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	hd_id3146948				0	hr	Primjeri				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3150704				0	hr	WEEKNUM("1/1/95";1) returns 1 (1/1/95 was a Sunday)				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3149792				0	hr	WEEKNUM("1/1/95";2) returns 52. If the week starts on Monday, Sunday belongs to the last week of the previous year.				20181231 09:50:43
