helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147253				0	hr	\<emph\>Number\</emph\> represents the value based on which the Poisson distribution is calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151177				0	hr	\<emph\>Mean\</emph\> represents the middle value of the Poisson distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149200				0	hr	\<emph\>C\</emph\> = 0 calculates the density function; \<emph\>C\</emph\> = 1 calculates the distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3159347				0	hr	Primjer				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150113				0	hr	=POISSON(60;50;1) returns 0.93.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153100				0	hr	\<bookmark_value\>PERCENTILE function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153100				0	hr	PERCENTILE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154940				0	hr	\<ahelp hid=\"HID_FUNC_QUANTIL\"\>Returns the alpha-percentile of data values in an array.\</ahelp\> A percentile returns the scale value for a data series which goes from the smallest (Alpha=0) to the largest value (alpha=1) of a data series. For \<emph\>Alpha\</emph\> = 25%, the percentile means the first quartile; \<emph\>Alpha\</emph\> = 50% is the MEDIAN.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150531				0	hr	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148813				0	hr	PERCENTILE(Data;Alpha)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153054				0	hr	\<emph\>Data\</emph\> represents the array of data.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154212				0	hr	\<emph\>Alpha\</emph\> represents the percentage of the scale between 0 and 1.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154290				0	hr	Primjer				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159147				0	hr	=PERCENTILE(A1:A50; 0.1) predstavlja vrijednost u setu podataka koja  iznosi 10% od svih podataka u A1:A50. 				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148807				0	hr	\<bookmark_value\>PERCENTRANK function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148807				0	hr	PERCENTRANK				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153573				0	hr	\<ahelp hid=\"HID_FUNC_QUANTILSRANG\"\>Returns the percentage rank of a value in a sample.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147512				0	hr	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147238				0	hr	PERCENTRANK(Data; Value)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154266				0	hr	\<emph\>Data\</emph\> represents the array of data in the sample.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148475				0	hr	\<emph\>Value\</emph\> represents the value whose percentile rank must be determined.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155364				0	hr	Primjer				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149163				0	hr	=PERCENTRANK(A1:A50; 50) returns the percentage rank of the value 50 from the total range of all values found in A1:A50. If 50 falls outside the total range, an error message will appear.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3166442				0	hr	\<bookmark_value\>QUARTILE function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3166442				0	hr	QUARTILE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146958				0	hr	\<ahelp hid=\"HID_FUNC_QUARTILE\"\>Returns the quartile of a data set.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152942				0	hr	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153684				0	hr	QUARTILE(Data; Type)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153387				0	hr	\<emph\>Data\</emph\> represents the array of data in the sample.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155589				0	hr	\<emph\>Type\</emph\> represents the type of quartile. (0 = MIN, 1 = 25%, 2 = 50% (MEDIAN), 3 = 75% and 4 = MAX.)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149103				0	hr	Primjer				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159276				0	hr	=QUARTILE(A1:A50; 2) returns the value of which 50% of the scale corresponds to the lowest to highest values in the range A1:A50.				20181231 09:50:43
