helpcontent2	source\text\swriter\01\05030400.xhp	0	help	hd_id3150252				0	hr	\<link href=\"text/swriter/01/05030400.xhp\" name=\"Drop Caps\"\>Drop Caps\</link\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	par_id3154763				0	hr	\<ahelp hid=\"HID_DROPCAPS\"\>Formats the first letter of a paragraph with a large capital letter, that can span several lines. The paragraph must span at least as many lines as you specify in the Lines box.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	hd_id3151388				0	hr	Postavke				20181231 09:50:43
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	hd_id3147295				0	hr	Show Drop Caps				20181231 09:50:43
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	par_id3150536				0	hr	\<ahelp hid=\"SW_CHECKBOX_TP_DROPCAPS_CB_SWITCH\"\>Applies the drop cap settings to the selected paragraph.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	hd_id3155626				0	hr	Whole word				20181231 09:50:43
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	par_id3154554				0	hr	\<ahelp hid=\"SW_CHECKBOX_TP_DROPCAPS_CB_WORD\"\>Displays the first letter of the first word in the paragraph as a drop cap, and the remaining letters of the word as large type.\</ahelp\>				20181231 09:50:43
