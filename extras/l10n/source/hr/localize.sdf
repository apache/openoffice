helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3154724				0	hr	\<ahelp hid=\"HID_SMA_SLRBRACEX\"\>Inserts scalable braces with a placeholder.\</ahelp\> You can also type \<emph\>left lbrace <?> right rbrace\</emph\> in the \<emph\>Commands\</emph\> window. The size of the braces is automatically adjusted.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_idN1037E				0	hr	\<image id=\"img_id3155598\" src=\"starmath/res/al21813.png\" width=\"0.3335inch\" height=\"0.3335inch\"\>\<alt id=\"alt_id3155598\"\>Icon\</alt\>\</image\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3150924				0	hr	Single vertical bars (scalable)				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3145634				0	hr	\<ahelp hid=\"HID_SMA_SLRLINEX\"\>Inserts scalable single vertical bars with a placeholder.\</ahelp\> You can also type \<emph\>left lline <?> right rline\</emph\> in the \<emph\>Commands\</emph\> window. The size of the brackets is automatically adjusted.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_idN103B7				0	hr	\<image id=\"img_id3153223\" src=\"starmath/res/al21814.png\" width=\"0.25inch\" height=\"0.25inch\"\>\<alt id=\"alt_id3153223\"\>Icon\</alt\>\</image\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3146938				0	hr	Double vertical bars (scalable)				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3146950				0	hr	\<ahelp hid=\"HID_SMA_SLRDLINEX\"\>Inserts scalable double vertical bars with a placeholder.\</ahelp\> You can also type \<emph\>left ldline <?> right rdline\</emph\> in the \<emph\>Commands\</emph\> window. The size of the brackets is automatically adjusted.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_idN103F0				0	hr	\<image id=\"img_id3150026\" src=\"starmath/res/al21811.png\" width=\"0.3335inch\" height=\"0.3335inch\"\>\<alt id=\"alt_id3150026\"\>Icon\</alt\>\</image\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3149359				0	hr	Angle brackets (scalable)				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3149372				0	hr	\<ahelp hid=\"HID_SMA_SLRANGLEX\"\>Inserts scalable angle brackets with a placeholder.\</ahelp\> You can also type \<emph\>left langle <?> right rangle\</emph\> in the \<emph\>Commands\</emph\> window. The size of the brackets is automatically adjusted.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_idN10429				0	hr	\<image id=\"img_id3154235\" src=\"starmath/res/al21822.png\" width=\"0.25inch\" height=\"0.25inch\"\>\<alt id=\"alt_id3154235\"\>Icon\</alt\>\</image\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3153139				0	hr	Operator brackets (scalable)				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3155388				0	hr	\<ahelp hid=\"HID_SMA_SLMRANGLEXY\"\>Inserts scalable operator brackets with placeholders.\</ahelp\> You can also type \<emph\>left langle <?> mline <?> right rangle\</emph\> in the \<emph\>Commands\</emph\> window. The bracket size is adjusted automatically.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_idN10464				0	hr	\<image id=\"img_id3154349\" src=\"starmath/res/al21825.png\" width=\"0.25inch\" height=\"0.25inch\"\>\<alt id=\"alt_id3154349\"\>Icon\</alt\>\</image\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3155954				0	hr	Brace top (scalable)				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3154621				0	hr	\<ahelp hid=\"HID_SMA_XOVERBRACEY\"\>Inserts a scalable horizontal upper brace with placeholders.\</ahelp\> You can also enter \<emph\><?> overbrace <?>\</emph\> directly in the \<emph\>Commands\</emph\> window. The bracket size is adjusted automatically.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_idN104A0				0	hr	\<image id=\"img_id3149646\" src=\"starmath/res/al21826.png\" width=\"0.25inch\" height=\"0.25inch\"\>\<alt id=\"alt_id3149646\"\>Icon\</alt\>\</image\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3150674				0	hr	Brace bottom (scalable)				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3154023				0	hr	\<ahelp hid=\"HID_SMA_XUNDERBRACEY\"\>Inserts a scalable horizontal lower brace with placeholders.\</ahelp\> You can also type \<emph\><?> underbrace <?>\</emph\> directly in the \<emph\>Commands\</emph\> window. The bracket size is adjusted automatically.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3149954				0	hr	\<ahelp hid=\"HID_SMA_LRFLOORX\"\>To insert floor brackets, type \<emph\>lfloor<?>rfloor\</emph\> directly in the \<emph\>Commands\</emph\> window.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3150592				0	hr	\<ahelp hid=\"HID_SMA_LRCEILX\"\>To insert ceiling brackets, type \<emph\>lceil<?>rceil\</emph\> directly in the \<emph\>Commands\</emph\> window.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3149623				0	hr	\<ahelp hid=\"HID_SMA_SLRFLOORX\"\>To insert scalable floor brackets, type \<emph\>left lfloor<?>right rfloor\</emph\> directly in the \<emph\>Commands\</emph\> window.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3145668				0	hr	\<ahelp hid=\"HID_SMA_SLRCEILX\"\>To insert scalable ceiling brackets, type \<emph\>left lceil<?>right rceil\</emph\> directly in the \<emph\>Commands\</emph\> window.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3149208				0	hr	Brackets are automatically sized when you type \<emph\>left\</emph\> and \<emph\>right\</emph\> in front of the bracket command, for example, \<emph\>left(a over b right)\</emph\>. You can also set the size and spacing of brackets by choosing \<emph\>Format - Spacing - Category - Brackets\</emph\> and setting the desired percentages. Mark the \<emph\>Scale all brackets\</emph\> check box to apply the changes to all brackets in the formula.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3150857				0	hr	You can also use single brackets. To do this, type a backslash \<emph\>\\\</emph\> in front of the command. For example, when you type \<emph\>\\[\</emph\>, the left square bracket appears without its counterpart. This is useful for creating reverse brackets or for constructing intervals. Note that only non-scalable brackets can be used individually. To change the size, use the \<emph\>size\</emph\> command.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_idN113E5				0	hr	Examples of single brackets				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_idN113E8				0	hr	For non-scaled brackets:				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_idN113EB				0	hr	a = \\{ \\( \\[ b newline				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_idN113EE				0	hr	{} + c \\] \\) \\ }				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_idN113F3				0	hr	For scaled brackets use \<emph\>none\</emph\> as the bracket name				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_idN113FA				0	hr	a = left ( a over b right none newline				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_idN113FF				0	hr	left none phantom {a over b} + c right )				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_idN11404				0	hr	The \<emph\>phantom\</emph\> statement ensures that the last bracket is the correct size.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3145107				0	hr	Be sure to put spaces (gaps) between elements when entering them directly in the Commands window. This ensures that the correct structure is recognized.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3153198				0	hr	Useful information about \<link href=\"text/smath/01/03091200.xhp\" name=\"indexes and exponents\"\>indexes and exponents\</link\> as well as \<link href=\"text/smath/01/03091400.xhp\" name=\"scaling\"\>scaling\</link\> helps you structure formulas effectively. For more information about brackets, see \<link href=\"text/smath/01/03091100.xhp\" name=\"Brackets and Groups\"\>Brackets and Grouping\</link\>.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090908.xhp	0	help	tit				0	hr	Korijen				20181231 09:50:43
helpcontent2	source\text\smath\01\03090908.xhp	0	help	hd_id3154704				0	hr	\<link href=\"text/smath/01/03090908.xhp\" name=\"Square Root\"\>Square Root\</link\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090908.xhp	0	help	par_id3145790				0	hr	Here is an example of how to create a square root with \<emph\>$[officename] Math\</emph\>. If you want to use the example in your own formula, copy it to the \<emph\>Commands\</emph\> window using the clipboard.				20181231 09:50:43
helpcontent2	source\text\smath\01\03090908.xhp	0	help	par_id3148870				0	hr	\<image id=\"img_id3153917\" src=\"res/helpimg/smzb8.png\" width=\"9.567cm\" height=\"3.597cm\"\>\<alt id=\"alt_id3153917\"\>Icon\</alt\>\</image\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03090908.xhp	0	help	par_id3153914				0	hr	%LAMBDA_{deg","t}=1 + %alpha_deg SQRT {M_t over M_{(t=0)}-1}~"."				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	tit				0	hr	Zagrade i grupiranja				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	bm_id3147341				0	hr	\<bookmark_value\>brackets and grouping in $[officename] Math\</bookmark_value\>\<bookmark_value\>grouping and brackets in $[officename] Math\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	hd_id3147341				0	hr	\<link href=\"text/smath/01/03091100.xhp\" name=\"Brackets and Grouping\"\>Brackets and Grouping\</link\>				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3150342				0	hr	Note: the quotation marks in the examples are used to emphasize text and do not belong to the content of the formulas and commands.				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3146962				0	hr	When typing example formulas into the \<emph\>Commands\</emph\> window, note that spaces are often required for correct structure.				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3149054				0	hr	Braces "{}" are used to group expressions together to form one new expression. For example, "sqrt {x * y}" is the square root of the entire product x*y, while "sqrt x * y" is the square root of x multiplied by y. Braces do not require an extra space.				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3151392				0	hr	Set brackets were previously inserted in the Selection window or directly in the Commands window as "left lbrace <?> right rbrace". Now, a left and a right set bracket can also be inserted using "lbrace" and "rbrace", without or without wildcards.				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3147403				0	hr	There are a total of eight (8) different types of brackets available. The "ceil" and "floor" brackets are often used for rounding up or down the argument to the next integer: "lceil -3.7 rceil = -3" or "lfloor -3.7 rfloor = -4".				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3146320				0	hr	Operator brackets, also known as Bra-kets (angle brackets with a vertical line in between), are common in Physics notation: "langle a mline b rangle" or "langle a mline b mline c over d mline e rangle." The height and positioning of the vertical lines always corresponds exactly to the enclosing brackets.				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3157870				0	hr	All brackets may only be used in pairs. The brackets have some common characteristics:				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3155761				0	hr	All types of brackets have the same grouping function as described for "{}"\<emph\>-\</emph\> brackets.				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3145590				0	hr	All types of brackets, including those that are visible, permit empty group definition. The enclosed expression may therefore be empty.				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3154562				0	hr	Brackets do not adjust their size to the enclosed expression. For example, if you want "( a over b )" with a bracket size adjusted to a and b you must insert "left" and "right". Entering "left(a over b right)" produces appropriate sizing. If, however, the brackets themselves are part of the expression whose size is changed, they are included the size change: "size 3(a over b)" and "size 12(a over b)". The sizing of the bracket-to-bracket expression ratio does not change in any way.				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3153002				0	hr	Since "left" and "right" ensure unique assignment of the brackets, every single bracket can be used as an argument for these two commands, even placing right brackets on the left side, or left brackets on the right. Instead of a bracket you can use the "none" qualifier, which means that there is no bracket shown and that there is no space reserved for a bracket. Using this, you can create the following expressions:				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3150014				0	hr	left lbrace x right none				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3149877				0	hr	left [ x right )				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3145241				0	hr	left ] x right [				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3156060				0	hr	left rangle x right lfloor				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3150935				0	hr	The same rules apply to "left" and "right" as to the other brackets: they also work as group builders and may enclose empty expressions.				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3149030				0	hr	The combination of mismatched brackets, single brackets and repositioned left and right brackets occurs often in mathematical formulas. The following is a formula that will create an error when typed:				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3155989				0	hr	[2, 3) - right open interval				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3147169				0	hr	Using "left" and "right" makes the above expression valid in $[officename] Math: "left [2, 3 right )". However, the brackets do not have any fixed size because they adjust to the argument. Setting a single bracket is a bit cumbersome. Therefore, there you can display single brackets with a fixed size by placing a "\\" (backslash) in front of normal brackets. These brackets then act like any other symbol and no longer have the special functionality of brackets; that is they do not work as group builders and their orientation corresponds to that of other symbols. See "size *2 \\langle x \\rangle" and "size *2 langle x rangle".				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3153720				0	hr	The complete overview is as follows				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3149715				0	hr	\\{ or \\lbrace, \\} or \\rbrace				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3150756				0	hr	\\(, \\)				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3145207				0	hr	\\[, \\]				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3153153				0	hr	\\langle, \\rangle				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3150263				0	hr	\\lceil, \\rceil				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3147252				0	hr	\\lfloor, \\rfloor				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3154690				0	hr	\\lline, \\rline				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3145414				0	hr	\\ldline, \\rdline				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3147514				0	hr	In this way, intervals like the one above can be built in \<emph\>$[officename] Math\</emph\> without any problems: \\[2", "3\\) or "\\]2", "3\\[ (Attention: These quotation marks are part of the entry.)				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3153532				0	hr	Please note that the quotation marks must be entered and can be obtained with \<emph\>Shift+2\</emph\> and not with typographical quotation marks. Generally, punctuation marks (like the comma in this case) are set as text. Although it is also possible to type "\\[2,~3\\)" the above option is preferable. In the previous example, "fixed size" always describes a bracket size dependent on the font size used.				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3153674				0	hr	Nesting groups within each other is relatively problem-free. In the formula hat "{a + b}" the "hat" is displayed simply over the center of "{a + b}". Also, "color red lceil a rceil" and "grave hat langle x * y rangle" work as expected. The result of the latter can be compared to "grave {hat langle x * y rangle}." These attributes do not compete, but rather can be combined.				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3147526				0	hr	This differs slightly for competing or mutually influencing attributes. This is often the case with font attributes. For example, which color does the b have in "color yellow color red (a + color green b)", or which size does it have in "size *4 (a + size /2 b)"? Given a base size of 12, does it have the size 48, 6 or even 24 (which could be seen as a combination)? The following are basic resolution rules, which will be followed consistently in the future. In general, the rules apply to all group operations. This only has a visible effect on the font attributes, like "bold", "ital", "phantom", "size", "color" and "font":				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3152952				0	hr	Group operations in sequence are treated as if every single operation is enclosed by braces. They are nested, and in every level there can be no more than one operation. Here is an example of a formula with many group operations: "size 12 color red font sans size -5 (a + size 8 b)" like "{size 12{color red{font sans{size -5 (a + {size 8 b})}}}}".				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3158441				0	hr	This example formula is then interpreted from left to right. The operations only affect its corresponding group (or expression). Operations further to the right "replace" or "combine themselves with" their predecessors.				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3150994				0	hr	A group operation does not have any effect on higher-level operations but rather affects only lower-level groups and expressions, including their brackets and super-/subscripts. For example, "a + size *2 (b * size -8 c_1)^2"				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3154196				0	hr	"color ..." and "font ..." as well as "size n" (n is a decimal) replace any preceding operations of the same type				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3154136				0	hr	for "size +n", "size -n", "size *n", and "size /n" the effects of the operations are combined,				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3146934				0	hr	"size *2 size -5 a" would be double the starting size minus 5				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3149297				0	hr	"font sans ( a + font serif b)"				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3155174				0	hr	"size *2 ( a + size /2 b )"				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3154906				0	hr	To change the size of a formula, use "size +" or -,*,/. Do not use "size n". These can easily be used in any context. This enables you to copy to other areas by using Copy and Paste, and the result remains the same. Furthermore, such expressions survive a change of base size in the menu better than when using "size n". If you use only "size *" and "size /" (for example, "size *1.24 a or size /0.86 a") the proportions remain intact.				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3147587				0	hr	Examples (with a base size of 12 and 50% for indexes):				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3148734				0	hr	Exactly identical proportions with "size 18 a_n" and "size *1.5 a_n".				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3152766				0	hr	This differs in different contexts: "x^{size 18 a_n}" and "x^{size *1.5 a_n}"				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3157986				0	hr	Examples with size +n for a comparison. They look identical:				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3158001				0	hr	a_{size 8 n}				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3147332				0	hr	a_{size +2 n}				20181231 09:50:43
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3155143				0	hr	a_{size *1.333 n}				20181231 09:50:43
