helpcontent2	source\text\schart\01\05070000.xhp	0	help	bm_id3154346				0	hr	\<bookmark_value\>charts; formatting floors\</bookmark_value\>\<bookmark_value\>formatting; chart floors\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\schart\01\05070000.xhp	0	help	hd_id3154346				0	hr	Pod grafikona				20181231 09:50:43
helpcontent2	source\text\schart\01\05070000.xhp	0	help	par_id3150767	2			0	hr	\<variable id=\"diagrammboden\"\>\<ahelp hid=\".uno:DiagramFloor\"\>Opens the\<emph\> Chart Floor\</emph\> dialog, where you can modify the properties of the chart floor. The chart floor is the lower area in 3D charts. This function is only available for 3D charts.\</ahelp\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\schart\01\05060000.xhp	0	help	tit				0	hr	Zid grafikona				20181231 09:50:43
helpcontent2	source\text\schart\01\05060000.xhp	0	help	bm_id3150792				0	hr	\<bookmark_value\>charts; formatting walls\</bookmark_value\>\<bookmark_value\>formatting;chart walls\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\schart\01\05060000.xhp	0	help	hd_id3150792				0	hr	Zid grafikona				20181231 09:50:43
helpcontent2	source\text\schart\01\05060000.xhp	0	help	par_id3154685	2			0	hr	\<variable id=\"diagramm\"\>\<ahelp visibility=\"visible\" hid=\".uno:DiagramWall\"\>Opens the\<emph\> Chart Wall\</emph\> dialog, where you can modify the properties of the chart wall. The chart wall is the "vertical" background behind the data area of the chart.\</ahelp\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\schart\01\05050100.xhp	0	help	tit				0	hr	Mreža				20181231 09:50:43
helpcontent2	source\text\schart\01\05050100.xhp	0	help	bm_id3150398				0	hr	\<bookmark_value\>X axes;grid formatting\</bookmark_value\>\<bookmark_value\>Y axes;grid formatting\</bookmark_value\>\<bookmark_value\>Z axes; grid formatting\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\schart\01\05050100.xhp	0	help	hd_id3150398				0	hr	Mreža				20181231 09:50:43
helpcontent2	source\text\schart\01\05050100.xhp	0	help	par_id3152577				0	hr	\<variable id=\"gitter\"\>\<ahelp hid=\".uno:DiagramGridAll\"\>Opens the \<emph\>Grid\</emph\> dialog for defining grid properties.\</ahelp\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\schart\01\05030000.xhp	0	help	tit				0	hr	Legenda				20181231 09:50:43
helpcontent2	source\text\schart\01\05030000.xhp	0	help	hd_id3145800				0	hr	 Legend				20181231 09:50:43
helpcontent2	source\text\schart\01\05030000.xhp	0	help	par_id3146972				0	hr	\<variable id=\"legende\"\>\<ahelp hid=\".uno:Legend\"\>Defines the border, area and character attributes for a legend.\</ahelp\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\schart\01\05030000.xhp	0	help	hd_id3145232				0	hr	\<link href=\"text/shared/01/05020100.xhp\" name=\"Character\"\>Character\</link\>				20181231 09:50:43
helpcontent2	source\text\schart\01\05030000.xhp	0	help	hd_id3147344				0	hr	\<link href=\"text/schart/01/04020000.xhp\" name=\"Display\"\>Display\</link\>				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	tit				0	hr	Trend Lines 				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	bm_id1744743				0	hr	\<bookmark_value\>calculating;regression curves\</bookmark_value\>      \<bookmark_value\>regression curves in charts\</bookmark_value\>      \<bookmark_value\>trend lines in charts\</bookmark_value\>      \<bookmark_value\>mean value lines in charts\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	hd_id5409405				0	hr	\<variable id=\"regression\"\>\<link href=\"text/schart/01/04050100.xhp\"\>Trend Lines\</link\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id7272255				0	hr	\<variable id=\"trendlinestext\"\>\<ahelp hid=\".\"\>Trend lines can be added to all 2D chart types except for Pie and Stock charts.\</ahelp\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id143436				0	hr	\<ahelp hid=\".\" visibility=\"hidden\"\>No trend line is shown.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id5716727				0	hr	\<ahelp hid=\".\" visibility=\"hidden\"\>A linear trend line is shown.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id5840021				0	hr	\<ahelp hid=\".\" visibility=\"hidden\"\>A logarithmic trend line is shown.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id9417096				0	hr	\<ahelp hid=\".\" visibility=\"hidden\"\>An exponential trend line is shown.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id8482924				0	hr	\<ahelp hid=\".\" visibility=\"hidden\"\>A power trend line is shown.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id8962370				0	hr	\<ahelp hid=\".\" visibility=\"hidden\"\>Shows the trend line equation next to the trend line.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id6889858				0	hr	\<ahelp hid=\".\" visibility=\"hidden\"\>Shows the coefficient of determination next to the trend line.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id8398998				0	hr	If you insert a trend line to a chart type that uses categories, like \<emph\>Line \</emph\>or \<emph\>Column, \</emph\>then the numbers 1, 2, 3, \<emph\>…\</emph\> are used as x-values to calculate the trend line.				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id5676747				0	hr	To insert trend lines for all data series, double-click the chart to enter edit mode. Choose \<item type=\"menuitem\"\>Insert - Trend Lines\</item\>, then select the type of trend line from None, Linear, Logarithmic, Exponential, or Power trend line.				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id4349192				0	hr	To insert a trend line for a single data series, select the data series in the chart, right-click to open the context menu, and choose \<item type=\"menuitem\"\>Insert - Trend Line\</item\>.				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id9337443				0	hr	To delete a single trend line or mean value line, click the line, then press the Del key.				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id4529251				0	hr	To delete all trend lines, choose \<item type=\"menuitem\"\>Insert - Trend Lines\</item\>, then select \<emph\>None\</emph\>.				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id296334				0	hr	A trend line is shown in the legend automatically.				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id4072084				0	hr	\<ahelp hid=\".\"\>Mean Value Lines are special trend lines that show the mean value. Use \<item type=\"menuitem\"\>Insert - Mean Value Lines\</item\> to insert mean value lines for data series.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id9569689				0	hr	The trend line has the same color as the corresponding data series. To change the line properties, select the trend line and choose \<item type=\"menuitem\"\>Format - Format Selection - Line\</item\>.				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id846888				0	hr	\<ahelp hid=\".\"\>To show the trend line equation, select the trend line in the chart, right-click to open the context menu, and choose \<emph\>Insert Trend Line Equation\</emph\>.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id8962065				0	hr	When the chart is in edit mode, %PRODUCTNAME gives you the equation of the trend line and the coefficient of determination R². Click on the trend line to see the information in the status bar.				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id1328470				0	hr	For a category chart (for example a line chart), the trend line information is calculated using numbers 1, 2, 3, … as x-values. This is also true if your data series uses other numbers as names for the x-values. For such charts the XY chart type might be more suitable.				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id8092593				0	hr	To show the equation and the coefficient of determination, select the trend line and choose \<item type=\"menuitem\"\>Format - Format Selection - Equation\</item\>.				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id7971434				0	hr	\<ahelp hid=\".\" visibility=\"hidden\"\>Enable Show equation to see the equation of the trend line.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id558793				0	hr	\<ahelp hid=\".\" visibility=\"hidden\"\>Enable Show Coefficient of Determination to see the determination coefficient of the trend line.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id7735221				0	hr	You can also calculate the parameters using Calc functions as follows.				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	hd_id5744193				0	hr	The linear regression equation				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id9251991				0	hr	The \<emph\>linear regression\</emph\> follows the equation \<item type=\"literal\"\>y=m*x+b\</item\>.				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id7951902				0	hr	m = SLOPE(Data_Y;Data_X) 				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id6637165				0	hr	b = INTERCEPT(Data_Y ;Data_X) 				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id7879268				0	hr	Calculate the coefficient of determination by				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id9244361				0	hr	r² = RSQ(Data_Y;Data_X) 				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id2083498				0	hr	Besides m, b and r² the array function \<emph\>LINEST\</emph\> provides additional statistics for a regression analysis.				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	hd_id2538834				0	hr	The logarithm regression equation				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id394299				0	hr	The \<emph\>logarithm regression\</emph\> follows the equation \<item type=\"literal\"\>y=a*ln(x)+b\</item\>.				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id2134159				0	hr	a = SLOPE(Data_Y;LN(Data_X)) 				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id5946531				0	hr	b = INTERCEPT(Data_Y ;LN(Data_X)) 				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id5649281				0	hr	r² = RSQ(Data_Y;LN(Data_X)) 				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	hd_id7874080				0	hr	The exponential regression equation				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id4679097				0	hr	 For exponential trend lines a transformation to a linear model takes place. The optimal curve fitting is related to the linear model and the results are interpreted accordingly. 				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id9112216				0	hr	The exponential regression follows the equation \<item type=\"literal\"\>y=b*exp(a*x)\</item\> or \<item type=\"literal\"\>y=b*m^x\</item\>, which is transformed to \<item type=\"literal\"\>ln(y)=ln(b)+a*x\</item\> or \<item type=\"literal\"\>ln(y)=ln(b)+ln(m)*x\</item\> respectively.				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id4416638				0	hr	a = SLOPE(LN(Data_Y);Data_X) 				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id1039155				0	hr	The variables for the second variation are calculated as follows:				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id7184057				0	hr	m = EXP(SLOPE(LN(Data_Y);Data_X)) 				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id786767				0	hr	b = EXP(INTERCEPT(LN(Data_Y);Data_X)) 				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id7127292				0	hr	Calculate the coefficient of determination by				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id5437177				0	hr	r² = RSQ(LN(Data_Y);Data_X) 				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id6946317				0	hr	Besides m, b and r² the array function LOGEST provides additional statistics for a regression analysis.				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	hd_id6349375				0	hr	The power regression equation				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id1857661				0	hr	 For \<emph\>power regression\</emph\> curves a transformation to a linear model takes place. The power regression follows the equation \<item type=\"literal\"\>y=b*x^a\</item\> , which is transformed to \<item type=\"literal\"\>ln(y)=ln(b)+a*ln(x)\</item\>.				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id8517105				0	hr	a = SLOPE(LN(Data_Y);LN(Data_X)) 				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id9827265				0	hr	b = EXP(INTERCEPT(LN(Data_Y);LN(Data_X)) 				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id2357249				0	hr	r² = RSQ(LN(Data_Y);LN(Data_X)) 				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	hd_id9204077				0	hr	Constraints				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id7393719				0	hr	 The calculation of the trend line considers only data pairs with the following values:				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id7212744				0	hr	logarithm regression: only positive x-values are considered,				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id1664479				0	hr	exponential regression: only positive y-values are considered,				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id8734702				0	hr	power regression: only positive x-values and positive y-values are considered.				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id181279				0	hr	You should transform your data accordingly; it is best to work on a copy of the original data and transform the copied data.				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	hd_id7907040				0	hr	The polynomial regression equation				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id8918729				0	hr	A \<emph\>polynomial regression\</emph\> curve cannot be added automatically. You must calculate this curve manually. 				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id33875				0	hr	Create a table with the columns x, x², x³, … , xⁿ, y up to the desired degree n. 				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id8720053				0	hr	Use the formula \<item type=\"literal\"\>=LINEST(Data_Y,Data_X)\</item\> with the complete range x to xⁿ (without headings) as Data_X. 				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id5068514				0	hr	The first row of the LINEST output contains the coefficients of the regression polynomial, with the coefficient of xⁿ at the leftmost position.				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id8202154				0	hr	The first element of the third row of the LINEST output is the value of r². See the \<link href=\"text/scalc/01/04060107.xhp#Section8\"\>LINEST\</link\> function for details on proper use and an explanation of the other output parameters.				20181231 09:50:43
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id4562211				0	hr	\<link href=\"text/schart/01/04050000.xhp\"\>Y Error Bars tab page\</link\>				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	tit				0	hr	Skaliranje				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	bm_id3150868				0	hr	\<bookmark_value\>scaling; axes\</bookmark_value\>\<bookmark_value\>logarithmic scaling along axes\</bookmark_value\>\<bookmark_value\>charts;scaling axes\</bookmark_value\>\<bookmark_value\>X axes;scaling\</bookmark_value\>\<bookmark_value\>Y axes; scaling\</bookmark_value\>\<bookmark_value\>axes;interval marks\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	hd_id3150868				0	hr	\<link href=\"text/schart/01/05040201.xhp\" name=\"Scaling\"\>Scaling\</link\>				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id3154013				0	hr	Controls the scaling of the Y axis. The X axis can also be scaled here for X-Y charts.				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id3148576				0	hr	The Y axis is automatically scaled by $[officename] so that all values are optimally displayed.				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id3149379				0	hr	To achieve specific results, you can manually change the axis scaling. For example, you can display only the top areas of the columns by shifting the zero line upwards.				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	hd_id3154730				0	hr	Skaliranje osi				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id3149400				0	hr	You can enter values for subdividing axes in this area. You can automatically set the five properties \<emph\>Minimum, Maximum, Major interval, Minor interval\</emph\> and \<emph\>Axis at\</emph\>.				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	hd_id3150751				0	hr	Minimum				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id3153713				0	hr	\<ahelp hid=\"SCH_SPINFIELD_TP_SCALE_Y_EDT_MIN\"\>Defines the minimum value for the beginning of the Y axis.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	hd_id3156385				0	hr	Maksimum				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id3159266				0	hr	\<ahelp hid=\"SCH_SPINFIELD_TP_SCALE_Y_EDT_MAX\"\>Defines the maximum value for the end of the Y axis.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	hd_id3155336				0	hr	Veći interval				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id3143218				0	hr	\<ahelp hid=\"SCH_SPINFIELD_TP_SCALE_Y_EDT_STEP_MAIN\"\>Defines the interval for the main division of the axes.\</ahelp\> The main interval cannot be larger than the value area.				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	hd_id3154020				0	hr	Manji interval				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id3154656				0	hr	\<ahelp hid=\"SCH_SPINFIELD_TP_SCALE_Y_EDT_STEP_HELP\"\>Defines the interval for the subdivision of the axes.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	hd_id3150089				0	hr	Axis at:				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id3152990				0	hr	\<ahelp hid=\"SCH_SPINFIELD_TP_SCALE_Y_EDT_ORIGIN\"\>Specifies at which position to display the values along the y axis.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	hd_id3166432				0	hr	Automatski				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id3145389				0	hr	\<ahelp hid=\"SCH:CHECKBOX:TP_SCALE_Y:CBX_AUTO_ORIGIN\"\>You must first deselect the \<emph\>Automatic\</emph\> option in order to modify the values.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id3149129				0	hr	Disable this feature if you are working with "fixed" values, as it does not permit automatic scaling.				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	hd_id3159206				0	hr	Logaritamska skala				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id3145360				0	hr	\<ahelp hid=\"SCH:CHECKBOX:TP_SCALE_Y:CBX_LOGARITHM\"\>Specifies that you want the y axis to be subdivided logarithmically.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id3153956				0	hr	Use this feature if you are working with values that differ sharply from each other. You can use logarithmic scaling to make the grid lines of the axis equidistant but have values that may increase or decrease.				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	hd_id9941404				0	hr	Reverse direction				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id5581835				0	hr	\<ahelp hid=\".\"\>Defines where the lower and where the higher values are displayed at the axis. The unchecked state is the mathematical direction.\</ahelp\> That means for Cartesian coordinate systems that the x-axis shows the lower values on the left and the y-axis shows the lower values at the bottom. For polar coordinate systems the mathematical angle axis direction is counterclockwise and the radial axis is from inner to outer.				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	hd_id922204				0	hr	Type				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id59225				0	hr	\<ahelp hid=\".\"\>For some types of axes, you can select to format an axis as text or date, or to detect the type automatically.\</ahelp\> For the axis type "Date" you can set the following options.				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id1159225				0	hr	Minimum and maximum value to be shown on the ends of the scale.				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id2259225				0	hr	\<ahelp hid=\".\"\>Resolution can be set to show days, months, or years as interval steps.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id3359225				0	hr	\<ahelp hid=\".\"\>Major interval can be set to show a certain number of days, months, or years.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id4459225				0	hr	\<ahelp hid=\".\"\>Minor interval can be set to show a certain number of days, months, or years.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\schart\01\type_stock.xhp	0	help	tit				0	hr	Chart Type Stock				20181231 09:50:43
