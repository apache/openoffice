helpcontent2	source\text\sbasic\shared\03090410.xhp	0	help	par_id3149579				0	hr	sGender = GetGenderIndex( "John" )				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03090410.xhp	0	help	par_id3153626				0	hr	MsgBox sGender				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03090410.xhp	0	help	par_id3147560				0	hr	End Sub				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03090410.xhp	0	help	par_id3154758				0	hr	Function GetGenderIndex (sName As String) As String				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03090410.xhp	0	help	par_id3153361				0	hr	GetGenderIndex = Switch(sName = "Jane", "female", sName = "John", "male")				20181231 09:50:43
