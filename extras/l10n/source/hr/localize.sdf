helpcontent2	source\text\schart\01\wiz_chart_elements.xhp	0	help	par_id6437269				0	hr	\<ahelp hid=\".\" visibility=\"hidden\"\>Enter a title for your chart.\</ahelp\>				20181231 09:50:43
