helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3153955				0	hr	PTR_DOUBLE =0 pointer to a double				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3159262				0	hr	PTR_STRING =1 pointer to a zero-terminated string				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3148747				0	hr	PTR_DOUBLE_ARR =2 pointer to a double array				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3147406				0	hr	PTR_STRING_ARR =3 pointer to a string array				20181231 09:50:43
