helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3150244				0	hr	\<ahelp hid=\"SVTOOLS_RADIOBUTTON_DLG_SVT_PRNDLG_PRINTDLG_RBT_SELECTION\"\>Prints only the selected area(s) or object(s) in the current document.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3146848				0	hr	\<ahelp hid=\"SVTOOLS_EDIT_DLG_SVT_PRNDLG_PRINTDLG_EDT_PAGES\"\>To print a range of pages, use the format 3-6. To print single pages, use the format 7;9;11. If you want, you can print a combination of page ranges and single pages, by using the format 3-6;8;10;12. \</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3150772				0	hr	\<ahelp hid=\"SVTOOLS_CHECKBOX_DLG_SVT_PRNDLG_PRINTDLG_CBX_FILEPRINT\"\>Prints to a file instead of to a printer. Select this box, and then choose a location to save the file.\</ahelp\>				20181231 09:50:43
