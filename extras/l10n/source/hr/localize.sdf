helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165883				0	hr	2				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165906				0	hr	COUNT				20181231 09:50:43
