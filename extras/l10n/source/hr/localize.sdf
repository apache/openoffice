helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143366				0	hr	7				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143389				0	hr	STDEV				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143416				0	hr	8				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143439				0	hr	STDEVP				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143466				0	hr	9				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143489				0	hr	SUM				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143516				0	hr	10				20181231 09:50:43
