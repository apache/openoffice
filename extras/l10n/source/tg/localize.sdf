helpcontent2	source\text\shared\01\06010000.xhp	0	help	par_id3144446				0	tg	\<ahelp hid=\"SVX:PUSHBUTTON:RID_SVXDLG_SPELLCHECK:BTN_CHANGEALL\"\>Replaces all occurrences of the unknown word with the current suggestion.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06010000.xhp	0	help	par_id3145318				0	tg	\<ahelp hid=\"SVX:PUSHBUTTON:RID_SVXDLG_SPELLCHECK:BTN_IGNOREALL\"\>Skips all occurrences of the unknown word in the entire document and continues with the spellcheck.\</ahelp\>				2002-02-02 02:02:02
