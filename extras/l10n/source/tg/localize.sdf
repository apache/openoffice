helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3146060				0	tg	\<ahelp hid=\".uno:HangulHanjaConversion\"\>Converts the selected Korean text from Hangul to Hanja or from Hanja to Hangul.\</ahelp\> The menu command can only be called if you enable Asian language support under \<emph\>Tools - Options - Language Settings - Languages\</emph\>, and if a text formatted in Korean language is selected.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3148403				0	tg	\<ahelp hid=\"HID_HANGULDLG_BUTTON_CHANGE\"\>Replaces the selection with the suggested characters or word according to the format options.\</ahelp\> The next word or character will be selected for conversion.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3148520				0	tg	\<ahelp hid=\"HID_SPELLDLG_SETWORD\"\>Displays the current selection.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3149192				0	tg	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVX_MDLG_HANGULHANJA_RB_HANGUL_HANJA_BRACKETED\"\>The Hanja part will be displayed in brackets after the Hangul part.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3149205				0	tg	\<ahelp hid=\"HID_HANGULDLG_EDIT_NEWWORD\"\>Displays the first replacement suggestion from the dictionary.\</ahelp\> You can edit the suggested word or enter another word. Click the \<emph\>Find\</emph\> button to replace your original word with the corresponding replacement word.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3150771				0	tg	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVX_MDLG_HANGULHANJA_RB_HANJA_HANGUL_ABOVE\"\>The Hangul part will be displayed as ruby text above the Hanja part.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3150775				0	tg	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVX_MDLG_HANGULHANJA_RB_SIMPLE_CONVERSION\"\>The original characters are replaced by the suggested characters.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3153338				0	tg	\<ahelp hid=\"HID_HANGULDLG_BUTTON_CHANGEALL\"\>Replaces the selection with the suggested characters or word according to the format options. Every time the same selection is detected it will be replaced automatically.\</ahelp\> The next word or character will be selected for conversion. The list of replacement text is valid for the current $[officename] session.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3153662				0	tg	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVX_MDLG_HANGULHANJA_RB_HANJA_HANGUL_BRACKETED\"\>The Hangul part will be displayed in brackets after the Hanja part.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3153896				0	tg	\<ahelp hid=\"HID_HANGULDLG_BUTTON_IGNORE\"\>No changes will be made to the current selection. The next word or character will be selected for conversion.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3154142				0	tg	\<ahelp hid=\"SVX_CHECKBOX_RID_SVX_MDLG_HANGULHANJA_CB_HANGUL_ONLY\"\>Check to convert only Hangul. Do not convert Hanja.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3154173				0	tg	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVX_MDLG_HANGULHANJA_RB_HANGUL_HANJA_ABOVE\"\>The Hanja part will be displayed as ruby text above the Hangul part.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3154823				0	tg	\<ahelp hid=\"SVX_LISTBOX_RID_SVX_MDLG_HANGULHANJA_LB_SUGGESTIONS\"\>Displays all available replacements in the dictionary.\</ahelp\> If the \<emph\>Replace by character\</emph\> box is enabled, you see a grid of characters. If the \<emph\>Replace by character\</emph\> box is not checked, you see a list of words.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3154937				0	tg	\<ahelp hid=\"HID_HANGULDLG_BUTTON_IGNOREALL\"\>No changes will be made to the current selection, and every time the same selection is detected it will be skipped automatically.\</ahelp\> The next word or character will be selected for conversion. The list of ignored text is valid for the current $[officename] session.				2002-02-02 02:02:02
