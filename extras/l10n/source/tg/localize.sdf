helpcontent2	source\text\swriter\01\03080000.xhp	0	help	par_id3147513				0	tg	\<ahelp hid=\".uno:Marks\"\>Shows or hides field shadings in your document, including non-breaking spaces, custom hyphens, indexes, and footnotes.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\03080000.xhp	0	help	par_id3153540				0	tg	\<link href=\"text/swriter/01/03100000.xhp\" name=\"Nonprinting Characters On/Off\"\>Nonprinting Characters On/Off\</link\>				2002-02-02 02:02:02
