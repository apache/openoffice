helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3155114				0	tg	\<ahelp hid=\"SC:EDIT:RID_SCDLG_CONDFORMAT:EDT_COND3_2\" visibility=\"hidden\"\>Ҳавола, арзиш ё формуларо дохил кунед.\</ahelp\> Ҳавола, арзиш ё формуларо дохил кунед дар майдони параметр ё ду параметро дохил кунед агар ҳарду шартро интихоб карда бошед. 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3155602				0	tg	\<ahelp hid=\"SC:LISTBOX:RID_SCDLG_CONDFORMAT:LB_COND3_1\"\>Муайян месозад, ки форматкунии шарти аз арзиш ё формулаи чашмак вобаста аст.\</ahelp\> Агар формуларо ҳамчун ҳавола интихоб кунед,  майдони \<emph\>Шарти арзиши чашмак\</emph\> дар рости майдони \<emph\>Арзиши чашмак/Формула\</emph\> пайдо мешавад. Агар шарт "Формула аст", ҳаволаи чашмакро дохил кунед. Агар арзиши чашмак ғайр аз сифр бошад, шарт иҷро мешавад.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3163710				0	tg	\<variable id=\"bedingtetext\"\>\<ahelp hid=\".uno:ConditionalFormatDialog\"\> \<emph\>Форматноккунии шартӣ\</emph\> интихоб кунед, агар формат аз критерия вобаста бошад.\</ahelp\>\</variable\> Агар чашмак формат карда шуда бошад, он тағир намеёбад. Метавонед 3 шатро дохил кунед, ки арзиш ё формулаи чашмакро месанҷанд. Агар шарти 1 қонеъ карда шавад, сабки муайянкардашуда истифода мешавад. Вагарна шарти2юм санҷида мешавад, агар қонеъ шавад сабки он истифода мешавад. Агар иш шарт қонеъ нашавад шарти 3юм дида мешавад.				2002-02-02 02:02:02
