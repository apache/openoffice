helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3153417	37			0	tg	\<variable id=\"kategorienliste\"\>\<ahelp hid=\"SC:LISTBOX:RID_SCTAB_FUNCTION:LB_CATEGORY\"\>Категорияҳоро нишон медиҳад, ки ба онҳо функтсияҳои алоҳида вобаста карда шудаанд. Категорияро интихоб карда функтсияҳояшро мебинед.\</ahelp\> "Ҳама"ро интихоб кунед барои дидани ҳама функтсияҳо новобаста аз категория. "Охирон бор истифода шудааст" функтсияҳое, ки ба назикӣ истифода бурдаед нишон медиҳад.\</variable\>				2002-02-02 02:02:02
