helpcontent2	source\text\swriter\01\01160300.xhp	0	help	par_id3149286	2			0	tg	\<variable id=\"autoabstracttext\"\>\<ahelp hid=\".uno:CreateAbstract\"\>Сарлавҳаҳо ва рақами параграфи ояндаи ҳуҷҷати фаъолро ба ҳуҷҷати матнии АвтоРеферат нусхабардорӣ мекунад. Автоабстракт баро дидани фишурдаи умумии ҳуҷҷатҳои дароз муфид аст.\</ahelp\> Шумо метавонед шумораи дараҷаҳои сарҳадро ҳамчун шумораи параграфҳои дар ин ҳангом баровардашуда нишон диҳед. Ҳамаи дараҷаҳо дар зери ҷӯрҳои мувофиқ пинҳон карда шудаанд. \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\01160300.xhp	0	help	par_id3149804				0	tg	\<ahelp hid=\"SW:NUMERICFIELD:DLG_INSERT_ABSTRACT:NF_LEVEL\"\>Enter the extent of the outline levels to be copied to the new document.\</ahelp\> For example, if you choose 4 levels, all paragraphs formatted with Heading 1 to Heading 4 are included, along with the number of subsequent paragraphs specified in \<emph\>Subpoints per Level\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\01160300.xhp	0	help	par_id3155892				0	tg	\<ahelp hid=\"SW:NUMERICFIELD:DLG_INSERT_ABSTRACT:NF_PARA\"\>Шумораи ҳадди аксари параграфҳои пайдарпаеро, ки бояд пас аз ҳар сарлавҳа ба Автоабстракт дохил шаванд нишон диҳед.\</ahelp\> Ҳамаи параграфҳо, то шумораи ҳадди аксари муайяншуда дохил карда мешаванд, то он даме ки параграфи навбати бо Услуби Сарлавҳа набарояд.				2002-02-02 02:02:02
