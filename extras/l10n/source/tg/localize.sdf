helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3149346				0	tg	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_GRFCROP_RB_ZOOMCONST\"\>Maintains the original scale of the graphic when you crop, so that only the size of the graphic changes.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3150084				0	tg	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_BOTTOM\"\>If the \<emph\>Keep Scale\</emph\> option is selected, enter a positive amount to trim the bottom of the graphic, or a negative amount to add white space below the graphic. If the \<emph\>Keep image size\</emph\> option is selected, enter a positive amount to increase the vertical scale of the graphic, or a negative amount to decrease the vertical scale of the graphic.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3150543				0	tg	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_WIDTH\"\>Enter a width for the selected graphic.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3150603				0	tg	\<ahelp hid=\".\"\>Trims or scales the selected graphic. You can also restore the graphic to its original size.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3152372				0	tg	Use this area to trim or scale the selected graphic, or to add white space around the graphic.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3153257				0	tg	Changes the scale of the selected graphic.				2002-02-02 02:02:02
