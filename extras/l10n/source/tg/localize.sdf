helpcontent2	source\text\shared\guide\dragdrop_table.xhp	0	help	par_id3152780	32			0	tg	\<switchinline select=\"sys\"\>\<caseinline select=\"WIN\"\>Агар ҳуҷҷатҳо дар шафати якдигар намоён набошанд, аввал мушро ба болои тугмачаи ҳуҷҷати интиҳоӣ баред. Пои мушро сар надиҳед. Ҳуҷҷат нишон дода мешавад ва шумо мушро ба ҳуҷҷат бурда метавонед. \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
