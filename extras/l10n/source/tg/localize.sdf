helpcontent2	source\text\shared\optionen\01020200.xhp	0	help	par_id3154758				0	tg	\<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXPAGE_INET_SEARCH:RB_EXACT\"\>Тарзи ҷустуҷӯ (ва, ё, дақиқ) ва тарзи намоиши натиҷаро ҷӯр месозад.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01020200.xhp	0	help	par_id3154918				0	tg	\<ahelp hid=\"SVX:LISTBOX:RID_SVXPAGE_INET_SEARCH:ED_CASE\"\>Ба инобатгирии ҳарфҳои хурду калонро муайян месозад.\</ahelp\> Рӯйхат навиштҳои зерро дорад: \<emph\>Ҳеҷ\</emph\>, \<emph\>Ҳарфи калон\</emph\> ва \<emph\>Ҳарфи хурд\</emph\>. Истилоҳоти ҷустуҷӯ мувофиқ ба ин интихоб табдил дода мешаванд.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01020200.xhp	0	help	par_id3155449	12			0	tg	\<ahelp hid=\"SVX:EDIT:RID_SVXPAGE_INET_SEARCH:ED_SEARCH_NAME\"\>Номи мошини ҷустуҷӯии интихобшударо нишон медиҳад.\</ahelp\> Ин ном дар зерменюи тасвири \<emph\>Ҷустуҷӯ\</emph\> дар лавҳаи Ҳавола нишон дода мешавад. 				2002-02-02 02:02:02
