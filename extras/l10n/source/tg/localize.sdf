helpcontent2	source\text\shared\autopi\01100200.xhp	0	help	par_id3155892				0	tg	\<ahelp hid=\"HID_DLGREPORT_2_PREGROUPINGDEST\"\>Майдонҳое, ки бо онҳо ҳисобот гурӯҳбандӣ мешавад, нишон медиҳад. Барои кӯркунии як дараҷаи гурӯҳбандӣ тугмачаро\<emph\><\</emph\> пахш кунед. Шумо метавонед то чор гурӯҳбандиро интихоб кунед.\</ahelp\>				2002-02-02 02:02:02
