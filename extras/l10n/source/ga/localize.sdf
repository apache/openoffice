helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	hd_id3150991				0	ga	\<variable id=\"eomonth\"\>\<link href=\"text/scalc/01/func_eomonth.xhp\"\>EOMONTH\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3152766	232			0	ga	\<ahelp hid=\"HID_AAI_FUNC_EOMONTH\"\>Returns the date of the last day of a month which falls m\<emph\>onths\</emph\> away from the s\<emph\>tart date\</emph\>.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	hd_id3150597				0	ga	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3150351				0	ga	EOMONTH(StartDate; Months)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3146787				0	ga	\<emph\>StartDate\</emph\> is a date (the starting point of the calculation).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3155615				0	ga	\<emph\>Months\</emph\> is the number of months before (negative) or after (positive) the start date.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	hd_id3156335				0	ga	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3154829				0	ga	What is the last day of the month that falls 6 months after September 14 2001?				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3156143				0	ga	\<item type=\"input\"\>=EOMONTH(DATE(2001;9;14);6)\</item\> returns the serial number 37346. Formatted as a date, this is 2002-03-31.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3156144				0	ga	\<item type=\"input\"\>=EOMONTH("2001-09-14";6)\</item\> works as well. If the date is given as string, it has to be in ISO format.				2002-02-02 02:02:02
