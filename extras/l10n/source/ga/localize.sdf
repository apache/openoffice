helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN105E0				0	ga	\<ahelp hid=\".\"\>Select this box to copy your user name and other data from a previous installation to your new installation of %PRODUCTNAME.\</ahelp\>				2002-02-02 02:02:02
