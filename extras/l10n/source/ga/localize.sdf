helpcontent2	source\text\sdraw\guide\combine_etc.xhp	0	help	par_id3145829	91			0	ga	 \<emph\>Merge\</emph\> 				2002-02-02 02:02:02
helpcontent2	source\text\sdraw\guide\combine_etc.xhp	0	help	par_id3154680	92			0	ga	 \<emph\>Subtract\</emph\> 				2002-02-02 02:02:02
helpcontent2	source\text\sdraw\guide\combine_etc.xhp	0	help	par_id3153034				0	ga	 \<emph\>Intersect\</emph\>.				2002-02-02 02:02:02
