helpcontent2	source\text\scalc\01\12100000.xhp	0	help	tit				0	ga	Refresh Range				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12100000.xhp	0	help	bm_id3153662				0	ga	\<bookmark_value\>database ranges; refreshing\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12100000.xhp	0	help	hd_id3153662				0	ga	\<link href=\"text/scalc/01/12100000.xhp\" name=\"Refresh Range\"\>Refresh Range\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12100000.xhp	0	help	par_id3153088				0	ga	\<variable id=\"aktualisieren\"\>\<ahelp hid=\".uno:DataAreaRefresh\" visibility=\"visible\"\>Updates a data range that was inserted from an external database. The data in the sheet is updated to match the data in the external database.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	tit				0	ga	WEEKNUM				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	bm_id3159161				0	ga	\<bookmark_value\>WEEKNUM function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	hd_id3159161				0	ga	\<variable id=\"weeknum\"\>\<link href=\"text/scalc/01/func_weeknum.xhp\"\>WEEKNUM\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3149770				0	ga	\<ahelp hid=\"HID_FUNC_KALENDERWOCHE\"\>WEEKNUM calculates the week number of the year for the internal date value.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_idN105E4				0	ga	The International Standard ISO 8601 has decreed that Monday shall be the first day of the week. A week that lies partly in one year and partly in another is assigned a number in the year in which most of its days lie. That means that week number 1 of any year is the week that contains the January 4th.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	hd_id3153055				0	ga	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3147236				0	ga	WEEKNUM(Number; Mode)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3147511				0	ga	\<emph\>Number\</emph\> is the internal date number.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3154269				0	ga	\<emph\>Mode\</emph\> sets the start of the week and the calculation type.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3148930				0	ga	1 = Sunday				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3154280				0	ga	2 = Monday				2002-02-02 02:02:02
