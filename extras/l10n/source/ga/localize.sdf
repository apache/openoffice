helpcontent2	source\text\scalc\01\func_second.xhp	0	help	hd_id3159390				0	ga	\<variable id=\"second\"\>\<link href=\"text/scalc/01/func_second.xhp\"\>SECOND\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_second.xhp	0	help	par_id3148974				0	ga	\<ahelp hid=\"HID_FUNC_SEKUNDE\"\>Returns the second for the given time value.\</ahelp\> The second is given as an integer between 0 and 59.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_second.xhp	0	help	hd_id3154362				0	ga	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_second.xhp	0	help	par_id3148407				0	ga	SECOND(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_second.xhp	0	help	par_id3155904				0	ga	\<emph\>Number\</emph\>, as a time value, is a decimal, for which the second is to be returned.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_second.xhp	0	help	hd_id3149992				0	ga	Examples				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_second.xhp	0	help	par_id3153350				0	ga	\<item type=\"input\"\>=SECOND(NOW())\</item\> returns the current second				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_second.xhp	0	help	par_id3150831				0	ga	\<item type=\"input\"\>=SECOND(C4)\</item\> returns 17 if contents of C4 = \<item type=\"input\"\>12:20:17\</item\>.				2002-02-02 02:02:02
