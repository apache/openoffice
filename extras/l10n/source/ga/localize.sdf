helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3159219				0	ga	Title				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3156435				0	ga	user_position				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3145178				0	ga	Position				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3150797				0	ga	user_tel_work				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3150820				0	ga	Business telephone number				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3150894				0	ga	user_tel_home				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3155320				0	ga	Home telephone number				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3154400				0	ga	user_fax				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3153363				0	ga	Uimhir fhacs				2002-02-02 02:02:02
