helpcontent2	source\text\scalc\01\04070300.xhp	0	help	par_id3153969				0	ga	\<variable id=\"namenuebernehmentext\"\>\<ahelp hid=\".uno:CreateNames\"\>Allows you to automatically name multiple cell ranges.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070300.xhp	0	help	par_id3156280				0	ga	Select the area containing all the ranges that you want to name. Then choose \<emph\>Insert - Names - Create\</emph\>. This opens the \<emph\>Create Names\</emph\> dialog, from which you can select the naming options that you want.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070300.xhp	0	help	hd_id3151116				0	ga	Cruthaigh ainmneacha ó				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070300.xhp	0	help	par_id3152597				0	ga	Defines which part of the spreadsheet is to be used for creating the name.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070300.xhp	0	help	hd_id3153729				0	ga	Top row				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070300.xhp	0	help	par_id3149263				0	ga	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_NAMES_CREATE:BTN_TOP\"\>Creates the range names from the header row of the selected range.\</ahelp\> Each column receives a separated name and cell reference.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070300.xhp	0	help	hd_id3146984				0	ga	Left Column				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070300.xhp	0	help	par_id3153190				0	ga	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_NAMES_CREATE:BTN_LEFT\"\>Creates the range names from the entries in the first column of the selected sheet range.\</ahelp\> Each row receives a separated name and cell reference.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070300.xhp	0	help	hd_id3156284				0	ga	Bottom row				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070300.xhp	0	help	par_id3147124				0	ga	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_NAMES_CREATE:BTN_BOTTOM\"\>Creates the range names from the entries in the last row of the selected sheet range.\</ahelp\> Each column receives a separated name and cell reference.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070300.xhp	0	help	hd_id3154731				0	ga	Right Column				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070300.xhp	0	help	par_id3153158				0	ga	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_NAMES_CREATE:BTN_RIGHT\"\>Creates the range names from the entries in the last column of the selected sheet range.\</ahelp\> Each row receives a separated name and cell reference.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	tit				0	ga	Treoraí Feidhme				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	bm_id3147426				0	ga	\<bookmark_value\>inserting functions; Function Wizard\</bookmark_value\>\<bookmark_value\>functions;Function Wizard\</bookmark_value\>\<bookmark_value\>wizards; functions\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3147426				0	ga	\<link href=\"text/scalc/01/04060000.xhp\" name=\"AutoPilot: Functions\"\>Function Wizard\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3145271				0	ga	\<variable id=\"funktionsautopilottext\"\>\<ahelp hid=\".uno:FunctionDialog\"\>Opens the \<emph\>Function Wizard\</emph\>, which helps you to interactively create formulas.\</ahelp\>\</variable\> Before you start the Wizard, select a cell or a range of cells from the current sheet, in order to determine the position at which the formula will be inserted.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id8007446				0	ga	You can download the complete ODFF (OpenDocument Format Formula) specification from the \<link href=\"http://www.oasis-open.org/committees/documents.php?wg_abbrev=office-formula\"\>OASIS\</link\> web site.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3159153				0	ga	The \<emph\>Function Wizard\</emph\> has two tabs: \<emph\>Functions\</emph\> is used to create formulas, and \<emph\>Structure\</emph\> is used to check the formula build.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3154490				0	ga	Functions Tab				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3149378				0	ga	\<link href=\"text/scalc/01/04060100.xhp\" name=\"List of Categories and Functions\"\>List of Categories and Functions\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3154730				0	ga	Catagóir				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3153417	37			0	ga	\<variable id=\"kategorienliste\"\>\<ahelp hid=\"SC:LISTBOX:RID_SCTAB_FUNCTION:LB_CATEGORY\"\>Lists all the categories to which the different functions are assigned. Select a category to view the appropriate functions in the list field below.\</ahelp\> Select "All" to view all functions in alphabetical order, irrespective of category. "Last Used" lists the functions you have most recently used. \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3150749				0	ga	Function				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3155445				0	ga	\<ahelp hid=\"SC:LISTBOX:RID_SCTAB_FUNCTION:LB_FUNCTION\"\>Displays the functions found under the selected category. Double-click to select a function.\</ahelp\> A single-click displays a short function description.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3159264				0	ga	Eagar				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3149566	9			0	ga	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_FORMULA:BTN_MATRIX\"\>Specifies that the selected function is inserted into the selected cell range as an array formula. \</ahelp\> Array formulas operate on multiple cells. Each cell in the array contains the formula, not as a copy but as a common formula shared by all matrix cells.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3155959				0	ga	The \<emph\>Array\</emph\> option is identical to the \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+Shift+Enter command, which is used to enter and confirm formulas in the sheet. The formula is inserted as a matrix formula indicated by two braces { }.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3152993				0	ga	The maximum size of an array range is 128 by 128 cells.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3150367				0	ga	Argument Input Fields				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3145587				0	ga	When you double-click a function, the argument input field(s) appear on the right side of the dialog. To select a cell reference as an argument, click directly into the cell, or drag across the required range on the sheet while holding down the mouse button. You can also enter numerical and other values or references directly into the corresponding fields in the dialog. When using \<link href=\"text/scalc/01/04060102.xhp\" name=\"date entries\"\>date entries\</link\>, make sure you use the correct format. Click OK to insert the result into the spreadsheet.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3149408				0	ga	Function Result				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3155809				0	ga	As soon you enter arguments in the function, the result is calculated. This preview informs you if the calculation can be carried out with the arguments given. If the arguments result in an error, the corresponding \<link href=\"text/scalc/05/02140000.xhp\" name=\"error code\"\>error code\</link\> is displayed.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3148700				0	ga	The required arguments are indicated by names in bold print.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3153064				0	ga	f(x) (depending on the selected function)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3157980				0	ga	\<ahelp hid=\"HID_SC_FAP_BTN_FX4\"\>Allows you to access a subordinate level of the \<emph\>Function Wizard\</emph\> in order to nest another function within the function, instead of a value or reference.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3145076				0	ga	Argument/Parameter/Cell Reference (depending on the selected function)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3159097				0	ga	\<ahelp hid=\"SC:EDIT:RID_SCDLG_FORMULA:ED_REF\"\>The number of visible text fields depends on the function. Enter arguments either directly into the argument fields or by clicking a cell in the table.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3154957				0	ga	Result				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3150211				0	ga	Displays the calculation result or an error message.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3151304				0	ga	Foirmle				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3149898				0	ga	\<ahelp hid=\"HID_SC_FAP_FORMULA\"\>Displays the created formula. Type your entries directly, or create the formula using the wizard.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3153249				0	ga	Siar				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3152869				0	ga	\<ahelp hid=\"SC:PUSHBUTTON:RID_SCDLG_FORMULA:BTN_BACKWARD\"\>Moves the focus back through the formula components, marking them as it does so.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3146966				0	ga	To select a single function from a complex formula consisting of several functions, double-click the function in the formula window.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3155762				0	ga	Ar Aghaidh				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3149316	55			0	ga	\<ahelp hid=\"SC:PUSHBUTTON:RID_SCDLG_FORMULA:BTN_FORWARD\"\>Moves forward through the formula components in the formula window.\</ahelp\> This button can also be used to assign functions to the formula. If you select a function and click the \<emph\>Next \</emph\>button, the selection appears in the formula window.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3159262				0	ga	Double-click a function in the selection window to transfer it to the formula window.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3148745				0	ga	Cealaigh				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3147402				0	ga	Closes the dialog without implementing the formula.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3150534				0	ga	OK				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3153029				0	ga	Ends the \<emph\>Function Wizard\</emph\>, and transfers the formula to the selected cells.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3156400				0	ga	\<link href=\"text/scalc/01/04060100.xhp\" name=\"List of Categories and Functions\"\>List of Categories and Functions\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3147610				0	ga	Structure tab				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3153122				0	ga	On this page, you can view the structure of the function.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3149350				0	ga	If you start the \<emph\>Function Wizard\</emph\> while the cell cursor is positioned in a cell that already contains a function, the \<emph\>Structure\</emph\> tab is opened and shows the composition of the current formula.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3149014				0	ga	Structure				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3150481				0	ga	\<ahelp hid=\"HID_SC_FAP_STRUCT\"\>Displays a hierarchical representation of the current function.\</ahelp\> You can hide or show the arguments by a click on the plus or minus sign in front.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3148886				0	ga	Blue dots denote correctly entered arguments. Red dots indicate incorrect data types. For example: if the SUM function has one argument entered as text, this is highlighted in red as SUM only permits number entries.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	tit				0	ga	MONTH 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	bm_id3149936				0	ga	\<bookmark_value\>MONTH function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	hd_id3149936				0	ga	\<variable id=\"month\"\>\<link href=\"text/scalc/01/func_month.xhp\"\>MONTH\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	par_id3153538				0	ga	\<ahelp hid=\"HID_FUNC_MONAT\"\>Returns the month for the given date value.\</ahelp\> The month is returned as an integer between 1 and 12.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	hd_id3149517				0	ga	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	par_id3145602				0	ga	MONTH(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	par_id3149485				0	ga	\<emph\>Number\</emph\>, as a time value, is a decimal for which the month is to be returned.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	hd_id3153322				0	ga	Examples				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	par_id3149244				0	ga	=MONTH(NOW()) returns the current month.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	par_id3154790				0	ga	=MONTH(C4) returns 7 if you enter 2000-07-07 to cell C4 (that date value might get formatted differently after you press Enter).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140500.xhp	0	help	tit				0	ga	Fill Sheet				2002-02-02 02:02:02
