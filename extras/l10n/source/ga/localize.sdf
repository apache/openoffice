helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3146313				0	ga	Intermediate color				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3145230				0	ga	\<ahelp hid=\"SFX2_RADIOBUTTON_TP_COMMONPRINTOPTIONS_RB_REDUCEGRADIENTS_COLOR\"\>Specifies that gradients are only printed in a single intermediate color.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3147323				0	ga	Convert colors to grayscale				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3145150				0	ga	\<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_CONVERTTOGREYSCALES\"\>Specifies that all colors are printed only as grayscale.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3150646				0	ga	Rabhaidh phriontála				2002-02-02 02:02:02
