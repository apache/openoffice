helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153736	45			0	ga	                     \<item type=\"input\"\>10,000 currency units\</item\>                  				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150131	46			0	ga	                     \<item type=\"input\"\>5\</item\>                  				2002-02-02 02:02:02
