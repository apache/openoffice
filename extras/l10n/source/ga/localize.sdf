helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166440				0	ga	COSH(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150710				0	ga	Returns the hyperbolic cosine of \<emph\>Number\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153234				0	ga	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154099				0	ga	\<item type=\"input\"\>=COSH(0)\</item\> returns 1, the hyperbolic cosine of 0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152888				0	ga	\<bookmark_value\>COT function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152888				0	ga	COT				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153679				0	ga	\<ahelp hid=\"HID_FUNC_COT\"\>Returns the cotangent of the given angle (in radians).\</ahelp\>				2002-02-02 02:02:02
