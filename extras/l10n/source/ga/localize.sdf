helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3145114				0	ga	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150955				0	ga	DAYSINMONTH(Date)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3147501				0	ga	\<emph\>Date\</emph\> is any date in the respective month of the desired year. The Date parameter must be a valid date according to the locale settings of %PRODUCTNAME.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3149871				0	ga	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3155742				0	ga	=DAYSINMONTH(A1) returns 29 days if A1 contains 1968-02-17, a valid date for February 1968.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3149048				0	ga	\<bookmark_value\>WEEKS function\</bookmark_value\>\<bookmark_value\>number of weeks;between two dates\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3149048				0	ga	WEEKS				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153340				0	ga	\<ahelp hid=\"HID_DAI_FUNC_DIFFWEEKS\"\>Calculates the difference in weeks between two dates.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3150393				0	ga	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3147402				0	ga	WEEKS(StartDate; EndDate; Type)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3151387				0	ga	\<emph\>StartDate\</emph\> is the first date				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3146324				0	ga	\<emph\>EndDate\</emph\> is the second date				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3166467				0	ga	\<emph\>Type\</emph\> calculates the type of difference. The possible values are 0 (interval) and 1 (in numbers of weeks).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3145237				0	ga	\<bookmark_value\>WEEKSINYEAR function\</bookmark_value\>\<bookmark_value\>number of weeks;in a specific year\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3145237				0	ga	WEEKSINYEAR				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3147410				0	ga	\<ahelp hid=\"HID_DAI_FUNC_WEEKSINYEAR\"\>Calculates the number of weeks of the year in which the date entered occurs.\</ahelp\> The number of weeks is defined as follows: a week that spans two years is added to the year in which most days of that week occur.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3149719				0	ga	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3145638				0	ga	WEEKSINYEAR(Date)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3149946				0	ga	\<emph\>Date\</emph\> is any date in the respective year. The Date parameter must be a valid date according to the locale settings of %PRODUCTNAME.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3150037				0	ga	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3147614				0	ga	WEEKSINYEAR(A1) returns 53 if A1 contains 1970-02-17, a valid date for the year 1970.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3157901				0	ga	Add-ins through %PRODUCTNAME API				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3149351				0	ga	Add-ins can also be implemented through the %PRODUCTNAME \<link href=\"http://api.openoffice.org/\"\>API\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	tit				0	ga	Fill Series				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3148664				0	ga	Fill Series				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3148797				0	ga	\<variable id=\"reihenfuellentext\"\>\<ahelp hid=\".uno:FillSeries\"\>Automatically generate series with the options in this dialog. Determine direction, increment, time unit and series type.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3146976				0	ga	Before filling a series, first select the cell range.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3145748				0	ga	To automatically continue a series using the assumed completion rules, choose the \<emph\>AutoFill\</emph\> option after opening the \<emph\>Fill Series\</emph\> dialog.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3147435				0	ga	Treo				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3154729				0	ga	Determines the direction of series creation.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3145253				0	ga	Down				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3155418				0	ga	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_BOTTOM\"\>Creates a downward series in the selected cell range for the column using the defined increment to the end value.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3155738				0	ga	Right				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3149402				0	ga	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_RIGHT\"\>Creates a series running from left to right within the selected cell range using the defined increment to the end value.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3146972				0	ga	Up				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3153711				0	ga	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_TOP\"\>Creates an upward series in the cell range of the column using the defined increment to the end value.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3153764				0	ga	Left				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3156382				0	ga	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_LEFT\"\>Creates a series running from right to left in the selected cell range using the defined increment to the end value.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3147344				0	ga	Series Type				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3149257	15			0	ga	Defines the series type. Choose between \<emph\>Linear, Growth, Date \</emph\>and \<emph\>AutoFill\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3148488				0	ga	Linear				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3159238				0	ga	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_ARITHMETIC\"\>Creates a linear number series using the defined increment and end value.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3149210				0	ga	Growth				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3150364				0	ga	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_GEOMETRIC\"\>Creates a growth series using the defined increment and end value.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3149528				0	ga	Date				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3150887				0	ga	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_DATE\"\>Creates a date series using the defined increment and end date.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3150202				0	ga	UathLíon				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3156288				0	ga	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_AUTOFILL\"\>Forms a series directly in the sheet.\</ahelp\> The AutoFill function takes account of customized lists. For example, by entering \<emph\>January\</emph\> in the first cell, the series is completed using the list defined under \<emph\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - %PRODUCTNAME Calc - Sort Lists\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3155811				0	ga	AutoFill tries to complete a value series by using a defined pattern. The series 1,3,5 is automatically completed with 7,9,11,13, and so on. Date and time series are completed accordingly; for example, after 01.01.99 and 15.01.99, an interval of 14 days is used.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3148700				0	ga	Unit of Time				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3153308				0	ga	In this area you can specify the desired unit of time. This area is only active if the \<emph\>Date\</emph\> option has been chosen in the \<emph\>Series type\</emph\> area.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3148868				0	ga	Lá				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3148605				0	ga	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_DAY\"\>Use the \<emph\>Date\</emph\> series type and this option to create a series using seven days.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3144771				0	ga	Weekday				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3150108				0	ga	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_DAY_OF_WEEK\"\>Use the \<emph\>Date\</emph\> series type and this option to create a series of five day sets.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3154957				0	ga	Mí				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3149126				0	ga	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_MONTH\"\>Use the \<emph\>Date\</emph\> series type and this option to form a series from the names or abbreviations of the months.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3152870				0	ga	Bliain				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3151300				0	ga	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_YEAR\"\>Use the \<emph\>Date\</emph\> series type and this option to create a series of years.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3154762				0	ga	Start Value				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3149381				0	ga	\<ahelp hid=\"SC:EDIT:RID_SCDLG_FILLSERIES:ED_START_VALUES\"\>Determines the start value for the series.\</ahelp\> Use numbers, dates or times.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3153013				0	ga	End Value				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3153487				0	ga	\<ahelp hid=\"SC:EDIT:RID_SCDLG_FILLSERIES:ED_END_VALUES\"\>Determines the end value for the series.\</ahelp\> Use numbers, dates or times.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3149312				0	ga	Incrimint				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3154739				0	ga	The term "increment" denotes the amount by which a given value increases.\<ahelp hid=\"SC:EDIT:RID_SCDLG_FILLSERIES:ED_INCREMENT\"\> Determines the value by which the series of the selected type increases by each step.\</ahelp\> Entries can only be made if the linear, growth or date series types have been selected.				2002-02-02 02:02:02
