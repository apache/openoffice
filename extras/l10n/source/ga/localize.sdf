helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	hd_id3154725				0	ga	\<variable id=\"hour\"\>\<link href=\"text/scalc/01/func_hour.xhp\"\>HOUR\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	par_id3149747				0	ga	\<ahelp hid=\"HID_FUNC_STUNDE\"\>Returns the hour for a given time value.\</ahelp\> The hour is returned as an integer between 0 and 23.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	hd_id3149338				0	ga	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	par_id3150637				0	ga	HOUR(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	par_id3147547				0	ga	\<emph\>Number\</emph\>, as a time value, is a decimal, for which the hour is to be returned.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	hd_id3153264				0	ga	Examples				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	par_id3159215				0	ga	\<item type=\"input\"\>=HOUR(NOW())\</item\> returns the current hour				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	par_id3145152				0	ga	\<item type=\"input\"\>=HOUR(C4)\</item\> returns 17 if the contents of C4 = \<item type=\"input\"\>17:20:00\</item\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	par_id3154188				0	ga	\<link href=\"text/scalc/01/04060102.xhp\" name=\"YEAR\"\>YEAR\</link\>, \<link href=\"text/scalc/01/04060102.xhp\" name=\"NOW\"\>NOW\</link\>, \<link href=\"text/scalc/01/04060102.xhp\" name=\"MINUTE\"\>MINUTE\</link\>, \<link href=\"text/scalc/01/04060102.xhp\" name=\"MONTH\"\>MONTH\</link\>, \<link href=\"text/scalc/01/04060102.xhp\" name=\"DAY\"\>DAY\</link\>, \<link href=\"text/scalc/01/04060102.xhp\" name=\"WEEKDAY\"\>WEEKDAY\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	tit				0	ga	Conditional Formatting				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	hd_id3155132				0	ga	Conditional Formatting				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3163710				0	ga	\<variable id=\"bedingtetext\"\>\<ahelp hid=\".uno:ConditionalFormatDialog\"\>Choose \<emph\>Conditional Formatting\</emph\> to define format styles depending on certain conditions.\</ahelp\>\</variable\> If a style was already assigned to a cell, it remains unchanged. The style entered here is then evaluated. You can enter three conditions that query the contents of cell values or formulas. The conditions are evaluated from 1 to 3. If the condition 1 matches the condition, the defined style will be used. Otherwise, condition 2 is evaluated, and its defined style used. If this style does not match, condition 3 is evaluated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id2414014				0	ga	To apply conditional formatting, AutoCalculate must be enabled. Choose Tools - Cell Contents - AutoCalculate (you see a check mark next to the command when AutoCalculate is enabled).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	bm_id3153189				0	ga	\<bookmark_value\>conditional formatting; conditions\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	hd_id3153189				0	ga	Condition 1/2/3				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3149413				0	ga	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_CONDFORMAT:CBX_COND3\"\>Mark the boxes corresponding to each condition and enter the corresponding condition.\</ahelp\> To close the dialog, click \<emph\>OK\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	hd_id3147394				0	ga	Cell Value / Formula				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3155602				0	ga	\<ahelp hid=\"SC:LISTBOX:RID_SCDLG_CONDFORMAT:LB_COND3_1\"\>Specifies if conditional formatting is dependent on a cell value or a formula.\</ahelp\> If you select a formula as a reference, the \<emph\>Cell Value Condition\</emph\> box is displayed to the right of the \<emph\>Cell value/Formula\</emph\> field. If the condition is "Formula is", enter a cell reference. If the cell reference is a value other than zero, the condition matches.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	hd_id3153709				0	ga	Cell Value Condition				2002-02-02 02:02:02
