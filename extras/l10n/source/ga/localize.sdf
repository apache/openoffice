helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_id3149797				0	ga	\<image id=\"img_id3155434\" src=\"res/commandimagelist/sc_print.png\" width=\"0.1665in\" height=\"0.1665in\"\>\<alt id=\"alt_id3155434\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
