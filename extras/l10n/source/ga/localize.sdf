helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3156076				0	ga	\<item type=\"input\"\>=TIME(0;0;0)\</item\> returns 00:00:00				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3156090				0	ga	\<item type=\"input\"\>=TIME(4;20;4)\</item\> returns 04:20:04				2002-02-02 02:02:02
