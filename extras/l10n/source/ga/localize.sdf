helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3153694				0	ga	\<bookmark_value\>N function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3153694				0	ga	N				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150405				0	ga	\<ahelp hid=\"HID_FUNC_N\"\>Returns the numeric value of the given parameter. Returns 0 if parameter is text, FALSE or #NA.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id9115573				0	ga	If an error occurs, other than #NA, the function returns the error value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3145774				0	ga	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153883				0	ga	N(Value)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151101				0	ga	\<emph\>Value\</emph\> is the parameter to be converted into a number. N() returns the numeric value if it can. It returns the logical values TRUE and FALSE as 1 and 0 respectively. It returns text and errors as 0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3147097				0	ga	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154117				0	ga	\<item type=\"input\"\>=N(123)\</item\> returns 123				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id2337717				0	ga	\<item type=\"input\"\>=N(TRUE)\</item\> returns 1				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153781				0	ga	\<item type=\"input\"\>=N(FALSE)\</item\> returns 0				2002-02-02 02:02:02
