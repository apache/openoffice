helpcontent2	source\text\simpress\guide\print_tofit.xhp	0	help	hd_id3155067				0	ga	\<variable id=\"print_tofit\"\>\<link href=\"text/simpress/guide/print_tofit.xhp\" name=\"Printing a Slide to Fit a Paper Size\"\>Printing a Slide to Fit a Paper Size\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\simpress\guide\print_tofit.xhp	0	help	par_id3154704				0	ga	You can reduce the size of a slide when you print, so that the slide can fit on a printed page.				2002-02-02 02:02:02
