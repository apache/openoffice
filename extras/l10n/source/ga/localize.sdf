helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149282				0	ga	\<ahelp hid=\"HID_FUNC_ISTFEHL\"\>Tests for error conditions, except the #N/A error value, and returns TRUE or FALSE.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3149450				0	ga	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156312				0	ga	ISERR(Value)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3146857				0	ga	\<emph\>Value\</emph\> is any value or expression which is tested to see whether an error value other than #N/A is present.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3153212				0	ga	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153276				0	ga	\<item type=\"input\"\>=ISERR(C8)\</item\> where cell C8 contains \<item type=\"input\"\>=1/0\</item\> returns TRUE, because 1/0 is an error.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id8456984				0	ga	\<item type=\"input\"\>=ISERR(C9)\</item\> where cell C9 contains \<item type=\"input\"\>=NA()\</item\> returns FALSE, because ISERR() ignores the #N/A error.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3147081				0	ga	\<bookmark_value\>ISERROR function\</bookmark_value\>\<bookmark_value\>recognizing;general errors\</bookmark_value\>				2002-02-02 02:02:02
