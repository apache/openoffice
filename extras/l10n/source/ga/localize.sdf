helpcontent2	source\text\shared\explorer\database\rep_prop.xhp	0	help	par_id5749687				0	ga	\<ahelp hid=\".\" visibility=\"hidden\"\>Sets the width of the selected object.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\rep_prop.xhp	0	help	par_id79348				0	ga	\<ahelp hid=\".\" visibility=\"hidden\"\>Select the font for the selected text object.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\rep_prop.xhp	0	help	par_id2414014				0	ga	\<ahelp hid=\".\" visibility=\"hidden\"\>Print when group change\</ahelp\>				2002-02-02 02:02:02
