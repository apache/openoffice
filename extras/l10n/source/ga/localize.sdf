helpcontent2	source\text\sbasic\shared\03030205.xhp	0	help	par_id3156286				0	ga	dDate = TimeSerial(8,30,15)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03030205.xhp	0	help	par_id3148456				0	ga	sDate = TimeSerial(8,30,15)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03030205.xhp	0	help	par_id3155600				0	ga	MsgBox dDate,64,"Time as a number"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03030205.xhp	0	help	par_id3153417				0	ga	MsgBox sDate,64,"Formatted time"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03030205.xhp	0	help	par_id3153836				0	ga	End Sub				2002-02-02 02:02:02
