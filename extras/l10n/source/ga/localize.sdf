helpcontent2	source\text\scalc\01\solver.xhp	0	help	par_id9183935				0	ga	\<ahelp hid=\".\" visibility=\"hidden\"\>Enter a cell reference.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\solver.xhp	0	help	par_id946684				0	ga	\<ahelp hid=\".\" visibility=\"hidden\"\>Select an operator from the list.\</ahelp\>				2002-02-02 02:02:02
