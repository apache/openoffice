helpcontent2	source\text\swriter\01\mailmerge06.xhp	0	help	par_idN1055A				0	ga	\<ahelp hid=\".\"\>Enter the address record number of a recipient to preview the mail merge document for the recipient.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\mailmerge06.xhp	0	help	par_idN10604				0	ga	\<ahelp hid=\".\"\>Use the browse buttons to scroll through the address records.\</ahelp\>				2002-02-02 02:02:02
