helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	hd_id3149803				0	ga	\<variable id=\"minute\"\>\<link href=\"text/scalc/01/func_minute.xhp\"\>MINUTE\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	par_id3148988				0	ga	\<ahelp hid=\"HID_FUNC_MINUTE\"\>Calculates the minute for an internal time value.\</ahelp\> The minute is returned as a number between 0 and 59.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	hd_id3154343				0	ga	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	par_id3148660				0	ga	MINUTE(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	par_id3154611				0	ga	\<emph\>Number\</emph\>, as a time value, is a decimal number where the number of the minute is to be returned.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	hd_id3145374				0	ga	Examples				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	par_id3148463				0	ga	\<item type=\"input\"\>=MINUTE(8.999)\</item\> returns 58				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	par_id3149419				0	ga	\<item type=\"input\"\>=MINUTE(8.9999)\</item\> returns 59				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	par_id3144755				0	ga	\<item type=\"input\"\>=MINUTE(NOW())\</item\> returns the current minute value.				2002-02-02 02:02:02
