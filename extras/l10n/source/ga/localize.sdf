helpcontent2	source\text\swriter\guide\pagestyles.xhp	0	help	hd_id3155182	1			0	ga	\<variable id=\"pagestyles\"\>\<link href=\"text/swriter/guide/pagestyles.xhp\" name=\"Creating and Applying Page Styles\"\>Creating and Applying Page Styles\</link\> \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\guide\pagestyles.xhp	0	help	par_id3149846				0	ga	$[officename] uses page styles to specify the layout of a page, including the page orientation, background, margins, headers, footers, and text columns. To change the layout of an individual page in a document, you must create and apply a custom page style to the page.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\guide\pagestyles.xhp	0	help	par_idN1071A				0	ga	         \<embedvar href=\"text/swriter/guide/pageorientation.xhp#pageorientation\"/\>      				2002-02-02 02:02:02
