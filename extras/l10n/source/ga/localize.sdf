helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3146072				0	ga	Pentecost Sunday = EASTERSUNDAY(Year) + 49				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3149553				0	ga	Pentecost Monday = EASTERSUNDAY(Year) + 50				2002-02-02 02:02:02
