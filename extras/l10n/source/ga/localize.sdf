helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153155				0	ga	ISERROR(Value)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154047				0	ga	\<emph\>Value\</emph\> is or refers to the value to be tested. ISERROR() returns TRUE if there is an error and FALSE if not.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3155994				0	ga	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150256				0	ga	\<item type=\"input\"\>=ISERROR(C8)\</item\> where cell C8 contains \<item type=\"input\"\>=1/0\</item\> returns TRUE, because 1/0 is an error.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id1889095				0	ga	\<item type=\"input\"\>=ISERROR(C9)\</item\> where cell C9 contains \<item type=\"input\"\>=NA()\</item\> returns TRUE.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3153618				0	ga	\<bookmark_value\>ISFORMULA function\</bookmark_value\>\<bookmark_value\>recognizing formula cells\</bookmark_value\>\<bookmark_value\>formula cells;recognizing\</bookmark_value\>				2002-02-02 02:02:02
