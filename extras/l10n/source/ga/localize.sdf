helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145123	36			0	ga	                     \<emph\>E\</emph\>                  				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149504				0	ga	1				2002-02-02 02:02:02
