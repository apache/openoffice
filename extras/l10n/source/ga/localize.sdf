helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id9475997				0	ga	myText = "Hello"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id6933500				0	ga	print "in module1 : ", myText				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id631733				0	ga	End Sub				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id8234199				0	ga	REM ***** Module2 *****				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id6969512				0	ga	'Option Explicit				2002-02-02 02:02:02
