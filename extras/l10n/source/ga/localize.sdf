helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3146944				0	ga	\<bookmark_value\>ABS function\</bookmark_value\>\<bookmark_value\>absolute values\</bookmark_value\>\<bookmark_value\>values;absolute\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146944				0	ga	ABS				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154546				0	ga	\<ahelp hid=\"HID_FUNC_ABS\"\>Returns the absolute value of a number.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154843				0	ga	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147475				0	ga	ABS(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148438				0	ga	\<emph\>Number\</emph\> is the number whose absolute value is to be calculated. The absolute value of a number is its value without the +/- sign.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155823				0	ga	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152787				0	ga	\<item type=\"input\"\>=ABS(-56)\</item\> returns 56.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148752				0	ga	\<item type=\"input\"\>=ABS(12)\</item\> returns 12.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id320139				0	ga	\<item type=\"input\"\>=ABS(0)\</item\> returns 0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3150896				0	ga	\<bookmark_value\>COUNTBLANK function\</bookmark_value\>\<bookmark_value\>counting;empty cells\</bookmark_value\>\<bookmark_value\>empty cells;counting\</bookmark_value\>				2002-02-02 02:02:02
