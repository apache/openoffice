helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DA7				0	ga	no				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DAF				0	ga	3				2002-02-02 02:02:02
