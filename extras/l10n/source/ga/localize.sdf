helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3155592	57			0	ga	            \<item type=\"input\"\>=IMAGINARY("4+3j")\</item\> returns 3.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	bm_id3146106				0	ga	\<bookmark_value\>IMPOWER function\</bookmark_value\>				2002-02-02 02:02:02
