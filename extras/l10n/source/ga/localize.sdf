helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155260				0	ga	\<ahelp hid=\"HID_FUNC_ANZAHLLEEREZELLEN\"\>Returns the number of empty cells.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145144				0	ga	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153931				0	ga	COUNTBLANK(Range)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149512				0	ga	 Returns the number of empty cells in the cell range \<emph\>Range\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146139				0	ga	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148586				0	ga	\<item type=\"input\"\>=COUNTBLANK(A1:B2)\</item\> returns 4 if cells A1, A2, B1, and B2 are all empty.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3153114				0	ga	\<bookmark_value\>ACOS function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153114				0	ga	ACOS				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145163				0	ga	\<ahelp hid=\"HID_FUNC_ARCCOS\"\>Returns the inverse trigonometric cosine of a number.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153565				0	ga	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150020				0	ga	ACOS(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159134				0	ga	 This function returns the inverse trigonometric cosine of \<emph\>Number\</emph\>, that is the angle (in radians) whose cosine is Number. The angle returned is between 0 and PI.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id679647				0	ga	To return the angle in degrees, use the DEGREES function.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3149882				0	ga	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150128				0	ga	\<item type=\"input\"\>=ACOS(-1)\</item\> returns 3.14159265358979 (PI radians)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8792382				0	ga	\<item type=\"input\"\>=DEGREES(ACOS(0.5))\</item\> returns 60. The cosine of 60 degrees is 0.5.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3145355				0	ga	\<bookmark_value\>ACOSH function\</bookmark_value\>				2002-02-02 02:02:02
