helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	par_id3154125				0	ga	iPos = Instr(sInput,"c")				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	par_id3145173				0	ga	print iPos				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	par_id3145786				0	ga	end sub				2002-02-02 02:02:02
