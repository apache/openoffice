helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3146125				0	ga	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3153695				0	ga	CONVERT_ADD(Number; "FromUnit"; "ToUnit")				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3147522	211			0	ga	            \<emph\>Number\</emph\> is the number to be converted.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3154472	212			0	ga	            \<emph\>FromUnit\</emph\> is the unit from which conversion is taking place.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3153790	213			0	ga	            \<emph\>ToUnit\</emph\> is the unit to which conversion is taking place. Both units must be of the same type.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id09022809540918				0	ga	\<link href=\"http://wiki.services.openoffice.org/wiki/Documentation/How_Tos/Calc:_CONVERT_ADD_function\"\>Current list of CONVERT_ADD units in the OpenOffice.org Wiki.\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3156270				0	ga	Examples				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3156336	215			0	ga	            \<item type=\"input\"\>=CONVERT_ADD(10;"HP";"PS") \</item\>returns, rounded to two decimal places, 10.14. 10 HP equal 10.14 PS.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3154834	216			0	ga	            \<item type=\"input\"\>=CONVERT_ADD(10;"km";"mi") \</item\>returns, rounded to two decimal places, 6.21. 10 kilometers equal 6.21 miles. The k is the permitted prefix character for the factor 10^3.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	bm_id3147096				0	ga	\<bookmark_value\>FACTDOUBLE function\</bookmark_value\>         \<bookmark_value\>factorials;numbers with increments of two\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3147096				0	ga	FACTDOUBLE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3151309				0	ga	\<ahelp hid=\"HID_AAI_FUNC_FACTDOUBLE\"\>Returns the double factorial of a number.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3154666				0	ga	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3155121				0	ga	FACTDOUBLE(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3158440	40			0	ga	Returns \<emph\>Number\</emph\>            \<emph\>!!\</emph\>, the double factorial of \<emph\>Number\</emph\>, where \<emph\>Number\</emph\> is an integer greater than or equal to zero.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id2480849				0	ga	For even numbers FACTDOUBLE(n) returns:				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id4181951				0	ga	2*4*6*8* ... *n				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id2927335				0	ga	For odd numbers FACTDOUBLE(n) returns:				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id2107303				0	ga	1*3*5*7* ... *n				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id4071779				0	ga	FACTDOUBLE(0) returns 1 by definition.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3154622				0	ga	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id7844477				0	ga	            \<item type=\"input\"\>=FACTDOUBLE(5)\</item\> returns 15.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3154116	43			0	ga	            \<item type=\"input\"\>=FACTDOUBLE(6)\</item\> returns 48.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id6478469				0	ga	            \<item type=\"input\"\>=FACTDOUBLE(0)\</item\> returns 1.				2002-02-02 02:02:02
