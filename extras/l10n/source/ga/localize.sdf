helpcontent2	source\text\swriter\01\03120000.xhp	0	help	par_id3154646				0	ga	\<ahelp hid=\".uno:BrowseView\"\>Displays the document as seen in a Web browser.\</ahelp\> This is useful when you create HTML documents.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04200000.xhp	0	help	tit				0	ga	Insert Script				2002-02-02 02:02:02
