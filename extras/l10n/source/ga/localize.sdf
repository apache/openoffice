helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3154372				0	ga	\<variable id=\"fh\"\>\<link href=\"text/scalc/01/04060182.xhp\" name=\"Statistical Functions Part Two\"\>Statistical Functions Part Two\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3145388				0	ga	\<bookmark_value\>FINV function\</bookmark_value\>         \<bookmark_value\>inverse F probability distribution\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3145388				0	ga	FINV				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155089				0	ga	\<ahelp hid=\"HID_FUNC_FINV\"\>Returns the inverse of the F probability distribution.\</ahelp\> The F distribution is used for F tests in order to set the relation between two differing data sets.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3153816				0	ga	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153068				0	ga	FINV(Number; DegreesFreedom1; DegreesFreedom2)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146866	6			0	ga	            \<emph\>Number\</emph\> is probability value for which the inverse F distribution is to be calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153914	7			0	ga	            \<emph\>DegreesFreedom1\</emph\> is the number of degrees of freedom in the numerator of the F distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3148607	8			0	ga	            \<emph\>DegreesFreedom2\</emph\> is the number of degrees of freedom in the denominator of the F distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3156021				0	ga	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145073	10			0	ga	            \<item type=\"input\"\>=FINV(0.5;5;10)\</item\> yields 0.93.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3150888				0	ga	\<bookmark_value\>FISHER function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150888				0	ga	FISHER				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155384				0	ga	\<ahelp hid=\"HID_FUNC_FISHER\"\>Returns the Fisher transformation for x and creates a function close to a normal distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3149898				0	ga	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3143220				0	ga	FISHER(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3159228	16			0	ga	            \<emph\>Number\</emph\> is the value to be transformed.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3154763				0	ga	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3149383	18			0	ga	            \<item type=\"input\"\>=FISHER(0.5)\</item\> yields 0.55.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3155758				0	ga	\<bookmark_value\>FISHERINV function\</bookmark_value\>         \<bookmark_value\>inverse of Fisher transformation\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3155758				0	ga	FISHERINV				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154734				0	ga	\<ahelp hid=\"HID_FUNC_FISHERINV\"\>Returns the inverse of the Fisher transformation for x and creates a function close to a normal distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3155755				0	ga	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146108				0	ga	FISHERINV(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145115	24			0	ga	            \<emph\>Number\</emph\> is the value that is to undergo reverse-transformation.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3155744				0	ga	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150432	26			0	ga	            \<item type=\"input\"\>=FISHERINV(0.5)\</item\> yields 0.46.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3151390				0	ga	\<bookmark_value\>FTEST function\</bookmark_value\>				2002-02-02 02:02:02
