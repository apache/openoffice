helpcontent2	source\text\shared\guide\sidebar_window.xhp	0	help	par_id2004				0	hy	\<item type=\"menuitem\"\>Ոճեր և Ձևավորում\</item\> հարթակը պարունակում է \<switchinline select=\"appl\"\>        \<caseinline select=\"CALC\"\>\<link href=\"text/scalc/01/05100000.xhp\" name=\"styles\"\>Ոճեր և Ձևավորում\</link\>\</caseinline\>        \<caseinline select=\"DRAW\"\>\<link href=\"text/simpress/01/05100000.xhp\" name=\"styles\"\>Ոճեր և Ձևավորում\</link\>\</caseinline\>        \<caseinline select=\"IMPRESS\"\>\<link href=\"text/simpress/01/05100000.xhp\" name=\"styles\"\>Ոճեր և Ձևավորում\</link\>\</caseinline\>        \<defaultinline\>\<link href=\"text/swriter/01/05140000.xhp\" name=\"styles\"\>Ոճեր և Ձևավորում\</link\>\</defaultinline\>        \</switchinline\> պատուհանը։				20200411 15:09:53
