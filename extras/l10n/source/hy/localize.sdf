helpcontent2	source\text\swriter\01\04120211.xhp	0	help	par_id3150570	2			0	hy	\<variable id=\"verzeichnis\"\>The following options are available when you select \<emph\>Table of Contents \</emph\>as the \<link href=\"text/swriter/01/04120210.xhp\" name=\"index\"\>index\</link\> type. \</variable\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120211.xhp	0	help	hd_id3150763				0	hy	Type and Title				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120211.xhp	0	help	par_id3149286				0	hy	Specify the type and title of the index.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120211.xhp	0	help	hd_id3151171				0	hy	Type				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120211.xhp	0	help	par_id3145418				0	hy	\<ahelp hid=\"SW:LISTBOX:TP_TOX_SELECT:LB_TYPE\"\>Select the type of index that you want to insert.\</ahelp\> The options available on this tab depend on the index type that you select. If the cursor is in an index when you choose the \<emph\>Insert - Indexes and Tables - Indexes and Tables\</emph\>, you can then edit that index.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120211.xhp	0	help	hd_id3149801				0	hy	Title				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120211.xhp	0	help	par_id3153532				0	hy	\<ahelp hid=\"SW:EDIT:TP_TOX_SELECT:ED_TITLE\"\>Enter a title for the selected index.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120211.xhp	0	help	hd_id3151317				0	hy	Protected against manual changes				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120211.xhp	0	help	par_id3153665	10			0	hy	\<ahelp hid=\"SW:CHECKBOX:TP_TOX_SELECT:CB_READONLY\"\>Prevents the contents of the index from being changed.\</ahelp\> Manual changes that you make to an index are lost when the index is refreshed. If you want the cursor to scroll through a protected area, choose \<emph\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - %PRODUCTNAME Writer - Formatting Aids\</emph\>, and then select the \<emph\>Cursor in protected areas - Enabled \</emph\>check box.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120211.xhp	0	help	hd_id3155893				0	hy	Create index for				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120211.xhp	0	help	par_id3149688				0	hy	\<ahelp hid=\"SW:LISTBOX:TP_TOX_SELECT:LB_AREA\"\>Select whether to create the index for the document or for the current chapter.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120211.xhp	0	help	hd_id3154199				0	hy	Evaluation level				20200411 15:09:53
