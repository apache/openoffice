helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	par_id3151041				0	hy	Selling Price				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	par_id3159149				0	hy	100				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	par_id3159254				0	hy	6				20200411 15:09:53
