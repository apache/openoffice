helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id5649281				0	hy	r² = RSQ(Data_Y;LN(Data_X)) 				20200411 15:09:53
helpcontent2	source\text\schart\01\04050100.xhp	0	help	hd_id7874080				0	hy	Էքսպոնենցիալ ռեգրեսիայի հավասարումը				20200411 15:09:53
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id4679097				0	hy	 Էքսպոնենցիալ միտումների գծերի համար տեղի է ունենում փոխակերպում գծային մոդելի: Օպտիմալ կորի հարմարեցումը կապված է գծային մոդելի հետ և արդյունքները մեկնաբանվում են համապատասխանաբար: 				20200411 15:09:53
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id9112216				0	hy	Էքսպոնենցիալ ռեգրեսիան հետևում է \<item type=\"literal\"\>y=b*exp(a*x)\</item\> կամ \<item type=\"literal\"\>y=b*m^x\</item\> հավասարմանը, որը փոխակերպվում է \<item type=\"literal\"\>ln(y)=ln(b)+a*x\</item\> կամ \<item type=\"literal\"\>ln(y)=ln(b)+ln(m)*x\</item\> համապատասխանաբար:				20200411 15:09:53
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id4416638				0	hy	a = SLOPE(LN(Data_Y);Data_X) 				20200411 15:09:53
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id1039155				0	hy	Երկրորդ փոփոխության համար փոփոխականները հաշվարկվում են հետևյալ կերպ.				20200411 15:09:53
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id7184057				0	hy	m = EXP(SLOPE(LN(Data_Y);Data_X)) 				20200411 15:09:53
helpcontent2	source\text\schart\01\04050100.xhp	0	help	par_id786767				0	hy	b = EXP(INTERCEPT(LN(Data_Y);Data_X)) 				20200411 15:09:53
