helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3152582	44			0	lt	Specifies that capitalization is checked during spellcheck.				20130618 17:22:18
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3150826	45			0	lt	Check words with numbers.				20130618 17:22:18
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3150208	46			0	lt	Specifies that words that contain numbers as well as letters are to be checked.				20130618 17:22:18
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3147509	47			0	lt	Check capitalization				20130618 17:22:18
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3154200	48			0	lt	Checks for the correct use of capitals at the start of words during spellcheck.				20130618 17:22:18
