helpcontent2	source\text\shared\02\12090101.xhp	0	help	bm_id3148983				0	lt	\<bookmark_value\>comparisons;operators in standard filter dialog\</bookmark_value\>      \<bookmark_value\>operators;standard filters\</bookmark_value\>      \<bookmark_value\>standard filters;comparison operators\</bookmark_value\>      \<bookmark_value\>filters; comparison operators\</bookmark_value\>      \<bookmark_value\>equal sign, see also operators\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	hd_id3148983	1			0	lt	Comparison Operators				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3155364	2			0	lt	The following comparative operators can be set under \<item type=\"menuitem\"\>Condition\</item\> in the \<item type=\"menuitem\"\>Standard Filter\</item\> dialog.				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3145313	3			0	lt	                  \<emph\>Comparative operator\</emph\>               				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3147089	4			0	lt	                  \<emph\>Effect\</emph\>               				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3147209	5			0	lt	Equal (=)				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3146797	6			0	lt	Shows values equal to the condition.				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3143271	7			0	lt	Less than (<)				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3153761	8			0	lt	Shows values less than the condition.				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3146807	9			0	lt	Greater than (>)				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3154852	10			0	lt	Shows values greater than the condition.				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3155342	11			0	lt	Less than or equal to (< =)				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3154381	12			0	lt	Shows values that are less than or equal to the condition.				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3153823	13			0	lt	Greater than or equal to (> =)				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3154143	14			0	lt	Shows values that are greater than or equal to the condition.				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3154811	15			0	lt	Not equal (< >)				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3148944	16			0	lt	Shows the values not equal to the condition.				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3149669	17			0	lt	Largest				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3159413	18			0	lt	Shows the N (numeric value as parameter) largest values.				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3151054	19			0	lt	Smallest				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3161657	20			0	lt	Shows the N (numeric value as parameter) smallest values.				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3150400	21			0	lt	Largest %				20130618 17:22:18
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3161645	22			0	lt	Shows the largest N% (numeric value as parameter) of the total values.				20130618 17:22:18
