helpcontent2	source\text\scalc\01\format_graphic.xhp	0	help	par_id2480544				0	lt	\<ahelp hid=\".\"\>Switches \<emph\>Edit Points\</emph\> mode for an inserted freeform line on and off.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	tit				0	lt	DATE				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	bm_id3155511				0	lt	\<bookmark_value\>DATE function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	hd_id3155511	3			0	lt	\<variable id=\"date\"\>\<link href=\"text/scalc/01/func_date.xhp\"\>DATE\</link\>\</variable\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3153551	4			0	lt	\<ahelp hid=\"HID_FUNC_DATUM\"\>This function calculates a date specified by year, month, day and displays it in the cell's formatting.\</ahelp\> The default format of a cell containing the DATE function is the date format, but you can format the cells with any other number format.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	hd_id3148590	5			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3150474	6			0	lt	DATE(Year; Month; Day)				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3152815	7			0	lt	\<emph\>Year\</emph\> is an integer between 1583 and 9957 or between 0 and 99.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3153222	174			0	lt	In \<item type=\"menuitem\"\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - $[officename] - General \</item\>you can set from which year a two-digit number entry is recognized as 20xx.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3155817	8			0	lt	\<emph\>Month\</emph\> is an integer indicating the month.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3153183	9			0	lt	\<emph\>Day\</emph\> is an integer indicating the day of the month.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3156260	10			0	lt	If the values for month and day are out of bounds, they are carried over to the next digit. If you enter \<item type=\"input\"\>=DATE(00;12;31)\</item\> the result will be 12/31/00. If, on the other hand, you enter \<item type=\"input\"\>=DATE(00;13;31)\</item\> the result will be 1/31/01.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	hd_id3147477	12			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3152589	16			0	lt	\<item type=\"input\"\>=DATE(00;1;31)\</item\> yields 1/31/00 if the cell format setting is MM/DD/YY.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	tit				0	lt	DATEVALUE 				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	bm_id3145621				0	lt	\<bookmark_value\>DATEVALUE function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	hd_id3145621	18			0	lt	\<variable id=\"datevalue\"\>\<link href=\"text/scalc/01/func_datevalue.xhp\"\>DATEVALUE\</link\>\</variable\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	par_id3145087	19			0	lt	\<ahelp hid=\"HID_FUNC_DATWERT\"\>Returns the internal date number for text in quotes.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	par_id3149281	20			0	lt	The internal date number is returned as a number. The number is determined by the date system that is used by $[officename] to calculate dates.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	par_id0119200903491982				0	lt	If the text string also includes a time value, DATEVALUE only returns the integer part of the conversion.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	hd_id3156294	21			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	par_id3149268	22			0	lt	DATEVALUE("Text")				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	par_id3154819	23			0	lt	         \<emph\>Text\</emph\> is a valid date expression and must be entered with quotation marks.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	hd_id3156309	24			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	par_id3155841	25			0	lt	         \<emph\>=DATEVALUE("1954-07-20")\</emph\> yields 19925.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	tit				0	lt	DAY 				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	bm_id3147317				0	lt	\<bookmark_value\>DAY function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	hd_id3147317	106			0	lt	\<variable id=\"day\"\>\<link href=\"text/scalc/01/func_day.xhp\"\>DAY\</link\>\</variable\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3147584	107			0	lt	\<ahelp hid=\"HID_FUNC_TAG\"\>Returns the day of given date value.\</ahelp\> The day is returned as an integer between 1 and 31. You can also enter a negative date/time value.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	hd_id3150487	108			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3149430	109			0	lt	DAY(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3149443	110			0	lt	\<emph\>Number\</emph\>, as a time value, is a decimal, for which the day is to be returned.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	hd_id3163809	111			0	lt	Examples 				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3151200	112			0	lt	DAY(1) returns 31 (since $[officename] starts counting at zero from December 30, 1899)				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3154130	113			0	lt	DAY(NOW()) returns the current day.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3159190	114			0	lt	=DAY(C4) returns 5 if you enter 1901-08-05 in cell C4 (the date value might get formatted differently after you press Enter).				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	tit				0	lt	DAYS 				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	bm_id3151328				0	lt	\<bookmark_value\>DAYS function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	hd_id3151328	116			0	lt	\<variable id=\"days\"\>\<link href=\"text/scalc/01/func_days.xhp\"\>DAYS\</link\>\</variable\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3155139	117			0	lt	\<ahelp hid=\"HID_FUNC_TAGE\"\>Calculates the difference between two date values.\</ahelp\> The result returns the number of days between the two days.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	hd_id3155184	118			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3149578	119			0	lt	DAYS(Date2; Date1)				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3151376	120			0	lt	\<emph\>Date1\</emph\> is the start date, \<emph\>Date2\</emph\> is the end date. If \<emph\>Date2\</emph\> is an earlier date than \<emph\>Date1\</emph\> the result is a negative number.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	hd_id3151001	121			0	lt	Examples				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3159101	123			0	lt	=DAYS("2010-01-01"; NOW()) returns the number of days from today until January 1, 2010.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3163720	172			0	lt	=DAYS("1990-10-10";"1980-10-10") returns 3652 days.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days360.xhp	0	help	tit				0	lt	DAYS360 				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days360.xhp	0	help	bm_id3148555				0	lt	\<bookmark_value\>DAYS360 function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days360.xhp	0	help	hd_id3148555	124			0	lt	\<variable id=\"days360\"\>\<link href=\"text/scalc/01/func_days360.xhp\"\>DAYS360\</link\>\</variable\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days360.xhp	0	help	par_id3156032	125			0	lt	\<ahelp hid=\"HID_FUNC_TAGE360\"\>Returns the difference between two dates based on the 360 day year used in interest calculations.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days360.xhp	0	help	hd_id3155347	126			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days360.xhp	0	help	par_id3155313	127			0	lt	DAYS360("Date1"; "Date2"; Type)				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days360.xhp	0	help	par_id3145263	128			0	lt	If \<emph\>Date2\</emph\> is earlier than \<emph\>Date1\</emph\>, the function will return a negative number.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days360.xhp	0	help	par_id3151064	129			0	lt	The optional argument \<emph\>Type\</emph\> determines the type of difference calculation. If Type = 0 or if the argument is missing, the US method (NASD, National Association of Securities Dealers) is used. If Type <> 0, the European method is used.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days360.xhp	0	help	hd_id3148641	130			0	lt	Examples				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days360.xhp	0	help	par_id3156348	132			0	lt	=DAYS360("2000-01-01";NOW()) returns the number of interest days from January 1, 2000 until today.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	tit				0	lt	EASTERSUNDAY				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	bm_id3152960				0	lt	\<bookmark_value\>EASTERSUNDAY function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	hd_id3152960	175			0	lt	\<variable id=\"eastersunday\"\>\<link href=\"text/scalc/01/func_eastersunday.xhp\"\>EASTERSUNDAY\</link\>\</variable\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3154570	176			0	lt	\<ahelp hid=\"HID_FUNC_OSTERSONNTAG\"\>Returns the date of Easter Sunday for the entered year.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	hd_id9460127				0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id2113711				0	lt	EASTERSUNDAY(Year)				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3938413				0	lt	\<emph\>Year\</emph\> is an integer between 1583 and 9956 or 0 and 99. You can also calculate other holidays by simple addition with this date.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3156156	177			0	lt	Easter Monday = EASTERSUNDAY(Year) + 1				20130618 17:22:18
