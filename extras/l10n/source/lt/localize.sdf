helpcontent2	source\text\sbasic\shared\03120103.xhp	0	help	par_id3145069	14			0	lt	iVar = 123.123				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03120103.xhp	0	help	par_id3153897	15			0	lt	sVar = LTrim(Str(iVar))				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03120103.xhp	0	help	par_id3154924	16			0	lt	Msgbox sVar & chr(13) & Str(iVar)				20130618 17:22:18
