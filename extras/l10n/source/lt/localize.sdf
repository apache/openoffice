helpcontent2	source\text\swriter\01\02110000.xhp	0	help	par_id3151354	56			0	lt	\<ahelp hid=\"HID_NAVI_TBX14\"\>Increases the outline level of the selected heading, and the headings that occur below the heading, by one. To only increase the outline level of the selected heading, hold down Ctrl, and then click this icon.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\02110000.xhp	0	help	par_id3155414				0	lt	\<image id=\"img_id3155420\" src=\"sw/imglst/sc20172.png\" width=\"0.2228in\" height=\"0.2228in\"\>\<alt id=\"alt_id3155420\"\>Icon\</alt\>\</image\>				20130618 17:22:18
