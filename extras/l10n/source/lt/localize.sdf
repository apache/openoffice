helpcontent2	source\text\swriter\01\04120227.xhp	0	help	hd_id31544970				0	lt	Type				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120227.xhp	0	help	par_id3150017	3			0	lt	The types that are displayed depend on the different literature sources.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120227.xhp	0	help	hd_id3150570	4			0	lt	Type				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120227.xhp	0	help	par_id3147175	5			0	lt	Lists the available bibliography entries. \<ahelp hid=\".\"\>To add an entry to the Structure line, click the entry, click in an empty box on the Structure line, and then click \<emph\>Insert\</emph\>.\</ahelp\> Use the \<link href=\"text/swriter/01/04120229.xhp\" name=\"Define Bibliography Entry\"\>Define Bibliography Entry\</link\> dialog to add new entries.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120227.xhp	0	help	hd_id3149287	6			0	lt	Insert				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120227.xhp	0	help	par_id3151178	7			0	lt	\<ahelp hid=\"SW:PUSHBUTTON:TP_TOX_ENTRY:PB_AUTHINSERT\"\>Adds the reference code for the selected bibliography entry to the Structure line. Select an entry in the list, click in an empty box, and then click this button.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120227.xhp	0	help	hd_id3154096	8			0	lt	Remove				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120227.xhp	0	help	par_id3149807	9			0	lt	\<ahelp hid=\"SW:PUSHBUTTON:TP_TOX_ENTRY:PB_AUTHREMOVE\"\>Removes the selected reference code from the Structure line.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120227.xhp	0	help	hd_id3154470	10			0	lt	Sort by				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120227.xhp	0	help	par_id3154482	11			0	lt	Specify the sorting options for the bibliography entries.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120227.xhp	0	help	hd_id3153665	12			0	lt	Document position				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120227.xhp	0	help	par_id3151314	13			0	lt	\<ahelp hid=\"SW:RADIOBUTTON:TP_TOX_ENTRY:RB_DOCPOS\"\>Sorts the bibliography entries according to the position of their references in the document.\</ahelp\> Select this option if you want to use automatically numbered references.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120227.xhp	0	help	hd_id3154576	14			0	lt	Content				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120227.xhp	0	help	par_id3149687	15			0	lt	\<ahelp hid=\"SW:RADIOBUTTON:TP_TOX_ENTRY:RB_SORTCONTENT\"\>Sorts the bibliography entries by the Sort keys that you specify, for example, by author or by year of publication.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120227.xhp	0	help	hd_id3155175	16			0	lt	Sort keys				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120227.xhp	0	help	hd_id3143270	18			0	lt	1, 2 or 3				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120227.xhp	0	help	par_id3149491	19			0	lt	\<ahelp hid=\"SW:LISTBOX:TP_TOX_ENTRY:LB_THIRDKEY\"\>Select the entry by which to sort the bibliography entries. This option is only available if you select the \<emph\>Content\</emph\> radio button in the \<emph\>Sort by\</emph\> area.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120227.xhp	0	help	hd_id3149826	20			0	lt	AZ				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120227.xhp	0	help	par_id3147098	21			0	lt	\<ahelp hid=\"SW:IMAGERADIOBUTTON:TP_TOX_ENTRY:RB_SORTUP3\"\>Sorts the bibliography entries in ascending alphanumerical order.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120227.xhp	0	help	hd_id3148981	22			0	lt	ZA				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120227.xhp	0	help	par_id3149041	23			0	lt	\<ahelp hid=\"SW:IMAGERADIOBUTTON:TP_TOX_ENTRY:RB_SORTDOWN3\"\>Sorts the bibliography entries in a descending alphanumerical order.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120229.xhp	0	help	tit				0	lt	Define Bibliography Entry				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120229.xhp	0	help	hd_id3147176	1			0	lt	\<link href=\"text/swriter/01/04120229.xhp\" name=\"Define Bibliography Entry\"\>Define Bibliography Entry\</link\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120229.xhp	0	help	par_id3151183	2			0	lt	\<ahelp hid=\"HID_DLG_CREATE_AUTH_ENTRY\"\>Change the content of a bibliography entry.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120229.xhp	0	help	hd_id3151175	3			0	lt	Entry data				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120229.xhp	0	help	par_id3145419	4			0	lt	Enter a short name and select the appropriate source type. You can now enter data into the other fields belonging for the entry.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120229.xhp	0	help	hd_id3154097	5			0	lt	Short name				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120229.xhp	0	help	par_id3145582	6			0	lt	\<ahelp hid=\"HID_AUTH_FIELD_IDENTIFIER\"\>Displays the short name for the bibliography entry. You can only enter a name here if you are creating a new bibliography entry.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120229.xhp	0	help	par_id3153527	11			0	lt	\<ahelp hid=\"HID_AUTH_FIELD_CUSTOM4\"\>This is where you select the desired entry data for your bibliography.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120229.xhp	0	help	hd_id3155185	7			0	lt	Type				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120229.xhp	0	help	par_id3143283	8			0	lt	\<ahelp hid=\"HID_AUTH_FIELD_AUTHORITY_TYPE\"\>Select the source for the bibliography entry.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120229.xhp	0	help	par_id3147091	12			0	lt	\<link href=\"text/swriter/01/04120227.xhp\" name=\"Formatting bibliography entries\"\>Formatting bibliography entries\</link\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	tit				0	lt	Edit Concordance File				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	bm_id3148768				0	lt	\<bookmark_value\>editing; concordance files\</bookmark_value\>\<bookmark_value\>concordance files; definition\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	hd_id3148768	1			0	lt	Edit Concordance File				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3151180	2			0	lt	\<ahelp hid=\"HID_DLG_CREATE_AUTOMARK\"\>Create or edit a list of words to include in an Alphabetical Index.\</ahelp\> A concordance file lists words that should be referenced in an alphabetical index, together with the page number(s) where they appear in the document.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id837427				0	lt	You can use the Find All button on the Find & Replace dialog to highlight all places where a word appears, then open the Insert Index Entry dialog to add that word and places to the alphabetical index. However, if you need the same set of alphabetical indexes in multiple documents, the concordance file allows to enter every word just once, then use the list many times.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	hd_id3154645	19			0	lt	To access the Edit Concordance File dialog:				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3149292	20			0	lt	Choose \<emph\>Insert - Indexes and Tables - Indexes and Tables - Index/Table\</emph\>.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3145420	21			0	lt	In the \<emph\>Type \</emph\>box, select "Alphabetical Index".				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3154107	22			0	lt	In the \<emph\>Options \</emph\>area, select the \<emph\>Concordance file\</emph\> check box.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3153668	23			0	lt	Click the \<emph\>File\</emph\> button, and then choose \<emph\>New\</emph\> or \<emph\>Edit\</emph\>.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3154470	24			0	lt	A concordance file contains the following fields: 				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3152953	3			0	lt	"Search term" refers to the index entry that you want to mark in the document.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3155896	4			0	lt	"Alternative entry" refers to the index entry that you want to appear in the index.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3154194	5			0	lt	The 1st and 2nd Keys are parent index entries. The "Search term" or the "Alternative entry" appears as a subentry under the 1st and 2nd Keys.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3155184	6			0	lt	"Match case" means that uppercase and lowercase letters are considered.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3143282	7			0	lt	"Word only" searches for the term as a single word.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3147220	8			0	lt	To enable the "Match case" or "Word only" options, click in the corresponding cell, and then select the check box.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	hd_id3153629	25			0	lt	To create a concordance file without the Edit Concordance File dialog:				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3153644	9			0	lt	Use the following format guidelines when you create a concordance file:				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3152770	10			0	lt	Each entry in the concordance file is on a separate line.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3155142	26			0	lt	Commented lines start with #.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3153354	11			0	lt	Use the following format for the entries:				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3149172	12			0	lt	Search term;Alternative entry;1st key;2nd key;Match case;Word only				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3156270	13			0	lt	The entries "Match case" and "Word only" are interpreted as "No" or FALSE if they are empty or zero (0). All other contents are interpreted as "Yes" or TRUE.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	hd_id3145778	27			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3155907	14			0	lt	For example, to include the word "Boston" in your alphabetical index under the "Cities" entry, enter the following line in the concordance file:				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3151370	15			0	lt	Boston;Boston;Cities;;0;0 				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3151383	16			0	lt	This also finds "Boston" if it is written in lowercase letters.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3155866	17			0	lt	To include the "Beacon Hill" district in Boston under the "Cities" entry, enter the following line:				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3150116	18			0	lt	Beacon Hill;Boston;Cities; 				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	tit				0	lt	Insert Bibliography Entry				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	hd_id3151187	1			0	lt	Insert Bibliography Entry				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	par_id3154642	2			0	lt	\<variable id=\"literaturvz\"\>\<ahelp hid=\".uno:InsertAuthoritiesEntry\"\>Inserts a bibliography reference.\</ahelp\>\</variable\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	hd_id3145416	3			0	lt	Entry				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	hd_id3157721	15			0	lt	From bibliography database				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	par_id3154096	16			0	lt	\<ahelp hid=\"HID_AUTH_MARK_DLG_FROM_COMP_RB\"\>Inserts a reference from the bibliography database.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	hd_id3149805	17			0	lt	From document content				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	par_id3153536	18			0	lt	\<ahelp hid=\"HID_AUTH_MARK_DLG_FROM_DOC_RB\"\>Inserts a reference from the bibliography records that are stored in the current document.\</ahelp\> An entry that is stored in the document has priority over an entry that is stored in the bibliography database.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	par_id3154200	19			0	lt	When you save a document that contains bibliography entries, the corresponding records are automatically saved in a hidden field in the document.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	hd_id3143273	5			0	lt	Short name				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	par_id3149490	6			0	lt	\<ahelp hid=\"HID_AUTH_MARK_DLG_ID_LISTBOX\"\>Select the short name of the bibliography record that you want to insert.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	hd_id3151260	7			0	lt	Author, Title				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	par_id3149824	8			0	lt	If available, the author and the full title of the selected short name are displayed in this area.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	hd_id3149105	9			0	lt	Insert				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	par_id3147100	10			0	lt	\<ahelp hid=\"HID_INSERT_AUTH_MRK_OK\"\>Inserts the bibliographic reference into the document. If you created a new record, you must also insert it as an entry, otherwise the record is lost when you close the document.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	hd_id3147216	11			0	lt	Close				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	par_id3149036	12			0	lt	\<ahelp hid=\"HID_INSERT_AUTH_MRK_CLOSE\"\>Closes the dialog.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	hd_id3153634	13			0	lt	New				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	par_id3147579	14			0	lt	\<ahelp hid=\"HID_INSERT_AUTH_MRK_CREATE_ENTRY\"\>Opens the \<link href=\"text/swriter/01/04120229.xhp\" name=\"Define Bibliography Entry\"\>Define Bibliography Entry\</link\> dialog, where you can create a new bibliography record. This record is only stored in the document. To add a record to the bibliography database, choose \<emph\>Tools - Bibliography Database\</emph\>.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	hd_id3155142	20			0	lt	Edit				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	par_id3157900	21			0	lt	\<ahelp hid=\"HID_INSERT_AUTH_MRK_EDIT_ENTRY\"\>Opens the \<link href=\"text/swriter/01/04120229.xhp\" name=\"Define Bibliography Entry\"\>Define Bibliography Entry\</link\> dialog where you can edit the selected bibliography record.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	par_id3149172	22			0	lt	\<link href=\"text/swriter/guide/indices_literature.xhp\" name=\"Tips for working with bibliography entries\"\>Tips for working with bibliography entries\</link\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04130000.xhp	0	help	tit				0	lt	Frame				20130618 17:22:18
helpcontent2	source\text\swriter\01\04130000.xhp	0	help	hd_id3151189	1			0	lt	Frame				20130618 17:22:18
helpcontent2	source\text\swriter\01\04130000.xhp	0	help	par_id3145420	2			0	lt	\<variable id=\"rahm\"\>\<ahelp hid=\".uno:InsertFrame\"\>Inserts a frame that you can use to create a layout of one or more columns of text and objects.\</ahelp\>\</variable\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04130000.xhp	0	help	par_id3153678	37			0	lt	To edit a frame, click the border to select it, and then choose \<emph\>Format - Frame/Object\</emph\>. You can also resize or move a selected frame using special \<link href=\"text/swriter/01/04130100.xhp\" name=\"shortcut keys\"\>shortcut keys\</link\>.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04130000.xhp	0	help	par_id3152952	38			0	lt	To delete a frame, click the border of the frame, and then press Delete.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04130000.xhp	0	help	par_id3151311	23			0	lt	If you see small red arrows at the beginning and the end of text in frame, use the arrow keys to scroll through the remaining text.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04130000.xhp	0	help	par_id3155896	25			0	lt	In the preview area of the \<emph\>Frame\</emph\> dialog, the frame is represented by a green rectangle, and the reference area by a red rectangle.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04130000.xhp	0	help	par_id3149694	26			0	lt	You can also preview the effects when you change the frame anchor to "As Character". The "Baseline" is drawn in red, "Character" is the font height, and "line" is the height of the line, including the frame.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04130000.xhp	0	help	hd_id3149107	5			0	lt	Icon on the Insert toolbar:				20130618 17:22:18
helpcontent2	source\text\swriter\01\04130000.xhp	0	help	par_id3148970	6			0	lt	\<variable id=\"syrahmentext\"\>\<ahelp hid=\".uno:InsertFrameInteract\"\>Draws a frame where you drag in the document. Click the arrow next to the icon to select the number of columns for the frame.\</ahelp\>\</variable\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04130100.xhp	0	help	tit				0	lt	Resizing and Moving Frames, Objects With the Keyboard				20130618 17:22:18
helpcontent2	source\text\swriter\01\04130100.xhp	0	help	bm_id3154506				0	lt	\<bookmark_value\>moving;objects and frames\</bookmark_value\>\<bookmark_value\>objects;moving and resizing with keyboard\</bookmark_value\>\<bookmark_value\>resizing;objects and frames, by keyboard\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04130100.xhp	0	help	hd_id3154506	1			0	lt	Resizing and Moving Frames, Objects With the Keyboard				20130618 17:22:18
helpcontent2	source\text\swriter\01\04130100.xhp	0	help	par_id3145248	2			0	lt	You can resize and move selected frames and objects with the keyboard.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04130100.xhp	0	help	par_id3148771	4			0	lt	To move a selected frame or object, press an arrow key. To move by one pixel, hold down \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Option\</caseinline\>\<defaultinline\>Alt\</defaultinline\>\</switchinline\>, and then press an arrow key.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04130100.xhp	0	help	par_id3150762	5			0	lt	To resize a selected frame or object, first press Ctrl+Tab. Now one of the handles blinks to show that it is selected. To select another handle, press Ctrl+Tab again. Press an arrow key to resize the object by one grid unit. To resize by one pixel, hold down \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Option\</caseinline\>\<defaultinline\>Alt\</defaultinline\>\</switchinline\>, and then press an arrow key.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04130100.xhp	0	help	par_id3149294	6			0	lt	The increment by which you move an object with the keyboard is determined by the document grid. To change the properties of the document grid, choose \<emph\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - \<link href=\"text/shared/optionen/01050100.xhp\" name=\"Text document - Grid\"\>%PRODUCTNAME Writer - Grid\</link\>\</emph\>.				20130618 17:22:18
