helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_id7679372				0	lt	In a database window, choose \<emph\>Edit - Database - Advanced Settings\</emph\>         				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_id4572283				0	lt	The availability of the following controls depends on the type of database:				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN10590				0	lt	Use SQL92 naming constraints				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN10594				0	lt	\<ahelp hid=\".\"\>Only allows characters that conform to the SQL92 naming convention in a name in a data source. All other characters are rejected. Each name must begin with a lowercase letter, an uppercase letter, or an underscore ( _ ). The remaining characters can be ASCII letters, numbers, and underscores.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105907				0	lt	Use keyword AS before table alias names				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105947				0	lt	\<ahelp hid=\".\"\>Some databases use the keyword "AS" between a name and its alias, while other databases use a whitespace. Enable this option to insert AS before the alias.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	hd_id3534958				0	lt	End text lines with CR + LF				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_id6151921				0	lt	\<ahelp hid=\".\"\>Select to use the CR + LF code pair to end every text line (preferred for DOS and Windows operating systems).\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN1059E				0	lt	Append the table alias name in SELECT statements				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105A2				0	lt	\<ahelp hid=\".\"\>Appends the alias to the table name in SELECT statements.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105A5				0	lt	Use Outer Join syntax '{OJ }'				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105A9				0	lt	\<ahelp hid=\".\"\>Use escape sequences for outer joins. The syntax for this escape sequence is {oj outer-join}\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105BE				0	lt	Example:				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105C1				0	lt	select Article.* from {oj item LEFT OUTER JOIN orders ON item.no=orders.ANR}				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105C4				0	lt	Ignore the privileges from the database driver				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105C8				0	lt	\<ahelp hid=\".\"\>Ignores access privileges that are provided by the database driver.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105CB				0	lt	Replace named parameters with ?				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105CF				0	lt	\<ahelp hid=\".\"\>Replaces named parameters in a data source with a question mark (?).\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105D2				0	lt	Display version columns (when available)				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105D6				0	lt	Some databases assign version numbers to fields to track changes to records. The version number of a field is incremented by one each time the contents of the field are changed. \<ahelp hid=\"HID_DSADMIN_SUPPRESS_VERSIONCL\"\>Displays the internal version number of the record in the database table.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105FA				0	lt	Use the catalog name in SELECT statements				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105FE				0	lt	\<ahelp hid=\".\"\>Uses the current data source of the catalog. This option is useful when the ODBC data source is a database server. Do not select this option if the ODBC data source is a dBASE driver.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN10613				0	lt	Use the schema name in SELECT statements				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN10617				0	lt	\<ahelp hid=\".\"\>Allows you to use the schema name in SELECT statements.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN1061A				0	lt	Create index with ASC or DESC statement				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN1061E				0	lt	\<ahelp hid=\".\"\>Creates an index with ASC or DESC statements.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN10621				0	lt	Comparison of Boolean values				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN10625				0	lt	\<ahelp hid=\".\"\>Select the type of Boolean comparison that you want to use.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	hd_id1101718				0	lt	Form data input checks for required fields				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_id3783989				0	lt	\<ahelp hid=\".\"\>When you enter a new record or update an existing record in a form, and you leave a field empty which is bound to a database column which requires input, then you will see a message complaining about the empty field.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_id6684163				0	lt	If this control box is not enabled, then the forms in the current database will not be checked for required fields.				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_id3837397				0	lt	The control box is available for all data source types which support write access to their data. The control box does not exist for spreadsheets, text, csv, and the various read-only address books.				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	hd_id0909200811170166				0	lt	Ignore currency field information				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_id0909200811170221				0	lt	\<ahelp hid=\".\"\>Only for Oracle JDBC connections. When enabled it specifies that no column is treated as a currency field. The field type returned from the database driver is discarded.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	hd_id040920092139524				0	lt	Use ODBC conformant date/time literals				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_id040920092139526				0	lt	\<ahelp hid=\".\"\>Use date/time literals that conform to ODBC standard.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	hd_id04092009442139524				0	lt	Supports primary keys				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_id04096620092139526				0	lt	\<ahelp hid=\".\"\>Enable to overrule Base's heuristics used to detect whether the database supports primary keys.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_id66841631				0	lt	When connecting to a database using a generic API like ODBC, JDBC, or ADO, Base currently applies heuristics to determine whether this database supports primary keys. None of those APIs has dedicated support to retrieve this information.				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_id66841632				0	lt	The heuristics sometimes fails. This tri-state check box by default is set to the undetermined state, which means "apply the heuristics". If the check box is enabled, primary key support is assumed. If the check box is disabled, no primary key support is assumed.				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_id66841633				0	lt	Note that if this option is just for overruling the heuristics. If you enable the check box for a database which actually does not support primary keys, you will see some errors.				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropgen.xhp	0	help	tit				0	lt	Generated Values				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropgen.xhp	0	help	par_idN10553				0	lt	\<link href=\"text/shared/explorer/database/dabaadvpropgen.xhp\"\>Generated Values\</link\>				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropgen.xhp	0	help	par_idN10563				0	lt	Specifies the options for automatically generated values for new data records.				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropgen.xhp	0	help	par_id7684560				0	lt	The availability of the following controls depends on the type of database:				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropgen.xhp	0	help	par_idN1058C				0	lt	Retrieve generated values				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropgen.xhp	0	help	par_idN10590				0	lt	\<ahelp hid=\".\"\>Enables $[officename] support for auto-incremented data fields in the current ODBC or JDBC data source. Select this option if the auto-increment feature in the SDBCX layer of the database is not supported. In general, the auto-increment is selected for the primary key field.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropgen.xhp	0	help	par_idN10593				0	lt	Auto-increment statement				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropgen.xhp	0	help	par_idN10597				0	lt	\<ahelp hid=\".\"\>Enter the SQL command specifier that instructs the data source to auto-increment a specified Integer data field.\</ahelp\> For example, the following MySQL statement used the AUTO_INCREMENT statement to increase the "id" field each time the statement creates a data field:				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropgen.xhp	0	help	par_idN105A0				0	lt	CREATE TABLE "table1" ("id" INTEGER AUTO_INCREMENT)				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropgen.xhp	0	help	par_idN10634				0	lt	For this example, you must enter AUTO_INCREMENT into the \<emph\>Auto-increment statement\</emph\> box.				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropgen.xhp	0	help	par_idN105AA				0	lt	Query of generated values				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropgen.xhp	0	help	par_idN10645				0	lt	\<ahelp hid=\".\"\>Enter an SQL statement that returns the last auto-incremented value for the primary key data field.\</ahelp\> For example:				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\dabaadvpropgen.xhp	0	help	par_idN105B1				0	lt	SELECT LAST_INSERT_D();				20130618 17:22:18
