helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3154685	4			0	lt	MsgBox (Text As String [,Type As Integer [,Dialogtitle As String]])				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	hd_id3153771	5			0	lt	Return value:				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3146985	6			0	lt	Integer				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	hd_id3153363	7			0	lt	Parameter:				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3153727	8			0	lt	\<emph\>Text\</emph\>: String expression displayed as a message in the dialog box. Line breaks can be inserted with Chr$(13).				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3147317	9			0	lt	\<emph\>DialogTitle\</emph\>: String expression displayed in the title bar of the dialog. If omitted, the name of the respective application is displayed.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3153954	10			0	lt	\<emph\>Type\</emph\>: Any integer expression that specifies the dialog type and defines the number and type of buttons or icons displayed. \<emph\>Type\</emph\> represents a combination of bit patterns (dialog elements defined by adding the respective values):				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3154319	11			0	lt	\<emph\>Values\</emph\>				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3147397	12			0	lt	0 : Display OK button only.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3145646	13			0	lt	1 : Display OK and Cancel buttons.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3149410	14			0	lt	2 : Display Abort, Retry, and Ignore buttons.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3151075	15			0	lt	3 : Display Yes, No, and Cancel buttons.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3153878	16			0	lt	4 : Display Yes and No buttons.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3155601	17			0	lt	5 : Display Retry and Cancel buttons.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3150716	18			0	lt	16 : Add the Stop icon to the dialog.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3153837	19			0	lt	32 : Add the Question icon to the dialog.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3150751	20			0	lt	48 : Add the Exclamation Point icon to the dialog.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3146915	21			0	lt	64 : Add the Information icon to the dialog.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3145640	22			0	lt	128 : First button in the dialog as default button.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3153765	23			0	lt	256 : Second button in the dialog as default button.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3153715	24			0	lt	512 : Third button in the dialog as default button.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3159267	25			0	lt	\<emph\>Return value:\</emph\>				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3145230	26			0	lt	1 : OK				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3149567	27			0	lt	2 : Cancel				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id4056825				0	lt	3 : Abort				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3155335	28			0	lt	4 : Retry				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3146918	29			0	lt	5 : Ignore				20130618 17:22:18
