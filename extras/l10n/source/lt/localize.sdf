helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145600	191			0	lt	DEGREES(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149484	192			0	lt	\<emph\>Number\</emph\> is the angle in radians to be converted to degrees.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3669545				0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3459578				0	lt	\<item type=\"input\"\>=DEGREES(PI())\</item\> returns 180 degrees.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3148698				0	lt	\<bookmark_value\>EXP function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3148698	198			0	lt	EXP				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150592	199			0	lt	\<ahelp hid=\"HID_FUNC_EXP\"\>Returns e raised to the power of a number.\</ahelp\> The constant e has a value of approximately 2.71828182845904.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150351	200			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146786	201			0	lt	EXP(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155608	202			0	lt	\<emph\>Number\</emph\> is the power to which e is to be raised.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154418	203			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156340	204			0	lt	\<item type=\"input\"\>=EXP(1)\</item\> returns 2.71828182845904, the mathematical constant e to Calc's accuracy.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3145781				0	lt	\<bookmark_value\>FACT function\</bookmark_value\>\<bookmark_value\>factorials;numbers\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145781	208			0	lt	FACT				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151109	209			0	lt	\<ahelp hid=\"HID_FUNC_FAKULTAET\"\>Returns the factorial of a number.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146902	210			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154661	211			0	lt	FACT(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152952	212			0	lt	 Returns Number!, the factorial of \<emph\>Number\</emph\>, calculated as 1*2*3*4* ... * Number.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3834650				0	lt	=FACT(0) returns 1 by definition. 				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8429517				0	lt	The factorial of a negative number returns the "invalid argument" error.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154569	213			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154476	216			0	lt	\<item type=\"input\"\>=FACT(3)\</item\> returns 6.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147525	214			0	lt	\<item type=\"input\"\>=FACT(0)\</item\> returns 1.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3159084				0	lt	\<bookmark_value\>INT function\</bookmark_value\>\<bookmark_value\>numbers;rounding down to next integer\</bookmark_value\>\<bookmark_value\>rounding;down to next integer\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3159084	218			0	lt	INT				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158441	219			0	lt	\<ahelp hid=\"HID_FUNC_GANZZAHL\"\>Rounds a number down to the nearest integer.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146132	220			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156146	221			0	lt	INT(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154117	222			0	lt	Returns \<emph\>Number\</emph\> rounded down to the nearest integer.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id153508				0	lt	Negative numbers round down to the integer below.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155118	223			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156267	224			0	lt	\<item type=\"input\"\>=INT(5.7)\</item\> returns 5.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147323	225			0	lt	\<item type=\"input\"\>=INT(-1.3)\</item\> returns -2.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3150938				0	lt	\<bookmark_value\>EVEN function\</bookmark_value\>\<bookmark_value\>numbers;rounding up/down to even integers\</bookmark_value\>\<bookmark_value\>rounding;up/down to even integers\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150938	227			0	lt	EVEN				20130618 17:22:18
