helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11BA1				0	lt	\<item type=\"input\"\>=SUMPRODUCT(A1:B3;C1:D3)\</item\> returns 397.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11BA4				0	lt	Calculation: A1*C1 + B1*D1 + A2*C2 + B2*D2 + A3*C3 + B3*D3				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11BA7				0	lt	You can use SUMPRODUCT to calculate the scalar product of two vectors.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11BBC				0	lt	SUMPRODUCT returns a single number, it is not necessary to enter the function as an array function.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11C91				0	lt	\<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3144842				0	lt	\<bookmark_value\>SUMX2MY2 function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3144842	169			0	lt	SUMX2MY2				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3144871	170			0	lt	\<ahelp hid=\"HID_FUNC_SUMMEX2MY2\"\>Returns the sum of the difference of squares of corresponding values in two arrays.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3144889	171			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3144903	172			0	lt	SUMX2MY2(ArrayX; ArrayY)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3144916	173			0	lt	\<emph\>ArrayX\</emph\> represents the first array whose elements are to be squared and added.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3144936	174			0	lt	\<emph\>ArrayY\</emph\> represents the second array whose elements are to be squared and subtracted.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11D6B				0	lt	\<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3145026				0	lt	\<bookmark_value\>SUMX2PY2 function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3145026	178			0	lt	SUMX2PY2				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3145055	179			0	lt	\<ahelp hid=\"HID_FUNC_SUMMEX2PY2\"\>Returns the sum of the sum of squares of corresponding values in two arrays.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3163390	180			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163404	181			0	lt	SUMX2PY2(ArrayX; ArrayY)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163417	182			0	lt	\<emph\>ArrayX\</emph\> represents the first array whose arguments are to be squared and added.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163437	183			0	lt	\<emph\>ArrayY\</emph\> represents the second array, whose elements are to be squared and added.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11E45				0	lt	\<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3163527				0	lt	\<bookmark_value\>SUMXMY2 function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3163527	187			0	lt	SUMXMY2				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163556	188			0	lt	\<ahelp hid=\"HID_FUNC_SUMMEXMY2\"\>Adds the squares of the variance between corresponding values in two arrays.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3163574	189			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163588	190			0	lt	SUMXMY2(ArrayX; ArrayY)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163601	191			0	lt	\<emph\>ArrayX\</emph\> represents the first array whose elements are to be subtracted and squared.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163621	192			0	lt	\<emph\>ArrayY\</emph\> represents the second array, whose elements are to be subtracted and squared.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11F1F				0	lt	\<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3166062				0	lt	\<bookmark_value\>TREND function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3166062	196			0	lt	TREND				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166091	197			0	lt	\<ahelp hid=\"HID_FUNC_TREND\"\>Returns values along a linear trend.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3166109	198			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166122	199			0	lt	TREND(DataY; DataX; NewDataX; LinearType)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166137	200			0	lt	\<emph\>DataY\</emph\> represents the Y Data array.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166156	201			0	lt	\<emph\>DataX\</emph\> (optional) represents the X Data array.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166176	202			0	lt	\<emph\>NewDataX\</emph\> (optional) represents the array of the X data, which are used for recalculating values.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166196	203			0	lt	\<emph\>LinearType\</emph\>(Optional). If LinearType = 0, then lines will be calculated through the zero point. Otherwise, offset lines will also be calculated. The default is LinearType <> 0.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11D2F				0	lt	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN12019				0	lt	\<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3166231	204			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166245	205			0	lt	Select a spreadsheet range in which the trend data will appear. Select the function. Enter the output data or select it with the mouse. Mark the \<emph\>Array\</emph\> field. click \<emph\>OK\</emph\>. The trend data calculated from the output data is displayed.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3166317				0	lt	\<bookmark_value\>GROWTH function\</bookmark_value\>\<bookmark_value\>exponential trends in arrays\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3166317	207			0	lt	GROWTH				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166346	208			0	lt	\<ahelp hid=\"HID_FUNC_VARIATION\"\>Calculates the points of an exponential trend in an array.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3166364	209			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166377	210			0	lt	GROWTH(DataY; DataX; NewDataX; FunctionType)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166392	211			0	lt	\<emph\>DataY\</emph\> represents the Y Data array.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166411	212			0	lt	\<emph\>DataX\</emph\> (optional) represents the X Data array.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3173797	213			0	lt	\<emph\>NewDataX\</emph\> (optional) represents the X data array, in which the values are recalculated.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3173817	214			0	lt	\<emph\>FunctionType\</emph\>(optional). If FunctionType = 0, functions in the form y = m^x will be calculated. Otherwise, y = b*m^x functions will be calculated.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11DFD				0	lt	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN12113				0	lt	\<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3173839	215			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3173852	216			0	lt	This function returns an array and is handled in the same way as the other array functions. Select a range where you want the answers to appear and select the function. Select DataY. Enter any other parameters, mark \<emph\>Array\</emph\> and click \<emph\>OK\</emph\>.				20130618 17:22:18
