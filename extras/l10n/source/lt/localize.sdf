helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3154502	204			0	lt	0 or missing				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3149877	205			0	lt	US method (NASD), 12 months of 30 days each				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3148766	250			0	lt	1				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3154326	206			0	lt	Exact number of days in months, exact number of days in year				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3145245	251			0	lt	2				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3155620	207			0	lt	Exact number of days in month, year has 360 days				20130618 17:22:18
