helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3147167	2			0	lt	\<variable id=\"fussnoteein\"\>\<ahelp hid=\".uno:InsertFootnote\"\>Inserts a footnote or an endnote in the document. The anchor for the note is inserted at the current cursor position.\</ahelp\> You can choose between automatic numbering or a custom symbol. \</variable\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3154645	23			0	lt	\<variable id=\"endnoten\"\>The following applies to both footnotes and endnotes. \</variable\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3151175	24			0	lt	\<variable id=\"endnotetext\"\>Footnotes are inserted at the end of a page, and endnotes are inserted at the end of a document. \</variable\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	hd_id3154106	7			0	lt	Numbering				20130618 17:22:18
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3149812	16			0	lt	Select the type of numbering that you want to use for footnotes and endnotes.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	hd_id3154470	8			0	lt	Automatic				20130618 17:22:18
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3153670	17			0	lt	\<variable id=\"bearbeitenautomatisch\"\>\<ahelp hid=\"SW:RADIOBUTTON:DLG_INS_FOOTNOTE:RB_NUMBER_AUTO\"\>Automatically assigns consecutive numbers to the footnotes or endnotes that you insert.\</ahelp\> To change the settings for automatic numbering, choose \<link href=\"text/swriter/01/06080000.xhp\" name=\"Tools - Footnotes\"\>\<emph\>Tools - Footnotes/Endnotes\</emph\>\</link\>. \</variable\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	hd_id3152952	9			0	lt	Character				20130618 17:22:18
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3155901	18			0	lt	\<variable id=\"bearbeitenzeichen\"\>\<ahelp hid=\"SW:EDIT:DLG_INS_FOOTNOTE:ED_NUMBER_CHAR\"\>Choose this option to define a character or symbol for the current footnote.\</ahelp\> This can be either a letter or number. To assign a special character, click the button at the bottom. \</variable\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	hd_id3155185	10			0	lt	...				20130618 17:22:18
