helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3166448	37			0	lt	sEntry(5) = "David"				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3149255	38			0	lt	sEntry(6) = "Cathy"				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3149565	39			0	lt	sEntry(7) = "Susie"				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3145148	40			0	lt	sEntry(8) = "Edward"				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3145229	41			0	lt	sEntry(9) = "Christine"				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3149107	44			0	lt	For iCount = 0 To 9				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3148485	45			0	lt	For iCount2 = iCount + 1 To 9				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3155608	46			0	lt	If sEntry(iCount) > sEntry(iCount2) Then				20130618 17:22:18
