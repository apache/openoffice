helpcontent2	source\text\scalc\01\04060103.xhp	0	help	tit				0	lt	Financial Functions Part One				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3143284				0	lt	\<bookmark_value\>financial functions\</bookmark_value\>      \<bookmark_value\>functions; financial functions\</bookmark_value\>      \<bookmark_value\>Function Wizard; financial\</bookmark_value\>      \<bookmark_value\>amortizations, see also depreciations\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3143284	1			0	lt	Financial Functions Part One				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149095	2			0	lt	\<variable id=\"finanztext\"\>This category contains the mathematical finance functions of \<item type=\"productname\"\>%PRODUCTNAME\</item\> Calc. \</variable\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3153366				0	lt	\<bookmark_value\>AMORDEGRC function\</bookmark_value\>         \<bookmark_value\>depreciations;degressive amortizations\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3153366	359			0	lt	AMORDEGRC				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147434	360			0	lt	\<ahelp hid=\"HID_AAI_FUNC_AMORDEGRC\"\>Calculates the amount of depreciation for a settlement period as degressive amortization.\</ahelp\> Unlike AMORLINC, a depreciation coefficient that is independent of the depreciable life is used here.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3155855	361			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147427	362			0	lt	AMORDEGRC(Cost; DatePurchased; FirstPeriod; Salvage; Period; Rate; Basis)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147125	363			0	lt	            \<emph\>Cost\</emph\> is the acquisition costs.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3151074	364			0	lt	            \<emph\>DatePurchased\</emph\> is the date of acquisition.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3144765	365			0	lt	            \<emph\>FirstPeriod \</emph\>is the end date of the first settlement period.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156286	366			0	lt	            \<emph\>Salvage\</emph\> is the salvage value of the capital asset at the end of the depreciable life.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153415	367			0	lt	            \<emph\>Period\</emph\> is the settlement period to be considered.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155064	368			0	lt	            \<emph\>Rate\</emph\> is the rate of depreciation.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3153765				0	lt	\<bookmark_value\>AMORLINC function\</bookmark_value\>         \<bookmark_value\>depreciations;linear amortizations\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3153765	369			0	lt	AMORLINC				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159264	370			0	lt	\<ahelp hid=\"HID_AAI_FUNC_AMORLINC\"\>Calculates the amount of depreciation for a settlement period as linear amortization. If the capital asset is purchased during the settlement period, the proportional amount of depreciation is considered.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3150044	371			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147363	372			0	lt	AMORLINC(Cost; DatePurchased; FirstPeriod; Salvage; Period; Rate; Basis)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146920	373			0	lt	            \<emph\>Cost\</emph\> means the acquisition costs.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3163807	374			0	lt	            \<emph\>DatePurchased\</emph\> is the date of acquisition.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148488	375			0	lt	            \<emph\>FirstPeriod \</emph\>is the end date of the first settlement period.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149530	376			0	lt	            \<emph\>Salvage\</emph\> is the salvage value of the capital asset at the end of the depreciable life.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148633	377			0	lt	            \<emph\>Period\</emph\> is the settlement period to be considered.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150982	378			0	lt	            \<emph\>Rate\</emph\> is the rate of depreciation.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3145257				0	lt	\<bookmark_value\>ACCRINT function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3145257	335			0	lt	ACCRINT				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3151276				0	lt	\<bookmark_value\>accrued interests;periodic payments\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3151276	336			0	lt	\<ahelp hid=\"HID_AAI_FUNC_ACCRINT\"\>Calculates the accrued interest of a security in the case of periodic payments.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3152581	337			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159092	338			0	lt	ACCRINT(Issue; FirstInterest; Settlement; Rate; Par; Frequency; Basis)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150519	339			0	lt	            \<emph\>Issue\</emph\> is the issue date of the security.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155376	340			0	lt	            \<emph\>FirstInterest\</emph\> is the first interest date of the security.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3166431	341			0	lt	            \<emph\>Settlement\</emph\> is the date at which the interest accrued up until then is to be calculated.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154486	342			0	lt	            \<emph\>Rate\</emph\> is the annual nominal rate of interest (coupon interest rate)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156445	343			0	lt	            \<emph\>Par\</emph\> is the par value of the security.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149406	344			0	lt	            \<emph\>Frequency\</emph\> is the number of interest payments per year (1, 2 or 4).				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3148699	345			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148599	346			0	lt	A security is issued on 2001-02-28. First interest is set for 2001-08-31. The settlement date is 2001-05-01. The Rate is 0.1 or 10% and Par is 1000 currency units. Interest is paid half-yearly (frequency is 2). The basis is the US method (0). How much interest has accrued?				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148840	347			0	lt	            \<item type=\"input\"\>=ACCRINT("2001-02-28";"2001-08-31";"2001-05-01";0.1;1000;2;0)\</item\> returns 16.94444.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3151240				0	lt	\<bookmark_value\>ACCRINTM function\</bookmark_value\>         \<bookmark_value\>accrued interests;one-off payments\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3151240	348			0	lt	ACCRINTM				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3157981	349			0	lt	\<ahelp hid=\"HID_AAI_FUNC_ACCRINTM\"\>Calculates the accrued interest of a security in the case of one-off payment at the settlement date.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3159097	350			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147074	351			0	lt	ACCRINTM(Issue; Settlement; Rate; Par; Basis)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3144773	352			0	lt	            \<emph\>Issue\</emph\> is the issue date of the security.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154956	353			0	lt	            \<emph\>Settlement\</emph\> is the date at which the interest accrued up until then is to be calculated.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153972	354			0	lt	            \<emph\>Rate\</emph\> is the annual nominal rate of interest (coupon interest rate).				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159204	355			0	lt	            \<emph\>Par\</emph\> is the par value of the security.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3155384	356			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154541	357			0	lt	A security is issued on 2001-04-01. The maturity date is set for 2001-06-15. The Rate is 0.1 or 10% and Par is 1000 currency units. The basis of the daily/annual calculation is the daily balance (3). How much interest has accrued?				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149128	358			0	lt	            \<item type=\"input\"\>=ACCRINTM("2001-04-01";"2001-06-15";0.1;1000;3)\</item\> returns 20.54795.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3145753				0	lt	\<bookmark_value\>RECEIVED function\</bookmark_value\>         \<bookmark_value\>amount received for fixed-interest securities\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3145753	390			0	lt	RECEIVED				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150051	391			0	lt	\<ahelp hid=\"HID_AAI_FUNC_RECEIVED\"\>Calculates the amount received that is paid for a fixed-interest security at a given point in time.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3149385	392			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145362	393			0	lt	RECEIVED("Settlement"; "Maturity"; Investment; Discount; Basis)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154654	394			0	lt	            \<emph\>Settlement\</emph\> is the date of purchase of the security.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153011	395			0	lt	            \<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155525	396			0	lt	            \<emph\>Investment\</emph\> is the purchase sum.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155760	397			0	lt	            \<emph\>Discount\</emph\> is the percentage discount on acquisition of the security.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3154710	398			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154735	399			0	lt	Settlement date: February 15 1999, maturity date: May 15 1999, investment sum: 1000 currency units, discount: 5.75 per cent, basis: Daily balance/360 = 2.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146108	400			0	lt	The amount received on the maturity date is calculated as follows:				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147246	401			0	lt	            \<item type=\"input\"\>=RECEIVED("1999-02-15";"1999-05-15";1000;0.0575;2)\</item\> returns 1014.420266.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3147556				0	lt	\<bookmark_value\>PV function\</bookmark_value\>         \<bookmark_value\>present values\</bookmark_value\>         \<bookmark_value\>calculating; present values\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3147556	3			0	lt	PV				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153301	4			0	lt	\<ahelp hid=\"HID_FUNC_BW\"\>Returns the present value of an investment resulting from a series of regular payments.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146099	5			0	lt	Use this function to calculate the amount of money needed to be invested at a fixed rate today, to receive a specific amount, an annuity, over a specified number of periods. You can also determine how much money is to remain after the elapse of the period. Specify as well if the amount is to be paid out at the beginning or at the end of each period.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153334	6			0	lt	Enter these values either as numbers, expressions or references. If, for example, interest is paid annually at 8%, but you want to use month as your period, enter 8%/12 under \<emph\>Rate\</emph\> and \<item type=\"productname\"\>%PRODUCTNAME\</item\> Calc with automatically calculate the correct factor.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3147407	7			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150395	8			0	lt	PV(Rate; NPer; Pmt; FV; Type)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3151341	9			0	lt	            \<emph\>Rate\</emph\> defines the interest rate per period.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153023	10			0	lt	            \<emph\>NPer\</emph\> is the total number of periods (payment period).				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146323	11			0	lt	            \<emph\>Pmt\</emph\> is the regular payment made per period.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150536	12			0	lt	            \<emph\>FV\</emph\> (optional) defines the future value remaining after the final installment has been made.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146883	13			0	lt	            \<emph\>Type\</emph\> (optional) denotes due date for payments. Type = 1 means due at the beginning of a period and Type = 0 (default) means due at the end of the period.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_idN10B13				0	lt	            \<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>         				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3150037	14			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145225	15			0	lt	What is the present value of an investment, if 500 currency units are paid out monthly and the annual interest rate is 8%? The payment period is 48 months and 20,000 currency units are to remain at the end of the payment period.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155907	16			0	lt	            \<item type=\"input\"\>=PV(8%/12;48;500;20000)\</item\> = -35,019.37 currency units. Under the named conditions, you must deposit 35,019.37 currency units today, if you want to receive 500 currency units per month for 48 months and have 20,000 currency units left over at the end. Cross-checking shows that 48 x 500 currency units + 20,000 currency units = 44,000 currency units. The difference between this amount and the 35,000 currency units deposited represents the interest paid.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149150	17			0	lt	If you enter references instead of these values into the formula, you can calculate any number of "If-then" scenarios. Please note: references to constants must be defined as absolute references. Examples of this type of application are found under the depreciation functions.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3152978				0	lt	\<bookmark_value\>calculating; depreciations\</bookmark_value\>         \<bookmark_value\>SYD function\</bookmark_value\>         \<bookmark_value\>depreciations; arithmetic declining\</bookmark_value\>         \<bookmark_value\>arithmetic declining depreciations\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3152978	19			0	lt	SYD				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148732	20			0	lt	\<ahelp hid=\"HID_FUNC_DIA\"\>Returns the arithmetic-declining depreciation rate.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149886	21			0	lt	Use this function to calculate the depreciation amount for one period of the total depreciation span of an object. Arithmetic declining depreciation reduces the depreciation amount from period to period by a fixed sum.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3149431	22			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150483	23			0	lt	SYD(Cost; Salvage; Life; Period)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146879	24			0	lt	            \<emph\>Cost\</emph\> is the initial cost of an asset.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147423	25			0	lt	            \<emph\>Salvage\</emph\> is the value of an asset after depreciation.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3151229	26			0	lt	            \<emph\>Life\</emph\> is the period fixing the time span over which an asset is depreciated.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147473	27			0	lt	            \<emph\>Period\</emph\> defines the period for which the depreciation is to be calculated.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3148434	28			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149688	29			0	lt	A video system initially costing 50,000 currency units is to be depreciated annually for the next 5 years. The salvage value is to be 10,000 currency units. You want to calculate depreciation for the first year.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150900	30			0	lt	            \<item type=\"input\"\>=SYD(50000;10000;5;1)\</item\>=13,333.33 currency units. The depreciation amount for the first year is 13,333.33 currency units.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146142	31			0	lt	To have an overview of depreciation rates per period, it is best to define a depreciation table. By entering the different depreciation formulas available in \<item type=\"productname\"\>%PRODUCTNAME\</item\> Calc next to each other, you can see which depreciation form is the most appropriate. Enter the table as follows:				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155258	32			0	lt	                     \<emph\>A\</emph\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154558	33			0	lt	                     \<emph\>B\</emph\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3152372	34			0	lt	                     \<emph\>C\</emph\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149949	35			0	lt	                     \<emph\>D\</emph\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145123	36			0	lt	                     \<emph\>E\</emph\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149504	37			0	lt	1				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153778	38			0	lt	                     \<item type=\"input\"\>Initial Cost\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159083	39			0	lt	                     \<item type=\"input\"\>Salvage Value\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150002	40			0	lt	                     \<item type=\"input\"\>Useful Life\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153006	41			0	lt	                     \<item type=\"input\"\>Time Period\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154505	42			0	lt	                     \<item type=\"input\"\>Deprec. SYD\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150336	43			0	lt	2				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155926	44			0	lt	                     \<item type=\"input\"\>50,000 currency units\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153736	45			0	lt	                     \<item type=\"input\"\>10,000 currency units\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150131	46			0	lt	                     \<item type=\"input\"\>5\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148766	47			0	lt	                     \<item type=\"input\"\>1\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159136	48			0	lt	                     \<item type=\"input\"\>13,333.33 currency units\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3151018	49			0	lt	3				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148397	50			0	lt	                     \<item type=\"input\"\>2\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146907	51			0	lt	                     \<item type=\"input\"\>10,666.67 currency units\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147356	52			0	lt	4				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150267	53			0	lt	                     \<item type=\"input\"\>3\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145628	54			0	lt	                     \<item type=\"input\"\>8,000.00 currency units\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149004	55			0	lt	5				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153545	56			0	lt	                     \<item type=\"input\"\>4\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154634	57			0	lt	                     \<item type=\"input\"\>5,333.33 currency units\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147537	58			0	lt	6				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155085	59			0	lt	                     \<item type=\"input\"\>5\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3158413	60			0	lt	                     \<item type=\"input\"\>2,666.67 currency units\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154866	61			0	lt	7				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155404	62			0	lt	                     \<item type=\"input\"\>6\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148431	63			0	lt	                     \<item type=\"input\"\>0.00 currency units\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156261	64			0	lt	8				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3083286	65			0	lt	                     \<item type=\"input\"\>7\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3083443	67			0	lt	9				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154815	68			0	lt	                     \<item type=\"input\"\>8\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145082	70			0	lt	10				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156307	71			0	lt	                     \<item type=\"input\"\>9\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147564	73			0	lt	11				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146856	74			0	lt	                     \<item type=\"input\"\>10\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150880	76			0	lt	12				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145208	77			0	lt	13				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156113	78			0	lt	                     \<item type=\"input\"\>>0\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153625	79			0	lt	                     \<item type=\"input\"\>Total\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3151297	80			0	lt	                     \<item type=\"input\"\>40,000.00 currency units\</item\>                  				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149979	81			0	lt	The formula in E2 is as follows:				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155849	82			0	lt	            \<item type=\"input\"\>=SYD($A$2;$B$2;$C$2;D2)\</item\>         				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156124	83			0	lt	This formula is duplicated in column E down to E11 (select E2, then drag down the lower right corner with the mouse).				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147270	84			0	lt	Cell E13 contains the formula used to check the total of the depreciation amounts. It uses the SUMIF function as the negative values in E8:E11 must not be considered. The condition >0 is contained in cell A13. The formula in E13 is as follows:				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3152811	85			0	lt	            \<item type=\"input\"\>=SUMIF(E2:E11;A13)\</item\>         				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155998	86			0	lt	Now view the depreciation for a 10 year period, or at a salvage value of 1 currency unit, or enter a different initial cost, and so on.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3155104				0	lt	\<bookmark_value\>DISC function\</bookmark_value\>         \<bookmark_value\>allowances\</bookmark_value\>         \<bookmark_value\>discounts\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3155104	379			0	lt	DISC				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153891	380			0	lt	\<ahelp hid=\"HID_AAI_FUNC_DISC\"\>Calculates the allowance (discount) of a security as a percentage.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3153982	381			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149756	382			0	lt	DISC("Settlement"; "Maturity"; Price; Redemption; Basis)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156014	383			0	lt	            \<emph\>Settlement\</emph\> is the date of purchase of the security.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154304	384			0	lt	            \<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159180	385			0	lt	            \<emph\>Price\</emph\> is the price of the security per 100 currency units of par value.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147253	386			0	lt	            \<emph\>Redemption\</emph\> is the redemption value of the security per 100 currency units of par value.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3151174	387			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155902	388			0	lt	A security is purchased on 2001-01-25; the maturity date is 2001-11-15. The price (purchase price) is 97, the redemption value is 100. Using daily balance calculation (basis 3) how high is the settlement (discount)?				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3152797	389			0	lt	            \<item type=\"input\"\>=DISC("2001-01-25";"2001-11-15";97;100;3)\</item\> returns about 0.0372 or 3.72 per cent.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3154695				0	lt	\<bookmark_value\>DURATION_ADD function\</bookmark_value\>         \<bookmark_value\>Microsoft Excel functions\</bookmark_value\>         \<bookmark_value\>durations;fixed interest securities\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3154695	402			0	lt	DURATION_ADD				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145768	403			0	lt	\<ahelp hid=\"HID_AAI_FUNC_DURATION\"\>Calculates the duration of a fixed interest security in years.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3153904	404			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153373	405			0	lt	DURATION_ADD("Settlement"; "Maturity"; Coupon; Yield; Frequency; Basis)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155397	406			0	lt	            \<emph\>Settlement\</emph\> is the date of purchase of the security.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148558	407			0	lt	            \<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153096	408			0	lt	            \<emph\>Coupon\</emph\> is the annual coupon interest rate (nominal rate of interest)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154594	409			0	lt	            \<emph\>Yield\</emph\> is the annual yield of the security.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149906	410			0	lt	            \<emph\>Frequency\</emph\> is the number of interest payments per year (1, 2 or 4).				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3146995	411			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148834	412			0	lt	A security is purchased on 2001-01-01; the maturity date is 2006-01-01. The Coupon rate of interest is 8%. The yield is 9.0%. Interest is paid half-yearly (frequency is 2). Using daily balance interest calculation (basis 3) how long is the duration?				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154902	413			0	lt	            \<item type=\"input\"\>=DURATION_ADD("2001-01-01";"2006-01-01";0.08;0.09;2;3)\</item\>         				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3159147				0	lt	\<bookmark_value\>annual net interest rates\</bookmark_value\>         \<bookmark_value\>calculating; annual net interest rates\</bookmark_value\>         \<bookmark_value\>net annual interest rates\</bookmark_value\>         \<bookmark_value\>EFFECTIVE function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3159147	88			0	lt	EFFECTIVE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154204	89			0	lt	\<ahelp hid=\"HID_FUNC_EFFEKTIV\"\>Returns the net annual interest rate for a nominal interest rate.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145417	90			0	lt	Nominal interest refers to the amount of interest due at the end of a calculation period. Effective interest increases with the number of payments made. In other words, interest is often paid in installments (for example, monthly or quarterly) before the end of the calculation period.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3150510	91			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148805	92			0	lt	EFFECTIVE(Nom; P)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149768	93			0	lt	            \<emph\>Nom\</emph\> is the nominal interest.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149334	94			0	lt	            \<emph\>P\</emph\> is the number of interest payment periods per year.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3154223	95			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3144499	96			0	lt	If the annual nominal interest rate is 9.75% and four interest calculation periods are defined, what is the actual interest rate (effective rate)?				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150772	97			0	lt	            \<item type=\"input\"\>=EFFECTIVE(9.75%;4)\</item\> = 10.11% The annual effective rate is therefore 10.11%.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3147241				0	lt	\<bookmark_value\>effective interest rates\</bookmark_value\>         \<bookmark_value\>EFFECT_ADD function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3147241	414			0	lt	EFFECT_ADD				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147524	415			0	lt	\<ahelp hid=\"HID_AAI_FUNC_EFFECT\"\>Calculates the effective annual rate of interest on the basis of the nominal interest rate and the number of interest payments per annum.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3155364	416			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155118	417			0	lt	EFFECT_ADD(NominalRate; NPerY)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148907	418			0	lt	            \<emph\>NominalRate\</emph\> is the annual nominal rate of interest.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154274	419			0	lt	            \<emph\>NPerY \</emph\>is the number of interest payments per year.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3149156	420			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3158426	421			0	lt	What is the effective annual rate of interest for a 5.25% nominal rate and quarterly payment.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148927	422			0	lt	            \<item type=\"input\"\>=EFFECT_ADD(0.0525;4)\</item\> returns 0.053543 or 5.3543%.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3149998				0	lt	\<bookmark_value\>calculating; arithmetic-degressive depreciations\</bookmark_value\>         \<bookmark_value\>arithmetic-degressive depreciations\</bookmark_value\>         \<bookmark_value\>depreciations;arithmetic-degressive\</bookmark_value\>         \<bookmark_value\>DDB function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3149998	99			0	lt	DDB				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159190	100			0	lt	\<ahelp hid=\"HID_FUNC_GDA\"\>Returns the depreciation of an asset for a specified period using the arithmetic-declining method.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3152361	101			0	lt	Use this form of depreciation if you require a higher initial depreciation value as opposed to linear depreciation. The depreciation value gets less with each period and is usually used for assets whose value loss is higher shortly after purchase (for example, vehicles, computers). Please note that the book value will never reach zero under this calculation type.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3156038	102			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3166452	103			0	lt	DDB(Cost; Salvage; Life; Period; Factor)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153237	104			0	lt	            \<emph\>Cost\</emph\> fixes the initial cost of an asset.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149787	105			0	lt	            \<emph\>Salvage\</emph\> fixes the value of an asset at the end of its life.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3152945	106			0	lt	            \<emph\>Life\</emph\> is the number of periods (for example, years or months) defining how long the asset is to be used.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149736	107			0	lt	            \<emph\>Period\</emph\> states the period for which the value is to be calculated.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150243	108			0	lt	            \<emph\>Factor\</emph\> (optional) is the factor by which depreciation decreases. If a value is not entered, the default is factor 2.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3159274	109			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3152882	110			0	lt	A computer system with an initial cost of 75,000 currency units is to be depreciated monthly over 5 years. The value at the end of the depreciation is to be 1 currency unit. The factor is 2.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154106	111			0	lt	            \<item type=\"input\"\>=DDB(75000;1;60;12;2) \</item\>= 1,721.81 currency units. Therefore, the double-declining depreciation in the twelfth month after purchase is 1,721.81 currency units.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3149962				0	lt	\<bookmark_value\>calculating; geometric-degressive depreciations\</bookmark_value\>         \<bookmark_value\>geometric-degressive depreciations\</bookmark_value\>         \<bookmark_value\>depreciations;geometric-degressive\</bookmark_value\>         \<bookmark_value\>DB function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3149962	113			0	lt	DB				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148989	114			0	lt	\<ahelp hid=\"HID_FUNC_GDA2\"\>Returns the depreciation of an asset for a specified period using the double-declining balance method.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156213	115			0	lt	This form of depreciation is used if you want to get a higher depreciation value at the beginning of the depreciation (as opposed to linear depreciation). The depreciation value is reduced with every depreciation period by the depreciation already deducted from the initial cost.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3149807	116			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153349	117			0	lt	DB(Cost; Salvage; Life; Period; Month)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148462	118			0	lt	            \<emph\>Cost\</emph\> is the initial cost of an asset.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148658	119			0	lt	            \<emph\>Salvage\</emph\> is the value of an asset at the end of the depreciation.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145371	120			0	lt	            \<emph\>Life\</emph\> defines the period over which an asset is depreciated.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154608	121			0	lt	            \<emph\>Period\</emph\> is the length of each period. The length must be entered in the same date unit as the depreciation period.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150829	122			0	lt	            \<emph\>Month\</emph\> (optional) denotes the number of months for the first year of depreciation. If an entry is not defined, 12 is used as the default.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3151130	123			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156147	124			0	lt	A computer system with an initial cost of 25,000 currency units is to be depreciated over a three year period. The salvage value is to be 1,000 currency units. One period is 30 days.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149513	125			0	lt	            \<item type=\"input\"\>=DB(25000;1000;36;1;6)\</item\> = 1,075.00 currency units				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159242	126			0	lt	The fixed-declining depreciation of the computer system is 1,075.00 currency units.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3153948				0	lt	\<bookmark_value\>IRR function\</bookmark_value\>         \<bookmark_value\>calculating;internal rates of return, regular payments\</bookmark_value\>         \<bookmark_value\>internal rates of return;regular payments\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3153948	128			0	lt	IRR				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3143282	129			0	lt	\<ahelp hid=\"HID_FUNC_IKV\"\>Calculates the internal rate of return for an investment.\</ahelp\> The values represent cash flow values at regular intervals, at least one value must be negative (payments), and at least one value must be positive (income).				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3150599	130			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155427	131			0	lt	IRR(Values; Guess)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3144758	132			0	lt	            \<emph\>Values\</emph\> represents an array containing the values.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149233	133			0	lt	            \<emph\>Guess\</emph\> (optional) is the estimated value. An iterative method is used to calculate the internal rate of return. If you can provide only few values, you should provide an initial guess to enable the iteration.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3151258	134			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150630	135			0	lt	Under the assumption that cell contents are A1=\<item type=\"input\"\>-10000\</item\>, A2=\<item type=\"input\"\>3500\</item\>, A3=\<item type=\"input\"\>7600\</item\> and A4=\<item type=\"input\"\>1000\</item\>, the formula \<item type=\"input\"\>=IRR(A1:A4)\</item\> gives a result of 11,33%.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3151012				0	lt	\<bookmark_value\>calculating; interests for unchanged amortization installments\</bookmark_value\>         \<bookmark_value\>interests for unchanged amortization installments\</bookmark_value\>         \<bookmark_value\>ISPMT function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3151012	314			0	lt	ISPMT				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148693	315			0	lt	\<ahelp hid=\"HID_FUNC_ISPMT\"\>Calculates the level of interest for unchanged amortization installments.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3154661	316			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146070	317			0	lt	ISPMT(Rate; Period; TotalPeriods; Invest)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148672	318			0	lt	            \<emph\>Rate\</emph\> sets the periodic interest rate.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145777	319			0	lt	            \<emph\>Period\</emph\> is the number of installments for calculation of interest.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153678	320			0	lt	            \<emph\>TotalPeriods\</emph\> is the total number of installment periods.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159390	321			0	lt	            \<emph\>Invest\</emph\> is the amount of the investment.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3156162	322			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149558	323			0	lt	For a credit amount of 120,000 currency units with a two-year term and monthly installments, at a yearly interest rate of 12% the level of interest after 1.5 years is required.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150949	324			0	lt	            \<item type=\"input\"\>=ISPMT(1%;18;24;120000)\</item\> = -300 currency units. The monthly interest after 1.5 years amounts to 300 currency units.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146812	426			0	lt	\<link href=\"text/scalc/01/04060119.xhp\" name=\"Forward to Financial Functions Part Two\"\>Financial Functions Part Two\</link\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154411	427			0	lt	\<link href=\"text/scalc/01/04060118.xhp\" name=\"Forward to Financial Functions Part Three\"\>Financial Functions Part Three\</link\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	tit				0	lt	Information Functions				20130618 17:22:18
