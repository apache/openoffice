helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3155306	11			0	lt	sText ="This is a short text"				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3154011	12			0	lt	iRun = 1				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3147215	13			0	lt	while iRun < Len(sText)				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3147427	14			0	lt	if Mid(sText,iRun,1 )<> " " then Mid( sText ,iRun, 1, Chr( 1 + Asc( Mid(sText,iRun,1 )) )				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3149665	15			0	lt	iRun = iRun + 1				20130618 17:22:18
