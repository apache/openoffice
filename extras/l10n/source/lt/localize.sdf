helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	hd_id3148735	196			0	lt	\<variable id=\"yearfrac\"\>\<link href=\"text/scalc/01/func_yearfrac.xhp\"\>YEARFRAC\</link\>\</variable\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3150899	197			0	lt	\<ahelp hid=\"HID_AAI_FUNC_YEARFRAC\"\> The result is a number between 0 and 1, representing the fraction of a year between \<emph\>StartDate\</emph\> and \<emph\>EndDate\</emph\>.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	hd_id3155259	198			0	lt	Syntax				20130618 17:22:18
