helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3149890	4			0	lt	\<ahelp hid=\"HID_FUNC_FALSCH\"\>Returns the logical value FALSE.\</ahelp\> The FALSE() function does not require any arguments, and always returns the logical value FALSE.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3146939	5			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3150030	6			0	lt	FALSE()				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3150697	7			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3154842	8			0	lt	            \<item type=\"input\"\>=FALSE()\</item\> returns FALSE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3147468	9			0	lt	            \<item type=\"input\"\>=NOT(FALSE())\</item\> returns TRUE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	bm_id3150141				0	lt	\<bookmark_value\>IF function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3150141	48			0	lt	IF				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3148740	49			0	lt	\<ahelp hid=\"HID_FUNC_WENN\"\>Specifies a logical test to be performed.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3153325	50			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3154558	51			0	lt	IF(Test; ThenValue; OtherwiseValue)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3149727	52			0	lt	            \<emph\>Test\</emph\> is any value or expression that can be TRUE or FALSE.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3155828	53			0	lt	            \<emph\>ThenValue\</emph\> (optional) is the value that is returned if the logical test is TRUE.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3154811	54			0	lt	            \<emph\>OtherwiseValue\</emph\> (optional) is the value that is returned if the logical test is FALSE.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_idN107FA				0	lt	            \<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>         				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3149507	55			0	lt	Examples				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3150867	57			0	lt	            \<item type=\"input\"\>=IF(A1>5;100;"too small")\</item\> If the value in A1 is higher than 5, the value 100 is entered in the current cell; otherwise, the text “too small” (without quotes) is entered.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	bm_id3155954				0	lt	\<bookmark_value\>NOT function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3155954	12			0	lt	NOT				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3153570	13			0	lt	\<ahelp hid=\"HID_FUNC_NICHT\"\>Complements (inverts) a logical value.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3147372	14			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3157996	15			0	lt	NOT(LogicalValue)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3148766	16			0	lt	            \<emph\>LogicalValue\</emph\> is any value to be complemented.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3149884	17			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3150132	18			0	lt	            \<item type=\"input\"\>=NOT(A)\</item\>. If A=TRUE then NOT(A) will evaluate FALSE.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	bm_id3148394				0	lt	\<bookmark_value\>OR function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3148394	20			0	lt	OR				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3156060	61			0	lt	\<ahelp hid=\"HID_FUNC_ODER\"\>Returns TRUE if at least one argument is TRUE.\</ahelp\> This function returns the value FALSE, if all the arguments have the logical value FALSE.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3148771	62			0	lt	The arguments are either logical expressions themselves (TRUE, 1<5, 2+3=7, B8<10) that return logical values, or arrays (A1:C3) containing logical values.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3153546	63			0	lt	When a function expects a single value, but you entered a cell range, then the value from the cell range is taken that is in the same column or row as the formula.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3149027	64			0	lt	If the entered range is outside of the current column or row of the formula, the function returns the error value #VALUE!				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3155517	22			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3150468	23			0	lt	OR(LogicalValue1; LogicalValue2 ...LogicalValue30)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3155819	24			0	lt	            \<emph\>LogicalValue1; LogicalValue2 ...LogicalValue30\</emph\> are conditions to be checked. All conditions can be either TRUE or FALSE. If a range is entered as a parameter, the function uses the value from the range that is in the current column or row.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3153228	25			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3154870	26			0	lt	The logical values of entries 12<11; 13>22, and 45=45 are to be checked.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3155371	27			0	lt	            \<item type=\"input\"\>=OR(12<11;13>22;45=45)\</item\> returns TRUE.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3158412	59			0	lt	            \<item type=\"input\"\>=OR(FALSE;TRUE)\</item\> returns TRUE.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	bm_id3156256				0	lt	\<bookmark_value\>TRUE function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3156256	38			0	lt	TRUE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3155985	39			0	lt	\<ahelp hid=\"HID_FUNC_WAHR\"\>The logical value is set to TRUE.\</ahelp\> The TRUE() function does not require any arguments, and always returns the logical value TRUE.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3153717	40			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3152590	41			0	lt	TRUE()				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3147175	42			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3146148	43			0	lt	If A=TRUE and B=FALSE the following examples appear:				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3083285	44			0	lt	            \<item type=\"input\"\>=AND(A;B)\</item\> returns FALSE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3083444	45			0	lt	            \<item type=\"input\"\>=OR(A;B)\</item\> returns TRUE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3154314	46			0	lt	            \<item type=\"input\"\>=NOT(AND(A;B))\</item\> returns TRUE				20130618 17:22:18
