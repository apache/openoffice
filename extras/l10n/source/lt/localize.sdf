helpcontent2	source\text\sbasic\shared\03090410.xhp	0	help	par_id3153626	14			0	lt	MsgBox sGender				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090410.xhp	0	help	par_id3147560	15			0	lt	End Sub				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090410.xhp	0	help	par_id3154758	17			0	lt	Function GetGenderIndex (sName As String) As String				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090410.xhp	0	help	par_id3153361	18			0	lt	GetGenderIndex = Switch(sName = "Jane", "female", sName = "John", "male")				20130618 17:22:18
