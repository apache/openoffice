helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3148401	229			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150830	230			0	lt	EVEN(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153350	231			0	lt	 Returns \<emph\>Number\</emph\> rounded to the next even integer up, away from zero. 				20130618 17:22:18
