helpcontent2	source\text\scalc\01\12090400.xhp	0	help	tit				0	lt	Grouping				20130618 17:22:18
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1054D				0	lt	Grouping				20130618 17:22:18
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10551				0	lt	Grouping pivot tables displays the \<emph\>Grouping\</emph\> dialog for either values or dates.				20130618 17:22:18
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10568				0	lt	Start				20130618 17:22:18
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1056C				0	lt	Specifies the start of the grouping.				20130618 17:22:18
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1056F				0	lt	Automatically				20130618 17:22:18
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10573				0	lt	Specifies whether to start grouping at the smallest value.				20130618 17:22:18
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10576				0	lt	Manually at				20130618 17:22:18
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1057A				0	lt	Specifies whether to enter the start value for grouping yourself.				20130618 17:22:18
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1057D				0	lt	End				20130618 17:22:18
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10581				0	lt	Specifies the end of the grouping.				20130618 17:22:18
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10584				0	lt	Automatically				20130618 17:22:18
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10588				0	lt	Specifies whether to end grouping at the largest value.				20130618 17:22:18
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1058B				0	lt	Manually at				20130618 17:22:18
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1058F				0	lt	Specifies whether to enter the end value for grouping yourself.				20130618 17:22:18
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10592				0	lt	Group by				20130618 17:22:18
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10596				0	lt	Specifies the value range by which every group's limits are calculated.				20130618 17:22:18
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10599				0	lt	Number of days				20130618 17:22:18
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1059D				0	lt	In the case of grouping date values, specifies the number of days to group by.				20130618 17:22:18
