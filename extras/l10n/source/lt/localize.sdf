helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146946	160			0	lt	\<ahelp hid=\"HID_FUNC_COSHYP\"\>Returns the hyperbolic cosine of a number.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3149792	161			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166440	162			0	lt	COSH(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150710	163			0	lt	Returns the hyperbolic cosine of \<emph\>Number\</emph\>.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153234	164			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154099	165			0	lt	\<item type=\"input\"\>=COSH(0)\</item\> returns 1, the hyperbolic cosine of 0.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152888				0	lt	\<bookmark_value\>COT function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152888	169			0	lt	COT				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153679	170			0	lt	\<ahelp hid=\"HID_FUNC_COT\"\>Returns the cotangent of the given angle (in radians).\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152943	171			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154856	172			0	lt	COT(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149969	173			0	lt	 Returns the (trigonometric) cotangent of \<emph\>Number\</emph\>, the angle in radians.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3444624				0	lt	To return the cotangent of an angle in degrees, use the RADIANS function.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6814477				0	lt	The cotangent of an angle is equivalent to 1 divided by the tangent of that angle.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3149800	174			0	lt	Examples:				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148616	175			0	lt	\<item type=\"input\"\>=COT(PI()/4)\</item\> returns 1, the cotangent of PI/4 radians.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148986	176			0	lt	\<item type=\"input\"\>=COT(RADIANS(45))\</item\> returns 1, the cotangent of 45 degrees.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3154337				0	lt	\<bookmark_value\>COTH function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154337	178			0	lt	COTH				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149419	179			0	lt	\<ahelp hid=\"HID_FUNC_COTHYP\"\>Returns the hyperbolic cotangent of a given number (angle).\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3149242	180			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143280	181			0	lt	COTH(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154799	182			0	lt	 Returns the hyperbolic cotangent of \<emph\>Number\</emph\>.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155422	183			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144754	184			0	lt	\<item type=\"input\"\>=COTH(1)\</item\> returns the hyperbolic cotangent of 1, approximately 1.3130.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3145314				0	lt	\<bookmark_value\>DEGREES function\</bookmark_value\>\<bookmark_value\>converting;radians, into degrees\</bookmark_value\>				20130618 17:22:18
