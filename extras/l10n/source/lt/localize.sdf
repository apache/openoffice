helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3147287	14			0	lt	dValue=Exp( Log(b1)+Log(b2) )				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3161832	15			0	lt	MsgBox "" & dValue & chr(13) & (b1*b2) ,0,"Multiplication by logarithm"				20130618 17:22:18
