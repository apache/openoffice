helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	bm_id3150616				0	lt	\<bookmark_value\>CBool function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	hd_id3150616	1			0	lt	\<link href=\"text/sbasic/shared/03100100.xhp\" name=\"CBool Function [Runtime]\"\>CBool Function [Runtime]\</link\>				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3145136	2			0	lt	Converts a string comparison or numeric comparison to a Boolean expression, or converts a single numeric expression to a Boolean expression.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	hd_id3153345	3			0	lt	Syntax:				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3149514	4			0	lt	CBool (Expression1 {= | <> | < | > | <= | >=} Expression2) or CBool (Number)				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	hd_id3156152	5			0	lt	Return value:				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3155419	6			0	lt	Bool				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	hd_id3147530	7			0	lt	Parameters:				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3156344	8			0	lt	\<emph\>Expression1, Expression2:\</emph\> Any string or numeric expressions that you want to compare. If the expressions match, the \<emph\>CBool\</emph\> function returns \<emph\>True\</emph\>, otherwise \<emph\>False\</emph\> is returned.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3149655	9			0	lt	\<emph\>Number:\</emph\> Any numeric expression that you want to convert. If the expression equals 0, \<emph\>False\</emph\> is returned, otherwise \<emph\>True\</emph\> is returned.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3145171	10			0	lt	The following example uses the \<emph\>CBool\</emph\> function to evaluate the value that is returned by the \<emph\>Instr\</emph\> function. The function checks if the word "and" is found in the sentence that was entered by the user.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	hd_id3156212	11			0	lt	Example:				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3147288	12			0	lt	Sub ExampleCBool				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3153768	13			0	lt	Dim sText As String				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3155132	14			0	lt	sText = InputBox("Please enter a short sentence:")				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3155855	15			0	lt	REM Proof if the word »and« appears in the sentence.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3146984	16			0	lt	REM Instead of the command line				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3148576	17			0	lt	REM If Instr(Input, "and")<>0 Then...				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3154014	18			0	lt	REM the CBool function is applied as follows:				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3155413	19			0	lt	If CBool(Instr(sText, "and")) Then				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3152940	20			0	lt	MsgBox "The word »and« appears in the sentence you entered!"				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3153954	21			0	lt	EndIf				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3152886	22			0	lt	End Sub				20130618 17:22:18
