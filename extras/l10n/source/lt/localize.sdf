helpcontent2	source\text\scalc\00\00000402.xhp	0	help	par_id3159233	3			0	lt	\<variable id=\"bkopfzeile\"\>Choose \<emph\>Edit - Headers & Footers - Header/Footer\</emph\> tabs\</variable\>				20130618 17:22:18
helpcontent2	source\text\scalc\00\00000402.xhp	0	help	par_id3150443	4			0	lt	\<variable id=\"bausfullen\"\>Choose \<emph\>Edit - Fill\</emph\>\</variable\>				20130618 17:22:18
helpcontent2	source\text\scalc\00\00000402.xhp	0	help	par_id3143267	5			0	lt	\<variable id=\"bausunten\"\>Choose \<emph\>Edit - Fill - Down\</emph\>\</variable\>				20130618 17:22:18
helpcontent2	source\text\scalc\00\00000402.xhp	0	help	par_id3153880	6			0	lt	\<variable id=\"bausrechts\"\>Choose \<emph\>Edit - Fill - Right\</emph\>\</variable\>				20130618 17:22:18
helpcontent2	source\text\scalc\00\00000402.xhp	0	help	par_id3151245	7			0	lt	\<variable id=\"bausoben\"\>Choose \<emph\>Edit - Fill - Up\</emph\>\</variable\>				20130618 17:22:18
