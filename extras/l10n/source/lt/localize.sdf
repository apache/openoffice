helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150763	102			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150882	103			0	lt	ASINH(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147621	104			0	lt	 This function returns the inverse hyperbolic sine of \<emph\>Number\</emph\>, that is the number whose hyperbolic sine is Number. 				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153212	105			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156120	106			0	lt	\<item type=\"input\"\>=ASINH(-90)\</item\> returns approximately -5.1929877.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id4808496				0	lt	\<item type=\"input\"\>=ASINH(SINH(4))\</item\> returns 4.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3155996				0	lt	\<bookmark_value\>ATAN function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155996	110			0	lt	ATAN				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149985	111			0	lt	\<ahelp hid=\"HID_FUNC_ARCTAN\"\>Returns the inverse trigonometric tangent of a number.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3151294	112			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150261	113			0	lt	ATAN(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147267	114			0	lt	 This function returns the inverse trigonometric tangent of \<emph\>Number\</emph\>, that is the angle (in radians) whose tangent is Number. The angle returned is between -PI/2 and PI/2.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6293527				0	lt	To return the angle in degrees, use the DEGREES function.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154054	115			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143229	116			0	lt	\<item type=\"input\"\>=ATAN(1)\</item\> returns 0.785398163397448 (PI/4 radians).				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8746299				0	lt	\<item type=\"input\"\>=DEGREES(ATAN(1))\</item\> returns 45. The tangent of 45 degrees is 1.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3153983				0	lt	\<bookmark_value\>ATAN2 function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153983	120			0	lt	ATAN2				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154297	121			0	lt	\<ahelp hid=\"HID_FUNC_ARCTAN2\"\>Returns the inverse trigonometric tangent of the specified x and y coordinates.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3149758	122			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156013	123			0	lt	ATAN2(NumberX; NumberY)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151168	124			0	lt	\<emph\>NumberX\</emph\> is the value of the x coordinate.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152798	125			0	lt	\<emph\>NumberY\</emph\> is the value of the y coordinate.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5036164				0	lt	ATAN2 returns the inverse trigonometric tangent, that is, the angle (in radians) between the x-axis and a line from point NumberX, NumberY to the origin. The angle returned is between -PI and PI.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3001800				0	lt	To return the angle in degrees, use the DEGREES function.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145663	126			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154692	127			0	lt	\<item type=\"input\"\>=ATAN2(20;20)\</item\> returns 0.785398163397448 (PI/4 radians).				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1477095				0	lt	\<item type=\"input\"\>=DEGREES(ATAN2(12.3;12.3))\</item\> returns 45. The tangent of 45 degrees is 1.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3155398				0	lt	\<bookmark_value\>ATANH function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155398	130			0	lt	ATANH				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148829	131			0	lt	\<ahelp hid=\"HID_FUNC_ARTANHYP\"\>Returns the inverse hyperbolic tangent of a number.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146997	132			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149912	133			0	lt	ATANH(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150521	134			0	lt	 This function returns the inverse hyperbolic tangent of \<emph\>Number\</emph\>, that is the number whose hyperbolic tangent is Number. 				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9357280				0	lt	 Number must obey the condition -1 < number < 1.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3148450	135			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145419	136			0	lt	\<item type=\"input\"\>=ATANH(0)\</item\> returns 0.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3153062				0	lt	\<bookmark_value\>COS function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153062	149			0	lt	COS				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148803	150			0	lt	\<ahelp hid=\"HID_FUNC_COS\"\>Returns the cosine of the given angle (in radians).\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150779	151			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154213	152			0	lt	COS(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154285	153			0	lt	 Returns the (trigonometric) cosine of \<emph\>Number\</emph\>, the angle in radians.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id831019				0	lt	To return the cosine of an angle in degrees, use the RADIANS function.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153579	154			0	lt	Examples				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147240	155			0	lt	\<item type=\"input\"\>=COS(PI()/2)\</item\> returns 0, the cosine of PI/2 radians.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147516	156			0	lt	\<item type=\"input\"\>=COS(RADIANS(60))\</item\> returns 0.5, the cosine of 60 degrees.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3154277				0	lt	\<bookmark_value\>COSH function\</bookmark_value\>				20130618 17:22:18
