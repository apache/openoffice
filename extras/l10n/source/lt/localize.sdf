helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_id3154939	18			0	lt	\<ahelp hid=\"HID_HELP_TOOLBOXITEM_BOOKMARKS\"\>Adds this page to your bookmarks\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN108D9				0	lt	\<image id=\"img_id7358623\" src=\"res/commandimagelist/sc_recsearch.png\" width=\"0.1665in\" height=\"0.1665in\"\>\<alt id=\"alt_id7358623\"\>Search icon\</alt\>\</image\>				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN108FE				0	lt	\<ahelp hid=\"HID_HELP_TOOLBOXITEM_SEARCHDIALOG\"\>Opens the \<emph\>Find on this page\</emph\> dialog.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_id3154366	21			0	lt	These commands can also be found in the context menu of the Help document.				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN10922				0	lt	Help Page				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN10926				0	lt	You can copy from the Help Viewer to the clipboard on your operating system with standard copy commands. For example:				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN1092C				0	lt	On a Help page, select the text that you want to copy.				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN10930				0	lt	Press \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+C.				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN10933				0	lt	To search the current Help page:				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN10939				0	lt	Click the \<emph\>Find on this Page\</emph\> icon.				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN10940				0	lt	The \<emph\>Find on this Page\</emph\> dialog opens.				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN10A36				0	lt	You can also click in the Help page and press \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+F.				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN10A22				0	lt	In the \<emph\>Search for\</emph\> box, enter the text that you want to find.				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN10A48				0	lt	Select the search options that you want to use.				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN10A26				0	lt	Click \<emph\>Find\</emph\>.				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN10A59				0	lt	To find the next occurrence of the search term on the page, click \<emph\>Find\</emph\> again.				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN10906				0	lt	\<ahelp hid=\"sfx2:ComboBox:RID_DLG_SEARCH:ED_SEARCH\" visibility=\"hidden\"\>Enter the text that you want to search for or select a text entry in the list.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN10993				0	lt	\<ahelp hid=\"sfx2:CheckBox:RID_DLG_SEARCH:CB_WHOLEWORDS\" visibility=\"hidden\"\>Finds complete words only.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN109AA				0	lt	\<ahelp hid=\"sfx2:CheckBox:RID_DLG_SEARCH:CB_MATCHCASE\" visibility=\"hidden\"\>Distinguishes between uppercase text and lowercase text.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN109C1				0	lt	\<ahelp hid=\"sfx2:CheckBox:RID_DLG_SEARCH:CB_WRAPAROUND\" visibility=\"hidden\"\>Searches the entire Help page, starting at the current position of the cursor.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN109D8				0	lt	\<ahelp hid=\"sfx2:CheckBox:RID_DLG_SEARCH:CB_BACKWARDS\" visibility=\"hidden\"\>Searches backwards from the current position of the cursor.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN109F5				0	lt	\<ahelp hid=\"sfx2:PushButton:RID_DLG_SEARCH:PB_FIND\" visibility=\"hidden\"\>Finds the next occurrence of the search term.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	hd_id3149202	8			0	lt	Navigation Pane				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_id3148673	9			0	lt	\<ahelp hid=\"HID_HELP_TABCONTROL\"\>The navigation pane of the Help window contains the tab pages \<emph\>Contents\</emph\>, \<emph\>Index\</emph\>, \<emph\>Find\</emph\> and \<emph\>Bookmarks\</emph\>.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_id3159149	19			0	lt	\<ahelp hid=\"HID_HELP_LISTBOX\"\>The list box located at the very top is where you can select other \<item type=\"productname\"\>%PRODUCTNAME\</item\> Help modules.\</ahelp\> The \<emph\>Index\</emph\> and \<emph\>Find\</emph\> tab pages only contain the data for the selected \<item type=\"productname\"\>%PRODUCTNAME\</item\> module.				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_id3149983	14			0	lt	\<link href=\"text/shared/05/00000160.xhp\" name=\"Contents\"\>Contents\</link\>				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_id3145748	15			0	lt	Displays an index of the main topics of all modules.				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_id3155366	10			0	lt	\<link href=\"text/shared/05/00000130.xhp\" name=\"Index\"\>Index\</link\>				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_id3151351	11			0	lt	Displays a list of index keywords for the currently selected %PRODUCTNAME module.				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_id3149260	12			0	lt	\<link href=\"text/shared/05/00000140.xhp\" name=\"Find\"\>Find\</link\>				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_id3154188	13			0	lt	Allows you to carry out a full-text search. The search will include the entire Help contents of the currently selected \<item type=\"productname\"\>%PRODUCTNAME\</item\> module.				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_id3154985	16			0	lt	\<link href=\"text/shared/05/00000150.xhp\" name=\"Bookmarks\"\>Bookmarks\</link\>				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_id3156062	17			0	lt	Contains user-defined bookmarks. You can edit or delete bookmarks, or click them to go to the corresponding pages.				20130618 17:22:18
