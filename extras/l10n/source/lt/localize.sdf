helpcontent2	source\text\scalc\01\func_year.xhp	0	help	par_id3145668	43			0	lt	\<item type=\"input\"\>=YEAR(1)\</item\> returns 1899				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_year.xhp	0	help	par_id3151168	44			0	lt	\<item type=\"input\"\>=YEAR(2)\</item\> returns 1900				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_year.xhp	0	help	par_id3150115	45			0	lt	\<item type=\"input\"\>=YEAR(33333.33)\</item\> returns 1991				20130618 17:22:18
