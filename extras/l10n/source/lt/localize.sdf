helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3148488	31			0	lt	7 : No				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	hd_id3150090	40			0	lt	Example:				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3154120	41			0	lt	Sub ExampleMsgBox				20130618 17:22:18
