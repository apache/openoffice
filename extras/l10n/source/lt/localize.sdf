helpcontent2	source\text\swriter\01\02110000.xhp	0	help	par_id3150707	59			0	lt	\<ahelp hid=\"HID_NAVI_TBX15\"\>Decreases the outline level of the selected heading, and the headings that occur below the heading, by one. To only decrease the outline level of the selected heading, hold down Ctrl, and then click this icon.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\02110000.xhp	0	help	par_id3148414				0	lt	\<image id=\"img_id3148420\" src=\"sw/imglst/sc20173.png\" width=\"0.2228in\" height=\"0.2228in\"\>\<alt id=\"alt_id3148420\"\>Icon\</alt\>\</image\>				20130618 17:22:18
