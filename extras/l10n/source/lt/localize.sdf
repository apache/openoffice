helpcontent2	source\text\shared\01\02220000.xhp	0	help	par_id3155308				0	lt	\<image id=\"img_id3154011\" src=\"res/commandimagelist/sc_ellipse.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3154011\"\>Icon\</alt\>\</image\>				20130618 17:22:18
