helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	par_id3149457	4			0	lt	Blue (Color As Long)				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	hd_id3149656	5			0	lt	Return value:				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	par_id3154365	6			0	lt	Integer				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	hd_id3156423	7			0	lt	Parameter:				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	par_id3150448	8			0	lt	\<emph\>Color value\</emph\>: Long integer expression that specifies any \<link href=\"text/sbasic/shared/00000003.xhp#farbcodes\" name=\"color code\"\>color code\</link\> for which to return the blue component.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	hd_id3153091	9			0	lt	Example:				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	par_id3153143	10			0	lt	Sub ExampleColor				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	par_id3149664	11			0	lt	Dim lVar As Long				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	par_id3148576	12			0	lt	lVar = rgb(128,0,200)				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	par_id3154012	13			0	lt	MsgBox "The color " & lVar & " consists of:" & Chr(13) &_				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	par_id3148645	14			0	lt	"red= " & Red(lVar) & Chr(13)&_				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	par_id3159155	15			0	lt	"green= " & Green(lVar) & Chr(13)&_				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	par_id3147319	16			0	lt	"blue= " & Blue(lVar) & Chr(13) , 64,"colors"				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	par_id3147434	17			0	lt	End Sub				20130618 17:22:18
