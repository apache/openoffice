helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN1057B				0	lt	\<ahelp hid=\"34218\"\>Select the file format that you want to export the selected file to.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN1057E				0	lt	Title				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN10582				0	lt	\<ahelp hid=\"34215\"\>Enter the title for the selected document. The title appears as a hyperlink to the selected document on the index page of your web site.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN10585				0	lt	Summary				20130618 17:22:18
