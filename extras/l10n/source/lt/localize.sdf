helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3148755	59			0	lt	Reset				20130618 17:22:18
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3149651	60			0	lt	\<ahelp hid=\"HID_TABDLG_RESET_BTN\"\>Resets changes made to the current tab to those applicable when this dialog was opened. A confirmation query does not appear when you close the dialog.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3143278	18			0	lt	Reset				20130618 17:22:18
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3150791	19			0	lt	\<ahelp hid=\"HID_TABDLG_RESET_BTN\"\>Resets modified values back to the default values.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154331	20			0	lt	A confirmation query does not appear. If you confirm the dialog with OK all settings in this dialog are reset.				20130618 17:22:18
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3145173	10			0	lt	Standard				20130618 17:22:18
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154153	11			0	lt	\<ahelp hid=\"HID_TABDLG_STANDARD_BTN\"\>Resets the values visible in the dialog back to the default installation values.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154299	12			0	lt	A confirmation does not appear before the defaults are reloaded.				20130618 17:22:18
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3147502	72			0	lt	Back				20130618 17:22:18
