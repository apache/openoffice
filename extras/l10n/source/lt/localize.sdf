helpcontent2	source\text\schart\01\type_stock.xhp	0	help	par_id1687063				0	lt	Wednesday				20130618 17:22:18
helpcontent2	source\text\schart\01\type_stock.xhp	0	help	par_id8982207				0	lt	1000				20130618 17:22:18
