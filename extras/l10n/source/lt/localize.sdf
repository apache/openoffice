helpcontent2	source\text\shared\01\05020301.xhp	0	help	par_id3147344	126			0	lt	Number of the year within an era, without a leading zero for single-digit years				20130618 17:22:18
helpcontent2	source\text\shared\01\05020301.xhp	0	help	par_id3147255	127			0	lt	E				20130618 17:22:18
