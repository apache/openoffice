helpcontent2	source\text\shared\01\02200200.xhp	0	help	par_id3151097	2			0	lt	Opens the selected OLE object with the program that the object was created in.				20130618 17:22:18
helpcontent2	source\text\shared\01\02200200.xhp	0	help	par_id3154230	3			0	lt	This menu command is inserted into \<emph\>Edit – Objects\</emph\> submenu by the application that created the linked object. Depending on the application, the “Open” command for the OLE object might have a different name.				20130618 17:22:18
helpcontent2	source\text\shared\01\02200200.xhp	0	help	par_id3149760	4			0	lt	After you have completed your changes, close the source file for the OLE object. The OLE object is then updated in the container document.				20130618 17:22:18
helpcontent2	source\text\shared\01\02210101.xhp	0	help	tit				0	lt	Floating Frame Properties				20130618 17:22:18
helpcontent2	source\text\shared\01\02210101.xhp	0	help	hd_id3150347	1			0	lt	\<link href=\"text/shared/01/02210101.xhp\" name=\"Floating Frame Properties\"\>Floating Frame Properties\</link\>				20130618 17:22:18
helpcontent2	source\text\shared\01\02210101.xhp	0	help	par_id3149031	2			0	lt	\<ahelp hid=\"SFX2:TABPAGE:TP_FRAMEPROPERTIES\"\>Changes the properties of the selected floating frame. Floating frames work best when they contain an html document, and when they are inserted in another html document.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\01\02210101.xhp	0	help	hd_id3155364	3			0	lt	Name				20130618 17:22:18
helpcontent2	source\text\shared\01\02210101.xhp	0	help	par_id3149511	4			0	lt	\<ahelp hid=\"SFX2:EDIT:TP_FRAMEPROPERTIES:ED_FRAMENAME\"\>Enter a name for the floating frame. The name cannot contain spaces, special characters, or begin with an underscore ( _ ).\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\01\02210101.xhp	0	help	hd_id3150789	5			0	lt	Contents				20130618 17:22:18
helpcontent2	source\text\shared\01\02210101.xhp	0	help	par_id3156414	6			0	lt	\<ahelp hid=\"SFX2:EDIT:TP_FRAMEPROPERTIES:ED_URL\"\>Enter the path and the name of the file that you want to display in the floating frame. You can also click the \<emph\>...\</emph\> button and locate the file that you want to display.\</ahelp\> For example, you can enter:				20130618 17:22:18
helpcontent2	source\text\shared\01\02210101.xhp	0	help	par_id3147399	7			0	lt	http://www.example.com				20130618 17:22:18
helpcontent2	source\text\shared\01\02210101.xhp	0	help	par_id3153683	8			0	lt	file:///c|/Readme.txt 				20130618 17:22:18
