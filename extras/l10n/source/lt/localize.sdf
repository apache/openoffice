helpcontent2	source\text\sbasic\shared\03120102.xhp	0	help	par_id3154909	12			0	lt	REM This example inserts quotation marks (ASCII value 34) in a string.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03120102.xhp	0	help	par_id3151380	13			0	lt	MsgBox "A "+ Chr$(34)+"short" + Chr$(34)+" trip."				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03120102.xhp	0	help	par_id3145174	14			0	lt	REM The printout appears in the dialog as: A "short" trip.				20130618 17:22:18
