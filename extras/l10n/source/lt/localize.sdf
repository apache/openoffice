helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	hd_id3154347	1			0	lt	\<link href=\"text/sbasic/shared/03020404.xhp\" name=\"Dir Function [Runtime]\"\>Dir Function [Runtime]\</link\>				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3153381	2			0	lt	Returns the name of a file, a directory, or all of the files and the directories on a drive or in a directory that match the specified search path.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	hd_id3154365	3			0	lt	Syntax:				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3156282	4			0	lt	Dir [(Text As String) [, Attrib As Integer]]				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	hd_id3156424	5			0	lt	Return value:				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3153193	6			0	lt	String				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	hd_id3153770	7			0	lt	Parameters:				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3161831	8			0	lt	\<emph\>Text:\</emph\> Any string expression that specifies the search path, directory or file. This argument can only be specified the first time that you call the Dir function. If you want, you can enter the path in \<link href=\"text/sbasic/shared/00000002.xhp\" name=\"URL notation\"\>URL notation\</link\>.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3146974	9			0	lt	\<emph\>Attrib: \</emph\>Any integer expression that specifies bitwise file attributes. The Dir function only returns files or directories that match the specified attributes. You can combine several attributes by adding the attribute values:				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3149666	11			0	lt	0 : Normal files.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3147427	15			0	lt	16 : Returns the name of the directory only.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3153952	16			0	lt	Use this attribute to check if a file or directory exists, or to determine all files and folders in a specific directory.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3159156	17			0	lt	To check if a file exists, enter the complete path and name of the file. If the file or directory name does not exist, the Dir function returns a zero-length string ("").				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3154012	18			0	lt	To generate a list of all existing files in a specific directory, proceed as follows: The first time you call the Dir function, specify the complete search path for the files, for example, "D:\\Files\\*.sxw". If the path is correct and the search finds at least one file, the Dir function returns the name of the first file that matches the search path. To return additional file names that match the path, call Dir again, but with no arguments.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3147348	19			0	lt	To return directories only, use the attribute parameter. The same applies if you want to determine the name of a volume (for example, a hard drive partition)				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	hd_id3154942	20			0	lt	Example:				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3147125	21			0	lt	Sub ExampleDir				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3148455	22			0	lt	REM Displays all files and directories				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3147396	23			0	lt	Dim sPath As String				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3149378	24			0	lt	Dim sDir as String, sValue as String				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3153416	27			0	lt	sDir="Directories:"				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3153838	29			0	lt	sPath = CurDir				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3150327	30			0	lt	sValue = Dir$(sPath + getPathSeparator + "*",16)				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3155064	31			0	lt	Do				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3153764	32			0	lt	If sValue <> "." and sValue <> ".." Then				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3155766	33			0	lt	if (GetAttr( sPath + getPathSeparator + sValue) AND 16) >0 then				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3154253	34			0	lt	REM get the directories				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3159264	35			0	lt	sDir = sDir & chr(13) & sValue				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3145148	43			0	lt	End If				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_idN10700				0	lt	End If				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3147324	44			0	lt	sValue = Dir$				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3155335	45			0	lt	Loop Until sValue = ""				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3147345	46			0	lt	MsgBox sDir,0,sPath				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3163808	48			0	lt	End sub				20130618 17:22:18
