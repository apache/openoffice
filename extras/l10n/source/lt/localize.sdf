helpcontent2	source\text\shared\explorer\database\rep_pagenumbers.xhp	0	help	par_id9879146				0	lt	\<ahelp hid=\".\" visibility=\"hidden\"\>Page N of M\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\rep_pagenumbers.xhp	0	help	par_id9404278				0	lt	\<ahelp hid=\".\" visibility=\"hidden\"\>Top of Page (Header)\</ahelp\>				20130618 17:22:18
