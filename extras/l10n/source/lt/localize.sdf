helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_id3154285	4			0	lt	\<ahelp hid=\"HID_HELP_TOOLBOXITEM_START\"\>Moves to the \<emph\>first page\</emph\> of the current Help topic\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_id3149797				0	lt	\<image id=\"img_id3155434\" src=\"res/commandimagelist/sc_print.png\" width=\"0.1665in\" height=\"0.1665in\"\>\<alt id=\"alt_id3155434\"\>Icon\</alt\>\</image\>				20130618 17:22:18
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_id3148563	7			0	lt	\<ahelp hid=\"HID_HELP_TOOLBOXITEM_PRINT\"\>\<emph\>Prints\</emph\> the current page\</ahelp\>				20130618 17:22:18
