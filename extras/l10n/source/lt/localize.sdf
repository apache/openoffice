helpcontent2	source\text\sbasic\guide\show_dialog.xhp	0	help	par_id3146985	20			0	lt	DialogLibraries.LoadLibrary( "Standard" )				20130618 17:22:18
helpcontent2	source\text\sbasic\guide\show_dialog.xhp	0	help	par_id3155418	21			0	lt	oDialog1 = CreateUnoDialog( DialogLibraries.Standard.Dialog1 )				20130618 17:22:18
