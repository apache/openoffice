helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id09022809540918				0	lt	\<link href=\"http://wiki.services.openoffice.org/wiki/Documentation/How_Tos/Calc:_CONVERT_ADD_function\"\>Current list of CONVERT_ADD units in the OpenOffice.org Wiki.\</link\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3156270	214			0	lt	Examples				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3156336	215			0	lt	            \<item type=\"input\"\>=CONVERT_ADD(10;"HP";"PS") \</item\>returns, rounded to two decimal places, 10.14. 10 HP equal 10.14 PS.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3154834	216			0	lt	            \<item type=\"input\"\>=CONVERT_ADD(10;"km";"mi") \</item\>returns, rounded to two decimal places, 6.21. 10 kilometers equal 6.21 miles. The k is the permitted prefix character for the factor 10^3.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	bm_id3147096				0	lt	\<bookmark_value\>FACTDOUBLE function\</bookmark_value\>         \<bookmark_value\>factorials;numbers with increments of two\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3147096	36			0	lt	FACTDOUBLE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3151309	37			0	lt	\<ahelp hid=\"HID_AAI_FUNC_FACTDOUBLE\"\>Returns the double factorial of a number.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3154666	38			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3155121	39			0	lt	FACTDOUBLE(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3158440	40			0	lt	Returns \<emph\>Number\</emph\>            \<emph\>!!\</emph\>, the double factorial of \<emph\>Number\</emph\>, where \<emph\>Number\</emph\> is an integer greater than or equal to zero.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id2480849				0	lt	For even numbers FACTDOUBLE(n) returns:				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id4181951				0	lt	2*4*6*8* ... *n				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id2927335				0	lt	For odd numbers FACTDOUBLE(n) returns:				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id2107303				0	lt	1*3*5*7* ... *n				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id4071779				0	lt	FACTDOUBLE(0) returns 1 by definition.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3154622	42			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id7844477				0	lt	            \<item type=\"input\"\>=FACTDOUBLE(5)\</item\> returns 15.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3154116	43			0	lt	            \<item type=\"input\"\>=FACTDOUBLE(6)\</item\> returns 48.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id6478469				0	lt	            \<item type=\"input\"\>=FACTDOUBLE(0)\</item\> returns 1.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	tit				0	lt	Financial Functions Part Three				20130618 17:22:18
