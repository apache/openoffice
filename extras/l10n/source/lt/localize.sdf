helpcontent2	source\text\schart\01\type_stock.xhp	0	help	par_id6897183				0	lt	2200				20130618 17:22:18
helpcontent2	source\text\schart\01\type_stock.xhp	0	help	par_id7003387				0	lt	40				20130618 17:22:18
helpcontent2	source\text\schart\01\type_stock.xhp	0	help	par_id4897915				0	lt	30				20130618 17:22:18
helpcontent2	source\text\schart\01\type_stock.xhp	0	help	par_id3105868				0	lt	47				20130618 17:22:18
helpcontent2	source\text\schart\01\type_stock.xhp	0	help	par_id3908810				0	lt	35				20130618 17:22:18
helpcontent2	source\text\schart\01\type_stock.xhp	0	help	par_id9461653				0	lt	6				20130618 17:22:18
