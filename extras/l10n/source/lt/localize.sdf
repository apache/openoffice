helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	tit				0	lt	Purchase %PRODUCTNAME				20130618 17:22:18
helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN10564				0	lt	\<link href=\"text/shared/autopi/purchase.xhp\"\>Purchase %PRODUCTNAME\</link\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN10574				0	lt	This wizard is visible for the evaluation version of %PRODUCTNAME. If you are using a time-limited evaluation version of %PRODUCTNAME, you can purchase a license online. You will get a serial number to change your %PRODUCTNAME to a full version.				20130618 17:22:18
helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN10577				0	lt	The wizard can be called any time from the Help menu. The wizard will be offered automatically starting five days before the evaluation period expires.				20130618 17:22:18
helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN1057A				0	lt	The wizard consists of the following steps:				20130618 17:22:18
helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN1057D				0	lt	Purchase %PRODUCTNAME				20130618 17:22:18
helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN10581				0	lt	\<ahelp hid=\".\"\>This is the welcome page of the wizard. If you want to buy a serial number online, click the button. If you already have a serial number, click Next to enter the number on the next page.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN10590				0	lt	Get your serial number online				20130618 17:22:18
helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN10594				0	lt	\<ahelp hid=\".\"\>Click to enter a web page, where you can purchase a serial number online.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN105A3				0	lt	Unlock %PRODUCTNAME				20130618 17:22:18
helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN105A7				0	lt	\<ahelp hid=\".\"\>Enter your serial number or copy and paste the number from the online web page.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN105B6				0	lt	License Agreement				20130618 17:22:18
helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN105BA				0	lt	\<ahelp hid=\".\"\>Please read the license text (scroll down the text accordingly), then accept the license to continue unlocking. If you do not accept the license, the software will not be unlocked.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN105C9				0	lt	Personal Data				20130618 17:22:18
helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN105CD				0	lt	\<ahelp hid=\".\"\>This step of the wizard appears when the unlocking program finds an installed version of %PRODUCTNAME where some user settings can be copied to the new installation.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN105DC				0	lt	Copy personal data				20130618 17:22:18
helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN105E0				0	lt	\<ahelp hid=\".\"\>Select this box to copy your user name and other data from a previous installation to your new installation of %PRODUCTNAME.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN105EF				0	lt	Summary				20130618 17:22:18
helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN105F3				0	lt	\<ahelp hid=\".\"\>This is the last page of the Purchase %PRODUCTNAME Wizard.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\startup.xhp	0	help	tit				0	lt	Start-up Wizard				20130618 17:22:18
helpcontent2	source\text\shared\autopi\startup.xhp	0	help	par_idN1054C				0	lt	\<link href=\"text/shared/autopi/startup.xhp\"\>Start-up Wizard\</link\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\startup.xhp	0	help	par_idN1055C				0	lt	The Start-up Wizard opens when you start %PRODUCTNAME for the first time.				20130618 17:22:18
helpcontent2	source\text\shared\autopi\startup.xhp	0	help	par_idN1055F				0	lt	The wizard consists of the following pages:				20130618 17:22:18
helpcontent2	source\text\shared\autopi\startup.xhp	0	help	par_idN10562				0	lt	Welcome				20130618 17:22:18
helpcontent2	source\text\shared\autopi\startup.xhp	0	help	par_idN10566				0	lt	\<ahelp hid=\".\"\>The Start-up Wizard helps you to specify the user settings for %PRODUCTNAME. This wizard only runs once.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\startup.xhp	0	help	par_idN10575				0	lt	License				20130618 17:22:18
helpcontent2	source\text\shared\autopi\startup.xhp	0	help	par_idN10579				0	lt	\<ahelp hid=\".\"\>Read and accept the license text to continue. You need to scroll to the end of the license text before you can continue. If you decline the license, the installation is canceled.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\startup.xhp	0	help	par_idN10588				0	lt	Migration				20130618 17:22:18
helpcontent2	source\text\shared\autopi\startup.xhp	0	help	par_idN1058C				0	lt	\<ahelp hid=\".\"\>You can use this page to import user data from a previously installed version of %PRODUCTNAME.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\startup.xhp	0	help	par_idN1059F				0	lt	Copy personal data				20130618 17:22:18
helpcontent2	source\text\shared\autopi\startup.xhp	0	help	par_idN105A3				0	lt	\<ahelp hid=\".\"\>Copies the user name and other data from a previous %PRODUCTNAME installation.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\startup.xhp	0	help	par_idN105B2				0	lt	User name				20130618 17:22:18
helpcontent2	source\text\shared\autopi\startup.xhp	0	help	par_idN105B6				0	lt	\<ahelp hid=\".\"\>The user name is used for the document properties, templates, and when you record changes made to documents. This page is only displayed if a previous installation of %PRODUCTNAME is not found on your computer.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\startup.xhp	0	help	par_idN105C8				0	lt	\<ahelp hid=\".\"\>Enter your personal data into the text boxes.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard00.xhp	0	help	tit				0	lt	Web Wizard				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard00.xhp	0	help	par_idN1054D				0	lt	\<link href=\"text/shared/autopi/webwizard00.xhp\"\>Web Wizard\</link\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard00.xhp	0	help	par_idN1055D				0	lt	\<ahelp hid=\"34200\"\>The Web Wizard helps you to maintain a web site on an Internet server.\</ahelp\>The Web Wizard converts files in a local folder to a web format and uploads the files to the server. The wizard also uses one of the supplied templates to create an index page that contains hyperlinks to the uploaded files.				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard00.xhp	0	help	par_idN105C4				0	lt	The Web Wizard uses the File Transfer Protocol (FTP) to upload files to a server. You cannot use the wizard to upload the files if you connect to the internet through a proxy server.				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard00.xhp	0	help	par_idN10574				0	lt	The wizard involves the following steps:				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard01.xhp	0	help	tit				0	lt	Web Wizard - Introduction				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard01.xhp	0	help	par_idN10544				0	lt	\<link href=\"text/shared/autopi/webwizard01.xhp\"\>Web Wizard - Introduction\</link\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard01.xhp	0	help	par_idN10554				0	lt	\<ahelp hid=\".\"\>You can use the Web Wizard to maintain web pages on a server.\</ahelp\> You can also load previously saved Web Wizard settings to maintain an existing web page. These settings include information about the local folder and the FTP server.				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard01.xhp	0	help	par_idN10557				0	lt	Choose Web Wizard settings				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard01.xhp	0	help	par_idN1055B				0	lt	\<ahelp hid=\"34207\"\>Select the settings that you want to load and then click \<emph\>Load\</emph\>. To start the wizard with the default settings, select "default".\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard01.xhp	0	help	par_idN1055E				0	lt	Delete				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard01.xhp	0	help	par_idN10562				0	lt	\<ahelp hid=\"34209\"\>Deletes the selected settings.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard01.xhp	0	help	par_idN10565				0	lt	\<link href=\"text/shared/autopi/webwizard02.xhp\"\>Web Wizard - Documents\</link\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	tit				0	lt	Web Wizard - Documents				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN10547				0	lt	\<link href=\"text/shared/autopi/webwizard02.xhp\"\>Web Wizard - Documents\</link\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN10557				0	lt	Select the files that you want to upload to your web site. You can upload the files to a server or to a local directory.				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN1055A				0	lt	Documents				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN1055E				0	lt	\<ahelp hid=\"34210\"\>Lists the documents that you want to publish to your web site. The wizard can convert %PRODUCTNAME documents to HTML, PDF, or, in some cases, Flash format before the documents are uploaded. All other files are uploaded in their original file format.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN10561				0	lt	Add				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN10565				0	lt	\<ahelp hid=\"34211\"\>Opens a dialog where you can select the files that you want to upload to your web site. The order of the list determines the order in which the hyperlinks to the documents are displayed on the index page of your web site.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN10568				0	lt	Remove				20130618 17:22:18
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN1056C				0	lt	\<ahelp hid=\"34212\"\>Removes the selected file from the list.\</ahelp\>				20130618 17:22:18
