helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154361	233			0	lt	\<item type=\"input\"\>=EVEN(2.3)\</item\> returns 4.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8477736				0	lt	\<item type=\"input\"\>=EVEN(2)\</item\> returns 2.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id159611				0	lt	\<item type=\"input\"\>=EVEN(0)\</item\> returns 0.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6097598				0	lt	\<item type=\"input\"\>=EVEN(-0.5)\</item\> returns -2.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3147356				0	lt	\<bookmark_value\>GCD function\</bookmark_value\>\<bookmark_value\>greatest common divisor\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3147356	237			0	lt	GCD				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152465	238			0	lt	\<ahelp hid=\"HID_FUNC_GGT\"\>Returns the greatest common divisor of two or more integers.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2769249				0	lt	The greatest common divisor is the positive largest integer which will divide, without remainder, each of the given integers.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150643	239			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154524	240			0	lt	GCD(Integer1; Integer2; ...; Integer30)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149340	241			0	lt	\<emph\>Integer1 To 30\</emph\> are up to 30 integers whose greatest common divisor is to be calculated.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3147317	242			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151285	243			0	lt	\<item type=\"input\"\>=GCD(16;32;24) \</item\>gives the result 8, because 8 is the largest number that can divide 16, 24 and 32 without a remainder.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1604663				0	lt	\<item type=\"input\"\>=GCD(B1:B3)\</item\> where cells B1, B2, B3 contain \<item type=\"input\"\>9\</item\>, \<item type=\"input\"\>12\</item\>, \<item type=\"input\"\>9\</item\> gives 3.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3151221				0	lt	\<bookmark_value\>GCD_ADD function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3151221	677			0	lt	GCD_ADD				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153257	678			0	lt	\<ahelp hid=\"HID_AAI_FUNC_GCD\"\> The result is the greatest common divisor of a list of numbers.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3147548	679			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156205	680			0	lt	GCD_ADD(Number(s))				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145150	681			0	lt	\<emph\>Number(s)\</emph\> is a list of up to 30 numbers.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150239	682			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159192	683			0	lt	\<item type=\"input\"\>=GCD_ADD(5;15;25)\</item\> returns 5.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3156048				0	lt	\<bookmark_value\>ISEVEN function\</bookmark_value\>\<bookmark_value\>even integers\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3156048	245			0	lt	ISEVEN				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149169	246			0	lt	\<ahelp hid=\"HID_FUNC_ISTGERADE\"\>Returns TRUE if the value is an even integer, or FALSE if the value is odd.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146928	247			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151203	248			0	lt	ISEVEN(Value)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150491	249			0	lt	\<emph\>Value\</emph\> is the value to be checked.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3445844				0	lt	If Value is not an integer any digits after the decimal point are ignored. The sign of Value is also ignored.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154136	250			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163813	251			0	lt	\<item type=\"input\"\>=ISEVEN(48)\</item\> returns TRUE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8378856				0	lt	\<item type=\"input\"\>=ISEVEN(33)\</item\> returns FALSE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7154759				0	lt	\<item type=\"input\"\>=ISEVEN(0)\</item\> returns TRUE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1912289				0	lt	\<item type=\"input\"\>=ISEVEN(-2.1)\</item\> returns TRUE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5627307				0	lt	\<item type=\"input\"\>=ISEVEN(3.999)\</item\> returns FALSE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3156034				0	lt	\<bookmark_value\>ISODD function\</bookmark_value\>\<bookmark_value\>odd integers\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3156034	255			0	lt	ISODD				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155910	256			0	lt	\<ahelp hid=\"HID_FUNC_ISTUNGERADE\"\>Returns TRUE if the value is odd, or FALSE if the number is even.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3151006	257			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151375	258			0	lt	ISODD(value)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155139	259			0	lt	\<emph\>Value\</emph\> is the value to be checked.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9027680				0	lt	If Value is not an integer any digits after the decimal point are ignored. The sign of Value is also ignored.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163723	260			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155345	261			0	lt	\<item type=\"input\"\>=ISODD(33)\</item\> returns TRUE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9392986				0	lt	\<item type=\"input\"\>=ISODD(48)\</item\> returns FALSE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5971251				0	lt	\<item type=\"input\"\>=ISODD(3.999)\</item\> returns TRUE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id4136478				0	lt	\<item type=\"input\"\>=ISODD(-3.1)\</item\> returns TRUE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3145213				0	lt	\<bookmark_value\>LCM function\</bookmark_value\>\<bookmark_value\>least common multiples\</bookmark_value\>\<bookmark_value\>lowest common multiples\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145213	265			0	lt	LCM				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146814	266			0	lt	\<ahelp hid=\"HID_FUNC_KGV\"\>Returns the least common multiple of one or more integers.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3148632	267			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147279	268			0	lt	LCM(Integer1; Integer2; ...; Integer30)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156348	269			0	lt	\<emph\>Integer1 to 30\</emph\> are up to 30 integers whose lowest common multiple is to be calculated.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3156431	270			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154914	271			0	lt	If you enter the numbers \<item type=\"input\"\>512\</item\>;\<item type=\"input\"\>1024\</item\> and \<item type=\"input\"\>2000\</item\> in the Integer 1;2 and 3 text boxes, 128000 will be returned as the result.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3154230				0	lt	\<bookmark_value\>LCM_ADD function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154230	684			0	lt	LCM_ADD				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149036	685			0	lt	\<ahelp hid=\"HID_AAI_FUNC_LCM\"\> The result is the lowest common multiple of a list of numbers.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153132	686			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154395	687			0	lt	LCM_ADD(Number(s))				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147377	688			0	lt	\<emph\>Number(s)\</emph\> is a list of up to 30 numbers.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145122	689			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145135	690			0	lt	\<item type=\"input\"\>=LCM_ADD(5;15;25)\</item\> returns 75.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3155802				0	lt	\<bookmark_value\>COMBIN function\</bookmark_value\>\<bookmark_value\>number of combinations\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155802	273			0	lt	COMBIN				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156172	274			0	lt	\<ahelp hid=\"HID_FUNC_KOMBINATIONEN\"\>Returns the number of combinations for elements without repetition.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3156193	275			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150223	276			0	lt	COMBIN(Count1; Count2)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150313	277			0	lt	\<emph\>Count1\</emph\> is the number of items in the set.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153830	278			0	lt	\<emph\>Count2\</emph\> is the number of items to choose from the set.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6807458				0	lt	COMBIN returns the number of ordered ways to choose these items. For example if there are 3 items A, B and C in a set, you can choose 2 items in 3 different ways, namely AB, AC and BC.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7414471				0	lt	COMBIN implements the formula: Count1!/(Count2!*(Count1-Count2)!)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153171	279			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153517	280			0	lt	\<item type=\"input\"\>=COMBIN(3;2)\</item\> returns 3.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3150284				0	lt	\<bookmark_value\>COMBINA function\</bookmark_value\>\<bookmark_value\>number of combinations with repetitions\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150284	282			0	lt	COMBINA				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157894	283			0	lt	\<ahelp hid=\"HID_FUNC_KOMBINATIONEN2\"\>Returns the number of combinations of a subset of items including repetitions.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145752	284			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145765	285			0	lt	COMBINA(Count1; Count2)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153372	286			0	lt	\<emph\>Count1\</emph\> is the number of items in the set.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155544	287			0	lt	\<emph\>Count2\</emph\> is the number of items to choose from the set.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1997131				0	lt	COMBINA returns the number of unique ways to choose these items, where the order of choosing is irrelevant, and repetition of items is allowed. For example if there are 3 items A, B and C in a set, you can choose 2 items in 6 different ways, namely AA, AB, AC, BB, BC and CC.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2052064				0	lt	COMBINA implements the formula: (Count1+Count2-1)! / (Count2!(Count1-1)!)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154584	288			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152904	289			0	lt	\<item type=\"input\"\>=COMBINA(3;2)\</item\> returns 6.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3156086				0	lt	\<bookmark_value\>TRUNC function\</bookmark_value\>\<bookmark_value\>decimal places;cutting off\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3156086	291			0	lt	TRUNC				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157866	292			0	lt	\<ahelp hid=\"HID_FUNC_KUERZEN\"\>Truncates a number by removing decimal places.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3148499	293			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148511	294			0	lt	TRUNC(Number; Count)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150796	295			0	lt	Returns \<emph\>Number\</emph\> with at most \<emph\>Count\</emph\> decimal places. Excess decimal places are simply removed, irrespective of sign.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150816	296			0	lt	\<item type=\"literal\"\>TRUNC(Number; 0)\</item\> behaves as \<item type=\"literal\"\>INT(Number)\</item\> for positive numbers, but effectively rounds towards zero for negative numbers.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148548	557			0	lt	The \<emph\>visible\</emph\> decimal places of the result are specified in \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - \<link href=\"text/shared/optionen/01060500.xhp\"\>%PRODUCTNAME Calc - Calculate\</link\>.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152555	297			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152569	298			0	lt	\<item type=\"input\"\>=TRUNC(1.239;2)\</item\> returns 1.23. The 9 is lost.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7050080				0	lt	\<item type=\"input\"\>=TRUNC(-1.234999;3)\</item\> returns -1.234. All the 9s are lost.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3153601				0	lt	\<bookmark_value\>LN function\</bookmark_value\>\<bookmark_value\>natural logarithm\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153601	301			0	lt	LN				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154974	302			0	lt	\<ahelp hid=\"HID_FUNC_LN\"\>Returns the natural logarithm based on the constant e of a number.\</ahelp\> The constant e has a value of approximately 2.71828182845904.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154993	303			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155284	304			0	lt	LN(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155297	305			0	lt	\<emph\>Number\</emph\> is the value whose natural logarithm is to be calculated.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153852	306			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153866	307			0	lt	\<item type=\"input\"\>=LN(3)\</item\> returns the natural logarithm of 3 (approximately 1.0986).				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5747245				0	lt	\<item type=\"input\"\>=LN(EXP(321))\</item\> returns 321.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3109813				0	lt	\<bookmark_value\>LOG function\</bookmark_value\>\<bookmark_value\>logarithms\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3109813	311			0	lt	LOG				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3109841	312			0	lt	\<ahelp hid=\"HID_FUNC_LOG\"\>Returns the logarithm of a number to the specified base.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144719	313			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144732	314			0	lt	LOG(Number; Base)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144746	315			0	lt	\<emph\>Number\</emph\> is the value whose logarithm is to be calculated.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152840	316			0	lt	\<emph\>Base\</emph\> (optional) is the base for the logarithm calculation. If omitted, Base 10 is assumed.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152860	317			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154429	318			0	lt	\<item type=\"input\"\>=LOG(10;3)\</item\> returns the logarithm to base 3 of 10 (approximately 2.0959).				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5577562				0	lt	\<item type=\"input\"\>=LOG(7^4;7)\</item\> returns 4.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3154187				0	lt	\<bookmark_value\>LOG10 function\</bookmark_value\>\<bookmark_value\>base-10 logarithm\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154187	322			0	lt	LOG10				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155476	323			0	lt	\<ahelp hid=\"HID_FUNC_LOG10\"\>Returns the base-10 logarithm of a number.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155494	324			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159294	325			0	lt	LOG10(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159308	326			0	lt	Returns the logarithm to base 10 of \<emph\>Number\</emph\>.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3159328	327			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157916	328			0	lt	\<item type=\"input\"\>=LOG10(5)\</item\> returns the base-10 logarithm of 5 (approximately 0.69897).				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152518				0	lt	\<bookmark_value\>CEILING function\</bookmark_value\>\<bookmark_value\>rounding;up to multiples of significance\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152518	332			0	lt	CEILING				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153422	558			0	lt	\<ahelp hid=\"HID_FUNC_OBERGRENZE\"\>Rounds a number up to the nearest multiple of Significance.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153440	334			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153454	335			0	lt	CEILING(Number; Significance; Mode)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153467	336			0	lt	\<emph\>Number\</emph\> is the number that is to be rounded up.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155000	337			0	lt	\<emph\>Significance\</emph\> is the number to whose multiple the value is to be rounded up.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155020	559			0	lt	\<emph\>Mode\</emph\> is an optional value. If the Mode value is given and not equal to zero, and if Number and Significance are negative, then rounding is done based on the absolute value of Number. This parameter is ignored when exporting to MS Excel as Excel does not know any third parameter.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163792	629			0	lt	If both parameters Number and Significance are negative and the Mode value is equal to zero or is not given, the results in $[officename] and Excel will differ after the import has been completed. If you export the spreadsheet to Excel, use Mode=1 to see the same results in Excel as in Calc.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145697	338			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145710	339			0	lt	\<item type=\"input\"\>=CEILING(-11;-2)\</item\> returns -10				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145725	340			0	lt	\<item type=\"input\"\>=CEILING(-11;-2;0)\</item\> returns -10				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145740	341			0	lt	\<item type=\"input\"\>=CEILING(-11;-2;1)\</item\> returns -12				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3157762				0	lt	\<bookmark_value\>PI function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157762	343			0	lt	PI				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157790	344			0	lt	\<ahelp hid=\"HID_FUNC_PI\"\>Returns 3.14159265358979, the value of the mathematical constant PI to 14 decimal places.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157809	345			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157822	346			0	lt	PI()				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157836	347			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152370	348			0	lt	\<item type=\"input\"\>=PI()\</item\> returns 3.14159265358979.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152418				0	lt	\<bookmark_value\>MULTINOMIAL function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152418	635			0	lt	MULTINOMIAL				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152454	636			0	lt	\<ahelp hid=\"HID_AAI_FUNC_MULTINOMIAL\"\> Returns the factorial of the sum of the arguments divided by the product of the factorials of the arguments.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155646	637			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155660	638			0	lt	MULTINOMIAL(Number(s))				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155673	639			0	lt	\<emph\>Number(s)\</emph\> is a list of up to 30 numbers.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155687	640			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155701	641			0	lt	\<item type=\"input\"\>=MULTINOMIAL(F11:H11)\</item\> returns 1260, if F11 to H11 contain the values \<item type=\"input\"\>2\</item\>, \<item type=\"input\"\>3\</item\> and \<item type=\"input\"\>4\</item\>. This corresponds to the formula =(2+3+4)! / (2!*3!*4!)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3155717				0	lt	\<bookmark_value\>POWER function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155717	350			0	lt	POWER				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159495	351			0	lt	\<ahelp hid=\"HID_FUNC_POTENZ\"\>Returns a number raised to another number.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3159513	352			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159526	353			0	lt	POWER(Base; Exponent)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159540	354			0	lt	Returns \<emph\>Base\</emph\> raised to the power of \<emph\>Exponent\</emph\>.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5081637				0	lt	The same result may be achieved by using the exponentiation operator ^:				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9759514				0	lt	\<item type=\"literal\"\>Base^Exponent\</item\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3159580	356			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159594	357			0	lt	\<item type=\"input\"\>=POWER(4;3)\</item\> returns 64, which is 4 to the power of 3.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1614429				0	lt	=4^3 also returns 4 to the power of 3.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152651				0	lt	\<bookmark_value\>SERIESSUM function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152651	642			0	lt	SERIESSUM				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152688	643			0	lt	\<ahelp hid=\".\"\>Sums the first terms of a power series.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152708	644			0	lt	SERIESSUM(x;n;m;coefficients) = coefficient_1*x^n + coefficient_2*x^(n+m) + coefficient_3*x^(n+2m) +...+ coefficient_i*x^(n+(i-1)m)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152724	645			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_idN11BD9				0	lt	SERIESSUM(X; N; M; Coefficients)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152737	646			0	lt	\<emph\>X\</emph\> is the input value for the power series.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144344	647			0	lt	\<emph\>N\</emph\> is the initial power				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144357	648			0	lt	\<emph\>M\</emph\> is the increment to increase N				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144370	649			0	lt	\<emph\>Coefficients\</emph\> is a series of coefficients. For each coefficient the series sum is extended by one section.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144386				0	lt	\<bookmark_value\>PRODUCT function\</bookmark_value\>\<bookmark_value\>numbers;multiplying\</bookmark_value\>\<bookmark_value\>multiplying;numbers\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144386	361			0	lt	PRODUCT				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144414	362			0	lt	\<ahelp hid=\"HID_FUNC_PRODUKT\"\>Multiplies all the numbers given as arguments and returns the product.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144433	363			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144446	364			0	lt	PRODUCT(Number1; Number2; ...; Number30)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144460	365			0	lt	\<emph\>Number1 to 30\</emph\> are up to 30 arguments whose product is to be calculated.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1589098				0	lt	PRODUCT returns number1 * number2 * number3 * ...				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144480	366			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144494	367			0	lt	\<item type=\"input\"\>=PRODUCT(2;3;4)\</item\> returns 24.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3160340				0	lt	\<bookmark_value\>SUMSQ function\</bookmark_value\>\<bookmark_value\>square number additions\</bookmark_value\>\<bookmark_value\>sums;of square numbers\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160340	369			0	lt	SUMSQ				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160368	370			0	lt	\<ahelp hid=\"HID_FUNC_QUADRATESUMME\"\>If you want to calculate the sum of the squares of numbers (totaling up of the squares of the arguments), enter these into the text fields.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160388	371			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160402	372			0	lt	SUMSQ(Number1; Number2; ...; Number30)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160415	373			0	lt	\<emph\>Number1 to 30\</emph\> are up to 30 arguments the sum of whose squares is to be calculated.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160436	374			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160449	375			0	lt	If you enter the numbers \<item type=\"input\"\>2\</item\>; \<item type=\"input\"\>3\</item\> and \<item type=\"input\"\>4\</item\> in the Number 1; 2 and 3 text boxes, 29 is returned as the result.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3158247				0	lt	\<bookmark_value\>MOD function\</bookmark_value\>\<bookmark_value\>remainders of divisions\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158247	387			0	lt	MOD				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158276	388			0	lt	\<ahelp hid=\"HID_FUNC_REST\"\>Returns the remainder when one integer is divided by another.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158294	389			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158308	390			0	lt	MOD(Dividend; Divisor)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158321	391			0	lt	 For integer arguments this function returns Dividend modulo Divisor, that is the remainder when \<emph\>Dividend\</emph\> is divided by \<emph\>Divisor\</emph\>.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158341	392			0	lt	This function is implemented as \<item type=\"literal\"\>Dividend - Divisor * INT(Dividend/Divisor)\</item\> , and this formula gives the result if the arguments are not integer.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158361	393			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158374	394			0	lt	\<item type=\"input\"\>=MOD(22;3)\</item\> returns 1, the remainder when 22 is divided by 3.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1278420				0	lt	\<item type=\"input\"\>=MOD(11.25;2.5)\</item\> returns 1.25.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144592				0	lt	\<bookmark_value\>QUOTIENT function\</bookmark_value\>\<bookmark_value\>divisions\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144592	652			0	lt	QUOTIENT				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144627	653			0	lt	\<ahelp hid=\"HID_AAI_FUNC_QUOTIENT\"\>Returns the integer part of a division operation.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144646	654			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144659	655			0	lt	QUOTIENT(Numerator; Denominator)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9038972				0	lt	Returns the integer part of \<emph\>Numerator\</emph\> divided by \<emph\>Denominator\</emph\>.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7985168				0	lt	QUOTIENT is equivalent to \<item type=\"literal\"\>INT(numerator/denominator)\</item\>, except that it may report errors with different error codes.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144674	656			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144687	657			0	lt	\<item type=\"input\"\>=QUOTIENT(11;3)\</item\> returns 3. The remainder of 2 is lost.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144702				0	lt	\<bookmark_value\>RADIANS function\</bookmark_value\>\<bookmark_value\>converting;degrees, into radians\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144702	377			0	lt	RADIANS				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158025	378			0	lt	\<ahelp hid=\"HID_FUNC_RAD\"\>Converts degrees to radians.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158042	379			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158055	380			0	lt	RADIANS(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158069	381			0	lt	\<emph\>Number\</emph\> is the angle in degrees to be converted to radians.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id876186				0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3939634				0	lt	\<item type=\"input\"\>=RADIANS(90)\</item\> returns 1.5707963267949, which is PI/2 to Calc's accuracy.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3158121				0	lt	\<bookmark_value\>ROUND function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158121	398			0	lt	ROUND				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158150	399			0	lt	\<ahelp hid=\"HID_FUNC_RUNDEN\"\>Rounds a number to a certain number of decimal places.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158169	400			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158182	401			0	lt	ROUND(Number; Count)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158196	402			0	lt	Returns \<emph\>Number\</emph\> rounded to \<emph\>Count\</emph\> decimal places. If Count is omitted or zero, the function rounds to the nearest integer. If Count is negative, the function rounds to the nearest 10, 100, 1000, etc.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id599688				0	lt	This function rounds to the nearest number. See ROUNDDOWN and ROUNDUP for alternatives.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145863	404			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145876	405			0	lt	\<item type=\"input\"\>=ROUND(2.348;2)\</item\> returns 2.35				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145899	406			0	lt	\<item type=\"input\"\>=ROUND(-32.4834;3)\</item\> returns -32.483. Change the cell format to see all decimals.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1371501				0	lt	\<item type=\"input\"\>=ROUND(2.348;0)\</item\> returns 2.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id4661702				0	lt	\<item type=\"input\"\>=ROUND(2.5)\</item\> returns 3. 				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7868892				0	lt	\<item type=\"input\"\>=ROUND(987.65;-2)\</item\> returns 1000.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3145991				0	lt	\<bookmark_value\>ROUNDDOWN function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145991	24			0	lt	ROUNDDOWN				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146020	25			0	lt	\<ahelp hid=\"HID_FUNC_ABRUNDEN\"\>Rounds a number down, toward zero, to a certain precision.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146037	26			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146051	27			0	lt	ROUNDDOWN(Number; Count)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146064	28			0	lt	Returns \<emph\>Number\</emph\> rounded down (towards zero) to \<emph\>Count\</emph\> decimal places. If Count is omitted or zero, the function rounds down to an integer. If Count is negative, the function rounds down to the next 10, 100, 1000, etc.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2188787				0	lt	This function rounds towards zero. See ROUNDUP and ROUND for alternatives.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163164	30			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163178	31			0	lt	\<item type=\"input\"\>=ROUNDDOWN(1.234;2)\</item\> returns 1.23.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5833307				0	lt	\<item type=\"input\"\>=ROUNDDOWN(45.67;0)\</item\> returns 45.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7726676				0	lt	\<item type=\"input\"\>=ROUNDDOWN(-45.67)\</item\> returns -45.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3729361				0	lt	\<item type=\"input\"\>=ROUNDDOWN(987.65;-2)\</item\> returns 900.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3163268				0	lt	\<bookmark_value\>ROUNDUP function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163268	140			0	lt	ROUNDUP				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163297	141			0	lt	\<ahelp hid=\"HID_FUNC_AUFRUNDEN\"\>Rounds a number up, away from zero, to a certain precision.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163315	142			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163328	143			0	lt	ROUNDUP(Number; Count)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163342	144			0	lt	Returns \<emph\>Number\</emph\> rounded up (away from zero) to \<emph\>Count\</emph\> decimal places. If Count is omitted or zero, the function rounds up to an integer. If Count is negative, the function rounds up to the next 10, 100, 1000, etc.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9573961				0	lt	This function rounds away from zero. See ROUNDDOWN and ROUND for alternatives.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163381	146			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144786	147			0	lt	\<item type=\"input\"\>=ROUNDUP(1.1111;2)\</item\> returns 1.12.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7700430				0	lt	\<item type=\"input\"\>=ROUNDUP(1.2345;1)\</item\> returns 1.3.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1180455				0	lt	\<item type=\"input\"\>=ROUNDUP(45.67;0)\</item\> returns 46.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3405560				0	lt	\<item type=\"input\"\>=ROUNDUP(-45.67)\</item\> returns -46.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3409527				0	lt	\<item type=\"input\"\>=ROUNDUP(987.65;-2)\</item\> returns 1000.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144877				0	lt	\<bookmark_value\>SIN function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144877	408			0	lt	SIN				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144906	409			0	lt	\<ahelp hid=\"HID_FUNC_SIN\"\>Returns the sine of the given angle (in radians).\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144923	410			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144937	411			0	lt	SIN(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144950	412			0	lt	Returns the (trigonometric) sine of \<emph\>Number\</emph\>, the angle in radians.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8079470				0	lt	To return the sine of an angle in degrees, use the RADIANS function.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144969	413			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144983	414			0	lt	\<item type=\"input\"\>=SIN(PI()/2)\</item\> returns 1, the sine of PI/2 radians.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3916440				0	lt	\<item type=\"input\"\>=SIN(RADIANS(30))\</item\> returns 0.5, the sine of 30 degrees.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3163397				0	lt	\<bookmark_value\>SINH function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163397	418			0	lt	SINH				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163426	419			0	lt	\<ahelp hid=\"HID_FUNC_SINHYP\"\>Returns the hyperbolic sine of a number.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163444	420			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163457	421			0	lt	SINH(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163471	422			0	lt	Returns the hyperbolic sine of \<emph\>Number\</emph\>.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163491	423			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163504	424			0	lt	\<item type=\"input\"\>=SINH(0)\</item\> returns 0, the hyperbolic sine of 0.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3163596				0	lt	\<bookmark_value\>SUM function\</bookmark_value\>\<bookmark_value\>adding;numbers in cell ranges\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163596	428			0	lt	SUM				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163625	429			0	lt	\<ahelp hid=\"HID_FUNC_SUMME\"\>Adds all the numbers in a range of cells.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163643	430			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163656	431			0	lt	SUM(Number1; Number2; ...; Number30)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163671	432			0	lt	\<emph\>Number 1 to Number 30\</emph\> are up to 30 arguments whose sum is to be calculated.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163690	433			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163704	434			0	lt	If you enter the numbers \<item type=\"input\"\>2\</item\>; \<item type=\"input\"\>3 \</item\>and \<item type=\"input\"\>4\</item\> in the Number 1; 2 and 3 text boxes, 9 will be returned as the result.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151740	556			0	lt	\<item type=\"input\"\>=SUM(A1;A3;B5)\</item\> calculates the sum of the three cells. \<item type=\"input\"\>=SUM (A1:E10)\</item\> calculates the sum of all cells in the A1 to E10 cell range.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151756	619			0	lt	Conditions linked by AND can be used with the function SUM() in the following manner:				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151774	620			0	lt	Example assumption: You have entered invoices into a table. Column A contains the date value of the invoice, column B the amounts. You want to find a formula that you can use to return the total of all amounts only for a specific month, e.g. only the amount for the period >=2008-01-01 to <2008-02-01. The range with the date values covers A1:A40, the range containing the amounts to be totaled is B1:B40. C1 contains the start date, 2008\<item type=\"input\"\>-01-01\</item\>, of the invoices to be included and C2 the date, 2008\<item type=\"input\"\>-02-01\</item\>, that is no longer included.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151799	621			0	lt	Enter the following formula as an array formula:				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151813	622			0	lt	\<item type=\"input\"\>=SUM((A1:A40>=C1)*(A1:A40<C2)*B1:B40)\</item\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151828	623			0	lt	In order to enter this as an array formula, you must press the Shift\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>+Command \</caseinline\>\<defaultinline\>+ Ctrl\</defaultinline\>\</switchinline\>+ Enter keys instead of simply pressing the Enter key to close the formula. The formula will then be shown in the \<emph\>Formula\</emph\> bar enclosed in braces.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151869	624			0	lt	{=SUM((A1:A40>=C1)*(A1:A40<C2)*B1:B40)}				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151884	625			0	lt	The formula is based on the fact that the result of a comparison is 1 if the criterion is met and 0 if it is not met. The individual comparison results will be treated as an array and used in matrix multiplication, and at the end the individual values will be totaled to give the result matrix.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3151957				0	lt	\<bookmark_value\>SUMIF function\</bookmark_value\>\<bookmark_value\>adding;specified numbers\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3151957	436			0	lt	SUMIF				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151986	437			0	lt	\<ahelp hid=\"HID_FUNC_SUMMEWENN\"\>Adds the cells specified by a given criteria.\</ahelp\> This function is used to browse a range when you search for a certain value.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152015	438			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152028	439			0	lt	SUMIF(Range; Criteria; SumRange)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152043	440			0	lt	\<emph\>Range\</emph\> is the range to which the criteria are to be applied.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152062	441			0	lt	\<emph\>Criteria\</emph\> is the cell in which the search criterion is shown, or the search criterion itself. If the criteria is written into the formula, it has to be surrounded by double quotes.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152083	442			0	lt	\<emph\>SumRange\</emph\> is the range from which values are summed. If this parameter has not been indicated, the values found in the Range are summed.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8347422				0	lt	SUMIF supports the reference concatenation operator (~) only in the Criteria parameter, and only if the optional SumRange parameter is not given.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152110	443			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152148	626			0	lt	To sum up only negative numbers: \<item type=\"input\"\>=SUMIF(A1:A10;"<0")\</item\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6670125				0	lt	\<item type=\"input\"\>=SUMIF(A1:A10;">0";B1:10)\</item\> - sums values from the range B1:B10 only if the corresponding values in the range A1:A10 are >0.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6062196				0	lt	See COUNTIF() for some more syntax examples that can be used with SUMIF().				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152195				0	lt	\<bookmark_value\>TAN function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152195	446			0	lt	TAN				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152224	447			0	lt	\<ahelp hid=\"HID_FUNC_TAN\"\>Returns the tangent of the given angle (in radians).\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152242	448			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152255	449			0	lt	TAN(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152269	450			0	lt	Returns the (trigonometric) tangent of \<emph\>Number\</emph\>, the angle in radians.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5752128				0	lt	To return the tangent of an angle in degrees, use the RADIANS function.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152287	451			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152301	452			0	lt	\<item type=\"input\"\>=TAN(PI()/4) \</item\>returns 1, the tangent of PI/4 radians.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1804864				0	lt	\<item type=\"input\"\>=TAN(RADIANS(45))\</item\> returns 1, the tangent of 45 degrees.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3165434				0	lt	\<bookmark_value\>TANH function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165434	456			0	lt	TANH				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165462	457			0	lt	\<ahelp hid=\"HID_FUNC_TANHYP\"\>Returns the hyperbolic tangent of a number.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165480	458			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165494	459			0	lt	TANH(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165508	460			0	lt	Returns the hyperbolic tangent of \<emph\>Number\</emph\>.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165527	461			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165541	462			0	lt	\<item type=\"input\"\>=TANH(0)\</item\> returns 0, the hyperbolic tangent of 0.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3165633				0	lt	\<bookmark_value\>AutoFilter function; subtotals\</bookmark_value\>\<bookmark_value\>sums;of filtered data\</bookmark_value\>\<bookmark_value\>filtered data; sums\</bookmark_value\>\<bookmark_value\>SUBTOTAL function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165633	466			0	lt	SUBTOTAL				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165682	467			0	lt	\<ahelp hid=\"HID_FUNC_TEILERGEBNIS\"\>Calculates subtotals.\</ahelp\> If a range already contains subtotals, these are not used for further calculations. Use this function with the AutoFilters to take only the filtered records into account.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165704	495			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165717	496			0	lt	SUBTOTAL(Function; Range)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165731	497			0	lt	\<emph\>Function\</emph\> is a number that stands for one of the following functions:				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165782	469			0	lt	Function index				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165806	470			0	lt	Function				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165833	471			0	lt	1				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165856	472			0	lt	AVERAGE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165883	473			0	lt	2				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165906	474			0	lt	COUNT				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165933	475			0	lt	3				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165956	476			0	lt	COUNTA				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165983	477			0	lt	4				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166006	478			0	lt	MAX				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166033	479			0	lt	5				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166056	480			0	lt	MIN				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143316	481			0	lt	6				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143339	482			0	lt	PRODUCT				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143366	483			0	lt	7				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143389	484			0	lt	STDEV				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143416	485			0	lt	8				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143439	486			0	lt	STDEVP				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143466	487			0	lt	9				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143489	488			0	lt	SUM				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143516	489			0	lt	10				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143539	490			0	lt	VAR				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143566	491			0	lt	11				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143589	492			0	lt	VARP				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143606	498			0	lt	\<emph\>Range\</emph\> is the range whose cells are included.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3143625	499			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143638	562			0	lt	You have a table in the cell range A1:B5 containing cities in column A and accompanying figures in column B. You have used an AutoFilter so that you only see rows containing the city Hamburg. You want to see the sum of the figures that are displayed; that is, just the subtotal for the filtered rows. In this case the correct formula would be:				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143658	563			0	lt	\<item type=\"input\"\>=SUBTOTAL(9;B2:B5)\</item\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3143672				0	lt	\<bookmark_value\>Euro; converting\</bookmark_value\>\<bookmark_value\>EUROCONVERT function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3143672	564			0	lt	EUROCONVERT				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143708	565			0	lt	\<ahelp hid=\"HID_FUNC_UMRECHNEN\"\>Converts between old European national currency and to and from Euros.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143731	566			0	lt	\<emph\>Syntax\</emph\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143748	567			0	lt	EUROCONVERT(Value; "From_currency"; "To_currency", full_precision, triangulation_precision)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143763	568			0	lt	\<emph\>Value\</emph\> is the amount of the currency to be converted.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143782	569			0	lt	\<emph\>From_currency\</emph\> and \<emph\>To_currency\</emph\> are the currency units to convert from and to respectively. These must be text, the official abbreviation for the currency (for example, "EUR"). The rates (shown per Euro) were set by the European Commission.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0119200904301810				0	lt	\<emph\>Full_precision\</emph\> is optional. If omitted or False, the result is rounded according to the decimals of the To currency. If Full_precision is True, the result is not rounded.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0119200904301815				0	lt	\<emph\>Triangulation_precision\</emph\> is optional. If Triangulation_precision is given and >=3, the intermediate result of a triangular conversion (currency1,EUR,currency2) is rounded to that precision. If Triangulation_precision is omitted, the intermediate result is not rounded. Also if To currency is "EUR", Triangulation_precision is used as if triangulation was needed and conversion from EUR to EUR was applied.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143819	570			0	lt	\<emph\>Examples\</emph\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143837	571			0	lt	\<item type=\"input\"\>=EUROCONVERT(100;"ATS";"EUR")\</item\> converts 100 Austrian Schillings into Euros.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143853	572			0	lt	\<item type=\"input\"\>=EUROCONVERT(100;"EUR";"DEM")\</item\> converts 100 Euros into German Marks.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id0908200902090676				0	lt	\<bookmark_value\>CONVERT function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id0908200902074836				0	lt	CONVERT				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902131122				0	lt	\<ahelp hid=\".\"\>Converts a value from one unit of measurement to another unit of measurement. The conversion factors are given in a list in the configuration.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902475420				0	lt	At one time the list of conversion factors included the legacy European currencies and the Euro (see examples below). We suggest using the new function EUROCONVERT for converting these currencies.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id0908200902131071				0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902131191				0	lt	CONVERT(value;"text";"text")				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id0908200902131152				0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id090820090213112				0	lt	\<item type=\"input\"\>=CONVERT(100;"ATS";"EUR")\</item\> returns the Euro value of 100 Austrian Schillings.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902475431				0	lt	=CONVERT(100;"EUR";"DEM") converts 100 Euros into German Marks. 				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3157177				0	lt	\<bookmark_value\>ODD function\</bookmark_value\>\<bookmark_value\>rounding;up/down to nearest odd integer\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157177	502			0	lt	ODD				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157205	503			0	lt	\<ahelp hid=\"HID_FUNC_UNGERADE\"\>Rounds a positive number up to the nearest odd integer and a negative number down to the nearest odd integer.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157223	504			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157237	505			0	lt	ODD(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157250	506			0	lt	 Returns \<emph\>Number\</emph\> rounded to the next odd integer up, away from zero.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157270	507			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157283	508			0	lt	\<item type=\"input\"\>=ODD(1.2)\</item\> returns 3.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8746910				0	lt	\<item type=\"input\"\>=ODD(1)\</item\> returns 1.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9636524				0	lt	\<item type=\"input\"\>=ODD(0)\</item\> returns 1.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5675527				0	lt	\<item type=\"input\"\>=ODD(-3.1)\</item\> returns -5.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3157404				0	lt	\<bookmark_value\>FLOOR function\</bookmark_value\>\<bookmark_value\>rounding;down to nearest multiple of significance\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157404	512			0	lt	FLOOR				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157432	513			0	lt	\<ahelp hid=\"HID_FUNC_UNTERGRENZE\"\>Rounds a number down to the nearest multiple of Significance.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157451	514			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157464	515			0	lt	FLOOR(Number; Significance; Mode)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157478	516			0	lt	\<emph\>Number\</emph\> is the number that is to be rounded down.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157497	517			0	lt	\<emph\>Significance\</emph\> is the value to whose multiple the number is to be rounded down.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157517	561			0	lt	\<emph\>Mode\</emph\> is an optional value. If the Mode value is given and not equal to zero, and if Number and Significance are negative, then rounding is done based on the absolute value of the number. This parameter is ignored when exporting to MS Excel as Excel does not know any third parameter.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163894	630			0	lt	If both parameters Number and Significance are negative, and if the Mode value is equal to zero or is not specified, then the results in $[officename] Calc and Excel will differ after exporting. If you export the spreadsheet to Excel, use Mode=1 to see the same results in Excel as in Calc.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163932	518			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163945	519			0	lt	\<item type=\"input\"\>=FLOOR( -11;-2)\</item\> returns -12				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163966	520			0	lt	\<item type=\"input\"\>=FLOOR( -11;-2;0)\</item\> returns -12				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163988	521			0	lt	\<item type=\"input\"\>=FLOOR( -11;-2;1)\</item\> returns -10				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164086				0	lt	\<bookmark_value\>SIGN function\</bookmark_value\>\<bookmark_value\>algebraic signs\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164086	523			0	lt	SIGN				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164115	524			0	lt	\<ahelp hid=\"HID_FUNC_VORZEICHEN\"\>Returns the sign of a number. Returns 1 if the number is positive, -1 if negative and 0 if zero.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164136	525			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164150	526			0	lt	SIGN(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164164	527			0	lt	\<emph\>Number\</emph\> is the number whose sign is to be determined.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164183	528			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164197	529			0	lt	\<item type=\"input\"\>=SIGN(3.4)\</item\> returns 1.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164212	530			0	lt	\<item type=\"input\"\>=SIGN(-4.5)\</item\> returns -1.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164252				0	lt	\<bookmark_value\>MROUND function\</bookmark_value\>\<bookmark_value\>nearest multiple\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164252	658			0	lt	MROUND				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164288	659			0	lt	\<ahelp hid=\"HID_AAI_FUNC_MROUND\"\>Returns a number rounded to the nearest multiple of another number.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164306	660			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164320	661			0	lt	MROUND(Number; Multiple)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3486434				0	lt	Returns \<emph\>Number\</emph\> rounded to the nearest multiple of \<emph\>Multiple\</emph\>. 				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3068636				0	lt	An alternative implementation would be \<item type=\"literal\"\>Multiple * ROUND(Number/Multiple)\</item\>.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164333	662			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164347	663			0	lt	\<item type=\"input\"\>=MROUND(15.5;3)\</item\> returns 15, as 15.5 is closer to 15 (= 3*5) than to 18 (= 3*6).				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_idN14DD6				0	lt	\<item type=\"input\"\>=MROUND(1.4;0.5)\</item\> returns 1.5 (= 0.5*3).				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164375				0	lt	\<bookmark_value\>SQRT function\</bookmark_value\>\<bookmark_value\>square roots;positive numbers\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164375	532			0	lt	SQRT				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164404	533			0	lt	\<ahelp hid=\"HID_FUNC_WURZEL\"\>Returns the positive square root of a number.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164424	534			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164437	535			0	lt	SQRT(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164451	536			0	lt	Returns the positive square root of \<emph\>Number\</emph\>.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6870021				0	lt	 Number must be positive.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164471	537			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164484	538			0	lt	\<item type=\"input\"\>=SQRT(16)\</item\> returns 4.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3591723				0	lt	\<item type=\"input\"\>=SQRT(-16)\</item\> returns an \<item type=\"literal\"\>invalid argument\</item\> error.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164560				0	lt	\<bookmark_value\>SQRTPI function\</bookmark_value\>\<bookmark_value\>square roots;products of Pi\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164560	665			0	lt	SQRTPI				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164596	666			0	lt	\<ahelp hid=\"HID_AAI_FUNC_SQRTPI\"\>Returns the square root of (PI times a number).\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164614	667			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164627	668			0	lt	SQRTPI(Number)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1501510				0	lt	Returns the positive square root of (PI multiplied by \<emph\>Number\</emph\>).				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9929197				0	lt	This is equivalent to \<item type=\"literal\"\>SQRT(PI()*Number)\</item\>.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164641	669			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164654	670			0	lt	\<item type=\"input\"\>=SQRTPI(2)\</item\> returns the squareroot of (2PI), approximately 2.506628.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164669				0	lt	\<bookmark_value\>random numbers; between limits\</bookmark_value\>\<bookmark_value\>RANDBETWEEN function\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164669	671			0	lt	RANDBETWEEN				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164711	672			0	lt	\<ahelp hid=\"HID_AAI_FUNC_RANDBETWEEN\"\>Returns an integer random number in a specified range.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164745	673			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164758	674			0	lt	RANDBETWEEN(Bottom; Top)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7112338				0	lt	Returns an integer random number between integers \<emph\>Bottom\</emph\> and \<emph\>Top\</emph\> (both inclusive).				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2855616				0	lt	This function produces a new random number each time Calc recalculates. To force Calc to recalculate manually press Shift+\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command \</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+F9.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2091433				0	lt	To generate random numbers which never recalculate, copy cells containing this function, and use \<item type=\"menuitem\"\>Edit - Paste Special\</item\> (with \<item type=\"menuitem\"\>Paste All\</item\> and \<item type=\"menuitem\"\>Formulas\</item\> not marked and \<item type=\"menuitem\"\>Numbers\</item\> marked).				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164772	675			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164785	676			0	lt	\<item type=\"input\"\>=RANDBETWEEN(20;30)\</item\> returns an integer of between 20 and 30.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164800				0	lt	\<bookmark_value\>RAND function\</bookmark_value\>\<bookmark_value\>random numbers;between 0 and 1\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164800	542			0	lt	RAND				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164829	543			0	lt	\<ahelp hid=\"HID_FUNC_ZUFALLSZAHL\"\>Returns a random number between 0 and 1.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164870	545			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164884	546			0	lt	RAND()				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5092318				0	lt	This function produces a new random number each time Calc recalculates. To force Calc to recalculate manually press Shift+\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command \</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+F9.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9312417				0	lt	To generate random numbers which never recalculate, copy cells each containing =RAND(), and use \<item type=\"menuitem\"\>Edit - Paste Special\</item\> (with \<item type=\"menuitem\"\>Paste All\</item\> and \<item type=\"menuitem\"\>Formulas\</item\> not marked and \<item type=\"menuitem\"\>Numbers\</item\> marked).				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id9089022				0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9569078				0	lt	\<item type=\"input\"\>=RAND()\</item\> returns a random number between 0 and 1.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164897				0	lt	\<bookmark_value\>COUNTIF function\</bookmark_value\>\<bookmark_value\>counting;specified cells\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164897	547			0	lt	COUNTIF				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164926	548			0	lt	\<ahelp hid=\"HID_FUNC_ZAEHLENWENN\"\>Returns the number of cells that meet with certain criteria within a cell range.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164953	549			0	lt	Syntax				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164967	550			0	lt	COUNTIF(Range; Criteria)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164980	551			0	lt	\<emph\>Range\</emph\> is the range to which the criteria are to be applied.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165000	552			0	lt	\<emph\>Criteria\</emph\> indicates the criteria in the form of a number, an expression or a character string. These criteria determine which cells are counted. You may also enter a search text in the form of a regular expression, e.g. b.* for all words that begin with b. You may also indicate a cell range that contains the search criterion. If you search for literal text, enclose the text in double quotes.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165037	553			0	lt	Example				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166505	627			0	lt	A1:A10 is a cell range containing the numbers \<item type=\"input\"\>2000\</item\> to \<item type=\"input\"\>2009\</item\>. Cell B1 contains the number \<item type=\"input\"\>2006\</item\>. In cell B2, you enter a formula:				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3581652				0	lt	\<item type=\"input\"\>=COUNTIF(A1:A10;2006)\</item\> - this returns 1				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id708639				0	lt	\<item type=\"input\"\>=COUNTIF(A1:A10;B1)\</item\> - this returns 1				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5169225				0	lt	\<item type=\"input\"\>=COUNTIF(A1:A10;">=2006") \</item\>- this returns 4				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2118594				0	lt	\<item type=\"input\"\>=COUNTIF(A1:A10;"<"&B1)\</item\> - when B1 contains \<item type=\"input\"\>2006\</item\>, this returns 6				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id166020				0	lt	\<item type=\"input\"\>=COUNTIF(A1:A10;C2)\</item\> where cell C2 contains the text \<item type=\"input\"\>>2006\</item\> counts the number of cells in the range A1:A10 which are >2006 				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6386913				0	lt	To count only negative numbers: \<item type=\"input\"\>=COUNTIF(A1:A10;"<0")\</item\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	tit				0	lt	Array Functions				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3147273				0	lt	\<bookmark_value\>matrices; functions\</bookmark_value\>\<bookmark_value\>Function Wizard; arrays\</bookmark_value\>\<bookmark_value\>array formulas\</bookmark_value\>\<bookmark_value\>inline array constants\</bookmark_value\>\<bookmark_value\>formulas;arrays\</bookmark_value\>\<bookmark_value\>functions;array functions\</bookmark_value\>\<bookmark_value\>editing; array formulas\</bookmark_value\>\<bookmark_value\>copying; array formulas\</bookmark_value\>\<bookmark_value\>adjusting array ranges\</bookmark_value\>\<bookmark_value\>calculating;conditional calculations\</bookmark_value\>\<bookmark_value\>matrices; calculations\</bookmark_value\>\<bookmark_value\>conditional calculations with arrays\</bookmark_value\>\<bookmark_value\>implicit array handling\</bookmark_value\>\<bookmark_value\>forced array handling\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3147273	1			0	lt	Array Functions				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154744	2			0	lt	\<variable id=\"matrixtext\"\>This category contains the array functions. \</variable\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3146084	257			0	lt	What is an Array?				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154298	258			0	lt	\<variable id=\"wasmatrix\"\>An array is a linked range of cells on a spreadsheet containing values. \</variable\> A square range of 3 rows and 3 columns is a 3 x 3 array:				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154692	260			0	lt	A				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3150117	261			0	lt	B				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3155325	262			0	lt	C				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3153104	263			0	lt	1				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3146996	264			0	lt	\<item type=\"input\"\>7\</item\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3150529	265			0	lt	\<item type=\"input\"\>31\</item\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3148831	266			0	lt	\<item type=\"input\"\>33\</item\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3148943	267			0	lt	2				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149771	268			0	lt	\<item type=\"input\"\>95\</item\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3158407	269			0	lt	\<item type=\"input\"\>17\</item\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3148806	270			0	lt	\<item type=\"input\"\>2\</item\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154904	271			0	lt	3				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3150779	272			0	lt	\<item type=\"input\"\>5\</item\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3148449	273			0	lt	\<item type=\"input\"\>10\</item\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3147238	274			0	lt	\<item type=\"input\"\>50\</item\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3153583	277			0	lt	The smallest possible array is a 1 x 2 or 2 x 1 array with two adjacent cells.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3148474	275			0	lt	What is an array formula?				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3155355	276			0	lt	A formula in which the individual values in a cell range are evaluated is referred to as an array formula. The difference between an array formula and other formulas is that the array formula deals with several values simultaneously instead of just one.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3151052	278			0	lt	Not only can an array formula process several values, but it can also return several values. The results of an array formula is also an array.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3158432	279			0	lt	To multiply the values in the individual cells by 10 in the above array, you do not need to apply a formula to each individual cell or value. Instead you just need to use a single array formula. Select a range of 3 x 3 cells on another part of the spreadsheet, enter the formula \<item type=\"input\"\>=10*A1:C3\</item\> and confirm this entry using the key combination \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+Shift+Enter. The result is a 3 x 3 array in which the individual values in the cell range (A1:C3) are multiplied by a factor of 10.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149156	280			0	lt	In addition to multiplication, you can also use other operators on the reference range (an array). With $[officename] Calc, you can add (+), subtract (-), multiply (*), divide (/), use exponents (^), concatenation (&) and comparisons (=, <>, <, >, <=, >=). The operators can be used on each individual value in the cell range and return the result as an array if the array formula was entered.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166456	326			0	lt	Comparison operators in an array formula treat empty cells in the same way as in a normal formula, that is, either as zero or as an empty string. For example, if cells A1 and A2 are empty the array formulas \<item type=\"input\"\>{=A1:A2=""}\</item\> and \<item type=\"input\"\>{=A1:A2=0}\</item\> will both return a 1 column 2 row array of cells containing TRUE.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3150713	281			0	lt	When do you use array formulas?				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149787	282			0	lt	Use array formulas if you have to repeat calculations using different values. If you decide to change the calculation method later, you only have to update the array formula. To add an array formula, select the entire array range and then \<link href=\"text/scalc/01/04060107.xhp\" name=\"make the required change to the array formula\"\>make the required change to the array formula\</link\>.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149798	283			0	lt	Array formulas are also a space saving option when several values must be calculated, since they are not very memory-intensive. In addition, arrays are an essential tool for carrying out complex calculations, because you can have several cell ranges included in your calculations. $[officename] has different math functions for arrays, such as the MMULT function for multiplying two arrays or the SUMPRODUCT function for calculating the scalar products of two arrays.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3155588	284			0	lt	Using Array Formulas in $[officename] Calc				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3152876	285			0	lt	You can also create a "normal" formula in which the reference range, such as parameters, indicate an array formula. The result is obtained from the intersection of the reference range and the rows or columns in which the formula is found. If there is no intersection or if the range at the intersection covers several rows or columns, a #VALUE! error message appears. The following example illustrates this concept:				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3151271	313			0	lt	Creating Array Formulas				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149102	314			0	lt	If you create an array formula using the \<emph\>Function Wizard\</emph\>, you must mark the \<emph\>Array\</emph\> check box each time so that the results are returned in an array. Otherwise, only the value in the upper-left cell of the array being calculated is returned.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3153392	4			0	lt	If you enter the array formula directly into the cell, you must use the key combination Shift+\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+Enter instead of the Enter key. Only then does the formula become an array formula.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3151120	315			0	lt	Array formulas appear in braces in $[officename] Calc. You cannot create array formulas by manually entering the braces.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154342	5			0	lt	The cells in a results array are automatically protected against changes. However, you can edit or copy the array formula by selecting the entire array cell range.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id8834803				0	lt	Using Inline Array Constants in Formulas				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id985747				0	lt	Calc supports inline matrix/array constants in formulas. An inline array is surrounded by curly braces '{' and '}'. Elements can be each a number (including negatives), a logical constant (TRUE, FALSE), or a literal string. Non-constant expressions are not allowed. Arrays can be entered with one or more rows, and one or more columns. All rows must consist of the same number of elements, all columns must consist of the same number of elements. 				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id936613				0	lt	The column separator (separating elements in one row) is the ';' semicolon. The row separator is a '|' pipe symbol. The separators are not language and locale dependent. 				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id1877498				0	lt	Arrays can not be nested.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id4262520				0	lt	\<emph\>Examples:\</emph\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id9387493				0	lt	={1;2;3}				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id8207037				0	lt	An array with one row consisting of the three numbers 1, 2, and 3.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id6757103				0	lt	To enter this array constant, you select three cells in a row, then you type the formula \<item type=\"input\"\>={1;2;3}\</item\> using the curly braces and the semicolons, then press \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+Shift+Enter.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id8868068				0	lt	={1;2;3|4;5;6}				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id6626483				0	lt	An array with two rows and three values in each row.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id5262916				0	lt	={0;1;2|FALSE;TRUE;"two"}				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id1623889				0	lt	A mixed data array.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id7781914				0	lt	=SIN({1;2;3})				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id300912				0	lt	Entered as a matrix formula, delivers the result of three SIN calculations with the arguments 1, 2, and 3.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3148660	316			0	lt	Editing Array Formulas				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149241	317			0	lt	Select the cell range or array containing the array formula. To select the whole array, position the cell cursor inside the array range, then press \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command \</caseinline\>\<defaultinline\>Ctrl \</defaultinline\>\</switchinline\>+ /, where / is the Division key on the numeric keypad.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3143274	318			0	lt	Either press F2 or position the cursor in the input line. Both of these actions let you edit the formula.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154798	319			0	lt	After you have made changes, press \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+Shift+Enter.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3150628	334			0	lt	You can format the separate parts of an array. For example, you can change the font color. Select a cell range and then change the attribute you want.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3145608	320			0	lt	Copying Array Formulas				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149585	321			0	lt	Select the cell range or array containing the array formula.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154619	322			0	lt	Either press F2 or position the cursor in the input line.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3150994	323			0	lt	Copy the formula into the input line by pressing \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+C.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3146787	324			0	lt	Select a range of cells where you want to insert the array formula and either press F2 or position the cursor in the input line.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154419	325			0	lt	Paste the formula by pressing \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+V in the selected space and confirm it by pressing \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+Shift+Enter. The selected range now contains the array formula.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3154834	328			0	lt	Adjusting an Array Range				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3148679	329			0	lt	If you want to edit the output array, do the following:				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3151102	330			0	lt	Select the cell range or array containing the array formula.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3147096	331			0	lt	Below the selection, to the right, you will see a small icon with which you can zoom in or out on the range using your mouse.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3150974	332			0	lt	When you adjust the array range, the array formula will not automatically be adjusted. You are only changing the range in which the result will appear.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3146080	333			0	lt	By holding down the \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command \</caseinline\>\<defaultinline\>Ctrl \</defaultinline\>\</switchinline\>key, you can create a copy of the array formula in the given range.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D47				0	lt	Conditional Array Calculations				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D4B				0	lt	A conditional array calculation is an array or matrix formula that includes an IF() or CHOOSE() function. The condition argument in the formula is an area reference or a matrix result.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D4E				0	lt	In the following example, the >0 test of the {=IF(A1:A3>0;"yes";"no")} formula is applied to each cell in the range A1:A3 and the result is copied to the corresponding cell.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D65				0	lt	A				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D6B				0	lt	B (formula)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10B75				0	lt	B (result)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D79				0	lt	1				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D80				0	lt	1				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D86				0	lt	{=IF(A1:A3>0;"yes";"no")}				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D8C				0	lt	yes				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D94				0	lt	2				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D9B				0	lt	0				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DA1				0	lt	{=IF(A1:A3>0;"yes";"no")}				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DA7				0	lt	no				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DAF				0	lt	3				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DB6				0	lt	1				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DBC				0	lt	{=IF(A1:A3>0;"yes";"no")}				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DC2				0	lt	yes				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DD0				0	lt	The following functions provide forced array handling: CORREL, COVAR, FORECAST, FTEST, INTERCEPT, MDETERM, MINVERSE, MMULT, MODE, PEARSON, PROB, RSQ, SLOPE, STEYX, SUMPRODUCT, SUMX2MY2, SUMX2PY2, SUMXMY2, TTEST. If you use area references as arguments when you call one of these functions, the functions behave as array functions. The following table provides an example of forced array handling:				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DE2				0	lt	A				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DE8				0	lt	B (formula)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DEE				0	lt	B (result)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DF4				0	lt	C (forced array formula)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DFA				0	lt	C (result)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E02				0	lt	1				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E09				0	lt	1				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E0F				0	lt	=A1:A2+1				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E17				0	lt	2				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E1D				0	lt	=SUMPRODUCT(A1:A2+1)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E25				0	lt	5				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E2D				0	lt	2				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E34				0	lt	2				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E3A				0	lt	=A1:A2+1				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E42				0	lt	3				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E48				0	lt	=SUMPRODUCT(A1:A2+1)				20130618 17:22:18
