helpcontent2	source\text\sbasic\shared\03100700.xhp	0	help	par_id3154217	12			0	lt	Const iVar = 1964				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100700.xhp	0	help	par_id3156281	13			0	lt	Msgbox iVar				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100700.xhp	0	help	par_id3153969	14			0	lt	Const sVar = "Program", dVar As Double = 1.00				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100700.xhp	0	help	par_id3149560	15			0	lt	Msgbox sVar & " " & dVar				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100700.xhp	0	help	par_id3153368	16			0	lt	end sub				20130618 17:22:18
