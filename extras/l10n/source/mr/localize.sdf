uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_LOCKING_LOCK_EXPIRED & ERRCODE_RES_MASK)			0	mr	फाइल $(ARG1) करीता पूर्वी प्राप्त कुलूपची वेळ समाप्त झाली.\nहे फाइल लॉकचे व्यवस्थापन करणाऱ्या सर्व्हरवरील अडचणींमुळे शक्य आहे. या फाइलवरील लेखन कार्ये इतर वापरकर्तांद्वारे केलेले बदलवांना खोडून पुनः लिहणे शक्य होण्याची खात्री देता येत नाही!				2002-02-02 02:02:02
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_UNKNOWNAUTH_UNTRUSTED)			0	mr	$(ARG1) संकेतस्थळाच्या ओळख   पडताळणी करण्यास असमर्थ.\n\nहे प्रमाणपत्र स्वीकारण्याआधी, आपण या संकेतस्थळाच्या प्रमाणपत्राचे काळजीपूर्वक परीक्षण करायला हवे.  आपण संकेतस्थळ  $(ARG1) ला ओळखण्याच्या उद्देश्याने हे प्रमाणपत्र स्वीकारण्यास खूष आहात का?				2002-02-02 02:02:02
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_SSLWARN_EXPIRED_1)			0	mr	$(ARG1) हे संकेतस्थळ आहे जे स्थानांतराच्या वेळी डाटा एनक्रिप्ट करण्यासाठी सुरक्षा प्रमाणपत्रास वापरते, परंतु त्याच्या प्रमाणपत्राची मुदत $(ARG2) वर समाप्त झाली.\n\nआपणआपल्या संगणकाचे घड्याळ्याची वेळ बरोबर असल्याची खात्री करण्यासाठी तपासायला हवे.				2002-02-02 02:02:02
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_SSLWARN_DOMAINMISMATCH_1)			0	mr	आपण  $(ARG1) बरोबर जुळणी प्रस्थापित करण्याचा प्रयत्न केलेला आहे.  तथापि, सुरक्षा प्रमाणपत्र $(ARG2) सह दाखवलेले आहे. जर आपणास  दाखवलेल्या प्रमाणपत्र $(ARG1) चे नसल्याची शंका आली, तर कृपया जुळणी रद्द करा आणि संकेतस्थळाच्या प्रशासाकास कळवा .\n\nआपणास कसेही चालूच ठेवायचे का?				2002-02-02 02:02:02
