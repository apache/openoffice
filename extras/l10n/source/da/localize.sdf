helpcontent2	source\text\schart\01\wiz_chart_elements.xhp	0	help	par_id2871791				0	da	\<ahelp hid=\".\" visibility=\"hidden\"\>Indtast en etiket for z-aksen. Denne indstilling er kun tilgængelig for tre-dimensionelle diagrammer.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\schart\01\wiz_chart_elements.xhp	0	help	par_id7333597				0	da	\<ahelp hid=\".\" visibility=\"hidden\"\>Viser en forklaring i dit diagram.\</ahelp\>				20130618 17:22:18
