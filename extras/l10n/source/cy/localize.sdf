helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3148755				0	cy	Reset				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3149651				0	cy	\<ahelp hid=\"HID_TABDLG_RESET_BTN\"\>Resets changes made to the current tab to those applicable when this dialog was opened. A confirmation query does not appear when you close the dialog.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3143278				0	cy	Reset				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3150791				0	cy	\<ahelp hid=\"HID_TABDLG_RESET_BTN\"\>Resets modified values back to the default values.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154331				0	cy	A confirmation query does not appear. If you confirm the dialog with OK all settings in this dialog are reset.				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3145173				0	cy	Standard				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154153				0	cy	\<ahelp hid=\"HID_TABDLG_STANDARD_BTN\"\>Resets the values visible in the dialog back to the default installation values.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154299				0	cy	A confirmation does not appear before the defaults are reloaded.				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3147502				0	cy	Back				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3150439				0	cy	\<ahelp hid=\"HID_TABDLG_STANDARD_BTN\"\>View the selections in the dialog made in the previous step. The current settings remain unchanged.\</ahelp\> This button can only be activated from page two on.				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3147352				0	cy	More				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3155314	53			0	cy	\<ahelp hid=\"HID_TABDLG_STANDARD_BTN\"\>Click the\<emph\> More\</emph\> button to expand the dialog to show further options. Click again to restore the dialog.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3161659	41			0	cy	\<variable id=\"siehe\"\>See also the following functions: \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3163714	56			0	cy	\<variable id=\"wahr\"\>If an error occurs, the function returns a logical or numerical value. \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154145	54			0	cy	\<variable id=\"kontext\"\>(This command is only accessible through the \<link href=\"text/shared/00/00000005.xhp#kontextmenue\" name=\"context menu\"\>context menu\</link\>). \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3152791	61			0	cy	\<variable id=\"wiederholen\"\>By double-clicking a tool, you can use it for multiple tasks. If you call the tool with a single-click, it reverts back to the last selection after completing the task. \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000207.xhp	0	help	hd_id3155577				0	cy	Field options				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000207.xhp	0	help	par_id3152427				0	cy	Defines the field separator, text separator and character set that is used for the text export.				2002-02-02 02:02:02
