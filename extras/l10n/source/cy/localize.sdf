helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149504				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150864				0	cy	=AVERAGEA(A1:A50)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153933				0	cy	\<bookmark_value\>MODE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153933				0	cy	MODE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153085				0	cy	\<ahelp hid=\"HID_FUNC_MODALWERT\"\>Returns the most common value in a data set.\</ahelp\> If there are several values with the same frequency, it returns the smallest value. An error occurs when a value doesn't appear twice.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153003				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155950				0	cy	MODE(Number 1; Number 2; ...Number 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150337				0	cy	\<emph\>Number 1; Number 2;...Number 30\</emph\> are numerical values or ranges.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153571				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153733				0	cy	=MODE(A1:A50)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3149879				0	cy	\<bookmark_value\>NEGBINOMDIST function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149879				0	cy	NEGBINOMDIST				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155437				0	cy	\<ahelp hid=\"HID_FUNC_NEGBINOMVERT\"\>Returns the negative binomial distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3145351				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150935				0	cy	NEGBINOMDIST(X; R; SP)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153044				0	cy	\<emph\>X\</emph\> represents the value returned for unsuccessful tests.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151018				0	cy	\<emph\>R\</emph\> represents the value returned for successful tests.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148878				0	cy	\<emph\>SP\</emph\> is the probability of the success of an attempt.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149539				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148770				0	cy	=NEGBINOMDIST(1; 1; 0.5) returns 0.25.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3155516				0	cy	\<bookmark_value\>NORMINV function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155516				0	cy	NORMINV				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154634				0	cy	\<ahelp hid=\"HID_FUNC_NORMINV\"\>Returns the inverse of the normal cumulative distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153227				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147534				0	cy	NORMINV(Number; Mean; STDEV)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154950				0	cy	\<emph\>Number\</emph\> represents the probability value used to determine the inverse normal distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150690				0	cy	\<emph\>Mean\</emph\> represents the mean value in the normal distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148594				0	cy	\<emph\>STDEV\</emph\> represents the standard deviation of the normal distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155822				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153921				0	cy	=NORMINV(0.9; 63; 5) returns 69.41. If the average egg weighs 63 grams with a standard deviation of 5, then there will be 90% probability that the egg will not be heavier than 69.41g grams.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153722				0	cy	\<bookmark_value\>NORMDIST function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153722				0	cy	NORMDIST				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150386				0	cy	\<ahelp hid=\"HID_FUNC_NORMVERT\"\>Returns the standard normal cumulative distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3083282				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150613				0	cy	NORMDIST(Number; Mean; STDEV; C)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149820				0	cy	\<emph\>Number\</emph\> is the value of the distribution based on which the normal distribution is to be calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146063				0	cy	\<emph\>Mean\</emph\> is the mean value of the distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156295				0	cy	\<emph\>STDEV\</emph\> is the standard deviation of the distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145080				0	cy	\<emph\>C\</emph\> = 0 calculates the density function; \<emph\>C\</emph\> = 1 calculates the distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152972				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149283				0	cy	=NORMDIST(70; 63; 5; 0) returns 0.03.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149448				0	cy	=NORMDIST(70; 63; 5; 1) returns 0.92.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3152934				0	cy	\<bookmark_value\>PEARSON function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152934				0	cy	PEARSON				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153216				0	cy	\<ahelp hid=\"HID_FUNC_PEARSON\"\>Returns the Pearson product moment correlation coefficient r.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147081				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156133				0	cy	PEARSON(Data_1; Data_2)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151272				0	cy	\<emph\>Data_1\</emph\> represents the array of the first data set.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153279				0	cy	\<emph\>Data_2\</emph\> represents the array of the second data set.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147567				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151187				0	cy	=PEARSON(A1:A30; B1:B30) returns the Pearson correlation coefficient of both data sets.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3152806				0	cy	\<bookmark_value\>PHI function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152806				0	cy	PHI				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150254				0	cy	\<ahelp hid=\"HID_FUNC_PHI\"\>Returns the values of the distribution function for a standard normal distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154748				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149976				0	cy	PHI(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156108				0	cy	\<emph\>Number\</emph\> represents the value based on which the standard normal distribution is calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153621				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155849				0	cy	PHI(2.25) = 0.03				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3143236				0	cy	PHI(-2.25) = 0.03				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149286				0	cy	PHI(0) = 0.4				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153985				0	cy	\<bookmark_value\>POISSON function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153985				0	cy	POISSON				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154298				0	cy	\<ahelp hid=\"HID_FUNC_POISSON\"\>Returns the Poisson distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3159183				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146093				0	cy	POISSON(Number; Mean; C)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147253				0	cy	\<emph\>Number\</emph\> represents the value based on which the Poisson distribution is calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151177				0	cy	\<emph\>Mean\</emph\> represents the middle value of the Poisson distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149200				0	cy	\<emph\>C\</emph\> = 0 calculates the density function; \<emph\>C\</emph\> = 1 calculates the distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3159347				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150113				0	cy	=POISSON(60;50;1) returns 0.93.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153100				0	cy	\<bookmark_value\>PERCENTILE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153100				0	cy	PERCENTILE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154940				0	cy	\<ahelp hid=\"HID_FUNC_QUANTIL\"\>Returns the alpha-percentile of data values in an array.\</ahelp\> A percentile returns the scale value for a data series which goes from the smallest (Alpha=0) to the largest value (alpha=1) of a data series. For \<emph\>Alpha\</emph\> = 25%, the percentile means the first quartile; \<emph\>Alpha\</emph\> = 50% is the MEDIAN.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150531				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148813				0	cy	PERCENTILE(Data;Alpha)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153054				0	cy	\<emph\>Data\</emph\> represents the array of data.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154212				0	cy	\<emph\>Alpha\</emph\> represents the percentage of the scale between 0 and 1.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154290				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159147				0	cy	=PERCENTILE(A1:A50; 0.1) represents the value in the data set, which equals 10% of the total data scale in A1:A50.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148807				0	cy	\<bookmark_value\>PERCENTRANK function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148807				0	cy	PERCENTRANK				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153573				0	cy	\<ahelp hid=\"HID_FUNC_QUANTILSRANG\"\>Returns the percentage rank of a value in a sample.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147512				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147238				0	cy	PERCENTRANK(Data; Value)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154266				0	cy	\<emph\>Data\</emph\> represents the array of data in the sample.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148475				0	cy	\<emph\>Value\</emph\> represents the value whose percentile rank must be determined.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155364				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149163				0	cy	=PERCENTRANK(A1:A50; 50) returns the percentage rank of the value 50 from the total range of all values found in A1:A50. If 50 falls outside the total range, an error message will appear.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3166442				0	cy	\<bookmark_value\>QUARTILE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3166442				0	cy	QUARTILE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146958				0	cy	\<ahelp hid=\"HID_FUNC_QUARTILE\"\>Returns the quartile of a data set.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152942				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153684				0	cy	QUARTILE(Data; Type)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153387				0	cy	\<emph\>Data\</emph\> represents the array of data in the sample.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155589				0	cy	\<emph\>Type\</emph\> represents the type of quartile. (0 = MIN, 1 = 25%, 2 = 50% (MEDIAN), 3 = 75% and 4 = MAX.)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149103				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159276				0	cy	=QUARTILE(A1:A50; 2) returns the value of which 25% of the scale corresponds to the lowest to highest values in the range A1:A50.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	tit				0	cy	Error Alert				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3153821				0	cy	\<link href=\"text/scalc/01/12120300.xhp\" name=\"Error Alert\"\>Error Alert\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3153379				0	cy	\<ahelp hid=\"SC:TABPAGE:TP_VALIDATION_ERROR\"\>Define the error message that is displayed when invalid data is entered in a cell.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3154138				0	cy	You can also start a macro with an error message. A sample macro is provided at the end of this page.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3156280				0	cy	Show error message when invalid values are entered.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3146984	5			0	cy	In both cases, if you select "Stop", the invalid entry is deleted and the previous value is reentered in the cell. The same applies if you close the "Warning" and "Information" dialogs by clicking the \<emph\>Cancel \</emph\>button. If you close the dialogs with the \<emph\>OK\</emph\> button, the invalid entry is not deleted.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3152460				0	cy	Contents				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3148646				0	cy	Action				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3151115				0	cy	\<ahelp hid=\"SC:LISTBOX:TP_VALIDATION_ERROR:LB_ACTION\"\>Select the action that you want to occur when invalid data is entered in a cell.\</ahelp\> The "Stop" action rejects the invalid entry and displays a dialog that you have to close by clicking \<emph\>OK\</emph\>. The "Warning" and "Information" actions display a dialog that can be closed by clicking \<emph\>OK\</emph\> or \<emph\>Cancel\</emph\>. The invalid entry is only rejected when you click \<emph\>Cancel\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3156441				0	cy	Browse				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3153160				0	cy	\<ahelp hid=\"SC:PUSHBUTTON:TP_VALIDATION_ERROR:BTN_SEARCH\"\>Opens the \<link href=\"text/shared/01/06130000.xhp\" name=\"Macro\"\>Macro\</link\> dialog where you can select the macro that is executed when invalid data is entered in a cell. The macro is executed after the error message is displayed.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3153876				0	cy	Title				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3149410				0	cy	\<ahelp hid=\"SC:EDIT:TP_VALIDATION_ERROR:EDT_TITLE\"\>Enter the title of the macro or the error message that you want to display when invalid data is entered in a cell.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3154510				0	cy	Error message				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3149122				0	cy	\<ahelp hid=\"SC:MULTILINEEDIT:TP_VALIDATION_ERROR:EDT_ERROR\"\>Enter the message that you want to display when invalid data is entered in a cell.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3150752				0	cy	\<emph\>Sample macro:\</emph\>				2002-02-02 02:02:02
