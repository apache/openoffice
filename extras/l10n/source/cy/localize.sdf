helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3166425				0	cy	\<variable id=\"kl\"\>\<link href=\"text/scalc/01/04060183.xhp\" name=\"Statistical Functions Part Three\"\>Statistical Functions Part Three\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3149530				0	cy	\<bookmark_value\>LARGE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3149530				0	cy	LARGE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150518				0	cy	\<ahelp hid=\"HID_FUNC_KGROESSTE\"\>Returns the Rank_c-th largest value in a data set.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3152990				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154372				0	cy	LARGE(Data; Rank_c)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3152986				0	cy	\<emph\>Data\</emph\> is the cell range of data.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3156448				0	cy	\<emph\>Rank_c\</emph\> is the ranking of the value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3152889				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3148702				0	cy	=LARGE(A1:C50; 2) gives the second largest value in A1:C50.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3154532				0	cy	\<bookmark_value\>SMALL function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3154532				0	cy	SMALL				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3157981				0	cy	\<ahelp hid=\"HID_FUNC_KKLEINSTE\"\>Returns the Rank_c-th smallest value in a data set.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3154957				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153974				0	cy	SMALL(Data; Rank_c)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154540				0	cy	\<emph\>Data\</emph\> is the cell range of data.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155094				0	cy	\<emph\>Rank_c\</emph\> is the rank of the value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3153247				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149897				0	cy	=SMALL(A1:C50; 2) gives the second smallest value in A1:C50.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3153559				0	cy	\<bookmark_value\>CONFIDENCE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3153559				0	cy	CONFIDENCE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153814				0	cy	\<ahelp hid=\"HID_FUNC_KONFIDENZ\"\>Returns the (1-alpha) confidence interval for a normal distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3149315				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3147501				0	cy	CONFIDENCE(Alpha; STDEV; Size)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149872				0	cy	\<emph\>Alpha\</emph\> is the level of the confidence interval.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145324				0	cy	\<emph\>STDEV\</emph\> is the standard deviation for the total population.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153075				0	cy	\<emph\>Size\</emph\> is the size of the total population.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150435				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153335				0	cy	=CONFIDENCE(0.05; 1.5; 100) gives 0.29.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3148746				0	cy	\<bookmark_value\>CORREL function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3148746				0	cy	CORREL				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3147299				0	cy	\<ahelp hid=\"HID_FUNC_KORREL\"\>Returns the correlation coefficient between two data sets.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3156397				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153023				0	cy	CORREL(Data_1; Data_2)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150036				0	cy	\<emph\>Data_1\</emph\> is the first data set.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153021				0	cy	\<emph\>Data_2\</emph\> is the second data set.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3149720				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149941				0	cy	=CORREL(A1:A50; B1:B50) calculates the correlation coefficient as a measure of the linear correlation of the two data sets.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3150652				0	cy	\<bookmark_value\>COVAR function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150652				0	cy	COVAR				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3146875				0	cy	\<ahelp hid=\"HID_FUNC_KOVAR\"\>Returns the covariance of the product of paired deviations.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3149013				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150740				0	cy	COVAR(Data_1; Data_2)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145827				0	cy	\<emph\>Data_1\</emph\> is the first data set.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150465				0	cy	\<emph\>Data_2\</emph\> is the second data set.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3154677				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3144748				0	cy	=COVAR(A1:A30; B1:B30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3147472				0	cy	\<bookmark_value\>CRITBINOM function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3147472				0	cy	CRITBINOM				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149254				0	cy	\<ahelp hid=\"HID_FUNC_KRITBINOM\"\>Returns the smallest value for which the cumulative binomial distribution is less than or equal to a criterion value.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3153930				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3148586				0	cy	CRITBINOM(Trials; SP; Alpha)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145593				0	cy	\<emph\>Trials\</emph\> is the total number of trials.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153084				0	cy	\<emph\>SP\</emph\> is the probability of success for one trial.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149726				0	cy	\<emph\>Alpha\</emph\> is the threshold probability to be reached or exceeded.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3148752				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3148740				0	cy	=CRITBINOM(100; 0.5; 0.1) yields 44.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3155956				0	cy	\<bookmark_value\>KURT function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3155956				0	cy	KURT				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153108				0	cy	\<ahelp hid=\"HID_FUNC_KURT\"\>Returns the kurtosis of a data set (at least 4 values required).\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150334				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154508				0	cy	KURT(Number 1; Number 2; ...Number 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145167				0	cy	\<emph\>Number 1,Number 2,...Number 30\</emph\> are numeric arguments or ranges representing a random sample of distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3158000				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150016				0	cy	=KURT(A1;A2;A3;A4;A5;A6)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3150928				0	cy	\<bookmark_value\>LOGINV function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150928				0	cy	LOGINV				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145297				0	cy	\<ahelp hid=\"HID_FUNC_LOGINV\"\>Returns the inverse of the lognormal distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3151016				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153049				0	cy	LOGINV(Number; Mean; STDEV)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3148390				0	cy	\<emph\>Number\</emph\> is the probability value for which the inverse standard logarithmic distribution is to be calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149538				0	cy	\<emph\>Mean\</emph\> is the arithmetic mean of the standard logarithmic distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145355				0	cy	\<emph\>STDEV\</emph\> is the standard deviation of the standard logarithmic distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3148768				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155623				0	cy	=LOGINV(0.05; 0; 1) returns 0.19.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3158417				0	cy	\<bookmark_value\>LOGNORMDIST function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3158417				0	cy	LOGNORMDIST				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154953				0	cy	\<ahelp hid=\"HID_FUNC_LOGNORMVERT\"\>Returns the cumulative lognormal distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150474				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150686				0	cy	LOGNORMDIST(Number; Mean; STDEV)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154871				0	cy	\<emph\>Number\</emph\> is the probability value for which the standard logarithmic distribution is to be calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155820				0	cy	\<emph\>Mean\</emph\> is the mean value of the standard logarithmic distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155991				0	cy	\<emph\>STDEV\</emph\> is the standard deviation of the standard logarithmic distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3153178				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149778				0	cy	=LOGNORMDIST(0.1; 0; 1) returns 0.01.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070400.xhp	0	help	tit				0	cy	Define Label Range				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070400.xhp	0	help	bm_id3150791				0	cy	\<bookmark_value\>sheets; defining label ranges\</bookmark_value\>\<bookmark_value\>label ranges in sheets\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070400.xhp	0	help	hd_id3150791				0	cy	\<variable id=\"define_label_range\"\>\<link href=\"text/scalc/01/04070400.xhp\"\>Define Label Range\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070400.xhp	0	help	par_id3150868				0	cy	\<variable id=\"beschtext\"\>\<ahelp hid=\".uno:DefineLabelRange\"\>Opens a dialog in which you can define a label range.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070400.xhp	0	help	par_id3155411				0	cy	The cell contents of a label range can be used like names in formulas - $[officename] recognizes these names in the same manner that it does the predefined names of the weekdays and months. These names are automatically completed when typed into a formula. In addition, the names defined by label ranges will have priority over names defined by automatically generated ranges.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070400.xhp	0	help	par_id3147435				0	cy	You can set label ranges that contain the same labels on different sheets. $[officename] first searches the label ranges of the current sheet and, following a failed search, the ranges of other sheets.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070400.xhp	0	help	hd_id3145801				0	cy	Range				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070400.xhp	0	help	par_id3154731				0	cy	\<ahelp hid=\"SC:EDIT:RID_SCDLG_COLROWNAMERANGES:ED_AREA\"\>Displays the cell reference of each label range.\</ahelp\> In order to remove a label range from the list box, select it and then click \<emph\>Delete\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070400.xhp	0	help	hd_id3149121				0	cy	Contains column labels				2002-02-02 02:02:02
