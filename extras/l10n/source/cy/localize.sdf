helpcontent2	source\text\scalc\01\04060119.xhp	0	help	tit				0	cy	Financial Functions Part Two				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149052				0	cy	Financial Functions Part Two				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148742				0	cy	\<link href=\"text/scalc/01/04060103.xhp\" name=\"Back to Financial Functions Part One\"\>Back to Financial Functions Part One\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151341				0	cy	\<link href=\"text/scalc/01/04060118.xhp\" name=\"Forward to Financial Functions Part Three\"\>Forward to Financial Functions Part Three\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3150026				0	cy	\<bookmark_value\>PPMT function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150026				0	cy	PPMT				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146942				0	cy	\<ahelp hid=\"HID_FUNC_KAPZ\"\>Returns for a given period the payment on the principal for an investment that is based on periodic and constant payments and a constant interest rate.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150459				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146878				0	cy	PPMT(Rate;Period;NPER;PV;FV;Type)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151228				0	cy	Rate: the periodic interest rate.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148887				0	cy	Period: the amortizement period. P=1 for the first and P=NPER for the last period.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148436				0	cy	NPER: the total number of periods during which annuity is paid.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153035				0	cy	PV. the present value in the sequence of payments.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147474				0	cy	FV (optional): the desired (future) value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3144744				0	cy	Type (optional): defines the due date. F=1 for payment at the beginning of a period and F=0 for payment at the end of a period.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3148582				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154811				0	cy	How high is the periodic monthly payment at an annual interest rate of 8.75% over a period of 3 years? The cash value is 5,000 currency units and is always paid at the beginning of a period. The future value is 8,000 currency units.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149246				0	cy	PPMT(8.75%/12;1;36;5000;8000;1) = -350.99 currency units.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3146139				0	cy	\<bookmark_value\>calculating; total amortizement rates\</bookmark_value\>\<bookmark_value\>total amortizement rates\</bookmark_value\>\<bookmark_value\>CUMPRINC function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3146139				0	cy	CUMPRINC				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150140				0	cy	\<ahelp hid=\"HID_FUNC_KUMKAPITAL\"\>Returns the cumulative interest paid for an investment period with a constant interest rate.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149188				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148733				0	cy	CUMPRINC(Rate;NPER;PV;S;E;Type)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150864				0	cy	Rate: the periodic interest rate.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3166052				0	cy	NPER: the payment period with the total number of periods. NPER can also be a non-integer value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150007				0	cy	PV: the current value in the sequence of payments.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153112				0	cy	S: the first period.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146847				0	cy	E: the last period.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145167				0	cy	Type: the due date of the payment at the beginning or end of each period.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154502				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153570				0	cy	What are the payoff amounts if the yearly interest rate is 5.5% for 36 months? The cash value is 15,000 currency units. The payoff amount is calculated between the 10th and 18th period. The due date is at the end of the period.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149884				0	cy	CUMPRINC(5.5%/12;36;15000;10;18;0) = -3669.74 currency units. The payoff amount between the 10th and 18th period is 3669.74 currency units.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3150019				0	cy	\<bookmark_value\>CUMPRINC_ADD function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150019				0	cy	CUMPRINC_ADD				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145246				0	cy	\<ahelp hid=\"HID_AAI_FUNC_CUMPRINC\"\> Calculates the cumulative redemption of a loan in a period.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153047				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3157970				0	cy	CUMPRINC_ADD(Rate;NPER;PV;Start period;End period;Type)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145302				0	cy	Rate: the interest rate for each period.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151017				0	cy	NPER: the total number of payment periods. The rate and NPER must refer to the same unit, and thus both be calculated annually or monthly.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155620				0	cy	PV: the current value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145352				0	cy	Start period: the first payment period for the calculation.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3157986				0	cy	End period: the last payment period for the calculation.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150570				0	cy	Type: the maturity of a payment at the end of each period (Type = 0) or at the start of the period (Type = 1).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150269				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148774				0	cy	The following mortgage loan is taken out on a house:				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150661				0	cy	Rate: 9.00 per cent per annum (9% / 12 = 0.0075), Duration: 30 years (payment periods = 30 * 12 = 360), NPV: 125000 currency units.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155512				0	cy	How much will you repay in the second year of the mortgage (thus from periods 13 to 24)?				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149394				0	cy	CUMPRINC_ADD(0.0075;360;125000;13;24;0) returns -934.1071				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149026				0	cy	In the first month you will be repaying the following amount:				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154636				0	cy	CUMPRINC_ADD(0.0075;360;125000;1;1;0) returns -68.27827				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3155370				0	cy	\<bookmark_value\>calculating; accumulated interests\</bookmark_value\>\<bookmark_value\>accumulated interests\</bookmark_value\>\<bookmark_value\>CUMIPMT function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155370				0	cy	CUMIPMT				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3158411				0	cy	\<ahelp hid=\"HID_FUNC_KUMZINSZ\"\>Calculates the cumulative interest payments, that is, the total interest, for an investment based on a constant interest rate.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155814				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147536				0	cy	CUMIPMT(Rate;NPER;pv;S;E;Type)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150475				0	cy	Rate: the periodic interest rate.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153921				0	cy	NPER: the payment period with the total number of periods. NPER can also be a non-integer value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153186				0	cy	pv: the current value in the sequence of payments.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156259				0	cy	S: the first period.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155990				0	cy	E: the last period.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149777				0	cy	Type: the due date of the payment at the beginning or end of each period.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153723				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147478	277			0	cy	What are the interest payments at a yearly interest rate of 5.5 %, a payment period of monthly payments for 2 years and a current cash value of 5,000 currency units? The start period is the 4th and the end period is the 6th period. The payment is due at the beginning of each period.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149819				0	cy	CUMIPMT(5.5%/12;24;5000;4;6;1) = -57.54 currency units. The interest payments for between the 4th and 6th period are 57.54 currency units.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3083280				0	cy	\<bookmark_value\>CUMIPMT_ADD function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3083280				0	cy	CUMIPMT_ADD				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3152482				0	cy	\<ahelp hid=\"HID_AAI_FUNC_CUMIPMT\"\>Calculates the accumulated interest for a period.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149713				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145087				0	cy	CUMIPMT_ADD(Rate;NPER;Pv;Start period;End period;Type)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149277				0	cy	Rate: the interest rate for each period.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149270				0	cy	NPER: the total number of payment periods. The rate and NPER must refer to the same unit, and thus both be calculated annually or monthly.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3152967				0	cy	Pv: the current value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156308				0	cy	Start period: the first payment period for the calculation.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149453				0	cy	End period: the last payment period for the calculation.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150962				0	cy	Type: the maturity of a payment at the end of each period (Type = 0) or at the start of the period (Type = 1).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3152933				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156324				0	cy	The following mortgage loan is taken out on a house:				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147566				0	cy	Rate: 9.00 per cent per annum (9% / 12 = 0.0075), Duration: 30 years (NPER = 30 * 12 = 360), Pv: 125000 currency units.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151272				0	cy	How much interest must you pay in the second year of the mortgage (thus from periods 13 to 24)?				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156130				0	cy	=CUMIPMT_ADD(0.0075;360;125000;13;24;0) returns -11135.23.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150764				0	cy	How much interest must you pay in the first month?				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146857				0	cy	=CUMIPMT_ADD(0.0075;360;125000;1;1;0) returns -937.50.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3150878				0	cy	\<bookmark_value\>PRICE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150878				0	cy	PRICE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153210				0	cy	\<ahelp hid=\"HID_AAI_FUNC_PRICE\"\>Calculates the market value of a fixed interest security with a par value of 100 currency units as a function of the forecast yield.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154646				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3152804				0	cy	PRICE(Settlement;Maturity;Rate;Yield;Redemption;Frequency;Basis)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156121				0	cy	Settlement: the date of purchase of the security.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149983				0	cy	Maturity: the date on which the security matures (expires).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153755				0	cy	Rate: the annual nominal rate of interest (coupon interest rate)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155999				0	cy	Yield: the annual yield of the security.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156114				0	cy	Redemption: the redemption value per 100 currency units of par value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155846				0	cy	Frequency: number of interest payments per year (1, 2 or 4).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153148				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150260				0	cy	A security is purchased on 2/15/1999; the maturity date is 11/15/2007. The nominal rate of interest is 5.75%. The yield is 6.5%. The redemption value is 100 currency units. Interest is paid half-yearly (frequency is 2). With calculation on basis 0 the price is as follows:				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147273				0	cy	=PRICE("2/15/1999"; "11/15/2007"; 0.0575; 0.065; 100; 2; 0) returns 95.04287.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3151297				0	cy	\<bookmark_value\>PRICEDISC function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3151297				0	cy	PRICEDISC				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155100				0	cy	\<ahelp hid=\"HID_AAI_FUNC_PRICEDISC\"\>Calculates the price per 100 currency units of par value of a non-interest- bearing security.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149294				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146084				0	cy	PRICEDISC(Settlement;Maturity;Discount;Redemption;Basis)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3159179				0	cy	Settlement: the date of purchase of the security.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154304				0	cy	Maturity: the date on which the security matures (expires).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156014				0	cy	Discount: the discount of a security as a percentage.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147489				0	cy	Redemption: the redemption value per 100 currency units of par value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3152794				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149198				0	cy	A security is purchased on 2/15/1999; the maturity date is 3/1/1999. Discount in per cent is 5.25%. The redemption value is 100. When calculating on basis 2 the price discount is as follows:				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151178				0	cy	=PRICEDISC("2/15/1999"; "3/1/1999"; 0.0525; 100; 2) returns 99.79583.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3154693				0	cy	\<bookmark_value\>PRICEMAT function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154693				0	cy	PRICEMAT				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153906				0	cy	\<ahelp hid=\"HID_AAI_FUNC_PRICEMAT\"\>Calculates the price per 100 currency units of par value of a security, that pays interest on the maturity date.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154933				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155393				0	cy	PRICEMAT(Settlement;Maturity;Issue;Rate;Yield;Basis)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153102				0	cy	Settlement: the date of purchase of the security.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150530				0	cy	Maturity: the date on which the security matures (expires).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149903				0	cy	Issue: the date of issue of the security.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148828				0	cy	Rate: the interest rate of the security on the issue date.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146993				0	cy	Yield: the annual yield of the security.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150507				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154289				0	cy	Settlement date: February 15 1999, maturity date: April 13 1999, issue date: November 11 1998. Interest rate: 6.1 per cent, yield: 6.1 per cent, basis: 30/360 = 0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154905				0	cy	The price is calculated as follows:				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3158409				0	cy	=PRICEMAT("2/15/1999";"4/13/1999";"11/11/1998"; 0.061; 0.061;0) returns 99.98449888.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3148448				0	cy	\<bookmark_value\>calculating; durations\</bookmark_value\>\<bookmark_value\>durations; calculating\</bookmark_value\>\<bookmark_value\>DURATION function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3148448				0	cy	DURATION				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153056				0	cy	\<ahelp hid=\"HID_FUNC_LAUFZEIT\"\>Calculates the number of periods required by an investment to attain the desired value.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3145421				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148933				0	cy	DURATION(Rate;PV;FV)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148801				0	cy	Rate: a constant. The interest rate is to be calculated for the entire duration (duration period). The interest rate per period is calculated by dividing the interest rate by the calculated duration. The internal rate for an annuity is to be entered as Rate/12.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147239				0	cy	PV: the present (current) value. The cash value is the deposit of cash or the current cash value of an allowance in kind. As a deposit value a positive value must be entered; the deposit must not be 0 or <0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147515				0	cy	FV: the expected value. The future value determines the desired (future) value of the deposit.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153579				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148480				0	cy	At an interest rate of 4.75%, a cash value of 25,000 currency units and a future value of 1,000,000 currency units, a duration of 79.49 payment periods is returned. The periodic payment is the resulting quotient from the future value and the duration, in this case 1,000,000/79.49=12,850.20.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3148912				0	cy	\<bookmark_value\>calculating;linear depreciations\</bookmark_value\>\<bookmark_value\>depreciations;linear\</bookmark_value\>\<bookmark_value\>linear depreciations\</bookmark_value\>\<bookmark_value\>SLN function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3148912				0	cy	SLN				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149154	291			0	cy	\<ahelp hid=\"HID_FUNC_LIA\"\>Returns the straight-line depreciation of an asset for one period.\</ahelp\>The amount of the depreciation is constant during the depreciation period.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153240				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3166456				0	cy	SLN(COST; SALVAGE; LIFE)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146955				0	cy	COST: the initial cost of an asset.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149796				0	cy	SALVAGE: the value of an asset at the end of the depreciation.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3166444				0	cy	LIFE: the depreciation period determining the number of periods in the depreciation of the asset.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155579				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154098				0	cy	Office equipment with an initial cost of 50,000 currency units is to be depreciated over 7 years. The value at the end of the depreciation is to be 3,500 currency units.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153390				0	cy	SLN(50000;3,500;84) = 553.57 currency units. The periodic monthly depreciation of the office equipment is 553.57 currency units.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3153739				0	cy	\<bookmark_value\>MDURATION function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153739				0	cy	MDURATION				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149923				0	cy	\<ahelp hid=\"HID_AAI_FUNC_MDURATION\"\>Calculates the modified Macauley duration of a fixed interest security in years.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149964				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148987				0	cy	MDURATION(Settlement;Maturity;Coupon;Yield;Frequency;Basis)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148619				0	cy	Settlement: the date of purchase of the security.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149805				0	cy	Maturity: the date on which the security matures (expires).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154338				0	cy	Coupon: the annual nominal rate of interest (coupon interest rate)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148466				0	cy	Yield: the annual yield of the security.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149423				0	cy	Frequency: number of interest payments per year (1, 2 or 4).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154602				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148652				0	cy	A security is purchased on 1/1/2001; the maturity date is 1/1/2006. The nominal rate of interest is 8%. The yield is 9.0%. Interest is paid half-yearly (frequency is 2). Using daily balance interest calculation (basis 3) how long is the modified duration?				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145378				0	cy	=MDURATION("1/1/2001"; "1/1/2006"; 0.08; 0.09; 2; 3)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3149242				0	cy	\<bookmark_value\>calculating;net present values\</bookmark_value\>\<bookmark_value\>net present values\</bookmark_value\>\<bookmark_value\>NPV function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149242				0	cy	NPV				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145308				0	cy	\<ahelp hid=\"HID_FUNC_NBW\"\>Returns the present value of an investment based on a series of periodic cash flows and a discount rate. To get the net present value, subtract the cost of the project (the initial cash flow at time zero) from the returned value.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149937				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153321				0	cy	NPV(RATE;Value 1;Value 2;...)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150630				0	cy	RATE: the discount rate for a period.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150427				0	cy	Value1;... are up to 30 values, which represent deposits or withdrawals.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153538				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154800				0	cy	What is the net present value of periodic payments of 10, 20 and 30 currency units with a discount rate of 8.75%. At time zero the costs were payed as -40 currency units.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3143270				0	cy	NPV(8.75%;10;20;30) = 49.43 currency units. The net present value is the returned value minus the initial costs of 40 currency units, therefore 9.43 currency units.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3149484				0	cy	\<bookmark_value\>calculating;nominal interest rates\</bookmark_value\>\<bookmark_value\>nominal interest rates;calculating\</bookmark_value\>\<bookmark_value\>NOMINAL function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149484				0	cy	NOMINAL				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149596				0	cy	\<ahelp hid=\"HID_FUNC_NOMINAL\"\>Calculates the yearly nominal interest rate, given the effective rate and the number of compounding periods per year.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3151252				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3152769				0	cy	NOMINAL(EFFECT_RATE;NPERY)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147521				0	cy	EFFECT_RATE: the effective interest rate				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156334				0	cy	NPERY: the number of periodic interest payments per year.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154473				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147091				0	cy	What is the nominal interest per year for an effective interest rate of 13.5% if twelve payments are made per year.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154831				0	cy	NOMINAL(13.5%;12) = 12.73%. The nominal interest rate per year is 12.73%.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3155123				0	cy	\<bookmark_value\>NOMINAL_ADD function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155123				0	cy	NOMINAL_ADD				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148671				0	cy	\<ahelp hid=\"HID_AAI_FUNC_NOMINAL\"\>Calculates the annual nominal rate of interest on the basis of the effective rate and the number of interest payments per annum.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155611				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156157				0	cy	NOMINAL_ADD(Effective rate;Npery)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153777				0	cy	Effective rate: the effective annual rate of interest.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150409				0	cy	Npery: the number of interest payments per year.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3146789				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145777				0	cy	What is the nominal rate of interest for a 5.3543% effective rate of interest and quarterly payment.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156146				0	cy	=NOMINAL_ADD(5.3543%; 4) returns 0.0525 or 5.25%.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3159087				0	cy	\<bookmark_value\>DOLLARFR function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3159087				0	cy	DOLLARFR				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150593				0	cy	\<ahelp hid=\"HID_AAI_FUNC_DOLLARFR\"\>Converts a quotation that has been given as a decimal number into a mixed decimal fraction.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3151106				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3152959				0	cy	DOLLARFR (Decimal dollar;Fraction)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149558				0	cy	Decimal dollar: a decimal number.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153672				0	cy	Fraction: a whole number that is used as the denominator of the decimal fraction.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3156274				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153795				0	cy	=DOLLARFR(1.125;16) converts into sixteenths. The result is 1.02 for 1 plus 2/16.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150995				0	cy	=DOLLARFR(1.125;8) converts into eighths. The result is 1.1 for 1 plus 1/8.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3154671				0	cy	\<bookmark_value\>fractions; converting\</bookmark_value\>\<bookmark_value\>DOLLARDE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154671				0	cy	DOLLARDE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154418				0	cy	\<ahelp hid=\"HID_AAI_FUNC_DOLLARDE\"\>Converts a quotation that has been given as a decimal fraction into a decimal number.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3146124				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150348				0	cy	DOLLARDE(Fractional dollar;Fraction)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154111				0	cy	Fractional dollar: a number given as a decimal fraction.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153695				0	cy	Fraction: a whole number that is used as the denominator of the decimal fraction.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153884				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150941				0	cy	=DOLLARDE (1.02;16) stands for 1 and 2/16. This returns 1.125.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150830				0	cy	=DOLLARDE (1.1;8) stands for 1 and 1/8. This returns 1.125.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3148974				0	cy	\<bookmark_value\>calculating;modified internal rates of return\</bookmark_value\>\<bookmark_value\>modified internal rates of return\</bookmark_value\>\<bookmark_value\>MIRR function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3148974				0	cy	MIRR				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155497				0	cy	\<ahelp hid=\"HID_FUNC_QIKV\"\>Calculates the modified internal rate of return of a series of investments.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154354				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148399				0	cy	MIRR(Values; investment; reinvest_rate)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155896				0	cy	Values:corresponds to the array or the cell reference for cells whose content corresponds to the payments.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149998				0	cy	investment:the rate of interest of the investments (the negative values of the array)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3159408				0	cy	reinvest_rate:the rate of interest of the reinvestment (the positive values of the array)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154714				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147352				0	cy	Assuming a cell content of A1=-5, A2=10, A3=15, and A4=8, and an investment value of 0.5 and a reinvestment value of 0.1, the result is 94.16%.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3149323				0	cy	\<bookmark_value\>YIELD function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149323				0	cy	YIELD				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150643				0	cy	\<ahelp hid=\"HID_AAI_FUNC_YIELD\"\>Calculates the yield of a security.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149344				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149744				0	cy	YIELD(Settlement;Maturity;Rate;Price;Redemption;Frequency;Basis)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154526				0	cy	Settlement: the date of purchase of the security.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153266				0	cy	Maturity: the date on which the security matures (expires).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151284				0	cy	Rate: the annual rate of interest.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147314				0	cy	Price: the price (purchase price) of the security per 100 currency units of par value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145156				0	cy	Redemption: the redemption value per 100 currency units of par value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3159218				0	cy	Frequency: number of interest payments per year (1, 2 or 4).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3147547				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151214				0	cy	A security is purchased on 2/15/1999. It matures on 11/15/2007. The rate of interest is 5.75%. The price is 95.04287 currency units per 100 units of par value, the redemption value is 100 units. Interest is paid half-yearly (frequency = 2) and the basis is 0. How high is the yield?				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154194				0	cy	=YIELD("2/15/1999"; "11/15/2007"; 0.0575 ;95.04287; 100; 2; 0) returns 0.065 or 6.5 per cent.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3150100				0	cy	\<bookmark_value\>YIELDDISC function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150100				0	cy	YIELDDISC				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150486				0	cy	\<ahelp hid=\"HID_AAI_FUNC_YIELDDISC\"\>Calculates the annual yield of a non-interest-bearing security.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149171				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3159191				0	cy	YIELDDISC(Settlement;Maturity;Price;Redemption;Basis)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150237				0	cy	Settlement: the date of purchase of the security.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146924				0	cy	Maturity: the date on which the security matures (expires).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151201				0	cy	Price: the price (purchase price) of the security per 100 currency units of par value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156049				0	cy	Redemption: the redemption value per 100 currency units of par value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154139				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3163815				0	cy	A non-interest-bearing security is purchased on 2/15/1999. It matures on 3/1/1999. The price is 99.795 currency units per 100 units of par value, the redemption value is 100 units. The basis is 2. How high is the yield?				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155187				0	cy	=YIELDDISC("2/15/1999"; "3/1/1999"; 99.795; 100; 2) returns 0.052823 or 5.2823 per cent.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3155140				0	cy	\<bookmark_value\>YIELDMAT function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155140				0	cy	YIELDMAT				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151332				0	cy	\<ahelp hid=\"HID_AAI_FUNC_YIELDMAT\"\>Calculates the annual yield of a security, the interest of which is paid on the date of maturity.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3159100				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3159113				0	cy	YIELDMAT(Settlement;Maturity;Issue;Rate;Price;Basis)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149309				0	cy	Settlement: the date of purchase of the security.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151381				0	cy	Maturity: the date on which the security matures (expires).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153302				0	cy	Issue: the date of issue of the security.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147140				0	cy	Rate: the interest rate of the security on the issue date.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151067				0	cy	Price: the price (purchase price) of the security per 100 currency units of par value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155342				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3163717				0	cy	A security is purchased on 3/15/1999. It matures on 11/3/1999. The issue date was 11/8/1998. The rate of interest is 6.25%, the price is 100.0123 units. The basis is 0. How high is the yield?				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155311				0	cy	=YIELDMAT("3/15/1999"; "11/3/1999"; "11/8/1998"; 0.0625; 100.0123; 0) returns 0.060954 or 6.0954 per cent.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3149577				0	cy	\<bookmark_value\>calculating;annuities\</bookmark_value\>\<bookmark_value\>annuities\</bookmark_value\>\<bookmark_value\>PMT function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149577				0	cy	PMT				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148563				0	cy	\<ahelp hid=\"HID_FUNC_RMZ\"\>Returns the periodic payment for an annuity with constant interest rates.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3145257				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147278				0	cy	PMT(Rate; NPER; PV; FV; Type)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147291				0	cy	Rate: the periodic interest rate.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148641				0	cy	NPER: the number of periods in which annuity is paid.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156360				0	cy	PV: the present value (cash value) in a sequence of payments.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154920				0	cy	FV (optional): the desired value (future value) to be reached at the end of the periodic payments.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156434				0	cy	Type (optional): the due date for the periodic payments. Type=1 is payment at the beginning and Type=0 is payment at the end of each period.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3152358				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154222				0	cy	What are the periodic payments at a yearly interest rate of 1.99% if the payment time is 3 years and the cash value is 25,000 currency units. There are 36 months as 36 payment periods, and the interest rate per payment period is 1.99%/12.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155943				0	cy	PMT(1.99%/12;36;25000) = -715.96 currency units. The periodic monthly payment is therefore 715.96 currency units.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3155799				0	cy	\<bookmark_value\>TBILLEQ function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155799				0	cy	TBILLEQ				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154403				0	cy	\<ahelp hid=\"HID_AAI_FUNC_TBILLEQ\"\>Calculates the annual return on a treasury bill ().\</ahelp\> A treasury bill is purchased on the settlement date and sold at the full par value on the maturity date, that must fall within the same year. A discount is deducted from the purchase price.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155080				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150224				0	cy	TBILLEQ(Settlement;Maturity;Discount)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156190				0	cy	Settlement: the date of purchase of the security.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153827				0	cy	Maturity: the date on which the security matures (expires).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150310				0	cy	Discount: the percentage discount on acquisition of the security.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150324				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153173				0	cy	Settlement date: March 31 1999, maturity date: June 1 1999, discount: 9.14 per cent.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153520				0	cy	The return on the treasury bill corresponding to a security is worked out as follows:				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154382				0	cy	=TBILLEQ("3/31/99";"6/1/99"; 0.0914) returns 0.094151 or 9.4151 per cent.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3151032				0	cy	\<bookmark_value\>TBILLPRICE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3151032				0	cy	TBILLPRICE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3157887				0	cy	\<ahelp hid=\"HID_AAI_FUNC_TBILLPRICE\"\>Calculates the price of a treasury bill per 100 currency units.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3156374				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150284				0	cy	TBILLPRICE(Settlement;Maturity;Discount)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154059				0	cy	Settlement: the date of purchase of the security.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154073				0	cy	Maturity: the date on which the security matures (expires).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145765				0	cy	Discount: the percentage discount upon acquisition of the security.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153373				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155542				0	cy	Settlement date: March 31 1999, maturity date: June 1 1999, discount: 9 per cent.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154578				0	cy	The price of the treasury bill is worked out as follows:				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154592				0	cy	=TBILLPRICE("3/31/99";"6/1/99"; 0.09) returns 98.45.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3152912				0	cy	\<bookmark_value\>TBILLYIELD function\</bookmark_value\>				2002-02-02 02:02:02
