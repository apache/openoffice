helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3153114				0	cy	\<ahelp hid=\"SFX2:EDIT:TP_DOCINFODOC:ED_FILE_NAME\"\>Displays the file name.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3156136				0	cy	Type:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3155552				0	cy	Displays the file type for the current document.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3145314				0	cy	Location:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3150506				0	cy	Displays the path and the name of the directory where the file is stored.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3155892				0	cy	Size:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3153311				0	cy	Displays the size of the current document in bytes.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3149178				0	cy	Created:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3153748				0	cy	Displays the date and time and author when the file was first saved.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3149182				0	cy	Modified:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3150355				0	cy	Displays the date and time and author when the file was last saved in a $[officename] file format.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_idN106C5				0	cy	Digitally signed:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_idN106C9				0	cy	Displays the date and the time when the file was last signed as well as the name of the author who signed the document.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_idN106CC				0	cy	Digital Signature				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_idN106D0				0	cy	Opens the \<link href=\"text/shared/01/digitalsignatures.xhp\"\>Digital Signatures\</link\> dialog where you can manage digital signatures for the current document.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3156346				0	cy	Last printed:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3152780				0	cy	Displays the date and time and user name when the file was last printed.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3153252				0	cy	Document number:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3149955				0	cy	Displays the number of times that the file has been saved.				2002-02-02 02:02:02
