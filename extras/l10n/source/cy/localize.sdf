helpcontent2	source\text\scalc\01\02210000.xhp	0	help	par_id3147265				0	cy	\<variable id=\"tabellenauswaehlen\"\>\<ahelp hid=\".uno:SelectTables\" visibility=\"visible\"\>Selects multiple sheets.\</ahelp\>.\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02210000.xhp	0	help	hd_id3125863				0	cy	Selected Sheets				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02210000.xhp	0	help	par_id3153969	3			0	cy	\<ahelp hid=\"HID_SELECTTABLES\" visibility=\"visible\"\>Lists the sheets in the current document. To select a sheet, press the up or down arrow keys to move to a sheet in the list. To add a sheet to the selection, hold down Ctrl while pressing the arrow keys  and then press Spacebar. To select a range of sheets, hold down Shift and press the arrow keys. \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02170000.xhp	0	help	tit				0	cy	Delete Sheet				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02170000.xhp	0	help	bm_id3156424				0	cy	\<bookmark_value\>spreadsheets; deleting\</bookmark_value\>\<bookmark_value\>sheets; deleting\</bookmark_value\>\<bookmark_value\>deleting; spreadsheets\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02170000.xhp	0	help	hd_id3156424				0	cy	 Delete Sheet				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02170000.xhp	0	help	par_id3153193				0	cy	\<variable id=\"tabelleloeschentext\"\>\<ahelp hid=\".uno:Remove\"\>Deletes the current sheet after query confirmation.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02170000.xhp	0	help	par_id3145801				0	cy	You cannot delete a sheet if changes to the document are being recorded, as in when \<emph\>Edit - Changes - Record\</emph\> is activated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02170000.xhp	0	help	hd_id3147124				0	cy	Yes				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02170000.xhp	0	help	par_id3154943				0	cy	Permanently deletes the active sheet.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02170000.xhp	0	help	hd_id3149412				0	cy	No				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02170000.xhp	0	help	par_id3154510				0	cy	Cancels the dialog. No delete is performed.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	tit				0	cy	DAY 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	bm_id3147317				0	cy	\<bookmark_value\>DAY function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	hd_id3147317				0	cy	\<variable id=\"day\"\>\<link href=\"text/scalc/01/func_day.xhp\"\>DAY\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3147584				0	cy	\<ahelp hid=\"HID_FUNC_TAG\"\>Returns the day of given date value.\</ahelp\> The day is returned as an integer between 1 and 31. You can also enter a negative date/time value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	hd_id3150487				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3149430				0	cy	DAY(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3149443				0	cy	\<emph\>Number\</emph\>, as a time value, is a decimal, for which the day is to be returned.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	hd_id3163809	111			0	cy	Examples 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3151200				0	cy	DAY(1) returns 31 (since $[officename] starts counting at zero from December 30, 1899)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3154130				0	cy	DAY(NOW()) returns the current day.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3159190				0	cy	DAY(C4) returns 5 if the contents of C4 = 8/5/1901.				2002-02-02 02:02:02
