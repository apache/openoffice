helpcontent2	source\text\smath\01\05030000.xhp	0	help	par_id3147509				0	cy	\<ahelp hid=\"HID_SMA_LOWERLIMIT_DIST\"\>Determines the spacing between the sum symbol and the lower limit.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05030000.xhp	0	help	hd_id3154267				0	cy	Brackets				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05030000.xhp	0	help	par_id3154273				0	cy	Defines the spacing between brackets and the content.				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05030000.xhp	0	help	hd_id3150708				0	cy	Excess size (left/right)				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05030000.xhp	0	help	par_id3154106				0	cy	\<ahelp hid=\"HID_SMA_BRACKET_EXCHEIGHT\"\>Determines the vertical distance between the upper edge of the contents and the upper end of the brackets.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05030000.xhp	0	help	hd_id3109843				0	cy	Spacing				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05030000.xhp	0	help	par_id3149810				0	cy	\<ahelp hid=\"HID_SMA_BRACKET_DIST\"\>Determines the horizontal distance between the contents and the upper end of the brackets.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05030000.xhp	0	help	hd_id3153531				0	cy	Scale all brackets				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05030000.xhp	0	help	par_id3154799				0	cy	\<ahelp hid=\"STARMATH:CHECKBOX:RID_DISTANCEDIALOG:1\"\>Scales all types of brackets.\</ahelp\> If you then enter \<emph\>( a over b)\</emph\> in the \<emph\>Commands\</emph\> window, the brackets will surround the whole height of the argument. You normally achieve this effect by entering \<emph\>left ( a over b right )\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05030000.xhp	0	help	hd_id3151099				0	cy	Excess size				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05030000.xhp	0	help	par_id3147524				0	cy	\<ahelp hid=\"HID_SMA_BRACKET_EXCHEIGHT2\"\>Adjusts the percentage excess size.\</ahelp\> At 0 percent the brackets are set so that they surround the argument at the same height. The higher the entered value is, the larger the vertical gap between the contents of the brackets and the external border of the brackets. The field can only be used in combination with \<emph\>Scale all brackets\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05030000.xhp	0	help	hd_id3153673				0	cy	Matrixes				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05030000.xhp	0	help	par_id3151319				0	cy	Defines the relative spacing for the elements in a matrix.				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05030000.xhp	0	help	hd_id3150996				0	cy	Line spacing				2002-02-02 02:02:02
