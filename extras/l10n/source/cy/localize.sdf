helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3146965				0	cy	\<ahelp hid=\"HID_AAI_FUNC_IMAGINARY\"\>The result is the imaginary coefficient of a complex number.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3153555				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3155522				0	cy	IMAGINARY(Complex number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3151193				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3155592	57			0	cy	=IMAGINARY("4+3j") returns 3.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	bm_id3146106				0	cy	\<bookmark_value\>IMPOWER function\</bookmark_value\>				2002-02-02 02:02:02
