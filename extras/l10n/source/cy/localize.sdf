helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	hd_id3154725				0	cy	\<variable id=\"hour\"\>\<link href=\"text/scalc/01/func_hour.xhp\"\>HOUR\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	par_id3149747				0	cy	\<ahelp hid=\"HID_FUNC_STUNDE\"\>Returns the hour for a given time value.\</ahelp\> The hour is returned as an integer between 0 and 23.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	hd_id3149338				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	par_id3150637				0	cy	HOUR(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	par_id3147547				0	cy	\<emph\>Number\</emph\>, as a time value, is a decimal, for which the hour is to be returned.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	hd_id3153264				0	cy	Examples				2002-02-02 02:02:02
