helpcontent2	source\text\swriter\01\05030800.xhp	0	help	par_id3154831				0	cy	\<ahelp hid=\"SW:TRISTATEBOX:TP_NUMPARA:CB_NEW_START\"\>Restarts the numbering at the current paragraph.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05030800.xhp	0	help	hd_id3147096				0	cy	Start with				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05030800.xhp	0	help	par_id3148979				0	cy	\<ahelp hid=\"SW_TRISTATEBOX_TP_NUMPARA_CB_NUMBER_NEW_START\"\>Select this check box, and then enter the number that you want to assign to the paragraph.\</ahelp\>				2002-02-02 02:02:02
