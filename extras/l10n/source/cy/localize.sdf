helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3157888				0	cy	\<ahelp hid=\"HID_FUNC_GLAETTEN\"\>Removes spaces that are in front of a string, or aligns cell contents to the left.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152913				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151349				0	cy	TRIM(Text)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151362	58			0	cy	\<emph\>text\</emph\> refers to text in which leading spaces are removed, or to the cell in which the contents will be left-aligned.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146838				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156074	60			0	cy	TRIM("   hello") returns "hello".				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3145178				0	cy	\<bookmark_value\>UPPER function\</bookmark_value\>				2002-02-02 02:02:02
