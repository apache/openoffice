helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN10993				0	cy	\<ahelp hid=\"sfx2:CheckBox:RID_DLG_SEARCH:CB_WHOLEWORDS\" visibility=\"hidden\"\>Finds complete words only.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN109AA				0	cy	\<ahelp hid=\"sfx2:CheckBox:RID_DLG_SEARCH:CB_MATCHCASE\" visibility=\"hidden\"\>Distinguishes between uppercase text and lowercase text.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN109C1				0	cy	\<ahelp hid=\"sfx2:CheckBox:RID_DLG_SEARCH:CB_WRAPAROUND\" visibility=\"hidden\"\>Searches the entire Help page, starting at the current position of the cursor.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_idN109D8				0	cy	\<ahelp hid=\"sfx2:CheckBox:RID_DLG_SEARCH:CB_BACKWARDS\" visibility=\"hidden\"\>Searches backwards from the current position of the cursor.\</ahelp\>				2002-02-02 02:02:02
