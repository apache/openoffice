helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3153534				0	cy	\<bookmark_value\>ROMAN function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153534				0	cy	ROMAN				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151256				0	cy	\<ahelp hid=\"HID_FUNC_ROEMISCH\"\>Converts a number into a Roman numeral. The value range must be between 0 and 3999, the modes can be integers from 0 to 4.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149299				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150593				0	cy	ROMAN(Number; Mode)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156139	252			0	cy	\<emph\>Number\</emph\> is the number that is to be converted into a Roman numeral.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153318	253			0	cy	\<emph\>Mode\</emph\> (optional) indicates the degree of simplification. The higher the value, the greater is the simplification of the Roman number.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3145306				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151371	255			0	cy	ROMAN(999) returns CMXCIX				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153938	256			0	cy	ROMAN(999;0) returns CMXCIX				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148412	257			0	cy	ROMAN (999;1) returns LMVLIV				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155421	258			0	cy	ROMAN(999;2) returns XMIX				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149235	259			0	cy	ROMAN(999;3) returns VMIV				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150624	260			0	cy	ROMAN(999;4) returns IM				2002-02-02 02:02:02
