helpcontent2	source\text\scalc\01\02120100.xhp	0	help	par_id3145638				0	cy	\<ahelp hid=\"HID_SC_HF_TIME\"\>Inserts a placeholder in the selected header/footer area, which is replaced by the current time in the header/footer on each page of the document.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02120100.xhp	0	help	par_id3153122				0	cy	\<image id=\"img_id3146884\" src=\"sc/res/time.png\" width=\"6.35mm\" height=\"5.64mm\"\>\<alt id=\"alt_id3146884\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
