helpcontent2	source\text\swriter\01\05060900.xhp	0	help	hd_id3152770				0	cy	Properties				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	par_id3155137				0	cy	Specifies print and text options for the selected item.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	hd_id3153345				0	cy	Editable in read-only document (frames only)				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	par_id3149167				0	cy	\<ahelp hid=\"SW:CHECKBOX:TP_FRM_ADD:CB_EDIT_IN_READONLY\"\>Allows you to edit the contents of a frame in a document that is read-only (write-protected).\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	hd_id3156269				0	cy	Print				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	par_id3151028				0	cy	\<ahelp hid=\"SW:CHECKBOX:TP_FRM_ADD:CB_PRINT_FRAME\"\>Includes the selected item when you print the document.\</ahelp\>				2002-02-02 02:02:02
