helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3148645				0	cy	sUS_date = Mid(sInput, 6, 2)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3153952				0	cy	sUS_date = sUS_date & "/"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3153364				0	cy	sUS_date = sUS_date & Right(sInput, 2)				2002-02-02 02:02:02
