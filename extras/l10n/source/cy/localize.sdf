helpcontent2	source\text\shared\guide\active_help_on_off.xhp	0	help	hd_id3156414				0	cy	\<variable id=\"active_help_on_off\"\>\<link href=\"text/shared/guide/active_help_on_off.xhp\" name=\"Turning Extended Tips On and Off\"\>Turning Extended Tips On and Off\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\active_help_on_off.xhp	0	help	par_id3157958				0	cy	\<emph\>Extended tips\</emph\> provide a brief description of the function of a particular icon, text box or menu command when you rest your cursor on that item.				2002-02-02 02:02:02
