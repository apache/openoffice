helpcontent2	source\text\swriter\01\03140000.xhp	0	help	par_id3150251				0	cy	\<ahelp hid=\".uno:ShowHiddenParagraphs\"\>Shows or hides hidden paragraphs.\</ahelp\> This option only affects the screen display of hidden paragraphs, and not the printing of hidden paragraphs.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\03140000.xhp	0	help	par_id3154501				0	cy	Use the \<link href=\"text/swriter/01/04090000.xhp\" name=\"field command\"\>field command\</link\> "Hidden Paragraph" to assign a \<link href=\"text/swriter/01/04090200.xhp\" name=\"condition\"\>condition\</link\> that must be met to hide a paragraph. If the condition is not met, the paragraph is displayed.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\03140000.xhp	0	help	par_id3083451				0	cy	When you hide a paragraph, footnotes and frames that are anchored to characters in the paragraph are also hidden.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090000.xhp	0	help	par_id3154643				0	cy	\<variable id=\"tabelletext\"\>\<ahelp hid=\".uno:TableDialog\"\>Specifies the properties of the selected table, for example, name, alignment, spacing, column width, borders, and background.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	tit				0	cy	Select Address Block				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN10539				0	cy	Select Address Block				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN1053D				0	cy	Select, edit, or delete an address block layout for \<link href=\"text/swriter/01/mailmerge03.xhp\"\>mail merge\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN1054E				0	cy	Select the address block which you want to use				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN10552				0	cy	\<ahelp hid=\".\"\>Select the block in the list that you want to use for mail merge addresses, and click \<emph\>OK\</emph\>.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN10555				0	cy	Never include country/region				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN10559				0	cy	\<ahelp hid=\".\"\>Excludes country or regional information from the address block.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN1055C				0	cy	Always include country/region				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN10560				0	cy	\<ahelp hid=\".\"\>Includes country or regional information in the address block.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN10563				0	cy	Only include country/region if it is not:				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN10567				0	cy	\<ahelp hid=\".\"\>Only includes country or regional information in the address block if the value differs from the value that you enter in the text box.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN10651				0	cy	\<ahelp hid=\".\"\>Enter the country/region string that shall not be printed.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN1056A				0	cy	New				2002-02-02 02:02:02
