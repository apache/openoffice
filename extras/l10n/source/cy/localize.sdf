helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3148993				0	cy	sEntry(2) = "Kurt"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3156382				0	cy	sEntry(3) = "Thomas"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3155174				0	cy	sEntry(4) = "Michael"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3166448				0	cy	sEntry(5) = "David"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3149255				0	cy	sEntry(6) = "Cathy"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3149565				0	cy	sEntry(7) = "Susie"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3145148				0	cy	sEntry(8) = "Edward"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3145229				0	cy	sEntry(9) = "Christine"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3149107				0	cy	For iCount = 0 To 9				2002-02-02 02:02:02
