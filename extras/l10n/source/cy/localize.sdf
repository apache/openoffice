helpcontent2	source\text\shared\optionen\01020000.xhp	0	help	par_id3146957	2			0	cy	\<variable id=\"laden\"\>\<ahelp hid=\"\" visibility=\"visible\"\>Specifies general Load/Save settings. \</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	tit				0	cy	Print Options				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	bm_id3147323				0	cy	\<bookmark_value\>printing; colors in grayscale\</bookmark_value\>\<bookmark_value\>grayscale printing\</bookmark_value\>\<bookmark_value\>colors; printing in grayscale\</bookmark_value\>\<bookmark_value\>printing; warnings\</bookmark_value\>\<bookmark_value\>paper size warning\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3148946				0	cy	\<link href=\"text/shared/optionen/01010900.xhp\" name=\"Print Options\"\>Print Options\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3148451				0	cy	Reduce print data				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3154910				0	cy	You can reduce the amount of data to be sent to the printer. Reducing the print data increases the print speed because the print files are smaller. This makes it easier for printers with a smaller memory to print. Reducing print data can result in slightly lower print quality.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3147085				0	cy	Settings for				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3158407				0	cy	\<ahelp hid=\"SFX2_RADIOBUTTON_TP_COMMONPRINTOPTIONS_RB_PRINTFILEOUTPUT\"\>Specifies whether the print settings apply to direct printing or to printing to a file.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3145786				0	cy	Reduce transparency				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3159154				0	cy	\<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_REDUCETRANSPARENCY\"\>If you mark this field the transparent objects will be printed like normal, non-transparent objects, depending on your selection in the following two option buttons.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3156444				0	cy	Transparency cannot be output directly to a printer. The areas of the document in which transparency is to be visible must therefore always be calculated as bitmaps and sent to the printer. Depending on the size of the bitmaps and the print resolution a large amount of data may result.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3147441				0	cy	Automatically				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3150488				0	cy	\<ahelp hid=\"SFX2_RADIOBUTTON_TP_COMMONPRINTOPTIONS_RB_REDUCETRANSPARENCY_AUTO\"\>Specifies that the transparency is only printed if the transparent area covers less than a quarter of the entire page.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3149417				0	cy	No transparency				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3153878				0	cy	\<ahelp hid=\"SFX2_RADIOBUTTON_TP_COMMONPRINTOPTIONS_RB_REDUCETRANSPARENCY_NONE\"\>With this option transparency is never printed.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3149960				0	cy	Reduce bitmaps				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3148455				0	cy	\<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_REDUCEBITMAPS\"\>Specifies that bitmaps are printed with reduced quality. The resolution can only be reduced and not increased.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3149400				0	cy	High/normal print quality				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3154510	76			0	cy	\<ahelp hid=\"SFX2_RADIOBUTTON_TP_COMMONPRINTOPTIONS_RB_REDUCEBITMAPS_NORMAL\"\>High print quality corresponds to a resolution of 300dpi. Normal print quality corresponds to a resolution of 200dpi. \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3146969				0	cy	Resolution				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3154270				0	cy	\<ahelp hid=\"SFX2_LISTBOX_TP_COMMONPRINTOPTIONS_LB_REDUCEBITMAPS_RESOLUTION\"\>Specifies the maximum print quality in dpi. The resolution can only be reduced and not increased.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3146789				0	cy	Include transparent objects				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3150749				0	cy	\<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_REDUCEBITMAPS_TRANSPARENCY\"\>If this field is marked, the reduction in print quality for bitmaps also applies to the transparent areas of objects.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3154362				0	cy	Reduce gradients				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3148914				0	cy	\<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_REDUCEGRADIENTS\"\>If this field is marked, gradients are printed with reduced quality.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3155766				0	cy	Gradient stripes				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3156382				0	cy	\<ahelp hid=\"SFX2_NUMERICFIELD_TP_COMMONPRINTOPTIONS_NF_REDUCEGRADIENTS_STEPCOUNT\"\>Specifies the maximum number of gradient stripes for printing.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3146313				0	cy	Intermediate color				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3145230				0	cy	\<ahelp hid=\"SFX2_RADIOBUTTON_TP_COMMONPRINTOPTIONS_RB_REDUCEGRADIENTS_COLOR\"\>Specifies that gradients are only printed in a single intermediate color.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3147323				0	cy	Convert colors to grayscale				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3145150				0	cy	\<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_CONVERTTOGREYSCALES\"\>Specifies that all colors are printed only as grayscale.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3150646				0	cy	Printer warnings				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3154022				0	cy	\<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_CONVERTTOGREYSCALES\"\>Defines which warnings appear before printing begins.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3147003				0	cy	Paper size				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3150206				0	cy	\<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_PAPERSIZE\"\>Mark this check box if a certain paper size is needed for printing the current document.\</ahelp\> If the paper size used in the document is not provided by the current printer, you will receive an error message.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3155581				0	cy	Paper orientation				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3153231				0	cy	\<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_PAPERORIENTATION\"\>Mark this check box if you need a certain paper orientation for printing the current document.\</ahelp\> If the format used by the current document is not available from the printer, an error message will appear.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3149531				0	cy	Transparency				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3152778				0	cy	\<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_TRANSPARENCY\"\>Mark this check box if you always want to be warned if transparent objects are contained in the document.\</ahelp\> If you print such a document, a dialog appears in which you can select if the transparency is to be printed in this print instruction.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01130100.xhp	0	help	tit				0	cy	VBA Properties				2002-02-02 02:02:02
