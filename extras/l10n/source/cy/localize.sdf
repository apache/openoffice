helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3154372				0	cy	\<variable id=\"fh\"\>\<link href=\"text/scalc/01/04060182.xhp\" name=\"Statistical Functions Part Two\"\>Statistical Functions Part Two\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3145388				0	cy	\<bookmark_value\>FINV function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3145388				0	cy	FINV				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155089				0	cy	\<ahelp hid=\"HID_FUNC_FINV\"\>Returns the inverse of the F probability distribution.\</ahelp\> The F distribution is used for F tests in order to set the relation between two differing data sets.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3153816				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153068				0	cy	FINV(Number; degrees_freedom_1; degrees_freedom_2)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146866	6			0	cy	\<emph\>Number\</emph\> is probability value for which the inverse F distribution is to be calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153914	7			0	cy	\<emph\>degrees_freedom_1\</emph\> is the number of degrees of freedom in the numerator of the F distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3148607	8			0	cy	\<emph\>degrees_freedom_2\</emph\> is the number of degrees of freedom in the denominator of the F distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3156021				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145073	10			0	cy	=FINV(0.5; 5; 10) yields 0.93.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3150888				0	cy	\<bookmark_value\>FISHER function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150888				0	cy	FISHER				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155384				0	cy	\<ahelp hid=\"HID_FUNC_FISHER\"\>Returns the Fisher transformation for x and creates a function close to a normal distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3149898				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3143220				0	cy	FISHER(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3159228	16			0	cy	\<emph\>Number\</emph\> is the value to be transformed.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3154763				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3149383	18			0	cy	=FISHER(0.5) yields 0.55.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3155758				0	cy	\<bookmark_value\>FISHERINV function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3155758				0	cy	FISHERINV				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154734				0	cy	\<ahelp hid=\"HID_FUNC_FISHERINV\"\>Returns the inverse of the Fisher transformation for x and creates a function close to a normal distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3155755				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146108				0	cy	FISHERINV(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145115	24			0	cy	\<emph\>Number\</emph\> is the value that is to undergo reverse-transformation.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3155744				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150432	26			0	cy	=FISHERINV(0.5) yields 0.46.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3151390				0	cy	\<bookmark_value\>FTEST function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3151390				0	cy	FTEST				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150534				0	cy	\<ahelp hid=\"HID_FUNC_FTEST\"\>Returns the result of an F test.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3166466				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153024				0	cy	FTEST(Data_1; Data_2)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150032	32			0	cy	\<emph\>Data_1\</emph\> is the first record array.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153018	33			0	cy	\<emph\>Data_2\</emph\> is the second record array.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3153123				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3159126	35			0	cy	=FTEST(A1:A30; B1:B12) calculates whether the two data sets are different in their variance and returns the probability that both sets could have come from the same total population.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3150372				0	cy	\<bookmark_value\>FDIST function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150372				0	cy	FDIST				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3152981				0	cy	\<ahelp hid=\"HID_FUNC_FVERT\"\>Calculates the values of an F distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150484				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145826				0	cy	FDIST(Number; degrees_freedom_1; degrees_freedom_2)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150461	41			0	cy	\<emph\>Number\</emph\> is the value for which the F distribution is to be calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150029	42			0	cy	\<emph\>degrees_freedom_1\</emph\> is the degrees of freedom in the numerator in the F distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146877	43			0	cy	\<emph\>degrees_freedom_2\</emph\> is the degrees of freedom in the denominator in the F distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3147423				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150696	45			0	cy	=FDIST(0.8; 8; 12) yields 0.61.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3154841				0	cy	\<bookmark_value\>GAMMAINV function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3154841				0	cy	GAMMAINV				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153932				0	cy	\<ahelp hid=\"HID_FUNC_GAMMAINV\"\>Returns the inverse of the Gamma cumulative distribution.\</ahelp\> This function allows you to search for variables with different distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3149949				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155828				0	cy	GAMMAINV(Number; Alpha; Beta)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145138	51			0	cy	\<emph\>Number\</emph\> is the probability value for which the inverse Gamma distribution is to be calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3152785	52			0	cy	\<emph\>Alpha\</emph\> is the parameter Alpha of the Gamma distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154561	53			0	cy	\<emph\>Beta\</emph\> is the parameter Beta of the Gamma distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3148734				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153331	55			0	cy	=GAMMAINV(0.8; 1; 1) yields 1.61.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3154806				0	cy	\<bookmark_value\>GAMMALN function\</bookmark_value\>				2002-02-02 02:02:02
