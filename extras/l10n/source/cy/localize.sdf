helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3159254				0	cy	const b2=1.345e34				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3147287				0	cy	dValue=Exp( Log(b1)+Log(b2) )				2002-02-02 02:02:02
