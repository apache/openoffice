helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154651				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146964				0	cy	MIN(Number 1; Number 2; ...Number 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153486				0	cy	\<emph\>Number 1; Number 2;...Number 30\</emph\> are numerical values or ranges.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155523				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154734				0	cy	=MIN(A1:B100) returns the smallest value in the list.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3147504				0	cy	\<bookmark_value\>MINA function\</bookmark_value\>				2002-02-02 02:02:02
