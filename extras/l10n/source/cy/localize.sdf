helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153415				0	cy	\<variable id=\"mq\"\>\<link href=\"text/scalc/01/04060184.xhp\" name=\"Statistical Functions Part Four\"\>Statistical Functions Part Four\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3154511				0	cy	\<bookmark_value\>MAX function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154511				0	cy	MAX				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153709				0	cy	\<ahelp hid=\"HID_FUNC_MAX\"\>Returns the maximum value in a list of arguments.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154256				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147340				0	cy	MAX(Number 1; Number 2; ...Number 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149568	6			0	cy	\<emph\>Number 1; Number 2;...Number 30\</emph\> are numerical values or ranges. 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153963				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147343				0	cy	=MAX(A1;A2;A3;50;100;200) returns the largest value from the list.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148485				0	cy	=MAX(A1:B100) returns the largest value from the list.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3166426				0	cy	\<bookmark_value\>MAXA function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3166426				0	cy	MAXA				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150363				0	cy	\<ahelp hid=\"HID_FUNC_MAXA\"\>Returns the maximum value in a list of arguments. In opposite to MAX, here you can enter text. The value of the text is 0.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150516				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3166431				0	cy	MAXA(Value 1; Value 2; ... Value 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150202				0	cy	\<emph\>Value 1; Value 2;...Value 30\</emph\> are values or ranges. Text has the value of 0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3156290				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156446				0	cy	=MAXA(A1;A2;A3;50;100;200;"Text") returns the largest value from the list.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149404				0	cy	=MAXA(A1:B100) returns the largest value from the list.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153820				0	cy	\<bookmark_value\>MEDIAN function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153820				0	cy	MEDIAN				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151241				0	cy	\<ahelp hid=\"HID_FUNC_MEDIAN\"\>Returns the median of a set of numbers. In a set containing an uneven number of values, the median will be the number in the middle of the set and in a set containing an even number of values, it will be the mean of the two values in the middle of the set.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148871				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155264				0	cy	MEDIAN(Number 1; Number 2; ...Number 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150109				0	cy	\<emph\>Number 1; Number 2;...Number 30\</emph\> are values or ranges, which represent a sample. Each number can also be replaced by a reference.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3144506				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145078				0	cy	for an odd number: =MEDIAN(1; 5; 9; 20; 21) returns 9 as the median value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149126				0	cy	for an even number: =MEDIAN(1; 5; 9; 20) returns the average of the two middle values 5 and 9, thus 7.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3154541				0	cy	\<bookmark_value\>MIN function\</bookmark_value\>				2002-02-02 02:02:02
