helpcontent2	source\text\scalc\01\12080100.xhp	0	help	hd_id3155628				0	cy	\<link href=\"text/scalc/01/12080100.xhp\" name=\"Hide Details\"\>Hide Details\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12080100.xhp	0	help	par_id3154515				0	cy	\<ahelp hid=\".uno:HideDetail\" visibility=\"visible\"\>Hides the details of the grouped row or column that contains the cursor. To hide all of the grouped rows or columns, select the outlined table, and then choose this command.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12080100.xhp	0	help	par_id3153252	3			0	cy	To show all hidden groups, select the outlined table, and then choose \<emph\>Data -Outline –\</emph\> \<link href=\"text/scalc/01/12080200.xhp\" name=\"Show Details\"\>\<emph\>Show Details\</emph\>\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090200.xhp	0	help	tit				0	cy	Refresh				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090200.xhp	0	help	hd_id3151385				0	cy	\<link href=\"text/scalc/01/12090200.xhp\" name=\"Refresh\"\>Refresh\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	tit				0	cy	TIME 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	bm_id3154073				0	cy	\<bookmark_value\>TIME function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	hd_id3154073				0	cy	\<variable id=\"time\"\>\<link href=\"text/scalc/01/func_time.xhp\"\>TIME\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3145762				0	cy	\<ahelp hid=\"HID_FUNC_ZEIT\"\>TIME returns the current time value from values for hours, minutes and seconds.\</ahelp\> This function can be used to convert a time based on these three elements to a decimal time value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	hd_id3155550				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3154584				0	cy	TIME(hour; minute; second)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3152904				0	cy	Use an integer to set the \<emph\>hour\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3151346				0	cy	Use an integer to set the \<emph\>minute\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3151366				0	cy	Use an integer to set the \<emph\>second\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	hd_id3145577				0	cy	Examples				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3156076				0	cy	TIME("0;0;0") returns 00:00:00				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3156090				0	cy	TIME("4;20;4") returns 04:20:04				2002-02-02 02:02:02
