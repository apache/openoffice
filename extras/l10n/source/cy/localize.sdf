helpcontent2	source\text\simpress\02\11100000.xhp	0	help	hd_id3150012				0	cy	\<link href=\"text/simpress/02/11100000.xhp\" name=\"Formatting On/Off\"\>Formatting On/Off\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\simpress\02\11100000.xhp	0	help	par_id3151073				0	cy	\<ahelp hid=\".uno:OutlineFormat\"\>Shows or hides the character formatting of the slide headings. To change the character formatting of a heading, open the \<emph\>Styles and Formatting\</emph\> window, right-click a style, and then choose \<emph\>Modify\</emph\>.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\simpress\02\11100000.xhp	0	help	par_id3156382				0	cy	\<image id=\"img_id3154254\" src=\"res/commandimagelist/sc_outlineformat.png\" width=\"0.1665inch\" height=\"0.1665inch\"\>\<alt id=\"alt_id3154254\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
