helpcontent2	source\text\shared\01\06200000.xhp	0	help	hd_id3148826				0	cy	Conversion				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3159157				0	cy	Normally in a mixed text selection made of Hangul and Hanja characters, all Hangul characters will be converted to Hanja and all Hanja characters will be converted to Hangul. If you want to convert a mixed text selection only in one direction, use the following conversion options.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	hd_id3153585				0	cy	Hangul only				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3154142				0	cy	\<ahelp hid=\"SVX_CHECKBOX_RID_SVX_MDLG_HANGULHANJA_CB_HANGUL_ONLY\"\>Check to convert only Hangul. Do not convert Hanja.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	hd_id3150823				0	cy	Hanja only				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3156023				0	cy	\<ahelp hid=\"SVX_CHECKBOX_RID_SVX_MDLG_HANGULHANJA_CB_HANJA_ONLY\"\>Check to convert only Hanja. Do not convert Hangul.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	hd_id3152360				0	cy	Ignore				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3153896				0	cy	\<ahelp hid=\"HID_HANGULDLG_BUTTON_IGNORE\"\>No changes will be made to the current selection. The next word or character will be selected for conversion.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	hd_id3148550				0	cy	Always Ignore				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3154937				0	cy	\<ahelp hid=\"HID_HANGULDLG_BUTTON_IGNOREALL\"\>No changes will be made to the current selection, and every time the same selection is detected it will be skipped automatically.\</ahelp\> The next word or character will be selected for conversion. The list of ignored text is valid for the current $[officename] session.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	hd_id3151056				0	cy	Replace				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3148403				0	cy	\<ahelp hid=\"HID_HANGULDLG_BUTTON_CHANGE\"\>Replaces the selection with the suggested characters or word according to the format options.\</ahelp\> The next word or character will be selected for conversion.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	hd_id3153360				0	cy	Always Replace				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3153338				0	cy	\<ahelp hid=\"HID_HANGULDLG_BUTTON_CHANGEALL\"\>Replaces the selection with the suggested characters or word according to the format options. Every time the same selection is detected it will be replaced automatically.\</ahelp\> The next word or character will be selected for conversion. The list of replacement text is valid for the current $[officename] session.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	hd_id3149290				0	cy	Replace by character				2002-02-02 02:02:02
