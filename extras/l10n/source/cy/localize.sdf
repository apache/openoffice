helpcontent2	source\text\sbasic\shared\03010305.xhp	0	help	par_id3154491				0	cy	"red= " & red(lVar) & Chr(13)&_				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010305.xhp	0	help	par_id3149401				0	cy	"green= " & green(lVar) & Chr(13)&_				2002-02-02 02:02:02
