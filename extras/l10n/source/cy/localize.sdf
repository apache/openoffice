helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3147245				0	cy	\<ahelp hid=\"HID_AAI_FUNC_IMPOWER\"\>The result is the integer power of a complex number.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3150954				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3147501				0	cy	IMPOWER(Complex number;Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3155743	63			0	cy	Number: the exponent.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3149048				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3151393	65			0	cy	=IMPOWER("2+3i";2) returns -5+12i.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	bm_id3148748				0	cy	\<bookmark_value\>IMARGUMENT function\</bookmark_value\>				2002-02-02 02:02:02
