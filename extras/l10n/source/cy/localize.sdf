helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3149895				0	cy	\<ahelp hid=\"HID_AAI_FUNC_IMABS\"\>The result is the absolute value of a complex number.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3155382				0	cy	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3151302				0	cy	IMABS(Complex number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3149697				0	cy	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3143222	50			0	cy	=IMABS("5+12j") returns 13.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	bm_id3145357				0	cy	\<bookmark_value\>IMAGINARY function\</bookmark_value\>				2002-02-02 02:02:02
