helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149202	111			0	sh	            \<emph\>Data1\</emph\> is the dependent array or range of data for the first record.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3145666	112			0	sh	            \<emph\>Data2\</emph\> is the dependent array or range of data for the second record.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153903	113			0	sh	            \<emph\>Mode\</emph\> = 1 calculates the one-tailed test, \<emph\>Mode\</emph\> = 2 the two- tailed test.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3155327	114			0	sh	            \<emph\>Type\</emph\> is the kind of t-test to perform. Type 1 means paired. Type 2 means two samples, equal variance (homoscedastic). Type 3 means two samples, unequal variance (heteroscedastic).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3159342				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150119	116			0	sh	            \<item type=\"input\"\>=TTEST(A1:A50;B1:B50;2;2)\</item\>         				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3154930				0	sh	\<bookmark_value\>TDIST function\</bookmark_value\>         \<bookmark_value\>t-distribution\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3154930				0	sh	TDIST				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153372				0	sh	\<ahelp hid=\"HID_FUNC_TVERT\"\>Returns the t-distribution.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3149911				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150521				0	sh	TDIST(Number; DegreesFreedom; Mode)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3146991	122			0	sh	            \<emph\>Number\</emph\> is the value for which the t-distribution is calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3148824	123			0	sh	            \<emph\>DegreesFreedom\</emph\> is the number of degrees of freedom for the t-distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149340	124			0	sh	            \<emph\>Mode\</emph\> = 1 returns the one-tailed test, \<emph\>Mode\</emph\> = 2 returns the two-tailed test.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3159150				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149773	126			0	sh	            \<item type=\"input\"\>=TDIST(12;5;1)\</item\>         				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3153828				0	sh	\<bookmark_value\>VAR function\</bookmark_value\>         \<bookmark_value\>variances\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3153828				0	sh	VAR				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3159165				0	sh	\<ahelp hid=\"HID_FUNC_VARIANZ\"\>Estimates the variance based on a sample.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3154286				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153054				0	sh	VAR(Number1; Number2; ...Number30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3148938	132			0	sh	            \<emph\>Number1, Number2, ...Number30\</emph\> are numerical values or ranges representing a sample based on an entire population.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3147233				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153575	134			0	sh	            \<item type=\"input\"\>=VAR(A1:A50)\</item\>         				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3151045				0	sh	\<bookmark_value\>VARA function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3151045				0	sh	VARA				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3155122				0	sh	\<ahelp hid=\"HID_FUNC_VARIANZA\"\>Estimates a variance based on a sample. The value of text is 0.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3149176				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149999				0	sh	VARA(Value1; Value2; ...Value30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3158421	206			0	sh	            \<emph\>Value1, Value2,...Value30\</emph\> are values or ranges representing a sample derived from an entire population. Text has the value 0.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3149160				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154279	208			0	sh	            \<item type=\"input\"\>=VARA(A1:A50)\</item\>         				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3166441				0	sh	\<bookmark_value\>VARP function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3166441				0	sh	VARP				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3159199				0	sh	\<ahelp hid=\"HID_FUNC_VARIANZEN\"\>Calculates a variance based on the entire population.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3150706				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3147282				0	sh	VARP(Number1; Number2; ...Number30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149793	140			0	sh	            \<emph\>Number1, Number2, ...Number30\</emph\> are numerical values or ranges representing an entire population.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3152939				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153385	142			0	sh	            \<item type=\"input\"\>=VARP(A1:A50)\</item\>         				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3153688				0	sh	\<bookmark_value\>VARPA function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3153688				0	sh	VARPA				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149109				0	sh	\<ahelp hid=\"HID_FUNC_VARIANZENA\"\>Calculates the variance based on the entire population. The value of text is 0.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3152880				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149967				0	sh	VARPA(Value1; Value2; ...Value30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149920	214			0	sh	            \<emph\>Value1,value2,...Value30\</emph\> are values or ranges representing an entire population.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3154862				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3156203	216			0	sh	            \<item type=\"input\"\>=VARPA(A1:A50)\</item\>         				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3154599				0	sh	\<bookmark_value\>PERMUT function\</bookmark_value\>         \<bookmark_value\>number of permutations\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3154599				0	sh	PERMUT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154334				0	sh	\<ahelp hid=\"HID_FUNC_VARIATIONEN\"\>Returns the number of permutations for a given number of objects.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3149422				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3148466				0	sh	PERMUT(Count1; Count2)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3148656	148			0	sh	            \<emph\>Count1\</emph\> is the total number of objects.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150826	149			0	sh	            \<emph\>Count2\</emph\> is the number of objects in each permutation.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3153351				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150424	151			0	sh	            \<item type=\"input\"\>=PERMUT(6;3)\</item\> returns 120. There are 120 different possibilities, to pick a sequence of 3 playing cards out of 6 playing cards.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3143276				0	sh	\<bookmark_value\>PERMUTATIONA function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3143276				0	sh	PERMUTATIONA				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3144759				0	sh	\<ahelp hid=\"HID_FUNC_VARIATIONEN2\"\>Returns the number of permutations for a given number of objects (repetition allowed).\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3145598				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149298				0	sh	PERMUTATIONA(Count1; Count2)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3156139	157			0	sh	            \<emph\>Count1\</emph\> is the total number of objects.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149519	158			0	sh	            \<emph\>Count2\</emph\> is the number of objects in each permutation.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3151382				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153949				0	sh	How often can 2 objects be selected from a total of 11 objects?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149233	161			0	sh	            \<item type=\"input\"\>=PERMUTATIONA(11;2)\</item\> returns 121.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150622	162			0	sh	            \<item type=\"input\"\>=PERMUTATIONA(6;3)\</item\> returns 216. There are 216 different possibilities to put a sequence of 3 playing cards together out of six playing cards if every card is returned before the next one is drawn.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3152952				0	sh	\<bookmark_value\>PROB function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3152952				0	sh	PROB				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154110				0	sh	\<ahelp hid=\"HID_FUNC_WAHRSCHBEREICH\"\>Returns the probability that values in a range are between two limits.\</ahelp\> If there is no \<item type=\"literal\"\>End\</item\> value, this function calculates the probability based on the principle that the Data values are equal to the value of \<item type=\"literal\"\>Start\</item\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3146810				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3147330				0	sh	PROB(Data; Probability; Start; End)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154573	168			0	sh	            \<emph\>Data\</emph\> is the array or range of data in the sample.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3156334	169			0	sh	            \<emph\>Probability\</emph\> is the array or range of the corresponding probabilities.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3151107	170			0	sh	            \<emph\>Start\</emph\> is the start value of the interval whose probabilities are to be summed.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153694	171			0	sh	            \<emph\>End\</emph\> (optional) is the end value of the interval whose probabilities are to be summed. If this parameter is missing, the probability for the \<emph\>Start \</emph\>value is calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3147574				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153666	173			0	sh	            \<item type=\"input\"\>=PROB(A1:A50;B1:B50;50;60)\</item\> returns the probability with which a value within the range of A1:A50 is also within the limits between 50 and 60. Every value within the range of A1:A50 has a probability within the range of B1:B50.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3150941				0	sh	\<bookmark_value\>WEIBULL function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3150941				0	sh	WEIBULL				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154916				0	sh	\<ahelp hid=\"HID_FUNC_WEIBULL\"\>Returns the values of the Weibull distribution.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id0305200911372767				0	sh	The Weibull distribution is a continuous probability distribution, with parameters Alpha > 0 (shape) and Beta > 0 (scale). 				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id0305200911372777				0	sh	If C is 0, WEIBULL calculates the probability density function.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id0305200911372743				0	sh	If C is 1, WEIBULL calculates the cumulative distribution function.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3159393				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154478				0	sh	WEIBULL(Number; Alpha; Beta; C)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3151317	179			0	sh	            \<emph\>Number\</emph\> is the value at which to calculate the Weibull distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3158436	180			0	sh	            \<emph\>Alpha \</emph\>is the shape parameter of the Weibull distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154668	181			0	sh	            \<emph\>Beta\</emph\> is the scale parameter of the Weibull distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154825	182			0	sh	            \<emph\>C\</emph\> indicates the type of function.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3153794				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3146077	184			0	sh	            \<item type=\"input\"\>=WEIBULL(2;1;1;1)\</item\> returns 0.86.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id0305200911372899				0	sh	See also the \<link href=\"https://wiki.openoffice.org/wiki/Documentation/How_Tos/Calc:_WEIBULL_function\"\>Wiki page\</link\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\03090000.xhp	0	help	tit				0	sh	Formula Bar				20181231 09:50:43
helpcontent2	source\text\scalc\01\03090000.xhp	0	help	bm_id3147264				0	sh	\<bookmark_value\>formula bar;spreadsheets\</bookmark_value\>\<bookmark_value\>spreadsheets; formula bar\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\03090000.xhp	0	help	hd_id3147264				0	sh	\<link href=\"text/scalc/01/03090000.xhp\" name=\"Formula Bar\"\>Formula Bar\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\03090000.xhp	0	help	par_id3156423				0	sh	\<ahelp hid=\".uno:InputLineVisible\"\>Shows or hides the Formula Bar, which is used for entering and editing formulas.\</ahelp\> The Formula Bar is the most important tool when working with spreadsheets.				20181231 09:50:43
helpcontent2	source\text\scalc\01\03090000.xhp	0	help	par_id3154686				0	sh	To hide the Formula Bar, unmark the menu item.				20181231 09:50:43
helpcontent2	source\text\scalc\01\03090000.xhp	0	help	par_id3145787				0	sh	If the Formula Bar is hidden, you can still edit cells by activating the edit mode with F2. After editing cells, accept the changes by pressing Enter, or discard entries by pressing Esc. Esc is also used to exit the edit mode.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12080300.xhp	0	help	tit				0	sh	Group				20181231 09:50:43
helpcontent2	source\text\scalc\01\12080300.xhp	0	help	hd_id3153088				0	sh	\<link href=\"text/scalc/01/12080300.xhp\" name=\"Group\"\>Group\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12080300.xhp	0	help	par_id3153821				0	sh	\<variable id=\"gruppierung\"\>\<ahelp hid=\".uno:Group\" visibility=\"visible\"\>Defines the selected cell range as a group of rows or columns.\</ahelp\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12080300.xhp	0	help	par_id3145069	3			0	sh	When you group a cell range, and outline icon appears in the margins next to the group. To hide or show the group, click the icon. To ungroup the selection, choose \<emph\>Data – Outline -\</emph\> \<link href=\"text/scalc/01/12080400.xhp\" name=\"Ungroup\"\>\<emph\>Ungroup\</emph\>\</link\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12080300.xhp	0	help	hd_id3125863				0	sh	Include				20181231 09:50:43
helpcontent2	source\text\scalc\01\12080300.xhp	0	help	hd_id3150448				0	sh	Rows				20181231 09:50:43
helpcontent2	source\text\scalc\01\12080300.xhp	0	help	par_id3153194				0	sh	\<ahelp hid=\"HID_SC_GROUP_ROWS\" visibility=\"visible\"\>Groups the selected rows.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12080300.xhp	0	help	hd_id3145786				0	sh	Columns				20181231 09:50:43
helpcontent2	source\text\scalc\01\12080300.xhp	0	help	par_id3146984				0	sh	\<ahelp hid=\"HID_SC_GROUP_COLS\" visibility=\"visible\"\>Groups the selected columns.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04080000.xhp	0	help	tit				0	sh	Function List				20181231 09:50:43
helpcontent2	source\text\scalc\01\04080000.xhp	0	help	bm_id3154126				0	sh	\<bookmark_value\>formula list window\</bookmark_value\>\<bookmark_value\>function list window\</bookmark_value\>\<bookmark_value\>inserting functions; function list window\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04080000.xhp	0	help	hd_id3154126				0	sh	\<link href=\"text/scalc/01/04080000.xhp\" name=\"Function List\"\>Function List\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04080000.xhp	0	help	par_id3151118				0	sh	\<variable id=\"funktionslistetext\"\>\<ahelp hid=\"HID_SC_FUNCTIONLIST\"\>This command opens the \<emph\>Function List\</emph\> window, which displays all functions that can be inserted into your document.\</ahelp\>\</variable\> The \<emph\>Function List\</emph\> window is similar to the \<emph\>Functions\</emph\> tab page of the \<link href=\"text/scalc/01/04060000.xhp\" name=\"Function Wizard\"\>Function Wizard\</link\>. The functions are inserted with placeholders to be replaced with your own values.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04080000.xhp	0	help	par_id3152576				0	sh	The \<emph\>Function List\</emph\> window is a resizable \<link href=\"text/shared/00/00000005.xhp#andocken\" name=\"dockable window\"\>dockable window\</link\>. Use it to quickly enter functions in the spreadsheet. By double-clicking an entry in the functions list, the respective function is directly inserted with all parameters.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04080000.xhp	0	help	hd_id3145799				0	sh	Category List				20181231 09:50:43
helpcontent2	source\text\scalc\01\04080000.xhp	0	help	hd_id3153160				0	sh	Function List				20181231 09:50:43
helpcontent2	source\text\scalc\01\04080000.xhp	0	help	par_id3149412				0	sh	\<ahelp hid=\"SC:LISTBOX:FID_FUNCTION_BOX:LB_FUNC\"\>Displays the available functions.\</ahelp\> When you select a function, the area below the list box displays a short description. To insert the selected function double-click it or click the \<emph\>Insert Function into calculation sheet\</emph\> icon.				20181231 09:50:43
