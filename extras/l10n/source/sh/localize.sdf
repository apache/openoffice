helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3155071				0	sh	\<bookmark_value\>RANK function\</bookmark_value\>         \<bookmark_value\>numbers;determining ranks\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3155071				0	sh	RANK				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153976				0	sh	\<ahelp hid=\"HID_FUNC_RANG\"\>Returns the rank of a number in a sample.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3159206				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153250				0	sh	RANK(Value; Data; Type)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154543	6			0	sh	            \<emph\>Value\</emph\> is the value, whose rank is to be determined.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149130	7			0	sh	            \<emph\>Data\</emph\> is the array or range of data in the sample.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150215	8			0	sh	            \<emph\>Type\</emph\> (optional) is the sequence order.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id9305398				0	sh	Type = 0 means descending from the last item of the array to the first (this is the default), 				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id9996948				0	sh	Type = 1 means ascending from the first item of the range to the last.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3143223				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3155919	10			0	sh	            \<item type=\"input\"\>=RANK(A10;A1:A50)\</item\> returns the ranking of the value in A10 in value range A1:A50. If \<item type=\"literal\"\>Value\</item\> does not exist within the range an error message is displayed.				20181231 09:50:43
