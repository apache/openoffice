helpcontent2	source\text\scalc\01\12090300.xhp	0	help	tit				0	sh	Delete				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090300.xhp	0	help	hd_id3150276				0	sh	\<link href=\"text/scalc/01/12090300.xhp\" name=\"Delete\"\>Delete\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090300.xhp	0	help	par_id3159400				0	sh	\<ahelp hid=\".uno:DeletePivotTable\" visibility=\"visible\"\>Deletes the selected pivot table.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\06130000.xhp	0	help	tit				0	sh	AutoInput				20181231 09:50:43
helpcontent2	source\text\scalc\01\06130000.xhp	0	help	bm_id2486037				0	sh	\<bookmark_value\>entering entries with AutoInput function\</bookmark_value\>\<bookmark_value\>capital letters;AutoInput function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\06130000.xhp	0	help	hd_id3148492				0	sh	\<link href=\"text/scalc/01/06130000.xhp\" name=\"AutoInput\"\>AutoInput\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\06130000.xhp	0	help	par_id3150793				0	sh	\<ahelp hid=\".uno:AutoComplete\"\>Switches the AutoInput function on and off, which automatically completes entries, based on other entries in the same column.\</ahelp\> The column is scanned up to a maximum of 2000 cells or 200 different strings.				20181231 09:50:43
helpcontent2	source\text\scalc\01\06130000.xhp	0	help	par_id3156422				0	sh	The completion text is highlighted.				20181231 09:50:43
helpcontent2	source\text\scalc\01\06130000.xhp	0	help	par_idN1065D				0	sh	To accept the completion, press \<item type=\"keycode\"\>Enter\</item\> or a cursor key.				20181231 09:50:43
helpcontent2	source\text\scalc\01\06130000.xhp	0	help	par_idN10665				0	sh	To append text or to edit the completion, press \<item type=\"keycode\"\>F2\</item\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\06130000.xhp	0	help	par_idN1066D				0	sh	To view more completions, press \<item type=\"keycode\"\>Tab\</item\> to scroll forward, or \<item type=\"keycode\"\>Shift+Tab\</item\> to scroll backward.				20181231 09:50:43
helpcontent2	source\text\scalc\01\06130000.xhp	0	help	par_idN10679				0	sh	To see a list of all available AutoInput text items for the current column, press \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+D.				20181231 09:50:43
helpcontent2	source\text\scalc\01\06130000.xhp	0	help	par_id3150439				0	sh	When typing formulas using characters that match previous entries, a Help tip will appear listing the last ten functions used from \<emph\>Function Wizard\</emph\>, from all defined range names, from all database range names, and from the content of all label ranges.				20181231 09:50:43
helpcontent2	source\text\scalc\01\06130000.xhp	0	help	par_id3153363				0	sh	AutoInput is case-sensitive. If, for example, you have written "Total" in a cell, you cannot enter "total" in another cell of the same column without first deactivating AutoInput.				20181231 09:50:43
helpcontent2	source\text\scalc\01\06030700.xhp	0	help	tit				0	sh	Fill Mode				20181231 09:50:43
helpcontent2	source\text\scalc\01\06030700.xhp	0	help	bm_id3145119				0	sh	\<bookmark_value\>cells; trace fill mode\</bookmark_value\>\<bookmark_value\>traces; precedents for multiple cells\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\06030700.xhp	0	help	hd_id3145119				0	sh	\<link href=\"text/scalc/01/06030700.xhp\" name=\"Fill Mode\"\>Fill Mode\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\06030700.xhp	0	help	par_id3151246				0	sh	\<ahelp hid=\".uno:AuditingFillMode\"\>Activates the Fill Mode in the Detective. The mouse pointer changes to a special symbol, and you can click any cell to see a trace to the precedent cell.\</ahelp\> To exit this mode, press Escape or click the \<emph\>End Fill Mode\</emph\> command in the context menu.				20181231 09:50:43
helpcontent2	source\text\scalc\01\06030700.xhp	0	help	par_id3151211				0	sh	The \<emph\>Fill Mode\</emph\> function is identical to the \<link href=\"text/scalc/01/06030100.xhp\" name=\"Trace Precedent\"\>Trace Precedent\</link\> command if you call this mode for the first time. Use the context menu to select further options for the Fill Mode and to exit this mode.				20181231 09:50:43
helpcontent2	source\text\scalc\01\06031000.xhp	0	help	tit				0	sh	AutoRefresh				20181231 09:50:43
helpcontent2	source\text\scalc\01\06031000.xhp	0	help	bm_id3154515				0	sh	\<bookmark_value\>cells; autorefreshing traces\</bookmark_value\>\<bookmark_value\>traces; autorefreshing\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\06031000.xhp	0	help	hd_id3154515				0	sh	\<link href=\"text/scalc/01/06031000.xhp\" name=\"AutoRefresh\"\>AutoRefresh\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\06031000.xhp	0	help	par_id3147264				0	sh	\<ahelp hid=\".uno:AutoRefreshArrows\" visibility=\"visible\"\>Automatically refreshes all the traces in the sheet whenever you modify a formula.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	tit				0	sh	Mathematical Functions				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3147124				0	sh	\<bookmark_value\>mathematical functions\</bookmark_value\>\<bookmark_value\>Function Wizard; mathematical\</bookmark_value\>\<bookmark_value\>functions; mathematical functions\</bookmark_value\>\<bookmark_value\>trigonometric functions\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3147124				0	sh	Mathematical Functions				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154943				0	sh	\<variable id=\"mathematiktext\"\>This category contains the \<emph\>Mathematical\</emph\> functions for Calc.\</variable\> To open the \<emph\>Function Wizard\</emph\>, choose \<link href=\"text/scalc/01/04060000.xhp\" name=\"Insert - Function\"\>\<emph\>Insert - Function\</emph\>\</link\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3146944				0	sh	\<bookmark_value\>ABS function\</bookmark_value\>\<bookmark_value\>absolute values\</bookmark_value\>\<bookmark_value\>values;absolute\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146944				0	sh	ABS				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154546				0	sh	\<ahelp hid=\"HID_FUNC_ABS\"\>Returns the absolute value of a number.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154843				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147475				0	sh	ABS(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148438				0	sh	\<emph\>Number\</emph\> is the number whose absolute value is to be calculated. The absolute value of a number is its value without the +/- sign.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155823				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152787				0	sh	\<item type=\"input\"\>=ABS(-56)\</item\> returns 56.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148752				0	sh	\<item type=\"input\"\>=ABS(12)\</item\> returns 12.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id320139				0	sh	\<item type=\"input\"\>=ABS(0)\</item\> returns 0.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3150896				0	sh	\<bookmark_value\>COUNTBLANK function\</bookmark_value\>\<bookmark_value\>counting;empty cells\</bookmark_value\>\<bookmark_value\>empty cells;counting\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150896				0	sh	COUNTBLANK				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155260				0	sh	\<ahelp hid=\"HID_FUNC_ANZAHLLEEREZELLEN\"\>Returns the number of empty cells.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145144				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153931				0	sh	COUNTBLANK(Range)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149512				0	sh	 Returns the number of empty cells in the cell range \<emph\>Range\</emph\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146139				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148586				0	sh	\<item type=\"input\"\>=COUNTBLANK(A1:B2)\</item\> returns 4 if cells A1, A2, B1, and B2 are all empty.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3153114				0	sh	\<bookmark_value\>ACOS function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153114				0	sh	ACOS				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145163				0	sh	\<ahelp hid=\"HID_FUNC_ARCCOS\"\>Returns the inverse trigonometric cosine of a number.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153565				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150020				0	sh	ACOS(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159134				0	sh	 This function returns the inverse trigonometric cosine of \<emph\>Number\</emph\>, that is the angle (in radians) whose cosine is Number. The angle returned is between 0 and PI.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id679647				0	sh	To return the angle in degrees, use the DEGREES function.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3149882				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150128				0	sh	\<item type=\"input\"\>=ACOS(-1)\</item\> returns 3.14159265358979 (PI radians)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8792382				0	sh	\<item type=\"input\"\>=DEGREES(ACOS(0.5))\</item\> returns 60. The cosine of 60 degrees is 0.5.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3145355				0	sh	\<bookmark_value\>ACOSH function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145355				0	sh	ACOSH				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157993				0	sh	\<ahelp hid=\"HID_FUNC_ARCOSHYP\"\>Returns the inverse hyperbolic cosine of a number.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145295				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151017				0	sh	ACOSH(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149000	64			0	sh	 This function returns the inverse hyperbolic cosine of \<emph\>Number\</emph\>, that is the number whose hyperbolic cosine is Number. 				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6393932				0	sh	 Number must be greater than or equal to 1.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150566				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145629				0	sh	\<item type=\"input\"\>=ACOSH(1)\</item\> returns 0.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id951567				0	sh	\<item type=\"input\"\>=ACOSH(COSH(4))\</item\> returns 4.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3149027				0	sh	\<bookmark_value\>ACOT function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3149027				0	sh	ACOT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155818				0	sh	\<ahelp hid=\"HID_FUNC_ARCCOT\"\>Returns the inverse cotangent (the arccotangent) of the given number.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153225				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158419				0	sh	ACOT(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154948				0	sh	 This function returns the inverse trigonometric cotangent of \<emph\>Number\</emph\>, that is the angle (in radians) whose cotangent is Number. The angle returned is between 0 and PI.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5834528				0	sh	To return the angle in degrees, use the DEGREES function.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3147538				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155375				0	sh	\<item type=\"input\"\>=ACOT(1)\</item\> returns 0.785398163397448 (PI/4 radians).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8589434				0	sh	\<item type=\"input\"\>=DEGREES(ACOT(1))\</item\> returns 45. The tangent of 45 degrees is 1. 				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3148426				0	sh	\<bookmark_value\>ACOTH function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3148426				0	sh	ACOTH				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147478				0	sh	\<ahelp hid=\"HID_FUNC_ARCOTHYP\"\>Returns the inverse hyperbolic cotangent of the given number.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152585				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147172				0	sh	ACOTH(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146155				0	sh	 This function returns the inverse hyperbolic cotangent of \<emph\>Number\</emph\>, that is the number whose hyperbolic cotangent is Number.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5818659				0	sh	An error results if Number is between -1 and 1 inclusive.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3083452				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150608				0	sh	\<item type=\"input\"\>=ACOTH(1.1)\</item\> returns inverse hyperbolic cotangent of 1.1, approximately 1.52226.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3145084				0	sh	\<bookmark_value\>ASIN function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145084				0	sh	ASIN				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156296				0	sh	\<ahelp hid=\"HID_FUNC_ARCSIN\"\>Returns the inverse trigonometric sine of a number.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3149716				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156305				0	sh	ASIN(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150964				0	sh	 This function returns the inverse trigonometric sine of \<emph\>Number\</emph\>, that is the angle (in radians) whose sine is Number. The angle returned is between -PI/2 and +PI/2.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id203863				0	sh	To return the angle in degrees, use the DEGREES function.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3149448				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156100				0	sh	\<item type=\"input\"\>=ASIN(0)\</item\> returns 0.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6853846				0	sh	\<item type=\"input\"\>=ASIN(1)\</item\> returns 1.5707963267949 (PI/2 radians). 				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8772240				0	sh	\<item type=\"input\"\>=DEGREES(ASIN(0.5))\</item\> returns 30. The sine of 30 degrees is 0.5.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3151266				0	sh	\<bookmark_value\>ASINH function\</bookmark_value\>				20181231 09:50:43
