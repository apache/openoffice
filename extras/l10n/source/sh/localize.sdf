helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11BA1				0	sh	\<item type=\"input\"\>=SUMPRODUCT(A1:B3;C1:D3)\</item\> returns 397.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11BA4				0	sh	Calculation: A1*C1 + B1*D1 + A2*C2 + B2*D2 + A3*C3 + B3*D3				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11BA7				0	sh	You can use SUMPRODUCT to calculate the scalar product of two vectors.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11BBC				0	sh	SUMPRODUCT returns a single number, it is not necessary to enter the function as an array function.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11C91				0	sh	\<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3144842				0	sh	\<bookmark_value\>SUMX2MY2 function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3144842				0	sh	SUMX2MY2				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3144871				0	sh	\<ahelp hid=\"HID_FUNC_SUMMEX2MY2\"\>Returns the sum of the difference of squares of corresponding values in two arrays.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3144889				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3144903				0	sh	SUMX2MY2(ArrayX; ArrayY)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3144916				0	sh	\<emph\>ArrayX\</emph\> represents the first array whose elements are to be squared and added.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3144936				0	sh	\<emph\>ArrayY\</emph\> represents the second array whose elements are to be squared and subtracted.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11D6B				0	sh	\<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3145026				0	sh	\<bookmark_value\>SUMX2PY2 function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3145026				0	sh	SUMX2PY2				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3145055				0	sh	\<ahelp hid=\"HID_FUNC_SUMMEX2PY2\"\>Returns the sum of the sum of squares of corresponding values in two arrays.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3163390				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163404				0	sh	SUMX2PY2(ArrayX; ArrayY)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163417				0	sh	\<emph\>ArrayX\</emph\> represents the first array whose arguments are to be squared and added.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163437				0	sh	\<emph\>ArrayY\</emph\> represents the second array, whose elements are to be squared and added.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11E45				0	sh	\<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3163527				0	sh	\<bookmark_value\>SUMXMY2 function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3163527				0	sh	SUMXMY2				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163556				0	sh	\<ahelp hid=\"HID_FUNC_SUMMEXMY2\"\>Adds the squares of the variance between corresponding values in two arrays.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3163574				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163588				0	sh	SUMXMY2(ArrayX; ArrayY)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163601				0	sh	\<emph\>ArrayX\</emph\> represents the first array whose elements are to be subtracted and squared.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163621				0	sh	\<emph\>ArrayY\</emph\> represents the second array, whose elements are to be subtracted and squared.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11F1F				0	sh	\<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3166062				0	sh	\<bookmark_value\>TREND function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3166062				0	sh	TREND				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166091				0	sh	\<ahelp hid=\"HID_FUNC_TREND\"\>Returns values along a linear trend.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3166109				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166122				0	sh	TREND(DataY; DataX; NewDataX; LinearType)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166137				0	sh	\<emph\>DataY\</emph\> represents the Y Data array.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166156				0	sh	\<emph\>DataX\</emph\> (optional) represents the X Data array.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166176				0	sh	\<emph\>NewDataX\</emph\> (optional) represents the array of the X data, which are used for recalculating values.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166196				0	sh	\<emph\>LinearType\</emph\>(Optional). If LinearType = 0, then lines will be calculated through the zero point. Otherwise, offset lines will also be calculated. The default is LinearType <> 0.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11D2F				0	sh	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN12019				0	sh	\<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3166231				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166245				0	sh	Select a spreadsheet range in which the trend data will appear. Select the function. Enter the output data or select it with the mouse. Mark the \<emph\>Array\</emph\> field. click \<emph\>OK\</emph\>. The trend data calculated from the output data is displayed.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3166317				0	sh	\<bookmark_value\>GROWTH function\</bookmark_value\>\<bookmark_value\>exponential trends in arrays\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3166317				0	sh	GROWTH				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166346				0	sh	\<ahelp hid=\"HID_FUNC_VARIATION\"\>Calculates the points of an exponential trend in an array.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3166364				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166377				0	sh	GROWTH(DataY; DataX; NewDataX; FunctionType)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166392				0	sh	\<emph\>DataY\</emph\> represents the Y Data array.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166411				0	sh	\<emph\>DataX\</emph\> (optional) represents the X Data array.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3173797				0	sh	\<emph\>NewDataX\</emph\> (optional) represents the X data array, in which the values are recalculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3173817				0	sh	\<emph\>FunctionType\</emph\>(optional). If FunctionType = 0, functions in the form y = m^x will be calculated. Otherwise, y = b*m^x functions will be calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11DFD				0	sh	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN12113				0	sh	\<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3173839				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3173852				0	sh	This function returns an array and is handled in the same way as the other array functions. Select a range where you want the answers to appear and select the function. Select DataY. Enter any other parameters, mark \<emph\>Array\</emph\> and click \<emph\>OK\</emph\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04020000.xhp	0	help	tit				0	sh	Insert Cells				20181231 09:50:43
helpcontent2	source\text\scalc\01\04020000.xhp	0	help	bm_id3156023				0	sh	\<bookmark_value\>spreadsheets; inserting cells\</bookmark_value\>\<bookmark_value\>cells; inserting\</bookmark_value\>\<bookmark_value\>inserting; cells\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04020000.xhp	0	help	hd_id3156023				0	sh	 Insert Cells				20181231 09:50:43
helpcontent2	source\text\scalc\01\04020000.xhp	0	help	par_id3150542	2			0	sh	\<variable id=\"zelleneinfuegentext\"\>\<ahelp hid=\".uno:InsertCell\"\>Opens the\<emph\> Insert Cells \</emph\>dialog, in which you can insert new cells according to the options that you specify.\</ahelp\>\</variable\> You can delete cells by choosing \<link href=\"text/scalc/01/02160000.xhp\" name=\"Edit - Delete Cells\"\>\<emph\>Edit - Delete Cells\</emph\>\</link\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04020000.xhp	0	help	hd_id3153768				0	sh	Selection				20181231 09:50:43
helpcontent2	source\text\scalc\01\04020000.xhp	0	help	par_id3149262				0	sh	This area contains the options available for inserting cells into a sheet. The cell quantity and position is defined by selecting a cell range in the sheet beforehand.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04020000.xhp	0	help	hd_id3146120				0	sh	Shift cells down				20181231 09:50:43
helpcontent2	source\text\scalc\01\04020000.xhp	0	help	par_id3152596				0	sh	\<variable id=\"zellenuntentext\"\>\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_INSCELL:BTN_CELLSDOWN\"\>Moves the contents of the selected range downward when cells are inserted.\</ahelp\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04020000.xhp	0	help	hd_id3147434				0	sh	Shift cells right				20181231 09:50:43
helpcontent2	source\text\scalc\01\04020000.xhp	0	help	par_id3144764				0	sh	\<variable id=\"zellenrechtstext\"\>\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_INSCELL:BTN_CELLSRIGHT\"\>Moves the contents of the selected range to the right when cells are inserted.\</ahelp\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04020000.xhp	0	help	hd_id3153877				0	sh	Entire row				20181231 09:50:43
helpcontent2	source\text\scalc\01\04020000.xhp	0	help	par_id3155417				0	sh	\<variable id=\"zeilenganzetext\"\>\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_INSCELL:BTN_INSROWS\"\>Inserts an entire row. The position of the row is determined by the selection on the sheet.\</ahelp\>\</variable\> The number of rows inserted depends on how many rows are selected. The contents of the original rows are moved downward.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04020000.xhp	0	help	hd_id3146971				0	sh	Entire column				20181231 09:50:43
helpcontent2	source\text\scalc\01\04020000.xhp	0	help	par_id3155068				0	sh	\<variable id=\"spaltenganzetext\"\>\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_INSCELL:BTN_INSCOLS\"\>Inserts an entire column. The number of columns to be inserted is determined by the selected number of columns.\</ahelp\>\</variable\> The contents of the original columns are shifted to the right.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	tit				0	sh	Spreadsheet Functions				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3148522				0	sh	\<bookmark_value\>spreadsheets; functions\</bookmark_value\>      \<bookmark_value\>Function Wizard; spreadsheets\</bookmark_value\>      \<bookmark_value\>functions; spreadsheets\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3148522				0	sh	Spreadsheet Functions				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3144508				0	sh	\<variable id=\"tabelletext\"\>This section contains descriptions of the \<emph\>Spreadsheet\</emph\> functions together with an example.\</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3146968				0	sh	\<bookmark_value\>ADDRESS function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3146968				0	sh	ADDRESS				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155762				0	sh	\<ahelp hid=\"HID_FUNC_ADRESSE\"\>Returns a cell address (reference) as text, according to the specified row and column numbers.\</ahelp\> You can determine whether the address is interpreted as an absolute address (for example, $A$1) or as a relative address (as A1) or in a mixed form (A$1 or $A1). You can also specify the name of the sheet.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301348				0	sh	For interoperability the ADDRESS and INDIRECT functions support an optional parameter to specify whether the R1C1 address notation instead of the usual A1 notation should be used.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301445				0	sh	In ADDRESS, the parameter is inserted as the fourth parameter, shifting the optional sheet name parameter to the fifth position.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id102720080230153				0	sh	In INDIRECT, the parameter is appended as the second parameter.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id102720080230151				0	sh	In both functions, if the argument is inserted with the value 0, then the R1C1 notation is used. If the argument is not given or has a value other than 0, then the A1 notation is used. 				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301556				0	sh	In case of R1C1 notation, ADDRESS returns address strings using the exclamation mark '!' as the sheet name separator, and INDIRECT expects the exclamation mark as sheet name separator. Both functions still use the dot '.' sheet name separator with A1 notation.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301521				0	sh	When opening documents from ODF 1.0/1.1 format, the ADDRESS functions that show a sheet name as the fourth paramater will shift that sheet name to become the fifth parameter. A new fourth parameter with the value 1 will be inserted.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301650				0	sh	When storing a document in ODF 1.0/1.1 format, if ADDRESS functions have a fourth parameter, that parameter will be removed.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id102720080230162				0	sh	Do not save a spreadsheet in the old ODF 1.0/1.1 format if the ADDRESS function's new fourth parameter was used with a value of 0.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301756				0	sh	The INDIRECT function is saved without conversion to ODF 1.0/1.1 format. If the second parameter was present, an older version of Calc will return an error for that function.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3151196				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154707				0	sh	ADDRESS(Row; Column; Abs; A1; "Sheet")				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147505	7			0	sh	            \<emph\>Row\</emph\> represents the row number for the cell reference				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3145323	8			0	sh	            \<emph\>Column\</emph\> represents the column number for the cell reference (the number, not the letter)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153074	9			0	sh	            \<emph\>Abs\</emph\> determines the type of reference:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153298				0	sh	1: absolute ($A$1)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150431				0	sh	2: row reference type is absolute; column reference is relative (A$1)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3146096				0	sh	3: row (relative); column (absolute) ($A1)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153334				0	sh	4: relative (A1)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802465915				0	sh	            \<emph\>A1\</emph\> (optional) - if set to 0, the R1C1 notation is used. If this parameter is absent or set to another value than 0, the A1 notation is used.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153962	14			0	sh	            \<emph\>Sheet\</emph\> represents the name of the sheet. It must be placed in double quotes.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3147299				0	sh	Example:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148744	16			0	sh	            \<item type=\"input\"\>=ADDRESS(1;1;2;;"Sheet2")\</item\> returns the following: Sheet2.A$1				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3159260				0	sh	If the cell A1 in sheet 2 contains the value \<item type=\"input\"\>-6\</item\>, you can refer indirectly to the referenced cell using a function in B2 by entering \<item type=\"input\"\>=ABS(INDIRECT(B2))\</item\>. The result is the absolute value of the cell reference specified in B2, which in this case is 6.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3150372				0	sh	\<bookmark_value\>AREAS function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3150372				0	sh	AREAS				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150036				0	sh	\<ahelp hid=\"HID_FUNC_BEREICHE\"\>Returns the number of individual ranges that belong to a multiple range.\</ahelp\> A range can consist of contiguous cells or a single cell.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id061020090307073				0	sh	The function expects a single argument. If you state multiple ranges, you must enclose them into additional parentheses. Multiple ranges can be entered using the semicolon (;) as divider, but this gets automatically converted to the tilde (~) operator. The tilde is used to join ranges.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3145222				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155907				0	sh	AREAS(Reference)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153118				0	sh	Reference represents the reference to a cell or cell range.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3148891				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149946	25			0	sh	            \<item type=\"input\"\>=AREAS((A1:B3;F2;G1))\</item\> returns 3, as it is a reference to three cells and/or areas. After entry this gets converted to =AREAS((A1:B3~F2~G1)).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3146820	26			0	sh	            \<item type=\"input\"\>=AREAS(All)\</item\> returns 1 if you have defined an area named All under \<emph\>Data - Define Range\</emph\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3148727				0	sh	\<bookmark_value\>DDE function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3148727				0	sh	DDE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149434				0	sh	\<ahelp hid=\"HID_FUNC_DDE\"\>Returns the result of a DDE-based link.\</ahelp\> If the contents of the linked range or section changes, the returned value will also change. You must reload the spreadsheet or choose \<emph\>Edit - Links\</emph\> to see the updated links. Cross-platform links, for example from a \<item type=\"productname\"\>%PRODUCTNAME\</item\> installation running on a Windows machine to a document created on a Linux machine, are not allowed.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3150700				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148886				0	sh	DDE("Server"; "File"; "Range"; Mode)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154842	32			0	sh	            \<emph\>Server\</emph\> is the name of a server application. \<item type=\"productname\"\>%PRODUCTNAME\</item\>applications have the server name "Soffice".				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153034	33			0	sh	            \<emph\>File\</emph\> is the complete file name, including path specification.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147472	34			0	sh	            \<emph\>Range\</emph\> is the area containing the data to be evaluated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3152773	184			0	sh	            \<emph\>Mode\</emph\> is an optional parameter that controls the method by which the DDE server converts its data into numbers.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154383	185			0	sh	                     \<emph\>Mode\</emph\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3145146	186			0	sh	                     \<emph\>Effect\</emph\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154558				0	sh	0 or missing				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3145596				0	sh	Number format from the "Default" cell style				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3152785				0	sh	1				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154380				0	sh	Data are always interpreted in the standard format for US English				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150279				0	sh	2				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153775				0	sh	Data are retrieved as text; no conversion to numbers				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3149546				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148734	36			0	sh	            \<item type=\"input\"\>=DDE("soffice";"c:\\office\\document\\data1.sxc";"sheet1.A1")\</item\> reads the contents of cell A1 in sheet1 of the \<item type=\"productname\"\>%PRODUCTNAME\</item\> Calc spreadsheet data1.sxc.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153081	37			0	sh	            \<item type=\"input\"\>=DDE("soffice";"c:\\office\\document\\motto.sxw";"Today's motto")\</item\> returns a motto in the cell containing this formula. First, you must enter a line in the motto.sxw document containing the motto text and define it as the first line of a section named \<item type=\"literal\"\>Today's Motto\</item\> (in \<item type=\"productname\"\>%PRODUCTNAME\</item\> Writer under \<emph\>Insert - Section\</emph\>). If the motto is modified (and saved) in the \<item type=\"productname\"\>%PRODUCTNAME\</item\> Writer document, the motto is updated in all \<item type=\"productname\"\>%PRODUCTNAME\</item\> Calc cells in which this DDE link is defined.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3153114				0	sh	\<bookmark_value\>ERRORTYPE function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153114				0	sh	ERRORTYPE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148568				0	sh	\<ahelp hid=\"HID_FUNC_FEHLERTYP\"\>Returns the number corresponding to an \<link href=\"text/scalc/05/02140000.xhp\" name=\"error value\"\>error value\</link\> occurring in a different cell.\</ahelp\> With the aid of this number, you can generate an error message text.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149877				0	sh	The Status Bar displays the predefined error code from \<item type=\"productname\"\>%PRODUCTNAME\</item\> if you click the cell containing the error.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3154327				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3151322				0	sh	ERRORTYPE(Reference)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150132	43			0	sh	            \<emph\>Reference\</emph\> contains the address of the cell in which the error occurs.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3145248				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3146904				0	sh	If cell A1 displays Err:518, the function \<item type=\"input\"\>=ERRORTYPE(A1)\</item\> returns the number 518.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3151221				0	sh	\<bookmark_value\>INDEX function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3151221				0	sh	INDEX				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150268				0	sh	\<ahelp hid=\"HID_FUNC_INDEX\"\>INDEX returns a sub range, specified by row and column number, or an optional range index. Depending on context, INDEX returns a reference or content.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3156063				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149007				0	sh	INDEX(Reference; Row; Column; Range)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153260	51			0	sh	            \<emph\>Reference\</emph\> is a reference, entered either directly or by specifying a range name. If the reference consists of multiple ranges, you must enclose the reference or range name in parentheses.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3145302	52			0	sh	            \<emph\>Row\</emph\> (optional) represents the row index of the reference range, for which to return a value. In case of zero (no specific row) all referenced rows are returned.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154628	53			0	sh	            \<emph\>Column\</emph\> (optional) represents the column index of the reference range, for which to return a value. In case of zero (no specific column) all referenced columns are returned.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155514	54			0	sh	            \<emph\>Range\</emph\> (optional) represents the index of the subrange if referring to a multiple range.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3145264				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3159112	56			0	sh	            \<item type=\"input\"\>=INDEX(Prices;4;1)\</item\> returns the value from row 4 and column 1 of the database range defined in \<emph\>Data - Define\</emph\> as \<emph\>Prices\</emph\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150691	57			0	sh	            \<item type=\"input\"\>=INDEX(SumX;4;1)\</item\> returns the value from the range \<emph\>SumX\</emph\> in row 4 and column 1 as defined in \<emph\>Insert - Names - Define\</emph\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id4109012				0	sh	            \<item type=\"input\"\>=INDEX(A1:B6;1)\</item\> returns a reference to the first row of A1:B6.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id9272133				0	sh	            \<item type=\"input\"\>=INDEX(A1:B6;0;1)\</item\> returns a reference to the first column of A1:B6.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3158419	58			0	sh	            \<item type=\"input\"\>=INDEX((multi);4;1)\</item\> indicates the value contained in row 4 and column 1 of the (multiple) range, which you named under \<emph\>Insert - Names - Set\</emph\> as \<emph\>multi\</emph\>. The multiple range may consist of several rectangular ranges, each with a row 4 and column 1. If you now want to call the second block of this multiple range enter the number \<item type=\"input\"\>2\</item\> as the \<emph\>range\</emph\> parameter.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148595	59			0	sh	            \<item type=\"input\"\>=INDEX(A1:B6;1;1)\</item\> indicates the value in the upper-left of the A1:B6 range.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id9960020				0	sh	            \<item type=\"input\"\>=INDEX((multi);0;0;2)\</item\> returns a reference to the second range of the multiple range.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3153181				0	sh	\<bookmark_value\>INDIRECT function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153181				0	sh	INDIRECT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147169				0	sh	\<ahelp hid=\"HID_FUNC_INDIREKT\"\>Returns the \<emph\>reference\</emph\> specified by a text string.\</ahelp\> This function can also be used to return the area of a corresponding string.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153717				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149824				0	sh	INDIRECT(Ref; A1)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154317	66			0	sh	            \<emph\>Ref\</emph\> represents a reference to a cell or an area (in text form) for which to return the contents.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802470312				0	sh	            \<emph\>A1\</emph\> (optional) - if set to 0, the R1C1 notation is used. If this parameter is absent or set to another value than 0, the A1 notation is used.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN10CAE				0	sh	If you open an Excel spreadsheet that uses indirect addresses calculated from string functions, the sheet addresses will not be translated automatically. For example, the Excel address in INDIRECT("filename!sheetname"&B1) is not converted into the Calc address in INDIRECT("filename.sheetname"&B1).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3150389				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150608	68			0	sh	            \<item type=\"input\"\>=INDIRECT(A1)\</item\> equals 100 if A1 contains C108 as a reference and cell C108 contains a value of \<item type=\"input\"\>100\</item\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3083286	181			0	sh	            \<item type=\"input\"\>=SUM(INDIRECT("a1:" & ADDRESS(1;3)))\</item\> totals the cells in the area of A1 up to the cell with the address defined by row 1 and column 3. This means that area A1:C1 is totaled.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3154818				0	sh	\<bookmark_value\>COLUMN function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3154818				0	sh	COLUMN				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149711				0	sh	\<ahelp hid=\"HID_FUNC_SPALTE\"\>Returns the column number of a cell reference.\</ahelp\> If the reference is a cell the column number of the cell is returned; if the parameter is a cell area, the corresponding column numbers are returned in a single-row \<link href=\"text/scalc/01/04060107.xhp#wasmatrix\" name=\"array\"\>array\</link\> if the formula is entered \<link href=\"text/scalc/01/04060107.xhp#somatrixformel\" name=\"as an array formula\"\>as an array formula\</link\>. If the COLUMN function with an area reference parameter is not used for an array formula, only the column number of the first cell within the area is determined.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3149283				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149447				0	sh	COLUMN(Reference)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3156310	74			0	sh	            \<emph\>Reference\</emph\> is the reference to a cell or cell area whose first column number is to be found.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155837				0	sh	If no reference is entered, the column number of the cell in which the formula is entered is found. \<item type=\"productname\"\>%PRODUCTNAME\</item\> Calc automatically sets the reference to the current cell.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3152932				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147571	76			0	sh	            \<item type=\"input\"\>=COLUMN(A1)\</item\> equals 1. Column A is the first column in the table.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147079	77			0	sh	            \<item type=\"input\"\>=COLUMN(C3:E3)\</item\> equals 3. Column C is the third column in the table.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3146861	195			0	sh	            \<item type=\"input\"\>=COLUMN(D3:G10)\</item\> returns 4 because column D is the fourth column in the table and the COLUMN function is not used as an array formula. (In this case, the first value of the array is always used as the result.)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3156320	196			0	sh	            \<item type=\"input\"\>{=COLUMN(B2:B7)}\</item\> and \<item type=\"input\"\>=COLUMN(B2:B7)\</item\> both return 2 because the reference only contains column B as the second column in the table. Because single-column areas have only one column number, it does not make a difference whether or not the formula is used as an array formula.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150872	197			0	sh	            \<item type=\"input\"\>=COLUMN()\</item\> returns 3 if the formula was entered in column C.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153277	198			0	sh	            \<item type=\"input\"\>{=COLUMN(Rabbit)}\</item\> returns the single-row array (3, 4) if "Rabbit" is the named area (C1:D3).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3154643				0	sh	\<bookmark_value\>COLUMNS function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3154643				0	sh	COLUMNS				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3151182				0	sh	\<ahelp hid=\"HID_FUNC_SPALTEN\"\>Returns the number of columns in the given reference.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3149141				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154047				0	sh	COLUMNS(Array)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154745	83			0	sh	            \<emph\>Array\</emph\> is the reference to a cell range whose total number of columns is to be found. The argument can also be a single cell.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153622				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149577	200			0	sh	            \<item type=\"input\"\>=COLUMNS(B5)\</item\> returns 1 because a cell only contains one column.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3145649	85			0	sh	            \<item type=\"input\"\>=COLUMNS(A1:C5)\</item\> equals 3. The reference comprises three columns.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155846	201			0	sh	            \<item type=\"input\"\>=COLUMNS(Rabbit)\</item\> returns 2 if \<item type=\"literal\"\>Rabbit\</item\> is the named range (C1:D3).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3153152				0	sh	\<bookmark_value\>vertical search function\</bookmark_value\>         \<bookmark_value\>VLOOKUP function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153152				0	sh	VLOOKUP				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149984				0	sh	\<ahelp hid=\"HID_FUNC_SVERWEIS\"\>Vertical search with reference to adjacent cells to the right.\</ahelp\> This function checks if a specific value is contained in the first column of an array. The function then returns the value in the same row of the column named by \<item type=\"literal\"\>Index\</item\>. If the \<item type=\"literal\"\>SortOrder\</item\> parameter is omitted or set to TRUE or one, it is assumed that the data is sorted in ascending order. In this case, if the exact \<item type=\"literal\"\>SearchCriterion\</item\> is not found, the last value that is smaller than the criterion will be returned. If \<item type=\"literal\"\>SortOrder\</item\> is set to FALSE or zero, an exact match must be found, otherwise the error \<emph\>Error: Value Not Available\</emph\> will be the result. Thus with a value of zero the data does not need to be sorted in ascending order.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3146898				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150156				0	sh	=VLOOKUP(SearchCriterion; Array; Index; SortOrder)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149289	91			0	sh	            \<emph\>SearchCriterion\</emph\> is the value searched for in the first column of the array.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153884	92			0	sh	            \<emph\>Array\</emph\> is the reference, which is to comprise at least two columns.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3156005	93			0	sh	            \<emph\>Index\</emph\> is the number of the column in the array that contains the value to be returned. The first column has the number 1.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3151208	94			0	sh	            \<emph\>SortOrder\</emph\> is an optional parameter that indicates whether the first column in the array is sorted in ascending order. Enter the Boolean value FALSE or zero if the first column is not sorted in ascending order. Sorted columns can be searched much faster and the function always returns a value, even if the search value was not matched exactly, if it is between the lowest and highest value of the sorted list. In unsorted lists, the search value must be matched exactly. Otherwise the function will return this message: \<emph\>Error: Value Not Available\</emph\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3147487				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154129				0	sh	You want to enter the number of a dish on the menu in cell A1, and the name of the dish is to appear as text in the neighboring cell (B1) immediately. The Number to Name assignment is contained in the D1:E100 array. D1 contains \<item type=\"input\"\>100\</item\>, E1 contains the name \<item type=\"input\"\>Vegetable Soup\</item\>, and so forth, for 100 menu items. The numbers in column D are sorted in ascending order; thus, the optional \<item type=\"literal\"\>SortOrder\</item\> parameter is not necessary.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3145663				0	sh	Enter the following formula in B1:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3151172	98			0	sh	            \<item type=\"input\"\>=VLOOKUP(A1;D1:E100;2)\</item\>         				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149200				0	sh	As soon as you enter a number in A1 B1 will show the corresponding text contained in the second column of reference D1:E100. Entering a nonexistent number displays the text with the next number down. To prevent this, enter FALSE as the last parameter in the formula so that an error message is generated when a nonexistent number is entered.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3153905				0	sh	\<bookmark_value\>sheet numbers; looking up\</bookmark_value\>         \<bookmark_value\>SHEET function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153905				0	sh	SHEET				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150309				0	sh	\<ahelp hid=\"HID_FUNC_TABELLE\"\>Returns the sheet number of a reference or a string representing a sheet name.\</ahelp\> If you do not enter any parameters, the result is the sheet number of the spreadsheet containing the formula.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3148564				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153095				0	sh	SHEET(Reference)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154588	219			0	sh	            \<emph\>Reference\</emph\> is optional and is the reference to a cell, an area, or a sheet name string.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3155399				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3146988	221			0	sh	            \<item type=\"input\"\>=SHEET(Sheet2.A1)\</item\> returns 2 if Sheet2 is the second sheet in the spreadsheet document.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3148829				0	sh	\<bookmark_value\>number of sheets; function\</bookmark_value\>         \<bookmark_value\>SHEETS function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3148829				0	sh	SHEETS				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148820				0	sh	\<ahelp hid=\"HID_FUNC_TABELLEN\"\>Determines the number of sheets in a reference.\</ahelp\> If you do not enter any parameters, it returns the number of sheets in the current document.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3154220				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150777				0	sh	SHEETS(Reference)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153060	226			0	sh	            \<emph\>Reference\</emph\> is the reference to a sheet or an area. This parameter is optional.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3149766				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150507	228			0	sh	            \<item type=\"input\"\>=SHEETS(Sheet1.A1:Sheet3.G12)\</item\> returns 3 if Sheet1, Sheet2, and Sheet3 exist in the sequence indicated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3158407				0	sh	\<bookmark_value\>MATCH function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3158407				0	sh	MATCH				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154896				0	sh	\<ahelp hid=\"HID_FUNC_VERGLEICH\"\>Returns the relative position of an item in an array that matches a specified value.\</ahelp\> The function returns the position of the value found in the lookup_array as a number.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153834				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3159152				0	sh	MATCH(SearchCriterion; LookupArray; Type)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149336	105			0	sh	            \<emph\>SearchCriterion\</emph\> is the value which is to be searched for in the single-row or single-column array.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3159167	106			0	sh	            \<emph\>LookupArray\</emph\> is the reference searched. A lookup array can be a single row or column, or part of a single row or column.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147239	107			0	sh	            \<emph\>Type\</emph\> may take the values 1, 0, or -1. If Type = 1 or if this optional parameter is missing, it is assumed that the first column of the search array is sorted in ascending order. If Type = -1 it is assumed that the column in sorted in descending order. This corresponds to the same function in Microsoft Excel.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154265				0	sh	If Type = 0, only exact matches are found. If the search criterion is found more than once, the function returns the index of the first matching value. Only if Type = 0 can you search for regular expressions.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147528				0	sh	If Type = 1 or the third parameter is missing, the index of the last value that is smaller or equal to the search criterion is returned. This applies even when the search array is not sorted. For Type = -1, the first value that is larger or equal is returned.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3155119				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155343	109			0	sh	            \<item type=\"input\"\>=MATCH(200;D1:D100)\</item\> searches the area D1:D100, which is sorted by column D, for the value 200. As soon as this value is reached, the number of the row in which it was found is returned. If a higher value is found during the search in the column, the number of the previous row is returned.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3158430				0	sh	\<bookmark_value\>OFFSET function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3158430				0	sh	OFFSET				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149167				0	sh	\<ahelp hid=\"HID_FUNC_VERSCHIEBUNG\"\>Returns the value of a cell offset by a certain number of rows and columns from a given reference point.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3146952				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3159194				0	sh	OFFSET(Reference; Rows; Columns; Height; Width)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3152360	115			0	sh	            \<emph\>Reference\</emph\> is the reference from which the function searches for the new reference.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3156032	116			0	sh	            \<emph\>Rows\</emph\> is the number of rows by which the reference was corrected up (negative value) or down.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3166458	117			0	sh	            \<emph\>Columns\</emph\> (optional) is the number of columns by which the reference was corrected to the left (negative value) or to the right.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150708	118			0	sh	            \<emph\>Height\</emph\> (optional) is the vertical height for an area that starts at the new reference position.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147278	119			0	sh	            \<emph\>Width\</emph\> (optional) is the horizontal width for an area that starts at the new reference position.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id8662373				0	sh	Arguments \<emph\>Rows\</emph\> and \<emph\>Columns\</emph\> must not lead to zero or negative start row or column.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id9051484				0	sh	Arguments \<emph\>Height\</emph\> and \<emph\>Width\</emph\> must not lead to zero or negative count of rows or columns.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN1104B				0	sh	            \<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>         				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3155586				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149744	121			0	sh	            \<item type=\"input\"\>=OFFSET(A1;2;2)\</item\> returns the value in cell C3 (A1 moved by two rows and two columns down). If C3 contains the value \<item type=\"input\"\>100\</item\> this function returns the value 100.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id7439802				0	sh	            \<item type=\"input\"\>=OFFSET(B2:C3;1;1)\</item\> returns a reference to B2:C3 moved down by 1 row and one column to the right (C3:D4).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3009430				0	sh	            \<item type=\"input\"\>=OFFSET(B2:C3;-1;-1)\</item\> returns a reference to B2:C3 moved up by 1 row and one column to the left (A1:B2).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id2629169				0	sh	            \<item type=\"input\"\>=OFFSET(B2:C3;0;0;3;4)\</item\> returns a reference to B2:C3 resized to 3 rows and 4 columns (B2:E4).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id6668599				0	sh	            \<item type=\"input\"\>=OFFSET(B2:C3;1;0;3;4)\</item\> returns a reference to B2:C3 moved down by one row resized to 3 rows and 4 columns (B2:E4).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153739	122			0	sh	            \<item type=\"input\"\>=SUM(OFFSET(A1;2;2;5;6))\</item\> determines the total of the area that starts in cell C3 and has a height of 5 rows and a width of 6 columns (area=C3:H7).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3159273				0	sh	\<bookmark_value\>LOOKUP function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3159273				0	sh	LOOKUP				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153389				0	sh	\<ahelp hid=\"HID_FUNC_VERWEIS\"\>Returns the contents of a cell either from a one-row or one-column range.\</ahelp\> Optionally, the assigned value (of the same index) is returned in a different column and row. As opposed to \<link href=\"text/scalc/01/04060109.xhp\" name=\"VLOOKUP\"\>VLOOKUP\</link\> and \<link href=\"text/scalc/01/04060109.xhp\" name=\"HLOOKUP\"\>HLOOKUP\</link\>, search and result vector may be at different positions; they do not have to be adjacent. Additionally, the search vector for the LOOKUP must be sorted ascending, otherwise the search will not return any usable results.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id4484084				0	sh	If LOOKUP cannot find the search criterion, it matches the largest value in the search vector that is less than or equal to the search criterion.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3152947				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154104				0	sh	LOOKUP(SearchCriterion; SearchVector; ResultVector)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150646	127			0	sh	            \<emph\>SearchCriterion\</emph\> is the value to be searched for; entered either directly or as a reference.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154854	128			0	sh	            \<emph\>SearchVector\</emph\> is the single-row or single-column area to be searched.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149925	129			0	sh	            \<emph\>ResultVector\</emph\> is another single-row or single-column range from which the result of the function is taken. The result is the cell of the result vector with the same index as the instance found in the search vector.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3148624				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149809	131			0	sh	            \<item type=\"input\"\>=LOOKUP(A1;D1:D100;F1:F100)\</item\> searches the corresponding cell in range D1:D100 for the number you entered in A1. For the instance found, the index is determined, for example, the 12th cell in this range. Then, the contents of the 12th cell are returned as the value of the function (in the result vector).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3149425				0	sh	\<bookmark_value\>STYLE function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3149425				0	sh	STYLE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150826				0	sh	\<ahelp hid=\"HID_FUNC_VORLAGE\"\>Applies a style to the cell containing the formula.\</ahelp\> After a set amount of time, another style can be applied. This function always returns the value 0, allowing you to add it to another function without changing the value. Together with the CURRENT function you can apply a color to a cell regardless of the value. For example: =...+STYLE(IF(CURRENT()>3;"red";"green")) applies the style "red" to the cell if the value is greater than 3, otherwise the style "green" is applied. Both cell formats have to be defined beforehand.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3145373				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149302				0	sh	STYLE("Style"; Time; "Style2")				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150596	137			0	sh	            \<emph\>Style\</emph\> is the name of a cell style assigned to the cell. Style names must be entered in quotation marks.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3156149	138			0	sh	            \<emph\>Time\</emph\> is an optional time range in seconds. If this parameter is missing the style will not be changed after a certain amount of time has passed.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149520	139			0	sh	            \<emph\>Style2\</emph\> is the optional name of a cell style assigned to the cell after a certain amount of time has passed. If this parameter is missing "Default" is assumed.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN111CA				0	sh	            \<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>         				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3159254				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3151374	141			0	sh	            \<item type=\"input\"\>=STYLE("Invisible";60;"Default")\</item\> formats the cell in transparent format for 60 seconds after the document was recalculated or loaded, then the Default format is assigned. Both cell formats have to be defined beforehand.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id8056886				0	sh	Since STYLE() has a numeric return value of zero, this return value gets appended to a string. This can be avoided using T() as in the following example 				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3668935				0	sh	            \<item type=\"input\"\>="Text"&T(STYLE("myStyle"))\</item\>         				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3042085				0	sh	See also CURRENT() for another example.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3150430				0	sh	\<bookmark_value\>CHOOSE function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3150430				0	sh	CHOOSE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3143270				0	sh	\<ahelp hid=\"HID_FUNC_WAHL\"\>Uses an index to return a value from a list of up to 30 values.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153533				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155425				0	sh	CHOOSE(Index; Value1; ...; Value30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3144755	146			0	sh	            \<emph\>Index\</emph\> is a reference or number between 1 and 30 indicating which value is to be taken from the list.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149939	147			0	sh	            \<emph\>Value1...Value30\</emph\> is the list of values entered as a reference to a cell or as individual values.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3151253				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150625	149			0	sh	            \<item type=\"input\"\>=CHOOSE(A1;B1;B2;B3;"Today";"Yesterday";"Tomorrow")\</item\>, for example, returns the contents of cell B2 for A1 = 2; for A1 = 4, the function returns the text "Today".				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3151001				0	sh	\<bookmark_value\>HLOOKUP function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3151001				0	sh	HLOOKUP				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148688				0	sh	\<ahelp hid=\"HID_FUNC_WVERWEIS\"\>Searches for a value and reference to the cells below the selected area.\</ahelp\> This function verifies if the first row of an array contains a certain value. The function returns then the value in a row of the array, named in the \<emph\>Index\</emph\>, in the same column.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3154661				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3146070				0	sh	HLOOKUP(SearchCriteria; Array; Index; Sorted)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148672				0	sh	See also:\<link href=\"text/scalc/01/04060109.xhp\" name=\"VLOOKUP\"\>VLOOKUP\</link\> (columns and rows are exchanged)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3147321				0	sh	\<bookmark_value\>ROW function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3147321				0	sh	ROW				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154564				0	sh	\<ahelp hid=\"HID_FUNC_ZEILE\"\>Returns the row number of a cell reference.\</ahelp\> If the reference is a cell, it returns the row number of the cell. If the reference is a cell range, it returns the corresponding row numbers in a one-column \<link href=\"text/scalc/01/04060107.xhp#wasmatrix\" name=\"Array\"\>Array\</link\> if the formula is entered \<link href=\"text/scalc/01/04060107.xhp#somatrixformel\" name=\"as an array formula\"\>as an array formula\</link\>. If the ROW function with a range reference is not used in an array formula, only the row number of the first range cell will be returned.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3158439				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154916				0	sh	ROW(Reference)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3156336	161			0	sh	            \<emph\>Reference\</emph\> is a cell, an area, or the name of an area.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3151109				0	sh	If you do not indicate a reference, the row number of the cell in which the formula is entered will be found. \<item type=\"productname\"\>%PRODUCTNAME\</item\> Calc automatically sets the reference to the current cell.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3155609				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154830	205			0	sh	            \<item type=\"input\"\>=ROW(B3)\</item\> returns 3 because the reference refers to the third row in the table.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147094	206			0	sh	            \<item type=\"input\"\>{=ROW(D5:D8)}\</item\> returns the single-column array (5, 6, 7, 8) because the reference specified contains rows 5 through 8.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153701	207			0	sh	            \<item type=\"input\"\>=ROW(D5:D8)\</item\> returns 5 because the ROW function is not used as array formula and only the number of the first row of the reference is returned.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150996	208			0	sh	            \<item type=\"input\"\>{=ROW(A1:E1)}\</item\> and \<item type=\"input\"\>=ROW(A1:E1)\</item\> both return 1 because the reference only contains row 1 as the first row in the table. (Because single-row areas only have one row number it does not make any difference whether or not the formula is used as an array formula.)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153671	209			0	sh	            \<item type=\"input\"\>=ROW()\</item\> returns 3 if the formula was entered in row 3.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153790	210			0	sh	            \<item type=\"input\"\>{=ROW(Rabbit)}\</item\> returns the single-column array (1, 2, 3) if "Rabbit" is the named area (C1:D3).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3145772				0	sh	\<bookmark_value\>ROWS function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3145772				0	sh	ROWS				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148971				0	sh	\<ahelp hid=\"HID_FUNC_ZEILEN\"\>Returns the number of rows in a reference or array.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3156051				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154357				0	sh	ROWS(Array)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155942	170			0	sh	            \<emph\>Array\</emph\> is the reference or named area whose total number of rows is to be determined.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3155869				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154725	212			0	sh	            \<item type=\"input\"\>=Rows(B5)\</item\> returns 1 because a cell only contains one row.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150102	172			0	sh	            \<item type=\"input\"\>=ROWS(A10:B12)\</item\> returns 3.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155143	213			0	sh	            \<item type=\"input\"\>=ROWS(Rabbit)\</item\> returns 3 if "Rabbit" is the named area (C1:D3).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id9959410				0	sh	\<bookmark_value\>HYPERLINK function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11798				0	sh	HYPERLINK				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN117F1				0	sh	\<ahelp hid=\"HID_FUNC_HYPERLINK\"\>When you click a cell that contains the HYPERLINK function, the hyperlink opens.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11800				0	sh	If you use the optional \<emph\>CellText\</emph\> parameter, the formula locates the URL, and then displays the text or number.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11803				0	sh	To open a hyperlinked cell with the keyboard, select the cell, press F2 to enter the Edit mode, move the cursor in front of the hyperlink, press Shift+F10, and then choose \<emph\>Open Hyperlink\</emph\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN1180A				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN1180E				0	sh	HYPERLINK("URL") or HYPERLINK("URL"; "CellText")				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11811				0	sh	            \<emph\>URL\</emph\> specifies the link target. The optional \<emph\>CellText\</emph\> parameter is the text or a number that is displayed in the cell and will be returned as the result. If the \<emph\>CellText\</emph\> parameter is not specified, the \<emph\>URL\</emph\> is displayed in the cell text and will be returned as the result.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id0907200912224576				0	sh	The number 0 is returned for empty cells and matrix elements.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11823				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11827				0	sh	            \<item type=\"input\"\>=HYPERLINK("http://www.example.org")\</item\> displays the text "http://www.example.org" in the cell and executes the hyperlink http://www.example.org when clicked.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN1182A				0	sh	            \<item type=\"input\"\>=HYPERLINK("http://www.example.org";"Click here")\</item\> displays the text "Click here" in the cell and executes the hyperlink http://www.example.org when clicked.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id0907200912224534				0	sh	=HYPERLINK("http://www.example.org";12345) displays the number 12345 and executes the hyperlink http://www.example.org when clicked.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN1182D				0	sh	            \<item type=\"input\"\>=HYPERLINK($B4)\</item\> where cell B4 contains \<item type=\"input\"\>http://www.example.org\</item\>. The function adds http://www.example.org to the URL of the hyperlink cell and returns the same text which is used as formula result.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11830				0	sh	            \<item type=\"input\"\>=HYPERLINK("http://www.";"Click ") & "example.org"\</item\> displays the text Click example.org in the cell and executes the hyperlink http://www.example.org when clicked.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id8859523				0	sh	            \<item type=\"input\"\>=HYPERLINK("#Sheet1.A1";"Go to top")\</item\> displays the text Go to top and jumps to cell Sheet1.A1 in this document.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id2958769				0	sh	            \<item type=\"input\"\>=HYPERLINK("file:///C:/writer.odt#Specification";"Go to Writer bookmark")\</item\>displays the text Go to Writer bookmark, loads the specified text document and jumps to bookmark "Specification".				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id7682424				0	sh	\<bookmark_value\>GETPIVOTDATA function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3747062				0	sh	GETPIVOTDATA				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3593859				0	sh	\<ahelp hid=\".\"\>The GETPIVOTDATA function returns a result value from a pivot table. The value is addressed using field and item names, so it remains valid if the layout of the pivot table changes.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id9741508				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id909451				0	sh	Two different syntax definitions can be used:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1665089				0	sh	GETPIVOTDATA(TargetField; pivot table; [ Field 1; Item 1; ... ])				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id4997100				0	sh	GETPIVOTDATA(pivot table; Constraints)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1672109				0	sh	The second syntax is assumed if exactly two parameters are given, of which the first parameter is a cell or cell range reference. The first syntax is assumed in all other cases. The Function Wizard shows the first syntax.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id9464094				0	sh	First Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id9302346				0	sh	            \<emph\>TargetField\</emph\> is a string that selects one of the pivot table's data fields. The string can be the name of the source column, or the data field name as shown in the table (like "Sum - Sales").				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id8296151				0	sh	            \<emph\>pivot table\</emph\> is a reference to a cell or cell range that is positioned within a pivot table or contains a pivot table. If the cell range contains several pivot tables, the table that was created last is used.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id4809411				0	sh	If no \<emph\>Field n / Item n\</emph\> pairs are given, the grand total is returned. Otherwise, each pair adds a constraint that the result must satisfy. \<emph\>Field n\</emph\> is the name of a field from the pivot table. \<emph\>Item n\</emph\> is the name of an item from that field.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id6454969				0	sh	If the pivot table contains only a single result value that fulfills all of the constraints, or a subtotal result that summarizes all matching values, that result is returned. If there is no matching result, or several ones without a subtotal for them, an error is returned. These conditions apply to results that are included in the pivot table.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id79042				0	sh	If the source data contains entries that are hidden by settings of the pivot table, they are ignored. The order of the Field/Item pairs is not significant. Field and item names are not case-sensitive.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id7928708				0	sh	If no constraint for a page field is given, the field's selected value is implicitly used. If a constraint for a page field is given, it must match the field's selected value, or an error is returned. Page fields are the fields at the top left of a pivot table, populated using the "Page Fields" area of the pivot table layout dialog. From each page field, an item (value) can be selected, which means only that item is included in the calculation.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3864253				0	sh	Subtotal values from the pivot table are only used if they use the function "auto" (except when specified in the constraint, see \<item type=\"literal\"\>Second Syntax\</item\> below).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3144016				0	sh	Second Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id9937131				0	sh	            \<emph\>pivot table\</emph\> has the same meaning as in the first syntax.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id5616626				0	sh	            \<emph\>Constraints\</emph\> is a space-separated list. Entries can be quoted (single quotes). The whole string must be enclosed in quotes (double quotes), unless you reference the string from another cell.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id4076357				0	sh	One of the entries can be the data field name. The data field name can be left out if the pivot table contains only one data field, otherwise it must be present.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id8231757				0	sh	Each of the other entries specifies a constraint in the form \<item type=\"literal\"\>Field[Item]\</item\> (with literal characters [ and ]), or only \<item type=\"literal\"\>Item\</item\> if the item name is unique within all fields that are used in the pivot table.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3168736				0	sh	A function name can be added in the form \<emph\>Field[Item;Function]\</emph\>, which will cause the constraint to match only subtotal values which use that function. The possible function names are Sum, Count, Average, Max, Min, Product, Count (Numbers only), StDev (Sample), StDevP (Population), Var (Sample), and VarP (Population), case-insensitive.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	tit				0	sh	Add-in Functions, List of Analysis Functions Part Two				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	bm_id3145074				0	sh	\<bookmark_value\>imaginary numbers in analysis functions\</bookmark_value\>      \<bookmark_value\>complex numbers in analysis functions\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3154659				0	sh	Add-in Functions, List of Analysis Functions Part Two				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3151242				0	sh	\<link href=\"text/scalc/01/04060108.xhp\" name=\"Category Statistics\"\>Category Statistics\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3148869				0	sh	\<link href=\"text/scalc/01/04060115.xhp\" name=\"Analysis Functions Part One\"\>Analysis Functions Part One\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3147072				0	sh	\<link href=\"text/scalc/01/04060111.xhp\" name=\"Back to the Overview\"\>Back to the Overview\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	bm_id3154959				0	sh	\<bookmark_value\>IMABS function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3154959				0	sh	IMABS				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3149895				0	sh	\<ahelp hid=\"HID_AAI_FUNC_IMABS\"\>The result is the absolute value of a complex number.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3155382				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3151302				0	sh	IMABS("ComplexNumber")				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3153974				0	sh	\<variable id=\"complex\"\>\<emph\>ComplexNumber\</emph\> is a complex number that is entered in the form "x+yi" or "x+yj".\</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3149697				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3143222	50			0	sh	            \<item type=\"input\"\>=IMABS("5+12j")\</item\> returns 13.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	bm_id3145357				0	sh	\<bookmark_value\>IMAGINARY function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3145357				0	sh	IMAGINARY				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3146965				0	sh	\<ahelp hid=\"HID_AAI_FUNC_IMAGINARY\"\>The result is the imaginary coefficient of a complex number.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3153555				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3155522				0	sh	IMAGINARY("ComplexNumber")				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3151193				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3155592	57			0	sh	            \<item type=\"input\"\>=IMAGINARY("4+3j")\</item\> returns 3.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	bm_id3146106				0	sh	\<bookmark_value\>IMPOWER function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3146106				0	sh	IMPOWER				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3147245				0	sh	\<ahelp hid=\"HID_AAI_FUNC_IMPOWER\"\>The result is the integer power of a complex number.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3150954				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3147501				0	sh	IMPOWER("ComplexNumber"; Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3155743	63			0	sh	            \<emph\>Number\</emph\> is the exponent.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3149048				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3151393	65			0	sh	            \<item type=\"input\"\>=IMPOWER("2+3i";2)\</item\> returns -5+12i.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	bm_id3148748				0	sh	\<bookmark_value\>IMARGUMENT function\</bookmark_value\>				20181231 09:50:43
