helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147427				0	sh	AMORDEGRC(Cost; DatePurchased; FirstPeriod; Salvage; Period; Rate; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147125	363			0	sh	            \<emph\>Cost\</emph\> is the acquisition costs.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3151074	364			0	sh	            \<emph\>DatePurchased\</emph\> is the date of acquisition.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3144765	365			0	sh	            \<emph\>FirstPeriod \</emph\>is the end date of the first settlement period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156286	366			0	sh	            \<emph\>Salvage\</emph\> is the salvage value of the capital asset at the end of the depreciable life.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153415	367			0	sh	            \<emph\>Period\</emph\> is the settlement period to be considered.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155064	368			0	sh	            \<emph\>Rate\</emph\> is the rate of depreciation.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3153765				0	sh	\<bookmark_value\>AMORLINC function\</bookmark_value\>         \<bookmark_value\>depreciations;linear amortizations\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3153765				0	sh	AMORLINC				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159264				0	sh	\<ahelp hid=\"HID_AAI_FUNC_AMORLINC\"\>Calculates the amount of depreciation for a settlement period as linear amortization. If the capital asset is purchased during the settlement period, the proportional amount of depreciation is considered.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3150044				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147363				0	sh	AMORLINC(Cost; DatePurchased; FirstPeriod; Salvage; Period; Rate; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146920	373			0	sh	            \<emph\>Cost\</emph\> means the acquisition costs.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3163807	374			0	sh	            \<emph\>DatePurchased\</emph\> is the date of acquisition.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148488	375			0	sh	            \<emph\>FirstPeriod \</emph\>is the end date of the first settlement period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149530	376			0	sh	            \<emph\>Salvage\</emph\> is the salvage value of the capital asset at the end of the depreciable life.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148633	377			0	sh	            \<emph\>Period\</emph\> is the settlement period to be considered.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150982	378			0	sh	            \<emph\>Rate\</emph\> is the rate of depreciation.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3145257				0	sh	\<bookmark_value\>ACCRINT function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3145257				0	sh	ACCRINT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3151276				0	sh	\<bookmark_value\>accrued interests;periodic payments\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3151276				0	sh	\<ahelp hid=\"HID_AAI_FUNC_ACCRINT\"\>Calculates the accrued interest of a security in the case of periodic payments.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3152581				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159092				0	sh	ACCRINT(Issue; FirstInterest; Settlement; Rate; Par; Frequency; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150519	339			0	sh	            \<emph\>Issue\</emph\> is the issue date of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155376	340			0	sh	            \<emph\>FirstInterest\</emph\> is the first interest date of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3166431	341			0	sh	            \<emph\>Settlement\</emph\> is the date at which the interest accrued up until then is to be calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154486	342			0	sh	            \<emph\>Rate\</emph\> is the annual nominal rate of interest (coupon interest rate)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156445	343			0	sh	            \<emph\>Par\</emph\> is the par value of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149406	344			0	sh	            \<emph\>Frequency\</emph\> is the number of interest payments per year (1, 2 or 4).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3148699				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148599				0	sh	A security is issued on 2001-02-28. First interest is set for 2001-08-31. The settlement date is 2001-05-01. The Rate is 0.1 or 10% and Par is 1000 currency units. Interest is paid half-yearly (frequency is 2). The basis is the US method (0). How much interest has accrued?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148840	347			0	sh	            \<item type=\"input\"\>=ACCRINT("2001-02-28";"2001-08-31";"2001-05-01";0.1;1000;2;0)\</item\> returns 16.94444.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3151240				0	sh	\<bookmark_value\>ACCRINTM function\</bookmark_value\>         \<bookmark_value\>accrued interests;one-off payments\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3151240				0	sh	ACCRINTM				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3157981				0	sh	\<ahelp hid=\"HID_AAI_FUNC_ACCRINTM\"\>Calculates the accrued interest of a security in the case of one-off payment at the settlement date.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3159097				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147074				0	sh	ACCRINTM(Issue; Settlement; Rate; Par; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3144773	352			0	sh	            \<emph\>Issue\</emph\> is the issue date of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154956	353			0	sh	            \<emph\>Settlement\</emph\> is the date at which the interest accrued up until then is to be calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153972	354			0	sh	            \<emph\>Rate\</emph\> is the annual nominal rate of interest (coupon interest rate).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159204	355			0	sh	            \<emph\>Par\</emph\> is the par value of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3155384				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154541				0	sh	A security is issued on 2001-04-01. The maturity date is set for 2001-06-15. The Rate is 0.1 or 10% and Par is 1000 currency units. The basis of the daily/annual calculation is the daily balance (3). How much interest has accrued?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149128	358			0	sh	            \<item type=\"input\"\>=ACCRINTM("2001-04-01";"2001-06-15";0.1;1000;3)\</item\> returns 20.54795.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3145753				0	sh	\<bookmark_value\>RECEIVED function\</bookmark_value\>         \<bookmark_value\>amount received for fixed-interest securities\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3145753				0	sh	RECEIVED				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150051				0	sh	\<ahelp hid=\"HID_AAI_FUNC_RECEIVED\"\>Calculates the amount received that is paid for a fixed-interest security at a given point in time.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3149385				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145362				0	sh	RECEIVED("Settlement"; "Maturity"; Investment; Discount; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154654	394			0	sh	            \<emph\>Settlement\</emph\> is the date of purchase of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153011	395			0	sh	            \<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155525	396			0	sh	            \<emph\>Investment\</emph\> is the purchase sum.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155760	397			0	sh	            \<emph\>Discount\</emph\> is the percentage discount on acquisition of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3154710				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154735				0	sh	Settlement date: February 15 1999, maturity date: May 15 1999, investment sum: 1000 currency units, discount: 5.75 per cent, basis: Daily balance/360 = 2.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146108				0	sh	The amount received on the maturity date is calculated as follows:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147246	401			0	sh	            \<item type=\"input\"\>=RECEIVED("1999-02-15";"1999-05-15";1000;0.0575;2)\</item\> returns 1014.420266.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3147556				0	sh	\<bookmark_value\>PV function\</bookmark_value\>         \<bookmark_value\>present values\</bookmark_value\>         \<bookmark_value\>calculating; present values\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3147556				0	sh	PV				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153301				0	sh	\<ahelp hid=\"HID_FUNC_BW\"\>Returns the present value of an investment resulting from a series of regular payments.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146099				0	sh	Use this function to calculate the amount of money needed to be invested at a fixed rate today, to receive a specific amount, an annuity, over a specified number of periods. You can also determine how much money is to remain after the elapse of the period. Specify as well if the amount is to be paid out at the beginning or at the end of each period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153334				0	sh	Enter these values either as numbers, expressions or references. If, for example, interest is paid annually at 8%, but you want to use month as your period, enter 8%/12 under \<emph\>Rate\</emph\> and \<item type=\"productname\"\>%PRODUCTNAME\</item\> Calc with automatically calculate the correct factor.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3147407				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150395				0	sh	PV(Rate; NPer; Pmt; FV; Type)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3151341	9			0	sh	            \<emph\>Rate\</emph\> defines the interest rate per period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153023	10			0	sh	            \<emph\>NPer\</emph\> is the total number of periods (payment period).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146323	11			0	sh	            \<emph\>Pmt\</emph\> is the regular payment made per period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150536	12			0	sh	            \<emph\>FV\</emph\> (optional) defines the future value remaining after the final installment has been made.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146883	13			0	sh	            \<emph\>Type\</emph\> (optional) denotes due date for payments. Type = 1 means due at the beginning of a period and Type = 0 (default) means due at the end of the period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_idN10B13				0	sh	            \<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>         				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3150037				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145225				0	sh	What is the present value of an investment, if 500 currency units are paid out monthly and the annual interest rate is 8%? The payment period is 48 months and 20,000 currency units are to remain at the end of the payment period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155907	16			0	sh	            \<item type=\"input\"\>=PV(8%/12;48;500;20000)\</item\> = -35,019.37 currency units. Under the named conditions, you must deposit 35,019.37 currency units today, if you want to receive 500 currency units per month for 48 months and have 20,000 currency units left over at the end. Cross-checking shows that 48 x 500 currency units + 20,000 currency units = 44,000 currency units. The difference between this amount and the 35,000 currency units deposited represents the interest paid.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149150				0	sh	If you enter references instead of these values into the formula, you can calculate any number of "If-then" scenarios. Please note: references to constants must be defined as absolute references. Examples of this type of application are found under the depreciation functions.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3152978				0	sh	\<bookmark_value\>calculating; depreciations\</bookmark_value\>         \<bookmark_value\>SYD function\</bookmark_value\>         \<bookmark_value\>depreciations; arithmetic declining\</bookmark_value\>         \<bookmark_value\>arithmetic declining depreciations\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3152978				0	sh	SYD				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148732				0	sh	\<ahelp hid=\"HID_FUNC_DIA\"\>Returns the arithmetic-declining depreciation rate.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149886				0	sh	Use this function to calculate the depreciation amount for one period of the total depreciation span of an object. Arithmetic declining depreciation reduces the depreciation amount from period to period by a fixed sum.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3149431				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150483				0	sh	SYD(Cost; Salvage; Life; Period)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146879	24			0	sh	            \<emph\>Cost\</emph\> is the initial cost of an asset.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147423	25			0	sh	            \<emph\>Salvage\</emph\> is the value of an asset after depreciation.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3151229	26			0	sh	            \<emph\>Life\</emph\> is the period fixing the time span over which an asset is depreciated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147473	27			0	sh	            \<emph\>Period\</emph\> defines the period for which the depreciation is to be calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3148434				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149688				0	sh	A video system initially costing 50,000 currency units is to be depreciated annually for the next 5 years. The salvage value is to be 10,000 currency units. You want to calculate depreciation for the first year.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150900	30			0	sh	            \<item type=\"input\"\>=SYD(50000;10000;5;1)\</item\>=13,333.33 currency units. The depreciation amount for the first year is 13,333.33 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146142				0	sh	To have an overview of depreciation rates per period, it is best to define a depreciation table. By entering the different depreciation formulas available in \<item type=\"productname\"\>%PRODUCTNAME\</item\> Calc next to each other, you can see which depreciation form is the most appropriate. Enter the table as follows:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155258	32			0	sh	                     \<emph\>A\</emph\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154558	33			0	sh	                     \<emph\>B\</emph\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3152372	34			0	sh	                     \<emph\>C\</emph\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149949	35			0	sh	                     \<emph\>D\</emph\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145123	36			0	sh	                     \<emph\>E\</emph\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149504				0	sh	1				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153778	38			0	sh	                     \<item type=\"input\"\>Initial Cost\</item\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159083	39			0	sh	                     \<item type=\"input\"\>Salvage Value\</item\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150002	40			0	sh	                     \<item type=\"input\"\>Useful Life\</item\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153006	41			0	sh	                     \<item type=\"input\"\>Time Period\</item\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154505	42			0	sh	                     \<item type=\"input\"\>Deprec. SYD\</item\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150336				0	sh	2				20181231 09:50:43
