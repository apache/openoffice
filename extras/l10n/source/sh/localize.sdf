helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147389	162			0	sh	            \<emph\>Number\</emph\> is the numerical value to be converted.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156167	163			0	sh	            \<emph\>Format\</emph\> is the text which defines the format. Use decimal and thousands separators according to the language set in the cell format.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id1243629				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id9044770				0	sh	            \<item type=\"input\"\>=TEXT(12.34567;"###.##")\</item\> returns the text 12.35				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3674123				0	sh	            \<item type=\"input\"\>=TEXT(12.34567;"000.00")\</item\> returns the text 012.35				20181231 09:50:43
