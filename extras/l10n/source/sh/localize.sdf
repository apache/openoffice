helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3145786				0	sh	\<emph\>Number:\</emph\> Any numeric expression that you want to calculate the tangent for (in radians).				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3153728				0	sh	To convert degrees to radians, multiply by Pi/180. To convert radians to degrees, multiply by 180/Pi.				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3155414				0	sh	degrees=(radiant*180)/Pi				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3146975				0	sh	radiant=(degrees*Pi)/180				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3147434				0	sh	Pi is approximately 3.141593.				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	hd_id3149483				0	sh	Example:				20181231 09:50:43
