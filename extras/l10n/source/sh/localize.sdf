helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3163713				0	sh	\<link href=\"text/scalc/01/04060112.xhp#addinconcept\"\>Add-in concept\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3146120	5			0	sh	You will also find a \<link href=\"text/scalc/01/04060112.xhp\"\>description of the $[officename] Calc add-in interface\</link\> in the Help. In addition, important functions and their parameters are described in the Help for the \<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>Shared Library \</caseinline\>\<defaultinline\>$[officename] Calc add-in DLL\</defaultinline\>\</switchinline\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3151075				0	sh	Add-ins supplied				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3156285				0	sh	$[officename] contains examples for the add-in interface of $[officename] Calc.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3159267				0	sh	\<link href=\"text/scalc/01/04060115.xhp\"\>Analysis Functions Part One\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3154703				0	sh	\<link href=\"text/scalc/01/04060116.xhp\"\>Analysis Functions Part Two\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3149566				0	sh	\<bookmark_value\>ISLEAPYEAR function\</bookmark_value\>\<bookmark_value\>leap year determination\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3149566				0	sh	ISLEAPYEAR				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150297				0	sh	\<ahelp hid=\".\"\>Determines whether a year is a leap year.\</ahelp\> If yes, the function will return the value 1 (TRUE); if not, it will return 0 (FALSE).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3148487				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150205				0	sh	ISLEAPYEAR("Date")				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3159239				0	sh	\<emph\>Date\</emph\> specifies whether a given date falls within a leap year. The Date parameter must be a valid date according to the locale settings of %PRODUCTNAME.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3149817				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150786				0	sh	=ISLEAPYEAR(A1) returns 1, if A1 contains 1968-02-29, the valid date 29th of February 1968 in your locale setting.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_idN107E7				0	sh	You may also use =ISLEAPYEAR("1968-02-29") or =ISLEAPYEAR("2/29/68").				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_idN107EA				0	sh	Never use =ISLEAPYEAR(2/29/68), because this would first evaluate 2 divided by 29 divided by 68, and then calculate the ISLEAPYEAR function from this small number as a serial date number.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3154656				0	sh	\<bookmark_value\>YEARS function\</bookmark_value\>\<bookmark_value\>number of years between two dates\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3154656				0	sh	YEARS				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150886				0	sh	\<ahelp hid=\"HID_DAI_FUNC_DIFFYEARS\"\>Calculates the difference in years between two dates.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3154370				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3146114				0	sh	YEARS(StartDate; EndDate; Type)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3145387				0	sh	\<emph\>StartDate\</emph\> is the first date				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3156290				0	sh	\<emph\>EndDate\</emph\> is the second date				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3152893				0	sh	\<emph\>Type\</emph\> calculates the type of difference. Possible values are 0 (interval) and 1 (in calendar years).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3152898				0	sh	\<bookmark_value\>MONTHS function\</bookmark_value\>\<bookmark_value\>number of months between two dates\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3152898				0	sh	MONTHS				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153066				0	sh	\<ahelp hid=\"HID_DAI_FUNC_DIFFMONTHS\"\>Calculates the difference in months between two dates.\</ahelp\>				20181231 09:50:43
