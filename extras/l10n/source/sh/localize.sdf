helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3156134				0	sh	<SDFIELD TYPE=DOCINFO SUBTYPE=CREATE FORMAT=TIME SDVAL="0" SDNUM="1031;1031;HH:MM:SS AM/PM" SDFIXED>03:58:35 PM</SDFIELD>				20181231 09:50:43
