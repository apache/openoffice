helpcontent2	source\text\sbasic\shared\03120403.xhp	0	help	par_id3150503				0	sh	StrComp (Text1 As String, Text2 As String[, Compare])				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03120403.xhp	0	help	hd_id3147574				0	sh	Return value:				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03120403.xhp	0	help	par_id3156152				0	sh	Integer				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03120403.xhp	0	help	hd_id3150984				0	sh	Parameter:				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03120403.xhp	0	help	par_id3153061				0	sh	\<emph\>Text1:\</emph\> Any string expression				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03120403.xhp	0	help	par_id3147560				0	sh	\<emph\>Text2:\</emph\> Any string expression				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03120403.xhp	0	help	par_id3146796				0	sh	\<emph\>Compare:\</emph\> This optional parameter sets the comparison method. If Compare = 1, the string comparison is case-sensitive. If Compare = 0, no distinction is made between uppercase and lowercase letters.				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03120403.xhp	0	help	hd_id3154940				0	sh	Return value				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03120403.xhp	0	help	par_id3150358				0	sh	If Text1 < Text2 the function returns -1				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03120403.xhp	0	help	par_id3151043				0	sh	If Text1 = Text2 the function returns 0				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03120403.xhp	0	help	par_id3158410				0	sh	If Text1 > Text2 the function returns 1				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03120403.xhp	0	help	hd_id3153968				0	sh	Example:				20181231 09:50:43
