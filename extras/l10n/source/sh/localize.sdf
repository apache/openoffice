helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154344				0	sh	RIGHT("Text"; Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149426	117			0	sh	            \<emph\>Text\</emph\> is the text of which the right part is to be determined.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153350	118			0	sh	            \<emph\>Number\</emph\> (optional) is the number of characters from the right part of the text.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148661				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151132	120			0	sh	            \<item type=\"input\"\>=RIGHT("Sun";2)\</item\> returns un.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3153534				0	sh	\<bookmark_value\>ROMAN function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153534				0	sh	ROMAN				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151256				0	sh	\<ahelp hid=\"HID_FUNC_ROEMISCH\"\>Converts a number into a Roman numeral. The value range must be between 0 and 3999, the modes can be integers from 0 to 4.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149299				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150593				0	sh	ROMAN(Number; Mode)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156139	252			0	sh	            \<emph\>Number\</emph\> is the number that is to be converted into a Roman numeral.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153318	253			0	sh	            \<emph\>Mode\</emph\> (optional) indicates the degree of simplification. The higher the value, the greater is the simplification of the Roman number.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3145306				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151371	255			0	sh	            \<item type=\"input\"\>=ROMAN(999)\</item\> returns CMXCIX				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153938	256			0	sh	            \<item type=\"input\"\>=ROMAN(999;0)\</item\> returns CMXCIX				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148412	257			0	sh	            \<item type=\"input\"\>=ROMAN (999;1)\</item\> returns LMVLIV				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155421	258			0	sh	            \<item type=\"input\"\>=ROMAN(999;2)\</item\> returns XMIX				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149235	259			0	sh	            \<item type=\"input\"\>=ROMAN(999;3)\</item\> returns VMIV				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150624	260			0	sh	            \<item type=\"input\"\>=ROMAN(999;4)\</item\> returns IM				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3151005				0	sh	\<bookmark_value\>SEARCH function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3151005				0	sh	SEARCH				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148692				0	sh	\<ahelp hid=\"HID_FUNC_SUCHEN\"\>Returns the position of a text segment within a character string.\</ahelp\> You can set the start of the search as an option. The search text can be a number or any sequence of characters. The search is not case-sensitive.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152964				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154671				0	sh	SEARCH("FindText"; "Text"; Position)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146080	126			0	sh	            \<emph\>FindText\</emph\> is the text to be searched for.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154111	127			0	sh	            \<emph\>Text\</emph\> is the text where the search will take place.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149559	128			0	sh	            \<emph\>Position\</emph\> (optional) is the position in the text where the search is to start.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3147322				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154564	130			0	sh	            \<item type=\"input\"\>=SEARCH(54;998877665544)\</item\> returns 10.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3154830				0	sh	\<bookmark_value\>SUBSTITUTE function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3154830				0	sh	SUBSTITUTE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153698				0	sh	\<ahelp hid=\"HID_FUNC_WECHSELN\"\>Substitutes new text for old text in a string.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150994				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147582				0	sh	SUBSTITUTE("Text"; "SearchText"; "NewText"; Occurrence)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153675	178			0	sh	            \<emph\>Text\</emph\> is the text in which text segments are to be exchanged.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156155	179			0	sh	            \<emph\>SearchText \</emph\>is the text segment that is to be replaced (a number of times).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145779	180			0	sh	            \<emph\>NewText\</emph\> is the text that is to replace the text segment.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150348	181			0	sh	            \<emph\>Occurrence\</emph\> (optional) indicates which occurrence of the search text is to be replaced. If this parameter is missing the search text is replaced throughout.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150946				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150412	183			0	sh	            \<item type=\"input\"\>=SUBSTITUTE("123123123";"3";"abc")\</item\> returns 12abc12abc12abc.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154915	238			0	sh	            \<item type=\"input\"\>=SUBSTITUTE("123123123";"3";"abc";2)\</item\> returns 12312abc123.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3148977				0	sh	\<bookmark_value\>T function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148977				0	sh	T				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154359				0	sh	\<ahelp hid=\"HID_FUNC_T\"\>This function returns the target text, or a blank text string if the target is not text.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155858				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155871				0	sh	T(Value)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154726				0	sh	If \<emph\>Value\</emph\> is a text string or refers to a text string, T returns that text string; otherwise it returns a blank text string.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155544				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151062	146			0	sh	            \<item type=\"input\"\>=T(12345)\</item\> returns an empty string. 				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id4650105				0	sh	            \<item type=\"input\"\>=T("12345")\</item\> returns the string 12345.				20181231 09:50:43
