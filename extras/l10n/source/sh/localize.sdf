helpcontent2	source\text\scalc\01\02190100.xhp	0	help	hd_id3156326				0	sh	\<link href=\"text/scalc/01/02190100.xhp\" name=\"Row Break\"\>Row Break\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\02190100.xhp	0	help	par_id3154366				0	sh	\<ahelp hid=\".uno:DeleteRowbreak\"\>Removes the manual row break above the active cell.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\02190100.xhp	0	help	par_id3151041				0	sh	Position the cursor in a cell directly below the row break indicated by a horizontal line and choose \<emph\>Edit - Delete Manual Break - Row Break\</emph\>. The manual row break is removed.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	tit				0	sh	MONTH 				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	bm_id3149936				0	sh	\<bookmark_value\>MONTH function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	hd_id3149936				0	sh	\<variable id=\"month\"\>\<link href=\"text/scalc/01/func_month.xhp\"\>MONTH\</link\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	par_id3153538				0	sh	\<ahelp hid=\"HID_FUNC_MONAT\"\>Returns the month for the given date value.\</ahelp\> The month is returned as an integer between 1 and 12.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	hd_id3149517				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	par_id3145602				0	sh	MONTH(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	par_id3149485				0	sh	\<emph\>Number\</emph\>, as a time value, is a decimal for which the month is to be returned.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	hd_id3153322				0	sh	Examples				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	par_id3149244				0	sh	=MONTH(NOW()) returns the current month.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	par_id3154790				0	sh	=MONTH(C4) returns 7 if you enter 2000-07-07 to cell C4 (that date value might get formatted differently after you press Enter).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	tit				0	sh	Array Functions				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3147273				0	sh	\<bookmark_value\>matrices; functions\</bookmark_value\>\<bookmark_value\>Function Wizard; arrays\</bookmark_value\>\<bookmark_value\>array formulas\</bookmark_value\>\<bookmark_value\>inline array constants\</bookmark_value\>\<bookmark_value\>formulas;arrays\</bookmark_value\>\<bookmark_value\>functions;array functions\</bookmark_value\>\<bookmark_value\>editing; array formulas\</bookmark_value\>\<bookmark_value\>copying; array formulas\</bookmark_value\>\<bookmark_value\>adjusting array ranges\</bookmark_value\>\<bookmark_value\>calculating;conditional calculations\</bookmark_value\>\<bookmark_value\>matrices; calculations\</bookmark_value\>\<bookmark_value\>conditional calculations with arrays\</bookmark_value\>\<bookmark_value\>implicit array handling\</bookmark_value\>\<bookmark_value\>forced array handling\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3147273				0	sh	Array Functions				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154744				0	sh	\<variable id=\"matrixtext\"\>This category contains the array functions. \</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3146084				0	sh	What is an Array?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154298				0	sh	\<variable id=\"wasmatrix\"\>An array is a linked range of cells on a spreadsheet containing values. \</variable\> A square range of 3 rows and 3 columns is a 3 x 3 array:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154692				0	sh	A				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3150117				0	sh	B				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3155325				0	sh	C				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3153104				0	sh	1				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3146996				0	sh	\<item type=\"input\"\>7\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3150529				0	sh	\<item type=\"input\"\>31\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3148831				0	sh	\<item type=\"input\"\>33\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3148943				0	sh	2				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149771				0	sh	\<item type=\"input\"\>95\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3158407				0	sh	\<item type=\"input\"\>17\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3148806				0	sh	\<item type=\"input\"\>2\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154904				0	sh	3				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3150779				0	sh	\<item type=\"input\"\>5\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3148449				0	sh	\<item type=\"input\"\>10\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3147238				0	sh	\<item type=\"input\"\>50\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3153583				0	sh	The smallest possible array is a 1 x 2 or 2 x 1 array with two adjacent cells.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3148474				0	sh	What is an array formula?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3155355				0	sh	A formula in which the individual values in a cell range are evaluated is referred to as an array formula. The difference between an array formula and other formulas is that the array formula deals with several values simultaneously instead of just one.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3151052				0	sh	Not only can an array formula process several values, but it can also return several values. The results of an array formula is also an array.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3158432				0	sh	To multiply the values in the individual cells by 10 in the above array, you do not need to apply a formula to each individual cell or value. Instead you just need to use a single array formula. Select a range of 3 x 3 cells on another part of the spreadsheet, enter the formula \<item type=\"input\"\>=10*A1:C3\</item\> and confirm this entry using the key combination \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+Shift+Enter. The result is a 3 x 3 array in which the individual values in the cell range (A1:C3) are multiplied by a factor of 10.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149156				0	sh	In addition to multiplication, you can also use other operators on the reference range (an array). With $[officename] Calc, you can add (+), subtract (-), multiply (*), divide (/), use exponents (^), concatenation (&) and comparisons (=, <>, <, >, <=, >=). The operators can be used on each individual value in the cell range and return the result as an array if the array formula was entered.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166456				0	sh	Comparison operators in an array formula treat empty cells in the same way as in a normal formula, that is, either as zero or as an empty string. For example, if cells A1 and A2 are empty the array formulas \<item type=\"input\"\>{=A1:A2=""}\</item\> and \<item type=\"input\"\>{=A1:A2=0}\</item\> will both return a 1 column 2 row array of cells containing TRUE.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3150713				0	sh	When do you use array formulas?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149787				0	sh	Use array formulas if you have to repeat calculations using different values. If you decide to change the calculation method later, you only have to update the array formula. To add an array formula, select the entire array range and then \<link href=\"text/scalc/01/04060107.xhp\" name=\"make the required change to the array formula\"\>make the required change to the array formula\</link\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149798				0	sh	Array formulas are also a space saving option when several values must be calculated, since they are not very memory-intensive. In addition, arrays are an essential tool for carrying out complex calculations, because you can have several cell ranges included in your calculations. $[officename] has different math functions for arrays, such as the MMULT function for multiplying two arrays or the SUMPRODUCT function for calculating the scalar products of two arrays.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3155588				0	sh	Using Array Formulas in $[officename] Calc				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3152876				0	sh	You can also create a "normal" formula in which the reference range, such as parameters, indicate an array formula. The result is obtained from the intersection of the reference range and the rows or columns in which the formula is found. If there is no intersection or if the range at the intersection covers several rows or columns, a #VALUE! error message appears. The following example illustrates this concept:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3151271				0	sh	Creating Array Formulas				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149102				0	sh	If you create an array formula using the \<emph\>Function Wizard\</emph\>, you must mark the \<emph\>Array\</emph\> check box each time so that the results are returned in an array. Otherwise, only the value in the upper-left cell of the array being calculated is returned.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3153392				0	sh	If you enter the array formula directly into the cell, you must use the key combination Shift+\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+Enter instead of the Enter key. Only then does the formula become an array formula.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3151120				0	sh	Array formulas appear in braces in $[officename] Calc. You cannot create array formulas by manually entering the braces.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154342				0	sh	The cells in a results array are automatically protected against changes. However, you can edit or copy the array formula by selecting the entire array cell range.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id8834803				0	sh	Using Inline Array Constants in Formulas				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id985747				0	sh	Calc supports inline matrix/array constants in formulas. An inline array is surrounded by curly braces '{' and '}'. Elements can be each a number (including negatives), a logical constant (TRUE, FALSE), or a literal string. Non-constant expressions are not allowed. Arrays can be entered with one or more rows, and one or more columns. All rows must consist of the same number of elements, all columns must consist of the same number of elements. 				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id936613				0	sh	The column separator (separating elements in one row) is the ';' semicolon. The row separator is a '|' pipe symbol. The separators are not language and locale dependent. 				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id1877498				0	sh	Arrays can not be nested.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id4262520				0	sh	\<emph\>Examples:\</emph\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id9387493				0	sh	={1;2;3}				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id8207037				0	sh	An array with one row consisting of the three numbers 1, 2, and 3.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id6757103				0	sh	To enter this array constant, you select three cells in a row, then you type the formula \<item type=\"input\"\>={1;2;3}\</item\> using the curly braces and the semicolons, then press \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+Shift+Enter.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id8868068				0	sh	={1;2;3|4;5;6}				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id6626483				0	sh	An array with two rows and three values in each row.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id5262916				0	sh	={0;1;2|FALSE;TRUE;"two"}				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id1623889				0	sh	A mixed data array.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id7781914				0	sh	=SIN({1;2;3})				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id300912				0	sh	Entered as a matrix formula, delivers the result of three SIN calculations with the arguments 1, 2, and 3.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3148660				0	sh	Editing Array Formulas				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149241				0	sh	Select the cell range or array containing the array formula. To select the whole array, position the cell cursor inside the array range, then press \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command \</caseinline\>\<defaultinline\>Ctrl \</defaultinline\>\</switchinline\>+ /, where / is the Division key on the numeric keypad.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3143274				0	sh	Either press F2 or position the cursor in the input line. Both of these actions let you edit the formula.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154798				0	sh	After you have made changes, press \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+Shift+Enter.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3150628				0	sh	You can format the separate parts of an array. For example, you can change the font color. Select a cell range and then change the attribute you want.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3145608				0	sh	Copying Array Formulas				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149585				0	sh	Select the cell range or array containing the array formula.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154619				0	sh	Either press F2 or position the cursor in the input line.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3150994				0	sh	Copy the formula into the input line by pressing \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+C.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3146787				0	sh	Select a range of cells where you want to insert the array formula and either press F2 or position the cursor in the input line.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154419				0	sh	Paste the formula by pressing \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+V in the selected space and confirm it by pressing \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+Shift+Enter. The selected range now contains the array formula.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3154834				0	sh	Adjusting an Array Range				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3148679				0	sh	If you want to edit the output array, do the following:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3151102				0	sh	Select the cell range or array containing the array formula.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3147096				0	sh	Below the selection, to the right, you will see a small icon with which you can zoom in or out on the range using your mouse.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3150974				0	sh	When you adjust the array range, the array formula will not automatically be adjusted. You are only changing the range in which the result will appear.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3146080				0	sh	By holding down the \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command \</caseinline\>\<defaultinline\>Ctrl \</defaultinline\>\</switchinline\>key, you can create a copy of the array formula in the given range.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D47				0	sh	Conditional Array Calculations				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D4B				0	sh	A conditional array calculation is an array or matrix formula that includes an IF() or CHOOSE() function. The condition argument in the formula is an area reference or a matrix result.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D4E				0	sh	In the following example, the >0 test of the {=IF(A1:A3>0;"yes";"no")} formula is applied to each cell in the range A1:A3 and the result is copied to the corresponding cell.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D65				0	sh	A				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D6B				0	sh	B (formula)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10B75				0	sh	B (result)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D79				0	sh	1				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D80				0	sh	1				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D86				0	sh	{=IF(A1:A3>0;"yes";"no")}				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D8C				0	sh	yes				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D94				0	sh	2				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D9B				0	sh	0				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DA1				0	sh	{=IF(A1:A3>0;"yes";"no")}				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DA7				0	sh	no				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DAF				0	sh	3				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DB6				0	sh	1				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DBC				0	sh	{=IF(A1:A3>0;"yes";"no")}				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DC2				0	sh	yes				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DD0				0	sh	The following functions provide forced array handling: CORREL, COVAR, FORECAST, FTEST, INTERCEPT, MDETERM, MINVERSE, MMULT, MODE, PEARSON, PROB, RSQ, SLOPE, STEYX, SUMPRODUCT, SUMX2MY2, SUMX2PY2, SUMXMY2, TTEST. If you use area references as arguments when you call one of these functions, the functions behave as array functions. The following table provides an example of forced array handling:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DE2				0	sh	A				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DE8				0	sh	B (formula)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DEE				0	sh	B (result)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DF4				0	sh	C (forced array formula)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DFA				0	sh	C (result)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E02				0	sh	1				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E09				0	sh	1				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E0F				0	sh	=A1:A2+1				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E17				0	sh	2				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E1D				0	sh	=SUMPRODUCT(A1:A2+1)				20181231 09:50:43
