helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	tit				0	sh	MINUTE 				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	bm_id3149803				0	sh	\<bookmark_value\>MINUTE function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	hd_id3149803				0	sh	\<variable id=\"minute\"\>\<link href=\"text/scalc/01/func_minute.xhp\"\>MINUTE\</link\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	par_id3148988				0	sh	\<ahelp hid=\"HID_FUNC_MINUTE\"\>Calculates the minute for an internal time value.\</ahelp\> The minute is returned as a number between 0 and 59.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	hd_id3154343				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	par_id3148660				0	sh	MINUTE(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	par_id3154611				0	sh	\<emph\>Number\</emph\>, as a time value, is a decimal number where the number of the minute is to be returned.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	hd_id3145374				0	sh	Examples				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	par_id3148463				0	sh	\<item type=\"input\"\>=MINUTE(8.999)\</item\> returns 58				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	par_id3149419				0	sh	\<item type=\"input\"\>=MINUTE(8.9999)\</item\> returns 59				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	par_id3144755				0	sh	\<item type=\"input\"\>=MINUTE(NOW())\</item\> returns the current minute value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\02140100.xhp	0	help	tit				0	sh	Down				20181231 09:50:43
helpcontent2	source\text\scalc\01\02140100.xhp	0	help	hd_id3150792				0	sh	\<link href=\"text/scalc/01/02140100.xhp\" name=\"Down\"\>Down\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\02140100.xhp	0	help	par_id3153969				0	sh	\<ahelp hid=\".uno:FillDown\" visibility=\"visible\"\>Fills a selected range of at least two rows with the contents of the top cell of the range.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\02140100.xhp	0	help	par_id3145787				0	sh	If a selected range has only one column, the contents of the top cell are copied to all others. If several columns are selected, the contents of the corresponding top cell will be copied down.				20181231 09:50:43
