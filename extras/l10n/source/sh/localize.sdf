helpcontent2	source\text\sbasic\shared\03103800.xhp	0	help	hd_id3145136				0	sh	\<link href=\"text/sbasic/shared/03103800.xhp\" name=\"FindObject Function [Runtime]\"\>FindObject Function [Runtime]\</link\>				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103800.xhp	0	help	par_id3155341				0	sh	Enables an object to be addressed at run-time as a string parameter through the object name.				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103800.xhp	0	help	par_id3150669				0	sh	For example, the following command:				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103800.xhp	0	help	par_id3148473				0	sh	MyObj.Prop1.Command = 5				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103800.xhp	0	help	par_id3156023				0	sh	corresponds to the command block:				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103800.xhp	0	help	par_id3153896				0	sh	Dim ObjVar as Object				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103800.xhp	0	help	par_id3154760				0	sh	Dim ObjProp as Object				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103800.xhp	0	help	par_id3145069				0	sh	ObjName As String = "MyObj"				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103800.xhp	0	help	par_id3154939				0	sh	ObjVar = FindObject( ObjName As String )				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103800.xhp	0	help	par_id3150793				0	sh	PropName As String = "Prop1"				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103800.xhp	0	help	par_id3154141				0	sh	ObjProp = FindPropertyObject( ObjVar, PropName As String )				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103800.xhp	0	help	par_id3156424				0	sh	ObjProp.Command = 5				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103800.xhp	0	help	par_id3145420				0	sh	This allows names to be dynamically created at run-time. For example:				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103800.xhp	0	help	par_id3153104				0	sh	"TextEdit1" to TextEdit5" in a loop to create five control names.				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103800.xhp	0	help	par_id3150767				0	sh	See also: \<link href=\"text/sbasic/shared/03103900.xhp\" name=\"FindPropertyObject\"\>FindPropertyObject\</link\>				20181231 09:50:43
