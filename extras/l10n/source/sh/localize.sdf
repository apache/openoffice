helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153196				0	sh	\<ahelp hid=\"HID_FUNC_ZELLE\"\>Returns information on address, formatting or contents of a cell.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3149323				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3147355				0	sh	CELL("InfoType"; Reference)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154716				0	sh	\<emph\>InfoType\</emph\> is the character string that specifies the type of information. The character string is always in English. Upper or lower case is optional.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150636				0	sh	InfoType				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149344				0	sh	Meaning				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153266				0	sh	COL				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156204				0	sh	Returns the number of the referenced column.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150094				0	sh	\<item type=\"input\"\>=CELL("COL";D2)\</item\> returns 4.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151276				0	sh	ROW				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3147583				0	sh	Returns the number of the referenced row.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151222				0	sh	\<item type=\"input\"\>=CELL("ROW";D2)\</item\> returns 2.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3159217				0	sh	SHEET				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151201				0	sh	Returns the number of the referenced sheet.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149169				0	sh	\<item type=\"input\"\>=CELL("Sheet";Sheet3.D2)\</item\> returns 3.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149431				0	sh	ADDRESS				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156054				0	sh	Returns the absolute address of the referenced cell.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154136				0	sh	\<item type=\"input\"\>=CELL("ADDRESS";D2)\</item\> returns $D$2.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3159198				0	sh	\<item type=\"input\"\>=CELL("ADDRESS";Sheet3.D2)\</item\> returns $Sheet3.$D$2.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150245				0	sh	\<item type=\"input\"\>=CELL("ADDRESS";'X:\\dr\\test.sxc'#$Sheet1.D2)\</item\> returns 'file:///X:/dr/test.sxc'#$Sheet1.$D$2.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3146811				0	sh	FILENAME				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151328				0	sh	Returns the file name and the sheet number of the referenced cell.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3148896				0	sh	\<item type=\"input\"\>=CELL("FILENAME";D2)\</item\> returns 'file:///X:/dr/own.sxc'#$Sheet1, if the formula in the current document X:\\dr\\own.sxc is located in Sheet1.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155144				0	sh	\<item type=\"input\"\>=CELL("FILENAME";'X:\\dr\\test.sxc'#$Sheet1.D2)\</item\> returns 'file:///X:/dr/test.sxc'#$Sheet1.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151381				0	sh	COORD				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151004				0	sh	Returns the complete cell address in Lotus(TM) notation.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3159104				0	sh	\<item type=\"input\"\>=CELL("COORD"; D2)\</item\> returns $A:$D$2.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3163720				0	sh	\<item type=\"input\"\>=CELL("COORD"; Sheet3.D2)\</item\> returns $C:$D$2.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155910				0	sh	CONTENTS				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156041				0	sh	Returns the contents of the referenced cell, without any formatting.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151069				0	sh	TYPE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155344				0	sh	Returns the type of cell contents.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3145217				0	sh	b = blank. empty cell				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155176				0	sh	l = label. Text, result of a formula as text				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3147280				0	sh	v = value. Value, result of a formula as a number				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156348				0	sh	WIDTH				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154920				0	sh	Returns the width of the referenced column. The unit is the number of zeros (0) that fit into the column in the default text and the default size.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3152355				0	sh	PREFIX				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154230				0	sh	Returns the alignment of the referenced cell.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155946				0	sh	' = align left or left-justified				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3147220				0	sh	" = align right				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149038				0	sh	^ = centered				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153129				0	sh	\\ = repeating (currently inactive)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154406				0	sh	PROTECT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3145127				0	sh	Returns the status of the cell protection for the cell.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155794				0	sh	1 = cell is protected				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155072				0	sh	0 = cell is not protected				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156178				0	sh	FORMAT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150220				0	sh	Returns a character string that indicates the number format.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153824				0	sh	, = number with thousands separator				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153837				0	sh	F = number without thousands separator				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150318				0	sh	C = currency format				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153168				0	sh	S = exponential representation, for example, 1.234+E56				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153515				0	sh	P = percentage				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154375				0	sh	In the above formats, the number of decimal places after the decimal separator is given as a number. Example: the number format #,##0.0 returns ,1 and the number format 00.000% returns P3				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150575				0	sh	D1 = MMM-D-YY, MM-D-YY and similar formats				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150589				0	sh	D2 = DD-MM				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151034				0	sh	D3 = MM-YY				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156371				0	sh	D4 = DD-MM-YYYY HH:MM:SS				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3157881				0	sh	D5 = MM-DD				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3157894				0	sh	D6 = HH:MM:SS AM/PM				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154068				0	sh	D7 = HH:MM AM/PM				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150286				0	sh	D8 = HH:MM:SS				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3145756				0	sh	D9 = HH:MM				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3145768				0	sh	G = All other formats				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153375				0	sh	- (Minus) at the end = negative numbers are formatted in color				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155545				0	sh	() (brackets) at the end = there is an opening bracket in the format code				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154594				0	sh	COLOR				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3152922				0	sh	Returns 1, if negative values have been formatted in color, otherwise 0.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3145563				0	sh	PARENTHESES				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156072				0	sh	Returns 1 if the format code contains an opening bracket (, otherwise 0.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156090				0	sh	\<emph\>Reference\</emph\> (list of options) is the position of the cell to be examined. If \<emph\>Reference\</emph\> is a range, the cell moves to the top left of the range. If \<emph\>Reference\</emph\> is missing, $[officename] Calc uses the position of the cell in which this formula is located. Microsoft Excel uses the reference of the cell in which the cursor is positioned.				20181231 09:50:43
