helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN10594				0	sh	Delete				20181231 09:50:43
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN10598				0	sh	\<ahelp hid=\".\"\>Deletes the selected address block layout.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	tit				0	sh	Insert Index Entry				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	hd_id3154508				0	sh	Insert Index Entry				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	par_id3150565				0	sh	\<variable id=\"eintrag\"\>\<ahelp hid=\".uno:InsertIndexesEntry\"\>Marks the selected text as index or table of contents entry.\</ahelp\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	par_id3147571				0	sh	To edit an index entry, place the cursor in front of the index field, and then choose \<link href=\"text/swriter/01/02160000.xhp\" name=\"Edit - Index Entry\"\>\<emph\>Edit - Index Entry\</emph\>\</link\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	par_id3145760				0	sh	You can leave the \<emph\>Insert Index Entry\</emph\> dialog open while you select and insert entries.				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	hd_id3145410				0	sh	Selection				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	hd_id3147508				0	sh	Index				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	par_id3154103				0	sh	\<ahelp hid=\"HID_INSERT_IDX_MRK_TYPE\"\>Select the index that you want to add the entry to.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	hd_id3153527				0	sh	Entry				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	par_id3151312				0	sh	\<ahelp hid=\"HID_INSERT_IDX_MRK_ENTRY\"\>Displays the text that is selected in the document. If you want, you can enter a different word for the index entry. The selected text in the document is not changed.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	hd_id3154480				0	sh	1st key				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	par_id3152953				0	sh	\<ahelp hid=\"HID_INSERT_IDX_MRK_PRIM_KEY\"\>Makes the current selection a subentry of the word that you enter here. For example, if you select "cold", and enter "weather" as the 1st key, the index entry is "weather, cold".\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	hd_id3154572				0	sh	2nd key				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	par_id3155904				0	sh	\<ahelp hid=\"HID_INSERT_IDX_MRK_SEC_KEY\"\>Makes the current selection a sub-subentry of the 1st key. For example, if you select "cold", and enter "weather" as the 1st key and "winter" as the 2nd key, the index entry is "weather, winter, cold".\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	hd_id3155174				0	sh	Phonetic reading				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	par_id3149484				0	sh	\<ahelp hid=\"HID_INSERT_IDX_MRK_PHONETIC_READING\"\>Enter the phonetic reading for the corresponding entry. For example, if a Japanese Kanji word has more than one pronunciation, enter the correct pronunciation as a Katakana word. The Kanji word is then sorted according to the phonetic reading entry.\</ahelp\> This option is only available if Asian language support is enabled.				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	hd_id3143284				0	sh	Main Entry				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	par_id3151248				0	sh	\<ahelp hid=\"HID_INSERT_IDX_MRK_MAIN_ENTRY\"\>Makes the selected text the main entry in an alphabetical index.\</ahelp\> $[officename] displays the page number of the main entry in a different format than the other entries in the index.				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	hd_id3149821				0	sh	Level				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	par_id3147098				0	sh	Entries using the paragraph format "Heading X" (X = 1-10) can be automatically added to the table of contents. The level of the entry in the index corresponds to the outline level of the heading style.\<ahelp hid=\"HID_INSERT_IDX_MRK_LEVEL\"/\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	par_id3149175				0	sh	This option is available only for table of contents and user-defined index entries.				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	hd_id3156278				0	sh	Apply to all similar texts				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	par_id3145783				0	sh	\<ahelp hid=\"HID_INSERT_IDX_MRK_APPLY_ALL\"\>Automatically marks all other occurrences of the selected text in the document. Text in headers, footers, frames, and captions is not included.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	par_id3155920	21			0	sh	You cannot use the function for an \<emph\>Entry \</emph\>that you entered manually in this dialog.				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	par_id3147496	18			0	sh	To include all occurrences of a text passage in an index, select the text, choose\<emph\> Edit - Find & Replace\</emph\>, and click \<emph\>Find All\</emph\>. Then choose \<emph\>Insert - Indexes and Tables - Entry\</emph\> and click \<emph\>Insert\</emph\>.				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	hd_id3149568				0	sh	Match case				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	hd_id3147741				0	sh	Whole words only				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	hd_id3146345				0	sh	Insert				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	par_id3149845				0	sh	\<ahelp hid=\"HID_INSERT_IDX_MRK_OK\"\>Marks an index entry in your text.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	hd_id3148855				0	sh	Close				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	par_id3154777				0	sh	\<ahelp hid=\"HID_INSERT_IDX_MRK_CLOSE\"\>Closes the dialog.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	hd_id3151083				0	sh	New user-defined index				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	par_id3150161				0	sh	\<ahelp hid=\"HID_INSERT_IDX_MRK_NEW\"\>Opens the \<emph\>Create New User-defined Index\</emph\> dialog where you can create a custom index.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	hd_id3153296				0	sh	Name				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	par_id3153507				0	sh	\<ahelp hid=\"SW:EDIT:DLG_NEW_USER_IDX:ED_NAME\"\>Enter a name for the new user-defined index. The new index is added to the list of available indexes and tables.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\04120100.xhp	0	help	par_id3156124				0	sh	\<link href=\"text/swriter/guide/indices_toc.xhp\" name=\"Using Tables of Content and Indexes\"\>Using Tables of Content and Indexes\</link\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\04060100.xhp	0	help	tit				0	sh	Options				20181231 09:50:43
helpcontent2	source\text\swriter\01\04060100.xhp	0	help	hd_id3149287				0	sh	Options				20181231 09:50:43
helpcontent2	source\text\swriter\01\04060100.xhp	0	help	par_id3151177				0	sh	\<variable id=\"optionentext\"\>\<ahelp hid=\"SW:PUSHBUTTON:DLG_CAPTION:BTN_OPTION\"\>Adds the chapter number to the caption label. To use this feature, you must first assign an \<link href=\"text/swriter/guide/chapter_numbering.xhp\" name=\"outline level\"\>outline level\</link\> to a paragraph style, and then apply the style to the chapter headings in your document.\</ahelp\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\04060100.xhp	0	help	hd_id3149805				0	sh	Numbering by chapter				20181231 09:50:43
helpcontent2	source\text\swriter\01\04060100.xhp	0	help	par_id3153532				0	sh	When you add chapter numbers to caption labels, the caption numbering is reset when a chapter heading is encountered. For example, if the last figure in chapter 1 is "Figure 1.12", the first figure in the next chapter would be "Figure 2.1".				20181231 09:50:43
helpcontent2	source\text\swriter\01\04060100.xhp	0	help	hd_id3154574				0	sh	Level				20181231 09:50:43
helpcontent2	source\text\swriter\01\04060100.xhp	0	help	par_id3152954				0	sh	\<ahelp hid=\"SW:LISTBOX:DLG_SEQUENCE_OPTION:LB_LEVEL\"\>Select the number of outline levels from the top of the chapter hierarchy down to include in the caption label.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\04060100.xhp	0	help	hd_id3151316				0	sh	Separator				20181231 09:50:43
helpcontent2	source\text\swriter\01\04060100.xhp	0	help	par_id3155892				0	sh	\<ahelp hid=\"SW:EDIT:DLG_SEQUENCE_OPTION:ED_SEPARATOR\"\>Enter the character that you want to insert between the chapter number and the caption number.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\04060100.xhp	0	help	par_idN10633				0	sh	Category and frame format				20181231 09:50:43
helpcontent2	source\text\swriter\01\04060100.xhp	0	help	par_idN10639				0	sh	Character style				20181231 09:50:43
helpcontent2	source\text\swriter\01\04060100.xhp	0	help	par_idN1063F				0	sh	\<ahelp hid=\".\"\>Specifies the character style.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\04060100.xhp	0	help	hd_id3143280				0	sh	Apply border and shadow				20181231 09:50:43
helpcontent2	source\text\swriter\01\04060100.xhp	0	help	par_id3149826				0	sh	\<ahelp hid=\"SW:CHECKBOX:DLG_CAPTION:CB_COPY_ATTR\"\>Applies the border and shadow of the object to the caption frame.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	tit				0	sh	Defining Conditions				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	bm_id3145828				0	sh	\<bookmark_value\>logical expressions\</bookmark_value\>      \<bookmark_value\>formulating conditions\</bookmark_value\>      \<bookmark_value\>conditions; in fields and sections\</bookmark_value\>      \<bookmark_value\>fields;defining conditions\</bookmark_value\>      \<bookmark_value\>sections;defining conditions\</bookmark_value\>      \<bookmark_value\>variables; in conditions\</bookmark_value\>      \<bookmark_value\>user data;in conditions\</bookmark_value\>      \<bookmark_value\>databases;in conditions\</bookmark_value\>      \<bookmark_value\>hiding; database fields\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	hd_id3145828				0	sh	\<variable id=\"defining_conditions\"\>\<link href=\"text/swriter/01/04090200.xhp\"\>Defining Conditions\</link\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3145242				0	sh	Conditions are logical expressions that you can use to control the display of \<link href=\"text/swriter/01/04090000.xhp\"\>fields\</link\> and \<link href=\"text/swriter/01/04020000.xhp\"\>sections\</link\> in your document. Although the following examples apply to fields, they also apply to sections.				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3147171				0	sh	You can define conditions for the following field types:				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3151185				0	sh	Conditional text: displays text A if the condition is true, or text B if the condition is false.				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3149289				0	sh	Hidden text: hides the contents of the field if the condition is true.				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3145412				0	sh	Hidden paragraph: hides the paragraph if the condition is true.				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3147515				0	sh	Any record and next record: controls the access to database records.				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3149802	18			0	sh	The simplest way to define a condition is to type the logical expression directly in a \<emph\>Condition \</emph\>box using the following values:				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3153677				0	sh	TRUE				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3152960				0	sh	The condition is always met. You can also enter any value not equal to 0 as the conditional text.				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3155900				0	sh	FALSE				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3154191				0	sh	The condition is not met. You can also enter the value 0.				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3147090	23			0	sh	If you leave the \<emph\>Condition \</emph\>box empty, the condition is interpreted as not being met.				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3148980				0	sh	When you define a condition, use the same \<link href=\"text/swriter/02/14020000.xhp\"\>elements\</link\> for defining a formula, namely comparative operators, mathematical and statistical functions, number formats, variables and constants.				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3153638				0	sh	You can use the following types of variables when you define a condition:				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3155135				0	sh	Predefined \<link href=\"text/swriter/02/14020000.xhp\"\>$[officename] variables\</link\> that use statistics on document properties				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3156273				0	sh	Custom variables, that are a created with the "Set variable" field				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3149174				0	sh	Variables based on user data				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3145781				0	sh	Variables based on the contents of database fields				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3155916				0	sh	You cannot use internal variables, such as page and chapter numbers, in condition expression.				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	hd_id3151375				0	sh	Conditions and Variables				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3150122				0	sh	The following examples use a variable called "x":				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3147417				0	sh	x == 1 or x EQ 1				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3147500				0	sh	The condition is true if "x" is equal to 1.				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3145259				0	sh	x != 1 or x NEQ 1				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3150551				0	sh	The condition is true if "x" does not equal 1.				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3147749				0	sh	sinx == 0				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3146345				0	sh	The condition is true if "x" is a multiple of pi.				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3149846				0	sh	To use comparative operators with strings, the operands must be bounded by double quotation marks:				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3151078				0	sh	x == "ABC" or x EQ "ABC"				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3150162				0	sh	Checks if variable "x" contains (true) the "ABC" string, or not (false).				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3153301				0	sh	x == "" or x EQ ""				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3156120				0	sh	or				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3156133				0	sh	!x or NOT x				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3156112				0	sh	Checks if the variable "x" contains an empty string.				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3150097				0	sh	The "equal" comparative operator must be represented by two equal signs (==) in a condition. For example, if you define a variable "x" with the value of 1, you can enter the condition as x==1.				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	hd_id3148791				0	sh	User Data				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3150028				0	sh	You can include user data when you define conditions. To change your user data, choose \<emph\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - $[officename] - User data\</emph\>. User data must be entered in the form of strings. You can query the user data with "==" (EQ), "!=" (NEQ), or "!"(NOT).				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3153124				0	sh	The following table lists user data variables and their meanings:				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3149632				0	sh	Variable				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3150662				0	sh	Meaning				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3154026				0	sh	user_firstname				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3149953				0	sh	First name				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3147272				0	sh	user_lastname				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3149601				0	sh	Last name				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3150770				0	sh	user_initials				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090200.xhp	0	help	par_id3155529				0	sh	Initials				20181231 09:50:43
