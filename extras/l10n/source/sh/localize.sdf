helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN10555				0	sh	Never include country/region				20181231 09:50:43
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN10559				0	sh	\<ahelp hid=\".\"\>Excludes country or regional information from the address block.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN1055C				0	sh	Always include country/region				20181231 09:50:43
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN10560				0	sh	\<ahelp hid=\".\"\>Includes country or regional information in the address block.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN10563				0	sh	Only include country/region if it is not:				20181231 09:50:43
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN10567				0	sh	\<ahelp hid=\".\"\>Only includes country or regional information in the address block if the value differs from the value that you enter in the text box.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN10651				0	sh	\<ahelp hid=\".\"\>Enter the country/region string that shall not be printed.\</ahelp\>				20181231 09:50:43
