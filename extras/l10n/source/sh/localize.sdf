helpcontent2	source\text\smath\04\01020000.xhp	0	help	par_id3150345				0	sh	A list of the shortcut keys specific to creating formulas is contained in this section.				20181231 09:50:43
helpcontent2	source\text\smath\04\01020000.xhp	0	help	par_id3150203				0	sh	The general \<link href=\"text/shared/04/01010000.xhp\" name=\"shortcut keys in $[officename]\"\>shortcut keys in $[officename]\</link\> also apply.				20181231 09:50:43
helpcontent2	source\text\smath\04\01020000.xhp	0	help	hd_id3148870				0	sh	Shortcut Keys for Formula Functions				20181231 09:50:43
helpcontent2	source\text\smath\04\01020000.xhp	0	help	par_id3153246	19			0	sh	The following shortcut keys correspond to commands in the \<emph\>Edit\</emph\> and \<emph\>View \</emph\>menus.				20181231 09:50:43
helpcontent2	source\text\smath\04\01020000.xhp	0	help	hd_id3146324				0	sh	F3				20181231 09:50:43
helpcontent2	source\text\smath\04\01020000.xhp	0	help	par_id3150537				0	sh	Next Error				20181231 09:50:43
helpcontent2	source\text\smath\04\01020000.xhp	0	help	hd_id3155620				0	sh	Shift+F3				20181231 09:50:43
helpcontent2	source\text\smath\04\01020000.xhp	0	help	par_id3149355				0	sh	Previous Error				20181231 09:50:43
helpcontent2	source\text\smath\04\01020000.xhp	0	help	hd_id3153808				0	sh	F4				20181231 09:50:43
helpcontent2	source\text\smath\04\01020000.xhp	0	help	par_id3149871				0	sh	Next Marker (Placeholder)				20181231 09:50:43
helpcontent2	source\text\smath\04\01020000.xhp	0	help	hd_id3150396				0	sh	Shift+F4				20181231 09:50:43
helpcontent2	source\text\smath\04\01020000.xhp	0	help	par_id3151390				0	sh	Previous Marker (Placeholder)				20181231 09:50:43
helpcontent2	source\text\smath\04\01020000.xhp	0	help	hd_id3154554				0	sh	F9				20181231 09:50:43
helpcontent2	source\text\smath\04\01020000.xhp	0	help	par_id3153003				0	sh	Update				20181231 09:50:43
helpcontent2	source\text\smath\04\01020000.xhp	0	help	hd_id3153732				0	sh	Navigation in the Elements Window				20181231 09:50:43
helpcontent2	source\text\smath\04\01020000.xhp	0	help	hd_id3155927				0	sh	Left or right arrow				20181231 09:50:43
helpcontent2	source\text\smath\04\01020000.xhp	0	help	par_id3145249				0	sh	Move left or right to the next category or function.				20181231 09:50:43
helpcontent2	source\text\smath\04\01020000.xhp	0	help	hd_id3150928				0	sh	Enter key				20181231 09:50:43
helpcontent2	source\text\smath\04\01020000.xhp	0	help	par_id3148390				0	sh	Selects a category (within the category section) or inserts a function in the \<emph\>Commands\</emph\> window (within the function section).				20181231 09:50:43
helpcontent2	source\text\smath\04\01020000.xhp	0	help	hd_id3155988				0	sh	Tab				20181231 09:50:43
helpcontent2	source\text\smath\04\01020000.xhp	0	help	par_id3153723				0	sh	Jump from the first category item to the first function of the category.				20181231 09:50:43
