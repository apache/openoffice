helpcontent2	source\text\shared\explorer\database\05020100.xhp	0	help	hd_id3145272				0	sh	Set Default				20181231 09:50:43
helpcontent2	source\text\shared\explorer\database\05020100.xhp	0	help	par_id3154320				0	sh	\<ahelp hid=\"DBACCESS_RADIOBUTTON_DLG_REL_PROPERTIES_RB_CASC_DEL_DEFAULT\"\>If you delete the corresponding primary key, a set value will be set to all external key fields.\</ahelp\>				20181231 09:50:43
