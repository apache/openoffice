helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3154330				0	sh	<SDFIELD TYPE=DOCINFO SUBTYPE=CHANGE FORMAT=DATE SDNUM="1031;1031;NN DD MMM, YY">Mo 23 Feb, 98</SDFIELD>				20181231 09:50:43
helpcontent2	source\text\swriter\01\02150000.xhp	0	help	tit				0	sh	Footnote/Endnote				20181231 09:50:43
helpcontent2	source\text\swriter\01\02150000.xhp	0	help	hd_id3143276				0	sh	\<link href=\"text/swriter/01/02150000.xhp\" name=\"Edit Footnotes\"\>Footnote/Endnote\</link\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\02150000.xhp	0	help	par_id3149097				0	sh	\<variable id=\"fusstext\"\>\<ahelp hid=\".uno:EditFootnote\"\>Edits the selected footnote or endnote anchor. Click in front of the footnote or endnote, and then choose this command.\</ahelp\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\02150000.xhp	0	help	par_id3149035				0	sh	To edit the text of a footnote or endnote, click in the footnote area at the bottom of the page, or at the end of the document.				20181231 09:50:43
helpcontent2	source\text\swriter\01\02150000.xhp	0	help	par_id3145776				0	sh	To quickly jump to the footnote or endnote text, click the anchor for note in the document. You can also position the cursor in front of or behind the marker, and then press Ctrl+Shift+PgDn. To jump back to the anchor for the note, press PgUp.				20181231 09:50:43
helpcontent2	source\text\swriter\01\02150000.xhp	0	help	hd_id3155916				0	sh	Numbering				20181231 09:50:43
helpcontent2	source\text\swriter\01\02150000.xhp	0	help	par_id3151373				0	sh	Select the numbering type for the footnote or endnote.				20181231 09:50:43
helpcontent2	source\text\swriter\01\02150000.xhp	0	help	hd_id3150685				0	sh	Auto				20181231 09:50:43
