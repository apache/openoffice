helpcontent2	source\text\simpress\guide\table_insert.xhp	0	help	par_id0916200803551632				0	sh	\<ahelp hid=\".\" visibility=\"hidden\"\>The cell contents are aligned at the bottom of the cells.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\simpress\guide\table_insert.xhp	0	help	par_idN10626				0	sh	\<ahelp hid=\".\" visibility=\"hidden\"\>Selects the current table.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\simpress\guide\table_insert.xhp	0	help	par_id0916200803551734				0	sh	\<ahelp hid=\".\" visibility=\"hidden\"\>Choose commands for the selected or all rows.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\simpress\guide\table_insert.xhp	0	help	par_id0916200804080035				0	sh	\<ahelp hid=\".\" visibility=\"hidden\"\>Distributes the height of the selected or all rows to the same size. The height of the table is not changed.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\simpress\guide\table_insert.xhp	0	help	par_id0916200804080063				0	sh	\<ahelp hid=\".\" visibility=\"hidden\"\>If currently no cell is selected, all rows will be selected. If currently cells are selected, all rows containing the selected cells will be selected.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\simpress\guide\table_insert.xhp	0	help	par_id091620080408008				0	sh	\<ahelp hid=\".\" visibility=\"hidden\"\>If currently no cell is selected, a new row will be inserted at the bottom of the table. If currently cells are selected, as many new rows as the selection has will be inserted below the selection.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\simpress\guide\table_insert.xhp	0	help	par_id0916200804080050				0	sh	\<ahelp hid=\".\" visibility=\"hidden\"\>All rows of the current selection will be deleted.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\simpress\guide\table_insert.xhp	0	help	par_id0916200804163012				0	sh	\<ahelp hid=\".\" visibility=\"hidden\"\>Choose commands for the selected or all columns.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\simpress\guide\table_insert.xhp	0	help	par_id0916200804163092				0	sh	\<ahelp hid=\".\" visibility=\"hidden\"\>Distributes the width of the selected or all columns to the same size. The width of the table is not changed.\</ahelp\>				20181231 09:50:43
