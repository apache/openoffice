helpcontent2	source\text\scalc\01\func_days.xhp	0	help	hd_id3151328				0	sh	\<variable id=\"days\"\>\<link href=\"text/scalc/01/func_days.xhp\"\>DAYS\</link\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3155139				0	sh	\<ahelp hid=\"HID_FUNC_TAGE\"\>Calculates the difference between two date values.\</ahelp\> The result returns the number of days between the two days.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	hd_id3155184				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3149578				0	sh	DAYS(Date2; Date1)				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3151376				0	sh	\<emph\>Date1\</emph\> is the start date, \<emph\>Date2\</emph\> is the end date. If \<emph\>Date2\</emph\> is an earlier date than \<emph\>Date1\</emph\> the result is a negative number.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	hd_id3151001				0	sh	Examples				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3159101				0	sh	=DAYS("2010-01-01"; NOW()) returns the number of days from today until January 1, 2010.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3163720				0	sh	=DAYS("1990-10-10";"1980-10-10") returns 3652 days.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12080700.xhp	0	help	tit				0	sh	Show Details (Pivot Table)				20181231 09:50:43
helpcontent2	source\text\scalc\01\12080700.xhp	0	help	hd_id3344523				0	sh	\<link href=\"text/scalc/01/12080700.xhp\"\>Show Details (Pivot Table)\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12080700.xhp	0	help	par_id871303				0	sh	\<ahelp hid=\".\"\>Inserts a new "drill-down" sheet with more information about the current pivot table cell. You can also double-click a pivot table cell to insert the "drill-down" sheet. The new sheet shows a subset of rows from the original data source that constitutes the result data displayed in the current cell.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12080700.xhp	0	help	par_id7132480				0	sh	Hidden items are not evaluated, the rows for the hidden items are included. Show Details is available only for pivot tables that are based on cell ranges or database data.				20181231 09:50:43
