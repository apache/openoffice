helpcontent2	source\text\scalc\01\05030400.xhp	0	help	hd_id3147264				0	sh	\<link href=\"text/scalc/01/05030400.xhp\" name=\"Show\"\>Show\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\05030400.xhp	0	help	par_id3150447				0	sh	\<ahelp hid=\".uno:ShowColumn\"\>Choose this command to show previously hidden rows or columns.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\05030400.xhp	0	help	par_id3155131				0	sh	To show a column or row, select the range of rows or columns containing the hidden elements, then choose \<emph\>Format - Row - Show\</emph\> or \<emph\>Format - Column - Show\</emph\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\05030400.xhp	0	help	par_id3145748				0	sh	To show all hidden cells, first click in the field in the upper left corner. This selects all cells of the table.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	tit				0	sh	TIME 				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	bm_id3154073				0	sh	\<bookmark_value\>TIME function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	hd_id3154073				0	sh	\<variable id=\"time\"\>\<link href=\"text/scalc/01/func_time.xhp\"\>TIME\</link\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3145762				0	sh	\<ahelp hid=\"HID_FUNC_ZEIT\"\>TIME returns the current time value from values for hours, minutes and seconds.\</ahelp\> This function can be used to convert a time based on these three elements to a decimal time value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	hd_id3155550				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3154584				0	sh	TIME(Hour; Minute; Second)				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3152904				0	sh	Use an integer to set the \<emph\>Hour\</emph\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3151346				0	sh	Use an integer to set the \<emph\>Minute\</emph\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3151366				0	sh	Use an integer to set the \<emph\>Second\</emph\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	hd_id3145577				0	sh	Examples				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3156076				0	sh	\<item type=\"input\"\>=TIME(0;0;0)\</item\> returns 00:00:00				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3156090				0	sh	\<item type=\"input\"\>=TIME(4;20;4)\</item\> returns 04:20:04				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	tit				0	sh	Statistical Functions Part Two				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3154372				0	sh	\<variable id=\"fh\"\>\<link href=\"text/scalc/01/04060182.xhp\" name=\"Statistical Functions Part Two\"\>Statistical Functions Part Two\</link\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3145388				0	sh	\<bookmark_value\>FINV function\</bookmark_value\>         \<bookmark_value\>inverse F probability distribution\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3145388				0	sh	FINV				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155089				0	sh	\<ahelp hid=\"HID_FUNC_FINV\"\>Returns the inverse of the F probability distribution.\</ahelp\> The F distribution is used for F tests in order to set the relation between two differing data sets.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3153816				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153068				0	sh	FINV(Number; DegreesFreedom1; DegreesFreedom2)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146866	6			0	sh	            \<emph\>Number\</emph\> is probability value for which the inverse F distribution is to be calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153914	7			0	sh	            \<emph\>DegreesFreedom1\</emph\> is the number of degrees of freedom in the numerator of the F distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3148607	8			0	sh	            \<emph\>DegreesFreedom2\</emph\> is the number of degrees of freedom in the denominator of the F distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3156021				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145073	10			0	sh	            \<item type=\"input\"\>=FINV(0.5;5;10)\</item\> yields 0.93.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3150888				0	sh	\<bookmark_value\>FISHER function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150888				0	sh	FISHER				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155384				0	sh	\<ahelp hid=\"HID_FUNC_FISHER\"\>Returns the Fisher transformation for x and creates a function close to a normal distribution.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3149898				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3143220				0	sh	FISHER(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3159228	16			0	sh	            \<emph\>Number\</emph\> is the value to be transformed.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3154763				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3149383	18			0	sh	            \<item type=\"input\"\>=FISHER(0.5)\</item\> yields 0.55.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3155758				0	sh	\<bookmark_value\>FISHERINV function\</bookmark_value\>         \<bookmark_value\>inverse of Fisher transformation\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3155758				0	sh	FISHERINV				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154734				0	sh	\<ahelp hid=\"HID_FUNC_FISHERINV\"\>Returns the inverse of the Fisher transformation for x and creates a function close to a normal distribution.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3155755				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146108				0	sh	FISHERINV(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145115	24			0	sh	            \<emph\>Number\</emph\> is the value that is to undergo reverse-transformation.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3155744				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150432	26			0	sh	            \<item type=\"input\"\>=FISHERINV(0.5)\</item\> yields 0.46.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3151390				0	sh	\<bookmark_value\>FTEST function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3151390				0	sh	FTEST				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150534				0	sh	\<ahelp hid=\"HID_FUNC_FTEST\"\>Returns the result of an F test.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3166466				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153024				0	sh	FTEST(Data1; Data2)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150032	32			0	sh	            \<emph\>Data1\</emph\> is the first record array.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153018	33			0	sh	            \<emph\>Data2\</emph\> is the second record array.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3153123				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3159126	35			0	sh	            \<item type=\"input\"\>=FTEST(A1:A30;B1:B12)\</item\> calculates whether the two data sets are different in their variance and returns the probability that both sets could have come from the same total population.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3150372				0	sh	\<bookmark_value\>FDIST function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150372				0	sh	FDIST				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3152981				0	sh	\<ahelp hid=\"HID_FUNC_FVERT\"\>Calculates the values of an F distribution.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150484				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145826				0	sh	FDIST(Number; DegreesFreedom1; DegreesFreedom2)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150461	41			0	sh	            \<emph\>Number\</emph\> is the value for which the F distribution is to be calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150029	42			0	sh	            \<emph\>degreesFreedom1\</emph\> is the degrees of freedom in the numerator in the F distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146877	43			0	sh	            \<emph\>degreesFreedom2\</emph\> is the degrees of freedom in the denominator in the F distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3147423				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150696	45			0	sh	            \<item type=\"input\"\>=FDIST(0.8;8;12)\</item\> yields 0.61.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id0119200903223192				0	sh	\<bookmark_value\>GAMMA function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id0119200903205393				0	sh	GAMMA				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id0119200903205379				0	sh	\<ahelp hid=\".\"\>Returns the Gamma function value.\</ahelp\> Note that GAMMAINV is not the inverse of GAMMA, but of GAMMADIST.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id0119200903271613				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id0119200903271614				0	sh	            \<emph\>Number\</emph\> is the number for which the Gamma function value is to be calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3154841				0	sh	\<bookmark_value\>GAMMAINV function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3154841				0	sh	GAMMAINV				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153932				0	sh	\<ahelp hid=\"HID_FUNC_GAMMAINV\"\>Returns the inverse of the Gamma cumulative distribution GAMMADIST.\</ahelp\> This function allows you to search for variables with different distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3149949				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155828				0	sh	GAMMAINV(Number; Alpha; Beta)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145138	51			0	sh	            \<emph\>Number\</emph\> is the probability value for which the inverse Gamma distribution is to be calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3152785	52			0	sh	            \<emph\>Alpha\</emph\> is the parameter Alpha of the Gamma distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154561	53			0	sh	            \<emph\>Beta\</emph\> is the parameter Beta of the Gamma distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3148734				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153331	55			0	sh	            \<item type=\"input\"\>=GAMMAINV(0.8;1;1)\</item\> yields 1.61.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3154806				0	sh	\<bookmark_value\>GAMMALN function\</bookmark_value\>         \<bookmark_value\>natural logarithm of Gamma function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3154806				0	sh	GAMMALN				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3148572				0	sh	\<ahelp hid=\"HID_FUNC_GAMMALN\"\>Returns the natural logarithm of the Gamma function: G(x).\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3152999				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153112				0	sh	GAMMALN(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154502	61			0	sh	            \<emph\>Number\</emph\> is the value for which the natural logarithm of the Gamma function is to be calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3153568				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153730	63			0	sh	            \<item type=\"input\"\>=GAMMALN(2)\</item\> yields 0.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3150132				0	sh	\<bookmark_value\>GAMMADIST function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150132				0	sh	GAMMADIST				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155931				0	sh	\<ahelp hid=\"HID_FUNC_GAMMAVERT\"\>Returns the values of a Gamma distribution.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id0119200903333675				0	sh	The inverse function is GAMMAINV.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3147373				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155436				0	sh	GAMMADIST(Number; Alpha; Beta; C)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150571	69			0	sh	            \<emph\>Number\</emph\> is the value for which the Gamma distribution is to be calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145295	70			0	sh	            \<emph\>Alpha\</emph\> is the parameter Alpha of the Gamma distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3151015	71			0	sh	            \<emph\>Beta\</emph\> is the parameter Beta of the Gamma distribution				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3157972	72			0	sh	            \<emph\>C\</emph\> (optional) = 0 or False calculates the density function \<emph\>C\</emph\> = 1 or True calculates the distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3149535				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145354	74			0	sh	            \<item type=\"input\"\>=GAMMADIST(2;1;1;1)\</item\> yields 0.86.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3150272				0	sh	\<bookmark_value\>GAUSS function\</bookmark_value\>         \<bookmark_value\>normal distribution; standard\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150272				0	sh	GAUSS				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3149030				0	sh	\<ahelp hid=\"HID_FUNC_GAUSS\"\>Returns the standard normal cumulative distribution.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id2059694				0	sh	It is GAUSS(x)=NORMSDIST(x)-0.5				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3153551				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155368				0	sh	GAUSS(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153228	80			0	sh	            \<emph\>Number\</emph\> is the value for which the value of the standard normal distribution is to be calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150691				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154867	82			0	sh	            \<item type=\"input\"\>=GAUSS(0.19)\</item\> = 0.08				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3148594	83			0	sh	            \<item type=\"input\"\>=GAUSS(0.0375)\</item\> = 0.01				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3148425				0	sh	\<bookmark_value\>GEOMEAN function\</bookmark_value\>         \<bookmark_value\>means;geometric\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3148425				0	sh	GEOMEAN				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3156257				0	sh	\<ahelp hid=\"HID_FUNC_GEOMITTEL\"\>Returns the geometric mean of a sample.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3147167				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153720				0	sh	GEOMEAN(Number1; Number2; ...Number30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3152585	89			0	sh	            \<emph\>Number1, Number2,...Number30\</emph\> are numeric arguments or ranges that represent a random sample.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3146146				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3149819	92			0	sh	            \<item type=\"input\"\>=GEOMEAN(23;46;69)\</item\> = 41.79. The geometric mean value of this random sample is therefore 41.79.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3152966				0	sh	\<bookmark_value\>TRIMMEAN function\</bookmark_value\>         \<bookmark_value\>means;of data set without margin data\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3152966				0	sh	TRIMMEAN				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3149716				0	sh	\<ahelp hid=\"HID_FUNC_GESTUTZTMITTEL\"\>Returns the mean of a data set without the Alpha percent of data at the margins.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3149281				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154821				0	sh	TRIMMEAN(Data; Alpha)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155834	98			0	sh	            \<emph\>Data\</emph\> is the array of data in the sample.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3156304	99			0	sh	            \<emph\>Alpha\</emph\> is the percentage of the marginal data that will not be taken into consideration.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3151180				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3156130	101			0	sh	            \<item type=\"input\"\>=TRIMMEAN(A1:A50; 0.1)\</item\> calculates the mean value of numbers in A1:A50, without taking into consideration the 5 percent of the values representing the highest values and the 5 percent of the values representing the lowest ones. The percentage numbers refer to the amount of the untrimmed mean value, not to the number of summands.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3153216				0	sh	\<bookmark_value\>ZTEST function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3153216				0	sh	ZTEST				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150758				0	sh	\<ahelp hid=\"HID_FUNC_GTEST\"\>Calculates the probability of observing a z-statistic greater than the one computed based on a sample.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150872				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153274				0	sh	ZTEST(Data; mu; Sigma)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3156109	107			0	sh	            \<emph\>Data\</emph\> is the given sample, drawn from a normally distributed population.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3149977	108			0	sh	            \<emph\>mu\</emph\> is the known mean of the population.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154740	109			0	sh	            \<emph\>Sigma\</emph\> (optional) is the known standard deviation of the population. If omitted, the standard deviation of the given sample is used.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id0305200911372999				0	sh	See also the \<link href=\"https://wiki.openoffice.org/wiki/Documentation/How_Tos/Calc:_ZTEST_function\"\>Wiki page\</link\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3153623				0	sh	\<bookmark_value\>HARMEAN function\</bookmark_value\>         \<bookmark_value\>means;harmonic\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3153623				0	sh	HARMEAN				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155102				0	sh	\<ahelp hid=\"HID_FUNC_HARMITTEL\"\>Returns the harmonic mean of a data set.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3146900				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3149287				0	sh	HARMEAN(Number1; Number2; ...Number30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154303	117			0	sh	            \<emph\>Number1,Number2,...Number30\</emph\> are up to 30 values or ranges, that can be used to calculate the harmonic mean.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3159179				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146093	120			0	sh	            \<item type=\"input\"\>=HARMEAN(23;46;69)\</item\> = 37.64. The harmonic mean of this random sample is thus 37.64				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3152801				0	sh	\<bookmark_value\>HYPGEOMDIST function\</bookmark_value\>         \<bookmark_value\>sampling without replacement\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3152801				0	sh	HYPGEOMDIST				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3159341				0	sh	\<ahelp hid=\"HID_FUNC_HYPGEOMVERT\"\>Returns the hypergeometric distribution.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3154697				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155388				0	sh	HYPGEOMDIST(X; NSample; Successes; NPopulation)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154933	126			0	sh	            \<emph\>X\</emph\> is the number of results achieved in the random sample.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153106	127			0	sh	            \<emph\>NSample\</emph\> is the size of the random sample.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146992	128			0	sh	            \<emph\>Successes\</emph\> is the number of possible results in the total population.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3148826	129			0	sh	            \<emph\>NPopulation \</emph\>is the size of the total population.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150529				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154904	131			0	sh	            \<item type=\"input\"\>=HYPGEOMDIST(2;2;90;100)\</item\> yields 0.81. If 90 out of 100 pieces of buttered toast fall from the table and hit the floor with the buttered side first, then if 2 pieces of buttered toast are dropped from the table, the probability is 81%, that both will strike buttered side first.				20181231 09:50:43
