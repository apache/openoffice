helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149171				0	sh	\<bookmark_value\>REPLACE function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149171				0	sh	REPLACE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148925				0	sh	\<ahelp hid=\"HID_FUNC_ERSETZEN\"\>Replaces part of a text string with a different text string.\</ahelp\> This function can be used to replace both characters and numbers (which are automatically converted to text). The result of the function is always displayed as text. If you intend to perform further calculations with a number which has been replaced by text, you will need to convert it back to a number using the \<link href=\"text/scalc/01/04060110.xhp\" name=\"VALUE\"\>VALUE\</link\> function.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3158426				0	sh	Any text containing numbers must be enclosed in quotation marks if you do not want it to be interpreted as a number and automatically converted to text.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149159				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147286				0	sh	REPLACE("Text"; Position; Length; "NewText")				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149797	27			0	sh	            \<emph\>Text\</emph\> refers to text of which a part will be replaced.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3166451	28			0	sh	            \<emph\>Position\</emph\> refers to the position within the text where the replacement will begin.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156040	29			0	sh	            \<emph\>Length\</emph\> is the number of characters in \<emph\>Text\</emph\> to be replaced.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3159188	30			0	sh	            \<emph\>NewText\</emph\> refers to the text which replaces \<emph\>Text\</emph\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146958				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154096	32			0	sh	            \<item type=\"input\"\>=REPLACE("1234567";1;1;"444")\</item\> returns "444234567". One character at position 1 is replaced by the complete \<item type=\"literal\"\>NewText\</item\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149741				0	sh	\<bookmark_value\>REPT function\</bookmark_value\>				20181231 09:50:43
