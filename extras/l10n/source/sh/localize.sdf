helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155437				0	sh	\<ahelp hid=\"HID_FUNC_NEGBINOMVERT\"\>Returns the negative binomial distribution.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3145351				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150935				0	sh	NEGBINOMDIST(X; R; SP)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153044				0	sh	\<emph\>X\</emph\> represents the value returned for unsuccessful tests.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151018				0	sh	\<emph\>R\</emph\> represents the value returned for successful tests.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148878				0	sh	\<emph\>SP\</emph\> is the probability of the success of an attempt.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149539				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148770				0	sh	\<item type=\"input\"\>=NEGBINOMDIST(1;1;0.5)\</item\> returns 0.25.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3155516				0	sh	\<bookmark_value\>NORMINV function\</bookmark_value\>\<bookmark_value\>normal distribution;inverse of\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155516				0	sh	NORMINV				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154634				0	sh	\<ahelp hid=\"HID_FUNC_NORMINV\"\>Returns the inverse of the normal cumulative distribution.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153227				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147534				0	sh	NORMINV(Number; Mean; StDev)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154950				0	sh	\<emph\>Number\</emph\> represents the probability value used to determine the inverse normal distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150690				0	sh	\<emph\>Mean\</emph\> represents the mean value in the normal distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148594				0	sh	\<emph\>StDev\</emph\> represents the standard deviation of the normal distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155822				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153921				0	sh	\<item type=\"input\"\>=NORMINV(0.9;63;5)\</item\> returns 69.41. If the average egg weighs 63 grams with a standard deviation of 5, then there will be 90% probability that the egg will not be heavier than 69.41g grams.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153722				0	sh	\<bookmark_value\>NORMDIST function\</bookmark_value\>\<bookmark_value\>density function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153722				0	sh	NORMDIST				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150386				0	sh	\<ahelp hid=\"HID_FUNC_NORMVERT\"\>Returns the density function or the normal cumulative distribution.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3083282				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150613				0	sh	NORMDIST(Number; Mean; StDev; C)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149820				0	sh	\<emph\>Number\</emph\> is the value of the distribution based on which the normal distribution is to be calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146063				0	sh	\<emph\>Mean\</emph\> is the mean value of the distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156295				0	sh	\<emph\>StDev\</emph\> is the standard deviation of the distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145080				0	sh	\<emph\>C\</emph\> is optional. \<emph\>C\</emph\> = 0 calculates the density function, \<emph\>C\</emph\> = 1 calculates the distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152972				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149283				0	sh	\<item type=\"input\"\>=NORMDIST(70;63;5;0)\</item\> returns 0.03.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149448				0	sh	\<item type=\"input\"\>=NORMDIST(70;63;5;1)\</item\> returns 0.92.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3152934				0	sh	\<bookmark_value\>PEARSON function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152934				0	sh	PEARSON				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153216				0	sh	\<ahelp hid=\"HID_FUNC_PEARSON\"\>Returns the Pearson product moment correlation coefficient r.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147081				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156133				0	sh	PEARSON(Data1; Data2)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151272				0	sh	\<emph\>Data1\</emph\> represents the array of the first data set.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153279				0	sh	\<emph\>Data2\</emph\> represents the array of the second data set.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147567				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151187				0	sh	\<item type=\"input\"\>=PEARSON(A1:A30;B1:B30)\</item\> returns the Pearson correlation coefficient of both data sets.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3152806				0	sh	\<bookmark_value\>PHI function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152806				0	sh	PHI				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150254				0	sh	\<ahelp hid=\"HID_FUNC_PHI\"\>Returns the values of the distribution function for a standard normal distribution.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154748				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149976				0	sh	PHI(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156108				0	sh	\<emph\>Number\</emph\> represents the value based on which the standard normal distribution is calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153621				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155849				0	sh	\<item type=\"input\"\>=PHI(2.25) \</item\>= 0.03				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3143236				0	sh	\<item type=\"input\"\>=PHI(-2.25)\</item\> = 0.03				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149286				0	sh	\<item type=\"input\"\>=PHI(0)\</item\> = 0.4				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153985				0	sh	\<bookmark_value\>POISSON function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153985				0	sh	POISSON				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154298				0	sh	\<ahelp hid=\"HID_FUNC_POISSON\"\>Returns the Poisson distribution.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3159183				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146093				0	sh	POISSON(Number; Mean; C)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147253				0	sh	\<emph\>Number\</emph\> represents the value based on which the Poisson distribution is calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151177				0	sh	\<emph\>Mean\</emph\> represents the middle value of the Poisson distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149200				0	sh	\<emph\>C\</emph\> (optional) = 0 or False calculates the density function; \<emph\>C\</emph\> = 1 or True calculates the distribution. When omitted, the default value True is inserted when you save the document, for best compatibility with other programs and older versions of %PRODUCTNAME.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3159347				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150113				0	sh	\<item type=\"input\"\>=POISSON(60;50;1)\</item\> returns 0.93.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153100				0	sh	\<bookmark_value\>PERCENTILE function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153100				0	sh	PERCENTILE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154940				0	sh	\<ahelp hid=\"HID_FUNC_QUANTIL\"\>Returns the alpha-percentile of data values in an array.\</ahelp\> A percentile returns the scale value for a data series which goes from the smallest (Alpha=0) to the largest value (alpha=1) of a data series. For \<item type=\"literal\"\>Alpha\</item\> = 25%, the percentile means the first quartile; \<item type=\"literal\"\>Alpha\</item\> = 50% is the MEDIAN.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150531				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148813				0	sh	PERCENTILE(Data; Alpha)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153054				0	sh	\<emph\>Data\</emph\> represents the array of data.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154212				0	sh	\<emph\>Alpha\</emph\> represents the percentage of the scale between 0 and 1.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154290				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159147				0	sh	\<item type=\"input\"\>=PERCENTILE(A1:A50;0.1)\</item\> represents the value in the data set, which equals 10% of the total data scale in A1:A50.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148807				0	sh	\<bookmark_value\>PERCENTRANK function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148807				0	sh	PERCENTRANK				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153573				0	sh	\<ahelp hid=\"HID_FUNC_QUANTILSRANG\"\>Returns the percentage rank of a value in a sample.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147512				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147238				0	sh	PERCENTRANK(Data; Value)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154266				0	sh	\<emph\>Data\</emph\> represents the array of data in the sample.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148475				0	sh	\<emph\>Value\</emph\> represents the value whose percentile rank must be determined.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155364				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149163				0	sh	\<item type=\"input\"\>=PERCENTRANK(A1:A50;50)\</item\> returns the percentage rank of the value 50 from the total range of all values found in A1:A50. If 50 falls outside the total range, an error message will appear.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3166442				0	sh	\<bookmark_value\>QUARTILE function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3166442				0	sh	QUARTILE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146958				0	sh	\<ahelp hid=\"HID_FUNC_QUARTILE\"\>Returns the quartile of a data set.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152942				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153684				0	sh	QUARTILE(Data; Type)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153387				0	sh	\<emph\>Data\</emph\> represents the array of data in the sample.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155589				0	sh	\<emph\>Type\</emph\> represents the type of quartile. (0 = MIN, 1 = 25%, 2 = 50% (MEDIAN), 3 = 75% and 4 = MAX.)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149103				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159276				0	sh	\<item type=\"input\"\>=QUARTILE(A1:A50;2)\</item\> returns the value of which 50% of the scale corresponds to the lowest to highest values in the range A1:A50.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_today.xhp	0	help	tit				0	sh	TODAY				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_today.xhp	0	help	bm_id3145659				0	sh	\<bookmark_value\>TODAY function\</bookmark_value\>				20181231 09:50:43
