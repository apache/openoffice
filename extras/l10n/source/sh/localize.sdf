helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id2301400				0	sh	Returns 0 if no numeric value and no error was encountered in the cell range(s) passed as cell reference(s). Text cells are ignored by MIN() and MAX(). The functions MINA() and MAXA() return 0 if no value (numeric or text) and no error was encountered. Passing a literal string argument to MIN() or MAX(), e.g. MIN("string"), still results in an error.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154651				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146964				0	sh	MIN(Number1; Number2; ...Number30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153486				0	sh	\<emph\>Number1; Number2;...Number30\</emph\> are numerical values or ranges.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155523				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154734				0	sh	\<item type=\"input\"\>=MIN(A1:B100)\</item\> returns the smallest value in the list.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3147504				0	sh	\<bookmark_value\>MINA function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147504				0	sh	MINA				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147249				0	sh	\<ahelp hid=\"HID_FUNC_MINA\"\>Returns the minimum value in a list of arguments. Here you can also enter text. The value of the text is 0.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id4294564				0	sh	The functions MINA() and MAXA() return 0 if no value (numeric or text) and no error was encountered.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150435				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153336				0	sh	MINA(Value1; Value2; ... Value30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146098				0	sh	\<emph\>Value1; Value2;...Value30\</emph\> are values or ranges. Text has the value of 0.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148743				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147401				0	sh	\<item type=\"input\"\>=MINA(1;"Text";20)\</item\> returns 0.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147295				0	sh	\<item type=\"input\"\>=MINA(A1:B100)\</item\> returns the smallest value in the list.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3166465				0	sh	\<bookmark_value\>AVEDEV function\</bookmark_value\>\<bookmark_value\>averages;statistical functions\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3166465				0	sh	AVEDEV				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150373				0	sh	\<ahelp hid=\"HID_FUNC_MITTELABW\"\>Returns the average of the absolute deviations of data points from their mean.\</ahelp\> Displays the diffusion in a data set.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150038				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145636				0	sh	AVEDEV(Number1; Number2; ...Number30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3157871				0	sh	\<emph\>Number1, Number2,...Number30\</emph\> are values or ranges that represent a sample. Each number can also be replaced by a reference.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149725				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153122				0	sh	            \<item type=\"input\"\>=AVEDEV(A1:A50)\</item\>         				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3145824				0	sh	\<bookmark_value\>AVERAGE function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3145824				0	sh	AVERAGE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150482				0	sh	\<ahelp hid=\"HID_FUNC_MITTELWERT\"\>Returns the average of the arguments.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3146943				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154679				0	sh	AVERAGE(Number1; Number2; ...Number30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150741				0	sh	\<emph\>Number1; Number2;...Number 0\</emph\> are numerical values or ranges.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153039				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151232				0	sh	\<item type=\"input\"\>=AVERAGE(A1:A50)\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148754				0	sh	\<bookmark_value\>AVERAGEA function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148754				0	sh	AVERAGEA				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145138				0	sh	\<ahelp hid=\"HID_FUNC_MITTELWERTA\"\>Returns the average of the arguments. The value of a text is 0.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153326				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149734				0	sh	AVERAGEA(Value1; Value2; ... Value30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155260				0	sh	\<emph\>Value1; Value2;...Value30\</emph\> are values or ranges. Text has the value of 0.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149504				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150864				0	sh	\<item type=\"input\"\>=AVERAGEA(A1:A50)\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148754K1				0	sh	\<bookmark_value\>AVERAGEIF function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148754K1				0	sh	AVERAGEIF				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145138K1				0	sh	\<ahelp hid=\"HID_FUNC_MITTELWERTB\"\>Average the values of cells in a range that meet a criteria.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153326K1				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149734K1				0	sh	AVERAGEIF( Reference R ; Criterion C [ ; Reference A ] )				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155260K1				0	sh	 If reference A is omitted, averages the values of cells in the reference range R that meet the Criterion C. If reference A is given, averages the values of cells of a range that is constructed using the top left cell of reference A and applying the dimensions, shape and size, of reference R.  Does not accept constant values as reference parameters.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145139K1				0	sh	If no cell in range R matches the Criterion C, an Error is returned. If no Numbers are in the range to be averaged, an Error is returned.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149504K1				0	sh	Examples				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150864K1				0	sh	\<item type=\"input\"\>=AVERAGEIF(A1:A50;">"0)\</item\>will return the average of A1:A50 of all positive values in the range.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148754K2				0	sh	\<bookmark_value\>AVERAGEIFS function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148754K2				0	sh	AVERAGEIFS				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145138K2				0	sh	\<ahelp hid=\"HID_FUNC_MITTELWERTC\"\>Average the values of cells that meet multiple criteria in multiple ranges.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153326K2				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149734K2				0	sh	AVERAGEIFS( Reference A ; Reference R1 ; Criterion C1 [ ; Reference R2 ; Criterion C2 ]... )				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155260K2				0	sh	Averages the values of cells in the reference range A that meet the Criterion C1 in the reference range R1 and the Criterion C2 in the reference range R2, and so on.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145139K2				0	sh	All reference ranges shall have the same dimension and size, else an Error is returned. A logical AND is applied between each array result of each selection; a cell of reference range A is evaluated only if the same position in each array is the result of a Criterion match. If no numbers are in the result set to be averaged, an Error is returned.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149504K2				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150864K2				0	sh	\<item type=\"input\"\>=AVERAGEIFS(A1:A50;B1:B25;">"0)\</item\>+will return the average of A1:A50 if all cells in the range B1 to B25 are greater than 0.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153933				0	sh	\<bookmark_value\>MODE function\</bookmark_value\>\<bookmark_value\>most common value\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153933				0	sh	MODE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153085				0	sh	\<ahelp hid=\"HID_FUNC_MODALWERT\"\>Returns the most common value in a data set.\</ahelp\> If there are several values with the same frequency, it returns the smallest value. An error occurs when a value doesn't appear twice.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153003				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155950				0	sh	MODE(Number1; Number2; ...Number30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150337				0	sh	\<emph\>Number1; Number2;...Number30\</emph\> are numerical values or ranges.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153571				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153733				0	sh	\<item type=\"input\"\>=MODE(A1:A50)\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3149879				0	sh	\<bookmark_value\>NEGBINOMDIST function\</bookmark_value\>\<bookmark_value\>negative binomial distribution\</bookmark_value\>				20181231 09:50:43
