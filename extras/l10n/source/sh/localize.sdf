helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903061174				0	sh	Information units "bit" and "byte" may also be prefixed by one of the following IEC 60027-2 / IEEE 1541 prefixes:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903090966				0	sh	ki kibi 1024				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903090958				0	sh	Mi mebi 1048576				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903090936				0	sh	Gi gibi 1073741824				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903090975				0	sh	Ti tebi 1099511627776				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903090930				0	sh	Pi pebi 1125899906842620				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903091070				0	sh	Ei exbi 1152921504606850000				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903091097				0	sh	Zi zebi 1180591620717410000000				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903091010				0	sh	Yi yobi 1208925819614630000000000				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3146125				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3153695				0	sh	CONVERT_ADD(Number; "FromUnit"; "ToUnit")				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3147522	211			0	sh	            \<emph\>Number\</emph\> is the number to be converted.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3154472	212			0	sh	            \<emph\>FromUnit\</emph\> is the unit from which conversion is taking place.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3153790	213			0	sh	            \<emph\>ToUnit\</emph\> is the unit to which conversion is taking place. Both units must be of the same type.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id09022809540918				0	sh	\<link href=\"https://wiki.openoffice.org/wiki/Documentation/How_Tos/Calc:_CONVERT_ADD_function\"\>Current list of CONVERT_ADD units in the OpenOffice.org Wiki.\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3156270				0	sh	Examples				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3156336	215			0	sh	            \<item type=\"input\"\>=CONVERT_ADD(10;"HP";"PS") \</item\>returns, rounded to two decimal places, 10.14. 10 HP equal 10.14 PS.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3154834	216			0	sh	            \<item type=\"input\"\>=CONVERT_ADD(10;"km";"mi") \</item\>returns, rounded to two decimal places, 6.21. 10 kilometers equal 6.21 miles. The k is the permitted prefix character for the factor 10^3.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	bm_id3147096				0	sh	\<bookmark_value\>FACTDOUBLE function\</bookmark_value\>         \<bookmark_value\>factorials;numbers with increments of two\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3147096				0	sh	FACTDOUBLE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3151309				0	sh	\<ahelp hid=\"HID_AAI_FUNC_FACTDOUBLE\"\>Returns the double factorial of a number.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3154666				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3155121				0	sh	FACTDOUBLE(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3158440	40			0	sh	Returns \<emph\>Number\</emph\>            \<emph\>!!\</emph\>, the double factorial of \<emph\>Number\</emph\>, where \<emph\>Number\</emph\> is an integer greater than or equal to zero.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id2480849				0	sh	For even numbers FACTDOUBLE(n) returns:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id4181951				0	sh	2*4*6*8* ... *n				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id2927335				0	sh	For odd numbers FACTDOUBLE(n) returns:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id2107303				0	sh	1*3*5*7* ... *n				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id4071779				0	sh	FACTDOUBLE(0) returns 1 by definition.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3154622				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id7844477				0	sh	            \<item type=\"input\"\>=FACTDOUBLE(5)\</item\> returns 15.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3154116	43			0	sh	            \<item type=\"input\"\>=FACTDOUBLE(6)\</item\> returns 48.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id6478469				0	sh	            \<item type=\"input\"\>=FACTDOUBLE(0)\</item\> returns 1.				20181231 09:50:43
