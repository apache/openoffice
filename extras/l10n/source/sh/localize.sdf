helpcontent2	source\text\scalc\01\04060105.xhp	0	help	tit				0	sh	Logical Functions				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	bm_id3153484				0	sh	\<bookmark_value\>logical functions\</bookmark_value\>      \<bookmark_value\>Function Wizard; logical\</bookmark_value\>      \<bookmark_value\>functions; logical functions\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3153484				0	sh	Logical Functions				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3149312				0	sh	\<variable id=\"logischtext\"\>This category contains the \<emph\>Logical\</emph\> functions.\</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	bm_id3147505				0	sh	\<bookmark_value\>AND function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3147505				0	sh	AND				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3153959				0	sh	\<ahelp hid=\"HID_FUNC_UND\"\>Returns TRUE if all arguments are TRUE.\</ahelp\> If one of the elements is FALSE, this function returns the FALSE value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3146100				0	sh	The arguments are either logical expressions themselves (TRUE, 1<5, 2+3=7, B8<10) that return logical values, or arrays (A1:C3) containing logical values.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3150538				0	sh	When a function expects a single value, but you entered a cell range, then the value from the cell range is taken that is in the same column or row as the formula.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3149128				0	sh	If the entered range is outside of the current column or row of the formula, the function returns the error value #VALUE!				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3150374				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3159123				0	sh	AND(LogicalValue1; LogicalValue2 ...LogicalValue30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3150038	33			0	sh	            \<emph\>LogicalValue1; LogicalValue2 ...LogicalValue30\</emph\> are conditions to be checked. All conditions can be either TRUE or FALSE. If a range is entered as a parameter, the function uses the value from the range that is in the current column or row. The result is TRUE if the logical value in all cells within the cell range is TRUE.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3149143				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3153123				0	sh	The logical values of entries 12<13; 14>12, and 7<6 are to be checked:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3145632	36			0	sh	            \<item type=\"input\"\>=AND(12<13;14>12;7<6)\</item\> returns FALSE.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3149946	60			0	sh	            \<item type=\"input\"\>=AND (FALSE;TRUE)\</item\> returns FALSE.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	bm_id3156256				0	sh	\<bookmark_value\>TRUE function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3156256				0	sh	TRUE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3155985				0	sh	\<ahelp hid=\"HID_FUNC_WAHR\"\>The logical value is set to TRUE.\</ahelp\> The TRUE() function does not require any arguments, and always returns the logical value TRUE.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3153717				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3152590				0	sh	TRUE()				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3147175				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3146148				0	sh	If A=TRUE and B=FALSE the following examples appear:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3083285	44			0	sh	           \<item type=\"input\"\>=AND(A;B)\</item\> returns FALSE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3083444	45			0	sh	            \<item type=\"input\"\>=OR(A;B)\</item\> returns TRUE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3154314	46			0	sh	            \<item type=\"input\"\>=NOT(AND(A;B))\</item\> returns TRUE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	bm_id3149015				0	sh	\<bookmark_value\>FALSE function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3149015				0	sh	FALSE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3149890				0	sh	\<ahelp hid=\"HID_FUNC_FALSCH\"\>Returns the logical value FALSE.\</ahelp\> The FALSE() function does not require any arguments, and always returns the logical value FALSE.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3146939				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3150030				0	sh	FALSE()				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3150697				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3154842	8			0	sh	            \<item type=\"input\"\>=FALSE()\</item\> returns FALSE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3147468	9			0	sh	            \<item type=\"input\"\>=NOT(FALSE())\</item\> returns TRUE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	bm_id3150141				0	sh	\<bookmark_value\>IF function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3150141				0	sh	IF				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3148740				0	sh	\<ahelp hid=\"HID_FUNC_WENN\"\>Specifies a logical test to be performed.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3153325				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3154558				0	sh	IF(Test; ThenValue; OtherwiseValue)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3149727	52			0	sh	            \<emph\>Test\</emph\> is any value or expression that can be TRUE or FALSE.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3155828	53			0	sh	            \<emph\>ThenValue\</emph\> (optional) is the value that is returned if the logical test is TRUE.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3154811	54			0	sh	            \<emph\>OtherwiseValue\</emph\> (optional) is the value that is returned if the logical test is FALSE.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_idN107FA				0	sh	            \<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>         				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3149507				0	sh	Examples				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3150867	57			0	sh	            \<item type=\"input\"\>=IF(A1>5;100;"too small")\</item\> If the value in A1 is higher than 5, the value 100 is entered in the current cell; otherwise, the text “too small” (without quotes) is entered.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	bm_id3155954				0	sh	\<bookmark_value\>NOT function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3155954				0	sh	NOT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3153570				0	sh	\<ahelp hid=\"HID_FUNC_NICHT\"\>Complements (inverts) a logical value.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3147372				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3157996				0	sh	NOT(LogicalValue)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3148766	16			0	sh	            \<emph\>LogicalValue\</emph\> is any value to be complemented.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3149884				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3150132	18			0	sh	            \<item type=\"input\"\>=NOT(A)\</item\>. If A=TRUE then NOT(A) will evaluate FALSE.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	bm_id3148394				0	sh	\<bookmark_value\>OR function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3148394				0	sh	OR				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3156060				0	sh	\<ahelp hid=\"HID_FUNC_ODER\"\>Returns TRUE if at least one argument is TRUE.\</ahelp\> This function returns the value FALSE, if all the arguments have the logical value FALSE.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3148771				0	sh	The arguments are either logical expressions themselves (TRUE, 1<5, 2+3=7, B8<10) that return logical values, or arrays (A1:C3) containing logical values.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3153546				0	sh	When a function expects a single value, but you entered a cell range, then the value from the cell range is taken that is in the same column or row as the formula.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3149027				0	sh	If the entered range is outside of the current column or row of the formula, the function returns the error value #VALUE!				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3155517				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3150468				0	sh	OR(LogicalValue1; LogicalValue2 ...LogicalValue30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3155819	24			0	sh	            \<emph\>LogicalValue1; LogicalValue2 ...LogicalValue30\</emph\> are conditions to be checked. All conditions can be either TRUE or FALSE. If a range is entered as a parameter, the function uses the value from the range that is in the current column or row.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3153228				0	sh	Examples:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3154870				0	sh	The logical values of entries 12<11; 13>22, and 45=45 are to be checked.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3155371	27			0	sh	            \<item type=\"input\"\>=OR(12<11;13>22;45=45)\</item\> returns TRUE.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3158412	59			0	sh	            \<item type=\"input\"\>=OR(FALSE;TRUE)\</item\> returns TRUE.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	bm_id3148394K				0	sh	\<bookmark_value\>XOR function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3148394K				0	sh	XOR				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3156060K				0	sh	\<ahelp hid=\"HID_FUNC_ODER\"\>Returns the exclusive "or" of arguments.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3148771K				0	sh	The arguments are either numbers, logical expressions themselves (TRUE, 1<5, 2+3=7, B8<10) that return logical values, or arrays (A1:C3).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3149027K				0	sh	If the entered range is outside of the current column or row of the formula, the function returns the error value #VALUE!				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3155517K				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3150468K				0	sh	XOR(Value1; Value2 ...Value30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3155819K				0	sh	\<emph\>Value1; Value2 ...Value30\</emph\> are added modulo 2. TRUE is returned if the result of this addition is 1;FALSE is returned if the result of this addition is 0.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3153228K				0	sh	Examples:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3155371K				0	sh	\<item type=\"input\"\>=XOR(12<11;13>22;10)\</item\> returns TRUE since this converts to (1+0+10) mod 2 = 0				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3158412K				0	sh	\<item type=\"input\"\>=XOR(FALSE;TRUE)\</item\> returns TRUE.				20181231 09:50:43
