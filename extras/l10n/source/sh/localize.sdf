helpcontent2	source\text\scalc\01\func_year.xhp	0	help	par_id3145668				0	sh	\<item type=\"input\"\>=YEAR(1)\</item\> returns 1899				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_year.xhp	0	help	par_id3151168				0	sh	\<item type=\"input\"\>=YEAR(2)\</item\> returns 1900				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_year.xhp	0	help	par_id3150115				0	sh	\<item type=\"input\"\>=YEAR(33333.33)\</item\> returns 1991				20181231 09:50:43
