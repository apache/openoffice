helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3155435				0	sh	\<item type=\"input\"\>1000\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3145353				0	sh	\<item type=\"input\"\>42\</item\>				20181231 09:50:43
