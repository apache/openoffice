helpcontent2	source\text\scalc\01\func_today.xhp	0	help	par_id3153759				0	sh	\<ahelp hid=\"HID_FUNC_HEUTE\"\>Returns the current computer system date.\</ahelp\> The value is updated when you reopen the document or modify the values of the document.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_today.xhp	0	help	hd_id3154051				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_today.xhp	0	help	par_id3153154				0	sh	TODAY()				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_today.xhp	0	help	par_id3154741				0	sh	 TODAY is a function without arguments.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_today.xhp	0	help	hd_id3153627				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_today.xhp	0	help	par_id3156106				0	sh	\<item type=\"input\"\>TODAY()\</item\> returns the current computer system date.				20181231 09:50:43
