helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153736	45			0	sh	                     \<item type=\"input\"\>10,000 currency units\</item\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150131	46			0	sh	                     \<item type=\"input\"\>5\</item\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148766	47			0	sh	                     \<item type=\"input\"\>1\</item\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159136	48			0	sh	                     \<item type=\"input\"\>13,333.33 currency units\</item\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3151018				0	sh	3				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148397	50			0	sh	                     \<item type=\"input\"\>2\</item\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146907	51			0	sh	                     \<item type=\"input\"\>10,666.67 currency units\</item\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147356				0	sh	4				20181231 09:50:43
