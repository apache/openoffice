helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_id3150400				0	sh	\<ahelp hid=\"SC:LISTBOX:TP_VALIDATION_VALUES:LB_ALLOW\"\>Click a validation option for the selected cell(s).\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_id3148797				0	sh	The following conditions are available:				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_id3150447				0	sh	Condition				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_id3155854				0	sh	Effect				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_id3153092				0	sh	All values				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_id3155411				0	sh	No limitation.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_id3147434				0	sh	Whole number				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_id3154319				0	sh	Only whole numbers corresponding to the condition.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_id3145802				0	sh	Decimal				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_id3153160				0	sh	All numbers corresponding to the condition.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_id3149377				0	sh	Date				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_id3150718				0	sh	All numbers corresponding to the condition. The entered values are formatted accordingly the next time the dialog is called up.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_id3146969				0	sh	Time				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_id3155066				0	sh	All numbers corresponding to the condition. The entered values are formatted accordingly the next time the dialog is called up.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_idN106A0				0	sh	Cell range				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_idN106A5				0	sh	Allow only values that are given in a cell range. The cell range can be specified explicitly, or as a named database range, or as a named range. The range may consist of one column or one row of cells. If you specify a range of columns and rows, only the first column is used.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_idN106AB				0	sh	List				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_idN106B0				0	sh	Allow only values or strings specified in a list. Strings and values can be mixed. Numbers evaluate to their value, so if you enter the number 1 in the list, the entry 100% is also valid.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_id3154756				0	sh	Text length				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_id3147339				0	sh	Entries whose length corresponds to the condition.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	hd_id3154704				0	sh	Allow empty cells				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_id3153967				0	sh	\<ahelp hid=\"SC:TRISTATEBOX:TP_VALIDATION_VALUES:TSB_ALLOW_BLANKS\"\>In conjunction with \<emph\>Tools - Detective - Mark invalid Data\</emph\>, this defines that empty cells are shown as invalid data (disabled) or not (enabled).\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_idN10709				0	sh	Show selection list				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_idN1070D				0	sh	\<ahelp hid=\"sc:CheckBox:TP_VALIDATION_VALUES:CB_SHOWLIST\"\>Shows a list of all valid strings or values to select from. The list can also be opened by selecting the cell and pressing Ctrl+D (Mac: Command+D).\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_idN10724				0	sh	Sort entries ascending				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_idN10728				0	sh	\<ahelp hid=\"sc:CheckBox:TP_VALIDATION_VALUES:CB_SORTLIST\"\>Sorts the selection list in ascending order and filters duplicates from the list. If not checked, the order from the data source is taken.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_idN1073F				0	sh	Source				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_idN10743				0	sh	\<ahelp hid=\"sc:Edit:TP_VALIDATION_VALUES:EDT_MIN\"\>Enter the cell range that contains the valid values or text.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_idN1075A				0	sh	Entries				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_idN1075E				0	sh	\<ahelp hid=\"sc:MultiLineEdit:TP_VALIDATION_VALUES:EDT_LIST\"\>Enter the entries that will be valid values or text strings.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	hd_id3163807				0	sh	Data				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_id3144502	10			0	sh	\<ahelp hid=\"SC:LISTBOX:TP_VALIDATION_VALUES:LB_VALUE\"\>Select the comparative operator that you want to use.\</ahelp\> The available operators depend on what you selected in the \<emph\>Allow \</emph\>box. If you select "between" or "not between", the \<emph\>Minimum\</emph\> and \<emph\>Maximum\</emph\> input boxes appear. Otherwise, only the \<emph\>Minimum\</emph\>, the \<emph\>Maximum, or the Value\</emph\> input boxes appear.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	hd_id3153782				0	sh	Value				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_id3153266	12			0	sh	Enter the value for the data validation option that you selected in the \<emph\>Allow \</emph\>box.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	hd_id3149814				0	sh	Minimum				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	par_id3153199	14			0	sh	\<ahelp hid=\"SC:EDIT:TP_VALIDATION_VALUES:EDT_MIN\"\>Enter the minimum value for the data validation option that you selected in the \<emph\>Allow \</emph\>box.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12120100.xhp	0	help	hd_id3149035				0	sh	Maximum				20181231 09:50:43
