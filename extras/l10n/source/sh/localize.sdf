helpcontent2	source\text\swriter\guide\footnote_usage.xhp	0	help	hd_id3145819				0	sh	\<variable id=\"footnote_usage\"\>\<link href=\"text/swriter/guide/footnote_usage.xhp\" name=\"Inserting and Editing Footnotes or Endnotes\"\>Inserting and Editing Footnotes or Endnotes\</link\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\swriter\guide\footnote_usage.xhp	0	help	par_id3154258				0	sh	Footnotes reference more information about a topic at the bottom of a page and endnotes reference information at the end of the document. $[officename] automatically numbers the footnotes and endnotes.				20181231 09:50:43
