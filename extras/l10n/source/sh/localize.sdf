helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149419				0	sh	\<ahelp hid=\"HID_FUNC_COTHYP\"\>Returns the hyperbolic cotangent of a given number (angle).\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3149242				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143280				0	sh	COTH(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154799				0	sh	 Returns the hyperbolic cotangent of \<emph\>Number\</emph\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155422				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144754				0	sh	\<item type=\"input\"\>=COTH(1)\</item\> returns the hyperbolic cotangent of 1, approximately 1.3130.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3145314				0	sh	\<bookmark_value\>DEGREES function\</bookmark_value\>\<bookmark_value\>converting;radians, into degrees\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145314				0	sh	DEGREES				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149939				0	sh	\<ahelp hid=\"HID_FUNC_DEG\"\>Converts radians into degrees.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150623				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145600				0	sh	DEGREES(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149484				0	sh	\<emph\>Number\</emph\> is the angle in radians to be converted to degrees.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3669545				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3459578				0	sh	\<item type=\"input\"\>=DEGREES(PI())\</item\> returns 180 degrees.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3148698				0	sh	\<bookmark_value\>EXP function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3148698				0	sh	EXP				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150592				0	sh	\<ahelp hid=\"HID_FUNC_EXP\"\>Returns e raised to the power of a number.\</ahelp\> The constant e has a value of approximately 2.71828182845904.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150351				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146786				0	sh	EXP(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155608				0	sh	\<emph\>Number\</emph\> is the power to which e is to be raised.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154418				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156340				0	sh	\<item type=\"input\"\>=EXP(1)\</item\> returns 2.71828182845904, the mathematical constant e to Calc's accuracy.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3145781				0	sh	\<bookmark_value\>FACT function\</bookmark_value\>\<bookmark_value\>factorials;numbers\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145781				0	sh	FACT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151109				0	sh	\<ahelp hid=\"HID_FUNC_FAKULTAET\"\>Returns the factorial of a number.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146902				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154661				0	sh	FACT(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152952				0	sh	 Returns Number!, the factorial of \<emph\>Number\</emph\>, calculated as 1*2*3*4* ... * Number.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3834650				0	sh	=FACT(0) returns 1 by definition. 				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8429517				0	sh	The factorial of a negative number returns the "invalid argument" error.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154569				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154476				0	sh	\<item type=\"input\"\>=FACT(3)\</item\> returns 6.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147525				0	sh	\<item type=\"input\"\>=FACT(0)\</item\> returns 1.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3159084				0	sh	\<bookmark_value\>INT function\</bookmark_value\>\<bookmark_value\>numbers;rounding down to next integer\</bookmark_value\>\<bookmark_value\>rounding;down to next integer\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3159084				0	sh	INT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158441				0	sh	\<ahelp hid=\"HID_FUNC_GANZZAHL\"\>Rounds a number down to the nearest integer.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146132				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156146				0	sh	INT(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154117				0	sh	Returns \<emph\>Number\</emph\> rounded down to the nearest integer.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id153508				0	sh	Negative numbers round down to the integer below.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155118				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156267				0	sh	\<item type=\"input\"\>=INT(5.7)\</item\> returns 5.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147323				0	sh	\<item type=\"input\"\>=INT(-1.3)\</item\> returns -2.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3150938				0	sh	\<bookmark_value\>EVEN function\</bookmark_value\>\<bookmark_value\>numbers;rounding up/down to even integers\</bookmark_value\>\<bookmark_value\>rounding;up/down to even integers\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150938				0	sh	EVEN				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149988				0	sh	\<ahelp hid=\"HID_FUNC_GERADE\"\>Rounds a positive number up to the next even integer and a negative number down to the next even integer.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3148401				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150830				0	sh	EVEN(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153350	231			0	sh	 Returns \<emph\>Number\</emph\> rounded to the next even integer up, away from zero. 				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155508				0	sh	Examples				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154361				0	sh	\<item type=\"input\"\>=EVEN(2.3)\</item\> returns 4.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8477736				0	sh	\<item type=\"input\"\>=EVEN(2)\</item\> returns 2.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id159611				0	sh	\<item type=\"input\"\>=EVEN(0)\</item\> returns 0.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6097598				0	sh	\<item type=\"input\"\>=EVEN(-0.5)\</item\> returns -2.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3147356				0	sh	\<bookmark_value\>GCD function\</bookmark_value\>\<bookmark_value\>greatest common divisor\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3147356				0	sh	GCD				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152465				0	sh	\<ahelp hid=\"HID_FUNC_GGT\"\>Returns the greatest common divisor of two or more integers.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2769249				0	sh	The greatest common divisor is the positive largest integer which will divide, without remainder, each of the given integers.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150643				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154524				0	sh	GCD(Integer1; Integer2; ...; Integer30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149340				0	sh	\<emph\>Integer1 To 30\</emph\> are up to 30 integers whose greatest common divisor is to be calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3147317				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151285				0	sh	\<item type=\"input\"\>=GCD(16;32;24) \</item\>gives the result 8, because 8 is the largest number that can divide 16, 24 and 32 without a remainder.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1604663				0	sh	\<item type=\"input\"\>=GCD(B1:B3)\</item\> where cells B1, B2, B3 contain \<item type=\"input\"\>9\</item\>, \<item type=\"input\"\>12\</item\>, \<item type=\"input\"\>9\</item\> gives 3.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3151221				0	sh	\<bookmark_value\>GCD_ADD function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3151221				0	sh	GCD_ADD				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153257				0	sh	\<ahelp hid=\"HID_AAI_FUNC_GCD\"\> The result is the greatest common divisor of a list of numbers.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3147548				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156205				0	sh	GCD_ADD(Number(s))				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145150				0	sh	\<emph\>Number(s)\</emph\> is a list of up to 30 numbers.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150239				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159192				0	sh	\<item type=\"input\"\>=GCD_ADD(5;15;25)\</item\> returns 5.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3156048				0	sh	\<bookmark_value\>ISEVEN function\</bookmark_value\>\<bookmark_value\>even integers\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3156048				0	sh	ISEVEN				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149169				0	sh	\<ahelp hid=\"HID_FUNC_ISTGERADE\"\>Returns TRUE if the value is an even integer, or FALSE if the value is odd.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146928				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151203				0	sh	ISEVEN(Value)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150491				0	sh	\<emph\>Value\</emph\> is the value to be checked.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3445844				0	sh	If Value is not an integer any digits after the decimal point are ignored. The sign of Value is also ignored.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154136				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163813				0	sh	\<item type=\"input\"\>=ISEVEN(48)\</item\> returns TRUE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8378856				0	sh	\<item type=\"input\"\>=ISEVEN(33)\</item\> returns FALSE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7154759				0	sh	\<item type=\"input\"\>=ISEVEN(0)\</item\> returns TRUE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1912289				0	sh	\<item type=\"input\"\>=ISEVEN(-2.1)\</item\> returns TRUE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5627307				0	sh	\<item type=\"input\"\>=ISEVEN(3.999)\</item\> returns FALSE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3156034				0	sh	\<bookmark_value\>ISODD function\</bookmark_value\>\<bookmark_value\>odd integers\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3156034				0	sh	ISODD				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155910				0	sh	\<ahelp hid=\"HID_FUNC_ISTUNGERADE\"\>Returns TRUE if the value is odd, or FALSE if the number is even.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3151006				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151375				0	sh	ISODD(value)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155139				0	sh	\<emph\>Value\</emph\> is the value to be checked.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9027680				0	sh	If Value is not an integer any digits after the decimal point are ignored. The sign of Value is also ignored.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163723				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155345				0	sh	\<item type=\"input\"\>=ISODD(33)\</item\> returns TRUE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9392986				0	sh	\<item type=\"input\"\>=ISODD(48)\</item\> returns FALSE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5971251				0	sh	\<item type=\"input\"\>=ISODD(3.999)\</item\> returns TRUE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id4136478				0	sh	\<item type=\"input\"\>=ISODD(-3.1)\</item\> returns TRUE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3145213				0	sh	\<bookmark_value\>LCM function\</bookmark_value\>\<bookmark_value\>least common multiples\</bookmark_value\>\<bookmark_value\>lowest common multiples\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145213				0	sh	LCM				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146814				0	sh	\<ahelp hid=\"HID_FUNC_KGV\"\>Returns the least common multiple of one or more integers.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3148632				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147279				0	sh	LCM(Integer1; Integer2; ...; Integer30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156348				0	sh	\<emph\>Integer1 to 30\</emph\> are up to 30 integers whose lowest common multiple is to be calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3156431				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154914				0	sh	If you enter the numbers \<item type=\"input\"\>512\</item\>;\<item type=\"input\"\>1024\</item\> and \<item type=\"input\"\>2000\</item\> in the Integer 1;2 and 3 text boxes, 128000 will be returned as the result.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3154230				0	sh	\<bookmark_value\>LCM_ADD function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154230				0	sh	LCM_ADD				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149036				0	sh	\<ahelp hid=\"HID_AAI_FUNC_LCM\"\> The result is the lowest common multiple of a list of numbers.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153132				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154395				0	sh	LCM_ADD(Number(s))				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147377				0	sh	\<emph\>Number(s)\</emph\> is a list of up to 30 numbers.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145122				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145135				0	sh	\<item type=\"input\"\>=LCM_ADD(5;15;25)\</item\> returns 75.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3155802				0	sh	\<bookmark_value\>COMBIN function\</bookmark_value\>\<bookmark_value\>number of combinations\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155802				0	sh	COMBIN				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156172				0	sh	\<ahelp hid=\"HID_FUNC_KOMBINATIONEN\"\>Returns the number of combinations for elements without repetition.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3156193				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150223				0	sh	COMBIN(Count1; Count2)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150313				0	sh	\<emph\>Count1\</emph\> is the number of items in the set.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153830				0	sh	\<emph\>Count2\</emph\> is the number of items to choose from the set.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6807458				0	sh	COMBIN returns the number of ordered ways to choose these items. For example if there are 3 items A, B and C in a set, you can choose 2 items in 3 different ways, namely AB, AC and BC.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7414471				0	sh	COMBIN implements the formula: Count1!/(Count2!*(Count1-Count2)!)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153171				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153517				0	sh	\<item type=\"input\"\>=COMBIN(3;2)\</item\> returns 3.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3150284				0	sh	\<bookmark_value\>COMBINA function\</bookmark_value\>\<bookmark_value\>number of combinations with repetitions\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150284				0	sh	COMBINA				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157894				0	sh	\<ahelp hid=\"HID_FUNC_KOMBINATIONEN2\"\>Returns the number of combinations of a subset of items including repetitions.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145752				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145765				0	sh	COMBINA(Count1; Count2)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153372				0	sh	\<emph\>Count1\</emph\> is the number of items in the set.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155544				0	sh	\<emph\>Count2\</emph\> is the number of items to choose from the set.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1997131				0	sh	COMBINA returns the number of unique ways to choose these items, where the order of choosing is irrelevant, and repetition of items is allowed. For example if there are 3 items A, B and C in a set, you can choose 2 items in 6 different ways, namely AA, AB, AC, BB, BC and CC.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2052064				0	sh	COMBINA implements the formula: (Count1+Count2-1)! / (Count2!(Count1-1)!)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154584				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152904				0	sh	\<item type=\"input\"\>=COMBINA(3;2)\</item\> returns 6.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3156086				0	sh	\<bookmark_value\>TRUNC function\</bookmark_value\>\<bookmark_value\>decimal places;cutting off\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3156086				0	sh	TRUNC				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157866				0	sh	\<ahelp hid=\"HID_FUNC_KUERZEN\"\>Truncates a number by removing decimal places.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3148499				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148511				0	sh	TRUNC(Number; Count)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150796				0	sh	Returns \<emph\>Number\</emph\> with at most \<emph\>Count\</emph\> decimal places. Excess decimal places are simply removed, irrespective of sign.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150816				0	sh	\<item type=\"literal\"\>TRUNC(Number; 0)\</item\> behaves as \<item type=\"literal\"\>INT(Number)\</item\> for positive numbers, but effectively rounds towards zero for negative numbers.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148548				0	sh	The \<emph\>visible\</emph\> decimal places of the result are specified in \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - \<link href=\"text/shared/optionen/01060500.xhp\"\>%PRODUCTNAME Calc - Calculate\</link\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152555				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152569				0	sh	\<item type=\"input\"\>=TRUNC(1.239;2)\</item\> returns 1.23. The 9 is lost.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7050080				0	sh	\<item type=\"input\"\>=TRUNC(-1.234999;3)\</item\> returns -1.234. All the 9s are lost.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3153601				0	sh	\<bookmark_value\>LN function\</bookmark_value\>\<bookmark_value\>natural logarithm\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153601				0	sh	LN				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154974				0	sh	\<ahelp hid=\"HID_FUNC_LN\"\>Returns the natural logarithm based on the constant e of a number.\</ahelp\> The constant e has a value of approximately 2.71828182845904.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154993				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155284				0	sh	LN(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155297				0	sh	\<emph\>Number\</emph\> is the value whose natural logarithm is to be calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153852				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153866				0	sh	\<item type=\"input\"\>=LN(3)\</item\> returns the natural logarithm of 3 (approximately 1.0986).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5747245				0	sh	\<item type=\"input\"\>=LN(EXP(321))\</item\> returns 321.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3109813				0	sh	\<bookmark_value\>LOG function\</bookmark_value\>\<bookmark_value\>logarithms\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3109813				0	sh	LOG				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3109841				0	sh	\<ahelp hid=\"HID_FUNC_LOG\"\>Returns the logarithm of a number to the specified base.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144719				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144732				0	sh	LOG(Number; Base)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144746				0	sh	\<emph\>Number\</emph\> is the value whose logarithm is to be calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152840				0	sh	\<emph\>Base\</emph\> (optional) is the base for the logarithm calculation. If omitted, Base 10 is assumed.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152860				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154429				0	sh	\<item type=\"input\"\>=LOG(10;3)\</item\> returns the logarithm to base 3 of 10 (approximately 2.0959).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5577562				0	sh	\<item type=\"input\"\>=LOG(7^4;7)\</item\> returns 4.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3154187				0	sh	\<bookmark_value\>LOG10 function\</bookmark_value\>\<bookmark_value\>base-10 logarithm\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154187				0	sh	LOG10				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155476				0	sh	\<ahelp hid=\"HID_FUNC_LOG10\"\>Returns the base-10 logarithm of a number.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155494				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159294				0	sh	LOG10(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159308				0	sh	Returns the logarithm to base 10 of \<emph\>Number\</emph\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3159328				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157916				0	sh	\<item type=\"input\"\>=LOG10(5)\</item\> returns the base-10 logarithm of 5 (approximately 0.69897).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152518				0	sh	\<bookmark_value\>CEILING function\</bookmark_value\>\<bookmark_value\>rounding;up to multiples of significance\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152518				0	sh	CEILING				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153422				0	sh	\<ahelp hid=\"HID_FUNC_OBERGRENZE\"\>Rounds a number up to the nearest multiple of Significance.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153440				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153454				0	sh	CEILING(Number; Significance; Mode)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153467				0	sh	\<emph\>Number\</emph\> is the number that is to be rounded up.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155000				0	sh	\<emph\>Significance\</emph\> is the number to whose multiple the value is to be rounded up.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155020				0	sh	\<emph\>Mode\</emph\> is an optional value. If the Mode value is given and not equal to zero, and if Number and Significance are negative, then rounding is done based on the absolute value of Number. This parameter is ignored when exporting to MS Excel as Excel does not know any third parameter.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163792				0	sh	If both parameters Number and Significance are negative and the Mode value is equal to zero or is not given, the results in $[officename] and Excel will differ after the import has been completed. If you export the spreadsheet to Excel, use Mode=1 to see the same results in Excel as in Calc.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145697				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145710				0	sh	\<item type=\"input\"\>=CEILING(-11;-2)\</item\> returns -10				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145725				0	sh	\<item type=\"input\"\>=CEILING(-11;-2;0)\</item\> returns -10				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145740				0	sh	\<item type=\"input\"\>=CEILING(-11;-2;1)\</item\> returns -12				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3157762				0	sh	\<bookmark_value\>PI function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157762				0	sh	PI				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157790				0	sh	\<ahelp hid=\"HID_FUNC_PI\"\>Returns 3.14159265358979, the value of the mathematical constant PI to 14 decimal places.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157809				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157822				0	sh	PI()				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157836				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152370				0	sh	\<item type=\"input\"\>=PI()\</item\> returns 3.14159265358979.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152418				0	sh	\<bookmark_value\>MULTINOMIAL function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152418				0	sh	MULTINOMIAL				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152454				0	sh	\<ahelp hid=\"HID_AAI_FUNC_MULTINOMIAL\"\> Returns the factorial of the sum of the arguments divided by the product of the factorials of the arguments.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155646				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155660				0	sh	MULTINOMIAL(Number(s))				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155673				0	sh	\<emph\>Number(s)\</emph\> is a list of up to 30 numbers.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155687				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155701				0	sh	\<item type=\"input\"\>=MULTINOMIAL(F11:H11)\</item\> returns 1260, if F11 to H11 contain the values \<item type=\"input\"\>2\</item\>, \<item type=\"input\"\>3\</item\> and \<item type=\"input\"\>4\</item\>. This corresponds to the formula =(2+3+4)! / (2!*3!*4!)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3155717				0	sh	\<bookmark_value\>POWER function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155717				0	sh	POWER				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159495				0	sh	\<ahelp hid=\"HID_FUNC_POTENZ\"\>Returns a number raised to another number.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3159513				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159526				0	sh	POWER(Base; Exponent)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159540				0	sh	Returns \<emph\>Base\</emph\> raised to the power of \<emph\>Exponent\</emph\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5081637				0	sh	The same result may be achieved by using the exponentiation operator ^:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9759514				0	sh	\<item type=\"literal\"\>Base^Exponent\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3159580				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159594				0	sh	\<item type=\"input\"\>=POWER(4;3)\</item\> returns 64, which is 4 to the power of 3.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1614429				0	sh	=4^3 also returns 4 to the power of 3.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152651				0	sh	\<bookmark_value\>SERIESSUM function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152651				0	sh	SERIESSUM				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152688				0	sh	\<ahelp hid=\".\"\>Sums the first terms of a power series.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152708				0	sh	SERIESSUM(x;n;m;coefficients) = coefficient_1*x^n + coefficient_2*x^(n+m) + coefficient_3*x^(n+2m) +...+ coefficient_i*x^(n+(i-1)m)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152724				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_idN11BD9				0	sh	SERIESSUM(X; N; M; Coefficients)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152737				0	sh	\<emph\>X\</emph\> is the input value for the power series.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144344				0	sh	\<emph\>N\</emph\> is the initial power				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144357				0	sh	\<emph\>M\</emph\> is the increment to increase N				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144370				0	sh	\<emph\>Coefficients\</emph\> is a series of coefficients. For each coefficient the series sum is extended by one section.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144386				0	sh	\<bookmark_value\>PRODUCT function\</bookmark_value\>\<bookmark_value\>numbers;multiplying\</bookmark_value\>\<bookmark_value\>multiplying;numbers\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144386				0	sh	PRODUCT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144414				0	sh	\<ahelp hid=\"HID_FUNC_PRODUKT\"\>Multiplies all the numbers given as arguments and returns the product.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144433				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144446				0	sh	PRODUCT(Number1; Number2; ...; Number30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144460				0	sh	\<emph\>Number1 to 30\</emph\> are up to 30 arguments whose product is to be calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1589098				0	sh	PRODUCT returns number1 * number2 * number3 * ...				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144480				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144494				0	sh	\<item type=\"input\"\>=PRODUCT(2;3;4)\</item\> returns 24.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3160340				0	sh	\<bookmark_value\>SUMSQ function\</bookmark_value\>\<bookmark_value\>square number additions\</bookmark_value\>\<bookmark_value\>sums;of square numbers\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160340				0	sh	SUMSQ				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160368				0	sh	\<ahelp hid=\"HID_FUNC_QUADRATESUMME\"\>If you want to calculate the sum of the squares of numbers (totaling up of the squares of the arguments), enter these into the text fields.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160388				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160402				0	sh	SUMSQ(Number1; Number2; ...; Number30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160415				0	sh	\<emph\>Number1 to 30\</emph\> are up to 30 arguments the sum of whose squares is to be calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160436				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160449				0	sh	If you enter the numbers \<item type=\"input\"\>2\</item\>; \<item type=\"input\"\>3\</item\> and \<item type=\"input\"\>4\</item\> in the Number 1; 2 and 3 text boxes, 29 is returned as the result.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3158247				0	sh	\<bookmark_value\>MOD function\</bookmark_value\>\<bookmark_value\>remainders of divisions\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158247				0	sh	MOD				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158276				0	sh	\<ahelp hid=\"HID_FUNC_REST\"\>Returns the remainder when one integer is divided by another.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158294				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158308				0	sh	MOD(Dividend; Divisor)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158321				0	sh	 For integer arguments this function returns Dividend modulo Divisor, that is the remainder when \<emph\>Dividend\</emph\> is divided by \<emph\>Divisor\</emph\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158341				0	sh	This function is implemented as \<item type=\"literal\"\>Dividend - Divisor * INT(Dividend/Divisor)\</item\> , and this formula gives the result if the arguments are not integer.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158361				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158374				0	sh	\<item type=\"input\"\>=MOD(22;3)\</item\> returns 1, the remainder when 22 is divided by 3.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1278420				0	sh	\<item type=\"input\"\>=MOD(11.25;2.5)\</item\> returns 1.25.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144592				0	sh	\<bookmark_value\>QUOTIENT function\</bookmark_value\>\<bookmark_value\>divisions\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144592				0	sh	QUOTIENT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144627				0	sh	\<ahelp hid=\"HID_AAI_FUNC_QUOTIENT\"\>Returns the integer part of a division operation.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144646				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144659				0	sh	QUOTIENT(Numerator; Denominator)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9038972				0	sh	Returns the integer part of \<emph\>Numerator\</emph\> divided by \<emph\>Denominator\</emph\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7985168				0	sh	QUOTIENT is equivalent to \<item type=\"literal\"\>INT(numerator/denominator)\</item\>, except that it may report errors with different error codes.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144674				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144687				0	sh	\<item type=\"input\"\>=QUOTIENT(11;3)\</item\> returns 3. The remainder of 2 is lost.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144702				0	sh	\<bookmark_value\>RADIANS function\</bookmark_value\>\<bookmark_value\>converting;degrees, into radians\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144702				0	sh	RADIANS				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158025				0	sh	\<ahelp hid=\"HID_FUNC_RAD\"\>Converts degrees to radians.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158042				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158055				0	sh	RADIANS(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158069				0	sh	\<emph\>Number\</emph\> is the angle in degrees to be converted to radians.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id876186				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3939634				0	sh	\<item type=\"input\"\>=RADIANS(90)\</item\> returns 1.5707963267949, which is PI/2 to Calc's accuracy.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3158121				0	sh	\<bookmark_value\>ROUND function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158121				0	sh	ROUND				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158150				0	sh	\<ahelp hid=\"HID_FUNC_RUNDEN\"\>Rounds a number to a certain number of decimal places.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158169				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158182				0	sh	ROUND(Number; Count)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158196				0	sh	Returns \<emph\>Number\</emph\> rounded to \<emph\>Count\</emph\> decimal places. If Count is omitted or zero, the function rounds to the nearest integer. If Count is negative, the function rounds to the nearest 10, 100, 1000, etc.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id599688				0	sh	This function rounds to the nearest number. See ROUNDDOWN and ROUNDUP for alternatives.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145863				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145876				0	sh	\<item type=\"input\"\>=ROUND(2.348;2)\</item\> returns 2.35				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145899				0	sh	\<item type=\"input\"\>=ROUND(-32.4834;3)\</item\> returns -32.483. Change the cell format to see all decimals.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1371501				0	sh	\<item type=\"input\"\>=ROUND(2.348;0)\</item\> returns 2.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id4661702				0	sh	\<item type=\"input\"\>=ROUND(2.5)\</item\> returns 3. 				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7868892				0	sh	\<item type=\"input\"\>=ROUND(987.65;-2)\</item\> returns 1000.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3145991				0	sh	\<bookmark_value\>ROUNDDOWN function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145991				0	sh	ROUNDDOWN				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146020				0	sh	\<ahelp hid=\"HID_FUNC_ABRUNDEN\"\>Rounds a number down, toward zero, to a certain precision.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146037				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146051				0	sh	ROUNDDOWN(Number; Count)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146064				0	sh	Returns \<emph\>Number\</emph\> rounded down (towards zero) to \<emph\>Count\</emph\> decimal places. If Count is omitted or zero, the function rounds down to an integer. If Count is negative, the function rounds down to the next 10, 100, 1000, etc.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2188787				0	sh	This function rounds towards zero. See ROUNDUP and ROUND for alternatives.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163164				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163178				0	sh	\<item type=\"input\"\>=ROUNDDOWN(1.234;2)\</item\> returns 1.23.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5833307				0	sh	\<item type=\"input\"\>=ROUNDDOWN(45.67;0)\</item\> returns 45.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7726676				0	sh	\<item type=\"input\"\>=ROUNDDOWN(-45.67)\</item\> returns -45.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3729361				0	sh	\<item type=\"input\"\>=ROUNDDOWN(987.65;-2)\</item\> returns 900.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3163268				0	sh	\<bookmark_value\>ROUNDUP function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163268				0	sh	ROUNDUP				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163297				0	sh	\<ahelp hid=\"HID_FUNC_AUFRUNDEN\"\>Rounds a number up, away from zero, to a certain precision.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163315				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163328				0	sh	ROUNDUP(Number; Count)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163342				0	sh	Returns \<emph\>Number\</emph\> rounded up (away from zero) to \<emph\>Count\</emph\> decimal places. If Count is omitted or zero, the function rounds up to an integer. If Count is negative, the function rounds up to the next 10, 100, 1000, etc.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9573961				0	sh	This function rounds away from zero. See ROUNDDOWN and ROUND for alternatives.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163381				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144786				0	sh	\<item type=\"input\"\>=ROUNDUP(1.1111;2)\</item\> returns 1.12.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7700430				0	sh	\<item type=\"input\"\>=ROUNDUP(1.2345;1)\</item\> returns 1.3.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1180455				0	sh	\<item type=\"input\"\>=ROUNDUP(45.67;0)\</item\> returns 46.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3405560				0	sh	\<item type=\"input\"\>=ROUNDUP(-45.67)\</item\> returns -46.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3409527				0	sh	\<item type=\"input\"\>=ROUNDUP(987.65;-2)\</item\> returns 1000.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144877				0	sh	\<bookmark_value\>SIN function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144877				0	sh	SIN				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144906				0	sh	\<ahelp hid=\"HID_FUNC_SIN\"\>Returns the sine of the given angle (in radians).\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144923				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144937				0	sh	SIN(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144950				0	sh	Returns the (trigonometric) sine of \<emph\>Number\</emph\>, the angle in radians.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8079470				0	sh	To return the sine of an angle in degrees, use the RADIANS function.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144969				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144983				0	sh	\<item type=\"input\"\>=SIN(PI()/2)\</item\> returns 1, the sine of PI/2 radians.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3916440				0	sh	\<item type=\"input\"\>=SIN(RADIANS(30))\</item\> returns 0.5, the sine of 30 degrees.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3163397				0	sh	\<bookmark_value\>SINH function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163397				0	sh	SINH				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163426				0	sh	\<ahelp hid=\"HID_FUNC_SINHYP\"\>Returns the hyperbolic sine of a number.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163444				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163457				0	sh	SINH(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163471				0	sh	Returns the hyperbolic sine of \<emph\>Number\</emph\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163491				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163504				0	sh	\<item type=\"input\"\>=SINH(0)\</item\> returns 0, the hyperbolic sine of 0.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3163596				0	sh	\<bookmark_value\>SUM function\</bookmark_value\>\<bookmark_value\>adding;numbers in cell ranges\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163596				0	sh	SUM				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163625				0	sh	\<ahelp hid=\"HID_FUNC_SUMME\"\>Adds all the numbers in a range of cells.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163643				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163656				0	sh	SUM(Number1; Number2; ...; Number30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163671				0	sh	\<emph\>Number 1 to Number 30\</emph\> are up to 30 arguments whose sum is to be calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163690				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163704				0	sh	If you enter the numbers \<item type=\"input\"\>2\</item\>; \<item type=\"input\"\>3 \</item\>and \<item type=\"input\"\>4\</item\> in the Number 1; 2 and 3 text boxes, 9 will be returned as the result.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151740				0	sh	\<item type=\"input\"\>=SUM(A1;A3;B5)\</item\> calculates the sum of the three cells. \<item type=\"input\"\>=SUM (A1:E10)\</item\> calculates the sum of all cells in the A1 to E10 cell range.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151756				0	sh	Conditions linked by AND can be used with the function SUM() in the following manner:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151774				0	sh	Example assumption: You have entered invoices into a table. Column A contains the date value of the invoice, column B the amounts. You want to find a formula that you can use to return the total of all amounts only for a specific month, e.g. only the amount for the period >=2008-01-01 to <2008-02-01. The range with the date values covers A1:A40, the range containing the amounts to be totaled is B1:B40. C1 contains the start date, 2008\<item type=\"input\"\>-01-01\</item\>, of the invoices to be included and C2 the date, 2008\<item type=\"input\"\>-02-01\</item\>, that is no longer included.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151799				0	sh	Enter the following formula as an array formula:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151813				0	sh	\<item type=\"input\"\>=SUM((A1:A40>=C1)*(A1:A40<C2)*B1:B40)\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151828				0	sh	In order to enter this as an array formula, you must press the Shift\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>+Command \</caseinline\>\<defaultinline\>+ Ctrl\</defaultinline\>\</switchinline\>+ Enter keys instead of simply pressing the Enter key to close the formula. The formula will then be shown in the \<emph\>Formula\</emph\> bar enclosed in braces.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151869				0	sh	{=SUM((A1:A40>=C1)*(A1:A40<C2)*B1:B40)}				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151884				0	sh	The formula is based on the fact that the result of a comparison is 1 if the criterion is met and 0 if it is not met. The individual comparison results will be treated as an array and used in matrix multiplication, and at the end the individual values will be totaled to give the result matrix.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3151957				0	sh	\<bookmark_value\>SUMIF function\</bookmark_value\>\<bookmark_value\>adding;specified numbers\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3151957				0	sh	SUMIF				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151986				0	sh	\<ahelp hid=\"HID_FUNC_SUMMEWENN\"\>Adds the cells specified by a given criteria.\</ahelp\> This function is used to browse a range when you search for a certain value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152015				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152028				0	sh	SUMIF(Range; Criteria; SumRange)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152043				0	sh	\<emph\>Range\</emph\> is the range to which the criteria are to be applied.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152062				0	sh	\<emph\>Criteria\</emph\> is the cell in which the search criterion is shown, or the search criterion itself. If the criteria is written into the formula, it has to be surrounded by double quotes.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152083				0	sh	\<emph\>SumRange\</emph\> is the range from which values are summed. If this parameter has not been indicated, the values found in the Range are summed.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8347422				0	sh	SUMIF supports the reference concatenation operator (~) only in the Criteria parameter, and only if the optional SumRange parameter is not given.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152110				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152148				0	sh	To sum up only negative numbers: \<item type=\"input\"\>=SUMIF(A1:A10;"<0")\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6670125				0	sh	\<item type=\"input\"\>=SUMIF(A1:A10;">0";B1:10)\</item\> - sums values from the range B1:B10 only if the corresponding values in the range A1:A10 are >0.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6062196				0	sh	See COUNTIF() for some more syntax examples that can be used with SUMIF().				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3151957K				0	sh	\<bookmark_value\>SUMIFS function\</bookmark_value\>\<bookmark_value\>adding;specified numbers\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3151957K				0	sh	SUMIFS				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151986K				0	sh	\<ahelp hid=\"HID_FUNC_SUMMEWNRNG\"\>Sum the values of cells in a range that meet multiple criteria in multiple ranges.\</ahelp\> 				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152015K				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152028K				0	sh	SUMIFS( Reference R ; Reference R1 ; Criterion C1 [ ; Reference R2 ; Criterion C2 ]... )				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152043K				0	sh	Sums the value of cells in range R that meet the Criterion C1 in the reference range R1, and the Criterion C2 in the reference range R2, and so on. 				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152062K				0	sh	A \<emph\>Criterion\</emph\> is a single cell Reference, Number or Text. If the criterion is written into the formula, it has to be surrounded by double quotes.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152083K				0	sh	All \<emph\>Reference\</emph\> ranges shall have the same dimension and size, else an Error is returned.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152110K				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152148K				0	sh	Sum up cells in range A1:10 if the entires in B1:B10 are positive, and the entries in D1:D10 are the letter "A": \<item type=\"input\"\>=SUMIFS(A1:A10;B1:B10;">0";D1:D10;"A")\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6062196K				0	sh	See COUNTIFS() for some more syntax examples that can be used with SUMIFS().				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152195				0	sh	\<bookmark_value\>TAN function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152195				0	sh	TAN				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152224				0	sh	\<ahelp hid=\"HID_FUNC_TAN\"\>Returns the tangent of the given angle (in radians).\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152242				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152255				0	sh	TAN(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152269				0	sh	Returns the (trigonometric) tangent of \<emph\>Number\</emph\>, the angle in radians.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5752128				0	sh	To return the tangent of an angle in degrees, use the RADIANS function.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152287				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152301				0	sh	\<item type=\"input\"\>=TAN(PI()/4) \</item\>returns 1, the tangent of PI/4 radians.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1804864				0	sh	\<item type=\"input\"\>=TAN(RADIANS(45))\</item\> returns 1, the tangent of 45 degrees.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3165434				0	sh	\<bookmark_value\>TANH function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165434				0	sh	TANH				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165462				0	sh	\<ahelp hid=\"HID_FUNC_TANHYP\"\>Returns the hyperbolic tangent of a number.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165480				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165494				0	sh	TANH(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165508				0	sh	Returns the hyperbolic tangent of \<emph\>Number\</emph\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165527				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165541				0	sh	\<item type=\"input\"\>=TANH(0)\</item\> returns 0, the hyperbolic tangent of 0.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3165633				0	sh	\<bookmark_value\>AutoFilter function; subtotals\</bookmark_value\>\<bookmark_value\>sums;of filtered data\</bookmark_value\>\<bookmark_value\>filtered data; sums\</bookmark_value\>\<bookmark_value\>SUBTOTAL function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165633				0	sh	SUBTOTAL				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165682				0	sh	\<ahelp hid=\"HID_FUNC_TEILERGEBNIS\"\>Calculates subtotals.\</ahelp\> If a range already contains subtotals, these are not used for further calculations. Use this function with the AutoFilters to take only the filtered records into account.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165704				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165717				0	sh	SUBTOTAL(Function; Range)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165731				0	sh	\<emph\>Function\</emph\> is a number that stands for one of the following functions:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165782				0	sh	Function index				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165806				0	sh	Function				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165833				0	sh	1				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165856				0	sh	AVERAGE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165883				0	sh	2				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165906				0	sh	COUNT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165933				0	sh	3				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165956				0	sh	COUNTA				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165983				0	sh	4				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166006				0	sh	MAX				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166033				0	sh	5				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166056				0	sh	MIN				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143316				0	sh	6				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143339				0	sh	PRODUCT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143366				0	sh	7				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143389				0	sh	STDEV				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143416				0	sh	8				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143439				0	sh	STDEVP				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143466				0	sh	9				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143489				0	sh	SUM				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143516				0	sh	10				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143539				0	sh	VAR				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143566				0	sh	11				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143589				0	sh	VARP				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143606				0	sh	\<emph\>Range\</emph\> is the range whose cells are included.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3143625				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143638				0	sh	You have a table in the cell range A1:B5 containing cities in column A and accompanying figures in column B. You have used an AutoFilter so that you only see rows containing the city Hamburg. You want to see the sum of the figures that are displayed; that is, just the subtotal for the filtered rows. In this case the correct formula would be:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143658				0	sh	\<item type=\"input\"\>=SUBTOTAL(9;B2:B5)\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3143672				0	sh	\<bookmark_value\>Euro; converting\</bookmark_value\>\<bookmark_value\>EUROCONVERT function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3143672				0	sh	EUROCONVERT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143708				0	sh	\<ahelp hid=\"HID_FUNC_UMRECHNEN\"\>Converts between old European national currency and to and from Euros.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143731				0	sh	\<emph\>Syntax\</emph\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143748				0	sh	EUROCONVERT(Value; "From_currency"; "To_currency", full_precision, triangulation_precision)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143763				0	sh	\<emph\>Value\</emph\> is the amount of the currency to be converted.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143782				0	sh	\<emph\>From_currency\</emph\> and \<emph\>To_currency\</emph\> are the currency units to convert from and to respectively. These must be text, the official abbreviation for the currency (for example, "EUR"). The rates (shown per Euro) were set by the European Commission.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0119200904301810				0	sh	\<emph\>Full_precision\</emph\> is optional. If omitted or False, the result is rounded according to the decimals of the To currency. If Full_precision is True, the result is not rounded.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0119200904301815				0	sh	\<emph\>Triangulation_precision\</emph\> is optional. If Triangulation_precision is given and >=3, the intermediate result of a triangular conversion (currency1,EUR,currency2) is rounded to that precision. If Triangulation_precision is omitted, the intermediate result is not rounded. Also if To currency is "EUR", Triangulation_precision is used as if triangulation was needed and conversion from EUR to EUR was applied.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143819				0	sh	\<emph\>Examples\</emph\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143837				0	sh	\<item type=\"input\"\>=EUROCONVERT(100;"ATS";"EUR")\</item\> converts 100 Austrian Schillings into Euros.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143853				0	sh	\<item type=\"input\"\>=EUROCONVERT(100;"EUR";"DEM")\</item\> converts 100 Euros into German Marks.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id0908200902090676				0	sh	\<bookmark_value\>CONVERT function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id0908200902074836				0	sh	CONVERT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902131122				0	sh	\<ahelp hid=\".\"\>Converts a value from one unit of measurement to another unit of measurement. The conversion factors are given in a list in the configuration.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902475420				0	sh	At one time the list of conversion factors included the legacy European currencies and the Euro (see examples below). We suggest using the new function EUROCONVERT for converting these currencies.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id0908200902131071				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902131191				0	sh	CONVERT(value;"text";"text")				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id0908200902131152				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id090820090213112				0	sh	\<item type=\"input\"\>=CONVERT(100;"ATS";"EUR")\</item\> returns the Euro value of 100 Austrian Schillings.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902475431				0	sh	=CONVERT(100;"EUR";"DEM") converts 100 Euros into German Marks. 				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3157177				0	sh	\<bookmark_value\>ODD function\</bookmark_value\>\<bookmark_value\>rounding;up/down to nearest odd integer\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157177				0	sh	ODD				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157205				0	sh	\<ahelp hid=\"HID_FUNC_UNGERADE\"\>Rounds a positive number up to the nearest odd integer and a negative number down to the nearest odd integer.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157223				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157237				0	sh	ODD(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157250				0	sh	 Returns \<emph\>Number\</emph\> rounded to the next odd integer up, away from zero.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157270				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157283				0	sh	\<item type=\"input\"\>=ODD(1.2)\</item\> returns 3.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8746910				0	sh	\<item type=\"input\"\>=ODD(1)\</item\> returns 1.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9636524				0	sh	\<item type=\"input\"\>=ODD(0)\</item\> returns 1.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5675527				0	sh	\<item type=\"input\"\>=ODD(-3.1)\</item\> returns -5.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3157404				0	sh	\<bookmark_value\>FLOOR function\</bookmark_value\>\<bookmark_value\>rounding;down to nearest multiple of significance\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157404				0	sh	FLOOR				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157432				0	sh	\<ahelp hid=\"HID_FUNC_UNTERGRENZE\"\>Rounds a number down to the nearest multiple of Significance.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157451				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157464				0	sh	FLOOR(Number; Significance; Mode)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157478				0	sh	\<emph\>Number\</emph\> is the number that is to be rounded down.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157497				0	sh	\<emph\>Significance\</emph\> is the value to whose multiple the number is to be rounded down.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157517				0	sh	\<emph\>Mode\</emph\> is an optional value. If the Mode value is given and not equal to zero, and if Number and Significance are negative, then rounding is done based on the absolute value of the number. This parameter is ignored when exporting to MS Excel as Excel does not know any third parameter.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163894				0	sh	If both parameters Number and Significance are negative, and if the Mode value is equal to zero or is not specified, then the results in $[officename] Calc and Excel will differ after exporting. If you export the spreadsheet to Excel, use Mode=1 to see the same results in Excel as in Calc.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163932				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163945				0	sh	\<item type=\"input\"\>=FLOOR( -11;-2)\</item\> returns -12				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163966				0	sh	\<item type=\"input\"\>=FLOOR( -11;-2;0)\</item\> returns -12				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163988				0	sh	\<item type=\"input\"\>=FLOOR( -11;-2;1)\</item\> returns -10				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164086				0	sh	\<bookmark_value\>SIGN function\</bookmark_value\>\<bookmark_value\>algebraic signs\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164086				0	sh	SIGN				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164115				0	sh	\<ahelp hid=\"HID_FUNC_VORZEICHEN\"\>Returns the sign of a number. Returns 1 if the number is positive, -1 if negative and 0 if zero.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164136				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164150				0	sh	SIGN(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164164				0	sh	\<emph\>Number\</emph\> is the number whose sign is to be determined.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164183				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164197				0	sh	\<item type=\"input\"\>=SIGN(3.4)\</item\> returns 1.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164212				0	sh	\<item type=\"input\"\>=SIGN(-4.5)\</item\> returns -1.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164252				0	sh	\<bookmark_value\>MROUND function\</bookmark_value\>\<bookmark_value\>nearest multiple\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164252				0	sh	MROUND				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164288				0	sh	\<ahelp hid=\"HID_AAI_FUNC_MROUND\"\>Returns a number rounded to the nearest multiple of another number.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164306				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164320				0	sh	MROUND(Number; Multiple)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3486434				0	sh	Returns \<emph\>Number\</emph\> rounded to the nearest multiple of \<emph\>Multiple\</emph\>. 				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3068636				0	sh	An alternative implementation would be \<item type=\"literal\"\>Multiple * ROUND(Number/Multiple)\</item\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164333				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164347				0	sh	\<item type=\"input\"\>=MROUND(15.5;3)\</item\> returns 15, as 15.5 is closer to 15 (= 3*5) than to 18 (= 3*6).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_idN14DD6				0	sh	\<item type=\"input\"\>=MROUND(1.4;0.5)\</item\> returns 1.5 (= 0.5*3).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164375				0	sh	\<bookmark_value\>SQRT function\</bookmark_value\>\<bookmark_value\>square roots;positive numbers\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164375				0	sh	SQRT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164404				0	sh	\<ahelp hid=\"HID_FUNC_WURZEL\"\>Returns the positive square root of a number.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164424				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164437				0	sh	SQRT(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164451				0	sh	Returns the positive square root of \<emph\>Number\</emph\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6870021				0	sh	 Number must be positive.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164471				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164484				0	sh	\<item type=\"input\"\>=SQRT(16)\</item\> returns 4.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3591723				0	sh	\<item type=\"input\"\>=SQRT(-16)\</item\> returns an \<item type=\"literal\"\>invalid argument\</item\> error.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164560				0	sh	\<bookmark_value\>SQRTPI function\</bookmark_value\>\<bookmark_value\>square roots;products of Pi\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164560				0	sh	SQRTPI				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164596				0	sh	\<ahelp hid=\"HID_AAI_FUNC_SQRTPI\"\>Returns the square root of (PI times a number).\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164614				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164627				0	sh	SQRTPI(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1501510				0	sh	Returns the positive square root of (PI multiplied by \<emph\>Number\</emph\>).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9929197				0	sh	This is equivalent to \<item type=\"literal\"\>SQRT(PI()*Number)\</item\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164641				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164654				0	sh	\<item type=\"input\"\>=SQRTPI(2)\</item\> returns the squareroot of (2PI), approximately 2.506628.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164669				0	sh	\<bookmark_value\>random numbers; between limits\</bookmark_value\>\<bookmark_value\>RANDBETWEEN function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164669				0	sh	RANDBETWEEN				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164711				0	sh	\<ahelp hid=\"HID_AAI_FUNC_RANDBETWEEN\"\>Returns an integer random number in a specified range.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164745				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164758				0	sh	RANDBETWEEN(Bottom; Top)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7112338				0	sh	Returns an integer random number between integers \<emph\>Bottom\</emph\> and \<emph\>Top\</emph\> (both inclusive).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2855616				0	sh	This function produces a new random number each time Calc recalculates. To force Calc to recalculate manually press Shift+\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command \</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+F9.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2091433				0	sh	To generate random numbers which never recalculate, copy cells containing this function, and use \<item type=\"menuitem\"\>Edit - Paste Special\</item\> (with \<item type=\"menuitem\"\>Paste All\</item\> and \<item type=\"menuitem\"\>Formulas\</item\> not marked and \<item type=\"menuitem\"\>Numbers\</item\> marked).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164772				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164785				0	sh	\<item type=\"input\"\>=RANDBETWEEN(20;30)\</item\> returns an integer of between 20 and 30.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164800				0	sh	\<bookmark_value\>RAND function\</bookmark_value\>\<bookmark_value\>random numbers;between 0 and 1\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164800				0	sh	RAND				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164829				0	sh	\<ahelp hid=\"HID_FUNC_ZUFALLSZAHL\"\>Returns a random number between 0 and 1.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164870				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164884				0	sh	RAND()				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5092318				0	sh	This function produces a new random number each time Calc recalculates. To force Calc to recalculate manually press Shift+\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command \</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+F9.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9312417				0	sh	To generate random numbers which never recalculate, copy cells each containing =RAND(), and use \<item type=\"menuitem\"\>Edit - Paste Special\</item\> (with \<item type=\"menuitem\"\>Paste All\</item\> and \<item type=\"menuitem\"\>Formulas\</item\> not marked and \<item type=\"menuitem\"\>Numbers\</item\> marked).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id9089022				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9569078				0	sh	\<item type=\"input\"\>=RAND()\</item\> returns a random number between 0 and 1.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164897				0	sh	\<bookmark_value\>COUNTIF function\</bookmark_value\>\<bookmark_value\>counting;specified cells\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164897				0	sh	COUNTIF				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164926				0	sh	\<ahelp hid=\"HID_FUNC_ZAEHLENWENN\"\>Returns the number of cells that meet with certain criteria within a cell range.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164953				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164967				0	sh	COUNTIF(Range; Criteria)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164980				0	sh	\<emph\>Range\</emph\> is the range to which the criteria are to be applied.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165000				0	sh	\<emph\>Criteria\</emph\> indicates the criteria in the form of a number, an expression or a character string. These criteria determine which cells are counted. You may also enter a search text in the form of a regular expression, e.g. b.* for all words that begin with b. You may also indicate a cell range that contains the search criterion. If you search for literal text, enclose the text in double quotes.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165037				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166505				0	sh	A1:A10 is a cell range containing the numbers \<item type=\"input\"\>2000\</item\> to \<item type=\"input\"\>2009\</item\>. Cell B1 contains the number \<item type=\"input\"\>2006\</item\>. In cell B2, you enter a formula:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3581652				0	sh	\<item type=\"input\"\>=COUNTIF(A1:A10;2006)\</item\> - this returns 1				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id708639				0	sh	\<item type=\"input\"\>=COUNTIF(A1:A10;B1)\</item\> - this returns 1				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5169225				0	sh	\<item type=\"input\"\>=COUNTIF(A1:A10;">=2006") \</item\>- this returns 4				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2118594				0	sh	\<item type=\"input\"\>=COUNTIF(A1:A10;"<"&B1)\</item\> - when B1 contains \<item type=\"input\"\>2006\</item\>, this returns 6				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id166020				0	sh	\<item type=\"input\"\>=COUNTIF(A1:A10;C2)\</item\> where cell C2 contains the text \<item type=\"input\"\>>2006\</item\> counts the number of cells in the range A1:A10 which are >2006 				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6386913				0	sh	To count only negative numbers: \<item type=\"input\"\>=COUNTIF(A1:A10;"<0")\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164897K				0	sh	\<bookmark_value\>COUNTIFS function\</bookmark_value\>\<bookmark_value\>counting;specified cells\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164897K				0	sh	COUNTIFS				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164926K				0	sh	\<ahelp hid=\"HID_FUNC_ZAEHLENWNRNG\"\>Count the number of cells that meet multiple criteria in multiple ranges.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164953K				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164967K				0	sh	COUNTIFS( Reference R1 ; Criterion C1 [ ; Reference R2 ; Criterion C2 ]... )				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164980K				0	sh	\<emph\>Reference R1\</emph\> is the  range to which the \<emph\>Criterion C1\</emph\>applies. \<emph\>Reference R2\</emph\> is the  range to which the \<emph\>Criterion C2\</emph\>applies, and so on.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165000K				0	sh	All \<emph\>Reference \</emph\> ranges shall have the same dimension and size, else an Error is returned. \<emph\>Criteria\</emph\> indicates the criteria in the form of a number, an expression or a character string. These criteria determine which cells are counted. You may also enter a search text in the form of a regular expression, e.g. b.* for all words that begin with b. You may also indicate a cell range that contains the search criterion. If you search for literal text, enclose the text in double quotes.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165037K				0	sh	Examples:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166505K				0	sh	A1:A10 is a cell range containing the numbers \<item type=\"input\"\>2000\</item\> to \<item type=\"input\"\>2009\</item\>. B1:B10 is a cell range containing the numbers \<item type=\"input\"\>2007\</item\> to \<item type=\"input\"\>2016\</item\>:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3581652K				0	sh	\<item type=\"input\"\>=COUNTIFS(A1:A10;2006;B1:B10;2014)\</item\> - this returns 2				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5169225K				0	sh	\<item type=\"input\"\>=COUNTIFS(A1:A10;">=2006";B1:B10;">=2006") \</item\>- this returns 14				20181231 09:50:43
