helpcontent2	source\text\sbasic\shared\03131600.xhp	0	help	par_idN1062B				0	sh	fName = FileOpenDialog ("Please select a file")				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03131600.xhp	0	help	par_idN10630				0	sh	print "file chosen: "+fName				20181231 09:50:43
