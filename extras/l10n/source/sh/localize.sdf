helpcontent2	source\text\scalc\01\12030200.xhp	0	help	hd_id3147228				0	sh	\<link href=\"text/scalc/01/12030200.xhp\" name=\"Options\"\> Options\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	par_id3153770				0	sh	\<ahelp hid=\"HID_SCPAGE_SORT_OPTIONS\"\> Sets additional sorting options.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	hd_id3146976				0	sh	 Case Sensitivity				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	par_id3153091				0	sh	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_SORT_OPTIONS:BTN_CASESENSITIVE\"\> Sorts first by uppercase letters and then by lowercase letters. For Asian languages, special handling applies.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	par_idN10637				0	sh	 Note for Asian languages: Check \<emph\>Case Sensitivity\</emph\> to apply multi-level collation. With multi-level collation, entries are first compared in their primitive forms with their cases and diacritics ignored. If they evaluate as the same, their diacritics are taken into account for the second-level comparison. If they still evaluate as the same, their cases, character widths, and Japanese Kana difference are considered for the third-level comparison.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	hd_id3155856				0	sh	 Range contains column/row labels				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	par_id3154014				0	sh	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_SORT_OPTIONS:BTN_LABEL\"\> Omits the first row or the first column in the selection from the sort.\</ahelp\> The \<emph\>Direction\</emph\> setting at the bottom of the dialog defines the name and function of this check box.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	hd_id3147436				0	sh	 Include formats				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	par_id3149377				0	sh	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_SORT_OPTIONS:BTN_FORMATS\"\> Preserves the current cell formatting.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	hd_id3153878				0	sh	 Copy sort results to:				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	par_id3156286				0	sh	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_SORT_OPTIONS:BTN_COPYRESULT\"\> Copies the sorted list to the cell range that you specify.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	hd_id3153418				0	sh	 Sort results				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	par_id3155602				0	sh	\<ahelp hid=\"SC:LISTBOX:RID_SCPAGE_SORT_OPTIONS:LB_OUTAREA\"\> Select a named \<link href=\"text/scalc/01/12010000.xhp\" name=\"cell range\"\> cell range\</link\> where you want to display the sorted list, or enter a cell range in the input box.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	hd_id3153707				0	sh	 Sort results				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	par_id3145642				0	sh	\<ahelp hid=\"SC:EDIT:RID_SCPAGE_SORT_OPTIONS:ED_OUTAREA\"\> Enter the cell range where you want to display the sorted list, or select a named range from the list.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	hd_id3155445				0	sh	 Custom sort order				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	par_id3156385				0	sh	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_SORT_OPTIONS:BTN_SORT_USER\"\> Click here and then select the custom sort order that you want.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	hd_id3154704				0	sh	 Custom sort order				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	par_id3155962				0	sh	\<ahelp hid=\"SC:LISTBOX:RID_SCPAGE_SORT_OPTIONS:LB_SORT_USER\"\> Select the custom sort order that you want to apply. To define a custom sort order, choose \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - \<link href=\"text/shared/optionen/01060400.xhp\" name=\"%PRODUCTNAME Calc - Sort Lists\"\>%PRODUCTNAME Calc - Sort Lists\</link\> .\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	hd_id3149257				0	sh	 Language				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	hd_id3147004				0	sh	 Language				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	par_id3150787				0	sh	\<ahelp hid=\"SC_LISTBOX_RID_SCPAGE_SORT_OPTIONS_LB_LANGUAGE\"\> Select the language for the sorting rules.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	hd_id3150344				0	sh	 Options				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	par_id3155113				0	sh	\<ahelp hid=\"SC_LISTBOX_RID_SCPAGE_SORT_OPTIONS_LB_ALGORITHM\"\> Select a sorting option for the language.\</ahelp\> For example, select the "phonebook" option for German to include the umlaut special character in the sorting.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	hd_id3152580				0	sh	 Direction				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	hd_id3154201				0	sh	 Top to Bottom (Sort Rows)				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	par_id3166430				0	sh	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCPAGE_SORT_OPTIONS:BTN_TOP_DOWN\"\> Sorts rows by the values in the active columns of the selected range.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	hd_id3145588				0	sh	 Left to Right (Sort Columns)				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	par_id3154370				0	sh	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCPAGE_SORT_OPTIONS:BTN_LEFT_RIGHT\"\> Sorts columns by the values in the active rows of the selected range.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	hd_id3156290				0	sh	 Data area				20181231 09:50:43
helpcontent2	source\text\scalc\01\12030200.xhp	0	help	par_id3156446				0	sh	 Displays the cell range that you want to sort.				20181231 09:50:43
helpcontent2	source\text\scalc\01\05080000.xhp	0	help	tit				0	sh	Print Ranges				20181231 09:50:43
helpcontent2	source\text\scalc\01\05080000.xhp	0	help	hd_id3154013				0	sh	\<link href=\"text/scalc/01/05080000.xhp\" name=\"Print Ranges\"\>Print Ranges\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\05080000.xhp	0	help	par_id3155855				0	sh	\<ahelp hid=\".\"\>Manages print ranges. Only cells within the print ranges will be printed.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\05080000.xhp	0	help	par_id3146119				0	sh	If you do not define any print range manually, Calc assigns an automatic print range to include all the cells that are not empty.				20181231 09:50:43
helpcontent2	source\text\scalc\01\05080000.xhp	0	help	hd_id3154729				0	sh	\<link href=\"text/scalc/01/05080300.xhp\" name=\"Edit\"\>Edit\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	tit				0	sh	EOMONTH				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	bm_id3150991				0	sh	\<bookmark_value\>EOMONTH function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	hd_id3150991				0	sh	\<variable id=\"eomonth\"\>\<link href=\"text/scalc/01/func_eomonth.xhp\"\>EOMONTH\</link\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3152766	232			0	sh	\<ahelp hid=\"HID_AAI_FUNC_EOMONTH\"\>Returns the date of the last day of a month which falls m\<emph\>onths\</emph\> away from the s\<emph\>tart date\</emph\>.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	hd_id3150597				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3150351				0	sh	EOMONTH(StartDate; Months)				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3146787				0	sh	\<emph\>StartDate\</emph\> is a date (the starting point of the calculation).				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3155615				0	sh	\<emph\>Months\</emph\> is the number of months before (negative) or after (positive) the start date.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	hd_id3156335				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3154829				0	sh	What is the last day of the month that falls 6 months after September 14 2001?				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3156143				0	sh	\<item type=\"input\"\>=EOMONTH(DATE(2001;9;14);6)\</item\> returns the serial number 37346. Formatted as a date, this is 2002-03-31.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3156144				0	sh	\<item type=\"input\"\>=EOMONTH("2001-09-14";6)\</item\> works as well. If the date is given as string, it has to be in ISO format.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	tit				0	sh	Financial Functions Part Two				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149052				0	sh	Financial Functions Part Two				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148742				0	sh	\<link href=\"text/scalc/01/04060103.xhp\" name=\"Back to Financial Functions Part One\"\>Back to Financial Functions Part One\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151341				0	sh	\<link href=\"text/scalc/01/04060118.xhp\" name=\"Forward to Financial Functions Part Three\"\>Forward to Financial Functions Part Three\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3150026				0	sh	\<bookmark_value\>PPMT function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150026				0	sh	PPMT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146942				0	sh	\<ahelp hid=\"HID_FUNC_KAPZ\"\>Returns for a given period the payment on the principal for an investment that is based on periodic and constant payments and a constant interest rate.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150459				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146878				0	sh	PPMT(Rate; Period; NPer; PV; FV; Type)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151228				0	sh	\<emph\>Rate\</emph\> is the periodic interest rate.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148887				0	sh	\<emph\>Period\</emph\> is the amortizement period. P = 1 for the first and P = NPer for the last period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148436				0	sh	\<emph\>NPer\</emph\> is the total number of periods during which annuity is paid.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153035				0	sh	\<emph\>PV\</emph\> is the present value in the sequence of payments.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147474				0	sh	\<emph\>FV\</emph\> (optional) is the desired (future) value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3144744				0	sh	\<emph\>Type\</emph\> (optional) defines the due date. F = 1 for payment at the beginning of a period and F = 0 for payment at the end of a period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_idN1067C				0	sh	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3148582				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154811				0	sh	How high is the periodic monthly payment at an annual interest rate of 8.75% over a period of 3 years? The cash value is 5,000 currency units and is always paid at the beginning of a period. The future value is 8,000 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149246				0	sh	\<item type=\"input\"\>=PPMT(8.75%/12;1;36;5000;8000;1)\</item\> = -350.99 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3146139				0	sh	\<bookmark_value\>calculating; total amortizement rates\</bookmark_value\>\<bookmark_value\>total amortizement rates\</bookmark_value\>\<bookmark_value\>amortization installment\</bookmark_value\>\<bookmark_value\>repayment installment\</bookmark_value\>\<bookmark_value\>CUMPRINC function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3146139				0	sh	CUMPRINC				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150140				0	sh	\<ahelp hid=\"HID_FUNC_KUMKAPITAL\"\>Returns the cumulative interest paid for an investment period with a constant interest rate.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149188				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148733				0	sh	CUMPRINC(Rate; NPer; PV; S; E; Type)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150864				0	sh	\<emph\>Rate\</emph\> is the periodic interest rate.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3166052				0	sh	\<emph\>NPer\</emph\> is the payment period with the total number of periods. NPER can also be a non-integer value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150007				0	sh	\<emph\>PV\</emph\> is the current value in the sequence of payments.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153112				0	sh	\<emph\>S\</emph\> is the first period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146847				0	sh	\<emph\>E\</emph\> is the last period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145167				0	sh	\<emph\>Type\</emph\> is the due date of the payment at the beginning or end of each period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154502				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153570				0	sh	What are the payoff amounts if the yearly interest rate is 5.5% for 36 months? The cash value is 15,000 currency units. The payoff amount is calculated between the 10th and 18th period. The due date is at the end of the period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149884				0	sh	\<item type=\"input\"\>=CUMPRINC(5.5%/12;36;15000;10;18;0)\</item\> = -3669.74 currency units. The payoff amount between the 10th and 18th period is 3669.74 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3150019				0	sh	\<bookmark_value\>CUMPRINC_ADD function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150019				0	sh	CUMPRINC_ADD				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145246				0	sh	\<ahelp hid=\"HID_AAI_FUNC_CUMPRINC\"\> Calculates the cumulative redemption of a loan in a period.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153047				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3157970				0	sh	CUMPRINC_ADD(Rate; NPer; PV; StartPeriod; EndPeriod; Type)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145302				0	sh	\<emph\>Rate\</emph\> is the interest rate for each period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151017				0	sh	\<emph\>NPer\</emph\> is the total number of payment periods. The rate and NPER must refer to the same unit, and thus both be calculated annually or monthly.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155620				0	sh	\<emph\>PV\</emph\> is the current value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145352				0	sh	\<emph\>StartPeriod\</emph\> is the first payment period for the calculation.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3157986				0	sh	\<emph\>EndPeriod\</emph\> is the last payment period for the calculation.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150570				0	sh	\<emph\>Type\</emph\> is the maturity of a payment at the end of each period (Type = 0) or at the start of the period (Type = 1).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150269				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148774				0	sh	The following mortgage loan is taken out on a house:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150661				0	sh	Rate: 9.00 per cent per annum (9% / 12 = 0.0075), Duration: 30 years (payment periods = 30 * 12 = 360), NPV: 125000 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155512				0	sh	How much will you repay in the second year of the mortgage (thus from periods 13 to 24)?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149394				0	sh	\<item type=\"input\"\>=CUMPRINC_ADD(0.0075;360;125000;13;24;0)\</item\> returns -934.1071				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149026				0	sh	In the first month you will be repaying the following amount:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154636				0	sh	\<item type=\"input\"\>=CUMPRINC_ADD(0.0075;360;125000;1;1;0)\</item\> returns -68.27827				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3155370				0	sh	\<bookmark_value\>calculating; accumulated interests\</bookmark_value\>\<bookmark_value\>accumulated interests\</bookmark_value\>\<bookmark_value\>CUMIPMT function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155370				0	sh	CUMIPMT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3158411				0	sh	\<ahelp hid=\"HID_FUNC_KUMZINSZ\"\>Calculates the cumulative interest payments, that is, the total interest, for an investment based on a constant interest rate.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155814				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147536				0	sh	CUMIPMT(Rate; NPer; PV; S; E; Type)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150475				0	sh	\<emph\>Rate\</emph\> is the periodic interest rate.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153921				0	sh	\<emph\>NPer\</emph\> is the payment period with the total number of periods. NPER can also be a non-integer value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153186				0	sh	\<emph\>PV\</emph\> is the current value in the sequence of payments.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156259				0	sh	\<emph\>S\</emph\> is the first period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155990				0	sh	\<emph\>E\</emph\> is the last period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149777				0	sh	\<emph\>Type\</emph\> is the due date of the payment at the beginning or end of each period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153723				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147478	277			0	sh	What are the interest payments at a yearly interest rate of 5.5 %, a payment period of monthly payments for 2 years and a current cash value of 5,000 currency units? The start period is the 4th and the end period is the 6th period. The payment is due at the beginning of each period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149819				0	sh	\<item type=\"input\"\>=CUMIPMT(5.5%/12;24;5000;4;6;1)\</item\> = -57.54 currency units. The interest payments for between the 4th and 6th period are 57.54 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3083280				0	sh	\<bookmark_value\>CUMIPMT_ADD function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3083280				0	sh	CUMIPMT_ADD				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3152482				0	sh	\<ahelp hid=\"HID_AAI_FUNC_CUMIPMT\"\>Calculates the accumulated interest for a period.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149713				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145087				0	sh	CUMIPMT_ADD(Rate; NPer; PV; StartPeriod; EndPeriod; Type)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149277				0	sh	\<emph\>Rate\</emph\> is the interest rate for each period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149270				0	sh	\<emph\>NPer\</emph\> is the total number of payment periods. The rate and NPER must refer to the same unit, and thus both be calculated annually or monthly.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3152967				0	sh	\<emph\>PV\</emph\> is the current value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156308				0	sh	\<emph\>StartPeriod\</emph\> is the first payment period for the calculation.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149453				0	sh	\<emph\>EndPeriod\</emph\> is the last payment period for the calculation.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150962				0	sh	\<emph\>Type\</emph\> is the maturity of a payment at the end of each period (Type = 0) or at the start of the period (Type = 1).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3152933				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156324				0	sh	The following mortgage loan is taken out on a house:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147566				0	sh	Rate: 9.00 per cent per annum (9% / 12 = 0.0075), Duration: 30 years (NPER = 30 * 12 = 360), Pv: 125000 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151272				0	sh	How much interest must you pay in the second year of the mortgage (thus from periods 13 to 24)?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156130				0	sh	\<item type=\"input\"\>=CUMIPMT_ADD(0.0075;360;125000;13;24;0)\</item\> returns -11135.23.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150764				0	sh	How much interest must you pay in the first month?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146857				0	sh	\<item type=\"input\"\>=CUMIPMT_ADD(0.0075;360;125000;1;1;0)\</item\> returns -937.50.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3150878				0	sh	\<bookmark_value\>PRICE function\</bookmark_value\>\<bookmark_value\>prices; fixed interest securities\</bookmark_value\>\<bookmark_value\>sales values;fixed interest securities\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150878				0	sh	PRICE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153210				0	sh	\<ahelp hid=\"HID_AAI_FUNC_PRICE\"\>Calculates the market value of a fixed interest security with a par value of 100 currency units as a function of the forecast yield.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154646				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3152804				0	sh	PRICE(Settlement; Maturity; Rate; Yield; Redemption; Frequency; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156121				0	sh	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149983				0	sh	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153755				0	sh	\<emph\>Rate\</emph\> is the annual nominal rate of interest (coupon interest rate)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155999				0	sh	\<emph\>Yield\</emph\> is the annual yield of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156114				0	sh	\<emph\>Redemption\</emph\> is the redemption value per 100 currency units of par value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155846				0	sh	\<emph\>Frequency\</emph\> is the number of interest payments per year (1, 2 or 4).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153148				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150260				0	sh	A security is purchased on 1999-02-15; the maturity date is 2007-11-15. The nominal rate of interest is 5.75%. The yield is 6.5%. The redemption value is 100 currency units. Interest is paid half-yearly (frequency is 2). With calculation on basis 0, the price is as follows:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147273				0	sh	=PRICE("1999-02-15"; "2007-11-15"; 0.0575; 0.065; 100; 2; 0) returns 95.04287.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3151297				0	sh	\<bookmark_value\>PRICEDISC function\</bookmark_value\>\<bookmark_value\>prices;non-interest-bearing securities\</bookmark_value\>\<bookmark_value\>sales values;non-interest-bearing securities\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3151297				0	sh	PRICEDISC				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155100				0	sh	\<ahelp hid=\"HID_AAI_FUNC_PRICEDISC\"\>Calculates the price per 100 currency units of par value of a non-interest- bearing security.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149294				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146084				0	sh	PRICEDISC(Settlement; Maturity; Discount; Redemption; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3159179				0	sh	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154304				0	sh	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156014				0	sh	\<emph\>Discount\</emph\> is the discount of a security as a percentage.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147489				0	sh	\<emph\>Redemption\</emph\> is the redemption value per 100 currency units of par value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3152794				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149198				0	sh	A security is purchased on 1999-02-15; the maturity date is 1999-03-01. Discount in per cent is 5.25%. The redemption value is 100. When calculating on basis 2 the price discount is as follows:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151178				0	sh	=PRICEDISC("1999-02-15"; "1999-03-01"; 0.0525; 100; 2) returns 99.79583.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3154693				0	sh	\<bookmark_value\>PRICEMAT function\</bookmark_value\>\<bookmark_value\>prices;interest-bearing securities\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154693				0	sh	PRICEMAT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153906				0	sh	\<ahelp hid=\"HID_AAI_FUNC_PRICEMAT\"\>Calculates the price per 100 currency units of par value of a security, that pays interest on the maturity date.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154933				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155393				0	sh	PRICEMAT(Settlement; Maturity; Issue; Rate; Yield; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153102				0	sh	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150530				0	sh	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149903				0	sh	\<emph\>Issue\</emph\> is the date of issue of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148828				0	sh	\<emph\>Rate\</emph\> is the interest rate of the security on the issue date.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146993				0	sh	\<emph\>Yield\</emph\> is the annual yield of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150507				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154289				0	sh	Settlement date: February 15 1999, maturity date: April 13 1999, issue date: November 11 1998. Interest rate: 6.1 per cent, yield: 6.1 per cent, basis: 30/360 = 0.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154905				0	sh	The price is calculated as follows:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3158409				0	sh	=PRICEMAT("1999-02-15";"1999-04-13";"1998-11-11"; 0.061; 0.061;0) returns 99.98449888.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3148448				0	sh	\<bookmark_value\>calculating; durations\</bookmark_value\>\<bookmark_value\>durations;calculating\</bookmark_value\>\<bookmark_value\>DURATION function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3148448				0	sh	DURATION				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153056				0	sh	\<ahelp hid=\"HID_FUNC_LAUFZEIT\"\>Calculates the number of periods required by an investment to attain the desired value.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3145421				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148933				0	sh	DURATION(Rate; PV; FV)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148801				0	sh	\<emph\>Rate\</emph\> is a constant. The interest rate is to be calculated for the entire duration (duration period). The interest rate per period is calculated by dividing the interest rate by the calculated duration. The internal rate for an annuity is to be entered as Rate/12.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147239				0	sh	\<emph\>PV\</emph\> is the present (current) value. The cash value is the deposit of cash or the current cash value of an allowance in kind. As a deposit value a positive value must be entered; the deposit must not be 0 or <0.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147515				0	sh	\<emph\>FV\</emph\> is the expected value. The future value determines the desired (future) value of the deposit.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153579				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148480				0	sh	At an interest rate of 4.75%, a cash value of 25,000 currency units and a future value of 1,000,000 currency units, a duration of 79.49 payment periods is returned. The periodic payment is the resulting quotient from the future value and the duration, in this case 1,000,000/79.49=12,850.20.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3148912				0	sh	\<bookmark_value\>calculating;linear depreciations\</bookmark_value\>\<bookmark_value\>depreciations;linear\</bookmark_value\>\<bookmark_value\>linear depreciations\</bookmark_value\>\<bookmark_value\>straight-line depreciations\</bookmark_value\>\<bookmark_value\>SLN function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3148912				0	sh	SLN				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149154	291			0	sh	\<ahelp hid=\"HID_FUNC_LIA\"\>Returns the straight-line depreciation of an asset for one period.\</ahelp\>The amount of the depreciation is constant during the depreciation period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153240				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3166456				0	sh	SLN(Cost; Salvage; Life)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146955				0	sh	\<emph\>Cost\</emph\> is the initial cost of an asset.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149796				0	sh	\<emph\>Salvage\</emph\> is the value of an asset at the end of the depreciation.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3166444				0	sh	\<emph\>Life\</emph\> is the depreciation period determining the number of periods in the depreciation of the asset.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155579				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154098				0	sh	Office equipment with an initial cost of 50,000 currency units is to be depreciated over 7 years. The value at the end of the depreciation is to be 3,500 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153390				0	sh	\<item type=\"input\"\>=SLN(50000;3,500;84)\</item\> = 553.57 currency units. The periodic monthly depreciation of the office equipment is 553.57 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3153739				0	sh	\<bookmark_value\>MDURATION function\</bookmark_value\>\<bookmark_value\>Macauley duration\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153739				0	sh	MDURATION				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149923				0	sh	\<ahelp hid=\"HID_AAI_FUNC_MDURATION\"\>Calculates the modified Macauley duration of a fixed interest security in years.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149964				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148987				0	sh	MDURATION(Settlement; Maturity; Coupon; Yield; Frequency; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148619				0	sh	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149805				0	sh	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154338				0	sh	\<emph\>Coupon\</emph\> is the annual nominal rate of interest (coupon interest rate)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148466				0	sh	\<emph\>Yield\</emph\> is the annual yield of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149423				0	sh	\<emph\>Frequency\</emph\> is the number of interest payments per year (1, 2 or 4).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154602				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148652				0	sh	A security is purchased on 2001-01-01; the maturity date is 2006-01-01. The nominal rate of interest is 8%. The yield is 9.0%. Interest is paid half-yearly (frequency is 2). Using daily balance interest calculation (basis 3) how long is the modified duration?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145378				0	sh	=MDURATION("2001-01-01"; "2006-01-01"; 0.08; 0.09; 2; 3) returns 4.02 years.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3149242				0	sh	\<bookmark_value\>calculating;net present values\</bookmark_value\>\<bookmark_value\>net present values\</bookmark_value\>\<bookmark_value\>NPV function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149242				0	sh	NPV				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145308				0	sh	\<ahelp hid=\"HID_FUNC_NBW\"\>Returns the present value of an investment based on a series of periodic cash flows and a discount rate. To get the net present value, subtract the cost of the project (the initial cash flow at time zero) from the returned value.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149937				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153321				0	sh	NPV(Rate; Value1; Value2; ...)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150630				0	sh	\<emph\>Rate\</emph\> is the discount rate for a period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150427				0	sh	\<emph\>Value1;...\</emph\> are up to 30 values, which represent deposits or withdrawals.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153538				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154800				0	sh	What is the net present value of periodic payments of 10, 20 and 30 currency units with a discount rate of 8.75%. At time zero the costs were paid as -40 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3143270				0	sh	\<item type=\"input\"\>=NPV(8.75%;10;20;30)\</item\> = 49.43 currency units. The net present value is the returned value minus the initial costs of 40 currency units, therefore 9.43 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3149484				0	sh	\<bookmark_value\>calculating;nominal interest rates\</bookmark_value\>\<bookmark_value\>nominal interest rates\</bookmark_value\>\<bookmark_value\>NOMINAL function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149484				0	sh	NOMINAL				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149596				0	sh	\<ahelp hid=\"HID_FUNC_NOMINAL\"\>Calculates the yearly nominal interest rate, given the effective rate and the number of compounding periods per year.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3151252				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3152769				0	sh	NOMINAL(EffectiveRate; NPerY)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147521				0	sh	\<emph\>EffectiveRate\</emph\> is the effective interest rate				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156334				0	sh	\<emph\>NPerY\</emph\> is the number of periodic interest payments per year.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154473				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147091				0	sh	What is the nominal interest per year for an effective interest rate of 13.5% if twelve payments are made per year.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154831				0	sh	\<item type=\"input\"\>=NOMINAL(13.5%;12)\</item\> = 12.73%. The nominal interest rate per year is 12.73%.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3155123				0	sh	\<bookmark_value\>NOMINAL_ADD function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155123				0	sh	NOMINAL_ADD				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148671				0	sh	\<ahelp hid=\"HID_AAI_FUNC_NOMINAL\"\>Calculates the annual nominal rate of interest on the basis of the effective rate and the number of interest payments per annum.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155611				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156157				0	sh	NOMINAL_ADD(EffectiveRate; NPerY)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153777				0	sh	\<emph\>EffectiveRate\</emph\> is the effective annual rate of interest.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150409				0	sh	\<emph\>NPerY\</emph\> the number of interest payments per year.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3146789				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145777				0	sh	What is the nominal rate of interest for a 5.3543% effective rate of interest and quarterly payment.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156146				0	sh	\<item type=\"input\"\>=NOMINAL_ADD(5.3543%;4)\</item\> returns 0.0525 or 5.25%.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3159087				0	sh	\<bookmark_value\>DOLLARFR function\</bookmark_value\>\<bookmark_value\>converting;decimal fractions, into mixed decimal fractions\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3159087				0	sh	DOLLARFR				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150593				0	sh	\<ahelp hid=\"HID_AAI_FUNC_DOLLARFR\"\>Converts a quotation that has been given as a decimal number into a mixed decimal fraction.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3151106				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3152959				0	sh	DOLLARFR(DecimalDollar; Fraction)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149558				0	sh	\<emph\>DecimalDollar\</emph\> is a decimal number.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153672				0	sh	\<emph\>Fraction\</emph\> is a whole number that is used as the denominator of the decimal fraction.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3156274				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153795				0	sh	\<item type=\"input\"\>=DOLLARFR(1.125;16)\</item\> converts into sixteenths. The result is 1.02 for 1 plus 2/16.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150995				0	sh	\<item type=\"input\"\>=DOLLARFR(1.125;8)\</item\> converts into eighths. The result is 1.1 for 1 plus 1/8.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3154671				0	sh	\<bookmark_value\>fractions; converting\</bookmark_value\>\<bookmark_value\>converting;decimal fractions, into decimal numbers\</bookmark_value\>\<bookmark_value\>DOLLARDE function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154671				0	sh	DOLLARDE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154418				0	sh	\<ahelp hid=\"HID_AAI_FUNC_DOLLARDE\"\>Converts a quotation that has been given as a decimal fraction into a decimal number.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3146124				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150348				0	sh	DOLLARDE(FractionalDollar; Fraction)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154111				0	sh	\<emph\>FractionalDollar\</emph\> is a number given as a decimal fraction.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153695				0	sh	\<emph\>Fraction\</emph\> is a whole number that is used as the denominator of the decimal fraction.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153884				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150941				0	sh	\<item type=\"input\"\>=DOLLARDE(1.02;16)\</item\> stands for 1 and 2/16. This returns 1.125.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150830				0	sh	\<item type=\"input\"\>=DOLLARDE(1.1;8)\</item\> stands for 1 and 1/8. This returns 1.125.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3148974				0	sh	\<bookmark_value\>calculating;modified internal rates of return\</bookmark_value\>\<bookmark_value\>modified internal rates of return\</bookmark_value\>\<bookmark_value\>MIRR function\</bookmark_value\>\<bookmark_value\>internal rates of return;modified\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3148974				0	sh	MIRR				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155497				0	sh	\<ahelp hid=\"HID_FUNC_QIKV\"\>Calculates the modified internal rate of return of a series of investments.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154354				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148399				0	sh	MIRR(Values; Investment; ReinvestRate)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155896				0	sh	\<emph\>Values\</emph\> corresponds to the array or the cell reference for cells whose content corresponds to the payments.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149998				0	sh	\<emph\>Investment\</emph\> is the rate of interest of the investments (the negative values of the array)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3159408				0	sh	\<emph\>ReinvestRate\</emph\>:the rate of interest of the reinvestment (the positive values of the array)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154714				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147352				0	sh	Assuming a cell content of A1 = \<item type=\"input\"\>-5\</item\>, A2 = \<item type=\"input\"\>10\</item\>, A3 = \<item type=\"input\"\>15\</item\>, and A4 = \<item type=\"input\"\>8\</item\>, and an investment value of 0.5 and a reinvestment value of 0.1, the result is 94.16%.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3149323				0	sh	\<bookmark_value\>YIELD function\</bookmark_value\>\<bookmark_value\>rates of return;securities\</bookmark_value\>\<bookmark_value\>yields, see also rates of return\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149323				0	sh	YIELD				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150643				0	sh	\<ahelp hid=\"HID_AAI_FUNC_YIELD\"\>Calculates the yield of a security.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149344				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149744				0	sh	YIELD(Settlement; Maturity; Rate; Price; Redemption; Frequency; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154526				0	sh	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153266				0	sh	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151284				0	sh	\<emph\>Rate\</emph\> is the annual rate of interest.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147314				0	sh	\<emph\>Price\</emph\> is the price (purchase price) of the security per 100 currency units of par value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145156				0	sh	\<emph\>Redemption\</emph\> is the redemption value per 100 currency units of par value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3159218				0	sh	\<emph\>Frequency\</emph\> is the number of interest payments per year (1, 2 or 4).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3147547				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151214				0	sh	A security is purchased on 1999-02-15. It matures on 2007-11-15. The rate of interest is 5.75%. The price is 95.04287 currency units per 100 units of par value, the redemption value is 100 units. Interest is paid half-yearly (frequency = 2) and the basis is 0. How high is the yield?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154194				0	sh	=YIELD("1999-02-15"; "2007-11-15"; 0.0575 ;95.04287; 100; 2; 0) returns 0.065 or 6.50 per cent.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3150100				0	sh	\<bookmark_value\>YIELDDISC function\</bookmark_value\>\<bookmark_value\>rates of return;non-interest-bearing securities\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150100				0	sh	YIELDDISC				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150486				0	sh	\<ahelp hid=\"HID_AAI_FUNC_YIELDDISC\"\>Calculates the annual yield of a non-interest-bearing security.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149171				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3159191				0	sh	YIELDDISC(Settlement; Maturity; Price; Redemption; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150237				0	sh	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146924				0	sh	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151201				0	sh	\<emph\>Price\</emph\> is the price (purchase price) of the security per 100 currency units of par value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156049				0	sh	\<emph\>Redemption\</emph\> is the redemption value per 100 currency units of par value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154139				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3163815				0	sh	A non-interest-bearing security is purchased on 1999-02-15. It matures on 1999-03-01. The price is 99.795 currency units per 100 units of par value, the redemption value is 100 units. The basis is 2. How high is the yield?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155187				0	sh	=YIELDDISC("1999-02-15"; "1999-03-01"; 99.795; 100; 2) returns 0.052823 or 5.2823 per cent.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3155140				0	sh	\<bookmark_value\>YIELDMAT function\</bookmark_value\>\<bookmark_value\>rates of return;securities with interest paid on maturity\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155140				0	sh	YIELDMAT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151332				0	sh	\<ahelp hid=\"HID_AAI_FUNC_YIELDMAT\"\>Calculates the annual yield of a security, the interest of which is paid on the date of maturity.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3159100				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3159113				0	sh	YIELDMAT(Settlement; Maturity; Issue; Rate; Price; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149309				0	sh	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151381				0	sh	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153302				0	sh	\<emph\>Issue\</emph\> is the date of issue of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147140				0	sh	\<emph\>Rate\</emph\> is the interest rate of the security on the issue date.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151067				0	sh	\<emph\>Price\</emph\> is the price (purchase price) of the security per 100 currency units of par value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155342				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3163717				0	sh	A security is purchased on 1999-03-15. It matures on 1999-11-03. The issue date was 1998-11-08. The rate of interest is 6.25%, the price is 100.0123 units. The basis is 0. How high is the yield?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155311				0	sh	=YIELDMAT("1999-03-15"; "1999-11-03"; "1998-11-08"; 0.0625; 100.0123; 0) returns 0.060954 or 6.0954 per cent.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3149577				0	sh	\<bookmark_value\>calculating;annuities\</bookmark_value\>\<bookmark_value\>annuities\</bookmark_value\>\<bookmark_value\>PMT function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149577				0	sh	PMT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148563				0	sh	\<ahelp hid=\"HID_FUNC_RMZ\"\>Returns the periodic payment for an annuity with constant interest rates.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3145257				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147278				0	sh	PMT(Rate; NPer; PV; FV; Type)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147291				0	sh	\<emph\>Rate\</emph\> is the periodic interest rate.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148641				0	sh	\<emph\>NPer\</emph\> is the number of periods in which annuity is paid.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156360				0	sh	\<emph\>PV\</emph\> is the present value (cash value) in a sequence of payments.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154920				0	sh	\<emph\>FV\</emph\> (optional) is the desired value (future value) to be reached at the end of the periodic payments.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156434				0	sh	\<emph\>Type\</emph\> (optional) is the due date for the periodic payments. Type=1 is payment at the beginning and Type=0 is payment at the end of each period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_idN11645				0	sh	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3152358				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154222				0	sh	What are the periodic payments at a yearly interest rate of 1.99% if the payment time is 3 years and the cash value is 25,000 currency units. There are 36 months as 36 payment periods, and the interest rate per payment period is 1.99%/12.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155943				0	sh	\<item type=\"input\"\>=PMT(1.99%/12;36;25000)\</item\> = -715.96 currency units. The periodic monthly payment is therefore 715.96 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3155799				0	sh	\<bookmark_value\>TBILLEQ function\</bookmark_value\>\<bookmark_value\>treasury bills;annual return\</bookmark_value\>\<bookmark_value\>annual return on treasury bills\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155799				0	sh	TBILLEQ				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154403				0	sh	\<ahelp hid=\"HID_AAI_FUNC_TBILLEQ\"\>Calculates the annual return on a treasury bill ().\</ahelp\> A treasury bill is purchased on the settlement date and sold at the full par value on the maturity date, that must fall within the same year. A discount is deducted from the purchase price.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155080				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150224				0	sh	TBILLEQ(Settlement; Maturity; Discount)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156190				0	sh	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153827				0	sh	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150310				0	sh	\<emph\>Discount\</emph\> is the percentage discount on acquisition of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150324				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153173				0	sh	Settlement date: March 31 1999, maturity date: June 1 1999, discount: 9.14 per cent.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153520				0	sh	The return on the treasury bill corresponding to a security is worked out as follows:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154382				0	sh	=TBILLEQ("1999-03-31";"1999-06-01"; 0.0914) returns 0.094151 or 9.4151 per cent.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3151032				0	sh	\<bookmark_value\>TBILLPRICE function\</bookmark_value\>\<bookmark_value\>treasury bills;prices\</bookmark_value\>\<bookmark_value\>prices;treasury bills\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3151032				0	sh	TBILLPRICE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3157887				0	sh	\<ahelp hid=\"HID_AAI_FUNC_TBILLPRICE\"\>Calculates the price of a treasury bill per 100 currency units.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3156374				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150284				0	sh	TBILLPRICE(Settlement; Maturity; Discount)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154059				0	sh	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154073				0	sh	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145765				0	sh	\<emph\>Discount\</emph\> is the percentage discount upon acquisition of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153373				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155542				0	sh	Settlement date: March 31 1999, maturity date: June 1 1999, discount: 9 per cent.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154578				0	sh	The price of the treasury bill is worked out as follows:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154592				0	sh	=TBILLPRICE("1999-03-31";"1999-06-01"; 0.09) returns 98.45.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3152912				0	sh	\<bookmark_value\>TBILLYIELD function\</bookmark_value\>\<bookmark_value\>treasury bills;rates of return\</bookmark_value\>\<bookmark_value\>rates of return of treasury bills\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3152912				0	sh	TBILLYIELD				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145560				0	sh	\<ahelp hid=\"HID_AAI_FUNC_TBILLYIELD\"\>Calculates the yield of a treasury bill.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3145578				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156077				0	sh	TBILLYIELD(Settlement; Maturity; Price)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156091				0	sh	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3157856				0	sh	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149627				0	sh	\<emph\>Price\</emph\> is the price (purchase price) of the treasury bill per 100 currency units of par value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149642				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145178				0	sh	Settlement date: March 31 1999, maturity date: June 1 1999, price: 98.45 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145193				0	sh	The yield of the treasury bill is worked out as follows:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148528				0	sh	=TBILLYIELD("1999-03-31";"1999-06-01"; 98.45) returns 0.091417 or 9.1417 per cent.				20181231 09:50:43
