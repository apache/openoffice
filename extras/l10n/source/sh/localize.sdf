helpcontent2	source\text\swriter\01\06100000.xhp	0	help	par_id3150973				0	sh	\<ahelp hid=\"SW:RADIOBUTTON:DLG_SORTING:RB_COL\"\>Sorts the columns in the table according to the current sort options.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\06100000.xhp	0	help	hd_id3147526				0	sh	Rows				20181231 09:50:43
helpcontent2	source\text\swriter\01\06100000.xhp	0	help	par_id3153677				0	sh	\<ahelp hid=\"SW:RADIOBUTTON:DLG_SORTING:RB_ROW\"\>Sorts the rows in the table or the paragraphs in the selection according to the current sort options.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\06100000.xhp	0	help	hd_id3151312				0	sh	Separator				20181231 09:50:43
helpcontent2	source\text\swriter\01\06100000.xhp	0	help	par_id3150350				0	sh	Paragraphs are separated by nonprinting paragraph marks. You can also specify that tabs or a character act as separators when you sort paragraphs.				20181231 09:50:43
helpcontent2	source\text\swriter\01\06100000.xhp	0	help	hd_id3154570				0	sh	Tabs				20181231 09:50:43
helpcontent2	source\text\swriter\01\06100000.xhp	0	help	par_id3155902				0	sh	\<ahelp hid=\"SW:RADIOBUTTON:DLG_SORTING:RB_TAB\"\>If the selected paragraphs correspond to a list separated by tabs, select this option.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\06100000.xhp	0	help	hd_id3154190				0	sh	Character				20181231 09:50:43
helpcontent2	source\text\swriter\01\06100000.xhp	0	help	par_id3159196				0	sh	\<ahelp hid=\"SW:EDIT:DLG_SORTING:ED_TABCH\"\>Enter the character that you want to use as a separator in the selected area.\</ahelp\> By using the separator, $[officename] can determine the position of the sorting key in the selected paragraph.				20181231 09:50:43
helpcontent2	source\text\swriter\01\06100000.xhp	0	help	hd_id3151324				0	sh	...				20181231 09:50:43
