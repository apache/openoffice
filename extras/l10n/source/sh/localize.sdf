helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	hd_id3152960				0	sh	\<variable id=\"eastersunday\"\>\<link href=\"text/scalc/01/func_eastersunday.xhp\"\>EASTERSUNDAY\</link\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3154570				0	sh	\<ahelp hid=\"HID_FUNC_OSTERSONNTAG\"\>Returns the date of Easter Sunday for the entered year.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	hd_id9460127				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id2113711				0	sh	EASTERSUNDAY(Year)				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3938413				0	sh	\<emph\>Year\</emph\> is an integer between 1583 and 9956 or 0 and 99. You can also calculate other holidays by simple addition with this date.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3156156				0	sh	Easter Monday = EASTERSUNDAY(Year) + 1				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3147521				0	sh	Good Friday = EASTERSUNDAY(Year) - 2				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3146072				0	sh	Pentecost Sunday = EASTERSUNDAY(Year) + 49				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3149553				0	sh	Pentecost Monday = EASTERSUNDAY(Year) + 50				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	hd_id3155120				0	sh	Examples				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3154472				0	sh	=EASTERSUNDAY(2000) returns 2000-04-23.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3150940				0	sh	EASTERSUNDAY(2000)+49 returns the internal serial number 36688. The result is 2000-06-11. Format the serial date number as a date, for example in the format YYYY-MM-DD.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	tit				0	sh	Function Wizard				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	bm_id3147426				0	sh	\<bookmark_value\>inserting functions; Function Wizard\</bookmark_value\>\<bookmark_value\>functions;Function Wizard\</bookmark_value\>\<bookmark_value\>wizards; functions\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3147426				0	sh	\<link href=\"text/scalc/01/04060000.xhp\" name=\"AutoPilot: Functions\"\>Function Wizard\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3145271				0	sh	\<variable id=\"funktionsautopilottext\"\>\<ahelp hid=\".uno:FunctionDialog\"\>Opens the \<emph\>Function Wizard\</emph\>, which helps you to interactively create formulas.\</ahelp\>\</variable\> Before you start the Wizard, select a cell or a range of cells from the current sheet, in order to determine the position at which the formula will be inserted.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id8007446				0	sh	You can download the complete ODFF (OpenDocument Format Formula) specification from the \<link href=\"http://www.oasis-open.org/committees/documents.php?wg_abbrev=office-formula\"\>OASIS\</link\> web site.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3159153				0	sh	The \<emph\>Function Wizard\</emph\> has two tabs: \<emph\>Functions\</emph\> is used to create formulas, and \<emph\>Structure\</emph\> is used to check the formula build.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3154490				0	sh	Functions Tab				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3149378				0	sh	\<link href=\"text/scalc/01/04060100.xhp\" name=\"List of Categories and Functions\"\>List of Categories and Functions\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3154730				0	sh	Category				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3153417	37			0	sh	\<variable id=\"kategorienliste\"\>\<ahelp hid=\"SC:LISTBOX:RID_SCTAB_FUNCTION:LB_CATEGORY\"\>Lists all the categories to which the different functions are assigned. Select a category to view the appropriate functions in the list field below.\</ahelp\> Select "All" to view all functions in alphabetical order, irrespective of category. "Last Used" lists the functions you have most recently used. \</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3150749				0	sh	Function				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3155445				0	sh	\<ahelp hid=\"SC:LISTBOX:RID_SCTAB_FUNCTION:LB_FUNCTION\"\>Displays the functions found under the selected category. Double-click to select a function.\</ahelp\> A single-click displays a short function description.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3159264				0	sh	Array				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3149566	9			0	sh	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_FORMULA:BTN_MATRIX\"\>Specifies that the selected function is inserted into the selected cell range as an array formula. \</ahelp\> Array formulas operate on multiple cells. Each cell in the array contains the formula, not as a copy but as a common formula shared by all matrix cells.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3155959				0	sh	The \<emph\>Array\</emph\> option is identical to the \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+Shift+Enter command, which is used to enter and confirm formulas in the sheet. The formula is inserted as a matrix formula indicated by two braces { }.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3152993				0	sh	The maximum size of an array range is 128 by 128 cells.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3150367				0	sh	Argument Input Fields				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3145587				0	sh	When you double-click a function, the argument input field(s) appear on the right side of the dialog. To select a cell reference as an argument, click directly into the cell, or drag across the required range on the sheet while holding down the mouse button. You can also enter numerical and other values or references directly into the corresponding fields in the dialog. When using \<link href=\"text/scalc/01/04060102.xhp\" name=\"date entries\"\>date entries\</link\>, make sure you use the correct format. Click OK to insert the result into the spreadsheet.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3149408				0	sh	Function Result				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3155809				0	sh	As soon you enter arguments in the function, the result is calculated. This preview informs you if the calculation can be carried out with the arguments given. If the arguments result in an error, the corresponding \<link href=\"text/scalc/05/02140000.xhp\" name=\"error code\"\>error code\</link\> is displayed.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3148700				0	sh	The required arguments are indicated by names in bold print.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3153064				0	sh	f(x) (depending on the selected function)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3157980				0	sh	\<ahelp hid=\"HID_SC_FAP_BTN_FX4\"\>Allows you to access a subordinate level of the \<emph\>Function Wizard\</emph\> in order to nest another function within the function, instead of a value or reference.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3145076				0	sh	Argument/Parameter/Cell Reference (depending on the selected function)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3159097				0	sh	\<ahelp hid=\"SC:EDIT:RID_SCDLG_FORMULA:ED_REF\"\>The number of visible text fields depends on the function. Enter arguments either directly into the argument fields or by clicking a cell in the table.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3154957				0	sh	Result				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3150211				0	sh	Displays the calculation result or an error message.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3151304				0	sh	Formula				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3149898				0	sh	\<ahelp hid=\"HID_SC_FAP_FORMULA\"\>Displays the created formula. Type your entries directly, or create the formula using the wizard.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3153249				0	sh	Back				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3152869				0	sh	\<ahelp hid=\"SC:PUSHBUTTON:RID_SCDLG_FORMULA:BTN_BACKWARD\"\>Moves the focus back through the formula components, marking them as it does so.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3146966				0	sh	To select a single function from a complex formula consisting of several functions, double-click the function in the formula window.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3155762				0	sh	Next				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3149316	55			0	sh	\<ahelp hid=\"SC:PUSHBUTTON:RID_SCDLG_FORMULA:BTN_FORWARD\"\>Moves forward through the formula components in the formula window.\</ahelp\> This button can also be used to assign functions to the formula. If you select a function and click the \<emph\>Next \</emph\>button, the selection appears in the formula window.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3159262				0	sh	Double-click a function in the selection window to transfer it to the formula window.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3148745				0	sh	Cancel				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3147402				0	sh	Closes the dialog without implementing the formula.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3150534				0	sh	OK				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3153029				0	sh	Ends the \<emph\>Function Wizard\</emph\>, and transfers the formula to the selected cells.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3156400				0	sh	\<link href=\"text/scalc/01/04060100.xhp\" name=\"List of Categories and Functions\"\>List of Categories and Functions\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3147610				0	sh	Structure tab				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3153122				0	sh	On this page, you can view the structure of the function.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3149350				0	sh	If you start the \<emph\>Function Wizard\</emph\> while the cell cursor is positioned in a cell that already contains a function, the \<emph\>Structure\</emph\> tab is opened and shows the composition of the current formula.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3149014				0	sh	Structure				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3150481				0	sh	\<ahelp hid=\"HID_SC_FAP_STRUCT\"\>Displays a hierarchical representation of the current function.\</ahelp\> You can hide or show the arguments by a click on the plus or minus sign in front.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3148886				0	sh	Blue dots denote correctly entered arguments. Red dots indicate incorrect data types. For example: if the SUM function has one argument entered as text, this is highlighted in red as SUM only permits number entries.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	tit				0	sh	Statistical Functions Part Four				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153415				0	sh	\<variable id=\"mq\"\>\<link href=\"text/scalc/01/04060184.xhp\" name=\"Statistical Functions Part Four\"\>Statistical Functions Part Four\</link\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3154511				0	sh	\<bookmark_value\>MAX function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154511				0	sh	MAX				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153709				0	sh	\<ahelp hid=\"HID_FUNC_MAX\"\>Returns the maximum value in a list of arguments.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id9282509				0	sh	Returns 0 if no numeric value and no error was encountered in the cell range(s) passed as cell reference(s). Text cells are ignored by MIN() and MAX(). The functions MINA() and MAXA() return 0 if no value (numeric or text) and no error was encountered. Passing a literal string argument to MIN() or MAX(), e.g. MIN("string"), still results in an error.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154256				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147340				0	sh	MAX(Number1; Number2; ...Number30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149568	6			0	sh	\<emph\>Number1; Number2;...Number30\</emph\> are numerical values or ranges. 				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153963				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147343				0	sh	\<item type=\"input\"\>=MAX(A1;A2;A3;50;100;200)\</item\> returns the largest value from the list.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148485				0	sh	\<item type=\"input\"\>=MAX(A1:B100)\</item\> returns the largest value from the list.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3166426				0	sh	\<bookmark_value\>MAXA function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3166426				0	sh	MAXA				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150363				0	sh	\<ahelp hid=\"HID_FUNC_MAXA\"\>Returns the maximum value in a list of arguments. In opposite to MAX, here you can enter text. The value of the text is 0.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id7689443				0	sh	The functions MINA() and MAXA() return 0 if no value (numeric or text) and no error was encountered.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150516				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3166431				0	sh	MAXA(Value1; Value2; ... Value30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150202				0	sh	\<emph\>Value1; Value2;...Value30\</emph\> are values or ranges. Text has the value of 0.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3156290				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156446				0	sh	\<item type=\"input\"\>=MAXA(A1;A2;A3;50;100;200;"Text")\</item\> returns the largest value from the list.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149404				0	sh	\<item type=\"input\"\>=MAXA(A1:B100)\</item\> returns the largest value from the list.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153820				0	sh	\<bookmark_value\>MEDIAN function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153820				0	sh	MEDIAN				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151241				0	sh	\<ahelp hid=\"HID_FUNC_MEDIAN\"\>Returns the median of a set of numbers. In a set containing an uneven number of values, the median will be the number in the middle of the set and in a set containing an even number of values, it will be the mean of the two values in the middle of the set.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148871				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155264				0	sh	MEDIAN(Number1; Number2; ...Number30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150109				0	sh	\<emph\>Number1; Number2;...Number30\</emph\> are values or ranges, which represent a sample. Each number can also be replaced by a reference.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3144506				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145078				0	sh	for an odd number: \<item type=\"input\"\>=MEDIAN(1;5;9;20;21)\</item\> returns 9 as the median value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149126				0	sh	for an even number: \<item type=\"input\"\>=MEDIAN(1;5;9;20)\</item\> returns the average of the two middle values 5 and 9, thus 7.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3154541				0	sh	\<bookmark_value\>MIN function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154541				0	sh	MIN				20181231 09:50:43
