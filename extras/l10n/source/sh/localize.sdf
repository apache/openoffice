helpcontent2	source\text\sbasic\shared\03120101.xhp	0	help	hd_id3150499				0	sh	\<link href=\"text/sbasic/shared/03120101.xhp\" name=\"Asc Function [Runtime]\"\>Asc Function [Runtime]\</link\>				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03120101.xhp	0	help	par_id3151384				0	sh	Returns the ASCII (American Standard Code for Information Interchange) value of the first character in a string expression.				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03120101.xhp	0	help	hd_id3155555				0	sh	Syntax:				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03120101.xhp	0	help	par_id3143267				0	sh	Asc (Text As String)				20181231 09:50:43
