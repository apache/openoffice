helpcontent2	source\text\sbasic\shared\03090405.xhp	0	help	par_id3148648				0	sh	MyMessageBeep( lValue )				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03090405.xhp	0	help	par_id3145750				0	sh	FreeLibrary("user32.dll" )				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03090405.xhp	0	help	par_id3149412				0	sh	End Sub				20181231 09:50:43
