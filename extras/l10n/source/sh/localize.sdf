helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3147088				0	sh	\<ahelp hid=\"SD:RADIOBUTTON:DLG_PUBLISHING:PAGE2_STANDARD\"\>Creates standard HTML pages from export pages.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3145071				0	sh	Standard HTML with frames				20181231 09:50:43
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3154824				0	sh	\<ahelp hid=\"SD:RADIOBUTTON:DLG_PUBLISHING:PAGE2_FRAMES\"\>Creates standard HTML pages with frames. The exported page will be placed in the main frame, and the frame to the left will display a table of contents in the form of hyperlinks.\</ahelp\>				20181231 09:50:43
