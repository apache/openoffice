helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3149530				0	sh	LARGE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150518				0	sh	\<ahelp hid=\"HID_FUNC_KGROESSTE\"\>Returns the Rank_c-th largest value in a data set.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3152990				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154372				0	sh	LARGE(Data; RankC)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3152986				0	sh	\<emph\>Data\</emph\> is the cell range of data.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3156448				0	sh	\<emph\>RankC\</emph\> is the ranking of the value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3152889				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3148702				0	sh	\<item type=\"input\"\>=LARGE(A1:C50;2)\</item\> gives the second largest value in A1:C50.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3154532				0	sh	\<bookmark_value\>SMALL function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3154532				0	sh	SMALL				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3157981				0	sh	\<ahelp hid=\"HID_FUNC_KKLEINSTE\"\>Returns the Rank_c-th smallest value in a data set.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3154957				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153974				0	sh	SMALL(Data; RankC)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154540				0	sh	\<emph\>Data\</emph\> is the cell range of data.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155094				0	sh	\<emph\>RankC\</emph\> is the rank of the value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3153247				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149897				0	sh	\<item type=\"input\"\>=SMALL(A1:C50;2)\</item\> gives the second smallest value in A1:C50.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3153559				0	sh	\<bookmark_value\>CONFIDENCE function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3153559				0	sh	CONFIDENCE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153814				0	sh	\<ahelp hid=\"HID_FUNC_KONFIDENZ\"\>Returns the (1-alpha) confidence interval for a normal distribution.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3149315				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3147501				0	sh	CONFIDENCE(Alpha; StDev; Size)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149872				0	sh	\<emph\>Alpha\</emph\> is the level of the confidence interval.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145324				0	sh	\<emph\>StDev\</emph\> is the standard deviation for the total population.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153075				0	sh	\<emph\>Size\</emph\> is the size of the total population.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150435				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153335				0	sh	\<item type=\"input\"\>=CONFIDENCE(0.05;1.5;100)\</item\> gives 0.29.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3148746				0	sh	\<bookmark_value\>CORREL function\</bookmark_value\>\<bookmark_value\>coefficient of correlation\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3148746				0	sh	CORREL				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3147299				0	sh	\<ahelp hid=\"HID_FUNC_KORREL\"\>Returns the correlation coefficient between two data sets.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3156397				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153023				0	sh	CORREL(Data1; Data2)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150036				0	sh	\<emph\>Data1\</emph\> is the first data set.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153021				0	sh	\<emph\>Data2\</emph\> is the second data set.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3149720				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149941				0	sh	\<item type=\"input\"\>=CORREL(A1:A50;B1:B50)\</item\> calculates the correlation coefficient as a measure of the linear correlation of the two data sets.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3150652				0	sh	\<bookmark_value\>COVAR function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150652				0	sh	COVAR				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3146875				0	sh	\<ahelp hid=\"HID_FUNC_KOVAR\"\>Returns the covariance of the product of paired deviations.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3149013				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150740				0	sh	COVAR(Data1; Data2)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145827				0	sh	\<emph\>Data1\</emph\> is the first data set.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150465				0	sh	\<emph\>Data2\</emph\> is the second data set.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3154677				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3144748				0	sh	\<item type=\"input\"\>=COVAR(A1:A30;B1:B30)\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3147472				0	sh	\<bookmark_value\>CRITBINOM function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3147472				0	sh	CRITBINOM				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149254				0	sh	\<ahelp hid=\"HID_FUNC_KRITBINOM\"\>Returns the smallest value for which the cumulative binomial distribution is less than or equal to a criterion value.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3153930				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3148586				0	sh	CRITBINOM(Trials; SP; Alpha)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145593				0	sh	\<emph\>Trials\</emph\> is the total number of trials.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153084				0	sh	\<emph\>SP\</emph\> is the probability of success for one trial.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149726				0	sh	\<emph\>Alpha\</emph\> is the threshold probability to be reached or exceeded.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3148752				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3148740				0	sh	\<item type=\"input\"\>=CRITBINOM(100;0.5;0.1)\</item\> yields 44.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3155956				0	sh	\<bookmark_value\>KURT function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3155956				0	sh	KURT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153108				0	sh	\<ahelp hid=\"HID_FUNC_KURT\"\>Returns the kurtosis of a data set (at least 4 values required).\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150334				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154508				0	sh	KURT(Number1; Number2; ...Number30)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145167				0	sh	\<emph\>Number1,Number2,...Number30\</emph\> are numeric arguments or ranges representing a random sample of distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3158000				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150016				0	sh	\<item type=\"input\"\>=KURT(A1;A2;A3;A4;A5;A6)\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3150928				0	sh	\<bookmark_value\>LOGINV function\</bookmark_value\>\<bookmark_value\>inverse of lognormal distribution\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150928				0	sh	LOGINV				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145297				0	sh	\<ahelp hid=\"HID_FUNC_LOGINV\"\>Returns the inverse of the lognormal distribution.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3151016				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153049				0	sh	LOGINV(Number; Mean; StDev)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3148390				0	sh	\<emph\>Number\</emph\> is the probability value for which the inverse standard logarithmic distribution is to be calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149538				0	sh	\<emph\>Mean\</emph\> is the arithmetic mean of the standard logarithmic distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145355				0	sh	\<emph\>StDev\</emph\> is the standard deviation of the standard logarithmic distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3148768				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155623				0	sh	\<item type=\"input\"\>=LOGINV(0.05;0;1)\</item\> returns 0.19.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3158417				0	sh	\<bookmark_value\>LOGNORMDIST function\</bookmark_value\>\<bookmark_value\>cumulative lognormal distribution\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3158417				0	sh	LOGNORMDIST				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154953				0	sh	\<ahelp hid=\"HID_FUNC_LOGNORMVERT\"\>Returns the cumulative lognormal distribution.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150474				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150686				0	sh	LOGNORMDIST(Number; Mean; StDev; Cumulative)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154871				0	sh	\<emph\>Number\</emph\> is the probability value for which the standard logarithmic distribution is to be calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155820				0	sh	\<emph\>Mean\</emph\> (optional) is the mean value of the standard logarithmic distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155991				0	sh	\<emph\>StDev\</emph\> (optional) is the standard deviation of the standard logarithmic distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155992				0	sh	\<emph\>Cumulative\</emph\> (optional) = 0 calculates the density function, Cumulative = 1 calculates the distribution.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3153178				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149778				0	sh	\<item type=\"input\"\>=LOGNORMDIST(0.1;0;1)\</item\> returns 0.01.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12040400.xhp	0	help	tit				0	sh	Remove Filter				20181231 09:50:43
helpcontent2	source\text\scalc\01\12040400.xhp	0	help	hd_id3153087				0	sh	\<link href=\"text/scalc/01/12040400.xhp\" name=\"Remove Filter\"\>Remove Filter\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12040400.xhp	0	help	par_id3154760				0	sh	\<ahelp hid=\".uno:DataFilterRemoveFilter\"\>Removes the filter from the selected cell range. To enable this command, click inside the cell area where the filter was applied.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\05050300.xhp	0	help	tit				0	sh	Show Sheet				20181231 09:50:43
helpcontent2	source\text\scalc\01\05050300.xhp	0	help	bm_id3148946				0	sh	\<bookmark_value\>sheets; displaying\</bookmark_value\>\<bookmark_value\>displaying; sheets\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\05050300.xhp	0	help	hd_id3148946				0	sh	Show Sheet				20181231 09:50:43
helpcontent2	source\text\scalc\01\05050300.xhp	0	help	par_id3148799				0	sh	\<variable id=\"tabeintext\"\>\<ahelp visibility=\"visible\" hid=\".uno:Show\"\>Displays sheets that were previously hidden with the \<emph\>Hide\</emph\> command.\</ahelp\>\</variable\> Select one sheet only to call the command. The current sheet is always selected. If a sheet other than the current sheet is selected, you can deselect it by pressing \<switchinline select=\"sys\"\> \<caseinline select=\"MAC\"\>Command\</caseinline\> \<defaultinline\>Ctrl\</defaultinline\> \</switchinline\> while clicking the corresponding sheet tab at the bottom of the window.				20181231 09:50:43
helpcontent2	source\text\scalc\01\05050300.xhp	0	help	hd_id3151112				0	sh	Hidden sheets				20181231 09:50:43
helpcontent2	source\text\scalc\01\05050300.xhp	0	help	par_id3145273				0	sh	\<ahelp hid=\"SC:MULTILISTBOX:RID_SCDLG_SHOW_TAB:LB_ENTRYLIST\" visibility=\"visible\"\>Displays a list of all hidden sheets in your spreadsheet document.\</ahelp\> To show a certain sheet, click the corresponding entry on the list and confirm with OK.				20181231 09:50:43
helpcontent2	source\text\scalc\01\05040000.xhp	0	help	tit				0	sh	Column				20181231 09:50:43
