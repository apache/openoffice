helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153748				0	sh	\<ahelp hid=\"HID_FUNC_WIEDERHOLEN\"\>Repeats a character string by the given \<emph\>number\</emph\> of copies.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152884				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150494				0	sh	REPT("Text"; Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154859	197			0	sh	            \<emph\>Text\</emph\> is the text to be repeated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150638	198			0	sh	            \<emph\>Number\</emph\> is the number of repetitions.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149922				0	sh	The result can be a maximum of 255 characters.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3156213				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148626	200			0	sh	            \<item type=\"input\"\>=REPT("Good morning";2)\</item\> returns Good morningGood morning.				20181231 09:50:43
