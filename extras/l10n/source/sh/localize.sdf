helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	hd_id3153896				0	sh	\<link href=\"text/sbasic/shared/03080103.xhp\" name=\"Sin Function [Runtime]\"\>Sin Function [Runtime]\</link\>				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3149456				0	sh	Returns the sine of an angle. The angle is specified in radians. The result lies between -1 and 1.				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3153379				0	sh	Using the angle Alpha, the Sin Function returns the ratio of the length of the opposite side of an angle to the length of the hypotenuse in a right-angled triangle.				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3148798				0	sh	Sin(Alpha) = side opposite the angle/hypotenuse				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	hd_id3147230				0	sh	Syntax:				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3154909				0	sh	Sin (Number)				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	hd_id3156214				0	sh	Return value:				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3150870				0	sh	Double				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	hd_id3155132				0	sh	Parameters:				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3145786				0	sh	\<emph\>Number:\</emph\> Numeric expression that defines the angle in radians that you want to calculate the sine for.				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3155413				0	sh	To convert degrees to radians, multiply degrees by Pi/180, and to convert radians to degrees, multiply radians by 180/Pi.				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3149664				0	sh	grad=(radiant*180)/pi				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3153143				0	sh	radiant=(grad*pi)/180				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3151112				0	sh	Pi is approximately 3.141593.				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	hd_id3163712				0	sh	Example:				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3149482				0	sh	REM In this example, the following entry is possible for a right-angled triangle:				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3148577				0	sh	REM The side opposite the angle and the angle (in degrees) to calculate the length of the hypotenuse:				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3152941				0	sh	Sub ExampleSine				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3150011				0	sh	REM Pi = 3.1415926 is a predefined variable				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3153159				0	sh	Dim d1 as Double				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3154491				0	sh	Dim dAlpha as Double				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3145251				0	sh	d1 = InputBox$ ("Enter the length of the opposite side: ","Opposite Side")				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3148456				0	sh	dAlpha = InputBox$ ("Enter the angle Alpha (in degrees): ","Alpha")				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3153877				0	sh	Print "The length of the hypotenuse is"; (d1 / sin (dAlpha * Pi / 180))				20181231 09:50:43
