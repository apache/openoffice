helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	hd_id3151254				0	sh	\<variable id=\"networkdays\"\>\<link href=\"text/scalc/01/func_networkdays.xhp\"\>NETWORKDAYS\</link\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	par_id3153788				0	sh	\<ahelp hid=\"HID_AAI_FUNC_NETWORKDAYS\"\>Returns the number of workdays between a \<emph\>start date and an end date\</emph\>. Holidays can be deducted.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	hd_id3148677				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	par_id3145775				0	sh	NETWORKDAYS(StartDate; EndDate; Holidays)				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	par_id3153885				0	sh	\<emph\>StartDate\</emph\> is the date from when the calculation is carried out. If the start date is a workday, the day is included in the calculation.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	par_id3151110				0	sh	\<emph\>EndDate\</emph\> is the date up until when the calculation is carried out. If the end date is a workday, the day is included in the calculation.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	par_id3154115				0	sh	\<emph\>Holidays\</emph\> is an optional list of holidays. These are non-working days. Enter a cell range in which the holidays are listed individually.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	hd_id3146902				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	par_id3154661				0	sh	How many workdays fall between 2001-12-15 and 2002-01-15? The start date is located in C3 and the end date in D3. Cells F3 to J3 contain the following Christmas and New Year holidays: "2001-12-24", "2001-12-25", "2001-12-26", "2001-12-31", "2002-01-01".				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	par_id3147328				0	sh	=NETWORKDAYS(C3;D3;F3:J3) returns 17 workdays.				20181231 09:50:43
helpcontent2	source\text\scalc\01\05080200.xhp	0	help	tit				0	sh	Remove				20181231 09:50:43
helpcontent2	source\text\scalc\01\05080200.xhp	0	help	hd_id3153562				0	sh	\<link href=\"text/scalc/01/05080200.xhp\" name=\"Remove\"\>Remove\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\05080200.xhp	0	help	par_id3148550				0	sh	\<ahelp hid=\".uno:DeletePrintArea\"\>Removes the defined print area.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	tit				0	sh	Text Functions				20181231 09:50:43
