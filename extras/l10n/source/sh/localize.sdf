helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3146869				0	sh	MONTHS(StartDate; EndDate; Type)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3145075				0	sh	\<emph\>StartDate\</emph\> is the first date				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3157981				0	sh	\<emph\>EndDate\</emph\> is the second date				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150111				0	sh	\<emph\>Type\</emph\> calculates the type of difference. Possible values include 0 (interval) and 1 (in calendar months).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3159094				0	sh	\<bookmark_value\>ROT13 function\</bookmark_value\>\<bookmark_value\>encrypting text\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3159094				0	sh	ROT13				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3146781				0	sh	\<ahelp hid=\"HID_DAI_FUNC_ROT13\"\>Encrypts a character string by moving the characters 13 positions in the alphabet.\</ahelp\> After the letter Z, the alphabet begins again (Rotation). By applying the encryption function again to the resulting code, you can decrypt the text.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3150893				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3159205				0	sh	ROT13(Text)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153249				0	sh	\<emph\>Text\</emph\> is the character string to be encrypted. ROT13(ROT13(Text)) decrypts the code.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3151300				0	sh	\<bookmark_value\>DAYSINYEAR function\</bookmark_value\>\<bookmark_value\>number of days; in a specific year\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3151300				0	sh	DAYSINYEAR				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3143220				0	sh	\<ahelp hid=\"HID_DAI_FUNC_DAYSINYEAR\"\>Calculates the number of days of the year in which the date entered occurs.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3145358				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3154651				0	sh	DAYSINYEAR(Date)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153803				0	sh	\<emph\>Date\</emph\> is any date in the respective year. The Date parameter must be a valid date according to the locale settings of %PRODUCTNAME.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3153487				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153811				0	sh	=DAYSINYEAR(A1) returns 366 days if A1 contains 1968-02-29, a valid date for the year 1968.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3154737				0	sh	\<bookmark_value\>DAYSINMONTH function\</bookmark_value\>\<bookmark_value\>number of days;in a specific month of a year\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3154737				0	sh	DAYSINMONTH				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3149316				0	sh	\<ahelp hid=\"HID_DAI_FUNC_DAYSINMONTH\"\>Calculates the number of days of the month in which the date entered occurs.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3145114				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150955				0	sh	DAYSINMONTH(Date)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3147501				0	sh	\<emph\>Date\</emph\> is any date in the respective month of the desired year. The Date parameter must be a valid date according to the locale settings of %PRODUCTNAME.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3149871				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3155742				0	sh	=DAYSINMONTH(A1) returns 29 days if A1 contains 1968-02-17, a valid date for February 1968.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3149048				0	sh	\<bookmark_value\>WEEKS function\</bookmark_value\>\<bookmark_value\>number of weeks;between two dates\</bookmark_value\>				20181231 09:50:43
