helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3148755				0	sh	Reset				20181231 09:50:43
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3149651				0	sh	\<ahelp hid=\"HID_TABDLG_RESET_BTN\"\>Resets changes made to the current tab to those applicable when this dialog was opened. A confirmation query does not appear when you close the dialog.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3143278				0	sh	Reset				20181231 09:50:43
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3150791				0	sh	\<ahelp hid=\"HID_TABDLG_RESET_BTN\"\>Resets modified values back to the default values.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154331				0	sh	A confirmation query does not appear. If you confirm the dialog with OK all settings in this dialog are reset.				20181231 09:50:43
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3145173				0	sh	Standard				20181231 09:50:43
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154153				0	sh	\<ahelp hid=\"HID_TABDLG_STANDARD_BTN\"\>Resets the values visible in the dialog back to the default installation values.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154299				0	sh	A confirmation does not appear before the defaults are reloaded.				20181231 09:50:43
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3147502				0	sh	Back				20181231 09:50:43
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3150439				0	sh	\<ahelp hid=\"HID_TABDLG_STANDARD_BTN\"\>View the selections in the dialog made in the previous step. The current settings remain unchanged.\</ahelp\> This button can only be activated from page two on.				20181231 09:50:43
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3147352				0	sh	More				20181231 09:50:43
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3155314	53			0	sh	\<ahelp hid=\"HID_TABDLG_STANDARD_BTN\"\>Click the\<emph\> More\</emph\> button to expand the dialog to show further options. Click again to restore the dialog.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3161659	41			0	sh	\<variable id=\"siehe\"\>See also the following functions: \</variable\>				20181231 09:50:43
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3147418				0	sh	\<variable id=\"regulaer\"\>The search supports \<link href=\"text/shared/01/02100001.xhp\" name=\"regular expressions\"\>regular expressions\</link\>. You can enter "all.*", for example to find the first location of "all" followed by any characters. If you want to search for a text that is also a regular expression, you must precede every character with a \\ character. You can switch the automatic evaluation of regular expression on and off in \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - \<link href=\"text/shared/optionen/01060500.xhp\"\>%PRODUCTNAME Calc - Calculate\</link\>.\</variable\>				20181231 09:50:43
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3163714	56			0	sh	\<variable id=\"wahr\"\>If an error occurs, the function returns a logical or numerical value. \</variable\>				20181231 09:50:43
