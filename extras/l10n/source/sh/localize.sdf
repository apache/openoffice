helpcontent2	source\text\sbasic\shared\03103900.xhp	0	help	hd_id3146958				0	sh	\<link href=\"text/sbasic/shared/03103900.xhp\" name=\"FindPropertyObject Function [Runtime]\"\>FindPropertyObject Function [Runtime]\</link\>				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103900.xhp	0	help	par_id3154285				0	sh	Enables objects to be addressed at run-time as a string parameter using the object name.				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103900.xhp	0	help	par_id3147573				0	sh	For instance, the command:				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103900.xhp	0	help	par_id3145610				0	sh	MyObj.Prop1.Command = 5				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103900.xhp	0	help	par_id3147265				0	sh	corresponds to the following command block:				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103900.xhp	0	help	par_id3153896				0	sh	Dim ObjVar as Object				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103900.xhp	0	help	par_id3148664				0	sh	Dim ObjProp as Object				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103900.xhp	0	help	par_id3150792				0	sh	ObjName As String = "MyObj"				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103900.xhp	0	help	par_id3154365				0	sh	ObjVar = FindObject( ObjName As String )				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103900.xhp	0	help	par_id3148453				0	sh	PropName As String = "Prop1"				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103900.xhp	0	help	par_id3150449				0	sh	ObjProp = FindPropertyObject( ObjVar, PropName As String )				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103900.xhp	0	help	par_id3159152				0	sh	ObjProp.Command = 5				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103900.xhp	0	help	par_id3156214				0	sh	To dynamically create Names at run-time, use:				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103900.xhp	0	help	par_id3154686				0	sh	"TextEdit1" to TextEdit5" in a loop to create five names.				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103900.xhp	0	help	par_id3150868				0	sh	See also: \<link href=\"text/sbasic/shared/03103800.xhp\" name=\"FindObject\"\>FindObject\</link\>				20181231 09:50:43
