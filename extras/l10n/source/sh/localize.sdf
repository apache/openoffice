helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3148863				0	sh	<SDFIELD TYPE=DOCINFO SUBTYPE=COMMENT SDFIXED>Description</SDFIELD>				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3151083				0	sh	Creation date				20181231 09:50:43
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3153298				0	sh	<SDFIELD TYPE=DOCINFO SUBTYPE=CREATE FORMAT=DATE SDNUM="1031;1031;QQ YY">1. Quarter 98</SDFIELD>				20181231 09:50:43
