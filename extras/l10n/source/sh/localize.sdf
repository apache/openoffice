helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3691824				0	sh	\<bookmark_value\>INFO function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id5787224				0	sh	INFO				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id1507309				0	sh	Returns specific information about the current working environment. The function receives a single text argument and returns data depending on that parameter.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id7693411				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3928952				0	sh	INFO("Type")				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id5206762				0	sh	The following table lists the values for the text parameter \<item type=\"literal\"\>Type\</item\> and the return values of the INFO function.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id5735953				0	sh	Value for "Type"				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id8360850				0	sh	Return value				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id9648731				0	sh	"osversion"				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id908841				0	sh	Always "Windows (32-bit) NT 5.01", for compatibility reasons				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id8193914				0	sh	"system"				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id9841608				0	sh	The type of the operating system. \<br/\>"WNT" for Microsoft Windows \<br/\>"LINUX" for Linux \<br/\>"SOLARIS" for Solaris				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id2701803				0	sh	"release"				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id2136295				0	sh	The product release identifier, for example "300m25(Build:9876)"				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id9200109				0	sh	"numfile"				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id4186223				0	sh	Always 1, for compatibility reasons				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id5766472				0	sh	"recalc"				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id1491134				0	sh	Current formula recalculation mode, either "Automatic" or "Manual" (localized into %PRODUCTNAME language)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id1161534				0	sh	Other spreadsheet applications may accept localized values for the \<item type=\"literal\"\>Type\</item\> parameter, but %PRODUCTNAME Calc will only accept the English values.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id5459456				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3994567				0	sh	\<item type=\"input\"\>=INFO("release")\</item\> returns the product release number of the %PRODUCTNAME in use.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id2873622				0	sh	\<item type=\"input\"\>=INFO(D5)\</item\> with cell \<item type=\"literal\"\>D5\</item\> containing a text string \<item type=\"literal\"\>system\</item\> returns the operation system type.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3155625				0	sh	\<bookmark_value\>CURRENT function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3155625				0	sh	CURRENT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3157975				0	sh	\<ahelp hid=\"HID_FUNC_AKTUELL\"\>This function returns the result to date of evaluating the formula of which it is a part (in other words the result as far as that evaluation has got). Its main use is together with the STYLE() function to apply selected styles to a cell depending on the cell contents.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3148880				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150930				0	sh	CURRENT()				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3145629				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id5919064				0	sh	\<item type=\"input\"\>=1+2+CURRENT()\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id8751792				0	sh	The example returns 6. The formula is calculated from left to right as: 1 + 2 equals 3, giving the result to date when CURRENT() is encountered; CURRENT() therefore yields 3, which is added to the original 3 to give 6.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id5863826				0	sh	\<item type=\"input\"\>=A2+B2+STYLE(IF(CURRENT()>10;”Red”;”Default”))\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id7463911				0	sh	The example returns A2 + B2 (STYLE returns 0 here). If this sum is greater than 10, the style Red is applied to the cell. See the \<emph\>STYLE\</emph\> function for more explanation.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id7318643				0	sh	\<item type=\"input\"\>="choo"&CURRENT()\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id6019165				0	sh	The example returns choochoo.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3150688				0	sh	\<bookmark_value\>FORMULA function\</bookmark_value\>\<bookmark_value\>formula cells;displaying formulas in other cells\</bookmark_value\>\<bookmark_value\>displaying;formulas at any position\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3150688				0	sh	FORMULA				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3158417				0	sh	\<ahelp hid=\"HID_FUNC_FORMEL\"\>Displays the formula of a formula cell as a text string.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3154954				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3147535				0	sh	FORMULA(Reference)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3014313				0	sh	\<emph\>Reference\</emph\> is a reference to a cell containing a formula.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id8857081				0	sh	An invalid reference or a reference to a cell with no formula results in the error value #N/A.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3152820				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153179				0	sh	If cell A8 contains the formula \<item type=\"input\"\>=SUM(1;2;3)\</item\> then				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153923				0	sh	\<item type=\"input\"\>=FORMULA(A8)\</item\> returns the text =SUM(1;2;3).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3155409				0	sh	\<bookmark_value\>ISREF function\</bookmark_value\>\<bookmark_value\>references;testing cell contents\</bookmark_value\>\<bookmark_value\>cell contents;testing for references\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3155409				0	sh	ISREF				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153723				0	sh	\<ahelp hid=\"HID_FUNC_ISTBEZUG\"\>Tests if the argument is a reference.\</ahelp\> Returns TRUE if the argument is a reference, returns FALSE otherwise. When given a reference this function does not examine the value being referenced.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3147175				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149821				0	sh	ISREF(Value)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3146152				0	sh	\<emph\>Value\</emph\> is the value to be tested, to determine whether it is a reference.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3083448				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154317				0	sh	\<item type=\"input\"\>=ISREF(C5)\</item\> returns the result TRUE because C5 is a valid reference.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id9728072				0	sh	\<item type=\"input\"\>=ISREF("abcdef")\</item\> returns always FALSE because a text can never be a reference.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id2131544				0	sh	\<item type=\"input\"\>=ISREF(4)\</item\> returns FALSE.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id4295480				0	sh	\<item type=\"input\"\>=ISREF(INDIRECT("A6"))\</item\> returns TRUE, because INDIRECT is a function that returns a reference.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3626819				0	sh	\<item type=\"input\"\>=ISREF(ADDRESS(1; 1; 2;"Sheet2"))\</item\> returns FALSE, because ADDRESS is a function that returns a text, although it looks like a reference.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3154812				0	sh	\<bookmark_value\>ISERR function\</bookmark_value\>\<bookmark_value\>error codes;controlling\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3154812				0	sh	ISERR				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149282				0	sh	\<ahelp hid=\"HID_FUNC_ISTFEHL\"\>Tests for error conditions, except the #N/A error value, and returns TRUE or FALSE.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3149450				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156312				0	sh	ISERR(Value)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3146857				0	sh	\<emph\>Value\</emph\> is any value or expression which is tested to see whether an error value other than #N/A is present.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3153212				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153276				0	sh	\<item type=\"input\"\>=ISERR(C8)\</item\> where cell C8 contains \<item type=\"input\"\>=1/0\</item\> returns TRUE, because 1/0 is an error.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id8456984				0	sh	\<item type=\"input\"\>=ISERR(C9)\</item\> where cell C9 contains \<item type=\"input\"\>=NA()\</item\> returns FALSE, because ISERR() ignores the #N/A error.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3147081				0	sh	\<bookmark_value\>ISERROR function\</bookmark_value\>\<bookmark_value\>recognizing;general errors\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3147081				0	sh	ISERROR				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156316				0	sh	\<ahelp hid=\"HID_FUNC_ISTFEHLER\"\>Tests for error conditions, including the #N/A error value, and returns TRUE or FALSE.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3147569				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153155				0	sh	ISERROR(Value)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154047				0	sh	\<emph\>Value\</emph\> is or refers to the value to be tested. ISERROR() returns TRUE if there is an error and FALSE if not.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3155994				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150256				0	sh	\<item type=\"input\"\>=ISERROR(C8)\</item\> where cell C8 contains \<item type=\"input\"\>=1/0\</item\> returns TRUE, because 1/0 is an error.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id1889095				0	sh	\<item type=\"input\"\>=ISERROR(C9)\</item\> where cell C9 contains \<item type=\"input\"\>=NA()\</item\> returns TRUE.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3153618				0	sh	\<bookmark_value\>ISFORMULA function\</bookmark_value\>\<bookmark_value\>recognizing formula cells\</bookmark_value\>\<bookmark_value\>formula cells;recognizing\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3153618				0	sh	ISFORMULA				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149138				0	sh	\<ahelp hid=\"HID_FUNC_ISTFORMEL\"\>Returns TRUE if a cell is a formula cell.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3155100				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3143230				0	sh	ISFORMULA(Reference)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150150				0	sh	\<emph\>Reference\</emph\> indicates the reference to a cell in which a test will be performed to determine if it contains a formula.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3147491				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3159182				0	sh	\<item type=\"input\"\>=ISFORMULA(C4)\</item\> returns FALSE if the cell C4 contains the number \<item type=\"input\"\>5\</item\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3149760				0	sh	\<bookmark_value\>ISEVEN_ADD function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3149760				0	sh	ISEVEN_ADD				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3147253				0	sh	\<ahelp hid=\"HID_AAI_FUNC_ISEVEN\"\>Tests for even numbers. Returns 1 if the number divided by 2 returns a whole number.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3152799				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149202				0	sh	ISEVEN_ADD(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151168				0	sh	\<emph\>Number\</emph\> is the number to be tested.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3150115				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153904				0	sh	\<item type=\"input\"\>=ISEVEN_ADD(5)\</item\> returns 0.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id6238308				0	sh	\<item type=\"input\"\>=ISEVEN_ADD(A1)\</item\> returns 1 if cell A1 contains the number \<item type=\"input\"\>2\</item\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3154692				0	sh	\<bookmark_value\>ISNONTEXT function\</bookmark_value\>\<bookmark_value\>cell contents;no text\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3154692				0	sh	ISNONTEXT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155330				0	sh	\<ahelp hid=\"HID_FUNC_ISTKTEXT\"\>Tests if the cell contents are text or numbers, and returns FALSE if the contents are text.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id5719779				0	sh	If an error occurs, the function returns TRUE.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3154931				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3148829				0	sh	ISNONTEXT(Value)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3146992				0	sh	\<emph\>Value\</emph\> is any value or expression where a test is performed to determine whether it is a text or numbers or a Boolean value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3150525				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149906				0	sh	\<item type=\"input\"\>=ISNONTEXT(D2)\</item\> returns FALSE if cell D2 contains the text \<item type=\"input\"\>abcdef\</item\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150777				0	sh	\<item type=\"input\"\>=ISNONTEXT(D9)\</item\> returns TRUE if cell D9 contains the number \<item type=\"input\"\>8\</item\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3159148				0	sh	\<bookmark_value\>ISBLANK function\</bookmark_value\>\<bookmark_value\>blank cell contents\</bookmark_value\>\<bookmark_value\>empty cells; recognizing\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3159148				0	sh	ISBLANK				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3148800	78			0	sh	\<ahelp hid=\"HID_FUNC_ISTLEER\"\>Returns TRUE if the reference to a cell is blank.\</ahelp\> This function is used to determine if the content of a cell is empty. A cell with a formula inside is not empty. 				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3159162				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3158406				0	sh	ISBLANK(Value)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154212				0	sh	\<emph\>Value\</emph\> is the content to be tested.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3147508				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3147234				0	sh	\<item type=\"input\"\>=ISBLANK(D2)\</item\> returns FALSE as a result.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3155356				0	sh	\<bookmark_value\>ISLOGICAL function\</bookmark_value\>\<bookmark_value\>number formats;logical\</bookmark_value\>\<bookmark_value\>logical number formats\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3155356				0	sh	ISLOGICAL				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3148926				0	sh	\<ahelp hid=\"HID_FUNC_ISTLOG\"\>Tests for a logical value (TRUE or FALSE).\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3541062				0	sh	If an error occurs, the function returns FALSE.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3149162				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3148918				0	sh	ISLOGICAL(Value)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3146946				0	sh	Returns TRUE if \<emph\>Value\</emph\> is a logical value (TRUE or FALSE), and returns FALSE otherwise.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3150709				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3166442				0	sh	\<item type=\"input\"\>=ISLOGICAL(99)\</item\> returns FALSE, because 99 is a number, not a logical value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3556016				0	sh	\<item type=\"input\"\>=ISLOGICAL(ISNA(D4))\</item\> returns TRUE whatever the contents of cell D4, because ISNA() returns a logical value.				20181231 09:50:43
