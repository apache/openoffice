helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154634	57			0	sh	                     \<item type=\"input\"\>5,333.33 currency units\</item\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147537				0	sh	6				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155085	59			0	sh	                     \<item type=\"input\"\>5\</item\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3158413	60			0	sh	                     \<item type=\"input\"\>2,666.67 currency units\</item\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154866				0	sh	7				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155404	62			0	sh	                     \<item type=\"input\"\>6\</item\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148431	63			0	sh	                     \<item type=\"input\"\>0.00 currency units\</item\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156261				0	sh	8				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3083286	65			0	sh	                     \<item type=\"input\"\>7\</item\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3083443				0	sh	9				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154815	68			0	sh	                     \<item type=\"input\"\>8\</item\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145082				0	sh	10				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156307	71			0	sh	                     \<item type=\"input\"\>9\</item\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147564				0	sh	11				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146856	74			0	sh	                     \<item type=\"input\"\>10\</item\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150880				0	sh	12				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145208				0	sh	13				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156113	78			0	sh	                     \<item type=\"input\"\>>0\</item\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153625	79			0	sh	                     \<item type=\"input\"\>Total\</item\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3151297	80			0	sh	                     \<item type=\"input\"\>40,000.00 currency units\</item\>                  				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149979				0	sh	The formula in E2 is as follows:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155849	82			0	sh	            \<item type=\"input\"\>=SYD($A$2;$B$2;$C$2;D2)\</item\>         				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156124				0	sh	This formula is duplicated in column E down to E11 (select E2, then drag down the lower right corner with the mouse).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147270				0	sh	Cell E13 contains the formula used to check the total of the depreciation amounts. It uses the SUMIF function as the negative values in E8:E11 must not be considered. The condition >0 is contained in cell A13. The formula in E13 is as follows:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3152811	85			0	sh	            \<item type=\"input\"\>=SUMIF(E2:E11;A13)\</item\>         				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155998				0	sh	Now view the depreciation for a 10 year period, or at a salvage value of 1 currency unit, or enter a different initial cost, and so on.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3155104				0	sh	\<bookmark_value\>DISC function\</bookmark_value\>         \<bookmark_value\>allowances\</bookmark_value\>         \<bookmark_value\>discounts\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3155104				0	sh	DISC				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153891				0	sh	\<ahelp hid=\"HID_AAI_FUNC_DISC\"\>Calculates the allowance (discount) of a security as a percentage.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3153982				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149756				0	sh	DISC("Settlement"; "Maturity"; Price; Redemption; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156014	383			0	sh	            \<emph\>Settlement\</emph\> is the date of purchase of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154304	384			0	sh	            \<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159180	385			0	sh	            \<emph\>Price\</emph\> is the price of the security per 100 currency units of par value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147253	386			0	sh	            \<emph\>Redemption\</emph\> is the redemption value of the security per 100 currency units of par value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3151174				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155902				0	sh	A security is purchased on 2001-01-25; the maturity date is 2001-11-15. The price (purchase price) is 97, the redemption value is 100. Using daily balance calculation (basis 3) how high is the settlement (discount)?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3152797	389			0	sh	            \<item type=\"input\"\>=DISC("2001-01-25";"2001-11-15";97;100;3)\</item\> returns about 0.0372 or 3.72 per cent.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3154695				0	sh	\<bookmark_value\>DURATION_ADD function\</bookmark_value\>         \<bookmark_value\>Microsoft Excel functions\</bookmark_value\>         \<bookmark_value\>durations;fixed interest securities\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3154695				0	sh	DURATION_ADD				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145768				0	sh	\<ahelp hid=\"HID_AAI_FUNC_DURATION\"\>Calculates the duration of a fixed interest security in years.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3153904				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153373				0	sh	DURATION_ADD("Settlement"; "Maturity"; Coupon; Yield; Frequency; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155397	406			0	sh	            \<emph\>Settlement\</emph\> is the date of purchase of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148558	407			0	sh	            \<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153096	408			0	sh	            \<emph\>Coupon\</emph\> is the annual coupon interest rate (nominal rate of interest)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154594	409			0	sh	            \<emph\>Yield\</emph\> is the annual yield of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149906	410			0	sh	            \<emph\>Frequency\</emph\> is the number of interest payments per year (1, 2 or 4).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3146995				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148834				0	sh	A security is purchased on 2001-01-01; the maturity date is 2006-01-01. The Coupon rate of interest is 8%. The yield is 9.0%. Interest is paid half-yearly (frequency is 2). Using daily balance interest calculation (basis 3) how long is the duration?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154902	413			0	sh	            \<item type=\"input\"\>=DURATION_ADD("2001-01-01";"2006-01-01";0.08;0.09;2;3)\</item\>         				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3159147				0	sh	\<bookmark_value\>annual net interest rates\</bookmark_value\>         \<bookmark_value\>calculating; annual net interest rates\</bookmark_value\>         \<bookmark_value\>net annual interest rates\</bookmark_value\>         \<bookmark_value\>EFFECTIVE function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3159147				0	sh	EFFECTIVE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154204				0	sh	\<ahelp hid=\"HID_FUNC_EFFEKTIV\"\>Returns the net annual interest rate for a nominal interest rate.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145417				0	sh	Nominal interest refers to the amount of interest due at the end of a calculation period. Effective interest increases with the number of payments made. In other words, interest is often paid in installments (for example, monthly or quarterly) before the end of the calculation period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3150510				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148805				0	sh	EFFECTIVE(Nom; P)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149768	93			0	sh	            \<emph\>Nom\</emph\> is the nominal interest.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149334	94			0	sh	            \<emph\>P\</emph\> is the number of interest payment periods per year.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3154223				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3144499				0	sh	If the annual nominal interest rate is 9.75% and four interest calculation periods are defined, what is the actual interest rate (effective rate)?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150772	97			0	sh	            \<item type=\"input\"\>=EFFECTIVE(9.75%;4)\</item\> = 10.11% The annual effective rate is therefore 10.11%.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3147241				0	sh	\<bookmark_value\>effective interest rates\</bookmark_value\>         \<bookmark_value\>EFFECT_ADD function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3147241				0	sh	EFFECT_ADD				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147524				0	sh	\<ahelp hid=\"HID_AAI_FUNC_EFFECT\"\>Calculates the effective annual rate of interest on the basis of the nominal interest rate and the number of interest payments per annum.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3155364				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155118				0	sh	EFFECT_ADD(NominalRate; NPerY)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148907	418			0	sh	            \<emph\>NominalRate\</emph\> is the annual nominal rate of interest.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154274	419			0	sh	            \<emph\>NPerY \</emph\>is the number of interest payments per year.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3149156				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3158426				0	sh	What is the effective annual rate of interest for a 5.25% nominal rate and quarterly payment.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148927	422			0	sh	            \<item type=\"input\"\>=EFFECT_ADD(0.0525;4)\</item\> returns 0.053543 or 5.3543%.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3149998				0	sh	\<bookmark_value\>calculating; arithmetic-degressive depreciations\</bookmark_value\>         \<bookmark_value\>arithmetic-degressive depreciations\</bookmark_value\>         \<bookmark_value\>depreciations;arithmetic-degressive\</bookmark_value\>         \<bookmark_value\>DDB function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3149998				0	sh	DDB				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159190				0	sh	\<ahelp hid=\"HID_FUNC_GDA\"\>Returns the depreciation of an asset for a specified period using the arithmetic-declining method.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3152361				0	sh	Use this form of depreciation if you require a higher initial depreciation value as opposed to linear depreciation. The depreciation value gets less with each period and is usually used for assets whose value loss is higher shortly after purchase (for example, vehicles, computers). Please note that the book value will never reach zero under this calculation type.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3156038				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3166452				0	sh	DDB(Cost; Salvage; Life; Period; Factor)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153237	104			0	sh	            \<emph\>Cost\</emph\> fixes the initial cost of an asset.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149787	105			0	sh	            \<emph\>Salvage\</emph\> fixes the value of an asset at the end of its life.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3152945	106			0	sh	            \<emph\>Life\</emph\> is the number of periods (for example, years or months) defining how long the asset is to be used.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149736	107			0	sh	            \<emph\>Period\</emph\> states the period for which the value is to be calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150243	108			0	sh	            \<emph\>Factor\</emph\> (optional) is the factor by which depreciation decreases. If a value is not entered, the default is factor 2.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3159274				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3152882				0	sh	A computer system with an initial cost of 75,000 currency units is to be depreciated monthly over 5 years. The value at the end of the depreciation is to be 1 currency unit. The factor is 2.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154106	111			0	sh	            \<item type=\"input\"\>=DDB(75000;1;60;12;2) \</item\>= 1,721.81 currency units. Therefore, the double-declining depreciation in the twelfth month after purchase is 1,721.81 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3149962				0	sh	\<bookmark_value\>calculating; geometric-degressive depreciations\</bookmark_value\>         \<bookmark_value\>geometric-degressive depreciations\</bookmark_value\>         \<bookmark_value\>depreciations;geometric-degressive\</bookmark_value\>         \<bookmark_value\>DB function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3149962				0	sh	DB				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148989				0	sh	\<ahelp hid=\"HID_FUNC_GDA2\"\>Returns the depreciation of an asset for a specified period using the double-declining balance method.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156213				0	sh	This form of depreciation is used if you want to get a higher depreciation value at the beginning of the depreciation (as opposed to linear depreciation). The depreciation value is reduced with every depreciation period by the depreciation already deducted from the initial cost.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3149807				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153349				0	sh	DB(Cost; Salvage; Life; Period; Month)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148462	118			0	sh	            \<emph\>Cost\</emph\> is the initial cost of an asset.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148658	119			0	sh	            \<emph\>Salvage\</emph\> is the value of an asset at the end of the depreciation.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145371	120			0	sh	            \<emph\>Life\</emph\> defines the period over which an asset is depreciated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154608	121			0	sh	            \<emph\>Period\</emph\> is the length of each period. The length must be entered in the same date unit as the depreciation period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150829	122			0	sh	            \<emph\>Month\</emph\> (optional) denotes the number of months for the first year of depreciation. If an entry is not defined, 12 is used as the default.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3151130				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156147				0	sh	A computer system with an initial cost of 25,000 currency units is to be depreciated over a three year period. The salvage value is to be 1,000 currency units. One period is 30 days.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149513	125			0	sh	            \<item type=\"input\"\>=DB(25000;1000;36;1;6)\</item\> = 1,075.00 currency units				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159242				0	sh	The fixed-declining depreciation of the computer system is 1,075.00 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3153948				0	sh	\<bookmark_value\>IRR function\</bookmark_value\>         \<bookmark_value\>calculating;internal rates of return, regular payments\</bookmark_value\>         \<bookmark_value\>internal rates of return;regular payments\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3153948				0	sh	IRR				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3143282				0	sh	\<ahelp hid=\"HID_FUNC_IKV\"\>Calculates the internal rate of return for an investment.\</ahelp\> The values represent cash flow values at regular intervals, at least one value must be negative (payments), and at least one value must be positive (income).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3150599				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155427				0	sh	IRR(Values; Guess)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3144758	132			0	sh	            \<emph\>Values\</emph\> represents an array containing the values.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149233	133			0	sh	            \<emph\>Guess\</emph\> (optional) is the estimated value. An iterative method is used to calculate the internal rate of return. If you can provide only few values, you should provide an initial guess to enable the iteration.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3151258				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150630				0	sh	Under the assumption that cell contents are A1=\<item type=\"input\"\>-10000\</item\>, A2=\<item type=\"input\"\>3500\</item\>, A3=\<item type=\"input\"\>7600\</item\> and A4=\<item type=\"input\"\>1000\</item\>, the formula \<item type=\"input\"\>=IRR(A1:A4)\</item\> gives a result of 11,33%.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3151012				0	sh	\<bookmark_value\>calculating; interests for unchanged amortization installments\</bookmark_value\>         \<bookmark_value\>interests for unchanged amortization installments\</bookmark_value\>         \<bookmark_value\>ISPMT function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3151012				0	sh	ISPMT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148693				0	sh	\<ahelp hid=\"HID_FUNC_ISPMT\"\>Calculates the level of interest for unchanged amortization installments.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3154661				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146070				0	sh	ISPMT(Rate; Period; TotalPeriods; Invest)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148672	318			0	sh	            \<emph\>Rate\</emph\> sets the periodic interest rate.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145777	319			0	sh	            \<emph\>Period\</emph\> is the number of installments for calculation of interest.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153678	320			0	sh	            \<emph\>TotalPeriods\</emph\> is the total number of installment periods.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159390	321			0	sh	            \<emph\>Invest\</emph\> is the amount of the investment.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3156162				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149558				0	sh	For a credit amount of 120,000 currency units with a two-year term and monthly installments, at a yearly interest rate of 12% the level of interest after 1.5 years is required.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150949	324			0	sh	            \<item type=\"input\"\>=ISPMT(1%;18;24;120000)\</item\> = -300 currency units. The monthly interest after 1.5 years amounts to 300 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146812				0	sh	\<link href=\"text/scalc/01/04060119.xhp\" name=\"Forward to Financial Functions Part Two\"\>Financial Functions Part Two\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154411				0	sh	\<link href=\"text/scalc/01/04060118.xhp\" name=\"Forward to Financial Functions Part Three\"\>Financial Functions Part Three\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	tit				0	sh	Grouping				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1054D				0	sh	Grouping				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10551				0	sh	Grouping pivot tables displays the \<emph\>Grouping\</emph\> dialog for either values or dates.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10568				0	sh	Start				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1056C				0	sh	Specifies the start of the grouping.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1056F				0	sh	Automatically				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10573				0	sh	Specifies whether to start grouping at the smallest value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10576				0	sh	Manually at				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1057A				0	sh	Specifies whether to enter the start value for grouping yourself.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1057D				0	sh	End				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10581				0	sh	Specifies the end of the grouping.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10584				0	sh	Automatically				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10588				0	sh	Specifies whether to end grouping at the largest value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1058B				0	sh	Manually at				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1058F				0	sh	Specifies whether to enter the end value for grouping yourself.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10592				0	sh	Group by				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10596				0	sh	Specifies the value range by which every group's limits are calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10599				0	sh	Number of days				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1059D				0	sh	In the case of grouping date values, specifies the number of days to group by.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN105A0				0	sh	Intervals				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN105A4				0	sh	In the case of grouping date values, specifies the intervals to group by.				20181231 09:50:43
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN105B2				0	sh	\<embedvar href=\"text/scalc/guide/datapilot_grouping.xhp#datapilot_grouping\"/\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	tit				0	sh	Text to Columns				20181231 09:50:43
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	bm_id8004394				0	sh	\<bookmark_value\>text to columns\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	hd_id2300180				0	sh	\<link href=\"text/scalc/01/text2columns.xhp\"\>Text to Columns\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	par_id655232				0	sh	\<variable id=\"text2columns\"\>Opens the Text to Columns dialog, where you enter settings to expand the contents of selected cells to multiple cells. \</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	hd_id9599597				0	sh	To expand cell contents to multiple cells				20181231 09:50:43
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	par_id2021546				0	sh	You can expand cells that contain comma separated values (CSV) into multiple cells in the same row. 				20181231 09:50:43
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	par_id2623981				0	sh	For example, cell A1 contains the comma separated values \<item type=\"literal\"\>1,2,3,4\</item\>, and cell A2 contains the text \<item type=\"literal\"\>A,B,C,D\</item\>. 				20181231 09:50:43
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	par_id7242042				0	sh	Select the cell or cells that you want to expand.				20181231 09:50:43
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	par_id6999420				0	sh	Choose \<emph\>Data - Text to Columns\</emph\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	par_id6334116				0	sh	You see the Text to Columns dialog.				20181231 09:50:43
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	par_id9276406				0	sh	Select the separator options. The preview shows how the current cell contents will be transformed into multiple cells.				20181231 09:50:43
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	par_id8523819				0	sh	You can select a fixed width and then click the ruler on the preview to set cell breakup positions.				20181231 09:50:43
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	par_id1517380				0	sh	You can select or enter separator characters to define the positions of breaking points. The separator characters are removed from the resulting cell contents.				20181231 09:50:43
helpcontent2	source\text\scalc\01\text2columns.xhp	0	help	par_id7110812				0	sh	In the example, you select the comma as a delimiter character. Cells A1 and A2 will be expanded to four columns each. A1 contains 1, B1 contains 2, and so on.				20181231 09:50:43
