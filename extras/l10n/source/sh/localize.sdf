helpcontent2	source\text\shared\02\12090101.xhp	0	help	tit				0	sh	Comparison Operators				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	bm_id3148983				0	sh	\<bookmark_value\>comparisons;operators in standard filter dialog\</bookmark_value\>      \<bookmark_value\>operators;standard filters\</bookmark_value\>      \<bookmark_value\>standard filters;comparison operators\</bookmark_value\>      \<bookmark_value\>filters; comparison operators\</bookmark_value\>      \<bookmark_value\>equal sign, see also operators\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	hd_id3148983				0	sh	Comparison Operators				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3155364				0	sh	The following comparative operators can be set under \<item type=\"menuitem\"\>Condition\</item\> in the \<item type=\"menuitem\"\>Standard Filter\</item\> dialog.				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3145313	3			0	sh	                  \<emph\>Comparative operator\</emph\>               				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3147089	4			0	sh	                  \<emph\>Effect\</emph\>               				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3147209				0	sh	Equal (=)				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3146797				0	sh	Shows values equal to the condition.				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3143271				0	sh	Less than (<)				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3153761				0	sh	Shows values less than the condition.				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3146807				0	sh	Greater than (>)				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3154852				0	sh	Shows values greater than the condition.				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3155342				0	sh	Less than or equal to (< =)				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3154381				0	sh	Shows values that are less than or equal to the condition.				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3153823				0	sh	Greater than or equal to (> =)				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3154143				0	sh	Shows values that are greater than or equal to the condition.				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3154811				0	sh	Not equal (< >)				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3148944				0	sh	Shows the values not equal to the condition.				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3149669				0	sh	Largest				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3159413				0	sh	Shows the N (numeric value as parameter) largest values.				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3151054				0	sh	Smallest				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3161657				0	sh	Shows the N (numeric value as parameter) smallest values.				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3150400				0	sh	Largest %				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3161645				0	sh	Shows the largest N% (numeric value as parameter) of the total values.				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3149202				0	sh	Smallest %				20181231 09:50:43
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3151176				0	sh	Shows the smallest N% (numeric value as parameter) of the entire values.				20181231 09:50:43
helpcontent2	source\text\shared\02\01171100.xhp	0	help	tit				0	sh	Wizards On/Off				20181231 09:50:43
helpcontent2	source\text\shared\02\01171100.xhp	0	help	hd_id3155934				0	sh	\<link href=\"text/shared/02/01171100.xhp\" name=\"Wizards On/Off\"\>Wizards On/Off\</link\>				20181231 09:50:43
helpcontent2	source\text\shared\02\01171100.xhp	0	help	par_id3147143				0	sh	\<ahelp hid=\".uno:UseWizards\"\>Specifies whether to start the wizard automatically when inserting a new control.\</ahelp\> This setting applies globally to all documents.				20181231 09:50:43
helpcontent2	source\text\shared\02\01171100.xhp	0	help	par_id3159201				0	sh	There are wizards for inserting a list box or combo box, a table element and group boxes.				20181231 09:50:43
helpcontent2	source\text\shared\02\24100000.xhp	0	help	tit				0	sh	Crop				20181231 09:50:43
helpcontent2	source\text\shared\02\24100000.xhp	0	help	hd_id3154044				0	sh	\<link href=\"text/shared/02/24100000.xhp\" name=\"Crop\"\>Crop\</link\>				20181231 09:50:43
helpcontent2	source\text\shared\02\24100000.xhp	0	help	par_id3154863				0	sh	\<ahelp hid=\".uno:GrafAttrCrop\"\>Allows to crop the display of an inserted picture. Only the display gets cropped, the inserted picture is not changed.\</ahelp\> A picture must be selected to enable cropping.				20181231 09:50:43
helpcontent2	source\text\shared\02\24100000.xhp	0	help	par_id0514200804261097				0	sh	In Impress and Draw no dialog is shown when you click the icon, but you see eight cropping handles. Open the context menu of a selected picture and choose \<item type=\"menuitem\"\>Crop Picture\</item\>, if you want to use the \<link href=\"text/shared/01/05030800.xhp\"\>dialog\</link\> for cropping.				20181231 09:50:43
helpcontent2	source\text\shared\02\24100000.xhp	0	help	par_id0514200804261043				0	sh	\<ahelp hid=\".\"\>Drag any of the eight cropping handles to crop the picture.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\02\24100000.xhp	0	help	par_id0522200809440491				0	sh	\<image id=\"img_id0522200809434429\" src=\"res/commandimagelist/sc_crop.png\" width=\"0.1665in\" height=\"0.1665in\"\>\<alt id=\"alt_id0522200809434429\"\>icon\</alt\>\</image\>				20181231 09:50:43
helpcontent2	source\text\shared\02\24100000.xhp	0	help	par_id3154927				0	sh	Crop				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	tit				0	sh	Events				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	bm_id3148643				0	sh	\<bookmark_value\>controls; events\</bookmark_value\>         \<bookmark_value\>events; controls\</bookmark_value\>         \<bookmark_value\>macros; assigning to events in forms\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	hd_id3148643				0	sh	\<link href=\"text/shared/02/01170103.xhp\" name=\"Events\"\>Events\</link\>				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	par_id3152350	2			0	sh	On the\<emph\> Events \</emph\>tab page you can link macros to events that occur in a form's control fields.				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	par_id3155419				0	sh	When the event occurs, the linked macro will be called. To assign a macro to an event, press the \<emph\>...\</emph\> button. An \<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<link href=\"text/swriter/01/05060700.xhp\" name=\"Assign Macro\"\>Assign Macro\</link\>\</caseinline\>\<defaultinline\>dialog\</defaultinline\>\</switchinline\> opens.				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	par_id3149732				0	sh	Depending on the control, different events are available. Only the available events for the selected control and context are listed on the \<emph\>Events\</emph\> tab page. The following events are defined:				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	hd_id3149191				0	sh	Approve action				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	par_id3153717				0	sh	\<ahelp hid=\"HID_EVT_APPROVEACTIONPERFORMED\"\>This event takes place before an action is triggered by clicking the control.\</ahelp\> For example, clicking a "Submit" button initiates a send action; however, the actual "send" process is started only when the \<emph\>When initiating\</emph\> event occurs. The \<emph\>Approve action\</emph\> event allows you to kill the process. If the linked method sends back FALSE, \<emph\>When initiating\</emph\> will not be executed.				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	hd_id3156024				0	sh	Execute action				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	par_id3145609				0	sh	\<ahelp hid=\"HID_EVT_ACTIONPERFORMED\"\>The \<emph\>Execute action\</emph\> event occurs when an action is started.\</ahelp\> For example, if you have a "Submit" button in your form, the send process represents the action to be initiated.				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	hd_id3156343				0	sh	Changed				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	par_id3148755	42			0	sh	\<ahelp hid=\"HID_EVT_CHANGED\"\>The\<emph\> Changed \</emph\>event takes place when the control loses the focus and the content of the control has changed since it lost the focus.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	hd_id3153524				0	sh	Text modified				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	par_id3150495	11			0	sh	\<ahelp hid=\"HID_EVT_TEXTCHANGED\"\>The\<emph\> Text modified \</emph\>event takes place if you enter or modify a text in an input field.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	hd_id3154123				0	sh	Item status changed				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	par_id3150870	9			0	sh	\<ahelp hid=\"HID_EVT_ITEMSTATECHANGED\" visibility=\"hidden\"\>The\<emph\> Item status changed \</emph\>event takes place if the status of the control field has changed.\</ahelp\>The\<emph\> Item status changed\</emph\> event takes place if he status of the control field has changed.				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	hd_id3151176				0	sh	When receiving focus				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	par_id3154218	17			0	sh	\<ahelp hid=\"HID_EVT_FOCUSGAINED\"\>The\<emph\> When receiving focus \</emph\>event takes place if a control field receives the focus.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	hd_id3150447				0	sh	When losing focus				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	par_id3159252	19			0	sh	\<ahelp hid=\"HID_EVT_FOCUSLOST\"\>The\<emph\> When losing focus \</emph\>event takes place if a control field looses the focus.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	hd_id3147287				0	sh	Key pressed				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	par_id3152940	21			0	sh	\<ahelp hid=\"HID_EVT_KEYTYPED\"\>The \<emph\>Key pressed \</emph\>event occurs when the user presses any key while the control has the focus.\</ahelp\> This event may be linked to a macro for checking entries.				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	hd_id3154127				0	sh	Key released				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	par_id3154150	44			0	sh	\<ahelp hid=\"HID_EVT_KEYUP\"\>The\<emph\> Key released \</emph\>event occurs when the user releases any key while the control has the focus.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	hd_id3154921				0	sh	Mouse inside				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	par_id3148618	27			0	sh	\<ahelp hid=\"HID_EVT_MOUSEENTERED\"\>The\<emph\> Mouse inside \</emph\>event takes place if the mouse is inside the control field.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	hd_id3148576				0	sh	Mouse moved while key pressed				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	par_id3155411	31			0	sh	\<ahelp hid=\"HID_EVT_MOUSEDRAGGED\"\>The\<emph\> Mouse moved while key pressed \</emph\>event takes place when the mouse is dragged while a key is pressed.\</ahelp\> An example is when, during drag-and-drop, an additional key determines the mode (move or copy).				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	hd_id3149262				0	sh	Mouse moved				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	par_id3146975	33			0	sh	\<ahelp hid=\"HID_EVT_MOUSEMOVED\"\>The\<emph\> Mouse moved \</emph\>event occurs if the mouse moves over the control.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	hd_id3159197				0	sh	Mouse button pressed				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	par_id3145271	23			0	sh	\<ahelp hid=\"HID_EVT_MOUSEPRESSED\"\>The\<emph\> Mouse button pressed \</emph\>event occurs if the mouse button is pressed while the mouse pointer is on the control.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	par_idN108BD				0	sh	Note that this event is also used for notifying requests for a popup context menu on the control.				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	hd_id3148880				0	sh	Mouse button released				20181231 09:50:43
helpcontent2	source\text\shared\02\01170103.xhp	0	help	par_id3150659	25			0	sh	\<ahelp hid=\"HID_EVT_MOUSERELEASED\"\>The\<emph\> Mouse button released \</emph\>event occurs if the mouse button is released while the mouse pointer is on the control.\</ahelp\>				20181231 09:50:43
