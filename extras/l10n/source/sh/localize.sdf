helpcontent2	source\text\shared\optionen\01020200.xhp	0	help	par_id3153880				0	sh	\<ahelp hid=\"SVX:LISTBOX:RID_SVXPAGE_INET_SEARCH:LB_SEARCH\"\>Displays the available search engines.\</ahelp\> Select a search engine to display its configuration in the adjacent text and option boxes.				20181231 09:50:43
helpcontent2	source\text\shared\optionen\01020200.xhp	0	help	hd_id3150276				0	sh	Name				20181231 09:50:43
helpcontent2	source\text\shared\optionen\01020200.xhp	0	help	par_id3155449	12			0	sh	\<ahelp hid=\"SVX:EDIT:RID_SVXPAGE_INET_SEARCH:ED_SEARCH_NAME\"\>Displays the name of the selected search engine.\</ahelp\> This is the name that will be shown in the sub-menu of the \<emph\>Search\</emph\> icon on the Hyperlink bar. 				20181231 09:50:43
helpcontent2	source\text\shared\optionen\01020200.xhp	0	help	hd_id3151245				0	sh	Type				20181231 09:50:43
