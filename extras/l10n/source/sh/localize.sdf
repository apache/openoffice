helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3150010				0	sh	REM rounded Pi = 3.14159				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3149959				0	sh	Dim d1 as Double, dAngle as Double				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3144764				0	sh	d1 = InputBox$ (""Enter the length of the adjacent side: ","Adjacent")				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3154491				0	sh	dAngle = InputBox$ ("Enter the angle Alpha (in degrees): ","Alpha")				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3151074				0	sh	Print "The length of the hypothenuse is"; (d1 / cos (dAngle * Pi / 180))				20181231 09:50:43
