helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3150651				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3152982				0	sh	ODDFYIELD(Settlement; Maturity; Issue; FirstCoupon; Rate; Price; Redemption; Frequency; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3157906				0	sh	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150026				0	sh	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149012				0	sh	\<emph\>Issue\</emph\> is the date of issue of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148725				0	sh	\<emph\>FirstCoupon\</emph\> is the first interest period of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150465				0	sh	\<emph\>Rate\</emph\> is the annual rate of interest.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3146940				0	sh	\<emph\>Price\</emph\> is the price of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149893				0	sh	\<emph\>Redemption\</emph\> is the redemption value per 100 currency units of par value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148888				0	sh	\<emph\>Frequency\</emph\> is number of interest payments per year (1, 2 or 4).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3153933				0	sh	\<bookmark_value\>ODDLPRICE function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3153933				0	sh	ODDLPRICE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145145				0	sh	\<ahelp hid=\"HID_AAI_FUNC_ODDLPRICE\"\>Calculates the price per 100 currency units par value of a security, if the last interest date falls irregularly.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3152784				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155262				0	sh	ODDLPRICE(Settlement; Maturity; LastInterest; Rate; Yield; Redemption; Frequency; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149689				0	sh	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148753				0	sh	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150861				0	sh	\<emph\>LastInterest\</emph\> is the last interest date of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155831				0	sh	\<emph\>Rate\</emph\> is the annual rate of interest.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153328				0	sh	\<emph\>Yield\</emph\> is the annual yield of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149186				0	sh	\<emph\>Redemption\</emph\> is the redemption value per 100 currency units of par value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149726				0	sh	\<emph\>Frequency\</emph\> is number of interest payments per year (1, 2 or 4).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3153111				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3152999				0	sh	Settlement date: February 7 1999, maturity date: June 15 1999, last interest: October 15 1998. Interest rate: 3.75 per cent, yield: 4.05 per cent, redemption value: 100 currency units, frequency of payments: half-yearly = 2, basis: = 0				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148567				0	sh	The price per 100 currency units per value of a security, which has an irregular last interest date, is calculated as follows:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150332				0	sh	=ODDLPRICE("1999-02-07";"1999-06-15";"1998-10-15"; 0.0375; 0.0405;100;2;0) returns 99.87829.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3153564				0	sh	\<bookmark_value\>ODDLYIELD function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3153564				0	sh	ODDLYIELD				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3158002				0	sh	\<ahelp hid=\"HID_AAI_FUNC_ODDLYIELD\"\>Calculates the yield of a security if the last interest date falls irregularly.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3147366				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150018				0	sh	ODDLYIELD(Settlement; Maturity; LastInterest; Rate; Price; Redemption; Frequency; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3159132				0	sh	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150134				0	sh	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145245				0	sh	\<emph\>LastInterest\</emph\> is the last interest date of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3151014				0	sh	\<emph\>Rate\</emph\> is the annual rate of interest.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149003				0	sh	\<emph\>Price\</emph\> is the price of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148880				0	sh	\<emph\>Redemption\</emph\> is the redemption value per 100 currency units of par value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155622				0	sh	\<emph\>Frequency\</emph\> is number of interest payments per year (1, 2 or 4).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3145303				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145350				0	sh	Settlement date: April 20 1999, maturity date: June 15 1999, last interest: October 15 1998. Interest rate: 3.75 per cent, price: 99.875 currency units, redemption value: 100 currency units, frequency of payments: half-yearly = 2, basis: = 0				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3157990				0	sh	The yield of the security, that has an irregular last interest date, is calculated as follows:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150572				0	sh	=ODDLYIELD("1999-04-20";"1999-06-15"; "1998-10-15"; 0.0375; 99.875; 100;2;0) returns 0.044873 or 4.4873%.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3148768				0	sh	\<bookmark_value\>calculating;variable declining depreciations\</bookmark_value\>\<bookmark_value\>depreciations;variable declining\</bookmark_value\>\<bookmark_value\>VDB function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3148768				0	sh	VDB				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154636				0	sh	\<ahelp hid=\"HID_FUNC_VDB\"\>Returns the depreciation of an asset for a specified or partial period using a variable declining balance method.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3155519				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149025				0	sh	VDB(Cost; Salvage; Life; S; End; Factor; Type)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150692				0	sh	\<emph\>Cost\</emph\> is the initial value of an asset.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155369				0	sh	\<emph\>Salvage\</emph\> is the value of an asset at the end of the depreciation.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154954				0	sh	\<emph\>Life\</emph\> is the depreciation duration of the asset.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3152817				0	sh	\<emph\>S\</emph\> is the start of the depreciation. A must be entered in the same date unit as the duration.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153221				0	sh	\<emph\>End\</emph\> is the end of the depreciation.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3147536				0	sh	\<emph\>Factor\</emph\> (optional) is the depreciation factor. Factor = 2 is double rate depreciation.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154865	232			0	sh	\<emph\>Type \</emph\>is an optional parameter. Type = 1 means a switch to linear depreciation. In Type = 0 no switch is made.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_idN10A0D				0	sh	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3148429				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153927				0	sh	What is the declining-balance double-rate depreciation for a period if the initial cost is 35,000 currency units and the value at the end of the depreciation is 7,500 currency units. The depreciation period is 3 years. The depreciation from the 10th to the 20th period is calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155991				0	sh	\<item type=\"input\"\>=VDB(35000;7500;36;10;20;2)\</item\> = 8603.80 currency units. The depreciation during the period between the 10th and the 20th period is 8,603.80 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3147485				0	sh	\<bookmark_value\>calculating;internal rates of return, irregular payments\</bookmark_value\>\<bookmark_value\>internal rates of return;irregular payments\</bookmark_value\>\<bookmark_value\>XIRR function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3147485				0	sh	XIRR				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145614				0	sh	\<ahelp hid=\"HID_AAI_FUNC_XIRR\"\>Calculates the internal rate of return for a list of payments which take place on different dates.\</ahelp\> The calculation is based on a 365 days per year basis, ignoring leap years.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_idN10E62				0	sh	If the payments take place at regular intervals, use the IRR function.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3146149				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149826				0	sh	XIRR(Values; Dates; Guess)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3163821				0	sh	\<emph\>Values\</emph\> and \<emph\>Dates\</emph\> refer to a series of payments and the series of associated date values. The first pair of dates defines the start of the payment plan. All other date values must be later, but need not be in any order. The series of values must contain at least one negative and one positive value (receipts and deposits).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149708				0	sh	\<emph\>Guess\</emph\> (optional) is a guess that can be input for the internal rate of return. The default is 10%.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3145085				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149273				0	sh	Calculation of the internal rate of return for the following five payments:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155838				0	sh	A				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3152934				0	sh	B				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154638				0	sh	C				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3147083				0	sh	1				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3151187				0	sh	2001-01-01				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145212				0	sh	-\<item type=\"input\"\>10000\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3146856				0	sh	\<item type=\"input\"\>Received\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153277				0	sh	2				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154052				0	sh	2001-01-02				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3151297				0	sh	\<item type=\"input\"\>2000\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149985				0	sh	\<item type=\"input\"\>Deposited\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154744				0	sh	3				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153151				0	sh	2001-03-15				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145657				0	sh	2500				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155101				0	sh	4				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3146894				0	sh	2001-05-12				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3143231				0	sh	5000				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3156012				0	sh	5				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149758				0	sh	2001-08-10				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3147495				0	sh	1000				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3152793				0	sh	=XIRR(B1:B5; A1:A5; 0.1) returns 0.1828.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3149198				0	sh	\<bookmark_value\>XNPV function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3149198				0	sh	XNPV				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153904				0	sh	\<ahelp hid=\"HID_AAI_FUNC_XNPV\"\>Calculates the capital value (net present value)for a list of payments which take place on different dates.\</ahelp\> The calculation is based on a 365 days per year basis, ignoring leap years.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_idN11138				0	sh	If the payments take place at regular intervals, use the NPV function.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3155323				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150117				0	sh	XNPV(Rate; Values; Dates)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153100				0	sh	\<emph\>Rate\</emph\> is the internal rate of return for the payments.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155395				0	sh	\<emph\>Values\</emph\> and \<emph\>Dates\</emph\> refer to a series of payments and the series of associated date values. The first pair of dates defines the start of the payment plan. All other date values must be later, but need not be in any order. The series of values must contain at least one negative and one positive value (receipts and deposits)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3148832				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150525				0	sh	Calculation of the net present value for the above-mentioned five payments for a notional internal rate of return of 6%.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149910				0	sh	\<item type=\"input\"\>=XNPV(0.06;B1:B5;A1:A5)\</item\> returns 323.02.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3148822				0	sh	\<bookmark_value\>calculating;rates of return\</bookmark_value\>\<bookmark_value\>RRI function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3148822				0	sh	RRI				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154293				0	sh	\<ahelp hid=\"HID_FUNC_ZGZ\"\>Calculates the interest rate resulting from the profit (return) of an investment.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3148444				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148804				0	sh	RRI(P; PV; FV)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154901				0	sh	\<emph\>P\</emph\> is the number of periods needed for calculating the interest rate.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3159149				0	sh	\<emph\>PV\</emph\> is the present (current) value. The cash value is the deposit of cash or the current cash value of an allowance in kind. As a deposit value a positive value must be entered; the deposit must not be 0 or <0.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149771				0	sh	\<emph\>FV\</emph\> determines what is desired as the cash value of the deposit.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3148941				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154212				0	sh	For four periods (years) and a cash value of 7,500 currency units, the interest rate of the return is to be calculated if the future value is 10,000 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150775	246			0	sh	\<item type=\"input\"\>=RRI(4;7500;10000)\</item\> = 7.46 %				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145413	247			0	sh	The interest rate must be 7.46 % so that 7,500 currency units will become 10,000 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3154267				0	sh	\<bookmark_value\>calculating;constant interest rates\</bookmark_value\>\<bookmark_value\>constant interest rates\</bookmark_value\>\<bookmark_value\>RATE function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3154267				0	sh	RATE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3151052				0	sh	\<ahelp hid=\"HID_FUNC_ZINS\"\>Returns the constant interest rate per period of an annuity.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3154272				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3158423				0	sh	RATE(NPer; Pmt; PV; FV; Type; Guess)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148910				0	sh	\<emph\>NPer\</emph\> is the total number of periods, during which payments are made (payment period).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148925				0	sh	\<emph\>Pmt\</emph\> is the constant payment (annuity) paid during each period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149160				0	sh	\<emph\>PV\</emph\> is the cash value in the sequence of payments.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3166456				0	sh	\<emph\>FV\</emph\> (optional) is the future value, which is reached at the end of the periodic payments.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153243				0	sh	\<emph\>Type\</emph\> (optional) is the due date of the periodic payment, either at the beginning or at the end of a period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3146949				0	sh	\<emph\>Guess\</emph\> (optional) determines the estimated value of the interest with iterative calculation.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_idN10E2A				0	sh	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3149791				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150706				0	sh	What is the constant interest rate for a payment period of 3 periods if 10 currency units are paid regularly and the present cash value is 900 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155586				0	sh	\<item type=\"input\"\>=RATE(3;10;900)\</item\> = -121% The interest rate is therefore 121%.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3149106				0	sh	\<bookmark_value\>INTRATE function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3149106				0	sh	INTRATE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149918				0	sh	\<ahelp hid=\"HID_AAI_FUNC_INTRATE\"\>Calculates the annual interest rate that results when a security (or other item) is purchased at an investment value and sold at a redemption value. No interest is paid.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3149974				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149800				0	sh	INTRATE(Settlement; Maturity; Investment; Redemption; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148618				0	sh	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148988				0	sh	\<emph\>Maturity\</emph\> is the date on which the security is sold.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154604				0	sh	\<emph\>Investment\</emph\> is the purchase price.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154337				0	sh	\<emph\>Redemption\</emph\> is the selling price.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3145380				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149426				0	sh	A painting is bought on 1990-01-15 for 1 million and sold on 2002-05-05 for 2 million. The basis is daily balance calculation (basis = 3). What is the average annual level of interest?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3151125				0	sh	=INTRATE("1990-01-15"; "2002-05-05"; 1000000; 2000000; 3) returns 8.12%.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3148654				0	sh	\<bookmark_value\>COUPNCD function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3148654				0	sh	COUPNCD				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149927				0	sh	\<ahelp hid=\"HID_AAI_FUNC_COUPNCD\"\>Returns the date of the first interest date after the settlement date. Format the result as a date.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3153317				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150423				0	sh	COUPNCD(Settlement; Maturity; Frequency; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150628				0	sh	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153536				0	sh	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145313				0	sh	\<emph\>Frequency\</emph\> is number of interest payments per year (1, 2 or 4).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3155424				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154794				0	sh	A security is purchased on 2001-01-25; the date of maturity is 2001-11-15. Interest is paid half-yearly (frequency is 2). Using daily balance interest calculation (basis 3) when is the next interest date?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3159251				0	sh	=COUPNCD("2001-01-25"; "2001-11-15"; 2; 3) returns 2001-05-15.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3143281				0	sh	\<bookmark_value\>COUPDAYS function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3143281				0	sh	COUPDAYS				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149488				0	sh	\<ahelp hid=\"HID_AAI_FUNC_COUPDAYS\"\>Returns the number of days in the current interest period in which the settlement date falls.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3148685				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149585				0	sh	COUPDAYS(Settlement; Maturity; Frequency; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3152767				0	sh	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3151250				0	sh	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3146126				0	sh	\<emph\>Frequency\</emph\> is number of interest payments per year (1, 2 or 4).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3153705				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3147530				0	sh	A security is purchased on 2001-01-25; the date of maturity is 2001-11-15. Interest is paid half-yearly (frequency is 2). Using daily balance interest calculation (basis 3) how many days are there in the interest period in which the settlement date falls?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3156338				0	sh	=COUPDAYS("2001-01-25"; "2001-11-15"; 2; 3) returns 181.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3154832				0	sh	\<bookmark_value\>COUPDAYSNC function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3154832				0	sh	COUPDAYSNC				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3147100				0	sh	\<ahelp hid=\"HID_AAI_FUNC_COUPDAYSNC\"\>Returns the number of days from the settlement date until the next interest date.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3151312				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155121				0	sh	COUPDAYSNC(Settlement; Maturity; Frequency; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3158440				0	sh	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3146075				0	sh	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154620	159			0	sh	\<emph\>Frequency \</emph\>is number of interest payments per year (1, 2 or 4).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3155604				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148671				0	sh	A security is purchased on 2001-01-25; the date of maturity is 2001-11-15. Interest is paid half-yearly (frequency is 2). Using daily balance interest calculation (basis 3) how many days are there until the next interest payment?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3156158				0	sh	=COUPDAYSNC("2001-01-25"; "2001-11-15"; 2; 3) returns 110.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3150408				0	sh	\<bookmark_value\>COUPDAYBS function\</bookmark_value\>\<bookmark_value\>durations;first interest payment until settlement date\</bookmark_value\>\<bookmark_value\>securities;first interest payment until settlement date\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3150408				0	sh	COUPDAYBS				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3146795				0	sh	\<ahelp hid=\"HID_AAI_FUNC_COUPDAYBS\"\>Returns the number of days from the first day of interest payment on a security until the settlement date.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3156142				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3159083				0	sh	COUPDAYBS(Settlement; Maturity; Frequency; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3146907				0	sh	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3159390				0	sh	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154414				0	sh	\<emph\>Frequency\</emph\> is the number of interest payments per year (1, 2 or 4).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3153880				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150592				0	sh	A security is purchased on 2001-01-25; the date of maturity is 2001-11-15. Interest is paid half-yearly (frequency is 2). Using daily balance interest calculation (basis 3) how many days is this?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3151103				0	sh	=COUPDAYBS("2001-01-25"; "2001-11-15"; 2; 3) returns 71.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3152957				0	sh	\<bookmark_value\>COUPPCD function\</bookmark_value\>\<bookmark_value\>dates;interest date prior to settlement date\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3152957				0	sh	COUPPCD				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153678				0	sh	\<ahelp hid=\"HID_AAI_FUNC_COUPPCD\"\>Returns the date of the interest date prior to the settlement date. Format the result as a date.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3156269				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153790				0	sh	COUPPCD(Settlement; Maturity; Frequency; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150989				0	sh	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154667				0	sh	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154569				0	sh	\<emph\>Frequency\</emph\> is the number of interest payments per year (1, 2 or 4).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3150826				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148968				0	sh	A security is purchased on 2001-01-25; the date of maturity is 2001-11-15. Interest is paid half-yearly (frequency is 2). Using daily balance interest calculation (basis 3) what was the interest date prior to purchase?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149992				0	sh	=COUPPCD("2001-01-25"; "2001-11-15"; 2; 3) returns 2000-15-11.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3150673				0	sh	\<bookmark_value\>COUPNUM function\</bookmark_value\>\<bookmark_value\>number of coupons\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3150673				0	sh	COUPNUM				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154350				0	sh	\<ahelp hid=\"HID_AAI_FUNC_COUPNUM\"\>Returns the number of coupons (interest payments) between the settlement date and the maturity date.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3148400				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153200				0	sh	COUPNUM(Settlement; Maturity; Frequency; Basis)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3159406				0	sh	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155864				0	sh	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154720				0	sh	\<emph\>Frequency\</emph\> is the number of interest payments per year (1, 2 or 4).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3149319				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3152460				0	sh	A security is purchased on 2001-01-25; the date of maturity is 2001-11-15. Interest is paid half-yearly (frequency is 2). Using daily balance interest calculation (basis 3) how many interest dates are there?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150640				0	sh	=COUPNUM("2001-01-25"; "2001-11-15"; 2; 3) returns 2.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3149339				0	sh	\<bookmark_value\>IPMT function\</bookmark_value\>\<bookmark_value\>periodic amortizement rates\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3149339				0	sh	IPMT				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154522				0	sh	\<ahelp hid=\"HID_FUNC_ZINSZ\"\>Calculates the periodic amortizement for an investment with regular payments and a constant interest rate.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3153266				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3151283				0	sh	IPMT(Rate; Period; NPer; PV; FV; Type)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3147313				0	sh	\<emph\>Rate\</emph\> is the periodic interest rate.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145158				0	sh	\<emph\>Period\</emph\> is the period, for which the compound interest is calculated. Period=NPER if compound interest for the last period is calculated.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3147577				0	sh	\<emph\>NPer\</emph\> is the total number of periods, during which annuity is paid.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3156211				0	sh	\<emph\>PV\</emph\> is the present cash value in sequence of payments.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3151213				0	sh	\<emph\>FV\</emph\> (optional) is the desired value (future value) at the end of the periods.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154195				0	sh	\<emph\>Type\</emph\> is the due date for the periodic payments.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3150102				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149438				0	sh	What is the interest rate during the fifth period (year) if the constant interest rate is 5% and the cash value is 15,000 currency units? The periodic payment is seven years.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150496				0	sh	\<item type=\"input\"\>=IPMT(5%;5;7;15000)\</item\> = -352.97 currency units. The compound interest during the fifth period (year) is 352.97 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3151205				0	sh	\<bookmark_value\>calculating;future values\</bookmark_value\>\<bookmark_value\>future values;constant interest rates\</bookmark_value\>\<bookmark_value\>FV function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3151205				0	sh	FV				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154140				0	sh	\<ahelp hid=\"HID_FUNC_ZW\"\>Returns the future value of an investment based on periodic, constant payments and a constant interest rate (Future Value).\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3155178				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145215				0	sh	FV(Rate; NPer; Pmt; PV; Type)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155136				0	sh	\<emph\>Rate\</emph\> is the periodic interest rate.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3156029				0	sh	\<emph\>NPer\</emph\> is the total number of periods (payment period).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3151322				0	sh	\<emph\>Pmt\</emph\> is the annuity paid regularly per period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145256				0	sh	\<emph\>PV\</emph\> (optional) is the (present) cash value of an investment.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150999				0	sh	\<emph\>Type\</emph\> (optional) defines whether the payment is due at the beginning or the end of a period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_idN114D8				0	sh	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3146800				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3146813				0	sh	What is the value at the end of an investment if the interest rate is 4% and the payment period is two years, with a periodic payment of 750 currency units. The investment has a present value of 2,500 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149302				0	sh	\<item type=\"input\"\>=FV(4%;2;750;2500) \</item\>= -4234.00 currency units. The value at the end of the investment is 4234.00 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3155912				0	sh	\<bookmark_value\>FVSCHEDULE function\</bookmark_value\>\<bookmark_value\>future values;varying interest rates\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3155912				0	sh	FVSCHEDULE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3163726				0	sh	\<ahelp hid=\"HID_AAI_FUNC_FVSCHEDULE\"\>Calculates the accumulated value of the starting capital for a series of periodically varying interest rates.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3149571				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148891				0	sh	FVSCHEDULE(Principal; Schedule)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148904				0	sh	\<emph\>Principal\</emph\> is the starting capital.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148562				0	sh	\<emph\>Schedule\</emph\> is a series of interest rates, for example, as a range H3:H5 or as a (List) (see example).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3147288				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148638				0	sh	1000 currency units have been invested in for three years. The interest rates were 3%, 4% and 5% per annum. What is the value after three years?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3156358				0	sh	\<item type=\"input\"\>=FVSCHEDULE(1000;{0.03;0.04;0.05})\</item\> returns 1124.76.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3156435				0	sh	\<bookmark_value\>calculating;number of payment periods\</bookmark_value\>\<bookmark_value\>payment periods;number of\</bookmark_value\>\<bookmark_value\>number of payment periods\</bookmark_value\>\<bookmark_value\>NPER function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3156435				0	sh	NPER				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3152363				0	sh	\<ahelp hid=\"HID_FUNC_ZZR\"\>Returns the number of periods for an investment based on periodic, constant payments and a constant interest rate.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3147216				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155934				0	sh	NPER(Rate; Pmt; PV; FV; Type)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155946				0	sh	\<emph\>Rate\</emph\> is the periodic interest rate.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149042				0	sh	\<emph\>Pmt\</emph\> is the constant annuity paid in each period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153134				0	sh	\<emph\>PV\</emph\> is the present value (cash value) in a sequence of payments.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154398				0	sh	\<emph\>FV\</emph\> (optional) is the future value, which is reached at the end of the last period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145127				0	sh	\<emph\>Type\</emph\> (optional) is the due date of the payment at the beginning or at the end of the period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_idN1166C				0	sh	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3155795				0	sh	Example				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3147378				0	sh	How many payment periods does a payment period cover with a periodic interest rate of 6%, a periodic payment of 153.75 currency units and a present cash value of 2.600 currency units.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3156171				0	sh	\<item type=\"input\"\>=NPER(6%;153.75;2600)\</item\> = -12,02. The payment period covers 12.02 periods.				20181231 09:50:43
