helpcontent2	source\text\sbasic\shared\03030201.xhp	0	help	par_id3156441				0	sh	Print "The current hour is " & Hour( Now )				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03030201.xhp	0	help	par_id3153145				0	sh	End Sub				20181231 09:50:43
