helpcontent2	source\text\sbasic\shared\03103450.xhp	0	help	par_id3149670				0	sh	iGlobalVar = iGlobalVar + 1				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03103450.xhp	0	help	par_id3148552				0	sh	MsgBox iGlobalVar				20181231 09:50:43
