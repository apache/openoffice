helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3155418				0	sh	Case 6, 7, 8				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3154943				0	sh	Print "Number from 6 to 8"				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3145800				0	sh	Case Is > 8 And iVar < 11				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3151074				0	sh	Print "Greater than 8"				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3154016				0	sh	Case Else				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3155602				0	sh	Print "Outside range 1 to 10"				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3150328				0	sh	End Select				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3154479				0	sh	end sub				20181231 09:50:43
