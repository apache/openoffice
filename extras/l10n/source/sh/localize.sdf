helpcontent2	source\text\shared\02\01170100.xhp	0	help	par_id3153627				0	sh	\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Option\</caseinline\>\<defaultinline\>Alt\</defaultinline\>\</switchinline\>+Up Arrow				20181231 09:50:43
helpcontent2	source\text\shared\02\01170100.xhp	0	help	par_id3153063				0	sh	Closes the combo box				20181231 09:50:43
