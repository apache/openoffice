helpcontent2	source\text\scalc\01\func_day.xhp	0	help	hd_id3147317				0	sh	\<variable id=\"day\"\>\<link href=\"text/scalc/01/func_day.xhp\"\>DAY\</link\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3147584				0	sh	\<ahelp hid=\"HID_FUNC_TAG\"\>Returns the day of given date value.\</ahelp\> The day is returned as an integer between 1 and 31. You can also enter a negative date/time value.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	hd_id3150487				0	sh	Syntax				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3149430				0	sh	DAY(Number)				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3149443				0	sh	\<emph\>Number\</emph\>, as a time value, is a decimal, for which the day is to be returned.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	hd_id3163809	111			0	sh	Examples 				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3151200				0	sh	DAY(1) returns 31 (since $[officename] starts counting at zero from December 30, 1899)				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3154130				0	sh	DAY(NOW()) returns the current day.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3159190				0	sh	=DAY(C4) returns 5 if you enter 1901-08-05 in cell C4 (the date value might get formatted differently after you press Enter).				20181231 09:50:43
