helpcontent2	source\text\swriter\01\03080000.xhp	0	help	par_id3147513	2			0	es	\<ahelp hid=\".uno:Marks\"\>Muestra u oculta los sombreados de los campos en el documento, incluidos los espacios protegidos, las separaciones manuales, los índices y las notas al pie.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\03080000.xhp	0	help	par_id3153540	17			0	es	\<link href=\"text/swriter/01/03100000.xhp\" name=\"Activar o desactivar los caracteres no imprimibles\"\>Activar o desactivar los caracteres no imprimibles\</link\>				20130618 17:22:18
