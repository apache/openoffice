helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3154490	16			0	es	sFecha = InputBox("Escriba la fecha de caducidad (MM.DD.AAAA)")				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3154943	17			0	es	sFecha = Right$(sFecha, 4) +  Mid$(sFecha, 4, 2)  + Left$(sFecha, 2)				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3154098	18			0	es	sHoy = Date$				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3144765	19			0	es	sHoy = Right$(sHoy, 4) +  Mid$(sHoy, 4, 2)  + Left$(sHoy, 2)				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3154792	20			0	es	If sFecha < sHoy Then				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3155601	21			0	es	MsgBox "La fecha de caducidad ya ha pasado"				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3146972	22			0	es	ElseIf sFecha > sHoy Then				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3146912	23			0	es	MsgBox "La fecha de caducidad no ha pasado aún"				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3153710	24			0	es	Else				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3154754	25			0	es	MsgBox "La fecha de caducidad es hoy"				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3154361	26			0	es	End If				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3148405	28			0	es	End Sub				20130618 17:22:18
