helpcontent2	source\text\shared\02\12100200.xhp	0	help	par_id3150365	44			0	es	"?loppy" encuentra "Floppy"				20130618 17:22:18
helpcontent2	source\text\shared\02\12100200.xhp	0	help	par_id3166426	65			0	es	"C?sa" encuentra casa y cosa				20130618 17:22:18
