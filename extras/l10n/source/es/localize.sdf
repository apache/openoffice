helpcontent2	source\text\sbasic\shared\03120101.xhp	0	help	par_id3150792	12			0	es	Print ASC("A") REM devuelve 65				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03120101.xhp	0	help	par_id3148797	13			0	es	Print ASC("Z") REM devuelve 90				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03120101.xhp	0	help	par_id3163800	14			0	es	Print ASC("Las Vegas") REM devuelve 76, ya que sólo se tiene en cuenta el primer carácter				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03120101.xhp	0	help	par_id3148674	15			0	es	End Sub				20130618 17:22:18
