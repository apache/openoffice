helpcontent2	source\text\smath\01\03090906.xhp	0	help	par_id3154763				0	hu	bold { f(x", "y) = left [ stack { x + y over z + left lbrace matrix { 2 # 3 # 4 ## 4 # 5 # 6 ## 6 # 7 # 8} right rbrace # {y + sin (x)} over %alpha # z + y over g } right ]}				20200411 15:09:53
