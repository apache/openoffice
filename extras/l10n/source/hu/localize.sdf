helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3155132				0	hu	sText = InputBox("Írjon be egy rövid mondatot:")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3155855				0	hu	REM Bizonyosodjon meg arról, hogy az „és” szó a mondatban jelenik meg.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3146984				0	hu	REM A parancssor helyett				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3148576				0	hu	REM If Instr(Input, "és")<>0 Then...				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3154014				0	hu	REM A CBool függvény a következőképpen lesz alkalmazva:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3155413				0	hu	If CBool(Instr(sText, "és")) Then				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3152940				0	hu	MsgBox "Az „és” szó benne van a beírt mondatban!"				20200411 15:09:53
