helpcontent2	source\text\sbasic\shared\03120308.xhp	0	help	par_id3148575				0	ast	sVar = String(5,"*")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120308.xhp	0	help	par_id3153140				0	ast	sExpr = "123457896"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120308.xhp	0	help	par_id3153144				0	ast	RSet sVar = sExpr				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120308.xhp	0	help	par_id3150116				0	ast	Print ">"; sVar; "<"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120308.xhp	0	help	par_id3154491				0	ast	sVar = String(40,"*")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120308.xhp	0	help	par_id3149412				0	ast	sExpr = "SBX"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120308.xhp	0	help	par_id3145801				0	ast	REM Left-align "SBX" in a 40-character string				20200411 15:09:53
