helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145123	36			0	ast	                     \<emph\>E\</emph\>                  				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149504				0	ast	1				20200411 15:09:53
