helpcontent2	source\text\sbasic\shared\03060500.xhp	0	help	par_id3155856				0	ast	vA = 10: vB = 8: vC = 6: vD = Null				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03060500.xhp	0	help	par_id3152460				0	ast	vOut = vA > vB Or vB > vC REM -1				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03060500.xhp	0	help	par_id3147349				0	ast	vOut = vB > vA Or vB > vC REM -1				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03060500.xhp	0	help	par_id3151114				0	ast	vOut = vA > vB Or vB > vD REM -1				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03060500.xhp	0	help	par_id3153726				0	ast	vOut = (vB > vD Or vB > vA) REM 0				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03060500.xhp	0	help	par_id3152598				0	ast	vOut = vB Or vA REM 10				20200411 15:09:53
