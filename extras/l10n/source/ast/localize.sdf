helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	hd_id3154347				0	ast	\<link href=\"text/sbasic/shared/03020404.xhp\" name=\"Dir Function [Runtime]\"\>Dir Function [Runtime]\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3153381				0	ast	Returns the name of a file, a directory, or all of the files and the directories on a drive or in a directory that match the specified search path.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	hd_id3154365				0	ast	Syntax:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3156282				0	ast	Dir [(Text As String) [, Attrib As Integer]]				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	hd_id3156424				0	ast	Return value:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3153193				0	ast	String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	hd_id3153770				0	ast	Parameters:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3161831				0	ast	\<emph\>Text:\</emph\> Any string expression that specifies the search path, directory or file. This argument can only be specified the first time that you call the Dir function. If you want, you can enter the path in \<link href=\"text/sbasic/shared/00000002.xhp\" name=\"URL notation\"\>URL notation\</link\>.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3146974	9			0	ast	\<emph\>Attrib: \</emph\>Any integer expression that specifies bitwise file attributes. The Dir function only returns files or directories that match the specified attributes. You can combine several attributes by adding the attribute values:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3149666				0	ast	0 : Normal files.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3147427				0	ast	16 : Returns the name of the directory only.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3153952				0	ast	Use this attribute to check if a file or directory exists, or to determine all files and folders in a specific directory.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3159156				0	ast	To check if a file exists, enter the complete path and name of the file. If the file or directory name does not exist, the Dir function returns a zero-length string ("").				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3154012	18			0	ast	To generate a list of all existing files in a specific directory, proceed as follows: The first time you call the Dir function, specify the complete search path for the files, for example, "D:\\Files\\*.sxw". If the path is correct and the search finds at least one file, the Dir function returns the name of the first file that matches the search path. To return additional file names that match the path, call Dir again, but with no arguments.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3147348				0	ast	To return directories only, use the attribute parameter. The same applies if you want to determine the name of a volume (for example, a hard drive partition)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	hd_id3154942				0	ast	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3147125				0	ast	Sub ExampleDir				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3148455				0	ast	REM Displays all files and directories				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3147396				0	ast	Dim sPath As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3149378				0	ast	Dim sDir as String, sValue as String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3153416				0	ast	sDir="Directories:"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3153838				0	ast	sPath = CurDir				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3150327				0	ast	sValue = Dir$(sPath + getPathSeparator + "*",16)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3155064				0	ast	Do				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3153764				0	ast	If sValue <> "." and sValue <> ".." Then				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3155766				0	ast	if (GetAttr( sPath + getPathSeparator + sValue) AND 16) >0 then				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3154253				0	ast	REM get the directories				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3159264				0	ast	sDir = sDir & chr(13) & sValue				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3145148				0	ast	End If				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_idN10700				0	ast	End If				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3147324				0	ast	sValue = Dir$				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3155335				0	ast	Loop Until sValue = ""				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3147345				0	ast	MsgBox sDir,0,sPath				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3163808				0	ast	End sub				20200411 15:09:53
