helpcontent2	source\text\shared\explorer\database\tablewizard01.xhp	0	help	par_idN10567				0	ast	Sample tables				20200411 15:09:53
helpcontent2	source\text\shared\explorer\database\tablewizard01.xhp	0	help	par_idN1056B				0	ast	\<ahelp hid=\".\"\>Select one of the sample tables. Then select fields from that table from the left list box. Repeat this step until you have selected all the fields that you need.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\explorer\database\tablewizard01.xhp	0	help	par_idN1059E				0	ast	Selected Fields				20200411 15:09:53
