helpcontent2	source\text\sbasic\shared\03102700.xhp	0	help	par_id3148944				0	ast	Bool				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102700.xhp	0	help	hd_id3148947				0	ast	Parameters:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102700.xhp	0	help	par_id3154760				0	ast	\<emph\>Var:\</emph\> Any expression that you want to test.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102700.xhp	0	help	hd_id3149656				0	ast	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102700.xhp	0	help	par_id3154367				0	ast	Sub ExampleIsNumeric				20200411 15:09:53
