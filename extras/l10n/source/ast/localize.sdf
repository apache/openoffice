helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	hd_id3154725				0	ast	\<variable id=\"hour\"\>\<link href=\"text/scalc/01/func_hour.xhp\"\>HOUR\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	par_id3149747				0	ast	\<ahelp hid=\"HID_FUNC_STUNDE\"\>Returns the hour for a given time value.\</ahelp\> The hour is returned as an integer between 0 and 23.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	hd_id3149338				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	par_id3150637				0	ast	HOUR(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	par_id3147547				0	ast	\<emph\>Number\</emph\>, as a time value, is a decimal, for which the hour is to be returned.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	hd_id3153264				0	ast	Examples				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	par_id3159215				0	ast	\<item type=\"input\"\>=HOUR(NOW())\</item\> returns the current hour				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	par_id3145152				0	ast	\<item type=\"input\"\>=HOUR(C4)\</item\> returns 17 if the contents of C4 = \<item type=\"input\"\>17:20:00\</item\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	par_id3154188				0	ast	\<link href=\"text/scalc/01/04060102.xhp\" name=\"YEAR\"\>YEAR\</link\>, \<link href=\"text/scalc/01/04060102.xhp\" name=\"NOW\"\>NOW\</link\>, \<link href=\"text/scalc/01/04060102.xhp\" name=\"MINUTE\"\>MINUTE\</link\>, \<link href=\"text/scalc/01/04060102.xhp\" name=\"MONTH\"\>MONTH\</link\>, \<link href=\"text/scalc/01/04060102.xhp\" name=\"DAY\"\>DAY\</link\>, \<link href=\"text/scalc/01/04060102.xhp\" name=\"WEEKDAY\"\>WEEKDAY\</link\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140500.xhp	0	help	tit				0	ast	Fill Sheet				20200411 15:09:53
