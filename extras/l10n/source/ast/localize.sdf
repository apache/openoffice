helpcontent2	source\text\sbasic\shared\03010103.xhp	0	help	par_id36317				0	ast	Print #i, "ABC"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010103.xhp	0	help	par_id7381817				0	ast	Close #i				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010103.xhp	0	help	par_id3147339				0	ast	end Sub				20200411 15:09:53
