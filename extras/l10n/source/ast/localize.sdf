helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3151211				0	ast	\<emph\>n:\</emph\> Numeric expression that defines the number of characters that you want to return. If \<emph\>n\</emph\> = 0, a zero-length string is returned. The maximum allowed value is 65535.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3158410				0	ast	The following example converts a date in YYYY-MM-DD format to the US date format (MM/DD/YYYY).				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	hd_id3156212				0	ast	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3150869				0	ast	Sub ExampleUSDate				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3153105				0	ast	Dim sInput As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3154124				0	ast	Dim sUS_date As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3159252				0	ast	sInput = InputBox("Please input a date in the international format 'YYYY-MM-DD'")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3149561				0	ast	sUS_date = Mid(sInput, 6, 2)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3146984				0	ast	sUS_date = sUS_date & "/"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3155308				0	ast	sUS_date = sUS_date & Right(sInput, 2)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3153727				0	ast	sUS_date = sUS_date & "/"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3145365				0	ast	sUS_date = sUS_date & Left(sInput, 4)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3152940				0	ast	MsgBox sUS_date				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3146120				0	ast	End Sub				20200411 15:09:53
