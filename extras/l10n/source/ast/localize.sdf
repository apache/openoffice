helpcontent2	source\text\sbasic\shared\03010303.xhp	0	help	par_id3145173				0	ast	Integer				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010303.xhp	0	help	hd_id3154685				0	ast	Parameter:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010303.xhp	0	help	par_id3150440	8			0	ast	\<emph\>ColorNumber\</emph\>: Long integer expression that specifies any \<link href=\"text/sbasic/shared/00000003.xhp#farbcodes\" name=\"color code\"\>color code\</link\> for which to return the Red component.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010303.xhp	0	help	hd_id3148575				0	ast	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010303.xhp	0	help	par_id3145365				0	ast	Sub ExampleColor				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010303.xhp	0	help	par_id3147348				0	ast	Dim lVar As Long				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010303.xhp	0	help	par_id3145750				0	ast	lVar = rgb(128,0,200)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010303.xhp	0	help	par_id3147435				0	ast	msgbox "The color " & lVar & " consists of:" & Chr(13) &_				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010303.xhp	0	help	par_id3155306				0	ast	"red= " & red(lVar) & Chr(13)&_				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010303.xhp	0	help	par_id3149262				0	ast	"green= " & green(lVar) & Chr(13)&_				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010303.xhp	0	help	par_id3147397				0	ast	"blue= " & blue(lVar) & Chr(13) , 64,"colors"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010303.xhp	0	help	par_id3156286				0	ast	end sub				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	tit				0	ast	FileAttr-Function [Runtime]				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	bm_id3153380				0	ast	\<bookmark_value\>FileAttr function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	hd_id3153380				0	ast	\<link href=\"text/sbasic/shared/03020405.xhp\" name=\"FileAttr-Function [Runtime]\"\>FileAttr Function [Runtime]\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3154366				0	ast	Returns the access mode or the file access number of a file that was opened with the Open statement. The file access number is dependent on the operating system (OSH = Operating System Handle).				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3153364				0	ast	If you use a 32-Bit operating system, you cannot use the FileAttr-Function to determine the file access number.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3163713				0	ast	See also: \<link href=\"text/sbasic/shared/03020103.xhp\" name=\"Open\"\>Open\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	hd_id3151116				0	ast	Syntax:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3154012				0	ast	FileAttr (FileNumber As Integer, Attribute As Integer)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	hd_id3147349				0	ast	Return value:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3146974				0	ast	Integer				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	hd_id3153728				0	ast	Parameters:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3151074				0	ast	\<emph\>FileNumber:\</emph\> The number of the file that was opened with the Open statement.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3144766				0	ast	\<emph\>Attribute:\</emph\> Integer expression that indicates the type of file information that you want to return. The following values are possible:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3147396				0	ast	1: The FileAttr-Function indicates the access mode of the file.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3149959				0	ast	2: The FileAttr-Function returns the file access number of the operating system.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3154018				0	ast	If you specify a parameter attribute with a value of 1, the following return values apply:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3149124				0	ast	1 - INPUT (file open for input)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3156275				0	ast	2 - OUTPUT (file open for output)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3155066				0	ast	4 - RANDOM (file open for random access)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3148406				0	ast	8 - APPEND (file open for appending)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3154757				0	ast	32 - BINARY (file open in binary mode).				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	hd_id3147339				0	ast	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3155959				0	ast	Sub ExampleFileAttr				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3145147				0	ast	Dim iNumber As Integer				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3153966				0	ast	Dim sLine As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3155336				0	ast	Dim aFile As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3163807				0	ast	aFile = "c:\\data.txt"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3154021				0	ast	iNumber = Freefile				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3153786				0	ast	Open aFile For Output As #iNumber				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3155607				0	ast	Print #iNumber, "This is a line of text"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3150361				0	ast	MsgBox FileAttr(#iNumber, 1 ),0,"Access mode"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3149817				0	ast	MsgBox FileAttr(#iNumber, 2 ),0,"File attribute"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3155115				0	ast	Close #iNumber				20200411 15:09:53
