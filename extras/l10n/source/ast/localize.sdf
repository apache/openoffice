helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3150327				0	ast	Const sText1 = "An unexpected error occurred."				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3146912				0	ast	Const sText2 = "The program execution will continue, however."				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3154757				0	ast	Const sText3 = "Error"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3155445				0	ast	MsgBox(sText1 + Chr(13) + sText2,16,sText3)				20200411 15:09:53
