helpcontent2	source\text\sbasic\shared\03090402.xhp	0	help	par_id3155855				0	ast	sReturn = ChooseMenu(2)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090402.xhp	0	help	par_id3148575				0	ast	Print sReturn				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090402.xhp	0	help	par_id3154012				0	ast	end sub				20200411 15:09:53
