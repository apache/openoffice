helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3151075				0	ast	Add-ins supplied				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3156285				0	ast	$[officename] contains examples for the add-in interface of $[officename] Calc.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3159267				0	ast	\<link href=\"text/scalc/01/04060115.xhp\"\>Analysis Functions Part One\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3154703				0	ast	\<link href=\"text/scalc/01/04060116.xhp\"\>Analysis Functions Part Two\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3149566				0	ast	\<bookmark_value\>ISLEAPYEAR function\</bookmark_value\>\<bookmark_value\>leap year determination\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3149566				0	ast	ISLEAPYEAR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150297				0	ast	\<ahelp hid=\".\"\>Determines whether a year is a leap year.\</ahelp\> If yes, the function will return the value 1 (TRUE); if not, it will return 0 (FALSE).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3148487				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150205				0	ast	ISLEAPYEAR("Date")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3159239				0	ast	\<emph\>Date\</emph\> specifies whether a given date falls within a leap year. The Date parameter must be a valid date according to the locale settings of %PRODUCTNAME.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3149817				0	ast	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150786				0	ast	=ISLEAPYEAR(A1) returns 1, if A1 contains 1968-02-29, the valid date 29th of February 1968 in your locale setting.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_idN107E7				0	ast	You may also use =ISLEAPYEAR("1968-02-29") or =ISLEAPYEAR("2/29/68").				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_idN107EA				0	ast	Never use =ISLEAPYEAR(2/29/68), because this would first evaluate 2 divided by 29 divided by 68, and then calculate the ISLEAPYEAR function from this small number as a serial date number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3154656				0	ast	\<bookmark_value\>YEARS function\</bookmark_value\>\<bookmark_value\>number of years between two dates\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3154656				0	ast	YEARS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150886				0	ast	\<ahelp hid=\"HID_DAI_FUNC_DIFFYEARS\"\>Calculates the difference in years between two dates.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3154370				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3146114				0	ast	YEARS(StartDate; EndDate; Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3145387				0	ast	\<emph\>StartDate\</emph\> is the first date				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3156290				0	ast	\<emph\>EndDate\</emph\> is the second date				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3152893				0	ast	\<emph\>Type\</emph\> calculates the type of difference. Possible values are 0 (interval) and 1 (in calendar years).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3152898				0	ast	\<bookmark_value\>MONTHS function\</bookmark_value\>\<bookmark_value\>number of months between two dates\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3152898				0	ast	MONTHS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153066				0	ast	\<ahelp hid=\"HID_DAI_FUNC_DIFFMONTHS\"\>Calculates the difference in months between two dates.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3151240				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3146869				0	ast	MONTHS(StartDate; EndDate; Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3145075				0	ast	\<emph\>StartDate\</emph\> is the first date				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3157981				0	ast	\<emph\>EndDate\</emph\> is the second date				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150111				0	ast	\<emph\>Type\</emph\> calculates the type of difference. Possible values include 0 (interval) and 1 (in calendar months).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3159094				0	ast	\<bookmark_value\>ROT13 function\</bookmark_value\>\<bookmark_value\>encrypting text\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3159094				0	ast	ROT13				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3146781				0	ast	\<ahelp hid=\"HID_DAI_FUNC_ROT13\"\>Encrypts a character string by moving the characters 13 positions in the alphabet.\</ahelp\> After the letter Z, the alphabet begins again (Rotation). By applying the encryption function again to the resulting code, you can decrypt the text.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3150893				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3159205				0	ast	ROT13(Text)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153249				0	ast	\<emph\>Text\</emph\> is the character string to be encrypted. ROT13(ROT13(Text)) decrypts the code.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3151300				0	ast	\<bookmark_value\>DAYSINYEAR function\</bookmark_value\>\<bookmark_value\>number of days; in a specific year\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3151300				0	ast	DAYSINYEAR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3143220				0	ast	\<ahelp hid=\"HID_DAI_FUNC_DAYSINYEAR\"\>Calculates the number of days of the year in which the date entered occurs.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3145358				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3154651				0	ast	DAYSINYEAR(Date)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153803				0	ast	\<emph\>Date\</emph\> is any date in the respective year. The Date parameter must be a valid date according to the locale settings of %PRODUCTNAME.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3153487				0	ast	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153811				0	ast	=DAYSINYEAR(A1) returns 366 days if A1 contains 1968-02-29, a valid date for the year 1968.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3154737				0	ast	\<bookmark_value\>DAYSINMONTH function\</bookmark_value\>\<bookmark_value\>number of days;in a specific month of a year\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3154737				0	ast	DAYSINMONTH				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3149316				0	ast	\<ahelp hid=\"HID_DAI_FUNC_DAYSINMONTH\"\>Calculates the number of days of the month in which the date entered occurs.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3145114				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150955				0	ast	DAYSINMONTH(Date)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3147501				0	ast	\<emph\>Date\</emph\> is any date in the respective month of the desired year. The Date parameter must be a valid date according to the locale settings of %PRODUCTNAME.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3149871				0	ast	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3155742				0	ast	=DAYSINMONTH(A1) returns 29 days if A1 contains 1968-02-17, a valid date for February 1968.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3149048				0	ast	\<bookmark_value\>WEEKS function\</bookmark_value\>\<bookmark_value\>number of weeks;between two dates\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3149048				0	ast	WEEKS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153340				0	ast	\<ahelp hid=\"HID_DAI_FUNC_DIFFWEEKS\"\>Calculates the difference in weeks between two dates.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3150393				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3147402				0	ast	WEEKS(StartDate; EndDate; Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3151387				0	ast	\<emph\>StartDate\</emph\> is the first date				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3146324				0	ast	\<emph\>EndDate\</emph\> is the second date				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3166467				0	ast	\<emph\>Type\</emph\> calculates the type of difference. The possible values are 0 (interval) and 1 (in numbers of weeks).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3145237				0	ast	\<bookmark_value\>WEEKSINYEAR function\</bookmark_value\>\<bookmark_value\>number of weeks;in a specific year\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3145237				0	ast	WEEKSINYEAR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3147410				0	ast	\<ahelp hid=\"HID_DAI_FUNC_WEEKSINYEAR\"\>Calculates the number of weeks of the year in which the date entered occurs.\</ahelp\> The number of weeks is defined as follows: a week that spans two years is added to the year in which most days of that week occur.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3149719				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3145638				0	ast	WEEKSINYEAR(Date)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3149946				0	ast	\<emph\>Date\</emph\> is any date in the respective year. The Date parameter must be a valid date according to the locale settings of %PRODUCTNAME.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3150037				0	ast	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3147614				0	ast	WEEKSINYEAR(A1) returns 53 if A1 contains 1970-02-17, a valid date for the year 1970.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3157901				0	ast	Add-ins through %PRODUCTNAME API				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3149351				0	ast	Add-ins can also be implemented through the %PRODUCTNAME \<link href=\"https://api.openoffice.org/\"\>API\</link\>.				20200411 15:09:53
