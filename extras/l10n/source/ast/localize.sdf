helpcontent2	source\text\sbasic\shared\03020103.xhp	0	help	par_id3155764				0	ast	Dim sMsg as String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020103.xhp	0	help	par_id3159264				0	ast	aFile = "c:\\data.txt"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020103.xhp	0	help	par_id3153963				0	ast	iNumber = Freefile				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020103.xhp	0	help	par_id3155959				0	ast	Open aFile For Output As #iNumber				20200411 15:09:53
