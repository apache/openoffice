helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3125864				0	ast	\<emph\>Expression:\</emph\> Any numeric expression.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3155306				0	ast	\<emph\>Omitted:\</emph\> Returns the next random number in the sequence.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3147318				0	ast	The \<emph\>Rnd\</emph\> function only returns values ranging from 0 to 1. To generate random integers in a given range, use the formula in the following example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	hd_id3151118				0	ast	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3145365				0	ast	Sub ExampleRandomSelect				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3147426				0	ast	Dim iVar As Integer				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3150011				0	ast	iVar = Int((15 * Rnd) -2)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3148575				0	ast	Select Case iVar				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3154097				0	ast	Case 1 To 5				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3147124				0	ast	Print "Number from 1 to 5"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3155418				0	ast	Case 6, 7, 8				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3154943				0	ast	Print "Number from 6 to 8"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3145800				0	ast	Case Is > 8 And iVar < 11				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3151074				0	ast	Print "Greater than 8"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3154016				0	ast	Case Else				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3155602				0	ast	Print "Outside range 1 to 10"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3150328				0	ast	End Select				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080302.xhp	0	help	par_id3154479				0	ast	end sub				20200411 15:09:53
