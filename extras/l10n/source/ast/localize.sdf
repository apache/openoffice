helpcontent2	source\text\swriter\guide\text_nav_keyb.xhp	0	help	par_id3149624				0	ast	Home				20200411 15:09:53
helpcontent2	source\text\swriter\guide\text_nav_keyb.xhp	0	help	par_id3149871				0	ast	Moves the cursor to the beginning of the current line.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\text_nav_keyb.xhp	0	help	par_id3145108				0	ast	Moves the cursor to the beginning of the document.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\text_nav_keyb.xhp	0	help	par_id3149586				0	ast	Home				20200411 15:09:53
