helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	hd_id3149532				0	ast	\<variable id=\"export_as_pdf\"\>\<variable id=\"ref_pdf_export\"\>\<link href=\"text/shared/01/ref_pdf_export.xhp\" name=\"Export as PDF\"\>Export as PDF\</link\>\</variable\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_id3154044				0	ast	\<variable id=\"export\"\>\<ahelp hid=\"FILTER_EDIT_RID_PDF_EXPORT_DLG_ED_PAGES\"\>Saves the current file to Portable Document Format (PDF) version 1.4.\</ahelp\> A PDF file can be viewed and printed on any platform with the original formatting intact, provided that supporting software is installed.\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	hd_id746482				0	ast	General				20200411 15:09:53
