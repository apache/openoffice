helpcontent2	source\text\sbasic\shared\03030301.xhp	0	help	hd_id3156027				0	ast	\<link href=\"text/sbasic/shared/03030301.xhp\" name=\"Date Statement [Runtime]\"\>Date Statement [Runtime]\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030301.xhp	0	help	par_id3147291				0	ast	Returns the current system date as a string, or resets the date. The date format depends on your local system settings.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030301.xhp	0	help	hd_id3148686				0	ast	Syntax:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030301.xhp	0	help	par_id3146794				0	ast	Date ; Date = Text As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030301.xhp	0	help	hd_id3154347				0	ast	Parameters:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030301.xhp	0	help	par_id3145069				0	ast	\<emph\>Text:\</emph\> Only required in order to reset the system date. In this case, the string expression must correspond to the date format defined in your local settings.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030301.xhp	0	help	hd_id3150793				0	ast	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030301.xhp	0	help	par_id3151212				0	ast	Sub ExampleDate				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030301.xhp	0	help	par_id3156424				0	ast	msgbox "The date is " & Date				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030301.xhp	0	help	par_id3145174				0	ast	end sub				20200411 15:09:53
