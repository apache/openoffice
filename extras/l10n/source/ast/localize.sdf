helpcontent2	source\text\swriter\01\mailmerge07.xhp	0	help	par_idN1056F				0	ast	\<ahelp hid=\".\"\>Searches for whole words only and not parts of larger words.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\mailmerge07.xhp	0	help	par_idN10572				0	ast	Backwards				20200411 15:09:53
helpcontent2	source\text\swriter\01\mailmerge07.xhp	0	help	par_idN10576				0	ast	\<ahelp hid=\".\"\>Searches from the current cursor position to the top of the document.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\mailmerge07.xhp	0	help	par_idN10579				0	ast	Match case				20200411 15:09:53
helpcontent2	source\text\swriter\01\mailmerge07.xhp	0	help	par_idN1057D				0	ast	\<ahelp hid=\".\"\>Distinguishes between uppercase and lowercase characters in the search.\</ahelp\>				20200411 15:09:53
