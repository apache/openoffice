helpcontent2	source\text\shared\02\20100000.xhp	0	help	par_id3154926				0	ast	\<ahelp hid=\".uno:CurrentDate\" visibility=\"visible\"\>Displays the current date.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	tit				0	ast	Table				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	hd_id3151299				0	ast	Table				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	bm_id3156183				0	ast	\<bookmark_value\>database contents; inserting as tables\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3156183	18			0	ast	\<ahelp hid=\"SW:RADIOBUTTON:DLG_AP_INSERT_DB_SEL:RB_AS_TABLE\" visibility=\"hidden\"\>Inserts data selected from the data source browser into the document as a table.\</ahelp\>In the \<emph\>Insert Database Columns\</emph\> dialog, select the \<emph\>Table\</emph\> option to insert the selected data into the document as a table. In the dialog, you can decide which database fields or columns are transferred, and how the text table is formatted.				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	hd_id3152594				0	ast	Table				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3152918				0	ast	In the \<emph\>Table\</emph\> area, use the arrow keys to select the columns of the database table that you want to apply to the text table.				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	hd_id3156042				0	ast	Database columns				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3152425	20			0	ast	\<ahelp hid=\"SW:LISTBOX:DLG_AP_INSERT_DB_SEL:LB_TBL_DB_COLUMN\"\>Specifies the database columns to be inserted into the text table.\</ahelp\> All database table columns that have not been accepted in the \<emph\>Table column(s)\</emph\> list box are listed here. The entries are sorted alphabetically. 				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	hd_id3147577				0	ast	Table column(s)				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3153527				0	ast	\<ahelp hid=\"SW:LISTBOX:DLG_AP_INSERT_DB_SEL:LB_TABLE_COL\"\>Lists all database columns to be inserted into the document.\</ahelp\> A column will be assigned to each corresponding entry in the table. The entry order in the \<emph\>Table column(s)\</emph\> list box determines the data order in the text table.				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	hd_id3146958				0	ast	>>				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3149750				0	ast	\<ahelp hid=\"SW_IMAGEBUTTON_DLG_AP_INSERT_DB_SEL_IB_DBCOL_ALL_TO\"\>Moves all listed database fields into the \<emph\>Table column(s)\</emph\> list box.\</ahelp\> All fields listed in the \<emph\>Table column(s)\</emph\> list box are inserted into the document.				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	hd_id3163802				0	ast	>				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3153662	23			0	ast	\<ahelp hid=\"SW_IMAGEBUTTON_DLG_AP_INSERT_DB_SEL_IB_DBCOL_ONE_TO\"\>Moves the selected database field into the \<emph\>Table column(s)\</emph\> list box. \</ahelp\> You can also double click an entry to move it to the \<emph\>Table column(s)\</emph\> list box. All fields listed in the \<emph\>Table column(s)\</emph\> list box are inserted into the document.				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	hd_id3149732				0	ast	<				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3148685	24			0	ast	\<ahelp hid=\"SW_IMAGEBUTTON_DLG_AP_INSERT_DB_SEL_IB_DBCOL_ONE_FROM\"\>Removes the selected database field from the\<emph\> Table column(s)\</emph\> list box\</ahelp\> The removed field is not inserted into the document.				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	hd_id3150771				0	ast	<<				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3154897				0	ast	\<ahelp hid=\"SW_IMAGEBUTTON_DLG_AP_INSERT_DB_SEL_IB_DBCOL_ALL_FROM\"\>Removes all database fields from the \<emph\>Table column(s)\</emph\> list box.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	hd_id3159399				0	ast	Format				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3154380				0	ast	Specifies the format for inserting the database fields into the document.				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	hd_id3156329				0	ast	From database				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3149415				0	ast	\<ahelp hid=\"SW:RADIOBUTTON:DLG_AP_INSERT_DB_SEL:RB_DBFMT_FROM_DB\"\>Accepts the database formats.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	hd_id3159148				0	ast	Select				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3152349				0	ast	\<ahelp hid=\"SW:LISTBOX:DLG_AP_INSERT_DB_SEL:LB_DBFMT_FROM_USR\"\>Specifies a format from the list, if the format information of certain data fields is not accepted.\</ahelp\> The formats supplied here are only available for certain database fields, such as numeric or Boolean fields. If you select a database field in text format, you will not be able to select any format from the selection list, since the text format will be automatically maintained.				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3144511				0	ast	If the format you want is not listed, select "Other Formats..." and define the desired format in the \<link href=\"text/shared/01/05020300.xhp\" name=\"Number Format\"\>\<emph\>Number Format\</emph\>\</link\> dialog.				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3154282				0	ast	The number format assigned using the selection list always refers to the database field selected in the \<emph\>Database columns\</emph\> list box.				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3154138				0	ast	To insert the data into the document in the form of a table, the correct \<emph\>Table\</emph\> option must be active. You can then select a database field from the \<emph\>Table column(s)\</emph\> list box to define the formatting of the database field. The changes to the number formats will be applied to the last selection. It does not matter whether the database field was selected from the \<emph\>Database columns\</emph\> list box or from the \<emph\>Table column(s)\</emph\> list box.				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	hd_id3156280				0	ast	Insert table heading				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3150497				0	ast	\<ahelp hid=\"SW:CHECKBOX:DLG_AP_INSERT_DB_SEL:CB_TABLE_HEADON\"\>Specifies whether to insert a heading line for the columns in the text table.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	hd_id3153178				0	ast	Apply column name				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3152922				0	ast	\<ahelp hid=\"SW:RADIOBUTTON:DLG_AP_INSERT_DB_SEL:RB_HEADL_COLNMS\"\>Uses the field names of the database table as headings for each of the text table columns.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	hd_id3158407				0	ast	Create row only				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3153194	29			0	ast	\<ahelp hid=\"SW:RADIOBUTTON:DLG_AP_INSERT_DB_SEL:RB_HEADL_EMPTY\"\>Inserts an empty heading line into the text table.\</ahelp\> Using the\<emph\> Create row only \</emph\>option, you can define headings in the document, which do not correspond to the database field names.				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	hd_id3153369				0	ast	Properties				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3154299				0	ast	\<ahelp hid=\"SW:PUSHBUTTON:DLG_AP_INSERT_DB_SEL:PB_TBL_FORMAT\"\>Opens the \<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<link href=\"text/swriter/01/05090000.xhp\" name=\"Table Format\"\>\<emph\>Table Format\</emph\>\</link\>\</caseinline\>\<defaultinline\>\<emph\>Table Format\</emph\>\</defaultinline\>\</switchinline\> dialog, which enables you to define the table properties such as borders, background, and column width.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	hd_id3153728				0	ast	AutoFormat				20200411 15:09:53
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3154988				0	ast	\<ahelp hid=\"SW:PUSHBUTTON:DLG_AP_INSERT_DB_SEL:PB_TBL_AUTOFMT\"\>Opens the \<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<link href=\"text/swriter/01/05150101.xhp\" name=\"AutoFormat\"\>\<emph\>AutoFormat\</emph\>\</link\>\</caseinline\>\<defaultinline\>\<emph\>AutoFormat\</emph\>\</defaultinline\>\</switchinline\> dialog, in which you can select format styles that are immediately applied when inserting the table.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\09070200.xhp	0	help	tit				0	ast	Mail & News				20200411 15:09:53
helpcontent2	source\text\shared\02\09070200.xhp	0	help	hd_id3147102				0	ast	\<link href=\"text/shared/02/09070200.xhp\" name=\"Mail News\"\>Mail & News\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\02\09070200.xhp	0	help	par_id3153049				0	ast	On the \<emph\>Mail & News\</emph\> page in the \<link href=\"text/shared/02/09070000.xhp\" name=\"Hyperlink dialog\"\>Hyperlink dialog\</link\> you can edit hyperlinks for e-mail or news addresses.				20200411 15:09:53
helpcontent2	source\text\shared\02\09070200.xhp	0	help	hd_id3153528				0	ast	Mail & News				20200411 15:09:53
helpcontent2	source\text\shared\02\09070200.xhp	0	help	hd_id3153748				0	ast	E-mail				20200411 15:09:53
helpcontent2	source\text\shared\02\09070200.xhp	0	help	par_id3166460				0	ast	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_HYPERLINK_MAIL_RB_LINKTYP_MAIL\"\>Assigns the specified e-mail address to the hyperlink.\</ahelp\> Clicking the new hyperlink in the document will open a new message document, addressed to the receiver specified in the \<emph\>E-mail\</emph\> field.				20200411 15:09:53
helpcontent2	source\text\shared\02\09070200.xhp	0	help	hd_id3155628				0	ast	News				20200411 15:09:53
helpcontent2	source\text\shared\02\09070200.xhp	0	help	par_id3149955				0	ast	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_HYPERLINK_MAIL_RB_LINKTYP_NEWS\"\>Assigns a news address to the hyperlink.\</ahelp\> Clicking the hyperlink in the document will open a new message document to the news group you entered in the \<emph\>Receiver\</emph\> field.				20200411 15:09:53
helpcontent2	source\text\shared\02\09070200.xhp	0	help	hd_id3149580				0	ast	Receiver				20200411 15:09:53
helpcontent2	source\text\shared\02\09070200.xhp	0	help	par_id3153665				0	ast	\<ahelp hid=\"HID_HYPERDLG_MAIL_PATH\"\>Specifies the full URL of the addressee, in the form mailto:name@provider.com or news:group.server.com.\</ahelp\> You can also use drag-and-drop.				20200411 15:09:53
helpcontent2	source\text\shared\02\09070200.xhp	0	help	hd_id3143270				0	ast	Data Sources				20200411 15:09:53
helpcontent2	source\text\shared\02\09070200.xhp	0	help	par_id3149514				0	ast	\<ahelp hid=\"SVX_IMAGEBUTTON_RID_SVXPAGE_HYPERLINK_MAIL_BTN_ADRESSBOOK\"\>Hides or shows the data source browser.\</ahelp\> Drag the receiver's \<emph\>E-mail\</emph\> data field from the data source browser into the \<emph\>Receiver\</emph\> text field.				20200411 15:09:53
helpcontent2	source\text\shared\02\09070200.xhp	0	help	hd_id3153332				0	ast	Subject				20200411 15:09:53
