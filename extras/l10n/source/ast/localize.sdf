helpcontent2	source\text\sbasic\shared\03132200.xhp	0	help	hd_id3155342				0	ast	\<link href=\"text/sbasic/shared/03132200.xhp\" name=\"ThisComponent [Runtime]\"\>ThisComponent [Runtime]\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03132200.xhp	0	help	par_id3154923				0	ast	Addresses the active component so that its properties can be read and set. ThisComponent is used from document Basic, where it represents the document the Basic belongs to. The type of object accessed by ThisComponent depends on the document type.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03132200.xhp	0	help	hd_id3154346				0	ast	Syntax:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03132200.xhp	0	help	par_id3151056				0	ast	ThisComponent				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03132200.xhp	0	help	hd_id3154940				0	ast	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03132200.xhp	0	help	par_id3151211				0	ast	Sub Main				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03132200.xhp	0	help	par_id3154123				0	ast	 REM updates the "Table of Contents" in a text doc				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03132200.xhp	0	help	par_id3151381				0	ast	 Dim allindexes, index As Object				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03132200.xhp	0	help	par_id3150769				0	ast	 allindexes = ThisComponent.getDocumentIndexes()				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03132200.xhp	0	help	par_id3153194				0	ast	 index = allindexes.getByName("Table of Contents1")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03132200.xhp	0	help	par_id3156422				0	ast	 REM use the default name for Table of Contents and a 1				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03132200.xhp	0	help	par_id3153368				0	ast	 index.update()				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03132200.xhp	0	help	par_id3161832				0	ast	End Sub				20200411 15:09:53
