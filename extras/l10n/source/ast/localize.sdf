helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3148990				0	ast	\<ahelp hid=\"SVX:METRICFIELD:RID_SVXPAGE_STD_PARAGRAPH:ED_LEFTINDENT\"\>Enter the amount of space that you want to indent the paragraph from the page margin. If you want the paragraph to extend into the page margin, enter a negative number. In Left-to-Right languages, the left edge of the paragraph is indented with respect to the left page margin. In Right-to-Left languages, the right edge of the paragraph is indented with respect to the right page margin.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3152361				0	ast	After text				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3154390				0	ast	\<ahelp hid=\"SVX:METRICFIELD:RID_SVXPAGE_STD_PARAGRAPH:ED_RIGHTINDENT\"\>Enter the amount of space that you want to indent the paragraph from the page margin. If you want the paragraph to extend into the page margin, enter a negative number. In Left-to-Right languages, the right edge of the paragraph is indented with respect to the right page margin. In Right-to-Left languages, the left edge of the paragraph is indented with respect to the left page margin.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3149169				0	ast	First line				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3150651				0	ast	\<ahelp hid=\"SVX:METRICFIELD:RID_SVXPAGE_STD_PARAGRAPH:ED_FLINEINDENT\"\>Indents the first line of a paragraph by the amount that you enter. To create a hanging indent enter a positive value for "Before text" and a negative value for "First line". To indent the first line of a paragraph that uses numbering or bullets, choose "\<link href=\"text/shared/01/06050600.xhp\"\>Format - Bullets and Numbering - Position\</link\>".\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3150288	52			0	ast	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Automatic \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3151041	53			0	ast	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<ahelp hid=\"SVX:CHECKBOX:RID_SVXPAGE_STD_PARAGRAPH:CB_AUTO\"\>Automatically indents a paragraph according to the font size and the line spacing. The setting in the \<emph\>First Line \</emph\>box is ignored.\</ahelp\>\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3157894				0	ast	Spacing				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3152462				0	ast	Specify the amount of space to leave between selected paragraphs.				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3147216				0	ast	Above paragraph				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3146148				0	ast	\<ahelp hid=\"SVX:METRICFIELD:RID_SVXPAGE_STD_PARAGRAPH:ED_TOPDIST\"\>Enter the amount of space that you want to leave above the selected paragraph(s).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3145590				0	ast	Below paragraph				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3163822				0	ast	\<ahelp hid=\"SVX:METRICFIELD:RID_SVXPAGE_STD_PARAGRAPH:ED_BOTTOMDIST\"\>Enter the amount of space that you want to leave below the selected paragraph(s).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3156441				0	ast	Line spacing				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3146985				0	ast	\<ahelp hid=\"SVX:LISTBOX:RID_SVXPAGE_STD_PARAGRAPH:LB_LINEDIST\"\>Specify the amount of space to leave between lines of text in a paragraph.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3146923				0	ast	Single				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3150011	31			0	ast	\<variable id=\"einzeiligtext\"\>Applies single line spacing to the current paragraph. This is the default setting. \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3148500				0	ast	1.5 lines				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3150094	34			0	ast	\<variable id=\"eineinhalbzeiligtext\"\>Sets the line spacing to 1.5 lines. \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3149378				0	ast	Double				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3154512	37			0	ast	\<variable id=\"zweizeiligtext\"\>Sets the line spacing to two lines. \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3151206				0	ast	Proportional				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3147494				0	ast	Select this option and then enter a percentage value in the box, where 100% corresponds to single line spacing.				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3156332				0	ast	At Least				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3157965				0	ast	Sets the minimum line spacing to the value that you enter in the box.				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3150744				0	ast	If you use different font sizes within a paragraph, the line spacing is automatically adjusted to the largest font size. If you prefer to have identical spacing for all lines, specify a value in \<emph\>At least\</emph\> that corresponds to the largest font size.				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3153927				0	ast	Leading				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3153354				0	ast	Sets the height of the vertical space that is inserted between two lines.				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3155443	54			0	ast	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Fixed \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3153711	55			0	ast	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Sets the line spacing to exactly match the value that you enter in the box. This can result in cropped characters. \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3156383				0	ast	of				20200411 15:09:53
