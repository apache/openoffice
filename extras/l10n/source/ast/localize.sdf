helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148692				0	ast	\<ahelp hid=\"HID_FUNC_SUCHEN\"\>Returns the position of a text segment within a character string.\</ahelp\> You can set the start of the search as an option. The search text can be a number or any sequence of characters. The search is not case-sensitive.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152964				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154671				0	ast	SEARCH("FindText"; "Text"; Position)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146080	126			0	ast	            \<emph\>FindText\</emph\> is the text to be searched for.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154111	127			0	ast	            \<emph\>Text\</emph\> is the text where the search will take place.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149559	128			0	ast	            \<emph\>Position\</emph\> (optional) is the position in the text where the search is to start.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3147322				0	ast	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154564	130			0	ast	            \<item type=\"input\"\>=SEARCH(54;998877665544)\</item\> returns 10.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3154830				0	ast	\<bookmark_value\>SUBSTITUTE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3154830				0	ast	SUBSTITUTE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153698				0	ast	\<ahelp hid=\"HID_FUNC_WECHSELN\"\>Substitutes new text for old text in a string.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150994				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147582				0	ast	SUBSTITUTE("Text"; "SearchText"; "NewText"; Occurrence)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153675	178			0	ast	            \<emph\>Text\</emph\> is the text in which text segments are to be exchanged.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156155	179			0	ast	            \<emph\>SearchText \</emph\>is the text segment that is to be replaced (a number of times).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145779	180			0	ast	            \<emph\>NewText\</emph\> is the text that is to replace the text segment.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150348	181			0	ast	            \<emph\>Occurrence\</emph\> (optional) indicates which occurrence of the search text is to be replaced. If this parameter is missing the search text is replaced throughout.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150946				0	ast	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150412	183			0	ast	            \<item type=\"input\"\>=SUBSTITUTE("123123123";"3";"abc")\</item\> returns 12abc12abc12abc.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154915	238			0	ast	            \<item type=\"input\"\>=SUBSTITUTE("123123123";"3";"abc";2)\</item\> returns 12312abc123.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3148977				0	ast	\<bookmark_value\>T function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148977				0	ast	T				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154359				0	ast	\<ahelp hid=\"HID_FUNC_T\"\>This function returns the target text, or a blank text string if the target is not text.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155858				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155871				0	ast	T(Value)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154726				0	ast	If \<emph\>Value\</emph\> is a text string or refers to a text string, T returns that text string; otherwise it returns a blank text string.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155544				0	ast	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151062	146			0	ast	            \<item type=\"input\"\>=T(12345)\</item\> returns an empty string. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id4650105				0	ast	            \<item type=\"input\"\>=T("12345")\</item\> returns the string 12345.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3147132				0	ast	\<bookmark_value\>TEXT function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3147132				0	ast	TEXT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147213				0	ast	\<ahelp hid=\"HID_FUNC_TEXT\"\>Converts a number into text according to a given format.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153129				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147377				0	ast	TEXT(Number; Format)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147389	162			0	ast	            \<emph\>Number\</emph\> is the numerical value to be converted.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156167	163			0	ast	            \<emph\>Format\</emph\> is the text which defines the format. Use decimal and thousands separators according to the language set in the cell format.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id1243629				0	ast	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id9044770				0	ast	            \<item type=\"input\"\>=TEXT(12.34567;"###.##")\</item\> returns the text 12.35				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3674123				0	ast	            \<item type=\"input\"\>=TEXT(12.34567;"000.00")\</item\> returns the text 012.35				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3151039				0	ast	\<bookmark_value\>TRIM function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3151039				0	ast	TRIM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3157888				0	ast	\<ahelp hid=\"HID_FUNC_GLAETTEN\"\>Removes spaces from a string, leaving only a single space character between words.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152913				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151349				0	ast	TRIM("Text")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151362	58			0	ast	            \<emph\>Text\</emph\> refers to text in which spaces are removed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146838				0	ast	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156074	60			0	ast	            \<item type=\"input\"\>=TRIM("hello")\</item\> returns hello.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id0907200904030935				0	ast	\<bookmark_value\>UNICHAR function\</bookmark_value\>				20200411 15:09:53
