helpcontent2	source\text\sbasic\shared\03030104.xhp	0	help	hd_id3153127				0	ast	\<link href=\"text/sbasic/shared/03030104.xhp\" name=\"Month Function [Runtime]\"\>Month Function [Runtime]\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030104.xhp	0	help	par_id3148550				0	ast	Returns the month of a year from a serial date that is generated by the DateSerial or the DateValue function.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030104.xhp	0	help	hd_id3145068				0	ast	Syntax:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030104.xhp	0	help	par_id3150398				0	ast	Month (Number)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030104.xhp	0	help	hd_id3154366				0	ast	Return value:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030104.xhp	0	help	par_id3154125				0	ast	Integer				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030104.xhp	0	help	hd_id3150768				0	ast	Parameters:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030104.xhp	0	help	par_id3156423				0	ast	\<emph\>Number:\</emph\> Numeric expression that contains the serial date number that is used to determine the month of the year.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030104.xhp	0	help	par_id3153770	9			0	ast	This function is the opposite of the \<emph\>DateSerial \</emph\>function. It returns the month in the year that corresponds to the serial date that is generated by \<emph\>DateSerial\</emph\> or \<emph\>DateValue\</emph\>. For example, the expression				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030104.xhp	0	help	par_id3147426				0	ast	Print Month(DateSerial(1994, 12, 20))				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030104.xhp	0	help	par_id3145366				0	ast	returns the value 12.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030104.xhp	0	help	hd_id3146923				0	ast	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030104.xhp	0	help	par_id3156442				0	ast	Sub ExampleMonth				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030104.xhp	0	help	par_id3149664				0	ast	MsgBox "" & Month(Now) ,64,"The current month"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030104.xhp	0	help	par_id3150012				0	ast	End sub				20200411 15:09:53
