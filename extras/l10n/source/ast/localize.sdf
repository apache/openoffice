helpcontent2	source\text\shared\02\07090000.xhp	0	help	hd_id3146946				0	ast	\<link href=\"text/shared/02/07090000.xhp\" name=\"Export Directly as PDF\"\>Export Directly as PDF\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\02\07090000.xhp	0	help	par_id3085157				0	ast	\<ahelp hid=\".uno:ExportDirectToPDF\" visibility=\"visible\"\>Exports the current document directly as PDF. No settings dialog is shown.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\24090000.xhp	0	help	tit				0	ast	Transparency				20200411 15:09:53
helpcontent2	source\text\shared\02\24090000.xhp	0	help	hd_id3159411				0	ast	\<link href=\"text/shared/02/24090000.xhp\" name=\"Transparency\"\>Transparency\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\02\24090000.xhp	0	help	par_id3150445				0	ast	\<ahelp hid=\".uno:GrafTransparence\"\>Specifies the transparency in the graphic object.\</ahelp\> Values from 0% (fully opaque) to +100% (fully transparent) are possible.				20200411 15:09:53
helpcontent2	source\text\shared\02\24090000.xhp	0	help	par_id3154116				0	ast	\<image id=\"img_id3152372\" src=\"res/sc10869.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3152372\"\>Icon\</alt\>\</image\>				20200411 15:09:53
