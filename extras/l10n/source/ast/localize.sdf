helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1054D				0	ast	Grouping				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10551				0	ast	Grouping pivot tables displays the \<emph\>Grouping\</emph\> dialog for either values or dates.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10568				0	ast	Start				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1056C				0	ast	Specifies the start of the grouping.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1056F				0	ast	Automatically				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10573				0	ast	Specifies whether to start grouping at the smallest value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10576				0	ast	Manually at				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1057A				0	ast	Specifies whether to enter the start value for grouping yourself.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1057D				0	ast	End				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10581				0	ast	Specifies the end of the grouping.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10584				0	ast	Automatically				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10588				0	ast	Specifies whether to end grouping at the largest value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1058B				0	ast	Manually at				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1058F				0	ast	Specifies whether to enter the end value for grouping yourself.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10592				0	ast	Group by				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10596				0	ast	Specifies the value range by which every group's limits are calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN10599				0	ast	Number of days				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN1059D				0	ast	In the case of grouping date values, specifies the number of days to group by.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN105A0				0	ast	Intervals				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN105A4				0	ast	In the case of grouping date values, specifies the intervals to group by.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090400.xhp	0	help	par_idN105B2				0	ast	\<embedvar href=\"text/scalc/guide/datapilot_grouping.xhp#datapilot_grouping\"/\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	tit				0	ast	AutoOutline				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	hd_id3150275				0	ast	\<link href=\"text/scalc/01/12080500.xhp\" name=\"AutoOutline\"\>AutoOutline\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3145069				0	ast	\<ahelp hid=\".uno:AutoOutline\"\>If the selected cell range contains formulas or references, $[officename] automatically outlines the selection.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3148798				0	ast	For example, consider the following table:				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3154123				0	ast	January				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3154011				0	ast	February				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3152460				0	ast	March				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3146119				0	ast	1st Quarter				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3155854				0	ast	April				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3148575				0	ast	May				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3145271				0	ast	June				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3145648				0	ast	2nd Quarter				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3153876				0	ast	100				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3145251				0	ast	120				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3149400				0	ast	130				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3150328				0	ast	350				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3155443				0	ast	100				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3153713				0	ast	100				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3156385				0	ast	200				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3145230				0	ast	400				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3147363				0	ast	The cells for the 1st and 2nd quarters each contain a sum formula for the three cells to their left. If you apply the \<emph\>AutoOutline\</emph\> command, the table is grouped into two quarters.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3146918				0	ast	To remove the outline, select the table, and then choose \<link href=\"text/scalc/01/12080600.xhp\" name=\"Data - Group and Outline - Remove\"\>Data - Group and Outline - Remove\</link\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	tit				0	ast	DATEVALUE 				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	bm_id3145621				0	ast	\<bookmark_value\>DATEVALUE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	hd_id3145621				0	ast	\<variable id=\"datevalue\"\>\<link href=\"text/scalc/01/func_datevalue.xhp\"\>DATEVALUE\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	par_id3145087				0	ast	\<ahelp hid=\"HID_FUNC_DATWERT\"\>Returns the internal date number for text in quotes.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	par_id3149281				0	ast	The internal date number is returned as a number. The number is determined by the date system that is used by $[officename] to calculate dates.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	par_id0119200903491982				0	ast	If the text string also includes a time value, DATEVALUE only returns the integer part of the conversion.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	hd_id3156294				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	par_id3149268				0	ast	DATEVALUE("Text")				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	par_id3154819	23			0	ast	         \<emph\>Text\</emph\> is a valid date expression and must be entered with quotation marks.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	hd_id3156309				0	ast	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_datevalue.xhp	0	help	par_id3155841	25			0	ast	         \<emph\>=DATEVALUE("1954-07-20")\</emph\> yields 19925.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	tit				0	ast	Protecting Sheet				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	hd_id3153087				0	ast	Protecting Sheet				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3148664				0	ast	\<variable id=\"tabelletext\"\>\<ahelp hid=\".uno:Protect\"\>Protects the cells in the current sheet from being modified.\</ahelp\>\</variable\> Choose \<emph\>Tools - Protect Document - Sheet\</emph\> to open the \<emph\>Protect Sheet\</emph\> dialog in which you then specify sheet protection with or without a password.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3149664				0	ast	To protect cells from further editing, the \<emph\>Protected\</emph\> check box must be checked on the \<link href=\"text/scalc/01/05020600.xhp\" name=\"Format - Cells - Cell Protection\"\>\<emph\>Format - Cells - Cell Protection\</emph\>\</link\> tab page or on the \<emph\>Format Cells\</emph\> context menu.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3154490	8			0	ast	Unprotected cells or cell ranges can be set up on a protected sheet by using the \<emph\>Tools - Protect Document - Sheet\</emph\> and \<emph\>Format - Cells - Cell Protection\</emph\> menus: 				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3149123				0	ast	Select the cells that will be unprotected				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3150329				0	ast	Select \<emph\>Format - Cells - Cell Protection\</emph\>. Unmark the \<emph\>Protected\</emph\> box and click \<emph\>OK\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3156384				0	ast	On the \<emph\>Tools - Protect Document - Sheet\</emph\> menu, activate protection for the sheet. Effective immediately, only the cell range you selected in step 1 can be edited.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3149566	9			0	ast	To later change an unprotected area to a protected area, select the range. Next, on the \<emph\>Format - Cells - Cell Protection\</emph\> tab page, check the \<emph\>Protected\</emph\> box. Finally, choose the \<emph\>Tools - Protect Document - Sheet \</emph\>menu. The previously editable range is now protected.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3153964				0	ast	Sheet protection also affects the context menu of the sheet tabs at the bottom of the screen. The \<emph\>Delete\</emph\> and \<emph\>Rename\</emph\> commands cannot be selected.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3150301				0	ast	If a sheet is protected, you will not be able to modify or delete any Cell Styles.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3154656				0	ast	A protected sheet or cell range can no longer be modified until this protection is disabled. To disable the protection, choose the \<emph\>Tools - Protect Document - Sheet\</emph\> command. If no password was set, the sheet protection is immediately disabled. If the sheet was password protected, the \<emph\>Remove Protection\</emph\> dialog opens, where you must enter the password.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3149815				0	ast	Once saved, protected sheets can only be saved again by using the \<emph\>File - Save As\</emph\> command.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	hd_id3150206				0	ast	Password (optional)				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3152990				0	ast	\<ahelp hid=\".uno:Protect\"\>Allows you to enter a password to protect the sheet from unauthorized changes.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3148700				0	ast	Complete protection of your work can be achieved by combining both options on the \<emph\>Tools - Protect Document\</emph\> menu, including password protection. To prohibit opening the document altogether, in the \<emph\>Save\</emph\> dialog mark the \<emph\>Save with password\</emph\> box before you click the \<emph\>Save\</emph\> button.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06030800.xhp	0	help	tit				0	ast	Mark Invalid Data				20200411 15:09:53
helpcontent2	source\text\scalc\01\06030800.xhp	0	help	bm_id3153821				0	ast	\<bookmark_value\>cells; invalid data\</bookmark_value\>\<bookmark_value\>data; showing invalid data\</bookmark_value\>\<bookmark_value\>invalid data;marking\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06030800.xhp	0	help	hd_id3153821				0	ast	\<link href=\"text/scalc/01/06030800.xhp\" name=\"Mark Invalid Data\"\>Mark Invalid Data\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06030800.xhp	0	help	par_id3147264				0	ast	\<ahelp hid=\".uno:ShowInvalid\" visibility=\"visible\"\>Marks all cells in the sheet that contain values outside the validation rules.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06030800.xhp	0	help	par_id3151211				0	ast	The \<link href=\"text/scalc/01/12120000.xhp\" name=\"validity rules\"\>validity rules\</link\> restrict the input of numbers, dates, time values and text to certain values. However, it is possible to enter invalid values or copy invalid values into the cells if the \<emph\>Stop\</emph\> option is not selected. When you assign a validity rule, existing values in a cell will not be modified.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	tit				0	ast	EASTERSUNDAY				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	bm_id3152960				0	ast	\<bookmark_value\>EASTERSUNDAY function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	hd_id3152960				0	ast	\<variable id=\"eastersunday\"\>\<link href=\"text/scalc/01/func_eastersunday.xhp\"\>EASTERSUNDAY\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3154570				0	ast	\<ahelp hid=\"HID_FUNC_OSTERSONNTAG\"\>Returns the date of Easter Sunday for the entered year.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	hd_id9460127				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id2113711				0	ast	EASTERSUNDAY(Year)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3938413				0	ast	\<emph\>Year\</emph\> is an integer between 1583 and 9956 or 0 and 99. You can also calculate other holidays by simple addition with this date.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3156156				0	ast	Easter Monday = EASTERSUNDAY(Year) + 1				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3147521				0	ast	Good Friday = EASTERSUNDAY(Year) - 2				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3146072				0	ast	Pentecost Sunday = EASTERSUNDAY(Year) + 49				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3149553				0	ast	Pentecost Monday = EASTERSUNDAY(Year) + 50				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	hd_id3155120				0	ast	Examples				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3154472				0	ast	=EASTERSUNDAY(2000) returns 2000-04-23.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3150940				0	ast	EASTERSUNDAY(2000)+49 returns the internal serial number 36688. The result is 2000-06-11. Format the serial date number as a date, for example in the format YYYY-MM-DD.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	tit				0	ast	Error Alert				20200411 15:09:53
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3153821				0	ast	\<link href=\"text/scalc/01/12120300.xhp\" name=\"Error Alert\"\>Error Alert\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3153379				0	ast	\<ahelp hid=\"SC:TABPAGE:TP_VALIDATION_ERROR\"\>Define the error message that is displayed when invalid data is entered in a cell.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3154138				0	ast	You can also start a macro with an error message. A sample macro is provided at the end of this page.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3156280				0	ast	Show error message when invalid values are entered.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3150768				0	ast	\<ahelp hid=\".\"\>Displays the error message that you enter in the \<emph\>Contents\</emph\> area when invalid data is entered in a cell.\</ahelp\> If enabled, the message is displayed to prevent an invalid entry.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3146984	5			0	ast	In both cases, if you select "Stop", the invalid entry is deleted and the previous value is reentered in the cell. The same applies if you close the "Warning" and "Information" dialogs by clicking the \<emph\>Cancel \</emph\>button. If you close the dialogs with the \<emph\>OK\</emph\> button, the invalid entry is not deleted.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3152460				0	ast	Contents				20200411 15:09:53
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3148646				0	ast	Action				20200411 15:09:53
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3151115				0	ast	\<ahelp hid=\"SC:LISTBOX:TP_VALIDATION_ERROR:LB_ACTION\"\>Select the action that you want to occur when invalid data is entered in a cell.\</ahelp\> The "Stop" action rejects the invalid entry and displays a dialog that you have to close by clicking \<emph\>OK\</emph\>. The "Warning" and "Information" actions display a dialog that can be closed by clicking \<emph\>OK\</emph\> or \<emph\>Cancel\</emph\>. The invalid entry is only rejected when you click \<emph\>Cancel\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3156441				0	ast	Browse				20200411 15:09:53
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3153160				0	ast	\<ahelp hid=\"SC:PUSHBUTTON:TP_VALIDATION_ERROR:BTN_SEARCH\"\>Opens the \<link href=\"text/shared/01/06130000.xhp\" name=\"Macro\"\>Macro\</link\> dialog where you can select the macro that is executed when invalid data is entered in a cell. The macro is executed after the error message is displayed.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3153876				0	ast	Title				20200411 15:09:53
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3149410				0	ast	\<ahelp hid=\"SC:EDIT:TP_VALIDATION_ERROR:EDT_TITLE\"\>Enter the title of the macro or the error message that you want to display when invalid data is entered in a cell.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3154510				0	ast	Error message				20200411 15:09:53
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3149122				0	ast	\<ahelp hid=\"SC:MULTILINEEDIT:TP_VALIDATION_ERROR:EDT_ERROR\"\>Enter the message that you want to display when invalid data is entered in a cell.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3150752				0	ast	\<emph\>Sample macro:\</emph\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	tit				0	ast	Statistical Functions Part Five				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3147072				0	ast	\<variable id=\"rz\"\>\<link href=\"text/scalc/01/04060185.xhp\" name=\"Statistical Functions Part Five\"\>Statistical Functions Part Five\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3155071				0	ast	\<bookmark_value\>RANK function\</bookmark_value\>         \<bookmark_value\>numbers;determining ranks\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3155071				0	ast	RANK				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153976				0	ast	\<ahelp hid=\"HID_FUNC_RANG\"\>Returns the rank of a number in a sample.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3159206				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153250				0	ast	RANK(Value; Data; Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154543	6			0	ast	            \<emph\>Value\</emph\> is the value, whose rank is to be determined.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149130	7			0	ast	            \<emph\>Data\</emph\> is the array or range of data in the sample.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150215	8			0	ast	            \<emph\>Type\</emph\> (optional) is the sequence order.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id9305398				0	ast	Type = 0 means descending from the last item of the array to the first (this is the default), 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id9996948				0	ast	Type = 1 means ascending from the first item of the range to the last.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3143223				0	ast	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3155919	10			0	ast	            \<item type=\"input\"\>=RANK(A10;A1:A50)\</item\> returns the ranking of the value in A10 in value range A1:A50. If \<item type=\"literal\"\>Value\</item\> does not exist within the range an error message is displayed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3153556				0	ast	\<bookmark_value\>SKEW function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3153556				0	ast	SKEW				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153485				0	ast	\<ahelp hid=\"HID_FUNC_SCHIEFE\"\>Returns the skewness of a distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3154733				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3151191				0	ast	SKEW(Number1; Number2; ...Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3155757	16			0	ast	            \<emph\>Number1, Number2...Number30\</emph\> are numerical values or ranges.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3153297				0	ast	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3145118	18			0	ast	            \<item type=\"input\"\>=SKEW(A1:A50)\</item\> calculates the value of skew for the data referenced.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3149051				0	ast	\<bookmark_value\>regression lines;FORECAST function\</bookmark_value\>         \<bookmark_value\>extrapolations\</bookmark_value\>         \<bookmark_value\>FORECAST function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3149051				0	ast	FORECAST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153290				0	ast	\<ahelp hid=\"HID_FUNC_SCHAETZER\"\>Extrapolates future values based on existing x and y values.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3151343				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3147404				0	ast	FORECAST(Value; DataY; DataX)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3148743	24			0	ast	            \<emph\>Value\</emph\> is the x value, for which the y value on the linear regression is to be returned.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3146325	25			0	ast	            \<emph\>DataY\</emph\> is the array or range of known y's.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150536	26			0	ast	            \<emph\>DataX\</emph\> is the array or range of known x's.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3147416				0	ast	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3157874	28			0	ast	            \<item type=\"input\"\>=FORECAST(50;A1:A50;B1;B50)\</item\> returns the Y value expected for the X value of 50 if the X and Y values in both references are linked by a linear trend.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3149143				0	ast	\<bookmark_value\>STDEV function\</bookmark_value\>         \<bookmark_value\>standard deviations in statistics;based on a sample\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3149143				0	ast	STDEV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3146888				0	ast	\<ahelp hid=\"HID_FUNC_STABW\"\>Estimates the standard deviation based on a sample.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3146815				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149946	33			0	ast	STDEV(Number1; Number2; ...Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3157904	34			0	ast	            \<emph\>Number1, Number2, ... Number30\</emph\> are numerical values or ranges representing a sample based on an entire population.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3150650				0	ast	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149434	36			0	ast	            \<item type=\"input\"\>=STDEV(A1:A50)\</item\> returns the estimated standard deviation based on the data referenced.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3144745				0	ast	\<bookmark_value\>STDEVA function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3144745				0	ast	STDEVA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3151234				0	ast	\<ahelp hid=\"HID_FUNC_STABWA\"\>Calculates the standard deviation of an estimation based on a sample.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3148884				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3147422				0	ast	STDEVA(Value1;Value2;...Value30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154547	190			0	ast	            \<emph\>Value1, Value2, ...Value30\</emph\> are values or ranges representing a sample derived from an entire population. Text has the value 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3155829				0	ast	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3148581	192			0	ast	            \<item type=\"input\"\>=STDEVA(A1:A50)\</item\> returns the estimated standard deviation based on the data referenced.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3149734				0	ast	\<bookmark_value\>STDEVP function\</bookmark_value\>         \<bookmark_value\>standard deviations in statistics;based on a population\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3149734				0	ast	STDEVP				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149187				0	ast	\<ahelp hid=\"HID_FUNC_STABWN\"\>Calculates the standard deviation based on the entire population.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3154387				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154392				0	ast	STDEVP(Number1;Number2;...Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3155261	42			0	ast	            \<emph\>Number 1,Number 2,...Number 30\</emph\> are numerical values or ranges representing a sample based on an entire population.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3145591				0	ast	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153933	44			0	ast	            \<item type=\"input\"\>=STDEVP(A1:A50)\</item\> returns a standard deviation of the data referenced.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3154522				0	ast	\<bookmark_value\>STDEVPA function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3154522				0	ast	STDEVPA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149549				0	ast	\<ahelp hid=\"HID_FUNC_STABWNA\"\>Calculates the standard deviation based on the entire population.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3155950				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3146851				0	ast	STDEVPA(Value1;Value2;...Value30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153109	198			0	ast	            \<emph\>Value1,value2,...value30\</emph\> are values or ranges representing a sample derived from an entire population. Text has the value 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3154506				0	ast	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3145163	200			0	ast	            \<item type=\"input\"\>=STDEVPA(A1:A50)\</item\> returns the standard deviation of the data referenced.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3155928				0	ast	\<bookmark_value\>STANDARDIZE function\</bookmark_value\>         \<bookmark_value\>converting;random variables, into normalized values\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3155928				0	ast	STANDARDIZE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149883				0	ast	\<ahelp hid=\"HID_FUNC_STANDARDISIERUNG\"\>Converts a random variable to a normalized value.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3154330				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150132				0	ast	STANDARDIZE(Number; Mean; StDev)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3159139	50			0	ast	            \<emph\>Number\</emph\> is the value to be standardized.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3145241	51			0	ast	            \<emph\>Mean\</emph\> is the arithmetic mean of the distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3148874	52			0	ast	            \<emph\>StDev\</emph\> is the standard deviation of the distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3145351				0	ast	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3156067	54			0	ast	            \<item type=\"input\"\>=STANDARDIZE(11;10;1)\</item\> returns 1. The value 11 in a normal distribution with a mean of 10 and a standard deviation of 1 is as much above the mean of 10, as the value 1 is above the mean of the standard normal distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3157986				0	ast	\<bookmark_value\>NORMSINV function\</bookmark_value\>         \<bookmark_value\>normal distribution;inverse of standard\</bookmark_value\>				20200411 15:09:53
