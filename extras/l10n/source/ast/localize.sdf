helpcontent2	source\text\sbasic\shared\03030101.xhp	0	help	par_id3154791				0	ast	Dim sDate as String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030101.xhp	0	help	par_id3155415				0	ast	lDate = DateSerial(1964, 4, 9)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030101.xhp	0	help	par_id3147125				0	ast	sDate = DateSerial(1964, 4, 9)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030101.xhp	0	help	par_id3154942				0	ast	msgbox lDate REM returns 23476				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030101.xhp	0	help	par_id3151074				0	ast	msgbox sDate REM returns 04/09/1964				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030101.xhp	0	help	par_id3153878				0	ast	end sub				20200411 15:09:53
