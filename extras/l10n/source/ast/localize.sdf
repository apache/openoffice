helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	bm_id3143268				0	ast	\<bookmark_value\>Mid function\</bookmark_value\>\<bookmark_value\>Mid statement\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	hd_id3143268				0	ast	\<link href=\"text/sbasic/shared/03120306.xhp\" name=\"Mid Function, Mid Statement [Runtime]\"\>Mid Function, Mid Statement [Runtime]\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3148473				0	ast	Returns the specified portion of a string expression (\<emph\>Mid function\</emph\>), or replaces the portion of a string expression with another string (\<emph\>Mid statement\</emph\>).				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	hd_id3154285				0	ast	Syntax:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3147530				0	ast	Mid (Text As String, Start As Long [, Length As Long]) or Mid (Text As String, Start As Long , Length As Long, Text As String)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	hd_id3145068				0	ast	Return value:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3149295				0	ast	String (only by Function)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	hd_id3154347				0	ast	Parameters:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3148664				0	ast	\<emph\>Text:\</emph\> Any string expression that you want to modify.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3150359	9			0	ast	\<emph\>Start: \</emph\>Numeric expression that indicates the character position within the string where the string portion that you want to replace or to return begins. The maximum allowed value is 65535.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3148451				0	ast	\<emph\>Length:\</emph\> Numeric expression that returns the number of characters that you want to replace or return. The maximum allowed value is 65535.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3125864				0	ast	If the Length parameter in the \<emph\>Mid function\</emph\> is omitted, all characters in the string expression from the start position to the end of the string are returned.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3144762				0	ast	If the Length parameter in the \<emph\>Mid statement\</emph\> is less than the length of the text that you want to replace, the text is reduced to the specified length.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3150769				0	ast	\<emph\>Text:\</emph\> The string to replace the string expression (\<emph\>Mid statement\</emph\>).				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	hd_id3149560				0	ast	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3150439				0	ast	Sub ExampleUSDate				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3147349				0	ast	Dim sInput As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3155854				0	ast	Dim sUS_date As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3153189				0	ast	sInput = InputBox("Please input a date in the international format 'YYYY-MM-DD'")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3148645				0	ast	sUS_date = Mid(sInput, 6, 2)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3153952				0	ast	sUS_date = sUS_date & "/"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3153364				0	ast	sUS_date = sUS_date & Right(sInput, 2)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3146975				0	ast	sUS_date = sUS_date & "/"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3149665				0	ast	sUS_date = sUS_date & Left(sInput, 4)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3150011				0	ast	MsgBox sUS_date				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3148618				0	ast	End Sub				20200411 15:09:53
