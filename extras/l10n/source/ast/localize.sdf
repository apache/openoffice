helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	par_id3154319				0	ast	=B6*0,15				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	hd_id3145750				0	ast	Steps				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	par_id3152576				0	ast	\<ahelp hid=\"SC:NUMERICFIELD:RID_SCPAGE_CALC:ED_STEPS\"\>Sets the maximum number of iteration steps.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	hd_id3153728				0	ast	Minimum Change				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	par_id3153139				0	ast	\<ahelp hid=\"SC:EDIT:RID_SCPAGE_CALC:ED_EPS\"\>Specifies the difference between two consecutive iteration step results. If the result of the iteration is lower than the minimum change value, then the iteration will stop.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	hd_id3147125				0	ast	Date				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	par_id3155416				0	ast	Select the start date for the internal conversion from days to numbers.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	hd_id3147396				0	ast	12/30/1899 (default)				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	par_id3145646				0	ast	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCPAGE_CALC:BTN_DATESTD\"\>Sets 12/30/1899 as day zero.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	hd_id3156283				0	ast	01/01/1900 (StarCalc 1.0)				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	par_id3154018				0	ast	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCPAGE_CALC:BTN_DATESC10\"\>Sets 1/1/1900 as day zero. Use this setting for StarCalc 1.0 spreadsheets containing date entries.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	hd_id3156181				0	ast	01/01/1904				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	par_id3153948				0	ast	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCPAGE_CALC:BTN_DATE1904\"\>Sets 1/1/1904 as day zero. Use this setting for spreadsheets that are imported in a foreign format.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	hd_id3153838				0	ast	Case sensitive				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	par_id3146793				0	ast	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_CALC:BTN_CASE\"\>Specifies whether to distinguish between upper and lower case in texts when comparing cell contents.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	par_id3153707	28			0	ast	         \<emph\>Example:\</emph\> Type the text 'Test' in cell A1; and the text 'test' in B1. Then type the formula "=A1=B1" in cell C1. If the \<emph\>Case sensitive\</emph\> box is marked, FALSE will appear in the cell; otherwise, TRUE will appear in the cell.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	par_id3153965				0	ast	The EXACT text function is always case-sensitive, independent of the settings in this dialog.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	hd_id3145231				0	ast	Decimal places				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	par_id3149568				0	ast	\<ahelp hid=\"SC:NUMERICFIELD:RID_SCPAGE_CALC:ED_PREC\"\>Defines the number of decimals to be displayed for numbers with the \<emph\>Standard\</emph\> number format. The numbers are displayed as rounded numbers, but are not saved as rounded numbers.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	hd_id3145150				0	ast	Precision as shown				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	par_id3150644				0	ast	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_CALC:BTN_CALC\"\>Specifies whether to make calculations using the rounded values displayed in the sheet. Charts will be shown with the displayed values. If the \<emph\>Precision as shown\</emph\> option is not marked, the displayed numbers are rounded, but they are calculated internally using the non-rounded number.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	hd_id3152581				0	ast	Search criteria = and <> must apply to whole cells				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	par_id3149211				0	ast	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_CALC:BTN_MATCH\"\>Specifies that the search criteria you set for the Calc database functions must match the whole cell exactly. When the \<emph\>Search criteria = and <> must apply to whole cells\</emph\> box is marked, $[officename] Calc behaves exactly as MS Excel when searching cells in the database functions.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	par_id3148422				0	ast	.* in following position:				20200411 15:09:53
