helpcontent2	source\text\schart\01\wiz_chart_elements.xhp	0	help	par_id2871791				0	ast	\<ahelp hid=\".\" visibility=\"hidden\"\>Enter a label for the z-axis. This option is only available for three-dimensional charts.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\wiz_chart_elements.xhp	0	help	par_id7333597				0	ast	\<ahelp hid=\".\" visibility=\"hidden\"\>Displays a legend in your chart.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\wiz_chart_elements.xhp	0	help	par_id9976195				0	ast	\<ahelp hid=\".\" visibility=\"hidden\"\>Positions the legend to the left of the chart.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\wiz_chart_elements.xhp	0	help	par_id2507400				0	ast	\<ahelp hid=\".\" visibility=\"hidden\"\>Positions the legend to the top of the chart.\</ahelp\>				20200411 15:09:53
