helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151132	120			0	ast	            \<item type=\"input\"\>=RIGHT("Sun";2)\</item\> returns un.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3153534				0	ast	\<bookmark_value\>ROMAN function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153534				0	ast	ROMAN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151256				0	ast	\<ahelp hid=\"HID_FUNC_ROEMISCH\"\>Converts a number into a Roman numeral. The value range must be between 0 and 3999, the modes can be integers from 0 to 4.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149299				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150593				0	ast	ROMAN(Number; Mode)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156139	252			0	ast	            \<emph\>Number\</emph\> is the number that is to be converted into a Roman numeral.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153318	253			0	ast	            \<emph\>Mode\</emph\> (optional) indicates the degree of simplification. The higher the value, the greater is the simplification of the Roman number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3145306				0	ast	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151371	255			0	ast	            \<item type=\"input\"\>=ROMAN(999)\</item\> returns CMXCIX				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153938	256			0	ast	            \<item type=\"input\"\>=ROMAN(999;0)\</item\> returns CMXCIX				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148412	257			0	ast	            \<item type=\"input\"\>=ROMAN (999;1)\</item\> returns LMVLIV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155421	258			0	ast	            \<item type=\"input\"\>=ROMAN(999;2)\</item\> returns XMIX				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149235	259			0	ast	            \<item type=\"input\"\>=ROMAN(999;3)\</item\> returns VMIV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150624	260			0	ast	            \<item type=\"input\"\>=ROMAN(999;4)\</item\> returns IM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3151005				0	ast	\<bookmark_value\>SEARCH function\</bookmark_value\>				20200411 15:09:53
