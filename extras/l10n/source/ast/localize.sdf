helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	par_id3154012				0	ast	MsgBox "The color " & lVar & " consists of:" & Chr(13) &_				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	par_id3148645				0	ast	"red= " & Red(lVar) & Chr(13)&_				20200411 15:09:53
