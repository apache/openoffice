helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3153694				0	ast	N				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150405				0	ast	\<ahelp hid=\"HID_FUNC_N\"\>Returns the numeric value of the given parameter. Returns 0 if parameter is text, FALSE or #NA.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id9115573				0	ast	If an error occurs, other than #NA, the function returns the error value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3145774				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153883				0	ast	N(Value)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151101				0	ast	\<emph\>Value\</emph\> is the parameter to be converted into a number. N() returns the numeric value if it can. It returns the logical values TRUE and FALSE as 1 and 0 respectively. It returns text and errors as 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3147097				0	ast	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154117				0	ast	\<item type=\"input\"\>=N(123)\</item\> returns 123				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id2337717				0	ast	\<item type=\"input\"\>=N(TRUE)\</item\> returns 1				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153781				0	ast	\<item type=\"input\"\>=N(FALSE)\</item\> returns 0				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154670				0	ast	\<item type=\"input\"\>=N("abc")\</item\> returns 0				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3519089				0	ast	=N(1/0) returns #DIV/0!				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3156275				0	ast	\<bookmark_value\>NA function\</bookmark_value\>\<bookmark_value\>#N/A error;assigning to a cell\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3156275				0	ast	NA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156161				0	ast	\<ahelp hid=\"HID_FUNC_NV\"\>Returns the error value #N/A.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3147532				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149563				0	ast	NA()				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3155128				0	ast	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154481				0	ast	\<item type=\"input\"\>=NA()\</item\> converts the contents of the cell into #N/A.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3151255				0	ast	\<bookmark_value\>TYPE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3151255				0	ast	TYPE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155900				0	ast	\<ahelp hid=\"HID_FUNC_TYP\"\>Returns the type of value, where 1 = number, 2 = text, 4 = Boolean value, 8 = formula, 16 = error value, 64 = array.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3149992				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3148400				0	ast	TYPE(Value)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150830				0	ast	\<emph\>Value\</emph\> is a specific value for which the data type is determined.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3154363				0	ast	Example (see example table above)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153357				0	ast	\<item type=\"input\"\>=TYPE(C2)\</item\> returns 2 as a result.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3148980				0	ast	\<item type=\"input\"\>=TYPE(D9)\</item\> returns 1 as a result.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3155509				0	ast	\<bookmark_value\>CELL function\</bookmark_value\>\<bookmark_value\>cell information\</bookmark_value\>\<bookmark_value\>information on cells\</bookmark_value\>				20200411 15:09:53
