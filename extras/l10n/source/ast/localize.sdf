helpcontent2	source\text\sbasic\shared\03120403.xhp	0	help	par_id3153061				0	ast	\<emph\>Text1:\</emph\> Any string expression				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120403.xhp	0	help	par_id3147560				0	ast	\<emph\>Text2:\</emph\> Any string expression				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120403.xhp	0	help	par_id3146796				0	ast	\<emph\>Compare:\</emph\> This optional parameter sets the comparison method. If Compare = 1, the string comparison is case-sensitive. If Compare = 0, no distinction is made between uppercase and lowercase letters.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120403.xhp	0	help	hd_id3154940				0	ast	Return value				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120403.xhp	0	help	par_id3150358				0	ast	If Text1 < Text2 the function returns -1				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120403.xhp	0	help	par_id3151043				0	ast	If Text1 = Text2 the function returns 0				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120403.xhp	0	help	par_id3158410				0	ast	If Text1 > Text2 the function returns 1				20200411 15:09:53
