helpcontent2	source\text\sbasic\shared\03010300.xhp	0	help	par_id3155555				0	ast	This section describes Runtime functions used to define colors.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120100.xhp	0	help	tit				0	ast	ASCII/ANSI Conversion in Strings				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120100.xhp	0	help	hd_id3147443				0	ast	\<link href=\"text/sbasic/shared/03120100.xhp\" name=\"ASCII/ANSI Conversion in Strings\"\>ASCII/ANSI Conversion in Strings\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120100.xhp	0	help	par_id3159201				0	ast	The following functions convert strings to and from ASCII or ANSI code.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	tit				0	ast	Dim Statement [Runtime]				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	bm_id3149812				0	ast	\<bookmark_value\>Dim statement\</bookmark_value\>\<bookmark_value\>arrays; dimensioning\</bookmark_value\>\<bookmark_value\>dimensioning arrays\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	hd_id3149812				0	ast	\<link href=\"text/sbasic/shared/03102100.xhp\" name=\"Dim Statement [Runtime]\"\>Dim Statement [Runtime]\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3143271				0	ast	Declares a variable or an array.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3154686				0	ast	If the variables are separated by commas (for example, DIM sPar1, sPar2, sPar3 AS STRING), only Variant variables can be defined. Use a separate definition line for each variable.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3156422				0	ast	DIM sPar1 AS STRING				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3159252				0	ast	DIM sPar2 AS STRING				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3153142				0	ast	DIM sPar3 AS STRING				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3152576				0	ast	Dim declares local variables within subroutines. Global variables are declared with the PUBLIC or the PRIVATE statement.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	hd_id3156443				0	ast	Syntax:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3149412				0	ast	[ReDim]Dim VarName [(start To end)] [As VarType][, VarName2 [(start To end)] [As VarType][,...]]				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	hd_id3147397				0	ast	Parameters:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3154730				0	ast	\<emph\>VarName:\</emph\> Any variable or array name.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3147125				0	ast	\<emph\>Start, End:\</emph\> Numerical values or constants that define the number of elements (NumberElements=(end-start)+1) and the index range.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3153877				0	ast	Start and End can be numerical expressions if ReDim is applied at the procedure level.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3153510				0	ast	\<emph\>VarType:\</emph\> Key word that declares the data type of a variable.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3154015				0	ast	\<emph\>Keyword:\</emph\> Variable type				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3153949				0	ast	\<emph\>Bool:\</emph\> Boolean variable (True, False)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3156275				0	ast	\<emph\>Currency:\</emph\> Currency-Variable (Currency with 4 Decimal places)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3156057				0	ast	\<emph\>Date:\</emph\> Date variable				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3148405				0	ast	\<emph\>Double:\</emph\> Double-precision floating-point variable (1,79769313486232 x 10E308 - 4,94065645841247 x 10E-324)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3148916				0	ast	\<emph\>Integer:\</emph\> Integer variable (-32768 - 32767)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3150045				0	ast	\<emph\>Long:\</emph\> Long integer variable (-2.147.483.648 - 2.147.483.647)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3149255				0	ast	\<emph\>Object:\</emph\> Object variable (Note: this variable can only subsequently be defined with Set!)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3155937				0	ast	\<emph\>Single:\</emph\> Single-precision floating-point variable (3,402823 x 10E38 - 1,401298 x 10E-45).				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3151251				0	ast	\<emph\>String:\</emph\> String variable consisting of a maximum of 64,000 ASCII characters.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3154704				0	ast	\<emph\>[Variant]:\</emph\> Variant variable type (contains all types, specified by definition). If a key word is not specified, variables are automatically defined as Variant Type, unless a statement from DefBool to DefVar is used.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3146316				0	ast	In $[officename] Basic, you do not need to declare variables explicitly. However, you need to declare an array before you can use them. You can declare a variable with the Dim statement, using commas to separate multiple declarations. To declare a variable type, enter a type-declaration character following the name or use a corresponding key word.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3149924				0	ast	$[officename] Basic supports single or multi-dimensional arrays that are defined by a specified variable type. Arrays are suitable if the program contains lists or tables that you want to edit. The advantage of arrays is that it is possible to address individual elements according to indexes, which can be formulated as numeric expressions or variables.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3148488				0	ast	Arrays are declared with the Dim statement. There are two methods to define the index range:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3154662				0	ast	DIM text(20) as String REM 21 elements numbered from 0 to 20				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3155604				0	ast	DIM text(5 to 25) as String REM 21 elements numbered from 5 to 25				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3151274				0	ast	DIM text(-15 to 5) as String REM 21 elements (including 0)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3152774				0	ast	REM numbered from -15 to 5				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3150829				0	ast	Two-dimensional data field				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3149529				0	ast	DIM text(20,2) as String REM 63 elements; form 0 to 20 level 1, from 0 to 20 level 2 and from 0 to 20 level 3.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3159239				0	ast	You can declare an array types as dynamic if a ReDim statement defines the number of dimensions in the subroutine or the function that contains the array. Generally, you can only define an array dimension once, and you cannot modify it. Within a subroutine, you can declare an array with ReDim. You can only define dimensions with numeric expressions. This ensures that the fields are only as large as necessary.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	hd_id3150344				0	ast	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3150206				0	ast	Sub ExampleDim1				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3154201				0	ast	Dim sVar As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3146134				0	ast	Dim iVar As Integer				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3154657				0	ast	sVar = "Office"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3148459				0	ast	End Sub				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3166424				0	ast	Sub ExampleDim2				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3149036				0	ast	REM Two-dimensional data field				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3149737				0	ast	Dim stext(20,2) as String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3153782				0	ast	Const sDim as String = " Dimension:"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3150518				0	ast	for i = 0 to 20				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3166428				0	ast	for ii = 0 to 2				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3152994				0	ast	stext(i,ii) = str(i) & sDim & str(ii)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3150202				0	ast	next ii				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3154370				0	ast	next i				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3156166				0	ast	for i = 0 to 20				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3148815				0	ast	for ii = 0 to 2				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3146981				0	ast	msgbox stext(i,ii)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3155125				0	ast	next ii				20200411 15:09:53
