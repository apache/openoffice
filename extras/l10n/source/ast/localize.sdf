helpcontent2	source\text\sbasic\shared\03020204.xhp	0	help	par_id3154022				0	ast	Get #iNumber,2,sText				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020204.xhp	0	help	par_id3150940				0	ast	Put #iNumber,,"This is new text"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020204.xhp	0	help	par_id3146132				0	ast	Get #iNumber,1,sText				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020204.xhp	0	help	par_id3154198				0	ast	Get #iNumber,2,sText				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020204.xhp	0	help	par_id3159102				0	ast	Put #iNumber,20,"This is the text in record 20"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020204.xhp	0	help	par_id3153785				0	ast	Print Lof(#iNumber)				20200411 15:09:53
