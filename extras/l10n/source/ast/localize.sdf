helpcontent2	source\text\shared\01\02050000.xhp	0	help	par_id3154682				0	ast	\<ahelp hid=\".uno:Copy\"\>Copies the selection to the clipboard.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02050000.xhp	0	help	par_id3155552				0	ast	Each time you copy, the existing content of the clipboard is overwritten.				20200411 15:09:53
helpcontent2	source\text\shared\01\02050000.xhp	0	help	par_id3154824				0	ast	\<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>\<variable id=\"unixkopieren\"\>$[officename] also supports the clipboard under Unix; however, you must use the $[officename] commands, such as Ctrl+C.\</variable\>\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	tit				0	ast	Position				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	hd_id3150467				0	ast	\<link href=\"text/shared/01/06050600.xhp\" name=\"Position\"\>Position\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	par_id3158397				0	ast	Sets the indent, spacing, and alignment options for the numbered or bulleted list.				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	par_id5004119				0	ast	The Position tab page looks different for documents using the new position and spacing attributes introduced with OpenOffice.org 3.0, or documents using the old attributes from versions before 3.0. The new version of this tab page shows the controls "Numbering followed by", "Numbering alignment", "Aligned at", and "Indent at". The old version of this tab page that can be seen in an old numbered or bulleted list shows the controls "Indent", "Width of numbering", "Minimum space numbering <-> text", and "Numbering alignment".				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	hd_id3149031				0	ast	Level				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	par_id3155755				0	ast	\<ahelp hid=\"SW:MULTILISTBOX:TP_NUM_POSITION:LB_LEVEL\"\>Select the level(s) that you want to modify.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	hd_id6561784				0	ast	Numbering followed by				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	par_id423291				0	ast	\<ahelp hid=\".\"\>Select the element that will follow the numbering: a tab stop, a space, or nothing.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	hd_id7809686				0	ast	at				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	par_id8177434				0	ast	\<ahelp hid=\".\"\>If you select a tab stop to follow the numbering, you can enter a non-negative value as the tab stop position.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	hd_id3155583				0	ast	Numbering alignment				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	par_id3153063				0	ast	\<ahelp hid=\"SW:LISTBOX:TP_NUM_POSITION:LB_ALIGN\"\>Set the alignment of the numbering symbols. Select "Left" to align the numbering symbol to start directly at the "Aligned at" position. Select "Right" to align the symbol to end directly before the "Aligned at" position. Select "Centered" to center the symbol around the "Aligned at" position.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	par_id3147422				0	ast	The \<emph\>Numbering alignment\</emph\> option does not set the alignment of the paragraph.				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	hd_id1619617				0	ast	Aligned at				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	par_id1015655				0	ast	\<ahelp hid=\".\"\>Enter the distance from the left page margin at which the numbering symbol will be aligned.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	hd_id2336191				0	ast	Indent at				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	par_id6081728				0	ast	\<ahelp hid=\".\"\>Enter the distance from the left page margin to the start of all lines in the numbered paragraph that follow the first line.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	hd_id3154422				0	ast	Indent				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	par_id3144438				0	ast	\<ahelp hid=\"SW:METRICFIELD:TP_NUM_POSITION:MF_BORDERDIST\"\>Enter the amount of space to leave between the left page margin (or the left edge of the text object) and the left edge of the numbering symbol. If the current paragraph style uses an indent, the amount you enter here is added to the indent.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	hd_id3155179				0	ast	Relative				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	par_id3146137				0	ast	\<ahelp hid=\"SW:CHECKBOX:TP_NUM_POSITION:CB_RELATIVE\"\>Indents the current level relative to the previous level in the list hierarchy.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	hd_id3150245				0	ast	Width of numbering				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	par_id3150129				0	ast	\<ahelp hid=\"SW:METRICFIELD:TP_NUM_POSITION:MF_INDENT\"\>Enter the amount of space to leave between the left edge of the numbering symbol and the left edge of the text.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	hd_id3156194				0	ast	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Minimum space numbering <-> text\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	par_id3147574				0	ast	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<ahelp hid=\"SW:METRICFIELD:TP_NUM_POSITION:MF_NUMDIST\"\>Enter the minimum amount of space to leave between the right edge of the numbering symbol and the left edge of the text.\</ahelp\>\</caseinline\>\</switchinline\>				20200411 15:09:53
