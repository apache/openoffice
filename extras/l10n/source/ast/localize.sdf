helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153196				0	ast	\<ahelp hid=\"HID_FUNC_ZELLE\"\>Returns information on address, formatting or contents of a cell.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3149323				0	ast	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3147355				0	ast	CELL("InfoType"; Reference)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154716				0	ast	\<emph\>InfoType\</emph\> is the character string that specifies the type of information. The character string is always in English. Upper or lower case is optional.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150636				0	ast	InfoType				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149344				0	ast	Meaning				20200411 15:09:53
