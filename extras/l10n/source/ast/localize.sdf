helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903061174				0	ast	Information units "bit" and "byte" may also be prefixed by one of the following IEC 60027-2 / IEEE 1541 prefixes:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903090966				0	ast	ki kibi 1024				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903090958				0	ast	Mi mebi 1048576				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903090936				0	ast	Gi gibi 1073741824				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903090975				0	ast	Ti tebi 1099511627776				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903090930				0	ast	Pi pebi 1125899906842620				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903091070				0	ast	Ei exbi 1152921504606850000				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903091097				0	ast	Zi zebi 1180591620717410000000				20200411 15:09:53
