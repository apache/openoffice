helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	par_id3151278				0	ast	Finds win and win95, but not os2win or upwind				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	par_id3155506				0	ast	.*win				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	par_id3150886				0	ast	Finds win and os2win, but not win95 or upwind				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01060500.xhp	0	help	par_id3147167				0	ast	.*win.*				20200411 15:09:53
