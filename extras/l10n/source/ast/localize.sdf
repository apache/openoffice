helpcontent2	source\text\shared\01\05210500.xhp	0	help	hd_id3150275				0	ast	Add				20200411 15:09:53
helpcontent2	source\text\shared\01\05210500.xhp	0	help	par_id3154306	10			0	ast	\<ahelp hid=\"SVX:PUSHBUTTON:RID_SVXPAGE_BITMAP:BTN_ADD\"\>Adds a bitmap that you created in the \<emph\>Pattern Editor \</emph\>to the current list.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05210500.xhp	0	help	hd_id3158432				0	ast	Modify				20200411 15:09:53
helpcontent2	source\text\shared\01\05210500.xhp	0	help	par_id3153827				0	ast	\<ahelp hid=\"SVX:PUSHBUTTON:RID_SVXPAGE_BITMAP:BTN_MODIFY\"\>Replaces a bitmap that you created in the \<emph\>Pattern Editor\</emph\> with the current bitmap pattern. If you want, you can save the pattern under a different name.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05210500.xhp	0	help	hd_id3149516				0	ast	Import				20200411 15:09:53
helpcontent2	source\text\shared\01\05210500.xhp	0	help	par_id3148473				0	ast	\<ahelp hid=\"SVX:PUSHBUTTON:RID_SVXPAGE_BITMAP:BTN_IMPORT\"\>Locate the bitmap that you want to import, and then click \<emph\>Open\</emph\>. The bitmap is added to the end of the list of available bitmaps.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05210500.xhp	0	help	hd_id3159166				0	ast	Load Bitmap List				20200411 15:09:53
