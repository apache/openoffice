helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	hd_id3153896				0	ast	\<link href=\"text/sbasic/shared/03080103.xhp\" name=\"Sin Function [Runtime]\"\>Sin Function [Runtime]\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3149456				0	ast	Returns the sine of an angle. The angle is specified in radians. The result lies between -1 and 1.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3153379				0	ast	Using the angle Alpha, the Sin Function returns the ratio of the length of the opposite side of an angle to the length of the hypotenuse in a right-angled triangle.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3148798				0	ast	Sin(Alpha) = side opposite the angle/hypotenuse				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	hd_id3147230				0	ast	Syntax:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3154909				0	ast	Sin (Number)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	hd_id3156214				0	ast	Return value:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3150870				0	ast	Double				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	hd_id3155132				0	ast	Parameters:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3145786				0	ast	\<emph\>Number:\</emph\> Numeric expression that defines the angle in radians that you want to calculate the sine for.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3155413				0	ast	To convert degrees to radians, multiply degrees by Pi/180, and to convert radians to degrees, multiply radians by 180/Pi.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3149664				0	ast	grad=(radiant*180)/pi				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3153143				0	ast	radiant=(grad*pi)/180				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3151112				0	ast	Pi is approximately 3.141593.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	hd_id3163712				0	ast	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3149482				0	ast	REM In this example, the following entry is possible for a right-angled triangle:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3148577				0	ast	REM The side opposite the angle and the angle (in degrees) to calculate the length of the hypotenuse:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3152941				0	ast	Sub ExampleSine				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3150011				0	ast	REM Pi = 3.1415926 is a predefined variable				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3153159				0	ast	Dim d1 as Double				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3154491				0	ast	Dim dAlpha as Double				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3145251				0	ast	d1 = InputBox$ ("Enter the length of the opposite side: ","Opposite Side")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3148456				0	ast	dAlpha = InputBox$ ("Enter the angle Alpha (in degrees): ","Alpha")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3153877				0	ast	Print "The length of the hypotenuse is"; (d1 / sin (dAlpha * Pi / 180))				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3150717				0	ast	End Sub				20200411 15:09:53
