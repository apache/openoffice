helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159083	39			0	ast	                     \<item type=\"input\"\>Salvage Value\</item\>                  				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150002	40			0	ast	                     \<item type=\"input\"\>Useful Life\</item\>                  				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153006	41			0	ast	                     \<item type=\"input\"\>Time Period\</item\>                  				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154505	42			0	ast	                     \<item type=\"input\"\>Deprec. SYD\</item\>                  				20200411 15:09:53
