helpcontent2	source\text\scalc\01\06030800.xhp	0	help	hd_id3153821				0	eo	\<link href=\"text/scalc/01/06030800.xhp\" name=\"Mark Invalid Data\"\>Marki nevalidajn datumojn\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\06030800.xhp	0	help	par_id3147264				0	eo	\<ahelp hid=\".uno:ShowInvalid\" visibility=\"visible\"\>Markas nevalidajn datumojn en la folio kiuj enhavas valorojn ekster la validigaj reguloj.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\06030800.xhp	0	help	par_id3151211				0	eo	La \<link href=\"text/scalc/01/12120000.xhp\" name=\"validity rules\"\>validigaj reguloj\</link\> limigas la enigon de numeroj, datoj, horaj valoroj kaj teksto al specifaj valoroj. Tamen, eblas enigi nevalidajn valorojn aŭ kopii nevalidajn valorojn en la ĉelojn se la eblo \<emph\>Haltigi\</emph\> ne estas elektita. Kiam vi agordas validigan regulon, ekzistantaj valoroj en ĉelo ne ŝanĝiĝas.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\06030800.xhp	0	help	tit				0	eo	Marki nevalidajn datumojn				2002-02-02 02:02:02
