helpcontent2	source\text\scalc\01\02110000.xhp	0	help	par_id3150051				0	eo	\<ahelp hid=\"HID_SC_NAVIPI_ZOOM\"\>Ebligas al vi kaŝi/malkaŝi la enhavon.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02110000.xhp	0	help	par_id3150086				0	eo	\<ahelp hid=\"HID_SC_NAVIPI_UP\"\>Movas al ĉelo ĉe la komenco de la aktuala amplekso, kiun vi povas emfazi per la butono \<emph\>Datuma Amplekso\</emph\>.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02110000.xhp	0	help	par_id3150656				0	eo	Ŝovreĝimo				2002-02-02 02:02:02
