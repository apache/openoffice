helpcontent2	source\text\swriter\01\04010000.xhp	0	help	hd_id3148566				0	eo	Kolumnosalto				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04010000.xhp	0	help	hd_id3149175				0	eo	Stilo				2002-02-02 02:02:02
