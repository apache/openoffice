helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3151384				0	eo	\<ahelp hid=\"HID_SCPAGE_TABLE\"\>Agordas la elementojn enmeti en la presaĵo de ĉiuj folioj kun la aktuala Paĝa Stilo. Plue, vi povas agordi la presan ordon, la unuan paĝan nombron, kaj la paĝan skalon.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3152899				0	eo	\<ahelp hid=\"SC_METRICFIELD_RID_SCPAGE_TABLE_ED_SCALEALL\" visibility=\"hidden\"\>Enigu skaligan faktoron. Faktoroj malpli ol 100 malpligrandigas la paĝojn; pli altaj faktoroj pligrandigas la paĝojn.\</ahelp\>				2002-02-02 02:02:02
