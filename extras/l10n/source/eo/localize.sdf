helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3155707				0	eo	\<item type=\"input\"\>10,96\</item\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3155730				0	eo	\<item type=\"input\"\>9,35\</item\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3155799				0	eo	16				2002-02-02 02:02:02
