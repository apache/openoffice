helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3145251				0	ca-XR	d1 = InputBox$ ("Enter the length of the opposite side: ","Opposite Side")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3148456				0	ca-XR	dAlpha = InputBox$ ("Enter the angle Alpha (in degrees): ","Alpha")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3153877				0	ca-XR	Print "The length of the hypotenuse is"; (d1 / sin (dAlpha * Pi / 180))				20200411 15:09:53
