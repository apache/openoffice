helpcontent2	source\text\sbasic\shared\03060600.xhp	0	help	par_id3152462				0	ca-XR	vA = 10: vB = 8: vC = 6: vD = Null				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03060600.xhp	0	help	par_id3156442				0	ca-XR	vOut = vA > vB Xor vB > vC REM returns 0				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03060600.xhp	0	help	par_id3153191				0	ca-XR	vOut = vB > vA Xor vB > vC REM returns -1				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03060600.xhp	0	help	par_id3153144				0	ca-XR	vOut = vA > vB Xor vB > vD REM returns -1				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03060600.xhp	0	help	par_id3154944				0	ca-XR	vOut = (vB > vD Xor vB > vA) REM returns 0				20200411 15:09:53
