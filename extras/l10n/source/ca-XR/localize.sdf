helpcontent2	source\text\shared\01\online_update_dialog.xhp	0	help	par_id8277230				0	ca-XR	\<ahelp hid=\".\" visibility=\"hidden\"\>Installs the downloaded update.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update_dialog.xhp	0	help	par_id4086428				0	ca-XR	\<ahelp hid=\".\" visibility=\"hidden\"\>Pauses the download. Later click Resume to continue downloading.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update_dialog.xhp	0	help	par_id9024628				0	ca-XR	\<ahelp hid=\".\" visibility=\"hidden\"\>Continues a paused download.\</ahelp\>				20200411 15:09:53
