helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3144748				0	ca-XR	\<item type=\"input\"\>=COVAR(A1:A30;B1:B30)\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3147472				0	ca-XR	\<bookmark_value\>CRITBINOM function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3147472				0	ca-XR	CRITBINOM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149254				0	ca-XR	\<ahelp hid=\"HID_FUNC_KRITBINOM\"\>Returns the smallest value for which the cumulative binomial distribution is less than or equal to a criterion value.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3153930				0	ca-XR	Syntax				20200411 15:09:53
