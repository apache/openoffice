helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3147072				0	ca-XR	\<variable id=\"rz\"\>\<link href=\"text/scalc/01/04060185.xhp\" name=\"Statistical Functions Part Five\"\>Statistical Functions Part Five\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3155071				0	ca-XR	\<bookmark_value\>RANK function\</bookmark_value\>         \<bookmark_value\>numbers;determining ranks\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3155071				0	ca-XR	RANK				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153976				0	ca-XR	\<ahelp hid=\"HID_FUNC_RANG\"\>Returns the rank of a number in a sample.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3159206				0	ca-XR	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153250				0	ca-XR	RANK(Value; Data; Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154543	6			0	ca-XR	            \<emph\>Value\</emph\> is the value, whose rank is to be determined.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149130	7			0	ca-XR	            \<emph\>Data\</emph\> is the array or range of data in the sample.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150215	8			0	ca-XR	            \<emph\>Type\</emph\> (optional) is the sequence order.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id9305398				0	ca-XR	Type = 0 means descending from the last item of the array to the first (this is the default), 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id9996948				0	ca-XR	Type = 1 means ascending from the first item of the range to the last.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3143223				0	ca-XR	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3155919	10			0	ca-XR	            \<item type=\"input\"\>=RANK(A10;A1:A50)\</item\> returns the ranking of the value in A10 in value range A1:A50. If \<item type=\"literal\"\>Value\</item\> does not exist within the range an error message is displayed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3153556				0	ca-XR	\<bookmark_value\>SKEW function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3153556				0	ca-XR	SKEW				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153485				0	ca-XR	\<ahelp hid=\"HID_FUNC_SCHIEFE\"\>Returns the skewness of a distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3154733				0	ca-XR	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3151191				0	ca-XR	SKEW(Number1; Number2; ...Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3155757	16			0	ca-XR	            \<emph\>Number1, Number2...Number30\</emph\> are numerical values or ranges.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3153297				0	ca-XR	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3145118	18			0	ca-XR	            \<item type=\"input\"\>=SKEW(A1:A50)\</item\> calculates the value of skew for the data referenced.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3149051				0	ca-XR	\<bookmark_value\>regression lines;FORECAST function\</bookmark_value\>         \<bookmark_value\>extrapolations\</bookmark_value\>         \<bookmark_value\>FORECAST function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3149051				0	ca-XR	FORECAST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153290				0	ca-XR	\<ahelp hid=\"HID_FUNC_SCHAETZER\"\>Extrapolates future values based on existing x and y values.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3151343				0	ca-XR	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3147404				0	ca-XR	FORECAST(Value; DataY; DataX)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3148743	24			0	ca-XR	            \<emph\>Value\</emph\> is the x value, for which the y value on the linear regression is to be returned.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3146325	25			0	ca-XR	            \<emph\>DataY\</emph\> is the array or range of known y's.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150536	26			0	ca-XR	            \<emph\>DataX\</emph\> is the array or range of known x's.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3147416				0	ca-XR	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3157874	28			0	ca-XR	            \<item type=\"input\"\>=FORECAST(50;A1:A50;B1;B50)\</item\> returns the Y value expected for the X value of 50 if the X and Y values in both references are linked by a linear trend.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3149143				0	ca-XR	\<bookmark_value\>STDEV function\</bookmark_value\>         \<bookmark_value\>standard deviations in statistics;based on a sample\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3149143				0	ca-XR	STDEV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3146888				0	ca-XR	\<ahelp hid=\"HID_FUNC_STABW\"\>Estimates the standard deviation based on a sample.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3146815				0	ca-XR	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149946	33			0	ca-XR	STDEV(Number1; Number2; ...Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3157904	34			0	ca-XR	            \<emph\>Number1, Number2, ... Number30\</emph\> are numerical values or ranges representing a sample based on an entire population.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3150650				0	ca-XR	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149434	36			0	ca-XR	            \<item type=\"input\"\>=STDEV(A1:A50)\</item\> returns the estimated standard deviation based on the data referenced.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3144745				0	ca-XR	\<bookmark_value\>STDEVA function\</bookmark_value\>				20200411 15:09:53
