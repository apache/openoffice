helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN105A3				0	ca-XR	Unlock %PRODUCTNAME				20200411 15:09:53
helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN105A7				0	ca-XR	\<ahelp hid=\".\"\>Enter your serial number or copy and paste the number from the online web page.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN105B6				0	ca-XR	License Agreement				20200411 15:09:53
helpcontent2	source\text\shared\autopi\purchase.xhp	0	help	par_idN105BA				0	ca-XR	\<ahelp hid=\".\"\>Please read the license text (scroll down the text accordingly), then accept the license to continue unlocking. If you do not accept the license, the software will not be unlocked.\</ahelp\>				20200411 15:09:53
