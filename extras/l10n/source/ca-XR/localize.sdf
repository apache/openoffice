helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151349				0	ca-XR	TRIM("Text")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151362	58			0	ca-XR	            \<emph\>Text\</emph\> refers to text in which spaces are removed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146838				0	ca-XR	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156074	60			0	ca-XR	            \<item type=\"input\"\>=TRIM("hello")\</item\> returns hello.				20200411 15:09:53
