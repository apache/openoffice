helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id2801599				0	ca-XR	\<ahelp hid=\".\"\>Enter a name for the hyperlink.\</ahelp\> $[officename] inserts a NAME tag in the hyperlink.				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	tit				0	ca-XR	Comparison Operators				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	bm_id3148983				0	ca-XR	\<bookmark_value\>comparisons;operators in standard filter dialog\</bookmark_value\>      \<bookmark_value\>operators;standard filters\</bookmark_value\>      \<bookmark_value\>standard filters;comparison operators\</bookmark_value\>      \<bookmark_value\>filters; comparison operators\</bookmark_value\>      \<bookmark_value\>equal sign, see also operators\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	hd_id3148983				0	ca-XR	Comparison Operators				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3155364				0	ca-XR	The following comparative operators can be set under \<item type=\"menuitem\"\>Condition\</item\> in the \<item type=\"menuitem\"\>Standard Filter\</item\> dialog.				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3145313	3			0	ca-XR	                  \<emph\>Comparative operator\</emph\>               				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3147089	4			0	ca-XR	                  \<emph\>Effect\</emph\>               				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3147209				0	ca-XR	Equal (=)				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3146797				0	ca-XR	Shows values equal to the condition.				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3143271				0	ca-XR	Less than (<)				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3153761				0	ca-XR	Shows values less than the condition.				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3146807				0	ca-XR	Greater than (>)				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3154852				0	ca-XR	Shows values greater than the condition.				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3155342				0	ca-XR	Less than or equal to (< =)				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3154381				0	ca-XR	Shows values that are less than or equal to the condition.				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3153823				0	ca-XR	Greater than or equal to (> =)				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3154143				0	ca-XR	Shows values that are greater than or equal to the condition.				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3154811				0	ca-XR	Not equal (< >)				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3148944				0	ca-XR	Shows the values not equal to the condition.				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3149669				0	ca-XR	Largest				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3159413				0	ca-XR	Shows the N (numeric value as parameter) largest values.				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3151054				0	ca-XR	Smallest				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3161657				0	ca-XR	Shows the N (numeric value as parameter) smallest values.				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3150400				0	ca-XR	Largest %				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3161645				0	ca-XR	Shows the largest N% (numeric value as parameter) of the total values.				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3149202				0	ca-XR	Smallest %				20200411 15:09:53
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3151176				0	ca-XR	Shows the smallest N% (numeric value as parameter) of the entire values.				20200411 15:09:53
