helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154508				0	ca-XR	KURT(Number1; Number2; ...Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145167				0	ca-XR	\<emph\>Number1,Number2,...Number30\</emph\> are numeric arguments or ranges representing a random sample of distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3158000				0	ca-XR	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150016				0	ca-XR	\<item type=\"input\"\>=KURT(A1;A2;A3;A4;A5;A6)\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3150928				0	ca-XR	\<bookmark_value\>LOGINV function\</bookmark_value\>\<bookmark_value\>inverse of lognormal distribution\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150928				0	ca-XR	LOGINV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145297				0	ca-XR	\<ahelp hid=\"HID_FUNC_LOGINV\"\>Returns the inverse of the lognormal distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3151016				0	ca-XR	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153049				0	ca-XR	LOGINV(Number; Mean; StDev)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3148390				0	ca-XR	\<emph\>Number\</emph\> is the probability value for which the inverse standard logarithmic distribution is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149538				0	ca-XR	\<emph\>Mean\</emph\> is the arithmetic mean of the standard logarithmic distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145355				0	ca-XR	\<emph\>StDev\</emph\> is the standard deviation of the standard logarithmic distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3148768				0	ca-XR	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155623				0	ca-XR	\<item type=\"input\"\>=LOGINV(0.05;0;1)\</item\> returns 0.19.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3158417				0	ca-XR	\<bookmark_value\>LOGNORMDIST function\</bookmark_value\>\<bookmark_value\>cumulative lognormal distribution\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3158417				0	ca-XR	LOGNORMDIST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154953				0	ca-XR	\<ahelp hid=\"HID_FUNC_LOGNORMVERT\"\>Returns the cumulative lognormal distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150474				0	ca-XR	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150686				0	ca-XR	LOGNORMDIST(Number; Mean; StDev; Cumulative)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154871				0	ca-XR	\<emph\>Number\</emph\> is the probability value for which the standard logarithmic distribution is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155820				0	ca-XR	\<emph\>Mean\</emph\> (optional) is the mean value of the standard logarithmic distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155991				0	ca-XR	\<emph\>StDev\</emph\> (optional) is the standard deviation of the standard logarithmic distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155992				0	ca-XR	\<emph\>Cumulative\</emph\> (optional) = 0 calculates the density function, Cumulative = 1 calculates the distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3153178				0	ca-XR	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149778				0	ca-XR	\<item type=\"input\"\>=LOGNORMDIST(0.1;0;1)\</item\> returns 0.01.				20200411 15:09:53
