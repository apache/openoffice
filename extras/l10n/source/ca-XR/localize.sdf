helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3153194				0	ca-XR	Dim sInput As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3154217				0	ca-XR	Dim sUS_date As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3150448				0	ca-XR	sInput = InputBox("Please input a date in the international format 'YYYY-MM-DD'")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3149203				0	ca-XR	sUS_date = Mid(sInput, 6, 2)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3150439				0	ca-XR	sUS_date = sUS_date & "/"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3153770				0	ca-XR	sUS_date = sUS_date & Right(sInput, 2)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3161833				0	ca-XR	sUS_date = sUS_date & "/"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3147215				0	ca-XR	sUS_date = sUS_date & Left(sInput, 4)				20200411 15:09:53
