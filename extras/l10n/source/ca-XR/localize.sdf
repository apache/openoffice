helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150837				0	ca-XR	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154344				0	ca-XR	RIGHT("Text"; Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149426	117			0	ca-XR	            \<emph\>Text\</emph\> is the text of which the right part is to be determined.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153350	118			0	ca-XR	            \<emph\>Number\</emph\> (optional) is the number of characters from the right part of the text.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148661				0	ca-XR	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151132	120			0	ca-XR	            \<item type=\"input\"\>=RIGHT("Sun";2)\</item\> returns un.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3153534				0	ca-XR	\<bookmark_value\>ROMAN function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153534				0	ca-XR	ROMAN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151256				0	ca-XR	\<ahelp hid=\"HID_FUNC_ROEMISCH\"\>Converts a number into a Roman numeral. The value range must be between 0 and 3999, the modes can be integers from 0 to 4.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149299				0	ca-XR	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150593				0	ca-XR	ROMAN(Number; Mode)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156139	252			0	ca-XR	            \<emph\>Number\</emph\> is the number that is to be converted into a Roman numeral.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153318	253			0	ca-XR	            \<emph\>Mode\</emph\> (optional) indicates the degree of simplification. The higher the value, the greater is the simplification of the Roman number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3145306				0	ca-XR	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151371	255			0	ca-XR	            \<item type=\"input\"\>=ROMAN(999)\</item\> returns CMXCIX				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153938	256			0	ca-XR	            \<item type=\"input\"\>=ROMAN(999;0)\</item\> returns CMXCIX				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148412	257			0	ca-XR	            \<item type=\"input\"\>=ROMAN (999;1)\</item\> returns LMVLIV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155421	258			0	ca-XR	            \<item type=\"input\"\>=ROMAN(999;2)\</item\> returns XMIX				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149235	259			0	ca-XR	            \<item type=\"input\"\>=ROMAN(999;3)\</item\> returns VMIV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150624	260			0	ca-XR	            \<item type=\"input\"\>=ROMAN(999;4)\</item\> returns IM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3151005				0	ca-XR	\<bookmark_value\>SEARCH function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3151005				0	ca-XR	SEARCH				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148692				0	ca-XR	\<ahelp hid=\"HID_FUNC_SUCHEN\"\>Returns the position of a text segment within a character string.\</ahelp\> You can set the start of the search as an option. The search text can be a number or any sequence of characters. The search is not case-sensitive.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152964				0	ca-XR	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154671				0	ca-XR	SEARCH("FindText"; "Text"; Position)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146080	126			0	ca-XR	            \<emph\>FindText\</emph\> is the text to be searched for.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154111	127			0	ca-XR	            \<emph\>Text\</emph\> is the text where the search will take place.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149559	128			0	ca-XR	            \<emph\>Position\</emph\> (optional) is the position in the text where the search is to start.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3147322				0	ca-XR	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154564	130			0	ca-XR	            \<item type=\"input\"\>=SEARCH(54;998877665544)\</item\> returns 10.				20200411 15:09:53
