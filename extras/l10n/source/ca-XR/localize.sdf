helpcontent2	source\text\shared\01\06150120.xhp	0	help	par_id3152552				0	ca-XR	\<ahelp hid=\"HID_XML_FILTER_EXPORT_XSLT\" visibility=\"visible\"\>If this is an export filter, enter the file name of the XSLT stylesheet that you want to use for exporting.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06150120.xhp	0	help	hd_id3149149				0	ca-XR	XSLT for import				20200411 15:09:53
