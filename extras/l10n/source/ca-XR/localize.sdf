helpcontent2	source\text\shared\02\09070100.xhp	0	help	hd_id3148663				0	ca-XR	Further settings				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	hd_id3153525				0	ca-XR	Frame				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id2052980				0	ca-XR	\<ahelp hid=\".\"\>Enter the name of the frame that you want the linked file to open in, or select a predefined frame from the list. If you leave this box blank, the linked file opens in the current browser window.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	hd_id3155101				0	ca-XR	Form				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id3149167				0	ca-XR	\<ahelp hid=\"SVX:LISTBOX:RID_SVXPAGE_HYPERLINK_NEWDOCUMENT:LB_FORM\"\>Specifies whether the hyperlink is inserted as text or as a button.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	hd_id3152920				0	ca-XR	Events				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id3144760				0	ca-XR	\<ahelp hid=\"SVX:IMAGEBUTTON:RID_SVXPAGE_HYPERLINK_NEWDOCUMENT:BTN_SCRIPT\"\>Opens the \<emph\>Assign Macro\</emph\> dialog, in which you can give events such as "mouse over object" or "trigger hyperlink" their own program codes.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	hd_id3151041				0	ca-XR	Text				20200411 15:09:53
