helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3159343				0	ca-XR	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155329	93			0	ca-XR	            \<item type=\"input\"\>=LOWER("Sun")\</item\> returns sun.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3154589				0	ca-XR	\<bookmark_value\>MID function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3154589				0	ca-XR	MID				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154938				0	ca-XR	\<ahelp hid=\"HID_FUNC_TEIL\"\>Returns a text string of a text. The parameters specify the starting position and the number of characters.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148829				0	ca-XR	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150526				0	ca-XR	MID("Text"; Start; Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148820	152			0	ca-XR	            \<emph\>Text\</emph\> is the text containing the characters to extract.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150774	153			0	ca-XR	            \<emph\>Start\</emph\> is the position of the first character in the text to extract.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153063	154			0	ca-XR	            \<emph\>Number\</emph\> specifies the number of characters in the part of the text.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150509				0	ca-XR	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3158407	156			0	ca-XR	            \<item type=\"input\"\>=MID("office";2;2)\</item\> returns ff.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3159143				0	ca-XR	\<bookmark_value\>PROPER function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3159143				0	ca-XR	PROPER				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149768				0	ca-XR	\<ahelp hid=\"HID_FUNC_GROSS2\"\>Capitalizes the first letter in all words of a text string.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153573				0	ca-XR	Syntax				20200411 15:09:53
