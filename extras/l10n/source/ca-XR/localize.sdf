helpcontent2	source\text\scalc\01\05040000.xhp	0	help	par_id3148946				0	ca-XR	\<ahelp hid=\".\"\>Sets the column width and hides or shows selected columns.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05040000.xhp	0	help	hd_id3150398				0	ca-XR	\<link href=\"text/shared/01/05340200.xhp\" name=\"Width\"\>Width\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05040000.xhp	0	help	hd_id3145171				0	ca-XR	\<link href=\"text/scalc/01/05040200.xhp\" name=\"Optimal Width\"\>Optimal Width\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040400.xhp	0	help	tit				0	ca-XR	Remove Filter				20200411 15:09:53
