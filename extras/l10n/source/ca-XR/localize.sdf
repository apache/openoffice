helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150147				0	ca-XR	\<ahelp hid=\"HID_FUNC_LAENGE\"\>Returns the length of a string including spaces.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155108				0	ca-XR	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154063				0	ca-XR	LEN("Text")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146894	108			0	ca-XR	            \<emph\>Text\</emph\> is the text whose length is to be determined.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153884				0	ca-XR	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156008	110			0	ca-XR	            \<item type=\"input\"\>=LEN("Good Afternoon")\</item\> returns 14.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154300	111			0	ca-XR	            \<item type=\"input\"\>=LEN(12345.67)\</item\> returns 8.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3153983				0	ca-XR	\<bookmark_value\>LOWER function\</bookmark_value\>				20200411 15:09:53
