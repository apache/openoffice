helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3159254				0	ca-XR	const b2=1.345e34				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3147287				0	ca-XR	dValue=Exp( Log(b1)+Log(b2) )				20200411 15:09:53
