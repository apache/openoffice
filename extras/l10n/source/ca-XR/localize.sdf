helpcontent2	source\text\scalc\01\func_days.xhp	0	help	tit				0	ca-XR	DAYS 				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	bm_id3151328				0	ca-XR	\<bookmark_value\>DAYS function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	hd_id3151328				0	ca-XR	\<variable id=\"days\"\>\<link href=\"text/scalc/01/func_days.xhp\"\>DAYS\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3155139				0	ca-XR	\<ahelp hid=\"HID_FUNC_TAGE\"\>Calculates the difference between two date values.\</ahelp\> The result returns the number of days between the two days.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	hd_id3155184				0	ca-XR	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3149578				0	ca-XR	DAYS(Date2; Date1)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3151376				0	ca-XR	\<emph\>Date1\</emph\> is the start date, \<emph\>Date2\</emph\> is the end date. If \<emph\>Date2\</emph\> is an earlier date than \<emph\>Date1\</emph\> the result is a negative number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	hd_id3151001				0	ca-XR	Examples				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3159101				0	ca-XR	=DAYS("2010-01-01"; NOW()) returns the number of days from today until January 1, 2010.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3163720				0	ca-XR	=DAYS("1990-10-10";"1980-10-10") returns 3652 days.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	tit				0	ca-XR	AutoFormat				20200411 15:09:53
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	hd_id3149666				0	ca-XR	\<variable id=\"autoformat\"\>\<link href=\"text/scalc/01/05110000.xhp\" name=\"AutoFormat\"\>AutoFormat\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	par_id3145367				0	ca-XR	\<variable id=\"autoformattext\"\>\<ahelp hid=\".\"\>Use this command to apply an AutoFormat to a selected sheet area or to define your own AutoFormats.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	hd_id3148455				0	ca-XR	Format				20200411 15:09:53
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	par_id3145799				0	ca-XR	\<ahelp hid=\"SC:LISTBOX:RID_SCDLG_AUTOFORMAT:LB_FORMAT\"\>Choose a predefined AutoFormat to apply to a selected area in your sheet.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	hd_id3149410				0	ca-XR	Add				20200411 15:09:53
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	par_id3154017				0	ca-XR	\<ahelp hid=\"SC:PUSHBUTTON:RID_SCDLG_AUTOFORMAT:BTN_ADD\"\>Allows you to add the current formatting of a range of at least 4 x 4 cells to the list of predefined AutoFormats.\</ahelp\> The \<link href=\"text/shared/01/05150101.xhp\" name=\"Add AutoFormat\"\>Add AutoFormat\</link\> dialog then appears.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	par_id3153708	29			0	ca-XR	\<ahelp hid=\"HID_SC_AUTOFMT_NAME\"\>Enter a name and click \<emph\>OK\</emph\>. \</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	hd_id3150044				0	ca-XR	More				20200411 15:09:53
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	par_id3146920				0	ca-XR	\<ahelp hid=\"SC:MOREBUTTON:RID_SCDLG_AUTOFORMAT:BTN_MORE\"\>Opens the \<emph\>Formatting\</emph\> section, which displays the formatting overrides that can be applied to the spreadsheet. Deselecting an option keeps the format of the current spreadsheet for that format type.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	hd_id3155961				0	ca-XR	Formatting				20200411 15:09:53
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	par_id3153965				0	ca-XR	In this section you can select or deselect the available formatting options. If you want to keep any of the settings currently in your spreadsheet, deselect the corresponding option.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	hd_id3154021				0	ca-XR	Number format				20200411 15:09:53
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	par_id3159239				0	ca-XR	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_AUTOFORMAT:BTN_NUMFORMAT\"\>When marked, specifies that you want to retain the number format of the selected format.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	hd_id3149530				0	ca-XR	Borders				20200411 15:09:53
