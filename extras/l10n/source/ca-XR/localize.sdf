helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	hd_id3159411				0	ca-XR	\<link href=\"text/shared/optionen/01013000.xhp\" name=\"Accessibility\"\>Accessibility\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	par_id3149827				0	ca-XR	\<ahelp hid=\".\"\>Sets options that make \<item type=\"productname\"\>%PRODUCTNAME\</item\> programs more accessible for users with reduced sight, limited dexterity or other disabilities.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	hd_id3166460				0	ca-XR	Miscellaneous options				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	par_id3152996				0	ca-XR	Sets accessibility options.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	hd_id3154750				0	ca-XR	\<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>\</caseinline\>\<defaultinline\>Support assistive technology tools (program restart required)\</defaultinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	par_id3155628				0	ca-XR	\<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>\</caseinline\>\<defaultinline\>\<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_ACCESSIBILITYCONFIG_CB_ACCESSIBILITY_TOOL\"\>Allows you to use assistive tools, such as external screen readers, Braille devices or speech recognition input devices. The Java Runtime Environment must be installed on your computer before you can enable assistive support.\</ahelp\>\</defaultinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	hd_id3154047				0	ca-XR	Use text selection cursor in read-only text document				20200411 15:09:53
