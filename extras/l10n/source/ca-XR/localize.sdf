helpcontent2	source\text\scalc\01\func_now.xhp	0	help	bm_id3150521				0	ca-XR	\<bookmark_value\>NOW function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	hd_id3150521				0	ca-XR	\<variable id=\"now\"\>\<link href=\"text/scalc/01/func_now.xhp\"\>NOW\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	par_id3148829				0	ca-XR	\<ahelp hid=\"HID_FUNC_JETZT\"\>Returns the computer system date and time.\</ahelp\> The value is updated when you recalculate the document or each time a cell value is modified.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	hd_id3146988				0	ca-XR	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	par_id3154897				0	ca-XR	NOW()				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	par_id4598529				0	ca-XR	NOW is a function without arguments.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	hd_id3154205				0	ca-XR	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	par_id3150774				0	ca-XR	\<item type=\"input\"\>=NOW()-A1\</item\> returns the difference between the date in A1 and now. Format the result as a number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	tit				0	ca-XR	TIMEVALUE 				20200411 15:09:53
