helpcontent2	source\text\shared\autopi\01110300.xhp	0	help	hd_id2298959				0	ca-XR	PNG - Portable Network Graphics format				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110300.xhp	0	help	par_id4653767				0	ca-XR	\<ahelp hid=\".\"\>The files are exported as PNG files. PNG files are compressed without loss of data, and can contain more than 256 colors.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110300.xhp	0	help	hd_id3147618				0	ca-XR	GIF - Graphics Interchange Format				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110300.xhp	0	help	par_id3154860				0	ca-XR	\<ahelp hid=\"SD:RADIOBUTTON:DLG_PUBLISHING:PAGE3_GIF\"\>The files are exported as GIF files. GIF files are compressed without loss of data, and have a maximum of 256 colors.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110300.xhp	0	help	hd_id3154306				0	ca-XR	JPG - Compressed file format				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110300.xhp	0	help	par_id3153665				0	ca-XR	\<ahelp hid=\"SD:RADIOBUTTON:DLG_PUBLISHING:PAGE3_JPG\"\>The files are exported as JPEG files. JPEG files are compressed, with adjustable compression and can contain more than 256 colors.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110300.xhp	0	help	hd_id3149763				0	ca-XR	Quality				20200411 15:09:53
