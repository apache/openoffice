helpcontent2	source\text\schart\01\wiz_chart_elements.xhp	0	help	par_id6437269				0	ca-XR	\<ahelp hid=\".\" visibility=\"hidden\"\>Enter a title for your chart.\</ahelp\>				20200411 15:09:53
