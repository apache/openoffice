helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3153626				0	ta	\<ahelp hid=\"HID_AAI_FUNC_HEX2DEC\"\>The result is the decimal number for the hexadecimal number entered.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3143233				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3149293				0	ta	HEX2DEC(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3159176				0	ta	\<emph\>Number\</emph\> is a hexadecimal number. The number can have a maximum of 10 places. The most significant bit is the sign bit, the following bits return the value. Negative numbers are entered as two's complement.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3154304				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3146093				0	ta	\<item type=\"input\"\>=HEX2DEC(64)\</item\> returns 100.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	bm_id3149750				0	ta	\<bookmark_value\>HEX2OCT function\</bookmark_value\>\<bookmark_value\>converting;hexadecimal numbers, into octal numbers\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3149750				0	ta	HEX2OCT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3153983				0	ta	\<ahelp hid=\"HID_AAI_FUNC_HEX2OCT\"\>The result is the octal number for the hexadecimal number entered.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3145660				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3151170				0	ta	HEX2OCT(Number; Places)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3152795				0	ta	\<emph\>Number\</emph\> is a hexadecimal number. The number can have a maximum of 10 places. The most significant bit is the sign bit, the following bits return the value. Negative numbers are entered as two's complement.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3149204				0	ta	\<emph\>Places\</emph\> is the number of places to be output.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3153901				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3159341				0	ta	\<item type=\"input\"\>=HEX2OCT(64;4)\</item\> returns 0144.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	tit				0	ta	Function Wizard				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	bm_id3147426				0	ta	\<bookmark_value\>inserting functions; Function Wizard\</bookmark_value\>\<bookmark_value\>functions;Function Wizard\</bookmark_value\>\<bookmark_value\>wizards; functions\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3147426				0	ta	\<link href=\"text/scalc/01/04060000.xhp\" name=\"AutoPilot: Functions\"\>Function Wizard\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3145271				0	ta	\<variable id=\"funktionsautopilottext\"\>\<ahelp hid=\".uno:FunctionDialog\"\>Opens the \<emph\>Function Wizard\</emph\>, which helps you to interactively create formulas.\</ahelp\>\</variable\> Before you start the Wizard, select a cell or a range of cells from the current sheet, in order to determine the position at which the formula will be inserted.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id8007446				0	ta	You can download the complete ODFF (OpenDocument Format Formula) specification from the \<link href=\"http://www.oasis-open.org/committees/documents.php?wg_abbrev=office-formula\"\>OASIS\</link\> web site.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3159153				0	ta	The \<emph\>Function Wizard\</emph\> has two tabs: \<emph\>Functions\</emph\> is used to create formulas, and \<emph\>Structure\</emph\> is used to check the formula build.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3154490				0	ta	Functions Tab				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3149378				0	ta	\<link href=\"text/scalc/01/04060100.xhp\" name=\"List of Categories and Functions\"\>List of Categories and Functions\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3154730				0	ta	Category				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3153417	37			0	ta	\<variable id=\"kategorienliste\"\>\<ahelp hid=\"SC:LISTBOX:RID_SCTAB_FUNCTION:LB_CATEGORY\"\>Lists all the categories to which the different functions are assigned. Select a category to view the appropriate functions in the list field below.\</ahelp\> Select "All" to view all functions in alphabetical order, irrespective of category. "Last Used" lists the functions you have most recently used. \</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3150749				0	ta	Function				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3155445				0	ta	\<ahelp hid=\"SC:LISTBOX:RID_SCTAB_FUNCTION:LB_FUNCTION\"\>Displays the functions found under the selected category. Double-click to select a function.\</ahelp\> A single-click displays a short function description.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3159264				0	ta	Array				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3149566	9			0	ta	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_FORMULA:BTN_MATRIX\"\>Specifies that the selected function is inserted into the selected cell range as an array formula. \</ahelp\> Array formulas operate on multiple cells. Each cell in the array contains the formula, not as a copy but as a common formula shared by all matrix cells.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3155959				0	ta	The \<emph\>Array\</emph\> option is identical to the \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+Shift+Enter command, which is used to enter and confirm formulas in the sheet. The formula is inserted as a matrix formula indicated by two braces { }.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3152993				0	ta	The maximum size of an array range is 128 by 128 cells.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3150367				0	ta	Argument Input Fields				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3145587				0	ta	When you double-click a function, the argument input field(s) appear on the right side of the dialog. To select a cell reference as an argument, click directly into the cell, or drag across the required range on the sheet while holding down the mouse button. You can also enter numerical and other values or references directly into the corresponding fields in the dialog. When using \<link href=\"text/scalc/01/04060102.xhp\" name=\"date entries\"\>date entries\</link\>, make sure you use the correct format. Click OK to insert the result into the spreadsheet.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3149408				0	ta	Function Result				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3155809				0	ta	As soon you enter arguments in the function, the result is calculated. This preview informs you if the calculation can be carried out with the arguments given. If the arguments result in an error, the corresponding \<link href=\"text/scalc/05/02140000.xhp\" name=\"error code\"\>error code\</link\> is displayed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3148700				0	ta	The required arguments are indicated by names in bold print.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3153064				0	ta	f(x) (depending on the selected function)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3157980				0	ta	\<ahelp hid=\"HID_SC_FAP_BTN_FX4\"\>Allows you to access a subordinate level of the \<emph\>Function Wizard\</emph\> in order to nest another function within the function, instead of a value or reference.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3145076				0	ta	Argument/Parameter/Cell Reference (depending on the selected function)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3159097				0	ta	\<ahelp hid=\"SC:EDIT:RID_SCDLG_FORMULA:ED_REF\"\>The number of visible text fields depends on the function. Enter arguments either directly into the argument fields or by clicking a cell in the table.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3154957				0	ta	Result				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3150211				0	ta	Displays the calculation result or an error message.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3151304				0	ta	Formula				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3149898				0	ta	\<ahelp hid=\"HID_SC_FAP_FORMULA\"\>Displays the created formula. Type your entries directly, or create the formula using the wizard.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3153249				0	ta	Back				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3152869				0	ta	\<ahelp hid=\"SC:PUSHBUTTON:RID_SCDLG_FORMULA:BTN_BACKWARD\"\>Moves the focus back through the formula components, marking them as it does so.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3146966				0	ta	To select a single function from a complex formula consisting of several functions, double-click the function in the formula window.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3155762				0	ta	Next				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3149316	55			0	ta	\<ahelp hid=\"SC:PUSHBUTTON:RID_SCDLG_FORMULA:BTN_FORWARD\"\>Moves forward through the formula components in the formula window.\</ahelp\> This button can also be used to assign functions to the formula. If you select a function and click the \<emph\>Next \</emph\>button, the selection appears in the formula window.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3159262				0	ta	Double-click a function in the selection window to transfer it to the formula window.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3148745				0	ta	Cancel				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3147402				0	ta	Closes the dialog without implementing the formula.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3150534				0	ta	OK				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3153029				0	ta	Ends the \<emph\>Function Wizard\</emph\>, and transfers the formula to the selected cells.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3156400				0	ta	\<link href=\"text/scalc/01/04060100.xhp\" name=\"List of Categories and Functions\"\>List of Categories and Functions\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3147610				0	ta	Structure tab				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3153122				0	ta	On this page, you can view the structure of the function.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3149350				0	ta	If you start the \<emph\>Function Wizard\</emph\> while the cell cursor is positioned in a cell that already contains a function, the \<emph\>Structure\</emph\> tab is opened and shows the composition of the current formula.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	hd_id3149014				0	ta	Structure				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3150481				0	ta	\<ahelp hid=\"HID_SC_FAP_STRUCT\"\>Displays a hierarchical representation of the current function.\</ahelp\> You can hide or show the arguments by a click on the plus or minus sign in front.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3148886				0	ta	Blue dots denote correctly entered arguments. Red dots indicate incorrect data types. For example: if the SUM function has one argument entered as text, this is highlighted in red as SUM only permits number entries.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	tit				0	ta	Sheet				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	bm_id3150542				0	ta	\<bookmark_value\>pages; order when printing\</bookmark_value\>\<bookmark_value\>printing; page order\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3156329				0	ta	\<link href=\"text/scalc/01/05070500.xhp\" name=\"Sheet\"\>Sheet\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3151384				0	ta	\<ahelp hid=\"HID_SCPAGE_TABLE\"\>Specifies the elements to be included in the printout of all sheets with the current Page Style. Additionally, you can set the print order, the first page number, and the page scale.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3150542				0	ta	Print				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3125863				0	ta	Defines which elements of the spreadsheet are to be printed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3151041				0	ta	Column and row headers				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3147228				0	ta	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_TABLE:BTN_HEADER\"\>Specifies whether you want the column and row headers to be printed.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3150439				0	ta	Grid				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3147436				0	ta	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_TABLE:BTN_GRID\"\>Prints out the borders of the individual cells as a grid.\</ahelp\> For the view on screen, make your choice under \<emph\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - %PRODUCTNAME Calc\</emph\> - \<link href=\"text/shared/optionen/01060100.xhp\" name=\"View\"\>\<emph\>View\</emph\>\</link\> - \<emph\>Grid lines\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3145750				0	ta	Comments				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3150010				0	ta	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_TABLE:BTN_NOTES\"\>Prints the comments defined in your spreadsheet.\</ahelp\> They will be printed on a separate page, along with the corresponding cell reference.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3154944				0	ta	Objects/graphics				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3149581				0	ta	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_TABLE:BTN_OBJECTS\"\>Includes all inserted objects (if printable) and graphics with the printed document.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3149377				0	ta	Charts				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3148455				0	ta	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_TABLE:BTN_CHARTS\"\>Prints the charts that have been inserted into your spreadsheet.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3153418				0	ta	Drawing Objects				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3149122				0	ta	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_TABLE:BTN_DRAWINGS\"\>Includes all drawing objects in the printed document.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3150330				0	ta	Formulas				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3153715				0	ta	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_TABLE:BTN_FORMULAS\"\>Prints the formulas contained in the cells, instead of the results.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3156385				0	ta	Zero Values				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3149258				0	ta	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_TABLE:BTN_NULLVALS\"\>Specifies that cells with a zero value are printed.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3154022				0	ta	Page Order				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3166423				0	ta	Defines the order in which data in a sheet is numbered and printed when it does not fit on one printed page.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3152580				0	ta	Top to bottom, then right				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3150205				0	ta	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCPAGE_TABLE:BTN_TOPDOWN\"\>Prints vertically from the left column to the bottom of the sheet.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3150786				0	ta	Left to right, then down				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3154657				0	ta	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCPAGE_TABLE:BTN_LEFTRIGHT\"\>Prints horizontally from the top row of the sheet to the right column.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3150887				0	ta	First page number				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3155378				0	ta	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_TABLE:BTN_PAGENO\"\>Select this option if you want the first page to start with a number other than 1.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3145389				0	ta	\<ahelp hid=\"SC:NUMERICFIELD:RID_SCPAGE_TABLE:ED_PAGENO\"\>Enter the number of the first page.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3146978				0	ta	Scale				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3149408				0	ta	Defines a page scale for the printed spreadsheet.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_idN1096D				0	ta	Scaling mode				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_idN10971				0	ta	\<ahelp hid=\"sc:ListBox:RID_SCPAGE_TABLE:LB_SCALEMODE\"\>Select a scaling mode from the list box. Appropriate controls will be shown at the side of the list box.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3155089				0	ta	Reduce/enlarge printout				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3159171				0	ta	Specifies a scaling factor to scale all printed pages.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_idN1099A				0	ta	Scaling factor				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3152899				0	ta	\<ahelp hid=\"SC_METRICFIELD_RID_SCPAGE_TABLE_ED_SCALEALL\" visibility=\"hidden\"\>Enter a scaling factor. Factors less than 100 reduce the pages, higher factors enlarge the pages.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_idN109B2				0	ta	Fit print range(s) to width/height				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_idN109B5				0	ta	Specifies the maximum number of pages horizontally (width) and vertically (height) on which every sheet with the current Page Style is to be printed. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_idN109BB				0	ta	The print ranges are always scaled proportionally, so the resulting number of pages may be less than specified.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_idN109BF				0	ta	You may clear one of the boxes, then the unspecified dimension will use as many pages as necessary.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_idN109C3				0	ta	If you clear both boxes, this will result in a scaling factor of 100%.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_idN109CE				0	ta	Width in pages				20200411 15:09:53
