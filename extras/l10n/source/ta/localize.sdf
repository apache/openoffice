helpcontent2	source\text\sbasic\shared\03080401.xhp	0	help	par_id3147288				0	ta	iVar = 36				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080401.xhp	0	help	par_id3159254				0	ta	Msgbox Sqr(iVar)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080401.xhp	0	help	par_id3161832				0	ta	end sub				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120312.xhp	0	help	tit				0	ta	ConvertToURL Function [Runtime]				20200411 15:09:53
