helpcontent2	source\text\shared\01\06010000.xhp	0	help	par_id3154123				0	ta	\<ahelp hid=\"SVX_PUSHBUTTON_RID_SVXDLG_SPELLCHECK_BTN_OPTIONS\"\>Ko izberete uporabniško določene slovarje, se odpre pogovorno okno, v katerem lahko nastavite pravila za pregledovanje črkovanja.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010000.xhp	0	help	hd_id3153353				0	ta	Dodaj				20200411 15:09:53
