helpcontent2	source\text\swriter\01\mm_newaddblo.xhp	0	help	tit				0	ta	New Address Block				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddblo.xhp	0	help	par_idN10542				0	ta	New Address Block				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddblo.xhp	0	help	par_idN10546				0	ta	Specify the placement of address data fields in an address block in \<link href=\"text/swriter/01/mm_seladdblo.xhp\"\>mail merge\</link\> documents.				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddblo.xhp	0	help	par_idN10569				0	ta	Address Elements				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddblo.xhp	0	help	par_idN1056D				0	ta	\<ahelp hid=\".\"\>Select an address field and drag the field to the other list.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddblo.xhp	0	help	par_idN10570				0	ta	>				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddblo.xhp	0	help	par_idN10574				0	ta	\<ahelp hid=\".\"\>Adds the selected field from the Address Elements list to the other list.\</ahelp\> You can add the same field more than once.				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddblo.xhp	0	help	par_idN10577				0	ta	<				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddblo.xhp	0	help	par_idN1057B				0	ta	\<ahelp hid=\".\"\>Removes the selected field from the other list.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddblo.xhp	0	help	par_idN1057E				0	ta	Drag address element to the field below				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddblo.xhp	0	help	par_idN10582				0	ta	\<ahelp hid=\".\"\>Arrange the fields with drag-and-drop or use the arrow buttons.\</ahelp\>				20200411 15:09:53
