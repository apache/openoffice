helpcontent2	source\text\sbasic\shared\03060300.xhp	0	help	par_id3151116				0	ta	A = 10: B = 8: C = 6: D = Null				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03060300.xhp	0	help	par_id3145750				0	ta	vOut = A > B Imp B > C REM returns -1				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03060300.xhp	0	help	par_id3156441				0	ta	vOut = B > A Imp B > C REM returns -1				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03060300.xhp	0	help	par_id3152596				0	ta	vOut = A > B Imp B > D REM returns 0				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03060300.xhp	0	help	par_id3154942				0	ta	vOut = (B > D Imp B > A) REM returns -1				20200411 15:09:53
