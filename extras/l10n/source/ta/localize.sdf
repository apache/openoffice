helpcontent2	source\text\scalc\01\04060108.xhp	0	help	par_id3147483				0	ta	-1				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060108.xhp	0	help	par_id3083443				0	ta	1				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060108.xhp	0	help	par_id3149826				0	ta	6				20200411 15:09:53
