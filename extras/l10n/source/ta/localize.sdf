helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3147410				0	ta	\<ahelp hid=\"SW:METRICFIELD:DLG_PAGEPREVIEW_PRINTOPTIONS:MF_LMARGIN\" visibility=\"visible\"\>Specifies the left margin width.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3149552				0	ta	Top				20200411 15:09:53
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3150546				0	ta	\<ahelp hid=\"SW:METRICFIELD:DLG_PAGEPREVIEW_PRINTOPTIONS:MF_TMARGIN\" visibility=\"visible\"\>Specifies the top margin height.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3147733				0	ta	Right				20200411 15:09:53
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3147751				0	ta	\<ahelp hid=\"SW:METRICFIELD:DLG_PAGEPREVIEW_PRINTOPTIONS:MF_RMARGIN\" visibility=\"visible\"\>Specifies the right margin width.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3149845				0	ta	Bottom				20200411 15:09:53
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3148857				0	ta	\<ahelp hid=\"SW:METRICFIELD:DLG_PAGEPREVIEW_PRINTOPTIONS:MF_BMARGIN\" visibility=\"visible\"\>Specifies the bottom margin height.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3150491				0	ta	Spacing				20200411 15:09:53
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3156097				0	ta	The spacing section is used to determine the horizontal and vertical distances between the reduced document pages on one page.				20200411 15:09:53
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3156113				0	ta	Horizontal				20200411 15:09:53
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3150100				0	ta	\<ahelp hid=\"SW:METRICFIELD:DLG_PAGEPREVIEW_PRINTOPTIONS:MF_HMARGIN\" visibility=\"visible\"\>Determines the horizontal distance between document pages.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3153128				0	ta	Vertical				20200411 15:09:53
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3149632				0	ta	\<ahelp hid=\"SW:METRICFIELD:DLG_PAGEPREVIEW_PRINTOPTIONS:MF_VMARGIN\" visibility=\"visible\"\>Determines the vertical distance between document pages.\</ahelp\>				20200411 15:09:53
