helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151349				0	ta	TRIM("Text")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151362	58			0	ta	            \<emph\>Text\</emph\> refers to text in which spaces are removed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146838				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156074	60			0	ta	            \<item type=\"input\"\>=TRIM("hello")\</item\> returns hello.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id0907200904030935				0	ta	\<bookmark_value\>UNICHAR function\</bookmark_value\>				20200411 15:09:53
