helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	tit				0	ta	NETWORKDAYS				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	bm_id3151254				0	ta	\<bookmark_value\>NETWORKDAYS function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	hd_id3151254				0	ta	\<variable id=\"networkdays\"\>\<link href=\"text/scalc/01/func_networkdays.xhp\"\>NETWORKDAYS\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	par_id3153788				0	ta	\<ahelp hid=\"HID_AAI_FUNC_NETWORKDAYS\"\>Returns the number of workdays between a \<emph\>start date and an end date\</emph\>. Holidays can be deducted.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	hd_id3148677				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	par_id3145775				0	ta	NETWORKDAYS(StartDate; EndDate; Holidays)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	par_id3153885				0	ta	\<emph\>StartDate\</emph\> is the date from when the calculation is carried out. If the start date is a workday, the day is included in the calculation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	par_id3151110				0	ta	\<emph\>EndDate\</emph\> is the date up until when the calculation is carried out. If the end date is a workday, the day is included in the calculation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	par_id3154115				0	ta	\<emph\>Holidays\</emph\> is an optional list of holidays. These are non-working days. Enter a cell range in which the holidays are listed individually.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	hd_id3146902				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	par_id3154661				0	ta	How many workdays fall between 2001-12-15 and 2002-01-15? The start date is located in C3 and the end date in D3. Cells F3 to J3 contain the following Christmas and New Year holidays: "2001-12-24", "2001-12-25", "2001-12-26", "2001-12-31", "2002-01-01".				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	par_id3147328				0	ta	=NETWORKDAYS(C3;D3;F3:J3) returns 17 workdays.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	tit				0	ta	YEARFRAC				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	bm_id3148735				0	ta	\<bookmark_value\>YEARFRAC function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	hd_id3148735				0	ta	\<variable id=\"yearfrac\"\>\<link href=\"text/scalc/01/func_yearfrac.xhp\"\>YEARFRAC\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3150899				0	ta	\<ahelp hid=\"HID_AAI_FUNC_YEARFRAC\"\> The result is a number between 0 and 1, representing the fraction of a year between \<emph\>StartDate\</emph\> and \<emph\>EndDate\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	hd_id3155259				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3155823				0	ta	YEARFRAC(StartDate; EndDate; Basis)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3145144				0	ta	\<emph\>StartDate\</emph\> and \<emph\>EndDate\</emph\> are two date values.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3149954				0	ta	\<emph\>Basis\</emph\> is chosen from a list of options and indicates how the year is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3146847				0	ta	Basis				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3155956				0	ta	Calculation				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3154502				0	ta	0 or missing				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3149877				0	ta	US method (NASD), 12 months of 30 days each				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3148766				0	ta	1				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3154326				0	ta	Exact number of days in months, exact number of days in year				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3145245				0	ta	2				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3155620				0	ta	Exact number of days in month, year has 360 days				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3145297				0	ta	3				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3148394				0	ta	Exact number of days in month, year has 365 days				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3151022				0	ta	4				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3150931				0	ta	European method, 12 months of 30 days each				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	hd_id3145626				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3149007				0	ta	What fraction of the year 2008 lies between 2008-01-01 and 2008-07-01?				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3154632				0	ta	=YEARFRAC("2008-01-01"; "2008-07-01";0) returns 0.50.				20200411 15:09:53
