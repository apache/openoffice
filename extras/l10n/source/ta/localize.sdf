helpcontent2	source\text\sbasic\shared\03020204.xhp	0	help	par_id3150045				0	ta	Seek #iNumber,2				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020204.xhp	0	help	par_id3145149				0	ta	Get #iNumber,,sText				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020204.xhp	0	help	par_id3147363				0	ta	Print sText				20200411 15:09:53
