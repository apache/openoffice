helpcontent2	source\text\sbasic\shared\03090410.xhp	0	help	par_id3143270				0	ta	Dim sGender As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090410.xhp	0	help	par_id3149579				0	ta	sGender = GetGenderIndex( "John" )				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090410.xhp	0	help	par_id3153626				0	ta	MsgBox sGender				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090410.xhp	0	help	par_id3147560				0	ta	End Sub				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090410.xhp	0	help	par_id3154758				0	ta	Function GetGenderIndex (sName As String) As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090410.xhp	0	help	par_id3153361				0	ta	GetGenderIndex = Switch(sName = "Jane", "female", sName = "John", "male")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090410.xhp	0	help	par_id3154939				0	ta	End Function				20200411 15:09:53
