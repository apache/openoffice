helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3145762				0	ta	\<ahelp hid=\"HID_FUNC_ZEIT\"\>TIME returns the current time value from values for hours, minutes and seconds.\</ahelp\> This function can be used to convert a time based on these three elements to a decimal time value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	hd_id3155550				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3154584				0	ta	TIME(Hour; Minute; Second)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3152904				0	ta	Use an integer to set the \<emph\>Hour\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3151346				0	ta	Use an integer to set the \<emph\>Minute\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3151366				0	ta	Use an integer to set the \<emph\>Second\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	hd_id3145577				0	ta	Examples				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3156076				0	ta	\<item type=\"input\"\>=TIME(0;0;0)\</item\> returns 00:00:00				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3156090				0	ta	\<item type=\"input\"\>=TIME(4;20;4)\</item\> returns 04:20:04				20200411 15:09:53
