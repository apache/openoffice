helpcontent2	source\text\simpress\guide\keyboard.xhp	0	help	par_id3148728				0	ta	\<item type=\"keycode\"\>Spacebar\</item\>				20200411 15:09:53
helpcontent2	source\text\simpress\guide\keyboard.xhp	0	help	hd_id3153035				0	ta	Advance to the next slide without playing object animation effects				20200411 15:09:53
helpcontent2	source\text\simpress\guide\keyboard.xhp	0	help	par_id3155263				0	ta	\<item type=\"keycode\"\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Option\</caseinline\>\<defaultinline\>Alt\</defaultinline\>\</switchinline\>+PageDown\</item\>				20200411 15:09:53
helpcontent2	source\text\simpress\guide\keyboard.xhp	0	help	hd_id3154558				0	ta	Return to previous slide				20200411 15:09:53
