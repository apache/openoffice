helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3153526				0	ta	\<emph\>Text:\</emph\> Any string expression that you want to return the rightmost characters of.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3151211				0	ta	\<emph\>n:\</emph\> Numeric expression that defines the number of characters that you want to return. If \<emph\>n\</emph\> = 0, a zero-length string is returned. The maximum allowed value is 65535.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3158410				0	ta	The following example converts a date in YYYY-MM-DD format to the US date format (MM/DD/YYYY).				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	hd_id3156212				0	ta	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3150869				0	ta	Sub ExampleUSDate				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3153105				0	ta	Dim sInput As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3154124				0	ta	Dim sUS_date As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3159252				0	ta	sInput = InputBox("Please input a date in the international format 'YYYY-MM-DD'")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3149561				0	ta	sUS_date = Mid(sInput, 6, 2)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3146984				0	ta	sUS_date = sUS_date & "/"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3155308				0	ta	sUS_date = sUS_date & Right(sInput, 2)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3153727				0	ta	sUS_date = sUS_date & "/"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3145365				0	ta	sUS_date = sUS_date & Left(sInput, 4)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3152940				0	ta	MsgBox sUS_date				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3146120				0	ta	End Sub				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120104.xhp	0	help	tit				0	ta	Val Function [Runtime]				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120104.xhp	0	help	bm_id3149205				0	ta	\<bookmark_value\>Val function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120104.xhp	0	help	hd_id3149205				0	ta	\<link href=\"text/sbasic/shared/03120104.xhp\" name=\"Val Function [Runtime]\"\>Val Function [Runtime]\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120104.xhp	0	help	par_id3153345				0	ta	Converts a string to a numeric expression.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120104.xhp	0	help	hd_id3159157				0	ta	Syntax:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120104.xhp	0	help	par_id3149514				0	ta	Val (Text As String)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120104.xhp	0	help	hd_id3150669				0	ta	Return value:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120104.xhp	0	help	par_id3143228				0	ta	Double				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120104.xhp	0	help	hd_id3156024				0	ta	Parameters:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120104.xhp	0	help	par_id3154348				0	ta	\<emph\>Text:\</emph\> String that represents a number.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120104.xhp	0	help	par_id3149670				0	ta	Using the Val function, you can convert a string that represents numbers into numeric expressions. This is the inverse of the \<emph\>Str\</emph\> function. If only part of the string contains numbers, only the first appropriate characters of the string are converted. If the string does not contain any numbers, the \<emph\>Val\</emph\> function returns the value 0.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120104.xhp	0	help	hd_id3154365				0	ta	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120104.xhp	0	help	par_id3151177				0	ta	Sub ExampleVal				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120104.xhp	0	help	par_id3159150				0	ta	msgbox Val("123.123")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120104.xhp	0	help	par_id3154126				0	ta	msgbox Val("A123.123")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120104.xhp	0	help	par_id3147229				0	ta	end Sub				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080401.xhp	0	help	tit				0	ta	Sqr Function [Runtime]				20200411 15:09:53
