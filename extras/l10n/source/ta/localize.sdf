helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	par_id3148576				0	ta	lVar = rgb(128,0,200)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	par_id3154012				0	ta	MsgBox "The color " & lVar & " consists of:" & Chr(13) &_				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	par_id3148645				0	ta	"red= " & Red(lVar) & Chr(13)&_				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	par_id3159155				0	ta	"green= " & Green(lVar) & Chr(13)&_				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	par_id3147319				0	ta	"blue= " & Blue(lVar) & Chr(13) , 64,"colors"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010301.xhp	0	help	par_id3147434				0	ta	End Sub				20200411 15:09:53
