helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN10582				0	ta	\<ahelp hid=\".\"\>Deletes the selected record.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN10585				0	ta	Find				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN10589				0	ta	\<ahelp hid=\".\"\>Opens the \<link href=\"text/swriter/01/mm_finent.xhp\"\>Find Entry\</link\> dialog. You can leave the dialog open while you edit the entries.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN1059A				0	ta	Customize				20200411 15:09:53
