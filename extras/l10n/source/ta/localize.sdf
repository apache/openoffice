helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3166425				0	ta	\<variable id=\"kl\"\>\<link href=\"text/scalc/01/04060183.xhp\" name=\"Statistical Functions Part Three\"\>Statistical Functions Part Three\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3149530				0	ta	\<bookmark_value\>LARGE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3149530				0	ta	LARGE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150518				0	ta	\<ahelp hid=\"HID_FUNC_KGROESSTE\"\>Returns the Rank_c-th largest value in a data set.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3152990				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154372				0	ta	LARGE(Data; RankC)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3152986				0	ta	\<emph\>Data\</emph\> is the cell range of data.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3156448				0	ta	\<emph\>RankC\</emph\> is the ranking of the value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3152889				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3148702				0	ta	\<item type=\"input\"\>=LARGE(A1:C50;2)\</item\> gives the second largest value in A1:C50.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3154532				0	ta	\<bookmark_value\>SMALL function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3154532				0	ta	SMALL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3157981				0	ta	\<ahelp hid=\"HID_FUNC_KKLEINSTE\"\>Returns the Rank_c-th smallest value in a data set.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3154957				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153974				0	ta	SMALL(Data; RankC)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154540				0	ta	\<emph\>Data\</emph\> is the cell range of data.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155094				0	ta	\<emph\>RankC\</emph\> is the rank of the value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3153247				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149897				0	ta	\<item type=\"input\"\>=SMALL(A1:C50;2)\</item\> gives the second smallest value in A1:C50.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3153559				0	ta	\<bookmark_value\>CONFIDENCE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3153559				0	ta	CONFIDENCE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153814				0	ta	\<ahelp hid=\"HID_FUNC_KONFIDENZ\"\>Returns the (1-alpha) confidence interval for a normal distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3149315				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3147501				0	ta	CONFIDENCE(Alpha; StDev; Size)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149872				0	ta	\<emph\>Alpha\</emph\> is the level of the confidence interval.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145324				0	ta	\<emph\>StDev\</emph\> is the standard deviation for the total population.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153075				0	ta	\<emph\>Size\</emph\> is the size of the total population.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150435				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153335				0	ta	\<item type=\"input\"\>=CONFIDENCE(0.05;1.5;100)\</item\> gives 0.29.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3148746				0	ta	\<bookmark_value\>CORREL function\</bookmark_value\>\<bookmark_value\>coefficient of correlation\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3148746				0	ta	CORREL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3147299				0	ta	\<ahelp hid=\"HID_FUNC_KORREL\"\>Returns the correlation coefficient between two data sets.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3156397				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153023				0	ta	CORREL(Data1; Data2)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150036				0	ta	\<emph\>Data1\</emph\> is the first data set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153021				0	ta	\<emph\>Data2\</emph\> is the second data set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3149720				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149941				0	ta	\<item type=\"input\"\>=CORREL(A1:A50;B1:B50)\</item\> calculates the correlation coefficient as a measure of the linear correlation of the two data sets.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3150652				0	ta	\<bookmark_value\>COVAR function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150652				0	ta	COVAR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3146875				0	ta	\<ahelp hid=\"HID_FUNC_KOVAR\"\>Returns the covariance of the product of paired deviations.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3149013				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150740				0	ta	COVAR(Data1; Data2)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145827				0	ta	\<emph\>Data1\</emph\> is the first data set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150465				0	ta	\<emph\>Data2\</emph\> is the second data set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3154677				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3144748				0	ta	\<item type=\"input\"\>=COVAR(A1:A30;B1:B30)\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3147472				0	ta	\<bookmark_value\>CRITBINOM function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3147472				0	ta	CRITBINOM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149254				0	ta	\<ahelp hid=\"HID_FUNC_KRITBINOM\"\>Returns the smallest value for which the cumulative binomial distribution is less than or equal to a criterion value.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3153930				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3148586				0	ta	CRITBINOM(Trials; SP; Alpha)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145593				0	ta	\<emph\>Trials\</emph\> is the total number of trials.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153084				0	ta	\<emph\>SP\</emph\> is the probability of success for one trial.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149726				0	ta	\<emph\>Alpha\</emph\> is the threshold probability to be reached or exceeded.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3148752				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3148740				0	ta	\<item type=\"input\"\>=CRITBINOM(100;0.5;0.1)\</item\> yields 44.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3155956				0	ta	\<bookmark_value\>KURT function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3155956				0	ta	KURT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153108				0	ta	\<ahelp hid=\"HID_FUNC_KURT\"\>Returns the kurtosis of a data set (at least 4 values required).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150334				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154508				0	ta	KURT(Number1; Number2; ...Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145167				0	ta	\<emph\>Number1,Number2,...Number30\</emph\> are numeric arguments or ranges representing a random sample of distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3158000				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150016				0	ta	\<item type=\"input\"\>=KURT(A1;A2;A3;A4;A5;A6)\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3150928				0	ta	\<bookmark_value\>LOGINV function\</bookmark_value\>\<bookmark_value\>inverse of lognormal distribution\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150928				0	ta	LOGINV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145297				0	ta	\<ahelp hid=\"HID_FUNC_LOGINV\"\>Returns the inverse of the lognormal distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3151016				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153049				0	ta	LOGINV(Number; Mean; StDev)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3148390				0	ta	\<emph\>Number\</emph\> is the probability value for which the inverse standard logarithmic distribution is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149538				0	ta	\<emph\>Mean\</emph\> is the arithmetic mean of the standard logarithmic distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145355				0	ta	\<emph\>StDev\</emph\> is the standard deviation of the standard logarithmic distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3148768				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155623				0	ta	\<item type=\"input\"\>=LOGINV(0.05;0;1)\</item\> returns 0.19.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3158417				0	ta	\<bookmark_value\>LOGNORMDIST function\</bookmark_value\>\<bookmark_value\>cumulative lognormal distribution\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3158417				0	ta	LOGNORMDIST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154953				0	ta	\<ahelp hid=\"HID_FUNC_LOGNORMVERT\"\>Returns the cumulative lognormal distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150474				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150686				0	ta	LOGNORMDIST(Number; Mean; StDev; Cumulative)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154871				0	ta	\<emph\>Number\</emph\> is the probability value for which the standard logarithmic distribution is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155820				0	ta	\<emph\>Mean\</emph\> (optional) is the mean value of the standard logarithmic distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155991				0	ta	\<emph\>StDev\</emph\> (optional) is the standard deviation of the standard logarithmic distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155992				0	ta	\<emph\>Cumulative\</emph\> (optional) = 0 calculates the density function, Cumulative = 1 calculates the distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3153178				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149778				0	ta	\<item type=\"input\"\>=LOGNORMDIST(0.1;0;1)\</item\> returns 0.01.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06070000.xhp	0	help	tit				0	ta	AutoCalculate				20200411 15:09:53
helpcontent2	source\text\scalc\01\06070000.xhp	0	help	bm_id3145673				0	ta	\<bookmark_value\>calculating; auto calculating sheets\</bookmark_value\>\<bookmark_value\>recalculating;auto calculating sheets\</bookmark_value\>\<bookmark_value\>AutoCalculate function in sheets\</bookmark_value\>\<bookmark_value\>correcting sheets automatically\</bookmark_value\>\<bookmark_value\>formulas;AutoCalculate function\</bookmark_value\>\<bookmark_value\>cell contents;AutoCalculate function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06070000.xhp	0	help	hd_id3145673				0	ta	\<link href=\"text/scalc/01/06070000.xhp\" name=\"AutoCalculate\"\>AutoCalculate\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06070000.xhp	0	help	par_id3148798				0	ta	\<ahelp hid=\".uno:AutomaticCalculation\"\>Automatically recalculates all formulas in the document.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06070000.xhp	0	help	par_id3145173				0	ta	All cells are recalculated after a sheet cell has been modified. Any charts in the sheet will also be refreshed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	tit				0	ta	DATE				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	bm_id3155511				0	ta	\<bookmark_value\>DATE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	hd_id3155511				0	ta	\<variable id=\"date\"\>\<link href=\"text/scalc/01/func_date.xhp\"\>DATE\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3153551				0	ta	\<ahelp hid=\"HID_FUNC_DATUM\"\>This function calculates a date specified by year, month, day and displays it in the cell's formatting.\</ahelp\> The default format of a cell containing the DATE function is the date format, but you can format the cells with any other number format.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	hd_id3148590				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3150474				0	ta	DATE(Year; Month; Day)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3152815				0	ta	\<emph\>Year\</emph\> is an integer between 1583 and 9957 or between 0 and 99.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3153222				0	ta	In \<item type=\"menuitem\"\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - $[officename] - General \</item\>you can set from which year a two-digit number entry is recognized as 20xx.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3155817				0	ta	\<emph\>Month\</emph\> is an integer indicating the month.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3153183				0	ta	\<emph\>Day\</emph\> is an integer indicating the day of the month.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3156260				0	ta	If the values for month and day are out of bounds, they are carried over to the next digit. If you enter \<item type=\"input\"\>=DATE(00;12;31)\</item\> the result will be 12/31/00. If, on the other hand, you enter \<item type=\"input\"\>=DATE(00;13;31)\</item\> the result will be 1/31/01.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	hd_id3147477				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3152589				0	ta	\<item type=\"input\"\>=DATE(00;1;31)\</item\> yields 1/31/00 if the cell format setting is MM/DD/YY.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	tit				0	ta	Consolidate by				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	hd_id3151210				0	ta	Consolidate by				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	hd_id3125864				0	ta	Consolidate by				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	par_id3154909				0	ta	Use this section if the cell ranges that you want to consolidate contain labels. You only need to select these options if the consolidation ranges contain similar labels and the data arranged is arranged differently.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	hd_id3153968				0	ta	Row labels				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	par_id3150441				0	ta	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_CONSOLIDATE:BTN_BYROW\" visibility=\"visible\"\>Uses the row labels to arrange the consolidated data.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	hd_id3146976				0	ta	Column labels				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	par_id3155411				0	ta	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_CONSOLIDATE:BTN_BYCOL\" visibility=\"visible\"\>Uses the column labels to arrange the consolidated data.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	hd_id3153191				0	ta	Options				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	hd_id3159154				0	ta	Link to source data				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	par_id3146986				0	ta	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_CONSOLIDATE:BTN_REFS\" visibility=\"visible\"\>Links the data in the consolidation range to the source data, and automatically updates the results of the consolidation when the source data is changed.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	hd_id3163708				0	ta	More <<				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	par_id3151118				0	ta	Hides the additional options.				20200411 15:09:53
