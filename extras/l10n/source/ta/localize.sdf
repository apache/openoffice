helpcontent2	source\text\scalc\01\func_days.xhp	0	help	tit				0	ta	DAYS 				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	bm_id3151328				0	ta	\<bookmark_value\>DAYS function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	hd_id3151328				0	ta	\<variable id=\"days\"\>\<link href=\"text/scalc/01/func_days.xhp\"\>DAYS\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3155139				0	ta	\<ahelp hid=\"HID_FUNC_TAGE\"\>Calculates the difference between two date values.\</ahelp\> The result returns the number of days between the two days.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	hd_id3155184				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3149578				0	ta	DAYS(Date2; Date1)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3151376				0	ta	\<emph\>Date1\</emph\> is the start date, \<emph\>Date2\</emph\> is the end date. If \<emph\>Date2\</emph\> is an earlier date than \<emph\>Date1\</emph\> the result is a negative number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	hd_id3151001				0	ta	Examples				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3159101				0	ta	=DAYS("2010-01-01"; NOW()) returns the number of days from today until January 1, 2010.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3163720				0	ta	=DAYS("1990-10-10";"1980-10-10") returns 3652 days.				20200411 15:09:53
