helpcontent2	source\text\shared\02\06050000.xhp	0	help	par_id3147285				0	ta	\<ahelp hid=\".uno:DecrementLevel\"\>Moves the selected paragraph down one level in a numbering or bullets hierarchy.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\06050000.xhp	0	help	par_id3149549	4			0	ta	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>The\<emph\> Demote One Level \</emph\>icon is on the \<emph\>Bullets and Numbering\</emph\> bar, which appears when the cursor is positioned on a numbering or bullets item. \</caseinline\>\<caseinline select=\"IMPRESS\"\>The \<emph\>Demote \</emph\>icon is on the \<emph\>Text Formatting\</emph\> bar, which appears when working in the outline view. \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\02\06050000.xhp	0	help	par_id3146957				0	ta	\<image id=\"img_id3143267\" src=\"res/commandimagelist/sc_outlineright.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3143267\"\>Icon\</alt\>\</image\>				20200411 15:09:53
helpcontent2	source\text\shared\02\06050000.xhp	0	help	par_id3149096	3			0	ta	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Demote One Level \</caseinline\>\<defaultinline\>Demote\</defaultinline\>\</switchinline\>				20200411 15:09:53
