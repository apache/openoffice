helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id0818200912531487				0	ta	\<emph\>Tiskanje preglednic:\</emph\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id0818200912531410				0	ta	\<emph\>Tiskanje predstavitev:\</emph\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id0818200912531449				0	ta	\<emph\>Splošno tiskanje:\</emph\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id0818200912284952				0	ta	Nastavitve, ki jih določite v pogovornem oknu Natisni, veljajo le za trenutno tiskalniško opravilo, ki ga poženete s klikom gumba Natisni. Če želite trajno spremeniti določeno nastavitev, odprite Orodja - Možnosti - %PRODUCTNAME (ime modula) - Natisni.				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3156080				0	ta	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Če želite nastaviti privzete možnosti tiskanja za dokumente z besedilom v \<item type=\"productname\"\>%PRODUCTNAME\</item\>, izberite \<link href=\"text/shared/optionen/01040400.xhp\" name=\"Orodja - Možnosti - Writer - Natisni\"\>\<emph\>Orodja - Možnosti - %PRODUCTNAME Writer - Natisni\</emph\>\</link\>.\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_idN1099E				0	ta	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>Če želite nastaviti privzete možnosti tiskanja za dokumente s preglednico v \<item type=\"productname\"\>%PRODUCTNAME\</item\>, izberite \<link href=\"text/shared/optionen/01060700.xhp\" name=\"Orodja - Možnosti - Calc - Natisni\"\>\<emph\>Orodja - Možnosti - %PRODUCTNAME Calc - Natisni\</emph\>\</link\>.\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_idN109CD				0	ta	\<switchinline select=\"appl\"\>\<caseinline select=\"IMPRESS\"\>Če želite nastaviti privzete možnosti tiskanja za dokumente s predstavitvijo v \<item type=\"productname\"\>%PRODUCTNAME\</item\>, izberite \<link href=\"text/shared/optionen/01070400.xhp\" name=\"Orodja - Možnosti - Impress - Tiskanje\"\>\<emph\>Orodja - Možnosti - %PRODUCTNAME Impress - Tiskanje\</emph\>\</link\>.\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id0818200901194137				0	ta	Pritisnite Shift+F1 ali izberite \<item type=\"menuitem\"\>Pomoč - Kaj je to?\</item\> in usmerite kazalec na poljuben kontrolnik v pogovornem oknu Natisni, izpiše se razširjen namig zanj.				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	hd_id0818200912284914				0	ta	Predogled				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id081820091228505				0	ta	Predogled prikaže, kako bo videti vsak list papirja. Po listih lahko brskate z gumbi pod prikazanim predogledom.				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	hd_id0818200912285056				0	ta	Splošno				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id0818200912285064				0	ta	Na zavihku Splošno najdete najpogostejše kontrolnike za tiskanje. Določite lahko, katere vsebine dokumenta bodo natisnjene. Izberete lahko tiskalnik in odprete pogovorno okno nastavitev tiskalnika.				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id2				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Določa, ali bodo natisnjene tudi barve in predmeti, ki so vstavljeni v ozadje strani (Oblika - Stran - Ozadje).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id4				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Določa, ali bodo natisnjene grafika in slike ali predmeti OLE dokumenta z besedilom.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id6				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Vključite to možnost, če želite natisniti besedilo, označeno kot skrito.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id8				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Vključite to možnost, če želite natisniti ograde z besedilom. Izključite to možnost, če želite v izpisu pustiti ograde z besedilom prazne.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id10				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Določa, ali bodo natisnjena tudi polja kontrolnika obrazca, ki se nahajajo v dokumentu z besedilom.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id12				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Določa, ali naj bo besedilo vedno natisnjeno v črni barvi.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id14				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Če je ta možnost izbrana, bodo samodejno vstavljene prazne strani tudi natisnjene. To možnost priporočamo, kadar tiskate obojestransko. V knjigi je npr. slog odstavka "poglavje" nastavljen tako, da se vedno začne na liho oštevilčeni strani. Če se na lihi strani konča tudi prejšnje poglavje, bo %PRODUCTNAME vstavil sodo oštevilčeno prazno stran. Ta možnost določa, ali bo natisnjena tudi ta oštevilčena prazna stran.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id16				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Določite, kje naj bodo natisnjeni komentarji (če obstajajo).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id18				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Določite, kje naj bodo natisnjeni komentarji (če obstajajo).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id20				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Določa, ali želite, da je ime dokumenta vključeno v izpis.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id22				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Določa, ali naj bo vsebina okna Ukazi vključena na dnu izpisa.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id24				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Pri izpisu območje formule tanko obrobi.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id26				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Natisne formulo brez prilagajanja trenutne velikosti pisave.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id28				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Formulo prilagodi obliki strani, uporabljeni pri izpisu.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id30				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Pomanjša ali poveča velikost natisnjene formule z navedenim faktorjem povečave.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id32				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Pomanjša ali poveča velikost natisnjene formule z navedenim faktorjem povečave.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id34				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>If checked empty pages that have no cell contents or draw objects are printed.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id36				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Pri tiskalnikih z več pladnji ta možnost določa, ali tiskalniški pladenj, ki naj bo uporabljen, določajo sistemske nastavitve tiskalnika.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3149164				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Natisne celoten dokument.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3152944				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Natisne le tiste strani ali prosojnice, ki jih navedete v polju \<emph\>Strani\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3150244				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Natisne le izbrana območja ali predmete v trenutnem dokumentu.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3146848				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Če želite natisniti obseg strani, uporabite obliko 3-6. Če želite natisniti posamezne strani, uporabite obliko 7;9;11. Če želite, lahko natisnete kombinacijo obsega strani in posameznih strani, tako da uporabite obliko 3-6;8;10;12.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3150772				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Tiska v datoteko namesto s tiskalnikom.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id38				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Potrdite, če se pri ustvarjanju zbranih kopij ne želite zanesti na tiskalnik, temveč želite za vsako kopijo ustvariti ločeno tiskalniško opravilo.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id40				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Potrdite, če želite tiskati strani v obratnem vrstnem redu.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3145069				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Vnesite število kopij, ki jih želite natisniti.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3150865				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Ohrani zaporedje strani izvirnega dokumenta.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3156113				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Odpre pogovorno okno lastnosti tiskalnika. Lastnosti tiskalnika se razlikujejo glede na izbrani tiskalnik.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id42				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Pokažite/skrijte podrobnosti o izbranem tiskalniku.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3149511				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Seznamsko polje prikaže nameščene tiskalnike. Kliknite tiskalnik, ki ga želite uporabiti za trenutno tiskalniško opravilo. Kliknite gumb Podatki o tiskalniku, če si želite ogledati informacije o izbranem tiskalniku. Kliknite gumb Lastnosti, če želite spremeniti katero od lastnosti tiskalnika.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id44				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Določite, katere strani naj bodo vključene v izpis.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id46				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Izberite možnost Brošura, če želite dokument natisniti v obliki brošure.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id48				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Izberite strani brošure, ki jih želite natisniti.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id0818200904102910				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Pri tiskanju brošure lahko izberete zaporedje strani od leve proti desni ali od desne proti levi.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id50				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Potrdite, če želite narisati rob okoli vsake strani.\</ahelp\>				20200411 15:09:53
