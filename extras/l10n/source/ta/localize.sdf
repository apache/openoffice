helpcontent2	source\text\sbasic\shared\03050000.xhp	0	help	par_id3145068				0	ta	Use the following statements and functions to define the way $[officename] Basic reacts to run-time errors.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03050000.xhp	0	help	par_id3148946				0	ta	$[officename] Basic offers several methods to prevent the termination of a program when a run-time error occurs.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	tit				0	ta	CBool Function [Runtime]				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	bm_id3150616				0	ta	\<bookmark_value\>CBool function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	hd_id3150616				0	ta	\<link href=\"text/sbasic/shared/03100100.xhp\" name=\"CBool Function [Runtime]\"\>CBool Function [Runtime]\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3145136				0	ta	Converts a string comparison or numeric comparison to a Boolean expression, or converts a single numeric expression to a Boolean expression.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	hd_id3153345				0	ta	Syntax:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3149514				0	ta	CBool (Expression1 {= | <> | < | > | <= | >=} Expression2) or CBool (Number)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	hd_id3156152				0	ta	Return value:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3155419				0	ta	Bool				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	hd_id3147530				0	ta	Parameters:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3156344				0	ta	\<emph\>Expression1, Expression2:\</emph\> Any string or numeric expressions that you want to compare. If the expressions match, the \<emph\>CBool\</emph\> function returns \<emph\>True\</emph\>, otherwise \<emph\>False\</emph\> is returned.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3149655				0	ta	\<emph\>Number:\</emph\> Any numeric expression that you want to convert. If the expression equals 0, \<emph\>False\</emph\> is returned, otherwise \<emph\>True\</emph\> is returned.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3145171				0	ta	The following example uses the \<emph\>CBool\</emph\> function to evaluate the value that is returned by the \<emph\>Instr\</emph\> function. The function checks if the word "and" is found in the sentence that was entered by the user.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	hd_id3156212				0	ta	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3147288				0	ta	Sub ExampleCBool				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3153768				0	ta	Dim sText As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3155132				0	ta	sText = InputBox("Please enter a short sentence:")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3155855				0	ta	REM Proof if the word »and« appears in the sentence.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3146984				0	ta	REM Instead of the command line				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3148576				0	ta	REM If Instr(Input, "and")<>0 Then...				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3154014				0	ta	REM the CBool function is applied as follows:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3155413				0	ta	If CBool(Instr(sText, "and")) Then				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3152940				0	ta	MsgBox "The word »and« appears in the sentence you entered!"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3153954				0	ta	EndIf				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3152886				0	ta	End Sub				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	tit				0	ta	For...Next Statement [Runtime]				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	bm_id3149205				0	ta	\<bookmark_value\>For statement\</bookmark_value\>\<bookmark_value\>To statement\</bookmark_value\>\<bookmark_value\>Step statement\</bookmark_value\>\<bookmark_value\>Next statement\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	hd_id3149205				0	ta	\<link href=\"text/sbasic/shared/03090202.xhp\" name=\"For...Next Statement [Runtime]\"\>For...Next Statement [Runtime]\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3143267				0	ta	Repeats the statements between the For...Next block a specified number of times.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	hd_id3156153				0	ta	Syntax:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3148473				0	ta	For counter=start To end [Step step]				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3156024				0	ta	statement block				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3146796				0	ta	[Exit For]				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3159414				0	ta	statement block				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3153897				0	ta	Next [counter]				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	hd_id3150400				0	ta	Variables:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3150358				0	ta	\<emph\>Counter:\</emph\> Loop counter initially assigned the value to the right of the equal sign (start). Only numeric variables are valid. The loop counter increases or decreases according to the variable Step until End is passed.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3152455				0	ta	\<emph\>Start:\</emph\> Numeric variable that defines the initial value at the beginning of the loop.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3151043				0	ta	\<emph\>End:\</emph\> Numeric variable that defines the final value at the end of the loop.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3156281				0	ta	\<emph\>Step:\</emph\> Sets the value by which to increase or decrease the loop counter. If Step is not specified, the loop counter is incremented by 1. In this case, End must be greater than Start. If you want to decrease Counter, End must be less than Start, and Step must be assigned a negative value.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3154684				0	ta	The \<emph\>For...Next\</emph\> loop repeats all of the statements in the loop for the number of times that is specified by the parameters.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3147287				0	ta	As the counter variable is decreased, $[officename] Basic checks if the end value has been reached. As soon as the counter passes the end value, the loop automatically ends.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3159154				0	ta	It is possible to nest \<emph\>For...Next\</emph\> statements. If you do not specify a variable following the \<emph\>Next\</emph\> statement, \<emph\>Next\</emph\> automatically refers to the most recent \<emph\>For\</emph\> statement.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3155306				0	ta	If you specify an increment of 0, the statements between \<emph\>For\</emph\> and \<emph\>Next\</emph\> are repeated continuously.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3155854				0	ta	When counting down the counter variable, $[officename] Basic checks for overflow or underflow. The loop ends when Counter exceeds End (positive Step value) or is less than End (negative Step value).				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3145273				0	ta	Use the \<emph\>Exit For\</emph\> statement to exit the loop unconditionally. This statement must be within a \<emph\>For...Next\</emph\> loop. Use the \<emph\>If...Then\</emph\> statement to test the exit condition as follows:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3153190				0	ta	For...				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3149482				0	ta	statements				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3147124				0	ta	If condition = True Then Exit For				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3153159				0	ta	statements				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3154096				0	ta	Next				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3156286				0	ta	Note: In nested \<emph\>For...Next\</emph\> loops, if you exit a loop unconditionally with \<emph\>Exit For\</emph\>, only one loop is exited.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	hd_id3148457				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3151074				0	ta	The following example uses two nested loops to sort a string array with 10 elements ( sEntry() ), that are first filled with various contents:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3155603				0	ta	Sub ExampleSort				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3156275				0	ta	Dim sEntry(9) As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3155066				0	ta	Dim iCount As Integer				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3150751				0	ta	Dim iCount2 As Integer				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3155446				0	ta	Dim sTemp As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3155767				0	ta	sEntry(0) = "Jerry"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3153711				0	ta	sEntry(1) = "Patty"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3148993				0	ta	sEntry(2) = "Kurt"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3156382				0	ta	sEntry(3) = "Thomas"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3155174				0	ta	sEntry(4) = "Michael"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3166448				0	ta	sEntry(5) = "David"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3149255				0	ta	sEntry(6) = "Cathy"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3149565				0	ta	sEntry(7) = "Susie"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3145148				0	ta	sEntry(8) = "Edward"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3145229				0	ta	sEntry(9) = "Christine"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3149107				0	ta	For iCount = 0 To 9				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3148485				0	ta	For iCount2 = iCount + 1 To 9				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3155608				0	ta	If sEntry(iCount) > sEntry(iCount2) Then				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3150938				0	ta	sTemp = sEntry(iCount)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3153790				0	ta	sEntry(iCount) = sEntry(iCount2)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3149210				0	ta	sEntry(iCount2) = sTemp				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3153781				0	ta	End If				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3158446				0	ta	Next iCount2				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3150783				0	ta	Next iCount				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3151278				0	ta	For iCount = 0 To 9				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3148462				0	ta	Print sEntry(iCount)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3149528				0	ta	Next iCount				20200411 15:09:53
