helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	bm_id3154923				0	ta	\<bookmark_value\>Cos function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	hd_id3154923				0	ta	\<link href=\"text/sbasic/shared/03080102.xhp\" name=\"Cos Function [Runtime]\"\>Cos Function [Runtime]\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3159413				0	ta	Calculates the cosine of an angle. The angle is specified in radians. The result lies between -1 and 1.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3150358				0	ta	Using the angle Alpha, the Cos-Function calculates the ratio of the length of the side that is adjacent to the angle, divided by the length of the hypotenuse in a right-angled triangle.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3154141				0	ta	Cos(Alpha) = Adjacent/Hypotenuse				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	hd_id3154125				0	ta	Syntax:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3145172				0	ta	Cos (Number)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	hd_id3156214				0	ta	Return value:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3150449				0	ta	Double				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	hd_id3153969				0	ta	Parameters:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3153770				0	ta	\<emph\>Number:\</emph\> Numeric expression that specifies an angle in radians that you want to calculate the cosine for.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3145749				0	ta	To convert degrees to radians, multiply degrees by pi/180. To convert radians to degrees, multiply radians by 180/pi.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3149664				0	ta	degree=(radian*180)/pi				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3146985				0	ta	radian=(degree*pi)/180				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3152885				0	ta	Pi is here the fixed circle constant with the rounded value 3.14159...				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	hd_id3153951				0	ta	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3155855				0	ta	REM The following example allows for a right-angled triangle the input of				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3149484				0	ta	REM secant and angle (in degrees) and calculates the length of the hypotenuse:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3147428				0	ta	Sub ExampleCosinus				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3150010				0	ta	REM rounded Pi = 3.14159				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3149959				0	ta	Dim d1 as Double, dAngle as Double				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3144764				0	ta	d1 = InputBox$ (""Enter the length of the adjacent side: ","Adjacent")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3154491				0	ta	dAngle = InputBox$ ("Enter the angle Alpha (in degrees): ","Alpha")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3151074				0	ta	Print "The length of the hypothenuse is"; (d1 / cos (dAngle * Pi / 180))				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3149583				0	ta	End Sub				20200411 15:09:53
