helpcontent2	source\text\shared\01\06050600.xhp	0	help	par_id8177434				0	ta	\<ahelp hid=\".\"\>Če izberete, da bo oštevilčenju sledilo tabulatorsko mesto, lahko vnesete ne negativno vrednost, ki predstavlja položaj tabulatorskega mesta.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	hd_id3155583				0	ta	Poravnava oštevilčenja				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	par_id3153063				0	ta	\<ahelp hid=\"SW:LISTBOX:TP_NUM_POSITION:LB_ALIGN\"\>Nastavite poravnavo simbolov oštevilčevanja. Izberite "Levo", če želite poravnati simbol oštevilčevanja tako, da se začne neposredno na položaju "Poravnano na". Izberite "Desno", če želite poravnati simbol s koncem, neposredno pred položaj "Poravnano na". Izberite "Sredinsko" za sredinsko poravnavo simbola okrog položaja "Poravnano na".\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06050600.xhp	0	help	par_id3147422				0	ta	Možnost \<emph\>Poravnava oštevilčevanja\</emph\> ne nastavi poravnave odstavka.				20200411 15:09:53
