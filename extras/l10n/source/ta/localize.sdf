helpcontent2	source\text\scalc\01\06030400.xhp	0	help	par_id3148663				0	ta	\<ahelp visibility=\"visible\" hid=\".uno:ClearArrowDependents\"\>Deletes one level of tracer arrows created with \<emph\>Trace Dependents\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	tit				0	ta	WEEKNUM				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	bm_id3159161				0	ta	\<bookmark_value\>WEEKNUM function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	hd_id3159161				0	ta	\<variable id=\"weeknum\"\>\<link href=\"text/scalc/01/func_weeknum.xhp\"\>WEEKNUM\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3149770				0	ta	\<ahelp hid=\"HID_FUNC_KALENDERWOCHE\"\>WEEKNUM calculates the week number of the year for the internal date value.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_idN105E4				0	ta	The International Standard ISO 8601 has decreed that Monday shall be the first day of the week. A week that lies partly in one year and partly in another is assigned a number in the year in which most of its days lie. That means that week number 1 of any year is the week that contains the January 4th.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	hd_id3153055				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3147236				0	ta	WEEKNUM(Number; Mode)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3147511				0	ta	\<emph\>Number\</emph\> is the internal date number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3154269				0	ta	\<emph\>Mode\</emph\> sets the start of the week and the calculation type.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3148930				0	ta	1 = Sunday				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3154280				0	ta	2 = Monday				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	hd_id3146948				0	ta	Examples				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3150704				0	ta	=WEEKNUM("1995-01-01";1) returns 1				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3149792				0	ta	=WEEKNUM("1995-01-01";2) returns 52. If the week starts on Monday, Sunday belongs to the last week of the previous year.				20200411 15:09:53
