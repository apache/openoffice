helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3149969				0	ta	\<ahelp hid=\"SW:RADIOBUTTON:DLG_PAGEPREVIEW_PRINTOPTIONS:RB_LANDSCAPE\" visibility=\"visible\"\>Prints the page in landscape format.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3149611				0	ta	Portrait				20200411 15:09:53
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3145094				0	ta	\<ahelp hid=\"SW:RADIOBUTTON:DLG_PAGEPREVIEW_PRINTOPTIONS:RB_PORTRAIT\" visibility=\"visible\"\>Prints the page in portrait format.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3145110				0	ta	Default				20200411 15:09:53
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3149579				0	ta	\<ahelp hid=\"SW:PUSHBUTTON:DLG_PAGEPREVIEW_PRINTOPTIONS:PB_STANDARD\" visibility=\"visible\"\>Specifies that the system will not use a fixed number of rows and columns when printing out the page view, but rather uses what was originally shown in the page view.\</ahelp\>				20200411 15:09:53
