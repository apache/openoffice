helpcontent2	source\text\shared\explorer\database\dabaadvpropgen.xhp	0	help	par_idN10645				0	ta	\<ahelp hid=\".\"\>Enter an SQL statement that returns the last auto-incremented value for the primary key data field.\</ahelp\> For example:				20200411 15:09:53
helpcontent2	source\text\shared\explorer\database\dabaadvpropgen.xhp	0	help	par_idN105B1				0	ta	SELECT LAST_INSERT_D();				20200411 15:09:53
