helpcontent2	source\text\shared\01\xformsdatatab.xhp	0	help	hd_id2927335				0	ta	+				20200411 15:09:53
helpcontent2	source\text\shared\01\xformsdatatab.xhp	0	help	par_id2107303				0	ta	\<ahelp hid=\".\"\>Kliknite gumb, da odprete pogovorno okno, kjer lahko vnesete ime nove uporabniško določene vrste podatkov. Nova vrsta podatkov podeduje lastnosti od trenutno izbrane vrste podatkov.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\xformsdatatab.xhp	0	help	par_id4071779				0	ta	Sledi seznam vseh lastnosti, veljavnih za vrste podatkov. Nekatere lastnosti so na voljo samo za nekatere vrste podatkov.				20200411 15:09:53
