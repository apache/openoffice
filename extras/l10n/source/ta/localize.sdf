helpcontent2	source\text\smath\01\03090600.xhp	0	help	par_id3150089				0	ta	Bold font				20200411 15:09:53
helpcontent2	source\text\smath\01\03090600.xhp	0	help	par_id3150101				0	ta	\<ahelp hid=\"HID_SMA_BOLDX\"\>Inserts a placeholder with bold formatting.\</ahelp\> You can also type \<emph\>bold <?>\</emph\> in the \<emph\>Commands\</emph\> window.				20200411 15:09:53
helpcontent2	source\text\smath\01\03090600.xhp	0	help	par_idN1051C				0	ta	\<image id=\"img_id3150038\" src=\"starmath/res/at21718.png\" width=\"0.2228in\" height=\"0.2228in\"\>\<alt id=\"alt_id3150038\"\>Icon\</alt\>\</image\>				20200411 15:09:53
