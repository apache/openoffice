helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145123	36			0	ta	                     \<emph\>E\</emph\>                  				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149504				0	ta	1				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153778	38			0	ta	                     \<item type=\"input\"\>Initial Cost\</item\>                  				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159083	39			0	ta	                     \<item type=\"input\"\>Salvage Value\</item\>                  				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150002	40			0	ta	                     \<item type=\"input\"\>Useful Life\</item\>                  				20200411 15:09:53
