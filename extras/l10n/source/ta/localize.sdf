helpcontent2	source\text\scalc\01\02150000.xhp	0	help	par_id3148485				0	ta	\<ahelp hid=\"SC_CHECKBOX_RID_SCDLG_DELCONT_BTN_DELFORMULAS\"\>Deletes formulas. Text, numbers, formats, dates and times remain unchanged.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	hd_id3150300				0	ta	Comments				20200411 15:09:53
