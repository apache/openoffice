helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3154965	48			0	ta	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Zvesto registru \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3146316	50			0	ta	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Aktiviraj \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3156315	51			0	ta	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<ahelp hid=\"SVX:CHECKBOX:RID_SVXPAGE_STD_PARAGRAPH:CB_REGISTER\"\>Osnovna vrstica vsake vrstice v besedilu se poravna z navpično mrežo dokumenta, tako da so vse vrstice iste višine. Če želite uporabiti to zmožnost, morate najprej za trenutni slog strani aktivirati možnost \<emph\>Zvesto registru\</emph\>. Če to želite, izberite \<emph\>Oblika - Stran\</emph\>, kliknite zavihek \<emph\>Stran\</emph\>, nato pa na področju\<emph\>Nastavitve postavitve\</emph\> izberite polje \<emph\>Zvesto registru\</emph\>.\</ahelp\>\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id9267250				0	ta	\<link href=\"text/swriter/guide/registertrue.xhp\" name=\"Pisanje zvesto registru\"\>Pisanje zvesto registru\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05340500.xhp	0	help	tit				0	ta	Skrij stolpce				20200411 15:09:53
helpcontent2	source\text\shared\01\05340500.xhp	0	help	hd_id3148882				0	ta	\<link href=\"text/shared/01/05340500.xhp\" name=\"Skrij stolpce\"\>Skrij stolpce\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05340500.xhp	0	help	par_id3155620				0	ta	\<ahelp hid=\".\"\>Izbran stolpec oziroma izbrani stolpci se skrijejo. Če želite prikazati skrite stolpce, z desnim miškinim gumbom kliknite glavo katerega koli stolpca, nato pa izberite \<emph\>Pokaži stolpce\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	tit				0	ta	Kitajska pretvorba				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	bm_id49745				0	ta	\<bookmark_value\>kitajski sistemi pisanja\</bookmark_value\>\<bookmark_value\>poenostavljena kitajščina;v tradicionalno kitajščino\</bookmark_value\>\<bookmark_value\>tradicionalna kitajščina;v poenostavljeno kitajščino\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10547				0	ta	\<link href=\"text/shared/01/06010600.xhp\"\>Kitajski prevod\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10557				0	ta	\<ahelp hid=\".\"\>Izbrano kitajsko besedilo se prevede iz enega kitajskega sistema pisanja v drugega. Če niste izbrali besedila, se prevede celotni dokument.\</ahelp\> Ta ukaz lahko uporabljate le, če je omogočena podpora za azijske jezike v \<emph\>Orodja - Možnosti - Nastavitve jezika - Jeziki\</emph\>.				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10572				0	ta	Smer pretvorbe				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10576				0	ta	\<ahelp hid=\".\"\>Izberite smer prevoda.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10579				0	ta	Iz tradicionalne kitajščine v poenostavljeno kitajščino				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1057D				0	ta	\<ahelp hid=\".\"\>Znaki besedila v tradicionalni kitajščini se prevedejo v znake besedila v poenostavljeni kitajščini. Kliknite \<emph\>V redu\</emph\>, če želite prevesti izbrano besedilo. Če niste izbrali besedila, se prevede celotni dokument.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10580				0	ta	Iz poenostavljene kitajščine v tradicionalno kitajščino				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10584				0	ta	\<ahelp hid=\".\"\>Znaki besedila v poenostavljeni kitajščini se prevedejo v znake besedila v tradicionalni kitajščini. Kliknite \<emph\>V redu\</emph\>, če želite prevesti izbrano besedilo. Če niste izbrali besedila, se prevede celotni dokument.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1058E				0	ta	Pogosti izrazi				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10592				0	ta	\<ahelp hid=\".\"\>Pogosti izrazi so besede, ki imajo v tradicionalni in poenostavljeni kitajščini isti pomen, vendar pa so zapisane z drugačnimi znaki.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10595				0	ta	Prevedi pogoste izraze				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10599				0	ta	\<ahelp hid=\".\"\>Prevedejo se besede z dvema ali več znaki, ki so na seznamu pogostih izrazov. Ko je seznam pregledan, se preostalo besedilo prevede znak za znakom.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1059C				0	ta	Uredi izraze				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN105A0				0	ta	\<ahelp hid=\".\"\>Odpre pogovorno okno\<link href=\"text/shared/01/06010601.xhp\"\>Uredi slovar\</link\>, v katerem lahko uredite seznam prevedov izrazov.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	tit				0	ta	Komentar				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	hd_id3083278				0	ta	Komentar				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	par_id3148983				0	ta	\<variable id=\"kommentartext\"\>\<ahelp hid=\"HID_REDLINING_EDIT\"\>Vnesite komentar za zapisano spremembo.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	par_id3155391	3			0	ta	Komentar lahko priložite, ko \<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>je kazalka na spremenjenem odlomku besedila\</caseinline\>,\<caseinline select=\"CALC\"\>je izbrana spremenjena celica\</caseinline\>\</switchinline\>, ali v pogovornem oknu \<emph\>Sprejmi ali zavrni spremembe\</emph\>.				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	par_id3156426	5			0	ta	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>Komentarji so prikazani kot oblački na listu, ko z miškinim kazalcem nekaj časa mirujete nad celico z zapisano spremembo. Komentarje, ki so priloženi k spremenjeni celici, si lahko ogledate tudi na seznamu sprememb v pogovornem oknu \<link href=\"text/shared/01/02230400.xhp\" name=\"Sprejmi ali zavrni spremembe\"\>\<emph\>Sprejmi ali zavrni spremembe\</emph\>\</link\>. \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	tit				0	ta	Seznam regularnih izrazov				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	bm_id3146765				0	ta	\<bookmark_value\>regularni izrazi; seznam vseh\</bookmark_value\>\<bookmark_value\>seznami;regularni izrazi\</bookmark_value\>\<bookmark_value\>zamenjevanje;tabulatorska mesta (regularni izrazi)\</bookmark_value\>\<bookmark_value\>tabulatorska mesta;regularni izrazi\</bookmark_value\>\<bookmark_value\>konkatenacija, glejte simbol &\</bookmark_value\>\<bookmark_value\>simbol &, glejte tudi operatorji\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	hd_id3146765				0	ta	\<variable id=\"02100001\"\>\<link href=\"text/shared/01/02100001.xhp\"\>Seznam regularnih izrazov\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149741				0	ta	Znak				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155577				0	ta	Rezultat/Uporabi				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id6600543				0	ta	Vsak znak				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9824518.00000001				0	ta	Predstavlja dani znak, če ni navedeno drugače.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152427				0	ta	.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149031				0	ta	Predstavlja vsak posamezen znak, razen preloma vrstice ali preloma odstavka. Primer: iskalni pogoj "kr.tek" najde tako "kratek" kot "krotek".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154682				0	ta	^				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155351				0	ta	Iskani izraz najde samo, če se ta nahaja na začetku odstavka. Posebni predmeti na začetku odstavka, kot so prazna polja ali kot znaki zasidrani okviri, so prezrti. Primer: "^Peter".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3159194				0	ta	$				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152542				0	ta	Iskani izraz najde samo, če se ta pojavlja na koncu odstavka. Posebni predmeti na koncu odstavka, kot so prazna polja ali kot znaki zasidrani okviri, so prezrti. Primer: "Peter$".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156414				0	ta	*				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155555				0	ta	Najde nič ali več znakov pred "*". Primer: "Ab*c" najde "Ac", "Abc", "Abbc", "Abbbc", in tako naprej.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147399				0	ta	+				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3157958				0	ta	Najde enega ali več znakov pred "+". Primer: "AX.+4" najde "AXx4", vendar ne "AX4".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145313				0	ta	Najdaljši možni niz v odstavku, ki se ujema s tem iskalnim vzorcem, je vedno najden. Če odstavek vsebuje niz "AX 4 AX4", je označen celoten odlomek.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3143267				0	ta	?				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153684				0	ta	Najde nič ali enega izmed znakov pred "?". Primer: "fant?" najde "fant" in "fantje", "x(ab|c)?y" najde "xy", "xaby", ali "xcy".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3166410				0	ta	\\				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147209				0	ta	Poseben znak, ki sledi "\\" iskanje tolmači kot normalen znak in ne kot regularen izraz (razen kombinacij \\n, \\t, \\> in \\<). Primer: "drva\\." najde "drva.", ne najde pa "drvar" ali "drvača".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152945				0	ta	\\n				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153700				0	ta	Predstavlja prelom vrstice, ki je bil vstavljen s kombinacijo tipk Shift+Enter. Če želite prelom vrstice spremeniti v prelom odstavka, v polji \<emph\>Išči\</emph\> in \<emph\>Zamenjaj z\</emph\> vnesite \<emph\>\\n\</emph\> in nato izvršite ukaz najdi in zamenjaj.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9262672				0	ta	\\n v polju \<emph\>Išči\</emph\> pomeni prelom vrstice, vstavljen s kombinacijo tipk Shift+Enter.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id2366100				0	ta	\\n v polju \<emph\>Zamenjaj z\</emph\> pomeni prelom odstavka, ki se ga lahko vstavi s tipko Enter ali Return.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153258				0	ta	\\t				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3157809				0	ta	Predstavlja tabulator. Ta izraz lahko uporabite tudi v polju \<emph\>Zamenjaj z\</emph\>.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150670				0	ta	\\b				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153666				0	ta	Ujemanje roba besede. "\\bljub" npr. najde "ljuba", ne pa tudi "poljub", medtem ko "ljub\\b" najde "poljuga", ne pa tudi "ljuba". Besedo "ljub" najdeta oba iskalna niza.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149576				0	ta	^$				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3151245				0	ta	Najde prazen odstavek.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148550				0	ta	^.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3159413				0	ta	Najde prvi znak v odstavku.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147282				0	ta	& ali $0				20200411 15:09:53
