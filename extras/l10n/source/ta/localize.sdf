helpcontent2	source\text\scalc\01\04060108.xhp	0	help	par_id3154816				0	ta	3				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060108.xhp	0	help	par_id3149276				0	ta	7				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060108.xhp	0	help	par_id3149267				0	ta	2				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060108.xhp	0	help	par_id3156310				0	ta	4				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060108.xhp	0	help	par_id3154639				0	ta	8				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060108.xhp	0	help	par_id3145205				0	ta	4				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060108.xhp	0	help	par_id3153276				0	ta	6				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060108.xhp	0	help	par_id3150756				0	ta	9				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060108.xhp	0	help	par_id3156095				0	ta	6				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060108.xhp	0	help	par_id3152929				0	ta	8				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060108.xhp	0	help	par_id3156324				0	ta	The statistical functions are described in the following subsections.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060108.xhp	0	help	par_id3150271				0	ta	\<link href=\"text/scalc/01/04060116.xhp\" name=\"Statistical Functions in the Analysis-AddIn.\"\>Statistical Functions in the Analysis-AddIn\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	tit				0	ta	Statistical Functions Part Four				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153415				0	ta	\<variable id=\"mq\"\>\<link href=\"text/scalc/01/04060184.xhp\" name=\"Statistical Functions Part Four\"\>Statistical Functions Part Four\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3154511				0	ta	\<bookmark_value\>MAX function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154511				0	ta	MAX				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153709				0	ta	\<ahelp hid=\"HID_FUNC_MAX\"\>Returns the maximum value in a list of arguments.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id9282509				0	ta	Returns 0 if no numeric value and no error was encountered in the cell range(s) passed as cell reference(s). Text cells are ignored by MIN() and MAX(). The functions MINA() and MAXA() return 0 if no value (numeric or text) and no error was encountered. Passing a literal string argument to MIN() or MAX(), e.g. MIN("string"), still results in an error.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154256				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147340				0	ta	MAX(Number1; Number2; ...Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149568	6			0	ta	\<emph\>Number1; Number2;...Number30\</emph\> are numerical values or ranges. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153963				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147343				0	ta	\<item type=\"input\"\>=MAX(A1;A2;A3;50;100;200)\</item\> returns the largest value from the list.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148485				0	ta	\<item type=\"input\"\>=MAX(A1:B100)\</item\> returns the largest value from the list.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3166426				0	ta	\<bookmark_value\>MAXA function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3166426				0	ta	MAXA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150363				0	ta	\<ahelp hid=\"HID_FUNC_MAXA\"\>Returns the maximum value in a list of arguments. In opposite to MAX, here you can enter text. The value of the text is 0.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id7689443				0	ta	The functions MINA() and MAXA() return 0 if no value (numeric or text) and no error was encountered.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150516				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3166431				0	ta	MAXA(Value1; Value2; ... Value30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150202				0	ta	\<emph\>Value1; Value2;...Value30\</emph\> are values or ranges. Text has the value of 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3156290				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156446				0	ta	\<item type=\"input\"\>=MAXA(A1;A2;A3;50;100;200;"Text")\</item\> returns the largest value from the list.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149404				0	ta	\<item type=\"input\"\>=MAXA(A1:B100)\</item\> returns the largest value from the list.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153820				0	ta	\<bookmark_value\>MEDIAN function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153820				0	ta	MEDIAN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151241				0	ta	\<ahelp hid=\"HID_FUNC_MEDIAN\"\>Returns the median of a set of numbers. In a set containing an uneven number of values, the median will be the number in the middle of the set and in a set containing an even number of values, it will be the mean of the two values in the middle of the set.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148871				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155264				0	ta	MEDIAN(Number1; Number2; ...Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150109				0	ta	\<emph\>Number1; Number2;...Number30\</emph\> are values or ranges, which represent a sample. Each number can also be replaced by a reference.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3144506				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145078				0	ta	for an odd number: \<item type=\"input\"\>=MEDIAN(1;5;9;20;21)\</item\> returns 9 as the median value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149126				0	ta	for an even number: \<item type=\"input\"\>=MEDIAN(1;5;9;20)\</item\> returns the average of the two middle values 5 and 9, thus 7.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3154541				0	ta	\<bookmark_value\>MIN function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154541				0	ta	MIN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3143222				0	ta	\<ahelp hid=\"HID_FUNC_MIN\"\>Returns the minimum value in a list of arguments.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id2301400				0	ta	Returns 0 if no numeric value and no error was encountered in the cell range(s) passed as cell reference(s). Text cells are ignored by MIN() and MAX(). The functions MINA() and MAXA() return 0 if no value (numeric or text) and no error was encountered. Passing a literal string argument to MIN() or MAX(), e.g. MIN("string"), still results in an error.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154651				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146964				0	ta	MIN(Number1; Number2; ...Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153486				0	ta	\<emph\>Number1; Number2;...Number30\</emph\> are numerical values or ranges.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155523				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154734				0	ta	\<item type=\"input\"\>=MIN(A1:B100)\</item\> returns the smallest value in the list.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3147504				0	ta	\<bookmark_value\>MINA function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147504				0	ta	MINA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147249				0	ta	\<ahelp hid=\"HID_FUNC_MINA\"\>Returns the minimum value in a list of arguments. Here you can also enter text. The value of the text is 0.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id4294564				0	ta	The functions MINA() and MAXA() return 0 if no value (numeric or text) and no error was encountered.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150435				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153336				0	ta	MINA(Value1; Value2; ... Value30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146098				0	ta	\<emph\>Value1; Value2;...Value30\</emph\> are values or ranges. Text has the value of 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148743				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147401				0	ta	\<item type=\"input\"\>=MINA(1;"Text";20)\</item\> returns 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147295				0	ta	\<item type=\"input\"\>=MINA(A1:B100)\</item\> returns the smallest value in the list.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3166465				0	ta	\<bookmark_value\>AVEDEV function\</bookmark_value\>\<bookmark_value\>averages;statistical functions\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3166465				0	ta	AVEDEV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150373				0	ta	\<ahelp hid=\"HID_FUNC_MITTELABW\"\>Returns the average of the absolute deviations of data points from their mean.\</ahelp\> Displays the diffusion in a data set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150038				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145636				0	ta	AVEDEV(Number1; Number2; ...Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3157871				0	ta	\<emph\>Number1, Number2,...Number30\</emph\> are values or ranges that represent a sample. Each number can also be replaced by a reference.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149725				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153122				0	ta	            \<item type=\"input\"\>=AVEDEV(A1:A50)\</item\>         				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3145824				0	ta	\<bookmark_value\>AVERAGE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3145824				0	ta	AVERAGE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150482				0	ta	\<ahelp hid=\"HID_FUNC_MITTELWERT\"\>Returns the average of the arguments.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3146943				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154679				0	ta	AVERAGE(Number1; Number2; ...Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150741				0	ta	\<emph\>Number1; Number2;...Number 0\</emph\> are numerical values or ranges.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153039				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151232				0	ta	\<item type=\"input\"\>=AVERAGE(A1:A50)\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148754				0	ta	\<bookmark_value\>AVERAGEA function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148754				0	ta	AVERAGEA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145138				0	ta	\<ahelp hid=\"HID_FUNC_MITTELWERTA\"\>Returns the average of the arguments. The value of a text is 0.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153326				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149734				0	ta	AVERAGEA(Value1; Value2; ... Value30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155260				0	ta	\<emph\>Value1; Value2;...Value30\</emph\> are values or ranges. Text has the value of 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149504				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150864				0	ta	\<item type=\"input\"\>=AVERAGEA(A1:A50)\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148754K1				0	ta	\<bookmark_value\>AVERAGEIF function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148754K1				0	ta	AVERAGEIF				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145138K1				0	ta	\<ahelp hid=\"HID_FUNC_MITTELWERTB\"\>Average the values of cells in a range that meet a criteria.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153326K1				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149734K1				0	ta	AVERAGEIF( Reference R ; Criterion C [ ; Reference A ] )				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155260K1				0	ta	 If reference A is omitted, averages the values of cells in the reference range R that meet the Criterion C. If reference A is given, averages the values of cells of a range that is constructed using the top left cell of reference A and applying the dimensions, shape and size, of reference R.  Does not accept constant values as reference parameters.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145139K1				0	ta	If no cell in range R matches the Criterion C, an Error is returned. If no Numbers are in the range to be averaged, an Error is returned.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149504K1				0	ta	Examples				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150864K1				0	ta	\<item type=\"input\"\>=AVERAGEIF(A1:A50;">"0)\</item\>will return the average of A1:A50 of all positive values in the range.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148754K2				0	ta	\<bookmark_value\>AVERAGEIFS function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148754K2				0	ta	AVERAGEIFS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145138K2				0	ta	\<ahelp hid=\"HID_FUNC_MITTELWERTC\"\>Average the values of cells that meet multiple criteria in multiple ranges.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153326K2				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149734K2				0	ta	AVERAGEIFS( Reference A ; Reference R1 ; Criterion C1 [ ; Reference R2 ; Criterion C2 ]... )				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155260K2				0	ta	Averages the values of cells in the reference range A that meet the Criterion C1 in the reference range R1 and the Criterion C2 in the reference range R2, and so on.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145139K2				0	ta	All reference ranges shall have the same dimension and size, else an Error is returned. A logical AND is applied between each array result of each selection; a cell of reference range A is evaluated only if the same position in each array is the result of a Criterion match. If no numbers are in the result set to be averaged, an Error is returned.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149504K2				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150864K2				0	ta	\<item type=\"input\"\>=AVERAGEIFS(A1:A50;B1:B25;">"0)\</item\>+will return the average of A1:A50 if all cells in the range B1 to B25 are greater than 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153933				0	ta	\<bookmark_value\>MODE function\</bookmark_value\>\<bookmark_value\>most common value\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153933				0	ta	MODE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153085				0	ta	\<ahelp hid=\"HID_FUNC_MODALWERT\"\>Returns the most common value in a data set.\</ahelp\> If there are several values with the same frequency, it returns the smallest value. An error occurs when a value doesn't appear twice.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153003				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155950				0	ta	MODE(Number1; Number2; ...Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150337				0	ta	\<emph\>Number1; Number2;...Number30\</emph\> are numerical values or ranges.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153571				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153733				0	ta	\<item type=\"input\"\>=MODE(A1:A50)\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3149879				0	ta	\<bookmark_value\>NEGBINOMDIST function\</bookmark_value\>\<bookmark_value\>negative binomial distribution\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149879				0	ta	NEGBINOMDIST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155437				0	ta	\<ahelp hid=\"HID_FUNC_NEGBINOMVERT\"\>Returns the negative binomial distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3145351				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150935				0	ta	NEGBINOMDIST(X; R; SP)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153044				0	ta	\<emph\>X\</emph\> represents the value returned for unsuccessful tests.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151018				0	ta	\<emph\>R\</emph\> represents the value returned for successful tests.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148878				0	ta	\<emph\>SP\</emph\> is the probability of the success of an attempt.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149539				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148770				0	ta	\<item type=\"input\"\>=NEGBINOMDIST(1;1;0.5)\</item\> returns 0.25.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3155516				0	ta	\<bookmark_value\>NORMINV function\</bookmark_value\>\<bookmark_value\>normal distribution;inverse of\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155516				0	ta	NORMINV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154634				0	ta	\<ahelp hid=\"HID_FUNC_NORMINV\"\>Returns the inverse of the normal cumulative distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153227				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147534				0	ta	NORMINV(Number; Mean; StDev)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154950				0	ta	\<emph\>Number\</emph\> represents the probability value used to determine the inverse normal distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150690				0	ta	\<emph\>Mean\</emph\> represents the mean value in the normal distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148594				0	ta	\<emph\>StDev\</emph\> represents the standard deviation of the normal distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155822				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153921				0	ta	\<item type=\"input\"\>=NORMINV(0.9;63;5)\</item\> returns 69.41. If the average egg weighs 63 grams with a standard deviation of 5, then there will be 90% probability that the egg will not be heavier than 69.41g grams.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153722				0	ta	\<bookmark_value\>NORMDIST function\</bookmark_value\>\<bookmark_value\>density function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153722				0	ta	NORMDIST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150386				0	ta	\<ahelp hid=\"HID_FUNC_NORMVERT\"\>Returns the density function or the normal cumulative distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3083282				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150613				0	ta	NORMDIST(Number; Mean; StDev; C)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149820				0	ta	\<emph\>Number\</emph\> is the value of the distribution based on which the normal distribution is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146063				0	ta	\<emph\>Mean\</emph\> is the mean value of the distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156295				0	ta	\<emph\>StDev\</emph\> is the standard deviation of the distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145080				0	ta	\<emph\>C\</emph\> is optional. \<emph\>C\</emph\> = 0 calculates the density function, \<emph\>C\</emph\> = 1 calculates the distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152972				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149283				0	ta	\<item type=\"input\"\>=NORMDIST(70;63;5;0)\</item\> returns 0.03.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149448				0	ta	\<item type=\"input\"\>=NORMDIST(70;63;5;1)\</item\> returns 0.92.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3152934				0	ta	\<bookmark_value\>PEARSON function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152934				0	ta	PEARSON				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153216				0	ta	\<ahelp hid=\"HID_FUNC_PEARSON\"\>Returns the Pearson product moment correlation coefficient r.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147081				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156133				0	ta	PEARSON(Data1; Data2)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151272				0	ta	\<emph\>Data1\</emph\> represents the array of the first data set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153279				0	ta	\<emph\>Data2\</emph\> represents the array of the second data set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147567				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151187				0	ta	\<item type=\"input\"\>=PEARSON(A1:A30;B1:B30)\</item\> returns the Pearson correlation coefficient of both data sets.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3152806				0	ta	\<bookmark_value\>PHI function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152806				0	ta	PHI				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150254				0	ta	\<ahelp hid=\"HID_FUNC_PHI\"\>Returns the values of the distribution function for a standard normal distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154748				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149976				0	ta	PHI(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156108				0	ta	\<emph\>Number\</emph\> represents the value based on which the standard normal distribution is calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153621				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155849				0	ta	\<item type=\"input\"\>=PHI(2.25) \</item\>= 0.03				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3143236				0	ta	\<item type=\"input\"\>=PHI(-2.25)\</item\> = 0.03				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149286				0	ta	\<item type=\"input\"\>=PHI(0)\</item\> = 0.4				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153985				0	ta	\<bookmark_value\>POISSON function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153985				0	ta	POISSON				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154298				0	ta	\<ahelp hid=\"HID_FUNC_POISSON\"\>Returns the Poisson distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3159183				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146093				0	ta	POISSON(Number; Mean; C)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147253				0	ta	\<emph\>Number\</emph\> represents the value based on which the Poisson distribution is calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151177				0	ta	\<emph\>Mean\</emph\> represents the middle value of the Poisson distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149200				0	ta	\<emph\>C\</emph\> (optional) = 0 or False calculates the density function; \<emph\>C\</emph\> = 1 or True calculates the distribution. When omitted, the default value True is inserted when you save the document, for best compatibility with other programs and older versions of %PRODUCTNAME.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3159347				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150113				0	ta	\<item type=\"input\"\>=POISSON(60;50;1)\</item\> returns 0.93.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153100				0	ta	\<bookmark_value\>PERCENTILE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153100				0	ta	PERCENTILE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154940				0	ta	\<ahelp hid=\"HID_FUNC_QUANTIL\"\>Returns the alpha-percentile of data values in an array.\</ahelp\> A percentile returns the scale value for a data series which goes from the smallest (Alpha=0) to the largest value (alpha=1) of a data series. For \<item type=\"literal\"\>Alpha\</item\> = 25%, the percentile means the first quartile; \<item type=\"literal\"\>Alpha\</item\> = 50% is the MEDIAN.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150531				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148813				0	ta	PERCENTILE(Data; Alpha)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153054				0	ta	\<emph\>Data\</emph\> represents the array of data.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154212				0	ta	\<emph\>Alpha\</emph\> represents the percentage of the scale between 0 and 1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154290				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159147				0	ta	\<item type=\"input\"\>=PERCENTILE(A1:A50;0.1)\</item\> represents the value in the data set, which equals 10% of the total data scale in A1:A50.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148807				0	ta	\<bookmark_value\>PERCENTRANK function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148807				0	ta	PERCENTRANK				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153573				0	ta	\<ahelp hid=\"HID_FUNC_QUANTILSRANG\"\>Returns the percentage rank of a value in a sample.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147512				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147238				0	ta	PERCENTRANK(Data; Value)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154266				0	ta	\<emph\>Data\</emph\> represents the array of data in the sample.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148475				0	ta	\<emph\>Value\</emph\> represents the value whose percentile rank must be determined.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155364				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149163				0	ta	\<item type=\"input\"\>=PERCENTRANK(A1:A50;50)\</item\> returns the percentage rank of the value 50 from the total range of all values found in A1:A50. If 50 falls outside the total range, an error message will appear.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3166442				0	ta	\<bookmark_value\>QUARTILE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3166442				0	ta	QUARTILE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146958				0	ta	\<ahelp hid=\"HID_FUNC_QUARTILE\"\>Returns the quartile of a data set.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152942				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153684				0	ta	QUARTILE(Data; Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153387				0	ta	\<emph\>Data\</emph\> represents the array of data in the sample.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155589				0	ta	\<emph\>Type\</emph\> represents the type of quartile. (0 = MIN, 1 = 25%, 2 = 50% (MEDIAN), 3 = 75% and 4 = MAX.)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149103				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159276				0	ta	\<item type=\"input\"\>=QUARTILE(A1:A50;2)\</item\> returns the value of which 50% of the scale corresponds to the lowest to highest values in the range A1:A50.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	tit				0	ta	Hyphenation				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	bm_id3159399				0	ta	\<bookmark_value\>automatic hyphenation in spreadsheets\</bookmark_value\>\<bookmark_value\>hyphenation; in spreadsheets\</bookmark_value\>\<bookmark_value\>syllables in spreadsheets\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	hd_id3159399				0	ta	Hyphenation				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3145068	2			0	ta	\<variable id=\"silben\"\>\<ahelp hid=\".uno:Hyphenate\"\>The \<emph\>Hyphenation \</emph\>command calls the dialog for setting the hyphenation in $[officename] Calc.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3154366				0	ta	You can only turn on the automatic hyphenation in $[officename] Calc when the \<link href=\"text/shared/01/05340300.xhp\" name=\"row break\"\>row break\</link\> feature is active.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	hd_id3153192				0	ta	Hyphenation for selected cells.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3150868				0	ta	Select the cells for which you want to change the hyphenation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3150440				0	ta	Choose \<emph\>Tools - Language - Hyphenation\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3156441				0	ta	The \<emph\>Format Cells\</emph\> dialog appears with the \<emph\>Alignment\</emph\> tab page open.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3149260				0	ta	Mark the \<emph\>Wrap text automatically\</emph\> and \<emph\>Hyphenation active\</emph\> check boxes.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	hd_id3153094				0	ta	Hyphenation for Drawing Objects				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3148577				0	ta	Select a drawing object.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3156285				0	ta	Choose \<emph\>Tools - Language - Hyphenation\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3147394				0	ta	Each time you call the command you turn the hyphenation for the drawing object on or off. A check mark shows the current status.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	tit				0	ta	NOW				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	bm_id3150521				0	ta	\<bookmark_value\>NOW function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	hd_id3150521				0	ta	\<variable id=\"now\"\>\<link href=\"text/scalc/01/func_now.xhp\"\>NOW\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	par_id3148829				0	ta	\<ahelp hid=\"HID_FUNC_JETZT\"\>Returns the computer system date and time.\</ahelp\> The value is updated when you recalculate the document or each time a cell value is modified.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	hd_id3146988				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	par_id3154897				0	ta	NOW()				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	par_id4598529				0	ta	NOW is a function without arguments.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	hd_id3154205				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	par_id3150774				0	ta	\<item type=\"input\"\>=NOW()-A1\</item\> returns the difference between the date in A1 and now. Format the result as a number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	tit				0	ta	TIMEVALUE 				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	bm_id3146755				0	ta	\<bookmark_value\>TIMEVALUE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	hd_id3146755				0	ta	\<variable id=\"timevalue\"\>\<link href=\"text/scalc/01/func_timevalue.xhp\"\>TIMEVALUE\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3148502				0	ta	\<ahelp hid=\"HID_FUNC_ZEITWERT\"\>TIMEVALUE returns the internal time number from a text enclosed by quotes and which may show a possible time entry format.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3150794				0	ta	The internal number indicated as a decimal is the result of the date system used under $[officename] to calculate date entries.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id011920090347118				0	ta	If the text string also includes a year, month, or day, TIMEVALUE only returns the fractional part of the conversion.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	hd_id3150810				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3150823				0	ta	TIMEVALUE("Text")				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3152556	165			0	ta	         \<emph\>Text\</emph\> is a valid time expression and must be entered in quotation marks.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	hd_id3146815				0	ta	Examples				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3146829	167			0	ta	         \<item type=\"input\"\>=TIMEVALUE("4PM")\</item\> returns 0.67. When formatting in time format HH:MM:SS, you then get 16:00:00.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3153632	168			0	ta	         \<item type=\"input\"\>=TIMEVALUE("24:00")\</item\> returns 1. If you use the HH:MM:SS time format, the value is 00:00:00.				20200411 15:09:53
