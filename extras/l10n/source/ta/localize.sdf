helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	hd_id3153379				0	ta	\<link href=\"text/sbasic/shared/03010102.xhp\" name=\"MsgBox Function [Runtime]\"\>MsgBox Function [Runtime]\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3145171				0	ta	Displays a dialog box containing a message and returns a value.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	hd_id3156281				0	ta	Syntax:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3154685				0	ta	MsgBox (Text As String [,Type As Integer [,Dialogtitle As String]])				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	hd_id3153771				0	ta	Return value:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3146985				0	ta	Integer				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	hd_id3153363				0	ta	Parameter:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3153727	8			0	ta	\<emph\>Text\</emph\>: String expression displayed as a message in the dialog box. Line breaks can be inserted with Chr$(13).				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3147317	9			0	ta	\<emph\>DialogTitle\</emph\>: String expression displayed in the title bar of the dialog. If omitted, the name of the respective application is displayed.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3153954	10			0	ta	\<emph\>Type\</emph\>: Any integer expression that specifies the dialog type and defines the number and type of buttons or icons displayed. \<emph\>Type\</emph\> represents a combination of bit patterns (dialog elements defined by adding the respective values):				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3154319	11			0	ta	\<emph\>Values\</emph\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3147397				0	ta	0 : Display OK button only.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3145646				0	ta	1 : Display OK and Cancel buttons.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3149410				0	ta	2 : Display Abort, Retry, and Ignore buttons.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3151075				0	ta	3 : Display Yes, No, and Cancel buttons.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3153878				0	ta	4 : Display Yes and No buttons.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3155601				0	ta	5 : Display Retry and Cancel buttons.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3150716				0	ta	16 : Add the Stop icon to the dialog.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3153837				0	ta	32 : Add the Question icon to the dialog.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3150751				0	ta	48 : Add the Exclamation Point icon to the dialog.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3146915				0	ta	64 : Add the Information icon to the dialog.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3145640				0	ta	128 : First button in the dialog as default button.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3153765				0	ta	256 : Second button in the dialog as default button.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3153715				0	ta	512 : Third button in the dialog as default button.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3159267				0	ta	\<emph\>Return value:\</emph\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3145230				0	ta	1 : OK				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3149567				0	ta	2 : Cancel				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id4056825				0	ta	3 : Abort				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3155335				0	ta	4 : Retry				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3146918				0	ta	5 : Ignore				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3155961				0	ta	6 : Yes				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3148488				0	ta	7 : No				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	hd_id3150090				0	ta	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3154120				0	ta	Sub ExampleMsgBox				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3145131				0	ta	Dim sVar as Integer				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3151278				0	ta	sVar = MsgBox("Las Vegas")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3149034				0	ta	sVar = MsgBox("Las Vegas",1)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3166424				0	ta	sVar = MsgBox( "Las Vegas",256 + 16 + 2,"Dialog title")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010102.xhp	0	help	par_id3152581				0	ta	end sub				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	tit				0	ta	InputBox Function [Runtime]				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	bm_id3148932				0	ta	\<bookmark_value\>InputBox function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	hd_id3148932				0	ta	\<link href=\"text/sbasic/shared/03010201.xhp\" name=\"InputBox Function [Runtime]\"\>InputBox Function [Runtime]\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	par_id3151262				0	ta	Displays a prompt in a dialog at which the user can input text. The input is assigned to a variable.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	par_id3151100				0	ta	The \<emph\>InputBox\</emph\> statement is a convenient method of entering text through a dialog. Confirm the input by clicking OK or pressing Return. The input is returned as the function return value. If you close the dialog with Cancel, \<emph\>InputBox\</emph\> returns a zero-length string ("").				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	hd_id3152347				0	ta	Syntax:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	par_id3159201	5			0	ta	InputBox (Msg As String[, Title As String[, Default As String[, x_pos As Integer, y_pos As Integer]]]]) 				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	hd_id3150713				0	ta	Return value:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	par_id3145090				0	ta	String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	hd_id3149346				0	ta	Parameter:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	par_id3153311	9			0	ta	\<emph\>Msg\</emph\>: String expression displayed as the message in the dialog box.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	par_id3145315	10			0	ta	\<emph\>Title\</emph\>: String expression displayed in the title bar of the dialog box.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	par_id3154307	11			0	ta	\<emph\>Default\</emph\>: String expression displayed in the text box as default if no other input is given.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	par_id3147573	12			0	ta	\<emph\>x_pos\</emph\>: Integer expression that specifies the horizontal position of the dialog. The position is an absolute coordinate and does not refer to the window of the office application.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	par_id3156024	13			0	ta	\<emph\>y_pos\</emph\>: Integer expression that specifies the vertical position of the dialog. The position is an absolute coordinate and does not refer to the window of the office application.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	par_id3153897				0	ta	If \<emph\>x_pos\</emph\> and \<emph\>y_pos\</emph\> are omitted, the dialog is centered on the screen. The position is specified in \<link href=\"text/sbasic/shared/00000002.xhp#twips\" name=\"twips\"\>twips\</link\>.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	hd_id3149456				0	ta	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	par_id3153379				0	ta	Sub ExampleInputBox				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	par_id3149656				0	ta	Dim sText As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	par_id3154367				0	ta	sText = InputBox ("Please enter a phrase:","Dear User")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	par_id3151042				0	ta	MsgBox ( sText , 64, "Confirmation of phrase")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	par_id3150768				0	ta	End Sub				20200411 15:09:53
