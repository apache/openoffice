helpcontent2	source\text\shared\01\02230401.xhp	0	help	par_id3155552	29			0	ta	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>Če si želite ogledati vse spremembe, zabeležene za celico, kliknite znak plus poleg vnosa na seznamu. \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02230401.xhp	0	help	par_id3154824	31			0	ta	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>Če se ena izmed gnezdenih sprememb ujema s pogojem filtriranja, so prikazane vse spremembe za celico. Ko filtrirate seznam sprememb, se vnosi na seznamu pojavijo v različnih barvah, v skladu z naslednjo tabelo: \</caseinline\>\</switchinline\>				20200411 15:09:53
