helpcontent2	source\text\sbasic\shared\03120312.xhp	0	help	hd_id3150984				0	ta	Return value:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120312.xhp	0	help	par_id3147530				0	ta	String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120312.xhp	0	help	hd_id3148550				0	ta	Parameters:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120312.xhp	0	help	par_id3148947				0	ta	\<emph\>Filename:\</emph\> A file name as string.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120312.xhp	0	help	hd_id3153361				0	ta	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120312.xhp	0	help	par_id3150792				0	ta	systemFile$ = "c:\\folder\\mytext.txt"				20200411 15:09:53
