helpcontent2	source\text\shared\00\00000208.xhp	0	help	hd_id3145313				0	ta	Comma				20200411 15:09:53
helpcontent2	source\text\shared\00\00000208.xhp	0	help	par_id3150693				0	ta	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_ASCII:CKB_COMMA\"\>Separates data delimited by commas into columns.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000208.xhp	0	help	hd_id3163802				0	ta	Space				20200411 15:09:53
helpcontent2	source\text\shared\00\00000208.xhp	0	help	par_id3153663				0	ta	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_ASCII:CKB_SPACE\"\>Separates data delimited by spaces into columns.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000208.xhp	0	help	hd_id3147335				0	ta	Other				20200411 15:09:53
helpcontent2	source\text\shared\00\00000208.xhp	0	help	par_id3156329				0	ta	\<ahelp hid=\"SC:EDIT:RID_SCDLG_ASCII:ED_OTHER\"\>Separates data into columns using the custom separator that you specify. Note: The custom separator must also be contained in your data.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000208.xhp	0	help	hd_id3150978				0	ta	Merge delimiters				20200411 15:09:53
