helpcontent2	source\text\swriter\guide\insert_graphic_fromdraw.xhp	0	help	bm_id3155917				0	ta	\<bookmark_value\>text; inserting pictures from Draw\</bookmark_value\>\<bookmark_value\>pictures; inserting from Draw\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\swriter\guide\insert_graphic_fromdraw.xhp	0	help	hd_id3155917				0	ta	\<variable id=\"insert_graphic_fromdraw\"\>\<link href=\"text/swriter/guide/insert_graphic_fromdraw.xhp\" name=\"Inserting Graphics From $[officename] Draw or Impress\"\>Inserting Graphics From $[officename] Draw or Impress\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\swriter\guide\insert_graphic_fromdraw.xhp	0	help	par_id3153414				0	ta	Open the document where you want to insert the object.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\insert_graphic_fromdraw.xhp	0	help	par_id3149640				0	ta	Open the Draw or Impress document containing the object that you want to copy.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\insert_graphic_fromdraw.xhp	0	help	par_id3145098				0	ta	Hold down \<item type=\"keycode\"\>Ctrl\</item\> and click and hold the object for a moment.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\insert_graphic_fromdraw.xhp	0	help	par_id3156250				0	ta	Drag to the document where you want to insert the object.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	tit				0	ta	Inserting and Deleting Page Breaks				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	bm_id3155183				0	ta	\<bookmark_value\>page breaks; inserting and deleting\</bookmark_value\>      \<bookmark_value\>inserting; page breaks\</bookmark_value\>      \<bookmark_value\>deleting;page breaks\</bookmark_value\>      \<bookmark_value\>pages; inserting/deleting page breaks\</bookmark_value\>      \<bookmark_value\>manual page breaks\</bookmark_value\>      \<bookmark_value\>tables;deleting page breaks before\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	hd_id3155183				0	ta	\<variable id=\"page_break\"\>\<link href=\"text/swriter/guide/page_break.xhp\" name=\"Inserting and Deleting Page Breaks\"\>Inserting and Deleting Page Breaks\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	hd_id3149833				0	ta	To Insert a Manual Page Break				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	par_id3153402				0	ta	Click in your document where you want the new page to begin.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	par_id3153119				0	ta	Press Ctrl+Enter.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	hd_id3153135				0	ta	To Delete a Manual Page Break				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	par_id3149641				0	ta	Click in front of the first character on the page that follows the manual page break.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	par_id3149608				0	ta	Press Backspace.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	hd_id3149624				0	ta	To Delete a Manual Page Break That Occurs Before a Table				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	par_id3145111				0	ta	Right-click in the table, and choose \<emph\>Table\</emph\>.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	par_id3156254				0	ta	Click the \<link href=\"text/swriter/01/05090300.xhp\" name=\"Text Flow\"\>\<emph\>Text Flow\</emph\>\</link\> tab.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	par_id3153380				0	ta	Clear the \<emph\>Break\</emph\> check box.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	par_id3154249				0	ta	\<link href=\"text/swriter/01/04010000.xhp\" name=\"Insert Break dialog\"\>Insert Break dialog\</link\>				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	tit				0	ta	Defining Index or Table of Contents Entries				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	bm_id3149689				0	ta	\<bookmark_value\>indexes; defining entries in\</bookmark_value\>      \<bookmark_value\>tables of contents; defining entries in\</bookmark_value\>      \<bookmark_value\>entries; defining in indexes/tables of contents\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	hd_id3149689				0	ta	\<variable id=\"indices_enter\"\>\<link href=\"text/swriter/guide/indices_enter.xhp\" name=\"Defining Index or Table of Contents Entries\"\>Defining Index or Table of Contents Entries\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	hd_id3155862				0	ta	To Define Index Entries				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	par_id3156380				0	ta	Click in a word, or select the words in your document that you want to use as an index entry.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	par_id3147409				0	ta	Choose \<emph\>Insert - Indexes and Tables - Entry\</emph\>, and do one of the following:				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	par_id3153417				0	ta	To change the text that appears in the index, type the text that you want in the \<emph\>Entry\</emph\> box. The text that you type here does not replace the selected text in the document.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	par_id3154258				0	ta	To add an index mark to similar words in your document, select \<emph\>Apply to all similar texts\</emph\>.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	par_id3155889				0	ta	To add the entries to a custom index, click the \<emph\>New User-defined Index\</emph\> icon, enter the name of the index, and then click \<emph\>OK\</emph\>.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	hd_id3147119				0	ta	To Define Table of Contents Entries				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	par_id3147132				0	ta	The best way to generate a table of contents is to apply the predefined heading paragraph styles, such as "Heading 1", to the paragraphs that you want to include in your table of contents.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	hd_id3150230				0	ta	To Use a Custom Paragraph Style as a Table of Contents Entry				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	par_id3150933				0	ta	Choose \<emph\>Tools - Outline Numbering\</emph\> and click the \<emph\>Numbering\</emph\> tab.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	par_id3150964				0	ta	Select the paragraph style that you want to include in your table of contents in the \<emph\>Paragraph Style\</emph\> box.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	par_id3150523				0	ta	In the \<emph\>Level\</emph\> list, click the hierarchical level that you want to apply the paragraph style to.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	par_id3153730	17			0	ta	Click \<emph\>OK\</emph\>. You can now apply the style to headings in your document and include them in your table of contents. 				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	tit				0	ta	Defining Borders for Objects 				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	bm_id3146957				0	ta	\<bookmark_value\>objects; defining borders\</bookmark_value\>      \<bookmark_value\>borders; for objects\</bookmark_value\>      \<bookmark_value\>frames; around objects\</bookmark_value\>      \<bookmark_value\>charts;borders\</bookmark_value\>      \<bookmark_value\>pictures;borders\</bookmark_value\>      \<bookmark_value\>OLE objects;borders\</bookmark_value\>      \<bookmark_value\>defining;object borders\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	hd_id3146957				0	ta	\<variable id=\"border_object\"\>\<link href=\"text/swriter/guide/border_object.xhp\" name=\"Defining Borders for Objects\"\>Defining Borders for Objects\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	par_id3146797				0	ta	In Writer, you can define borders around OLE objects, plug-ins, diagrams/charts, graphics and frames. The name of the menu to be used depends on the object selected.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	hd_id3145673				0	ta	To Set a Predefined Border Style				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	par_id3155388				0	ta	Select the object for which you want to define a border.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	par_id3149578	4			0	ta	Click the \<emph\>Borders\</emph\> icon on the \<emph\>OLE-Object\</emph\> toolbar or \<emph\>Frame\</emph\> toolbar to open the \<emph\>Borders\</emph\> window. 				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	par_id3159176				0	ta	Click one of the predefined border styles. This replaces the current border style of the object with the selected style.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	hd_id3152474				0	ta	To Set a Customized Border Style				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	par_id3153896				0	ta	Select the table cells that you want to modify.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	par_id3156344	9			0	ta	Choose \<item type=\"menuitem\"\>Format - (object name) – Borders\</item\>.\<br/\>Replace (object name) with the actual name of the object type you selected.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	par_id3148797				0	ta	In the \<emph\>User-defined\</emph\> area select the edge(s) that you want to appear in a common layout. Click on an edge in the preview to toggle the selection of an edge.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	par_id3152933				0	ta	Select a line style and color for the selected border style in the \<emph\>Line\</emph\> area. These settings apply to all border lines that are included in the selected border style.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	par_id3125865				0	ta	Repeat the last two steps for every border edge.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	par_id3150447				0	ta	Select the distance between the border lines and the page contents in the \<emph\>Spacing to Contents\</emph\> area.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	par_id3154908				0	ta	Click \<emph\>OK\</emph\> to apply the changes.				20200411 15:09:53
helpcontent2	source\text\swriter\01\05130004.xhp	0	help	tit				0	ta	Numbering Style 				20200411 15:09:53
helpcontent2	source\text\swriter\01\05130004.xhp	0	help	hd_id3155961				0	ta	\<link href=\"text/swriter/01/05130004.xhp\" name=\"Numbering Style\"\>Numbering Style\</link\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05130004.xhp	0	help	par_id3149501				0	ta	Here you can create a Numbering Style. The Numbering Styles are organized in the \<link href=\"text/swriter/01/05140000.xhp\" name=\"Styles and Formatting\"\>Styles and Formatting\</link\> window.				20200411 15:09:53
helpcontent2	source\text\swriter\01\05130004.xhp	0	help	par_id3151390				0	ta	When a Numbering Style is created, a name is assigned to the numbering. This is why such templates are also called "named" numberings. Unnamed numberings, which are used for \<link href=\"text/shared/00/00000005.xhp#formatierung\" name=\"direct formatting\"\>direct formatting\</link\>, can be created in the \<link href=\"text/shared/01/06050000.xhp\" name=\"Numbering/bullets\"\>Bullets and Numbering\</link\> dialog or with the icons of the \<link href=\"text/swriter/main0206.xhp\" name=\"object bar\"\>object bar\</link\>.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	tit				0	ta	Special Tags				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	bm_id3154106				0	ta	\<bookmark_value\>tags; in $[officename] Writer\</bookmark_value\>\<bookmark_value\>$[officename] Writer; special HTML tags\</bookmark_value\>\<bookmark_value\>HTML;special tags for fields\</bookmark_value\>\<bookmark_value\>fields;HTML import and export\</bookmark_value\>\<bookmark_value\>time fields;HTML\</bookmark_value\>\<bookmark_value\>date fields;HTML\</bookmark_value\>\<bookmark_value\>DocInformation fields\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	hd_id3154106				0	ta	\<link href=\"text/swriter/01/04090007.xhp\" name=\"Special Tags\"\>Special Tags\</link\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3153669				0	ta	When you save a document that contains fields as an HTML document, $[officename] automatically converts date, time, and DocInformation fields to special HTML tags. The field contents are inserted between the opening and closing HTML tags of the converted fields. These special HTML tags do not correspond to standard HTML tags.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3152960				0	ta	$[officename] Writer fields are identified by the <SDFIELD> tag in an HTML document. The field type, the format, and the name of the special field are included in the opening HTML tag. The format of a field tag that is recognized by an HTML filter depends on the field type.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	hd_id3154570				0	ta	Date and Time Fields				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3149696				0	ta	For "Date" and "Time" fields, the TYPE parameter equals DATETIME. The format of the date or the time is specified by the SDNUM parameter, for example, DD:MM:YY for dates, or HH:MM:SS for time.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3155183				0	ta	For fixed date and time fields, the date or the time is specified by the SDVAL parameter.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3149485				0	ta	Examples of date and time special HTML tags that are recognized by $[officename] as fields are shown in the following table:				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3151257				0	ta	Fields				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3148970				0	ta	$[officename] Tag				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3147102				0	ta	Date is fixed				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3153634				0	ta	<SDFIELD TYPE=DATETIME SDVAL="35843,4239988426" SDNUM="1031;1031;DD/MM/YY">17/02/98</SDFIELD>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3155137				0	ta	Date is variable				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3156275				0	ta	<SDFIELD TYPE=DATETIME SDNUM="1031;1031;DD/MM/YY">17/02/98</SDFIELD>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3145774				0	ta	Time is fixed				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3155915				0	ta	<SDFIELD TYPE=DATETIME SDVAL="35843,4240335648" SDNUM="1031;1031;HH:MM:SS">10:10:36</SDFIELD>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3150110				0	ta	Time is variable				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3155862				0	ta	<SDFIELD TYPE=DATETIME SDNUM="1031;1031;HH:MM:SS">10:10:36</SDFIELD>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	hd_id3147409				0	ta	DocInformation Fields				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3147487				0	ta	For DocInformation fields, the TYPE parameter equals DOCINFO. The SUBTYPE parameter displays the specific field type, for example, for the "Created" DocInformation field, SUBTYPE=CREATE. For date and time DocInformation fields, the FORMAT parameter equals DATE or TIME, and the SDNUM parameter indicates the number format that is used. The SDFIXED parameter indicates if the content of the DocInformation field is fixed or not.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3147501				0	ta	The contents of a fixed date or time field are equal to the SDVAL parameter, otherwise the contents are equal to the text found between the SDFIELD HTML tags.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3149562				0	ta	Examples of DocInformation special HTML tags that are recognized by $[officename] as fields are shown in the following table:				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3147738				0	ta	Fields				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3146334				0	ta	$[officename] Tag				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3149846				0	ta	Description (fixed content)				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3148863				0	ta	<SDFIELD TYPE=DOCINFO SUBTYPE=COMMENT SDFIXED>Description</SDFIELD>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3151083				0	ta	Creation date				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3153298				0	ta	<SDFIELD TYPE=DOCINFO SUBTYPE=CREATE FORMAT=DATE SDNUM="1031;1031;QQ YY">1. Quarter 98</SDFIELD>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3150175				0	ta	Creation time (fixed content)				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3156134				0	ta	<SDFIELD TYPE=DOCINFO SUBTYPE=CREATE FORMAT=TIME SDVAL="0" SDNUM="1031;1031;HH:MM:SS AM/PM" SDFIXED>03:58:35 PM</SDFIELD>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3155077				0	ta	Modification date				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3154330				0	ta	<SDFIELD TYPE=DOCINFO SUBTYPE=CHANGE FORMAT=DATE SDNUM="1031;1031;NN DD MMM, YY">Mo 23 Feb, 98</SDFIELD>				20200411 15:09:53
helpcontent2	source\text\swriter\01\02170000.xhp	0	help	tit				0	ta	Edit Sections				20200411 15:09:53
helpcontent2	source\text\swriter\01\02170000.xhp	0	help	hd_id3153673				0	ta	Edit Sections				20200411 15:09:53
helpcontent2	source\text\swriter\01\02170000.xhp	0	help	par_id3155902				0	ta	\<variable id=\"bereichetext\"\>\<ahelp hid=\".uno:EditRegion\"\>Changes the properties of sections defined in your document.\</ahelp\> To insert a section, select text or click in your document, and then choose \<emph\>Insert - Section\</emph\>.\</variable\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\02170000.xhp	0	help	par_id3143275				0	ta	The \<emph\>Edit Sections\</emph\> dialog is similar to the \<link href=\"text/swriter/01/04020100.xhp\" name=\"Insert - Section\"\>\<emph\>Insert - Section\</emph\>\</link\> dialog, and offers the following additional options:				20200411 15:09:53
helpcontent2	source\text\swriter\01\02170000.xhp	0	help	hd_id3149820				0	ta	Section				20200411 15:09:53
helpcontent2	source\text\swriter\01\02170000.xhp	0	help	par_id3149104	5			0	ta	\<ahelp hid=\"HID_REGION_TREE\"\>Type the name of the section that you want to edit, or click a name in the \<emph\>Section \</emph\>list.\</ahelp\> If the cursor is currently in a section, the section name is displayed on the right side of the status bar at the bottom of the document window.				20200411 15:09:53
helpcontent2	source\text\swriter\01\02170000.xhp	0	help	par_id3149040				0	ta	The current write protection status of a section is indicated by the lock symbol in front of the section name in the list. An open lock is unprotected and a closed lock is protected. Similarly, visible sections are indicated by a glasses symbol.				20200411 15:09:53
helpcontent2	source\text\swriter\01\02170000.xhp	0	help	hd_id3153638				0	ta	Options				20200411 15:09:53
helpcontent2	source\text\swriter\01\02170000.xhp	0	help	par_id3152773				0	ta	\<ahelp hid=\"HID_REGION_TREE\"\>Opens the \<link href=\"text/swriter/01/05040501.xhp\" name=\"Options\"\>\<emph\>Options\</emph\>\</link\> dialog, where you can edit the column layout, background, footnote and endnote behavior of the selected section.\</ahelp\> If the section is password protected, you must enter the password first.				20200411 15:09:53
helpcontent2	source\text\swriter\01\02170000.xhp	0	help	hd_id3155143				0	ta	Remove				20200411 15:09:53
helpcontent2	source\text\swriter\01\02170000.xhp	0	help	par_id3145413				0	ta	\<ahelp hid=\"SW:PUSHBUTTON:MD_EDIT_REGION:CB_DISMISS\"\>Removes the selected section from the document, and inserts the contents of the section into the document.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060201.xhp	0	help	tit				0	ta	Contour Editor				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060201.xhp	0	help	hd_id3153539				0	ta	Contour Editor				20200411 15:09:53
