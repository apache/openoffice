helpcontent2	source\text\sbasic\shared\03102900.xhp	0	help	par_id3153768				0	ta	print UBound(sVar())				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102900.xhp	0	help	par_id3147288				0	ta	end Sub				20200411 15:09:53
