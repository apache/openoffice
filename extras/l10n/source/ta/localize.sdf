helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3146914				0	ta	MsgBox oEvent.Dbg_Properties				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3150749				0	ta	End Sub				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3145642				0	ta	Sub ContListener_elementReplaced( oEvent )				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3148915				0	ta	MsgBox "elementReplaced"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3148995				0	ta	MsgBox oEvent.Dbg_Properties				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3148407				0	ta	End Sub				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3156056				0	ta	You do not need to include the parameter of an event object if the object is not used:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3150042				0	ta	' Minimal implementation of Sub disposing				20200411 15:09:53
