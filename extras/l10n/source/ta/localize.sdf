helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3151302				0	ta	IMABS("ComplexNumber")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3153974				0	ta	\<variable id=\"complex\"\>\<emph\>ComplexNumber\</emph\> is a complex number that is entered in the form "x+yi" or "x+yj".\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3149697				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3143222	50			0	ta	            \<item type=\"input\"\>=IMABS("5+12j")\</item\> returns 13.				20200411 15:09:53
