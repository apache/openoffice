helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	par_id3155535				0	ta	Defines the default settings for kerning between individual characters.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	hd_id3147275				0	ta	Western characters only				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	par_id3149398				0	ta	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_ASIAN_LAYOUT_RB_CHAR_KERNING\"\>Specifies that kerning is only applied to western text.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	hd_id3148538				0	ta	Western text and Asian punctuation				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	par_id3147336				0	ta	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_ASIAN_LAYOUT_RB_CHAR_PUNCT\"\>Specifies that kerning is applied to both western text and Asian punctuation.\</ahelp\>				20200411 15:09:53
