helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155108				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154063				0	ta	LEN("Text")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146894	108			0	ta	            \<emph\>Text\</emph\> is the text whose length is to be determined.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153884				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156008	110			0	ta	            \<item type=\"input\"\>=LEN("Good Afternoon")\</item\> returns 14.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154300	111			0	ta	            \<item type=\"input\"\>=LEN(12345.67)\</item\> returns 8.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3153983				0	ta	\<bookmark_value\>LOWER function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153983				0	ta	LOWER				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3152791				0	ta	\<ahelp hid=\"HID_FUNC_KLEIN\"\>Converts all uppercase letters in a text string to lowercase.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155902				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150121				0	ta	LOWER("Text")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153910	91			0	ta	            \<emph\>Text\</emph\> refers to the text to be converted.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3159343				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155329	93			0	ta	            \<item type=\"input\"\>=LOWER("Sun")\</item\> returns sun.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3154589				0	ta	\<bookmark_value\>MID function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3154589				0	ta	MID				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154938				0	ta	\<ahelp hid=\"HID_FUNC_TEIL\"\>Returns a text string of a text. The parameters specify the starting position and the number of characters.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148829				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150526				0	ta	MID("Text"; Start; Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148820	152			0	ta	            \<emph\>Text\</emph\> is the text containing the characters to extract.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150774	153			0	ta	            \<emph\>Start\</emph\> is the position of the first character in the text to extract.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153063	154			0	ta	            \<emph\>Number\</emph\> specifies the number of characters in the part of the text.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150509				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3158407	156			0	ta	            \<item type=\"input\"\>=MID("office";2;2)\</item\> returns ff.				20200411 15:09:53
