helpcontent2	source\text\sbasic\shared\03020000.xhp	0	help	tit				0	ta	File I/O Functions				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020000.xhp	0	help	hd_id3156344				0	ta	\<link href=\"text/sbasic/shared/03020000.xhp\" name=\"File I/O Functions\"\>File I/O Functions\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020000.xhp	0	help	par_id3153360				0	ta	Use File I/O functions to create and manage user-defined (data) files.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020000.xhp	0	help	par_id3150398				0	ta	You can use these functions to support the creation of "relative" files, so that you can save and reload certain records by specifying their record number. File I/O functions can also help you manage your files by providing you with information such as file size, current path settings, or the creation date of a file or a directory.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010100.xhp	0	help	tit				0	ta	Display Functions				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010100.xhp	0	help	hd_id3151384				0	ta	\<link href=\"text/sbasic/shared/03010100.xhp\" name=\"Display Functions\"\>Display Functions\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010100.xhp	0	help	par_id3149346				0	ta	This section describes Runtime functions used to output information to the screen display.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	tit				0	ta	InStr Function [Runtime]				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	bm_id3155934				0	ta	\<bookmark_value\>InStr function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	hd_id3155934				0	ta	\<link href=\"text/sbasic/shared/03120401.xhp\" name=\"InStr Function [Runtime]\"\>InStr Function [Runtime]\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	par_id3153990				0	ta	Returns the position of a string within another string.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	par_id3147303				0	ta	The Instr function returns the position at which the match was found. If the string was not found, the function returns 0.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	hd_id3145090				0	ta	Syntax:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	par_id3146957				0	ta	InStr ([Start As Long,] Text1 As String, Text2 As String[, Compare])				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	hd_id3148538				0	ta	Return value:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	par_id3149763				0	ta	Integer				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	hd_id3148473				0	ta	Parameters:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	par_id3153126	9			0	ta	\<emph\>Start: \</emph\>A numeric expression that marks the position in a string where the search for the specified substring starts. If you omit this parameter, the search starts at the first character of the string. The maximum allowed value is 65535.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	par_id3145609				0	ta	\<emph\>Text1:\</emph\> The string expression that you want to search.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	par_id3147559				0	ta	\<emph\>Text2:\</emph\> The string expression that you want to search for.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	par_id3154758				0	ta	\<emph\>Compare:\</emph\> Optional numeric expression that defines the type of comparison. The value of this parameter can be 0 or 1. The default value of 1 specifies a text comparison that is not case-sensitive. The value of 0 specifies a binary comparison that is case-sensitive.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	par_id3153361				0	ta	To avoid a run-time error, do not set the Compare parameter if the first return parameter is omitted.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	hd_id3154366				0	ta	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	par_id3154217				0	ta	Sub ExamplePosition				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	par_id3154685				0	ta	Dim sInput As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	par_id3151042				0	ta	Dim iPos as Integer				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	par_id3144760				0	ta	sInput = "Office"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	par_id3154125				0	ta	iPos = Instr(sInput,"c")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	par_id3145173				0	ta	print iPos				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	par_id3145786				0	ta	end sub				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01010210.xhp	0	help	tit				0	ta	Basics				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01010210.xhp	0	help	bm_id4488967				0	ta	\<bookmark_value\>fundamentals\</bookmark_value\>\<bookmark_value\>subroutines\</bookmark_value\>\<bookmark_value\>variables;global and local\</bookmark_value\>\<bookmark_value\>modules;subroutines and functions\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01010210.xhp	0	help	hd_id3154927				0	ta	\<link href=\"text/sbasic/shared/01010210.xhp\" name=\"Basics\"\>Basics\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01010210.xhp	0	help	par_id3156023				0	ta	This section provides the fundamentals for working with $[officename] Basic.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01010210.xhp	0	help	par_id3147560				0	ta	$[officename] Basic code is based on subroutines and functions that are specified between \<emph\>sub...end sub\</emph\> and \<emph\>function...end function\</emph\> sections. Each Sub or Function can call other Subs and Functions. If you take care to write generic code for a Sub or Function, you can probably re-use it in other programs. See also \<link href=\"text/sbasic/shared/01020300.xhp\" name=\"Procedures and Functions\"\>Procedures and Functions\</link\>.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01010210.xhp	0	help	par_id314756320				0	ta	Some restrictions apply for the names of your public variables, subs, and functions. You must not use the same name as one of the modules of the same library.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01010210.xhp	0	help	hd_id3150398				0	ta	What is a Sub?				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01010210.xhp	0	help	par_id3148797				0	ta	\<emph\>Sub\</emph\> is the short form of \<emph\>subroutine\</emph\>, that is used to handle a certain task within a program. Subs are used to split a task into individual procedures. Splitting a program into procedures and sub-procedures enhances readability and reduces the error-proneness. A sub possibly takes some arguments as parameters but does not return any values back to the calling sub or function, for example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01010210.xhp	0	help	par_id3150868				0	ta	DoSomethingWithTheValues(MyFirstValue,MySecondValue)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01010210.xhp	0	help	hd_id3156282				0	ta	What is a Function?				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01010210.xhp	0	help	par_id3156424				0	ta	A \<emph\>function\</emph\> is essentially a sub, which returns a value. You may use a function at the right side of a variable declaration, or at other places where you normally use values, for example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01010210.xhp	0	help	par_id3146985				0	ta	MySecondValue = myFunction(MyFirstValue)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01010210.xhp	0	help	hd_id3153364				0	ta	Global and local variables				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01010210.xhp	0	help	par_id3151112				0	ta	Global variables are valid for all subs and functions inside a module. They are declared at the beginning of a module before the first sub or function starts.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01010210.xhp	0	help	par_id3154012				0	ta	Variables that you declare within a sub or function are valid only inside this sub or function. These variables override global variables with the same name and local variables with the same name coming from superordinate subs or functions.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01010210.xhp	0	help	hd_id3150010				0	ta	Structuring				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01010210.xhp	0	help	par_id3153727				0	ta	After separating your program into procedures and functions (Subs and Functions), you can save these procedures and functions as files for reuse in other projects. $[officename] Basic supports \<link href=\"text/sbasic/shared/01020500.xhp\" name=\"Modules and Libraries\"\>Modules and Libraries\</link\>. Subs and functions are always contained in modules. You can define modules to be global or part of a document. Multiple modules can be combined to a library.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\01010210.xhp	0	help	par_id3152578				0	ta	You can copy or move subs, functions, modules and libraries from one file to another by using the \<link href=\"text/sbasic/shared/01/06130000.xhp\" name=\"Macro\"\>Macro\</link\> dialog.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	tit				0	ta	Tan Function [Runtime]				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	bm_id3148550				0	ta	\<bookmark_value\>Tan function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	hd_id3148550				0	ta	\<link href=\"text/sbasic/shared/03080104.xhp\" name=\"Tan Function [Runtime]\"\>Tan Function [Runtime]\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3148663				0	ta	Determines the tangent of an angle. The angle is specified in radians.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3153379				0	ta	Using the angle Alpha, the Tan Function calculates the ratio of the length of the side opposite the angle to the length of the side adjacent to the angle in a right-angled triangle.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3154366				0	ta	Tan(Alpha) = side opposite the angle/side adjacent to angle				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	hd_id3145174				0	ta	Syntax:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3151042				0	ta	Tan (Number)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	hd_id3156214				0	ta	Return value:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3156281				0	ta	Double				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	hd_id3155132				0	ta	Parameters:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3145786				0	ta	\<emph\>Number:\</emph\> Any numeric expression that you want to calculate the tangent for (in radians).				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3153728				0	ta	To convert degrees to radians, multiply by Pi/180. To convert radians to degrees, multiply by 180/Pi.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3155414				0	ta	degrees=(radiant*180)/Pi				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3146975				0	ta	radiant=(degrees*Pi)/180				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3147434				0	ta	Pi is approximately 3.141593.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	hd_id3149483				0	ta	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3148646				0	ta	REM In this example, the following entry is possible for a right-angled triangle:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3150012				0	ta	REM The side opposite the angle and the angle (in degrees) to calculate the length of the side adjacent to the angle:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3151115				0	ta	Sub ExampleTangens				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3153158				0	ta	REM Pi = 3.1415926 is a pre-defined variable				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3145800				0	ta	Dim d1 as Double				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080104.xhp	0	help	par_id3150417				0	ta	Dim dAlpha as Double				20200411 15:09:53
