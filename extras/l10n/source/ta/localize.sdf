helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153385	142			0	ta	            \<item type=\"input\"\>=VARP(A1:A50)\</item\>         				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3153688				0	ta	\<bookmark_value\>VARPA function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3153688				0	ta	VARPA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149109				0	ta	\<ahelp hid=\"HID_FUNC_VARIANZENA\"\>Calculates the variance based on the entire population. The value of text is 0.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3152880				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149967				0	ta	VARPA(Value1; Value2; ...Value30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149920	214			0	ta	            \<emph\>Value1,value2,...Value30\</emph\> are values or ranges representing an entire population.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3154862				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3156203	216			0	ta	            \<item type=\"input\"\>=VARPA(A1:A50)\</item\>         				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3154599				0	ta	\<bookmark_value\>PERMUT function\</bookmark_value\>         \<bookmark_value\>number of permutations\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3154599				0	ta	PERMUT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154334				0	ta	\<ahelp hid=\"HID_FUNC_VARIATIONEN\"\>Returns the number of permutations for a given number of objects.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3149422				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3148466				0	ta	PERMUT(Count1; Count2)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3148656	148			0	ta	            \<emph\>Count1\</emph\> is the total number of objects.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150826	149			0	ta	            \<emph\>Count2\</emph\> is the number of objects in each permutation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3153351				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150424	151			0	ta	            \<item type=\"input\"\>=PERMUT(6;3)\</item\> returns 120. There are 120 different possibilities, to pick a sequence of 3 playing cards out of 6 playing cards.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3143276				0	ta	\<bookmark_value\>PERMUTATIONA function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3143276				0	ta	PERMUTATIONA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3144759				0	ta	\<ahelp hid=\"HID_FUNC_VARIATIONEN2\"\>Returns the number of permutations for a given number of objects (repetition allowed).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3145598				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149298				0	ta	PERMUTATIONA(Count1; Count2)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3156139	157			0	ta	            \<emph\>Count1\</emph\> is the total number of objects.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149519	158			0	ta	            \<emph\>Count2\</emph\> is the number of objects in each permutation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3151382				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153949				0	ta	How often can 2 objects be selected from a total of 11 objects?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149233	161			0	ta	            \<item type=\"input\"\>=PERMUTATIONA(11;2)\</item\> returns 121.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150622	162			0	ta	            \<item type=\"input\"\>=PERMUTATIONA(6;3)\</item\> returns 216. There are 216 different possibilities to put a sequence of 3 playing cards together out of six playing cards if every card is returned before the next one is drawn.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3152952				0	ta	\<bookmark_value\>PROB function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3152952				0	ta	PROB				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154110				0	ta	\<ahelp hid=\"HID_FUNC_WAHRSCHBEREICH\"\>Returns the probability that values in a range are between two limits.\</ahelp\> If there is no \<item type=\"literal\"\>End\</item\> value, this function calculates the probability based on the principle that the Data values are equal to the value of \<item type=\"literal\"\>Start\</item\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3146810				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3147330				0	ta	PROB(Data; Probability; Start; End)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154573	168			0	ta	            \<emph\>Data\</emph\> is the array or range of data in the sample.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3156334	169			0	ta	            \<emph\>Probability\</emph\> is the array or range of the corresponding probabilities.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3151107	170			0	ta	            \<emph\>Start\</emph\> is the start value of the interval whose probabilities are to be summed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153694	171			0	ta	            \<emph\>End\</emph\> (optional) is the end value of the interval whose probabilities are to be summed. If this parameter is missing, the probability for the \<emph\>Start \</emph\>value is calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3147574				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153666	173			0	ta	            \<item type=\"input\"\>=PROB(A1:A50;B1:B50;50;60)\</item\> returns the probability with which a value within the range of A1:A50 is also within the limits between 50 and 60. Every value within the range of A1:A50 has a probability within the range of B1:B50.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3150941				0	ta	\<bookmark_value\>WEIBULL function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3150941				0	ta	WEIBULL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154916				0	ta	\<ahelp hid=\"HID_FUNC_WEIBULL\"\>Returns the values of the Weibull distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id0305200911372767				0	ta	The Weibull distribution is a continuous probability distribution, with parameters Alpha > 0 (shape) and Beta > 0 (scale). 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id0305200911372777				0	ta	If C is 0, WEIBULL calculates the probability density function.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id0305200911372743				0	ta	If C is 1, WEIBULL calculates the cumulative distribution function.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3159393				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154478				0	ta	WEIBULL(Number; Alpha; Beta; C)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3151317	179			0	ta	            \<emph\>Number\</emph\> is the value at which to calculate the Weibull distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3158436	180			0	ta	            \<emph\>Alpha \</emph\>is the shape parameter of the Weibull distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154668	181			0	ta	            \<emph\>Beta\</emph\> is the scale parameter of the Weibull distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154825	182			0	ta	            \<emph\>C\</emph\> indicates the type of function.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3153794				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3146077	184			0	ta	            \<item type=\"input\"\>=WEIBULL(2;1;1;1)\</item\> returns 0.86.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id0305200911372899				0	ta	See also the \<link href=\"https://wiki.openoffice.org/wiki/Documentation/How_Tos/Calc:_WEIBULL_function\"\>Wiki page\</link\>.				20200411 15:09:53
