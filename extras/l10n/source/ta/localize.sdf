helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_idN1070A				0	ta	Nastavi možnosti izvoza v PDF za slike v dokumentu.				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_idN1071B				0	ta	Slike EPS z vdelanimi predogledi bodo izvožene le kot predogledi. Slike EPS brez vdelanih predogledov bodo izvožene kot prazne ograde.				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_idN10715				0	ta	Stiskanje brez izgub				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_idN10719				0	ta	\<ahelp hid=\".\"\>Izberite za stiskanje slik brez izgub. Vse slikovne točke bodo tako ohranjene.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_idN10730				0	ta	Stiskanje JPEG				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_idN10734				0	ta	\<ahelp hid=\".\"\>Izberite stiskanje slik JPEG. Z visoko stopnjo kakovosti se ohranijo skoraj vse slikovne točke. Z nižjo stopnjo kakovosti se nekatere slikovne točke izgubijo in pojavijo se napake posploševanja, se pa opazno zmanjša velikost datoteke.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_idN1074C				0	ta	Kakovost				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_idN10750				0	ta	\<ahelp hid=\".\"\>Vnesite raven kakovosti stiskanja JPEG.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_idN10767				0	ta	Zmanjšaj ločljivost slik				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_idN1076B				0	ta	\<ahelp hid=\".\"\>Izberite, če želite ponovno vzorčenje ali pomanjšanje slik v manjše število slikovnih pik na palec.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_idN10782				0	ta	\<ahelp hid=\".\"\>Izberite ciljno ločljivost za slike.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_idN10791				0	ta	Splošno				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_idN10795				0	ta	Nastavi splošne možnosti izvoza v PDF.				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	hd_id2796411				0	ta	PDF/A-1a				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_id5016327				0	ta	\<ahelp hid=\".\"\>Pretvori v zapis PDF/A-1a. Ta je določen kot elektronski zapis datotek dokumentov za dolgoročno hrambo. Vse pisave, uporabljene v izvornem dokumentu, bodo vdelane v ustvarjeno datoteko PDF. Zapisane bodo tudi značke PDF.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_idN107A0				0	ta	PDF z značkami				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_idN107A4				0	ta	\<ahelp hid=\".\"\>Izberite za zapis značk PDF. To lahko krepko poveča velikost datoteke.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_idN107B3				0	ta	PDF z značkami vsebuje informacije o strukturi vsebine dokumenta. Te so lahko v pomoč pri prikazovanju dokumenta na napravah z drugačnim zaslonom ali pri uporabi programske opreme za branje z zaslona.				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_idN107BE				0	ta	Izvozi opombe				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_idN107C2				0	ta	\<ahelp hid=\".\"\>Izberite za izvoz komentarjev dokumentov Writer ali Calc kot opomb PDF.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	hd_id8257087				0	ta	Izvozi zaznamke				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_id3479415				0	ta	\<ahelp hid=\".\"\>Izberite za izvoz zaznamkov dokumentov Writer ali Calc kot zaznamkov PDF. Zaznamki se ustvarijo za vse odstavke orisa (Orodja - Orisno oštevilčevanje) in za vse vnose kazala vsebine, katerim ste dodelili hiperpovezave v izvornem dokumentu.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_idN107F4				0	ta	Ustvari obrazec PDF				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_id4909817				0	ta	\<ahelp hid=\".\"\>Izberite, če želite ustvariti obrazec PDF. Tovrstni dokument PDF lahko uporabnik izpolni in natisne.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	hd_id6585283				0	ta	Pošlji obliko				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_idN107F8				0	ta	\<ahelp hid=\".\"\>Izberite obliko oddaje obrazcev v datoteki PDF.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_id0901200811454970				0	ta	Izberite obliko podatkov, ki jih boste prejeli od pošiljatelja: FDF (Forms Data Format), PDF, HTML ali XML.				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_idN10807				0	ta	Ta nastavitev prevlada nad lastnostjo kontrolnika URL, ki ste jo nastavili v dokumentu.				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	hd_id1026200909535841				0	ta	Dovoli podvojena imena polj				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_id102620090953596				0	ta	\<ahelp hid=\".\"\>Omogoča uporabo istega imena za več polj v ustvarjeni datoteki PDF. Če ni potrjeno, bodo polja izvožena z uporabo ustvarjenih enkratnih imen.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	hd_id3946958				0	ta	Izvozi samodejno vstavljene prazne strani				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_id8551896				0	ta	\<ahelp hid=\".\"\>Če izberete to možnost, bodo samodejno vstavljene prazne strani tudi vključene v datoteko PDF. To je smiselno, če tiskate datoteko obojestransko. Primer: V knjigi je slog odstavka poglavja vedno nastavljen, da se začne na lihi strani. Če se prejšnje poglavje konča na lihi strani, %PRODUCTNAME vstavi oštevilčeno sodo prazno stran. S to izbiro določite, ali naj bo ta soda stran del izvoženega dokumenta.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	hd_id3954548				0	ta	Vdelaj standardne pisave				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_id853434896				0	ta	\<ahelp hid=\".\"\>Običajno štirinajst standardnih pisav Postscript ni vdelanih v datoteko PDF, saj jih vsak program za prikaz dokumentov PDF že vsebuje. To možnost omogočite, če želite vdelati standardne pisave, ki so nameščene na vašem sistemu in ki so uporabljene v dokumentu.\</ahelp\> To možnost uporabite, če pričakujete, da imate lepšo ali uporabnejšo standardno pisavo, kot je pisava, ki je na voljo v programu za prikaz PDF na prejemnikovi strani.				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	hd_id080420080355360				0	ta	Ta dokument vdelaj v PDF				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_id0804200803553767				0	ta	\<ahelp hid=\".\"\>The document being exported will be embedded inside the PDF file.\</ahelp\> Some PDF tools or %PRODUCTNAME extensions may allow to extract the file from the PDF and save it; in this way, the original %PRODUCTNAME document can be edited back without the need of a PDF editing application.				20200411 15:09:53
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	hd_id9796441				0	ta	Začetni pogled				20200411 15:09:53
