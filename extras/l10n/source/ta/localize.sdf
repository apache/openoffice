helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3155592	57			0	ta	            \<item type=\"input\"\>=IMAGINARY("4+3j")\</item\> returns 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	bm_id3146106				0	ta	\<bookmark_value\>IMPOWER function\</bookmark_value\>				20200411 15:09:53
