helpcontent2	source\text\sbasic\shared\03102900.xhp	0	help	hd_id3156027				0	ta	\<link href=\"text/sbasic/shared/03102900.xhp\" name=\"LBound Function [Runtime]\"\>LBound Function [Runtime]\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102900.xhp	0	help	par_id3147226				0	ta	Returns the lower boundary of an array.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102900.xhp	0	help	hd_id3148538				0	ta	Syntax:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102900.xhp	0	help	par_id3150503				0	ta	LBound (ArrayName [, Dimension])				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102900.xhp	0	help	hd_id3150984				0	ta	Return value:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102900.xhp	0	help	par_id3153126				0	ta	Integer				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102900.xhp	0	help	hd_id3144500				0	ta	Parameters:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102900.xhp	0	help	par_id3145069				0	ta	\<emph\>ArrayName:\</emph\> Name of the array for which you want to return the upper (\<emph\>Ubound\</emph\>) or the lower (\<emph\>LBound\</emph\>) boundary of the array dimension.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102900.xhp	0	help	par_id3149457				0	ta	\<emph\>[Dimension]:\</emph\> Integer that specifies which dimension to return the upper (\<emph\>Ubound\</emph\>) or the lower (\<emph\>LBound\</emph\>) boundary for. If a value is not specified, the first dimension is assumed.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102900.xhp	0	help	hd_id3145171				0	ta	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102900.xhp	0	help	par_id3148673				0	ta	Sub ExampleUboundLbound				20200411 15:09:53
