helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150111				0	ta	\<emph\>Type\</emph\> calculates the type of difference. Possible values include 0 (interval) and 1 (in calendar months).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3159094				0	ta	\<bookmark_value\>ROT13 function\</bookmark_value\>\<bookmark_value\>encrypting text\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3159094				0	ta	ROT13				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3146781				0	ta	\<ahelp hid=\"HID_DAI_FUNC_ROT13\"\>Encrypts a character string by moving the characters 13 positions in the alphabet.\</ahelp\> After the letter Z, the alphabet begins again (Rotation). By applying the encryption function again to the resulting code, you can decrypt the text.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3150893				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3159205				0	ta	ROT13(Text)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153249				0	ta	\<emph\>Text\</emph\> is the character string to be encrypted. ROT13(ROT13(Text)) decrypts the code.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3151300				0	ta	\<bookmark_value\>DAYSINYEAR function\</bookmark_value\>\<bookmark_value\>number of days; in a specific year\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3151300				0	ta	DAYSINYEAR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3143220				0	ta	\<ahelp hid=\"HID_DAI_FUNC_DAYSINYEAR\"\>Calculates the number of days of the year in which the date entered occurs.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3145358				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3154651				0	ta	DAYSINYEAR(Date)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153803				0	ta	\<emph\>Date\</emph\> is any date in the respective year. The Date parameter must be a valid date according to the locale settings of %PRODUCTNAME.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3153487				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153811				0	ta	=DAYSINYEAR(A1) returns 366 days if A1 contains 1968-02-29, a valid date for the year 1968.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3154737				0	ta	\<bookmark_value\>DAYSINMONTH function\</bookmark_value\>\<bookmark_value\>number of days;in a specific month of a year\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3154737				0	ta	DAYSINMONTH				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3149316				0	ta	\<ahelp hid=\"HID_DAI_FUNC_DAYSINMONTH\"\>Calculates the number of days of the month in which the date entered occurs.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3145114				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150955				0	ta	DAYSINMONTH(Date)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3147501				0	ta	\<emph\>Date\</emph\> is any date in the respective month of the desired year. The Date parameter must be a valid date according to the locale settings of %PRODUCTNAME.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3149871				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3155742				0	ta	=DAYSINMONTH(A1) returns 29 days if A1 contains 1968-02-17, a valid date for February 1968.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3149048				0	ta	\<bookmark_value\>WEEKS function\</bookmark_value\>\<bookmark_value\>number of weeks;between two dates\</bookmark_value\>				20200411 15:09:53
