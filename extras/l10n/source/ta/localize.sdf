helpcontent2	source\text\swriter\01\06080200.xhp	0	help	par_id3147512				0	ta	\<ahelp hid=\"SW:NUMERICFIELD:TP_ENDNOTEOPTION:FLD_OFFSET\"\>Enter the number for the first endnote in the document.\</ahelp\> This is useful if want the endnote numbering to span more than one document.				20200411 15:09:53
helpcontent2	source\text\swriter\01\06080200.xhp	0	help	hd_id3150702				0	ta	Before				20200411 15:09:53
helpcontent2	source\text\swriter\01\06080200.xhp	0	help	par_id3152943				0	ta	\<ahelp hid=\"SW:EDIT:TP_ENDNOTEOPTION:ED_PREFIX\"\>Enter the text that you want to display in front of the endnote number in the note text.\</ahelp\> For example, type "re: " to display "re: 1".				20200411 15:09:53
helpcontent2	source\text\swriter\01\06080200.xhp	0	help	hd_id3149804				0	ta	After				20200411 15:09:53
helpcontent2	source\text\swriter\01\06080200.xhp	0	help	par_id3153535				0	ta	\<ahelp hid=\"SW:EDIT:TP_ENDNOTEOPTION:ED_SUFFIX\"\>Enter the text that you want to display after the endnote number in the note text.\</ahelp\> For example, type ")" to display "1)".				20200411 15:09:53
helpcontent2	source\text\swriter\01\06080200.xhp	0	help	hd_id3152952				0	ta	Styles				20200411 15:09:53
helpcontent2	source\text\swriter\01\06080200.xhp	0	help	par_id3150970				0	ta	To ensure a uniform appearance for the endnotes in your document, assign a paragraph style to the footnotes.				20200411 15:09:53
