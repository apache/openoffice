helpcontent2	source\text\scalc\01\04060108.xhp	0	help	par_id3153551				0	ta	x value				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060108.xhp	0	help	par_id3147536				0	ta	y value				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060108.xhp	0	help	par_id3153224				0	ta	3				20200411 15:09:53
