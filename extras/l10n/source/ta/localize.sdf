helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3154098				0	ta	MsgBox "elementInserted"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3155601				0	ta	MsgBox oEvent.Dbg_Properties				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3153415				0	ta	End Sub				20200411 15:09:53
