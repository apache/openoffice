helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id68				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Izberite, kateri deli dokumenta naj bodo natisnjeni.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id70				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Izberite, koliko prosojnic želite natisniti na posamezen list.\</ahelp\>				20200411 15:09:53
