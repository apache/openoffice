helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3157960				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Vnesite številko zapisa, ki si ga želite ogledati, nato pritisnite Enter.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	hd_id3150868				0	ta	Vstavljanje novega zapisa				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3149168	6			0	ta	\<ahelp hid=\"HID_GRID_TRAVEL_NEW\" visibility=\"hidden\"\>Vstavi nov zapis v trenutno tabelo.\</ahelp\> Če želite ustvariti zapis, kliknite gumb zvezdica (*) na dnu pogleda tabele. Prazna vrstica je dodana na koncu tabele.				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3152920				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Izberite vrsto zapisa, kakršnega želite ustvariti. $[officename] vstavi številko v stolpec \<emph\>Vrsta\</emph\> zapisa, ki ustreza tukaj izbrani vrsti.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3156423				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Vnesite okrajšano ime za zapis. Okrajšano ime se pojavi na seznamu zapisov v stolpcu \<emph\>Identifikator\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3155994				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Vnesite dodatne podatke za izbrani zapis. Če želite, lahko podatke vnesete tudi v ustrezno polje v tabeli.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	hd_id3163716				0	ta	Iskanje in filtriranje zapisov				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3147478				0	ta	Zapise lahko iščete na podlagi ujemanja ključne besede z vnosom v polju.				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	hd_id3159181				0	ta	Vnašanje ključa za iskanje				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3159125	11			0	ta	\<ahelp hid=\".uno:Bib/query\"\>Vtipkajte podatke, ki jih želite poiskati, in pritisnite Enter. Če želite spremeniti možnosti filtriranja pri iskanju, pridržite miškin gumb na ikoni \<emph\>Samodejni filter\</emph\>, nato pa izberite drugačno podatkovno polje. Pri iskanju lahko uporabite nadomestna znaka % ali * za katero koli število znakov in _ ali ? za en znak. Za prikaz vseh zapisov v tabeli, to polje izpraznite in pritisnite Enter. \</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	hd_id3155511				0	ta	Samodejni filter				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3146975				0	ta	\<ahelp hid=\".uno:Bib/autoFilter\"\>Pridržite miškin gumb, če želite izbrati podatkovno polje, ki ga hočete poiskati s pomočjo izraza, ki ste ga vnesli v polje \<emph\>Iskani niz\</emph\>. Iščete lahko le eno podatkovno polje.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3149664				0	ta	Seznam zapisov v tabeli se samodejno posodobi, da se ujema z novimi nastavitvami filtriranja.				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3145590	30			0	ta	\<ahelp hid=\".\"\>Uporabite \<emph\>Standardni filter\</emph\> za izboljšanje in kombiniranje iskalnih možnosti \<emph\>Samodejnega filtra\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3155311				0	ta	\<ahelp hid=\".\"\>Za prikaz vseh zapisov v tabeli kliknite ikono \<emph\>Odstrani filter\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	hd_id3147580				0	ta	Brisanje zapisa				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3154471				0	ta	Če želite izbrisati zapis v trenutni tabeli, z desnim miškinim gumbom kliknite glavo vrstice s tem zapisom in izberite \<emph\>Izbriši\</emph\>. \<ahelp hid=\"SID_FM_DELETEROWS\" visibility=\"hidden\"\>Izbriše izbrani zapis.\</ahelp\>				20200411 15:09:53
