helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	tit				0	ta	Atn Function [Runtime]				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	bm_id3150616				0	ta	\<bookmark_value\>Atn function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	hd_id3150616				0	ta	\<link href=\"text/sbasic/shared/03080101.xhp\" name=\"Atn Function [Runtime]\"\>Atn Function [Runtime]\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	par_id3149346				0	ta	Trigonometric function that returns the arctangent of a numeric expression. The return value is in the range -Pi/2 to +Pi/2.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	par_id3143271				0	ta	The arctangent is the inverse of the tangent function. The Atn Function returns the angle "Alpha", expressed in radians, using the tangent of this angle. The function can also return the angle "Alpha" by comparing the ratio of the length of the side that is opposite of the angle to the length of the side that is adjacent to the angle in a right-angled triangle.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	par_id3145315				0	ta	Atn(side opposite the angle/side adjacent to angle)= Alpha				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	hd_id3149669				0	ta	Syntax:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	par_id3148947				0	ta	Atn (Number)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	hd_id3148664				0	ta	Return value:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	par_id3150359				0	ta	Double				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	hd_id3148798				0	ta	Parameters:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	par_id3156212				0	ta	\<emph\>Number:\</emph\> Any numerical expression that represents the ratio of two sides of a right triangle. The Atn function returns the corresponding angle in radians (arctangent).				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	par_id3153192				0	ta	To convert radians to degrees, multiply radians by 180/pi.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	par_id3147230				0	ta	degree=(radian*180)/pi				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	par_id3125864				0	ta	radian=(degree*pi)/180				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	par_id3159252				0	ta	Pi is here the fixed circle constant with the rounded value 3.14159.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	hd_id3153142				0	ta	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	par_id3146985				0	ta	REM The following example calculates for a right-angled triangle				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	par_id3145750				0	ta	REM the angle Alpha from the tangent of the angle Alpha:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	par_id3146975				0	ta	Sub ExampleATN				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	par_id3151112				0	ta	REM rounded Pi = 3.14159 is a predefined constant				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	par_id3159156				0	ta	Dim d1 As Double				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	par_id3147435				0	ta	Dim d2 As Double				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	par_id3149262				0	ta	d1 = InputBox$ ("Enter the length of the side adjacent to the angle: ","Adjacent")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	par_id3149482				0	ta	d2 = InputBox$ ("Enter the length of the side opposite the angle: ","Opposite")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	par_id3155415				0	ta	Print "The Alpha angle is"; (atn (d2/d1) * 180 / Pi); " degrees"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080101.xhp	0	help	par_id3149959				0	ta	End Sub				20200411 15:09:53
