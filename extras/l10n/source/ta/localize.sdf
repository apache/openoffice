helpcontent2	source\text\simpress\01\02150000.xhp	0	help	par_id3155601				0	ta	\<variable id=\"uebertext\"\>\<ahelp hid=\".uno:Morphing\"\>Creates shapes and distributes them by uniform increments between two drawing objects.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\simpress\01\02150000.xhp	0	help	par_id3146971				0	ta	$[officename] draws a series of intermediate shapes between two selected objects and \<link href=\"text/shared/01/05290000.xhp\" name=\"groups\"\>groups\</link\> the result.				20200411 15:09:53
helpcontent2	source\text\simpress\01\02150000.xhp	0	help	hd_id3155334				0	ta	Settings				20200411 15:09:53
helpcontent2	source\text\simpress\01\02150000.xhp	0	help	par_id3149126				0	ta	Sets the options for cross-fading.				20200411 15:09:53
