helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3163807				0	ta	aFile = "c:\\data.txt"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3154021				0	ta	iNumber = Freefile				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3153786				0	ta	Open aFile For Output As #iNumber				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3155607				0	ta	Print #iNumber, "This is a line of text"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020405.xhp	0	help	par_id3150361				0	ta	MsgBox FileAttr(#iNumber, 1 ),0,"Access mode"				20200411 15:09:53
