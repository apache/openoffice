helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	bm_id3150991				0	ta	\<bookmark_value\>EOMONTH function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	hd_id3150991				0	ta	\<variable id=\"eomonth\"\>\<link href=\"text/scalc/01/func_eomonth.xhp\"\>EOMONTH\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3152766	232			0	ta	\<ahelp hid=\"HID_AAI_FUNC_EOMONTH\"\>Returns the date of the last day of a month which falls m\<emph\>onths\</emph\> away from the s\<emph\>tart date\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	hd_id3150597				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3150351				0	ta	EOMONTH(StartDate; Months)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3146787				0	ta	\<emph\>StartDate\</emph\> is a date (the starting point of the calculation).				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3155615				0	ta	\<emph\>Months\</emph\> is the number of months before (negative) or after (positive) the start date.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	hd_id3156335				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3154829				0	ta	What is the last day of the month that falls 6 months after September 14 2001?				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3156143				0	ta	\<item type=\"input\"\>=EOMONTH(DATE(2001;9;14);6)\</item\> returns the serial number 37346. Formatted as a date, this is 2002-03-31.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3156144				0	ta	\<item type=\"input\"\>=EOMONTH("2001-09-14";6)\</item\> works as well. If the date is given as string, it has to be in ISO format.				20200411 15:09:53
