helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3148943				0	ta	2				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149771				0	ta	\<item type=\"input\"\>95\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3158407				0	ta	\<item type=\"input\"\>17\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3148806				0	ta	\<item type=\"input\"\>2\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154904				0	ta	3				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3150779				0	ta	\<item type=\"input\"\>5\</item\>				20200411 15:09:53
