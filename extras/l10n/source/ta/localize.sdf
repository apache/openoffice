helpcontent2	source\text\swriter\01\06030000.xhp	0	help	par_id3149096				0	ta	\<ahelp hid=\"HID_HYPHENATE\"\>Inserts the hyphen at the indicated position.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\06030000.xhp	0	help	hd_id3154829				0	ta	Remove				20200411 15:09:53
helpcontent2	source\text\swriter\01\06030000.xhp	0	help	par_id3149821				0	ta	\<ahelp hid=\"SVX:PUSHBUTTON:RID_SVXDLG_HYPHENATE:BTN_HYPH_DELETE\"\>Removes the current hyphenation point from the displayed word.\</ahelp\>				20200411 15:09:53
