helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	hd_id3153896				0	ta	\<link href=\"text/sbasic/shared/03080103.xhp\" name=\"Sin Function [Runtime]\"\>Sin Function [Runtime]\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3149456				0	ta	Returns the sine of an angle. The angle is specified in radians. The result lies between -1 and 1.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3153379				0	ta	Using the angle Alpha, the Sin Function returns the ratio of the length of the opposite side of an angle to the length of the hypotenuse in a right-angled triangle.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3148798				0	ta	Sin(Alpha) = side opposite the angle/hypotenuse				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	hd_id3147230				0	ta	Syntax:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3154909				0	ta	Sin (Number)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	hd_id3156214				0	ta	Return value:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3150870				0	ta	Double				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	hd_id3155132				0	ta	Parameters:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3145786				0	ta	\<emph\>Number:\</emph\> Numeric expression that defines the angle in radians that you want to calculate the sine for.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3155413				0	ta	To convert degrees to radians, multiply degrees by Pi/180, and to convert radians to degrees, multiply radians by 180/Pi.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3149664				0	ta	grad=(radiant*180)/pi				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3153143				0	ta	radiant=(grad*pi)/180				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3151112				0	ta	Pi is approximately 3.141593.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	hd_id3163712				0	ta	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3149482				0	ta	REM In this example, the following entry is possible for a right-angled triangle:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3148577				0	ta	REM The side opposite the angle and the angle (in degrees) to calculate the length of the hypotenuse:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3152941				0	ta	Sub ExampleSine				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3150011				0	ta	REM Pi = 3.1415926 is a predefined variable				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3153159				0	ta	Dim d1 as Double				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3154491				0	ta	Dim dAlpha as Double				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3145251				0	ta	d1 = InputBox$ ("Enter the length of the opposite side: ","Opposite Side")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3148456				0	ta	dAlpha = InputBox$ ("Enter the angle Alpha (in degrees): ","Alpha")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3153877				0	ta	Print "The length of the hypotenuse is"; (d1 / sin (dAlpha * Pi / 180))				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3150717				0	ta	End Sub				20200411 15:09:53
