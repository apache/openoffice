helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3156116				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146786				0	ta	LEFT("Text"; Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147274	99			0	ta	            \<emph\>Text\</emph\> is the text where the initial partial words are to be determined.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153152	100			0	ta	            \<emph\>Number\</emph\> (optional) specifies the number of characters for the start text. If this parameter is not defined, one character is returned.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150260				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149141	102			0	ta	            \<item type=\"input\"\>=LEFT("output";3)\</item\> returns “out”.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3156110				0	ta	\<bookmark_value\>LEN function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3156110				0	ta	LEN				20200411 15:09:53
