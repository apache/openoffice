helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id74				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Določa, ali bo ime strani dokumenta natisnjeno.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id76				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Določa, ali bo natisnjen trenutni datum in čas.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id78				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Določa, ali naj se natisnejo strani, ki so trenutno skrite.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id80				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Določa, da želite tiskati v barvah izvirnika.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id82				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Določa, da želite barve tiskati v črno-belih odtenkih.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id84				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Določa, da želite barve tiskati črno-belo.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id86				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Določite, kako naj bodo pomanjšane prosojnice v izpisu.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id88				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Določa, da med tiskanjem ne želite dodatnih sprememb merila strani.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id90				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Določa, ali naj bodo predmeti, ki segajo prek robov tiskanja trenutnega tiskalnika, pomanjšani, da bodo prilagojeni papirju tiskalnika.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id92				0	ta	\<ahelp hid=\".\" visibility=\"hidden\"\>Določa, da morajo biti strani natisnjene razpostavljeno. Če so strani ali prosojnice manjše od lista papirja, bo na eno stran papirja natisnjenih več strani ali prosojnic.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	hd_id0818200912285074				0	ta	%PRODUCTNAME Writer / Calc / Impress / Draw / Math				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id0818200912285019				0	ta	Zavihek z imenom modula, ki ga trenutno uporabljate, določa vsebino, barvo, velikost in strani, ki naj bodo natisnjene. Na njem določite nastavitve, ki so specifične za trenutno vrsto dokumenta.				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	hd_id0818200912285112				0	ta	Postavitev strani				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id0818200912285150				0	ta	Zavihek Postavitev strani lahko uporabite za prihranek pri papirju, tako da natisnete več strani na posamezen list. Določite lahko porazdelitev in velikost izpisanih strani na dejanskem papirju.				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id0818200904164735				0	ta	Spremenite razporeditev strani, ki naj bodo natisnjene na vsakem listu papirja. Predogled prikazuje videz vsakega končnega lista.				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id0818200904102987				0	ta	Pri nekaterih vrstah dokumentov lahko izberete tiskanje brošure.				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	hd_id0818200912285138				0	ta	Možnosti				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id0818200912285146				0	ta	Na zavihku Možnosti lahko nastavite nekatere dodatne možnosti za trenutno tiskarniško opravilo. Tukaj lahko določite tiskanje v datoteko namesto s tiskalnikom.				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	hd_id0819200910481678				0	ta	\<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>Namigi za Unix\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3157320				0	ta	\<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>Če želite, lahko uporabite spremenljivko okolja STAR_SPOOL_DIR za določitev mape, kjer so shranjene datoteke spool tiskalnika Xprinter. Primer:\</caseinline\>\</switchinline\>				20200411 15:09:53
