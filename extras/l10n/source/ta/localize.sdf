helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3153194				0	ta	Dim sInput As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3154217				0	ta	Dim sUS_date As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3150448				0	ta	sInput = InputBox("Please input a date in the international format 'YYYY-MM-DD'")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3149203				0	ta	sUS_date = Mid(sInput, 6, 2)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3150439				0	ta	sUS_date = sUS_date & "/"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3153770				0	ta	sUS_date = sUS_date & Right(sInput, 2)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3161833				0	ta	sUS_date = sUS_date & "/"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3147215				0	ta	sUS_date = sUS_date & Left(sInput, 4)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3149666				0	ta	MsgBox sUS_date				20200411 15:09:53
