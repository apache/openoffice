helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3155443	54			0	ta	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Fiksno \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3153711	55			0	ta	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Razmik med vrsticami se nastavi tako, da se popolnoma ujema z vrednostjo, ki jo vnesete v polje. Posledica so lahko obrezani znaki. \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3156383				0	ta	od				20200411 15:09:53
