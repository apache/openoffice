helpcontent2	source\text\sbasic\shared\03030205.xhp	0	help	par_id3156286				0	ta	dDate = TimeSerial(8,30,15)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030205.xhp	0	help	par_id3148456				0	ta	sDate = TimeSerial(8,30,15)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030205.xhp	0	help	par_id3155600				0	ta	MsgBox dDate,64,"Time as a number"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030205.xhp	0	help	par_id3153417				0	ta	MsgBox sDate,64,"Formatted time"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030205.xhp	0	help	par_id3153836				0	ta	End Sub				20200411 15:09:53
