helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3149824				0	ta	Automatic				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3151262				0	ta	\<ahelp hid=\"SW:CHECKBOX:TP_FRM_STD:CB_AUTOHEIGHT\"\>Automatically adjusts the width or height of a frame to match the contents of the frame. If you want, you can specify a minimum width or minimum height for the frame.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3152773				0	ta	The \<emph\>Automatic\</emph\> option is only available when you select a frame.				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3155144				0	ta	Anchor				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3153352				0	ta	Specify the anchoring options for the selected object or frame. The anchor options are not available when you open the dialog from the Styles and Formatting window.				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3156269				0	ta	To page				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3149169				0	ta	\<ahelp hid=\"SW_RADIOBUTTON_TP_FRM_STD_RB_ANCHOR_PAGE\"\>Anchors the selection to the current page.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3151028				0	ta	To paragraph				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3145777				0	ta	\<ahelp hid=\"SW_RADIOBUTTON_TP_FRM_STD_RB_ANCHOR_PARA\"\>Anchors the selection to the current paragraph.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3155913				0	ta	To character				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3151377				0	ta	\<ahelp hid=\"SW_RADIOBUTTON_TP_FRM_STD_RB_ANCHOR_AT_CHAR\"\>Anchors the selection to a character.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3150115				0	ta	As character				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3155863				0	ta	\<ahelp hid=\"SW_RADIOBUTTON_TP_FRM_STD_RB_ANCHOR_AS_CHAR\"\>Anchors the selection as character. The height of the current line is resized to match the height of the selection.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3150693				0	ta	Position				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3147413				0	ta	Specify the location of the selected object on the current page.				20200411 15:09:53
