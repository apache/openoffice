helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	hd_id3166443				0	ta	\<variable id=\"weeknumadd\"\>\<link href=\"text/scalc/01/func_weeknumadd.xhp\"\>WEEKNUM_ADD\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	par_id3152945				0	ta	\<ahelp hid=\"HID_AAI_FUNC_WEEKNUM\"\>The result indicates the number of the calendar week for a date.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	par_idN105DD				0	ta	The WEEKNUM_ADD function is designed to calculate week numbers exactly as Microsoft Excel does. Use the \<link href=\"text/scalc/01/func_weeknum.xhp\"\>WEEKNUM\</link\> function, or format your date cells using the WW formatting code, when you need ISO 8601 week numbers.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	hd_id3153745				0	ta	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	par_id3153685				0	ta	WEEKNUM_ADD(Date; ReturnType)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	par_id3159277				0	ta	\<emph\>Date\</emph\> is the date within the calendar week.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	par_id3154098				0	ta	\<emph\>ReturnType\</emph\> is 1 for week beginning on a Sunday, 2 for week beginning on a Monday.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	hd_id3152886				0	ta	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	par_id3149973				0	ta	In which week number does 12.24.2001 fall?				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	par_id3149914				0	ta	\<item type=\"input\"\>=WEEKNUM_ADD(24.12.2001;1)\</item\> returns 52.				20200411 15:09:53
