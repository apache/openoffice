helpcontent2	source\text\scalc\01\12040400.xhp	0	help	hd_id3153087				0	ta	\<link href=\"text/scalc/01/12040400.xhp\" name=\"Remove Filter\"\>Remove Filter\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040400.xhp	0	help	par_id3154760				0	ta	\<ahelp hid=\".uno:DataFilterRemoveFilter\"\>Removes the filter from the selected cell range. To enable this command, click inside the cell area where the filter was applied.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\07090000.xhp	0	help	tit				0	ta	Freeze				20200411 15:09:53
helpcontent2	source\text\scalc\01\07090000.xhp	0	help	hd_id3150517				0	ta	\<link href=\"text/scalc/01/07090000.xhp\" name=\"Freeze\"\>Freeze\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\07090000.xhp	0	help	par_id3156289				0	ta	\<ahelp hid=\".uno:FreezePanes\" visibility=\"visible\"\>Divides the sheet at the top left corner of the active cell and the area to the top left is no longer scrollable.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\03090000.xhp	0	help	tit				0	ta	Formula Bar				20200411 15:09:53
helpcontent2	source\text\scalc\01\03090000.xhp	0	help	bm_id3147264				0	ta	\<bookmark_value\>formula bar;spreadsheets\</bookmark_value\>\<bookmark_value\>spreadsheets; formula bar\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\03090000.xhp	0	help	hd_id3147264				0	ta	\<link href=\"text/scalc/01/03090000.xhp\" name=\"Formula Bar\"\>Formula Bar\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\03090000.xhp	0	help	par_id3156423				0	ta	\<ahelp hid=\".uno:InputLineVisible\"\>Shows or hides the Formula Bar, which is used for entering and editing formulas.\</ahelp\> The Formula Bar is the most important tool when working with spreadsheets.				20200411 15:09:53
helpcontent2	source\text\scalc\01\03090000.xhp	0	help	par_id3154686				0	ta	To hide the Formula Bar, unmark the menu item.				20200411 15:09:53
helpcontent2	source\text\scalc\01\03090000.xhp	0	help	par_id3145787				0	ta	If the Formula Bar is hidden, you can still edit cells by activating the edit mode with F2. After editing cells, accept the changes by pressing Enter, or discard entries by pressing Esc. Esc is also used to exit the edit mode.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060108.xhp	0	help	tit				0	ta	Statistics Functions				20200411 15:09:53
