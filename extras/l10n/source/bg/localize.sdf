helpcontent2	source\text\scalc\01\12100000.xhp	0	help	par_id3153088				0	bg	\<variable id=\"aktualisieren\"\>\<ahelp hid=\".uno:DataAreaRefresh\" visibility=\"visible\"\>Обновява област с данни, която е била вмъкната от външна база от данни. Данните в листа се обновяват, така че да съответстват на тези във външната база от данни.\</ahelp\>\</variable\>				20200411 15:09:53
