helpcontent2	source\text\swriter\guide\indices_literature.xhp	0	help	par_id3155872				0	bg	Изберете \<link href=\"text/shared/01/02250000.xhp\" name=\"Инструменти - Библиографска база от данни\"\>\<emph\>Инструменти - Библиографска база от данни\</emph\>\</link\>.				20200411 15:09:53
