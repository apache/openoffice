uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_IO_UNSUPPORTEDOVERWRITE & ERRCODE_RES_MASK)			0	bg	Когато се ползва избраният протокол на предаване, %PRODUCTNAME не може да предотврати презапис на файловете. Желаете ли да продължите въпреки това?				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_IO_BROKENPACKAGE & ERRCODE_RES_MASK)			1	bg	Файлът '$(ARG1)' е повреден и поради това не може да бъде отворен. %PRODUCTNAME може да се опита да го поправи.\n\nПовредата може да е в резултат на манипулация на документа или повреда в структурата на документа при предаване на данните.\n\nПрепоръчваме да не вярвате на съдържанието на поправения документ.\nИзпълненията на макроси са забранени за този документ.\n\nТрябва ли %PRODUCTNAME да се опита да поправи файлът?\n				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_IO_BROKENPACKAGE_CANTREPAIR & ERRCODE_RES_MASK)			1	bg	Файлът "$(ARG1)" не може да бъде поправен и затова не може да бъде отворен.				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_CONFIGURATION_BROKENDATA_NOREMOVE & ERRCODE_RES_MASK)			1	bg	Конфигурационните данни в "$(ARG1)" са повредени. Без тези данни някои функции може да не се изпълняват правилно.\nЖелаете ли да продължите стартирането на %PRODUCTNAME без тези повредени конфигурационни данни?				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_CONFIGURATION_BROKENDATA_WITHREMOVE & ERRCODE_RES_MASK)			1	bg	Личният конфигурационен файл "$(ARG1)" е повреден и е необходимо да бъде изтрит, за да продължите. Може би ще бъдат загубени част от личните Ви настойки.\nЖелаете ли да продължите със стартирането на %PRODUCTNAME без повредените конфигурационни данни?				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_CONFIGURATION_BACKENDMISSING & ERRCODE_RES_MASK)			1	bg	Източникът с конфигурационни данни "$(ARG1)" е недостъпен. Без тази информация някои функции може да не работят правилно.				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_CONFIGURATION_BACKENDMISSING_WITHRECOVER & ERRCODE_RES_MASK)			1	bg	Източникът с конфигурационни данни "$(ARG1)" е недостъпен. Без тази информация някои функции може да не работят правилно.\nЖелаете ли да продължите със стартирането на %PRODUCTNAME без повредените конфигурационни данни?				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_INVALID_XFORMS_SUBMISSION_DATA & ERRCODE_RES_MASK)			1	bg	Формулярът съдържа невалидни данни. Желаете ли да продължите?				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_LOCKING_LOCKED & ERRCODE_RES_MASK)			1	bg	Файлът $(ARG1) е заключен от друг потребител. В момента не може да бъде даден друг достъп.				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_LOCKING_LOCKED_SELF & ERRCODE_RES_MASK)			1	bg	Файлът $(ARG1) е заключен от вас. В момента не може да бъде предоставен друг достъп за записване в него.				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_LOCKING_NOT_LOCKED & ERRCODE_RES_MASK)			1	bg	Файлът $(ARG1) не е заключен в момента от Вас.				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_LOCKING_LOCK_EXPIRED & ERRCODE_RES_MASK)			1	bg	Придобитото заключване за файла $(ARG1) е изтекло.\nТова може да се случи поради проблеми в сървъра, управляващ заключването. Възможно е записването в този файл да заличи промени, нанесени от други потребители!				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_UNKNOWNAUTH_UNTRUSTED)			1	bg	Не може да се удостовери идентичността на сайта $(ARG1).\n\nПреди да приемете този сертификат, е добре внимателно да разгледате сертификата на сайта. Желаете ли да приемете този сертификат за идентифициране на уебсайта $(ARG1)?				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_SSLWARN_EXPIRED_1)			1	bg	Сайтът $(ARG1) използва сертификат за сигурност, за да шифрова данните по време на предаване, но срокът на сертификата е изтекъл на $(ARG2).\n\nДобре е се уверите, че датата и часът в компютъра ви са правилни.				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_SSLWARN_DOMAINMISMATCH_1)			1	bg	Опитахте се да установите връзка с $(ARG1), а представеният сертификат за сигурност принадлежи на $(ARG2). Възможно е, макар и малко вероятно, някой да се опитва да прехване комуникацията ви с този уебсайт.\n\nАко подозирате, че показаният сертификат не принадлежи на $(ARG1), моля, прекратете връзката и уведомете администратора на сайта.\n\nЖелаете ли все пак да продължите?				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_SSLWARN_INVALID_1)			1	bg	Не бе възможно да се провери валидността на сертификата. Добре е внимателно да разгледате сертификата на този сайт.\n\nАко показаният сертификат ви изглежда подозрителен, моля, прекратете връзката и уведомете администратора на сайта.				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(TITLE_UUI_SSLWARN_DOMAINMISMATCH)			1	bg	Предупреждение за сигурността: несъответстващо име на домейн				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(TITLE_UUI_SSLWARN_EXPIRED)			1	bg	Предупреждение за сигурността: изтекъл сертификат на сървър				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(TITLE_UUI_SSLWARN_INVALID)			1	bg	Предупреждение за сигурността: невалиден сертификат на сървър				20200411 15:09:53
uui	source\filechanged.src	0	string	STR_FILECHANGED_TITLE				0	bg	Документът е променен от други				20200411 15:09:53
uui	source\filechanged.src	0	string	STR_FILECHANGED_MSG				0	bg	Файлът е бил променен, докато е бил отворен за редактиране в %PRODUCTNAME. Съхранявайки вашата версия на документа, ще презапишете промените, направени от други.\n\nЖелаете ли да го съхраните въпреки това?\n\n				20200411 15:09:53
