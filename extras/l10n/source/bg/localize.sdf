helpcontent2	source\text\scalc\01\func_time.xhp	0	help	bm_id3154073				0	bg	\<bookmark_value\>TIME, функция\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	hd_id3154073				0	bg	\<variable id=\"time\"\>\<link href=\"text/scalc/01/func_time.xhp\"\>TIME\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3145762				0	bg	\<ahelp hid=\"HID_FUNC_ZEIT\"\>TIME връща стойност за час по зададени часове, минути и секунди.\</ahelp\> Тази функция може да се използва за преобразуване на точен час, зададен чрез тези три стойности, в десетично числово представяне на час.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	hd_id3155550				0	bg	Синтаксис				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3154584				0	bg	TIME(Час; Минута; Секунда)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3152904				0	bg	\<emph\>Час\</emph\> е цяло число.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3151346				0	bg	\<emph\>Минута\</emph\> е цяло число.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3151366				0	bg	\<emph\>Секунда\</emph\> е цяло число.				20200411 15:09:53
