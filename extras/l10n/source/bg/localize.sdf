helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3459578				0	bg	\<item type=\"input\"\>=DEGREES(PI())\</item\> връща 180 градуса.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3148698				0	bg	\<bookmark_value\>EXP, функция\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3148698				0	bg	EXP				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150592				0	bg	\<ahelp hid=\"HID_FUNC_EXP\"\>Връща e на степен дадено число.\</ahelp\> Константата e е приблизително равна на 2,71828182845904.				20200411 15:09:53
