helpcontent2	source\text\schart\01\04030000.xhp	0	help	hd_id1106200812280727				0	bg	Ориентация на текста				20200411 15:09:53
helpcontent2	source\text\schart\01\04030000.xhp	0	help	par_id1106200812280719				0	bg	\<ahelp hid=\".\"\>Задайте посоката на текста за абзац със сложна писменост (CTL). Тази функция е достъпна само ако е разрешена поддръжката за сложни писмености.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04030000.xhp	0	help	hd_id1007200901590713				0	bg	Въртене на текст				20200411 15:09:53
helpcontent2	source\text\schart\01\04030000.xhp	0	help	par_id1007200901590752				0	bg	\<ahelp hid=\".\"\>Щракнете в колелото, за да зададете ориентацията на текста в надписите на данните.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04030000.xhp	0	help	par_id1007200901590757				0	bg	\<ahelp hid=\".\"\>Въведете ъгъл на завъртане за надписите на данните. Положително число означава завъртане на текста наляво, а отрицателно – надясно.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\choose_chart_type.xhp	0	help	tit				0	bg	Избиране на тип диаграма				20200411 15:09:53
