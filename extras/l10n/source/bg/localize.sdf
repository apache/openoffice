helpcontent2	source\text\shared\01\05030700.xhp	0	help	par_id3153031				0	bg	\<variable id=\"linkstext\"\>\<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXPAGE_ALIGN_PARAGRAPH:BTN_LEFTALIGN\"\>Подравнява абзаца към лявото поле на страницата.\</ahelp\>\</variable\> Ако е разрешена поддръжката на азиатски езици, тази настройка се нарича Ляво/горе.				20200411 15:09:53
helpcontent2	source\text\shared\01\05030700.xhp	0	help	hd_id3154142				0	bg	Отдясно				20200411 15:09:53
