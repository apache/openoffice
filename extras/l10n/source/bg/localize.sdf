helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3149064				0	bg	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Създаване на таблица\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3146119				0	bg	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Създава таблица, когато натиснете Enter след въвеждане на поредица от тирета (-) или табулатори, разделени от плюсове, например +------+---+. Плюсовете обозначават разделители на колони, а тиретата и табулаторите показват ширината на колоните.\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3147219				0	bg	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>+-----------------+---------------+------+\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3153334				0	bg	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Прилагане на стилове\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3147396				0	bg	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Автоматично заменя абзацния стил „По подразбиране“ със стиловете от „Заглавие 1“ до „Заглавие 8“. За да приложите абзацния стил „Заглавие 1“, въведете текста, който желаете да използвате за заглавие (без точка) и натиснете два пъти Enter. За да оформите подзаглавие, натиснете Tab един или повече пъти, въведете текста (без точка), след което натиснете Enter.\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3151075				0	bg	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Премахване на празните абзаци\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3145728				0	bg	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Премахва празните абзаци от текущия документ, когато изберете \<emph\>Форматиране - Автокорекция - Прилагане\</emph\>.\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3152375				0	bg	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Замяна на стиловете по избор\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3156299				0	bg	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Заменя абзацните стилове по избор в текущия документ с абзацния стил „По подразбиране“, „Основен текст“ или „Основен текст с отстъп“.\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3147045				0	bg	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Замяна на водачите с\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3150420				0	bg	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Преобразува абзаците, които започват с тире (-), знак плюс (+) или звездичка (*), последвани непосредствено от интервал или табулатор, в списъци с водачи. Тази възможност работи само върху абзаци, форматирани с абзацните стилове „По подразбиране“, „Основен текст“ или „Основен текст с отстъп“. За да промените използвания стил на водачите, изберете тази настройка и щракнете върху \<emph\>Редактиране\</emph\>.\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3151019				0	bg	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Сливане на абзаци от по един ред, ако дължината им надвишава ...\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3154162				0	bg	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Обединява последователни абзаци от по един ред в един цял абзац. Тази възможност работи само ако абзаците са с абзацен стил „По подразбиране“. Ако дължината на абзаца е по-голяма от зададената, той се обединява със следващия. За да въведете друга дължина, изберете настройката и щракнете върху \<link href=\"text/swriter/01/05150104.xhp\"\>\<emph\>Редактиране\</emph\>\</link\>.\</caseinline\>\</switchinline\>				20200411 15:09:53
