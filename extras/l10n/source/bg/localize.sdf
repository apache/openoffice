helpcontent2	source\text\sbasic\guide\sample_code.xhp	0	help	par_id3144504				0	bg	oListbox.additem("Нов елемент" & iCount,0)				20200411 15:09:53
helpcontent2	source\text\sbasic\guide\sample_code.xhp	0	help	par_id3149328				0	bg	end sub				20200411 15:09:53
helpcontent2	source\text\sbasic\guide\sample_code.xhp	0	help	hd_id3147071				0	bg	Премахване на елемент от списъчно поле				20200411 15:09:53
helpcontent2	source\text\sbasic\guide\sample_code.xhp	0	help	par_id3159095				0	bg	Sub RemoveEntry				20200411 15:09:53
helpcontent2	source\text\sbasic\guide\sample_code.xhp	0	help	par_id3154958				0	bg	BasicLibraries.LoadLibrary("Tools")				20200411 15:09:53
helpcontent2	source\text\sbasic\guide\sample_code.xhp	0	help	par_id3149443				0	bg	oDialog1 = LoadDialog("Standard", "Dialog1")				20200411 15:09:53
helpcontent2	source\text\sbasic\guide\sample_code.xhp	0	help	par_id3153247				0	bg	REM Премахване на първия елемент от списъчното поле				20200411 15:09:53
helpcontent2	source\text\sbasic\guide\sample_code.xhp	0	help	par_id3151302				0	bg	oDialog1Model = oDialog1.Model				20200411 15:09:53
helpcontent2	source\text\sbasic\guide\sample_code.xhp	0	help	par_id3153976				0	bg	oListBox = oDialog1.GetControl("ListBox1")				20200411 15:09:53
helpcontent2	source\text\sbasic\guide\sample_code.xhp	0	help	par_id3155383				0	bg	oListbox.removeitems(0,1)				20200411 15:09:53
