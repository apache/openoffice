helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153824				0	bg	, = число с разделител на хилядите				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153837				0	bg	F = число без разделител на хилядите				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150318				0	bg	C = валутен формат				20200411 15:09:53
