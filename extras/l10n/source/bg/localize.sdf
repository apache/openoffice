helpcontent2	source\text\shared\01\05220000.xhp	0	help	par_id3150279				0	bg	\<ahelp hid=\"HID_PAGE_TEXTATTR\"\>Задава оформлението и свойствата на закотвяне за текст в избрания графичен или текстов обект.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	par_id3154794				0	bg	Текстът се позиционира относително спрямо краищата на графичния или текстов обект.				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	hd_id3149031				0	bg	Текст				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	hd_id3150445				0	bg	Ширина според текста				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	par_id3145629				0	bg	\<ahelp hid=\"SVX_TRISTATEBOX_RID_SVXPAGE_TEXTATTR_TSB_AUTOGROW_WIDTH\"\>Разширява обекта хоризонтално до ширината на текста, ако обектът е по-малък от текста.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	hd_id3149511				0	bg	Височина според текста				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	par_id3149640				0	bg	\<ahelp hid=\"SVX_TRISTATEBOX_RID_SVXPAGE_TEXTATTR_TSB_AUTOGROW_HEIGHT\"\>Увеличава височината на обекта до тази на текста, ако обектът е по-малък от текста.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	hd_id3152867				0	bg	Побиране в рамката				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	par_id3147834				0	bg	\<ahelp hid=\"SVX_TRISTATEBOX_RID_SVXPAGE_TEXTATTR_TSB_FIT_TO_SIZE\"\>Преоразмерява текста, за да запълни цялата област на графичния или текстов обект.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	hd_id3155892				0	bg	Напасване по контура				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	par_id3153577				0	bg	\<ahelp hid=\"SVX_TRISTATEBOX_RID_SVXPAGE_TEXTATTR_TSB_CONTOUR\"\>Приспособява изливането на текста така, че да пасва на контурите на избрания графичен обект.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	par_idN10705				0	bg	Пренасяне по думи във фигурата				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	par_idN10709				0	bg	\<ahelp hid=\".\"\>Пренася по думи текста, който добавяте чрез двукратно щракване върху фигурата, така че да се побира в очертанията й.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	par_idN10720				0	bg	Напасване на фигурата по текста				20200411 15:09:53
