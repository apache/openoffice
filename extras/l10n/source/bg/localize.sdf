helpcontent2	source\text\sbasic\shared\03010303.xhp	0	help	par_id3155306				0	bg	"червено= " & Red(lVar) & Chr(13)&_				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010303.xhp	0	help	par_id3149262				0	bg	"зелено= " & Green(lVar) & Chr(13)&_				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03010303.xhp	0	help	par_id3147397				0	bg	"синьо= " & Blue(lVar) & Chr(13), 64, "Цветове"				20200411 15:09:53
