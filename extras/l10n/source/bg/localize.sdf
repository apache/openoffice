helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3153351				0	bg	Пример				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150424	151			0	bg	\<item type=\"input\"\>=PERMUT(6; 3)\</item\> връща 120. Съществуват 120 различни възможности за избиране на поредица от 3 карти за игра от общо 6.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3143276				0	bg	\<bookmark_value\>PERMUTATIONA, функция\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3143276				0	bg	PERMUTATIONA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3144759				0	bg	\<ahelp hid=\"HID_FUNC_VARIATIONEN2\"\>Връща броя на пермутациите за зададен брой обекти (разрешават се повторения).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3145598				0	bg	Синтаксис				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149298				0	bg	PERMUTATIONA(Брой1; Брой2)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3156139	157			0	bg	\<emph\>Брой1\</emph\> е общият брой на обектите.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149519	158			0	bg	\<emph\>Брой2\</emph\> е броят на обектите във всяка пермутация.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3151382				0	bg	Пример				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153949				0	bg	По колко начина могат да бъдат избрани 2 обекта от общо 11?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149233	161			0	bg	\<item type=\"input\"\>=PERMUTATIONA(11; 2)\</item\> връща 121.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150622	162			0	bg	\<item type=\"input\"\>=PERMUTATIONA(6; 3)\</item\> връща 216. Съществува 216 различни начина да се образува последователност от 3 карти за игра от общо 6, ако всяка от картите се връща преди изтеглянето на следващата.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3152952				0	bg	\<bookmark_value\>PROB, функция\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3152952				0	bg	PROB				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154110				0	bg	\<ahelp hid=\"HID_FUNC_WAHRSCHBEREICH\"\>Връща вероятността стойностите в дадена област да бъдат в определени граници.\</ahelp\> Ако не е зададен \<item type=\"literal\"\>Край\</item\>, функцията изчислява вероятността при предположение, че стойностите от параметъра \<item type=\"literal\"\>Данни\</item\> са равни на \<item type=\"literal\"\>Начало\</item\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3146810				0	bg	Синтаксис				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3147330				0	bg	PROB(Данни; Вероятност; Начало; Край)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154573	168			0	bg	\<emph\>Данни\</emph\> е масивът или областта с данните на извадката.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3156334	169			0	bg	\<emph\>Вероятност\</emph\> е масивът или областта със съответните вероятности.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3151107	170			0	bg	\<emph\>Начало\</emph\> е началната стойност на интервала, за който трябва да се сумират вероятностите.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153694	171			0	bg	\<emph\>Край\</emph\> (незадължителен) е крайната стойност на интервала, за който трябва да се сумират вероятностите. Ако параметърът липсва, се изчислява вероятността за стойността на \<emph\>Начало\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3147574				0	bg	Пример				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153666	173			0	bg	\<item type=\"input\"\>=PROB(A1:A50; B1:B50; 50;60)\</item\> връща вероятността, с която стойност от областта A1:A50 се намира и в границите между 50 и 60. Всяка стойност от областта A1:A50 има вероятност, зададена в B1:B50.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3150941				0	bg	\<bookmark_value\>WEIBULL, функция\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3150941				0	bg	WEIBULL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154916				0	bg	\<ahelp hid=\"HID_FUNC_WEIBULL\"\>Изчислява стойностите на разпределението на Вейбул.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id0305200911372767				0	bg	Разпределението на Вейбул е непрекъснато вероятностно разпределение с параметри Алфа > 0 (форма) и Бета > 0 (мащаб). 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id0305200911372777				0	bg	Ако К = 0, WEIBULL изчислява функцията на плътност.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id0305200911372743				0	bg	Ако К = 1, WEIBULL изчислява кумулативната функция на разпределението.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3159393				0	bg	Синтаксис				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154478				0	bg	WEIBULL(Число; Алфа; Бета; К)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3151317	179			0	bg	\<emph\>Число\</emph\> е стойността, за която се изчислява разпределението на Вейбул.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3158436	180			0	bg	\<emph\>Алфа \</emph\> е параметърът „алфа“ на разпределението на Вейбул.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154668	181			0	bg	\<emph\>Бета\</emph\> е параметърът „бета“ на разпределението на Вейбул.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154825	182			0	bg	\<emph\>К\</emph\> определя вида на функцията.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3153794				0	bg	Пример				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3146077	184			0	bg	\<item type=\"input\"\>=WEIBULL(2; 1; 1; 1)\</item\> връща 0,86.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id0305200911372899				0	bg	See also the \<link href=\"https://wiki.openoffice.org/wiki/Documentation/How_Tos/Calc:_WEIBULL_function\"\>Wiki page\</link\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	tit				0	bg	Финансови функции, трета част				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3146780				0	bg	Финансови функции, трета част				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3145112				0	bg	\<bookmark_value\>ODDFPRICE, функция\</bookmark_value\>\<bookmark_value\>цени;ценни книжа с нерегулярен първи период\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3145112				0	bg	ODDFPRICE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3147250				0	bg	\<ahelp hid=\"HID_AAI_FUNC_ODDFPRICE\"\>Изчислява цената за 100 парични единици номинална стойност на ценна книга с нерегулярен първи период.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3153074				0	bg	Синтаксис				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3146098				0	bg	ODDFPRICE(Сделка; Падеж; ДатаНаИздаване; ПървиКупон; Лихва; Доходност; ПогСтойност; Честота; Основа)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153337				0	bg	\<emph\>Сделка\</emph\> е датата на закупуване на ценната книга.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149051				0	bg	\<emph\>Падеж\</emph\> е датата на падежа на ценната книга, когато срокът й изтича.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3147297				0	bg	\<emph\>ДатаНаИздаване\</emph\> е датата на издаването на ценната книга.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150393				0	bg	\<emph\>ПървиКупон\</emph\> е датата на първия купон на ценната книга.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3147402				0	bg	\<emph\>Лихва\</emph\> е годишният лихвен процент.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3151387				0	bg	\<emph\>Доходност\</emph\> е годишната доходност на ценната книга.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153023				0	bg	\<emph\>ПогСтойност\</emph\> е погасителната стойност на книгата за 100 парични единици от номиналната стойност.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150539				0	bg	\<emph\>Честота\</emph\> е броят на купонните плащания за една година (1, 2 или 4).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3157871				0	bg	\<bookmark_value\>ODDFYIELD, функция\</bookmark_value\>				20200411 15:09:53
