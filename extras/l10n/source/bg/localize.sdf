helpcontent2	source\text\shared\01\02220000.xhp	0	help	par_id3150870				0	bg	\<ahelp hid=\"HID_IMAPDLG_RECT\"\>Създава правоъгълна чувствителна област на мястото, на което плъзнете курсора в графиката. След това можете да въведете \<emph\>адрес и текст\</emph\> за чувствителната област и да изберете \<emph\>рамката\</emph\>, в която да се отвори зададеният URL.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02220000.xhp	0	help	par_id3150769				0	bg	\<image id=\"img_id3154297\" src=\"res/commandimagelist/sc_rect.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3154297\"\>Икона\</alt\>\</image\>				20200411 15:09:53
