helpcontent2	source\text\swriter\01\format_object.xhp	0	help	par_idN10558				0	bg	\<ahelp hid=\".\"\>Отваря подменю за редактиране свойствата на избрания обект.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\format_object.xhp	0	help	hd_id1863460				0	bg	\<link href=\"text/shared/01/05990000.xhp\"\>Атрибути на текста\</link\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\format_object.xhp	0	help	par_id3542588				0	bg	Задава оформлението и закотвянето на текста в избрания графичен или текстов обект.				20200411 15:09:53
helpcontent2	source\text\swriter\01\format_object.xhp	0	help	par_id9466841				0	bg	\<link href=\"text/shared/01/05280000.xhp\"\>Fontwork\</link\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\format_object.xhp	0	help	par_id2874538				0	bg	Редактира ефектите на Fontwork на избрания обект, който е бил създаден с предишния диалогов прозорец на Fontwork.				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	tit				0	bg	Тип				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	bm_id9646290				0	bg	\<bookmark_value\>преоразмеряване; отношение\</bookmark_value\>\<bookmark_value\>отношение; преоразмеряване на обекти\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3151389				0	bg	\<link href=\"text/swriter/01/05060100.xhp\" name=\"Тип\"\>Тип\</link\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3150568				0	bg	\<ahelp hid=\"HID_FRM_STD\"\>Определя размера и позицията на избрания обект или рамка върху страницата.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3147168				0	bg	Размер				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3147567				0	bg	Ширина				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3151180				0	bg	\<ahelp hid=\"SW:METRICFIELD:TP_FRM_STD:ED_WIDTH\"\>Въведете желаната ширина на избрания обект.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3154646				0	bg	Относителна				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3145413				0	bg	\<ahelp hid=\"SW:CHECKBOX:TP_FRM_STD:CB_REL_WIDTH\"\>Изчислява ширината на избрания обект в проценти от ширината на текстовата област от страницата.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3147516				0	bg	Височина				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3154099				0	bg	\<ahelp hid=\"SW:METRICFIELD:TP_FRM_STD:ED_HEIGHT\"\>Въведете желаната височина на избрания обект.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3149809				0	bg	Относителна				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3154563				0	bg	\<ahelp hid=\"SW:CHECKBOX:TP_FRM_STD:CB_REL_HEIGHT\"\>Изчислява височината на избрания обект в проценти от височината на текстовата област от страницата.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3151313				0	bg	Запазване на пропорциите				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3153675				0	bg	\<ahelp hid=\"SW:CHECKBOX:TP_FRM_STD:CB_FIXEDRATIO\"\>Запазва съотношението между ширината и височината, когато промените настройката за ширина или височина.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3154470				0	bg	Оригинален размер				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3155898				0	bg	\<ahelp hid=\"SW:PUSHBUTTON:TP_FRM_STD:BT_REALSIZE\"\>Връща оригиналните стойности на настройките за размери на избрания обект.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3149102				0	bg	Тази настройка не е достъпна за рамки.				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3149824				0	bg	Автоматично				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3151262				0	bg	\<ahelp hid=\"SW:CHECKBOX:TP_FRM_STD:CB_AUTOHEIGHT\"\>Автоматично нагласява ширината или височината на рамка, за да пасне на съдържанието й. Ако желаете, можете да зададете минимална ширина или минимална височина за рамката.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3152773				0	bg	Настройката \<emph\>Автоматично\</emph\> е налице само когато изберете рамка.				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3155144				0	bg	Закотвяне				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3153352				0	bg	Задайте настройките за закотвяне на избрания обект или рамка. Настройките за закотвяне не са достъпни, когато отворите диалоговия прозорец от прозореца Стилове и формати.				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3156269				0	bg	Към страница				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3149169				0	bg	\<ahelp hid=\"SW_RADIOBUTTON_TP_FRM_STD_RB_ANCHOR_PAGE\"\>Закотвя избраното към текущата страница.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3151028				0	bg	Към абзац				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3145777				0	bg	\<ahelp hid=\"SW_RADIOBUTTON_TP_FRM_STD_RB_ANCHOR_PARA\"\>Закотвя избраното към текущия абзац.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3155913				0	bg	Към знак				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3151377				0	bg	\<ahelp hid=\"SW_RADIOBUTTON_TP_FRM_STD_RB_ANCHOR_AT_CHAR\"\>Закотвя избраното към знак.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3150115				0	bg	Като знак				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3155863				0	bg	\<ahelp hid=\"SW_RADIOBUTTON_TP_FRM_STD_RB_ANCHOR_AS_CHAR\"\>Закотвя избраното като знак. Височината на текущия ред се променя, за да съответства на височината на избраното.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3150693				0	bg	Позиция				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3147413				0	bg	Задайте местоположението на избрания обект върху текущата страница.				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3147488				0	bg	Хоризонтално				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3145121				0	bg	\<ahelp hid=\"SW:LISTBOX:TP_FRM_STD:DLB_HORIZONTAL\"\>Изберете настройката за хоризонтално подравняване на обекта.\</ahelp\> Тази настройка не е достъпна, ако изберете "закотвяне като знак".				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3149554				0	bg	с				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3145258				0	bg	\<ahelp hid=\"SW:METRICFIELD:TP_FRM_STD:ED_AT_HORZ_POS\"\>Въведете разстоянието, което да бъде оставено между левия край на избрания обект и отправната точка, избрана в полето \<emph\>Спрямо\</emph\>.\</ahelp\> Тази настройка е достъпна само ако изберете "Отляво" в полето \<emph\>Хоризонтално\</emph\>.				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3150545				0	bg	спрямо				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3149213				0	bg	\<ahelp hid=\"SW:LISTBOX:TP_FRM_STD:LB_HORI_RELATION\"\>Изберете отправната точка за избраното хоризонтално подравняване.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3149230				0	bg	Можете да видите резултата от избраните от вас настройки за подравняване в полето за мостра.				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3147746				0	bg	Обръщане на четните страници				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3146337				0	bg	\<ahelp hid=\"SW:CHECKBOX:TP_FRM_STD:CB_MIRROR\"\>Обръща текущите настройки за хоризонтално подравняване на четните страници.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3148446				0	bg	Можете да ползвате и настройките за обръщане на \<link href=\"text/swriter/01/05060300.xhp\" name=\"Графики\"\>\<emph\>графики\</emph\>\</link\>, за да настроите оформлението на обектите в четните и нечетните страници.				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3145310				0	bg	Вертикално				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3150161				0	bg	\<ahelp hid=\"SW:LISTBOX:TP_FRM_STD:DLB_VERTICAL\"\>Изберете режима на вертикално подравняване за обекта.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3150463				0	bg	Ако закотвите обекта за рамка с фиксирана височина, са достъпни само вариантите "Долу" и "Центрирано".				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3154724				0	bg	с				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3156130	34			0	bg	\<ahelp hid=\"SW:METRICFIELD:TP_FRM_STD:ED_AT_VERT_POS\"\>Въведете разстоянието, което да бъде оставено между горния край на избрания обект и отправната точка, избрана в полето \<emph\>Спрямо\</emph\>.\</ahelp\> Тази настройка е достъпна само ако изберете "Отгоре" или "Отдолу" (като знак) в полето \<emph\>Вертикално\</emph\>. 				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3150912				0	bg	спрямо				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3155075				0	bg	\<ahelp hid=\"SW:LISTBOX:TP_FRM_STD:LB_VERT_RELATION\"\>Изберете отправната точка за избраното вертикално подравняване.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_idN10A8E				0	bg	Следване изливането на текста				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_idN10A92				0	bg	\<ahelp hid=\"sw:CheckBox:TP_FRM_STD:CB_FOLLOWTEXTFLOW\"\>Запазва избрания обект в границите на текста, към който обектът е закотвен. Ако желаете обектът да може да бъде поставен на произволно място в документа, не отмятайте това поле.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_idN10AA6				0	bg	По подразбиране полето \<emph\>Следване изливането на текста\</emph\> се отмята при отваряне на документ, създаден с версия на %PRODUCTNAME преди %PRODUCTNAME %PRODUCTVERSION. Когато създавате документ или отваряте документ във формата на Microsoft Word (*.doc), полето не се отмята.				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3149241				0	bg	Зеленият правоъгълник представя избрания обект, а червеният - отправната точка на подравняването. Ако закотвите обекта като знак, отправният правоъгълник се заменя с червена линия.				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3146949				0	bg	\<link href=\"text/shared/01/05260000.xhp\" name=\"Форматиране - Котва\"\>\<emph\>Форматиране - Закотвяне\</emph\>\</link\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3153231				0	bg	\<link href=\"text/shared/01/05070000.xhp\" name=\"Форматиране - Подравняване\"\>\<emph\>Форматиране - Подравняване\</emph\>\</link\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	tit				0	bg	Нов списък с адреси				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN10542				0	bg	Нов списък с адреси				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN10546				0	bg	Въведете нови адреси или редактирайте адресите за \<link href=\"text/swriter/01/mailmerge03.xhp\"\>циркулярните\</link\> документи. Когато натиснете \<emph\>OK\</emph\>, ще бъдете запитани чрез диалогов прозорец за мястото на съхраняване на адресния списък.				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN10557				0	bg	Адресна информация				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN1055B				0	bg	\<ahelp hid=\".\"\>Въведете или редактирайте съдържанието на полетата за всеки получател.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN1055E				0	bg	Показване на номерацията				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN10574				0	bg	\<ahelp hid=\".\"\>Натискайте бутоните, за да преминавате между записите, или въведете номер на запис за показване на записа.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN10577				0	bg	Нов				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN1057B				0	bg	\<ahelp hid=\".\"\>Добавя нов празен запис в списъка с адреси.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN1057E				0	bg	Изтриване				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN10582				0	bg	\<ahelp hid=\".\"\>Изтрива избрания запис.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN10585				0	bg	Търсене				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN10589				0	bg	\<ahelp hid=\".\"\>Отваря диалоговия прозорец \<link href=\"text/swriter/01/mm_finent.xhp\"\>Търсене на запис\</link\>. Можете да оставите този прозорец отворен, докато редактирате записа.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN1059A				0	bg	Персонализиране				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN1059E				0	bg	\<ahelp hid=\".\"\>Отваря диалоговия прозорец \<link href=\"text/swriter/01/mm_cusaddlis.xhp\"\>Настройка на списък с адреси\</link\>, където можете да преподредите, преименувате, добавяте и изтривате полета.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04120226.xhp	0	help	tit				0	bg	Записи (таблица на обектите)				20200411 15:09:53
