helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3153920				0	bg	14				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3148429				0	bg	\<item type=\"input\"\>>600\</item\>				20200411 15:09:53
