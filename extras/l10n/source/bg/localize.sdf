helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3154491				0	bg	dAngle = InputBox$("Въведете ъгъла в градуси: ", "Ъгъл")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3151074				0	bg	Print "Дължината на хипотенузата е "; (d1 / Cos (dAngle * Pi / 180))				20200411 15:09:53
