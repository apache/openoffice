helpcontent2	source\text\sbasic\shared\03120103.xhp	0	help	par_id3145069				0	bg	iVar = 123.123				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120103.xhp	0	help	par_id3153897				0	bg	sVar = LTrim(Str(iVar))				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120103.xhp	0	help	par_id3154924				0	bg	MsgBox sVar & Chr(13) & Str(iVar)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120103.xhp	0	help	par_id3152811				0	bg	End Sub				20200411 15:09:53
