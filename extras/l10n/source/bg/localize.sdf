helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3163824				0	bg	ERF(ДолнаГраница; ГорнаГраница)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3149715				0	bg	\<emph\>ДолнаГраница\</emph\> е долната граница на интеграла.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3156294				0	bg	\<emph\>ГорнаГраница\</emph\> е не задължителен. Той указва горната граница на интеграла. Ако е пропуснат, изчислението се извършва между 0 и долната граница.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3154819				0	bg	Пример				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3152974				0	bg	\<item type=\"input\"\>=ERF(0;1)\</item\> връща 0,842701.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	bm_id3145082				0	bg	\<bookmark_value\>ERFC, функция\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3145082				0	bg	ERFC				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3149453				0	bg	\<ahelp hid=\"HID_AAI_FUNC_ERFC\"\>Връща допълнителните стойности на Гаусовия интеграл на грешките между x и безкрайност.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3155839				0	bg	Синтаксис				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3153220				0	bg	ERFC(ДолнаГраница)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3147620				0	bg	\<emph\>ДолнаГраница\</emph\> е долната граница на интеграла.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3146861				0	bg	Пример				20200411 15:09:53
