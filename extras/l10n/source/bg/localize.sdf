helpcontent2	source\text\sbasic\shared\03102101.xhp	0	help	par_id3155174				0	bg	iVar(iCount) = iCount				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102101.xhp	0	help	par_id3163805				0	bg	Next iCount				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102101.xhp	0	help	par_id3149568				0	bg	ReDim iVar(10) As Integer				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102101.xhp	0	help	par_id3147364				0	bg	For iCount = 1 To 10				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102101.xhp	0	help	par_id3155335				0	bg	iVar(iCount) = iCount				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102101.xhp	0	help	par_id3154662				0	bg	Next iCount				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03102101.xhp	0	help	par_id3149926				0	bg	End Sub				20200411 15:09:53
