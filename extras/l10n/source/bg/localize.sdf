helpcontent2	source\text\simpress\02\13020000.xhp	0	help	hd_id3149664				0	bg	\<link href=\"text/simpress/02/13020000.xhp\" name=\"Режим на въртене след щракване върху обект\"\>Режим "въртене" след щракване върху обект\</link\>				20200411 15:09:53
helpcontent2	source\text\simpress\02\13020000.xhp	0	help	par_id3154320				0	bg	\<ahelp hid=\".uno:ClickChangeRotation\"\>Променя действието на щракването с мишката така, че манипулаторите за въртене да се появяват след като щракнете върху обект с мишката и после щракнете върху него повторно.\</ahelp\> Плъзнете някой от манипулаторите, за да завъртите обекта в желаната посока.				20200411 15:09:53
helpcontent2	source\text\simpress\02\13020000.xhp	0	help	par_id3155066				0	bg	\<image id=\"img_id3153714\" src=\"res/commandimagelist/sc_clickchangerotation.png\" width=\"5.64mm\" height=\"5.64mm\"\>\<alt id=\"alt_id3153714\"\>Икона\</alt\>\</image\>				20200411 15:09:53
