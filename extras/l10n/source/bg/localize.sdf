helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152806				0	bg	PHI				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150254				0	bg	\<ahelp hid=\"HID_FUNC_PHI\"\>Връща стойностите на функцията на разпределението за стандартно нормално разпределение.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154748				0	bg	Синтаксис				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149976				0	bg	PHI(Число)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156108				0	bg	\<emph\>Число\</emph\> е стойност, за която се изчислява стандартното нормално разпределение.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153621				0	bg	Пример				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155849				0	bg	\<item type=\"input\"\>=PHI(2,25) \</item\>= 0,03				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3143236				0	bg	\<item type=\"input\"\>=PHI(-2,25)\</item\> = 0,03				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149286				0	bg	\<item type=\"input\"\>=PHI(0)\</item\> = 0,4				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153985				0	bg	\<bookmark_value\>POISSON, функция\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153985				0	bg	POISSON				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154298				0	bg	\<ahelp hid=\"HID_FUNC_POISSON\"\>Изчислява разпределенеито на Поасон.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3159183				0	bg	Синтаксис				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146093				0	bg	POISSON(Число; Средно; К)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147253				0	bg	\<emph\>Число\</emph\> е стойността, за която се изчислява разпределението на Поасон.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151177				0	bg	\<emph\>Средно\</emph\> е средната стойност на разпределението на Поасон.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149200				0	bg	\<emph\>К\</emph\> (optional) = 0 или False означава изчисляване на функцията на плътност; \<emph\>К\</emph\> = 1 или True означава изчисляване на разпределението. Ако е пропуснат, при запазване на документа се вмъква  подразбираната стойност True за по-добра съвместимост с други програми и по-стари версии на %PRODUCTNAME.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3159347				0	bg	Пример				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150113				0	bg	\<item type=\"input\"\>=POISSON(60;50;1)\</item\> връща 0,93.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153100				0	bg	\<bookmark_value\>PERCENTILE, функция\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153100				0	bg	PERCENTILE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154940				0	bg	\<ahelp hid=\"HID_FUNC_QUANTIL\"\>Връща избран процентил на данни в масив.\</ahelp\> Процентилът представлява относителна позиция в последователност от данни, която се мени от най-малката стойност (Алфа=0) до най-голямата (Алфа=1). При \<item type=\"literal\"\>Алфа\</item\> = 25% процентилът представлява първия квартил, а \<item type=\"literal\"\>Алфа\</item\> = 50% е медианата.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150531				0	bg	Синтаксис				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148813				0	bg	PERCENTILE(Данни; Алфа)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153054				0	bg	\<emph\>Данни\</emph\> е масивът с данни.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154212				0	bg	\<emph\>Алфа\</emph\> е относителна стойност между 0 и 1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154290				0	bg	Пример				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159147				0	bg	\<item type=\"input\"\>=PERCENTILE(A1:A50; 0,1)\</item\> намира стойността в набора от данни, която отговаря на 10% от общия обхват на данните в A1:A50.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148807				0	bg	\<bookmark_value\>PERCENTRANK, функция\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148807				0	bg	PERCENTRANK				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153573				0	bg	\<ahelp hid=\"HID_FUNC_QUANTILSRANG\"\>Връща процентния ранг на стойност от извадка.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147512				0	bg	Синтаксис				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147238				0	bg	PERCENTRANK(Данни; Стойност)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154266				0	bg	\<emph\>Данни\</emph\> е масивът с данните в извадката.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148475				0	bg	\<emph\>Стойност\</emph\> е стойността, чийто процентилен ранг трябва да се определи.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155364				0	bg	Пример				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149163				0	bg	\<item type=\"input\"\>=PERCENTRANK(A1:A50; 50)\</item\> връща процентния ранг на стойността 50 измежду всички данни в A1:A50. Ако 50 попада извън общия им обхват, ще се изпише съобщение за грешка.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3166442				0	bg	\<bookmark_value\>QUARTILE, функция\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3166442				0	bg	QUARTILE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146958				0	bg	\<ahelp hid=\"HID_FUNC_QUARTILE\"\>Намира квартила на набор от данни.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152942				0	bg	Синтаксис				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153684				0	bg	QUARTILE(Данни; Тип)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153387				0	bg	\<emph\>Данни\</emph\> е масивът с данните в извадката.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155589				0	bg	\<emph\>Тип\</emph\> е типът на квартила: 0 = MIN, 1 = 25%, 2 = 50% (MEDIAN), 3 = 75% и 4 = MAX.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149103				0	bg	Пример				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159276				0	bg	\<item type=\"input\"\>=QUARTILE(A1:A50; 2)\</item\> връща стойността, която отговаря на относителна позиция 50% между най-ниската и най-високата стойност на данните от областта A1:A50.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	tit				0	bg	Сричкопренасяне				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	bm_id3159399				0	bg	\<bookmark_value\>автоматично сричкопренасяне в електронни таблици\</bookmark_value\>\<bookmark_value\>сричкопренасяне; в електронни таблици\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	hd_id3159399				0	bg	Сричкопренасяне				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3145068	2			0	bg	\<variable id=\"silben\"\>\<ahelp hid=\".uno:Hyphenate\"\>Командата \<emph\>Сричкопренасяне\</emph\> извиква диалоговия прозорец за настройка на сричкопренасянето в $[officename] Calc.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3154366				0	bg	За да включите автоматичното сричкопренасяне в $[officename] Calc, трябва да е включен режимът за \<link href=\"text/shared/01/05340300.xhp\" name=\"пренасяне на текста\"\>пренасяне на текста\</link\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	hd_id3153192				0	bg	Сричкопренасяне за избраните клетки				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3150868				0	bg	Изберете клетките, за които желаете да промените настройката за сричкопренасяне.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3150440				0	bg	Изберете \<emph\>Инструменти - Език - Сричкопренасяне\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3156441				0	bg	Ще се появи диалоговият прозорец \<emph\>Форматиране на клетки\</emph\>, отворен на раздела \<emph\>Подравняване\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3149260				0	bg	Отметнете полетата \<emph\>Автоматично пренасяне на текста\</emph\> и \<emph\>Активиране на сричкопренасянето\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	hd_id3153094				0	bg	Сричкопренасяне за графични обекти				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3148577				0	bg	Изберете графичен обект.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3156285				0	bg	Изберете \<emph\>Инструменти - Език - Сричкопренасяне\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3147394				0	bg	Всяко избиране на командата превключва сричкопренасянето за графичния обект между включено и изключено. Отметката показва текущото състояние.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	tit				0	bg	NOW				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	bm_id3150521				0	bg	\<bookmark_value\>NOW, функция\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	hd_id3150521				0	bg	\<variable id=\"now\"\>\<link href=\"text/scalc/01/func_now.xhp\"\>NOW\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	par_id3148829				0	bg	\<ahelp hid=\"HID_FUNC_JETZT\"\>Връща системната дата и час на компютъра.\</ahelp\> Стойността се обновява, когато документът бъде преизчислен или когато се промени стойност на клетка.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	hd_id3146988				0	bg	Синтаксис				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	par_id3154897				0	bg	NOW()				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	par_id4598529				0	bg	NOW е функция без аргументи.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	hd_id3154205				0	bg	Пример				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	par_id3150774				0	bg	\<item type=\"input\"\>=NOW() - A1\</item\> връща разликата между датата в A1 и настоящия момент. Форматирайте резултата като число.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	tit				0	bg	TIMEVALUE 				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	bm_id3146755				0	bg	\<bookmark_value\>TIMEVALUE, функция\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	hd_id3146755				0	bg	\<variable id=\"timevalue\"\>\<link href=\"text/scalc/01/func_timevalue.xhp\"\>TIMEVALUE\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3148502				0	bg	\<ahelp hid=\"HID_FUNC_ZEITWERT\"\>TIMEVALUE връща вътрешното числово представяне на час от текст, ограден с кавички и форматиран като час.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3150794				0	bg	Вътрешното числово представяне е десетично число и зависи от системата за дати, използвана от $[officename].				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id011920090347118				0	bg	Ако текстовият низ съдържа и година, месец или ден, TIMEVALUE връща само дробната част на резултата от преобразуванието.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	hd_id3150810				0	bg	Синтаксис				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3150823				0	bg	TIMEVALUE("Текст")				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3152556	165			0	bg	\<emph\>Текст\</emph\> е валиден израз – час, който трябва да е ограден с кавички.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	hd_id3146815				0	bg	Примери				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3146829	167			0	bg	\<item type=\"input\"\>=TIMEVALUE("4PM")\</item\> връща 0,67. Ако резултатът е с формат HH:MM:SS, ще получите 16:00:00.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3153632	168			0	bg	\<item type=\"input\"\>=TIMEVALUE("24:00")\</item\> връща 1. Ако използвате формата за час HH:MM:SS, стойността е 00:00:00.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090100.xhp	0	help	tit				0	bg	Избор на източник				20200411 15:09:53
