helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3157906				0	bg	\<emph\>Сделка\</emph\> е датата на закупуване на ценната книга.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150026				0	bg	\<emph\>Падеж\</emph\> е датата на падежа на ценната книга, когато срокът й изтича.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149012				0	bg	\<emph\>ДатаНаИздаване\</emph\> е датата на издаването на ценната книга.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148725				0	bg	\<emph\>ПървиКупон\</emph\> е датата на първия купон на ценната книга.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150465				0	bg	\<emph\>Лихва\</emph\> е годишният лихвен процент.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3146940				0	bg	\<emph\>Цена\</emph\> е цената на ценната книга.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149893				0	bg	\<emph\>ПогСтойност\</emph\> е погасителната стойност на книгата за 100 парични единици от номиналната стойност.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148888				0	bg	\<emph\>Честота\</emph\> е броят на купонните плащания за една година (1, 2 или 4).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3153933				0	bg	\<bookmark_value\>ODDLPRICE, функция\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3153933				0	bg	ODDLPRICE				20200411 15:09:53
