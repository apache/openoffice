helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153044				0	bg	\<emph\>Н\</emph\> е броят на неуспехите.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151018				0	bg	\<emph\>У\</emph\> е броят на успехите.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148878				0	bg	\<emph\>ВУ\</emph\> е вероятността за успех в един опит.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149539				0	bg	Пример				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148770				0	bg	\<item type=\"input\"\>=NEGBINOMDIST(1; 1; 0,5)\</item\> връща 0,25.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3155516				0	bg	\<bookmark_value\>NORMINV, функция\</bookmark_value\>\<bookmark_value\>нормално разпределение;обратно\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155516				0	bg	NORMINV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154634				0	bg	\<ahelp hid=\"HID_FUNC_NORMINV\"\>Изчислява обратното нормално кумулативно разпределение.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153227				0	bg	Синтаксис				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147534				0	bg	NORMINV(Число; Средно; СтОткл)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154950				0	bg	\<emph\>Число\</emph\> е вероятностната стойност, за която се изчислява обратното нормално разпределение.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150690				0	bg	\<emph\>Средно\</emph\> е средното аритметично на нрмалното разпределение.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148594				0	bg	\<emph\>СтОткл\</emph\> е стандартното отклонение на нормалното разпределение.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155822				0	bg	Пример				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153921				0	bg	\<item type=\"input\"\>=NORMINV(0,9; 63; 5)\</item\> връща 69,41. Ако средното яйце тежи 63 грама със стандартно отклонение 5, съществува 90% вероятност яйцето да не тежи повече от 69,41 грама.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153722				0	bg	\<bookmark_value\>NORMDIST, функция\</bookmark_value\>\<bookmark_value\>функция на плътност\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153722				0	bg	NORMDIST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150386				0	bg	\<ahelp hid=\"HID_FUNC_NORMVERT\"\>Изчислява функцията на плътност на нормалното кумулативно разпределение.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3083282				0	bg	Синтаксис				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150613				0	bg	NORMDIST(Число; Средно; СтОткл; К)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149820				0	bg	\<emph\>Число\</emph\> е стойността, за която се изчислява нормалното разпределение.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146063				0	bg	\<emph\>Средно\</emph\> е средното аритметично на разпределението.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156295				0	bg	\<emph\>СтОткл\</emph\> е стандартното отклонение на разпределението.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145080				0	bg	\<emph\>К\</emph\> не е задължително. \<emph\>К\</emph\> = 0 означава изчисляване на функцията на плътност, а \<emph\>К\</emph\> = 1 – на разпределението.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152972				0	bg	Пример				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149283				0	bg	\<item type=\"input\"\>=NORMDIST(70; 63; 5; 0)\</item\> връща 0,03.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149448				0	bg	\<item type=\"input\"\>=NORMDIST(70; 63; 5; 1)\</item\> връща 0,92.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3152934				0	bg	\<bookmark_value\>PEARSON, функция\</bookmark_value\>				20200411 15:09:53
