helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3145251				0	bg	d1 = InputBox$("Въведете дължината на срещулежащия катет: ", "Срещулежащ катет")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3148456				0	bg	dAlpha = InputBox$("Въведете ъгъла в градуси: ", "Ъгъл")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080103.xhp	0	help	par_id3153877				0	bg	Print "Дължината на хипотенузата е "; (d1 / Sin(dAlpha * Pi / 180))				20200411 15:09:53
