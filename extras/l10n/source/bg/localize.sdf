helpcontent2	source\text\swriter\01\05060200.xhp	0	help	hd_id3153229				0	bg	Първи абзац				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060200.xhp	0	help	par_id3154333				0	bg	\<variable id=\"ersterabsatztext\"\>\<ahelp hid=\".uno:WrapAnchorOnly\"\>Започва нов абзац под обекта, след като натиснете Enter.\</ahelp\> Разстоянието между абзаците се определя от размера на обекта. \</variable\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060200.xhp	0	help	hd_id3148790				0	bg	Във фона				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060200.xhp	0	help	par_id3150100				0	bg	\<variable id=\"hintergrundtext\"\>\<ahelp hid=\".uno:WrapThroughTransparent\"\>Moves the selected object to the background. This option is only available if you selected the\<emph\> Through\</emph\> wrap type.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060200.xhp	0	help	hd_id3149358				0	bg	Контур				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060200.xhp	0	help	par_id3155793				0	bg	\<variable id=\"konturtext\"\>\<ahelp hid=\".uno:WrapContour\"\>Текстът обтича плътно формата на обекта. Тази настройка не е достъпна в режима на обтичане \<emph\>През\</emph\>, както и за рамки.\</ahelp\> За да промените контура на обект, изберете обекта и изберете \<emph\>Форматиране - Обтичане - \</emph\>\<link href=\"text/swriter/01/05060201.xhp\" name=\"Редактиране на контура\"\>\<emph\>Редактиране на контура\</emph\>\</link\>. \</variable\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060200.xhp	0	help	hd_id3154620				0	bg	Само отвън				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060200.xhp	0	help	par_id3147377				0	bg	\<ahelp hid=\"SW:CHECKBOX:TP_FRM_WRAP:CB_ONLYOUTSIDE\"\>Излива текст само около контура на обекта, но не и в свободните области във вътрешността на обекта.\</ahelp\> Тази настройка не е достъпна за рамки.				20200411 15:09:53
