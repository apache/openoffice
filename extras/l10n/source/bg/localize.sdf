helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	hd_id5566778808				0	bg	Hex				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	par_id5566778808				0	bg	            \<ahelp hid=\"cui:MetricField:ColorPicker:Hex\"\>Sets the Red, Green, and Blue color value in the RGB color model, using a hexadecimal format RRGGBB.\</ahelp\>        				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	hd_id5566778809				0	bg	HSB				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	par_id5566778809				0	bg	These set of controls allow to choose a color in the HSB color space.				20200411 15:09:53
