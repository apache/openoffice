helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3145118	18			0	bg	\<item type=\"input\"\>=SKEW(A1:A50)\</item\> изчислява стойността на ексцеса на посочените данни.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3149051				0	bg	\<bookmark_value\>регресионни линии;FORECAST, функция\</bookmark_value\>\<bookmark_value\>екстраполация\</bookmark_value\>\<bookmark_value\>FORECAST, функция\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3149051				0	bg	FORECAST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153290				0	bg	\<ahelp hid=\"HID_FUNC_SCHAETZER\"\>Екстраполира бъдещи стойности на базата на съществуващи стойности за x и y.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3151343				0	bg	Синтаксис				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3147404				0	bg	FORECAST(Стойност; ДанниY; ДанниX)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3148743	24			0	bg	\<emph\>Стойност\</emph\> е стойността на x, за която се търси съответната стойност на y на базата на линейната регресия.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3146325	25			0	bg	\<emph\>ДанниY\</emph\> е масивът или областта с известните стойности на y.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150536	26			0	bg	\<emph\>ДанниX\</emph\> е масивът или областта с известните стойности на x.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3147416				0	bg	Пример				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3157874	28			0	bg	\<item type=\"input\"\>=FORECAST(50; A1:A50; B1; B50)\</item\> връща очакваната стойност на Y за X = 50, ако стойностите на X и Y от съответните обръщения следват линейна тенденция.				20200411 15:09:53
