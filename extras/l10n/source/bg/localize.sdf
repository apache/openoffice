helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153315				0	bg	\<emph\>Число\</emph\> е числото, което да бъде проверено.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3143274				0	bg	Пример				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154793				0	bg	\<item type=\"input\"\>=ISODD_ADD(5)\</item\> връща 1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3148688				0	bg	\<bookmark_value\>ISNUMBER, функция\</bookmark_value\>\<bookmark_value\>съдържание на клетки;числа\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3148688				0	bg	ISNUMBER				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154618				0	bg	\<ahelp hid=\"HID_FUNC_ISTZAHL\"\>Връща TRUE, ако стойността представлява или посочва число.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3152769				0	bg	Синтаксис				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150595				0	bg	ISNUMBER(Стойност)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150351				0	bg	\<emph\>Стойност\</emph\> е израз, за който да се провери дали е число или текст.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3146793				0	bg	Пример				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155614				0	bg	\<item type=\"input\"\>=ISNUMBER(C3)\</item\> връща TRUE, ако клетката C3 съдържа числото \<item type=\"input\"\>4\</item\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154417				0	bg	\<item type=\"input\"\>=ISNUMBER(C2)\</item\> връща FALSE, ако клетката C2 съдържа текста \<item type=\"input\"\>абвгде\</item\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3153694				0	bg	\<bookmark_value\>N, функция\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3153694				0	bg	N				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150405				0	bg	\<ahelp hid=\"HID_FUNC_N\"\>Връща числовата стойност на дадения параметър. Връща 0, ако параметърът е текст, FALSE или #NA.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id9115573				0	bg	Ако възникне грешка, различна от #NA, функцията връща съответната стойност за грешка.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3145774				0	bg	Синтаксис				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153883				0	bg	N(Стойност)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151101				0	bg	\<emph\>Стойност\</emph\> е параметърът, който да бъде преобразуван в число. N() връща числовата стойност, ако е възможно. За логическите стойности TRUE и FALSE се връщат съответно 1 и 0. За текстове и грешки се връща 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3147097				0	bg	Пример				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154117				0	bg	\<item type=\"input\"\>=N(123)\</item\> връща 123.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id2337717				0	bg	\<item type=\"input\"\>=N(TRUE)\</item\> връща 1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153781				0	bg	\<item type=\"input\"\>=N(FALSE)\</item\> връща 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154670				0	bg	\<item type=\"input\"\>=N("абв")\</item\> връща 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3519089				0	bg	=N(1/0) връща #ДЕЛ/0!				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3156275				0	bg	\<bookmark_value\>NA, функция\</bookmark_value\>\<bookmark_value\>#N/A, грешка;присвояване на клетка\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3156275				0	bg	NA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156161				0	bg	\<ahelp hid=\"HID_FUNC_NV\"\>Връща стойността за грешка #N/A.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3147532				0	bg	Синтаксис				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149563				0	bg	NA()				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3155128				0	bg	Пример				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154481				0	bg	\<item type=\"input\"\>=NA()\</item\> преобразува съдържанието на клетката в #N/A.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3151255				0	bg	\<bookmark_value\>TYPE, функция\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3151255				0	bg	TYPE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155900				0	bg	\<ahelp hid=\"HID_FUNC_TYP\"\>Returns the type of value, where 1 = number, 2 = text, 4 = Boolean value, 8 = formula, 16 = error value, 64 = array.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3149992				0	bg	Синтаксис				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3148400				0	bg	TYPE(Стойност)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150830				0	bg	\<emph\>Value\</emph\> is a specific value for which the data type is determined.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3154363				0	bg	Пример (вижте примерната таблица по-горе)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153357				0	bg	\<item type=\"input\"\>=TYPE(C2)\</item\> връща 2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3148980				0	bg	\<item type=\"input\"\>=TYPE(D9)\</item\> връща 1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3155509				0	bg	\<bookmark_value\>CELL, функция\</bookmark_value\>\<bookmark_value\>клетки; информация за\</bookmark_value\>\<bookmark_value\>информация за клетки\</bookmark_value\>				20200411 15:09:53
