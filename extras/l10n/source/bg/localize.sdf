helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159083	39			0	bg	\<item type=\"input\"\>Ликв. стойност\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150002	40			0	bg	\<item type=\"input\"\>Полезен живот\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153006	41			0	bg	\<item type=\"input\"\>Период\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154505	42			0	bg	\<item type=\"input\"\>Аморт. SYD\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150336				0	bg	2				20200411 15:09:53
