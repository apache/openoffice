helpcontent2	source\text\shared\02\01170203.xhp	0	help	hd_id3156054	12			0	kid	lzw4[w‖Allow modifications				20130829 23:02:48
helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3156377	25			0	kid	immgcj‖\<ahelp hid=\"HID_PROP_ALLOW_EDITS\"\> Determines if the data can be modified.\</ahelp\>				20130829 23:02:48
