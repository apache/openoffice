helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154634				0	gl	\<ahelp hid=\"HID_FUNC_NORMINV\"\>Returns the inverse of the normal cumulative distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153227				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147534				0	gl	NORMINV(Number; Mean; StDev)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154950				0	gl	\<emph\>Number\</emph\> represents the probability value used to determine the inverse normal distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150690				0	gl	\<emph\>Mean\</emph\> represents the mean value in the normal distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148594				0	gl	\<emph\>StDev\</emph\> represents the standard deviation of the normal distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155822				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153921				0	gl	\<item type=\"input\"\>=NORMINV(0.9;63;5)\</item\> returns 69.41. If the average egg weighs 63 grams with a standard deviation of 5, then there will be 90% probability that the egg will not be heavier than 69.41g grams.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153722				0	gl	\<bookmark_value\>NORMDIST function\</bookmark_value\>\<bookmark_value\>density function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153722				0	gl	DISTNORM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150386				0	gl	\<ahelp hid=\"HID_FUNC_NORMVERT\"\>Returns the density function or the normal cumulative distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3083282				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150613				0	gl	NORMDIST(Number; Mean; StDev; C)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149820				0	gl	\<emph\>Number\</emph\> is the value of the distribution based on which the normal distribution is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146063				0	gl	\<emph\>Mean\</emph\> is the mean value of the distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156295				0	gl	\<emph\>StDev\</emph\> is the standard deviation of the distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145080				0	gl	\<emph\>C\</emph\> is optional. \<emph\>C\</emph\> = 0 calculates the density function, \<emph\>C\</emph\> = 1 calculates the distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152972				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149283				0	gl	\<item type=\"input\"\>=NORMDIST(70;63;5;0)\</item\> returns 0.03.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149448				0	gl	\<item type=\"input\"\>=NORMDIST(70;63;5;1)\</item\> returns 0.92.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3152934				0	gl	\<bookmark_value\>PEARSON function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152934				0	gl	PEARSON				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153216				0	gl	\<ahelp hid=\"HID_FUNC_PEARSON\"\>Returns the Pearson product moment correlation coefficient r.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147081				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156133				0	gl	PEARSON(Data1; Data2)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151272				0	gl	\<emph\>Data1\</emph\> represents the array of the first data set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153279				0	gl	\<emph\>Data2\</emph\> represents the array of the second data set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147567				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151187				0	gl	\<item type=\"input\"\>=PEARSON(A1:A30;B1:B30)\</item\> returns the Pearson correlation coefficient of both data sets.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3152806				0	gl	\<bookmark_value\>PHI function\</bookmark_value\>				20200411 15:09:53
