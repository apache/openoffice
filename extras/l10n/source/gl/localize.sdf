helpcontent2	source\text\sbasic\guide\show_dialog.xhp	0	help	par_id3148575				0	gl	BasicLibraries.LoadLibrary("Tools")				20200411 15:09:53
helpcontent2	source\text\sbasic\guide\show_dialog.xhp	0	help	par_id3152463				0	gl	oDialog1 = \<link href=\"text/sbasic/guide/sample_code.xhp\" name=\"LoadDialog\"\>LoadDialog\</link\>("Standard", "Dialog1")				20200411 15:09:53
