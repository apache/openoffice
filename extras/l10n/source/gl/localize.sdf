helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143606				0	gl	\<emph\>Range\</emph\> is the range whose cells are included.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3143625				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143638				0	gl	You have a table in the cell range A1:B5 containing cities in column A and accompanying figures in column B. You have used an AutoFilter so that you only see rows containing the city Hamburg. You want to see the sum of the figures that are displayed; that is, just the subtotal for the filtered rows. In this case the correct formula would be:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143658				0	gl	\<item type=\"input\"\>=SUBTOTAL(9;B2:B5)\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3143672				0	gl	\<bookmark_value\>Euro; converting\</bookmark_value\>\<bookmark_value\>EUROCONVERT function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3143672				0	gl	EUROCONVERTER				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143708				0	gl	\<ahelp hid=\"HID_FUNC_UMRECHNEN\"\>Converts between old European national currency and to and from Euros.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143731				0	gl	\<emph\>Syntax\</emph\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143748				0	gl	EUROCONVERT(Value; "From_currency"; "To_currency", full_precision, triangulation_precision)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143763				0	gl	\<emph\>Value\</emph\> is the amount of the currency to be converted.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143782				0	gl	\<emph\>From_currency\</emph\> and \<emph\>To_currency\</emph\> are the currency units to convert from and to respectively. These must be text, the official abbreviation for the currency (for example, "EUR"). The rates (shown per Euro) were set by the European Commission.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0119200904301810				0	gl	\<emph\>Full_precision\</emph\> is optional. If omitted or False, the result is rounded according to the decimals of the To currency. If Full_precision is True, the result is not rounded.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0119200904301815				0	gl	\<emph\>Triangulation_precision\</emph\> is optional. If Triangulation_precision is given and >=3, the intermediate result of a triangular conversion (currency1,EUR,currency2) is rounded to that precision. If Triangulation_precision is omitted, the intermediate result is not rounded. Also if To currency is "EUR", Triangulation_precision is used as if triangulation was needed and conversion from EUR to EUR was applied.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143819				0	gl	\<emph\>Exemplos\</emph\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143837				0	gl	\<item type=\"input\"\>=EUROCONVERT(100;"ATS";"EUR")\</item\> converts 100 Austrian Schillings into Euros.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143853				0	gl	\<item type=\"input\"\>=EUROCONVERT(100;"EUR";"DEM")\</item\> converts 100 Euros into German Marks.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id0908200902090676				0	gl	\<bookmark_value\>CONVERT function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id0908200902074836				0	gl	CONVERTER				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902131122				0	gl	\<ahelp hid=\".\"\>Converts a value from one unit of measurement to another unit of measurement. The conversion factors are given in a list in the configuration.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902475420				0	gl	At one time the list of conversion factors included the legacy European currencies and the Euro (see examples below). We suggest using the new function EUROCONVERT for converting these currencies.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id0908200902131071				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902131191				0	gl	CONVERT(value;"text";"text")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id0908200902131152				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id090820090213112				0	gl	\<item type=\"input\"\>=CONVERT(100;"ATS";"EUR")\</item\> returns the Euro value of 100 Austrian Schillings.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902475431				0	gl	=CONVERT(100;"EUR";"DEM") converts 100 Euros into German Marks. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3157177				0	gl	\<bookmark_value\>ODD function\</bookmark_value\>\<bookmark_value\>rounding;up/down to nearest odd integer\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157177				0	gl	IMPAR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157205				0	gl	\<ahelp hid=\"HID_FUNC_UNGERADE\"\>Rounds a positive number up to the nearest odd integer and a negative number down to the nearest odd integer.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157223				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157237				0	gl	ODD(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157250				0	gl	 Returns \<emph\>Number\</emph\> rounded to the next odd integer up, away from zero.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157270				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157283				0	gl	\<item type=\"input\"\>=ODD(1.2)\</item\> returns 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8746910				0	gl	\<item type=\"input\"\>=ODD(1)\</item\> returns 1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9636524				0	gl	\<item type=\"input\"\>=ODD(0)\</item\> returns 1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5675527				0	gl	\<item type=\"input\"\>=ODD(-3.1)\</item\> returns -5.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3157404				0	gl	\<bookmark_value\>FLOOR function\</bookmark_value\>\<bookmark_value\>rounding;down to nearest multiple of significance\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157404				0	gl	ARREDMÚLTINF				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157432				0	gl	\<ahelp hid=\"HID_FUNC_UNTERGRENZE\"\>Rounds a number down to the nearest multiple of Significance.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157451				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157464				0	gl	FLOOR(Number; Significance; Mode)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157478				0	gl	\<emph\>Number\</emph\> is the number that is to be rounded down.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157497				0	gl	\<emph\>Significance\</emph\> is the value to whose multiple the number is to be rounded down.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157517				0	gl	\<emph\>Mode\</emph\> is an optional value. If the Mode value is given and not equal to zero, and if Number and Significance are negative, then rounding is done based on the absolute value of the number. This parameter is ignored when exporting to MS Excel as Excel does not know any third parameter.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163894				0	gl	If both parameters Number and Significance are negative, and if the Mode value is equal to zero or is not specified, then the results in $[officename] Calc and Excel will differ after exporting. If you export the spreadsheet to Excel, use Mode=1 to see the same results in Excel as in Calc.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163932				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163945				0	gl	\<item type=\"input\"\>=FLOOR( -11;-2)\</item\> returns -12				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163966				0	gl	\<item type=\"input\"\>=FLOOR( -11;-2;0)\</item\> returns -12				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163988				0	gl	\<item type=\"input\"\>=FLOOR( -11;-2;1)\</item\> returns -10				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164086				0	gl	\<bookmark_value\>SIGN function\</bookmark_value\>\<bookmark_value\>algebraic signs\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164086				0	gl	SINAL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164115				0	gl	\<ahelp hid=\"HID_FUNC_VORZEICHEN\"\>Returns the sign of a number. Returns 1 if the number is positive, -1 if negative and 0 if zero.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164136				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164150				0	gl	SIGN(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164164				0	gl	\<emph\>Number\</emph\> is the number whose sign is to be determined.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164183				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164197				0	gl	\<item type=\"input\"\>=SIGN(3.4)\</item\> returns 1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164212				0	gl	\<item type=\"input\"\>=SIGN(-4.5)\</item\> returns -1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164252				0	gl	\<bookmark_value\>MROUND function\</bookmark_value\>\<bookmark_value\>nearest multiple\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164252				0	gl	MARRED				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164288				0	gl	\<ahelp hid=\"HID_AAI_FUNC_MROUND\"\>Returns a number rounded to the nearest multiple of another number.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164306				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164320				0	gl	MROUND(Number; Multiple)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3486434				0	gl	Returns \<emph\>Number\</emph\> rounded to the nearest multiple of \<emph\>Multiple\</emph\>. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3068636				0	gl	An alternative implementation would be \<item type=\"literal\"\>Multiple * ROUND(Number/Multiple)\</item\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164333				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164347				0	gl	\<item type=\"input\"\>=MROUND(15.5;3)\</item\> returns 15, as 15.5 is closer to 15 (= 3*5) than to 18 (= 3*6).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_idN14DD6				0	gl	\<item type=\"input\"\>=MROUND(1.4;0.5)\</item\> returns 1.5 (= 0.5*3).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164375				0	gl	\<bookmark_value\>SQRT function\</bookmark_value\>\<bookmark_value\>square roots;positive numbers\</bookmark_value\>				20200411 15:09:53
