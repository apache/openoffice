helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154920				0	gl	Returns the width of the referenced column. The unit is the number of zeros (0) that fit into the column in the default text and the default size.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3152355				0	gl	PREFIX				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154230				0	gl	Returns the alignment of the referenced cell.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155946				0	gl	' = align left or left-justified				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3147220				0	gl	" = align right				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149038				0	gl	^ = centered				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153129				0	gl	\\ = repeating (currently inactive)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154406				0	gl	PROTECT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3145127				0	gl	Returns the status of the cell protection for the cell.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155794				0	gl	1 = cell is protected				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155072				0	gl	0 = cell is not protected				20200411 15:09:53
