helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153891				0	gl	\<ahelp hid=\"HID_AAI_FUNC_DISC\"\>Calculates the allowance (discount) of a security as a percentage.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3153982				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149756				0	gl	DISC("Settlement"; "Maturity"; Price; Redemption; Basis)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156014	383			0	gl	            \<emph\>Settlement\</emph\> is the date of purchase of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154304	384			0	gl	            \<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159180	385			0	gl	            \<emph\>Price\</emph\> is the price of the security per 100 currency units of par value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147253	386			0	gl	            \<emph\>Redemption\</emph\> is the redemption value of the security per 100 currency units of par value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3151174				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155902				0	gl	A security is purchased on 2001-01-25; the maturity date is 2001-11-15. The price (purchase price) is 97, the redemption value is 100. Using daily balance calculation (basis 3) how high is the settlement (discount)?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3152797	389			0	gl	            \<item type=\"input\"\>=DISC("2001-01-25";"2001-11-15";97;100;3)\</item\> returns about 0.0372 or 3.72 per cent.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3154695				0	gl	\<bookmark_value\>DURATION_ADD function\</bookmark_value\>         \<bookmark_value\>Microsoft Excel functions\</bookmark_value\>         \<bookmark_value\>durations;fixed interest securities\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3154695				0	gl	DURATION_ADD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145768				0	gl	\<ahelp hid=\"HID_AAI_FUNC_DURATION\"\>Calculates the duration of a fixed interest security in years.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3153904				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153373				0	gl	DURATION_ADD("Settlement"; "Maturity"; Coupon; Yield; Frequency; Basis)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155397	406			0	gl	            \<emph\>Settlement\</emph\> is the date of purchase of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148558	407			0	gl	            \<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153096	408			0	gl	            \<emph\>Coupon\</emph\> is the annual coupon interest rate (nominal rate of interest)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154594	409			0	gl	            \<emph\>Yield\</emph\> is the annual yield of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149906	410			0	gl	            \<emph\>Frequency\</emph\> is the number of interest payments per year (1, 2 or 4).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3146995				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148834				0	gl	A security is purchased on 2001-01-01; the maturity date is 2006-01-01. The Coupon rate of interest is 8%. The yield is 9.0%. Interest is paid half-yearly (frequency is 2). Using daily balance interest calculation (basis 3) how long is the duration?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154902	413			0	gl	            \<item type=\"input\"\>=DURATION_ADD("2001-01-01";"2006-01-01";0.08;0.09;2;3)\</item\>         				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3159147				0	gl	\<bookmark_value\>annual net interest rates\</bookmark_value\>         \<bookmark_value\>calculating; annual net interest rates\</bookmark_value\>         \<bookmark_value\>net annual interest rates\</bookmark_value\>         \<bookmark_value\>EFFECTIVE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3159147				0	gl	EFECTIVO				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154204				0	gl	\<ahelp hid=\"HID_FUNC_EFFEKTIV\"\>Returns the net annual interest rate for a nominal interest rate.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145417				0	gl	Nominal interest refers to the amount of interest due at the end of a calculation period. Effective interest increases with the number of payments made. In other words, interest is often paid in installments (for example, monthly or quarterly) before the end of the calculation period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3150510				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148805				0	gl	EFFECTIVE(Nom; P)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149768	93			0	gl	            \<emph\>Nom\</emph\> is the nominal interest.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149334	94			0	gl	            \<emph\>P\</emph\> is the number of interest payment periods per year.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3154223				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3144499				0	gl	If the annual nominal interest rate is 9.75% and four interest calculation periods are defined, what is the actual interest rate (effective rate)?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150772	97			0	gl	            \<item type=\"input\"\>=EFFECTIVE(9.75%;4)\</item\> = 10.11% The annual effective rate is therefore 10.11%.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3147241				0	gl	\<bookmark_value\>effective interest rates\</bookmark_value\>         \<bookmark_value\>EFFECT_ADD function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3147241				0	gl	EFFECT_ADD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147524				0	gl	\<ahelp hid=\"HID_AAI_FUNC_EFFECT\"\>Calculates the effective annual rate of interest on the basis of the nominal interest rate and the number of interest payments per annum.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3155364				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155118				0	gl	EFFECT_ADD(NominalRate; NPerY)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148907	418			0	gl	            \<emph\>NominalRate\</emph\> is the annual nominal rate of interest.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154274	419			0	gl	            \<emph\>NPerY \</emph\>is the number of interest payments per year.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3149156				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3158426				0	gl	What is the effective annual rate of interest for a 5.25% nominal rate and quarterly payment.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148927	422			0	gl	            \<item type=\"input\"\>=EFFECT_ADD(0.0525;4)\</item\> returns 0.053543 or 5.3543%.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3149998				0	gl	\<bookmark_value\>calculating; arithmetic-degressive depreciations\</bookmark_value\>         \<bookmark_value\>arithmetic-degressive depreciations\</bookmark_value\>         \<bookmark_value\>depreciations;arithmetic-degressive\</bookmark_value\>         \<bookmark_value\>DDB function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3149998				0	gl	DDB				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159190				0	gl	\<ahelp hid=\"HID_FUNC_GDA\"\>Returns the depreciation of an asset for a specified period using the arithmetic-declining method.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3152361				0	gl	Use this form of depreciation if you require a higher initial depreciation value as opposed to linear depreciation. The depreciation value gets less with each period and is usually used for assets whose value loss is higher shortly after purchase (for example, vehicles, computers). Please note that the book value will never reach zero under this calculation type.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3156038				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3166452				0	gl	DDB(Cost; Salvage; Life; Period; Factor)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153237	104			0	gl	            \<emph\>Cost\</emph\> fixes the initial cost of an asset.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149787	105			0	gl	            \<emph\>Salvage\</emph\> fixes the value of an asset at the end of its life.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3152945	106			0	gl	            \<emph\>Life\</emph\> is the number of periods (for example, years or months) defining how long the asset is to be used.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149736	107			0	gl	            \<emph\>Period\</emph\> states the period for which the value is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150243	108			0	gl	            \<emph\>Factor\</emph\> (optional) is the factor by which depreciation decreases. If a value is not entered, the default is factor 2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3159274				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3152882				0	gl	A computer system with an initial cost of 75,000 currency units is to be depreciated monthly over 5 years. The value at the end of the depreciation is to be 1 currency unit. The factor is 2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154106	111			0	gl	            \<item type=\"input\"\>=DDB(75000;1;60;12;2) \</item\>= 1,721.81 currency units. Therefore, the double-declining depreciation in the twelfth month after purchase is 1,721.81 currency units.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3149962				0	gl	\<bookmark_value\>calculating; geometric-degressive depreciations\</bookmark_value\>         \<bookmark_value\>geometric-degressive depreciations\</bookmark_value\>         \<bookmark_value\>depreciations;geometric-degressive\</bookmark_value\>         \<bookmark_value\>DB function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3149962				0	gl	DB				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148989				0	gl	\<ahelp hid=\"HID_FUNC_GDA2\"\>Returns the depreciation of an asset for a specified period using the double-declining balance method.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156213				0	gl	This form of depreciation is used if you want to get a higher depreciation value at the beginning of the depreciation (as opposed to linear depreciation). The depreciation value is reduced with every depreciation period by the depreciation already deducted from the initial cost.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3149807				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153349				0	gl	DB(Cost; Salvage; Life; Period; Month)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148462	118			0	gl	            \<emph\>Cost\</emph\> is the initial cost of an asset.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148658	119			0	gl	            \<emph\>Salvage\</emph\> is the value of an asset at the end of the depreciation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145371	120			0	gl	            \<emph\>Life\</emph\> defines the period over which an asset is depreciated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154608	121			0	gl	            \<emph\>Period\</emph\> is the length of each period. The length must be entered in the same date unit as the depreciation period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150829	122			0	gl	            \<emph\>Month\</emph\> (optional) denotes the number of months for the first year of depreciation. If an entry is not defined, 12 is used as the default.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3151130				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156147				0	gl	A computer system with an initial cost of 25,000 currency units is to be depreciated over a three year period. The salvage value is to be 1,000 currency units. One period is 30 days.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149513	125			0	gl	            \<item type=\"input\"\>=DB(25000;1000;36;1;6)\</item\> = 1,075.00 currency units				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159242				0	gl	The fixed-declining depreciation of the computer system is 1,075.00 currency units.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3153948				0	gl	\<bookmark_value\>IRR function\</bookmark_value\>         \<bookmark_value\>calculating;internal rates of return, regular payments\</bookmark_value\>         \<bookmark_value\>internal rates of return;regular payments\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3153948				0	gl	TID				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3143282				0	gl	\<ahelp hid=\"HID_FUNC_IKV\"\>Calculates the internal rate of return for an investment.\</ahelp\> The values represent cash flow values at regular intervals, at least one value must be negative (payments), and at least one value must be positive (income).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3150599				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155427				0	gl	IRR(Values; Guess)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3144758	132			0	gl	            \<emph\>Values\</emph\> represents an array containing the values.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149233	133			0	gl	            \<emph\>Guess\</emph\> (optional) is the estimated value. An iterative method is used to calculate the internal rate of return. If you can provide only few values, you should provide an initial guess to enable the iteration.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3151258				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150630				0	gl	Under the assumption that cell contents are A1=\<item type=\"input\"\>-10000\</item\>, A2=\<item type=\"input\"\>3500\</item\>, A3=\<item type=\"input\"\>7600\</item\> and A4=\<item type=\"input\"\>1000\</item\>, the formula \<item type=\"input\"\>=IRR(A1:A4)\</item\> gives a result of 11,33%.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3151012				0	gl	\<bookmark_value\>calculating; interests for unchanged amortization installments\</bookmark_value\>         \<bookmark_value\>interests for unchanged amortization installments\</bookmark_value\>         \<bookmark_value\>ISPMT function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3151012				0	gl	XSPGTO				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148693				0	gl	\<ahelp hid=\"HID_FUNC_ISPMT\"\>Calculates the level of interest for unchanged amortization installments.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3154661				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146070				0	gl	ISPMT(Rate; Period; TotalPeriods; Invest)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148672	318			0	gl	            \<emph\>Rate\</emph\> sets the periodic interest rate.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145777	319			0	gl	            \<emph\>Period\</emph\> is the number of installments for calculation of interest.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153678	320			0	gl	            \<emph\>TotalPeriods\</emph\> is the total number of installment periods.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159390	321			0	gl	            \<emph\>Invest\</emph\> is the amount of the investment.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3156162				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149558				0	gl	For a credit amount of 120,000 currency units with a two-year term and monthly installments, at a yearly interest rate of 12% the level of interest after 1.5 years is required.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150949	324			0	gl	            \<item type=\"input\"\>=ISPMT(1%;18;24;120000)\</item\> = -300 currency units. The monthly interest after 1.5 years amounts to 300 currency units.				20200411 15:09:53
