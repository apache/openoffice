helpcontent2	source\text\scalc\01\func_edate.xhp	0	help	hd_id3151184				0	gl	\<variable id=\"edate\"\>\<link href=\"text/scalc/01/func_edate.xhp\"\>EDATE\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_edate.xhp	0	help	par_id3150880	214			0	gl	\<ahelp hid=\"HID_AAI_FUNC_EDATE\"\>The result is a date which is a number of m\<emph\>onths\</emph\> away from the \<emph\>start date\</emph\>. Only months are considered; days are not used for calculation.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_edate.xhp	0	help	hd_id3154647				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_edate.xhp	0	help	par_id3153212				0	gl	EDATE(StartDate; Months)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_edate.xhp	0	help	par_id3146860				0	gl	\<emph\>StartDate\</emph\> is a date.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_edate.xhp	0	help	par_id3152929				0	gl	\<emph\>Months\</emph\> is the number of months before (negative) or after (positive) the start date.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_edate.xhp	0	help	hd_id3151289				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_edate.xhp	0	help	par_id3155845				0	gl	What date is one month prior to 3.31.2001?				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_edate.xhp	0	help	par_id3155999				0	gl	\<item type=\"input\"\>=EDATE(3.31.2001;-1)\</item\> returns 2.28.2001.				20200411 15:09:53
