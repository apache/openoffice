helpcontent2	source\text\shared\02\01170102.xhp	0	help	par_id3154596	27			0	gl	A entrada da lista visíbel ("ListBox1=Elemento")				20200411 15:09:53
helpcontent2	source\text\shared\02\01170102.xhp	0	help	par_id3146892				0	gl	<OPTION VALUE="Valor">Elemento				20200411 15:09:53
helpcontent2	source\text\shared\02\01170102.xhp	0	help	par_id3154604				0	gl	ListBox1.options[0].value="Valor"				20200411 15:09:53
helpcontent2	source\text\shared\02\01170102.xhp	0	help	par_id3153689				0	gl	"Valor"				20200411 15:09:53
