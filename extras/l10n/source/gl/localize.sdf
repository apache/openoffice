helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154618				0	gl	\<ahelp hid=\"HID_FUNC_ISTZAHL\"\>Returns TRUE if the value refers to a number.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3152769				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150595				0	gl	ISNUMBER(Value)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150351				0	gl	\<emph\>Value\</emph\> is any expression to be tested to determine whether it is a number or text.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3146793				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155614				0	gl	\<item type=\"input\"\>=ISNUMBER(C3)\</item\> returns TRUE if the cell C3 contains the number \<item type=\"input\"\>4\</item\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154417				0	gl	\<item type=\"input\"\>=ISNUMBER(C2)\</item\> returns FALSE if the cell C2 contains the text \<item type=\"input\"\>abcdef\</item\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3153694				0	gl	\<bookmark_value\>N function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3153694				0	gl	N				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150405				0	gl	\<ahelp hid=\"HID_FUNC_N\"\>Returns the numeric value of the given parameter. Returns 0 if parameter is text, FALSE or #NA.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id9115573				0	gl	If an error occurs, other than #NA, the function returns the error value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3145774				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153883				0	gl	N(Value)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151101				0	gl	\<emph\>Value\</emph\> is the parameter to be converted into a number. N() returns the numeric value if it can. It returns the logical values TRUE and FALSE as 1 and 0 respectively. It returns text and errors as 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3147097				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154117				0	gl	\<item type=\"input\"\>=N(123)\</item\> returns 123				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id2337717				0	gl	\<item type=\"input\"\>=N(TRUE)\</item\> returns 1				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153781				0	gl	\<item type=\"input\"\>=N(FALSE)\</item\> returns 0				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154670				0	gl	\<item type=\"input\"\>=N("abc")\</item\> returns 0				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3519089				0	gl	=N(1/0) returns #DIV/0!				20200411 15:09:53
