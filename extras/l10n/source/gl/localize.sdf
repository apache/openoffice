helpcontent2	source\text\scalc\01\12080100.xhp	0	help	par_id3154515				0	gl	\<ahelp hid=\".uno:HideDetail\" visibility=\"visible\"\>Hides the details of the grouped row or column that contains the cursor. To hide all of the grouped rows or columns, select the outlined table, and then choose this command.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080100.xhp	0	help	par_id3153252	3			0	gl	To show all hidden groups, select the outlined table, and then choose \<emph\>Data -Outline –\</emph\> \<link href=\"text/scalc/01/12080200.xhp\" name=\"Show Details\"\>\<emph\>Show Details\</emph\>\</link\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	tit				0	gl	Financial Functions Part One				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3143284				0	gl	\<bookmark_value\>financial functions\</bookmark_value\>      \<bookmark_value\>functions; financial functions\</bookmark_value\>      \<bookmark_value\>Function Wizard; financial\</bookmark_value\>      \<bookmark_value\>amortizations, see also depreciations\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3143284				0	gl	Financial Functions Part One				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149095				0	gl	\<variable id=\"finanztext\"\>This category contains the mathematical finance functions of \<item type=\"productname\"\>%PRODUCTNAME\</item\> Calc.\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3153366				0	gl	\<bookmark_value\>AMORDEGRC function\</bookmark_value\>         \<bookmark_value\>depreciations;degressive amortizations\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3153366				0	gl	AMORDEGRC				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147434				0	gl	\<ahelp hid=\"HID_AAI_FUNC_AMORDEGRC\"\>Calculates the amount of depreciation for a settlement period as degressive amortization.\</ahelp\> Unlike AMORLINC, a depreciation coefficient that is independent of the depreciable life is used here.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3155855				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147427				0	gl	AMORDEGRC(Cost; DatePurchased; FirstPeriod; Salvage; Period; Rate; Basis)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147125	363			0	gl	            \<emph\>Cost\</emph\> is the acquisition costs.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3151074	364			0	gl	            \<emph\>DatePurchased\</emph\> is the date of acquisition.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3144765	365			0	gl	            \<emph\>FirstPeriod \</emph\>is the end date of the first settlement period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156286	366			0	gl	            \<emph\>Salvage\</emph\> is the salvage value of the capital asset at the end of the depreciable life.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153415	367			0	gl	            \<emph\>Period\</emph\> is the settlement period to be considered.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155064	368			0	gl	            \<emph\>Rate\</emph\> is the rate of depreciation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3153765				0	gl	\<bookmark_value\>AMORLINC function\</bookmark_value\>         \<bookmark_value\>depreciations;linear amortizations\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3153765				0	gl	AMORLINC				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159264				0	gl	\<ahelp hid=\"HID_AAI_FUNC_AMORLINC\"\>Calculates the amount of depreciation for a settlement period as linear amortization. If the capital asset is purchased during the settlement period, the proportional amount of depreciation is considered.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3150044				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147363				0	gl	AMORLINC(Cost; DatePurchased; FirstPeriod; Salvage; Period; Rate; Basis)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146920	373			0	gl	            \<emph\>Cost\</emph\> means the acquisition costs.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3163807	374			0	gl	            \<emph\>DatePurchased\</emph\> is the date of acquisition.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148488	375			0	gl	            \<emph\>FirstPeriod \</emph\>is the end date of the first settlement period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149530	376			0	gl	            \<emph\>Salvage\</emph\> is the salvage value of the capital asset at the end of the depreciable life.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148633	377			0	gl	            \<emph\>Period\</emph\> is the settlement period to be considered.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150982	378			0	gl	            \<emph\>Rate\</emph\> is the rate of depreciation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3145257				0	gl	\<bookmark_value\>ACCRINT function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3145257				0	gl	XUROSACUM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3151276				0	gl	\<bookmark_value\>accrued interests;periodic payments\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3151276				0	gl	\<ahelp hid=\"HID_AAI_FUNC_ACCRINT\"\>Calculates the accrued interest of a security in the case of periodic payments.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3152581				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159092				0	gl	ACCRINT(Issue; FirstInterest; Settlement; Rate; Par; Frequency; Basis)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150519	339			0	gl	            \<emph\>Issue\</emph\> is the issue date of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155376	340			0	gl	            \<emph\>FirstInterest\</emph\> is the first interest date of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3166431	341			0	gl	            \<emph\>Settlement\</emph\> is the date at which the interest accrued up until then is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154486	342			0	gl	            \<emph\>Rate\</emph\> is the annual nominal rate of interest (coupon interest rate)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156445	343			0	gl	            \<emph\>Par\</emph\> is the par value of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149406	344			0	gl	            \<emph\>Frequency\</emph\> is the number of interest payments per year (1, 2 or 4).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3148699				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148599				0	gl	A security is issued on 2001-02-28. First interest is set for 2001-08-31. The settlement date is 2001-05-01. The Rate is 0.1 or 10% and Par is 1000 currency units. Interest is paid half-yearly (frequency is 2). The basis is the US method (0). How much interest has accrued?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148840	347			0	gl	            \<item type=\"input\"\>=ACCRINT("2001-02-28";"2001-08-31";"2001-05-01";0.1;1000;2;0)\</item\> returns 16.94444.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3151240				0	gl	\<bookmark_value\>ACCRINTM function\</bookmark_value\>         \<bookmark_value\>accrued interests;one-off payments\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3151240				0	gl	XUROSACUMV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3157981				0	gl	\<ahelp hid=\"HID_AAI_FUNC_ACCRINTM\"\>Calculates the accrued interest of a security in the case of one-off payment at the settlement date.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3159097				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147074				0	gl	ACCRINTM(Issue; Settlement; Rate; Par; Basis)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3144773	352			0	gl	            \<emph\>Issue\</emph\> is the issue date of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154956	353			0	gl	            \<emph\>Settlement\</emph\> is the date at which the interest accrued up until then is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153972	354			0	gl	            \<emph\>Rate\</emph\> is the annual nominal rate of interest (coupon interest rate).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159204	355			0	gl	            \<emph\>Par\</emph\> is the par value of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3155384				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154541				0	gl	A security is issued on 2001-04-01. The maturity date is set for 2001-06-15. The Rate is 0.1 or 10% and Par is 1000 currency units. The basis of the daily/annual calculation is the daily balance (3). How much interest has accrued?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149128	358			0	gl	            \<item type=\"input\"\>=ACCRINTM("2001-04-01";"2001-06-15";0.1;1000;3)\</item\> returns 20.54795.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3145753				0	gl	\<bookmark_value\>RECEIVED function\</bookmark_value\>         \<bookmark_value\>amount received for fixed-interest securities\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3145753				0	gl	RECIBIDO				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150051				0	gl	\<ahelp hid=\"HID_AAI_FUNC_RECEIVED\"\>Calculates the amount received that is paid for a fixed-interest security at a given point in time.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3149385				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145362				0	gl	RECEIVED("Settlement"; "Maturity"; Investment; Discount; Basis)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154654	394			0	gl	            \<emph\>Settlement\</emph\> is the date of purchase of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153011	395			0	gl	            \<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155525	396			0	gl	            \<emph\>Investment\</emph\> is the purchase sum.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155760	397			0	gl	            \<emph\>Discount\</emph\> is the percentage discount on acquisition of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3154710				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154735				0	gl	Settlement date: February 15 1999, maturity date: May 15 1999, investment sum: 1000 currency units, discount: 5.75 per cent, basis: Daily balance/360 = 2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146108				0	gl	The amount received on the maturity date is calculated as follows:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147246	401			0	gl	            \<item type=\"input\"\>=RECEIVED("1999-02-15";"1999-05-15";1000;0.0575;2)\</item\> returns 1014.420266.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3147556				0	gl	\<bookmark_value\>PV function\</bookmark_value\>         \<bookmark_value\>present values\</bookmark_value\>         \<bookmark_value\>calculating; present values\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3147556				0	gl	VA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153301				0	gl	\<ahelp hid=\"HID_FUNC_BW\"\>Returns the present value of an investment resulting from a series of regular payments.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146099				0	gl	Use this function to calculate the amount of money needed to be invested at a fixed rate today, to receive a specific amount, an annuity, over a specified number of periods. You can also determine how much money is to remain after the elapse of the period. Specify as well if the amount is to be paid out at the beginning or at the end of each period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153334				0	gl	Enter these values either as numbers, expressions or references. If, for example, interest is paid annually at 8%, but you want to use month as your period, enter 8%/12 under \<emph\>Rate\</emph\> and \<item type=\"productname\"\>%PRODUCTNAME\</item\> Calc will automatically calculate the correct factor.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3147407				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150395				0	gl	PV(Rate; NPer; Pmt; FV; Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3151341	9			0	gl	            \<emph\>Rate\</emph\> defines the interest rate per period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153023	10			0	gl	            \<emph\>NPer\</emph\> is the total number of periods (payment period).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146323	11			0	gl	            \<emph\>Pmt\</emph\> is the regular payment made per period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150536	12			0	gl	            \<emph\>FV\</emph\> (optional) defines the future value remaining after the final installment has been made.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146883	13			0	gl	            \<emph\>Type\</emph\> (optional) denotes due date for payments. Type = 1 means due at the beginning of a period and Type = 0 (default) means due at the end of the period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_idN10B13				0	gl	            \<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>         				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3150037				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145225				0	gl	What is the present value of an investment, if 500 currency units are paid out monthly and the annual interest rate is 8%? The payment period is 48 months and 20,000 currency units are to remain at the end of the payment period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155907	16			0	gl	            \<item type=\"input\"\>=PV(8%/12;48;500;20000)\</item\> = -35,019.37 currency units. Under the named conditions, you must deposit 35,019.37 currency units today, if you want to receive 500 currency units per month for 48 months and have 20,000 currency units left over at the end. Cross-checking shows that 48 x 500 currency units + 20,000 currency units = 44,000 currency units. The difference between this amount and the 35,000 currency units deposited represents the interest paid.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149150				0	gl	If you enter references instead of these values into the formula, you can calculate any number of "If-then" scenarios. Please note: references to constants must be defined as absolute references. Examples of this type of application are found under the depreciation functions.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3152978				0	gl	\<bookmark_value\>calculating; depreciations\</bookmark_value\>         \<bookmark_value\>SYD function\</bookmark_value\>         \<bookmark_value\>depreciations; arithmetic declining\</bookmark_value\>         \<bookmark_value\>arithmetic declining depreciations\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3152978				0	gl	SYD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148732				0	gl	\<ahelp hid=\"HID_FUNC_DIA\"\>Returns the arithmetic-declining depreciation rate.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149886				0	gl	Use this function to calculate the depreciation amount for one period of the total depreciation span of an object. Arithmetic declining depreciation reduces the depreciation amount from period to period by a fixed sum.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3149431				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150483				0	gl	SYD(Cost; Salvage; Life; Period)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146879	24			0	gl	            \<emph\>Cost\</emph\> is the initial cost of an asset.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147423	25			0	gl	            \<emph\>Salvage\</emph\> is the value of an asset after depreciation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3151229	26			0	gl	            \<emph\>Life\</emph\> is the period fixing the time span over which an asset is depreciated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147473	27			0	gl	            \<emph\>Period\</emph\> defines the period for which the depreciation is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3148434				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149688				0	gl	A video system initially costing 50,000 currency units is to be depreciated annually for the next 5 years. The salvage value is to be 10,000 currency units. You want to calculate depreciation for the first year.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150900	30			0	gl	            \<item type=\"input\"\>=SYD(50000;10000;5;1)\</item\>=13,333.33 currency units. The depreciation amount for the first year is 13,333.33 currency units.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146142				0	gl	To have an overview of depreciation rates per period, it is best to define a depreciation table. By entering the different depreciation formulas available in \<item type=\"productname\"\>%PRODUCTNAME\</item\> Calc next to each other, you can see which depreciation form is the most appropriate. Enter the table as follows:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155258	32			0	gl	                     \<emph\>A\</emph\>                  				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154558	33			0	gl	                     \<emph\>B\</emph\>                  				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3152372	34			0	gl	                     \<emph\>C\</emph\>                  				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149949	35			0	gl	                     \<emph\>D\</emph\>                  				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145123	36			0	gl	                     \<emph\>E\</emph\>                  				20200411 15:09:53
