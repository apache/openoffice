helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	par_id3151262				0	gl	Comproba se un obxecto Uno de Basic soporta determinadas interfaces Uno.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	par_id3154232				0	gl	Returns True, if \<emph\>all\</emph\> stated Uno interfaces are supported, otherwise False is returned.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	hd_id3150040				0	gl	Sintaxe:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	par_id3155555				0	gl	HasUnoInterfaces( oTest, Nome-Interface-Uno 1 [, Nome-Interface-Uno 2, ...])				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	hd_id3153345				0	gl	Valor de retorno:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	par_id3148538				0	gl	Bool				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	hd_id3159157				0	gl	Parámetros:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	par_id3155419				0	gl	\<emph\>oTest:\</emph\> the Basic Uno object that you want to test.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	par_id3149236				0	gl	\<emph\>Uno-Interface-Name:\</emph\> list of Uno interface names.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	hd_id3147574				0	gl	Exemplo:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	par_id3149580				0	gl	bHas = HasUnoInterfaces( oTest, "com.sun.star.beans.XIntrospection" )				20200411 15:09:53
