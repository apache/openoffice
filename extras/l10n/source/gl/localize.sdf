helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3148467				0	gl	4				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3149237	148			0	gl	                     \<item type=\"input\"\>189\</item\>                  				20200411 15:09:53
