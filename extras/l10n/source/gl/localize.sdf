helpcontent2	source\text\scalc\01\02150000.xhp	0	help	par_id3148405				0	gl	\<ahelp hid=\"SC_CHECKBOX_RID_SCDLG_DELCONT_BTN_DELNUMBERS\"\>Deletes numbers only. Formats and formulas remain unchanged.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	hd_id3155764				0	gl	Date & time				20200411 15:09:53
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	par_id3149567				0	gl	\<ahelp hid=\"SC_CHECKBOX_RID_SCDLG_DELCONT_BTN_DELDATETIME\"\>Deletes date and time values. Formats, text, numbers and formulas remain unchanged.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	hd_id3154703				0	gl	Fórmulas				20200411 15:09:53
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	par_id3148485				0	gl	\<ahelp hid=\"SC_CHECKBOX_RID_SCDLG_DELCONT_BTN_DELFORMULAS\"\>Deletes formulas. Text, numbers, formats, dates and times remain unchanged.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	hd_id3150300				0	gl	Comentarios				20200411 15:09:53
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	par_id3154658				0	gl	\<ahelp hid=\"SC_CHECKBOX_RID_SCDLG_DELCONT_BTN_DELNOTES\"\>Deletes comments added to cells. All other elements remain unchanged.\</ahelp\>				20200411 15:09:53
