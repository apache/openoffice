helpcontent2	source\text\scalc\01\12040400.xhp	0	help	par_id3154760				0	gl	\<ahelp hid=\".uno:DataFilterRemoveFilter\"\>Removes the filter from the selected cell range. To enable this command, click inside the cell area where the filter was applied.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\07090000.xhp	0	help	tit				0	gl	Freeze				20200411 15:09:53
helpcontent2	source\text\scalc\01\07090000.xhp	0	help	hd_id3150517				0	gl	\<link href=\"text/scalc/01/07090000.xhp\" name=\"Freeze\"\>Freeze\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\07090000.xhp	0	help	par_id3156289				0	gl	\<ahelp hid=\".uno:FreezePanes\" visibility=\"visible\"\>Divides the sheet at the top left corner of the active cell and the area to the top left is no longer scrollable.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\03090000.xhp	0	help	tit				0	gl	Barra de fórmulas				20200411 15:09:53
