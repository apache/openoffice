helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3149312				0	gl	\<variable id=\"logischtext\"\>This category contains the \<emph\>Logical\</emph\> functions.\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	bm_id3147505				0	gl	\<bookmark_value\>AND function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3147505				0	gl	E				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3153959				0	gl	\<ahelp hid=\"HID_FUNC_UND\"\>Returns TRUE if all arguments are TRUE.\</ahelp\> If one of the elements is FALSE, this function returns the FALSE value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3146100				0	gl	The arguments are either logical expressions themselves (TRUE, 1<5, 2+3=7, B8<10) that return logical values, or arrays (A1:C3) containing logical values.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3150538				0	gl	When a function expects a single value, but you entered a cell range, then the value from the cell range is taken that is in the same column or row as the formula.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3149128				0	gl	If the entered range is outside of the current column or row of the formula, the function returns the error value #VALUE!				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3150374				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3159123				0	gl	AND(LogicalValue1; LogicalValue2 ...LogicalValue30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3150038	33			0	gl	            \<emph\>LogicalValue1; LogicalValue2 ...LogicalValue30\</emph\> are conditions to be checked. All conditions can be either TRUE or FALSE. If a range is entered as a parameter, the function uses the value from the range that is in the current column or row. The result is TRUE if the logical value in all cells within the cell range is TRUE.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3149143				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3153123				0	gl	The logical values of entries 12<13; 14>12, and 7<6 are to be checked:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3145632	36			0	gl	            \<item type=\"input\"\>=AND(12<13;14>12;7<6)\</item\> returns FALSE.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3149946	60			0	gl	            \<item type=\"input\"\>=AND (FALSE;TRUE)\</item\> returns FALSE.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	bm_id3156256				0	gl	\<bookmark_value\>TRUE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3156256				0	gl	VERDADEIRO				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3155985				0	gl	\<ahelp hid=\"HID_FUNC_WAHR\"\>The logical value is set to TRUE.\</ahelp\> The TRUE() function does not require any arguments, and always returns the logical value TRUE.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3153717				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3152590				0	gl	TRUE()				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3147175				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3146148				0	gl	If A=TRUE and B=FALSE the following examples appear:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3083285	44			0	gl	           \<item type=\"input\"\>=AND(A;B)\</item\> returns FALSE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3083444	45			0	gl	            \<item type=\"input\"\>=OR(A;B)\</item\> returns TRUE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3154314	46			0	gl	            \<item type=\"input\"\>=NOT(AND(A;B))\</item\> returns TRUE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	bm_id3149015				0	gl	\<bookmark_value\>FALSE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3149015				0	gl	FALSO				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3149890				0	gl	\<ahelp hid=\"HID_FUNC_FALSCH\"\>Returns the logical value FALSE.\</ahelp\> The FALSE() function does not require any arguments, and always returns the logical value FALSE.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3146939				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3150030				0	gl	FALSE()				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3150697				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3154842	8			0	gl	            \<item type=\"input\"\>=FALSE()\</item\> returns FALSE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3147468	9			0	gl	            \<item type=\"input\"\>=NOT(FALSE())\</item\> returns TRUE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	bm_id3150141				0	gl	\<bookmark_value\>IF function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3150141				0	gl	SE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3148740				0	gl	\<ahelp hid=\"HID_FUNC_WENN\"\>Specifies a logical test to be performed.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3153325				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3154558				0	gl	IF(Test; ThenValue; OtherwiseValue)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3149727	52			0	gl	            \<emph\>Test\</emph\> is any value or expression that can be TRUE or FALSE.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3155828	53			0	gl	            \<emph\>ThenValue\</emph\> (optional) is the value that is returned if the logical test is TRUE.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3154811	54			0	gl	            \<emph\>OtherwiseValue\</emph\> (optional) is the value that is returned if the logical test is FALSE.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_idN107FA				0	gl	            \<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>         				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3149507				0	gl	Exemplos				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3150867	57			0	gl	            \<item type=\"input\"\>=IF(A1>5;100;"too small")\</item\> If the value in A1 is higher than 5, the value 100 is entered in the current cell; otherwise, the text “too small” (without quotes) is entered.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	bm_id3155954				0	gl	\<bookmark_value\>NOT function\</bookmark_value\>				20200411 15:09:53
