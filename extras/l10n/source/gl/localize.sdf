helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154546				0	gl	\<ahelp hid=\"HID_FUNC_ABS\"\>Returns the absolute value of a number.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154843				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147475				0	gl	ABS(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148438				0	gl	\<emph\>Number\</emph\> is the number whose absolute value is to be calculated. The absolute value of a number is its value without the +/- sign.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155823				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152787				0	gl	\<item type=\"input\"\>=ABS(-56)\</item\> returns 56.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148752				0	gl	\<item type=\"input\"\>=ABS(12)\</item\> returns 12.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id320139				0	gl	\<item type=\"input\"\>=ABS(0)\</item\> returns 0.				20200411 15:09:53
