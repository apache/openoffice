helpcontent2	source\text\shared\01\06010000.xhp	0	help	hd_id3153056				0	gl	Cambiar				20200411 15:09:53
helpcontent2	source\text\shared\01\06010000.xhp	0	help	par_id3148559				0	gl	\<ahelp hid=\"SVX:PUSHBUTTON:RID_SVXDLG_SPELLCHECK:BTN_CHANGE\"\>Replaces the unknown word with the current suggestion. If you changed more than just the misspelled word, the entire sentence is replaced.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010000.xhp	0	help	hd_id3145787				0	gl	Cambiar todo				20200411 15:09:53
