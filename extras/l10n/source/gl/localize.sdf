helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3150330				0	gl	Fórmulas				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3153715				0	gl	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_TABLE:BTN_FORMULAS\"\>Prints the formulas contained in the cells, instead of the results.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3156385				0	gl	Valores cero				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3149258				0	gl	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_TABLE:BTN_NULLVALS\"\>Specifies that cells with a zero value are printed.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3154022				0	gl	Page Order				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3166423				0	gl	Defines the order in which data in a sheet is numbered and printed when it does not fit on one printed page.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3152580				0	gl	Top to bottom, then right				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3150205				0	gl	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCPAGE_TABLE:BTN_TOPDOWN\"\>Prints vertically from the left column to the bottom of the sheet.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3150786				0	gl	Left to right, then down				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3154657				0	gl	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCPAGE_TABLE:BTN_LEFTRIGHT\"\>Prints horizontally from the top row of the sheet to the right column.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3150887				0	gl	Número da primeira páxina				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3155378				0	gl	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_TABLE:BTN_PAGENO\"\>Select this option if you want the first page to start with a number other than 1.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3145389				0	gl	\<ahelp hid=\"SC:NUMERICFIELD:RID_SCPAGE_TABLE:ED_PAGENO\"\>Enter the number of the first page.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3146978				0	gl	Escala				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3149408				0	gl	Defines a page scale for the printed spreadsheet.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_idN1096D				0	gl	Scaling mode				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_idN10971				0	gl	\<ahelp hid=\"sc:ListBox:RID_SCPAGE_TABLE:LB_SCALEMODE\"\>Select a scaling mode from the list box. Appropriate controls will be shown at the side of the list box.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3155089				0	gl	Reducir/aumentar impresión				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3159171				0	gl	Specifies a scaling factor to scale all printed pages.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_idN1099A				0	gl	Scaling factor				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3152899				0	gl	\<ahelp hid=\"SC_METRICFIELD_RID_SCPAGE_TABLE_ED_SCALEALL\" visibility=\"hidden\"\>Enter a scaling factor. Factors less than 100 reduce the pages, higher factors enlarge the pages.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_idN109B2				0	gl	Axustar intervalo(s) de impresión á largura e altura				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_idN109B5				0	gl	Specifies the maximum number of pages horizontally (width) and vertically (height) on which every sheet with the current Page Style is to be printed. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_idN109BB				0	gl	The print ranges are always scaled proportionally, so the resulting number of pages may be less than specified.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_idN109BF				0	gl	You may clear one of the boxes, then the unspecified dimension will use as many pages as necessary.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_idN109C3				0	gl	If you clear both boxes, this will result in a scaling factor of 100%.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_idN109CE				0	gl	Width in pages				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_idN109D1				0	gl	\<ahelp hid=\"sc:NumericField:RID_SCPAGE_TABLE:ED_SCALEPAGEWIDTH\"\>Enter the maximum number of pages to be printed horizontally across.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_idN109E8				0	gl	Height in pages				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_idN109EB				0	gl	\<ahelp hid=\"sc:NumericField:RID_SCPAGE_TABLE:ED_SCALEPAGEHEIGHT\"\>Enter the maximum number of pages to be printed vertically stacked.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3148868				0	gl	Axustar intervalo(s) de impresión ao número de páxinas				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3145074				0	gl	Specifies the maximum number of pages on which every sheet with the current Page Style is to be printed. The scale will be reduced as necessary to fit the defined number of pages.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_idN10A26				0	gl	Number of pages				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3144507				0	gl	\<ahelp hid=\"SC:NUMERICFIELD:RID_SCPAGE_TABLE:ED_SCALEPAGENUM\"\>Enter the maximum number of pages to be printed.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weekday.xhp	0	help	tit				0	gl	WEEKDAY 				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weekday.xhp	0	help	bm_id3154925				0	gl	\<bookmark_value\>WEEKDAY function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weekday.xhp	0	help	hd_id3154925				0	gl	\<variable id=\"weekday\"\>\<link href=\"text/scalc/01/func_weekday.xhp\"\>WEEKDAY\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weekday.xhp	0	help	par_id3154228				0	gl	\<ahelp hid=\"HID_FUNC_WOCHENTAG\"\>Returns the day of the week for the given date value.\</ahelp\> The day is returned as an integer between 1 (Sunday) and 7 (Saturday) if no type or type=1 is specified. If type=2, numbering begins at Monday=1; and if type=3 numbering begins at Monday=0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weekday.xhp	0	help	hd_id3147217				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weekday.xhp	0	help	par_id3149033				0	gl	WEEKDAY(Number; Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weekday.xhp	0	help	par_id3149046				0	gl	\<emph\>Number\</emph\>, as a date value, is a decimal for which the weekday is to be returned.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weekday.xhp	0	help	par_id3154394				0	gl	\<emph\>Type\</emph\> determines the type of calculation. For Type=1, the weekdays are counted starting from Sunday (this is the default even when the Type parameter is missing). For Type=2, the weekdays are counted starting from Monday=1. For Type=3, the weekdays are counted starting from Monday=0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weekday.xhp	0	help	par_id3156188				0	gl	These values apply only to the standard date format that you select under \<emph\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - %PRODUCTNAME Calc - Calculate\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weekday.xhp	0	help	hd_id3153836				0	gl	Exemplos				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weekday.xhp	0	help	par_id3150317				0	gl	=WEEKDAY("2000-06-14") returns 4 (the Type parameter is missing, therefore the standard count is used. The standard count starts with Sunday as day number 1. June 14, 2000 was a Wednesday and therefore day number 4).				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weekday.xhp	0	help	par_id3153174				0	gl	=WEEKDAY("1996-07-24";2) returns 3 (the Type parameter is 2, therefore Monday is day number 1. July 24, 1996 was a Wednesday and therefore day number 3).				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weekday.xhp	0	help	par_id3153525				0	gl	=WEEKDAY("1996-07-24";1) returns 4 (the Type parameter is 1, therefore Sunday is day number 1. July 24, 1996 was a Wednesday and therefore day number 4).				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weekday.xhp	0	help	par_id3150575				0	gl	=WEEKDAY(NOW()) returns the number of the current day.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weekday.xhp	0	help	par_id3150588	171			0	gl	To obtain a function indicating whether a day in A1 is a business day, use the IF and WEEKDAY functions as follows: \<br/\>IF(WEEKDAY(A1;2)<6;"Business day";"Weekend")				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	tit				0	gl	Campo de datos				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	bm_id7292397				0	gl	\<bookmark_value\>calculating;pivot table\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	hd_id3150871				0	gl	Campo de datos				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_id3154124				0	gl	The contents of this dialog is different for data fields in the \<emph\>Data\</emph\> area, and data fields in the \<emph\>Row\</emph\> or \<emph\>Column\</emph\> area of the \<link href=\"text/scalc/01/12090102.xhp\" name=\"Pivot table\"\>Pivot Table\</link\> dialog.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	hd_id3152596				0	gl	Subtotais				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_id3151113				0	gl	\<ahelp hid=\"HID_SC_PIVOTSUBT\"\>Specify the subtotals that you want to calculate.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	hd_id3145366				0	gl	Ningún				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_id3152576				0	gl	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_PIVOTSUBT:BTN_NONE\"\>Does not calculate subtotals.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	hd_id3154012				0	gl	Automático				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_id3155856				0	gl	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_PIVOTSUBT:BTN_AUTO\"\>Automatically calculates subtotals.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	hd_id3155411				0	gl	Definido polo usuario				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_id3149581				0	gl	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_PIVOTSUBT:BTN_USER\"\>Select this option, and then click the type of subtotal that you want to calculate in the list.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	hd_id3147124				0	gl	Función				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_id3154490				0	gl	\<ahelp hid=\"SC:MULTILISTBOX:RID_SCDLG_PIVOTSUBT:LB_FUNC\"\>Click the type of subtotal that you want to calculate. This option is only available if the \<emph\>User-defined\</emph\> option is selected.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	hd_id3154944				0	gl	Show elements without data				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_id3149403				0	gl	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_PIVOTSUBT:CB_SHOWALL\"\>Includes empty columns and rows in the results table.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	hd_id3149122				0	gl	Nome:				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_id3150749				0	gl	Lists the name of the selected data field.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN106EC				0	gl	Máis				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN106F0				0	gl	\<ahelp hid=\".\"\>Expands or reduces the dialog. The \<emph\>More\</emph\> button is visible for data fields only.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN106F3				0	gl	Opcións				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN106F7				0	gl	\<ahelp hid=\".\"\>Opens the \<link href=\"text/scalc/01/12090106.xhp\"\>Data Field Options\</link\> dialog. The \<emph\>Options\</emph\> button is visible for column, row, or page fields only.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN10708				0	gl	If the dialog is expanded by the \<emph\>More\</emph\> button, the following items are added to the dialog:				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN1070B				0	gl	Valor visualizado				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN1070F				0	gl	\<ahelp hid=\".\"\>For each data field, you can select the type of display.\</ahelp\> For some types you can select additional information for a base field and a base item.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN10712				0	gl	Tipo				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN10716				0	gl	\<ahelp hid=\"1495371266\"\>Select the type of calculating of the displayed value for the data field.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN10724				0	gl	Tipo				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN1072A				0	gl	Valor visualizado				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN10731				0	gl	Normal				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN10737				0	gl	Results are shown unchanged				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN1073E				0	gl	Diferenza con				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN10744				0	gl	From each result, its reference value (see below) is subtracted, and the difference is shown. Totals outside of the base field are shown as empty results.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN10747				0	gl	\<emph\>Named item\</emph\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN1074C				0	gl	If a base item name is specified, the reference value for a combination of field items is the result where the item in the base field is replaced by the specified base item.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN1074F				0	gl	\<emph\>Previous item or Next item\</emph\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN10754				0	gl	If "previous item" or "next item" is specified as the base item, the reference value is the result for the next visible member of the base field, in the base field's sort order.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN1075B				0	gl	% Of				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN10761				0	gl	Each result is divided by its reference value. The reference value is determined in the same way as for "Difference from". Totals outside of the base field are shown as empty results. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN1076A				0	gl	Diferenza con				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN10770				0	gl	From each result, its reference value is subtracted, and the difference is divided by the reference value. The reference value is determined in the same way as for "Difference from". Totals outside of the base field are shown as empty results.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN10777				0	gl	Executando total en				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN1077D				0	gl	Each result is added to the sum of the results for preceding items in the base field, in the base field's sort order, and the total sum is shown.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN10780				0	gl	Results are always summed, even if a different summary function was used to get each result.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN10787				0	gl	% de fila				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN1078D				0	gl	Each result is divided by the total result for its row in the pivot table. If there are several data fields, the total for the result's data field is used. If there are subtotals with manually selected summary functions, the total with the data field's summary function is still used. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN10794				0	gl	% de columna				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN1079A				0	gl	Same as "% of row", but the total for the result's column is used.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN107A1				0	gl	% de total				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN107A7				0	gl	Same as "% of row", but the grand total for the result's data field is used.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN107AE				0	gl	Índice				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN107B4				0	gl	The row and column totals and the grand total, following the same rules as above, are used to calculate the following expression:				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN107B7				0	gl	( original result * grand total ) / ( row total * column total )				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN107BA				0	gl	Base field				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN107BE				0	gl	\<ahelp hid=\"1495371267\"\>Select the field from which the respective value is taken as base for the calculation.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN107C1				0	gl	Base item				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090105.xhp	0	help	par_idN107C5				0	gl	\<ahelp hid=\"1495371268\"\>Select the item of the base field from which the respective value is taken as base for the calculation.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080100.xhp	0	help	tit				0	gl	Hide Details				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080100.xhp	0	help	bm_id3155628				0	gl	\<bookmark_value\>sheets; hiding details\</bookmark_value\>				20200411 15:09:53
