helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3159279	139			0	gl	                     \<item type=\"input\"\>195\</item\>                  				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3149105	140			0	gl	                     \<item type=\"input\"\>170\</item\>                  				20200411 15:09:53
