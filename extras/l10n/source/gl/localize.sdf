helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155100				0	gl	\<ahelp hid=\"HID_AAI_FUNC_PRICEDISC\"\>Calculates the price per 100 currency units of par value of a non-interest- bearing security.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149294				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146084				0	gl	PRICEDISC(Settlement; Maturity; Discount; Redemption; Basis)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3159179				0	gl	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154304				0	gl	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156014				0	gl	\<emph\>Discount\</emph\> is the discount of a security as a percentage.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147489				0	gl	\<emph\>Redemption\</emph\> is the redemption value per 100 currency units of par value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3152794				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149198				0	gl	A security is purchased on 1999-02-15; the maturity date is 1999-03-01. Discount in per cent is 5.25%. The redemption value is 100. When calculating on basis 2 the price discount is as follows:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151178				0	gl	=PRICEDISC("1999-02-15"; "1999-03-01"; 0.0525; 100; 2) returns 99.79583.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3154693				0	gl	\<bookmark_value\>PRICEMAT function\</bookmark_value\>\<bookmark_value\>prices;interest-bearing securities\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154693				0	gl	PREZOVENC				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153906				0	gl	\<ahelp hid=\"HID_AAI_FUNC_PRICEMAT\"\>Calculates the price per 100 currency units of par value of a security, that pays interest on the maturity date.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154933				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155393				0	gl	PRICEMAT(Settlement; Maturity; Issue; Rate; Yield; Basis)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153102				0	gl	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150530				0	gl	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149903				0	gl	\<emph\>Issue\</emph\> is the date of issue of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148828				0	gl	\<emph\>Rate\</emph\> is the interest rate of the security on the issue date.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146993				0	gl	\<emph\>Yield\</emph\> is the annual yield of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150507				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154289				0	gl	Settlement date: February 15 1999, maturity date: April 13 1999, issue date: November 11 1998. Interest rate: 6.1 per cent, yield: 6.1 per cent, basis: 30/360 = 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154905				0	gl	The price is calculated as follows:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3158409				0	gl	=PRICEMAT("1999-02-15";"1999-04-13";"1998-11-11"; 0.061; 0.061;0) returns 99.98449888.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3148448				0	gl	\<bookmark_value\>calculating; durations\</bookmark_value\>\<bookmark_value\>durations;calculating\</bookmark_value\>\<bookmark_value\>DURATION function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3148448				0	gl	DURACIÓN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153056				0	gl	\<ahelp hid=\"HID_FUNC_LAUFZEIT\"\>Calculates the number of periods required by an investment to attain the desired value.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3145421				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148933				0	gl	DURATION(Rate; PV; FV)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148801				0	gl	\<emph\>Rate\</emph\> is a constant. The interest rate is to be calculated for the entire duration (duration period). The interest rate per period is calculated by dividing the interest rate by the calculated duration. The internal rate for an annuity is to be entered as Rate/12.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147239				0	gl	\<emph\>PV\</emph\> is the present (current) value. The cash value is the deposit of cash or the current cash value of an allowance in kind. As a deposit value a positive value must be entered; the deposit must not be 0 or <0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147515				0	gl	\<emph\>FV\</emph\> is the expected value. The future value determines the desired (future) value of the deposit.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153579				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148480				0	gl	At an interest rate of 4.75%, a cash value of 25,000 currency units and a future value of 1,000,000 currency units, a duration of 79.49 payment periods is returned. The periodic payment is the resulting quotient from the future value and the duration, in this case 1,000,000/79.49=12,850.20.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3148912				0	gl	\<bookmark_value\>calculating;linear depreciations\</bookmark_value\>\<bookmark_value\>depreciations;linear\</bookmark_value\>\<bookmark_value\>linear depreciations\</bookmark_value\>\<bookmark_value\>straight-line depreciations\</bookmark_value\>\<bookmark_value\>SLN function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3148912				0	gl	SLN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149154	291			0	gl	\<ahelp hid=\"HID_FUNC_LIA\"\>Returns the straight-line depreciation of an asset for one period.\</ahelp\>The amount of the depreciation is constant during the depreciation period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153240				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3166456				0	gl	SLN(Cost; Salvage; Life)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146955				0	gl	\<emph\>Cost\</emph\> is the initial cost of an asset.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149796				0	gl	\<emph\>Salvage\</emph\> is the value of an asset at the end of the depreciation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3166444				0	gl	\<emph\>Life\</emph\> is the depreciation period determining the number of periods in the depreciation of the asset.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155579				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154098				0	gl	Office equipment with an initial cost of 50,000 currency units is to be depreciated over 7 years. The value at the end of the depreciation is to be 3,500 currency units.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153390				0	gl	\<item type=\"input\"\>=SLN(50000;3,500;84)\</item\> = 553.57 currency units. The periodic monthly depreciation of the office equipment is 553.57 currency units.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3153739				0	gl	\<bookmark_value\>MDURATION function\</bookmark_value\>\<bookmark_value\>Macauley duration\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153739				0	gl	MDURACIÓN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149923				0	gl	\<ahelp hid=\"HID_AAI_FUNC_MDURATION\"\>Calculates the modified Macauley duration of a fixed interest security in years.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149964				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148987				0	gl	MDURATION(Settlement; Maturity; Coupon; Yield; Frequency; Basis)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148619				0	gl	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149805				0	gl	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154338				0	gl	\<emph\>Coupon\</emph\> is the annual nominal rate of interest (coupon interest rate)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148466				0	gl	\<emph\>Yield\</emph\> is the annual yield of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149423				0	gl	\<emph\>Frequency\</emph\> is the number of interest payments per year (1, 2 or 4).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154602				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148652				0	gl	A security is purchased on 2001-01-01; the maturity date is 2006-01-01. The nominal rate of interest is 8%. The yield is 9.0%. Interest is paid half-yearly (frequency is 2). Using daily balance interest calculation (basis 3) how long is the modified duration?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145378				0	gl	=MDURATION("2001-01-01"; "2006-01-01"; 0.08; 0.09; 2; 3) returns 4.02 years.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3149242				0	gl	\<bookmark_value\>calculating;net present values\</bookmark_value\>\<bookmark_value\>net present values\</bookmark_value\>\<bookmark_value\>NPV function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149242				0	gl	VAL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145308				0	gl	\<ahelp hid=\"HID_FUNC_NBW\"\>Returns the present value of an investment based on a series of periodic cash flows and a discount rate. To get the net present value, subtract the cost of the project (the initial cash flow at time zero) from the returned value.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149937				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153321				0	gl	NPV(Rate; Value1; Value2; ...)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150630				0	gl	\<emph\>Rate\</emph\> is the discount rate for a period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150427				0	gl	\<emph\>Value1;...\</emph\> are up to 30 values, which represent deposits or withdrawals.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153538				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154800				0	gl	What is the net present value of periodic payments of 10, 20 and 30 currency units with a discount rate of 8.75%. At time zero the costs were paid as -40 currency units.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3143270				0	gl	\<item type=\"input\"\>=NPV(8.75%;10;20;30)\</item\> = 49.43 currency units. The net present value is the returned value minus the initial costs of 40 currency units, therefore 9.43 currency units.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3149484				0	gl	\<bookmark_value\>calculating;nominal interest rates\</bookmark_value\>\<bookmark_value\>nominal interest rates\</bookmark_value\>\<bookmark_value\>NOMINAL function\</bookmark_value\>				20200411 15:09:53
