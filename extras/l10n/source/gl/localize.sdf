helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	hd_id3148735				0	gl	\<variable id=\"yearfrac\"\>\<link href=\"text/scalc/01/func_yearfrac.xhp\"\>YEARFRAC\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3150899				0	gl	\<ahelp hid=\"HID_AAI_FUNC_YEARFRAC\"\> The result is a number between 0 and 1, representing the fraction of a year between \<emph\>StartDate\</emph\> and \<emph\>EndDate\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	hd_id3155259				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3155823				0	gl	YEARFRAC(StartDate; EndDate; Basis)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3145144				0	gl	\<emph\>StartDate\</emph\> and \<emph\>EndDate\</emph\> are two date values.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3149954				0	gl	\<emph\>Basis\</emph\> is chosen from a list of options and indicates how the year is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3146847				0	gl	Base				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3155956				0	gl	Cálculo				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3154502				0	gl	0 ou falta				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3149877				0	gl	US method (NASD), 12 months of 30 days each				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3148766				0	gl	1				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3154326				0	gl	Exact number of days in months, exact number of days in year				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3145245				0	gl	2				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3155620				0	gl	Exact number of days in month, year has 360 days				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3145297				0	gl	3				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3148394				0	gl	Exact number of days in month, year has 365 days				20200411 15:09:53
