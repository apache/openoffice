helpcontent2	source\text\shared\01\05340500.xhp	0	help	hd_id3148882				0	gl	\<link href=\"text/shared/01/05340500.xhp\" name=\"Hide Columns\"\>Hide Columns\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05340500.xhp	0	help	par_id3155620				0	gl	\<ahelp hid=\".\"\>Hides the selected column(s). To display hidden columns, right-click any column header, and then choose \<emph\>Show Columns\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	tit				0	gl	Chinese Conversion				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	bm_id49745				0	gl	\<bookmark_value\>Chinese writing systems\</bookmark_value\>\<bookmark_value\>simplified Chinese;conversion to traditional Chinese\</bookmark_value\>\<bookmark_value\>traditional Chinese;conversion to simplified Chinese\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10547				0	gl	\<link href=\"text/shared/01/06010600.xhp\"\>Chinese Conversion\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10557				0	gl	\<ahelp hid=\".\"\>Converts the selected Chinese text from one Chinese writing system to the other. If no text is selected, the entire document is converted.\</ahelp\> You can only use this command if you enable Asian language support in \<emph\>Tools - Options - Language Settings - Languages\</emph\>.				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10572				0	gl	Conversion direction				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10576				0	gl	\<ahelp hid=\".\"\>Select the conversion direction.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10579				0	gl	Traditional Chinese to Simplified Chinese				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1057D				0	gl	\<ahelp hid=\".\"\>Converts traditional Chinese text characters to simplified Chinese text characters. Click \<emph\>OK\</emph\> to convert the selected text. If no text is selected, the whole document is converted.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10580				0	gl	Simplified Chinese to Traditional Chinese				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10584				0	gl	\<ahelp hid=\".\"\>Converts simplified Chinese text characters to traditional Chinese text characters. Click \<emph\>OK\</emph\> to convert the selected text. If no text is selected, the whole document is converted.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1058E				0	gl	Termos comúns				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10592				0	gl	\<ahelp hid=\".\"\>Common terms are words that have the same meaning in traditional and simplified Chinese but are written with different characters.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10595				0	gl	Convert Common Terms				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10599				0	gl	\<ahelp hid=\".\"\>Converts words with two or more characters that are in the list of common terms. After the list is scanned, the remaining text is converted character by character.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1059C				0	gl	Editar termos				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN105A0				0	gl	\<ahelp hid=\".\"\>Opens the \<link href=\"text/shared/01/06010601.xhp\"\>Edit Dictionary\</link\> dialog where you can edit the list of conversion terms.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	tit				0	gl	Comentario				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	hd_id3083278				0	gl	Comentario				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	par_id3148983				0	gl	\<variable id=\"kommentartext\"\>\<ahelp hid=\"HID_REDLINING_EDIT\"\>Enter a comment for the recorded change.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	par_id3155391	3			0	gl	You can attach a comment when \<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>the cursor is in a changed text passage \</caseinline\>\<caseinline select=\"CALC\"\>the changed cell is selected\</caseinline\>\</switchinline\>, or in the \<emph\>Accept or Reject Changes\</emph\> dialog.				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	par_id3156426	5			0	gl	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>Comments are displayed as callouts in the sheet when you rest your mouse pointer over a cell with a recorded change. You can also view comments that are attached to a changed cell in the changes list in the \<link href=\"text/shared/01/02230400.xhp\" name=\"Accept or Reject Changes\"\>\<emph\>Accept or Reject Changes\</emph\>\</link\> dialog. \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	tit				0	gl	Lista de expresións regulares				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	bm_id3146765				0	gl	\<bookmark_value\>regular expressions; list of\</bookmark_value\>      \<bookmark_value\>lists;regular expressions\</bookmark_value\>      \<bookmark_value\>replacing;tab stops (regular expressions)\</bookmark_value\>      \<bookmark_value\>tab stops;regular expressions\</bookmark_value\>      \<bookmark_value\>concatenation, see ampersand symbol\</bookmark_value\>      \<bookmark_value\>ampersand symbol, see also operators\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	hd_id3146765				0	gl	\<variable id=\"02100001\"\>\<link href=\"text/shared/01/02100001.xhp\"\>List of Regular Expressions\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149741				0	gl	Carácter				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155577				0	gl	Resultado/Uso				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id6600543				0	gl	Calquera carácter				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9824518.00000001				0	gl	Represents the given character unless otherwise specified.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152427				0	gl	.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149031				0	gl	Representa calquera carácter, excepto quebras de liña ou de parágrafo. Por exemplo, o termo de busca "d.do" devolve tanto "dado" como "dedo".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154682				0	gl	^				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155351				0	gl	Só localiza o termo de busca se está no inicio dun parágrafo. Ignóranse os obxectos especiais, tales como os campos baleiros ou os marcos ancorados a un carácter. Exemplo: "^Salvaterra".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3159194				0	gl	$				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152542				0	gl	Só localiza o termo de busca se está no final dun parágrafo. Ignóranse os obxectos especiais, tales como os campos baleiros ou os marcos ancorados a un carácter. Exemplo: "Salvaterra$".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156414				0	gl	*				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155555				0	gl	Localiza cero ou máis caracteres antes de "*". Por exemplo, "Ab*c" localiza "Ac", "Abc", "Abbc", "Abbbc", e así por diante.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147399				0	gl	+				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3157958				0	gl	Localiza un ou máis caracteres antes de "+". Por exemplo, "AX.+4" localiza "AXx4", mais non "AX4".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145313				0	gl	Búscase sempre a cadea de caracteres do parágrafo máis longa posíbel que se corresponda con este patrón de pesquisa. Se o parágrafo contén a cadea de caracteres "AX 4 AX4", reálzase toda a pasaxe.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3143267				0	gl	?				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153684				0	gl	Localiza cero ou un carácter antes de "?". Por exemplo, "Texts?" localiza "Text" e "Texts", e "x(ab|c)?y" localiza "xy", "xaby" ou "xcy".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3166410				0	gl	\\				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147209				0	gl	Search interprets the special character that follows the "\\" as a normal character and not as a regular expression (except for the combinations \\n, \\t, \\>, and \\<). For example, "tree\\." finds "tree.", not "treed" or "trees".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152945				0	gl	\\n				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153700				0	gl	Represents a line break that was inserted with the Shift+Enter key combination. To change a line break into a paragraph break, enter \<emph\>\\n\</emph\> in the \<emph\>Search for\</emph\> and \<emph\>Replace with\</emph\> boxes, and then perform a search and replace.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9262672				0	gl	\\n in the \<emph\>Search for\</emph\> text box stands for a line break that was inserted with the Shift+Enter key combination.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id2366100				0	gl	\\n in the \<emph\>Replace with\</emph\> text box stands for a paragraph break that can be entered with the Enter or Return key.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153258				0	gl	\\t				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3157809				0	gl	Represents a tab. You can also use this expression in the \<emph\>Replace with\</emph\> box.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150670				0	gl	\\b				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153666				0	gl	Match a word boundary. For example, "\\bbook" finds "bookmark" but not "checkbook" whereas "book\\b" finds "checkbook" but not "bookmark". The discrete word "book" is found by both search terms.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149576				0	gl	^$				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3151245				0	gl	Localiza un parágrafo baleiro.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148550				0	gl	^.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3159413				0	gl	Localiza o primeiro carácter dun parágrafo.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147282				0	gl	& or $0				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153961				0	gl	Adds the string that was found by the search criteria in the \<emph\>Search for\</emph\> box to the term in the \<emph\>Replace with\</emph\> box when you make a replacement.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149650				0	gl	For example, if you enter "window" in the \<emph\>Search for\</emph\> box and "&frame" in the \<emph\>Replace with\</emph\> box, the word "window" is replaced with "windowframe".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150543				0	gl	You can also enter an "&" in the \<emph\>Replace with\</emph\> box to modify the \<emph\>Attributes\</emph\> or the \<emph\>Format\</emph\> of the string found by the search criteria.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145419				0	gl	[abc123]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154630				0	gl	Representa un dos caracteres colocados entre os corchetes.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156293				0	gl	[a-e]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149167				0	gl	Represents any of the characters that are between a and e, including both start and end characters				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id100520090232005				0	gl	The characters are ordered by their code numbers.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155994				0	gl	[a-eh-x]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148676				0	gl	Representa calquera carácter situado entre a-e e h-x.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145318				0	gl	[^a-s]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153351				0	gl	Represents everything that is not between a and s.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156543				0	gl	\\xXXXX				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153768				0	gl	Representa un carácter especial de acordo co seu código hexadecimal de catro díxitos (XXXX).				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3159252				0	gl	The code for the special character depends on the font used. You can view the codes by choosing \<emph\>Insert - Special Character\</emph\>.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153951				0	gl	|				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154985				0	gl	Finds the terms that occur before the "|" and also finds the terms that occur after the "|". For example, "this|that" finds "this" and "that".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147376				0	gl	{2}				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150103				0	gl	Define o número mínimo de ocorrencias do carácter situado antes da chave. Por exemplo, "Ce{2,}" localiza "Cee", "Cercedo", "Cecebre", etc.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3151289				0	gl	{1,2}				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147317				0	gl	Define o número mínimo de ocorrencias do carácter situado antes da chave. Por exemplo, "Ce{2,}" localiza "Cee", "Cercedo", "Cecebre", etc.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id4870754				0	gl	{1,}				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id843836				0	gl	Define o número mínimo de ocorrencias do carácter situado antes da chave. Por exemplo, "Ce{2,}" localiza "Cee", "Cercedo", "Cecebre", etc.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148616				0	gl	( )				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id2701803				0	gl	In the \<emph\>Search for\</emph\> box:				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153573				0	gl	Defines the characters inside the parentheses as a reference. You can then refer to the first reference in the current expression with "\\1", to the second reference with "\\2", and so on.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156061				0	gl	For example, if your text contains the number 13487889 and you search using the regular expression (8)7\\1\\1, "8788" is found.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id2367931				0	gl	Pódese usar () para agrupar termos; por exemplo, "a(bc)?d" localiza "ad" ou "abcd".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9200109				0	gl	In the \<emph\>Replace with\</emph\> box:				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id5766472				0	gl	Use $ (dollar) instead of \\ (backslash) to replace references. Use $0 to replace the whole found string.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154790				0	gl	[:alpha:]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147397				0	gl	Represents an alphabetic character. Use [:alpha:]+ to find one or more of them.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152885				0	gl	[:digit:]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150010				0	gl	Represents a decimal digit. Use [:digit:]+ to find one or more of them.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153743				0	gl	[:alnum:]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153281				0	gl	Representa un carácter alfanumérico ([:alpha:] e [:digit:]).				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153726				0	gl	[:space:]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150961				0	gl	Represents a space character (but not other whitespace characters).				20200411 15:09:53
