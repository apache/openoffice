helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3150880				0	gl	\<ahelp hid=\"HID_FUNC_BETAVERT\"\>Returns the beta function.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3150762				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3147571				0	gl	BETADIST(Number; Alpha; Beta; Start; End; Cumulative)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3156317	68			0	gl	            \<emph\>Number\</emph\> is the value between \<emph\>Start\</emph\> and \<emph\>End\</emph\> at which to evaluate the function.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3156107	69			0	gl	            \<emph\>Alpha\</emph\> is a parameter to the distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3153619	70			0	gl	            \<emph\>Beta\</emph\> is a parameter to the distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3150254	71			0	gl	            \<emph\>Start\</emph\> (optional) is the lower bound for \<emph\>Number\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3149138	72			0	gl	            \<emph\>End\</emph\> (optional) is the upper bound for \<emph\>Number\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id012020091254453				0	gl	            \<emph\>Cumulative\</emph\> (optional) can be 0 or False to calculate the probability density function. It can be any other value or True or omitted to calculate the cumulative distribution function.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_idN10AB3				0	gl	            \<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>         				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3145649				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3156118	74			0	gl	            \<item type=\"input\"\>=BETADIST(0.75;3;4)\</item\> returns the value 0.96				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	bm_id3143228				0	gl	\<bookmark_value\>BINOMDIST function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3143228				0	gl	DISTBINOM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3146897				0	gl	\<ahelp hid=\"HID_FUNC_BINOMVERT\"\>Returns the individual term binomial distribution probability.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3149289				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3156009				0	gl	BINOMDIST(X; Trials; SP; C)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3154304	80			0	gl	            \<emph\>X\</emph\> is the number of successes in a set of trials.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3147492	81			0	gl	            \<emph\>Trials\</emph\> is the number of independent trials.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3146085	82			0	gl	            \<emph\>SP\</emph\> is the probability of success on each trial.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3149760	83			0	gl	            \<emph\>C\</emph\> = 0 calculates the probability of a single event and \<emph\>C\</emph\> = 1 calculates the cumulative probability.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3151171				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3145666	85			0	gl	            \<item type=\"input\"\>=BINOMDIST(A1;12;0.5;0)\</item\> shows (if the values \<item type=\"input\"\>0\</item\> to \<item type=\"input\"\>12\</item\> are entered in A1) the probabilities for 12 flips of a coin that \<emph\>Heads\</emph\> will come up exactly the number of times entered in A1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3150120	86			0	gl	            \<item type=\"input\"\>=BINOMDIST(A1;12;0.5;1)\</item\> shows the cumulative probabilities for the same series. For example, if A1 = \<item type=\"input\"\>4\</item\>, the cumulative probability of the series is 0, 1, 2, 3 or 4 times \<emph\>Heads\</emph\> (non-exclusive OR).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	bm_id0119200902432928				0	gl	\<bookmark_value\>CHISQINV function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id0119200902421451				0	gl	CHISQINV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id0119200902421449				0	gl	\<ahelp hid=\".\"\>Returns the inverse of CHISQDIST.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id0119200902475241				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id0119200902475286				0	gl	            \<emph\>Probability\</emph\> is the probability value for which the inverse of the chi-square distribution is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id0119200902475282				0	gl	            \<emph\>Degrees Of Freedom\</emph\> is the degrees of freedom for the chi-square function.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	bm_id3148835				0	gl	\<bookmark_value\>CHIINV function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3148835				0	gl	INVKHI				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3149906				0	gl	\<ahelp hid=\"HID_FUNC_CHIINV\"\>Returns the inverse of the one-tailed probability of the chi-squared distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3159157				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3150504				0	gl	CHIINV(Number; DegreesFreedom)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3154898	92			0	gl	            \<emph\>Number\</emph\> is the value of the error probability.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3154294	93			0	gl	            \<emph\>DegreesFreedom\</emph\> is the degrees of freedom of the experiment.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3154208				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3150777				0	gl	A die is thrown 1020 times. The numbers on the die 1 through 6 come up 195, 151, 148, 189, 183 and 154 times (observation values). The hypothesis that the die is not fixed is to be tested.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3153062				0	gl	The Chi square distribution of the random sample is determined by the formula given above. Since the expected value for a given number on the die for n throws is n times 1/6, thus 1020/6 = 170, the formula returns a Chi square value of 13.27.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3148806				0	gl	If the (observed) Chi square is greater than or equal to the (theoretical) Chi square CHIINV, the hypothesis will be discarded, since the deviation between theory and experiment is too great. If the observed Chi square is less that CHIINV, the hypothesis is confirmed with the indicated probability of error.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3149763	95			0	gl	            \<item type=\"input\"\>=CHIINV(0.05;5)\</item\> returns 11.07.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3159142	133			0	gl	            \<item type=\"input\"\>=CHIINV(0.02;5)\</item\> returns 13.39.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3158401				0	gl	If the probability of error is 5%, the die is not true. If the probability of error is 2%, there is no reason to believe it is fixed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	bm_id3154260				0	gl	\<bookmark_value\>CHITEST function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3154260				0	gl	TESTEKHI				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3151052				0	gl	\<ahelp hid=\"HID_FUNC_CHITEST\"\>Returns the probability of a deviance from a random distribution of two test series based on the chi-squared test for independence.\</ahelp\> CHITEST returns the chi-squared distribution of the data.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3148925				0	gl	The probability determined by CHITEST can also be determined with CHIDIST, in which case the Chi square of the random sample must then be passed as a parameter instead of the data row.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3154280				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3149162				0	gl	CHITEST(DataB; DataE)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3158421	101			0	gl	            \<emph\>DataB\</emph\> is the array of the observations.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3166453	102			0	gl	            \<emph\>DataE\</emph\> is the range of the expected values.				20200411 15:09:53
