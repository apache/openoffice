helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150254				0	gl	\<ahelp hid=\"HID_FUNC_PHI\"\>Returns the values of the distribution function for a standard normal distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154748				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149976				0	gl	PHI(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156108				0	gl	\<emph\>Number\</emph\> represents the value based on which the standard normal distribution is calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153621				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155849				0	gl	\<item type=\"input\"\>=PHI(2.25) \</item\>= 0.03				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3143236				0	gl	\<item type=\"input\"\>=PHI(-2.25)\</item\> = 0.03				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149286				0	gl	\<item type=\"input\"\>=PHI(0)\</item\> = 0.4				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153985				0	gl	\<bookmark_value\>POISSON function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153985				0	gl	POISSON				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154298				0	gl	\<ahelp hid=\"HID_FUNC_POISSON\"\>Returns the Poisson distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3159183				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146093				0	gl	POISSON(Number; Mean; C)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147253				0	gl	\<emph\>Number\</emph\> represents the value based on which the Poisson distribution is calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151177				0	gl	\<emph\>Mean\</emph\> represents the middle value of the Poisson distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149200				0	gl	\<emph\>C\</emph\> (optional) = 0 or False calculates the density function; \<emph\>C\</emph\> = 1 or True calculates the distribution. When omitted, the default value True is inserted when you save the document, for best compatibility with other programs and older versions of %PRODUCTNAME.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3159347				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150113				0	gl	\<item type=\"input\"\>=POISSON(60;50;1)\</item\> returns 0.93.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153100				0	gl	\<bookmark_value\>PERCENTILE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153100				0	gl	PERCENTIL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154940				0	gl	\<ahelp hid=\"HID_FUNC_QUANTIL\"\>Returns the alpha-percentile of data values in an array.\</ahelp\> A percentile returns the scale value for a data series which goes from the smallest (Alpha=0) to the largest value (alpha=1) of a data series. For \<item type=\"literal\"\>Alpha\</item\> = 25%, the percentile means the first quartile; \<item type=\"literal\"\>Alpha\</item\> = 50% is the MEDIAN.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150531				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148813				0	gl	PERCENTILE(Data; Alpha)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153054				0	gl	\<emph\>Data\</emph\> represents the array of data.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154212				0	gl	\<emph\>Alpha\</emph\> represents the percentage of the scale between 0 and 1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154290				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159147				0	gl	\<item type=\"input\"\>=PERCENTILE(A1:A50;0.1)\</item\> represents the value in the data set, which equals 10% of the total data scale in A1:A50.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148807				0	gl	\<bookmark_value\>PERCENTRANK function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148807				0	gl	RANGOPORCENTUAL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153573				0	gl	\<ahelp hid=\"HID_FUNC_QUANTILSRANG\"\>Returns the percentage rank of a value in a sample.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147512				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147238				0	gl	PERCENTRANK(Data; Value)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154266				0	gl	\<emph\>Data\</emph\> represents the array of data in the sample.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148475				0	gl	\<emph\>Value\</emph\> represents the value whose percentile rank must be determined.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155364				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149163				0	gl	\<item type=\"input\"\>=PERCENTRANK(A1:A50;50)\</item\> returns the percentage rank of the value 50 from the total range of all values found in A1:A50. If 50 falls outside the total range, an error message will appear.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3166442				0	gl	\<bookmark_value\>QUARTILE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3166442				0	gl	CUARTIL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146958				0	gl	\<ahelp hid=\"HID_FUNC_QUARTILE\"\>Returns the quartile of a data set.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152942				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153684				0	gl	QUARTILE(Data; Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153387				0	gl	\<emph\>Data\</emph\> represents the array of data in the sample.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155589				0	gl	\<emph\>Type\</emph\> represents the type of quartile. (0 = MIN, 1 = 25%, 2 = 50% (MEDIAN), 3 = 75% and 4 = MAX.)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149103				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159276				0	gl	\<item type=\"input\"\>=QUARTILE(A1:A50;2)\</item\> returns the value of which 50% of the scale corresponds to the lowest to highest values in the range A1:A50.				20200411 15:09:53
