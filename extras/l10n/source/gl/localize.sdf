helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155260				0	gl	\<ahelp hid=\"HID_FUNC_ANZAHLLEEREZELLEN\"\>Returns the number of empty cells.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145144				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153931				0	gl	COUNTBLANK(Range)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149512				0	gl	 Returns the number of empty cells in the cell range \<emph\>Range\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146139				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148586				0	gl	\<item type=\"input\"\>=COUNTBLANK(A1:B2)\</item\> returns 4 if cells A1, A2, B1, and B2 are all empty.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3153114				0	gl	\<bookmark_value\>ACOS function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153114				0	gl	ACOS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145163				0	gl	\<ahelp hid=\"HID_FUNC_ARCCOS\"\>Returns the inverse trigonometric cosine of a number.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153565				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150020				0	gl	ACOS(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159134				0	gl	 This function returns the inverse trigonometric cosine of \<emph\>Number\</emph\>, that is the angle (in radians) whose cosine is Number. The angle returned is between 0 and PI.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id679647				0	gl	To return the angle in degrees, use the DEGREES function.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3149882				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150128				0	gl	\<item type=\"input\"\>=ACOS(-1)\</item\> returns 3.14159265358979 (PI radians)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8792382				0	gl	\<item type=\"input\"\>=DEGREES(ACOS(0.5))\</item\> returns 60. The cosine of 60 degrees is 0.5.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3145355				0	gl	\<bookmark_value\>ACOSH function\</bookmark_value\>				20200411 15:09:53
