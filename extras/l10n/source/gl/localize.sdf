helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151193	243			0	gl	            \<emph\>Text\</emph\> is the text that represents a Roman number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155758				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154621	245			0	gl	            \<item type=\"input\"\>=ARABIC("MXIV")\</item\> returns 1014				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147553	246			0	gl	            \<item type=\"input\"\>=ARABIC("MMII")\</item\> returns 2002				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id8796349				0	gl	\<bookmark_value\>ASC function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id7723929				0	gl	ASC				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id8455153				0	gl	\<ahelp hid=\".\"\>The ASC function converts full-width to half-width ASCII and katakana characters. Returns a text string.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id9912411				0	gl	See \<link href=\"https://wiki.openoffice.org/wiki/Calc/Features/JIS_and_ASC_functions\"\>JIS and ASC Spreadsheet Functions\</link\> for a conversion table.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id9204992				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id1993774				0	gl	ASC("Text")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id2949919				0	gl	            \<emph\>Text\</emph\> is the text that contains characters to be converted.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id2355113				0	gl	See also JIS function.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id9323709				0	gl	\<bookmark_value\>BAHTTEXT function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id6695455				0	gl	TEXTOBAHT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id354014				0	gl	Converts a number to Thai text, including the Thai currency names.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id9942014				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id8780785				0	gl	BAHTTEXT(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id1539353				0	gl	            \<emph\>Number\</emph\> is any number. "Baht" is appended to the integral part of the number, and "Satang" is appended to the decimal part of the number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id9694814				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3289284				0	gl	            \<item type=\"input\"\>=BAHTTEXT(12.65)\</item\> returns a string in Thai characters with the meaning of "Twelve Baht and sixty five Satang".				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3153072				0	gl	\<bookmark_value\>BASE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153072				0	gl	BASE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153289				0	gl	\<ahelp hid=\"HID_FUNC_BASIS\"\>Converts a positive integer to a specified base into a text from the \<link href=\"text/shared/00/00000005.xhp#zahlensystem\" name=\"numbering system\"\>numbering system\</link\>.\</ahelp\> The digits 0-9 and the letters A-Z are used.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146097				0	gl	Sintaxe				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155743				0	gl	BASE(Number; Radix; [MinimumLength])				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151339	217			0	gl	            \<emph\>Number\</emph\> is the positive integer to be converted.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3159262	218			0	gl	            \<emph\>Radix\</emph\> indicates the base of the number system. It may be any positive integer between 2 and 36.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148746	219			0	gl	            \<emph\>MinimumLength\</emph\> (optional) determines the minimum length of the character sequence that has been created. If the text is shorter than the indicated minimum length, zeros are added to the left of the string.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146323				0	gl	Exemplo				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3156399				0	gl	\<bookmark_value\>decimal system; converting to\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156399	221			0	gl	            \<item type=\"input\"\>=BASE(17;10;4)\</item\> returns 0017 in the decimal system.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3157871				0	gl	\<bookmark_value\>binary system; converting to\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3157871	222			0	gl	            \<item type=\"input\"\>=BASE(17;2)\</item\> returns 10001 in the binary system.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3145226				0	gl	\<bookmark_value\>hexadecimal system; converting to\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145226	223			0	gl	            \<item type=\"input\"\>=BASE(255;16;4)\</item\> returns 00FF in the hexadecimal system.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149321				0	gl	\<bookmark_value\>CHAR function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149321				0	gl	CARACT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149150				0	gl	\<ahelp hid=\"HID_FUNC_ZEICHEN\"\>Converts a number into a character according to the current code table.\</ahelp\> The number can be a two-digit or three-digit integer number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149945				0	gl	Sintaxe				20200411 15:09:53
