helpcontent2	source\text\swriter\01\04120300.xhp	0	help	hd_id3149105	9			0	tr	Ekle				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	par_id3147100	10			0	tr	\<ahelp hid=\"HID_INSERT_AUTH_MRK_OK\"\>Inserts the bibliographic reference into the document. If you created a new record, you must also insert it as an entry, otherwise the record is lost when you close the document.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\04120300.xhp	0	help	hd_id3147216	11			0	tr	Kapat				20130618 17:22:18
