helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3148645	13			0	tr	Dim sDate as String				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3155855	14			0	tr	Dim sToday as String				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3154490	16			0	tr	sDate = InputBox("Enter the expiration date (MM.DD.YYYY)")				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3154943	17			0	tr	sDate = Right$(sDate, 4) + Mid$(sDate, 4, 2) + Left$(sDate, 2)				20130618 17:22:18
