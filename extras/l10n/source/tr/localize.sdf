helpcontent2	source\text\shared\02\12100200.xhp	0	help	par_id3150298	40			0	tr	Meaning				20130618 17:22:18
helpcontent2	source\text\shared\02\12100200.xhp	0	help	par_id3153919	41			0	tr	Örnek				20130618 17:22:18
helpcontent2	source\text\shared\02\12100200.xhp	0	help	par_id3158411	42			0	tr	silinsin mi?				20130618 17:22:18
