helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	par_id3154367	18			0	tr	sText = InputBox ("Please enter a phrase:","Dear User")				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	par_id3151042	19			0	tr	MsgBox ( sText , 64, "Onaylama tümcesi ")				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03010201.xhp	0	help	par_id3150768	20			0	tr	End Sub				20130618 17:22:18
