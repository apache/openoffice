helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3148863				0	et	<SDFIELD TYPE=DOCINFO SUBTYPE=COMMENT SDFIXED>Kirjeldus</SDFIELD>				20200411 15:09:53
