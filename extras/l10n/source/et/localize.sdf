helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147505	7			0	et	            \<emph\>Row\</emph\> represents the row number for the cell reference				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3145323	8			0	et	            \<emph\>Column\</emph\> represents the column number for the cell reference (the number, not the letter)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153074	9			0	et	            \<emph\>Abs\</emph\> determines the type of reference:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153298				0	et	1: absoluutne ($A$1)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150431				0	et	2: rida absoluutne, veerg suhteline (A$1)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3146096				0	et	3: rida suhteline; veerg absoluutne ($A1)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153334				0	et	4: suhteline (A1)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802465915				0	et	            \<emph\>A1\</emph\> (optional) - if set to 0, the R1C1 notation is used. If this parameter is absent or set to another value than 0, the A1 notation is used.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153962	14			0	et	            \<emph\>Sheet\</emph\> represents the name of the sheet. It must be placed in double quotes.				20200411 15:09:53
