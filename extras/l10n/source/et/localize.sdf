helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3155601				0	et	MsgBox "Aegumiskuupäev on möödas"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3146972				0	et	ElseIf sDate > sToday Then				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3146912				0	et	MsgBox "Aegumiskuupäev pole veel möödas"				20200411 15:09:53
