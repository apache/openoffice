helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3147399				0	et	Standardne HTML				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3147088				0	et	\<ahelp hid=\"SD:RADIOBUTTON:DLG_PUBLISHING:PAGE2_STANDARD\"\>Creates standard HTML pages from export pages.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3145071				0	et	Standardne HTML (paneelidega)				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3154824				0	et	\<ahelp hid=\"SD:RADIOBUTTON:DLG_PUBLISHING:PAGE2_FRAMES\"\>Creates standard HTML pages with frames. The exported page will be placed in the main frame, and the frame to the left will display a table of contents in the form of hyperlinks.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3149398				0	et	Loo tiitelleht				20200411 15:09:53
