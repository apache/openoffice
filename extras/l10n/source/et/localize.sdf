helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3154754				0	et	MsgBox "Aegumiskuupäev on täna"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3154361				0	et	End If				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3148405				0	et	End Sub				20200411 15:09:53
