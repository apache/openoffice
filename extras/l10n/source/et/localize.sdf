helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3155855				0	et	Dim sToday as String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3154490				0	et	sDate = InputBox("Sisesta aegumiskuupäev (MM.DD.YYYY)")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3154943				0	et	sDate = Right$(sDate, 4) + Mid$(sDate, 4, 2) + Left$(sDate, 2)				20200411 15:09:53
