helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3150244				0	et	\<ahelp hid=\".\" visibility=\"hidden\"\>Prints only the selected area(s) or object(s) in the current document.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3146848				0	et	\<ahelp hid=\".\" visibility=\"hidden\"\>To print a range of pages, use a format like 3-6. To print single pages, use a format like 7;9;11. You can print a combination of page ranges and single pages, by using a format like 3-6;8;10;12.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3150772				0	et	\<ahelp hid=\".\" visibility=\"hidden\"\>Prints to a file instead of to a printer.\</ahelp\>				20200411 15:09:53
