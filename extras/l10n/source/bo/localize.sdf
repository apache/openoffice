helpcontent2	source\text\shared\autopi\01050200.xhp	0	help	par_id3155338	26			0	bo	\<ahelp hid=\"SD:LISTBOX:DLG_ASS:LB_PAGE2_LAYOUT\" visibility=\"visible\"\>ཁྱེད་ཀྱི་སྣེ་སྟོན་ཤོག་ཨང་ 1 སྟེང་དུ་བདམས་པའི་གསལ་སྟོན་ཡིག་ཟིན་ལ་སྒྲོན་བཪྙན་སྤྱིན་ཤོག་གི་ཇུས་འགོད་ཞིག་འདེམས་པ་བྱས་ཆོག \</ahelp\>སྟེང་ཆོག་ཀྱི་རེའུ་འགོད་སྒྲོམ་ནང་ སྒྲོན་བཪྙན་སྤྱིན་ཤོག་ཇུས་འགོད་རིགས་3 བདམས་ག་བྱེད་རྒྱུ་མཁོ་འདོན་བྱས་ཡོད།(སློབ་གསོ་ གསལ་སྟོན་ཡིག་ཟིན་རྒྱབ་ལྗོངས་ གསལ་སྟོན་ཡིག་ཟིན་)གཤམ་ཆོག་ཀྱི་རེའུ་འགོད་སྒྲོམ་ནང་ ཁྱེད་ཀྱི་གསལ་སྟོན་ཡིག་ཟིན་ལ་མ་པང་ཞིག་འདེམས་ཆོག				2002-02-02 02:02:02
