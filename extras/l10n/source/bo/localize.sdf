helpcontent2	source\text\shared\00\00000005.xhp	0	help	par_id3159239				0	bo	SQL གཞི་གྲངས་མཛོད་ནི་ \<link href=\"text/shared/00/00000005.xhp#sql\"\>SQL\</link\> ཡི་མཐུད་ཁ་མཁོ་འདོན་བྱེད་མཁན་གྱི་གཞི་གྲངས་མཛོད་མ་ལག་ཡིན་ SQL གཞི་གྲངས་མཛོད་ནི་རྟག་ཏུ་མཁོ་མཁན་སྣེ་/ཞབས་ཆས་གྱི་དྲ་རྒྱ་ལ་སྤྱོད་པ་ཡིན་ རིགས་འདི་རིགས་ཀྱི་དྲ་རྒྱའི་ནང་མཁོ་མཁན་སྣེ་མི་འདྲ་བ་ཡིས་དབུས་ཀྱིསཞབས་ཆས་ལ་བཅར་འདྲི་བྱེད་(དཔེར་ན་ SQL ཞབས་ཆས་) དེར་བརྟེན་གཞི་གྲངས་མཛོད་ལ་ SQL ཞབས་ཆས་གཞི་གྲངས་མཛོད་ཅེས་བརྗོད་བསྡུས་མིང་ལ་ SQL ཞབས་ཆས་ཞེས་བརྗོད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000005.xhp	0	help	par_id3159118				0	bo	$[officename] ནང་ཕྱི་ཁུལ་ SQL གཞི་གྲངས་མཛོད་ཕྱོགས་བསྡུས་བྱས་ཆོག་ གཞི་གྲངས་མཛོད་ནི་ཕལ་ཆེར་ཁྱེད་ཀྱི་རང་སའི་མཁྲེགས་ཆས་དང་དྲ་རྒྱའི་ཐོག་གནས་ཡོད་  བཅར་འདྲི་བྱེད་སྟངས་ནི་ \<link href=\"text/shared/00/00000005.xhp#odbc\"\>ODBC\</link\>འམ་ཕྱོགས་བསྡུས་བྱས་ནས་ $[officename] ནང་གི་རྩེས་འཁོར་འདིའི་སྒུལ་འདེད་བྱ་རིམ་ནས་མངོན་དུ་གྱུར་དགོས།				2002-02-02 02:02:02
