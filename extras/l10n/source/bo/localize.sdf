helpcontent2	source\text\shared\01\06010000.xhp	0	help	par_id3154682				0	bo	\<variable id=\"recht\"\>\<ahelp hid=\".uno:Spelling\"\>མིག་སྔའི་ཡིག་ཚགས་ཡང་ན་བདམས་པའི་ཡི་གེའི་ནང་གི་འབྲི་སྦྱོར་གྱི་ནོར་འཁྲུལ་ལག་བཟོའི་བརྟག་དཔྱད་བྱེད།\</ahelp\>$[officename] འབྲི་སྤྱོརབརྟག་དཔྱད་ཀྱི་ཁྱབ་ཁོངས་ལ་ཤོག་སྨིན་དང་ཤོག་ཞབས་ བཤེར་འདྲེན་བཤར་བྱང་ ཞབས་མཆན་བཅས་ཚུད་ཡོད།\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06010000.xhp	0	help	par_idN1064B				0	bo	མིག་སྔའི་འོད་རྟགས་གནས་པའི་གནས་ས་འགོ་འཛུགས་ཏེ་ འབྲི་སྦྱོར་བརྟག་དཔྱད་བྱེད་ ཡིག་ཚགས་བར་ཡང་ན་ཡི་གེའི་མཇུག་གི་གནས་ས་འདེམས། དེ་རྗེས་ཡིག་ཚགས་ཀྱི་འགོ་འཛུགས་གནས་ས་མུ་མཐུད་འབྲི་སྦྱོར་བརྟག་དཔྱད་བྱེད་མིན་འདེམས་ཆོག				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06010000.xhp	0	help	par_id3166445				0	bo	འབྲི་སྦྱོར་ནོར་བའི་ཡི་གེ་བཙལ་འཚོལ་ལ་འབྲི་སྦྱོར་བརྟག་དཔྱད་བྱེད་པ་མ་ཟད་ ཁྱེད་ཀྱིས་མ་ཤེས་པའི་མིང་ཚིག་སྤྱོད་པའི་ཚིག་མཛོད་ནང་སྣོན་བཅུག་བྱེད་མིན་འདེམས་དགོས། ཨང་དང་པོ་འབྲི་སྦྱོར་ནོར་བའི་ཡི་གེ་བརྟག་དཔྱད་ཐུབ་སྐབས་\<emph\>"འབྲི་སྦྱོར་བརྟག་དཔྱད་"\</emph\>གླེང་སྒྲོམ་ཁ་ཕྱེ།				2002-02-02 02:02:02
