helpcontent2	source\text\swriter\01\04090006.xhp	0	help	par_id3152776	9			0	bo	\<emph\>"གཞི་གྲངས་མཛོད་འདེམས་གཞི་"\</emph\>སྒྲོམ་ནང་འདེམས་པའི་གཞི་གྲངས་མཛོད་རེའུ་མིག་གྱི་མིང་བསྒརའཛུད་བྱེད།"གཞི་གྲངས་མཛོད་མིང་"ཁོངས་ཀྱི་ཀུན་ཡོངས་ཀྱི་ཁོངས་ཀྱི་ཡིན་ གསལ་ཡོལ་བཤད་ན་ གལ་སྲིད་ཡིག་ཚགས་ནང་དེ་མིན་གྱི་གཞི་གྲངས་མཛོད་མིང་བསྒར་འཛུད་བྱས་ན་ཐོག་མར་བསྒར་འཛུད་བྱས་པའི་"གཞི་གྲངས་མཛོད་མིང་"གི་ཁོངས་ཀྱི་ནང་དོན་ཡོད་ཚད་གསར་བཅོས་བྱེད་ཐབ་རེད།				2002-02-02 02:02:02
