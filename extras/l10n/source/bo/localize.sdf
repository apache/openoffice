helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3145271				0	bo	\<variable id=\"funktionsautopilottext\"\>\<ahelp hid=\".uno:FunctionDialog\"\>་\<emph\>"རྟེན་གྲངས་སྣེ་སྟོན་"ཁ་ཕྱེས་\</emph\> ཕྱོགས་སྟོན་འདིས་ཁྱེད་ལ་ཕན་ཚུན་བྱེད་ཚུལ་གྱི་སྤྱི་འགྲོས་གསར་འཛུགས་རོགས་རམ་བྱེད།\</ahelp\>\</variable\>ཕྱོགས་སྟོན་འདི་སྒུལ་སློང་མ་བྱེད་གོང་སྔོན་ལ་མིག་སྔའི་ལས་ཁྲའི་ནང་དྲ་མིག་གཅིག་གམ་ཡང་ན་ཁྱབ་ཁོངས་ངེས་ཡོད་པའི་དྲ་མིག་འདེམས་ བསྒར་འཛུད་སྤྱི་འགྲོས་ཀྱིས་གནས་ས་གཏན་འཁེལ་བྱེད།				2002-02-02 02:02:02
