helpcontent2	source\text\swriter\01\04020100.xhp	0	help	par_id3154343				0	bo	\<ahelp hid=\"SW:EDIT:MD_EDIT_REGION:ED_CONDITION\"\>ནང་བཅུག་ཀྱི་ཆ་རྐྱེན་ངེས་པར་དུ་གབ་པའི་ས་ཁོངས་ཀྱི་རེ་བ་སྐོར་ཐུབ།\</ahelp\>ཆ་རྐྱེན་ནི་\<link href=\"text/swriter/01/04090200.xhp\" name=\"གཏན་ཚིག་མཚོན་ཚུལ་\"\>གཏན་ཚིག་མཚོན་ཚུལ་\</link\>ཞིག་ཡིན་  དཔེར་ན་"SALUTATION EQ Mr."ལྟ་བུ།དཔེར་ན་  གལ་ཏེ་\<link href=\"text/swriter/guide/form_letters_main.xhp\" name=\"རྣམ་གཞག་འཕྲིན་ཡིག་\"\>རྣམ་གཞག་འཕྲིན་ཡིག་\</link\>བྱེད་ནུས་ཀྱི་མཚན་འཇོག་མིང་ནི་"འབོད་མིང་"གྱི་གཞི་གྲངས་མཛོད་ཡིག་དུམ་(ཡིག་དུ་དེར་"Mr."、"Ms."、"Sir"ཡང་"Madam")ཚུད་ཡོད་  བེད་སྤྱོད་དང་ཁྱེད་ཀྱི་མིང་འབོད་"Mr."ཁོ་ན་གཏན་འཁེངས་བྱེད་པའི་སྐབས་གཞིགས་ནས་ས་ཁོངས་གཏག་པར་རྒྱབ་ཆོག				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04020100.xhp	0	help	par_id3150086				0	bo	དཔེ་མཚོན་གཞན་ཞིག་ནི་ཡིག་དུམ་འགྱུར་ཚད་"x"གསར་འཛུགས་མ་ཟད་དེ་ལ་ཐང་ 1གཏན་འཁེལ་བྱེད་པ་དང་  དེ་ནས་འགྱུར་ཚད་གཞིགས་ཏེ་ས་ཁོངས་ཀྱི་གབ་པའི་ཆ་རྐྱེན་གཏན་འཁེལ་བྱེད་  དཔེར་ན་:"x eq 1"ལྟ་བུ།གལ་ཏེ་ས་ཁོངས་དེ་མངོན་དགོས་ན་  འགྱུར་ཚད་"x"ཐང་"0"བཀོད་སྒྲིག་བྱེད།				2002-02-02 02:02:02
