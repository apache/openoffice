helpcontent2	source\text\shared\02\01140000.xhp	0	help	par_id3147214				0	bo	\<ahelp hid=\".uno:Polygon_Unfilled\"\>དྲང་ཐིག་དུམ་ལས་གྲུབ་པའི་ཐིག་སྐུད་ཚོ་གཅིག་བྲིས་འགོད་བྱས།  བྲིས་འགོད་མཚན་ཉིད་ཡིག་དུམ་གྱིས་ཐ་ཚིག་རྐྱང་རྡེབ་བྱེད་ དེ་རྗེས་བསྐྱར་དུ་ཐིག་དུམ་གསར་པ་བྲིས་འགོད་བྱེད།  ལེགས་སྒྲུབ་བྱུང་བའི་ཐིག་སྐུད་ཀྱི་བྲིས་འགོད་ཆ་རྡེབ་བྱེད།  ཁ་སྐུམ་པའི་བཟོ་དབྱིབས་འཛུགས་  ཐིག་སྐུད་གྱི་འགོ་འཛུགས་ལ་ཆ་རྡེབ་བྱེད།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01140000.xhp	0	help	par_id3154638				0	bo	མཐའ་མང་དབྱིབས་གང་རུང་བྲིས་འགོད་སྐབས་Shift མཐེབ་གནོན་འཛིན་བྱེད་  ཏུའུ་45 ཟུར་གྱི་ཁ་ཕྱོགས་ཐོག་མཐུད་ཚེག་གནས་ངེས་བྱེད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01140000.xhp	0	help	par_id3154319				0	bo	གལ་སྲིད་མ་ཚུལ་སྤྱད་ན་\<link href=\"text/shared/01/05270000.xhp\" name=\"མཐུད་ཚེག་རྩོམ་སྒྲིག\"\>མཐུད་ཚེག་རྩོམ་སྒྲིག\</link\>  ཐབས་ཚུལ་སྤྱད་དེ་ཁག་སོ་སོར་མཐའ་མང་དབྱིབས་ཀྱི་མཐུད་ཚེག་གང་རུང་བཟོ་བཅོས་བྱེད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01140000.xhp	0	help	hd_id3153279				0	bo	འཕྱོག་ཐིག				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01140000.xhp	0	help	par_id3153876				0	bo	\<image id=\"img_id3149379\" src=\"res/commandimagelist/sc_bezier_unfilled.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3149379\"\>རིས་རྟགས།\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01140000.xhp	0	help	par_id3148878	57			0	bo	\<variable id=\"kurvetext\"\>\<ahelp hid=\".uno:Bezier_Unfilled\"\>སྙོམས་འདྲེད་འཕྱོག་ཐིག་བྲིས་འགོད་བྱེད།  འདེམས་ངེས་ཀྱི་འཕྱོག་ཐིག་འགོ་འཛུགས་གནས་ས་རྐྱང་རྡེབ་དྲུད་སྒུལ་  གློད་པ་  དེ་རྗེས་ཙིག་རྟགས་སྟོན་མདའ་འདེམས་ངེས་ཀྱི་འཕྱོག་ཐིག་མཐའ་ཚིག་གནས་ས་སྤོ་བ་མ་ཟད་རྐྱང་རྡེབ་བྱེད།  ཙིག་རྟགས་སྟོན་མདའ་སྤོ་འགུལ་བྱས་པ་མ་ཟད་བསྐྱར་དུ་རྐྱང་རྡེབ་བྱས་ཏེ་ཐིག་སྐུད་འཕྱོག་ཐིག་ནང་སྣོན་བཅུག་བྱེད།  ཆ་རྡེབ་བྱས་ཏེ་འཕྱོག་ཐིག་གི་བྲིས་འགོད་ལེགས་གྲུབ་བྱེད།  ཁ་ཟུམ་གྱི་གནས་སྟངས་འཛུགས་  འཕྱོག་ཐིག་གྱི་འགོ་འཛུགས་ལ་ཆ་རྡེབ་བྱེད།\</ahelp\>འཕྱོག་ཐིག་གི་གཞུ་དབྱིབས་ནི་དྲུད་སྒུལ་གྱི་བར་ཆོད་ལ་རག་ལས་ཡོད།\</variable\>				2002-02-02 02:02:02
