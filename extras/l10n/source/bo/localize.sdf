helpcontent2	source\text\scalc\guide\consolidate.xhp	0	help	par_id3157983				0	bo	\<emph\>འདྲ་ཕབ་འབྲས་བུ་སླེབས་པ་\</emph\>སྒྲོམ་ནང་ནས་དམིགས་འབེན་ས་ཁོངས་འདེམས་ནས་འབྲས་བུ་མངོན་པར་སྤྱོད་པའི་ས་ཁོངས་གཏན་འཁེལ་བྱེད།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\guide\consolidate.xhp	0	help	par_id3150215				0	bo	གལ་ཏེ་དམིགས་འབེན་ས་ཆར་མིང་མེད་ན་\<emph\>འདྲ་ཕབ་འབྲས་བུ་སླེབས་\</emph\>འགྲམ་གྱི་ཡིག་དུམ་རྐྱང་རྡེབ་བྱས་ཆོག་  དེ་རྗེས་དམིགས་འབེན་ས་ཁོངས་ཀྱི་འདྲེན་སྤྱོད་ནང་འཇུག་བྱ་ཐུབ།  ཡང་ན་ཙིག་རྟགས་བརྒྱུད་པའམ་འོད་རྟགས་དེ་དམིགས་འབེན་ས་ཁོངས་ཀྱི་གཡོན་སྟེང་ཟུར་གྱི་དྲ་མིག་སར་འཇོག་པར་བརྒྱུད་ནས་དམིགས་འབེན་ས་ཁོངས་འདེམས་པའོ།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\guide\consolidate.xhp	0	help	par_id3153813				0	bo	\<emph\>རྟེན་གྲངས།\</emph\>སྒྲོམ་ནང་ནས་རྟེན་གྲངས་ཤིག་འདེམས་པ།  ཟླ་སྒྲིལ་རྩིས་རྒྱག་ས་ཁོངས་ཀྱི་གྲངས་ཐང་དེ་རྟེན་གྲངས་དེ་གཞིར་བཟུང་ནས་རྩིས་རྒྱག་བྱེད།   ཁས་ལེན་བཀོད་སྒྲིག་ནི་"སྤྱི་སྡོམས།"རྟེན་གྲངས་ཡིན།				2002-02-02 02:02:02
