helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3148700				0	bo	\<emph\>[བདེ་འཇགས།] - [ནང་དོན་སྲུང་སྐྱོབ།]\</emph\>ཚལ་ཐོའི་ནང་གི་འདེམས་གཞི་གཉིས་དང་གསང་ཨང་ཕན་ཚུན་ཟུང་འབྲེལ་གྱིས་ཁྱེད་ཀྱི་ལས་ཀར་ཁྱོན་ཡོངས་ནས་སྲུང་སྐྱོབ་བྱ་ཐུབ།  མི་གཞན་དག་གིས་ཁྱེད་ཀྱི་ཡིག་ཚགས་ཁ་འབྱེད་པ་བཀག་འགོག་བྱ་དགོས་ན་\<emph\>"ཉར་ཚགས།"\</emph\>གླེང་སྒྲོམ་ནང་དུ་\<emph\>"གསང་ཨང་ཉར་སྡེར་བེད་སྤྱོད།"\</emph\>བསྐྱར་འདེམས་སྒྲོམ་བདམས་པ་དང་དེ་རྗེས་ཡང་བསྐྱར་\<emph\>"ཉར་ཚགས།"\</emph\>གནོན་མཐེབ་ལ་རྐྱང་རྡེབ་བྱ།				2002-02-02 02:02:02
