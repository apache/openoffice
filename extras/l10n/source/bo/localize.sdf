helpcontent2	source\text\sbasic\shared\02\11070000.xhp	0	help	par_id3149346				0	bo	བར་གཅོད་ཚེག་འོད་རྟགས་གནས་སར་མངོན། བར་གཅོད་ཚེག་བེད་སྤྱད་ན་ནོར་འཁྲུལ་མ་བྱུང་སྔོན་བྱ་རིམ་མཚམས་ཆད། དེ་རྗེས་\<link href=\"text/sbasic/shared/02/11050000.xhp\" name=\"རིམ་འདེད་བརྗོད་པ་\"\>རིམ་འདེད་བརྗོད་པ་\</link\>མ་ཚུལ་འོག་བྱ་རིམ་ལག་བསྟར་བྱེད་ཆོག་ ནོར་འཁྲུལ་མ་ལྷག་བར་ལག་བསྟར་བྱེད་ བྱ་རིམ་ནང་གི་གནད་དོན་གཏན་འཁེལ་བྱེད་པར་སྟབས་བདེ་སྐྲུན། \<link href=\"text/sbasic/shared/02/11080000.xhp\" name=\"མངོན་པ་/ལྟ་རྟོག་གབ་སྦས་\"\>"མངོན་པ་/ལྟ་རྟོག་གབ་སྦས"\</link\>རིས་རྟགས་ཀྱིས་འབྲེལ་ཡོད་འགྱུར་ཚད་ནང་དོན་བརྟག་དཔྱད་ཡང་སྤྱད་ཆོག				2002-02-02 02:02:02
