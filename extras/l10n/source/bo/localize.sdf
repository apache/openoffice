helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3149819	10			0	bo	\<ahelp hid=\"HID_PROP_NAME\" visibility=\"hidden\"\>\<emph\>གཏོགས་གཤིས།\</emph\>འདེམས་གཞི་ཁཱ་ཤོག་ངོས་ཐོག་  ཚོད་འཛིན་ཡིག་དུམ་གྱི་མིང་གཏན་འཁེལ་བྱེད།\<emph\>རེའུ་བྱང་གཏོགས་གཤིས།\</emph\>འདེམས་གཞི་ཁཱ་ཤོག་ངོས་ཐོག་ རེའུ་བྱང་གྱི་མིང་གཏན་འཁེལ་བྱེད།\</ahelp\>ཚོད་འཛིན་ཡིག་དུམ་ཡོད་ཚད་དང་རེའུ་བྱང་ཚང་མ་མཚོན་པ་རང་གི་\<emph\>མིང་།\</emph\>གཏོགས་གཤིས་སྤྱོད།  མིང་ནི་\<link href=\"text/shared/02/01170600.xhp\" name=\"རེའུ་བྱང་ལག་རོགས།\"\>རེའུ་བྱང་ལག་རོགས།\</link\>ནང་མངོན་  མིང་གཡར་ཏེ་ཧུང་ནང་ཚོད་འཛིན་ཡིག་དུམ་འདྲེན་སྤྱོད་བྱེད།				2002-02-02 02:02:02
