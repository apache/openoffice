helpcontent2	source\text\swriter\01\02110100.xhp	0	help	par_id3149844				0	bo	\<ahelp hid=\"HID_SCRL_NAVI\"\>གལ་ཏེ་"ལག་རོགས་"སམ་ཡང་ན་ཡིག་ཚགས་སྒེའུ་ཁུང་གི་གཡས་འོག་ཟུར་གྱི་རིས་རྟགས་ལ་རྐྱང་རྡེབ་བྱེད་ ཡོ་བྱད་ཚང་ཞིག་ཐོན་སྲིད་པའི་ཁྱེད་ཀྱི་དེ་བེད་སྤྱད་ནས་ ཡིག་ཚགས་ནང་གི་ད་ཡོད་དམིགས་འབེན་འདེམས་ཆོག་ལ།\</ahelp\> དེ་ཁྲོས་གོང་འོག་མདའ་རྩེའི་ རིས་རྟགས་རྒྱུད་  ཡི་གེ་འོ་རྟགས་དེ་ཡིག་ཚགས་ཀྱི་དམིགས་འབེན་གོང་མ་འམ་དམེགས་འབེན་འོག་མར་གནས།				2002-02-02 02:02:02
