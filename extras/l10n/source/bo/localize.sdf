helpcontent2	source\text\shared\guide\protection.xhp	0	help	par_id3150775				0	bo	\<link href=\"text/shared/00/00000021.xhp\" name=\"XML རྣམ་གཞག་\"\>XML རྣམ་གཞག་\</link\>ཉར་ཚགས་བྱེད་པའི་ཡིག་ཚགས་ཡོད་ཚད་ཆ་སྙོམས་ཀྱིས་གསང་ཨང་ལྡན་ཡོད།  གསང་ཨང་ཡོད་པའི་ཡིག་ཚགས་ཁ་ཕྱེས་  ངེས་པར་དུ་ཡང་དག་གསང་ཨང་མཁོ་འདོན་བྱེད།  ཡིག་ཚགས་ནང་དོན་སྲུང་སྐྱོབ་ཟིན་པའི་ དེར་བརྟེན་ཕྱི་ངོས་ཀྱི་རྩོམ་སྒྲིག་ཆས་ཀློག་ལེན་བེད་སྤྱོད་བྱ་ཐབས་བྲལ།  ལས་སྣོན་འདི་དག་ནང་དོན་རིས་དབྱིབས་དང་ OLE བྱ་ཡུལ་སྤྱོད་བདེ་བྱེད།				2002-02-02 02:02:02
