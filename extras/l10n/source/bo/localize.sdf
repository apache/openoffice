helpcontent2	source\text\sbasic\guide\control_properties.xhp	0	help	hd_id3145786				0	bo	\<variable id=\"control_properties\"\>\<link href=\"text/sbasic/guide/control_properties.xhp\" name=\"གླེང་སྒྲོམ་རྩོམ་སྒྲིག་ཆས་ནང་ཚོད་འཛིན་ཆས་ཀྱི་གཏོགས་གཤིས་བཟི་བཅོས་བྱས་\"\>གླེང་སྒྲོམ་རྩོམ་སྒྲིག་ཆས་ནང་ཚོད་འཛིན་ཆས་ཀྱི་གཏོགས་གཤིས་\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\guide\control_properties.xhp	0	help	par_id3147317				0	bo	ཁྱེད་ཀྱིས་གླེང་སྒྲོམ་ནང་སྣོན་འཇུག་བྱ་བའི་ཚོད་འཛིན་ཆས་ཀྱི་གཏོགས་གཤིས་བཟོ་བཅོས་བཀོད་སྒྲིག་བྱས་ཆོག དཔེར་ན་ གླེང་སྒྲོམ་ནང་སྣོན་འཇུག་བྱས་པའི་གནོན་མཐེབ་ཀྱི་ཚོས་གཞི་དང་ མིང་ ཆེ་ཆུང་བཟོ་བཅོས་བྱས་ཆོག གླེང་སྒྲོམ་འཛུགས་པའམ་རྩོམ་སྒྲིག་བྱ་སྐབས་ཚོད་འཛིན་ཆས་ཀྱི་གཏོགས་གཤིས་མང་ཆེ་བ་བ་བཟོ་བཅོས་བྱས་ཆོག་ འོན་ཏེ་ཁོར་རྒྱུག་སྐབས་ཚོད་འཛིན་ཆས་ཀྱི་གཏོགས་གཤིས་ཁོ་ན་བཟོ་བཅོས་བྱ།				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\guide\control_properties.xhp	0	help	par_id3145749				0	bo	འཆར་འགོད་མ་ཚུལ་འོག་ཚོད་འཛིན་ཆས་ཤིག་གི་གཏོགས་གཤིས་བཟོ་བཅོས་བྱ་དགོས་ན་ ཚོད་འཛིན་ཆས་དེའི་སྟེང་ཚིག་རྟགས་གཡས་མཐེབ་ལ་རྐྱང་རྡེབ་བྱ་དགོས་  དེ་རྗེས་\<emph\>གཏོགས་གཤིས་\</emph\>འདེམས་དགོས།				2002-02-02 02:02:02
