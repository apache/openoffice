helpcontent2	source\text\shared\02\14030000.xhp	0	help	par_id3155364				0	bo	\<ahelp hid=\".uno:SbaNativeSql\"\>རང་སའི་SQL མ་ཚུལ་འོག་ SQL བཀའ་ཚིག་ནང་འཇུག་བྱེད་ བཀའ་ཚིག་ $[officename] ཡི་འགྲེལ་བཤད་བརྒྱུད་མི་དགོས་པར་ཐད་ཀར་གཞི་གྲངས་མཛོད་ནང་བརྒྱུད་གཏོང་བྱེད་\</ahelp\>གལ་སྲིད་ཇུས་འགོད་ཐད་མཐོང་དཔེ་རིས་ནང་བཟོ་བཅོས་འདི་དག་མངོན་མེད་ན་ཡང་བསྐྱར་ཇུས་འགོད་ཐད་མཐོང་དཔེ་རིས་ལ་བཅོས་སུ་མེད། 				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\14030000.xhp	0	help	par_id3149999				0	bo	རང་སའི་ SQLནས་བརྗོད་ན་SQL ཡི་གེའི་ཕྲེང་བ་ཐད་ཀར་འབྲེལ་མཐུད་བྱས་པའི་གཞི་གྲངས་མཛོད་ཀྱི་མ་ལག་ལ་བསྒྱུར་བ་ལས་ $[officename] ནས་སྔོན་ལ་དཔྱད་དཔོག་བྱ་མི་དགོས།  དཔེར་ན་ ODBC མཐུད་ཁ་བརྒྱུད་གཞི་གྲངས་མཛོད་གཅིག་ལ་མཚམས་འདྲི་བྱེད་པ་དང་SQL ཡི་གེའི་ཕྲེང་བ་ཉིད་ ODBC སྒུལ་འདེད་བྱ་རིམ་ལ་བསྒྱུར་བ་དང་སྦྲགས་དེས་ལས་སྣོན་བྱེད།				2002-02-02 02:02:02
