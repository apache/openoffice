helpcontent2	source\text\shared\explorer\database\05020000.xhp	0	help	par_id3155430				0	bo	འབྲེལ་བའི་ཡིག་དུམ་ནང་ད་ཡོད་ཀྱི་འབྲེལ་བ་ཡོད་ཚད་ཐིག་སྐུད་ཀྱི་མཚོན་ འགག་གནད་ཡིག་དུམ་ཡི་གེ་དང་་གཞན་པའི་ཡིག་དུམ་ཡི་གེ་ཐིག་སྐུད་འདི་བརྒྱུད་ཕན་ཚུན་སྦྲེལ།  རེའུ་མིག་ནང་གི་ཡིག་དུམ་རེའུ་མིག་གཞན་པའི་ཡིག་དུམ་ནང་དུ་འདྲུད་འཇོག་བྱེད་པ་དང་འབྲེལ་བ་འཕར་སྣོན་བྱ་ཆོག།  འབྲེལ་བ་འདེམས་པ་མ་ཟད་ Delete མཐེབ་གནོན་ན་བསྐྱར་དུ་གསར་འཛུགས་ཀྱི་འབྲེལ་བ་སུབ་པ་བྱེད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\05020000.xhp	0	help	par_id3149984				0	bo	ཡང་རྐྱང་རྡེབ་བྱས་པ་བརྒྱུད་ཡིག་དུམ་འབྲེལ་བའི་ས་ཁོངས་ནང་གི་\<emph\>འབྲེལ་བ་གསར་འཛུགས་\</emph\>རིས་རྟགས་ལ་རྐྱང་རྡེབ་བྱེད་ \<link href=\"text/shared/explorer/database/05020100.xhp\" name=\"འབྲེལ་བ་\"\>\<emph\>འབྲེལ་བ་\</emph\>\</link\> གླེང་སྒྲོམ་ནང་རེའུ་མིག་གཉིས་བར་གྱི་འབྲེལ་བ་མཚན་འཇོག་བྱེད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\05020000.xhp	0	help	par_id3153093				0	bo	གལ་ཏེ་ $[officename] འབྲེལ་བའི་གཞི་གྲངས་མཛོད་ཀྱི་མདུན་སྣེ་ཡིན་ན་ འབྲེལ་བའི་གསར་འཛུགས་དང་སུབ་པ་ $[officename] ཡིས་གནས་སྐབས་ཉར་ཚགས་བྱེད་པ་ལས་ ཕྱི་ཁུལ་གྱི་གཞི་གྲངས་མཛོད་ཐད་ཀར་གོང་འབུལ་མི་བྱེད།				2002-02-02 02:02:02
