helpcontent2	source\text\shared\01\02220000.xhp	0	help	par_id3153190				0	bo	\<ahelp hid=\"HID_IMAPDLG_POLY\"\>རིས་དབྱིབས་ནང་མཐའ་མང་དབྱིབས་ཀྱི་ཚ་གནས་གཅིག་འགོད་བྲིས་བྱེད་ རིས་རྟགས་དེར་རྐྱང་རྡེབ་བྱས་པ་དང་རིས་དབྱིབས་ནང་དྲུད་སྒུལ་བྱ་ དེ་རྗེས་རྐྱང་རྡེབ་ཀྱིས་མཐའ་མང་དབྱིབས་ཀྱི་མཐའ་ཞིག་མཚོན་ གཤམ་གྱི་མཐའ་ཞིག་གི་རྩེ་ཚེག་སར་སྤོ་བ་དང་དེ་རྗེས་ཙིག་རྟགས་ལ་རྐྱང་རྡེབ་བྱ་ བཀོལ་སྤྱོད་འདི་བསྐྱར་ཟློས་བྱས་པ་དང་མཐའ་མང་དབྱིབས་ཀྱི་མཐའ་ཡོད་ཚད་འགོད་བྲིས་མ་ཚར་བར་དེ་ལྟར་བྱ་ འགོད་བྲིས་ཚར་རྗེས་ཙིག་རྟགས་ལ་ཆ་རྡེབ་ཀྱིས་ཁ་ཟུམ་པའི་མཐའ་མང་དབྱིབས་ཤིག་ཆགས་ འགོད་བྲིས་ཚར་རྗེས་རྩེ་ཚེག་གི\<emph\>"གནས་ཡུལ་"དང་"ཡི་གེ་"\</emph\>ནང་འཇུག་བྱས་ཆོག་པ་དང་དེ་རྗེས་དེ་ཁྲོད་དུ་ URL ཡི་\<emph\>"སྒྲོམ་བྱ་ཡུལ་"\</emph\>ཁ་ཕྱེ་དགོས་པ་འདེམས་པར་བྱེད།\</ahelp\>				2002-02-02 02:02:02
