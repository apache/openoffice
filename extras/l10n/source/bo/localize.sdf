helpcontent2	source\text\shared\04\01010000.xhp	0	help	par_id3152425				0	bo	\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>\</caseinline\>\<defaultinline\>ཚལ་ཐོའི་ཚང་ནང་མངོན་པའི་ཡིག་རྟགས་དུ་མར་གཤམ་འགོད་ཐིག་ཡོད། ཁྱེད་ཀྱིས་དུས་གཅིག་ཏུ་ Alt མཐེབ་དང་གཤམ་འགོད་ཐིག་ཡོད་པའི་ཡིག་རྟགས་མནན་པས་ཐད་ཀར་ཚལ་ཐོ་འདི་དག་སྒུལ་སློང་བྱེད། ཚལ་ཐོ་ཁ་ཕྱེ་རྗེས་གཤམ་འགོད་ཐིག་ཡོད་པའི་ཡིག་རྟགས་གཅིག་མཐོང་ཐུབ། གཤམ་འགོད་ཐིག་ཡོད་པའི་ཡིག་རྟགས་ཀྱི་མཐེབ་གནོན་པ་ཙམ་གྱིས་ཐད་ཀར་ཚལ་ཐོའི་རྣམ་གྲངས་འདི་དག་ཁ་ཕྱེ་ཐུབ།  \</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
