helpcontent2	source\text\scalc\01\04080000.xhp	0	help	par_id3151118				0	bo	\<variable id=\"funktionslistetext\"\>\<ahelp hid=\"HID_SC_FUNCTIONLIST\"\>བཀའ་ཚིག་འདིས་\<emph\>"རྟེན་གྲངས་རེའུ་འགོད།"\</emph\>སྒེའུ་ཁུང་ཁ་ཕྱེ་  དེའི་ནང་ཡིག་ཚགས་ནང་བསྒར་འཛུད་བྱ་རུང་བའི་རྟེན་གྲངས་བསྒྲིགས་ཡོད།   \</ahelp\>\</variable\>\<emph\>"རྟེན་གྲངས་རེའུ་འགོད་"\</emph\>སྒེའུ་ཁུང་དེ་\<link href=\"text/scalc/01/04060000.xhp\" name=\"རྟེན་གྲངས་སྣེ་སྟོན།\"\>"རྟེན་གྲངས་སྣེ་སྟོན་པ་"\</link\>ནང་གི་\<emph\>"རྟེན་གྲངས་"\</emph\>འདེམས་གཞིའི་ཁཱའི་ཤོག་ངོས་འདྲ་བ་ཡིན།  རྟེན་གྲངས་རེའུ་འགོད་བརྒྱུད་ནས་བསྒར་འཛུད་བྱས་པའི་རྟེན་གྲངས་ལ་གནས་ཟིན་རྟགས་འདུས་ཡོད་  བསྒར་འཛུད་བྱ་སྐབས་ལྟོས་བཅས་ཀྱི་གྲངས་ཐང་བེད་སྤྱད་ནས་གནས་ཟིན་རྟགས་དེ་དག་ཚབ་བརྗེ་བྱ་དགོས། 				2002-02-02 02:02:02
