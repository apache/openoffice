helpcontent2	source\text\swriter\01\02170000.xhp	0	help	par_id3155902				0	bo	\<variable id=\"bereichetext\"\>\<ahelp hid=\".uno:EditRegion\" visibility=\"visible\"\>ཡིག་ཚགས་ནང་མཚན་འཇོག་ཟིན་པའི་ས་ཁོངས་ཀྱི་གཏོགས་གཤིས་བཟོ་བཅོས་བྱེད་དགོས།\</ahelp\>གལ་ཏེ་ས་ཁོངས་བསྒར་འཛུད་བྱེད་ནས་  ཡི་གེ་འདེམས་པ་འམ་ཡིག་ཚགས་ནང་རྐྱང་རྡེབ་བྱེད་  དེ་ནས་\<emph\>[བསྒར་འཛུད་] - [ས་ཁོངས་...]\</emph\>འདེམས།\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02170000.xhp	0	help	par_id3143275				0	bo	\<emph\>"རྩོམ་སྒྲིག་ས་ཁོངས་"\</emph\>གླིང་སྒྲོམ་དང་ཚལ་ཐོ་\<link href=\"text/swriter/01/04020100.xhp\" name=\"ས་ཁོངས་\"\>\<emph\>[བསྒར་འཛུད་] - [ས་ཁོངས་...]\</emph\>\</link\>རྒྱུད་ཁ་ཕྱེ་བའི་གླིང་སྒྲོམ་འདྲ་བ་མ་ཟད་  དེ་མིན་གཤམ་གསལ་འདེམས་གཞི་མཁོ་འདོན་བྱས་ཡོད།				2002-02-02 02:02:02
