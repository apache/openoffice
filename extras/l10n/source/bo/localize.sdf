helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3147505	134			0	bo	\<ahelp hid=\"HID_PROP_EFFECTIVEMIN\" visibility=\"hidden\"\>འདིར་ཁྱེད་ཀྱི་ཚོད་འཛིན་ཡིག་དུམ་འདི་ཐང་ཞིག་ལ་གཏན་འཁེལ་བྱེད་  སྤྱོད་པོ་ནང་འཇུག་སྐབས་དེ་ ཆད་མི་རུང་འདི་འདྲ་སྤྱོད་པོས་ནང་འཇུག་གི་ཅུང་ཆུང་བའི་སྐབས་ཐང་ཁས་མི་ལེན།\</ahelp\>གྲངས་ཐང་ཡིག་དུམ་དང་དངུལ་ལོར་ཡིག་དུམ་ངོས་ནས་ཁྱེད་ཀྱིས་གྲངས་ཐང་ཆུང་ཤོས་གཏན་འབེབས་བྱས་ཆོག་སྤྱོད་པོས་ཐང་ཆུང་ཤོས་ནང་ནང་འཇུག་བྱེད་པ་བཀའ་འགོག་བྱེད།				2002-02-02 02:02:02
