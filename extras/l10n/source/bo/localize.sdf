helpcontent2	source\text\swriter\main0503.xhp	0	help	par_id3145675				0	bo	ཁྱེད་ཀྱིས་ནང་དོན་རྒྱ་ཆེ་བའི་འཕྲུལ་མཐུད་\<link href=\"text/shared/05/00000110.xhp\" name=\"རོགས་རམ་མ་ལག་\"\>རོགས་རམ་མ་ལག་\</link\>བེད་སྤྱོད་ཆོག་ མ་ལག་འདི་ $[officename] ཉེར་སྤྱོད་བྱ་རིམ་གྱི་ཆ་ཚང་འདྲེན་སྤྱོད་བརྩིས་  དེའི་ནང་སྟབས་བདེ་དང་ཪྙོག་འཛིང་ལས་འགན་གྱི་\<link href=\"text/swriter/guide/main.xhp\" name=\"གསལ་བཤད་\"\>གསལ་བཤད་\</link\>ཚུད་ཡོད།				2002-02-02 02:02:02
