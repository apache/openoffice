helpcontent2	source\text\swriter\main0110.xhp	0	help	par_idN1074F				0	bo	\<ahelp hid=\".\" visibility=\"hidden\"\>གླེང་སྒྲོམ་ཞིག་ཁ་ཕྱེས་  གཞན་ཡང་འདེམས་ངེས་ཀྱི་ཡིག་དེབ་དེ་རེའུ་མིག་ལ་བརྗེ་སྒྱུར་བྱེད།\</ahelp\>\<link href=\"text/swriter/01/06090000.xhp\"\>"ཡིག་དེབ་རེའུ་མིག་ལ་བརྗེ་སྒྱུར་བྱེད་"\</link\>གླེང་སྒྲོམ་ཁ་ཕྱེས་ གཞན་ཡང་འདེམས་ངེས་ཀྱི་ཡིག་དེབ་དེ་རེའུ་མིག་ལ་བརྗེ་སྒྱུར་བྱེད།				2002-02-02 02:02:02
