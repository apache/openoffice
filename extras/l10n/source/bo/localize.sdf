helpcontent2	source\text\swriter\01\04090006.xhp	0	help	par_id3151257				0	bo	གལ་ཏེ་ནང་འཇུག་གི་ཆ་རྐྱེན་མཛོམས་ན་\<link href=\"text/swriter/01/04090200.xhp\" name=\"ཆ་རྐྱེན་\"\>\<emph\>"ཆ་རྐྱེན་"\</emph\>\</link\>  \<emph\>"གཞི་གྲངས་གཤར་བྱང་ཨང་འགོད་"\</emph\>སྒྲོམ་ནང་གཏན་འཁེལ་གྱི་གཞི་གྲངས་མཛོད་ཁོངས་ཀྱི་ནང་དོན་བསྒར་འཛུད་བྱེད་དགོས་པ་དེ་  སྦྲགས་ཡིག་དུམ་དུ་ཟླ་དྲིལ་བར་རྩིས་དགོས།གཞི་གྲངས་མཛོད་ཁུངས་ཀི་མཐོང་དཔེ་རིས་ནང་སྣ་མང་བདམས་གས་ཐག་བཅད་པའི་ཟིན་བྲིས་ལ་བསམ་བློ་གཏོང་དགོས།				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04090006.xhp	0	help	par_id3147100				0	bo	ཁོངས་འདིའི་ཡིག་ཚགས་ནང་ཚན་པ་མང་པོ་ཟིན་འགོད་བསྒརའཛུད་བྱེད་པར་སྤྱད་ཆོག་ཅིང་ དམིགས་བསལ་ཟིན་འགོད་གྱི་རྣམ་གཞག་འཕྲིན་ཡིག་ཁོངས་ཀྱི་སྔོན་དུ་\<emph\>"གཞི་གྲངས་གཤར་བྱང་གང་རུང་ཞིག་"\</emph\>གི་ཁོངས་བསྒརའཛུད་བྱས་གཞི་ནས་འགྲིག་པ་རེད།				2002-02-02 02:02:02
