helpcontent2	source\text\swriter\02\18030200.xhp	0	help	par_id3152896				0	bo	\<ahelp hid=\".uno:InsertTimeField\" visibility=\"visible\"\>མིག་སྔའི་དུས་ཚོད་ཡིག་དུམ་ལ་རྩེས་ནས་བསྒར་འཛུད་བྱེད། \</ahelp\>དུས་ཚོད་ནི་བཀོལ་སྤྱོད་མ་ལག་གི་མ་ལག་སྒྲིག་ནང་ནས་ཐད་ཀར་ཐོག་ཀྱི་ཡོད་ཅོང་ རྒྱས་བཅད་ཀྱི་དུས་ཚོད་རྣམ་གཞག་ཉེར་སྤྱོད་བྱས་ནས་  F9 བྱེད་ནུས་མཐེབ་བེད་སྤྱོད་ཀྱི་རྣམ་གཞག་དེ་གསར་བཟོ་བྱེད།				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\18030200.xhp	0	help	par_id3151177				0	bo	དུས་ཚོད་རྣམ་གཞག་གཞན་དག་གཏན་འཁེལ་བྱེད་ན་ དོན་དངོས་ཀྱི་དུས་ཚོད་གཞི་གྲངས་ལེགས་སྒྲིག་བྱེད་དགོས་ན་ \<emph\>[བསྒར་འཛུད་] - [ཁོངས་] - [གཞན་དག་...]\</emph\>འདེམས་པ་དང་ \<link href=\"text/swriter/01/04090000.xhp\" name=\"ཁོངས་བཀའ་བརྡ་\"\>\<emph\>"ཁོངས་བཀའ་བརྡ་"\</emph\>\</link\>གླེང་སྒྲོམ་ནང་མཁོ་ངེས་ཀྱི་བཀོད་སྒྲིག་གཏན་འཁེལ་བྱེད་དགོས། ག་དུས་ཡིན་ཡང་གཡས་མཐེབ་ཚལ་ཐོའི་\<link href=\"text/swriter/01/02140000.xhp\" name=\"རྩོམ་སྒྲིག་ཁོངས་བཀའ་བརྡ་\"\>\<emph\>[རྩོམ་སྒྲིག་ཁོངས་བཀའ་བརྡ་...]\</emph\>\</link\>འདེམས་ནས་བསྒར་འཛུད་བྱས་པའི་དུས་ཚོད་ཡིག་དུམ་རྣམ་གཞག་བསྒར་འཛུད་བྱེད།				2002-02-02 02:02:02
