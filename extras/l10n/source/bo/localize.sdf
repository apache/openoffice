helpcontent2	source\text\scalc\01\05050300.xhp	0	help	par_id3148799				0	bo	\<variable id=\"tabeintext\"\>\<ahelp visibility=\"visible\" hid=\".uno:Show\"\>བསྐྱར་དུ་མངོན་པ་བེད་སྤྱོད་\<emph\>[གབ་པ།]\</emph\>གབ་པའི་ལས་ཁྲར་བཀའ་ཚིག་ཕབ་པ། \</ahelp\>\</variable\>བཀའ་ཚིག་དེ་ཁོལ་སྤྱོད་བྱ་དགོས་ན་ལས་ཁྲ་གཅིག་ཁོ་ན་འདེམས་དགོས།  ཁས་ལེན་གནས་ཚུལ་འོག་རང་འགུལ་གྱིས་མིག་སྔའི་ལས་ཁྲ་འདེམས་པར་བྱས།  གལ་ཏེ་ལས་ཁྲ་གཞན་འདེམས་དགོས་ན་ \<switchinline select=\"sys\"\> \<caseinline select=\"MAC\"\>བཀའ་ཚིག་\</caseinline\> \<defaultinline\>Ctrl\</defaultinline\> \</switchinline\> མཐེབ་གནོན་པ་དང་ཆབས་ཅིག་སྒེའུ་ཁུང་མཐིལ་ངོས་ཀྱི་ལྟོས་བཅས་ཀྱི་ལས་ཁྲའི་འདེམས་གཞིའི་ཁཱ་ལ་རྐྱང་རྡེབ་བྱས་ནས་འདེམས་པ་རྩིས་མེད་བྱེད་ཆོག				2002-02-02 02:02:02
