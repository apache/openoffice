helpcontent2	source\text\shared\05\00000140.xhp	0	help	par_id3155555				0	bo	\<ahelp hid=\"SFX2_PUSHBUTTON_TP_HELP_SEARCH_PB_OPEN_SEARCH\" visibility=\"hidden\"\>མངོན་པའི་རིའུ་འགོད་ནང་ཤར་བྱང་འདེམས་དགོས།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\05\00000140.xhp	0	help	par_id3152552				0	bo	རོགས་རམ་ནང་གི་ཡིག་ཆ་ཧྲིལ་པོ་བཤེར་འཚོལ་བྱེད་ནུས་ $[officename] བེད་སྤྱོད་སྐབས་སྡེབ་སྒྲིག་གང་རུང་གི་བཤེར་འཚོལ་ཤར་བྱང་གི་རོགས་རམ་ཡིག་ཚགས་ཪྙེད་ཐུབ་    དེས་ ན་ཁྱེད་རང་ གི་བཤེར་འཚོལ་ཤར་བྱང་ཡི་གེའི་ཡིག་ཐུང་ནང་ཡིག་ཚགས་གཅིག་གམ་མང་པོ་མཐེབ་འཇུག་གནང་དགོས།\<emph\> \</emph\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\05\00000140.xhp	0	help	par_id3153345				0	bo	\<emph\>བཤེར་འཚོལ་ཤར་བྱང་\</emph\>ཡི་གེ་དང་ཡིག་ཐུང་གིས་ཉེ་བར་མཐེབ་འཇུག་བྱས་པའི་ཡིག་ཚིག་རྣམས་ཉར་ཚགས་བྱེད་ཀྱི་ཡོད་    སྔོན་གྱི་བཤེར་འཚོལ་གང་རུང་བསྐྱར་ཟློས་བྱེད་དགོས་ན་མདའ་རྩེའི་རིས་རྟགས་རྐྱང་རྡེབ་བྱེད་དགོས་པ་མ་ཟད་རེའུ་འགོད་ནང་ཁྱེད ་ལ་མཁོ་བའི་ཤར་བྱང་དྲན་བརྡར་སྤྱོད་ཀྱི་ཡོད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\05\00000140.xhp	0	help	par_id3155941				0	bo	བཤེར་འཚོལ་ཚར་སྐབས་བཤེར་འཚོལ་བྱས་པའི་ཡིག་ཚགས་གི་ཁ་བྱང་རིའུ་འགོད་ནང་མངོན་ཐུབ་         ཟླ་སྒྲིལ་ཤོག་གི་ཤར་བྱང་རིའུ་འགོད་ཀྱི་ཆེས་གོང་མར་གནས་གི་ཡོད་  ཡང་ན་ ཤར་བྱང་བདམས་ཚར་རྗེས་རྐྱང་རྡེབ་ཀྱིས་\<emph\>显示\</emph\>འབྲེལ་ཡོད་རོགས་རམ་ཡིག་ཚགས་ཀྱི་ཁུར་སྣོན་མངོན་པ་བྱེད་དགོས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\05\00000140.xhp	0	help	par_id3157958				0	bo	བསྐྱར་འདེམས་སྒྲོམ་བེད་སྤྱད་ ནས་ཁ་བྱང་ཁོ་ནའི་ཐོག་འཚོལ་དགོས་\<emph\>ཁ་བྱང་ཁོ་ནའི་ཐོག་འཚོལ་དགོས\</emph\>ཁྱེད་ཀྱི་བཤེར་འཚོལ་ཡིག་ཚགས་ཁ་བྱང་ཁོ་ནར་གཏན་འཁེལ་གནང་དགོས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\05\00000140.xhp	0	help	par_id3147210				0	bo	བསྐྱར་འདེམས་སྒྲོམ་\<emph\>ཡི་གི་ཧྲིལ་པོའི་ཟླ་སྒྲིལ་\</emph\>གནད་ལ་ཕིགས་པའི་བཤེར་འཚོལ་ཐད་བེད་སྤྱོད་གལ་ཏེ་བདམས་པ་ཡིན་ན་ ཟླ་སྒྲིལ་མིང་ཚིག་ཆ་ཙམ་ན་གཏོགས་བཪྙེད་ཐུབ་ཀྱི་མེད་མིང་ཚིག་རིང་པོའི་ནང་འཇུག་བཤེར་འཚོལ་ཤར་བྱང་གྱི་ཆ་ཤས་བཤེར་འཚོལ་དགོས་ ན་བདམས་རྒྱུ་མེད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\05\00000140.xhp	0	help	par_id3146798				0	bo	ཁྱེད་ཀྱི་བཤེར་འཚོལ་ཤར་བྱང་སྡེབ་སྒྲིབ་གང་འདྲ་ཞིག་ནང་འཇུག་བྱས་ན་ འགྲིག་   ཤར་བྱང་སོ་སོའི་བར་ལ་སྟོང་མིག་གི་ཁ་འབྱེད་དགོས་    འཚོལ་བཤེར་སྐབས་\<emph\>ཡིག་འབྲུ་ཆེ་ཆུང་བྲིས་ཐོག་\</emph\>བསམ་གཞིགས་མི་དགོས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\05\00000140.xhp	0	help	par_id3149732				0	bo	བཤེར་འདྲེན་དང་ཡིག་ཆ་ཧྲིལ་པོ་བཤེར་འཚོལ་རྒྱུན་དུ་མིག་སྔར་འདེམས་ངེས་པའི་རྒྱུན་མཁོའི་བྱ་རིམ་ཁོ་ནར་བེད་སྤྱོད་རོགས་རམ་ལྟ་ཞིབ་བེད་སྤྱོད་སྐབས་ཡོ་བྱད་ཚང་ཐོག་གི་རེའུ་འགོད་སྒྲོམ་གྱིས་ཉེར་མཁོའི་བྱ་རིམ་དང་འཚམ་པ་ཞིག་འདེམས་དགོས་ %PRODUCTNAME				2002-02-02 02:02:02
