helpcontent2	source\text\shared\05\00000100.xhp	0	help	par_id3150618				0	bo	\<emph\>ཐོག་གི་ $[officename] རོགས་སྐྱོན་འཁོར་ཡུལ་\</emph\>ནང་ནང་དོན་དང་ཐབས་ཤེས་བཤེས་འཚོལ་ཐོན་\<link href=\"text/shared/05/00000110.xhp\" name=\"རོགས་་སྐྱོར་འཁོར་ཡུལ་\"\>རོགས་་སྐྱོར་འཁོར་ཡུལ\</link\>ནང་ནང་དོན་དང་ཐབས་ཤེས་བཤེར་འཚོལ་ ཐོག་\<link href=\"text/shared/05/00000130.xhp\" name=\"Index\"\>ཡོང་ཐུབ་\</link\>ཡི་ནང་གཏན་འཁེལ་པའི་འགག་རྩའི་ཡིག་འབྲུ་བཤེཤེ་འཚོལ་དང་ཡང་ན་\<link href=\"text/shared/05/00000140.xhp\" name=\"Find\"\>ཡིག་ཐོག་གི་འཚོལ་བསྡུའི་\</link\>ནང་ཡིག་ཆ་ཚང་ལ་བཤེར་འཚོའཚོ་བྱེད་དགོས་ཡང་ན་\<link href=\"text/shared/05/00000160.xhp\" name=\"Topics\"\>གཙོ་དོན་\</link\>ནང་མིག་ཤར་བང་རིམ་རེའུ་འགོད་བྱ་དགོས།				2002-02-02 02:02:02
