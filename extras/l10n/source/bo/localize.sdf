helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3149566	9			0	bo	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_FORMULA:BTN_MATRIX\"\>བདམས་པའི་དྲ་མིག་ཁྱབ་ཁོངས་ནང་ལིང་ཚེ་སྤྱི་འགྲོས་ཀྱི་རྣམ་པ་བདམས་པའི་རྟེན་གྲངས་ནང་བསྒར་འཛུད་བྱེད།\</ahelp\>རིང་ཚེ་སྤྱི་འགྲོས་གཅིག་དྲ་མིག་ཡང་དག་ཅིག་བཀོད་སྤྱོད་བྱ་ཆོག་  གནས་ཚུལ་འདི་འདྲའི་འོག་ལིང་ཚེ་ནང་དྲ་མིག་ཡོད་ཚད་སྤྱི་འགྲོས་གཅིག་ལ་མཉམ་སྤྱོད་བྱེད་   དྲ་མིག་ཚང་མ་ཚུད་པའི་སྤྱི་འགྲོས་ཀྱི་འདྲ་ཕབ་ཆེས་གཅིག་མ་རེད།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3155959				0	bo	ལས་ཁྲའི་ནང་འཇུག་པ་མ་ཟད་སྤྱི་འགྲོས་གཏན་འཁེལ་སྐབས་ \<emph\>"ལིང་ཚེ་"\</emph\>འདེམས་གཞི་དང་།\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>བཀའ་ཚིག་\</caseinline\>\<defaultinline\> Ctrl\</defaultinline\>\</switchinline\>+Shift+Enter བཀའ་ཚིག་ལ་འདྲ་མཚུངས་ཀྱི་བྱེད་ནུས་ལྡན་ གུག་རྟགས་ཁྲ་ཁྲ་གཉིས་ཀྱི་བསྒར་འཛུད་ཀྱི་ལིང་ཚེའི་སྤྱི་འགྲོས་སྟོན་པ།				2002-02-02 02:02:02
