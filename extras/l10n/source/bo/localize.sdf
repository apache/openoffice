helpcontent2	source\text\shared\explorer\database\05030100.xhp	0	help	par_id3150178				0	bo	\<ahelp hid=\"DBACCESS_RADIOBUTTON_TAB_WIZ_COPYTABLE_RB_DEFDATA\"\>གཞི་གྲངས་མཛོད་རེའུ་མིག་གི་ 1:1 ཟུར་དེབ་གསར་འཛུགས་བྱེད། \</ahelp\>རེའུ་མིག་མཚན་འཇོག་དང་གཞི་གྲངས་ཡོད་ཚད་འདྲ་ཕབ་བྱེད་པ་འགྱུར།  རེའུ་མིག་མཚན་འཇོག་ལ་རེའུ་མིག་སྒྲིག་གཞི་དང་གཞི་གྲངས་ཡིག་དུམ་མི་འདྲི་བའི་རྣམ་གཞག་ཚུད་མེད་(དམིགས་བསལ་ཡིག་དུམ་གཏོགས་གཤིས་ཚུད་ཡོད་) ཡིག་དུམ་ནང་དོན་གྱི་གཞི་གྲངས་མཁོ་འདོན་བྱེད།				2002-02-02 02:02:02
