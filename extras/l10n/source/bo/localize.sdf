helpcontent2	source\text\shared\02\06050000.xhp	0	help	par_id3149549	4			0	bo	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<emph\>"གཤམ་ལ་རིམ་པ་གཅིག"\</emph\>རིས་རྟགས་\<emph\>[རྣམ་གྲངས་མཚོན་རྟགས་དང་ཨང་སྒྲིག་ཡོ་བྱད་ཚང་།]\</emph\>ལ་གནས་  འོད་རྟགས་ནི་ཨང་སྒྲིག་གམ་རྣམ་གྲངས་མཚོན་རྟགས་ལ་གནས་དུས་དེ་ཐོན་ཡོང་། \</caseinline\>\<caseinline select=\"IMPRESS\"\>\<emph\>"རིམ་པ་ཆག"\</emph\>རིས་རྟགས་\<emph\>[རྩ་འཛིན་ཡོ་བྱད་ཚང་།]\</emph\>ལ་གནས་  རྩ་འཛིན་མཐོང་རིས་བེད་སྤྱོད་བྱེད་དུས་དེ་ཐོན་ཡོང་། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
