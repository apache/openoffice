helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	par_id3154142				0	bo	ད་དུང་ཡང་\<switchinline select=\"appl\"\>\<caseinline select=\"IMPRESS\"\>\<link href=\"text/simpress/02/13140000.xhp\" name=\"གནས་སྟངས་ཐིག་གི་སྙོམས་གཤིབ།\"\>\<emph\>"གནས་སྟངས་ཐིག་གི་སྙོམས་གཤིབ།"\</emph\>\</link\>\</caseinline\>\<caseinline select=\"DRAW\"\>\<link href=\"text/simpress/02/13140000.xhp\" name=\"གནས་སྟངས་ཐིག་གི་སྙོམས་གཤིབ།\"\>\<emph\>"གནས་སྟངས་ཐིག་གི་སྙོམས་གཤིབ།"\</emph\>\</link\>\</caseinline\>\<defaultinline\>\<emph\>"གནས་སྟངས་ཐིག་གི་སྙོམས་གཤིབ།"\</emph\>\</defaultinline\>\</switchinline\>བེད་སྤྱོད་པ་དང་ བཟོ་སྒྲིག་འདི་རིས་རྟགས་ཐོག་ནས་མཚན་ཉིད་འཇོག་དགོས་ རིས་རྟགས་འདི་ནི་གསལ་སྟོན་ཡིག་ཟིན་ཡིག་གམ་རིས་དབྱིབས་ཡིག་ཚགས་\<emph\>[འདེམས་གཞིའི་ཚང་།]\</emph\>ནང་ལས་འཚོལ་ཐུབ།				2002-02-02 02:02:02
