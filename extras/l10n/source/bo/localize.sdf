helpcontent2	source\text\swriter\main0503.xhp	0	help	par_id3155137				0	bo	 \<link href=\"text/shared/guide/dragdrop.xhp\" name=\"འདྲུད་སྐྱེལ་\"\>འདྲུད་སྐྱེལ་\</link\>བྱེད་ནུས་ནི་དེ་བས་མྱུར་བདེ་བྱེད་ཚད་མཐོ་$[officename] ཡི་གེ་ལས་སྣོན་ཡིག་ཚགས་ལས་སྣོན་བྱེད།  དཔེར་ན་  འདྲུད་སྐྱེལ་སྤྱད་དེ་བྱ་ཡུལ་(དཔེར་ན་ དྲས་སྦྱར་རིས་མཛོད་ནང་གི་རིས་དབྱིབས་)མིག་སྔའི་ཡིག་ཚགས་ཀྱི་གནས་ས་གཞན་ཡང་ན་བེད་སྤྱོད་བྱེད་བཞིན་པའི་ $[officename] ཡིག་ཚགས་ནང་འདྲུད་སྐྱེལ་བྱེད།				2002-02-02 02:02:02
