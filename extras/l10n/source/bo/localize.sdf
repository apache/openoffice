helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3146119				0	bo	\<switchinline select=\"appl\"\> \<caseinline select=\"WRITER\"\>ཁྱེད་ཀྱིས་རབ་དང་རིམ་པའི་སྣོན་རྟགས་བར་གཅོད་ཀྱི་ཡིག་འགྲེལ་རྟགས་(-)ཡང་ན་རེའུ་འགོད་རྟགས་  +------+---+ནང་བཅུག་དེ་ དུམ་མཚུངས་ Enter མཐེབ་གནོན་མཐེབ་སྐབས་ རེའུ་མིག་ཞིག་འཛུགས་ཐུབ། སྣོན་རྟགས་ཀྱིས་སྟར་བར་གཅོད་རྟགས་སྟོན་ སྣོན་རྟགས་དབར་གྱི་ཡིག་སྦྲེལ་རྟགས་དང་རེའུ་འགོད་རྟགས་ཀྱིས་སྟར་ཞེང་སྟོན།\</caseinline\> \</switchinline\>				2002-02-02 02:02:02
