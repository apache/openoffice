helpcontent2	source\text\shared\02\02140000.xhp	0	help	par_id3149798				0	bo	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>གལ་ཏེ་དུམ་བུ་མང་པོ་འདེམས་ན་  བདམས་པའི་དུམ་བུ་ཡོད་ཚད་ཀྱི་ནང་སྐུམ་ཆེར་གཏོང་བྱེད།\</caseinline\>\<caseinline select=\"CALC\"\>དྲ་མིག་གི་ནང་དོན་\<link href=\"text/shared/01/05340300.xhp\" name=\"རྣམ་གཞག་ - དྲ་མིག་ - སྙོམས་གཤིབ་\"\>\<emph\>རྣམ་གཞག་ - དྲ་མིག་ - སྙོམས་གཤིབ་\</emph\>\</link\>ནང་བཀོད་སྒྲིག་བྱས་པའི་མིག་སྔའི་ཐང་སྤོ་འགུལ་བྱེད།\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
