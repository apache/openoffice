helpcontent2	source\text\scalc\guide\formulas.xhp	0	help	par_id3156281				0	bo	སྤྱི་འགྲོས་ཡོད་ཚད་མཚུངས་རྟགས་ནས་འགོ་བཙུགས་དགོས།  སྤྱི་འགྲོས་ནང་ཨང་ཀིའམ་ཡི་གེ་ཡོད་ཆོག་ལ་ཡང་གཞི་གྲངས་གཞན་ཡང་(དཔེར་ན་སྤྱི་འགྲོས་ཀྱི་ཞིབ་ཆ་)ཡོད་ཆོག   སྤྱི་འགྲོས་ནང་ད་དུང་གྲངས་རིག་པའི་རྩིས་རྒྱག་རྟགས་སམ་གཏན་ཚིགས་རྩིས་རྒྱག་རྟགས་སམ་རྟེན་གྲངས་མིང་བཅས་ཚུད་ཆོག				2002-02-02 02:02:02
helpcontent2	source\text\scalc\guide\formulas.xhp	0	help	par_id3145272				0	bo	སྤྱི་འགྲོས་ནང་དཔེར་ན་སྡོམས་འཐེན་བསྒྱུར་བགོས་(+, -, *, /)རྩ་བའི་རྩིས་རྒྱག་རྟགས་སྤྱོད་པའི་སྐབས་"བསྒྱུར་བགོས་སྔོན་དང་སྡོམས་འཐེན་རྗེས་"ཀྱི་གྲངས་རིག་པའི་རྩིས་རྒྱག་ངེས་སྲོལ་ལ་དོ་སྣང་གནང་དགོས།  གཞི་གྲངས་ཀྱི་སྤྱི་སྡོམས་བརྩི་བའི་སྐབས་ཁྱེད་ཀྱིས་སྤྱི་འགྲོས་ =SUM(A1:B1)སྤྱད་ནས་མཚོན་པ་ཕུད་ད་དུང་སྤྱི་འགྲོས་ =A1+B1མཚོན་ཆོག་པའོ།				2002-02-02 02:02:02
