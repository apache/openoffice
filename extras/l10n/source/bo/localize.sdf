helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3155073				0	bo	\<ahelp hid=\"HID_PROP_BACKGROUNDCOLOR\" visibility=\"hidden\"\>ཚོད་འཛིན་ཡིག་དུམ་གྱི་རྒྱབ་ལྗོངས་ཚོད་གཞི་བཀོད་སྒྲིག་བྱེད།\</ahelp\>ཚོད་འཛིན་ཡིག་དུམ་མང་ཆེ་བ་རྒྱབ་ལྗོངས་ཚོད་གཞི་ལ་བཀོད་སྒྲིག་བྱེད།\<emph\>རྒྱབ་ལྗོངས་ཚོད་གཞི།\</emph\>རྐྱང་རྡེབ་བྱས་ཏེ་རེའུ་འགོད་ཞིག་ཁ་ཕྱེས་གཞན་ཡང་འདེམས་པའི་ཚོས་གཞི་ཁག་བཀོད་"ཚད་གཞི།"འདེམས་གཞི་འདེམས་པ་མ་ལག་བཀོད་སྒྲིག་གི་ཚོས་གཞི་སྤྱོད། གལ་སྲིད་རེའུ་འགོད་ནང་དགོས་ངེས་ཀྱི་ཚོས་གཞི་བཀོད་མེད་ན་ \<emph\>...\</emph\>གནོན་མཐེབ་རྐྱང་རྡེབ་བྱེད་ \<link href=\"text/shared/optionen/01010501.xhp\" name=\"ཚོས་གཞི།\"\>\<emph\>ཚོས་གཞི།\</emph\>\</link\> གླེང་སྒྲོམ་ནང་ཚོས་གཞི་མཚན་འཇོག་བྱེད།				2002-02-02 02:02:02
