helpcontent2	source\text\smath\01\05010000.xhp	0	help	par_id3151108				0	bo	\<ahelp hid=\"STARMATH:LISTBOX:RID_FONTTYPEDIALOG:5\"\>ཁྱེད་ཀྱིས་ \<emph\>font serif\</emph\> རྣམ་གཞག་ལ་སྤྱོད་དགོས་པའི་ཡིག་གཟུགས་གཏན་འཁེལ་བྱེད། \</ahelp\>Serif ནི་"རོགས་རམ་ཐིག་"ཆུང་བ་ཡིན་  Times serif ཡིག་གཟུགས་སྤྱོད་པའི་སྐབས་ རམ་འདེམས་ཐིག་མཐོང་ཐུབ་(དཔེར་ན་ ཡིག་ཆེན་ཡིག་འབྲུ་ A མཐིལ་ངོས་) serif སྤྱད་ནས་ཧ་ཆང་ཁོ་བེད་ རྒྱུ་རྐྱེནནི་དེ་ཀློག་པ་པོའི་མཐོང་ལམ་དྲང་ཐིག་གཅིག་ཐོག་གནས་པ་ཁྲེད་སྟོན་གྱི་མུ་མཐུད་ནས་ཀློག་འདོན་འགྱགས་ཚད་གོང་མཐོང་གཏོང་ཐུབ།				2002-02-02 02:02:02
