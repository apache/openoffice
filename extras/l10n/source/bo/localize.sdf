helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3154509				0	bo	\<emph\>ཉན་མཁན་ URL\</emph\>ཡིགདེབ་སྒྲོམ་ནང་ ཉན་པ་པོར་སྤྱོད་པ་མཁོ་འདོན་བྱས་པའི་ HTML ཡིག་ཚགས་ཀྱི་ཡིག་ཆའི་མིང་ནང་བཅུག་བྱེད། \<emph\>གསལ་སྟོན་ཡིག་ཟིན་ URL\</emph\>ནང་ གསལ་སྟོན་ཡིག་ཟིན་དཀར་ཆག་གྱི་ URLནང་བཅུག་བྱེད་ དེ་རྗེས་\<emph\>Perl ཞབས་བེད་ URL\</emph\>ནང་  CGI ཞབས་དེབ་དཀར་ཆག་གྱི་ URLནང་བཅུག་བྱེད། ད་ཆ་སྣེ་སྟོན་རྗེས་ཀྱི་ཤོག་ལྷེའི་འགའི་ནང་གོང་གང་མདུན་སྤོས་ཀྱིས་བཀོད་སྒྲིག་མཚན་འཇོག་བྱེད་ ཡང་ན་\<emph\>གསར་འཛུགས་\</emph\>གནོན་མཐེབ་ལ་ལ་རྐྱང་རྡེབ་བྱེད་ཀྱི་འཕེལ་རིམ་འདྲེན་བཏོན་བྱེད།				2002-02-02 02:02:02
