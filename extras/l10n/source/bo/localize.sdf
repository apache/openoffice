helpcontent2	source\text\swriter\01\04090003.xhp	0	help	par_id3149881	6			0	bo	ལ་ཏེ་ཆ་རྐྱེན་ངོས་ཅན་ཞིག་སྐོང་ཐུབ་ན་\<link href=\"text/swriter/01/04090200.xhp\" name=\"ཆ་རྐྱེན་\"\>ཆ་རྐྱེན་\</link\>  ཡི་གེ་བསྒརའཛུད་བྱསབྱས་ན་འགྲིག་སྟེ།དཔེར་ན་  \<emph\>"ཆ་རྐྱེན་"\</emph\>སྒྲོམ་"sun eq 1"ནང་འཇུག་བྱས་རྗེས་དེ་ནས་ \<emph\>"དེ་"\</emph\>སྒྲོམ་ནང་འཇུག་གིས་འགྱུར་ཚད་"sun"དེ་"1"དང་མཚུངས་སྐབས་བསྒརའཛུད་ཀྱི་ཡི་གེ་དགོས།གལ་སྲིད་འདོད་མོས་ཡོད་ན་  \<emph\>"དེ་མིན་"\</emph\>སྒྲོམ་ནང་ཆ་རྐྱེན་གིས་འགྱུར་ཚད་"sunདེ་"  དང་མཚུངས་སྐབས་བསྒར་འཛུད་ཀྱི་ཡི་གེ་དགོས་ གལ་ཏེ་འདོད་མོས་ཡོད་ན་\<link href=\"text/swriter/01/04090005.xhp\" name=\"འགྱུར་ཚད་\"\>\<emph\>"འགྱུར་ཚད་"\</emph\>\</link\>འདེམས་གཞི་ཁ་ལ་རྐྱང་རྡེབ་བྱས་ཏེ་"འགྱུར་ཚད་བཀོད་སྒྲིག་"འདེམས་ནས་ དེ་རྗེས་\<emph\>"མིང་"\</emph\>སྒྲོམ་ནང་"sun" ནང་འཇུག་བྱེད་དགོས་\<emph\>"གྲངས་ཐང་"\</emph\>སྒྲོམ་ནང་འགྱུར་ཚད་ཐང་ནང་འཇུག་བྱེད་དགོས།				2002-02-02 02:02:02
