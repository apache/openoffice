helpcontent2	source\text\scalc\guide\cellstyle_conditional.xhp	0	help	par_id3146969				0	bo	གླེང་སྒྲོམ་ནང་ཆ་རྐྱེན་ནང་འཇུག་བྱ།  གླེང་སྒྲོམ་དེ་ \<link href=\"text/scalc/01/05120000.xhp\" name=\"$[officename] རོགས་རམ།\"\>$[officename] རོགས་རམ།\</link\>ནང་ཞིབ་པར་གསལ་བཤད་བྱས་ཡོད་  གཤམ་གསལ་ནི་དཔེ་གཞི་ཞིག་ཡིན།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\guide\cellstyle_conditional.xhp	0	help	par_id3150043				0	bo	ཁྱེད་ཀྱིས་ཁྱེད་ཀྱི་ལས་ཁྲའི་ནང་དམིགས་གསལ་དུ་དམིགས་འཛུགས་ཐང་ནན་བཤད་བྱེད་འདོད་ན།  དཔེར་ན་ རེའུ་མིག་ནང་ཆ་སྙོམས་ཐང་ཡོད་ཚད་ཡན་ཆད་ལྗང་གུ་ཡིན་པ་གཏན་འབེབས་བྱ་བ་དང་ཆ་སྙོམས་ཐང་ཡོད་ཚད་མན་གྱི་གྲངས་ཐང་དམར་པོར་གཏན་འབེབས་བྱ་བ།  དེ་ནི་ཆ་རྐྱེན་རྣམ་གཞག་ཅན་བརྒྱུད་ནས་མངོན་འགྱུར་བྱེད།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\guide\cellstyle_conditional.xhp	0	help	par_id3155337				0	bo	དེའི་ཁྲོད་མི་གཅིག་པའི་གྲངས་ཐང་འགའ་ཤས་ཐོན་པའི་རེའུ་མིག་འབྲི་འཇུག་བྱ་རོགས།  ཚོད་ལྟར་མཚོན་ན་ སྐབས་བསྟུན་གྲངས་ཐང་སྤྱད་ནས་རེའུ་མིག་གསར་འཛུགས་བྱས་ཆོག				2002-02-02 02:02:02
helpcontent2	source\text\scalc\guide\cellstyle_conditional.xhp	0	help	par_id3149565				0	bo	དྲ་མིག་གཅིག་ནང་སྤྱི་འགྲོས་ནང་འཇུག་བྱ་ =RAND()ཁྱེད་ལ་ 0 དང་ 1 བར་གྱི་སྐབས་བསྟུན་གྲངས་ཐང་ཤོག་ཐོབ་ཐུབ།  གལ་ཏེ་ཁྱེད་ཀྱིས་གྲངས་ཐང་ཡོད་ཚད་ 0 དང་ 50 དུ་གནས་འདོད་ན་སྤྱི་གྲོས་དེ་ནང་འཇུག་བྱ་ =INT(RAND()*50)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\guide\cellstyle_conditional.xhp	0	help	par_id3149258				0	bo	སྤྱི་གྲོས་འདྲ་ཕབ་ཀྱིས་སྐབས་བསྟུན་གྲངས་ཡིག་ཕྲེང་གསར་འཛུགས་བྱེད།  བདམས་པའི་དྲ་མིག་གི་གཡོན་གཤམ་ཟུར་ལ་རྐྱང་རྡེབ་དང་སྦྲགས་གཡས་ལ་དྲུད་སྐྱེལ་བྱ་  དགོས་ངེས་ཀྱི་དྲ་མིག་ས་ཁོངས་བདམས་ཟིན་པའི་བར་དུ་དེ་ལྟར་བྱ།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\guide\cellstyle_conditional.xhp	0	help	par_id3159236				0	bo	གོང་དུ་བཤད་པ་དང་ཆ་འདྲ་བར་གཡས་གཤམ་ཟུར་གྱི་དྲ་མིག་འོག་ལ་དྲུད་སྒུལ་བྱས་ཏེ་ཕྲེང་མང་སྐབས་བསྟུན་གྲངས་གསར་འཛུགས་བྱེད།   				2002-02-02 02:02:02
helpcontent2	source\text\scalc\guide\cellstyle_conditional.xhp	0	help	par_id3154659				0	bo	གཤམ་གྱི་གོ་རིམ་ནི་དྲ་མིག་བཟོ་ལྟ་ཞིག་གི་ཆ་སྙོམས་ལས་གཉེར་ཡོང་འབབས་ལས་མཐོ་བའི་ཐང་ཡོད་ཚད་ལ་སྤྱོད་པ་ཡིན་  བཟོ་ལྟ་གཞན་དག་གཅིག་ཆ་སྙོམས་ལས་གཉེར་ཡོང་འབབས་ལས་ཉུང་བའི་ཐང་ལ་སྤྱོད།   མུ་མ་མཐུད་སྔོན་དུ་"བཟོ་ལྟ་སྣ་ཚོགས།"སྒེའུ་ཁུང་མཐོང་རུང་ངོས་བཟུང་བྱ་རོགས།				2002-02-02 02:02:02
