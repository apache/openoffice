helpcontent2	source\text\swriter\02\04100000.xhp	0	help	par_id3145078				0	bo	\<ahelp hid=\".uno:InsertColumns\" visibility=\"visible\"\>རེའུ་མིག་ནང་འོད་རྟགས་གང་དུ་གནས་སའི་འོག་ཏུ་སྟར་གཅིག་བསྒར་འཛུད་བྱེད། \</ahelp\>ཕྲེང་མང་པོ་ཞིག་བསྒར་འཛུད་བྱེད་ནས་ ལྟོ་བཅས་ཀྱི་གླེང་སྒྲོམ་(\<emph\>རྣམ་གཞག་ - སྟར་་ - བསྒར་འཛུད་\</emph\>)འདེམས་པ་ བེད་སྤྱོད་བྱས་ཆོག་ རིས་རྟགས་དེར་རྐྱང་རྡེབ་མ་བྱས་གོང་ཕྲེང་མང་པོ་ཞིག་འདེམས། དཔར་ན་ཐབས་ཤེས་གཉིས་པ་བེད་སྤྱོད་ནས་ བསྒར་འཛུད་ཀྱི་ཕྲེང་དེ་འདེམས་ངེས་ཀྱི་སྟར་དང་མཚུངས་པའི་མཐོ་ཚད་ཡོད།				2002-02-02 02:02:02
