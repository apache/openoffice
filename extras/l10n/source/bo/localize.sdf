helpcontent2	source\text\shared\01\01010301.xhp	0	help	par_id3159201				0	bo	\<ahelp visibility=\"visible\" hid=\"HID_BUSINESS_FMT_PAGE_TYPE\"\>བེད་སྤྱོད་དགོས་པའི་ཁྲེ་ཚུན་རྣམ་གཞག་འདེམས་པ། སྤྱོད་རུང་གི་རྣམ་གཞག་དེ་ཁྱེད་ཀྱིས་\<emph\>"ཚོང་རྟགས་"\</emph\>རེའུ་འགོད་ནང་ཇི་ལྟར་འདེམས་པར་རག་ལས་ཡོད་ རང་མཚན་འཇོག་ཁྲེ་ཚུན་རྣམ་གཞག་གཞན་སྤྱོད་དགོས་ན་ \<emph\>"བེད་སྤྱོད་མཁན་"\</emph\>འདེམས་རོགས་ དེ་རྗེས་\<link href=\"text/shared/01/01010202.xhp\" name=\"རྣམ་གཞག་\"\>\<emph\>"རྣམ་གཞག་"\</emph\>\</link\>འདེམས་གཞིའི་ཁྭ་ལ་རྐྱང་རྡེབ་ཀྱིས་རྣམ་གཞག་མཚན་འཇོག་བྱ་དགོས་\</ahelp\>				2002-02-02 02:02:02
