helpcontent2	source\text\shared\02\01170102.xhp	0	help	par_id3153326				0	bo	གལ་སྲིད་"གྲངས་ཐང་རེའུ་འགོད།"འདེམས་གཞི་བེད་སྤྱད་ན་ཚོད་ཆས་ནི་\<link href=\"text/shared/02/01170101.xhp\" name=\"རྒྱུན་གཏན།\"\>\<emph\>རྒྱུན་གཏན།\</emph\>\</link\>འདེམས་གཞི་ཁཱ་ནང་\<emph\>རེའུ་འགོད་སྒྲོམ་\</emph\>ཡིག་དུམ་ནང་ཚུད་པའི་གཤར་བྱང་ཡོད་ཚད་མངོན།  གཞི་གྲངས་མཛོད་རེའུ་བྱང་ཆ་བཞག་ན་འདྲེན་སྤྱོད་ཐང་བེད་སྤྱོད་ཆོག་(\<link href=\"text/shared/02/01170102.xhp\" name=\"གྲངས་ཐང་རེའུ་འགོད་ཀྱི་འདྲེན་སྤྱོད་བེད་སྤྱོད།\"\>\<emph\>གྲངས་ཐང་རེའུ་འགོད་ཀྱི་འདྲེན་སྤྱོད་བེད་སྤྱོད།\</emph\>\</link\>ས་བཅད་དང་པོ་ལ་གཟིགས་)				2002-02-02 02:02:02
