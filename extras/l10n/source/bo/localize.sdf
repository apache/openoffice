helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3150275				0	bo	\<ahelp hid=\"SD:RADIOBUTTON:DLG_PUBLISHING:PAGE2_CHG_DEFAULT\"\>སྒྲོན་བཪྙན་སྤྱིན་ཤོག་གི་བརྗེ་བསྒྱུར་དུས་ཚོད་དེ་ཁྱེད་ཀྱི་གསལ་སྟོན་ཡིག་ཟིན་ནང་གི་སྒྲོན་བཪྙན་སྤྱིན་ཤོག་རེ་རེ་བཀོང་སྒྲིག་དུས་ཚོད་ལ་རག་ལས། གལ་ཏེ་ཁྱེད་ཀྱིས་ལག་འགུལ་བརྗེ་བསྒྲུར་ཤོག་ངོས་བཀོཀོ་སྒྲིག་བྱས་ཡོད་ན་མཐེབ་གཞོང་ནང་གི་ ཡིག་དེབ་གང་རུང་གནོན་ཏེ་ཚང་མ་ HTML གསལ་སྟོན་ཡིག་ཟིན་ཤོག་བརྗེ་བྱེད། \</ahelp\>				2002-02-02 02:02:02
