helpcontent2	source\text\simpress\01\13050300.xhp	0	help	par_id3149127	3			0	bo	གལ་སྲིད་ཁྱེད་ཀྱི་གཉིས་ཡང་ན་མང་བའི་བྱ་ཡུལ་འདེམས་པ་མ་ཟད་འདི་རྩ་གསུམ་ལ་བརྗེ་སྒྱུར་ དེ་ནས་བརྗེ་སྒྱུར་གྱི་འབྲས་བུ་ནི་རྩ་གསུམ་ཚོ་གཅིག་ཡིན་ ཚོ་འདི་རྐྱང་པའི་བྱ་ཡུལ་ལ་དངོས་འཛིན་ནས་བེད་སྤྱོད་ཐུབ།  \<switchinline select=\"appl\"\>\<caseinline select=\"DRAW\"\>\<emph\>བཟོ་བཅོས་\</emph\> - \<emph\>འཛུལ་བའི་ཚོ་སྒྲིག་\</emph\>\</caseinline\>\<defaultinline\>\<emph\>རྣམ་གཞག་ - ཚོ་སྒྲིག་ - རྩོམ་སྒྲིག་ཚོ་སྒྲིག་\</emph\>\</defaultinline\>\</switchinline\>བརྒྱུད་ནས་ཚོ་ནང་གི་བྱ་ཡུལ་སོ་སོ་རྩོམ་སྒྲིག་བྱེད། རྩོམ་སྒྲིག་གྲུབ་རྗེས་ \<switchinline select=\"appl\"\>\<caseinline select=\"DRAW\"\>\<emph\>བཟོ་བཅོས་འདེམས་རོགས་གནང་ - ཚོ་སྒྲིག་ནས་ཐོན་ནས་\</emph\>\</caseinline\>\<defaultinline\>\<emph\>རྣམ་གཞག་ - ཚོ་སྒྲིག་ - ཚོ་སྒྲིག་ཕྱིར་ཐོན་\</emph\>\</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
