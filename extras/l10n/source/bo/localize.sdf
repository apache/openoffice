helpcontent2	source\text\shared\02\01170300.xhp	0	help	par_id3150347	2			0	bo	\<variable id=\"text\"\>\<ahelp hid=\".uno:TabDialog\"\>\<emph\>བརྗེ་རེས་གོ་རིམ་\</emph\>གླེང་སྒྲོམ་ནང་སྤྱོད་པོས་ Tab མཐེབ་གནོན་དུས་ཚོད་ཆས་ཡིག་དུམ་ལ་ཐོབ་པའི་མདོ་གནས་ཀྱི་གོ་རིམ་བཟོ་བཅོས་བྱེད། \</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170300.xhp	0	help	par_id3109850				0	bo	གལ་སྲིད་ཡིག་ཚགས་ནང་རེའུ་བྱང་གཞི་རྒྱུ་བསྒར་འཛུད་བྱེད་ན་\<item type=\"productname\"\>%PRODUCTNAME\</item\> ཡིས་རང་འགུལ་ངང་ Tab མཐེབ་སྤྱད་ནས་ཚོད་ཆས་ཤིག་ནས་ཚོད་ཆས་གཞན་ཞིག་ལ་འགྱུར་བའི་གོ་རིམ་གཏན་འཁེལ་བྱེད།  གབ་སྣོན་གསར་པ་བྱས་པའི་ཚོད་ཆས་ཁག་བརྒྱུད་གྲས་ཀྱི་མཇུག་མཐར་འཇོག  \<emph\>བརྗེ་རེས་གོ་རིམ་\</emph\>གླེང་སྒྲོམ་ནང་སྒེར་གྱི་དགོས་མཁོ་གཞིར་བཟུང་ནས་བརྒྱུད་གྲས་འདིའི་གོ་རིམ་ལེགས་སྒྲིག་བྱེད་དོ། 				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170300.xhp	0	help	par_id3155934				0	bo	ཚོད་ཆས་འདིའི་\<emph\>གཏོགས་གཤིས།\</emph\>གླེང་སྒྲོམ་ནང་  བརྒྱུད་ནས་\<link href=\"text/shared/02/01170101.xhp\" name=\"གོ་རིམ།\"\>\<emph\>གོ་རིམ།\</emph\>\</link\>ནང་དམིགས་འཛུགས་གཏོགས་གཤིས་ལ་ལྟོས་བཅས་ཀྱི་ཐང་ནང་འཇུག་བྱས་ནས་ཚོད་ཆས་ཀྱི་བཤེར་འདྲེན་མཚན་འཇོག་བྱེད། 				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170300.xhp	0	help	par_id3149760				0	bo	རྐྱང་འདེམས་གནོན་མཐེབ་གཅིག་འདེམས་ཐུབ་དུས་ Tab མཐེབ་སྤྱད་ནས་རྐྱང་འདེམས་གནོན་མཐེབ་འདི་ལ་འཚམས་འདྲི་བྱེད་ཐུབ།  གལ་ཏེ་ཇུས་འགོད་བྱས་པའི་རྐྱང་འདེམས་གནོན་མཐེབ་ཚོ་སྒྲིག་ནང་བདམས་པའི་གནས་སྟངས་སུ་གནས་པ་མེད་ཕྱིན་སྤྱོད་པོས་མཐེབ་གཞོང་བརྒྱུད་ཚོ་སྒྲིག་འདི་དང་ཡང་ན་དེའི་ནང་གི་རྐྱང་འདེམས་གནོན་མཐེབ་གང་རུང་ཞིག་ལ་འཚམས་འདྲི་བྱ་ཐབས་བྲལ།				2002-02-02 02:02:02
