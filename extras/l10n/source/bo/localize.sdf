helpcontent2	source\text\shared\00\00000005.xhp	0	help	par_id3155922				0	bo	ASCII ནི་ཨ་རིའི་ཆ་འཕྲིན་བརྗེ་ལེན་ཚད་གཞིའི་ཚབ་ཨང་གི་བསྡུས་མིང་ཡིན་ ASCII ནི་རྩིས་འཁོང་ནང་གི་ཡིག་རྟགས་མངོན་པའི་ཡིག་རྟགས་ཚོགས་ཤིག་ཡིན་དེ་ནི་ཡིག་འབྲུ་དང་གྲངས་ཀ་ཚད་ལྡན་རྟགས་ དམིགས་བསལ་ཀྱིས་མཚོན་པའི་ཡིག་རྟགས་128 ལས་གྲུབ་པ་ཞིག་ཡིན་ རྒྱ་སྐྱེད་ཀྱི་ASCII ཡིག་རྟགས་ཚོགས་ལ་ལ་ཡིག་རྟགས་ 256 ཚུད་ཡོད་ ཡིག་རྟགས་རེ་རེར་ཁ་གསལ་གྱི་ཨང་རེ་རེ་གཏན་འཁེལ་བཟོས་ཡོད་ ཨང་རིམ་དེ་ལའང་ ASCII ཚབ་ཨང་ཞེས་བརྗོད་དོ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000005.xhp	0	help	par_id3150823				0	bo	HTML ཡིག་ཆའི་ནང་ཤོག་ངོས་སྟེང་གནས་7གྱི་ ASCII ཡིག་རྟགས་ཚོགས་ཀྱི་ཡིག་རྟགས་ལས་ཐོན་པ་མེད་ ཡིག་རྟགས་གཞན་ དཔེར་ན་འཇར་པན་སྐད་ཀྱི་འགྱུར་བའི་དབྱངས་འགའ་ཞིག་བཅོས་འབྲི་བྱེད་ལས་མཚོན་ དཔེར་ན་ཡིག་ཆུང་ ü དེ་ <Ü>ལ་བསྒྱུར་བ་ལྟ་བུའོ།$[officename] ཕྱིར་བཏོན་བརྗེ་བསྒྱུར་ཆས་ཀྱི་རང་འགུལ་ངང་གྲུབ།				2002-02-02 02:02:02
