helpcontent2	source\text\scalc\01\func_now.xhp	0	help	par_id3150774				0	bo	 NOW()-A1 མཐེབ་མཇུག་དང་སྦྲགས་Enterམཐེབ་ལ་རྡེབ་གནོན་བྱས་རྗེས་A1དང་མིག་སྔའི་ཚེས་གྲངས་ཀྱི་བར་ཁྱད་གྲངས་ཐང་ཐོབ་ཐུབ།   དེ་རྗེས་བསྐྱར་དུ་འབྲས་བུའི་རྣམ་གཞག་གྲངས་ཀར་བསྒྱུར། 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3148664				0	bo	\<variable id=\"tabelletext\"\>\<ahelp hid=\".uno:Protect\"\>མིག་སྔའི་ལས་ཁྲའི་ནང་གི་དྲ་མིག་བཟོ་བཅོས་བྱ་མི་དགོས་པ་ལ་སྲུང་སྐྱོབ་བྱེད།  \</ahelp\>\</variable\> \<emph\>[བདེ་འཇགས།] - [ནང་དོན་སྲུང་སྐྱོབ།] - [ལས་ཁྲ།...]\</emph\>འདེམས་པ་དང་\<emph\>"ལས་ཁྲ་སྲུང་སྐྱོབ།"\</emph\>གླེང་སྒྲོམ་ཁ་ཕྱེ་བ་  ཁྱེད་ཀྱིས་དེའི་ནང་ལས་ཁྲར་གསང་ཨང་བེད་སྤྱོད་ཀྱིས་སྲུང་སྐྱོབ་དགོས་མིན་གཏན་འཁེལ་བྱ་ཐུབ།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3149664				0	bo	དྲ་མིག་ལ་རྩོམ་སྒྲིག་བྱ་རྒྱུ་བཀག་འགོག་བྱ་དགོས་ན་ ངེས་པར་དུ་\<link href=\"text/scalc/01/05020600.xhp\" name=\"རྣམ་གཞག་ - དྲ་མིག་ - དྲ་མིག་སྲུང་སྐྱོབ་\"\>\<emph\>[རྣམ་གཞག] - [དྲ་མིག...] - "དྲ་མིག་སྲུང་སྐྱོབ།"\</emph\>\</link\>འདེམས་གཞིའི་ཁཱ་ཤོག་ངོས་དེ་ད་དུང་གཡས་མཐེབ་ཚལ་ཐོའི་ནང་གི་\<emph\>"ཆིངས་བརྒྱབ་པའི་"\</emph\>བསྐྱར་འདེམས་སྒྲོམ་འདེམས་དགོས་ "དྲ་མིག་སྲུང་སྐྱོབ།"འདེམས་གཞིའི་ཁཱ་ཤོག་ངོས་དེ་ད་དུང་གཡས་མཐེབ་ཚལ་ཐོའི་ནང་གི་\<emph\>[དྲ་མིག་རྣམ་གཞག་བཀོད་སྒྲིག...]\</emph\>ཁ་ཕྱེ་དགོས།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3154490	8			0	bo	ཚལ་ཐོའི་\<emph\>[བདེ་འཇགས།] - [ནང་དོན་སྲུང་སྐྱོབ།] - [ལས་ཁྲ།...]\</emph\>དང་\<emph\>[བདེ་འཇགས་] - [ནང་དོན་སྲུང་སྐྱོབ་] - [དྲ་མིག་...]\</emph\>སྤྱད་ནས་སྲུང་སྐྱོབ་ཐོབ་པའི་ལས་ཁྲའི་ནང་དྲ་མིག་སུབ་པའམ་དྲ་མིག་ས་ཁོངས་ཀྱི་སྲུང་སྐྱོབ་སུབ་པར་བྱ་ཐུབ། 				2002-02-02 02:02:02
