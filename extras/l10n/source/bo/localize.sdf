helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3148649				0	bo	\<ahelp hid=\"HID_PROP_HELPURL\"\> URL སྦྱར་བྲིས་རྣམ་པས་འདྲེན་སྤྱོད་རོགས་རམ་ཀྱི་གཏན་འཁེལ་བྱེད་  ཤོག་བྱང་བཀོལ་སྤྱོད་སྐབས་དུས་མཚུངས་ཚོད་འཛིན་ཡིག་དུམ་གྱི་རོགས་རམ་འདི་བཀོལ་སྤྱོད་བྱེད།\</ahelp\>མདོ་གནས་ནི་ཚོད་འཛིན་ཡིག་དུམ་ཐོག་འཇོག་པ་མ་ཟད་ F1 མཐེབ་གནོན་ཚོད་འཛིན་ཡིག་དུམ་ཀྱི་་རོགས་རམ་འདི་ཁ་ཕྱེ་ཆོག				2002-02-02 02:02:02
