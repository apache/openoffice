uui	source\cookiedg.src	0	string	STR_COOKIES_RECV_START				295	bo	'${HOST}'ཞབས་ཞུའི་རྩིས་འཁོར་ལ་  Cookieགཅིག་གམ་ཡང་ན་དེ་ལས་མང་བ་སྒྲིག་བཀོད་བྱེད་དགོས། \nCookie ལ་དམིགས་གཏན་འཁེལ་བའི་URLརིགས་ཀྱི་འབྲེལ་ཡོད་ཆ་འཕྲིན་ཚུད་ཡོད།   གལ་ཏེ་%PRODUCTNAMEཡིས་རྗེས་སུ་ཡིག་ཚགས་ཤིག་རེ་བ་ཞུས་ནས་ཡིག་ཚགས་དེའི་URLདང་གོང་དུ་སྒྲིག་བཀོད་བྱས་པའི་Cookieགང་རུང་གི་རིགས་ཁ་གཏད་བྱས་ཡོད་ཚེ་%PRODUCTNAMEདེ་ཞབས་ཞུའི་རྩིས་འཁོར་ལ་ཆ་འཕྲིན་དེ་གཏོང་སྐྱེལ་བྱེད།  དེ་ལྟར་བྱས་ན་ཞབས་ཞུའི་རྩིས་འཁོར་གྱིས་WWWཡི་བཀོལ་སྤྱོད་བྱ་རིམ་གྱི་གནས་སྟངས（དཔེར་ན་དྲ་ཐོག་ཉོ་སྒྲུབ་བྱེད་སྐབས）དབྱེ་འབྱེད་བྱེད་ཐུབ།    \n\n  གཤམ་གྱི་Cookieསྒྲིག་བཀོད་བྱེད་དགོས་པ་སྟེ། \n\n				2002-02-02 02:02:02
