helpcontent2	source\text\swriter\01\02170000.xhp	0	help	par_id3152773				0	bo	\<ahelp visibility=\"visible\" hid=\"HID_REGION_TREE\"\>打开\<link href=\"text/swriter/01/05040501.xhp\" name=\"འདེམས་གཞི་\"\>\<emph\>"འདེམས་གཞི་"\</emph\>\</link\>གླིང་སྒྲོམ་ཁ་ཕྱེ་བའི་  དེ་ནང་འདེམས་ངེས་ས་ཁོངས་ཀྱི་ཚང་དབྱི་པར་དབྱིབས་དང་、རྒྱབ་ལྗོངས་、ཞབས་མཆན་དང་མཇུག་མཆན་རྩོམ་སྒྲིག་བྱས་ཆོག།\</ahelp\>གལ་ཏེ་ས་ཁོངས་གང་ཡང་བེད་སྤྱོད་ནས་སྲུང་སྐྱོབ་བྱེད་ནས་ངེས་པར་དུ་  གསང་ཨང་སྔོན་ལ་ནང་བཅུག་བྱེད།				2002-02-02 02:02:02
