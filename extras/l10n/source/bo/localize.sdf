helpcontent2	source\text\simpress\main0210.xhp	0	help	par_id3148610				0	bo	དུས་གཅིག་ལ་བྱ་ཡུལ་མང་པོ་འདེམས་དགོས་པའི་སྐབས་ Shift མཐེབ་གནོན་ཟིན་བྱས་ན་བྱ་ཡུལ་ཚང་མ་མཉམ་དུ་འདེམས་ཐུབ།				2002-02-02 02:02:02
helpcontent2	source\text\simpress\main0210.xhp	0	help	par_id3148699				0	bo	གལ་ཏེ་བྱ་ཡུལ་གཞན་གྱི་རྒྱབ་ལ་གནས་པའི་བྱ་ཡུལ་བདམས་ན་ \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>འདེམས་གཞི་\</caseinline\>\<defaultinline\>Alt\</defaultinline\>\</switchinline\>མཐེབ་གནོན་ཟིན་མ་ཟད་བྱ་ཡུལ་དེ་རྐྱང་རྡེབ་ \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>འདེམས་གཞི་\</caseinline\>\<defaultinline\>Alt\</defaultinline\>\</switchinline\> ནང་གི་གཤམ་གྱི་མཐའ་རིམ་བྱ་ཡུལ་འདེམས་དགོས་ན་ Shift + \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>འདེམས་གཞིའི་\</caseinline\>\<defaultinline\>Alt\</defaultinline\>\</switchinline\>མཐེབ་གནོན་ཟིན་མ་ཟད་ཡང་བསྐྱར་རྐྱང་རྡེབ་འདེམས་ངེས་པའི་སྔོན་གྱི་བྱ་ཡུལ་ཡང་བསྐྱར་འདེམས་དགོས་ན་ Shift + MACའདེམས་གཞི་གནོན་མཐེབ་ཟིན་རྗེས་རྐྱང་རྡེབ།				2002-02-02 02:02:02
helpcontent2	source\text\simpress\main0210.xhp	0	help	par_id3154651				0	bo	རྩོམ་སྒྲིག་ཡོ་བྱད་མང་ཆེ་བ་སྔོན་ལ་བདམས་ཚར་བའི་བྱ་ཡུལ་ལ་ནུས་པ་ཡོད་   བདམས་ཚར་བའི་བྱ་ཡུལ་ཚོད་འཛིན་ཚེག་ཆུང་བརྒྱད་རྒྱུད་ནས་མངོན་   བདམས་ཚར་བའི་བྱ་ཡུལ་ཆ་རྡེབ་རྗེས་  ཁྱེད་ཀྱི་བྱ་ཡུལ་དེ་དང་ཐག་སྦྲེལ་གྱི་ཡིག་དེབ་གཅིག་ནང་འཇུག་བྱས་ཆོག་  བདམས་ཟིན་བྱ་ཡུལ་ཕུད་པའི་གནས་ས་ཞིག་ལ་རྡེབ་གནོན་བྱས་ན་བྱ་ཡུལ་དེ་བདམས་པ་གཙང་སེལ་བྱེད་ཐུབ།				2002-02-02 02:02:02
