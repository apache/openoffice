helpcontent2	source\text\shared\01\06050500.xhp	0	help	par_id3150495	30			0	bo	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<ahelp hid=\"SVX:LISTBOX:RID_SVXPAGE_NUM_OPTIONS:LB_CHARFMT\"\>ཨང་སྒྲིག་རེའུ་འགོད་ནང་བེད་སྤྱོད་པའི་ཡིག་རྟགས་བཟོ་ལྟ་འདེམས།\</ahelp\>\<link href=\"text/swriter/01/05130002.xhp\" name=\"ཡིག་རྟགས་བཟོ་ལྟ།\"\>ཡིག་རྟགས་བཟོ་ལྟ།\</link\>གསར་བཟོ་འམ་ཡང་ན་རྩོམ་སྒྲིག་བྱེད་ན་ \<emph\>"རིགས་སྣ་ཚོགས་ཀྱི་བཟོ་ལྟ།"\</emph\>མཐོང་རིས་ཁ་ཕྱེ་ "ཡིག་རྟགས་བཟོ་ལྟ།"ཡི་རིས་རྟགས་ལ་རྐྱང་རྡེབ་བྱེད་དེ་ བཟོ་ལྟ་ཞིག་ལ་གཡོན་མཐེབ་རྐྱང་རྡེབ་བྱས་ནས་ དེ་རྗེས་\<emph\>[གསར་བཟོ།...]\</emph\>འདེམས།\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
