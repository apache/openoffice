helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3154730	79			0	bo	\<variable id=\"ignore\"\>\<emph\>IgnoreAllList (All)\</emph\> སྦྱོར་འབྲིའི་བརྟག་དཔྱད་བརྒྱུད་རིམ་ནང་\<emph\>སྣང་མེད་\</emph\>དུ་འཇོག་པའི་རྟགས་འགོད་ཀྱི་ཡིག་ཚིག་ཡོད་ཚད་ཚུད་པ།  རེའུ་འགོད་འདི་ནི་དོ་དམ་བརླག་བདེ་བའི་རང་བཞིན་ RAM ནང་གི་མིག་སྔའི་སྦྱོར་འབྲིའི་བརྟག་དཔྱད་ཁོ་ནར་སྤྱོད་པའོ།   སྤྱོད་པོའི་གཞི་གྲངས་འགའ་ཞིག་ནི་བྱ་རིམ་སྒུལ་སློང་བྱེད་པའི་སྐབས་རེའུ་འགོད་འདིའི་ནང་སྣོན། \<emph\>IgnoreAllList (All)\</emph\> དོར་མི་རུང་། \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3154757				0	bo	གཤར་བྱང་ \<emph\>IgnoreAllList\</emph\> ནི་ངེས་པར་དུ་འདེམས་དགོས་པ་དང་དོར་མི་ཆོག  ནང་དོན་དུ་བརྩིས་ནས་ཁ་སྣོན་བྱས་པའི་ཡི་གེ་ནི་ད་གཟོད་དོར་ཆོག  འདི་ནི་$[officename] མཇུག་བསྒྲིལ་རིམ་བཞིན་རང་འགུལ་གྱི་ལག་བསྟར་བྱེད།				2002-02-02 02:02:02
