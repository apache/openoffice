helpcontent2	source\text\shared\main0227.xhp	0	help	par_id3148420				0	bo	\<ahelp hid=\".uno:BezierConvert\"\>ཁྱོག་ཐིག་དེ་དྲང་ཐིག་ལ་བསྒྱུར་བའམ་དྲང་ཐིག་དེ་འཁྱོག་ཐིག་ལ་བརྗེ་བསྒྱུར་བྱ།\</ahelp\>གལ་ཏེ་ཚེག་ཅིག་འདེམས་ན་ཚེག་དེའི་མདུན་གྱི་འཁྱོག་ཐིག་བརྗེ་བསྒྱུར་བྱེད། གལ་ཏེ་ཚེག་གཉིས་འདེམས་ན་ཚེག་གཉིས་བར་གྱི་འཁྱོག་ཐིག་ལ་བརྗེ་བསྒྱུར་བྱེད། གལ་ཏེ་ཚེག་གཉིས་ཡན་འདེམས་ན་རིས་རྟགས་ལ་རྐྱང་རྡེབ་བྱ་ཐེངས་རེར་འཁྱོག་ཐིག་གི་ཆ་ཤས་ཤིག་ལ་བརྗེ་བསྒྱུར་བྱེད། དགོས་པ་ཡོད་ན་སྒོར་འདྲེད་ཀྱི་མཐུད་ཚེག་དེ་ཟུར་ཚེག་ལ་བསྒྱུར་བ་དང་ཡང་ན་ཟུར་ཚེག་དེ་སྒོར་འདྲེད་ཀྱི་མཐུད་ཚེག་ལ་བརྗེ་བསྒྱུར་བྱེད།				2002-02-02 02:02:02
