helpcontent2	source\text\shared\02\01170600.xhp	0	help	par_id3149760				0	bo	\<ahelp hid=\".uno:ShowFmExplorer\"\>\<emph\>རེའུ་བྱང་ལས་རོགས།\</emph\>ཁ་འབྱེད། \<emph\>རེའུ་བྱང་ལས་རོགས།\</emph\>ནང་མིག་སྔའི་ཡིག་ཚགས་ཀྱི་རེའུ་བྱང་ཡོད་ཚད་དང་ཡན་ལག་རེའུ་བྱང་དེ་བཞིན་ཁག་སོ་སོར་ལྡན་པའི་ཚོད་ཆས་ཁག་མངོན་པར་བྱེད། \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170600.xhp	0	help	par_id3147399				0	bo	རེའུ་བྱང་མང་པོ་བེད་སྤྱོད་བྱེད་དུས་[རེའུ་བྱང་ལས་རོགས།] རེའུ་བྱང་ཡོད་ཚད་ཀྱི་རགས་མཐོང་སྤྲད་  ད་དུང་རེའུ་བྱང་འདི་དག་རྩོམ་སྒྲིག་བྱེད་པར་བྱེད་ནུས་ཁག་མདོ་འདོན་བྱས།  				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170600.xhp	0	help	par_id3155552				0	bo	\<ahelp hid=\"HID_FORM_NAVIGATOR\"\>\<emph\>རེའུ་བྱང་ལས་རོགས་\</emph\>ནང་རེའུ་འགོད་གཅིག་ལྡན་ཡོད་  དེའི་ནང་སྒྲིག་པའི་གསར་འཛུགས་རེའུ་བྱང་(གཏན་ཚིགས་)ཡོད་ཚད་དམ་དེའི་ལྟོས་ཟླའི་ཚོད་ཆས་ཡིག་དུམ་སྒྲིག་པར་བྱེད། \</ahelp\>ཚོད་ཆས་ཡིག་དུམ་གྱི་རེའུ་བྱང་གཤར་བྱང་མདུན་དུ་ལྡན་པའི་སྣོན་རྟགས་མངོན་པར་བྱེད།  སྣོན་རྟགས་ལ་རྐྱང་རྡེབ་བྱས་ན་རེའུ་བྱང་གཞི་རྒྱུ་རེའུ་འགོད་བྱེད། 				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170600.xhp	0	help	par_id3155892				0	bo	\<emph\>རེའུ་བྱང་ལས་རོགས་\</emph\>ནང་མིང་རྩོམ་སྒྲིག་བྱེད་དུས་ཁྱེད་ཀྱིས་ལྟོས་བཅས་ཀྱི་མིང་ལ་རྐྱང་རྡེབ་བྱེད་པ་མ་ཟད་མིང་གསར་པ་ནང་འཇུག་གྱིས་   ཡང་ན་གཡས་མཐེབ་ཚལ་ཐོའི་ནང་གི་བཀའ་ཚིག་བེད་སྤྱོད་གྱིས།				2002-02-02 02:02:02
