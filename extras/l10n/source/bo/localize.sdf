helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3159125	11			0	bo	\<ahelp hid=\".uno:Bib/query\"\>འཚོལ་དགོས་པའི་ཆ་འཕྲིན་ནང་འཇུག་བྱ་བ་དང་དེ་རྗེས་ Enter མཐེབ་གནོན་བྱེད་ འཚོལ་དགོས་པའི་འཚགས་འདེམས་འདེམས་གཞི་བཟོ་བཅོས་བྱ་དགོས་ན་དལ་བུས་\<emph\>"རང་འགུལ་འཚགས་འདེམས་"\</emph\>རིས་རྟགས་ དེ་རྗེས་གཞི་གྲངས་མིང་ཡིག་དུམ་འདེམས་རོགས་ འཚོལ་བའི་ནང་ཀུན་འཕྲོད་རྟགས་ % ཡང་ན་ * སྤྱད་ནས་རྐྱང་རྡེབ་བྱ་ དེ་རྗེས་གཞི་གྲངས་རིགས་འདེམས་རིགས་འཚོལ་བའི་ནང་ཀུན་འཕྲོད་རྟགས་% སམ་ * སྤྱད་ནས་རྐྱང་རྡེབ་བྱ་ དེ་རྗེས་ Enter མཐེབ་གནོན་བྱེད།\</ahelp\>				2002-02-02 02:02:02
