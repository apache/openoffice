helpcontent2	source\text\sbasic\shared\03120301.xhp	0	help	par_id3149481				0	bo	\<emph\>E- E+ e- e+  \</emph\>གལ་སྲིད་རྣམ་གཞག་ཚབ་ཡང་ཁྲོད་རྟགས་ E- E+ e- འམ་ e+ བཅས་ཚུད་པ་མ་ཟད་རྟགས་ཀྱི་གཡོན་དུ་ཉུང་མཐར་གནས་གཅིག་གི་གནས་འཛིན་རྟགས་ (0 ཡང་ན་ #)གྲངས་ཀའི་རྣམ་གཞག་ཅན་ཉིད་ཚན་རིག་གི་གྲངས་བགྲང་ཐབས་སམ་སྟོན་གྲངས་རྣམ་གཞག་དུ་གྱུར་ མ་ཟད་གྲངས་ཀ་དང་སྟོན་གྲངས་བར་ཡིག་འབྲུ་ E འམ་ eབསྒར་འཛུད་བྱ་དགོས་ སྟོན་གྲངས་ཀྱི་གྲངས་གནས་ནི་རྟགས་ཀྱི་གཡོན་དུ་ཡོད་པའི་གནས་འཛིན་རྟགས་ཀྱི་གྲངས་གནས་ཀྱི་གཏན་འཁེལ་བཟོས།				2002-02-02 02:02:02
