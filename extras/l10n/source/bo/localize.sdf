helpcontent2	source\text\shared\02\12100200.xhp	0	help	par_id3147588				0	bo	\<variable id=\"suchentext\"\>\<ahelp hid=\".uno:RecSearch\" visibility=\"hidden\"\>གཞི་གྲངས་མཛོད་རེའུ་མིག་དང་རེའུ་བྱང་བཤེར་འཚོལ་བྱེད་པ།\</ahelp\>རེའུ་བྱང་ངམ་གཞི་གྲངས་མཛོད་རེའུ་མིག་ནང་ཁྱེད་ཀྱིས་གཞི་གྲངས་ཡིག་དུམ་དང་ རེའུ་འགོད་སྒྲོམ་ བསྐྱར་འདེམས་སྒྲོམ་ཡོད་ཚད་ནང་དམིགས་འཛུགས་ཀྱི་ཐང་བཤེར་འཚོལ་བྱེད་པ།   \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12100200.xhp	0	help	par_id3149355				0	bo	རེའུ་མིག་བཤེར་འཚོལ་སྐབས་ བཤེར་འཚོལ་ཁྱབ་ཁོངས་ནི་མིག་སྔའི་རེའུ་མིག་གི་གཞི་གྲངས་ཡིག་དུམ་ཡིན།  རེའུ་འགོད་བཤེར་འཚོལ་སྐབས་བཤེར་འཚོལ་ཁྱབ་ཁོངས་ནི་རེའུ་འགོད་འདི་དང་ཐག་སྦྲེལ་གྱི་རེའུ་མིག་གི་གཞི་གྲངས་ཡིག་དུམ་ཡིན་ནོ།  				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12100200.xhp	0	help	par_id3153394				0	bo	འདིར་བཀོད་འབྲི་བྱས་པའི་བཤེར་འཚོལ་ནི་ \<item type=\"productname\"\>%PRODUCTNAME\</item\>གྱིས་ལག་བསྟར་བྱེད།  གལ་སྲིད་ SQL ཞབས་ཞུ་ཆས་སྤྱད་ནས་གཞི་གྲངས་མཛོད་བཤེར་འཚོལ་དགོས་ན་\<link href=\"text/shared/02/12110000.xhp\" name=\"རེའུ་བྱང་ཚང་།\"\>རེའུ་བྱང་ཚང་།\</link\>སྟེང་གི་\<link href=\"text/shared/main0213.xhp\" name=\"རེའུ་བྱང་ཚུལ་གྱི་འཚག་ཆས།\"\>རེའུ་བྱང་ཚུལ་གྱི་འཚག་ཆས།\</link\>རིས་རྟགས་སྤྱོད་དགོས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12100200.xhp	0	help	par_id3149095				0	bo	བཤེར་འཚོལ་བྱེད་ནུས་ཡང་རེའུ་མིག་ཚོད་ཆས་ལ་སྤྱད་ཆོག   རེའུ་མིག་ཚོད་ཆས་ནང་ནས་བཤེར་འཚོལ་བྱེད་ནུས་བཀོལ་སྤྱོད་བྱེད་པའི་སྐབས་རེའུ་མིག་ཚོད་ཆས་ཀྱི་སྟར་པ་ཡོད་ཚད་བཤེར་འཚོལ་ཐུབ་  སྟར་པ་འདི་དག་དང་ཐག་སྦྲེལ་གྱི་གཞི་གྲངས་མཛོད་རེའུ་མིག་གི་གཞི་གྲངས་མཛོད་ཀྱི་སྟར་པ་ཕན་ཚུན་ལྟོས་ཟླར་འགྱུར།    				2002-02-02 02:02:02
