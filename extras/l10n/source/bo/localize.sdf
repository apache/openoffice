helpcontent2	source\text\shared\02\12070000.xhp	0	help	par_id3143284				0	bo	\<ahelp hid=\".uno:SbaBrwInsert\"\>\<variable id=\"datenintext\"\>རྟགས་འཁོད་ཀྱི་ཟིན་ཐོའི་ཡིག་དུམ་ཡོད་ཚད་མིག་སྔའི་ཡིག་ཚགས་ནང་གི་འོད་རྟགས་གནས་ཡུལ་དུ་བསྒར་འཛུད་བྱེད། \</variable\>\</ahelp\> མིག་སྔའི་ཡིག་ཚགས་དེ་ཉིད་ཡི་གེ་ལས་སྣོན་ཡིག་ཚགས་སམ་ལས་དེབ་ཁོ་ན་ཡིན་པའི་སྐབས་རིས་རྟགས་འདི་ཉིད་ད་གཟོད་མཐོང་ཐུབ།  				2002-02-02 02:02:02
