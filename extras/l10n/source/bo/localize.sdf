helpcontent2	source\text\shared\guide\dragdrop_table.xhp	0	help	par_id3149827				0	bo	གལ་ཏེ་བདམས་པའི་ས་ཁོངས་དགོས་ཁོ་ཡོད་ན་ ཁྱེད་ཀྱིས་ཙིག་རྟགས་སྟོན་མདའ་བདམས་པའི་ས་ཁོངས་ནང་འཇོག་པ་དང་ ཙིག་རྟགས་གནོན་མཐེབ་གནོན་འཛིན་པ་མ་ཟད་ཙིག་རྟགས་གནོན་འཛིན་ཐག་ཏེ་དུས་ཚོད་གང་འཚམ་ཞིག་རེ་སྒུག་བྱེད་ དེ་རྗེས་ས་ཁོངས་ཡིག་གེ་ལས་སྣོན་ཡིག་ཚགས་ནང་སྒུལ་བྱེད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\dragdrop_table.xhp	0	help	par_id3152780	32			0	bo	\<switchinline select=\"sys\"\> \<caseinline select=\"WIN\"\>གལ་ཏེ་ཡིག་ཚགས་འདི་དག་དུས་གཅིག་ཏུ་མཐོང་མ་ཐུབ་ན་ སྔོན་ལ་ཙིག་རྟགས་སྟོན་མདའ་དམིགས་འབེན་ཡིག་ཚགས་ཀྱི་གནོན་མཐེབ་ཐིག་འདྲུད་སྐྱེལ་བྱེད་ དེ་མུ་མཐུད་ཙིག་རྟགས་མཐེབ་གནོན་འཛིན་བྱེད་ དམིགས་ལེན་ཡིག་ཚགས་ཆབས་ཅིག་མངོན་ཐུབ་ འདིའི་སྐབས་ཡིག་ཚགས་འདིའི་ནང་ཙིག་རྟགས་སྟོན་མདའ་སྤོ་སྒུལ་བྱེད།\</caseinline\> \</switchinline\>				2002-02-02 02:02:02
