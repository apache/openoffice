helpcontent2	source\text\shared\optionen\01040200.xhp	0	help	par_id3154944				0	bo	བེད་སྤྱོད་བྱས་ཆོག་\<link href=\"text/swriter/02/18120000.xhp\" name=\"རིས་དབྱིབས་གབ་པ།\"\>\<emph\>"རིས་དབྱིབས་གབ་པ།"\</emph\>\</link\>རིས་རྟགས་པར་རིས་ཀྱི་མངོན་ཚུལ་ཚོད་འཛིན་པ།    གལ་སྲིད་ཡི་གེ་ལས་སྣོན་ཡིག་ཚགས་ཁ་ཕྱེ་ཡོད་ན་རིས་རྟགས་འདི་ཉིད་\<emph\>[ཡོ་བྱད་ཚང་གཙོ་བོའི།]\</emph\>ཐོག་མངོན་པ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01040200.xhp	0	help	par_id3146898	39			0	bo	གལ་སྲིད་པར་རིས་བྱ་ཡུལ་\<emph\>"པར་རིས་བྱ་ཡུལ།"\</emph\>འདེམས་གཞི་  བདམས་མེད་ན་དབྱིན་ཐ་དྲ་ཐོག་ནས་རིས་གཟུགས་གང་ཡང་བླུགས་ཐབས་མེད།  གལ་སྲིད་མིག་བཤར་གྱི་ཤོག་ངོས་ཐོག་ HTML ཚད་གཞི་ཪྙིང་པ་བེད་སྤྱད་ན་རེའུ་མིག་ནང་ཆེ་ཆུང་གཏན་འཁེལ་མེད་པའི་རིས་གཟུགས་ཀྱིས་མངོན་ཚུལ་ལ་འགོག་དོན་བཟོས།				2002-02-02 02:02:02
