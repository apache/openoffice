helpcontent2	source\text\shared\explorer\database\05020000.xhp	0	help	par_id3149168				0	bo	གལ་ཏེ་རེའུ་མིག་དེ་འདྲ་བའི་བར་འབྲེལ་བ་མཚན་འཇོག་བྱེད་ན་ \<link href=\"text/shared/00/00000005.xhp#primaerschluessel\" name=\"འགག་གནད་ཡི་གེ་གཙོ་བོ།\"\>འགག་གནད་ཡི་གེ་གཙོ་བོ།\</link\>ནང་འཇུག་བྱེད་ཁ་གསལ་གོང་ནས་ད་ཡོད་རེའུ་མིག་གི་གཞི་གྲངས་ཡིག་དུམ་ཞིག་རྟགས་འགོད་པ་བྱེད།  དེ་རྗེས་རེའུ་མིག་གཞན་པའི་ནང་ནས་འགག་གནད་ཡི་གེ་གཙོ་བོ་འདི་ཀློག་ལེན་བྱས་པ་བརྒྱུད་རེའུ་མིག་ནང་གི་གཞི་གྲངས་འདྲེན་སྤྱོད་བྱེད་  འདྲེན་སྤྱོད་བྱས་པའི་འགག་གནད་གཙོ་བོའི་གཞི་གྲངས་ཡིག་དུམ་ཕྱི་་ཁུལ་གྱི་འགག་གནད་ཡིག་གེ་བྲིས་རྟགས་འགོད་པར་བྱེད།				2002-02-02 02:02:02
