helpcontent2	source\text\shared\04\01010000.xhp	0	help	par_id3154749				0	bo	འདྲུད་འཇོག་སྤྱད་དེ་ཙིག་རྟགས་བརྒྱུད་གདམ་ང་བྱས་པའམ་བྱ་ཡུལ་དང་མིང་ལ་རྐྱང་རྡེབ་བྱས་པའི་སྐབས་ Shift、\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>བཀའ་ཚིག་\</caseinline\>\<defaultinline\>Ctrl \</defaultinline\>\</switchinline\> དང་\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>འདེམས་གཞི་\</caseinline\>\<defaultinline\> Alt\</defaultinline\>\</switchinline\>(སྐབས་འགར་སྤྱོད་)སོགས་ཀྱི་མཐེབ་སྤྱད་ནས་ཟུར་སྣོན་བྱེད་ནུས་མཐེབ་འདི་དག་གནོན་འཛིན་གྱིས་འདྲུད་འཇོག་བྱེད་པའི་སྐབས་བཟོ་བཅོས་བྱེད་ནུས་མཁོ་འདོན་དགོས་མིན་ནི་ཙིག་རྟགས་སྟོན་མདའི་དབྱིབས་ཀྱི་འགྱུར་བ་ལ་རགས་ལུས་  ཡིག་ཆའམ་བྱ་ཡུལ་གཞན་འདེམས་སྐབས་བཟོ་བཅོས་མཐེབ་ཀྱིས་གདམ་ང་རྒྱ་ཆེར་བཏང་ཆོག།  བྱེད་ནུས་འདི་དག་འོས་འཚམས་ཀྱི་གནས་སུ་ངོ་སྤྲོད་ཞུ། \<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>\<embedvar href=\"text/shared/00/00000099.xhp#winmanager\"/\>\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
