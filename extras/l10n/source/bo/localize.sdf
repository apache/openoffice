helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149711				0	bo	\<ahelp hid=\"HID_FUNC_SPALTE\"\>དྲ་མིག་འདྲེན་སྤྱོད་ཀྱི་ཕྲེང་རྟགས་སུ་ཕྱིར་ལོག་པ།\</ahelp\> གལ་སྲིད་འདྲེན་སྤྱོད་བྱས་པ་ནི་དྲ་མིག་ཅིག་ཡིན་ན་ རྟེན་གྲངས་ཕྱིར་ལོག་པ་ནི་དྲ་མིག་གི་ཕྲེང་རྟགས་ཡིན།  གལ་སྲིད་ཞུགས་གྲངས་ནི་དྲ་མིག་གི་ས་ཁོངས་ཤིག་ཡིན་ན་ཕྲེང་རྐྱང་པ་ཞིག་གི་ཐོག་ནས་\<link href=\"text/scalc/01/04060107.xhp#wasmatrix\" name=\"ལིང་ཚེ།\"\>ལིང་ཚེ།\</link\>ལྟོས་ཟླའི་ཕྲེང་རྟགས་སུ་ཕྱིར་ལོག  གལ་སྲིད་རྟེན་གྲངས་སྤྱི་བགྲོས་\<link href=\"text/scalc/01/04060107.xhp#somatrixformel\" name=\"ལིང་ཚེ་སྤྱི་འགྲོས་སུ་བཞག་པ།\"\>ལིང་ཚེ་སྤྱི་འགྲོས་སུ་བཞག་པ།\</link\>བེད་སྤྱད་ནས།   གལ་སྲིད་རྟེན་གྲངས་ COLUMN གྱིས་འདྲེན་སྤྱོད་བྱས་པ་ནི་དྲ་མིག་ཁྱབ་ཁོངས་ཤིག་ཡིན་ལ་རྟེན་གྲངས་ཉིད་ལིང་ཚེ་སྤྱི་འགྲོས་སུ་བཞག་ནས་སྤྱད་པ་མ་ཡིན་ན་ཁྱབ་ཁོངས་ནང་གི་དྲ་མིག་དང་པོའི་ཕྲེང་རྟགས་སུ་ཕྱིར་ལོག་ཁོ་ན་ཡོད།				2002-02-02 02:02:02
