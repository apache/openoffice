helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3152349				0	bo	\<ahelp hid=\"SW:LISTBOX:DLG_AP_INSERT_DB_SEL:LB_DBFMT_FROM_USR\"\>གལ་སྲིད་དམིགས་འཛུགས་ཀྱི་གཞི་གྲངས་ཡིག་དུམ་ཀྱི་རྣམ་གཞག་ཆ་འཕྲིན་དང་ལེན་མ་བྱས་ན་རེའུ་འགོད་ནང་ནས་རྣམ་གཞག་གཏན་འཁེལ་བྱེད།\</ahelp\>འདིར་མཁོ་འདོན་བྱས་པའི་རྣམ་གཞག་ནི་དམིགས་འཛུགས་ཀྱི་གཞི་གྲངས་མཛོད་ཡིག་དུམ་ཁོ་ནར་སྤྱོད་པ།  དཔེར་ན་ཨང་ཀིའམ་པོ་ལེན་ཡིག་དུམ་ལྟ་བུའོ།  གལ་སྲིད་©ཡིག་དེབ་རྣམ་གཞག་ནི་གཞི་གྲངས་མཛོད་­དུམ་བུ་བདམས་ན་བདམས་ངའི་རེའུ་འགོད་ནང་ནས་རྣམ་གཞག་ཅི་ཡང་འདེམས་ཐབས་བྲལ་  རྒྱུ་མཚན་ནི་རང་འགུལ་གྱིས་ཡིག་དེབ་རྣམ་གཞག་སྲུང་སྐྱོབ་བྱེད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3144511				0	bo	གལ་སྲིད་ཁྱེད་ལ་དགོས་པའི་རྣམ་གཞག་ད་དུང་སྒྲིག་མེད་ན་གཤར་བྱང་"རྣམ་གཞག་གཞན།..."བདམས་ནས་གླེང་སྒྲོམ་\<link href=\"text/shared/01/05020300.xhp\" name=\"གྲངས་ཀྱི་རྣམ་གཞག\"\>\<emph\>གྲངས་ཀྱི་རྣམ་གཞག\</emph\>\</link\>ནང་དགོས་སྙམ་པའི་རྣམ་གཞག་མཚན་འཇོག་བྱ་དགོས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3154282				0	bo	རེའུ་འགོད་བདམས་ང་བྱས་པ་བརྒྱུད་གྲངས་ཀའི་རྣམ་གཞག་མཚན་འཇོག་བྱས་པ་ནི་རྟག་ཏུ་རེའུ་འགོད་སྒྲོམ་\<emph\>གཞི་གྲངས་མཛོད་སྟར་པའི་\</emph\>ནང་ནས་བདམས་པའི་གཞི་གྲངས་མཛོད་ཡིག་དུམ་ལ་དམིགས་པ་ཡིན། 				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3154138				0	bo	རེའུ་མིག་གི་རྣམ་པའི་ཐོག་ནས་གཞི་གྲངས་ཉིད་ཡིག་ཚགས་ནང་བསྒར་འཛུད་བྱ་དགོས་ཚེ་ངེས་པར་དུ་\<emph\>རེའུ་མིག་\</emph\>འདེམས་གཞི་སྤྱོད་པ་དང་  དེ་རྗེས་\<emph\>རེའུ་མིག་སྟར་པ་\</emph\>རེའུ་འགོད་སྒྲོམ་ནང་ནས་གཞི་གྲངས་མཛོད་ཡིག་དུམ་བདམས་ནས་དེའི་རྣམ་གཞག་ལ་མཚན་འཇོག་བྱའོ།  གྲངས་ཀྱི་རྣམ་གཞག་ལ་ལག་བསྟར་དགོས་པའི་བཟོ་བཅོས་ཉིད་མཇུག་མཐར་བདམས་ང་བྱས་པའི་གཞི་གྲངས་ཡིག་དུམ་བར་སྤྱད་ འོན་ཀྱང་བདམས་པའི་གཞི་གྲངས་མཛོད་ཡིག་དུམ་ནི་ \<emph\>གཞི་གྲངས་མཛོད་ཚང་ནང་ནས་བྱུང་བའམ་ཡང་ན་\</emph\>\<emph\>རེའུ་མིག་སྟར་པ་\</emph\>རེའུ་འགོད་སྒྲོམ་ནང་བྱུང་བ་གཉིས་དབར་འབྲེལ་བ་མེད།				2002-02-02 02:02:02
