helpcontent2	source\text\shared\02\01170000.xhp	0	help	par_id3148394				0	bo	གལ་སྲིད་ཡིག་ཚགས་ནང་ཚོ་སྒྲིག་སྒྲོམ་བསྒར་འཛུད་བྱེད་ན་\<link href=\"text/shared/autopi/01120000.xhp\" name=\"གཞི་རྒྱུའི་རང་འགུལ་ཡིག་ཆའི་ལས་རོགས།\"\>ཚོ་དབྱེའི་གཞི་རྒྱུའི་ཕྱོགས་སྟོན།\</link\>སྒུལ་སློང་བྱེད་  ཁྱེད་ཀྱིས་དལ་ལྷོའི་ངང་ནས་འདེམས་གཞི་ཚོ་གཅིག་གསར་བཟོ་བྱེད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170000.xhp	0	help	par_id3150567				0	bo	\<emph\>དོ་སྣང་ \</emph\>གལ་སྲིད་ཚོ་སྒྲོམ་ཞིག་ད་ཡོད་ཀྱི་ཚོད་ཆས་ཐོག་འདྲུད་སྒུལ་བྱེད་པ་མ་ཟད་ ཚོད་ཆས་ཞིག་འདེམས་འདོད་ན་  ཁྱེད་ཀྱིས་ངེས་པར་དུ་སྔོན་ལ་ཚོ་སྒྲོམ་གྱི་གཡས་མཐེབ་ཚལ་ཐོའི་ཁ་ཕྱེ་བ་དང་དེ་རྗེས་\<emph\>སྟར་འགོད་ - མཐིང་ལ་འཇོག་པ་འདེམས་\</emph\> མུ་མཐུད་\<switchinline select=\"sys\"\> \<caseinline select=\"MAC\"\>བཀའ་ཚིག་\</caseinline\> \<defaultinline\>Ctrl\</defaultinline\> \</switchinline\> གནོན་འཛིན་དང་དུས་མཚུངས་ཚོད་ཆས་འདེམས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170000.xhp	0	help	par_id3145615				0	bo	ཚོ་སྒྲོམ་ནི་མཐོང་ཚོར་ཕན་འབྲས་སྤྱོད་མཚན་འཇོག མིང་བརྒྱུད་འདེམས་གཞིའི་ཡིག་དུམ་བྱེད་ནུས་ཚོ་སྒྲིག་བྱེད་ འདེམས་གཞིའི་ཡིག་དུམ་ཡོད་ཚད་ཀྱི་\<link href=\"text/shared/02/01170101.xhp\" name=\"མིང་།\"\>\<emph\>མིང་།\</emph\>\</link\>གཏོགས་གཤིས་ནང་མིང་འདྲ་བ་ནང་འཇུག་བྱེད།				2002-02-02 02:02:02
