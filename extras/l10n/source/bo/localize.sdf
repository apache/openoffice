helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154564				0	bo	\<ahelp hid=\"HID_FUNC_ZEILE\"\>དྲ་མིག་འདྲེན་སྤྱོད་ཀྱི་ཕྲེང་རྟགས་ཕྱིར་ལོག་པ། \</ahelp\>གལ་སྲིད་འདྲེན་སྤྱོད་བྱས་པ་ནི་དྲ་མིག་ཡིན་ན་ རྟེན་གྲངས་ཉིད་དྲ་མིག་གི་ཕྲེང་རྟགས་སུ་ཕྱིར་ལོག  གལ་སྲིད་འདྲེན་སྤྱོད་བྱས་པ་ནི་དྲ་མིག་ཁྱབ་ཁོངས་ཡིན་ན་སྟར་པ་རྐྱང་པ་ཞིག་གི་\<link href=\"text/scalc/01/04060107.xhp#wasmatrix\" name=\"ལིང་ཚེ།\"\>ལིང་ཚེ།\</link\> ནང་ལྟོས་ཟླའི་ཕྲེང་རྟགས་ཕྱིར་ལོག་(གལ་སྲིད་སྤྱི་འགྲོས་ནི་\<link href=\"text/scalc/01/04060107.xhp#somatrixformel\" name=\"ལིང་ཚེ་སྤྱི་འགྲོས་སུ་བཞག་པ།\"\>ལིང་ཚེ་སྤྱི་འགྲོས་སུ་བཞག་པ།\</link\>ནང་འཇུག་བྱས་ན་)གལ་སྲིད་ ROW རྟེན་གྲངས་ཀྱིས་འདྲེན་སྤྱོད་ནི་དྲ་མིག་ཁྱབ་ཁོངས་ཤིག་ཡིན་པ་དང་རྟེན་གྲངས་དེ་ལིང་ཚེ་སྤྱི་འགྲོས་སུ་བཞག་པ་ནང་འཇུག་མ་བྱས་ན་རྒྱབ་ཁོངས་ནང་གི་དྲ་མིག་དང་པོའི་ཕྲེང་རྟགས་ཁོ་ན་ཕྱིར་ལོག				2002-02-02 02:02:02
