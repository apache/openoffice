helpcontent2	source\text\shared\02\01170000.xhp	0	help	par_id3155399				0	bo	\<ahelp hid=\".uno:TimeField\"\>དུས་ཚོད་ཡིག་དུམ་ཞིག་གསར་བཟོ་བྱེད།\</ahelp\>གལ་སྲིད་རེའུ་བྱང་གཞི་གྲངས་མཛོད་ནང་ཐག་སྦྲེལ་བྱས་ན་ གཞི་གྲངས་མཛོད་ནང་རེའུ་བྱང་གི་དུས་ཚོད་ཐང་འདེམས་སྤྱོད་བྱེད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170000.xhp	0	help	par_id3154764				0	bo	དུས་ཚོད་ཡིག་དུམ་སྒྲིག་ཧ་ཅང་སླ་  སྤྱོད་པོ་ནི་གོང་ཕྱོགས་མདའ་མཐེབ་བམ་ཡང་ན་འོག་ཕྱོགས་མདའ་རྩེ་མཐེབ་ཁོ་བརྒྱུད་དགོས་ངེས་་ཡིན་  འོད་རྟགས་གནས་སའི་ཆུ་ཚོད་སྐར་མ་ཡང་ནསྐར་ཆའི་ཐང་འཕར་སྣོན་ཡང་ན་་ཉུང་དུ་གཏོང་ཆོག				2002-02-02 02:02:02
