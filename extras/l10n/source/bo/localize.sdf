helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3155323	157			0	bo	\<ahelp hid=\"HID_PROP_ECHO_CHAR\" visibility=\"hidden\"\>གལ་སྲིད་ཡི་གེའི་སྒྲོམ་ནང་འཇུག་མ་སྤྱད་ན་  ཡིག་རྟགས་ཀྱི་ ASCII ཨང་མངོན་པ་ནང་འཇུག་བྱེད།\</ahelp\>མངོན་པའི་སྐབས་གསང་ཨང་ཡིག་རྟགས་འདི་སྤྱོད་པོས་མཐེབ་འཇུག་གི་གསང་ཨང་ཡིག་རྟགས་ཚབ་བྱེད། གལ་སྲིད་སྤྱོད་པོ་གསང་ཨང་ནང་འཇུག་བྱེད་ན་མངོན་པའི་སྐབས་ཡིག་རྟགས་འདི་སྤྱོད་དེ་སྤྱོ་པོས་གསང་ཨང་ནང་འཇུག་ལ་ཚབ་བྱེད་\<emph\>གསང་ཨང་ཡིག་རྟགས་\</emph\>ནང་ དགོང་ངེས་ཀྱི་ཡིག་རྟགས་ ASCII ཨང་ནང་འཇུག་བྱེད་བེད་སྤྱོད་པའི་ཐང་ནི་ 0 ནས་ 255བར་ཡིན།				2002-02-02 02:02:02
