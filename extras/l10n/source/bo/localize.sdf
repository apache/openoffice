helpcontent2	source\text\sbasic\shared\03100500.xhp	0	help	par_id3159414				0	bo	\<emph\>Expression \</emph\>བརྗེ་བསྒྱུར་བྱ་དགོས་པའི་གྲངས་ཀའི་མཚོན་ཚུལ་གང་རུང་། གལ་ཏེ་ \<emph\>Expression\</emph\> དེ་ -32768 ནས་ 32767 བར་གྱི་གྲངས་ཐང་ཁྱབ་ཁོངས་ནང་གནས་མེད་ན་ $[officename] ཧུང་གིས་ཕྱིར་ལུད་པའི་ནོར་འཁྲུལ་སྙན་སེང་བྱེད། ཡིག་རྟགས་ཕྲེང་བའི་མཚོན་ཚུལ་བརྗེ་བསྒྱུར་བྱ་དགོས་ན་ངེས་པར་དུ་བཀོལ་སྤྱོད་མ་ལག་གིས་ཁས་བླངས་པའི་གྲངས་ཀའི་རྣམ་གཞག་བེད་སྤྱོད་བྱེད་དགོས་  གྲངས་དེ་སྤྱིར་བཏང་ཡི་གེར་བརྩིས་ ("123.5") ནས་ནང་འཇུག་བྱེད།				2002-02-02 02:02:02
