helpcontent2	source\text\scalc\01\02120000.xhp	0	help	par_id3153415	3			0	bo	\<emph\>"ཤོག་སྨིན་དང་ཤོག་ཞབས"\</emph\>གླེང་སྒྲོམ་གྱིས་ཤོག་སྨིན་དང་ཤོག་ཞབས་ཀྱི་འདེམས་གཞིའི་ཁྭ་མཁོ་འདོན་བྱེད།  གལ་སྲིད་\<link href=\"text/scalc/01/05070000.xhp\" name=\"ཤོག་ངོས་བཀོད་སྒྲིག་\"\>"ཤོག་ངོས་བཀོད་སྒྲིག་"ཟིན་ན་\</link\>གླེང་སྒྲོམ་ནང་བདམས་པ་རྩེས་མེད་གཏོང་\<emph\>"ཆ་ཡའི་ཤོག་ལྷེ་མཚུངས་པ་"\</emph\>འདེམས་གཞི་  ཆ་ཡའི་ཤོག་ངོས་ཀྱི་ཤོག་སྨིན་དང་ཤོག་ཞབས་ནང་དོན་བཀོད་སྒྲིག་མི་འདྲ་བ་བྱས་ཡོད་ ཁྱེད་ཀྱིས་ཁག་སོ་སོར་སྤྱད་པའི་ཆ་ཡའི་ཤོག་ལྷེའི་ཤོག་སྨིན་དང་ཤོག་ཞབས་ཀྱི་འདེམས་གཞིའི་ཁྭ་མཐོང་ཐུབ།				2002-02-02 02:02:02
