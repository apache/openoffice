helpcontent2	source\text\shared\main0213.xhp	0	help	par_id3154751				0	bo	\<emph\>[རེའུ་བྱང་སྣེ་སྟོན་ཡོ་བྱད་ཚང་]\</emph\>ལ་གཞི་གྲངས་མཛོད་རེའུ་མིག་གམ་གཞི་གྲངས་མཐོང་རིས་ཚོད་འཛིན་རྩོམ་སྒྲིག་ལ་སྤྱོད་པའི་རིས་རྟགས་ཚུད་ཡོད། གཞི་གྲངས་མཛོད་ཐག་སྦྲེལ་ཡིག་དུམ་ཚུད་པའི་ཡིག་ཚགས་ནང་ཚང་དེ་ཡིག་ཚགས་མཐིལ་ངོས་སུ་མངོན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\main0213.xhp	0	help	par_id3157958				0	bo	ཁྱེད་ཀྱིས་\<emph\>[རེའུ་བྱང་སྣེ་སྟོན་ཡོ་བྱད་ཚང་]\</emph\>སྤྱད་ནས་ཟིན་ཐོ་སྣ་ཚོགས་ནང་སྤོ་སྒུལ་བྱ་ མ་ཟད་ཟིན་ཐོ་བསྒར་འཛུད་དང་སུབ་ཐུབ། གལ་ཏེ་རེའུ་བྱང་སྤྱད་ནས་གཞི་གྲངས་ཉར་ཚགས་བྱས་ན་བཟོ་བཅོས་དེ་གཞི་གྲངས་མཛོད་ལ་བརྒྱུད་གཏོང་བྱེད། \<emph\>[རེའུ་བྱང་སྣེ་སྟོན་ཡོ་བྱད་ཚང་]\</emph\>ད་དུང་གཞི་གྲངས་ཟིན་འགོད་ཀྱི་རིམ་སྒྲིག་དང་འཚག་འདེམས་བཙལ་འཚོལ་བྱེད་ནུས་ཚུད་ཡོད།				2002-02-02 02:02:02
