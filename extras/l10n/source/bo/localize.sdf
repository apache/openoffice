helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3154902				0	bo	\<ahelp hid=\"HID_AAI_FUNC_CONVERT\"\>གྲངས་ཀ་ཞིག་ཚད་འཇལ་སྡེ་ཚན་ཞིག་ནས་ཚད་འཇལ་སྡེ་ཚན་གཞན་ཞིག་ལ་བརྗེ་སྒྱུར་བྱེད། \</ahelp\>འཇལ་ཚད་ཀྱིས་ཐད་ཀར་འདྲེན་རྟགས་སྣོན་པའི་ཡིག་དེབ་ནང་འཇུག་བྱས་ཆོག་ལ་འདྲེན་རྟགས་སྤྱད་ནས་ནང་འཇུག་བྱས་ཆོག།  གལ་སྲིད་དྲ་མིག་ནང་འཇལ་ཚད་ནང་འཇུག་བྱེད་ན་ངེསངེསཔར་དུ་གཤམ་གྱི་རེའུ་འགོད་དང་གཅིག་མཐུན་ཡོང་བ་བྱེད་དགོས་པ་མ་ཟད་ཡིག་ཆེན་ཡིག་ཆུར་དབྱེ་བ་འབྱེད་:དཔེར་ན་  དྲ་མིག་ནང་ཡིག་ཆུང་ཡིག་འབྲུ་ lནང་འཇུག་བྱེད་ན་("ཧྲེང་"མཚོན་)འདྲེན་རྟགས་རྐྱང་པ་ནང་འཇུག་བྱེད་དགོས་རྗེས་ལམ་སེང་ lནང་འཇུག་བྱེད་དེ་ 'lནང་འཇུག་བྱེད།				2002-02-02 02:02:02
