helpcontent2	source\text\shared\02\01170102.xhp	0	help	par_id3148475				0	bo	\<ahelp hid=\"HID_PROP_BOUNDCOLUMN\" visibility=\"hidden\"\>བཤེར་འདྲེན་གཏན་འཁེལ་ནི་\<emph\>གཞི་གྲངས་ཡིག་དུམ་\</emph\>ནང་གི་ཡིག་དུམ་གྱི་རེའུ་མིག་ཡིག་དུམ་ཡང་ན་རེའུ་མིག་ SQL བཙལ་འདྲའི་ནང་ཐག་སྦྲེལ་བྱེད་པའི་བེད་སྤྱོད། གཏོགས་གཤིས་འདིའི་ནུས་ལྡན་ཐང་ནི་ 1、2、3 སོགས་ཡིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170102.xhp	0	help	par_idN10AD2				0	bo	གལ་ཏེ་གཏོགས་གཤིས་མིག་བཤར་ཆས་ནང་\<emph\>རྒྱས་བཅད་ཀྱི་ཡིག་དུམ་\</emph\>ནང་དོན་སུབ་ན་འབྲས་བུའི་ཚོགས་ཀྱི་ཡིག་དུམ་ཨང་དང་པོ་ནི་མངོན་པ་དང་གཞི་གྲངས་བརྗེས་བསྒྱུར་ལ་སྤྱོད་དོ།  				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170102.xhp	0	help	par_id3154588				0	bo	རེའུ་འགོད་སྒྲོམ་གྱི་གཏོགས་གཤིས་ལ་འདི་སྤྱད་དེ་གཏན་འཁེལ་བྱེད་ ཐག་སྦྲེལ་བྱེད་པའི་རེའུ་མིག་ཞིག་ནང་གི་གཞི་གྲངས་ཡིག་དུམ་རེའུ་བྱང་ནང་མངོན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170102.xhp	0	help	par_id3151213	38			0	bo	གལ་སྲིད་རེའུ་བྱང་ནང་གི་རེའུ་འགོད་སྒྲོམ་ནི་རེའུ་བྱང་རེའུ་མིག་གི་རེའུ་མིག་ནང་དོན་ལ་ཐག་སྦྲེལ་བྱེད་མངོན་\<emph\>རེའུ་འགོད་ནང་དོན་གྱི་རིགས་\</emph\>ཡིག་དུམ་ནང་མཚན་ཉིད་མངོན་མིན་ནི་ SQL བཀའ་ཚིག་ལ་རག་ལས་པའམ་ཡང་ན་(ཐག་སྦྲེལ་)རེའུ་མིག་འཚམས་འདྲི་བྱེད་མིན་དེ་ཡིན།\<emph\>འབྲེལ་བའི་ཡིག་དུམ་\</emph\>གཏོགས་གཤིས་ བརྒྱུད་བཤེར་འདྲེན་བེད་སྤྱད་དེ་རེའུ་འགོད་ཡིག་དུམ་དེ་བཙལ་འདྲི་ཡང་ན་རེའུ་མིག་ནང་གི་གཞི་གྲངས་ཡིག་དུམ་གང་ཡང་ཞིག་ཐག་སྦྲེལ་བྱེད་པ་གཏན་འཁེལ་བྱེད།				2002-02-02 02:02:02
