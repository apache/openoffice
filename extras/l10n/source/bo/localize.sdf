helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	par_id3154942	24			0	bo	\<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_GRID_CBX_BIGORTHO\"\>གཏན་འཁེལ་གྱི་ཙིག་རྟགས་གློད་པའི་སྔོན་དུ་ Shift གནོན་དགོས་  རྨང་སྒྲིག་གྲུ་བཞིའི་མཐའ་ཆུང་  བདམས་བྱ་དེ་འཇོད་སྒོར་ལ་(འཇོང་སྒོར་གྱི་དྲང་ཐིག་རིང་བར་གྲུ་བཞིའི་ལྷོམ་པ་ཞིག་བཟོ་དགོས་) གལ་ཏེ་བདམས་བྱའི་\<emph\>ནང་ཅུང་རིང་བའི་གཟུགས་\</emph\>བསྐྱར་འདེམས་སྒྲོམ་ཞིག་ཡོད་ཚེ་ ཅུང་འཐུང་བའི་མཐའ་འམ་དྲང་ཐིག་ཐོག་གྲུ་བཞི་ལྷོམ་པའམ་སྒོར་མོ་བཟོ་དགོས།  \</ahelp\>				2002-02-02 02:02:02
