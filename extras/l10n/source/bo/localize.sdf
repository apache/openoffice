helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3145382				0	bo	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_RIGHT\"\>གལ་ཏེ་\<emph\>མངོན་པའི་སྡུར་ཚད་རྒྱུན་འཁྱོངས་ \</emph\>འདེམས་གཞི་བདམས་རྗེས་ཕོ་ཐང་ནང་འཇུག་བྱས་ན་རིས་དབྱིབས་ཀྱི་གཡས་མཐའ་འགྲམ་ནང་འཇུག་བྱེད་  མོ་ཐང་ནང་འཇུག་བྱས་ན་རིས་དབྱིབས་ཀྱི་གཡས་ངོས་སུ་ས་ཁོངས་སྟོང་པ་སྣོན་འཇུག་བྱེད།  གལ་ཏེ་\<emph\>བཪྙན་རིས་ཀྱི་ཆེ་ཆུང་རྒྱུན་འཁོངས་\</emph\>འདེམས་གཞི་བདམས་རྗེས་ཕོ་ཐང་ནང་འཇུག་གིས་རིས་དབྱིབས་ཀྱི་ཆུ་སྙོམ་མངོན་པའི་སྡུར་ཚད་འཕར་སྣོན་བྱེད། མོ་ཐང་ནང་འཇུག་བྱས་ན་རིས་དབྱིབས་ཀྱི་ཆུ་སྙོམ་མངོན་པའི་སྡུར་ཚད་ཆུང་དུ་འགྲོ།\</ahelp\>				2002-02-02 02:02:02
