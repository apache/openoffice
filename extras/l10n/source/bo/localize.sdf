helpcontent2	source\text\schart\01\05070000.xhp	0	help	par_id3150767	2			0	bo	\<variable id=\"diagrammboden\"\>\<ahelp hid=\".uno:DiagramFloor\"\> \<emph\>རིས་མཚོན་རྨང་ཞབས་\</emph\>གླེང་སྒྲོམ་ཁ་ཕྱེ་ན་  ཁྱེད་ཀྱིས་གླེང་སྒྲོམ་འདིའི་ནང་རིས་མཚོན་རྨང་ཞབས་ཀྱི་གཏོགས་གཤིས་ལ་བཟོ་བཅོས་བྱེད་ཆོག  རིས་མཚོན་རྨང་ཞབས་ནི་རྩ་གསུམ་རིས་མཚོན་གྱི་འོག་ཕྱོགས་ས་ཁོངས་ཡིན།   བྱེད་ནུས་འདི་རྩ་གསུམ་རིས་འགོད་ཁོ་ནར་སྤྱད་ན་འཚམས།  \</ahelp\>\</variable\>				2002-02-02 02:02:02
