helpcontent2	source\text\shared\02\01170400.xhp	0	help	par_id3166460				0	bo	\<variable id=\"text\"\>\<ahelp hid=\".uno:AddField\" visibility=\"visible\"\>སྒེའུ་ཁུང་ཞིག་ཁ་འབྱེད་པར་འགྱུར་  དེའི་རེའུ་བྱང་ནང་སྣོན་འཇུག་བྱས་པའི་གཞི་གྲངས་མཛོད་ཡིག་དུམ་འདེམས་དགོས། \</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170400.xhp	0	help	par_id3156114				0	bo	\<ahelp visibility=\"visible\" hid=\"HID_FIELD_SEL\"\>ཡིག་དུམ་འདེམས་པའི་སྒེའུ་ཁུང་གིས་ \<link href=\"text/shared/02/01170201.xhp\" name=\"རེའུ་མིག་གཏོགས་གཤིས།\"\>རེའུ་མིག་གཏོགས་གཤིས།\</link\> ནང་གཞི་གྲངས་ཁུངས་ལ་གཏན་འཁེལ་བྱས་པའི་རེའུ་མིག་ (ཡང་ན་བཙལ་འདྲི་) ནང་གི་གཞི་གྲངས་མཛོད་ཡིག་དུམ་ཡོད་ཚད་སྟར་སྒྲིག་བྱེད། \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170400.xhp	0	help	par_id3147620				0	bo	འདྲུད་འཇོག་གི་ཐབས་ཤེས་བརྒྱུད་ནས་ཡིག་དུམ་ཞིག་མིག་སྔའི་ཡིག་ཚགས་ལ་སྣོན་འཇུག་བྱེད།  ཐབས་ཤེས་ནི་ཙིག་རྟགས་སྤྱད་དེ་ཡིག་དུམ་འདི་འདེམས་དགོས་པ་མ་ཟད་ཙིག་རྟགས་མནན་ནས་མ་གློད་པར་དེ་ཡིག་ཚགས་ནང་འདྲུད་འཇོག་བྱེད།  དེ་རྗེས་ཡིག་ཚགས་ནང་ལྟོས་བཅས་ཀྱི་ཡིག་དུམ་ཞིག་འཛུགས་པ་མ་ཟད་གཞི་གྲངས་མཛོད་ལ་སླེབས་པའི་ཐག་སྦྲེལ་ལྡན་ཡོད།  				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170400.xhp	0	help	par_id3153541				0	bo	གལ་ཏེ་ཁ་བརྒྱབ་ན་\<link href=\"text/shared/02/01170500.xhp\" name=\"ཇུས་འགོད་མ་ཚུལ།\"\>ཇུས་འགོད་མ་ཚུལ།\</link\>  $[officename] བསྒར་འཛུད་བྱས་པའི་གཞི་གྲངས་མཛོད་ཡིག་དུམ་ཚང་མར་ཤོག་བྱང་ལྡན་པའི་ནང་འཇུག་ཡིག་དུམ་ཞིག་བཙུགས་པ་མཐོང་   སྤྱོད་པོས་དེའི་ནང་གཞི་གྲངས་ནང་འཇུག་བྱེད་ཆོག				2002-02-02 02:02:02
