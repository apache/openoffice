helpcontent2	source\text\swriter\01\04120212.xhp	0	help	par_id3083451				0	bo	\<ahelp hid=\"SW_CHECKBOX_TP_TOX_SELECT_CB_USEFF\"\>གཤར་བྱང་རྐྱང་པ་ཚབ་བརྗེ་བྱས་ནས་ཐོག་པའི་ཤོག་ལྷེ་གཅིག་གམ་ཤོག་ལྷེ་མདུད་མའི་ཐོག་གི་དཀར་ཆག་གཤར་བྱང་མཚུངས་པ་སྤྱོད་ཅིང་ གཤར་བྱང་རྐྱང་པ་དེ་ཐེངས་དང་པོའི་གཤར་བྱང་དེའི་ཤོག་ཨང་སྒྲིག་པ་མ་ཟད་ "f"ཡང་ན་"ff"ཁྲོད་ཡོད་དེ།དཔེར་ན་  གཤར་བྱང་"མཐོང་རིས་ 10、མཐོང་རིས་ 11、མཐོང་རིས་ 12"ཟླ་དྲིལ་བ་"མཐོང་རིས་ 10ff"  "མཐོང་རིས་ 10、མཐོང་རིས་ 10"ཟླ་དྲིལ་བ་"མཐོང་རིས་ 10f" \</ahelp\>				2002-02-02 02:02:02
