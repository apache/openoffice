helpcontent2	source\text\shared\explorer\database\11020000.xhp	0	help	par_id3151245				0	bo	\<ahelp hid=\"HID_DSADMIN_CHARSET_ODBC\" visibility=\"visible\"\>  $[officename] ནང་གཞི་གྲངས་མཛོད་ཀྱི་ཚབ་ཨང་བརྗེ་པོར་སྤྱོད་པ་འདེམས་དགོས།  ཚབ་ཨང་འདིས་གཞི་གྲངས་མཛོད་ལ་ཤུགས་རྐྱེན་མི་བྱེད།\</ahelp\> "མ་ལག་"བདམས་ནས་བཀོལ་སྤྱོད་མ་ལག་གི་ཁས་ལེན་ཡིག་རྟགས་ཚོགས་བེད་སྤྱོད་བྱེད།  ཡི་གེ་དང་གཞི་གྲངས་མཛོད་ dBase ནང་ཚང་མར་ཡིག་རྟགས་ཀྱི་རིང་ཚད་གཏནའཁེལ་བྱས་པའི་ཡིག་རྟགས་ཚོགས་སྤྱོད་པ་དང་  དེའི་ནང་ཡིག་རྟགས་ཡོད་ཚད་མཚུངས་པའི་ཡིག་ཚིགས་ཀྱིས་ཨང་སྒྲིག་བྱེད།				2002-02-02 02:02:02
