helpcontent2	source\text\swriter\main0503.xhp	0	help	par_id3155098				0	bo	བྱ་རིམ་འཆར་ངོས་ནི་ཞིབ་ཕྲའི་འཆར་འགོད་བརྒྱུད་ཡོད་སྒེར་གྱི་དགའ་སྣང་ལ་བརྟེན་ནས་དེ་སྦྱོར་སྒྲིག་བྱེད་  རང་མཚན་འཇོག་རིས་རྟགས་དང་ཚལ་ཐོ་ཚུད་ཡོད་བྱ་རིམ་ཁག་གི་སྒེའུ་ཁུང་(དཔེར་ན་"རིགས་ཁག་བཟོ་ལྟ་"སྒེའུ་ཁུང་ཡང་ན་"ལག་རོགས་"སྒེའུ་ཁུང་)འཕྱོ་སྒུལ་སྒེའུ་ཁུང་ངོས་ནས་གསལ་ཡོལ་གྱི་གནས་ས་གང་རུང་ཞིག་འཇོག་  སྒེའུ་ཁུང་ཁ་ཤས་\<link href=\"text/shared/guide/autohide.xhp\" name=\"རྒྱས་བཅད་\"\>རྒྱས་བཅད་\</link\> ལས་ཀའི་བར་སྟོང་གི་མཐའ་འགྲམ་བྱ་ཆོག།				2002-02-02 02:02:02
