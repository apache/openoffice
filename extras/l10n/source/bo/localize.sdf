helpcontent2	source\text\shared\guide\copytext2application.xhp	0	help	par_id3158430				0	bo	དྲས་སྦྱར་པང་ནང་གི་ནང་དོན་གྱི་སྦྱར་བའི་རྣམ་གཞག་འདེམས་དགོས་ན་ [རྒྱུན་སྤྱོད་ཡོ་བྱད་ཚང་]སྟེང་\<emph\>"སྦྱར་བ་"\</emph\>རིས་རྟགས་གྲམ་གྱི་མདའ་རྩི་རྐྱང་རྡེབ་བྱས་རོགས་ ཡང་ན་\<emph\>[རྩོམ་སྒྲིག་] - [འདེམས་ངའི་རང་བཞིན་གྱི་སྦྱར་བ་...]\</emph\>འདེམས་པ་དང་ དེ་ནས་འོད་མཚམས་ཀྱི་རྣམ་གཞག་འདེམས་དགོས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\copytext2application.xhp	0	help	par_id3156155				0	bo	གལ་ཏེ་ཡི་གེ་ལས་སྣོན་ཡིག་ཚགས་ནང་"ཁ་བྱང་དུམ་མཚམས་བཟོ་ལྟ་"་སྤྱད་ནས་རྣམ་གཞག་ཅན་དུ་འགྱུར་བའི་ཁ་བྱང་འདུས་ཡོད་ན་ \<emph\>[ཡིག་ཆ་] - [བསྐུར་བ་] - [རྩ་འཛིན་གྱི་སྐྱེལ་གྲུབ་གསལ་སྟོན་ཡིག་ཟིན་...\</emph\>འདེམས་པ། ཁ་བྱང་དེ་དག་རྩ་འཛིན་པ་རྩིས་ནས་གསལ་སྟོན་ཡིག་ཟིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\copytext2application.xhp	0	help	par_id3145316				0	bo	གལ་ཏེ་དུས་མཉམ་དུ་ཁ་བྱང་སོ་སོ་དང་དེ་ཡིན་ཞོར་ཁྲིད་ཀྱི་དུམ་མཚམས་བརྒྱུད་སྐྱེལ་བྱ་དགོས་ན་ \<emph\>[ཡིག་ཆ་] - [བསྐུར་བ་] - [རང་བྱུང་གནད་བསྡུས་སྐྱེད་གྲུབ་གསལ་སྟོན་ཡིག་ཟིན་...]\</emph\>བཀའ་ཚིག་འདེམས་ཆོག། ངེས་པར་དུ་ལྟོས་བཅས་ཀྱི་དུམ་མཚམས་བཟོ་ལྟ་སྤྱད་ནས་ཁ་བྱང་དེ་དག་རྣམ་གཞག་ཅན་འགྱུར་ན་ བཀའ་ཚིག་མཐོ་ཐུབ།				2002-02-02 02:02:02
