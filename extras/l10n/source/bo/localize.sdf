helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3155579				0	bo	གཞི་གྲངས་མཛོད་རེའུ་མིག་གཅིག་གཞིར་བྱེད་པའམ་གཞི་གྲངས་མཛོད་བརྩད་འདྲི་ཞིག་གི་རེའུ་བྱང་གསར་འཛུགས་བྱེད།  རེའུ་བྱང་གིས་མཐོང་སྣང་ལ་སྣང་བ་སྤྲོ་བའི་ཐབས་ཚུལ་གྱིས་གཞི་གྲངས་མངོན་པ་དང་  ད་དུང་གཞི་གྲངས་ནང་འཇུག་གམ་རྩོམ་སྒྲིག་བྱེད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3147094	34			0	bo	\<variable id=\"wozu\"\>གལ་ཏེ་རེའུ་བྱང་གིས་རེའུ་མིག་ཞིག་གམ་བརྩད་འདྲིའི་ནང་གི་གཞི་གྲངས་འདྲེན་སྤྱོད་བྱེད་ཐུབ་པར་རེ་བ་བྱེད་པ་མ་ཟད་རེའུ་མིག་གཞན་པའི་ནང་གི་གཞི་གྲངས་མངོན་ན་ཡན་ལག་རེའུ་བྱང་གསར་འཛུགས་བྱེད་འོས། \</variable\>དཔེར་ན་  ཡན་ལག་རེའུ་བྱང་གཞན་པའི་གཞི་གྲངས་མཛོད་རེའུ་བྱང་ནང་གི་གཞི་གྲངས་ཀྱི་ཡི་གེའི་སྒྲོམ་མངོན་པར་སྤྱོད་དོ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3157972				0	bo	ཡན་ལག་རེའུ་བྱང་ནི་རེའུ་བྱང་གཙོ་བོའི་ཟུར་སྣོན་ཚོ་ཆས་ཤིག་རེད།  གཙོ་བོའི་རེའུ་བྱང་ལ་"རེའུ་བྱང་ཕ།"ཡང་ན་"རེའུ་བྱང་གཙོ་བོ།"ཟེར།  རེའུ་བྱང་ཞིག་ནས་རེའུ་མིག་མང་པོར་འཚམས་འདྲི་བྱེད་དུས་ཡན་ལག་རེའུ་བྱང་སྤྱོད།  གཞན་པའི་རེའུ་མིག་ཚང་མར་སོ་སོའི་ཡན་ལག་རེའུ་བྱང་དགོས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id4807275				0	bo	རེའུ་བྱང་གསར་འཛུགས་བྱས་རྗེས་རེའུ་བྱང་འདི་ཡན་ལག་རེའུ་བྱང་ལ་འགྱུར་དགོས།  འདི་མངོན་འགྱུར་བྱེད་དགོས་ན་"ཇུས་འགོད་མ་ཚུལ།"ནང་འཇུག་བྱེད་པ་མ་ཟད་"རེའུ་བྱང་ལས་རོགས།"ཁ་ཕྱེ་དགོས།  "རེའུ་བྱང་ལས་རོགས།"ནང་རེའུ་བྱང་ཞིག་(ཡན་ལག་རེའུ་བྱང་ལ་འགྱུར་བ་)གཞན་པའི་རེའུ་བྱང་(རེའུ་བྱང་གཙོ་བོར་འགྱུར་)སྟེང་འདྲུད་འཇོག་བྱེད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3158444				0	bo	ཡིག་ཚགས་ཀྱི་སྤྱོད་པོས་ཡན་ལག་རེའུ་བྱང་ལྡན་པའི་རེའུ་བྱང་མཐོང་ཐབས་བྲལ།  སྤྱོད་པོས་ནང་འཇུག་ཟིན་པའི་གཞི་གྲངས་ཀྱི་ཡིག་ཚགས་ཁོ་ན་མཐོང་བའམ་སྔར་ཡོད་གཞི་གྲངས་ཀྱི་ཡིག་ཚགས་མངོན་ནོ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_idN10C2A				0	bo	རེའུ་བྱང་གཙོ་བོའི་ནང་གཞི་གྲངས་ཡིག་དུམ་གྱི་"ཐག་སྦྲེལ།"ཡིག་དུམ་གཙོ་བོ་གཏན་འཁེལ་བྱེད།  ཡན་ལག་རེའུ་བྱང་ནང་"ཐག་སྦྲེལ།"ནི་ཡིག་དུམ་ནས་"ཐག་སྦྲེལ།"ཡིག་དུམ་གཙོ་བོའི་ནང་དོན་དང་ཟླ་སྒྲིག་པའི་ཡིག་དུམ་དང་བཀོད་སྒྲིག་བྱེད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_idN10C2D				0	bo	སྤྱོད་པོས་གཞི་གྲངས་ལ་མིག་བཤར་བྱེད་དུས་རེའུ་བྱང་གིས་ཐོག་མཐའ་བར་གསུམ་དུ་མིག་སྔའི་གཞི་གྲངས་ཟིན་འགོད་བྱེད།  གལ་ཏེ་ཡན་ལག་ཚལ་ཐོར་མཚན་འཇོག་བྱས་ན་ཡན་ལག་ཚལ་ཐོའི་ནང་དོན་ནི་ཡུན་ཐུང་དུས་འགྱངས་ཧའོ་སྐར་ཆ་ 200 བྱས་རྗེས་མངོན་ནོ།  དུས་འགྱངས་འདིས་ཁྱེད་ལ་མགྱོགས་མྱུར་ངང་རེའུ་བྱང་གཙོ་བོའི་གཞི་གྲངས་ཟིན་ཐོ་མིག་བཤར་བྱེད།   གལ་ཏེ་ནར་འགྱངས་དུས་ཚོད་ནང་གཤམ་གྱི་གཞི་གྲངས་གཙོ་བོའི་ཟིན་ཐོར་མིག་བཤར་བྱེད་ན་  ཡན་ལག་ཚལ་ཐོའི་གཞི་གྲངས་མཛོད་བྱང་འཚོལ་དང་མངོན་པར་བྱེད་མི་དགོས།				2002-02-02 02:02:02
