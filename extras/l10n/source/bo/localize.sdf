helpcontent2	source\text\shared\00\00000099.xhp	0	help	par_id3156069				0	bo	\<link href=\"text/shared/guide/main.xhp\" name=\"$[officename] ཡི་སྤྱིར་བཏང་གསལ་བཤད་\"\>$[officename]  ཡི་སྤྱིར་བཏང་གསལ་བཤད་\</link\>ཤོག་ངོས་ཐོག་རོགས་རམ་བྱེད་  སྨོ་ལིང་ཡོད་ཚད་ཀྱི་གསལ་བཤད་འཚོལ་ཐུབ་  དཔེར་ན་སྒེའུ་ཁུང་དང་ཚལ་ཐོ་བེད་སྤྱོད་གང་འདྲ་བྱེད་  $[officename] གཞི་གྲངས་ཁུངས་  རིས་མཛོད་དྲས་སྦྱར་དང་འདྲུད་སྐྱེལ་སོགས་རང་མཚན་འཇོག་གང་འདྲ་བྱེད། 				2002-02-02 02:02:02
