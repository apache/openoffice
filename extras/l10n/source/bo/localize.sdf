helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3153724				0	bo	\<ahelp hid=\"37933\"\>ཚོད་ཆས་ཡིག་དུམ་ནང་ཕྲེང་བརྗེ་དང་རྣམ་གཞག་ཅན་སྤྱོད་  དཔེར་ན་ཡིག་དེབ་སྒྲོམ་ཡང་ན་ཤོག་བྱང་ལག་འགུལ་ཕྲེང་བརྗེ་ནང་འཇུག་བྱེད་  Enter མཐེབ་གནོན། "རྣམ་གཞག་གི་ཕྲེང་ཁྱེར་ཡོད་པ།"འདེམས་ཏེ་རྣམ་གཞག་གི་ཡིག་དེབ་ཁྱེར་པ་ནང་འཇུག་བྱེད།\</ahelp\>				2002-02-02 02:02:02
