helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	par_id3146974				0	bo	\<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_ANNOT\"\> རྩིག་རྟགས་དེ་མཆན་འགྲེལ་བསྒར་འཛུད་བྱས་པའི་དྲ་མིག་སྟེང་བཞག་པའི་སྐབས་བསྒར་འཛུད་བྱས་པའི་མཆན་འགྲེལ་མངོན་པར་གཏན་འཁེལ་བྱེད།  དྲ་མིག་གཡས་ཐོད་ཀྱི་གྲུ་བཞི་ཆུང་ངུ་དྲ་མིག་འདི་ལ་མཆན་འགྲེལ་ཚུད་ཡོད་པ་མཚོན་པ་མ་ཟད་མཆན་འགྲེལ་མངོན་པར་འགྱུར།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	par_id3150487				0	bo	\<ahelp hid=\".uno:NoteVisible\"\>  སྔ་ཕྱི་བར་གསུམ་དུ་མཆན་འགྲེལ་མངོན་དགོས་ན་  དྲ་མིག་གི་གཡས་མཐེབ་ཚལ་ཐོའི་ནང་  \<emph\> མཆན་འགྲེལ་མངོན་པའི་\</emph\>བཀའ་ཚིག་འདེམས་དགོས།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01060100.xhp	0	help	par_id3149667				0	bo	བཀའ་ཚིག་ \<link href=\"text/shared/01/04050000.xhp\" name=\" བསྒར་འཛུད་- མཆན་འགྲེལ་ \"\>\<emph\>[བསྒར་འཛུད།] - [མཆན་འགྲེལ།]\</emph\>\</link\> སྤྱད་ནས་མཆན་འགྲེལ་མཐེབ་འཇུག་དང་རྩོམ་སྒྲིག་བྱས་ཆོག   སྔ་ཕྱི་བར་གསུམ་དུ་མངོན་པའི་མཆན་འགྲེལ་ནས་བརྗོད་ན་མཆན་འགྲེལ་གྱི་མཐའ་སྒྲོམ་ལ་རྐྱང་རྡེབ་བྱས་ནས་རྩོམསྒྲིག་བྱས་ཆོག  ལག་རོགས་ལ་རྐྱང་རྡེབ་དང་ \<emph\>མཆན་འགྲེལ་\</emph\>གཤར་བྱང་བརྒྱུད་མིག་སྔའི་ཡིག་ཚགས་ནང་གི་མཆན་འགྲེལ་ཡོད་ཚད་ལ་ལྟ་ཞིབ་ཐུབ།  མཆན་འགྲེལ་ལ་ཆ་རྡེབ་ཀྱིས་འོད་རྟགས་དེ་མཆན་འགྲེལ་ཚུད་པའི་ལྟོས་བཅས་དྲ་མིག་ཏུ་མཆོངས།				2002-02-02 02:02:02
