helpcontent2	source\text\schart\01\04070000.xhp	0	help	par_id3150344				0	bo	\<variable id=\"sytextygitter\"\>\<ahelp hid=\".uno:ToggleGridVertical\"\>\<emph\>[རྣམ་གཞག་ཡོ་བྱད་ཚང་]\</emph\>སྟེང་གི་\<emph\>"གཞུང་ཕྱོགས་དྲ་མིག་ཐིག་མངོན་པའམ་གབ་པ་"\</emph\>རིས་རྟགས་ནི་མདའ་ Y ཡི་དྲ་མིག་མངོན་པ་བརྗེ་བསྒྱུར་བྱེད་པ་སྤྱོད།   ཡིད་གཟབ་མཛད་རྒྱུར་\<emph\>[བསྒར་འཛུད་] - [དྲ་མིག་ཐིག་...]\</emph\>ཁོ་ནའི་ནང་\<emph\>"དྲ་མིག་ཐིག་ཕལ་པ་"\</emph\>མ་འདེམས་པའི་སྐབས་བྱེད་ནུས་འདིས་ནུས་པ་མཐོན།  \</ahelp\>\</variable\> དེ་མིན་དྲ་མིག་གཙོ་བོ་གཏན་འགོག་བྱས་རྗེས་དྲ་མིག་ཕལ་པ་སྔར་བཞིན་མཐོང་ཐུབ།				2002-02-02 02:02:02
