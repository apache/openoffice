helpcontent2	source\text\swriter\01\02120000.xhp	0	help	par_id3154571				0	bo	\<variable id=\"autotexttext\"\>\<ahelp hid=\".uno:EditGlossary\"\>རང་འགུལ་རིས་ཡིག་ཚགས་གསར་འཛུགས་དང་རྩོམ་སྒྲིག་བསྒར་འཛུད་བྱེད་ན་རྣམ་གཞག་ཅན་དུ།འགྱུར་ཟིན་པའི་ཡི་གེ་དང་རིས་དབྱིབས་དང་ལྡན་པའི་ཡི་གེ་、རེའུ་མིག་དང་ཡིག་དུམ་、རང་འགུལ་རིས་ཡིག་ཚགས་སུ་ཉར་ཚགས་བྱེད་ཀྱི་ཡོད།མགྱོགས་མྱུར་གྱི་རང་འགུལ་རིས་ཡིག་ཚགས་བསྒར་འཛུད་བྱེད་ན་  ཡིག་ཚགས་ནང་རང་འགུལ་རིས་ཡིག་ཚགས་ཀྱི་བསྡུས་འབྲི་བཅུག་ཆོག་  དེ་རྗེས་ F3 མཐེབ་གནོན་བྱ་དགོས།\</ahelp\>\</variable\>				2002-02-02 02:02:02
