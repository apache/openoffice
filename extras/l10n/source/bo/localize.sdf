helpcontent2	source\text\shared\guide\tabs.xhp	0	help	par_id3159156				0	bo	གལ་སྲིད་ཁྱེད་ཀྱིས་ཚད་ཁྲེའི་ཐོག་རེའུ་འགོད་རྟགས་སྤོ་སྒུལ་བྱ་འདོད་ན་  Shift མཐེབ་གནོན་པ་མ་ཟད་མུ་མཐུད་ནས་དེ་གནོན་འཛིན་བྱེད།   Shift གནོན་འཛིན་བྱེད་པ་དང་དུས་མཚུངས་རེའུ་འགོད་རྟགས་ཤིག་འདྲུད་སྒུལ་བྱེད་  རེའུ་འགོད་རྟགས་འདི་དང་དེའི་གཡས་མཐའི་རེའུ་འགོད་རྟགས་ཡོད་ཚད་སྤོ་སྒུལ་བྱེད།  སྤོ་སྒུལ་བྱེད་པའི་རེའུ་འགོད་རྟགས་འདི་དག་ཕན་ཚུན་དབར་གྱི་བར་ཆོད་འགྱུར་བ་མི་འགྲོ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\tabs.xhp	0	help	par_id3147349	23			0	bo	ཚད་ཁྲེའི་ཐོག་རེའུ་འགོད་རྟགས་ཤིག་འདྲུད་སྒུལ་བྱེད་  \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>བཀའ་ཚིག་\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\> མཐེབ་གནོན་འཛིན་བྱེད་  རེའུ་འགོད་རྟགས་འདི་དེ་བཞིན་གཡས་ངོས་ཀྱི་རེའུ་འགོད་རྟགས་ཡོད་ཚད་སྤོ་སྒུལ་བྱེད།  རེའུ་འགོད་རྟགས་འདི་དག་གི་དབར་གྱི་བར་རྒྱང་ནི་བར་ཐག་གཞན་གྱི་ཤོག་མཐའི་དར་ཐག་དྲང་སྡུར་གྱི་འགྱུར་བ་ཡིན།				2002-02-02 02:02:02
