helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3150870				0	bo	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>གལ་སྲིད་ཕྲེང་གི་འགོ་ལ་རིམ་བཞིན་ཨང་སྒྲིག་ རྫིགས་རྟགས་ སྟོང་མིག་ཡིན་ན་ དེ་རྗེས་ཡི་གེ་ཡིན་ ཕྲེང་མཇུག་ Enter མཐེབ་གནོན་སྐབས་ རང་འགུལ་གྱིས་ཨང་སྒྲིག་རེའུ་མིག་ཞིག་གསར་བཟོ་བྱེད། གལ་སྲིད་ཕྲེང་གི་འགོ་ནི་ཡིག་འགྲེལ་རྟགས་(-)སྣོན་རྟགས་(+)ཡང་ན་སྐར་རྟགས་(*)ཡིན་ན་ དེ་རྗེས་ནི་སྟོང་མིག་དང་ཡི་གེ་ཡིན་  Enter མཐེབ་གནོན་སྐབས་རྣམ་གྲངས་མཚོན་རྟགས་རེའུ་འགོད་ཞིག་གསར་བཟོ་བྱེད།\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3146874				0	bo	\<switchinline select=\"appl\"\> \<caseinline select=\"WRITER\"\>འགོ་ལ་རང་འགུལ་ཨང་སྒྲིག་ཁྱེར་བའི་ཕྲེང་ལ་ ཕྲེང་མཇུག་ལ་ Enter མཐེབ་གནོན་མཐེབ་སྐབས་སྐྱེ་གྲུབ་བྱུང་བའི་རང་འགུལ་ཨང་སྒྲིག་རྩིས་མེད་གཏོང་དགོས་ན་ བསྐྱར་དུ་ Enter མཐེབ་གནོན་མཐེབ་བྱེད།\</caseinline\> \</switchinline\>				2002-02-02 02:02:02
