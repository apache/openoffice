helpcontent2	source\text\sbasic\shared\03120101.xhp	0	help	par_id3145609				0	bo	Asc  རྟེན་གྲངས་ནི་མཐེབ་ཨང་ཉིད་ཐང་ལ་བརྗེ་བར་སྤྱོད་དགོས་ Asc  རྟེན་གྲངས་ལ་ཡིག་རྟགས་ཕྲེང་བ་སྟོང་པ་ཞིག་འཕྲད་ཀྱི་སྐབས་ $[officename] ཧུང་གིས་འཁོར་བསྐྱོད་སྐབས་ནོར་འཁྲུལ་སྙན་ཞུ་ཐུབ་ གཏན་པར་རུང་བའི་གནས་7 གྱི་ ASCII ཡིག་རྟགས་(ཚབ་ཡང་ནི་ 0-127)ཕུད་ ASCII  རྟེན་གྲངས་ཀྱིས་ད་དུང་ ASCII ཚབ་ཡང་ཁྲོད་གཏན་པར་མི་རུང་བའི་མཐེབ་ཨང་ར་སྤྲོད་ཐུབ་ གཞན་ཡང་རྟེན་གྲངས་འདིས་གནས་ 16 གི་ unicode ཡིག་རྟགས་ལས་སྣོན་ཐུབ།				2002-02-02 02:02:02
