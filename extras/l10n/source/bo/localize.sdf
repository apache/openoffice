helpcontent2	source\text\shared\02\06110000.xhp	0	help	par_id3158405	5			0	bo	གལ་ཏེ་ཁྱེད་ཀྱིས་དུམ་མཚམས་ལ་ཨང་སྒྲིག་བྱེད་པ་མ་ཟད་\<emph\>"འོག་ལ་སྤོ་འགུལ།"\</emph\>རིས་རྟགས་ལ་རྐྱང་རྡེབ་བྱས་ན་ཨང་སྒྲིག་གིས་མིག་སྔའི་གོ་རིམ་གཞིར་བཟུང་ནས་ལེགས་སྒྲིག་བྱེད། \<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>འོད་རྟགས་ནི་རྣམ་གྲངས་མཚོན་རྟགས་སམ་ཨང་སྒྲིག་རེའུ་འགོད་དུ་གནས་དུས་\<emph\>"འོག་ལ་སྤོ་འགུལ།"\</emph\>རིས་རྟགས་མཐོང་ཐུབ། \</caseinline\>\</switchinline\>\<switchinline select=\"appl\"\>\<caseinline select=\"IMPRESS\"\>རྩ་འཛིན་མཐོང་རིས་ཁོ་ན་སྤྱོད་དུས་\<emph\>[རྩ་འཛིན་ཡོ་བྱད་ཚང་།]\</emph\>སྟེང་གི་\<emph\>"འོག་ལ་སྤོ་བ།"\</emph\>རིས་རྟགས་མཐོང་ཐུབ། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
