helpcontent2	source\text\shared\02\01170000.xhp	0	help	par_id3151378				0	bo	\<variable id=\"formulartext\"\>\<ahelp hid=\".uno:Config\"\>"རེའུ་བྱང་ཚོད་ཆས།"རིས་རྟགས་ཀྱི་ཡོ་བྱད་ཚང་ཞིག་ཁ་ཕྱེ་ཆོག་  ཡོ་བྱད་ཚང་འདི་ནང་ཕན་ཚུན་བརྗེ་རེས་ཚུལ་གྱི་རེའུ་བྱང་དགོས་ངེས་ཀྱི་ཡོ་བྱད་གསར་བཟོ་བྱེད་པ་ཚུད་ཡོད།\</ahelp\>\</variable\> ཡིག་དེབ་ གློག་རྡུལ་རེའུ་མིག་ གསལ་སྟོན་ཡིག་ཟིན་ཡང་ན་ HTML ཡིག་ཚགས་ནང་རེའུ་བྱང་ནང་ཚོད་ཆས་ (འཁོར་རྒྱུག་ཧུང་གི་མཐེབ་གནོན་)གསབ་སྣོན་བྱེད།				2002-02-02 02:02:02
