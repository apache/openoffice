helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3146325				0	bo	མིང་ནི་བྱེད་ནུས་མཚུངས་པའི་ཚོད་ཆས་མི་འདྲ་བ་ཚོ་སྒྲིག་བྱེད་པ་སྤྱོད་ དཔེར་ན་ རྐྱང་འདེམས་གནོན་མཐེབ།  དེར་བརྟེན་ ཚོ་སྒྲིག་གྱི་ཁུངས་ཞུགས་ཡོད་ཚད་འདྲ་བའི་མིང་སྤྲོད་དགོས་ངེས་ཡིན་ མིང་དྲ་བའི་ཚོད་ཆས་ནི་ཚོ་སྒྲིག་ཞིག་གྲུབ། \<link href=\"text/shared/02/01170000.xhp\" name=\"ཚོ་སྒྲོམ།\"\>ཚོ་སྒྲོམ།\</link\> བེད་སྤྱད་དེ་ཚོ་སྒྲིག་པའི་ཚོད་ཆས་ཐད་མཐོང་གྱིས་མཚོན་ཆོག				2002-02-02 02:02:02
