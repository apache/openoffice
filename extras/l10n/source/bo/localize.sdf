helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3153215	43			0	bo	\<ahelp hid=\"HID_PROP_READONLY\" visibility=\"hidden\"\>ཚོད་འཛིན་ནི་ཀློག་ཙམ་( རེད་ )ཡང་ན་(མིན་)རྩོམ་སྒྲིག་ཡིན་མིན་གཏན་འཁེལ་བྱེད།\</ahelp\>སྤྱོད་པོས་ཡིག་དེབ་གཞན་ནང་འཇུག་བྱེད་པའི་ཚོད་ཆས་ཡོད་ཚད་\<emph\>ཀློག་ཙམ་\</emph\>གཏོགས་གཤིས་གཏན་འཁེལ་བྱེད། གལ་སྲིད་གཞི་གྲངས་མཛོད་སྤྱོད་པོའི་ནང་རིས་དབྱིབས་ཀྱི་བཪྙན་རིས་ཡིག་དུམ་ཀློག་ཙམ་གཏོགས་གཤིས་གཏན་འཁེལ་བྱེད་ སྤྱོད་པོ་ནི་གཞི་གྲངས་མཛོད་ནང་རིས་དབྱིབས་གསར་པ་བསྒར་འཛུད་བྱ་ཐབས་བྲལ།				2002-02-02 02:02:02
