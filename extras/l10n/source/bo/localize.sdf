helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3155892				0	bo	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_GRFCROP_RB_SIZECONST\"\>བྲེགས་གཏུབ་སྐབས་རིས་དབྱིབས་ཀྱི་མ་དེབ་ཆེ་ཆུང་རྒྱུན་འཁྱོངས་བྱེད་  དེར་བརྟེན་རིས་དབྱིབས་ཀྱི་མངོན་པའི་སྡུར་ཚད་ཁོ་ན་བཟོ་བཅོས་བྱེད།  རིས་དབྱིབས་ཀྱི་མངོན་པའི་སྡུར་ཚད་ཆུང་དུ་གཏོང་དགོས་ན་འདེམས་གཞི་དེ་འདེམས་པ་སྦྲགས་བྲེགས་གཏུབ་སྒྲོམ་ནང་མོ་ཐང་ནང་འཇུག་བྱ་རོགས།  རིས་དབྱིབས་ཀྱི་མངོན་པའི་སྡུར་ཚད་ཆེ་རུང་གཏོང་དགོས་ན་བྲེགས་གཏུབ་སྒྲོམ་ནང་ཕོ་ཐང་ནང་འཇུག་བྱ་རོགས། \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3153683				0	bo	གཡོན་སྙོམས་གཤིབ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3145313				0	bo	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_LEFT\"\>གལ་ཏེ་\<emph\>མངོན་པའི་སྡུར་ཚད་རྒྱུན་འཁྱོངས་ \</emph\>འདེམས་གཞི་བདམས་རྗེས་ཕོ་ཐང་ནང་འཇུག་བྱས་ན་རིས་དབྱིབས་ཀྱི་གཡོན་མཐའ་བྲེགས་གཏུབ་བྱེད་  མོ་ཐང་ནང་འཇུག་བྱས་ན་རིས་དབྱིབས་ཀྱི་གཡོན་ངོས་སུ་ས་ཁོངས་སྟོང་པ་སྣོན་འཇུག་བྱེད།  གལ་ཏེ་\<emph\>བཪྙན་རིས་ཀྱི་ཆེ་ཆུང་རྒྱུན་འཁོངས་\</emph\>འདེམས་གཞི་བདམས་རྗེས་ཕོ་ཐང་ནང་འཇུག་བྱས་ན་རིས་དབྱིབས་ཀྱི་ཆུ་སྙོམ་མངོན་པའི་སྡུར་ཚད་འཕར་སྣོན་བྱེད། མོ་ཐང་ནང་འཇུག་བྱས་ན་རིས་དབྱིབས་ཀྱི་ཆུ་སྙོམ་མངོན་པའི་སྡུར་ཚད་ཆུང་དུ་འགྲོ།\</ahelp\>				2002-02-02 02:02:02
