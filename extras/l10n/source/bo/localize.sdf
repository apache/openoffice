helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3163712				0	bo	\<ahelp hid=\"HID_PROP_SORT_CRITERIA\"\>རེའུ་བྱང་གཞི་གྲངས་ཀྱི་རིམ་སྒྲིག་ཆ་རྐྱེན་གཏན་འཁེལ་བྱེད།  རིམ་སྒྲིག་ཆ་རྐྱེན་ཚད་ལྡན་གྱིས་ SQL སྒྲིག་སྲོལ་ལ་བརྩི་སྲུང་བྱེད་པ་ལས་ ORDER BY ཡན་ལག་བརྗོད་པ་མི་སྤྱོད། \</ahelp\>དཔེར་ན་ གལ་ཏེ་གཞི་གྲངས་མཛོད་ཀྱི་ཟིན་འགོད་ཡོད་ཚད་ཡིག་དུམ་ཞིག་རིམ་འཕར་རིམ་སྒྲིག་བྱེད་འདོད་པ་དང་གཞན་པའི་ཡིག་དུམ་ནང་རིམ་ཆག་རིམ་སྒྲིག་བྱེད་འདོད་ན་ Forename ASC, Name DESCནང་འཇུག་གྱིས་(གལ་ཏེ་ Forename དང་ Name གཞི་གྲངས་ཡིག་དུམ་གྱི་མིང་ཡིན་ན་)  				2002-02-02 02:02:02
