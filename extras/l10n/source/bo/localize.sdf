helpcontent2	source\text\swriter\01\04090003.xhp	0	help	par_id3147564				0	bo	ཡིག་གེའི་ཁོངས་ཤོག་བསྒརའཛུད་བྱས་ན་  རེའུ་འགོད་ནང་གི་རྣམ་གྲངས་ཤིག་མངོན་ཆེད་དུ་ཡིན་ལ།ཁ་སྣོན་དང་、རྩོམ་སྒྲིག་ སུབ་པའི་རྣམ་གྲང་སསྒྲུབ་ཐུབ་ཐོག་  རེའུ་འགོད་ནང་དེ་དག་གོ་རིམ་པའམ་དག་བཅོས་བྱེད་ཐུབ་ཀྱི་ཡོད།ཡིག་ཚགས་ཁྲོད་ཀྱིས་\<emph\>"རེའུ་འགོད་ནང་བཅུག་"\</emph\>ཁོངས་སམ་ Ctrl+Shift+F9 མཐེབ་རྐྱང་རྡེབ་བྱས་ན་  \<link href=\"text/swriter/01/04090003.xhp\" name=\"རྣམ་གྲངས་འདེམས་པ་\"\>\<emph\>"རྣམ་གྲངས་འདེམས་པ་"\</emph\>\</link\>གླིང་སྒྲོམ་མངོན་ཐུབ་པའི་ཡོད།				2002-02-02 02:02:02
