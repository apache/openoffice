helpcontent2	source\text\shared\02\12110000.xhp	0	help	par_id3152918				0	bo	སྤྱིར་བཏང་བཤེར་འཚོལ་དང་སྡུར་ན་(\<emph\>རེའུ་བྱང་ཚང་\</emph\>གི་\<link href=\"text/shared/02/12100200.xhp\" name=\"བཙལ་འཚོལ་ཟིན་ཐོ།\"\>བཙལ་འཚོལ་ཟིན་ཐོ།་\</link\>རིས་རྟགས་སྒུལ་སློང་)རེའུ་མིག་ཚུལ་གྱི་འཚག་ཆས་སྤྱད་ན་ཆེས་མགྱོགས་པའི་བཤེར་འཚོལ་མྱུར་ཚད་ཐོབ་ཐུབ།  རྒྱུན་གཏན་རྣམ་པའི་འོག་བཤེར་འཚོལ་འདི་དག་གིས་མྱུར་ཚད་དེ་བས་མགྱོགས་པའི་གཞི་གྲངས་མཛོད་ཞབས་ཞུ་ཆས་སྤྱོད་པར་བྱེད།  ད་དུང་དེ་བས་ཪྙོག་འཛིང་ཆེ་བའི་བཤེར་འཚོལ་ཆ་རྐྱེན་ནང་འཇུག་བྱས་ཆོག				2002-02-02 02:02:02
