helpcontent2	source\text\sbasic\shared\03030101.xhp	0	help	par_id3147229				0	bo	\<emph\>Year \</emph\>ཧྲིལ་གྲངས་མཚོན་ཚུལ་གྱིས་ལོ་མཚོན།  1900-1999 བར་གྱི་ལོ་འཁོར་ནི་ 0 ནས་ 99 བར་གྱི་ལྟོས་བཅས་ཀྱི་གྲངས་ཐང་གིས་མཚོན་ཆོག་  ཁྱབ་ཁོངས་འདི་ལས་བརྒལ་བའི་ལོ་འཁོར་ནི་ངེས་པར་དུ་འཐུས་ཚང་གི་གནས་བཞིའི་གྲངས་ཀ་ནང་འཇུག་བྱེད་དགོས།				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03030101.xhp	0	help	par_id3156280				0	bo	\<emph\>Month \</emph\>ཧྲིལ་གྲངས་མཚོན་ཚུལ་གྱིས་གཏན་འཁེལ་ལོ་འཁོར་ནང་གི་ཟླ་གྲངས་མཚོན།  ནུས་ལྡན་ཐང་གི་ཁྱབ་ཁོངས་ནི་ 1-12ཡིན།				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03030101.xhp	0	help	par_id3151043				0	bo	\<emph\>Day \</emph\>ཧྲིལ་གྲངས་མཚོན་ཚུལ་གྱིས་གཏན་འཁེལ་ཟླ་བའི་ནང་གི་ཉིན་གྲངས་མཚོན། ནུས་ལྡན་ཐང་གི་ཁྱབ་ཁོངས་ནི་ 1-31ཡིན་  ཞིབ་ཕྲའི་ནུས་ལྡན་ཐང་གི་ཁྱབ་ཁོངས་ནི་གནས་སའི་ཟླ་གྲངས་ཀྱིས་ཐག་གཅོད།				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03030101.xhp	0	help	par_id3161832				0	bo	\<emph\>DateSerial རྟེན་གྲངས་\</emph\>གིས་ 1899 ལོའི་ཟླ་ 12 ཚེས་ 30 ཉིན་དང་སྤྲད་པའི་ཚེས་གྲངས་བར་གྱི་ཁྱད་པར་ཕྱིར་ལོག་བྱེད།  དེར་བརྟེན་རྟེན་གྲངས་འདི་སྤྱད་ནས་ཚེས་དུས་གཉིས་བར་གྱི་ཁྱད་པར་གྱི་ཉིན་གྲངས་རྩིས་བརྒྱབ་ཆོག་				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03030101.xhp	0	help	par_id3155306				0	bo	\<emph\>DateSerial  རྟེན་གྲངས་\</emph\>ཕྱིར་ལོག་གི་གཞི་གྲངས་རིགས་ནི་གཟུགས་འགྱུར་རེད་  དེའི་ VarType ནི་ 7རེད་ དེ་ཡང་ཚེས་གྲངས་རེད།  བྱ་རིམ་ནང་ཁུལ་དུ་ཐང་འདི་དག་ཚད་ཆ་ལྡན་གྱི་རིགས་ལ་བརྩིས་ནས་གྲངས་ཐང་ཉར་གསོག་བྱེད་ དེར་བརྟེན་སྤྲད་པའི་ཚེས་གྲངས་ནི་ 1900.1.1 ཡིན་དུས་ཕྱིར་ལོག་ཐང་ཐང་ནི་ 2ཡིན།  མོ་ཐང་ནི་སྤྲད་པའི་ཚེས་དུས་ལས་ 1899 ལོའི་ཟླ་བ་ 12 ཚེས་ 30 ལས་སྔའོ།				2002-02-02 02:02:02
