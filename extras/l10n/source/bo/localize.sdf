helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3148637	122			0	bo	\<ahelp hid=\"HID_PROP_DATEMAX\" visibility=\"hidden\"\>ཚེས་གྲངས་ཞིགས་གཏན་འཁེལ་བྱེད་  སྤྱོད་པོས་ནང་ནང་འཇུག་གི་ཐང་ཚད་བཀག་ངེས་དུས་ཚོད་ཚེས་གྲངས་འདི་བརྒལ་མི་ཆོག\</ahelp\>ཚེས་གྲངས་ཞིགས་གཏན་འཁེལ་བྱེད་  སྤྱོད་པོས་ནང་འཇུག་གི་ཐང་ཚད་བཀག་ངེས་དུས་ཚོད་ཚེས་གྲངས་འདི་བརྒལ་མི་ཆོག				2002-02-02 02:02:02
