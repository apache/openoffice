helpcontent2	source\text\shared\02\14020100.xhp	0	help	par_id3152821	2			0	bo	\<variable id=\"tabellehinzufuegentext\"\>\<ahelp hid=\"HID_JOINSH_ADDTAB_TABLELIST\" visibility=\"hidden\"\>ཇུས་འགོད་སྒེའུ་ཁུང་ནང་བསྒར་འཛུད་དགོས་རྒྱུའི་རེའུ་མིག་གཏན་འཁེལ་བ།\</ahelp\>\<emph\>རེའུ་མིག་ཁ་སྣོན་\</emph\>གླེང་སྒྲོམ་ནང་མིག་སྔའི་ལས་འགན་ལ་མཁོ་བའི་རེའུ་མིག་འདེམས། \</variable\>འདྲི་རྩད་དམ་རེའུ་མིག་གསལ་མཐོང་ཡིག་ཟིན་གསར་འཛུགས་ཀྱི་སྐབས་འདྲི་རྩད་དམ་རེའུ་མིག་གསལ་མཐོང་ཡིན་ཟིན་གྱིས་འདྲེན་སྤྱོད་འོས་པའི་ལྟོས་བཅས་ཀྱི་རེའུ་མིག་བདམས་ང་བྱ་དགོས།    འབྲེལ་བའི་གཞི་གྲངས་མཛོད་སྤྱོད་པའི་སྐབས་དེ་ཁྲོད་དུ་འབྲེལ་བ་འཛུགས་པའི་རེའུ་མིག་བདམས་ང་བྱ་དགོས། 				2002-02-02 02:02:02
