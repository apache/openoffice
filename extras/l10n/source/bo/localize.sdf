helpcontent2	source\text\shared\02\01170000.xhp	0	help	par_id3149407				0	bo	\<ahelp hid=\".uno:ComboBox\"\>ཚོ་སྒྲིག་སྒྲོམ་ཞིག་གསར་བཟོ་བྱེད།\</ahelp\>ཚོ་སྒྲིག་སྒྲོམ་ནི་ཕྲེང་རྐྱང་རེའུ་འགོད་སྒྲོམ་ སྒྲོམ་ནང་རྒྱ་བསྐྱེད་རུང་བའི་རེའུ་དགོད་ཚུད་ཡོད་  སྤྱོད་པོ་འདེའི་ནང་འདེམས་གཞི་འདེམས།  ཚོ་སྒྲིག་སྒྲོམ་"ཀློག་ཙམ་"གཏོགས་གཤིས་ལ་གཏན་འཁེལ་བྱེད་  འདི་ལྟར་ མི་འདྲ་བའི་སྤྱོད་པོས་རེའུ་འགོད་ནང་ཚུད་པའི་འདེམས་གཞི་ཕུད་པའི་གཤར་བྱང་གཞན་ནང་འཇུག་མི་བྱེད།   གལ་སྲིད་རེའུ་བྱང་ནང་གཞི་གྲངས་མཛོད་ནང་བསྡམས་ངེས་བྱེད་ན་  གཞི་གྲངས་མཛོད་ཀྱི་འབྲེལ་མཐུད་གནས་སྟངས་ནི་ནུས་པ་ལྡན་  ཡིག་ཚགས་ནང་ཚོ་སྒྲིག་སྒྲོམ་བསྒར་འཛུད་རྗེས་རང་འགུལ་གྱིས་\<link href=\"text/shared/02/01170900.xhp\" name=\"ཚོ་སྒྲིག་སྒྲོམ་རང་འགུལ་ཡིག་ཆའི་ལས་རོགས།\"\>\<emph\>ཚོ་སྒྲིག་སྒྲོམ་ཕྱོགས་སྟོན་མངོན།\</emph\>\</link\>				2002-02-02 02:02:02
