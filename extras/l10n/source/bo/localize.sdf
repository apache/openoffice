helpcontent2	source\text\shared\04\01010000.xhp	0	help	par_id3154288				0	bo	གླེང་སྒྲོམ་ནང་རྟག་ཏུ་གཞི་རྒྱུ་ཞིག་འབུར་ཏུ་མངོན་པར་བྱེད་པ་ཕལ་ཆེར་ཟོལ་ཐིག་མཐའ་སྒྲོམ་ཡོད་ - གཞི་རྒྱུ་འདི་ནི་གནོན་མཐེབ་ཅིག་གམ་འདེམས་གཞིའི་ཡིག་དུམ་ཞིག་གམ་རེའུ་འགོད་སྒྲོམ་ནང་གི་གཤར་བྱང་ཞིག་གམ་བསྐྱར་འདེམས་སྒྲོམ་ཞིག་ཡིན་སྲིད་   ང་ཚོས་དེ་ལ་མདོ་གནས་ཤིག་ཡོད་པར་བརྗོད།  གལ་སྲིད་གཅིག་བསྡུས་ཟིན་པའི་གཞི་རྒྱུ་ནི་གནོན་མཐེབ་ཅིག་ཡིན་ན་Enterམཐེབ་ལ་རྐྱང་རྡེབ་བྱས་པ་ཙམ་གྱིས་དེ་ཉིད་ལག་བསྟར་བྱ་ཐུབ་པ་འདི་ནི་ཁྱེད་ཀྱིས་གནོན་མཐེབ་དེ་ང་རྐྱང་རྡེབ་བྱས་པ་དང་གཉིས་སུ་མེད།  བསྐྱར་འདེམས་སྒྲོམ་ཞིག་སྟོང་མཐེབ་ལ་རྐྱང་རྡེབ་བྱས་པ་བརྒྱུད་བརྗེ་ཐུབ།  གལ་སྲིད་གདམ་ངའི་ཡིག་དུམ་ཞིག་ལ་མདོ་གནས་ཞིག་ཡོད་ཚེ་འོད་རྟགས་མཐེབ་ཀྱིས་ས་ཁོངས་ནང་བརྗེ་བསྒྱུར་ལ་འདེམས་པའི་འདེམས་གཞིའི་ཡིག་དུམ་སྤྱད་ཆོག།   Tab མཐེབ་སྤྱད་ན་གཞི་རྒྱུའམ་ས་ཁོངས་ཤིག་ནས་མུ་མཐུད་གཞི་རྒྱུའམ་ས་ཁོངས་འོག་མར་བསྒྱུར་ཐུབ་ལ་ Shift+Tab ནི་ལྡོག་པའི་ཕྱོགས་སུ་སྤོས་པ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\04\01010000.xhp	0	help	par_id3149177				0	bo	Esc མཐེབ་གནོན་ནས་གླེང་སྒྲོམ་ཁ་བརྒྱབ་པ་ལས་བཟོ་བཅོས་ཉར་ཚགས་མི་བྱེད་པ། \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>\</caseinline\>\<defaultinline\>གལ་སྲིད་མདོ་གནས་གནོན་མཐེབ་ཞིག་གི་སྟེང་བཞག་ན་དེར་ཟོལ་ཐིག་མཐའ་སྒྲོམ་གྱི་གྲུ་བཞི་མངོན་པ་མ་ཟད་རྟགས་འདི་ལྟར་ཡོད་པའི་གནོན་མཐེབ་ལ་ད་དུང་གནོན་མཐེབ་གཞན་དང་སྡུར་ན་མཐུག་ཚད་མངོན་གསལ་དོད་པའི་གྲིབ་གཟུགས་མངོན་གསལ་འདོད་པའི་གྲིབ་གཟུགས་འདི་ལ་གཤམ་གྱི་དོན་སྙིང་ལྡན་ཡོད་པ་སྟེ་གལ་སྲིད་Enterམཐེབ་གནོན་ནས་གླེང་སྒྲོམ་མཇུག་སྒྲིལ་ན་མཐེབ་འདིའི་གོ་དོན་དང་མིག་སྔའི་མངོན་གསལ་འདོད་པའི་གྲིབ་གཟུགས་ལྡན་པའི་གནོན་མཐེབ་གཉིས་མཚུངས་སོ།  \</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
