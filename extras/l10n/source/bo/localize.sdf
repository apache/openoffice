helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156361				0	bo	\<ahelp hid=\"HID_FUNC_DEZIMAL\"\>ཉིད་\<link href=\"text/shared/00/00000005.xhp#zahlensystem\" name=\"གྲངས་ཀྱི་མ་ལག\"\>གྲངས་ཀྱི་མ་ལག\</link\> ནང་ཡིག་རྟགས་ཡོད་སའི་ཡི་གེ་དག་སྤྲོད་ངེས་ཀྱི་གཞི་གྲངས་གཞིར་བྱས་ཧྲིལ་གྲངས་ཕོ་ལ་བསྒྱུར་དགོས། \</ahelp\>གཞི་གྲངས་འདི་ངེས་པར་ 2 ནས་ 36 བར་ཡིན།  སྟོང་ཆ་དང་རེའུ་འགོད་རྟགས་ནི་སྣང་མེད་དུ་བཏང་།  \<emph\>Text\</emph\> ཚིག་དུམ་ལ་ཡིག་ཆེན་ཡིགཆུང་མི་དབྱེ།				2002-02-02 02:02:02
