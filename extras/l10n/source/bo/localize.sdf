helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3156384				0	bo	ཚལ་ཐོའི་\<emph\>[བདེ་འཇགས།] - [ནང་དོན་སྲུང་སྐྱོབ།] - [ལས་ཁྲ།...]\</emph\>བརྒྱུད་ནས་ལས་ཁྲའི་སྲུང་སྐྱོབ་སྒུལ་སློང་བྱེད།  ལས་ཁྲའི་སྲུང་སྐྱོབ་ལམ་སེང་ནུས་པ་ཐོན་ དེ་རྗེས་ཁྱེད་ཀྱིས་གོ་རིམ་ 1 ནང་འདེམས་པའི་དྲ་མིག་ས་ཁོངས་ཁོ་ན་རྩོམ་སྒྲིག་བྱ།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3149566	9			0	bo	གལ་ཏེ་རེ་བར་རྗེས་སུ་སྲུང་སྐྱོབ་དོར་བའི་དྲ་མིག་ས་ཁོངས་དེ་སྲུང་སྐྱོབ་ཐོབ་པའི་ས་ཁོངས་སུ་བཅོས་ཐུབ་པ་དགོས་ན་སྔོན་ལ་ས་ཁོངས་དེ་འདེམས་རོགས་  དེ་རྗེས་ཚལ་ཐོ་\<emph\>[བདེ་འཇགས།] - [ནང་དོན་སྲུང་སྐྱོབ།] - [དྲ་མིག...]\</emph\>འདེམས་པ་དང་\<emph\>"ཆིངས་བརྒྱབ་པའི་"\</emph\>བསྐྱར་འདེམས་སྒྲོམ་བདམས་པ།  མཇུག་མཐར་ཚལ་ཐོའི་\<emph\>[བདེ་འཇགས།] - [ནང་དོན་སྲུང་སྐྱོབ།] - [ལས་ཁྲ།...]\</emph\>འདེམས་པར་བྱ།  དེ་ལྟར་བྱས་ན་སྔོན་ཆུང་ནས་རྩོདརྩོད་སྒྲིག་བྱ་རུང་བའི་ས་ཁོངས་དེ་སྲུང་སྐྱོབ་ཐོབ་པའི་ས་ཁོངས་ཆགས་ཐུབ།  				2002-02-02 02:02:02
