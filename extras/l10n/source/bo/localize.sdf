helpcontent2	source\text\shared\autopi\01040000.xhp	0	help	par_id3156414				0	bo	$[officename] གྲོས་ཚོགས་གྲོས་རིམ་གྱི་མ་པང་དཔེ་གཞི་ཞིག་མཁོ་འདོན་བྱེད་ ཁྱེད་ཀྱི་རང་ཉིད་ཀྱི་དགོས་འཁོར་ཞིག་ནས་འདེར་བཟོ་བཅོས་བྱ། སྣེ་སྟོན་དེ་པར་དབྱིབས་དང་ཆོས་འགོད་འདེམས་ཞིག་སྣ་ཚོགས་མཁོ་འདོན་བྱེད་ ཡིག་ཚགས་མ་པང་འཛུགས་པའི་སྐབས་སྤྱད་ཆོག སྔོན་ལྟ་ཡིས་ཁྱེད་ཀྱིས་སྐྱེལ་གྲུབ་བྱས་པའི་གྲོས་ཚོགས་གྲོས་རིམ་ཀྱི་ཕན་འབྲས་རྒྱུས་མངའ་ཡོང་བ་བྱེད།				2002-02-02 02:02:02
