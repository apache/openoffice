helpcontent2	source\text\swriter\02\18030400.xhp	0	help	par_id3149294				0	bo	གལ་ཏེ་ཁྱེད་ཀྱི་རི་བར་མངོན་པའི་རྣམ་གཞག་དག་ཉེར་སྤྱོད་བྱ་འདོད་ན་ བཀའ་ཚིག་\<emph\>[བསྒར་འཛུད་] - [ཁོངས་] - [གཞན་དག་...]\</emph\>ཁོངས་བསྒར་འཛུད་བྱེད་པ་མ་ཟད་\<link href=\"text/swriter/01/04090000.xhp\" name=\"ཁོངས་བཀའ་བརྡ་\"\>\<emph\>"ཁོངས་བཀའ་བརྡ་"\</emph\>\</link\>གླེང་སྒྲོམ་ནང་རེ་བ་ལ་གཞིགས་ཏེ་བཀོད་སྒྲིག་བྱེད་ དེ་བཞིན་ཁྱེད་ཀྱིས་ཡང་ན་ཚལ་ཐོའུཐོའུ་བཀའ་ཚིག་\<emph\>[ཤོག་ཨང་]\</emph\>ནང་བསྒར་འཛུད་བྱས་པའི་ཡིག་དུམ་གྱི་རྣམ་གཞག་ལ་གཡས་མཐེབ་ཚལ་ཐོའི་བཀའ་ཚིག་\<link href=\"text/swriter/01/02140000.xhp\" name=\"རྩོམ་སྒྲིག་ཁོངས་བཀའ་བརྡ་\"\>\<emph\>[རྩོམ་སྒྲིག་ཁོངས་བཀའ་བརྡ་...]\</emph\>\</link\>སྤྱད་ནས་དག་བཅོས་བྱེད།				2002-02-02 02:02:02
