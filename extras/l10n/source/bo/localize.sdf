helpcontent2	source\text\scalc\guide\auto_off.xhp	0	help	par_id3156442				0	bo	ཁས་ལེན་གནས་ཚུལ་འོག་ $[officename] ཡིས་ཁྱེད་ཀྱིས་མཐེབ་འཇུག་བྱ་སྐབས་རྒྱུན་མཐོང་གིས་མཐེབ་འཇུག་ནོར་འཁྲུལ་རང་འགུལ་གྱིས་དག་བཅོས་བྱེད་ \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>བཀའ་ཚིག་དག་བཅོས་བྱེད་\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+Z རང་འགུལ་བཟོ་བཅོས་དེ་དག་ལམ་སེང་ཕྱིར་འཐེན་བྱས་ཆོག				2002-02-02 02:02:02
helpcontent2	source\text\scalc\guide\auto_off.xhp	0	help	par_id3145273				0	bo	གཤམ་ལ་ཇི་ལྟར་བྱས་ནས་$[officename] གློག་རྡུལ་དྲ་མིག་གི་རང་འགུལ་བཟོ་བཅོས་བྱེད་ནུས་ཁ་རྒྱག་པའམ་བསྐྱར་དུ་སྒུལ་སློང་བྱ་ཐབས་གསལ་བཤད་བྱ།				2002-02-02 02:02:02
