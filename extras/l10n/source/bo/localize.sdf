helpcontent2	source\text\scalc\guide\format_table.xhp	0	help	par_id3145389				0	bo	\<item type=\"menuitem\"\>[ཡིག་ཆ།] - [ཤོག་ངོས་བཀོད་སྒྲིག...] - "རྒྱབ་ལྗོངས།"\</item\>འདེམས་གཞིའི་ཁྭ་བརྒྱུད་ནས་ཁུར་སྣོན་བྱས་པའི་བཪྙན་རིས་དེ་གཏག་པར་རམ་ཤོག་ངོས་སྔོན་ལྟ་ཁོ་ནར་མཐོང་ཐུབ། གསལ་ཡོལ་སྟེང་དུའང་རྒྱབ་ལྗོངས་བཪྙན་རིས་མངོན་པ་ཞིག་དགོས་ན་\<item type=\"menuitem\"\>[བསྒར་འཛུད།] - [པར་རིས།] - [ཡིག་ཆ་ནས་ཡོང་བའི་པར་རིས།...]\</item\>བསྒར་འཛུད་བཪྙན་རིས་འདེམས་དགོས་པ་མ་ཟད་གཡས་མཐེབ་ཚལ་ཐོའི་བཀའ་ཚིག་འདེམས་ནས་\<item type=\"menuitem\"\>[བརྩེགས་འཇོག་ཐེངས་རིམ།] - [མཐིལ་ངོས་ལ་འཇོག་པ།]\</item\>གིས་བཪྙན་རིས་དེ་དྲ་མིག་གི་རྒྱབ་ལྗོངས་འདེམས་པར་བྱ།   \<link href=\"text/scalc/01/02110000.xhp\" name=\"ལག་རོགས།\"\>ལག་རོགས།\</link\>སྤྱད་ནས་རྒྱབ་ལྗོངས་བཪྙན་རིས་འདེམས་པར་བྱ།				2002-02-02 02:02:02
