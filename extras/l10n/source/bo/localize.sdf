helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3153921				0	bo	SELECT རྣམ་གྲངས་ FROM མངགས་ཐོ་ WHERE Customer_Number =: x(གལ་ཏེ་མངགས་ཉོ་བྱ་རྒྱུའི་རེའུ་མིག་ནང་གི་རེའུ་བྱང་གིས་"རྣམ་གྲངས།"ཡིག་དུམ་གྱི་གཞི་གྲངས་ཁོ་ན་མངོན་)				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3148488				0	bo	ཁྱེད་ཀྱིས་\<emph\>གཞི་གྲངས་ཁུངས་\</emph\>ཡིག་དུམ་ནང་ SQL བཀའ་བརྡ་ནང་འཇུག་བྱེད་པའམ་ཡན་ལག་རེའུ་བྱང་གསར་འཛུགས་བྱ་རྒྱུར་སྤྱོད་པའི་ལྟོས་བཅས་ཀྱི་ཞུགས་གྲངས་བརྩད་འདྲི་གསར་འཛུགས་བྱེད།   				2002-02-02 02:02:02
