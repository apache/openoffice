helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_id3144766				0	bo	\<ahelp hid=\".uno:FontColor\" visibility=\"hidden\"\>\<variable id=\"textfarbe\"\>རྐྱང་རྡེབ་ཀྱིས་བདམས་པའི་ཡིག་རྟགས་ལ་མིག་སྔའི་ཡིག་གཟུགས་ཚོས་གཞི་ཉེར་སྤྱོད་བྱེད།  ཁྱེད་ཀྱིས་རིས་རྟགས་འདི་ལ་རྐྱང་རྡེབ་བྱས་རྗེས་འདྲུད་སྒུལ་བརྒྱུད་བདམས་པའི་ནང་དོན་གྱིས་ཡི་གེའི་ཚོས་གཞི་བཟོ་བཅོས་བྱེད།  རིས་རྟགས་འཁྲིས་ཀྱི་མདའ་རྩེར་རྐྱང་རྡེབ་བྱས་ན་\<emph\>ཡིག་གཟུགས་ཚོས་གཞི་\</emph\>ཡོ་ཆས་ཚང་ཁ་ཕྱེའོ།\</variable\>\</ahelp\>				2002-02-02 02:02:02
