helpcontent2	source\text\shared\guide\line_intext.xhp	0	help	par_id3159149				0	bo	\<emph\>འདེམས་པ་\</emph\> རིས་རྟགས་རྗེས་རྐྱང་རྡེབ་བྱེད་    Shift མཐེབ་གནོན་འཛིན་བྱེད་པ་མ་ཟད་ཐིག་སྐུད་ཚང་མ་རྐྱང་རྡེབ་བྱེད།  ཐིག་སྐུད་ཡོད་ཚད་འདེམས་ འདི་འདྲའི་ཟློས་མང་འདེམས་པའི་བྱེད་ནུས་བེད་སྤྱོད་བྱེད་  ཐིག་སྐུད་ཡོད་ཚད་བེད་སྤྱོད་པའི་ཚོས་གཞི་ ཞེང་ཚད་ཡང་ན་གཏོགས་གཤིས་གཞན་གཏན་འཁེལ་བྱེད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\line_intext.xhp	0	help	par_id3153049				0	bo	སྔོན་བཀོད་ཀྱི་ཡིག་དུམ་བཟོ་ལྟ་\<emph\>ཆུ་སྙོམས་ཐིག་སྐུད་\</emph\>ཉེར་སྤྱོད་བརྒྱུད་ཆུ་སྙོམས་ཐིག་སྐུད་འཛུགས་དུམ་མཚམས་སྟོང་པའི་ནང་རྐྱང་རྡེབ་བྱེད་  དེ་རྗེས་"བཟོ་ལྟའི་རིགས་"སྒེའུ་ཁུང་ནང་\<emph\>ཆུ་སྙོམས་ཐིག་སྐུད་\</emph\>བཟོ་ལྟ་རྐྱང་རྡེབ་བྱེད།  གལ་སྲིད་ཆུ་སྙོམས་ཐིག་སྐུད་གཤར་བྱང་ནི་"དུམ་མཚམས་བཟོ་ལྟ་"རེའུ་འགོད་ནང་མཐོང་མི་ཐུབ་ན་  ཅུང་འོག་ཕྱོགས་ཀྱི་རེའུ་འགོད་སྒྲོམ་ནང་"བཟོ་ལྟ་ཡོད་ཚད་"འདེམས་པ་འདེམས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\line_intext.xhp	0	help	par_id3153748				0	bo	\<emph\>རྣམ་གཞག་ - ཡིག་དུམ་ - \</emph\>\<link href=\"text/shared/01/05030500.xhp\" name=\"མཐའ་སྒྲོམ་\"\>\<emph\>མཐའ་སྒྲོམ་\</emph\>\</link\>འདེམས་པ་བརྒྱུད་བྲིས་འགོད་ཀྱི་ཐིག་སྐུད་ཡིག་དུམ་ཐོག་ལ་ འགྲམ་ལ་ཡང་ན་འོག་ལ་གནས།   				2002-02-02 02:02:02
