helpcontent2	source\text\shared\main0227.xhp	0	help	par_id3160478				0	bo	\<ahelp hid=\".uno:BezierInsert\"\>བསྒར་འཛུད་མ་ཚུལ་སྒུལ་སློང་བྱེད། མ་ཚུལ་དེའི་ནང་མཐུད་ཚེག་བསྒར་འཛུད་བྱ་ཐུབ། \</ahelp\>ད་དུང་སྤོ་སྒུལ་མ་ཚུལ་ནང་དང་འདྲ་བར་མཐུད་ཚེག་སྤོ་སྒུལ་བྱ་ཐུབ། འོན་ཏེ་ གལ་སྲིད་མཐུད་ཚེག་གཉིས་བར་དུ་འཁྱོག་ཐིག་སྟེང་རྐྱང་རྡེབ་བྱས་པ་དང་སྦྲགས་ཙིག་རྟགས་མཐེབ་གནོན་འཛིན་གྱིས་ཙིག་རྟགས་འཇམ་པོར་སྤོ་སྒུལ་བྱས་པས་མཐུད་ཚེག་གསར་པ་ཞིག་བསྒར་འཛུད་བྱེད་ ཚེག་དེ་ནི་སྙོམ་འདྲེད་ཀྱི་ཚེག་གཅིག་ཡིན་ ཚོད་འཛིན་ཚེག་ལ་སླེབས་པའི་ཐིག་སྐུད་ནི་མཉམ་བགྲོད་ཡིན་ཞིང་ མ་ཟད་སྤོ་སྒུལ་བྱས་རྗེས་སྔར་བཞིན་མཉམ་བགྲོད་རྒྱུན་མཐུད་བྱས་ཡོད།				2002-02-02 02:02:02
