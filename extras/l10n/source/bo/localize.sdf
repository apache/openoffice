helpcontent2	source\text\swriter\01\04090001.xhp	0	help	par_id3156123				0	bo	མིག་སྔའི་མ་པང་གྱི་ཡིག་ཆའི་མིང་དང་ རྒྱུད་ལག་ཡང་ན་རྒྱ་སྐྱེད་མིང་མ་ཚུད་པའི་མིང་བསྒར་འཛུད་བྱེད།མིང་སྔའི་མ་པང་གྱི་བེད་སྤྱོད་པའི་"རེས་དབྱེ་"དང་"བཟོ་ལྟ་"རྣམ་གཞག་ཀྱི་མིང་བསྒར་འཛུད་བྱེད་དགོས།མ་པང་ནང་སྤྱད་པའི་་མ་པང་རིགས་དབྱེ་དང་བཟོ་ལྷའི་མིང་ལྟ་ཞིབ་བྱས་ན་  ཚལ་ཐོ་\<emph\>[ཡིག་ཆ་] - [མ་པང་དོ་དམ་] -\</emph\>\<link href=\"text/shared/01/01110100.xhp\" name=\"དོ་དམ་\"\>\<emph\>[དོ་དམ་...]\</emph\>\</link\>འདེམས་དགོས།				2002-02-02 02:02:02
