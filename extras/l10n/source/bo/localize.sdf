helpcontent2	source\text\shared\00\00000002.xhp	0	help	par_id3149483	74			0	bo	$[officename] གི་ཐབས་ཤེས་འདི་གཉིས་ཀྱི་བཪྙན་རིས་རྟེན་འཕྲོ་གསར་དུ་འཛུགས་ \<emph\>བཪྙན་རིས་རྟེན་འཕྲོ་རྩོམ་སྒྲིག་ཆས་\</emph\>ནང་\<emph\>གཞན་ཉར་\</emph\>གླེང་སྒྲོམ་ཁ་ཕྱེ་བ་དང་དེ་རྗེས་\<emph\>ཉར་ཚགས་རིགས་\</emph\>ཀྱི་རེའུ་འགོད་ནང་ནས་རྣམ་གཞག་གདམ་དགོས་ བཙུགས་ཟིན་པའི་རང་ཚུགས་བཪྙན་རིས་ཡི་ཆ་དེ་ངེས་པར་དུ་ཞབས་ཆས་སུ་ཡར་སྐྱེལ་དགོས་ ཁྱེད་ཀྱི་མཁོ་འདོན་ཚོང་པའམ་དྲ་རྒྱ་དོ་དམ་མཁན་ལ་ཞབས་ཆས་ཀྱིས་རྒྱབ་སྐྱོར་བྱེད་པའི་བཪྙན་རིས་རྟེན་འཕྲོ་རིགས་དང་ཇི་ལྟར་བྱས་ཏེ་ཐག་གཅོད་བྱ་རིམ་ལ་བཅར་འདྲི་ཞུ་དགོས་མིན་སྐད་ཆ་འདྲི་དགོས།				2002-02-02 02:02:02
