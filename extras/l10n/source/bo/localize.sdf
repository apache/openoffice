helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153081	37			0	bo	=DDE("soffice";"c:\\office5\\document\\motto.sdw";"Today's motto") སྤྱི་བགྲོས་གནས་པའི་དྲ་མིག་ནང་ཉིན་དེའི་ལེགས་བཤད་ཟློག་སྐྱེལ་ཐུབ།  སྔོན་འགྲོ་ནི་ཁྱེད་ནས་ངེས་པར་དུ་$[officename] ཡི་གེ་ལས་སྣོན་ཡིག་ཚགས་motto.sdw ནང་ཉིན་དེའི་ལེགས་བཤད་གཅིག་ནང་འཇུག་བྱ་དགོས་པ་དང་ཉིན་དེའི་ལེགས་བཤད་གནས་སའི་ཡིག་ཕྲེང་དེ་གཏན་འཁེལ་ས་ཁོངས་(ཉིན་དེའི་ལེགས་བཤད་)ཀྱི་ཕྲེང་དང་པོ་སྟེ་($[officename] ཡི་གེ་ལས་སྣོན་ཚལ་ཐོའི་བཀའ་ཚིག་:[བསྒར་འཛུད།] - [ས་ཁོངས།...])ཡི་གེ་ལས་སྣོན་$[officename] ཡིག་ཚགས་ནང་གི་ཉིན་དེའི་ལེགས་བཤད་བསྒྱུར་བཅོས་དང་ཉར་ཚགས་བྱས་མ་ཐག་$[officename] ལས་དེབ་ནང་མཚན་འཇོག་བྱས་ཟིན་པའི་ DDE ཐག་སྦྲེལ་གྱི་དྲ་མིག་ནང་བསྒྱུར་བཅོས་རྗེས་ཀྱི་ཉིན་དེའི་ལེགས་བཤད་མངོན།				2002-02-02 02:02:02
