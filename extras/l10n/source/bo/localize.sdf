helpcontent2	source\text\schart\01\04070000.xhp	0	help	par_id3154754				0	bo	\<variable id=\"sytextxgitter\"\>\<ahelp hid=\".uno:ToggleGridHorizontal\"\>\<emph\>[རྣམ་གཞག་ཡོ་བྱད་ཚང་]\</emph\>སྟེང་གི་\<emph\>"འཕྲེད་ཕྱོགས་དྲ་མིག་མངོན་པའམ་གབ་པའི་"\</emph\>རིས་རྟགས་མདའ་ X དྲ་མིག་མངོན་པ་བརྗེ་བསྒྱུར་ལ་སྤྱོད།  ཡིད་གཟབ་དགོས་རྒྱུར་\<emph\>[བསྒར་འཛུད་] - [སྲ་མིག་ཐིག་...]\</emph\>ནང་\<emph\>"དྲ་མིག་ཐིཐི་ཕལ་པ་"\</emph\>འདེམས་རྒྱུ་ཡིན་དུས་བྱེད་ནུས་འདིས་ནུས་པ་ཐོན་ཐུབ།  \</ahelp\>\</variable\> དེ་མིན་དྲ་མིག་གཙོ་བོ་གཏན་འགོག་བྱས་རྗེས་དྲ་མིག་འདི་སྔར་བཞིན་མཐོང་ཐུབ།				2002-02-02 02:02:02
