helpcontent2	source\text\shared\main0213.xhp	0	help	par_id3157910				0	bo	རེའུ་བྱང་གཞི་གྲངས་མཛོད་ལ་སྦྲེལ་བའི་སྐབས་ཁོ་ནར་ཕྱོགས་སྟོན་ཚང་གཞི་ནས་མཐོང་ཐུབ། རེའུ་བྱང་གི་\<link href=\"text/shared/explorer/database/04030000.xhp\" name=\"མཐོང་རིས་ཇུས་འགོད་\"\>མཐོང་རིས་ཇུས་འགོད་\</link\>ནང་ཕྱོགས་སྟོན་ཚང་བེད་སྤྱོད་མེད། \<link href=\"text/shared/main0212.xhp\" name=\"གཞི་གྲངས་མཛོད་ཡོ་བྱད་ཚང་\"\>གཞི་གྲངས་མཛོད་ཡོ་བྱད་ཚང་\</link\>ལ་དཔྱད་གཟིགས་མཛོད།				2002-02-02 02:02:02
