helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3149923				0	bo	\<ahelp hid=\"HID_PROP_SLAVEFIELDS\"\>གལ་ཏེ་ཡན་ལག་རེའུ་བྱང་འཛུགས་ན་རེའུ་བྱང་ཕའི་ཡིག་དུམ་ནང་གྲངས་ཐང་དུ་ཉར་ཚགས་ལ་སྤྱོད་པའི་གྲངས་ཐང་ཡིན་སྲིད་པའི་འགྱུར་ཚད་ནང་འཇུག་གྱིས། \</ahelp\>གལ་ཏེ་ཡན་ལག་རེའུ་བྱང་བརྩད་འདྲི་གཞིར་བྱས་ན་བརྩད་འདྲིའི་ནང་མཚན་འཇོག་བྱ་རྒྱུའི་འགྱུར་ཚད་ནང་འཇུག་གྱིས།  གལ་ཏེ་\<emph\>གཞི་གྲངས་ཁུངས་སྤྱད་ན་\</emph\>ཡིག་དུམ་ནང་འཇུག་བྱས་པའི་ SQL བརྗོད་པ་སྤྱད་དེ་རེའུ་བྱང་གསར་འཛུགས་བྱས་ན་ཁྱེད་ཀྱིས་བརྗོད་པའི་ནང་སྤྱོད་པའི་འགྱུར་ཚད་ནང་འཇུག་གྱིས།  འགྱུར་ཚད་ཀྱི་མིང་གང་རུང་སྤྱད་ཆོག   གལ་ཏེ་གྲང་ཐང་མང་པོ་ནང་འཇུག་བྱེད་ན་ Shift+Enter མཐེབ་གནོན་དགོས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3155114				0	bo	གལ་ཏེ་ དཔེར་ན་\<emph\>མཐེབ་ཡིག་དུམ་གཙོ་བོ་མཐུད་ནས་\</emph\>ནང་ Customer_ID གཞི་གྲངས་མཛོད་ཡིག་དུམ་ནི་ཡིག་དུམ་ཕ་ལ་གཏན་འཁེལ་བྱེད་ \<emph\>ཐག་སྦྲེལ་ནི་ཡིག་དུམ་\</emph\>ནང་ཉར་ཚགས་ Customer_ID གཞི་གྲངས་མཛོད་ཀྱི་ཡིག་དུམ་ཐང་གི་འགྱུར་ཚད་མིང་ལ་མཚན་འཇོག་བྱེད་ གཞི་གྲངས་མཛོད་ཡིག་དུམ་"མཁོ་མཁན་ཨང་སྒྲིག"གི་ཐང་ནི་འགྱུར་ཚད་འདིའི་ནང་ཀློག་ལེན་བྱེད། གལ་ཏེ་འགྱུར་ཚད་འདི་སྤྱད་ནས་\<emph\>གཞི་གྲངས་ཁུངས་\</emph\>སྒྲོམ་ནང་བརྗོད་པ་ SQL ཞིག་གཏན་འཁེལ་བྱེད་ན་རེའུ་བྱང་ནང་འབྲེལ་ཡོད་ཐང་མངོན་ནོ།				2002-02-02 02:02:02
