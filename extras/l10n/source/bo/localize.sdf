helpcontent2	source\text\shared\01\05020300.xhp	0	help	par_id3148563				0	bo	\<ahelp hid=\"SVX:LISTBOX:RID_SVXPAGE_NUMBERFORMAT:LB_CURRENCY\"\>དངུལ་ལོར་ཞིག་འདེམས་པ་དང་  དེ་རྗེས་\<emph\>"རྣམ་གཞག་"\</emph\>ལ་འགྲིལ་འཁོར་བྱེད་པ་དང་རེའུ་འགོད་ཀྱི་རྩེ་མོར་དངུལ་ལོར་འདི་དང་ལྟོས་ཟླ་བྱེད་པའི་རྣམ་གཞག་འདེམས་གཞི་ལྟ་ཞིབ་བྱེད། \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020300.xhp	0	help	par_id3150866	99			0	bo	དངུལ་ལོར་གྱི་རྣམ་གཞག་ཨང་ལ་ [$xxx-nnn] ཡི་རྣམ་གཞག་སྤྱོད་  དེའི་ནང་ xxx ནི་དངུལ་ལོར་མཚོན་རྟགས་ཡིན་nnn ནི་རྒྱལ་ཁབ་/ས་ཁུལ་གྱི་ཚབ་ཨང་ཡིན།   དམིགས་བསལ་གྱི་དངུལ་ཁང་མཚོན་རྟགས་ཁག་གཅིག་དཔེར་ན་ཡོ་སྒོར་ལ་སྤྱོད་པའི་EURལ་རྒྱབ་ཁབ་/ས་ཁུལ་གྱི་ཚབ་ཨང་མི་སྤྱོད།  དངུལ་ལོར་རྣམ་གཞག་ལ་\<emph\>སྐད་བརྡ་\</emph\>སྒྲོམ་ནང་བདམས་པའི་སྐད་བརྡ་ཤུགས་རྐྱེན་མི་ཕོག				2002-02-02 02:02:02
