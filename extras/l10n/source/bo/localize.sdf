helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150826				0	bo	\<ahelp hid=\"HID_FUNC_VORLAGE\"\>བཟོ་ལྟ་སྤྱི་བགྲོས་ཚུད་པའི་དྲ་མིག་ཏུ་སྤྱོད་པ་ཡིན། \</ahelp\> དུས་ཚོད་ངེས་ཅན་ཞིག་རྗེས་ བཟོ་ལྟ་གཞན་ཞིག་སླར་སྤྱད་ཆོག   རྟེན་གྲངས་འདི་ནམ་ཡང་ཕྱིར་ལོག་གྲངས་ཐང་ 0ཡིན་  ཁྱེད་ནས་གྲངས་ཐང་འདི་ཉིད་སྔ་མ་བཞིན་སོར་གནས་ཀྱི་སྒོ་ནས་རྟེན་གྲངས་གཞན་ཞིག་ནང་བསྣན་ན་འགྲིག    རྟེན་གྲངས་CURRENT མཉམ་དུ་སྤྱད་ནས་ཚོས་གཞི་ཉིད་དྲ་མིག་ལ་སྤྱོད་ཀྱང་ཐང་དེའི་ཞུགས་རྐྱེན་མི་ཐེབས་པ།  དཔེར་ན་:=...+STYLE(IF(CURRENT()>3;"red";"green")) གྲངས་ཐང་ 3 ཆེ་བའི་སྐབས་བཟོ་ལྟ་"དམར་པོ་"དྲ་མིག་ཏུ་སྤྱོད་པ་དང་  དེ་མིན་ན་"ལྗང་ཁུ་"སྤྱོད།  དྲ་མིག་གཉིས་ཀྱི་བཟོ་ལྟ་ཚང་མ་ངེས་པར་སྔོན་ནས་མཚན་འཇོག་བྱ་དགོས།				2002-02-02 02:02:02
