helpcontent2	source\text\swriter\01\04040000.xhp	0	help	par_id3149806	2			0	bo	\<variable id=\"textmarkeein\"\>\<ahelp hid=\".uno:InsertBookmark\"\>འོད་རྟགས་གནས་པའི་གནས་སར་ཤོག་མཆན་བསྒར་འཛུད་བྱེད་པ་དང།དེ་རྗེས་ལག་རོགས་བེད་སྤྱོད་ཀྱི་མགྱོགས་མྱུར་ངང་དེ་འཕྲལ་བྲིས་རྟགས་ཀྱི་གནས་སར་མཆོངས་སྒྱུར་བྱེད་དགོས།\</ahelp\> HTML ཡིག་ཚགས་ནང་  ཤོག་མཆན་དེ་ཆེས་ཐག་སྦྲེལ་རྒྱུད་མཆོངས་སྒྱུར་བྱེད་པའོ་གནས་ངེས་བྲིས་རྟགས་སུ་བརྗེ་སྒྱུར་བྱེད།\</variable\>				2002-02-02 02:02:02
