helpcontent2	source\text\shared\optionen\01060300.xhp	0	help	par_id3154684				0	bo	\<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_LAYOUT_CB_EXPREF\"\>དེང་སྤྱོད་ཁྱབ་ཁོངས་ཀྱི་མཐའ་འཁོར་དུ་སྟར་རམ་ཕྲེང་བསྒར་འཛུད་སྐབས་རྒྱ་སྤེལ་སྤྱོད་མིན་གཏན་འཁེལ་དགོས།  ཕྲེང་ངམ་སྟར་གྱི་བསྒར་འཛུད་དེང་སྤྱོད་ཁྱབ་ཁོངས་དེ་དགོས་ངེས་ཀྱི་ཁ་ཕྱོགས་སྟེང་ཉུང་མཐར་དྲ་མིག་གཉིས་ཡོད་ན་གཞི་ནས་རྒྱ་སྤེལ་སྤྱོད་ཆོག \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01060300.xhp	0	help	par_id3153194				0	bo	\<emph\>དཔེ་གཞི་:\</emph\>གལ་ཏེ་སྤྱི་འགྲོས་ནང་དྲ་མིག་ཁོངས་ A1:B1 སྤྱོད་ཚེ་སྟར་ B བཏོན་རྗེས་སྟར་གསར་བསྒར་འཛུད་བྱས་རྗེས་སྤྱོད་པ་དེ་  A1:C1དེ་རྒྱ་སྤེལ་བྱེད།   གལ་ཏེ་སྤྱོད་པ་དེ་དྲ་མིག་ཁོངས་ A1:B1ཡིན་ན་ཕྲེང་དང་པོའི་འོག་ཕྲེང་གསར་པ་བསྒར་འཛུད་བྱས་ཀྱང་སྤྱོད་པའི་ཁྱབ་ཁོངས་ལ་རྒྱ་སྤེལ་མི་འགྲོ་  དེ་ཡང་སྔོན་དེང་སྤྱོད་ཁྱབ་ཁོངས་དེ་ཐད་དཔྱང་ཁ་ཕྱོགས་སུ་དྲ་མིག་གཅིག་ལས་མེད་པས་སོ།				2002-02-02 02:02:02
