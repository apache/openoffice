helpcontent2	source\text\shared\explorer\database\04030000.xhp	0	help	par_id3154230				0	bo	$[officename] ཡིག་ཚགས་གང་འདྲ་ཞིག་ཀྱང་རེའུ་བྱང་ནང་བསྣར་བར་བྱེད།  རེའུ་བྱང་ཚོད་ཆས་གཅིག་གམ་མང་པོ་གསབ་སྣོན་བྱེད་པ་ཁོ་ནས་འཐུས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\04030000.xhp	0	help	par_id3145382				0	bo	"ཚོད་ཆས་"ཡོ་ཆས་ཚང་ཁ་ཕྱེ།  "ཚོད་ཆས་"ཡོ་ཆས་ཚང་ལ་རེའུ་བྱང་རྩོམ་སྒྲིག་ལ་མཁོ་བའི།\<link href=\"text/shared/02/01170000.xhp\" name=\"བྱེད་ནུས་\"\>བྱེད་ནུས་\</link\>ཚུད་ཡོད།  ཆེས་མང་བའི་བྱེད་ནུས་\<emph\>རེའུ་བྱང་བྱ་ཡུལ་ཚང།\</emph\>、\<emph\>རེའུ་བྱང་ཇུས་འགོད་ཚང།\</emph\>དང།\<emph\>ཆེས་མང་བའི་ཚོད་ཆས་ཚང།\</emph\>བརྒྱུད་ནས་ཐོབ་པར་འགྱུར།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\04030000.xhp	0	help	par_id3153146				0	bo	རེའུ་བྱང་ཇུས་འགོད་ནང་ ཁྱེད་ཀྱིས་\<link href=\"text/shared/02/01170000.xhp\" name=\"གསབ་སྣོན་ཚོད་ཆས་\"\>གསབ་སྣོན་ཚོད་ཆས་\</link\>ཚོད་ཆས་ལ།\<link href=\"text/shared/02/01170100.xhp\" name=\"གཏོགས་གཤིས་ཉེར་སྤྱོད།\"\>གཏོགས་གཤིས་ཉེར་སྤྱོད།\</link\>མཚན་འཇོག་བྱེད་པ་དང།\<link href=\"text/shared/02/01170200.xhp\" name=\"རེའུ་བྱང་གཏོགས་གཤིས་\"\>རེའུ་བྱང་གཏོགས་གཤིས་\</link\>མཚན་འཇོག་བྱེད་པ་དང།\<link href=\"text/shared/02/01170203.xhp\" name=\"ཡན་ལག་རེའུ་བྱང་མཚན་འཇོག།\"\>ཡན་ལག་རེའུ་བྱང་མཚན་འཇོག།\</link\>ལ་མཚན་འཇོག་བྱེད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\04030000.xhp	0	help	par_id3154924	9			0	bo	"རེའུ་བྱང་བྱ་ཡུང་"ཚང་སྟེང་གི།\<emph\>རེའུ་བྱང་ལག་རོགས་\</emph\>རིས་རྟགས་\<image id=\"img_id3156002\" src=\"res/commandimagelist/sc_showfmexplorer.png\" width=\"0.1665inch\" height=\"0.1665inch\"\>\<alt id=\"alt_id3156002\" xml-lang=\"bo\"\>རིས་རྟགས་\</alt\>\</image\> \<link href=\"text/shared/02/01170600.xhp\" name=\"རེའུ་བྱང་ལག་རོགས་\"\>\<emph\>རེའུ་བྱང་ལག་རོགས་\</emph\>\</link\>ཁ་འབྱེད་ཐུབ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\04030000.xhp	0	help	par_id3153968	6			0	bo	\<link href=\"text/shared/02/01171000.xhp\" name=\"ཇུས་འགོད་མ་ཚུལ་འོག་ཁ་ཕྱེ་བ་\"\>\<emph\>ཇུས་འགོད་མ་ཚུལ་འོག་ཁ་ཕྱེ་བ་\</emph\>\</link\>རིས་རྟགས་\<image id=\"img_id1871395\" src=\"res/commandimagelist/sc_openreadonly.png\" width=\"0.2201inch\" height=\"0.2201inch\"\>\<alt id=\"alt_id1871395\"\>རིས་རྟགས་\</alt\>\</image\> ཁྱེད་ཀྱིས་རེའུ་བྱང་ཡིག་ཚགས་ཉར་ཚགས་བྱེད་ཅིང་དེའི་བྱེད་ནུས་སྤྱི་རྩོམ་སྒྲིག་མ་ཚུལ་འོག་ཁ་འབྱེད་པར་སྟབས་བདེ་སྐྲུན།    				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\04030000.xhp	0	help	par_id3154948				0	bo	གལ་ཏེ་རེའུ་བྱང་ལྡན་པའི་བྱ་ཡུལ་ལ་གཏོགས་གཤིས་གཏན་འཁེལ་བྱེད་དུས་ནོར་འཁྲུལ་བྱུང་ན་(དཔེར་ན་  གནས་མེད་པའི་གཞི་གྲངས་རེའུ་མིག་བྱ་ཡུལ་ལ་གཏན་འཁེལ་བྱེད།)ལྟོས་བཅས་ཀྱི་ནོར་འཁྲུལ་སྙན་ཐོ་མངོན།  ནོར་འཁྲུལ་སྙན་ཐོའི་ནང་ཧ་ལམ།\<emph\>ཆེས་མང།\</emph\>གནོན་མཐེབ་ཚུད་ཡོད། \<ahelp hid=\"dummy\"\>\<emph\>ཆེས་མང།\</emph\>གནོན་མཐེབ་ལ་རྐྱང་རྡེབ་བྱས་རྗེས་གླགླཕང་སྒྲོམ་ཞིག་ཐོན་ཞིང་འབྲེལ་ཡོད་མིག་སྔའི་གནས་ཚུལ་ཆེས་མང་པོ་མངོན་ནོ།  \</ahelp\>				2002-02-02 02:02:02
