helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3163710				0	bo	\<variable id=\"bedingtetext\"\>\<ahelp hid=\".uno:ConditionalFormatDialog\"\>ཆ་རྐྱེན་གང་རུང་ལ་གཞིགས་ནས་རྣམ་གཞག་བཟོ་ལྟ་གཏན་འཁེལ་བྱེད།  \</ahelp\>\</variable\>གལ་ཏེ་དྲ་མིག་ལ་བཟོ་ལྟ་གཏན་འཁེལ་བྱས་ཡོད་ན་ བཟོ་ལྟ་དེ་འགྱུར་མི་ཐུབ།  འདིར་ནང་འཇུག་བྱས་པའི་བཟོ་ལྟ་དེ་ཁ་གསབ་ལ་བརྩིས་ནས་བེད་སྤྱོད་བྱེད།  ཁྱེད་ཀྱིས་ཆ་རྐྱེན་གསུམ་ནང་འཇུག་བྱས་ཆོག་ཅིང་དེ་དྲ་མིག་གྲངས་ཐང་བཙལ་འདྲི་འམ་སྤྱི་འགྲོས་ཀྱི་ནང་དོན་བཙལ་འདྲིར་སྤྱོད། ཆ་རྐྱེན་དེ་དག་ 1 ནས་ 3 གྱི་གོ་རིམ་ལ་གཞིགས་ནས་བཙལ་འཚོལ་བྱེད།  གལ་ཏེ་ཆ་རྐྱེན་ 1 གིས་དགོས་པ་སྐོང་ཐུབ་ན་ཆ་རྐྱེན་ 1 གིས་གཏན་འཁེལ་བྱས་པའི་བཟོ་ལྟ་བེད་སྤྱོད་བྱ།  དེ་མིན་ན་ཆ་རྐྱེན་ 2 ལ་གཞིགས་ནས་བཙལ་འདྲི་བྱེད་ མ་ཤད་ཆ་རྐྱེན་ 2 ཀྱིས་གཏན་འཁེལ་བྱས་པའི་བཟོ་ལྟ་སྤྱོད། གལ་ཏེ་ད་དུང་རེ་བ་སྐོང་མི་ཐུབ་ན་ཆ་རྐྱེན་ 3 ལ་གཞིགས་ནས་བཙལ་འདྲི་བྱེད།				2002-02-02 02:02:02
