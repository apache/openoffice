helpcontent2	source\text\shared\01\05020300.xhp	0	help	par_id3154138				0	bo	\<ahelp hid=\"SVX:LISTBOX:RID_SVXPAGE_NUMBERFORMAT:LB_LANGUAGE\"\>ལ་བདམས་པའི་\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>དྲ་མིག་\</caseinline\>\<defaultinline\>ཡིག་དུམ་\</defaultinline\>\</switchinline\>སྐད་བརྡ་བཀོད་སྒྲིག་གཏན་འཁེལ་བྱེད།  གལ་ཏེ་སྐད་ཡིག་ནི་\<emph\>"ཁས་ལེན་"ལ་བཀོད་སྒྲིག་བྱས་ན་\</emph\> $[officename] རང་འགུལ་ངང་མ་ལག་ཁས་ལེན་སྐད་བརྡ་ཕན་ཚུན་འབྲེལ་བའི་གྲངས་ཀའི་རྣམ་གཞག་རང་འགུལ་ངང་ཉེ་བར་སྤྱོད།  སྐད་བརྡ་གང་རུང་ཞིག་བདམས་ནས་བདམས་ཟིན་པའི་\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>དྲ་མིག་\</caseinline\>\<defaultinline\>ཡིག་དུམ་\</defaultinline\>\</switchinline\>གྱི་བཀོད་སྒྲིག་ལ་བཟོ་བཅོས་བྱེད་དོ། \</ahelp\>				2002-02-02 02:02:02
