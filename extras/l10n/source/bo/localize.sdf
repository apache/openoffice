helpcontent2	source\text\swriter\01\02110100.xhp	0	help	par_id3150045				0	bo	དྲང་འཕྱང་འདྲིལ་འཁོར་མདའ་ཡི་ཐོག་གནས་པའི་རིས་རྟགས་ལ་རྐྱང་རྡེབ་བྱེད་བརྒྱུད་\<emph\>སྣེ་སྟོན་\</emph\>ཡོ་བྱད་ཚང་ཁ་ཕྱེ་ཡོད་ གསལ་ཡོལ་ཐོག་འདྲུད་འགུལ་དང་ཡོ་བྱད་ཚང་སྟར་སྒྲིག་བྱས་ཡོད་  ཁྱོད་སྔར་ཡོད་ཀྱི་གནས་ས་ནས་ཁ་བྲལ་ཕྱོགས་པ་ཡིན།				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02110100.xhp	0	help	par_id3153141				0	bo	\<ahelp hid=\"HID_NAVI_VS\"\>མིག་བཤར་བྱ་རྒྱུ་བྱ་ཡུལ་རིགས་ཀྱི་ལྟོས་བཅས་ཀྱི་རིས་རྟགས་ལ་རྐྱང་རྡེབ་བྱེད་དགོས་ལ།མདའ་རྩེ་གནོན་མཐེབ་"བྱ་ཡུལ་གོང་མ་"ཡང་ན་"བྱ་ཡུལ་རྗེས་མ་" ཞིག་ལ་བསྐྱར་དུ་རྐྱང་རྡེབ་བྱ། གནོན་མཐེབ་གྱི་མིང་དེ་དག་བདམས་པའི་བྱ་ཡུལ་གྱི་རིགས་སྟོན་པ་ཡིན།ཡི་གེ་འོད་རྟགས་བདམས་པའི་བྱ་ཡུལ་དུ་གནས་སྲིད།\</ahelp\>				2002-02-02 02:02:02
