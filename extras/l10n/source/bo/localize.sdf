helpcontent2	source\text\shared\explorer\database\02010100.xhp	0	help	par_id3156372				0	bo	\<ahelp hid=\"HID_QRYDGN_ROW_FIELD\"\>བཙལ་འདྲིའི་ནང་འདྲེན་སྤྱོད་ཀྱི་གཞི་གྲངས་ཡིག་དུམ་གྱི་མིང་ནང་འཇུག་བྱེད།  གཤམ་གྱི་ཕྲེང་ནང་གི་བཀོད་སྒྲིག་ཡོད་ཚད་ནི་ཡིག་དུམ་འདི་ལ་དམིགས་པ་ཡིན།  \</ahelp\>བརྒྱུད་ཙིག་རྟགས་ལ་རྐྱང་རྡེབ་བྱས་ཏེ་དྲ་མིག་ཅིག་འགུལ་སློང་བྱས་ནས་ མདའ་རྩེའི་གནོན་མཐེབ་ཅིག་མངོན་པར་འགྱུར་ཞིང་ཡིག་དུམ་འདེམས་པ་མཁོ་འདོན་བྱེད། "Table name.*"འདེམས་གཞི་གཞི་གྲངས་ཡིག་དུམ་ཡོད་ཚད་འདེམས་པར་སྤྱོད་ ཆ་རྐྱེན་འདི་རེའུ་མིག་ཡིག་དུམ་ཡོད་ཚད་ལ་ཕན་ནུས་ལྡན་ནོ།				2002-02-02 02:02:02
