helpcontent2	source\text\swriter\01\02140000.xhp	0	help	par_id3151184				0	bo	\<variable id=\"feldbefehltext\"\>\<ahelp hid=\".uno:FieldDialog\"\>གླིང་སྒྲོམ་ཞིག་ཁ་ཕྱེ་བ་དེས་ དེའི་ནང་ཡིག་དུམ་གྱི་གཏོགས་གཤིས་རྩོམ་སྒྲིག་བྱས་ཆོག།ཡིག་དུམ་མདུན་དུ་ལ་རྐྱང་རྡེབ་བྱེད་ཐོག་ དེ་ནས་བཀའ་ཚིག་འདེམས།\</ahelp\>གླིང་སྒྲོམ་ནང་ མདའ་རྩེ་གནོན་མཐེབ་བེད་སྤྱོད་ཡིག་དུམ་ཕན་ཚུན་འགྲོ་འོང་བརྗེས་བསྒྱུར་བྱེད་ \</variable\>				2002-02-02 02:02:02
