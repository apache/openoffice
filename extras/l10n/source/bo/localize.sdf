helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3153527				0	bo	\<ahelp hid=\"SW:LISTBOX:DLG_AP_INSERT_DB_SEL:LB_TABLE_COL\"\>ཡིག་ཚགས་ནང་གི་གཞི་གྲངས་མཛོད་སྟར་པ་ཡོངས་རྫོགས་སྒྲིག་པ། \</ahelp\>སྟར་པ་རེ་རེའི་རེའུ་མིག་ནང་གི་ལྟོས་བཅས་གཤར་བྱང་ཞིག་ཏུ་གཏན་འཁེལ་བ། \<emph\>རེའུ་མིག་སྟར་པ་\</emph\>རེའུ་འགོད་སྒྲོམ་ནང་གི་གཤར་བྱང་གོ་རིམ་གྱིས་ཡིག་དེབ་རེའུ་མིག་ནང་གི་གཞི་གྲངས་གོ་རིམ་གྱི་ཁ་ལོ་བསྒྱུར།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3149750				0	bo	\<ahelp hid=\"SW_IMAGEBUTTON_DLG_AP_INSERT_DB_SEL_IB_DBCOL_ALL_TO\"\>སྒྲིག་ཟིན་པའི་གཞི་གྲངས་མཛོད་ཀྱི་ཡིག་དུམ་ཐམས་བཅད་\<emph\>རེའུ་མིག་སྟར་པ་\</emph\>རེའུ་འགོད་སྒྲོམ་ནང་སྤོས་པ། \</ahelp\>\<emph\>རེའུ་མིག་སྟར་པ་\</emph\>རེའུ་འགོད་སྒྲོམ་ནང་སྒྲིག་པའི་ཡིག་དུམ་ཡོད་ཚད་ཡིག་ཚགཚག་ནང་བསྒར་འཛུད་བྱེད་པའོ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3153662	23			0	bo	\<ahelp hid=\"SW_IMAGEBUTTON_DLG_AP_INSERT_DB_SEL_IB_DBCOL_ONE_TO\"\>བདམས་ཟིན་པའི་གཞི་གྲངས་མཛོད་ཡིག་དུམ་\<emph\>རེའུ་མིག་སྟར་པ་\</emph\>རེའུ་འགོད་སྒྲོམ་ནང་སྤོས་པ་དང་\</ahelp\>ཡང་གཤར་བྱང་ལ་ཆ་རྡུང་བྱས་པ་བརྒྱུད་དེ་ཉིད་ \<emph\>རེའུ་མིག་སྟར་པ་\</emph\>རེའུ་འགོད་སྒྲོམ་ནང་སྤོས་པའོ།\<emph\>རེའུ་མིག་སྟར་པ་\</emph\>རེའུ་འགོད་སྒྲོམ་ནང་སྒྲིག་པའི་ཡིག་དུམ་ཡོད་ཚད་ཡིག་ཚགས་ནང་བསྒར་འཛུད་བྱེད།				2002-02-02 02:02:02
