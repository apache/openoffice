helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3150084				0	bo	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_BOTTOM\"\>གལ་ཏེ་\<emph\>མངོན་པའི་སྡུར་ཚད་རྒྱུན་འཁྱོངས་ \</emph\>འདེམས་གཞི་བདམས་རྗེས་ཕོ་ཐང་ནང་འཇུག་བྱས་ན་རིས་དབྱིབས་ཀྱི་འོག་མཐའ་བྲེགས་གཏུབ་བྱེད་  མོ་ཐང་ནང་འཇུག་བྱས་ན་རིས་དབྱིབས་ཀྱི་འོག་ཕྱོགས་སུ་ས་ཁོངས་སྟོང་པ་སྣོན་འཇུག་བྱེད།  གལ་ཏེ་\<emph\>རིས་དབྱིབས་ཆེ་ཆུང་རྒྱུན་འཁྱོངས་\</emph\>འདེམས་གཞི་བདམས་རྗེས་ཕོ་ཐང་ནང་འཇུག་བྱས་པས་རིས་དབྱིབས་ཀྱི་དྲང་འཕྱང་མངོན་པའི་སྡུར་ཚད་འཕར་སྣོན་བྱེད་  མོ་ཐང་ནང་འཇུག་བྱས་པས་རིས་དབྱིབས་ཀྱི་དྲང་འཕྱང་མངོན་པའི་སྡུར་ཚད་ཆུང་དུ་འགྲོ། \</ahelp\>				2002-02-02 02:02:02
