helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3145669				0	bo	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>\</caseinline\>\<caseinline select=\"DRAW\"\>\</caseinline\>\<caseinline select=\"IMPRESS\"\>\</caseinline\>\<defaultinline\>$[officename] ཡི་གེ་ལས་སྣོན་གྱི་པར་གཞི་སྣ་ཚོགས་ཀྱི་ Microsoft Word ཡིག་དེབ་རྣམ་གཞག་ ཁྱེད་ཀྱིས་ད་དུང་རང་ཉིད་ཀྱི་ཡིག་དེབ Word རྣམ་གཞག་ལ་ཉར་ཚགས་ཐུབ་ འོན་ཀྱང་$[officename] ཡི་གེ་ལས་སྣོན་ལ་སྤྱོད་པའི་རྣམ་གཞག་ཡོད་ཚད་ནི་ MS Wordབརྗེ་བསྒྱུར་མི་ཐུབ་ལ་རྣམ་གཞག་ཡོད་ཚད་ཀྱང་འཇུག་ཐུབ་པ་མིན་\</defaultinline\> \</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3150144				0	bo	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>\</caseinline\>\<caseinline select=\"DRAW\"\>\</caseinline\>\<caseinline select=\"IMPRESS\"\>\</caseinline\>\<defaultinline\>སྤྱིར་བཏང་གནས་ཚུལ་འོག་འཇུག་པ་གནད་དོན་ལྷག་མི་སྲིད་ ཐ་ན་དམར་ཐིག་རྟགས་ཀྱི་ཆ་འཕྲིན་དང་ཚོད་འཛིན་ཆས་ཀྱང་འཇུག་པ་(དང་ཕྱིར་བཏོན་)བྱས་ན་ $[officename] ཡིས་ Word ཡིག་ཚགས་ནང་བསྒར་འཛུད་དམ་དོར་བའི་ཡི་གེ་དང་དེ་བཞིན་བཅོས་ཟིན་པའི་ཡིག་གཟུགས་ཀྱི་གཏོགས་གཤིས་ཤན་འབྱེད་ཐུབ་ འཇུག་པ་ལ་ད་དུང་བཟོ་བཅོས་མཁན་དང་བཟོ་བཅོས་དུས་ཚོད་ཀྱི་ཚོས་གཞི་མི་འདྲ་བ་མཚོན་རྒྱུར་སྤྱོད་པ་ཡང་ཚུད་ཡོད་ མ་པང་ནས་རིས་དབྱིབས་ཡིག་དེབ་སྒྲོམ་དང་གཞི་གྲངས་མཚོན་རྟགས་འཇུག་པའི་སྐབས་གཏོགས་གཤིས་མང་ཆེ་བ་ཐད་ཀའི་དུམ་མཚམས་དང་རིས་དབྱེབས་གཏོགས་གཤིས་ཀྱི་ཐོག་ནས་འདྲེན་འཇུག་བྱེད་ འོན་ཀྱང་འཇུག་པའི་བརྒྱུད་རིམ་ནང་གཏོགས་གཤིས་འགའ་བརླག་ཀྱང་སྲིད་\</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3149095				0	bo	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>\</caseinline\>\<caseinline select=\"DRAW\"\>\</caseinline\>\<caseinline select=\"IMPRESS\"\>\</caseinline\>\<defaultinline\>ད་དུང་འཇུག་པ་དང་བཏོན་པ་ \<link href=\"text/shared/00/00000005.xhp#rtf\" name=\"RTF\"\>RTF\</link\> ཡིག་ཆ་ ཡིག་ཆ་རྣམ་གཞག་འདི་ཉིད་ཉེར་སྤྱོད་བྱ་རིམ་མི་འདྲ་བ་དང་མ་སྟེགས་དབར་རྣམ་གཞག་ཅན་དུ་འགྱུར་ཟིན་པའི་ཡིག་དེབ་བརྗེ་ལེན་ལ་སྤྱོད་ དེ་ལྟར་གྱིས་ བྱ་རིམ་མང་ཆེ་བའི་ཀློག་འདོན་ཐུབ་པའི་རྣམ་གཞག་ཚང་མ་བདེ་བླག་ངང་བརྒྱུད་གཏོང་ཐུབ་ ཁྱེད་ནས་ \<link href=\"text/shared/00/00000005.xhp\" name=\"DDE\"\>DDE\</link\> བརྒྱུད་$[officename] གློག་བརྡུལ་རེའུམིག་ནང་གིས་ལས་ཀའི་རེའུ་མིག་ཆ་ཤས་$[officename] ཡི་གེ་ལས་སྣོན་ནང་བསྒར་འཛུད་བྱེད་པའི་སྐབས་དྲས་སྦྱར་པང་གིས་ RTF རྣམ་གཞག་སྤྱོད་པའོ་\</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3151378				0	bo	ཡིག་དེབ་འཚག་ཆས་\<emph\>ཕྱེད་ཀྱིས་ཨང་སྒྲིག་ཡིག་དེབ་དེ་\</emph\>ཡིག་རྟགས་ཚོགས་ཁ་ཕྱེ་བ་དང་ཉར་ཚགས་ཀྱི་ཨང་རིམ་སྒྲིག་པའི་ཡི་གེ་ལས་སྣོན་ཡིག་ཚགས་ལ་སྤྱད། འཚག་ཆས་འདི་ལ་གླེང་སྒྲོམ་ཞིག་ཡོད་པས་ཁྱེད་ཀྱིས་དེའི་ནང་ནས་ཡིག་རྟགས་ཚོགས་དང་ ཚད་ལྡན་ཡིག་གཟུགས་ སྐད་བརྡ་དུམ་མཚམས་བརྗེ་བ་བཅས་བཀོད་སྒྲིག་བྱས་ཆོག				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	hd_id3149763	11			0	bo	HTML རྣམ་གཞག་ནས་འཇུག་པ་དང་བཏོན་པ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3150244				0	bo	$[officename] ཡི་གེ་ལས་སྣོན་སྤྱད་ན་ཁྱེད་ཀྱིས་ HTML ཡིག་ཚགས་ནང་ཞབས་མཆན་དང་མཇུག་མཆན་བསྒར་འཛུད་བྱས་ཆོག་ དེ་དག་གཞི་རྟགས་སུ་བརྩིས་ནས་ཕྱིར་བཏོན་བྱའོ། ཞབས་མཆན་དང་མཇུག་མཆན་རྟགས་ཆེས་ཐག་སྦྲེལ་དུ་བརྩིས་ནས་བཏོན་ནོ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3149800				0	bo	ཟུར་མཆན་གིས་ཤེས་རྒྱུའི་ཡིག་རྟགས་ HTML ཡིག་ཚགས་ནང་སྣོན་"HTML:...ནས་"འགོ་ཚུགས་པ་མ་ཟད་">" ཡིས་མཇུག་སྒྲིལ་བའི་མཚན་ཡོད་ཚད་HTML ཨང་དུ་བརྩིས་ནས་ལས་སྣོན་བྱེད་ འོན་ཀྱང་བཏོན་པའི་སྐབས་རྟགས་མེད་  "HTML:..." ཡི་རྗེས་སུ་རྟགས་མང་པོ་ཡོད་ཆོག་ལ་རྟགས་འདི་དག་དབར་ཡི་གེ་ཨང་གང་རུང་ཡོད་ཆོག་ འགྱུར་བའི་དབྱངས་ཉིད་ ANSI ཡིག་རྟགས་ཚོགས་སུ་བརྗེ་བསྒྱུར་བྱེད་ འཇུག་པའི་སྐབས་ཟུར་མཆན་འཛུགས་དགོས་པ་(དཔེར་ན་ ཡིག་ཚགས་ཆ་འཕྲིན་ནང་གནས་ཡུལ་མེད་པའི་དཔར་རྒྱུའི་རྟགས་སམ་ཤེས་རྒྱུའི་རྟགས་སོགས་)				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3149734				0	bo	$[officename] ཡི་གེ་ལས་སྣོན་གྱི་ HTML ནང་འཇུག་གིས་ UTF-8འམ་ UCS2 ཡིག་རྟགས་ཨང་རིམ་ཚུད་པའི་ཡིག་ཆ་ཀློག་ཐུབ་པ་དང་དུས་མཚུངས་ ANSI ཡིག་རྟགས་ཚོགས་པ་དང་མ་ལག་ཡིག་རྟགས་ཚོགས་པའི་ནང་གི་ཡིག་རྟགས་ཡོད་ཚད་མངོན་ཐུབ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3154143				0	bo	"font" གཏོགས་གཤིས་ནི་ Netscape Navigator ཡིག་གཟུགས་དང་མཚུངས་ དེ་ནི་ཁྱེད་ཀྱིས་ཡིག་གཟུགས་ཆེ་ཆུང་མ་བཟོ་སྔོན་"font-style"(italic、none)、"font-variant"(normal、small-caps) དང་"font-weight"(normal、bold) ལ་སྤྱོད་པའི་གདེམ་གཞིའི་གྲངས་ཐང་གཏན་འཁེལ་བཟོ་དགོས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3153760				0	bo	དཔེར་ན་ "Font:bold italic small-caps 12pt/200% Arial, Helvetica"སྦོམ་གཟུགས་ གསེག་གཟུགས་ ཡིག་ཆེན་ཆུང་གྲས་ ཕྲེང་རྒྱང་ལྡབ་གཉིས་སུ་འགྱུར་བ་དང་ཡིག་གཟུགས་ནི་ Arialའམ་Helvetica བརྒྱུད་གྲས་ (གལ་སྲིད་ Arialམེད་ན་)				2002-02-02 02:02:02
