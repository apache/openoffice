helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3150420				0	bo	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>ཡིག་འགྲེལ་རྟགས་(-)སྣོན་རྟགས་(+)ཡང་ན་སྐར་རྟགས་(*)སྟོང་མིག་མཐུད་པའམ་ཡང་ན་རེའུ་འགོད་རྟགས་ཀྱི་འགོའི་དུམ་མཚམས་དེ་རྣམ་གྲངས་མཚོན་རྟགས་རེའུ་འགོད་ལ་ཚབ་བརྗེ་བྱེད། འདེམས་གཞི་འདི་"ཁས་ལེན་""དངོས་ཡིག་"དང་"དངོས་ཡིག་ནང་སྐུམ་"དུམ་མཚམས་བཟོ་ལྟའི་དུམ་མཚམས་ཉེར་སྤྱོད་ཁོ་ནར་འཚམས། བེད་སྤྱོད་རྣམ་གྲངས་མཚོན་རྟགས་བཟོ་ལྟ་བཟོ་བཅོས་བྱེད་དགོས་ན་ འདེམས་གཞི་འདི་འདེམས་ དེ་རྗེས་\<emph\>"རྩོམ་སྒྲིག་..."\</emph\>རྐྱང་རྡེབ་བྱེད།\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
