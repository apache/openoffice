helpcontent2	source\text\shared\01\05070100.xhp	0	help	par_id3150445	3			0	bo	\<variable id=\"mehrfachselektion\"\>ཚོ་སྒྲིག་ནང་གི་བྱ་ཡུལ་རེ་རེ་སྙོམ་གཤིབ་བྱ་དགོས་ན་\<switchinline select=\"appl\"\> \<caseinline select=\"CALC\"\> \<emph\>རྣམ་གཞག་ - ཚོ་སྒྲིག་ - ཚོ་སྒྲིག་རྩོམ་སྒྲིག་འདེམས་རོགས་\</emph\>\</caseinline\> \<defaultinline\>ཆ་རྡེབ་\</defaultinline\> \</switchinline\>ཀྱིས་ཚོ་སྒྲིག་ནང་འཇུག་བྱེད་  བྱ་ཡུལ་འདེམས་པ་དང་ཙིག་རྟགས་གཡས་མཐེབ་ལ་རྐྱང་རྡེབ་བྱ་  དེ་རྗེས་སྙོམ་གཤིབ་འདེམས་གཞི་འདེམས་རོགས། \</variable\>				2002-02-02 02:02:02
