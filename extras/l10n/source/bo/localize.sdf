helpcontent2	source\text\swriter\02\18030100.xhp	0	help	par_id3151312				0	bo	གལ་ཏེ་ཚེ་གྲངས་རྣམ་གཞག་མི་གཅིག་པའི་མཚན་འཇོག་བྱེད་པའམ་ཡང་ན་ ཚེ་གྲངས་རང་འགུལ་གྱི་གསལ་བཟོ་བྱེད་ན་ \<emph\>[བསྒར་འཛུད་] - [ཁོངས་] - [གཞན་དག་...]\</emph\>བདམས་པའི་ཡིས་ཁོངས་བསྒར་འཛུད་བྱེད་ དེ་ནས་\<link href=\"text/swriter/01/04090000.xhp\" name=\"ཁོངས་བཀའ་བརྡ་\"\>\<emph\>"ཁོངས་བཀའ་བརྡ་"\</emph\>\</link\> གླེང་སྒྲོམ་ནང་མཁོ་ངེས་ཀྱི་བཀོད་སྒྲིག་གཏན་འཁེལ་བྱེད་དགོས། ག་དུས་ཡིན་ཡང་གཡས་མཐེབ་ཚལ་ཐོའི་\<link href=\"text/swriter/01/02140000.xhp\" name=\"རྩོམ་སྒྲིག་ཁོངས་བཀའ་བརྡ་\"\>\<emph\>[རྩོམ་སྒྲིག་ཁོངས་བཀའ་བརྡ་...]\</emph\>\</link\>འདེམས་ནས་ད་ཡོད་ཀྱི་ཚེ་གྲངས་ཡིག་དུམ་རྣམ་གཞག་བཟོ་བཅོས་བྱེད།				2002-02-02 02:02:02
