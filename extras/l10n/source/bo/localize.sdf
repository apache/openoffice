helpcontent2	source\text\shared\02\01170102.xhp	0	help	par_id3163812	141			0	bo	\<ahelp hid=\"HID_PROP_REFVALUE\" visibility=\"hidden\"\> Web རེའུ་མིག་གི་འདྲེན་སྤྱོད་ཐང་ནང་འཇུག་བྱེད།  རེའུ་མིག་བསྐུར་དུས་ཐང་འདི་ཞབས་ཞུའི་ཆས་བརྒྱུད་སྐྱེལ་བྱེད།  གཞི་གྲངས་མཛོད་རེའུ་མིག་ནང་ཐང་འདི་ཚོད་འཛིན་ཡིག་དུམ་གྱིས་གཏན་འཁེལ་བྱས་པའི་གཞི་གྲངས་མཛོད་ཡིག་དུམ་ནང་འབྲི་འཇུག་བྱེད།   \</ahelp\>འདེམས་གཞི་ཡིག་དུམ་དང་བསྐྱར་འདེམས་སྒྲོམ་ལ་འདྲེན་སྤྱོད་ཐང་གཏན་འཁེལ་བྱེད་ཆོག   Web རེའུ་མིག་བསྐུར་དུས་འདྲེན་སྤྱོད་ཐང་ནི་ཞབས་ཞུ་ཆས་ལ་བརྒྱུད་གཏོང་བྱེད།  གཞི་གྲངས་མཛོད་རེའུ་མིག་ནང་གནས་འདིར་ནང་འཇུག་བྱས་པའི་ཐང་ཚོད་འཛིན་ཡིག་དུམ་གྱིས་གཏན་འཁེལ་བྱས་པའི་གཞི་གྲངས་མཛོད་ཡིག་དུམ་ནང་འཇུག་བྱེད། 				2002-02-02 02:02:02
