helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3151300				0	bo	\<ahelp hid=\"HID_PROP_STRINGITEMLIST\" visibility=\"hidden\"\>ཡིག་ཚགས་䶀­མཐོང་རུང་བའི་རེའུ་འགོད་གཤར་བྱང་མཚན་འཇོག་བྱེད།\</ahelp\>རེའུ་འགོད་འདི་ཁ་ཕྱེ་བ་མ་ཟད་ཡིག་དེབ་ནང་འཇུག་བྱེད་རེའུ་འགོད་སྒྲོམ་དང་ཚོ་སྒྲིག་སྒྲོམ་ངོས་ནས་ཡིག་ཚགས་ནང་མཐོང་རུང་གི་རེའུ་འགོད་གཤར་བྱང་མཚན་འཇོག་བྱེད།\<emph\>རེའུ་འགོད་གཤར་བྱང་\</emph\>ཡིག་དུམ་ཁ་ཕྱེ་བ་མ་ཟད་ཡིག་དེབ་ནང་མཐེབ་བཅུག་བྱེད།  འབྲེལ་ཡོད་གཤར་བྱང་ཚོད་འཛིན་དང་མཐེབ་གཞོང་གི་\<link href=\"text/shared/02/01170100.xhp\" name=\"དྲན་བརྡ།\"\>དྲན་བརྡ།\</link\>ཆ་འཕྲིན་ལ་དོ་སྣང་བྱེད།				2002-02-02 02:02:02
