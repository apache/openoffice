helpcontent2	source\text\shared\main0213.xhp	0	help	par_id3153062				0	bo	མིག་སྔའི་རིམ་སྒྲིག་གོ་རིམ་མམ་འཚག་འདེམས་ཆས་དེ་མིག་སྔའི་ཡིག་ཚགས་དང་མཉམ་དུ་ཉར་ཚགས་བྱེད། གལ་ཏེ་འཚག་འདེམས་ཆས་བཀོད་སྒྲིག་བྱས་ཡོད་ན་\<emph\>ཕྱོགས་སྟོན་\</emph\>ཚང་སྟེང་གི་\<emph\>ཉེར་སྤྱོད་འཚག་འདེམས་ཆས་\</emph\>རིས་རྟགས་དེ་གསོན་སློང་གནས་སྟངས་སུ་གནས། ཡིག་ཚགས་ནང་གི་རིམ་སྒྲིག་དང་འཚག་འདེམས་བྱེད་ནུས་ཡང་\<emph\>རེའུ་བྱང་གཏོགས་གཤིས་§\</emph\>གླེང་སྒྲོམ་ནང་སྡེབ་སྒྲིག་བྱ་ཐུབ།(\<emph\>རེའུ་བྱང་གཏོགས་གཤིས་ - གཏོགས་གཤིས་ - གཞི་གྲངས་\</emph\>\<link href=\"text/shared/02/01170203.xhp\" name=\"རིམ་སྒྲིག\"\>\<emph\>རིམ་སྒྲིག\</emph\>\</link\>དང་\<link href=\"text/shared/02/01170203.xhp\" name=\"འཚག་འདེམ་ཆས་\"\>\<emph\>འཚག་འདེམ་ཆས་\</emph\>\</link\>)				2002-02-02 02:02:02
