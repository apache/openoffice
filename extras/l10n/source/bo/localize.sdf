helpcontent2	source\text\shared\02\01170102.xhp	0	help	par_id3145357				0	bo	\<ahelp hid=\"HID_PROP_EMPTY_IS_NULL\"\>གང་འདྲ་བྱས་ཏེ་ནང་འཇུག་བྱེད་པའི་ཡིག་རྟགས་ཕྲེང་བ་སྟོང་པ་ལས་སྣོན་བྱེད་པ་མཚན་འཇོག་བྱེད།\</ahelp\>གལ་སྲིད་གཏོགས་གཤིས་འདི་"རེད།"བཀོད་སྒྲིག་བྱེད་ན་  སྟོང་མིག་གི་ཡིག་རྟགས་ཕྲེང་གཅིག་གམ་ཡང་ན་མང་དག་ཚུད་པའི་ NULL ཐང་ལ་འགྲེལ་བཤད་བྱེད་པ་མ་ཟད་གཞི་གྲངས་མཛོད་ནང་ཉར་འཇོག་བྱེད།  གལ་སྲིད་གཏོགས་གཤིས་འདི་"མིན།"བཀོད་སྒྲིག་བྱེད་ན་ རིགས་འདིའི་ཡིག་རྟགས་ཕྲེང་འདི་སྟོང་ཐང་ལ་མཐོང་།				2002-02-02 02:02:02
