helpcontent2	source\text\swriter\main0503.xhp	0	help	par_id3151206				0	bo	$[officename] ཡི་གེ་ལས་སྣོན་གྱི་\<link href=\"text/shared/02/01140000.xhp\" name=\"རིས་འགོད་ཡོ་བྱད་\"\>རིས་འགོད་ཡོ་བྱད་\</link\>བེད་སྤྱོད་ ཡི་གེ་ལས་སྣོན་ཡིག་ཚགས་ནང་ཐད་ཀར་རིས་འགོད་ རིས་དབྱིབས་  རིས་དཔེ་དེ་བཞིན་རིགས་གཞན་གྱི་རིས་འགོད་བྱ་ཡུལ་གསར་བཟོ་བྱེད།				2002-02-02 02:02:02
