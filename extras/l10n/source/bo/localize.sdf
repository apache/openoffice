helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3147396				0	bo	\<switchinline select=\"appl\"\> \<caseinline select=\"WRITER\"\>"ཁས་ལེན་"དུམ་མཚམས་བཟོ་ལྟ་"ཁ་བྱང་ 1"ནས་"ཁ་བྱང་ 8"དུམ་མཚམས་བཟོ་ལྟ་ལ་ཚབ་བརྗེ་བྱེད། "ཁ་བྱང་ 1"དུམ་མཚམས་བཟོ་ལྟ་བེད་སྤྱོད་ན་ ཁ་བྱང་བྱེད་པའི་ཡི་གེ་(རྫོགས་རྟགས་མི་སྣོན་)ནང་བཅུག་བྱེད་ དེ་རྗེས་ Enter མཐེབ་ཐེངས་གཉིས་གནོན། ཟུར་ཞོར་བྱང་ཉེར་སྤྱོད་བྱེད་ན་  Tab མཐེབ་ཐེངས་གཅིག་ཡང་ན་མང་དག་གནོན་ནས་ ཡི་གེ་ནང་བཅུག་(རྫིགས་རྟགས་མི་སྣོན་)དེ་རྗེས་ Enter མཐེབ་གནོན་མཐེབ་བྱེད།\</caseinline\> \</switchinline\>				2002-02-02 02:02:02
