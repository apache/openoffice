helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3154944				0	bo	\<ahelp hid=\"HID_PROP_CYCLE\"\> Tab མཐེབ་སྤྱོད་དུས་ཀྱི་མིག་བཤར་ཐབས་ཚུལ་གཏན་འཁེལ་བྱེད། \</ahelp\>  Tab མཐེབ་སྤྱད་ན་རེའུ་བྱང་ནང་མདུན་ལ་སྤོ་འགུལ་བྱེད་ཆོག   གལ་ཏེ་མཐེབ་ Tab སྤྱོད་དུས་ Shift མཐེབ་མནན་ན་ལྡོག་ཕྱོགས་ལ་མིག་བཤར་བྱེད།  གལ་ཏེ་མཇུག་མཐའི་ཡིག་དུམ་(ཡང་ན་དང་པོ་)ལ་སླེབས་ན་ Tab མཐེབ་གནོན་དགོས་ཤིང་ཕན་ནུས་མང་པོ་ཡོད་ཆོག   གཤམ་གྱི་འདེམས་གཞིའི་མཚན་འཇོག་ཆས་ཚོད་ཆས་སྤྱད་ཆོག				2002-02-02 02:02:02
