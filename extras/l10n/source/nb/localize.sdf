helpcontent2	source\text\schart\01\wiz_chart_elements.xhp	0	help	par_id7709585				0	nb	\<ahelp hid=\".\" visibility=\"hidden\"\>Plasser forklaringen under diagrammet.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\schart\01\wiz_chart_elements.xhp	0	help	par_id4309518				0	nb	\<ahelp hid=\".\" visibility=\"hidden\"\>Displays grid lines that are perpendicular to the x-axis.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\schart\01\wiz_chart_elements.xhp	0	help	par_id206610				0	nb	\<ahelp hid=\".\" visibility=\"hidden\"\>Displays grid lines that are perpendicular to the y-axis.\</ahelp\>				20130618 17:22:18
