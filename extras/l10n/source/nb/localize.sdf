helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DA1				0	nb	{=HVIS(A1:A3>0; "Ja"; "Nei")}				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10DA7				0	nb	nei				20130618 17:22:18
