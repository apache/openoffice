helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3155132	14			0	nb	sText = InputBox("Please enter a short sentence:")				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3155855	15			0	nb	REM Proof if the word »and« appears in the sentence.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3146984	16			0	nb	REM Instead of the command line				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3148576	17			0	nb	REM If Instr(Input, "and")<>0 Then...				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3154014	18			0	nb	REM the CBool function is applied as follows:				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3155413	19			0	nb	If CBool(Instr(sText, "and")) Then				20130618 17:22:18
