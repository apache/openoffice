helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3153710	24			0	nb	Else				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3154754	25			0	nb	MsgBox "The expiration date is today"				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3154361	26			0	nb	End If				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03090101.xhp	0	help	par_id3148405	28			0	nb	End Sub				20130618 17:22:18
