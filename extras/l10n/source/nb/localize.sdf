helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3149578	119			0	nb	DAYS(Date2; Date1)				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3151376	120			0	nb	\<emph\>Date1\</emph\> is the start date, \<emph\>Date2\</emph\> is the end date. If \<emph\>Date2\</emph\> is an earlier date than \<emph\>Date1\</emph\> the result is a negative number.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	hd_id3151001	121			0	nb	Eksempler				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3159101	123			0	nb	=DAYS("2010-01-01"; NOW()) returns the number of days from today until January 1, 2010.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3163720	172			0	nb	=DAYS("1990-10-10";"1980-10-10") returns 3652 days.				20130618 17:22:18
helpcontent2	source\text\scalc\01\func_days360.xhp	0	help	tit				0	nb	DAGER360 				20130618 17:22:18
