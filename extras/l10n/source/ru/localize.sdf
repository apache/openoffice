helpcontent2	source\text\swriter\main0103.xhp	0	help	hd_id3147265				0	ru	\<link href=\"text/shared/01/03010000.xhp\" name=\"Масштаб\"\>Масштаб\</link\>				20200411 15:09:53
helpcontent2	source\text\swriter\main0206.xhp	0	help	tit				0	ru	Панель "Маркеры и нумерация"				20200411 15:09:53
helpcontent2	source\text\swriter\main0206.xhp	0	help	hd_id3154256				0	ru	\<link href=\"text/swriter/main0206.xhp\" name=\"Панель ''Маркеры и нумерация''\"\>Панель ''Маркеры и нумерация''\</link\>				20200411 15:09:53
helpcontent2	source\text\swriter\main0206.xhp	0	help	par_id3154277				0	ru	\<ahelp hid=\"HID_NUM_TOOLBOX\"\>Панель \<emph\>Маркеры и нумерация\</emph\> содержит функции для изменения структуры нумерованных абзацев, включая изменение порядка абзацев и определения других уровней для абзацев.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\main0200.xhp	0	help	tit				0	ru	Панели инструментов				20200411 15:09:53
