helpcontent2	source\text\swriter\01\05120400.xhp	0	help	par_id3150564				0	ru	\<ahelp hid=\"SW:RADIOBUTTON:DLG_INS_ROW_COL:CB_POS_BEFORE\"\>Добавляет новые столбцы слева от текущего столбца или новые строки над текущей строкой.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05120400.xhp	0	help	hd_id3149024				0	ru	После				20200411 15:09:53
