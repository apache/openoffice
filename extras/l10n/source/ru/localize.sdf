helpcontent2	source\text\shared\01\05200100.xhp	0	help	hd_id3159234				0	ru	Ширина				20200411 15:09:53
helpcontent2	source\text\shared\01\05200100.xhp	0	help	par_id3150774				0	ru	\<variable id=\"breitetext\"\>\<ahelp hid=\"SVX:METRICFIELD:RID_SVXPAGE_LINE:MTR_FLD_LINE_WIDTH\"\>Выберите толщину линии. Можно добавить единицу измерения. Нулевая ширина линии приводит к линии наименьшей толщины шириной в один пиксель устройства вывода.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05200100.xhp	0	help	hd_id3153681				0	ru	Прозрачность				20200411 15:09:53
helpcontent2	source\text\shared\01\05200100.xhp	0	help	par_id3156346	12			0	ru	\<ahelp hid=\"SVX:METRICFIELD:RID_SVXPAGE_LINE:MTR_LINE_TRANSPARENT\"\>Введите уровень прозрачности линии, от 0% (непрозрачная) до 100% (полностью прозрачная). \</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05200100.xhp	0	help	par_id3152996				0	ru	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\</caseinline\>\<caseinline select=\"DRAW\"\>\</caseinline\>\<caseinline select=\"IMPRESS\"\>\</caseinline\>\<defaultinline\>Вкладка \<emph\>Линия\</emph\> диалогового окна \<emph\>Ряд данных\</emph\> доступна только в том случае, если выбран \<emph\>Тип диаграммы\</emph\> XY.\</defaultinline\>\</switchinline\>				20200411 15:09:53
