helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3149561				0	ru	sUS_date = Mid(sInput, 6, 2)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3146984				0	ru	sUS_date = sUS_date & "/"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3155308				0	ru	sUS_date = sUS_date & Right(sInput, 2)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3153727				0	ru	sUS_date = sUS_date & "/"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3145365				0	ru	sUS_date = sUS_date & Left(sInput, 4)				20200411 15:09:53
