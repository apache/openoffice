helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150613				0	ru	NORMDIST(Число; Среднее; Стандартное отклонение; И)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149820				0	ru	\<emph\>Число\</emph\>: значение распределения, на основе которого вычисляется нормальное распределение.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146063				0	ru	\<emph\>Среднее\</emph\>: среднее значение распределения.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156295				0	ru	\<emph\>Стандартное отклонение \</emph\>: стандартное отклонение распределения.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145080				0	ru	\<emph\>C\</emph\> – необязательный параметр. Если \<emph\>C\</emph\> = 0, то вычисляется функция плотности, а если \<emph\>C\</emph\> = 1, то вычисляется функция распределения.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152972				0	ru	Пример				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149283				0	ru	\<item type=\"input\"\>=NORMDIST(70;63;5;0)\</item\> возвращает значение 0.03.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149448				0	ru	\<item type=\"input\"\>=NORMDIST(70;63;5;1)\</item\> возвращает значение 0,92.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3152934				0	ru	\<bookmark_value\>Функция PEARSON\</bookmark_value\>				20200411 15:09:53
