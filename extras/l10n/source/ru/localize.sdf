helpcontent2	source\text\shared\01\06010000.xhp	0	help	hd_id3154071				0	ru	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Автозамена\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010000.xhp	0	help	par_id3153798				0	ru	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<ahelp hid=\"SVX_PUSHBUTTON_RID_SVXDLG_SPELLCHECK_BTN_AUTOCORR\"\>Добавляет текущую комбинацию неправильно написанного слова и его замены в таблицу автозамены.\</ahelp\>\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010000.xhp	0	help	hd_id3151382				0	ru	Параметры				20200411 15:09:53
helpcontent2	source\text\shared\01\06010000.xhp	0	help	par_id3154123				0	ru	\<ahelp hid=\"SVX_PUSHBUTTON_RID_SVXDLG_SPELLCHECK_BTN_OPTIONS\"\>Открывает диалоговое окно, в котором можно выбрать пользовательские словари и задать правила для проверки орфографии.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010000.xhp	0	help	hd_id3153353				0	ru	Добавить				20200411 15:09:53
