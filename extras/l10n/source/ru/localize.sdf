helpcontent2	source\text\scalc\guide\format_value_userdef.xhp	0	help	par_id3147003				0	ru	10.2 Million				20200411 15:09:53
helpcontent2	source\text\scalc\guide\format_value_userdef.xhp	0	help	par_id3166426				0	ru	10.2 Million				20200411 15:09:53
