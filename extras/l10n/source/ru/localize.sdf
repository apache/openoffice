helpcontent2	source\text\swriter\01\05060200.xhp	0	help	par_id3154716	24			0	ru	\<variable id=\"dynamischertext\"\>\<ahelp hid=\".uno:WrapIdeal\"\>Автоматически располагает обтекающий текст слева, справа или со всех четырех сторон от рамки объекта. Обтекание текстом не производится, если расстояние между объектом и полем страницы составляет менее 2 см. \</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060200.xhp	0	help	par_id3150904				0	ru	\<image id=\"img_id3150910\" src=\"sw/imglst/wr06.png\" width=\"0.82cm\" height=\"0.82cm\"\>\<alt id=\"alt_id3150910\"\>Значок\</alt\>\</image\>				20200411 15:09:53
