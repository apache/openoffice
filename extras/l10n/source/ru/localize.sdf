helpcontent2	source\text\shared\01\02230100.xhp	0	help	par_id3155599	2			0	ru	\<ahelp hid=\".uno:TraceChangeMode\"\>Отслеживание всех изменений, внесенных в текущий документ, по авторам и датам. \</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02230100.xhp	0	help	par_id3155934				0	ru	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>В случае выбора \<emph\>Запись – Показать\</emph\> строки, содержащие измененные отрывки текста, будут отмечены вертикальной линией в левом поле страницы. Свойства вертикальной линии и других элементов разметки можно определить на вкладке \<emph\>\<link href=\"text/shared/optionen/01040700.xhp\" name=\"Writer – Изменения\"\>%PRODUCTNAME Writer – Изменения\</link\>\</emph\> в диалоговом окне "Параметры".\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02230100.xhp	0	help	par_id3147261				0	ru	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>Свойства элементов разметки можно определить на вкладке \<link href=\"text/shared/optionen/01060600.xhp\" name=\"Calc – Изменения\"\>\<emph\>%PRODUCTNAME Calc – Изменения\</emph\>\</link\> в диалоговом окне "Параметры".\</caseinline\>\</switchinline\>				20200411 15:09:53
