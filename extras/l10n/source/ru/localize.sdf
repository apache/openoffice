helpcontent2	source\text\sbasic\shared\03120304.xhp	0	help	par_id3150447				0	ru	Dim sExpr As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120304.xhp	0	help	par_id3149561				0	ru	sVar = String(40,"*")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120304.xhp	0	help	par_id3153768				0	ru	sExpr = "АБВ"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120304.xhp	0	help	par_id3152940				0	ru	REM Выравнивание "АБВ" в строке ссылки длиной 40 символов				20200411 15:09:53
