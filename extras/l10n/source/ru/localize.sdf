helpcontent2	source\text\shared\explorer\database\menuedit.xhp	0	help	hd_id3153683				0	ru	Изменить				20200411 15:09:53
helpcontent2	source\text\shared\explorer\database\menuedit.xhp	0	help	par_id3147209				0	ru	\<ahelp hid=\".\"\>Открывает окно, где можно редактировать выбранную таблицу, запрос, форму или отчет.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\explorer\database\menuedit.xhp	0	help	hd_id3145315				0	ru	Удалить				20200411 15:09:53
