helpcontent2	source\text\swriter\01\06200000.xhp	0	help	par_id3154656				0	ru	\<ahelp hid=\".uno:UpdateFields\" visibility=\"visible\"\>Обновляет содержимое всех полей в текущем документе.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\06170000.xhp	0	help	tit				0	ru	Все оглавления и указатели				20200411 15:09:53
helpcontent2	source\text\swriter\01\06170000.xhp	0	help	hd_id3149875				0	ru	\<link href=\"text/swriter/01/06170000.xhp\" name=\"Все оглавления и указатели\"\>Все оглавления и указатели\</link\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\06170000.xhp	0	help	par_id3150211				0	ru	\<ahelp hid=\".uno:UpdateAllIndexes\" visibility=\"visible\"\>Обновляет все указатели и оглавления в текущем документе. Перед использованием этой команды нет необходимости помещать курсор в указатель или оглавление.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04020200.xhp	0	help	tit				0	ru	Отступы				20200411 15:09:53
