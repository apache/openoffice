helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3150470	47			0	ru	            \<emph\>Данные_Y\</emph\>: массив или диапазон точек данных.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3153181	48			0	ru	            \<emph\>Данные_X\</emph\>: массив или диапазон точек данных.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3156258				0	ru	Пример				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3155991	50			0	ru	            \<item type=\"input\"\>=RSQ(A1:A20;B1:B20)\</item\> используется в целях расчета коэффициента детерминации для двух наборов данных в столбцах A и B.				20200411 15:09:53
