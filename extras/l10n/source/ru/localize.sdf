helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3150381				0	ru	\<ahelp hid=\"HID_AAI_FUNC_ERF\"\>Возвращает значения гауссова интеграла ошибок.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3152475				0	ru	Синтаксис				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3163824				0	ru	ERF(LowerLimit; UpperLimit)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3149715				0	ru	\<emph\>LowerLimit\</emph\>: нижний предел интеграла.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3156294				0	ru	\<emph\>UpperLimit\</emph\> - дополнительный параметр. Это верхний предел интеграла. Если значение не указано, расчет выполняется для диапазона от 0 до нижнего предела.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3154819				0	ru	Пример				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3152974				0	ru	\<item type=\"input\"\>=ERF(0;1)\</item\> возвращает 0,842701.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	bm_id3145082				0	ru	\<bookmark_value\>Функция ERFC\</bookmark_value\>				20200411 15:09:53
