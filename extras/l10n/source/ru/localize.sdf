helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156161				0	ru	\<ahelp hid=\"HID_FUNC_NV\"\>Возвращает значение ошибки "#Н/Д".\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3147532				0	ru	Синтаксис				20200411 15:09:53
