helpcontent2	source\text\shared\02\06060000.xhp	0	help	par_id3149999				0	el	\<ahelp hid=\".uno:IncrementLevel\"\>Μετακινεί την επιλεγμένη παράγραφο πάνω ένα επίπεδο στην ιεραρχία αρίθμησης ή κουκίδων.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\06060000.xhp	0	help	par_id3149205	4			0	el	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Το εικονίδιο\<emph\> Προβιβασμός ενός επιπέδου \</emph\>βρίσκεται στην γραμμή \<emph\>Κουκίδες και αρίθμηση\</emph\> , η οποία εμφανίζεται όταν ο δείκτης τοποθετείται σε ένα στοιχείο αρίθμησης ή κουκίδων. \</caseinline\>\<caseinline select=\"IMPRESS\"\>Το εικονίδιο \<emph\> Προβιβασμός \</emph\> βρίσκεται στην γραμμή \<emph\>Μορφοποίηση κειμένου\</emph\>, η οποία εμφανίζεται κατά την εργασία σε προβολή διάρθρωσης. \</caseinline\>\</switchinline\>				20200411 15:09:53
