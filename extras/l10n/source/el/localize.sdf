helpcontent2	source\text\shared\autopi\01020300.xhp	0	help	par_idN105DE				0	el	Χρήση δεδομένων χρήστη για την διεύθυνση επιστροφής				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01020300.xhp	0	help	par_idN105E2				0	el	\<ahelp hid=\".\"\>Εισάγει υποδήλωση για τη διεύθυνση στο πρότυπο φαξ. Αργότερα, στο έγγραφο φαξ, επιλέξτε την υποδήλωση για να εισάγετε τα πραγματικά δεδομένα.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01020300.xhp	0	help	par_idN105E5				0	el	Νέα διεύθυνση επιστροφής				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01020300.xhp	0	help	par_idN105E9				0	el	\<ahelp hid=\".\"\>Επιλέξτε για να εισάγετε τα δεδομένα διεύθυνσης στο παρακάτω πεδίο κειμένου. Τα δεδομένα θα εισαχθούν ως κανονικό κείμενο το έγγραφο φαξ.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01020300.xhp	0	help	par_idN105EC				0	el	(Πεδία πληροφοριών διεύθυνσης)				20200411 15:09:53
