helpcontent2	source\text\shared\01\02090000.xhp	0	help	par_id3155261				0	el	\<switchinline select=\"appl\"\> \<caseinline select=\"CALC\"\>Για να επιλέξετε όλα τα κελιά ενός λογιστικού φύλλου, κάντε κλικ στο πεδίο τομής των επικεφαλίδων της στήλης και της γραμμής στην πάνω αριστερή γωνία του φύλλου.\</caseinline\> \<defaultinline/\> \</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02090000.xhp	0	help	par_id3154046				0	el	\<switchinline select=\"appl\"\> \<caseinline select=\"CALC\"\>Για να επιλέξετε όλα τα φύλλα  ενός αρχείου λογιστικών φύλλων, κάντε δεξί κλικ στο όνομα της καρτέλας ενός φύλλου, και στη συνέχεια επιλέξτε \<emph\>Επιλογή όλων των Φύλλων\</emph\>.\<ahelp hid=\".uno:TableSelectAll\" visibility=\"hidden\"\>Επιλέγει όλα τα φύλλα στο τρέχον έγγραφο λογιστικών φύλλων\</ahelp\>\</caseinline\> \<defaultinline/\> \</switchinline\>				20200411 15:09:53
