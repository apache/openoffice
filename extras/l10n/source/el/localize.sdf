helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3143236				0	el	\<item type=\"input\"\>=PHI(-2.25)\</item\> = 0.03				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149286				0	el	\<item type=\"input\"\>=PHI(0)\</item\> = 0.4				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153985				0	el	\<bookmark_value\>συνάρτηση POISSON\</bookmark_value\>				20200411 15:09:53
