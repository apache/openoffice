helpcontent2	source\text\smath\01\02110000.xhp	0	help	hd_id3147434				0	el	\<link href=\"text/smath/01/02110000.xhp\" name=\"Προηγούμενο σφάλμα\"\>Προηγούμενο σφάλμα\</link\>				20200411 15:09:53
