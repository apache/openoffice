helpcontent2	source\text\shared\autopi\01100500.xhp	0	help	hd_id3156211				0	el	\<link href=\"text/shared/autopi/01100500.xhp\" name=\"Αυτόματος πιλότος αναφοράς - Δημιουργία αναφοράς\"\>Αυτόματος πιλότος αναφοράς - Δημιουργία αναφοράς\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01100500.xhp	0	help	par_id3159224				0	el	\<ahelp hid=\".\"\>Μπορείτε να δημιουργήσετε την αναφορά ως στατική ή δυναμική αναφορά. Όταν ανοίγετε μια δυναμική αναφορά, θα εμφανίζει τα τρέχοντα περιεχόμενα δεδομένων. Όταν ανοίγετε μια στατική αναφορά, θα εμφανίζει πάντα τα ίδια δεδομένα από τη στιγμή όταν η στατική αναφορά δημιουργήθηκε.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01100500.xhp	0	help	hd_id3145669				0	el	Τίτλος αναφοράς				20200411 15:09:53
