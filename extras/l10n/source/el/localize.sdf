helpcontent2	source\text\shared\01\xformsdatatab.xhp	0	help	hd_id2656941				0	el	Διασύνδεση				20200411 15:09:53
helpcontent2	source\text\shared\01\xformsdatatab.xhp	0	help	par_id1481063				0	el	\<ahelp hid=\".\"\>Επιλέξτε ή εισάγετε το όνομα μιας διασύνδεσης. Επιλέγοντας το όνομα μιας υπάρχουσας διασύνδεσης την συνδέετε με το πεδίο ελέγχου φόρμας. Εισάγοντας ένα νέο όνομα δημιουργείτε μια νέα διασύνδεση και την συνδέετε με το πεδίο ελέγχου φόρμας.\</ahelp\>				20200411 15:09:53
