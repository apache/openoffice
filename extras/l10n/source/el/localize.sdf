helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3148467				0	el	4				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3149237	148			0	el	                     \<item type=\"input\"\>189\</item\>                  				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3145304	149			0	el	                     \<item type=\"input\"\>170\</item\>                  				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3149927				0	el	5				20200411 15:09:53
