helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148742				0	el	\<link href=\"text/scalc/01/04060103.xhp\" name=\"Επιστροφή στις Οικονομικές συναρτήσεις - Μέρος Πρώτο\"\>Επιστροφή στις Οικονομικές συναρτήσεις - Μέρος Πρώτο\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151341				0	el	\<link href=\"text/scalc/01/04060118.xhp\" name=\"Μετάβαση στις Οικονομικές συναρτήσεις - Μέρος τρίτο\"\>Μετάβαση στις Οικονομικές συναρτήσεις - Μέρος τρίτο\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3150026				0	el	\<bookmark_value\>συνάρτηση PPMT\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150026				0	el	PPMT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146942				0	el	\<ahelp hid=\"HID_FUNC_KAPZ\"\>Επιστρέφει την πληρωμή επί του κεφαλαίου σε μια δεδομένη περίοδο για μια επένδυση βάσει περιοδικών, σταθερών πληρωμών και σταθερού επιτοκίου.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150459				0	el	Σύνταξη				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146878				0	el	PPMT(Επιτόκιο, Περίοδος, NPer, Παρούσα-αξία, Μελλοντική-αξία, Τύπος)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151228				0	el	\<emph\>Επιτόκιο\</emph\> είναι το περιοδικό επιτόκιο.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148887				0	el	\<emph\>Περίοδος\</emph\> είναι η τοκοχρεολυτική περίοδος. P=1 για την πρώτη και P=NPER για την τελευταία περίοδο.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148436				0	el	\<emph\>NPer\</emph\> είναι ο συνολικός αριθμός περιόδων, κατά τις οποίες καταβάλλεται η πρόσοδος.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153035				0	el	\<emph\>PV\</emph\> είναι η παρούσα τρέχουσα αξία σε μια σειρά πληρωμών.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147474				0	el	\<emph\>FV\</emph\> (προαιρετική) είναι η επιθυμητή (μελλοντική) αξία.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3144744				0	el	\<emph\>Τύπος\</emph\> (προαιρετική) καθορίζει την ημερομηνία λήξεως. F=1 για πληρωμή στην αρχή της περιόδου και F=0 για πληρωμή στο τέλος της περιόδου.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_idN1067C				0	el	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3148582				0	el	Παράδειγμα				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154811				0	el	Πόσο μεγάλη είναι η περιοδική μηνιαία πληρωμή με επιτόκιο της τάξεως του 8,75% για περίοδο 3 ετών; Η τρέχουσα αξία είναι 5.000 νομισματικές μονάδες. Θα πρέπει να καταβάλλεται πάντα στην αρχή της περιόδου. Η μελλοντική αξία είναι 8.000 νομισματικές μονάδες.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149246				0	el	\<item type=\"input\"\>=PPMT(8.75%/12;1;36;5000;8000;1)\</item\> = -350.99 νομισματικές μονάδες.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3146139				0	el	\<bookmark_value\>υπολογισμός, συνολικά χρεωλυτικά επιτόκια\</bookmark_value\>\<bookmark_value\>συνολικά χρεωλυτικά επιτόκια\</bookmark_value\>\<bookmark_value\>χρεωλυτική δόση\</bookmark_value\>\<bookmark_value\>δόση εξόφλησης\</bookmark_value\>\<bookmark_value\>συνάρτηση CUMPRINC\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3146139				0	el	CUMPRINC				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150140				0	el	\<ahelp hid=\"HID_FUNC_KUMKAPITAL\"\>Επιστρέφει το σωρευτικό τόκο που καταβλήθηκε για μια επενδυτική περίοδο με σταθερό επιτόκιο.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149188				0	el	Σύνταξη				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148733				0	el	CUMPRINC(Επιτόκιο; NPER; Pv; S; E; Τύπος)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150864				0	el	\<emph\>Επιτόκιο\</emph\> είναι το περιοδικό επιτόκιο.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3166052				0	el	\<emph\>NPer\</emph\> είναι η περίοδος πληρωμής με το συνολικό αριθμό περιόδων. Μπορεί να είναι επίσης μη-ακέραια.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150007				0	el	\<emph\>PV\</emph\> είναι η παρούσα τρέχουσα αξία στη σειρά πληρωμών.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153112				0	el	\<emph\>S\</emph\> είναι η πρώτη περίοδος.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146847				0	el	\<emph\>Ε\</emph\> είναι η τελευταία περίοδος.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145167				0	el	\<emph\>Τύπος\</emph\> (προαιρετικό) είναι η ημερομηνία που πρέπει να γίνει η πληρωμή, είτε στην αρχή είτε στο τέλος της περιόδου.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154502				0	el	Παράδειγμα				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153570				0	el	Ποια είναι τα ποσά εξόφλησης αν το επιτόκιο είναι 5,5% για 36 περιόδους. Η τρέχουσα αξία είναι 15.000 νομισματικές μονάδες. Το ποσό εξόφλησης υπολογίζεται μεταξύ της 10ης και 18ης περιόδου. Η ημερομηνία λήξης της πληρωμής είναι για το τέλος της περιόδου.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149884				0	el	\<item type=\"input\"\>=CUMPRINC(5.5%/12;36;15000;10;18;0)\</item\> = -3669,74 νομισματικές μονάδες. Το ποσό εξόφλησης μεταξύ της 10ης και 18ης περιόδου είναι 3669,74 νομισματικές μονάδες.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3150019				0	el	\<bookmark_value\>συνάρτηση CUMPRINC_ADD\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150019				0	el	CUMPRINC_ADD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145246				0	el	\<ahelp hid=\"HID_AAI_FUNC_CUMPRINC\"\>Υπολογίζει τη σωρευτική εξαγορά ενός δανείου για κάποια περίοδο.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153047				0	el	Σύνταξη				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3157970				0	el	CUMPRINC_ADD(Επιτόκιο; NPER; ΠΑ; Περίοδος έναρξης; Περίοδος λήξης; Τύπος)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145302				0	el	Η παράμετρος \<emph\>Επιτόκιο\</emph\> καθορίζει το επιτόκιο ανά περίοδο.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151017				0	el	\<emph\>NPer\</emph\> είναι ο συνολικός αριθμός περιόδων πληρωμής. Το επιτόκιο και το NPER πρέπει να αναφέρονται στην ίδια μονάδα και ως εκ τούτου και τα δύο πρέπει να υπολογίζονται ετησίως ή μηνιαίως				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155620				0	el	\<emph\>ΠΑ\</emph\> είναι η τρέχουσα (παρούσα) αξία.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145352				0	el	\<emph\>Περίοδος έναρξης\</emph\> είναι η πρώτη περίοδος πληρωμής για τον υπολογισμό.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3157986				0	el	\<emph\>Περίοδος λήξης\</emph\> είναι η τελευταία περίοδος πληρωμής για τον υπολογισμό.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150570				0	el	\<emph\>Τύπος\</emph\> είναι η ωρίμανση (λήξη) της πληρωμής στο τέλος (Τύπος=0) κάθε περιόδου ή στην αρχή (Τύπος=1).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150269				0	el	Παράδειγμα				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148774				0	el	Το ακόλουθο ενυπόθηκο δάνειο συνάπτεται για μια οικία:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150661				0	el	Επιτόκιο: 9,00% ετησίως (9% / 12 = 0,0075), Διάρκεια: 30 έτη (περίοδοι πληρωμών = 30 * 12 = 360), NPV: 125000 νομισματικές μονάδες.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155512				0	el	Πόσο θα αποπληρώσετε το δεύτερο έτος του ενυπόθηκου δανείου (συνεπώς από τις περιόδους 13 έως 24);				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149394				0	el	\<item type=\"input\"\>=CUMPRINC_ADD(0.0075;360;125000;13;24;0)\</item\> επιστρέφει -934,1071				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149026				0	el	Τον πρώτο μήνα θα έχετε πληρώσει το ακόλουθο ποσό:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154636				0	el	\<item type=\"input\"\>=CUMPRINC_ADD(0.0075;360;125000;1;1;0)\</item\> επιστρέφει -68,27827				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3155370				0	el	\<bookmark_value\>υπολογισμός, σωρευτικοί τόκοι\</bookmark_value\>\<bookmark_value\>σωρευμένα επιτόκια\</bookmark_value\>\<bookmark_value\>συνάρτηση CUMIPMT\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155370				0	el	CUMIPMT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3158411				0	el	\<ahelp hid=\"HID_FUNC_KUMZINSZ\"\>Υπολογίζει τις σωρευτικές πληρωμές τόκου, δηλ. το συνολικό τόκο, για μια επένδυση που βασίζεται σε σταθερό επιτόκιο.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155814				0	el	Σύνταξη				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147536				0	el	CUMIPMT(Επιτόκιο; NPer; PV; S; E; Τύπος)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150475				0	el	\<emph\>Επιτόκιο\</emph\> είναι το περιοδικό επιτόκιο.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153921				0	el	\<emph\>NPer\</emph\> είναι η περίοδος πληρωμής με το συνολικό αριθμό περιόδων. Μπορεί να είναι επίσης μη-ακέραια τιμή.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153186				0	el	\<emph\>PV\</emph\> είναι η παρούσα τρέχουσα αξία στη σειρά πληρωμών.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156259				0	el	\<emph\>S\</emph\> είναι η πρώτη περίοδος.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155990				0	el	\<emph\>E\</emph\> είναι η τελευταία περίοδος.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149777				0	el	\<emph\>Τύπος\</emph\> (προαιρετικό) είναι η ημερομηνία που πρέπει να γίνει η πληρωμή, είτε στην αρχή είτε στο τέλος της περιόδου.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153723				0	el	Παράδειγμα				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147478	277			0	el	Ποιες είναι οι πληρωμές του τόκου με περιοδικό επιτόκιο της τάξεως του 5,5 %, με περιοδική περίοδο 2 ετών και με τρέχουσα αξία 5.000 νομισματικών μονάδων; Η περίοδος έναρξης είναι η 4η και η τελική περίοδος είναι η 6η. Η περιοδική πληρωμή αναμένεται στην αρχή κάθε περιόδου.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149819				0	el	\<item type=\"input\"\>=CUMIPMT(5.5%/12;24;5000;4;6;1)\</item\> = -57.54 νομισματικές μονάδες. Οι πληρωμές τόκων μεταξύ της 4ης και 6ης περιόδου είναι 57.54 νομισματικές μονάδες.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3083280				0	el	\<bookmark_value\>συνάρτηση CUMIPMT_ADD\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3083280				0	el	CUMIPMT_ADD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3152482				0	el	\<ahelp hid=\"HID_AAI_FUNC_CUMIPMT\"\>Υπολογίζει το συσσωρευμένο τόκο για μια περίοδο.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149713				0	el	Σύνταξη				20200411 15:09:53
