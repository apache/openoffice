helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149985				0	el	\<item type=\"input\"\>Προκαταβεβλημένο\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154744				0	el	3				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153151				0	el	2001-03-15				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145657				0	el	2500				20200411 15:09:53
