helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN10590				0	el	Χρήση περιορισμών ονομασίας SQL92				20200411 15:09:53
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN10594				0	el	\<ahelp hid=\".\"\>Επιτρέπει μόνο χαρακτήρες που προσαρμόζονται με τη σύμβαση ονομασίας SQL92, σε ένα όνομα σε μία βάση δεδομένων προέλευσης. Όλοι οι υπόλοιποι χαρακτήρες απορρίπτονται. Κάθε όνομα πρέπει να ξεκινά με πεζό γράμμα, κεφαλαίο, ή έναν χαρακτήρα υπογράμμισης ( _ ). Οι υπόλοιποι χαρακτήρες μπορούν να είναι γράμματα ASCII, αριθμοί, και χαρακτήρες υπογράμμισης.\</ahelp\>				20200411 15:09:53
