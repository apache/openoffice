uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_IO_UNSUPPORTEDOVERWRITE & ERRCODE_RES_MASK)			0	el	Το %PRODUCTNAME δεν μπορεί να συγκρατήσει την επικάλυψη των αρχείων όσο χρησιμοποιείται αυτό το πρωτόκολλο μετάδοσης. Θέλετε να συνεχίσετε οπωσδήποτε;				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_IO_BROKENPACKAGE & ERRCODE_RES_MASK)			1	el	Το αρχείο '$(ARG1)' είναι αλλοιωμένο και έτσι δεν μπορεί να ανοιχτεί. Το %PRODUCTNAME μπορεί να προσπαθήσει να επισκευάσει το αρχείο.\n\nΗ αλλοίωση μπορεί να είναι αποτέλεσμα από την τροποποίηση του εγγράφου ή από ζημιά στη δομή του εγγράφου λόγω της μεταφοράς δεδομένων.\n\nΣυνιστούμε να μην εμπιστευτείτε το περιεχόμενο του επισκευασμένου εγγράφου.\nΗ εκτέλεση μακροεντολών έχει απενεργοποιηθεί για αυτό το έγγραφο.\n\nΘέλετε το %PRODUCTNAME να επισκευάσει το αρχείο;\n				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_IO_BROKENPACKAGE_CANTREPAIR & ERRCODE_RES_MASK)			1	el	Το αρχείο '$(ARG1)' δεν μπορούσε να επισκευαστεί και επομένως δεν μπορεί να ανοίξει.				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_CONFIGURATION_BROKENDATA_NOREMOVE & ERRCODE_RES_MASK)			1	el	Τα ρυθμιστικά δεδομένα στο '$(ARG1)' είναι αλλοιωμένα. Χωρίς αυτά τα δεδομένα κάποιες λειτουργίες μπορεί να μην λειτουργούν σωστά.\nΘέλετε να συνεχίσετε την εκκίνηση του %PRODUCTNAME χωρίς τα αλλοιωμένα ρυθμιστικά δεδομένα;				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_CONFIGURATION_BROKENDATA_WITHREMOVE & ERRCODE_RES_MASK)			1	el	Το προσωπικό αρχείο ρύθμισης '$(ARG1)' είναι αλλοιωμένο και πρέπει να διαγραφεί για να συνεχίσετε. Κάποιες από τις προσωπικές σας ρυθμίσεις μπορεί να χαθούν.\nΘέλετε να συνεχίσετε την εκκίνηση του %PRODUCTNAME χωρίς αυτά τα προβληματικά δεδομένα;				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_CONFIGURATION_BACKENDMISSING & ERRCODE_RES_MASK)			1	el	Η πηγή δεδομένων ρύθμισης '$(ARG1)' δεν είναι διαθέσιμη. Χωρίς αυτά τα δεδομένα κάποιες εντολές μπορεί να μην λειτουργούν σωστά.				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_CONFIGURATION_BACKENDMISSING_WITHRECOVER & ERRCODE_RES_MASK)			1	el	Η πηγή δεδομένων ρύθμισης '$(ARG1)' δεν είναι διαθέσιμη. Χωρίς αυτά τα δεδομένα μερικές εντολές μπορεί να μην λειτουργούν σωστά.\nΘέλετε να συνεχίσετε την εκκίνηση του %PRODUCTNAME χωρίς τα μη υπάρχοντα δεδομένα ρύθμισης;				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_INVALID_XFORMS_SUBMISSION_DATA & ERRCODE_RES_MASK)			1	el	Η φόρμα περιέχει μη έγκυρα δεδομένα. Θέλετε ακόμα να συνεχίσετε;				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_LOCKING_LOCKED & ERRCODE_RES_MASK)			1	el	Το έγγραφο $(ARG1) είναι κλειδωμένο από άλλο χρήστη. Δεν είναι δυνατή η πρόσβαση εγγραφής σε αυτό το αρχείο.				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_LOCKING_LOCKED_SELF & ERRCODE_RES_MASK)			1	el	Το έγγραφο $(ARG1) είναι κλειδωμένο από εσάς. Δεν είναι δυνατή η πρόσβαση εγγραφής σε αυτό το αρχείο.				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_LOCKING_NOT_LOCKED & ERRCODE_RES_MASK)			1	el	Το έγγραφο $(ARG1) δεν είναι κλειδωμένο από εσάς.				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_LOCKING_LOCK_EXPIRED & ERRCODE_RES_MASK)			1	el	Το προηγούμενο κλείδωμα για το αρχείο $(ARG1) έχει λήξει.\nΑυτό μπορεί να συμβαίνει λόγω προβλημάτων στον εξυπηρετητή που διαχειρίζεται τα κλειδώματα. Πιθανώς οι εργασίες εγγραφής σε αυτό το αρχείο να αντικαταστήσουν αλλαγές που έχουν γίνει ήδη από άλλους χρήστες!				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_UNKNOWNAUTH_UNTRUSTED)			1	el	Δεν έγινε δυνατός ο έλεγχος της ταυτότητας της $(ARG1) ιστοσελίδας.\n\nπριν αποδεχτείτε αυτό το πιστοποιητικό, πρέπει να εξετάσετε το πιστοποιητικό αυτής της περιοχής προσεκτικά. Είστε πρόθυμοι να δεχτείτε αυτό το πιστοποιητικό με σκοπό τον προσδιορισμό του ιστοχώρου $(ARG1) ;				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_SSLWARN_EXPIRED_1)			1	el	$(ARG1) είναι μια περιοχή που χρησιμοποιεί ένα πιστοποιητικό ασφάλειας για να κρυπτογραφήσει τα στοιχεία κατά τη διάρκεια της μετάδοσης, αλλά το πιστοποιητικό του έχει λήξει $(ARG2).\n\nΠρέπει να ελέγξετε για να σιγουρευτείτε ότι ο χρόνος του υπολογιστή σας είναι σωστός.				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_SSLWARN_DOMAINMISMATCH_1)			1	el	Έχετε προσπαθήσει να εγκαταστήσετε μια σύνδεση με $(ARG1). Εντούτοις, το πιστοποιητικό ασφάλειας που παρουσιάζεται ανήκει στο $(ARG2). Υπάρχει περίπτωση, αν και είναι απίθανο, κάποιος να προσπαθεί να παρεμποδίσει την επικοινωνία σας με αυτόν τον ιστοχώρο.\n\nΕάν υποψιάζεστε ότι το πιστοποιητικό που παρουσιάζεται δεν ανήκει στο $(ARG1), παρακαλώ ακυρώστε τη σύνδεση και ειδοποιήστε τον διαχειριστή της ιστοσελίδας.\n\nΘέλετε να συνεχίσετε οπωσδήποτε ;				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_SSLWARN_INVALID_1)			1	el	Το πιστοποιητικό δεν μπόρεσε να επικυρωθεί. Πρέπει να εξετάσετε το πιστοποιητικό αυτής της περιοχής προσεκτικά.\n\nΕάν υποψιάζεστε το πιστοποιητικό που παρουσιάζεται, παρακαλώ ακυρώστε τη σύνδεση και ειδοποιήστε τον διαχειριστή του ιστοχώρου.				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(TITLE_UUI_SSLWARN_DOMAINMISMATCH)			1	el	Προειδοποίηση ασφάλειας: κακός συνδυασμός ονόματος ιστοσελίδας				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(TITLE_UUI_SSLWARN_EXPIRED)			1	el	Προειδοποίηση Ασφάλειας: το Πιστοποιητικό του Διακομιστή έχει Λήξει				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(TITLE_UUI_SSLWARN_INVALID)			1	el	Προειδοποίηση Ασφάλειας: το Πιστοποιητικό του Διακομιστή είναι Άκυρο				20200411 15:09:53
uui	source\filechanged.src	0	string	STR_FILECHANGED_TITLE				0	el	Το Έγγραφο Έχει Τροποποιηθεί από Άλλους				20200411 15:09:53
uui	source\filechanged.src	0	string	STR_FILECHANGED_MSG				0	el	Το αρχείο έχει τροποποιηθεί από τότε που ανοίχθηκε για επεξεργασία στο %PRODUCTNAME. Αν αποθηκεύσετε αυτή την έκδοση του εγγράφου σας, οι αλλαγές που έγιναν από τρίτους θα χαθούν.\n\nΘέλετε να το αποθηκεύσετε οπωσδήποτε;\n\n				20200411 15:09:53
