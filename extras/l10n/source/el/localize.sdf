helpcontent2	source\text\schart\01\04020000.xhp	0	help	hd_id3155114				0	el	Προβολή				20200411 15:09:53
helpcontent2	source\text\schart\01\04020000.xhp	0	help	par_id3150206				0	el	\<ahelp hid=\"SCH_CHECKBOX_DLG_LEGEND_CBX_SHOW\"\>Προσδιορίζει αν θα εμφανίζεται το υπόμνημα του διαγράμματος.\</ahelp\> Αυτή η επιλογή είναι διαθέσιμη μόνο αν καλέσετε το παράθυρο διαλόγου επιλέγοντας \<emph\>Εισαγωγή - Υπόμνημα\</emph\>.				20200411 15:09:53
helpcontent2	source\text\schart\01\04020000.xhp	0	help	hd_id3150201				0	el	Θέση				20200411 15:09:53
