helpcontent2	source\text\scalc\01\02150000.xhp	0	help	par_id3146134				0	el	\<ahelp hid=\"SC_CHECKBOX_RID_SCDLG_DELCONT_BTN_DELATTRS\"\>Διαγράφει ιδιότητες μορφοποιήσεων που εφαρμόστηκαν σε κελιά. Όλο το περιεχόμενο των κελιών παραμένει αμετάβλητο.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	hd_id3150088				0	el	Αντικείμενα				20200411 15:09:53
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	par_id3152990				0	el	\<ahelp hid=\"SC_CHECKBOX_RID_SCDLG_DELCONT_BTN_DELOBJECTS\"\>Διαγράφει αντικείμενα. Όλο το άλλο περιεχόμενο των κελιών παραμένει αμετάβλητο.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060000.xhp	0	help	tit				0	el	Προστασία εγγράφου				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060000.xhp	0	help	hd_id3148946				0	el	\<link href=\"text/scalc/01/06060000.xhp\" name=\"Προστασία εγγράφου\"\>Προστασία εγγράφου\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060000.xhp	0	help	par_id3153362	2			0	el	Η εντολή \<emph\>Προστασία εγγράφου\</emph\> αποτρέπει τις αλλαγές σε κελιά σε υπολογιστικά φύλλα και έγγραφα. Προαιρετικά, μπορείτε να καθορίσετε έναν κωδικό πρόσβασης. Αν ορισθεί κωδικός πρόσβασης τότε η αφαίρεση της προστασίας είναι δυνατή μόνο αν ο χρήστης εισάγει το σωστό κωδικό.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060000.xhp	0	help	hd_id3147228				0	el	\<link href=\"text/scalc/01/06060100.xhp\" name=\"Φύλλα\"\>Φύλλα\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060000.xhp	0	help	hd_id3153768				0	el	\<link href=\"text/scalc/01/06060200.xhp\" name=\"Έγγραφα\"\>Έγγραφα\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060000.xhp	0	help	par_idN10622				0	el	\<embedvar href=\"text/scalc/guide/cell_protect.xhp#cell_protect\"/\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	tit				0	el	Γέμισμα σειρών				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3148664				0	el	Γέμιδμα σειρών				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3148797				0	el	\<variable id=\"reihenfuellentext\"\>\<ahelp hid=\".uno:FillSeries\"\>Δημιουργεί αυτόματα σειρές με τις επιλογές σε αυτό το παράθυρο διαλόγου. Καθορίστε την κατεύθυνση, την αύξηση, τη μονάδα χρόνου και τον τύπο της σειράς.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3146976				0	el	Πριν γεμίσετε μια σειρά, πρώτα επιλέξτε την περιοχή κελιών. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3145748				0	el	Για να συνεχίσετε αυτόματα μια σειρά χρησιμοποιώντας τους συναγόμενους κανόνες συμπλήρωσης, επιλέξτε το \<emph\>Αυτόματο γέμισμα\</emph\> αφού ανοίξετε το παράθυρο διαλόγου \<emph\>Γέμισμα σειρών\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3147435				0	el	Κατεύθυνση				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3154729				0	el	Καθορίζει την κατεύθυνση της δημιουργίας σειρών.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3145253				0	el	Κάτω				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3155418				0	el	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_BOTTOM\"\>Δημιουργεί μια σειρά προς τα κάτω στην επιλεγμένη περιοχή κελιών για τη στήλη χρησιμοποιώντας το καθορισμένο βήμα μέχρι την τελική τιμή.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3155738				0	el	Δεξιά				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3149402				0	el	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_RIGHT\"\>Δημιουργεί μια σειρά από αριστερά προς τα δεξιά στην επιλεγμένη περιοχή κελιών χρησιμοποιώντας το καθορισμένο βήμα μέχρι την τελική τιμή.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3146972				0	el	Πάνω				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3153711				0	el	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_TOP\"\>Δημιουργεί μια σειρά προς τα πάνω στην επιλεγμένη περιοχή κελιών για τη στήλη χρησιμοποιώντας το καθορισμένο βήμα μέχρι την τελική τιμή.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3153764				0	el	Αριστερά				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3156382				0	el	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_LEFT\"\>Δημιουργεί μια σειρά από δεξιά προς τα αριστερά στην επιλεγμένη περιοχή κελιών χρησιμοποιώντας το καθορισμένο βήμα μέχρι την τελική τιμή.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3147344				0	el	Τύπος σειράς δεδομένων				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3149257	15			0	el	Καθορίζει τον τύπος της σειράς. Επιλέξτε ανάμεσα στις επιλογές \<emph\>Αριθμητική, Γεωμετρική, Ημερομηνία\</emph\> και \<emph\>Αυτόματο γέμισμα\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3148488				0	el	Γραμμική				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3159238				0	el	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_ARITHMETIC\"\>Δημιουργεί μια γραμμική σειρά αριθμών χρησιμοποιώντας το καθορισμένο βήμα και την τελική τιμή.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3149210				0	el	Γεωμετρική				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3150364				0	el	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_GEOMETRIC\"\>Δημιουργεί μια γεωμετρική πρόοδο χρησιμοποιώντας το καθορισμένο βήμα και την τελική τιμή.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3149528				0	el	Ημερομηνία				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3150887				0	el	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_DATE\"\>Δημιουργεί μια σειρά ημερομηνιών χρησιμοποιώντας το καθορισμένο βήμα και την τελική ημερομηνία.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3150202				0	el	Αυτόματο γέμισμα				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3156288				0	el	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_AUTOFILL\"\>Διαμορφώνει σειρές απευθείας στο φύλλο.\</ahelp\> Η λειτουργία Αυτόματης Συμπλήρωσης λαμβάνει υπόψη λίστες διαμορφωμένες από το χρήστη. Για παράδειγμα, καταχωρώντας \<emph\>January\</emph\> στο πρώτο κελί, η σειρά συμπληρώνεται με βάση την λίστα που έχετε ορίσει στο \<emph\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Επιλογές\</caseinline\>\<defaultinline\>Εργαλεία - Επιλογές\</defaultinline\>\</switchinline\> - %PRODUCTNAME Calc - Σύντομες Λίστες\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3155811				0	el	Το Αυτόματο γέμισμα προσπαθεί να συμπληρώσει μια σειρά τιμών χρησιμοποιώντας ένα καθορισμένο σχέδιο. Η σειρά 1,3,5 συμπληρώνεται αυτόματα με τα 7,9,11,13 κ.ο.κ. Οι σειρές ημερομηνίας και ώρας συμπληρώνονται αντίστοιχα. Π.χ. μετά την 01.01.99 και 15.01.99 χρησιμοποιείται ένα διάστημα 14 ημερών.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3148700				0	el	Μονάδα χρόνου				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3153308				0	el	Σε αυτή την περιοχή μπορείτε να καθορίσετε την επιθυμητή μονάδα χρόνου. Αυτή η περιοχή είναι ενεργή μόνο αν έχει επιλεχθεί η επιλογή \<emph\>Ημερομηνία\</emph\> στην περιοχή \<emph\>Τύπος σειράς\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3148868				0	el	Ημέρα				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3148605				0	el	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_DAY\"\>Χρησιμοποιήστε τον τύπο σειράς \<emph\>Ημερομηνία\</emph\> και αυτή την επιλογή για να δημιουργήσετε μια σειρά επτά ημερών.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3144771				0	el	Ημέρα της εβδομάδας				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3150108				0	el	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_DAY_OF_WEEK\"\>Χρησιμοποιήστε τον τύπο σειράς \<emph\>Ημερομηνία\</emph\> και αυτή την επιλογή για να δημιουργήσετε μια σειρά από πενθήμερα.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3154957				0	el	Μήνας				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3149126				0	el	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_MONTH\"\>Χρησιμοποιήστε τον τύπο σειράς \<emph\>Ημερομηνία\</emph\> και αυτή την επιλογή για να δημιουργήσετε μια σειρά από τα ονόματα ή τις συντομογραφίες των μηνών.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3152870				0	el	Έτος				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3151300				0	el	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_YEAR\"\>Χρησιμοποιήστε τον τύπο σειράς \<emph\>Ημερομηνία\</emph\> και αυτή την επιλογή για να δημιουργήσετε μια σειρά ετών.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3154762				0	el	Αρχική τιμή				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3149381				0	el	\<ahelp hid=\"SC:EDIT:RID_SCDLG_FILLSERIES:ED_START_VALUES\"\>Καθορίζει την αρχική τιμή για τη σειρά.\</ahelp\> Χρησιμοποιήστε αριθμούς, ημερομηνίες ή χρόνους.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3153013				0	el	Τελική τιμή				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3153487				0	el	\<ahelp hid=\"SC:EDIT:RID_SCDLG_FILLSERIES:ED_END_VALUES\"\>Καθορίζει την τιμή τέλους για τη σειρά\</ahelp\> Χρησιμοποιήστε αριθμούς, ημερομηνίες ή ώρες.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3149312				0	el	Βήμα				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3154739				0	el	Ο όρος "βήμα" αντιπροσωπεύει το ποσό κατά το οποίο αυξάνει μια δοσμένη τιμή. \<ahelp hid=\"SC:EDIT:RID_SCDLG_FILLSERIES:ED_INCREMENT\"\>Καθορίζει την τιμή κατά την οποία μια σειρά του επιλεγμένου τύπου αυξάνει σε κάθε βήμα.\</ahelp\> Καταχωρίσεις μπορούν να γίνουν μόνο αν έχουν επιλεγεί οι τύποι σειρών αριθμητική, γεωμετρική ή ημερομηνία.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140100.xhp	0	help	tit				0	el	Κάτω				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140100.xhp	0	help	hd_id3150792				0	el	\<link href=\"text/scalc/01/02140100.xhp\" name=\"Κάτω\"\>Κάτω\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140100.xhp	0	help	par_id3153969				0	el	\<ahelp hid=\".uno:FillDown\" visibility=\"visible\"\>Συμπληρώνει μια επιλεγμένη περιοχή τουλάχιστον δύο γραμμών με τα περιεχόμενα του κελιού που βρίσκεται στην κορυφή της περιοχής.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140100.xhp	0	help	par_id3145787				0	el	Αν η επιλεγμένη περιοχή περιέχει μόνο μία στήλη, τα περιεχόμενα του πάνω κελιού αντιγράφονται σε όλα τα υπόλοιπα. Αν μερικές στήλες είναι επιλεγμένες, τα περιεχόμενα του αντίστοιχου πάνω κελιού θα αντιγραφούν από κάτω.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04030000.xhp	0	help	tit				0	el	Γραμμές				20200411 15:09:53
helpcontent2	source\text\scalc\01\04030000.xhp	0	help	bm_id3150541				0	el	\<bookmark_value\>υπολογιστικά φύλλα, γραμμές\</bookmark_value\>\<bookmark_value\>γραμμές, εισαγωγή\</bookmark_value\>\<bookmark_value\>εισαγωγή, γραμμές\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04030000.xhp	0	help	hd_id3150541				0	el	\<link href=\"text/scalc/01/04030000.xhp\" name=\"Γραμμές\"\>Γραμμές\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04030000.xhp	0	help	par_id3150767				0	el	\<ahelp hid=\".uno:InsertRows\" visibility=\"visible\"\>Εισάγει μία νέα γραμμή πάνω από το ενεργό κελί.\</ahelp\> Ο αριθμός των γραμμών που εισάγονται αντιστοιχεί στον αριθμό των επιλεγμένων γραμμών. Οι υπάρχουσες γραμμές μετακινούνται προς τα κάτω.				20200411 15:09:53
