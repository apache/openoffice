helpcontent2	source\text\schart\01\04050000.xhp	0	help	hd_id0428200810574027				0	el	Θετική και αρνητική				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id0428200810574039				0	el	\<ahelp hid=\".\"\>Εμφανίζει τις θετικές και τις αρνητικές τιμές στα διαγράμματα σφαλμάτων.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	hd_id0428200810574031				0	el	Θετική				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id042820081057411				0	el	\<ahelp hid=\".\"\>Εμφανίζει μόνο τις θετικές τιμές στα διαγράμματα σφαλμάτων.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	hd_id0428200810574138				0	el	Αρνητική				20200411 15:09:53
