helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	hd_id3159411				0	el	\<link href=\"text/shared/optionen/01013000.xhp\" name=\"Προσιτότητα\"\>Προσιτότητα\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	par_id3149827				0	el	\<ahelp hid=\".\"\>Ενεργοποιεί επιλογές που κάνουν τα προγράμματα \<item type=\"productname\"\>%PRODUCTNAME\</item\> πιο προσιτά σε χρήστες με μειωμένη όραση, περιορισμένη δεξιότητα ή άλλες ανάγκες.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	hd_id3166460				0	el	Άλλες επιλογές				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	par_id3152996				0	el	Θέτει τις επιλογές της δυνατότητας πρόσβασης				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	hd_id3154750				0	el	\<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>\</caseinline\>\<defaultinline\>Υποστήριξη βοηθητικών τεχνολογιών (απαιτείται επανεκκίνηση του προγράμματος\</defaultinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	par_id3155628				0	el	\<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>\</caseinline\>\<defaultinline\>\<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_ACCESSIBILITYCONFIG_CB_ACCESSIBILITY_TOOL\"\>Σας επιτρέπει να χρησιμοποιήσετε βοηθητικά εργαλεία, όπως εξωτερικούς αναγνώστες οθόνης, συσκευές Braille ή συσκευές αναγνώρισης ομιλίας. Πρέπει να έχετε ήδη εγκατεστημένο στον υπολογιστή σας το Java Runtime Environment πριν ενεργοποιήσετε την βοήθεια.\</ahelp\>\</defaultinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	hd_id3154047				0	el	Χρήση δείκτη επιλογής κειμένου σε έγραφα μόνο για ανάγνωση				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	par_id3149164				0	el	\<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_ACCESSIBILITYCONFIG_CB_TEXTSELECTION\"\>Εμφανίζει τον δείκτη στα αρχεία μόνο για ανάγνωση.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	hd_id3147531				0	el	Να επιτρέπονται τα κινούμενα γραφικά.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	par_id3145069				0	el	\<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_ACCESSIBILITYCONFIG_CB_ANIMATED_GRAPHICS\"\>Παρουσιάζει  κινούμενα γραφικά, όπως εικόνες τύπου GIF, στο \<item type=\"productname\"\>%PRODUCTNAME\</item\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	hd_id3147264				0	el	Να επιτρέπεται το κινούμενο κείμενο.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	par_id3149656				0	el	\<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_ACCESSIBILITYCONFIG_CB_ANIMATED_TEXTS\"\>Παρουσιάζει κινούμενο κείμενο, όπως κείμενο που αναβοσβήνει και τυλίγεται, στο \<item type=\"productname\"\>%PRODUCTNAME\</item\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	hd_id3153381				0	el	Οι συμβουλές βοήθειας να εξαφανίζονται μετά από				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	par_id3150868				0	el	\<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_ACCESSIBILITYCONFIG_CB_TIPHELP\"\>Αποκρύπτει τις \<link href=\"text/shared/main0108.xhp\" name=\"Συμβουλές βοήθειας\"\>Συμβουλές βοήθειας\</link\> μετά  από τα δευτερόλεπτα που εισαγάγατε.\</ahelp\> Αλλιώς, οι συμβουλές βοήθειας εμφανίζονται μέχρι να πατήσετε Escape ή να μετακινήσετε το δείκτη.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	hd_id3151043				0	el	Δευτερόλεπτα				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	par_id3148672				0	el	\<ahelp hid=\"SVX_NUMERICFIELD_RID_SVXPAGE_ACCESSIBILITYCONFIG_NF_TIPHELP\"\>Πληκτρολήστε τον αριθμό των δευτερολέπτων που θα εμφανίζονται οι συμβουλές βοήθειας.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	hd_id3149809				0	el	Επιλογές για εμφάνιση υψηλής αντίθεσης				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	par_id3153106				0	el	Η υψηλή αντίθεση είναι μια ρύθμιση του λειτουργικού συστήματος που αλλάζει το συνδυασμό χρωμάτων του συστήματος για να βελτιώσει την αναγνωσιμότητα. Μπορείτε να επιλέξετε με πιο τρόπο το \<item type=\"productname\"\>%PRODUCTNAME\</item\> θα χρησιμοποιήσει την ρύθμιση υψηλής αντίθεσης του λειτουργικού συστήματος.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	par_id3125863				0	el	Τα περιγράμματα και οι σκιές των κελιών εμφανίζονται πάντα στο χρώμα του κειμένου όταν είναι ενεργή η λειτουργία υψηλής αντίθεσης. Το φόντο των κελιών αγνοείται τότε.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	hd_id3155132				0	el	Αυτόματη ανίχνευση της κατάστασης λειτουργίας υψηλής αντίθεσης του λειτουργικού συστήματος				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	par_id3153768				0	el	\<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_ACCESSIBILITYCONFIG_CB_AUTO_DETECT_HC\"\>Αλλάζει το περιβάλλον του \<item type=\"productname\"\>%PRODUCTNAME\</item\> σε κατάσταση λειτουργίας υψηλής αντίθεσης όταν το χρώμα του φόντου του συστήματος είναι πολύ σκούρο.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01013000.xhp	0	help	hd_id3154918				0	el	Χρήση αυτόματου χρώματος γραμματοσειράς για την εμφάνιση οθόνης				20200411 15:09:53
