helpcontent2	source\text\shared\optionen\01010800.xhp	0	help	par_id4743797				0	el	\<ahelp hid=\".\"\>Εισάγετε το μικρότερο μέγεθος γραμματοσειράς στο οποίο θα εφαρμόζεται η εξομάλυνση.\</ahelp\>				20200411 15:09:53
