helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157790				0	el	\<ahelp hid=\"HID_FUNC_PI\"\>Επιστρέφει 3.14159265358979, την τιμή της μαθηματικής σταθεράς π με ακρίβεια 14 δεκαδικών.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157809				0	el	Σύνταξη				20200411 15:09:53
