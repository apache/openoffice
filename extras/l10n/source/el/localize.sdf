helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5081637				0	el	Το ίδιο αποτέλεσμα επιτυγχάνεται με τον τελεστή ^:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9759514				0	el	\<item type=\"literal\"\>Βάση^Εκθέτης\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3159580				0	el	Παράδειγμα				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159594				0	el	Το \<item type=\"input\"\>=POWER(4;3)\</item\> επιστρέφει 64, το οποίο είναι το 4 υψωμένο στη δύναμη του 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1614429				0	el	Το =4^3 επίσης επιστρέφει το 4 υψωμένο στη δύναμη του 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152651				0	el	\<bookmark_value\>συνάρτηση SERIESSUM\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152651				0	el	SERIESSUM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152688				0	el	\<ahelp hid=\".\"\>Αθροίζει τους πρώτους όρους μιας σειράς δυνάμεων.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152708				0	el	SERIESSUM(x;n;m;coefficients) = coefficient_1*x^n + coefficient_2*x^(n+m) + coefficient_3*x^(n+2m) +...+ coefficient_i*x^(n+(i-1)m)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152724				0	el	Σύνταξη				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_idN11BD9				0	el	SERIESSUM(X, N, M, συντελεστές)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152737				0	el	\<emph\>X\</emph\> είναι η τιμή που εισάγεται για τη δυναμοσειρά.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144344				0	el	\<emph\>N\</emph\> είναι η αρχική δύναμη.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144357				0	el	\<emph\>M\</emph\> είναι το βήμα αύξησης του N				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144370				0	el	\<emph\>Συντελεστές\</emph\> είνια μια σειρά συντελεστών. Για κάθε συντελεστή το άθροισμα της σειράς αυξάνεται κατά ένα τμήμα.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144386				0	el	\<bookmark_value\>συνάρτηση PRODUCT\</bookmark_value\>\<bookmark_value\>αριθμοί, πολλαπλασιασμός\</bookmark_value\>\<bookmark_value\>πολλαπλασιασμός, αριθμοί\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144386				0	el	PRODUCT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144414				0	el	\<ahelp hid=\"HID_FUNC_PRODUKT\"\>Πολλαπλασιάζει όλους τους αριθμούς που δίνονται ως ορίσματα και επιστρέφει το γινόμενο.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144433				0	el	Σύνταξη				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144446				0	el	PRODUCT(Αριθμός1; Αριθμός2; ...; Αριθμός30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144460				0	el	\<emph\>Αριθμός1 ως 30\</emph\> είναι μέχρι 30 ορίσματα των οποίων το γινόμενο θα υπολογιστεί.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1589098				0	el	Η PRODUCT επιστρέφει το number1 * number2 * number3 * ...				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144480				0	el	Παράδειγμα				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144494				0	el	Η συνάρτηση \<item type=\"input\"\>=PRODUCT(2;3;4)\</item\> επιστρέφει ως αποτέλεσμα 24.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3160340				0	el	\<bookmark_value\>συνάρτηση SUMSQ\</bookmark_value\>\<bookmark_value\>προσθέσεις τετραγώνων\</bookmark_value\>\<bookmark_value\>αθροίσματα, τετραγώνων\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160340				0	el	SUMSQ				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160368				0	el	\<ahelp hid=\"HID_FUNC_QUADRATESUMME\"\>Αν θέλετε να υπολογίσετε το άθροισμα των τετραγώνων των αριθμών (σύνολο των τετραγώνων των ορισμάτων), εισάγετέ τα στα πεδία κειμένου.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160388				0	el	Σύνταξη				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160402				0	el	SUMSQ(Αριθμός1; Αριθμός2; ...; Αριθμός30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160415				0	el	\<emph\>Αριθμός1 ως 30\</emph\> είναι μέχρι 30 ορίσματα των οποίων το άθροισμα των τετραγώνων θα υπολογιστεί.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160436				0	el	Παράδειγμα				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160449				0	el	Αν εισάγετε τους αριθμούς \<item type=\"input\"\>2\</item\>; \<item type=\"input\"\>3\</item\> και \<item type=\"input\"\>4\</item\> στα πεδία κειμένου Αριθμός1, 2 και 3, θα επιστραφεί το αποτέλεσμα 29.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3158247				0	el	\<bookmark_value\>συνάρτηση MOD\</bookmark_value\>\<bookmark_value\>υπόλοιπα διαιρέσεων\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158247				0	el	MOD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158276				0	el	\<ahelp hid=\"HID_FUNC_REST\"\>Επιστρέφει το υπόλοιπο όταν ένας ακέραιος διαιρείται από άλλον.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158294				0	el	Σύνταξη				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158308				0	el	MOD(Διαιρετέος; Διαιρέτης)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158321				0	el	Για ακέραια ορίσματα αυτή η συνάρτηση επιστρέφει τον Διαιρετέτο modulo Διαιρέτη, δηλαδή το υπόλοιπο όταν ο \<emph\>Διαιρετεός\</emph\> διαρείται από τον \<emph\>Διαιρέτη\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158341				0	el	Αυτη η συνάρτηση υπολογίζεται ως \<item type=\"literal\"\>Διαιρετέος - Διαιρέτης * INT(Διαιρετέος/Διαιρέτης)\</item\>, και αυτός ο τύπος δίνει το αποτέλεσμα αν τα ορίσματα δεν είναι ακέραιοι.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158361				0	el	Παράδειγμα				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158374				0	el	Το \<item type=\"input\"\>=MOD(22;3)\</item\> επιστρέφει 1, το υπόλοιπο όταν το 22 διαιρείται με το 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1278420				0	el	Η συνάρτηση \<item type=\"input\"\>=MOD(11.25;2.5)\</item\> επιστρέφει ως αποτέλεσμα 1.25.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144592				0	el	\<bookmark_value\>συνάρτηση QUOTIENT\</bookmark_value\>\<bookmark_value\>διαιρέσεις\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144592				0	el	QUOTIENT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144627				0	el	\<ahelp hid=\"HID_AAI_FUNC_QUOTIENT\"\>Επιστρέφει το ακέραιο μέρος μιας διαίρεσης.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144646				0	el	Σύνταξη				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144659				0	el	QUOTIENT(Αριθμητής; Παρονομαστής)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9038972				0	el	Επιστρέφει το ακέραιο μέρος του \<emph\>Αριθμητή\</emph\> διαιρούμενου δια του \<emph\>Παρονομαστή\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7985168				0	el	Η QUOTIENT είνια ισοδύναμη με το \<item type=\"literal\"\>INT(αριθμητής/παρονομαστής)\</item\>, εκτός του ότι μπορεί να αναφέρει τα λάθη με διαφορετικούς κωδικούς λαθών.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144674				0	el	Παράδειγμα				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144687				0	el	Το \<item type=\"input\"\>=QUOTIENT(11;3)\</item\> επιστρέφει 3. Το υπόλοιπο 2 χάνεται.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144702				0	el	\<bookmark_value\>συνάρτηση RADIANS\</bookmark_value\>\<bookmark_value\>μετατροπή, μοίρες, σε ακτίνια\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144702				0	el	RADIANS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158025				0	el	\<ahelp hid=\"HID_FUNC_RAD\"\>Μετατρέπει μοίρες σε ακτίνια.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158042				0	el	Σύνταξη				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158055				0	el	RADIANS(Αριθμός)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158069				0	el	\<emph\>Αριθμός\</emph\> είναι η γωνία σε μοίρες που θα μετατραπεί σε ακτίνια.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id876186				0	el	Παράδειγμα				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3939634				0	el	Το \<item type=\"input\"\>=RADIANS(90)\</item\> επιστρέφει 1.5707963267949, το οποίο είναι το π/2 με την ακρίβεια του Calc.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3158121				0	el	\<bookmark_value\>συνάρτηση ROUND\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158121				0	el	ROUND				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158150				0	el	\<ahelp hid=\"HID_FUNC_RUNDEN\"\>Στρογγυλοποιεί έναν αριθμό σε συγκεκριμένο αριθμό δεκαδικών ψηφίων.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158169				0	el	Σύνταξη				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158182				0	el	ROUND(Αριθμός; Πλήθος)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158196				0	el	Επιστρέφει τον \<emph\>Αριθμό\</emph\> στρογγυλοποιημένο σε \<emph\>Πλήθος\</emph\> δεκαδικών. Αν το Πλήθος παραλειφθεί, ή ορισθεί 0, η συνάρτηση στρογγυλοποιεί στον πλησιέστερο ακέραιο. Αν το Πλήθος είναι αρνητικό, η συνάρτηση στρογγυλοποιεί στην πλησιέστερη 10άδα, 100άδα, 1000άδα κ.ο.κ.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id599688				0	el	Αυτή η συνάρτηση στρογγυλοποιεί στον πλησιέστερο αριθμό. Δείτε τις ROUNDDOWN και ROUNDUP για εναλλακτικές λύσεις.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145863				0	el	Παράδειγμα				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145876				0	el	Η συνάρτηση \<item type=\"input\"\>=ROUND(2.348;2)\</item\> επιστρέφει ως αποτέλεσμα 2.35				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145899				0	el	\<item type=\"input\"\>=ROUND(-32.4834;3)\</item\> επιστρέφει -32.483. Αλλάξτε τη μορφή των κελιών για να δείτε όλα τα δεκαδικά.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1371501				0	el	Η συνάρτηση \<item type=\"input\"\>=ROUND(2.348;0)\</item\> επιστρέφει ως αποτέλεσμα 2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id4661702				0	el	Η συνάρτηση \<item type=\"input\"\>=ROUND(2.5)\</item\> επιστρέφει ως αποτέλεσμα 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7868892				0	el	Η συνάρτηση \<item type=\"input\"\>=ROUND(987.65;-2)\</item\> επιστρέφει ως αποτέλεσμα 1000.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3145991				0	el	\<bookmark_value\>συνάρτηση ROUNDDOWN\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145991				0	el	ROUNDDOWN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146020				0	el	\<ahelp hid=\"HID_FUNC_ABRUNDEN\"\>Στρογγυλοποιεί έναν αριθμό προς τα κάτω, προς το μηδέν, σε συγκεκριμένη ακρίβεια.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146037				0	el	Σύνταξη				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146051				0	el	ROUNDDOWN(Αριθμός; Πλήθος)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146064				0	el	Επιστρέφει τον \<emph\>Αριθμό\</emph\> στρογγυλοποιημένο προς τα κάτω (προς το μηδέν) σε \<emph\>Πλήθος\</emph\> δεκαδικών. Αν το Πλήθος παραλειφθεί, ή ορισθεί 0, η συνάρτηση στρογγυλοποιεί σε ακέραιο. Αν το Πλήθος είναι αρνητικό, η συνάρτηση στρογγυλοποιεί στην επόμενη 10άδα, 100άδα, 1000άδα κ.ο.κ.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2188787				0	el	Αυτή η συνάρτηση στρογγυλοποιεί προς το μηδέν. Δείτε τις ROUNDUP και ROUND για εναλλακτικές λύσεις.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163164				0	el	Παράδειγμα				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163178				0	el	Η συνάρτηση \<item type=\"input\"\>=ROUNDDOWN(1.234;2)\</item\> επιστρέφει ως αποτέλεσμα 1.23.				20200411 15:09:53
