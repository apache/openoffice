helpcontent2	source\text\shared\00\00040501.xhp	0	help	par_id3153042				0	el	\<variable id=\"alszeichen\"\>Επιλέξτε \<emph\>Μορφή - Αγκύρωση - Ως χαρακτήρας\</emph\>\</variable\>				20200411 15:09:53
