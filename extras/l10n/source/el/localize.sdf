helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id5781731				0	el	^ σημαίνει ότι το ταίριασμα πρέπει να είναι στη αρχή της παραγράφου,				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id6942045				0	el	[:digit:] ταιριάζει οποιοδήποτε δεκαδικό ψηφίο,				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id4721823				0	el	{3} εννοεί ότι πρέπει να υπάρχουν ακριβώς 3 αντίγραφα του "ψηφίο",				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id5806756				0	el	$ σημαίνει ότι το ταίριασμα πρέπει να τελειώνει σε παράγραφο.				20200411 15:09:53
