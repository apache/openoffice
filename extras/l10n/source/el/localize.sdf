helpcontent2	source\text\shared\guide\change_title.xhp	0	help	tit				0	el	Αλλαγή του τίτλου ενός εγγράφου				20200411 15:09:53
helpcontent2	source\text\shared\guide\change_title.xhp	0	help	bm_id3156324				0	el	\<bookmark_value\>τίτλοι; αλλαγή\</bookmark_value\>\<bookmark_value\>αλλαγή;τίτλοι εγγράφων\</bookmark_value\>\<bookmark_value\>έγγραφα; αλλαγή τίτλων\</bookmark_value\>				20200411 15:09:53
