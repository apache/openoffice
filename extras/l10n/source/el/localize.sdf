helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id1596728				0	el	\<bookmark_value\>συνάρτηση LOGEST\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3146009				0	el	LOGEST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3146037				0	el	\<ahelp hid=\"HID_FUNC_RKP\"\>Αυτή η συνάρτηση υπολογίζει την προσαρμογή των εισηγμένων δεδομένων στην εκθετική καμπύλη παλινδρόμησης (y=b*m^x).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3146056				0	el	Σύνταξη				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163123				0	el	LOGEST(ΔεδομέναY, ΔεδομέναX, Τύπος-συνάρτησης, Στατιστικά)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163137				0	el	\<emph\>ΔεδομέναY\</emph\> αντιπροσωπεύει τον πίνακα των Υ δεδομένων.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163155				0	el	\<emph\>ΔεδομέναΧ\</emph\> (προαιρετικό) αντιπροσωπεύει τον πίνακα των Χ δεδομένων.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163174				0	el	\<emph\>Τύπος-συνάρτησης\</emph\> (προαιρετικό). Αν Τύπος-συνάρτησης = 0, θα υπολογιστούν οι συναρτήσεις με τη μορφή  y = m^x. Ειδάλλως,, θα υπολογιστούν οι συναρτήσεις y = b*m^x.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163196				0	el	\<emph\>Στατιστικά\</emph\> (προαιρετικά). Αν το Στατιστικά=0, υπολογίζεται μόνο ο συντελεστής παλινδρόμησης.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN118F7				0	el	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				20200411 15:09:53
