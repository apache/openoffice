helpcontent2	source\text\swriter\main0106.xhp	0	help	tit				0	el	Εργαλεία				20200411 15:09:53
helpcontent2	source\text\swriter\main0106.xhp	0	help	hd_id3147241				0	el	\<link href=\"text/swriter/main0106.xhp\" name=\"Εργαλεία\"\>Εργαλεία\</link\>				20200411 15:09:53
helpcontent2	source\text\swriter\main0106.xhp	0	help	par_id3147258				0	el	\<ahelp hid=\".\"\>Περιέχει εργαλεία ορθογραφίας, μια συλλογή αντικειμένων γραφικών που μπορείτε να προσθέσετε στο έγγραφό σας, καθώς και εργαλεία προσαρμογής των μενού και ρυθμίσεις προτιμήσεων της εφαρμογής.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\main0106.xhp	0	help	hd_id3149965				0	el	\<link href=\"text/swriter/01/06060000.xhp\" name=\"Αρίθμηση κεφαλαίων\"\>Αρίθμηση κεφαλαίων\</link\>				20200411 15:09:53
