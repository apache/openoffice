helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149758				0	el	2001-08-10				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3147495				0	el	1000				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3152793				0	el	=XIRR(B1:B5; A1:A5; 0.1) επιστρέφει 0.1828.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3149198				0	el	\<bookmark_value\>συνάρτηση XNPV\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3149198				0	el	XNPV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153904				0	el	\<ahelp hid=\"HID_AAI_FUNC_XNPV\"\>Υπολογίζει την αξία κεφαλαίου (καθαρή παρούσα αξία) για μια λίστα πληρωμών που πραγματοποιούνται σε διαφορετικές ημερομηνίες.\</ahelp\> Η βάση υπολογισμού είναι 365 μέρες το χρόνο αγνοώντας τα δίσεκτα έτη.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_idN11138				0	el	Αν οι πληρωμές πραγματοποιούνται σε τακτά χρονικά διαστήματα, χρησιμοποιείστε τη συνάρτηση NPV.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3155323				0	el	Σύνταξη				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150117				0	el	XNPV(Επιτόκιο; Τιμές; Ημερομηνίες)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153100				0	el	\<emph\>Επιτόκιο\</emph\>: ο εσωτερικός συντελεστής απόδοσης για τις πληρωμές.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155395				0	el	\<emph\>Τιμές\</emph\> και \<emph\>Ημερομηνίες\</emph\>: μια σειρά πληρωμών και η σειρά των αντίστοιχων τιμών των ημερομηνιών. Το πρώτο ζεύγος ημερομηνιών καθορίζει την έναρξη του σχεδίου πληρωμής. Όλες οι άλλες τιμές ημερομηνιών πρέπει να είναι αργότερα, αλλά δεν χρειάζεται να βρίσκονται σε σειρά. Η σειρά των τιμών πρέπει να περιέχει τουλάχιστον μία αρνητική και μία θετική τιμή (αναλήψεις και καταθέσεις)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3148832				0	el	Παράδειγμα				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150525				0	el	Υπολογισμός της καθαρής παρούσας αξίας για τις προαναφερθείσες πέντε πληρωμές για ένα ενδεικτικό εσωτερικό συντελεστή απόδοσης της τάξεως του 6%.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149910				0	el	Το \<item type=\"input\"\>=XNPV(0.06;B1:B5;A1:A5)\</item\> επιστρέφει 323.02.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3148822				0	el	\<bookmark_value\>υπολογισμοί, επιτόκια\</bookmark_value\>\<bookmark_value\>συνάρτηση RRI\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3148822				0	el	RRI				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154293				0	el	\<ahelp hid=\"HID_FUNC_ZGZ\"\>Υπολογίζει το επιτόκιο που προκύπτει από το κέρδος (απόδοση) μιας επένδυσης.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3148444				0	el	Σύνταξη				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148804				0	el	RRI(P;PV;FV)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154901				0	el	\<emph\>P\</emph\> είναι ο αριθμός των περιόδων που χρειάζονται για τον υπολογισμό του επιτοκίου.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3159149				0	el	Το \<emph\>PV\</emph\> είναι η τρέχουσα αξία. Η χρηματική αξία είναι η προκαταβολή μετρητών ή τρέχουσα ταμιακή αξία ενός ποσού σε είδος. Ως αξία προκαταβολής πρέπει να εισαχθεί θετική τιμή. Η προκαταβολή δεν μπορεί να είναι 0 ή <0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149771				0	el	\<emph\>FV\</emph\> καθορίζει τι είναι επιθυμητό ως αξία της κατάθεσης.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3148941				0	el	Παράδειγμα				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154212				0	el	Για τέσσερις περιόδους (έτη) και για τρέχουσα αξία 7.500 νομισματικών μονάδων, πρόκειται να υπολογισθεί το επιτόκιο της απόδοσης αν η μελλοντική αξία είναι 10.000 νομισματικές μονάδες.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150775	246			0	el	\<item type=\"input\"\>=RRI(4;7500;10000)\</item\> = 7.46 %				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145413	247			0	el	Το επιτόκιο πρέπει να είναι 7,46 % έτσι ώστε οι 7.500 νομισματικές μονάδες να γίνουν 10.000 νομισματικές μονάδες.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3154267				0	el	\<bookmark_value\>υπολογισμός, σταθερά επιτόκια\</bookmark_value\>\<bookmark_value\>σταθερά επιτόκια\</bookmark_value\>\<bookmark_value\>συνάρτηση RATE\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3154267				0	el	RATE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3151052				0	el	\<ahelp hid=\"HID_FUNC_ZINS\"\>Επιστρέφει το σταθερό επιτόκιο ανά περίοδο μιας προσόδου.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3154272				0	el	Σύνταξη				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3158423				0	el	RATE(NPer; Pmt; PV; FV; Τύπος; Εκτίμηση)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148910				0	el	\<emph\>NPer\</emph\> είναι ο συνολικός αριθμός των περιόδων κατά τις οποίες καταβάλλονται πληρωμές (περίοδος πληρωμής).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148925				0	el	\<emph\>Pmt\</emph\> είναι η σταθερή πληρωμή (πρόσοδος) που καταβάλλεται σε κάθε περίοδο.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149160				0	el	\<emph\>PV\</emph\> είναι η παρούσα τρέχουσα αξία σε μια σειρά πληρωμών.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3166456				0	el	\<emph\>FV\</emph\> (προαιρετικό) είναι η μελλοντική αξία, η οποία επιτυγχάνεται στο τέλος των περιοδικών πληρωμών.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153243				0	el	\<emph\>Τύπος\</emph\> (προαιρετικό) είναι η ημερομηνία λήξης της περιοδικής πληρωμής, είτε στην αρχή είτε στο τέλος της περιόδου.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3146949				0	el	\<emph\>Εκτίμηση\</emph\> (προαιρετικό) καθορίζει την εκτιμώμενη αξία του τόκου με διαδοχικούς υπολογισμούς.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_idN10E2A				0	el	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3149791				0	el	Παράδειγμα				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150706				0	el	Ποιο είναι το σταθερό επιτόκιο για περίοδο πληρωμής 3 περιόδων αν καταβάλλονται τακτικά 10 νομισματικές μονάδες και η παρούσα αξία είναι 900 νομισματικές μονάδες.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155586				0	el	\<item type=\"input\"\>=RATE(3;10;900)\</item\> = -121% Το επιτόκιο είναι λοιπόν 121%.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3149106				0	el	\<bookmark_value\>συνάρτηση INTRATE\</bookmark_value\>				20200411 15:09:53
