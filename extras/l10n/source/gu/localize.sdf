helpcontent2	source\text\smath\01\05030000.xhp	0	help	hd_id3149819				0	gu	કિનારીઓ				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05030000.xhp	0	help	par_id3149102				0	gu	Adds a border to your formula. This option is particularly useful if you want to integrate the formula into a text file in $[officename] Writer. When making settings, be sure that you do not use 0 as a size, since this creates viewing problems for text that surrounds the insertion point.				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05030000.xhp	0	help	par_id3149797				0	gu	\<ahelp hid=\"HID_SMA_LEFTBORDER_DIST\"\>The left border is positioned between the formula and background.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05030000.xhp	0	help	par_id3154898				0	gu	\<ahelp hid=\"HID_SMA_RIGHTBORDER_DIST\"\>The right border is positioned between the formula and background.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05030000.xhp	0	help	hd_id3147218				0	gu	ઉપર				2002-02-02 02:02:02
