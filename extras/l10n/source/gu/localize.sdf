helpcontent2	source\text\shared\01\06010601.xhp	0	help	par_idN1058C				0	gu	Property				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06010601.xhp	0	help	par_idN10590				0	gu	\<ahelp hid=\".\"\>Defines the class of the selected term.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06010601.xhp	0	help	par_idN10597				0	gu	\<ahelp hid=\".\"\>Adds the term to the translation dictionary. If the term is already in the dictionary, the new term receives precedence.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06010601.xhp	0	help	par_idN1059E				0	gu	\<ahelp hid=\".\"\>Saves the modified entry to the database file.\</ahelp\>				2002-02-02 02:02:02
