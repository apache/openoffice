helpcontent2	source\text\scalc\01\func_day.xhp	0	help	hd_id3147317				0	gu	\<variable id=\"day\"\>\<link href=\"text/scalc/01/func_day.xhp\"\>DAY\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3147584				0	gu	\<ahelp hid=\"HID_FUNC_TAG\"\>Returns the day of given date value.\</ahelp\> The day is returned as an integer between 1 and 31. You can also enter a negative date/time value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3149430				0	gu	DAY(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3149443				0	gu	\<emph\>Number\</emph\>, as a time value, is a decimal, for which the day is to be returned.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	hd_id3163809	111			0	gu	Examples 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3151200				0	gu	DAY(1) returns 31 (since $[officename] starts counting at zero from December 30, 1899)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3154130				0	gu	DAY(NOW()) returns the current day.				2002-02-02 02:02:02
