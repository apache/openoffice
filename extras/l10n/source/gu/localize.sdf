helpcontent2	source\text\sbasic\shared\03030205.xhp	0	help	par_id3156286				0	gu	dDate = TimeSerial(8,30,15)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03030205.xhp	0	help	par_id3148456				0	gu	sDate = TimeSerial(8,30,15)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03030205.xhp	0	help	par_id3155600				0	gu	MsgBox dDate,64,"Time as a number"				2002-02-02 02:02:02
