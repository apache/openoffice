helpcontent2	source\text\swriter\01\06090000.xhp	0	help	par_id3145829				0	gu	\<variable id=\"texttab\"\>\<ahelp hid=\".uno:ConvertTableText\"\>Converts the selected text into a table, or the selected table into text.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06090000.xhp	0	help	par_id3150015				0	gu	The options available in this dialog depending on the type of conversion.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06090000.xhp	0	help	par_id3148388				0	gu	A separator, such as a tab, marks the column boundaries in the selected text. Each paragraph in the selection is converted into a row in the table. Similarly, when you convert a table into text, the column markers are changed to the character that you specify, and each row is converted into a separate paragraph.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06090000.xhp	0	help	par_id3149027				0	gu	\<ahelp hid=\"SW:RADIOBUTTON:DLG_CONV_TEXT_TABLE:CB_TAB\"\>Converts the text to a table using tabs as column markers.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06090000.xhp	0	help	hd_id3147171				0	gu	Semicolons				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06090000.xhp	0	help	par_id3147565				0	gu	\<ahelp hid=\"SW:RADIOBUTTON:DLG_CONV_TEXT_TABLE:CB_SEMI\"\>Converts the text to a table using semi-colons (;) as column markers.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06090000.xhp	0	help	par_id3154645				0	gu	\<ahelp hid=\"SW:RADIOBUTTON:DLG_CONV_TEXT_TABLE:CB_PARA\"\>Converts the text to a table using paragraphs as column markers.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06090000.xhp	0	help	hd_id3151184				0	gu	Other:				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06090000.xhp	0	help	par_id3150256				0	gu	\<ahelp hid=\"SW:RADIOBUTTON:DLG_CONV_TEXT_TABLE:RB_OTHER\"\>Converts the text to a table using the character that you type in the box as a column marker.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06090000.xhp	0	help	hd_id3149295				0	gu	Text box				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06090000.xhp	0	help	par_id3151175				0	gu	\<ahelp hid=\"SW:EDIT:DLG_CONV_TEXT_TABLE:ED_OTHER\"\>Type the character that you want to use as a column marker.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06090000.xhp	0	help	par_id3154278				0	gu	\<ahelp hid=\"SW:CHECKBOX:DLG_CONV_TEXT_TABLE:CB_KEEPCOLUMN\"\>Creates columns of equal width, regardless of the position of the column marker.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06090000.xhp	0	help	hd_id3154097				0	gu	Option				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06090000.xhp	0	help	par_id3153535				0	gu	\<ahelp hid=\"SW:CHECKBOX:DLG_CONV_TEXT_TABLE:CB_HEADER\"\>Formats the first row of the new table as a heading.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06090000.xhp	0	help	par_id3150973				0	gu	\<ahelp hid=\"SW:CHECKBOX:DLG_CONV_TEXT_TABLE:CB_REPEAT_HEADER\"\>Repeats the table header on each page that the table spans.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06090000.xhp	0	help	par_id3147530				0	gu	\<ahelp hid=\"SW:CHECKBOX:DLG_CONV_TEXT_TABLE:CB_DONT_SPLIT\"\>Does not divide the table across pages.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06090000.xhp	0	help	par_id3154570				0	gu	\<ahelp hid=\"SW:CHECKBOX:DLG_CONV_TEXT_TABLE:CB_BORDER\"\>Adds a border to the table and the table cells.\</ahelp\>				2002-02-02 02:02:02
