helpcontent2	source\text\swriter\01\05030400.xhp	0	help	bm_id7635731				0	gu	\<bookmark_value\>first letters as large capital letters\</bookmark_value\>\<bookmark_value\>capital letters;starting paragraphs\</bookmark_value\>\<bookmark_value\>drop caps insertion\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	hd_id3150252				0	gu	\<link href=\"text/swriter/01/05030400.xhp\" name=\"Drop Caps\"\>Drop Caps\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	hd_id3147295				0	gu	Show Drop Caps				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	par_id3150536				0	gu	\<ahelp hid=\"SW_CHECKBOX_TP_DROPCAPS_CB_SWITCH\"\>Applies the drop cap settings to the selected paragraph.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	hd_id3155626				0	gu	Whole word				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	par_id3154554				0	gu	\<ahelp hid=\"SW_CHECKBOX_TP_DROPCAPS_CB_WORD\"\>Displays the first letter of the first word in the paragraph as a drop cap, and the remaining letters of the word as large type.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	hd_id3154505				0	gu	Number of characters				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	par_id3149881	8			0	gu	\<ahelp hid=\"SW_NUMERICFIELD_TP_DROPCAPS_FLD_DROPCAPS\"\>Enter the number of characters to convert to drop caps. \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	hd_id3150932				0	gu	Lines				2002-02-02 02:02:02
