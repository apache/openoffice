helpcontent2	source\text\shared\explorer\database\dabawiz02text.xhp	0	help	par_idN1061A				0	gu	\<ahelp hid=\".\"\>Click to access txt files.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\dabawiz02text.xhp	0	help	par_idN10643				0	gu	'Comma separated value' files (*.csv)				2002-02-02 02:02:02
