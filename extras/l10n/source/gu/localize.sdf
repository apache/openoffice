helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	bm_id3151254				0	gu	\<bookmark_value\>NETWORKDAYS function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	hd_id3151254				0	gu	\<variable id=\"networkdays\"\>\<link href=\"text/scalc/01/func_networkdays.xhp\"\>NETWORKDAYS\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	par_id3153788				0	gu	\<ahelp hid=\"HID_AAI_FUNC_NETWORKDAYS\"\>Returns the number of workdays between \<emph\>Start date\</emph\> and \<emph\>End date\</emph\>. Holidays can be deducted.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	par_id3145775				0	gu	NETWORKDAYS (Start date;End date;Holidays)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	par_id3153885				0	gu	\<emph\>End date\</emph\>: the date up until when the calculation is carried out. If the end date is a workday, the day is included in the calculation.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	par_id3151110				0	gu	\<emph\>End date\</emph\>: the date up until when the calculation is carried out. If the end date is a workday, the day is included in the calculation.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	par_id3154115				0	gu	\<emph\>Holidays\</emph\>: optional list of holidays. These are non-working days. Enter a cell range in which the holidays are listed individually.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	hd_id3146902				0	gu	Examples 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	par_id3154661				0	gu	How many workdays fall between 12/15/2001 and 1/15/2002? The start date is located in C3 and the end date in D3. Cells F3 to J3 contain the following Christmas and New Year holidays: "12/24/2001", "12/25/2001", "12/26/2001", "12/31/2001", "1/1/2002".				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	par_id3147328				0	gu	=NETWORKDAYS(C3;D3;F3:J3) returns 17 workdays.				2002-02-02 02:02:02
