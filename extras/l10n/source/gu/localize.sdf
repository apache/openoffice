helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3155071				0	gu	\<bookmark_value\>EXPONDIST function\</bookmark_value\>\<bookmark_value\>exponential distributions\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3155071				0	gu	RANK				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153976				0	gu	\<ahelp hid=\"HID_FUNC_RANG\"\>Returns the rank of a number in a sample.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153250				0	gu	RANK(Value; Data; Type)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154543	6			0	gu	\<emph\>Value\</emph\> is the value, whose rank is to be determined.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149130	7			0	gu	\<emph\>Data\</emph\> is the array of data in the sample.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150215	8			0	gu	\<emph\>Type\</emph\> (optional) is the sequence order.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id9305398				0	gu	Type = 0 means descending from the last item of the array to the first (this is the default), 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id9996948				0	gu	Type = 1 means ascending from the first item of the range to the last.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3143223				0	gu	Examples 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3155919	10			0	gu	=RANK(A10; A1:A50) returns the ranking of the value in A10 in value range A1:A50. If \<emph\>Value\</emph\> does not exist within the range an error message is displayed.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3153556				0	gu	\<bookmark_value\>SKEW function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3153556				0	gu	SKEW				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153485				0	gu	\<ahelp hid=\"HID_FUNC_SCHIEFE\"\>Returns the skewness of a distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3151191				0	gu	SKEW(Number 1; number 2; ...number 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3155757	16			0	gu	\<emph\>Number 1, number 2...number 30\</emph\> are numerical values or ranges.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3153297				0	gu	Examples 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3149051				0	gu	FORECAST				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153290				0	gu	\<ahelp hid=\"HID_FUNC_SCHAETZER\"\>Extrapolates future values based on existing x and y values.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3147404				0	gu	FORECAST(Value; data_Y; data_X)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3148743	24			0	gu	\<emph\>Value\</emph\> is the x value, for which the y value on the linear regression is to be returned.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3146325	25			0	gu	\<emph\>Data_Y\</emph\> is the array or range of known y's.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150536	26			0	gu	\<emph\>Data_X\</emph\> is the array or range of known x's.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3147416				0	gu	Examples 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3157874	28			0	gu	=FORECAST(50; A1:A50; B1;B50) returns the Y value expected for the X value of 50 if the X and Y values in both references are linked by a linear trend.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3149143				0	gu	\<bookmark_value\>EXPONDIST function\</bookmark_value\>\<bookmark_value\>exponential distributions\</bookmark_value\>				2002-02-02 02:02:02
