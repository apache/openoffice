helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	par_id3149516				0	gu	\<variable id=\"anlinie\"\>\<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_GRID_CBX_SNAP_HELPLINES\"\>Snaps the edge of a dragged object to the nearest snap line when you release the mouse.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	hd_id3154306				0	gu	To the page margins				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	par_id3156024				0	gu	\<variable id=\"seitenrand\"\>\<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_GRID_CBX_SNAP_BORDER\"\>Specifies whether to align the contour of the graphic object to the nearest page margin.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	hd_id3154365				0	gu	To object frame				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	par_id3148674				0	gu	\<variable id=\"rahmen\"\>\<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_GRID_CBX_SNAP_FRAME\"\>Specifies whether to align the contour of the graphic object to the border of the nearest graphic object.\</ahelp\>\</variable\>				2002-02-02 02:02:02
