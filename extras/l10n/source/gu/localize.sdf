helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3144764				0	gu	d1 = InputBox$ (""Enter the length of the adjacent side: ","Adjacent")				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3154491				0	gu	dAngle = InputBox$ ("Enter the angle Alpha (in degrees): ","Alpha")				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3151074				0	gu	Print "The length of the hypothenuse is"; (d1 / cos (dAngle * Pi / 180))				2002-02-02 02:02:02
