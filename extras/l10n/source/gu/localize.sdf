helpcontent2	source\text\shared\02\07080000.xhp	0	help	par_id3149495				0	gu	\<ahelp hid=\".uno:Stop\"\>Click to interrupt the current loading process, Ctrl-click to interrupt all loading processes.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\callouts.xhp	0	help	par_idN1055A				0	gu	\<link href=\"text/shared/02/callouts.xhp\"\>Callouts\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\callouts.xhp	0	help	par_idN1056A				0	gu	\<ahelp hid=\".\"\>Opens the Callouts toolbar from which you can insert graphics into your document.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\callouts.xhp	0	help	par_idN10597				0	gu	Some shapes have a handle which you can drag to change the properties of the shape. The mouse pointer changes to a hand symbol over these special handles.				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12020000.xhp	0	help	hd_id3154689				0	gu	\<link href=\"text/shared/02/12020000.xhp\" name=\"Sort Descending\"\>Sort Descending\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12020000.xhp	0	help	par_id3149987	2			0	gu	\<ahelp hid=\".uno:SortDown\" visibility=\"hidden\"\>Sorts the data of the selected field in descending order.\</ahelp\> Text fields are sorted alphabetically (Z-A), number fields in numerically descending order (9-0).				2002-02-02 02:02:02
