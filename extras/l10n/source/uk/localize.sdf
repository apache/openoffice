helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156316	54			0	uk	\<ahelp hid=\"HID_FUNC_ISTFEHLER\"\>Tests for error conditions, including the #N/A error value, and returns TRUE or FALSE.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3147569	55			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153155	56			0	uk	ISERROR(Value)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154047	57			0	uk	\<emph\>Value\</emph\> is or refers to the value to be tested. ISERROR() returns TRUE if there is an error and FALSE if not.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3155994	58			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150256	59			0	uk	\<item type=\"input\"\>=ISERROR(C8)\</item\> where cell C8 contains \<item type=\"input\"\>=1/0\</item\> returns TRUE, because 1/0 is an error.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id1889095				0	uk	\<item type=\"input\"\>=ISERROR(C9)\</item\> where cell C9 contains \<item type=\"input\"\>=NA()\</item\> returns TRUE.				20220827 09:49:47
