helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3152934	306			0	uk	B				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154638	307			0	uk	C				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3147083	308			0	uk	1				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3151187	309			0	uk	2001-01-01				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145212	201			0	uk	-\<item type=\"input\"\>10000\</item\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3146856	202			0	uk	\<item type=\"input\"\>Received\</item\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153277	310			0	uk	2				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154052	203			0	uk	2001-01-02				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3151297	204			0	uk	\<item type=\"input\"\>2000\</item\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149985	205			0	uk	\<item type=\"input\"\>Deposited\</item\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154744	311			0	uk	3				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153151	206			0	uk	2001-03-15				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145657	207			0	uk	2500				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155101	312			0	uk	4				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3146894	208			0	uk	2001-05-12				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3143231	209			0	uk	5000				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3156012	313			0	uk	5				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149758	210			0	uk	2001-08-10				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3147495	211			0	uk	1000				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3152793	212			0	uk	=XIRR(B1:B5; A1:A5; 0.1) returns 0.1828.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3149198				0	uk	\<bookmark_value\>XNPV function\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3149198	213			0	uk	XNPV				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153904	214			0	uk	\<ahelp hid=\"HID_AAI_FUNC_XNPV\"\>Calculates the capital value (net present value)for a list of payments which take place on different dates.\</ahelp\> The calculation is based on a 365 days per year basis, ignoring leap years.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_idN11138				0	uk	If the payments take place at regular intervals, use the NPV function.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3155323	215			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150117	216			0	uk	XNPV(Rate; Values; Dates)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153100	217			0	uk	\<emph\>Rate\</emph\> is the internal rate of return for the payments.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155395	218			0	uk	\<emph\>Values\</emph\> and \<emph\>Dates\</emph\> refer to a series of payments and the series of associated date values. The first pair of dates defines the start of the payment plan. All other date values must be later, but need not be in any order. The series of values must contain at least one negative and one positive value (receipts and deposits)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3148832	219			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150525	220			0	uk	Calculation of the net present value for the above-mentioned five payments for a notional internal rate of return of 6%.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149910	221			0	uk	\<item type=\"input\"\>=XNPV(0.06;B1:B5;A1:A5)\</item\> returns 323.02.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3148822				0	uk	\<bookmark_value\>calculating;rates of return\</bookmark_value\>\<bookmark_value\>RRI function\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3148822	237			0	uk	RRI				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154293	238			0	uk	\<ahelp hid=\"HID_FUNC_ZGZ\"\>Calculates the interest rate resulting from the profit (return) of an investment.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3148444	239			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148804	240			0	uk	RRI(P; PV; FV)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154901	241			0	uk	\<emph\>P\</emph\> is the number of periods needed for calculating the interest rate.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3159149	242			0	uk	\<emph\>PV\</emph\> is the present (current) value. The cash value is the deposit of cash or the current cash value of an allowance in kind. As a deposit value a positive value must be entered; the deposit must not be 0 or <0.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149771	243			0	uk	\<emph\>FV\</emph\> determines what is desired as the cash value of the deposit.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3148941	244			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154212	245			0	uk	For four periods (years) and a cash value of 7,500 currency units, the interest rate of the return is to be calculated if the future value is 10,000 currency units.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150775	246			0	uk	\<item type=\"input\"\>=RRI(4;7500;10000)\</item\> = 7.46 %				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145413	247			0	uk	The interest rate must be 7.46 % so that 7,500 currency units will become 10,000 currency units.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3154267				0	uk	\<bookmark_value\>calculating;constant interest rates\</bookmark_value\>\<bookmark_value\>constant interest rates\</bookmark_value\>\<bookmark_value\>RATE function\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3154267	249			0	uk	RATE				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3151052	250			0	uk	\<ahelp hid=\"HID_FUNC_ZINS\"\>Returns the constant interest rate per period of an annuity.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3154272	251			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3158423	252			0	uk	RATE(NPer; Pmt; PV; FV; Type; Guess)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148910	253			0	uk	\<emph\>NPer\</emph\> is the total number of periods, during which payments are made (payment period).				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148925	254			0	uk	\<emph\>Pmt\</emph\> is the constant payment (annuity) paid during each period.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149160	255			0	uk	\<emph\>PV\</emph\> is the cash value in the sequence of payments.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3166456	256			0	uk	\<emph\>FV\</emph\> (optional) is the future value, which is reached at the end of the periodic payments.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153243	257			0	uk	\<emph\>Type\</emph\> (optional) is the due date of the periodic payment, either at the beginning or at the end of a period.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3146949	258			0	uk	\<emph\>Guess\</emph\> (optional) determines the estimated value of the interest with iterative calculation.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_idN10E2A				0	uk	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3149791	259			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150706	260			0	uk	What is the constant interest rate for a payment period of 3 periods if 10 currency units are paid regularly and the present cash value is 900 currency units.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155586	261			0	uk	\<item type=\"input\"\>=RATE(3;10;900)\</item\> = -121% The interest rate is therefore 121%.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3149106				0	uk	\<bookmark_value\>INTRATE function\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3149106	60			0	uk	INTRATE				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149918	61			0	uk	\<ahelp hid=\"HID_AAI_FUNC_INTRATE\"\>Calculates the annual interest rate that results when a security (or other item) is purchased at an investment value and sold at a redemption value. No interest is paid.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3149974	62			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149800	63			0	uk	INTRATE(Settlement; Maturity; Investment; Redemption; Basis)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148618	64			0	uk	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148988	65			0	uk	\<emph\>Maturity\</emph\> is the date on which the security is sold.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154604	66			0	uk	\<emph\>Investment\</emph\> is the purchase price.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154337	67			0	uk	\<emph\>Redemption\</emph\> is the selling price.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3145380	68			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149426	69			0	uk	A painting is bought on 1990-01-15 for 1 million and sold on 2002-05-05 for 2 million. The basis is daily balance calculation (basis = 3). What is the average annual level of interest?				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3151125	70			0	uk	=INTRATE("1990-01-15"; "2002-05-05"; 1000000; 2000000; 3) returns 8.12%.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3148654				0	uk	\<bookmark_value\>COUPNCD function\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3148654	163			0	uk	COUPNCD				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149927	164			0	uk	\<ahelp hid=\"HID_AAI_FUNC_COUPNCD\"\>Returns the date of the first interest date after the settlement date. Format the result as a date.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3153317	165			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150423	166			0	uk	COUPNCD(Settlement; Maturity; Frequency; Basis)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150628	167			0	uk	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153536	168			0	uk	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145313	169			0	uk	\<emph\>Frequency\</emph\> is number of interest payments per year (1, 2 or 4).				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3155424	170			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154794	171			0	uk	A security is purchased on 2001-01-25; the date of maturity is 2001-11-15. Interest is paid half-yearly (frequency is 2). Using daily balance interest calculation (basis 3) when is the next interest date?				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3159251	172			0	uk	=COUPNCD("2001-01-25"; "2001-11-15"; 2; 3) returns 2001-05-15.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3143281				0	uk	\<bookmark_value\>COUPDAYS function\</bookmark_value\>				20220827 09:49:47
