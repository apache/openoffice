helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156139	252			0	uk	            \<emph\>Number\</emph\> is the number that is to be converted into a Roman numeral.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153318	253			0	uk	            \<emph\>Mode\</emph\> (optional) indicates the degree of simplification. The higher the value, the greater is the simplification of the Roman number.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3145306	254			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151371	255			0	uk	            \<item type=\"input\"\>=ROMAN(999)\</item\> returns CMXCIX				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153938	256			0	uk	            \<item type=\"input\"\>=ROMAN(999;0)\</item\> returns CMXCIX				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148412	257			0	uk	            \<item type=\"input\"\>=ROMAN (999;1)\</item\> returns LMVLIV				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155421	258			0	uk	            \<item type=\"input\"\>=ROMAN(999;2)\</item\> returns XMIX				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149235	259			0	uk	            \<item type=\"input\"\>=ROMAN(999;3)\</item\> returns VMIV				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150624	260			0	uk	            \<item type=\"input\"\>=ROMAN(999;4)\</item\> returns IM				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3151005				0	uk	\<bookmark_value\>SEARCH function\</bookmark_value\>				20220827 09:49:47
