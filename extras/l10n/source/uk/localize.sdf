helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3154830				0	uk	\<bookmark_value\>SUBSTITUTE function\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3154830	174			0	uk	SUBSTITUTE				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153698	175			0	uk	\<ahelp hid=\"HID_FUNC_WECHSELN\"\>Substitutes new text for old text in a string.\</ahelp\>				20220827 09:49:47
