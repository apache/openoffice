helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3154558	51			0	uk	IF(Test; ThenValue; OtherwiseValue)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3149727	52			0	uk	            \<emph\>Test\</emph\> is any value or expression that can be TRUE or FALSE.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3155828	53			0	uk	            \<emph\>ThenValue\</emph\> (optional) is the value that is returned if the logical test is TRUE.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3154811	54			0	uk	            \<emph\>OtherwiseValue\</emph\> (optional) is the value that is returned if the logical test is FALSE.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_idN107FA				0	uk	            \<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>         				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	hd_id3149507	55			0	uk	Examples				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3150867	57			0	uk	            \<item type=\"input\"\>=IF(A1>5;100;"too small")\</item\> If the value in A1 is higher than 5, the value 100 is entered in the current cell; otherwise, the text “too small” (without quotes) is entered.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	bm_id3155954				0	uk	\<bookmark_value\>NOT function\</bookmark_value\>				20220827 09:49:47
