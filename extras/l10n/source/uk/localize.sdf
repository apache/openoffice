helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153621	97			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155849	98			0	uk	\<item type=\"input\"\>=PHI(2.25) \</item\>= 0.03				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3143236	99			0	uk	\<item type=\"input\"\>=PHI(-2.25)\</item\> = 0.03				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149286	100			0	uk	\<item type=\"input\"\>=PHI(0)\</item\> = 0.4				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153985				0	uk	\<bookmark_value\>POISSON function\</bookmark_value\>				20220827 09:49:47
