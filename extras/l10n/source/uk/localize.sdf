helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E09				0	uk	1				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E0F				0	uk	=A1:A2+1				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E17				0	uk	2				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E1D				0	uk	=SUMPRODUCT(A1:A2+1)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E25				0	uk	5				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E2D				0	uk	2				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E34				0	uk	2				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E3A				0	uk	=A1:A2+1				20220827 09:49:47
