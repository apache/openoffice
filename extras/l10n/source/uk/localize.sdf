helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146093	105			0	uk	POISSON(Number; Mean; C)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147253	106			0	uk	\<emph\>Number\</emph\> represents the value based on which the Poisson distribution is calculated.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151177	107			0	uk	\<emph\>Mean\</emph\> represents the middle value of the Poisson distribution.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149200	108			0	uk	\<emph\>C\</emph\> (optional) = 0 or False calculates the density function; \<emph\>C\</emph\> = 1 or True calculates the distribution. When omitted, the default value True is inserted when you save the document, for best compatibility with other programs and older versions of %PRODUCTNAME.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3159347	109			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150113	110			0	uk	\<item type=\"input\"\>=POISSON(60;50;1)\</item\> returns 0.93.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153100				0	uk	\<bookmark_value\>PERCENTILE function\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153100	112			0	uk	PERCENTILE				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154940	113			0	uk	\<ahelp hid=\"HID_FUNC_QUANTIL\"\>Returns the alpha-percentile of data values in an array.\</ahelp\> A percentile returns the scale value for a data series which goes from the smallest (Alpha=0) to the largest value (alpha=1) of a data series. For \<item type=\"literal\"\>Alpha\</item\> = 25%, the percentile means the first quartile; \<item type=\"literal\"\>Alpha\</item\> = 50% is the MEDIAN.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150531	114			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148813	115			0	uk	PERCENTILE(Data; Alpha)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153054	116			0	uk	\<emph\>Data\</emph\> represents the array of data.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154212	117			0	uk	\<emph\>Alpha\</emph\> represents the percentage of the scale between 0 and 1.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154290	118			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159147	119			0	uk	\<item type=\"input\"\>=PERCENTILE(A1:A50;0.1)\</item\> represents the value in the data set, which equals 10% of the total data scale in A1:A50.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148807				0	uk	\<bookmark_value\>PERCENTRANK function\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148807	121			0	uk	PERCENTRANK				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153573	122			0	uk	\<ahelp hid=\"HID_FUNC_QUANTILSRANG\"\>Returns the percentage rank of a value in a sample.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147512	123			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147238	124			0	uk	PERCENTRANK(Data; Value)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154266	125			0	uk	\<emph\>Data\</emph\> represents the array of data in the sample.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148475	126			0	uk	\<emph\>Value\</emph\> represents the value whose percentile rank must be determined.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155364	127			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149163	128			0	uk	\<item type=\"input\"\>=PERCENTRANK(A1:A50;50)\</item\> returns the percentage rank of the value 50 from the total range of all values found in A1:A50. If 50 falls outside the total range, an error message will appear.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3166442				0	uk	\<bookmark_value\>QUARTILE function\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3166442	130			0	uk	QUARTILE				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146958	131			0	uk	\<ahelp hid=\"HID_FUNC_QUARTILE\"\>Returns the quartile of a data set.\</ahelp\>				20220827 09:49:47
