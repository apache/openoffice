helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3145166				0	uk	\<bookmark_value\>DECIMAL function\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3145166	225			0	uk	DECIMAL				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156361	226			0	uk	\<ahelp hid=\"HID_FUNC_DEZIMAL\"\>Converts text with characters from a \<link href=\"text/shared/00/00000005.xhp#zahlensystem\" name=\"number system\"\>number system\</link\> to a positive integer in the base radix given.\</ahelp\> The radix must be in the range 2 to 36. Spaces and tabs are ignored. The \<emph\>Text\</emph\> field is not case-sensitive.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3157994	227			0	uk	If the radix is 16, a leading x or X or 0x or 0X, and an appended h or H, is disregarded. If the radix is 2, an appended b or B is disregarded. Other characters that do not belong to the number system generate an error.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150014	228			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154328	229			0	uk	DECIMAL("Text"; Radix)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150128	230			0	uk	            \<emph\>Text\</emph\> is the text to be converted. To differentiate between a hexadecimal number, such as A1 and the reference to cell A1, you must place the number in quotation marks, for example, "A1" or "FACE".				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145241	231			0	uk	            \<emph\>Radix\</emph\> indicates the base of the number system. It may be any positive integer between 2 and 36.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3156062	232			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145355	233			0	uk	            \<item type=\"input\"\>=DECIMAL("17";10)\</item\> returns 17.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155622	234			0	uk	            \<item type=\"input\"\>=DECIMAL("FACE";16)\</item\> returns 64206.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151015	235			0	uk	            \<item type=\"input\"\>=DECIMAL("0101";2)\</item\> returns 5.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3148402				0	uk	\<bookmark_value\>DOLLAR function\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148402	11			0	uk	DOLLAR				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153049	12			0	uk	\<ahelp hid=\"HID_FUNC_DM\"\>Converts a number to an amount in the currency format, rounded to a specified decimal place.\</ahelp\> In the \<item type=\"literal\"\>Value\</item\> field enter the number to be converted to currency. Optionally, you may enter the number of decimal places in the \<item type=\"literal\"\>Decimals\</item\> field. If no value is specified, all numbers in currency format will be displayed with two decimal places. 				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151280	263			0	uk	You set the currency format in your system settings.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150569	13			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154188	14			0	uk	DOLLAR(Value; Decimals)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145299	15			0	uk	            \<emph\>Value\</emph\> is a number, a reference to a cell containing a number, or a formula which returns a number.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145629	16			0	uk	            \<emph\>Decimals\</emph\> is the optional number of decimal places.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149030	17			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153546	18			0	uk	            \<item type=\"input\"\>=DOLLAR(255)\</item\> returns $255.00.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154635	19			0	uk	            \<item type=\"input\"\>=DOLLAR(367.456;2)\</item\> returns $367.46. Use the decimal separator that corresponds to the \<link href=\"text/shared/optionen/01140000.xhp\" name=\"current locale setting\"\>current locale setting\</link\>.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3150685				0	uk	\<bookmark_value\>EXACT function\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150685	78			0	uk	EXACT				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3158413	79			0	uk	\<ahelp hid=\"HID_FUNC_IDENTISCH\"\>Compares two text strings and returns TRUE if they are identical.\</ahelp\> This function is case-sensitive.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152817	80			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148594	81			0	uk	EXACT("Text1"; "Text2")				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153224	82			0	uk	            \<emph\>Text1\</emph\> refers to the first text to compare.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148637	83			0	uk	            \<emph\>Text2\</emph\> is the second text to compare.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149777	84			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156263	85			0	uk	            \<item type=\"input\"\>=EXACT("microsystems";"Microsystems")\</item\> returns FALSE.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3152589				0	uk	\<bookmark_value\>FIND function\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152589	44			0	uk	FIND				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146149	45			0	uk	\<ahelp hid=\"HID_FUNC_FINDEN\"\>Looks for a string of text within another string.\</ahelp\> You can also define where to begin the search. The search term can be a number or any string of characters. The search is case-sensitive.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3083284	46			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3083452	47			0	uk	FIND("FindText"; "Text"; Position)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150608	48			0	uk	            \<emph\>FindText\</emph\> refers to the text to be found.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3152374	49			0	uk	            \<emph\>Text\</emph\> is the text where the search takes place.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3152475	50			0	uk	            \<emph\>Position\</emph\> (optional) is the position in the text from which the search starts.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3154812	51			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156375	52			0	uk	            \<item type=\"input\"\>=FIND(76;998877665544)\</item\> returns 6.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149268				0	uk	\<bookmark_value\>FIXED function\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149268	34			0	uk	FIXED				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155833	35			0	uk	\<ahelp hid=\"HID_FUNC_FEST\"\>Returns a number as text with a specified number of decimal places and optional thousands separators.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152470	36			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147567	37			0	uk	FIXED(Number; Decimals; NoThousandsSeparators)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151272	38			0	uk	            \<emph\>Number\</emph\> refers to the number to be formatted.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156322	39			0	uk	            \<emph\>Decimals\</emph\> refers to the number of decimal places to be displayed.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150877	40			0	uk	            \<emph\>NoThousandsSeparators\</emph\> (optional) determines whether the thousands separator is used. If the parameter is a number not equal to 0, the thousands separator is suppressed. If the parameter is equal to 0 or if it is missing altogether, the thousands separators of your \<link href=\"text/shared/optionen/01140000.xhp\" name=\"current locale setting\"\>current locale setting\</link\> are displayed.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149040	41			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145208	42			0	uk	            \<item type=\"input\"\>=FIXED(1234567.89;3)\</item\> returns 1,234,567.890 as a text string. 				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id5282143				0	uk	            \<item type=\"input\"\>=FIXED(1234567.89;3;1)\</item\> returns 1234567.890 as a text string.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id7319864				0	uk	\<bookmark_value\>JIS function\</bookmark_value\>				20220827 09:49:47
