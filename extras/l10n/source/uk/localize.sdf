helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	bm_id3150991				0	uk	\<bookmark_value\>EOMONTH function\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	hd_id3150991	231			0	uk	\<variable id=\"eomonth\"\>\<link href=\"text/scalc/01/func_eomonth.xhp\"\>EOMONTH\</link\>\</variable\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3152766	232			0	uk	\<ahelp hid=\"HID_AAI_FUNC_EOMONTH\"\>Returns the date of the last day of a month which falls m\<emph\>onths\</emph\> away from the s\<emph\>tart date\</emph\>.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	hd_id3150597	233			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3150351	234			0	uk	EOMONTH(StartDate; Months)				20220827 09:49:47
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3146787	235			0	uk	\<emph\>StartDate\</emph\> is a date (the starting point of the calculation).				20220827 09:49:47
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3155615	236			0	uk	\<emph\>Months\</emph\> is the number of months before (negative) or after (positive) the start date.				20220827 09:49:47
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	hd_id3156335	237			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3154829	238			0	uk	What is the last day of the month that falls 6 months after September 14 2001?				20220827 09:49:47
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3156143	239			0	uk	\<item type=\"input\"\>=EOMONTH(DATE(2001;9;14);6)\</item\> returns the serial number 37346. Formatted as a date, this is 2002-03-31.				20220827 09:49:47
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3156144	239			0	uk	\<item type=\"input\"\>=EOMONTH("2001-09-14";6)\</item\> works as well. If the date is given as string, it has to be in ISO format.				20220827 09:49:47
