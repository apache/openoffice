helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147582	177			0	uk	SUBSTITUTE("Text"; "SearchText"; "NewText"; Occurrence)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153675	178			0	uk	            \<emph\>Text\</emph\> is the text in which text segments are to be exchanged.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156155	179			0	uk	            \<emph\>SearchText \</emph\>is the text segment that is to be replaced (a number of times).				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145779	180			0	uk	            \<emph\>NewText\</emph\> is the text that is to replace the text segment.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150348	181			0	uk	            \<emph\>Occurrence\</emph\> (optional) indicates which occurrence of the search text is to be replaced. If this parameter is missing the search text is replaced throughout.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150946	182			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150412	183			0	uk	            \<item type=\"input\"\>=SUBSTITUTE("123123123";"3";"abc")\</item\> returns 12abc12abc12abc.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154915	238			0	uk	            \<item type=\"input\"\>=SUBSTITUTE("123123123";"3";"abc";2)\</item\> returns 12312abc123.				20220827 09:49:47
