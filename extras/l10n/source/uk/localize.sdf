helpcontent2	source\text\scalc\01\func_month.xhp	0	help	hd_id3149936	76			0	uk	\<variable id=\"month\"\>\<link href=\"text/scalc/01/func_month.xhp\"\>MONTH\</link\>\</variable\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	par_id3153538	77			0	uk	\<ahelp hid=\"HID_FUNC_MONAT\"\>Returns the month for the given date value.\</ahelp\> The month is returned as an integer between 1 and 12.				20220827 09:49:47
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	hd_id3149517	78			0	uk	Syntax				20220827 09:49:47
