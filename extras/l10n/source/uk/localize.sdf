helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3147209	5			0	uk	Equal (=)				20220827 09:49:47
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3146797	6			0	uk	Shows values equal to the condition.				20220827 09:49:47
helpcontent2	source\text\shared\02\12090101.xhp	0	help	par_id3143271	7			0	uk	Less than (<)				20220827 09:49:47
