helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166056	480			0	uk	MIN				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143316	481			0	uk	6				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143339	482			0	uk	PRODUCT				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143366	483			0	uk	7				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143389	484			0	uk	STDEV				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143416	485			0	uk	8				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143439	486			0	uk	STDEVP				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143466	487			0	uk	9				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143489	488			0	uk	SUM				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143516	489			0	uk	10				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143539	490			0	uk	VAR				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143566	491			0	uk	11				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143589	492			0	uk	VARP				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143606	498			0	uk	\<emph\>Range\</emph\> is the range whose cells are included.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3143625	499			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143638	562			0	uk	You have a table in the cell range A1:B5 containing cities in column A and accompanying figures in column B. You have used an AutoFilter so that you only see rows containing the city Hamburg. You want to see the sum of the figures that are displayed; that is, just the subtotal for the filtered rows. In this case the correct formula would be:				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143658	563			0	uk	\<item type=\"input\"\>=SUBTOTAL(9;B2:B5)\</item\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3143672				0	uk	\<bookmark_value\>Euro; converting\</bookmark_value\>\<bookmark_value\>EUROCONVERT function\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3143672	564			0	uk	EUROCONVERT				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143708	565			0	uk	\<ahelp hid=\"HID_FUNC_UMRECHNEN\"\>Converts between old European national currency and to and from Euros.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143731	566			0	uk	\<emph\>Syntax\</emph\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143748	567			0	uk	EUROCONVERT(Value; "From_currency"; "To_currency", full_precision, triangulation_precision)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143763	568			0	uk	\<emph\>Value\</emph\> is the amount of the currency to be converted.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143782	569			0	uk	\<emph\>From_currency\</emph\> and \<emph\>To_currency\</emph\> are the currency units to convert from and to respectively. These must be text, the official abbreviation for the currency (for example, "EUR"). The rates (shown per Euro) were set by the European Commission.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0119200904301810				0	uk	\<emph\>Full_precision\</emph\> is optional. If omitted or False, the result is rounded according to the decimals of the To currency. If Full_precision is True, the result is not rounded.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0119200904301815				0	uk	\<emph\>Triangulation_precision\</emph\> is optional. If Triangulation_precision is given and >=3, the intermediate result of a triangular conversion (currency1,EUR,currency2) is rounded to that precision. If Triangulation_precision is omitted, the intermediate result is not rounded. Also if To currency is "EUR", Triangulation_precision is used as if triangulation was needed and conversion from EUR to EUR was applied.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143819	570			0	uk	\<emph\>Examples\</emph\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143837	571			0	uk	\<item type=\"input\"\>=EUROCONVERT(100;"ATS";"EUR")\</item\> converts 100 Austrian Schillings into Euros.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143853	572			0	uk	\<item type=\"input\"\>=EUROCONVERT(100;"EUR";"DEM")\</item\> converts 100 Euros into German Marks.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id0908200902090676				0	uk	\<bookmark_value\>CONVERT function\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id0908200902074836				0	uk	CONVERT				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902131122				0	uk	\<ahelp hid=\".\"\>Converts a value from one unit of measurement to another unit of measurement. The conversion factors are given in a list in the configuration.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902475420				0	uk	At one time the list of conversion factors included the legacy European currencies and the Euro (see examples below). We suggest using the new function EUROCONVERT for converting these currencies.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id0908200902131071				0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902131191				0	uk	CONVERT(value;"text";"text")				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id0908200902131152				0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id090820090213112				0	uk	\<item type=\"input\"\>=CONVERT(100;"ATS";"EUR")\</item\> returns the Euro value of 100 Austrian Schillings.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902475431				0	uk	=CONVERT(100;"EUR";"DEM") converts 100 Euros into German Marks. 				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3157177				0	uk	\<bookmark_value\>ODD function\</bookmark_value\>\<bookmark_value\>rounding;up/down to nearest odd integer\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157177	502			0	uk	ODD				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157205	503			0	uk	\<ahelp hid=\"HID_FUNC_UNGERADE\"\>Rounds a positive number up to the nearest odd integer and a negative number down to the nearest odd integer.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157223	504			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157237	505			0	uk	ODD(Number)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157250	506			0	uk	 Returns \<emph\>Number\</emph\> rounded to the next odd integer up, away from zero.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157270	507			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157283	508			0	uk	\<item type=\"input\"\>=ODD(1.2)\</item\> returns 3.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8746910				0	uk	\<item type=\"input\"\>=ODD(1)\</item\> returns 1.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9636524				0	uk	\<item type=\"input\"\>=ODD(0)\</item\> returns 1.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5675527				0	uk	\<item type=\"input\"\>=ODD(-3.1)\</item\> returns -5.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3157404				0	uk	\<bookmark_value\>FLOOR function\</bookmark_value\>\<bookmark_value\>rounding;down to nearest multiple of significance\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157404	512			0	uk	FLOOR				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157432	513			0	uk	\<ahelp hid=\"HID_FUNC_UNTERGRENZE\"\>Rounds a number down to the nearest multiple of Significance.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157451	514			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157464	515			0	uk	FLOOR(Number; Significance; Mode)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157478	516			0	uk	\<emph\>Number\</emph\> is the number that is to be rounded down.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157497	517			0	uk	\<emph\>Significance\</emph\> is the value to whose multiple the number is to be rounded down.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157517	561			0	uk	\<emph\>Mode\</emph\> is an optional value. If the Mode value is given and not equal to zero, and if Number and Significance are negative, then rounding is done based on the absolute value of the number. This parameter is ignored when exporting to MS Excel as Excel does not know any third parameter.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163894	630			0	uk	If both parameters Number and Significance are negative, and if the Mode value is equal to zero or is not specified, then the results in $[officename] Calc and Excel will differ after exporting. If you export the spreadsheet to Excel, use Mode=1 to see the same results in Excel as in Calc.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163932	518			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163945	519			0	uk	\<item type=\"input\"\>=FLOOR( -11;-2)\</item\> returns -12				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163966	520			0	uk	\<item type=\"input\"\>=FLOOR( -11;-2;0)\</item\> returns -12				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163988	521			0	uk	\<item type=\"input\"\>=FLOOR( -11;-2;1)\</item\> returns -10				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164086				0	uk	\<bookmark_value\>SIGN function\</bookmark_value\>\<bookmark_value\>algebraic signs\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164086	523			0	uk	SIGN				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164115	524			0	uk	\<ahelp hid=\"HID_FUNC_VORZEICHEN\"\>Returns the sign of a number. Returns 1 if the number is positive, -1 if negative and 0 if zero.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164136	525			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164150	526			0	uk	SIGN(Number)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164164	527			0	uk	\<emph\>Number\</emph\> is the number whose sign is to be determined.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164183	528			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164197	529			0	uk	\<item type=\"input\"\>=SIGN(3.4)\</item\> returns 1.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164212	530			0	uk	\<item type=\"input\"\>=SIGN(-4.5)\</item\> returns -1.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164252				0	uk	\<bookmark_value\>MROUND function\</bookmark_value\>\<bookmark_value\>nearest multiple\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164252	658			0	uk	MROUND				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164288	659			0	uk	\<ahelp hid=\"HID_AAI_FUNC_MROUND\"\>Returns a number rounded to the nearest multiple of another number.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164306	660			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164320	661			0	uk	MROUND(Number; Multiple)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3486434				0	uk	Returns \<emph\>Number\</emph\> rounded to the nearest multiple of \<emph\>Multiple\</emph\>. 				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3068636				0	uk	An alternative implementation would be \<item type=\"literal\"\>Multiple * ROUND(Number/Multiple)\</item\>.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164333	662			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164347	663			0	uk	\<item type=\"input\"\>=MROUND(15.5;3)\</item\> returns 15, as 15.5 is closer to 15 (= 3*5) than to 18 (= 3*6).				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_idN14DD6				0	uk	\<item type=\"input\"\>=MROUND(1.4;0.5)\</item\> returns 1.5 (= 0.5*3).				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164375				0	uk	\<bookmark_value\>SQRT function\</bookmark_value\>\<bookmark_value\>square roots;positive numbers\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164375	532			0	uk	SQRT				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164404	533			0	uk	\<ahelp hid=\"HID_FUNC_WURZEL\"\>Returns the positive square root of a number.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164424	534			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164437	535			0	uk	SQRT(Number)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164451	536			0	uk	Returns the positive square root of \<emph\>Number\</emph\>.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6870021				0	uk	 Number must be positive.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164471	537			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164484	538			0	uk	\<item type=\"input\"\>=SQRT(16)\</item\> returns 4.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3591723				0	uk	\<item type=\"input\"\>=SQRT(-16)\</item\> returns an \<item type=\"literal\"\>invalid argument\</item\> error.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164560				0	uk	\<bookmark_value\>SQRTPI function\</bookmark_value\>\<bookmark_value\>square roots;products of Pi\</bookmark_value\>				20220827 09:49:47
