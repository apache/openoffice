helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165494	459			0	uk	TANH(Number)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165508	460			0	uk	Returns the hyperbolic tangent of \<emph\>Number\</emph\>.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165527	461			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165541	462			0	uk	\<item type=\"input\"\>=TANH(0)\</item\> returns 0, the hyperbolic tangent of 0.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3165633				0	uk	\<bookmark_value\>AutoFilter function; subtotals\</bookmark_value\>\<bookmark_value\>sums;of filtered data\</bookmark_value\>\<bookmark_value\>filtered data; sums\</bookmark_value\>\<bookmark_value\>SUBTOTAL function\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165633	466			0	uk	SUBTOTAL				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165682	467			0	uk	\<ahelp hid=\"HID_FUNC_TEILERGEBNIS\"\>Calculates subtotals.\</ahelp\> If a range already contains subtotals, these are not used for further calculations. Use this function with the AutoFilters to take only the filtered records into account.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165704	495			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165717	496			0	uk	SUBTOTAL(Function; Range)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165731	497			0	uk	\<emph\>Function\</emph\> is a number that stands for one of the following functions:				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165782	469			0	uk	Function index				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165806	470			0	uk	Function				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165833	471			0	uk	1				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165856	472			0	uk	AVERAGE				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165883	473			0	uk	2				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165906	474			0	uk	COUNT				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165933	475			0	uk	3				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165956	476			0	uk	COUNTA				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165983	477			0	uk	4				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166006	478			0	uk	MAX				20220827 09:49:47
