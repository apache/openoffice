helpcontent2	source\text\scalc\01\func_days.xhp	0	help	hd_id3151328	116			0	uk	\<variable id=\"days\"\>\<link href=\"text/scalc/01/func_days.xhp\"\>DAYS\</link\>\</variable\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3155139	117			0	uk	\<ahelp hid=\"HID_FUNC_TAGE\"\>Calculates the difference between two date values.\</ahelp\> The result returns the number of days between the two days.				20220827 09:49:47
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	hd_id3155184	118			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3149578	119			0	uk	DAYS(Date2; Date1)				20220827 09:49:47
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3151376	120			0	uk	\<emph\>Date1\</emph\> is the start date, \<emph\>Date2\</emph\> is the end date. If \<emph\>Date2\</emph\> is an earlier date than \<emph\>Date1\</emph\> the result is a negative number.				20220827 09:49:47
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	hd_id3151001	121			0	uk	Examples				20220827 09:49:47
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3159101	123			0	uk	=DAYS("2010-01-01"; NOW()) returns the number of days from today until January 1, 2010.				20220827 09:49:47
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3163720	172			0	uk	=DAYS("1990-10-10";"1980-10-10") returns 3652 days.				20220827 09:49:47
