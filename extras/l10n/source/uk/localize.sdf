helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3153534				0	uk	\<bookmark_value\>ROMAN function\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153534	248			0	uk	ROMAN				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151256	249			0	uk	\<ahelp hid=\"HID_FUNC_ROEMISCH\"\>Converts a number into a Roman numeral. The value range must be between 0 and 3999, the modes can be integers from 0 to 4.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149299	250			0	uk	Syntax				20220827 09:49:47
