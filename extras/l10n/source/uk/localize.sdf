helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154943	2			0	uk	\<variable id=\"mathematiktext\"\>This category contains the \<emph\>Mathematical\</emph\> functions for Calc.\</variable\> To open the \<emph\>Function Wizard\</emph\>, choose \<link href=\"text/scalc/01/04060000.xhp\" name=\"Insert - Function\"\>\<emph\>Insert - Function\</emph\>\</link\>.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3146944				0	uk	\<bookmark_value\>ABS function\</bookmark_value\>\<bookmark_value\>absolute values\</bookmark_value\>\<bookmark_value\>values;absolute\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146944	33			0	uk	ABS				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154546	34			0	uk	\<ahelp hid=\"HID_FUNC_ABS\"\>Returns the absolute value of a number.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154843	35			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147475	36			0	uk	ABS(Number)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148438	37			0	uk	\<emph\>Number\</emph\> is the number whose absolute value is to be calculated. The absolute value of a number is its value without the +/- sign.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155823	38			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152787	39			0	uk	\<item type=\"input\"\>=ABS(-56)\</item\> returns 56.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148752	40			0	uk	\<item type=\"input\"\>=ABS(12)\</item\> returns 12.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id320139				0	uk	\<item type=\"input\"\>=ABS(0)\</item\> returns 0.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3150896				0	uk	\<bookmark_value\>COUNTBLANK function\</bookmark_value\>\<bookmark_value\>counting;empty cells\</bookmark_value\>\<bookmark_value\>empty cells;counting\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150896	42			0	uk	COUNTBLANK				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155260	43			0	uk	\<ahelp hid=\"HID_FUNC_ANZAHLLEEREZELLEN\"\>Returns the number of empty cells.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145144	44			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153931	45			0	uk	COUNTBLANK(Range)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149512	46			0	uk	 Returns the number of empty cells in the cell range \<emph\>Range\</emph\>.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146139	47			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148586	48			0	uk	\<item type=\"input\"\>=COUNTBLANK(A1:B2)\</item\> returns 4 if cells A1, A2, B1, and B2 are all empty.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3153114				0	uk	\<bookmark_value\>ACOS function\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153114	50			0	uk	ACOS				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145163	51			0	uk	\<ahelp hid=\"HID_FUNC_ARCCOS\"\>Returns the inverse trigonometric cosine of a number.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153565	52			0	uk	Syntax				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150020	53			0	uk	ACOS(Number)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159134	54			0	uk	 This function returns the inverse trigonometric cosine of \<emph\>Number\</emph\>, that is the angle (in radians) whose cosine is Number. The angle returned is between 0 and PI.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id679647				0	uk	To return the angle in degrees, use the DEGREES function.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3149882	55			0	uk	Example				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150128	56			0	uk	\<item type=\"input\"\>=ACOS(-1)\</item\> returns 3.14159265358979 (PI radians)				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8792382				0	uk	\<item type=\"input\"\>=DEGREES(ACOS(0.5))\</item\> returns 60. The cosine of 60 degrees is 0.5.				20220827 09:49:47
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3145355				0	uk	\<bookmark_value\>ACOSH function\</bookmark_value\>				20220827 09:49:47
