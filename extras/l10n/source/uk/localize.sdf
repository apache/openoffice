helpcontent2	source\text\schart\01\05040200.xhp	0	help	bm_id3145673				0	uk	\<bookmark_value\>Y axes; formatting\</bookmark_value\>				20220827 09:49:47
helpcontent2	source\text\schart\01\05040200.xhp	0	help	hd_id3145673	1			0	uk	Y Axis				20220827 09:49:47
helpcontent2	source\text\schart\01\05040200.xhp	0	help	par_id3155628	2			0	uk	\<variable id=\"yachse\"\>\<ahelp hid=\".uno:DiagramAxisY\"\>Opens the\<emph\> Y Axis \</emph\>dialog, to change properties of the Y axis.\</ahelp\>\</variable\>				20220827 09:49:47
