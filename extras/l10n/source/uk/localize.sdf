helpcontent2	source\text\shared\02\02040000.xhp	0	help	par_id3147291				0	uk	\<image src=\"res/commandimagelist/sc_textdirectionlefttoright.png\" id=\"img_id3155805\"\>\<alt id=\"alt_id3155805\"\>Icon\</alt\>\</image\>				20220827 09:49:47
