helpcontent2	source\text\schart\01\05040201.xhp	0	help	hd_id3155336	10			0	uk	Major interval				20220827 09:49:47
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id3143218	11			0	uk	\<ahelp hid=\"SCH_SPINFIELD_TP_SCALE_EDT_STEP_MAIN\"\>Defines the interval for the main division of the axes.\</ahelp\> The main interval cannot be larger than the value area.				20220827 09:49:47
helpcontent2	source\text\schart\01\05040201.xhp	0	help	hd_id3154020	12			0	uk	Minor interval count				20220827 09:49:47
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id3154656	13			0	uk	\<ahelp hid=\"SCH_SPINFIELD_TP_SCALE_EDT_STEP_HELP\"\>Defines the interval for the subdivision of the axes.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\schart\01\05040201.xhp	0	help	hd_id3150089	14			0	uk	Reference value				20220827 09:49:47
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id3152990	15			0	uk	\<ahelp hid=\"SCH_SPINFIELD_TP_SCALE_EDT_ORIGIN\"\>Specifies at which position to display the values along the axis.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\schart\01\05040201.xhp	0	help	hd_id3166432	62			0	uk	Automatic				20220827 09:49:47
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id3145389	63			0	uk	\<ahelp hid=\"SCH:CHECKBOX:TP_SCALE:CBX_AUTO_ORIGIN\"\>You must first deselect the \<emph\>Automatic\</emph\> option in order to modify the values.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id3149129	64			0	uk	Disable this feature if you are working with "fixed" values, as it does not permit automatic scaling.				20220827 09:49:47
helpcontent2	source\text\schart\01\05040201.xhp	0	help	hd_id3159206	16			0	uk	Logarithmic scale				20220827 09:49:47
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id3145360	17			0	uk	\<ahelp hid=\"SCH:CHECKBOX:TP_SCALE:CBX_LOGARITHM\"\>Specifies that you want the axis to be subdivided logarithmically.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id3153956	61			0	uk	Use this feature if you are working with values that differ sharply from each other. You can use logarithmic scaling to make the grid lines of the axis equidistant but have values that may increase or decrease.				20220827 09:49:47
helpcontent2	source\text\schart\01\05040201.xhp	0	help	hd_id9941404				0	uk	Reverse direction				20220827 09:49:47
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id5581835				0	uk	\<ahelp hid=\".\"\>Defines where the lower and where the higher values are displayed at the axis. The unchecked state is the mathematical direction.\</ahelp\> That means for Cartesian coordinate systems that the x-axis shows the lower values on the left and the y-axis shows the lower values at the bottom. For polar coordinate systems the mathematical angle axis direction is counterclockwise and the radial axis is from inner to outer.				20220827 09:49:47
helpcontent2	source\text\schart\01\05040201.xhp	0	help	hd_id922204				0	uk	Type				20220827 09:49:47
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id59225				0	uk	\<ahelp hid=\".\"\>For some types of axes, you can select to format an axis as text or date, or to detect the type automatically.\</ahelp\> For the axis type "Date" you can set the following options.				20220827 09:49:47
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id1159225				0	uk	Minimum and maximum value to be shown on the ends of the scale.				20220827 09:49:47
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id2259225				0	uk	\<ahelp hid=\".\"\>Resolution can be set to show days, months, or years as interval steps.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id3359225				0	uk	\<ahelp hid=\".\"\>Major interval can be set to show a certain number of days, months, or years.\</ahelp\>				20220827 09:49:47
helpcontent2	source\text\schart\01\05040201.xhp	0	help	par_id4459225				0	uk	\<ahelp hid=\".\"\>Minor interval can be set to show a certain number of days, months, or years.\</ahelp\>				20220827 09:49:47
