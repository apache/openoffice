helpcontent2	source\text\simpress\02\10100000.xhp	0	help	par_id3148488				0	om	\<ahelp hid=\".uno:ConnectorToolbox\"\>Kamshaa \<emph\>Kornyoowwanii\</emph\> bakka kornyoowwan wantoota islaayidii ammee keessatti ida'uu dandessutti bana. Kornyoo sararaa wantoota kan walqunnamsiisa. Dabaltees yoo wantoonni socho'a waliin jalteessa kornyoo ni jalteeffama.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\simpress\02\10100000.xhp	0	help	par_id3154658				0	om	Sararawwan kornyoo gosa afurtuu jira:				20200411 15:09:53
helpcontent2	source\text\simpress\02\10100000.xhp	0	help	par_id3145584				0	om	Waltawaa(geengoo digirii-90 ni jalataa)				20200411 15:09:53
helpcontent2	source\text\simpress\02\10100000.xhp	0	help	par_id3154485				0	om	Sarara (lama jallachuu)				20200411 15:09:53
