helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	par_id3147469				0	om	\<emph\>Aduu Jalqaba\</emph\> guyyaa isa shallagin irraa hojjeetamu dha. Guyyyaan calqaba kunis yoo guyyaa hojii ta'e guyyaan kun shallaggii keessatti hammatama.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	par_id3153038				0	om	\<emph\>Guyyoota\</emph\> lakkoofsa guyyaa hojiiwwaaniti. Gatii firii aduu jalqabame poozetivi yommuu ta'u,kan osoo hin jalqabamin dura immoo neegativii ta'u.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	par_id3150693				0	om	\<emph\>Guyyaa Ayyaanaa\</emph\> tarree dirqala guyyaa ayyaanootati.Kunis guyyaa hojiin alaati. Bakka guyyaan ayyaanoota tokko tokkon eeramanitti,hangii man'ee galchi.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	hd_id3150141				0	om	Fakkeenya				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	par_id3152782				0	om	Mudde 1 bara 2001 guyyaa hojii guyyaa 17 booda guyyaa kamtu dhufa? C3 keessatti aduu calqaba galchi"2001-12-01" ,D3 keessa immoo lakkoofsa guyyaa hojiiwwaani galchi.Man'eewwaan F3 hanga J3 keessaa immo ayyaanoota qillee fi waggaa haaraa itti anuun dhufaan of keessaatti qabata."2001-12-24", "2001-12-25", "2001-12-26", "2001-12-31", "2002-01-01".				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	par_id3146142				0	om	=WORKDAY(C3;D3;F3:J3) 2001-12-28 kenna.Lakkoofsa eenyummaa aduu akka aduutti dhangeessi.Fakkeenyaaf dhangii YYYY-MM-DD.				20200411 15:09:53
