helpcontent2	source\text\swriter\guide\fields.xhp	0	help	bm_id3145576				0	om	\<bookmark_value\>dirreewwan;fooyyeessuu/mul'isuu\</bookmark_value\>      \<bookmark_value\>fooyyeessuu;dirreewwan\</bookmark_value\>      \<bookmark_value\>Gargaarsa qajeelchaa;dirreewwan\</bookmark_value\>      \<bookmark_value\>amaloota;dirreewwan\</bookmark_value\>      \<bookmark_value\>dhaamsuu;dirree shooluu\</bookmark_value\>      \<bookmark_value\>jijjiiruu;dirree gaaddiddeessitoota\</bookmark_value\>      \<bookmark_value\>mul'isuu;dirreewwan\</bookmark_value\>				20200411 15:09:53
