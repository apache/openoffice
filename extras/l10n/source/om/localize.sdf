helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	par_id3153885				0	om	\<emph\>Aduu Jalqaba\</emph\> guyyaa isa shallagin irraa hojjeetamu dha.Guyyyaan calqaba kunis yoo guyyaa hojii ta'e guyyaan kun shallaggii keessatti hammatama.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_networkdays.xhp	0	help	par_id3151110				0	om	\<emph\>AduuXumuraa\</emph\>n aduu hamma shallaggin irraa hojjeetamutti jiruu dha.Aduun xumuraa yoo guyyaa hojii ta'e, guyyaan kun shallaggii keessatti hammatama.				20200411 15:09:53
