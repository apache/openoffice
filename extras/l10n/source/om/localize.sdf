uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_UNKNOWNAUTH_UNTRUSTED)			1	om	Eenymmaa iddoola $(ARG1) mirkaneessuu hin dandeenye.\n\nRagaa kana fudhachuu kee dura, ragaa iddoola kanaa ofegannoon ilaaluu qabda. Eenyummaa iddoola kana gargar baafachuuf jecha ragaa $(ARG1) fudhachuu ni feetaa?				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_SSLWARN_EXPIRED_1)			1	om	$(ARG1) iddoola ragaa ittisaa fayyadamuun deetaa daddabarsu ta'uyyuu ragaan isaa $(ARG2) tti guyyaan irra darbeera.\n\nSa'aatiin kompitara keetii sirrii ta'uu isaa mirkaneeffachuu qabda.				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_SSLWARN_DOMAINMISMATCH_1)			1	om	$(ARG1) waliin walindhuuf yaalii gootee turte. Haa ta'u malee, ragaan ittisaa dhiheeffame kan $(ARG2) tti. Kan fakkatu ta'uu baatuyyuu, namni biraa wahii iddoola kanaan fakkeeffatee qunnamtii kee gufachiisuuf yaalaa jiraachuu danda'a.\n\nYoo ragaan mul'ifame kan $(ARG1) miti jettee shakkite, maaloo walindhaa kana dhiisitii bulchaa Iddoola kana yaadachiisi.\n\nHata'uu malee itti fufuu ni barbaaddaa?				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_SSLWARN_INVALID_1)			1	om	Ragaan kun gataa'uu hin dandeenye. Ragaa iddoola kanaa ofeeggannoon qorchuu qabda.\n\nRagaa dhiyaate shakkite, maaloo walindhaa kana dhiisitii bulchaa Iddoola kana yaadachiisi				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(TITLE_UUI_SSLWARN_DOMAINMISMATCH)			1	om	Dhaamsa Of Eeggannoo: Maqaan Qayee Wal hin fakkaatuu				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(TITLE_UUI_SSLWARN_EXPIRED)			1	om	Dhaamsa Of Eeggannoo: Ragaa Kaadima Yeeroon Irra Darbe				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(TITLE_UUI_SSLWARN_INVALID)			1	om	Dhaamsa Of Eeggannoo: Ragaa Kaadima Fashalaa				20200411 15:09:53
