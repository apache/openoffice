helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149447				0	om	COLUMN(Wabii)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3156310	74			0	om	            \<emph\>Wabii\</emph\>n wabii mandheef ykn naannoo mandhee lakkoofsi tarjaa jalqabaa barbaadamuu qabuuti.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155837				0	om	Yoo wabiin tokkoyyu hin seenne ta'e, lakkoofsi tarjaa mandhee foormulaan keessa seene ni argama. \<item type=\"productname\"\>%PRODUCTNAME\</item\> Calciin wabii ofumaan gara mandhee ammeetti qindeessa.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3152932				0	om	Fakkeenya				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147571	76			0	om	            \<item type=\"input\"\>=COLUMN(A1)\</item\> walqixa 1. Tarjaa A n gabatee keessatti tarjaa jalqabaati.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147079	77			0	om	            \<item type=\"input\"\>=COLUMN(C3:E3)\</item\> walqixa 3. Tarjaa C n gabatee keessatti tarjaa sadaffaadha.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3146861	195			0	om	            \<item type=\"input\"\>=COLUMN(D3:G10)\</item\>n 4 kenna sababni isaas tarjaa D n gabatee keessatti tarjaa afraffaadha dabalataan immoo faankishiniin TARJAA akka foormulaa waraantootti hin fayyadne. (Haala kana keessatti, gatiin waraantoo inni jalqabaa yeroo hunda akka firiitti fayyada.)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3156320	196			0	om	            \<item type=\"input\"\>{=COLUMN(B2:B7)}\</item\> fi \<item type=\"input\"\>=COLUMN(B2:B7)\</item\> lamaan isaaniiyyu 2 kennu sababni isaas wabiin tarjaa B qofa akka tarjaa lammaffaa gabatee keessaatti of keessatti qabata. Naannoon tajaa-qeenxee lakkoofsa tarjaa tokko qofa waan qabuuf, foormulaan akka foormulaa waraantootti yoo fayyades fayyaduu baates garaagarummaa hin uumu.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150872	197			0	om	            \<item type=\"input\"\>=COLUMN()\</item\>n yoo foormulaan tarjaa C keessa galeera ta'e 3 kenna.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153277	198			0	om	            \<item type=\"input\"\>{=COLUMN(Rabbit)}\</item\> yoo hilleensi maqaa naannoo (C1:D3) tti mogga'e ta'e waraantoo tarree-qeenxee (3, 4) kenna.				20200411 15:09:53
