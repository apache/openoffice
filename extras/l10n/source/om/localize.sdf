helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164926				0	om	\<ahelp hid=\"HID_FUNC_ZAEHLENWENN\"\>Lakkoofsa man'eewwanii kan ulaagaa wayii hammangaa man'ee keessaa waliin wal qabatu deebisa.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164953				0	om	Caasima				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164967				0	om	COUNTIF(Hammangaa; Ulaagaa)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164980				0	om	\<emph\>Hammangaan\</emph\> hammangaa ulaagaa hojiirra ooluudha.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165000				0	om	\<emph\>Ulaagaan\</emph\>, ulaagaa akka unka lakkoofsaatti, himamsaatti ykn diraa arfiitti mul'isa. Ulaagaan kun man'eewwan kamtu akka lakkaa'amu murteessa. Akka himamsa idileetti barruu barbaachaa, fkf b.* jechoota hundaa b dhaan jalqaban galchuu dandeessa. Akkasumas, hammangaa man'ee kan ulaagaa barbaachaa of keessaa qabu agarsiisuu dandeessa. Yoo barruu harjifaatiif barbaadde, barruu waraabbii lamaan cufi.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165037				0	om	Fakkeenya				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166505				0	om	A1:A10 hammangaa man'ee lakkoofsotaa \<item type=\"input\"\>2000\</item\> hanga \<item type=\"input\"\>2009\</item\> of keessaa qaba. Man'ee B1 lakkoofsa \<item type=\"input\"\>2006\</item\> of keessaa qaba. Man'ee B2 keessa, foormulaa galchita:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3581652				0	om	\<item type=\"input\"\>=COUNTIF(A1:A10;2006)\</item\> - kuni 1 deebisa				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id708639				0	om	\<item type=\"input\"\>=COUNTIF(A1:A10;B1)\</item\> - kuni 1 deebisa				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5169225				0	om	\<item type=\"input\"\>=COUNTIF(A1:A10;">=2006") \</item\>- kuni 4 deebisa				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2118594				0	om	\<item type=\"input\"\>=COUNTIF(A1:A10;"<"&B1)\</item\> - yoo B1 qabaate \<item type=\"input\"\>2006\</item\>, kuni 6 deebisa				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id166020				0	om	\<item type=\"input\"\>=COUNTIF(A1:A10;C2)\</item\> iddoo man'een C2 barruu \<item type=\"input\"\>>2006\</item\> lakkoofsa man'eewwanii hammangaa A1:A10 keessaa lakkaa'u kan >2006 ta'u of keessaa qaba.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6386913				0	om	Lakkoofsota negatiivii qofa lakkaa'uuf: \<item type=\"input\"\>=COUNTIF(A1:A10;"<0")\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164897K				0	om	\<bookmark_value\>COUNTIFS function\</bookmark_value\>\<bookmark_value\>counting;specified cells\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164897K				0	om	COUNTIFS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164926K				0	om	\<ahelp hid=\"HID_FUNC_ZAEHLENWNRNG\"\>Count the number of cells that meet multiple criteria in multiple ranges.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164953K				0	om	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164967K				0	om	COUNTIFS( Reference R1 ; Criterion C1 [ ; Reference R2 ; Criterion C2 ]... )				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164980K				0	om	\<emph\>Reference R1\</emph\> is the  range to which the \<emph\>Criterion C1\</emph\>applies. \<emph\>Reference R2\</emph\> is the  range to which the \<emph\>Criterion C2\</emph\>applies, and so on.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165000K				0	om	All \<emph\>Reference \</emph\> ranges shall have the same dimension and size, else an Error is returned. \<emph\>Criteria\</emph\> indicates the criteria in the form of a number, an expression or a character string. These criteria determine which cells are counted. You may also enter a search text in the form of a regular expression, e.g. b.* for all words that begin with b. You may also indicate a cell range that contains the search criterion. If you search for literal text, enclose the text in double quotes.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165037K				0	om	Examples:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166505K				0	om	A1:A10 is a cell range containing the numbers \<item type=\"input\"\>2000\</item\> to \<item type=\"input\"\>2009\</item\>. B1:B10 is a cell range containing the numbers \<item type=\"input\"\>2007\</item\> to \<item type=\"input\"\>2016\</item\>:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3581652K				0	om	\<item type=\"input\"\>=COUNTIFS(A1:A10;2006;B1:B10;2014)\</item\> - this returns 2				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5169225K				0	om	\<item type=\"input\"\>=COUNTIFS(A1:A10;">=2006";B1:B10;">=2006") \</item\>- this returns 14				20200411 15:09:53
