helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3152360	115			0	om	            \<emph\>Wabii\</emph\>n wabii faankishiniin wabii haaraa irraa barbaadudha.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3156032	116			0	om	            \<emph\>Tarreewwan\</emph\> lakkoofsa tarreewwanii wabiin ittiin ol(gatii negetiivaa) ykn gad sirraa'edha.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3166458	117			0	om	            \<emph\>Tarjaawwan\</emph\> (dirqala) lakkoofsa tarjaawwanii kan wabiin ittiin gara bitaatti (gatii negetiivaa) ykn gara mirgaatti sirraa'edha.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150708	118			0	om	            \<emph\>Hojjaa\</emph\>n (dirqala) hojjaa sarjaa bal'ina qubannoo wabii haaraa irratti jalqabuuti.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147278	119			0	om	            \<emph\>Dalgee\</emph\>n (dirqala) dalgee surdalaa bal'ina qubannoo wabii haaaraa irratti jalqabuuti.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id8662373				0	om	Arguments \<emph\>Rows\</emph\> and \<emph\>Columns\</emph\> must not lead to zero or negative start row or column.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id9051484				0	om	Qajeelfamoonni \<emph\>Hojjaa\</emph\> fi \<emph\>Dalgee\</emph\> gara zeerootti ykn tarree  negetiiviidhaan lakkaawuutti ykn tarjaatti deemsisuu hin qabu.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN1104B				0	om	            \<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>         				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3155586				0	om	Fakkeenya				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149744	121			0	om	            \<item type=\"input\"\>=OFFSET(A1;2;2)\</item\> gatii mandhee C3 (A1 tarreewwan lamaa fi tarjaawwan lamaan gad hiiqe) kenna. Yoo C3n gatii \<item type=\"input\"\>100\</item\> qabaate faankishiniin kun gatii 100 kenna.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id7439802				0	om	            \<item type=\"input\"\>=OFFSET(B2:C3;1;1)\</item\> wabii B2:C3 tarree 1 fi tarjaa tokkoon gad hiiqe gara mirgaatti (C3:D4) kenna.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3009430				0	om	            \<item type=\"input\"\>=OFFSET(B2:C3;-1;-1)\</item\> wabii B2:C3 tarree 1 fi tarjaa tokkoon ol hiiqe gara bitaatti (A1:B2) kenna.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id2629169				0	om	            \<item type=\"input\"\>=OFFSET(B2:C3;0;0;3;4)\</item\> wabii B2:C3 tarreewwan 3 fi tarjaawwan 4 (B2:E4)tti irra deebi'anii hamamtooman kenna.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id6668599				0	om	            \<item type=\"input\"\>=OFFSET(B2:C3;1;0;3;4)\</item\> wabii B2:C3 tarree tokko gara tarreewwan 3 fi tarjaawwan 4tti irra deebi'ee hamamtoomeetiin (B2:E4) gara gadiitti hiiqe kenna.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153739	122			0	om	            \<item type=\"input\"\>=SUM(OFFSET(A1;2;2;5;6))\</item\> dimshaasha bal'inaa mandhee C3 keessatti jalqabu murteessa dabalataanis hojjaa tarreewwan 5 fi dalgee tarjaawwan 6 qaba (bal'ina=C3:H7).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3159273				0	om	\<bookmark_value\>faankishinii LOOKUP\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3159273				0	om	LOOKUP				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153389				0	om	\<ahelp hid=\"HID_FUNC_VERWEIS\"\>Mandhee hangii tarree-tokkoo ykn tarjaa-tokkoo irraa qabeentota kenna.\</ahelp\> Dirqalaan, gatiin (kasaa walfakkaataa) moggaafame tarjaa fi tarree garaagaraa keessatti kennama. Faallaa \<link href=\"text/scalc/01/04060109.xhp\" name=\"VLOOKUP\"\>VLOOKUP\</link\> fi \<link href=\"text/scalc/01/04060109.xhp\" name=\"HLOOKUP\"\>HLOOKUP\</link\>tti, kalqabeen barbaachaa fi firii bakka garaagaraa ta'uu danda'u; isaan wal cinaa ta'uu hin qaban. Dabalataan, kalqabeen barbaachaa LOOKUP jalaa ol tartiibeffamuu qaba, ta'uu baannaan barbaachi firiiwwan faayidaa irra oolan hin kennu.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id4484084				0	om	Yoo LOOKUP ulaagaa barbaachaa argachuu dadhabe, gatii guddaa kalqabee barbaachaa kan ulaagaa barbaachaa wajjiin walqixa ykn irra xiqqaa ta'e waliin wal simata.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3152947				0	om	Caasima				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154104				0	om	LOOKUP(UlaagaaBarbaachaa; KalqabeeBarbaachaa; KalqabeeFirii)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150646	127			0	om	            \<emph\>UlaagaanBarbaachaa\</emph\> gatii barbaadamuu qabudha; kallattiidhaan ykn akka wabiitti galeera.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154854	128			0	om	            \<emph\>KalqabeenBarbaachaa\</emph\> bal'ina tarree-qeenxee ykn tarjaa-qeenxee barbaadamuuf jirudha.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149925	129			0	om	            \<emph\>KalqabeenFirii\</emph\> hangii tarree-qeenxee ykn tarjaa-qeenee biraa firiin faankishinii irraa fudhatamudha. Firiin mandhee kalqabee firii kasaa walfakkaataa akka miseensa kalqabee barbaachaa keessaa argameedha.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3148624				0	om	Fakkeenya				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149809	131			0	om	            \<item type=\"input\"\>=LOOKUP(A1;D1:D100;F1:F100)\</item\> Lakkoofsa A1 keessa galchiteef hangii D1:D100 keessaa mandhee barbaada. Miseensa argameef, kasaan murtaa'eera, fakkeenyaaf, mandhee 12ffaa hangii kana keessaa. Sana booda, qabeentotni mandhee 12ffaa akka gatii faankishinii (kalqabee firii keessaatti) deebi'u.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3149425				0	om	\<bookmark_value\>faankishinii STYLE\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3149425				0	om	STYLE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150826				0	om	\<ahelp hid=\"HID_FUNC_VORLAGE\"\>Mandhee foormulaa qabatetti haala hojii irra oolcha.\</ahelp\> Yeroo hamma ta'een booda, haalatni biraa hojii irra ooluu danda'a. Faankishiniin kun, gatii osoo hin jijjiiriin akka ati faankisinii biraatti dabaltuuf sii eeyyamuudhaan yeroo hunda gatii 0 kenna. Faankishinii CURRENT wajjiin gatii osoo hin ilaallatiin mandheetti halluu dibuu ni dandeessa. Fakkeenyaaf: =...+SYLE(IF(CURRENT()>3;"diimaa";"magariisa")) Yoo gatiin irra guddaa 3 ta'e haalata "diimaa" mandheetti hojii irra oolcha, ta'uu baannaan haalata "magariisatu" hojii irra oola. Dhangiiwwan mandhee lamaanuu duraan ibsamuu qabu.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3145373				0	om	Caasima				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149302				0	om	STYLE("Haalata"; Yeroo; "Haalata2")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150596	137			0	om	            \<emph\>Haalatni\</emph\> maqaa haalata mandhee mandheetti moggaafameedha. Maqaawwan haalataa mallattoo waraabbii keessa taa'uu  qabu.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3156149	138			0	om	            \<emph\>Yeroon\</emph\> hangii yeroo sekondiitiinii dirqalaadha. Yoo ulaagaan kun hafe haalatni yeroon murtaa'e erga darbee booda jijjiiramuu hin dandaa'u.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149520	139			0	om	            \<emph\>Haalata2\</emph\> maqaa dirqalaa haalata mandhee erga yeroon murtaa'ee darbee booda mandheetti moggaafamedha. Yoo ulaagaan kun hafe "durtiin" ni tilmaama. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN111CA				0	om	            \<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>         				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3159254				0	om	Fakkeenya				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3151374	141			0	om	            \<item type=\"input\"\>=STYLE("Invisible";60;"Default")\</item\> mandhee dhangii ifaa keessaa erga galmeen fe'amee ykn irra deebi'amee shallagamee booda sekondii 60f dhangi'ama, sana booda dhangiin durtii ni moggaafama. Dhangiiwwan mandhee lamaan isaaniiyyu dura ibsamuu qabu.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id8056886				0	om	STYLE()n gatii lakkoofsaa deebi'u zeeroo waan qabuuf, gatiin deebi'u kun diraatti miilta'a. KUn akka fakkeenya armaan gadiitti T() fayyadamuudhaan dhorgamuu danda'a.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3668935				0	om	            \<item type=\"input\"\>="Text"&T(STYLE("myStyle"))\</item\>         				20200411 15:09:53
