helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149577	200			0	om	            \<item type=\"input\"\>=COLUMN(B5)\</item\>n 1 kenna sababni isaaas mandheen tokko tarjaa tokko qofa qabata.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3145649	85			0	om	            \<item type=\"input\"\>=COLUMN(A1:C5)\</item\> walqixa 3. Wabiin tarjaawwan sadii of keessatti qabata.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155846	201			0	om	            \<item type=\"input\"\>=COLUMNS(Hilleensi)\</item\> yoo \<item type=\"literal\"\>Hilleensa\</item\> maqaa hangiitti moggaafame yoo ta'e (C1:D3) 2 deebisa.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3153152				0	om	\<bookmark_value\>faankishinii barbaadduu sarjaa\</bookmark_value\>        \<bookmark_value\>faankishinii VLOOKUP\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153152				0	om	VLOOKUP				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149984				0	om	\<ahelp hid=\"HID_FUNC_SVERWEIS\"\>Barbaacha sarjaa mandheewwan gara mirgaa wajjiin wabii ta'e.\</ahelp\> Faankishiniin kun tarjaa waraantoo jalqabaa keessatti gatiin adda ta'e hammatamuu isaa mirkaneessa. Faankishinichi sana booda gatii tarree wal fakkaataa tarjaa keessa jiru \<item type=\"literal\"\>Kasaa\</item\>dhaan moggaafame deebisa. Yoo ulaagaan \<item type=\"literal\"\>Tartiibaansirreessi\</item\> haqame ykn DHUGAA ta'e ykn tokko ta'e, deetaan jalaa ol akka tartiiba qabatetti ilaalama. Haala kana keessatti, yoo \<item type=\"literal\"\>UlaagaaBarbaachaa\</item\> sirriin hin argamne ta'e, gatiin dhumaa ulaagaatii gad ta'e deebi'uu danda'a. Yoo \<item type=\"literal\"\>Tartiibessuun\</item\> SOBA ykn zeerootti qindaa'e, walsimannaa sirriin argamuu qaba, ta'uu baannaan dogongorri \<emph\>Dogongora: Gatiin Hin jiru\</emph\> jedhutu firii ta'uu danda'a. Kanaafuu deetaan gatiin isaa zeeroo ta'e jalaa ol tartiiba'uun isa hin barbaachisu.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3146898				0	om	Caasima				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150156				0	om	=VLOOKUP(UlaagaaBarbaachaa; Waraantoo; Kasaa; TartiibaQabsiisuuu)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149289	91			0	om	            \<emph\>UlaagaanBarbaachaa\</emph\> gatii jalqaba tarjaa waraantoof barbaadamudha.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153884	92			0	om	            \<emph\>Waraantoo\</emph\>n wabii, yoo xiqqaate tarjaawwan lama qabatudha. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3156005	93			0	om	            \<emph\>Kasaa\</emph\>n lakkoofsa tarjaa waraantoo keessa jiru kan gatii kennamuu qabu of keessatti qabatudha. Tarjaan jalqabaa lakkoofsa 1 qaba.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3151208	94			0	om	            \<emph\>TartiibaQabsiisuu\</emph\>n ulaagaa dirqalaa tarjaan jalqabaa waraantoo keessa jiru jalaa ol tartiiba'uu isaa kan agarsiisudha.Yoo tarjaan jalqabaa jalaa ol hin tartiibone ta'e gatii Buuliyaanii SOBA ykn zeeroo galchi. Tarjaawwan tartiiba'an saffisa guddaadhaan barbaadamu gatiin barbaachaa sirriitti argamuu baatuyyu faankishiniin yeroo hunda gatii kenna, yoo inni walakkaa gatii guddaa fi xiqqaa tarree tartiiba'anii gidduu ta'e. Tarreewwan hin tartiibofne keessatti, gatiin barbaachaa sirriitti firoomuu qaba. Yoo ta'uu baate faankishinichi ergaa kana kenna: \<emph\>Dogongora: Gatiin Hin Jiru\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3147487				0	om	Fakkeenya				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154129				0	om	Baafata mandhee A1 keessa jiru irratti lakkoofsa 'dish' galchuu qabda, maqaan dish akka barruutti yerosuma mandhee (B1) ollaa jiru keessatti mul'ata.Lakkoofsi maqaa moggaasuuf gargaaru waraantoo D1:E100 keessatti qabatama. D1 \<item type=\"input\"\>100\</item\> qabata, E1 maqaa \<item type=\"input\"\>soup kuduraa fi muduraa\</item\> qabata, fi wantoota baafataa 100f haaluma kanaan itti fufa.Lakkoofsonni tarjaa D keessaa tartiiba jalaa oliin tartiiba'u; kanaafuu, ulaagaan \<item type=\"literal\"\>Tartiibessuu\</item\> dirqalaa barbaachisaa miti.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3145663				0	om	Foormulaa armaan gadii B1 keessa galchi:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3151172	98			0	om	            \<item type=\"input\"\>=VLOOKUP(A1;D1:E100;2)\</item\>         				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149200				0	om	Akkuma lakkoofsa A1 keessa galchiteen B1 barruu tarjaa lammaffaa wabii D1:E100 keessa jiru agarsiisa. Lakkoofsa hin jirre galchuun barruu lakkoofsa gadii itti aanu wajjiin mul'issa. Kana ittisuuf, foormulaa keessatti akka ulaagaa dhumaatti SOBA galchi kanaafuu yeroo lakkoofsi hin jirre seenu ergaan dogongoraa ni uumama.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3153905				0	om	\<bookmark_value\>lakkoofsota wardii; ilaaluu\</bookmark_value\>        \<bookmark_value\>faankishinii WARDII\</bookmark_value\>				20200411 15:09:53
