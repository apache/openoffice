helpcontent2	source\text\shared\01\xformsdatatab.xhp	0	help	hd_id2927335				0	om	+				20200411 15:09:53
helpcontent2	source\text\shared\01\xformsdatatab.xhp	0	help	par_id2107303				0	om	\<ahelp hid=\".\"\>Bakka maqaa akaakuu deetaa hiikamaa fayyadamaa haaraa galchuu dandeessutti qaaqa banuuf qabduu cuqaasi. Akaakuun deetaa haaraan akaakuu deetaa filatamaa ammee kallattii rakkoon ykn amalli itti mul'atu mara irraa dhaala.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\xformsdatatab.xhp	0	help	par_id4071779				0	om	Kan armaan gadii kallattii rakkoo ykn amallitti mul'atu mara akaakuuwwan deetaa muraasaaf jireessa tarreessa.				20200411 15:09:53
helpcontent2	source\text\shared\01\xformsdatatab.xhp	0	help	hd_id4313791				0	om	Iddadii				20200411 15:09:53
helpcontent2	source\text\shared\01\xformsdatatab.xhp	0	help	par_id4331797				0	om	\<ahelp hid=\".\"\>Iddadiiwwan yeroo diraan akaakuu deetaa ammee hojjatamu akkamitti akka qabamu ifteessa. Gatiiwwan fudhataman Kuufaman, Bakka buusi akkasumas Qoncoorsi. Hiikaan jechaa fi himaa hiikaa ittaanu bakka http://www.w3.org/TR/xmlschema-2/#rf-whiteSpace hordofa.\</ahelp\> 				20200411 15:09:53
helpcontent2	source\text\shared\01\xformsdatatab.xhp	0	help	hd_id4191717				0	om	Sarxaa				20200411 15:09:53
helpcontent2	source\text\shared\01\xformsdatatab.xhp	0	help	par_id2318796				0	om	\<ahelp hid=\".\"\>Sarxaa himannoo idilee ifteessa. Diraawwan akaakuun deetaa gata'eessuu dirqama dhugoomsuu gara sarxaa gataa'aamuu qabuudha. Caasima akaakuu deetaa XSD himannoowwan idileef caasima himannoo idilee irraa gargar %PRODUCTNAME bakka barbaaddetti keessatti, fakkeenyaaf qaaqa Barbaada fi Bu'insa keessatti.\</ahelp\>				20200411 15:09:53
