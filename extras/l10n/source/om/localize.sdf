helpcontent2	source\text\sbasic\shared\03030101.xhp	0	help	par_id3147229				0	om	\<emph\>Waggaa:\</emph\> Himamsa itergaa kan waggaa agarsiisu.Gatii hundinuu gidduu 0 fi 99 akka waggoota 1900-1999 ti hiikamu waggaa hamma kennameen ala ta'e lakqurxa afur qofa galchuu qabda.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030101.xhp	0	help	par_id3156280				0	om	\<emph\>Ji'a:\</emph\> Himamsa itergaa kan ji'a waggaa murtaa'ee agarsiisu.Kan fudhatama qabu 1-12 qofa.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030101.xhp	0	help	par_id3151043				0	om	\<emph\>Day:\</emph\> Himamsa itergaa kan guyyaa ji'a murtaa'e agarsiisu.Kan fudhatama qabu guyyaa 1-31 ti.Guyyaa hin jirree ji'aaf guyyaa 31 gadi ta'e yoo  galchite dogongorri hin deebi'u.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030101.xhp	0	help	par_id3161832				0	om	 \<emph\>Faankishinii DateSerial \</emph\> jedhamu guyyaa muddee 30,1899 fi guyyaa kenname deebisa. Garaagarummaa guyyaa lama gudduu jiru baruuf faankishinii kana fayyyadamuu ni dandeessa.				20200411 15:09:53
