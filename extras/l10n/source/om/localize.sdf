helpcontent2	source\text\scalc\guide\cell_protect.xhp	0	help	bm_id3146119				0	om	\<bookmark_value\>dhorkuu;man'eelee fi wardiilee\</bookmark_value\>      \<bookmark_value\>man'eelee; dhorkuu\</bookmark_value\>      \<bookmark_value\>man'ee dhorkuu; dandeessisuu\</bookmark_value\>      \<bookmark_value\>wardiilee; dhorkuu\</bookmark_value\>      \<bookmark_value\>galmeelee; dhorkuu\</bookmark_value\>      \<bookmark_value\>man'eelee; maxxansaaf dhoksuu\</bookmark_value\>      \<bookmark_value\>jijjiiruu; dhorka wardii\</bookmark_value\>      \<bookmark_value\>dhoksuu;foormulaawwan\</bookmark_value\>      \<bookmark_value\>foormulaawwan;dhoksuu\</bookmark_value\>				20200411 15:09:53
