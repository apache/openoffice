helpcontent2	source\text\shared\01\02250000.xhp	0	help	hd_id3150868				0	om	Galmee Haaraa Saaga				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3149168	6			0	om	\<ahelp hid=\"HID_GRID_TRAVEL_NEW\" visibility=\"hidden\"\>Galmee haaraa gabatee ammee keesssatti saga.\</ahelp\> Galmee uumuuf, qabduu urjoo(*) mula'annoo gabatee jalaa cuqaasi. Tarreen duwwaan dhuma gabateetti dabala.				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3152920				0	om	\<ahelp hid=\".\" visibility=\"hidden\"\>Akaakuu galmee uumuu barbaadee fili. $[officename]n lakkooofsaa tarjaa akaakuu keessaa galmee walitti galoo \<emph\>Akaakuu\</emph\> asitti filtu saaga.\</ahelp\>				20200411 15:09:53
