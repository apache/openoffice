helpcontent2	source\text\smath\01\03090100.xhp	0	help	tit				0	om	Ogeejjii Tokkee/Lamee				20200411 15:09:53
helpcontent2	source\text\smath\01\03090100.xhp	0	help	bm_id3150342				0	om	\<bookmark_value\>ogeejjii tokkee\</bookmark_value\>\<bookmark_value\>ogeejjii lamee\</bookmark_value\>\<bookmark_value\>ogeejjii; tokkee fi lamee\</bookmark_value\>\<bookmark_value\>mallattoo idaatii\</bookmark_value\>\<bookmark_value\>mallattoo ida'uu/hirrisuu\</bookmark_value\>\<bookmark_value\>mallattoo ida'uu/hirrisuu\</bookmark_value\>\<bookmark_value\>mallattoo baay'isuu\</bookmark_value\>\<bookmark_value\>NOT ogeejjii\</bookmark_value\>\<bookmark_value\>AND ogeejjii\</bookmark_value\>\<bookmark_value\>ogeejjii Yaayaa\</bookmark_value\>\<bookmark_value\>ogeejjii Buuliyaanii\</bookmark_value\>\<bookmark_value\>OR ogeejjii\</bookmark_value\>\<bookmark_value\>mallatoole herrega Walitti Fidi\</bookmark_value\>\<bookmark_value\>mallattoo ida'uu\</bookmark_value\>\<bookmark_value\>mallattoo hirrisuu\</bookmark_value\>\<bookmark_value\>mallaattoo hir'inaa\</bookmark_value\>\<bookmark_value\>mallaattoo haxaaroo hiruu\</bookmark_value\>\<bookmark_value\>mallaattoo haxaarroo hiruu\</bookmark_value\>\<bookmark_value\>indexes; foormulatti ida'uu\</bookmark_value\>\<bookmark_value\>powers\</bookmark_value\>\<bookmark_value\>mallaattoo hiruu\</bookmark_value\>\<bookmark_value\>hiika fayyadamaa ogeejjii;tokkee fi lamee\</bookmark_value\>				20200411 15:09:53
