helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN117F1				0	om	\<ahelp hid=\"HID_FUNC_HYPERLINK\"\>Yeroo mandhee faankishinii HYPERLINK qabatu cuqaastu, geessituun ni banama.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11800				0	om	Yoo ulaagaa \<emph\>barruu mandhee\</emph\> dirqalaa fayyadamte, foormulaan URL qubachiisa, sana boodas barruu mul'isa.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11803				0	om	Mandhee geessifame gabatee cuqoo wajjiin banuuf, mandhee filadhu, haalata gulaallii galchuuf F2 dhiibi, qaree fuldura geessituu jiru hiiqsi, Shift+F10 dhiibi, fi sana booda \<emph\>Geessituu Bani\</emph\> fladhu.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN1180A				0	om	Caasima				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN1180E				0	om	HYPERLINK("URL") ykn HYPERLINK("URL"; "BarruuMandhee")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11811				0	om	            \<emph\>URL\</emph\>n galtee walqabsiiftuu adda baasa. Ulaagaan \<emph\>BarruuMandhee\</emph\> dirqalaa barruu mandhee keessatti mul'atee fi firii faankishinii dha. Yoo ulaagaan \<emph\>BarruuMandhee\</emph\> adda hin baane ta'e,  \<emph\>URL\</emph\>iin barruu mandhee fi firii faankishinii keessatti mul'ifama 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id0907200912224576				0	om	Mandheewwan duwwaa fi maalimoota tareentaaf lakkoofsi 0 deebi'a.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11823				0	om	Fakkeenya				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11827				0	om	            \<item type=\"input\"\>=HYPERLINK("http://www.example.org")\</item\> yeroo cuqaafamu barruu "http://www.example.org" mandhee keessaa ni mul'isa dabalataanis geessituu http://www.example.org hojii irra oolcha.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN1182A				0	om	            \<item type=\"input\"\>=HYPERLINK("http://www.example.org";"Click here")\</item\> yeroo cuqaafamu barruu "as Cuqaasi" kan mandhee keessa jiru mul'isa dabalataanis geessituu http://www.example.org hojii irra oolcha.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id0907200912224534				0	om	=GEESSITUU("http://www.example.org";12345) lakkoofsa 12345 agarsiisa fi yeroo cuqaasamu geessituu http://www.example.org bana.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN1182D				0	om	            \<item type=\"input\"\>=HYPERLINK($B4)\</item\> yeroo mandheen B4 \<item type=\"input\"\>http://www.example.org\</item\> qabatu. Faankishinichi http://www.example.org URLii mandhee geessituutti dabalee barruu walfakkaataa akka firii foormulaatti gargaaru deebisa.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11830				0	om	            \<item type=\"input\"\>=HYPERLINK("http://www.";"Click ") & "example.org"\</item\> yeroo cuqaasamu barruu example.org Cuqaasi jedhu kan mandhee keessa jiru mul'isa dabalataanis hyperlink http://www.example.org hojii irra oolcha.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id8859523				0	om	            \<item type=\"input\"\>=HYPERLINK("#Sheet1.A1";"Go to top")\</item\> barruu gara olii deemi jedhu mul'isa dabalataanis mandhee Wardii1.A1 galmee kanna keessa jirutti utaala.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id2958769				0	om	            \<item type=\"input\"\>=HYPERLINK("file:///C:/writer.odt#Specification";"Go to Writer bookmark")\</item\> barruu gara Writer bookmark deemi jedhu mul'isa, galmee barruu adda ba'e fe'a dabalataanis "Addabaasuu" bookmark itti utaala.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id7682424				0	om	\<bookmark_value\>faankishinii GETPIVOTDATA\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3747062				0	om	GETPIVOTDATA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3593859				0	om	\<ahelp hid=\".\"\>The GETPIVOTDATA function returns a result value from a pivot table. The value is addressed using field and item names, so it remains valid if the layout of the pivot table changes.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id9741508				0	om	Caasima				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id909451				0	om	Ibsoonni caasimaa garaagaraa lama fayyadamamuu danda'u:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1665089				0	om	GETPIVOTDATA(TargetField; pivot table; [ Field 1; Item 1; ... ])				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id4997100				0	om	GETPIVOTDATA(pivot table; Constraints)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1672109				0	om	Yoo sirriitti ulaagaaleen lama kennaman caasimni lammaffaan, ulaagaan isaa tokkoffaa mandhee ykn wabii hangii mandhee ta'e ni tilmaamama. Caasimni tokkoffaan haalota biroo hunda keessatti ni tilmaamama. Masakni Faankishinii caasima tokkoffaa agarsiisa. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id9464094				0	om	Caasima Tokkoffaa				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id9302346				0	om	            \<emph\>TargetField\</emph\> is a string that selects one of the pivot table's data fields. The string can be the name of the source column, or the data field name as shown in the table (like "Sum - Sales").				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id8296151				0	om	            \<emph\>pivot table\</emph\> is a reference to a cell or cell range that is positioned within a pivot table or contains a pivot table. If the cell range contains several pivot tables, the table that was created last is used.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id4809411				0	om	If no \<emph\>Field n / Item n\</emph\> pairs are given, the grand total is returned. Otherwise, each pair adds a constraint that the result must satisfy. \<emph\>Field n\</emph\> is the name of a field from the pivot table. \<emph\>Item n\</emph\> is the name of an item from that field.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id6454969				0	om	If the pivot table contains only a single result value that fulfills all of the constraints, or a subtotal result that summarizes all matching values, that result is returned. If there is no matching result, or several ones without a subtotal for them, an error is returned. These conditions apply to results that are included in the pivot table.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id79042				0	om	If the source data contains entries that are hidden by settings of the pivot table, they are ignored. The order of the Field/Item pairs is not significant. Field and item names are not case-sensitive.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id7928708				0	om	If no constraint for a page field is given, the field's selected value is implicitly used. If a constraint for a page field is given, it must match the field's selected value, or an error is returned. Page fields are the fields at the top left of a pivot table, populated using the "Page Fields" area of the pivot table layout dialog. From each page field, an item (value) can be selected, which means only that item is included in the calculation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3864253				0	om	Subtotal values from the pivot table are only used if they use the function "auto" (except when specified in the constraint, see \<item type=\"literal\"\>Second Syntax\</item\> below).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3144016				0	om	Caasima Lammaffaa				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id9937131				0	om	            \<emph\>pivot table\</emph\> has the same meaning as in the first syntax.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id5616626				0	om	            \<emph\>Ittisamoonni\</emph\> tarree iddoo-adda ba'edha. Galiinsonni waraabbii (mallattoo waraabbii qeenxee) keessa taa'uu danda'u. Diraa mandhee biraa irraa yoo wabeessiteen ala, diraan hundi waraabbiiwwan (mallattoo waraabbi dachaa) keessatti hammatamuu qabu.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id4076357				0	om	One of the entries can be the data field name. The data field name can be left out if the pivot table contains only one data field, otherwise it must be present.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id8231757				0	om	Each of the other entries specifies a constraint in the form \<item type=\"literal\"\>Field[Item]\</item\> (with literal characters [ and ]), or only \<item type=\"literal\"\>Item\</item\> if the item name is unique within all fields that are used in the pivot table.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3168736				0	om	Maqaan faankishinii uunka \<emph\>Dirree[Wanta;Faankishinii]\</emph\>, ittisama gatiiwwan hundamta xiqqaa faankishini sana fayyadamu wajjiin akka waal simatu taasisu keessatti ida'amuu danda'a. Maqaan faankishinii danda'amu Ida'uu, Lakkaawuu, Gidduugala, Guddaa, Xiqqaa, Baay'ataa, Lakkaawuu (Lakkoofsota qofa), StDev (Fakkeenya), StDev (Baay'ina), Var (Fakkeenya), fi Varp (Baay'ina), qub-sukaanaa'aa kan hin taane. 				20200411 15:09:53
