desktop	source\migration\wizard.src	0	fixedtext	TP_MIGRATION	FT_MIGRATION_BODY			0	dgo	%OLDPRODUCT प्रस्थापना चा सभनें शा मता व्यक्तिगत डेटा  %PRODUCTNAME %PRODUCTVERSION.\n परतियै बरतोई सकदा ऐ. \n\n जेकर तुस %PRODUCTNAME %PRODUCTVERSION चा कोई बी सैट्टिंगां परतियै नेईं चांह्‌दे,जाच खान्ने गी अचि’न्नत करो. 				2002-02-02 02:02:02
