extensions	source\abpilot\abspilot.src	0	fixedtext	RID_PAGE_SELECTABTYPE	FT_TYPE_HINTS			0	dgo	%PRODUCTNAME कन्नै तुस अपने सिस्टम च पैह्‌लें गै मजूद सिरनामां डेटे तगर पुज्जी सकदे ओ.एह् करने लेई , %PRODUCTNAME डेटा स्रोत सिरजेआ जाग, जिस च  थुआढ़ा सिरनामां डेटा टेबल- रूप च उपलब्ध ऐ.\n \n एह् विशारद डेटा स्रोत  सिरजने च थुआढ़ी मदद करदा ऐ. 				2002-02-02 02:02:02
