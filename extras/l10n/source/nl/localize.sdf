helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3157320	214			0	nl	2				20130618 17:22:18
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3156422	215			0	nl	Pica				20130618 17:22:18
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3144760	216			0	nl	pc				20130618 17:22:18
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3145322	217			0	nl	2				20130618 17:22:18
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3155131	218			0	nl	Punt				20130618 17:22:18
