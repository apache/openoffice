helpcontent2	source\text\sbasic\shared\03120101.xhp	0	help	par_id3163800	14			0	nl	Print ASC("Leeuwarden") REM Geeft 76 terug, aangezien alleen met het eerste teken rekening wordt gehouden.				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03120101.xhp	0	help	par_id3148674	15			0	nl	End Sub				20130618 17:22:18
