helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3151118				0	id	\<ahelp hid=\".uno:Bib/sdbsource\"\>Select the data source for the bibliography database.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\01\02250000.xhp	0	help	hd_id3145645				0	id	Column Arrangement				20181231 09:50:43
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3151282	36			0	id	\<ahelp hid=\".uno:Bib/Mapping\"\>Lets you map the column headings to data fields from a different data source. To define a different data source for your bibliography, click the\<emph\> Data Source\</emph\> button on the record\<emph\> Object Bar\</emph\>.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3144767				0	id	\<ahelp hid=\"BIB_LISTBOX_RID_DLG_MAPPING_LB_CUSTOM4\"\>Select the data field that you want to map to the current \<emph\>Column name\</emph\>. To change the available data fields, select a different data source for your bibliography.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3153947				0	id	\<ahelp hid=\".\" visibility=\"hidden\"\>Deletes the current record.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3151019				0	id	\<ahelp hid=\".\" visibility=\"hidden\"\>Lets you choose a different data source for your bibliography.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3153730				0	id	\<ahelp hid=\".\" visibility=\"hidden\"\>Inserts a new record into the current table.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	tit				0	id	List of Regular Expressions				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	bm_id3146765				0	id	\<bookmark_value\>regular expressions; list of\</bookmark_value\>      \<bookmark_value\>lists;regular expressions\</bookmark_value\>      \<bookmark_value\>replacing;tab stops (regular expressions)\</bookmark_value\>      \<bookmark_value\>tab stops;regular expressions\</bookmark_value\>      \<bookmark_value\>concatenation, see ampersand symbol\</bookmark_value\>      \<bookmark_value\>ampersand symbol, see also operators\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	hd_id3146765				0	id	\<variable id=\"02100001\"\>\<link href=\"text/shared/01/02100001.xhp\"\>List of Regular Expressions\</link\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149741				0	id	Character				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155577				0	id	Result/Use				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id6600543				0	id	Any character				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9824518.00000001				0	id	Represents the given character unless otherwise specified.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152427				0	id	.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149031				0	id	Represents any single character except for a line break or paragraph break. For example, the search term "sh.rt" returns both "shirt" and "short".				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154682				0	id	^				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155351				0	id	Only finds the search term if the term is at the beginning of a paragraph. Special objects such as empty fields or character-anchored frames, at the beginning of a paragraph are ignored. Example: "^Peter".				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3159194				0	id	$				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152542				0	id	Only finds the search term if the term appears at the end of a paragraph. Special objects such as empty fields or character-anchored frames at the end of a paragraph are ignored. Example: "Peter$".				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156414				0	id	*				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155555				0	id	Finds zero or more of the characters in front of the "*". For example, "Ab*c" finds "Ac", "Abc", "Abbc", "Abbbc", and so on.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147399				0	id	+				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3157958				0	id	Finds one or more of the characters in front of the "+". For example, "AX.+4" finds "AXx4", but not "AX4".				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145313				0	id	The longest possible string that matches this search pattern in a paragraph is always found. If the paragraph contains the string "AX 4 AX4", the entire passage is highlighted.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3143267				0	id	?				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153684				0	id	Finds zero or one of the characters in front of the "?". For example, "Texts?" finds "Text" and "Texts" and "x(ab|c)?y" finds "xy", "xaby", or "xcy".				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3166410				0	id	\\				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147209				0	id	Search interprets the special character that follows the "\\" as a normal character and not as a regular expression (except for the combinations \\n, \\t, \\>, and \\<). For example, "tree\\." finds "tree.", not "treed" or "trees".				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152945				0	id	\\n				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153700				0	id	Represents a line break that was inserted with the Shift+Enter key combination. To change a line break into a paragraph break, enter \<emph\>\\n\</emph\> in the \<emph\>Search for\</emph\> and \<emph\>Replace with\</emph\> boxes, and then perform a search and replace.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9262672				0	id	\\n in the \<emph\>Search for\</emph\> text box stands for a line break that was inserted with the Shift+Enter key combination.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id2366100				0	id	\\n in the \<emph\>Replace with\</emph\> text box stands for a paragraph break that can be entered with the Enter or Return key.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153258				0	id	\\t				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3157809				0	id	Represents a tab. You can also use this expression in the \<emph\>Replace with\</emph\> box.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150670				0	id	\\b				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153666				0	id	Match a word boundary. For example, "\\bbook" finds "bookmark" but not "checkbook" whereas "book\\b" finds "checkbook" but not "bookmark". The discrete word "book" is found by both search terms.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149576				0	id	^$				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3151245				0	id	Finds an empty paragraph.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148550				0	id	^.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3159413				0	id	Finds the first character of a paragraph.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147282				0	id	& or $0				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153961				0	id	Adds the string that was found by the search criteria in the \<emph\>Search for\</emph\> box to the term in the \<emph\>Replace with\</emph\> box when you make a replacement.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149650				0	id	For example, if you enter "window" in the \<emph\>Search for\</emph\> box and "&frame" in the \<emph\>Replace with\</emph\> box, the word "window" is replaced with "windowframe".				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150543				0	id	You can also enter an "&" in the \<emph\>Replace with\</emph\> box to modify the \<emph\>Attributes\</emph\> or the \<emph\>Format\</emph\> of the string found by the search criteria.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145419				0	id	[abc123]				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154630				0	id	Represents one of the characters that are between the brackets.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156293				0	id	[a-e]				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149167				0	id	Represents any of the characters that are between a and e, including both start and end characters				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id100520090232005				0	id	The characters are ordered by their code numbers.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155994				0	id	[a-eh-x]				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148676				0	id	Represents any of the characters that are between a-e and h-x.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145318				0	id	[^a-s]				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153351				0	id	Represents everything that is not between a and s.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156543				0	id	\\xXXXX				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153768				0	id	Represents a special character based on its four-digit hexadecimal code (XXXX).				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3159252				0	id	The code for the special character depends on the font used. You can view the codes by choosing \<emph\>Insert - Special Character\</emph\>.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153951				0	id	|				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154985				0	id	Finds the terms that occur before the "|" and also finds the terms that occur after the "|". For example, "this|that" finds "this" and "that".				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147376				0	id	{2}				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150103				0	id	Defines the number of times that the character in front of the opening bracket occurs. For example, "tre{2}" finds and selects "tree".				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3151289				0	id	{1,2}				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147317				0	id	Defines the minimum and maximum number of times that the character in front of the opening bracket can occur. For example, "tre{1,2}" finds and selects "tre" and "tree".				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id4870754				0	id	{1,}				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id843836				0	id	Defines the minimum number of times that the character in front of the opening bracket can occur. For example, "tre{2,}" finds "tree", "treee", and "treeeee".				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148616				0	id	( )				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id2701803				0	id	In the \<emph\>Search for\</emph\> box:				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153573				0	id	Defines the characters inside the parentheses as a reference. You can then refer to the first reference in the current expression with "\\1", to the second reference with "\\2", and so on.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156061				0	id	For example, if your text contains the number 13487889 and you search using the regular expression (8)7\\1\\1, "8788" is found.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id2367931				0	id	You can also use () to group terms, for example, "a(bc)?d" finds "ad" or "abcd".				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9200109				0	id	In the \<emph\>Replace with\</emph\> box:				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id5766472				0	id	Use $ (dollar) instead of \\ (backslash) to replace references. Use $0 to replace the whole found string.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154790				0	id	[:alpha:]				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147397				0	id	Represents an alphabetic character. Use [:alpha:]+ to find one or more of them.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152885				0	id	[:digit:]				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150010				0	id	Represents a decimal digit. Use [:digit:]+ to find one or more of them.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153743				0	id	[:alnum:]				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153281				0	id	Represents an alphanumeric character ([:alpha:] and [:digit:]).				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153726				0	id	[:space:]				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150961				0	id	Represents a space character (but not other whitespace characters).				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150486				0	id	[:print:]				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150872				0	id	Represents a printable character.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155854				0	id	[:cntrl:]				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152576				0	id	Represents a nonprinting character.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149958				0	id	[:lower:]				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145730				0	id	Represents a lowercase character if \<emph\>Match case\</emph\> is selected in \<emph\>Options\</emph\>.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148455				0	id	[:upper:]				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150092	231			0	id	Represents an uppercase character if \<emph\>Match case\</emph\> is selected in \<emph\>Options.\</emph\>               				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	hd_id5311441				0	id	Examples				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id956834773				0	id	e([:digit:])?    -- finds 'e' followed by zero or one digit. Note that currently all named character classes like [:digit:] must be enclosed in parentheses.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id952368773				0	id	^([:digit:])$    -- finds lines or cells with exactly one digit.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9568773				0	id	You can combine the search terms to form complex searches.				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	hd_id71413				0	id	To find three-digit numbers alone in a paragraph				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id2924283				0	id	^[:digit:]{3}$				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id5781731				0	id	^ means the match has to be at the start of a paragraph, 				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id6942045				0	id	[:digit:] matches any decimal digit, 				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id4721823				0	id	{3} means there must be exactly 3 copies of "digit", 				20181231 09:50:43
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id5806756				0	id	$ means the match must end a paragraph. 				20181231 09:50:43
