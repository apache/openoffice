helpcontent2	source\text\scalc\01\02190100.xhp	0	help	hd_id3156326				0	id	\<link href=\"text/scalc/01/02190100.xhp\" name=\"Pemutus Baris\"\>Pemutus Baris\</link\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\02190100.xhp	0	help	par_id3154366				0	id	\<ahelp hid=\".uno:DeleteRowbreak\"\>Membuang pemutus baris manual di atas sel yang aktif.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\02190100.xhp	0	help	par_id3151041				0	id	Position the cursor in a cell directly below the row break indicated by a horizontal line and choose \<emph\>Edit - Delete Manual Break - Row Break\</emph\>. The manual row break is removed.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	tit				0	id	MONTH 				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	bm_id3149936				0	id	\<bookmark_value\>fungsi MONTH\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	hd_id3149936				0	id	\<variable id=\"month\"\>\<link href=\"text/scalc/01/func_month.xhp\"\>MONTH\</link\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	par_id3153538				0	id	\<ahelp hid=\"HID_FUNC_MONAT\"\>Returns the month for the given date value.\</ahelp\> The month is returned as an integer between 1 and 12.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	hd_id3149517				0	id	Sintaksis				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	par_id3145602				0	id	MONTH(Angka)				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	par_id3149485				0	id	\<emph\>Number\</emph\>, as a time value, is a decimal for which the month is to be returned.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	hd_id3153322				0	id	Contoh				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	par_id3149244				0	id	MONTH(NOW()) menghasilkan bulan saat ini				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_month.xhp	0	help	par_id3154790				0	id	=MONTH(C4) returns 7 if you enter 2000-07-07 to cell C4 (that date value might get formatted differently after you press Enter).				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	tit				0	id	Fungsi Susunan				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3147273				0	id	\<bookmark_value\>matrices; functions\</bookmark_value\>\<bookmark_value\>Function Wizard; arrays\</bookmark_value\>\<bookmark_value\>array formulas\</bookmark_value\>\<bookmark_value\>inline array constants\</bookmark_value\>\<bookmark_value\>formulas;arrays\</bookmark_value\>\<bookmark_value\>functions;array functions\</bookmark_value\>\<bookmark_value\>editing; array formulas\</bookmark_value\>\<bookmark_value\>copying; array formulas\</bookmark_value\>\<bookmark_value\>adjusting array ranges\</bookmark_value\>\<bookmark_value\>calculating;conditional calculations\</bookmark_value\>\<bookmark_value\>matrices; calculations\</bookmark_value\>\<bookmark_value\>conditional calculations with arrays\</bookmark_value\>\<bookmark_value\>implicit array handling\</bookmark_value\>\<bookmark_value\>forced array handling\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3147273				0	id	Fungsi Susunan				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154744				0	id	\<variable id=\"matrixtext\"\>Kategori ini mengandung fungsi susunan. \</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3146084				0	id	Apa itu Susunan?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154298				0	id	\<variable id=\"wasmatrix\"\>An array is a linked range of cells on a spreadsheet containing values. \</variable\> A square range of 3 rows and 3 columns is a 3 x 3 array:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154692				0	id	A				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3150117				0	id	B				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3155325				0	id	C				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3153104				0	id	1				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3146996				0	id	\<item type=\"input\"\>7\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3150529				0	id	\<item type=\"input\"\>31\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3148831				0	id	\<item type=\"input\"\>33\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3148943				0	id	2				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149771				0	id	\<item type=\"input\"\>95\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3158407				0	id	\<item type=\"input\"\>17\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3148806				0	id	\<item type=\"input\"\>2\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154904				0	id	3				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3150779				0	id	\<item type=\"input\"\>5\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3148449				0	id	\<item type=\"input\"\>10\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3147238				0	id	\<item type=\"input\"\>50\</item\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3153583				0	id	The smallest possible array is a 1 x 2 or 2 x 1 array with two adjacent cells.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3148474				0	id	Apa itu rumus susunan?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3155355				0	id	A formula in which the individual values in a cell range are evaluated is referred to as an array formula. The difference between an array formula and other formulas is that the array formula deals with several values simultaneously instead of just one.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3151052				0	id	Not only can an array formula process several values, but it can also return several values. The results of an array formula is also an array.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3158432				0	id	To multiply the values in the individual cells by 10 in the above array, you do not need to apply a formula to each individual cell or value. Instead you just need to use a single array formula. Select a range of 3 x 3 cells on another part of the spreadsheet, enter the formula \<item type=\"input\"\>=10*A1:C3\</item\> and confirm this entry using the key combination \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+Shift+Enter. The result is a 3 x 3 array in which the individual values in the cell range (A1:C3) are multiplied by a factor of 10.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149156				0	id	In addition to multiplication, you can also use other operators on the reference range (an array). With $[officename] Calc, you can add (+), subtract (-), multiply (*), divide (/), use exponents (^), concatenation (&) and comparisons (=, <>, <, >, <=, >=). The operators can be used on each individual value in the cell range and return the result as an array if the array formula was entered.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166456				0	id	Comparison operators in an array formula treat empty cells in the same way as in a normal formula, that is, either as zero or as an empty string. For example, if cells A1 and A2 are empty the array formulas \<item type=\"input\"\>{=A1:A2=""}\</item\> and \<item type=\"input\"\>{=A1:A2=0}\</item\> will both return a 1 column 2 row array of cells containing TRUE.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3150713				0	id	Kapankan Anda menggunakan rumus susunan (array)?				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149787				0	id	Use array formulas if you have to repeat calculations using different values. If you decide to change the calculation method later, you only have to update the array formula. To add an array formula, select the entire array range and then \<link href=\"text/scalc/01/04060107.xhp\" name=\"make the required change to the array formula\"\>make the required change to the array formula\</link\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149798				0	id	Array formulas are also a space saving option when several values must be calculated, since they are not very memory-intensive. In addition, arrays are an essential tool for carrying out complex calculations, because you can have several cell ranges included in your calculations. $[officename] has different math functions for arrays, such as the MMULT function for multiplying two arrays or the SUMPRODUCT function for calculating the scalar products of two arrays.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3155588				0	id	Menggunakan Rumus Susunan di $[officename] Calc				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3152876				0	id	You can also create a "normal" formula in which the reference range, such as parameters, indicate an array formula. The result is obtained from the intersection of the reference range and the rows or columns in which the formula is found. If there is no intersection or if the range at the intersection covers several rows or columns, a #VALUE! error message appears. The following example illustrates this concept:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3151271				0	id	Membuat Rumus Susunan				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149102				0	id	If you create an array formula using the \<emph\>Function Wizard\</emph\>, you must mark the \<emph\>Array\</emph\> check box each time so that the results are returned in an array. Otherwise, only the value in the upper-left cell of the array being calculated is returned.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3153392				0	id	If you enter the array formula directly into the cell, you must use the key combination Shift+\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+Enter instead of the Enter key. Only then does the formula become an array formula.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3151120				0	id	Array formulas appear in braces in $[officename] Calc. You cannot create array formulas by manually entering the braces.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154342				0	id	The cells in a results array are automatically protected against changes. However, you can edit or copy the array formula by selecting the entire array cell range.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id8834803				0	id	Using Inline Array Constants in Formulas				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id985747				0	id	Calc supports inline matrix/array constants in formulas. An inline array is surrounded by curly braces '{' and '}'. Elements can be each a number (including negatives), a logical constant (TRUE, FALSE), or a literal string. Non-constant expressions are not allowed. Arrays can be entered with one or more rows, and one or more columns. All rows must consist of the same number of elements, all columns must consist of the same number of elements. 				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id936613				0	id	The column separator (separating elements in one row) is the ';' semicolon. The row separator is a '|' pipe symbol. The separators are not language and locale dependent. 				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id1877498				0	id	Susunan (array) tidak bisa disarangkan.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id4262520				0	id	\<emph\>Contoh:\</emph\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id9387493				0	id	={1;2;3}				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id8207037				0	id	Sebuah susunan terdiri atas satu baris dengan tiga angka 1, 2, dan 3.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id6757103				0	id	To enter this array constant, you select three cells in a row, then you type the formula \<item type=\"input\"\>={1;2;3}\</item\> using the curly braces and the semicolons, then press \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+Shift+Enter.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id8868068				0	id	={1;2;3|4;5;6}				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id6626483				0	id	Sebuah susunan dengan dua baris masing-masing tiga angka.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id5262916				0	id	={0;1;2|FALSE;TRUE;"dua"}				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id1623889				0	id	Susunan data campuran.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id7781914				0	id	=SIN({1;2;3})				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id300912				0	id	Entered as a matrix formula, delivers the result of three SIN calculations with the arguments 1, 2, and 3.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3148660				0	id	Menyunting Rumus Susunan				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149241				0	id	Select the cell range or array containing the array formula. To select the whole array, position the cell cursor inside the array range, then press \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command \</caseinline\>\<defaultinline\>Ctrl \</defaultinline\>\</switchinline\>+ /, where / is the Division key on the numeric keypad.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3143274				0	id	Either press F2 or position the cursor in the input line. Both of these actions let you edit the formula.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154798				0	id	After you have made changes, press \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+Shift+Enter.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3150628				0	id	You can format the separate parts of an array. For example, you can change the font color. Select a cell range and then change the attribute you want.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3145608				0	id	Menyalin Rumus Susunan				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149585				0	id	Select the cell range or array containing the array formula.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154619				0	id	Either press F2 or position the cursor in the input line.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3150994				0	id	Copy the formula into the input line by pressing \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+C.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3146787				0	id	Select a range of cells where you want to insert the array formula and either press F2 or position the cursor in the input line.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3154419				0	id	Paste the formula by pressing \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+V in the selected space and confirm it by pressing \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+Shift+Enter. The selected range now contains the array formula.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3154834				0	id	Menyetel Jangkauan Susunan				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3148679				0	id	Apabila Anda hendak menyunting keluaran susunan (array), lakukan langkah berikut:				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3151102				0	id	Select the cell range or array containing the array formula.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3147096				0	id	Below the selection, to the right, you will see a small icon with which you can zoom in or out on the range using your mouse.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3150974				0	id	When you adjust the array range, the array formula will not automatically be adjusted. You are only changing the range in which the result will appear.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3146080				0	id	By holding down the \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command \</caseinline\>\<defaultinline\>Ctrl \</defaultinline\>\</switchinline\>key, you can create a copy of the array formula in the given range.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D47				0	id	Kalkulasi Susunan Berkondisi				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D4B				0	id	A conditional array calculation is an array or matrix formula that includes an IF() or CHOOSE() function. The condition argument in the formula is an area reference or a matrix result.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D4E				0	id	In the following example, the >0 test of the {=IF(A1:A3>0;"yes";"no")} formula is applied to each cell in the range A1:A3 and the result is copied to the corresponding cell.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10D65				0	id	A				20181231 09:50:43
