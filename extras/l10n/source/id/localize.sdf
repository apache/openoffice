helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148671				0	id	\<ahelp hid=\"HID_AAI_FUNC_NOMINAL\"\>Calculates the annual nominal rate of interest on the basis of the effective rate and the number of interest payments per annum.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155611				0	id	Sintaksis				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156157				0	id	NOMINAL_ADD(EffectiveRate; NPerY)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153777				0	id	\<emph\>EffectiveRate\</emph\> is the effective annual rate of interest.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150409				0	id	\<emph\>NPerY\</emph\> the number of interest payments per year.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3146789				0	id	Contoh				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145777				0	id	What is the nominal rate of interest for a 5.3543% effective rate of interest and quarterly payment.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156146				0	id	\<item type=\"input\"\>=NOMINAL_ADD(5.3543%;4)\</item\> returns 0.0525 or 5.25%.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3159087				0	id	\<bookmark_value\>fungsi DEC2HEX\</bookmark_value\>\<bookmark_value\>mengonversi;bilangan desimal, ke bilangan heksadesimal\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3159087				0	id	DOLLARFR				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150593				0	id	\<ahelp hid=\"HID_AAI_FUNC_DOLLARFR\"\>Converts a quotation that has been given as a decimal number into a mixed decimal fraction.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3151106				0	id	Sintaksis				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3152959				0	id	DOLLARFR(DecimalDollar; Fraction)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149558				0	id	\<emph\>DecimalDollar\</emph\> is a decimal number.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153672				0	id	\<emph\>Fraction\</emph\> is a whole number that is used as the denominator of the decimal fraction.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3156274				0	id	Contoh				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153795				0	id	\<item type=\"input\"\>=DOLLARFR(1.125;16)\</item\> converts into sixteenths. The result is 1.02 for 1 plus 2/16.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150995				0	id	\<item type=\"input\"\>=DOLLARFR(1.125;8)\</item\> converts into eighths. The result is 1.1 for 1 plus 1/8.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3154671				0	id	\<bookmark_value\>fractions; converting\</bookmark_value\>\<bookmark_value\>converting;decimal fractions, into decimal numbers\</bookmark_value\>\<bookmark_value\>DOLLARDE function\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154671				0	id	DOLLARDE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154418				0	id	\<ahelp hid=\"HID_AAI_FUNC_DOLLARDE\"\>Converts a quotation that has been given as a decimal fraction into a decimal number.\</ahelp\>				20181231 09:50:43
