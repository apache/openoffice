helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	bm_id3150991				0	id	\<bookmark_value\>fungsi EOMONTH\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	hd_id3150991				0	id	\<variable id=\"eomonth\"\>\<link href=\"text/scalc/01/func_eomonth.xhp\"\>EOMONTH\</link\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3152766	232			0	id	\<ahelp hid=\"HID_AAI_FUNC_EOMONTH\"\>Returns the date of the last day of a month which falls m\<emph\>onths\</emph\> away from the s\<emph\>tart date\</emph\>.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	hd_id3150597				0	id	Sintaksis				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3150351				0	id	EOMONTH(StartDate; Months)				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3146787				0	id	\<emph\>StartDate\</emph\> is a date (the starting point of the calculation).				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3155615				0	id	\<emph\>Months\</emph\> is the number of months before (negative) or after (positive) the start date.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	hd_id3156335				0	id	Contoh				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3154829				0	id	What is the last day of the month that falls 6 months after September 14 2001?				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3156143				0	id	\<item type=\"input\"\>=EOMONTH(DATE(2001;9;14);6)\</item\> returns the serial number 37346. Formatted as a date, this is 2002-03-31.				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_eomonth.xhp	0	help	par_id3156144				0	id	\<item type=\"input\"\>=EOMONTH("2001-09-14";6)\</item\> works as well. If the date is given as string, it has to be in ISO format.				20181231 09:50:43
