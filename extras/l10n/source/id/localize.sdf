helpcontent2	source\text\scalc\01\func_days360.xhp	0	help	hd_id3148555				0	id	\<variable id=\"days360\"\>\<link href=\"text/scalc/01/func_days360.xhp\"\>DAYS360\</link\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\func_days360.xhp	0	help	par_id3156032				0	id	\<ahelp hid=\"HID_FUNC_TAGE360\"\>Returns the difference between two dates based on the 360 day year used in interest calculations.\</ahelp\>				20181231 09:50:43
