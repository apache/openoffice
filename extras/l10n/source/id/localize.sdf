helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152651				0	id	\<bookmark_value\>fungsi SERIESSUM\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152651				0	id	SERIESSUM				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152688				0	id	\<ahelp hid=\".\"\>Sums the first terms of a power series.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152708				0	id	SERIESSUM(x;n;m;coefficients) = coefficient_1*x^n + coefficient_2*x^(n+m) + coefficient_3*x^(n+2m) +...+ coefficient_i*x^(n+(i-1)m)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152724				0	id	Sintaksis				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_idN11BD9				0	id	SERIESSUM(x; n; m; koefisien)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152737				0	id	\<emph\>X\</emph\> is the input value for the power series.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144344				0	id	\<emph\>N\</emph\> is the initial power				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144357				0	id	\<emph\>M\</emph\> is the increment to increase N				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144370				0	id	\<emph\>Coefficients\</emph\> is a series of coefficients. For each coefficient the series sum is extended by one section.				20181231 09:50:43
