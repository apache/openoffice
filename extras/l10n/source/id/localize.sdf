helpcontent2	source\text\scalc\01\12080300.xhp	0	help	hd_id3145786				0	id	Kolom				20181231 09:50:43
helpcontent2	source\text\scalc\01\12080300.xhp	0	help	par_id3146984				0	id	\<ahelp hid=\"HID_SC_GROUP_COLS\" visibility=\"visible\"\>Groups the selected columns.\</ahelp\>				20181231 09:50:43
