helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155802				0	id	COMBIN				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156172				0	id	\<ahelp hid=\"HID_FUNC_KOMBINATIONEN\"\>Returns the number of combinations for elements without repetition.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3156193				0	id	Sintaksis				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150223				0	id	COMBIN(Count1; Count2)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150313				0	id	\<emph\>Count1\</emph\> is the number of items in the set.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153830				0	id	\<emph\>Count2\</emph\> is the number of items to choose from the set.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6807458				0	id	COMBIN returns the number of ordered ways to choose these items. For example if there are 3 items A, B and C in a set, you can choose 2 items in 3 different ways, namely AB, AC and BC.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7414471				0	id	COMBIN implements the formula: Count1!/(Count2!*(Count1-Count2)!)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153171				0	id	Contoh				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153517				0	id	\<item type=\"input\"\>=COMBIN(3;2)\</item\> returns 3.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3150284				0	id	\<bookmark_value\>fungsi COMBINA\</bookmark_value\>\<bookmark_value\>banyaknya kombinasi dengan perulangan\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150284				0	id	COMBINA				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157894				0	id	\<ahelp hid=\"HID_FUNC_KOMBINATIONEN2\"\>Returns the number of combinations of a subset of items including repetitions.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145752				0	id	Sintaksis				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145765				0	id	COMBINA(Count1; Count2)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153372				0	id	\<emph\>Count1\</emph\> is the number of items in the set.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155544				0	id	\<emph\>Count2\</emph\> is the number of items to choose from the set.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1997131				0	id	COMBINA returns the number of unique ways to choose these items, where the order of choosing is irrelevant, and repetition of items is allowed. For example if there are 3 items A, B and C in a set, you can choose 2 items in 6 different ways, namely AA, AB, AC, BB, BC and CC.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2052064				0	id	COMBINA implements the formula: (Count1+Count2-1)! / (Count2!(Count1-1)!)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154584				0	id	Contoh				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152904				0	id	\<item type=\"input\"\>=COMBINA(3;2)\</item\> returns 6.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3156086				0	id	\<bookmark_value\>fungsi ROT13\</bookmark_value\>\<bookmark_value\>mengenkripsi teks\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3156086				0	id	TRUNC				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157866				0	id	\<ahelp hid=\"HID_FUNC_KUERZEN\"\>Truncates a number by removing decimal places.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3148499				0	id	Sintaksis				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148511				0	id	TRUNC(Number; Count)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150796				0	id	Returns \<emph\>Number\</emph\> with at most \<emph\>Count\</emph\> decimal places. Excess decimal places are simply removed, irrespective of sign.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150816				0	id	\<item type=\"literal\"\>TRUNC(Number; 0)\</item\> behaves as \<item type=\"literal\"\>INT(Number)\</item\> for positive numbers, but effectively rounds towards zero for negative numbers.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148548				0	id	The \<emph\>visible\</emph\> decimal places of the result are specified in \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - \<link href=\"text/shared/optionen/01060500.xhp\"\>%PRODUCTNAME Calc - Calculate\</link\>.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152555				0	id	Contoh				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152569				0	id	\<item type=\"input\"\>=TRUNC(1.239;2)\</item\> returns 1.23. The 9 is lost.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7050080				0	id	\<item type=\"input\"\>=TRUNC(-1.234999;3)\</item\> returns -1.234. All the 9s are lost.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3153601				0	id	\<bookmark_value\>fungsi LOG10\</bookmark_value\>\<bookmark_value\>logaritma basis 10\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153601				0	id	LN				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154974				0	id	\<ahelp hid=\"HID_FUNC_LN\"\>Returns the natural logarithm based on the constant e of a number.\</ahelp\> The constant e has a value of approximately 2.71828182845904.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154993				0	id	Sintaksis				20181231 09:50:43
