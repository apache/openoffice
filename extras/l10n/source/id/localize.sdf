helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147125	363			0	id	            \<emph\>Cost\</emph\> is the acquisition costs.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3151074	364			0	id	            \<emph\>DatePurchased\</emph\> is the date of acquisition.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3144765	365			0	id	            \<emph\>FirstPeriod \</emph\>is the end date of the first settlement period.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156286	366			0	id	            \<emph\>Salvage\</emph\> is the salvage value of the capital asset at the end of the depreciable life.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153415	367			0	id	            \<emph\>Period\</emph\> is the settlement period to be considered.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155064	368			0	id	\<emph\>Nilai\</emph\> adalah nilai yang akan diperiksa.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3153765				0	id	\<bookmark_value\>fungsi COMBIN\</bookmark_value\>\<bookmark_value\>banyaknya kombinasi\</bookmark_value\>				20181231 09:50:43
