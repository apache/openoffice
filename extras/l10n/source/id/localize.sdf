helpcontent2	source\text\swriter\01\01160300.xhp	0	help	par_id3149286	2			0	id	\<variable id=\"autoabstracttext\"\>\<ahelp hid=\".uno:CreateAbstract\"\>Menyalin heading pada dokumen aktif dan beberapa paragraf sesudahnya menjadi dokumen AutoAbstrak (Abstrak otomatis). AutoAbstrak digunakan untuk memperoleh gambaran global tentang dokumen yang besar.\</ahelp\> Anda bisa menentukan derajat kerangka dan jumlah paragraf yang menyertainya. Semua derajat kerangka dan paragraf lain akan disembunyikan. \</variable\>				20181231 09:50:43
helpcontent2	source\text\swriter\01\01160300.xhp	0	help	hd_id3147516				0	id	Derajat Kerangka Yang Terlibat				20181231 09:50:43
