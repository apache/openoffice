helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id8780785				0	id	BAHTTEXT(Angka)				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id1539353				0	id	            \<emph\>Number\</emph\> is any number. "Baht" is appended to the integral part of the number, and "Satang" is appended to the decimal part of the number.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id9694814				0	id	Contoh				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3289284				0	id	            \<item type=\"input\"\>=BAHTTEXT(12.65)\</item\> returns a string in Thai characters with the meaning of "Twelve Baht and sixty five Satang".				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3153072				0	id	\<bookmark_value\>fungsi BASE\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153072				0	id	BASE				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153289				0	id	\<ahelp hid=\"HID_FUNC_BASIS\"\>Converts a positive integer to a specified base into a text from the \<link href=\"text/shared/00/00000005.xhp#zahlensystem\" name=\"numbering system\"\>numbering system\</link\>.\</ahelp\> The digits 0-9 and the letters A-Z are used.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146097				0	id	Sintaksis				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155743				0	id	BASE(Number; Radix; [MinimumLength])				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151339	217			0	id	\<emph\>Nilai\</emph\> adalah nilai yang akan diperiksa.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3159262	218			0	id	            \<emph\>Radix\</emph\> indicates the base of the number system. It may be any positive integer between 2 and 36.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148746	219			0	id	            \<emph\>MinimumLength\</emph\> (optional) determines the minimum length of the character sequence that has been created. If the text is shorter than the indicated minimum length, zeros are added to the left of the string.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146323				0	id	Contoh				20181231 09:50:43
