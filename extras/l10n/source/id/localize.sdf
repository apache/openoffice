helpcontent2	source\text\shared\02\20090000.xhp	0	help	par_id3151299				0	id	\<ahelp hid=\".uno:CurrentTime\" visibility=\"visible\"\>Displays the current time.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\02\12040000.xhp	0	help	tit				0	id	Remove Filter/Sorting				20181231 09:50:43
helpcontent2	source\text\shared\02\12040000.xhp	0	help	hd_id3155069				0	id	\<link href=\"text/shared/02/12040000.xhp\" name=\"Remove Filter/Sorting\"\>Remove Filter/Sorting\</link\>				20181231 09:50:43
helpcontent2	source\text\shared\02\12040000.xhp	0	help	par_id3154094				0	id	\<ahelp hid=\".uno:RemoveFilterSort\" visibility=\"visible\"\>Cancels the filter settings and displays all of the records in the current table.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\02\12040000.xhp	0	help	par_id3146130				0	id	\<image src=\"res/commandimagelist/sc_removefilter.png\" id=\"img_id3151315\"\>\<alt id=\"alt_id3151315\"\>Ikon\</alt\>\</image\>				20181231 09:50:43
helpcontent2	source\text\shared\02\12040000.xhp	0	help	par_id3153750				0	id	Remove Filter/Sorting				20181231 09:50:43
helpcontent2	source\text\shared\02\02170000.xhp	0	help	tit				0	id	Background color/Paragraph background 				20181231 09:50:43
helpcontent2	source\text\shared\02\02170000.xhp	0	help	hd_id3154232				0	id	\<link href=\"text/shared/02/02170000.xhp\" name=\"Background Color\"\>Background Color\</link\>				20181231 09:50:43
helpcontent2	source\text\shared\02\02170000.xhp	0	help	par_id3149140				0	id	\<variable id=\"hintergrundfarbetext\"\>\<ahelp hid=\".\"\>Click to open a toolbar where you can click a background color for a paragraph. The color is applied to the background of the current paragraph or the selected paragraphs.\</ahelp\>\</variable\>				20181231 09:50:43
helpcontent2	source\text\shared\02\02170000.xhp	0	help	par_id3147276				0	id	\<image id=\"img_id3148538\" src=\"res/commandimagelist/sc_backgroundcolor.png\"\>\<alt id=\"alt_id3148538\"\>Ikon\</alt\>\</image\>				20181231 09:50:43
