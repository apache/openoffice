helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3149255				0	id	sEntry(6) = "Caca"				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3149565				0	id	sEntry(7) = "Susi"				20181231 09:50:43
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3145148				0	id	sEntry(8) = "Edi"				20181231 09:50:43
