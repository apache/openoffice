helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105A5				0	id	Use Outer Join syntax '{OJ }'				20181231 09:50:43
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105A9				0	id	\<ahelp hid=\".\"\>Use escape sequences for outer joins. The syntax for this escape sequence is {oj outer-join}\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105BE				0	id	Contoh:				20181231 09:50:43
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105C1				0	id	select Article.* from {oj item LEFT OUTER JOIN orders ON item.no=orders.ANR}				20181231 09:50:43
