helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156399	221			0	id	            \<item type=\"input\"\>=BASE(17;10;4)\</item\> returns 0017 in the decimal system.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3157871				0	id	\<bookmark_value\>sistem binari; konversi ke\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3157871	222			0	id	            \<item type=\"input\"\>=BASE(17;2)\</item\> returns 10001 in the binary system.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3145226				0	id	\<bookmark_value\>sistem heksadesimal; konversi ke\</bookmark_value\>				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145226	223			0	id	            \<item type=\"input\"\>=BASE(255;16;4)\</item\> returns 00FF in the hexadecimal system.				20181231 09:50:43
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149321				0	id	\<bookmark_value\>fungsi CHAR\</bookmark_value\>				20181231 09:50:43
