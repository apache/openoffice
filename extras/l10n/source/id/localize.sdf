helpcontent2	source\text\schart\01\type_stock.xhp	0	help	par_id9239173				0	id	Jumat				20181231 09:50:43
helpcontent2	source\text\schart\01\type_stock.xhp	0	help	par_id2656941				0	id	4600				20181231 09:50:43
