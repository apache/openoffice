helpcontent2	source\text\swriter\main0206.xhp	0	help	par_id3154277				0	id	\<ahelp hid=\"HID_NUM_TOOLBOX\"\>Baris \<emph\>Bulatan dan Penomoran\</emph\> memiliki sejumlah fungsi untuk mengubah struktur penomoran paragraf dokumen, termasuk mengubah urutan paragraf dan menentukan tingkat-tingkat penomoran yang berbeda.\</ahelp\>				20181231 09:50:43
helpcontent2	source\text\swriter\main0205.xhp	0	help	tit				0	id	Baris Properti Objek Menggambar				20181231 09:50:43
