helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157836				0	hi	उदाहरण				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152370				0	hi	\<item type=\"input\"\>=PI()\</item\> returns 3.14159265358979.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152418				0	hi	\<bookmark_value\>MULTINOMIAL function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152418				0	hi	MULTINOMIAL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152454				0	hi	\<ahelp hid=\"HID_AAI_FUNC_MULTINOMIAL\"\> Returns the factorial of the sum of the arguments divided by the product of the factorials of the arguments.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155646				0	hi	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155660				0	hi	MULTINOMIAL(Number(s))				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155673				0	hi	\<emph\>Number(s)\</emph\> is a list of up to 30 numbers.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155687				0	hi	उदाहरण				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155701				0	hi	\<item type=\"input\"\>=MULTINOMIAL(F11:H11)\</item\> returns 1260, if F11 to H11 contain the values \<item type=\"input\"\>2\</item\>, \<item type=\"input\"\>3\</item\> and \<item type=\"input\"\>4\</item\>. This corresponds to the formula =(2+3+4)! / (2!*3!*4!)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3155717				0	hi	\<bookmark_value\>POWER function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155717				0	hi	पावर				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159495				0	hi	\<ahelp hid=\"HID_FUNC_POTENZ\"\>Returns a number raised to another number.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3159513				0	hi	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159526				0	hi	POWER(Base; Exponent)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159540				0	hi	Returns \<emph\>Base\</emph\> raised to the power of \<emph\>Exponent\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5081637				0	hi	The same result may be achieved by using the exponentiation operator ^:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9759514				0	hi	\<item type=\"literal\"\>Base^Exponent\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3159580				0	hi	उदाहरण				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159594				0	hi	\<item type=\"input\"\>=POWER(4;3)\</item\> returns 64, which is 4 to the power of 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1614429				0	hi	=4^3 also returns 4 to the power of 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152651				0	hi	\<bookmark_value\>SERIESSUM function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152651				0	hi	SERIESSUM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152688				0	hi	\<ahelp hid=\".\"\>Sums the first terms of a power series.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152708				0	hi	SERIESSUM(x;n;m;coefficients) = coefficient_1*x^n + coefficient_2*x^(n+m) + coefficient_3*x^(n+2m) +...+ coefficient_i*x^(n+(i-1)m)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152724				0	hi	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_idN11BD9				0	hi	SERIESSUM(X; N; M; Coefficients)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152737				0	hi	\<emph\>X\</emph\> is the input value for the power series.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144344				0	hi	\<emph\>N\</emph\> is the initial power				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144357				0	hi	\<emph\>M\</emph\> is the increment to increase N				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144370				0	hi	\<emph\>Coefficients\</emph\> is a series of coefficients. For each coefficient the series sum is extended by one section.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144386				0	hi	\<bookmark_value\>PRODUCT function\</bookmark_value\>\<bookmark_value\>numbers;multiplying\</bookmark_value\>\<bookmark_value\>multiplying;numbers\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144386				0	hi	PRODUCT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144414				0	hi	\<ahelp hid=\"HID_FUNC_PRODUKT\"\>Multiplies all the numbers given as arguments and returns the product.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144433				0	hi	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144446				0	hi	PRODUCT(Number1; Number2; ...; Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144460				0	hi	\<emph\>Number1 to 30\</emph\> are up to 30 arguments whose product is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1589098				0	hi	PRODUCT returns number1 * number2 * number3 * ...				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144480				0	hi	उदाहरण				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144494				0	hi	\<item type=\"input\"\>=PRODUCT(2;3;4)\</item\> returns 24.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3160340				0	hi	\<bookmark_value\>SUMSQ function\</bookmark_value\>\<bookmark_value\>square number additions\</bookmark_value\>\<bookmark_value\>sums;of square numbers\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160340				0	hi	SUMSQ				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160368				0	hi	\<ahelp hid=\"HID_FUNC_QUADRATESUMME\"\>If you want to calculate the sum of the squares of numbers (totaling up of the squares of the arguments), enter these into the text fields.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160388				0	hi	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160402				0	hi	SUMSQ(Number1; Number2; ...; Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160415				0	hi	\<emph\>Number1 to 30\</emph\> are up to 30 arguments the sum of whose squares is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160436				0	hi	उदाहरण				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160449				0	hi	If you enter the numbers \<item type=\"input\"\>2\</item\>; \<item type=\"input\"\>3\</item\> and \<item type=\"input\"\>4\</item\> in the Number 1; 2 and 3 text boxes, 29 is returned as the result.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3158247				0	hi	\<bookmark_value\>MOD function\</bookmark_value\>\<bookmark_value\>remainders of divisions\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158247				0	hi	मोड				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158276				0	hi	\<ahelp hid=\"HID_FUNC_REST\"\>Returns the remainder when one integer is divided by another.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158294				0	hi	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158308				0	hi	MOD(Dividend; Divisor)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158321				0	hi	 For integer arguments this function returns Dividend modulo Divisor, that is the remainder when \<emph\>Dividend\</emph\> is divided by \<emph\>Divisor\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158341				0	hi	This function is implemented as \<item type=\"literal\"\>Dividend - Divisor * INT(Dividend/Divisor)\</item\> , and this formula gives the result if the arguments are not integer.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158361				0	hi	उदाहरण				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158374				0	hi	\<item type=\"input\"\>=MOD(22;3)\</item\> returns 1, the remainder when 22 is divided by 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1278420				0	hi	\<item type=\"input\"\>=MOD(11.25;2.5)\</item\> returns 1.25.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144592				0	hi	\<bookmark_value\>QUOTIENT function\</bookmark_value\>\<bookmark_value\>divisions\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144592				0	hi	QUOTIENT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144627				0	hi	\<ahelp hid=\"HID_AAI_FUNC_QUOTIENT\"\>Returns the integer part of a division operation.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144646				0	hi	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144659				0	hi	QUOTIENT(Numerator; Denominator)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9038972				0	hi	Returns the integer part of \<emph\>Numerator\</emph\> divided by \<emph\>Denominator\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7985168				0	hi	QUOTIENT is equivalent to \<item type=\"literal\"\>INT(numerator/denominator)\</item\>, except that it may report errors with different error codes.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144674				0	hi	उदाहरण				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144687				0	hi	\<item type=\"input\"\>=QUOTIENT(11;3)\</item\> returns 3. The remainder of 2 is lost.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144702				0	hi	\<bookmark_value\>RADIANS function\</bookmark_value\>\<bookmark_value\>converting;degrees, into radians\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144702				0	hi	RADIANS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158025				0	hi	\<ahelp hid=\"HID_FUNC_RAD\"\>Converts degrees to radians.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158042				0	hi	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158055				0	hi	RADIANS(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158069				0	hi	\<emph\>Number\</emph\> is the angle in degrees to be converted to radians.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id876186				0	hi	उदाहरण				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3939634				0	hi	\<item type=\"input\"\>=RADIANS(90)\</item\> returns 1.5707963267949, which is PI/2 to Calc's accuracy.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3158121				0	hi	\<bookmark_value\>ROUND function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158121				0	hi	ROUND				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158150				0	hi	\<ahelp hid=\"HID_FUNC_RUNDEN\"\>Rounds a number to a certain number of decimal places.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158169				0	hi	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158182				0	hi	ROUND(Number; Count)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158196				0	hi	Returns \<emph\>Number\</emph\> rounded to \<emph\>Count\</emph\> decimal places. If Count is omitted or zero, the function rounds to the nearest integer. If Count is negative, the function rounds to the nearest 10, 100, 1000, etc.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id599688				0	hi	This function rounds to the nearest number. See ROUNDDOWN and ROUNDUP for alternatives.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145863				0	hi	उदाहरण				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145876				0	hi	\<item type=\"input\"\>=ROUND(2.348;2)\</item\> returns 2.35				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145899				0	hi	\<item type=\"input\"\>=ROUND(-32.4834;3)\</item\> returns -32.483. Change the cell format to see all decimals.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1371501				0	hi	\<item type=\"input\"\>=ROUND(2.348;0)\</item\> returns 2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id4661702				0	hi	\<item type=\"input\"\>=ROUND(2.5)\</item\> returns 3. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7868892				0	hi	\<item type=\"input\"\>=ROUND(987.65;-2)\</item\> returns 1000.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3145991				0	hi	\<bookmark_value\>ROUNDDOWN function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145991				0	hi	ROUNDDOWN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146020				0	hi	\<ahelp hid=\"HID_FUNC_ABRUNDEN\"\>Rounds a number down, toward zero, to a certain precision.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146037				0	hi	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146051				0	hi	ROUNDDOWN(Number; Count)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146064				0	hi	Returns \<emph\>Number\</emph\> rounded down (towards zero) to \<emph\>Count\</emph\> decimal places. If Count is omitted or zero, the function rounds down to an integer. If Count is negative, the function rounds down to the next 10, 100, 1000, etc.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2188787				0	hi	This function rounds towards zero. See ROUNDUP and ROUND for alternatives.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163164				0	hi	उदाहरण				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163178				0	hi	\<item type=\"input\"\>=ROUNDDOWN(1.234;2)\</item\> returns 1.23.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5833307				0	hi	\<item type=\"input\"\>=ROUNDDOWN(45.67;0)\</item\> returns 45.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7726676				0	hi	\<item type=\"input\"\>=ROUNDDOWN(-45.67)\</item\> returns -45.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3729361				0	hi	\<item type=\"input\"\>=ROUNDDOWN(987.65;-2)\</item\> returns 900.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3163268				0	hi	\<bookmark_value\>ROUNDUP function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163268				0	hi	ROUNDUP				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163297				0	hi	\<ahelp hid=\"HID_FUNC_AUFRUNDEN\"\>Rounds a number up, away from zero, to a certain precision.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163315				0	hi	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163328				0	hi	ROUNDUP(Number; Count)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163342				0	hi	Returns \<emph\>Number\</emph\> rounded up (away from zero) to \<emph\>Count\</emph\> decimal places. If Count is omitted or zero, the function rounds up to an integer. If Count is negative, the function rounds up to the next 10, 100, 1000, etc.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9573961				0	hi	This function rounds away from zero. See ROUNDDOWN and ROUND for alternatives.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163381				0	hi	उदाहरण				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144786				0	hi	\<item type=\"input\"\>=ROUNDUP(1.1111;2)\</item\> returns 1.12.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7700430				0	hi	\<item type=\"input\"\>=ROUNDUP(1.2345;1)\</item\> returns 1.3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1180455				0	hi	\<item type=\"input\"\>=ROUNDUP(45.67;0)\</item\> returns 46.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3405560				0	hi	\<item type=\"input\"\>=ROUNDUP(-45.67)\</item\> returns -46.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3409527				0	hi	\<item type=\"input\"\>=ROUNDUP(987.65;-2)\</item\> returns 1000.				20200411 15:09:53
