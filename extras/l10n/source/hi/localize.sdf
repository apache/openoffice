helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147286				0	hi	REPLACE("Text"; Position; Length; "NewText")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149797	27			0	hi	            \<emph\>Text\</emph\> refers to text of which a part will be replaced.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3166451	28			0	hi	            \<emph\>Position\</emph\> refers to the position within the text where the replacement will begin.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156040	29			0	hi	            \<emph\>Length\</emph\> is the number of characters in \<emph\>Text\</emph\> to be replaced.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3159188	30			0	hi	            \<emph\>NewText\</emph\> refers to the text which replaces \<emph\>Text\</emph\>.				20200411 15:09:53
