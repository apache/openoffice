uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_LOCKING_LOCKED & ERRCODE_RES_MASK)			1	hi	फ़ाइल $(ARG1) किसी अन्य उपयोगकर्ता द्वारा बंद कर दिया है। वर्तमान में, इस फाइल को एक और लेखन अधिकार नहीं दी जा सकती।				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_LOCKING_LOCKED_SELF & ERRCODE_RES_MASK)			1	hi	फ़ाइल $(ARG1) वर्तमान में आपके द्वारा है। वर्तमान में, इस फाइल को एक और लेखन अधिकार नहीं दी जा सकती।				20200411 15:09:53
