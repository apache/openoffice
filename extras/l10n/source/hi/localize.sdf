helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id956834773				0	hi	e([:digit:])?    -- finds 'e' followed by zero or one digit. Note that currently all named character classes like [:digit:] must be enclosed in parentheses.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id952368773				0	hi	^([:digit:])$    -- finds lines or cells with exactly one digit.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9568773				0	hi	You can combine the search terms to form complex searches.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	hd_id71413				0	hi	To find three-digit numbers alone in a paragraph				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id2924283				0	hi	^[:digit:]{3}$				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id5781731				0	hi	^ means the match has to be at the start of a paragraph, 				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id6942045				0	hi	[:digit:] matches any decimal digit, 				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id4721823				0	hi	{3} means there must be exactly 3 copies of "digit", 				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id5806756				0	hi	$ means the match must end a paragraph. 				20200411 15:09:53
