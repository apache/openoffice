helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E2D				0	hi	2				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E34				0	hi	2				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E3A				0	hi	=A1:A2+1				20200411 15:09:53
