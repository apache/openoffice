helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154943				0	hi	\<variable id=\"mathematiktext\"\>This category contains the \<emph\>Mathematical\</emph\> functions for Calc.\</variable\> To open the \<emph\>Function Wizard\</emph\>, choose \<link href=\"text/scalc/01/04060000.xhp\" name=\"Insert - Function\"\>\<emph\>Insert - Function\</emph\>\</link\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3146944				0	hi	\<bookmark_value\>ABS function\</bookmark_value\>\<bookmark_value\>absolute values\</bookmark_value\>\<bookmark_value\>values;absolute\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146944				0	hi	ABS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154546				0	hi	\<ahelp hid=\"HID_FUNC_ABS\"\>Returns the absolute value of a number.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154843				0	hi	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147475				0	hi	ABS(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148438				0	hi	\<emph\>Number\</emph\> is the number whose absolute value is to be calculated. The absolute value of a number is its value without the +/- sign.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155823				0	hi	उदाहरण				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152787				0	hi	\<item type=\"input\"\>=ABS(-56)\</item\> returns 56.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148752				0	hi	\<item type=\"input\"\>=ABS(12)\</item\> returns 12.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id320139				0	hi	\<item type=\"input\"\>=ABS(0)\</item\> returns 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3150896				0	hi	\<bookmark_value\>COUNTBLANK function\</bookmark_value\>\<bookmark_value\>counting;empty cells\</bookmark_value\>\<bookmark_value\>empty cells;counting\</bookmark_value\>				20200411 15:09:53
