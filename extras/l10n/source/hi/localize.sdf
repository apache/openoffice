helpcontent2	source\text\shared\01\06050600.xhp	0	help	par_id6081728				0	hi	\<ahelp hid=\".\"\>Enter the distance from the left page margin to the start of all lines in the numbered paragraph that follow the first line.\</ahelp\>				20200411 15:09:53
