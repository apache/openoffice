uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_IO_BROKENPACKAGE & ERRCODE_RES_MASK)			1	hi	फ़ाइल '$(ARG1)' दूषित है और इसलिये खोला नहीं जा सकता है। क्या %PRODUCTNAME फ़ाइल को मरम्मत करनी चाहिए?\n\nयह दूषण दस्तावेज़ के साथ छेड़ छाड़ से भी हो सकती है या संरचनात्मक दस्तावेज़ क्षति के कारण आंकड़ा प्रेषण के वजह से।\n\nहमारी सलाह है कि मरम्मत किए गए दस्तावेज की सामग्री पर भरोसा मत करें।\nइस दस्तावेज के लिए मैक्रो का अपवाद निष्क्रिय किया जाता है।\n\nक्या %PRODUCTNAME को फ़ाइल की मरम्मत करनी चाहिए?\n				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_IO_BROKENPACKAGE_CANTREPAIR & ERRCODE_RES_MASK)			1	hi	फ़ाइल '$(ARG1)' की मरम्मत नहीं की जा सकी और इसलिये नहीं खोली जा सकी।				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_CONFIGURATION_BROKENDATA_NOREMOVE & ERRCODE_RES_MASK)			1	hi	'$(ARG1)' में विन्यास आँकड़ा खराब है। बिना इस आँकड़ा कुछ प्रकार्य अच्छा से कार्य नहीं कर सकता है।\nक्या आप %PRODUCTNAME का आरंभन जारी रखना चाहते हैं बिना खराब विन्यास आँकड़ा के?				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_CONFIGURATION_BROKENDATA_WITHREMOVE & ERRCODE_RES_MASK)			1	hi	निजी विन्यास फ़ाइल '$(ARG1)' खराब है और जारी रखने के लिए जरूर मिटाया जाना चाहिए। आपका कुछ निजी विन्यास नष्ट हो सकता है।\nक्या आप %PRODUCTNAME का आरंभन जारी रखना चाहते हैं बिना खराब विन्यास आँकड़ा के?				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_CONFIGURATION_BACKENDMISSING & ERRCODE_RES_MASK)			1	hi	विन्यास आँकड़ा स्रोत '$(ARG1)' अनुपलब्ध है। बिना इस आँकड़ा के कुछ फंक्शन ठीक से काम नहीं कर सकता है।				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_CONFIGURATION_BACKENDMISSING_WITHRECOVER & ERRCODE_RES_MASK)			1	hi	विन्यास आँकड़ा स्रोत '$(ARG1)' मौजूद नही है। बिना इस आँकड़ा कुछ प्रकार्य ठीक से काम नही कर सकता है।\nक्या आप %PRODUCTNAME का आरंभन जारी रखना चाहते हैं बिना विन्यास आँकड़ा को छोड़े?				20200411 15:09:53
