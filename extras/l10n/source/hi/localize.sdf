helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3159198				0	hi	\<item type=\"input\"\>=CELL("ADDRESS";Sheet3.D2)\</item\> returns $Sheet3.$D$2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150245				0	hi	\<item type=\"input\"\>=CELL("ADDRESS";'X:\\dr\\test.sxc'#$Sheet1.D2)\</item\> returns 'file:///X:/dr/test.sxc'#$Sheet1.$D$2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3146811				0	hi	FILENAME				20200411 15:09:53
