helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155849				0	hi	\<item type=\"input\"\>=PHI(2.25) \</item\>= 0.03				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3143236				0	hi	\<item type=\"input\"\>=PHI(-2.25)\</item\> = 0.03				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149286				0	hi	\<item type=\"input\"\>=PHI(0)\</item\> = 0.4				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153985				0	hi	\<bookmark_value\>POISSON function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153985				0	hi	POISSON				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154298				0	hi	\<ahelp hid=\"HID_FUNC_POISSON\"\>Returns the Poisson distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3159183				0	hi	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146093				0	hi	POISSON(Number; Mean; C)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147253				0	hi	\<emph\>Number\</emph\> represents the value based on which the Poisson distribution is calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151177				0	hi	\<emph\>Mean\</emph\> represents the middle value of the Poisson distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149200				0	hi	\<emph\>C\</emph\> (optional) = 0 or False calculates the density function; \<emph\>C\</emph\> = 1 or True calculates the distribution. When omitted, the default value True is inserted when you save the document, for best compatibility with other programs and older versions of %PRODUCTNAME.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3159347				0	hi	उदाहरण				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150113				0	hi	\<item type=\"input\"\>=POISSON(60;50;1)\</item\> returns 0.93.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153100				0	hi	\<bookmark_value\>PERCENTILE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153100				0	hi	PERCENTILE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154940				0	hi	\<ahelp hid=\"HID_FUNC_QUANTIL\"\>Returns the alpha-percentile of data values in an array.\</ahelp\> A percentile returns the scale value for a data series which goes from the smallest (Alpha=0) to the largest value (alpha=1) of a data series. For \<item type=\"literal\"\>Alpha\</item\> = 25%, the percentile means the first quartile; \<item type=\"literal\"\>Alpha\</item\> = 50% is the MEDIAN.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150531				0	hi	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148813				0	hi	PERCENTILE(Data; Alpha)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153054				0	hi	\<emph\>Data\</emph\> represents the array of data.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154212				0	hi	\<emph\>Alpha\</emph\> represents the percentage of the scale between 0 and 1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154290				0	hi	उदाहरण				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159147				0	hi	\<item type=\"input\"\>=PERCENTILE(A1:A50;0.1)\</item\> represents the value in the data set, which equals 10% of the total data scale in A1:A50.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148807				0	hi	\<bookmark_value\>PERCENTRANK function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148807				0	hi	PERCENTRANK				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153573				0	hi	\<ahelp hid=\"HID_FUNC_QUANTILSRANG\"\>Returns the percentage rank of a value in a sample.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147512				0	hi	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147238				0	hi	PERCENTRANK(Data; Value)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154266				0	hi	\<emph\>Data\</emph\> represents the array of data in the sample.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148475				0	hi	\<emph\>Value\</emph\> represents the value whose percentile rank must be determined.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155364				0	hi	उदाहरण				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149163				0	hi	\<item type=\"input\"\>=PERCENTRANK(A1:A50;50)\</item\> returns the percentage rank of the value 50 from the total range of all values found in A1:A50. If 50 falls outside the total range, an error message will appear.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3166442				0	hi	\<bookmark_value\>QUARTILE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3166442				0	hi	QUARTILE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146958				0	hi	\<ahelp hid=\"HID_FUNC_QUARTILE\"\>Returns the quartile of a data set.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152942				0	hi	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153684				0	hi	QUARTILE(Data; Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153387				0	hi	\<emph\>Data\</emph\> represents the array of data in the sample.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155589				0	hi	\<emph\>Type\</emph\> represents the type of quartile. (0 = MIN, 1 = 25%, 2 = 50% (MEDIAN), 3 = 75% and 4 = MAX.)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149103				0	hi	उदाहरण				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159276				0	hi	\<item type=\"input\"\>=QUARTILE(A1:A50;2)\</item\> returns the value of which 50% of the scale corresponds to the lowest to highest values in the range A1:A50.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	tit				0	hi	Hyphenation				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	bm_id3159399				0	hi	\<bookmark_value\>automatic hyphenation in spreadsheets\</bookmark_value\>\<bookmark_value\>hyphenation; in spreadsheets\</bookmark_value\>\<bookmark_value\>syllables in spreadsheets\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	hd_id3159399				0	hi	Hyphenation				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3145068	2			0	hi	\<variable id=\"silben\"\>\<ahelp hid=\".uno:Hyphenate\"\>The \<emph\>Hyphenation \</emph\>command calls the dialog for setting the hyphenation in $[officename] Calc.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3154366				0	hi	You can only turn on the automatic hyphenation in $[officename] Calc when the \<link href=\"text/shared/01/05340300.xhp\" name=\"row break\"\>row break\</link\> feature is active.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	hd_id3153192				0	hi	चयनित कक्षों के लिए हायफ़नेशन.				20200411 15:09:53
