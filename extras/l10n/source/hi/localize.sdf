helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3145217				0	hi	b = रिक्त. रिक्त कक्ष				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155176				0	hi	l = लेबल. पाठ, पाठ के रूप में सूत्र का परिणाम				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3147280				0	hi	v = मूल्य. मूल्य, संख्या के रुप में सूत्र का परिणाम				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156348				0	hi	WIDTH				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154920				0	hi	Returns the width of the referenced column. The unit is the number of zeros (0) that fit into the column in the default text and the default size.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3152355				0	hi	PREFIX				20200411 15:09:53
