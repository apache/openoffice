helpcontent2	source\text\sbasic\shared\03120101.xhp	0	help	hd_id3147242				0	hi	वापसी मूल्य:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120101.xhp	0	help	par_id3150669				0	hi	पूर्णांक				20200411 15:09:53
