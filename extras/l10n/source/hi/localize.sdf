helpcontent2	source\text\scalc\01\06060000.xhp	0	help	hd_id3148946				0	hi	\<link href=\"text/scalc/01/06060000.xhp\" name=\"Protect Document\"\>Protect Document\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060000.xhp	0	help	par_id3153362	2			0	hi	The\<emph\> Protect Document \</emph\>command prevents changes from being made to cells in the sheets or to sheets in a document. As an option, you can define a password. If a password is defined, removal of the protection is only possible if the user enters the correct password.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060000.xhp	0	help	hd_id3147228				0	hi	\<link href=\"text/scalc/01/06060100.xhp\" name=\"Sheets\"\>Sheets\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060000.xhp	0	help	hd_id3153768				0	hi	\<link href=\"text/scalc/01/06060200.xhp\" name=\"Documents\"\>Documents\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06060000.xhp	0	help	par_idN10622				0	hi	\<embedvar href=\"text/scalc/guide/cell_protect.xhp#cell_protect\"/\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	tit				0	hi	Fill Series				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3148664				0	hi	Fill Series				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3148797				0	hi	\<variable id=\"reihenfuellentext\"\>\<ahelp hid=\".uno:FillSeries\"\>Automatically generate series with the options in this dialog. Determine direction, increment, time unit and series type.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3146976				0	hi	किसी श्रेणी को भरने से पहले, कक्ष क्षेत्रसीमा चुनें.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3145748				0	hi	To automatically continue a series using the assumed completion rules, choose the \<emph\>AutoFill\</emph\> option after opening the \<emph\>Fill Series\</emph\> dialog.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3147435				0	hi	दिशा				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3154729				0	hi	श्रेणी तैयार करने की दिशा निर्धारित करता है.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3145253				0	hi	Down				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3155418				0	hi	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_BOTTOM\"\>Creates a downward series in the selected cell range for the column using the defined increment to the end value.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3155738				0	hi	Right				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3149402				0	hi	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_RIGHT\"\>Creates a series running from left to right within the selected cell range using the defined increment to the end value.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3146972				0	hi	Up				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3153711				0	hi	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_TOP\"\>Creates an upward series in the cell range of the column using the defined increment to the end value.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3153764				0	hi	Left				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3156382				0	hi	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_LEFT\"\>Creates a series running from right to left in the selected cell range using the defined increment to the end value.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3147344				0	hi	श्रेणी क़िस्म				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3149257	15			0	hi	Defines the series type. Choose between \<emph\>Linear, Growth, Date \</emph\>and \<emph\>AutoFill\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3148488				0	hi	लीनियर				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3159238				0	hi	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_ARITHMETIC\"\>Creates a linear number series using the defined increment and end value.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3149210				0	hi	बढ़त				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3150364				0	hi	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_GEOMETRIC\"\>Creates a growth series using the defined increment and end value.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3149528				0	hi	डाटा				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3150887				0	hi	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_DATE\"\>Creates a date series using the defined increment and end date.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3150202				0	hi	स्वतः भरें				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3156288				0	hi	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_AUTOFILL\"\>Forms a series directly in the sheet.\</ahelp\> The AutoFill function takes account of customized lists. For example, by entering \<emph\>January\</emph\> in the first cell, the series is completed using the list defined under \<emph\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - %PRODUCTNAME Calc - Sort Lists\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3155811				0	hi	AutoFill tries to complete a value series by using a defined pattern. The series 1,3,5 is automatically completed with 7,9,11,13, and so on. Date and time series are completed accordingly; for example, after 01.01.99 and 15.01.99, an interval of 14 days is used.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3148700				0	hi	समय की इकाई				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3153308				0	hi	In this area you can specify the desired unit of time. This area is only active if the \<emph\>Date\</emph\> option has been chosen in the \<emph\>Series type\</emph\> area.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3148868				0	hi	दिन				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3148605				0	hi	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_DAY\"\>Use the \<emph\>Date\</emph\> series type and this option to create a series using seven days.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3144771				0	hi	सप्ताह के दिन				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3150108				0	hi	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_DAY_OF_WEEK\"\>Use the \<emph\>Date\</emph\> series type and this option to create a series of five day sets.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3154957				0	hi	महीना				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3149126				0	hi	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_MONTH\"\>Use the \<emph\>Date\</emph\> series type and this option to form a series from the names or abbreviations of the months.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3152870				0	hi	वर्ष				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3151300				0	hi	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_YEAR\"\>Use the \<emph\>Date\</emph\> series type and this option to create a series of years.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3154762				0	hi	प्रारंभ मूल्य				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3149381				0	hi	\<ahelp hid=\"SC:EDIT:RID_SCDLG_FILLSERIES:ED_START_VALUES\"\>Determines the start value for the series.\</ahelp\> Use numbers, dates or times.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3153013				0	hi	अंतिम मूल्य				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3153487				0	hi	\<ahelp hid=\"SC:EDIT:RID_SCDLG_FILLSERIES:ED_END_VALUES\"\>Determines the end value for the series.\</ahelp\> Use numbers, dates or times.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3149312				0	hi	वृद्धि				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3154739				0	hi	The term "increment" denotes the amount by which a given value increases.\<ahelp hid=\"SC:EDIT:RID_SCDLG_FILLSERIES:ED_INCREMENT\"\> Determines the value by which the series of the selected type increases by each step.\</ahelp\> Entries can only be made if the linear, growth or date series types have been selected.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140100.xhp	0	help	tit				0	hi	Down				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140100.xhp	0	help	hd_id3150792				0	hi	\<link href=\"text/scalc/01/02140100.xhp\" name=\"Down\"\>Down\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140100.xhp	0	help	par_id3153969				0	hi	\<ahelp hid=\".uno:FillDown\" visibility=\"visible\"\>Fills a selected range of at least two rows with the contents of the top cell of the range.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140100.xhp	0	help	par_id3145787				0	hi	If a selected range has only one column, the contents of the top cell are copied to all others. If several columns are selected, the contents of the corresponding top cell will be copied down.				20200411 15:09:53
