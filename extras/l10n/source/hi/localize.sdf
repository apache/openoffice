helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3083285	44			0	hi	           \<item type=\"input\"\>=AND(A;B)\</item\> returns FALSE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3083444	45			0	hi	            \<item type=\"input\"\>=OR(A;B)\</item\> returns TRUE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060105.xhp	0	help	par_id3154314	46			0	hi	            \<item type=\"input\"\>=NOT(AND(A;B))\</item\> returns TRUE				20200411 15:09:53
