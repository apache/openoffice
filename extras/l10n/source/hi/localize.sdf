helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155758				0	hi	उदाहरण				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154621	245			0	hi	            \<item type=\"input\"\>=ARABIC("MXIV")\</item\> returns 1014				20200411 15:09:53
