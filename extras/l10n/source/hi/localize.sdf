helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3145166				0	hi	\<bookmark_value\>DECIMAL function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3145166				0	hi	DECIMAL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156361				0	hi	\<ahelp hid=\"HID_FUNC_DEZIMAL\"\>Converts text with characters from a \<link href=\"text/shared/00/00000005.xhp#zahlensystem\" name=\"number system\"\>number system\</link\> to a positive integer in the base radix given.\</ahelp\> The radix must be in the range 2 to 36. Spaces and tabs are ignored. The \<emph\>Text\</emph\> field is not case-sensitive.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3157994				0	hi	If the radix is 16, a leading x or X or 0x or 0X, and an appended h or H, is disregarded. If the radix is 2, an appended b or B is disregarded. Other characters that do not belong to the number system generate an error.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150014				0	hi	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154328				0	hi	DECIMAL("Text"; Radix)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150128	230			0	hi	            \<emph\>Text\</emph\> is the text to be converted. To differentiate between a hexadecimal number, such as A1 and the reference to cell A1, you must place the number in quotation marks, for example, "A1" or "FACE".				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145241	231			0	hi	            \<emph\>Radix\</emph\> indicates the base of the number system. It may be any positive integer between 2 and 36.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3156062				0	hi	उदाहरण				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145355	233			0	hi	            \<item type=\"input\"\>=DECIMAL("17";10)\</item\> returns 17.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155622	234			0	hi	            \<item type=\"input\"\>=DECIMAL("FACE";16)\</item\> returns 64206.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151015	235			0	hi	            \<item type=\"input\"\>=DECIMAL("0101";2)\</item\> returns 5.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3148402				0	hi	\<bookmark_value\>DOLLAR function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148402				0	hi	DOLLAR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153049	12			0	hi	\<ahelp hid=\"HID_FUNC_DM\"\>Converts a number to an amount in the currency format, rounded to a specified decimal place.\</ahelp\> In the \<item type=\"literal\"\>Value\</item\> field enter the number to be converted to currency. Optionally, you may enter the number of decimal places in the \<item type=\"literal\"\>Decimals\</item\> field. If no value is specified, all numbers in currency format will be displayed with two decimal places. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151280				0	hi	अपने तंत्र विन्यास में करंसी फ़ॉर्मेट सेट करें.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150569				0	hi	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154188				0	hi	DOLLAR(Value; Decimals)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145299	15			0	hi	            \<emph\>Value\</emph\> is a number, a reference to a cell containing a number, or a formula which returns a number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145629	16			0	hi	            \<emph\>Decimals\</emph\> is the optional number of decimal places.				20200411 15:09:53
