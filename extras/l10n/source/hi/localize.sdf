uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_LOCKING_LOCK_EXPIRED & ERRCODE_RES_MASK)			1	hi	फ़ाइल $(ARG1) के लिए पहले से प्राप्त ताला समाप्त हो गया है।\nयह ताला प्रबंध सर्वर पर समस्याओं के कारण हो सकता है। इस फ़ाइल पर लेखन कार्रवाई अन्य उपयोगकर्ताओं द्वारा किया परिवर्तनों को अधिलेखित नहीं होगा इसकि गारंटी नहीं दिया जा सकता है!				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_UNKNOWNAUTH_UNTRUSTED)			1	hi	साइट $(ARG1) की पहचान सत्यापित करने में असमर्थ।\n\nइस प्रमाण पत्र को स्वीकार करने से पहले, आपको ध्यान से इस साइट के प्रमाणपत्र की जांच करनी चाहिए। आप वेबसाइट $(ARG1) की पहचान करने के उद्देश्य के लिए इस प्रमाणपत्र को स्वीकार करने के लिए तैयार हैं?				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_SSLWARN_EXPIRED_1)			1	hi	$(ARG1) एक साइट है जो एक सुरक्षा प्रमाणपत्र प्रयोग करता है प्रेषण के समय आँकड़ा गोपित करने के लिए, लेकिन इसके प्रमाणपत्र $(ARG2) पर खतम होता है.\n\nआपको सुनिश्चित करने के लिए जाँच कर लेनी चाहिए कि आपके कंप्यूटर का समय सही है।				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_SSLWARN_DOMAINMISMATCH_1)			1	hi	आपने $(ARG1) के साथ संयोजन स्थापित करने की कोशिश की है। लेकिन, प्रस्तुत सुरक्षा प्रमाणपत्र $(ARG2) का हिस्सा है। यह संभव है, लेकिन बहुत कम, कि कोई इस वेब साइट की मदद से आपके संचार को बाधा पहुंचाने की कोशिश कर रहा है।\n\nयदि आपको संदेह है कि दिखाया प्रमाणपत्र $(ARG1) का नहीं अवयव है, कृपया संयोजन रद्द करें और प्रशासक को बताएँ।\n\nक्या आप किसी तरह से जारी रखना चाहेंगे?				20200411 15:09:53
uui	source\ids.src	0	string	RID_UUI_ERRHDL	(ERRCODE_UUI_SSLWARN_INVALID_1)			1	hi	प्रमाणपत्र को वैधीकृत नहीं किया जा सका। आपकी इस साइट के प्रमाणपत्र ध्यान से जाँच लेनी चाहिए।\n\nयदि आप दिखाए प्रमाणपत्र पर भरोसा नहीं रखते हैं, कृपया संयोजन रद्द करें और प्रशासक को बताएँ।				20200411 15:09:53
