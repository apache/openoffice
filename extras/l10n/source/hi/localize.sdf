helpcontent2	source\text\shared\01\06010600.xhp	0	help	bm_id49745				0	hi	\<bookmark_value\>Chinese writing systems\</bookmark_value\>\<bookmark_value\>simplified Chinese;conversion to traditional Chinese\</bookmark_value\>\<bookmark_value\>traditional Chinese;conversion to simplified Chinese\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10547				0	hi	\<link href=\"text/shared/01/06010600.xhp\"\>Chinese Conversion\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10557				0	hi	\<ahelp hid=\".\"\>Converts the selected Chinese text from one Chinese writing system to the other. If no text is selected, the entire document is converted.\</ahelp\> You can only use this command if you enable Asian language support in \<emph\>Tools - Options - Language Settings - Languages\</emph\>.				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10572				0	hi	Conversion direction				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10576				0	hi	\<ahelp hid=\".\"\>Select the conversion direction.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10579				0	hi	Traditional Chinese to Simplified Chinese				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1057D				0	hi	\<ahelp hid=\".\"\>Converts traditional Chinese text characters to simplified Chinese text characters. Click \<emph\>OK\</emph\> to convert the selected text. If no text is selected, the whole document is converted.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10580				0	hi	Simplified Chinese to Traditional Chinese				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10584				0	hi	\<ahelp hid=\".\"\>Converts simplified Chinese text characters to traditional Chinese text characters. Click \<emph\>OK\</emph\> to convert the selected text. If no text is selected, the whole document is converted.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1058E				0	hi	सामान्य पद				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10592				0	hi	\<ahelp hid=\".\"\>Common terms are words that have the same meaning in traditional and simplified Chinese but are written with different characters.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10595				0	hi	Convert Common Terms				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10599				0	hi	\<ahelp hid=\".\"\>Converts words with two or more characters that are in the list of common terms. After the list is scanned, the remaining text is converted character by character.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1059C				0	hi	पद संपादित करें				20200411 15:09:53
