helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3143220				0	hi	\<ahelp hid=\"HID_DAI_FUNC_DAYSINYEAR\"\>Calculates the number of days of the year in which the date entered occurs.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3145358				0	hi	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3154651				0	hi	DAYSINYEAR(तारीख़)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153803				0	hi	\<emph\>Date\</emph\> is any date in the respective year. The Date parameter must be a valid date according to the locale settings of %PRODUCTNAME.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3153487				0	hi	उदाहरण				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153811				0	hi	=DAYSINYEAR(A1) returns 366 days if A1 contains 1968-02-29, a valid date for the year 1968.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3154737				0	hi	\<bookmark_value\>DAYSINMONTH function\</bookmark_value\>\<bookmark_value\>number of days;in a specific month of a year\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3154737				0	hi	DAYSINMONTH				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3149316				0	hi	\<ahelp hid=\"HID_DAI_FUNC_DAYSINMONTH\"\>Calculates the number of days of the month in which the date entered occurs.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3145114				0	hi	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150955				0	hi	DAYSINMONTH(तारीख़)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3147501				0	hi	\<emph\>Date\</emph\> is any date in the respective month of the desired year. The Date parameter must be a valid date according to the locale settings of %PRODUCTNAME.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3149871				0	hi	उदाहरण				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3155742				0	hi	=DAYSINMONTH(A1) returns 29 days if A1 contains 1968-02-17, a valid date for February 1968.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3149048				0	hi	\<bookmark_value\>WEEKS function\</bookmark_value\>\<bookmark_value\>number of weeks;between two dates\</bookmark_value\>				20200411 15:09:53
