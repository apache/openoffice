helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156133				0	hi	PEARSON(Data1; Data2)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151272				0	hi	\<emph\>Data1\</emph\> represents the array of the first data set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153279				0	hi	\<emph\>Data2\</emph\> represents the array of the second data set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147567				0	hi	उदाहरण				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151187				0	hi	\<item type=\"input\"\>=PEARSON(A1:A30;B1:B30)\</item\> returns the Pearson correlation coefficient of both data sets.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3152806				0	hi	\<bookmark_value\>PHI function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152806				0	hi	PHI				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150254				0	hi	\<ahelp hid=\"HID_FUNC_PHI\"\>Returns the values of the distribution function for a standard normal distribution.\</ahelp\>				20200411 15:09:53
