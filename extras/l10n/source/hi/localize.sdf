helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3938413				0	hi	\<emph\>Year\</emph\> is an integer between 1583 and 9956 or 0 and 99. You can also calculate other holidays by simple addition with this date.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3156156				0	hi	Easter Monday = EASTERSUNDAY(Year) + 1				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3147521				0	hi	Good Friday = EASTERSUNDAY(Year) - 2				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3146072				0	hi	Pentecost Sunday = EASTERSUNDAY(Year) + 49				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3149553				0	hi	Pentecost Monday = EASTERSUNDAY(Year) + 50				20200411 15:09:53
