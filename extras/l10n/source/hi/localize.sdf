helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3149879				0	hi	\<bookmark_value\>NEGBINOMDIST function\</bookmark_value\>\<bookmark_value\>negative binomial distribution\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149879				0	hi	NEGBINOMDIST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155437				0	hi	\<ahelp hid=\"HID_FUNC_NEGBINOMVERT\"\>Returns the negative binomial distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3145351				0	hi	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150935				0	hi	NEGBINOMDIST(X; R; SP)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153044				0	hi	\<emph\>X\</emph\> represents the value returned for unsuccessful tests.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151018				0	hi	\<emph\>R\</emph\> represents the value returned for successful tests.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148878				0	hi	\<emph\>SP\</emph\> is the probability of the success of an attempt.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149539				0	hi	उदाहरण				20200411 15:09:53
