helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3150603				0	hi	\<ahelp hid=\".\"\>Trims or scales the selected graphic. You can also restore the graphic to its original size.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3148585				0	hi	Crop				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3152372				0	hi	इस क्षेत्र का इस्तेमाल चयनित चित्र को छोटा या बड़ा करने या चित्र के चारों ओर श्वेत स्थान भरने के लिए करें.				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3145669				0	hi	स्केल रखे रहें				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3149346				0	hi	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_GRFCROP_RB_ZOOMCONST\"\>Maintains the original scale of the graphic when you crop, so that only the size of the graphic changes.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3156426				0	hi	छवि आकार रखे रहें				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3155892				0	hi	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_GRFCROP_RB_SIZECONST\"\>Maintains the original size of the graphic when you crop, so that only the scale of the graphic changes. To reduce the scale of the graphic, select this option and enter negative values in the cropping boxes. To increase the scale of the graphic, enter positive values in the cropping boxes.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3153683				0	hi	Left				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3145313				0	hi	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_LEFT\"\>If the \<emph\>Keep Scale\</emph\> option is selected, enter a positive amount to trim the left edge of the graphic, or a negative amount to add white space to the left of the graphic. If the \<emph\>Keep image size\</emph\> option is selected, enter a positive amount to increase the horizontal scale of the graphic, or a negative amount to decrease the horizontal scale of the graphic.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3163803				0	hi	Right				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3145382				0	hi	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_RIGHT\"\>If the \<emph\>Keep Scale\</emph\> option is selected, enter a positive amount to trim the right edge of the graphic, or a negative amount to add white space to the right of the graphic. If the \<emph\>Keep image size\</emph\> option is selected, enter a positive amount to increase the horizontal scale of the graphic, or a negative amount to decrease the horizontal scale of the graphic.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3156153				0	hi	Top				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3154514				0	hi	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_TOP\"\>If the \<emph\>Keep Scale\</emph\> option is selected, enter a positive amount to trim the top of the graphic, or a negative amount to add white space above the graphic. If the \<emph\>Keep image size\</emph\> option is selected, enter a positive amount to increase the vertical scale of the graphic, or a negative amount to decrease the vertical scale of the graphic.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3149956				0	hi	Bottom				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3150084				0	hi	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_BOTTOM\"\>If the \<emph\>Keep Scale\</emph\> option is selected, enter a positive amount to trim the bottom of the graphic, or a negative amount to add white space below the graphic. If the \<emph\>Keep image size\</emph\> option is selected, enter a positive amount to increase the vertical scale of the graphic, or a negative amount to decrease the vertical scale of the graphic.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3158432				0	hi	Scale				20200411 15:09:53
