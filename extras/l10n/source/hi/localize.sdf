uui	source\cookiedg.src	0	string	STR_COOKIES_RECV_START				50	hi	'${HOST}' सर्वर एक अथवा अधिक कूकी को नियत करने की इच्छा रखता है।\nकूकी कुछ URL वर्ग से संदर्भित सूचना रखता है। यदि %PRODUCTNAME बाद में एक दस्तावेज़ के लिए आग्रह करता है एक URL के साथ पहले नियत किए कूकी के वर्ग के लिये, %PRODUCTNAME इस सूचना को सर्वर में भेजेगा। यह WWW अनुप्रयोग को पहचानने के लिए एक सर्वर को अनुमति देता है, उदा., ऑनलाइन खरीदारी के दौरान।\n\nनिम्न कूकी को नियत किया जाना चाहिए:\n\n				20200411 15:09:53
uui	source\cookiedg.src	0	string	STR_COOKIES_RECV_COOKIES				50	hi	डोमेन: ${DOMAIN}, पथ: ${PATH}, कूकी: ${COOKIE}।\n				20200411 15:09:53
uui	source\cookiedg.src	0	string	STR_COOKIES_RECV_TITLE				50	hi	कुकी प्राप्तकर्ता				20200411 15:09:53
uui	source\cookiedg.src	0	string	STR_COOKIES_SEND_START				50	hi	%PRODUCTNAME ने सर्वर '${HOST}' के लिए कुकीज़ को बचाया है जोकि दस्तावेज ${PATH} के अनुरोध करते समय भेजा जाएगा।\nकुकीज़ के पास कुछ जानकारी होती है जो यूआरएल वर्गों को संदर्भित करता है। जब कुछ दस्तावेज अभिगम्य किए जाते हैं तो ये कुछ सर्वर के द्वारा %PRODUCTNAME को भेजे जाते हैं जहाँ पर ये सहेजे जाते हैं। अगर %PRODUCTNAME एक दस्तावेज को भारित करता है, जोकि यूआरएल के अनुसार, पहले से प्राप्त कुकीज़ में से एक के एक वर्ग से मेल खाती है, तो %PRODUCTNAME यह जानकारी सर्वर को भेज देगा। यह एक सर्वर को WWW अनुप्रयोग की स्थिति पर नज़र रखने के लिए सक्षम बनाता है, उदाहरण के लिए, जब ऑनलाइन खरीदारी करते हैं।\n\nनिम्न कुकी नियत किया जाना चाहिए:\n\n				20200411 15:09:53
