helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3150471	76			0	it	\<item type=\"input\"\>Peso\</item\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3153920	77			0	it	14				20130618 17:22:18
