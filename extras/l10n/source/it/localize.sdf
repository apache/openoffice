helpcontent2	source\text\swriter\01\05030400.xhp	0	help	bm_id7635731				0	it	\<bookmark_value\>Carattere maiuscolo grande come prima lettera\</bookmark_value\>\<bookmark_value\>Lettera maiuscola;iniziare un paragrafo\</bookmark_value\>\<bookmark_value\>Capolettera;inserimento\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	hd_id3150252				0	it	\<link href=\"text/swriter/01/05030400.xhp\" name=\"Capolettera\"\>Capolettera\</link\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	par_id3154763				0	it	\<ahelp hid=\"HID_DROPCAPS\"\>Formatta la prima lettera di un paragrafo con un grande carattere maiuscolo, che può occupare diverse righe. Il paragrafo deve occupare almeno il numero di righe specificato nella casella Righe.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	hd_id3151388				0	it	Impostazioni				20200411 15:09:53
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	hd_id3147295				0	it	Mostra capolettera				20200411 15:09:53
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	par_id3150536				0	it	\<ahelp hid=\"SW_CHECKBOX_TP_DROPCAPS_CB_SWITCH\"\>Applica le impostazioni per il capolettera al paragrafo selezionato.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	hd_id3155626				0	it	Intera parola				20200411 15:09:53
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	par_id3154554				0	it	\<ahelp hid=\"SW_CHECKBOX_TP_DROPCAPS_CB_WORD\"\>Visualizza la prima lettera della prima parola del paragrafo come capolettera e le altre lettere della parola con un carattere grande.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	hd_id3154505				0	it	Numero di caratteri				20200411 15:09:53
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	par_id3149881	8			0	it	\<ahelp hid=\"SW_NUMERICFIELD_TP_DROPCAPS_FLD_DROPCAPS\"\>Inserite il numero di caratteri da convertire in capolettera. \</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	hd_id3150932				0	it	Righe				20200411 15:09:53
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	par_id3148391				0	it	\<ahelp hid=\"SW_NUMERICFIELD_TP_DROPCAPS_FLD_LINES\"\>Inserite il numero di righe sottostanti a cui desiderate estendere il capolettera a partire dalla prima riga del paragrafo. I paragrafi più brevi non conterranno capolettera.\</ahelp\> Potete specificare un numero compreso tra 2 e 9.				20200411 15:09:53
helpcontent2	source\text\swriter\01\05030400.xhp	0	help	hd_id3149030				0	it	Distanza dal testo				20200411 15:09:53
