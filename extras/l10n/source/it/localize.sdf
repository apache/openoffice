helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id9887081				0	it	\<ahelp hid=\".\"\>Digitate un indirizzo URL per il file che desiderate aprire quando si pigia il collegamento ipertestuale. Se non specificate un frame di arrivo, il file si apre nel documento o nel frame attivo.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	hd_id3155628				0	it	Browser Web				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id3153760				0	it	\<ahelp hid=\"SVX:IMAGEBUTTON:RID_SVXPAGE_HYPERLINK_INTERNET:BTN_BROWSE\"\>Apre un browser Web in cui potete caricare l'URL desiderato.\</ahelp\> Potete quindi copiare e incollare l'URL nel campo \<emph\>Destinazione\</emph\>.				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	hd_id3155421				0	it	Destinazione nel documento				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id3147618				0	it	\<ahelp hid=\"SVX:IMAGEBUTTON:RID_SVXPAGE_HYPERLINK_INTERNET:BTN_TARGET\"\>Apre la finestra di dialogo \<emph\>Destinazione nel documento\</emph\>.\</ahelp\> In questa finestra di dialogo potete selezionare una destinazione all'interno del documento e con il pulsante \<emph\>Applica\</emph\> inserirla nell'URL di destinazione.				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id3147335				0	it	\<ahelp hid=\"HID_HYPERLINK_MARKWND_TREE\" visibility=\"hidden\"\>Specifica la posizione nel documento di destinazione a cui si desidera passare.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id3149164				0	it	\<ahelp hid=\"HID_HYPERLINK_MARKWND_APPLY\" visibility=\"hidden\"\>Inserisce la destinazione nel campo \<emph\>Destinazione\</emph\> della finestra di dialogo \<emph\>Collegamento\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\09070100.xhp	0	help	par_id3155388				0	it	\<ahelp hid=\"HID_HYPERLINK_MARKWND_CLOSE\" visibility=\"hidden\"\>Dopo avere inserito tutte le informazioni relative al collegamento, fate clic su \<emph\>Chiudi\</emph\> per impostarlo e chiudere la finestra di dialogo.\</ahelp\>				20200411 15:09:53
