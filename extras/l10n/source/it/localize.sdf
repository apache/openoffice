helpcontent2	source\text\swriter\guide\table_insert.xhp	0	help	par_id3147527	41			0	it	Trascinate le celle selezionate nel documento di testo attuale.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_repeat_multiple_headers.xhp	0	help	tit				0	it	Ripetere la riga d'intestazione di una tabella su una nuova pagina				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_repeat_multiple_headers.xhp	0	help	bm_id3155870				0	it	\<bookmark_value\>Tabella; ripetizione dell'intestazione dopo un'interruzione di pagina\</bookmark_value\>\<bookmark_value\>Ripetizione; intestazione di una tabella dopo un'interruzione di pagina\</bookmark_value\>\<bookmark_value\>Intestazione; ripetizione nelle tabelle\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_repeat_multiple_headers.xhp	0	help	hd_id3153406	6			0	it	\<variable id=\"table_repeat_multiple_headers\"\>\<link href=\"text/swriter/guide/table_repeat_multiple_headers.xhp\" name=\"Ripetere la riga d'intestazione di una tabella su una nuova pagina\"\>Ripetere la riga d'intestazione di una tabella su una nuova pagina\</link\>\</variable\>				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_repeat_multiple_headers.xhp	0	help	par_id3149636	7			0	it	Potete ripetere la riga d'intestazione di una tabella su ognuna delle pagine in cui compare.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_repeat_multiple_headers.xhp	0	help	par_id3145098	8			0	it	Scegliete \<emph\>Tabella - Inserisci - Tabella\</emph\>.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_repeat_multiple_headers.xhp	0	help	par_id3156240	9			0	it	Selezionate le caselle di controllo \<item type=\"menuitem\"\>Intestazione\</item\> e \<item type=\"menuitem\"\>Ripeti intestazione\</item\>.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_repeat_multiple_headers.xhp	0	help	par_id3153376	10			0	it	Selezionate il numero di righe e di colonne da inserire nella nuova tabella.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_repeat_multiple_headers.xhp	0	help	par_id3153393	11			0	it	Fate clic su \<emph\>OK\</emph\>.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_select.xhp	0	help	tit				0	it	Selezionare tabelle, righe e colonne				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_select.xhp	0	help	bm_id7693411				0	it	\<bookmark_value\>Seleziona;tabelle\</bookmark_value\>\<bookmark_value\>Tabella;selezionare\</bookmark_value\>\<bookmark_value\>Colonna;selezionare\</bookmark_value\>\<bookmark_value\>Riga;selezionare\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_select.xhp	0	help	par_idN105F0				0	it	\<variable id=\"table_select\"\>\<link href=\"text/swriter/guide/table_select.xhp\"\>Selezionare tabelle, righe e colonne\</link\>\</variable\>				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_select.xhp	0	help	par_idN1060E				0	it	Potete selezionare una tabella in un documento di testo con la tastiera o con il mouse.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_select.xhp	0	help	par_idN10614				0	it	Per selezionare una tabella con la tastiera, spostate il cursore all'interno della tabella e premete \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Comando\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+A fino a selezionare tutte le celle.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_select.xhp	0	help	par_idN10633				0	it	Per selezionare una tabella con il mouse, spostate il puntatore appena al di sopra e alla sinistra della tabella. Il puntatore del mouse assume l'aspetto di una freccia diagonale. Fate clic per selezionare la tabella.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_select.xhp	0	help	par_idN10637				0	it	Per selezionare una riga o una colonna con il mouse, posizionate il puntatore di poco a sinistra della riga o di poco al di sopra della colonna. Il puntatore del mouse assume l'aspetto di una freccia. Fate clic per selezionare la riga o la colonna.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	tit				0	it	Ridimensionare righe e colonne in una tabella di testo				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	bm_id3156108				0	it	\<bookmark_value\>celle; aumentare e ridurre nelle tabelle di testo\</bookmark_value\>\<bookmark_value\>celle di tabella; aumentare/ridurre nel testo\</bookmark_value\>\<bookmark_value\>tastiera; ridimensionare righe/colonne\</bookmark_value\>\<bookmark_value\>ridimensionare;righe e colonne nelle tabelle di testo\</bookmark_value\>\<bookmark_value\>aumentare colonne,celle e righe di tabella\</bookmark_value\>\<bookmark_value\>ridurre righe e colonne nelle righe di tabella\</bookmark_value\>\<bookmark_value\>tabelle; ridimensionare/giustapporre\</bookmark_value\>\<bookmark_value\>giustapporre tabelle\</bookmark_value\>\<bookmark_value\>altezza delle righe della tabella\</bookmark_value\>\<bookmark_value\>larghezza delle colonne della tabella \</bookmark_value\>\<bookmark_value\>righe;ridimensionare nelle tabelle\</bookmark_value\>\<bookmark_value\>colonne;ridimensionare nelle tabelle\</bookmark_value\>\<bookmark_value\>larghezza della colonna nelle tabelle\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	hd_id3156108				0	it	\<variable id=\"table_sizing\"\>\<link href=\"text/swriter/guide/table_sizing.xhp\" name=\"Resizing Rows and Columns in a Text Table\"\>Ridimensionare righe e colonne in una tabella di testo\</link\>\</variable\>				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	par_id3153140				0	it	Potete modificare la larghezza delle celle e delle colonne della tabella e modificare l'altezza delle righe.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	par_id3149615				0	it	\<image id=\"img_id3149622\" src=\"res/commandimagelist/sc_optimizetable.png\" width=\"0.423cm\" height=\"0.423cm\"\>\<alt id=\"alt_id3149622\"\>Icona\</alt\>\</image\>				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	par_id3146497				0	it	Potete inoltre distribuire le righe e le colonne in modo uniforme usando la barra degli strumenti \<item type=\"menuitem\"\>Ottimizza\</item\> nella barra \<item type=\"menuitem\"\>Tabella\</item\>.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	hd_id3145109				0	it	Modifica della larghezza di celle e colonne				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	hd_id3149574				0	it	Per cambiare la larghezza di una colonna:				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	par_id3149587				0	it	Usate una delle procedure seguenti:				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	par_id3156246				0	it	Posizionate il puntatore del mouse sulla linea di divisione tra le colonne finché non compare il simbolo di separazione, e quindi trascinate la linea in una nuova posizione.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	par_id3145390				0	it	Posizionate il puntatore del mouse sulla linea di divisione tra le colonne situata sul righello finché non compare il simbolo di separazione, e trascinate la linea in una nuova posizione.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	par_id0918200811260957				0	it	Tenete premuto \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Comando\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\> quindi fate clic e trascinate una linea per ridimensionare proporzionalmente tutte le celle a destra o sopra la linea.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	par_id3145411				0	it	Posizionate il cursore in una cella nella colonna, premete il tasto \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Opzione\</caseinline\>\<defaultinline\>Alt\</defaultinline\>\</switchinline\> insieme alla freccia sinistra o destra.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	par_id3153364				0	it	Per aumentare la distanza tra il bordo sinistro della pagina e il bordo della tabella, tenete premuto \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Opzione\</caseinline\>\<defaultinline\>Alt\</defaultinline\>\</switchinline\>+Maiusc, quindi premete la freccia destra.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	par_id3155891				0	it	Potete specificare il comportamento dei tasti freccia scegliendo \<emph\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferenze\</caseinline\>\<defaultinline\>Strumenti - Opzioni\</defaultinline\>\</switchinline\> - %PRODUCTNAME Writer - Tabella\</emph\> e selezionando le opzioni desiderate nell'area \<emph\>Uso della tastiera\</emph\>.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	hd_id3149993				0	it	Per cambiare la larghezza di una cella:				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	par_id3148676				0	it	Tenete premuto il tasto \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Opzione+Comando\</caseinline\>\<defaultinline\>Alt+Ctrl\</defaultinline\>\</switchinline\> insieme alla freccia sinistra o destra.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	hd_id3153014				0	it	Modificare l'altezza di una riga				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	par_id3153035				0	it	Per cambiare l'altezza di una riga, posizionate il cursore in una cella della riga e premete il tasto \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Opzione\</caseinline\>\<defaultinline\>Alt\</defaultinline\>\</switchinline\> insieme alla freccia su o giù.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	hd_id8478041				0	it	Ridimensionare un'intera tabella:				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	par_id3358867				0	it	Per cambiare la larghezza e l'altezza di una tabella, usate una delle procedure seguenti:				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	par_id5366679				0	it	Fate clic all'interno della tabella. Nei righelli trascinate il bordo tra l'area bianca e grigia per ridimensionare la tabella.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	par_id1279030				0	it	Fate clic all'interno della tabella. Scegliete \<item type=\"menuitem\"\>Tabella - Proprietà tabella\</item\> per aprire una finestra di dialogo e impostare le proprietà sui numeri.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	par_id5009308				0	it	Per far scorrere del testo sui lati di una tabella e per disporre due tabelle una vicino all'altra, è necessario inserire le tabelle in una cornice. Fate clic all'interno della tabella, premete due volte\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Comando\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+A per selezionare l'intera tabella, quindi scegliete \<emph\>Inserisci - Cornice\</emph\>.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\table_sizing.xhp	0	help	par_id4190496				0	it	Le tabelle all'interno delle pagine HTML non offrono l'intervallo completo di proprietà e comandi delle tabelle in formato OpenDocument.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\tablemode.xhp	0	help	tit				0	it	Modificare righe e colonne con la tastiera				20130618 17:22:18
helpcontent2	source\text\swriter\guide\tablemode.xhp	0	help	bm_id3155856				0	it	\<bookmark_value\>Tabella; selezionare il modo\</bookmark_value\>\<bookmark_value\>Tabella; distribuire proporzionalmente\</bookmark_value\>\<bookmark_value\>Cella; distribuire in modo relativo in una tabella\</bookmark_value\>\<bookmark_value\>Tabella; adattare la larghezza con la tastiera\</bookmark_value\>\<bookmark_value\>Cella; adattare la larghezza con la tastiera\</bookmark_value\>\<bookmark_value\>Tastiera; modificare il comportamento di righe/colonne\</bookmark_value\>\<bookmark_value\>Comportamento di righe/colonne\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\swriter\guide\tablemode.xhp	0	help	hd_id3155856	7			0	it	\<variable id=\"tablemode\"\>\<link href=\"text/swriter/guide/tablemode.xhp\" name=\"Modificare il comportamento di righe e colonne nelle tabelle\"\>Modificare il comportamento di righe e colonne nelle tabelle\</link\>\</variable\>				20130618 17:22:18
helpcontent2	source\text\swriter\guide\tablemode.xhp	0	help	par_id3149835	12			0	it	Quando inserite o eliminate una o più celle, righe o colonne in una tabella, l'opzione \<item type=\"menuitem\"\>Comportamento durante lo spostamento\</item\> determina l'effetto dell'operazione sugli elementi adiacenti. Ad esempio, potete inserire righe e colonne nuove solo nelle tabelle in cui questi elementi hanno dimensioni fisse (se lo spazio lo consente).				20130618 17:22:18
helpcontent2	source\text\swriter\guide\tablemode.xhp	0	help	par_id7344279				0	it	Queste proprietà si riferiscono solo alle modifiche alla larghezza delle colonne che vengono effettuate con la tastiera. Se utilizzate il mouse, la larghezza delle colonne può essere modificata liberamente.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\tablemode.xhp	0	help	par_id3156110	8			0	it	Per impostare il \<item type=\"menuitem\"\>Comportamento durante lo spostamento\</item\> per le tabelle incluse nei documenti di testo, scegliete \<item type=\"menuitem\"\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferenze\</caseinline\>\<defaultinline\>Strumenti - Opzioni\</defaultinline\>\</switchinline\> - %PRODUCTNAME Writer - Tabella\</item\>, oppure usate le icone \<item type=\"menuitem\"\>Tabella: fissa\</item\>, \<item type=\"menuitem\"\>Tabella: fissa,proporzionale\</item\>, e \<item type=\"menuitem\"\>Tabella: variabile\</item\> nella barra \<item type=\"menuitem\"\>Tabella\</item\>. Esistono tre modalità di visualizzazione per le tabelle:				20130618 17:22:18
helpcontent2	source\text\swriter\guide\tablemode.xhp	0	help	par_id3149638	9			0	it	\<emph\>Tabella: fissa\</emph\> - i cambiamenti influiscono solo sulla cella adiacente e non sull'intera tabella. Ad esempio, quando allargate una cella, la cella adiacente diventa più stretta ma la larghezza della tabella rimane costante.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\tablemode.xhp	0	help	par_id3149613	10			0	it	\<emph\>Tabella: fissa, proporzionale\</emph\> - i cambiamenti hanno effetto sull'intera tabella, e le celle più larghe si restringono maggiormente rispetto a quelle più strette. Ad esempio, quando allargate una cella, le celle adiacenti si restringono proporzionalmente, ma la larghezza della tabella rimane costante.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\tablemode.xhp	0	help	par_id3149864	11			0	it	\<emph\>Tabella: variabile\</emph\> - i cambiamenti hanno effetto sulla dimensione della tabella. Ad esempio, quando allargate una cella, aumenta la larghezza dell'intera tabella.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_create.xhp	0	help	tit				0	it	Creare un modello di documento				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_create.xhp	0	help	bm_id3149688				0	it	\<bookmark_value\>Modello di documento\</bookmark_value\>\<bookmark_value\>Modello;creare un modello di documento\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_create.xhp	0	help	hd_id3149688	62			0	it	\<variable id=\"template_create\"\> \<link href=\"text/swriter/guide/template_create.xhp\" name=\"Creare un modello di documento\"\>Creare un modello di documento\</link\> \</variable\>				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_create.xhp	0	help	par_id3149492	63			0	it	Potete creare un modello da utilizzare come base per la creazione di nuovi documenti di testo.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_create.xhp	0	help	par_id3155915	64			0	it	Create un documento e aggiungetevi il contenuto e gli stili di formato desiderati.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_create.xhp	0	help	par_id3147422	65			0	it	Scegliete \<emph\>File - Modelli - Salva\</emph\>.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_create.xhp	0	help	par_id3149829	66			0	it	Nella casella \<item type=\"menuitem\"\>Nuovo modello\</item\>, digitate un nome per il nuovo modello di documento.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_create.xhp	0	help	par_id3156098	70			0	it	Selezionate una categoria di modelli di documento nell'elenco \<item type=\"menuitem\"\>Categorie\</item\>.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_create.xhp	0	help	par_id3149281	71			0	it	Fate clic su \<emph\>OK\</emph\>.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_create.xhp	0	help	par_id3153404	67			0	it	Per creare un documento basato su questo modello, scegliete \<item type=\"menuitem\"\>File - Nuovo - Modelli e documenti\</item\>, selezionate il modello di documento e fate clic su \<item type=\"menuitem\"\>Apri\</item\>.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_create.xhp	0	help	par_id3149636	68			0	it	\<link href=\"text/shared/01/01110300.xhp\" name=\"File - Modello di documento - Salva\"\>File - Modello di documento - Salva\</link\>				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_default.xhp	0	help	tit				0	it	Modificare il modello predefinito				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_default.xhp	0	help	bm_id3155913				0	it	\<bookmark_value\>Modello predefinito; definire\</bookmark_value\>\<bookmark_value\>Predefinito; modelli \</bookmark_value\>\<bookmark_value\>Modello; modelli predefiniti\</bookmark_value\>\<bookmark_value\>Documento di testo; modelli predefiniti\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_default.xhp	0	help	hd_id3155913	28			0	it	\<variable id=\"template_default\"\>\<link href=\"text/swriter/guide/template_default.xhp\" name=\"Modificare il modello predefinito\"\>Modificare il modello predefinito\</link\>\</variable\>				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_default.xhp	0	help	par_id3145569	68			0	it	Il modello di documento predefinito è quello che contiene le informazioni di formattazione predefinita per i nuovi documenti di testo. In base alle vostre esigenze, potete creare un nuovo modello di documento e utilizzarlo come modello predefinito.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_default.xhp	0	help	hd_id6414990				0	it	Per creare un modello di documento predefinito:				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_default.xhp	0	help	par_id3149838	102			0	it	Create un documento con il contenuto e gli stili di formato desiderati.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_default.xhp	0	help	par_id3156101	113			0	it	Scegliete \<emph\>File - Modelli - Salva\</emph\>.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_default.xhp	0	help	par_id3149283	106			0	it	Nella casella \<emph\>Nuovo modello\</emph\>, digitate un nome per il nuovo modello di documento.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_default.xhp	0	help	par_id3153409	114			0	it	Nell'elenco \<item type=\"menuitem\"\>Categorie\</item\>, selezionate "Personalizzati" e fate clic su \<item type=\"menuitem\"\>OK\</item\>.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_default.xhp	0	help	par_id3153140	107			0	it	Selezionate il comando \<link href=\"text/shared/01/01110100.xhp\" name=\"File - Modelli - Gestisci\"\>\<emph\>File - Modelli - Gestisci\</emph\>\</link\>.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_default.xhp	0	help	par_id3149952	108			0	it	Nell'elenco \<item type=\"menuitem\"\>Modelli\</item\>, fate doppio clic sulla cartella "Personalizzati".				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_default.xhp	0	help	par_id3149970	105			0	it	Fate clic col pulsante destro sul modello che avete creato e scegliete \<emph\>Imposta come modello predefinito\</emph\>.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_default.xhp	0	help	par_id3149620	115			0	it	Fate clic su \<emph\>Chiudi\</emph\>.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_default.xhp	0	help	hd_id3149867	109			0	it	Per ripristinare il modello di documento predefinito:				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_default.xhp	0	help	par_id3145102	110			0	it	Selezionate il comando \<link href=\"text/shared/01/01110100.xhp\" name=\"File - Modelli - Gestisci\"\>\<emph\>File - Modelli - Gestisci\</emph\>\</link\>.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_default.xhp	0	help	par_id3149582	111			0	it	Fate clic con il pulsante destro su un file di testo in uno dei due elenchi e scegliete \<item type=\"menuitem\"\>Ripristina modello predefinito - Documento di testo\</item\>.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\template_default.xhp	0	help	par_id3156245	112			0	it	Fate clic su \<emph\>Chiudi\</emph\>.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\templates_styles.xhp	0	help	tit				0	it	Modelli di documento e stili				20130618 17:22:18
helpcontent2	source\text\swriter\guide\templates_styles.xhp	0	help	bm_id3153396				0	it	\<bookmark_value\>Modello di documento;modelli di documento e di formato (guida)\</bookmark_value\>\<bookmark_value\>Formattazione;stili di formato e di documento\</bookmark_value\>\<bookmark_value\>Stile di formato;stili di formato e di modello di documento (guida)\</bookmark_value\>\<bookmark_value\>Organizzazione;modelli di documento (guida)\</bookmark_value\>\<bookmark_value\>Modello di documento;organizzazione (guida)\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\swriter\guide\templates_styles.xhp	0	help	hd_id3153396	15			0	it	\<variable id=\"templates_styles\"\>\<link href=\"text/swriter/guide/templates_styles.xhp\" name=\"Modelli di documento e di formato\"\>Modelli di documento e stili\</link\>\</variable\>				20130618 17:22:18
helpcontent2	source\text\swriter\guide\templates_styles.xhp	0	help	par_id3149635	2			0	it	Un modello è un documento che contiene specifici stili di formattazione, immagini, tabelle, oggetti e altre informazioni. I modelli di documento vengono usati come base per la creazione di altri documenti. Ad esempio, potete definire gli stili di paragrafo e di carattere da usare in un documento, salvare il file come modello di documento e quindi usare questo modello per creare un nuovo documento con gli stessi stili di formattazione.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\templates_styles.xhp	0	help	par_id3149957	18			0	it	Se non specificato diversamente, tutti i nuovi documenti di testo di $[officename] sono basati sul modello predefinito.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\templates_styles.xhp	0	help	par_id3149974	3			0	it	$[officename] dispone di vari \<link href=\"text/swriter/01/05130000.xhp\" name=\"modelli predefiniti\"\>modelli predefiniti\</link\> che permettono di creare diversi tipi di documento di testo, ad esempio le lettere commerciali.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\templates_styles.xhp	0	help	hd_id3149613	4			0	it	Visualizzare e organizzare gli stili				20130618 17:22:18
helpcontent2	source\text\swriter\guide\templates_styles.xhp	0	help	par_idN106B0				0	it	La finestra di dialogo \<link href=\"text/shared/01/01110100.xhp\" name=\"Gestione dei modelli\"\>Gestione dei modelli\</link\> vi permette di copiare gli stili di formato da un documento a un altro.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\templates_styles.xhp	0	help	par_id3153377	7			0	it	Per copiare uno stile di formato, trascinatelo su un altro modello di documento o su un documento.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_animation.xhp	0	help	tit				0	it	Applicare effetti di animazione a un testo				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_animation.xhp	0	help	bm_id3151182				0	it	\<bookmark_value\>Testo scorrevole\</bookmark_value\>\<bookmark_value\>Effetti;testo scorrevole\</bookmark_value\>\<bookmark_value\>Animazioni;testo\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_animation.xhp	0	help	hd_id3151182	17			0	it	\<variable id=\"text_animation\"\>\<link href=\"text/swriter/guide/text_animation.xhp\" name=\"Usare un testo scorrevole\"\>Usare un testo scorrevole\</link\>\</variable\>				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_animation.xhp	0	help	par_id3145080	18			0	it	Gli effetti di animazione possono essere applicati solo ai testi contenuti negli oggetti di disegno, ad esempio i rettangoli, le linee oppure gli oggetti di testo. Ad esempio, disegnate un rettangolo, quindi fatevi doppio clic e inserite il testo desiderato.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_animation.xhp	0	help	par_id3149811	19			0	it	Selezionate l'oggetto di disegno contenente il testo a cui desiderate applicare l'effetto di animazione.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_animation.xhp	0	help	par_id3155178	20			0	it	Scegliete \<item type=\"menuitem\"\>Formato - Oggetto - Attributi di testo\</item\> e fate clic sulla scheda \<item type=\"menuitem\"\>Testo scorrevole\</item\>.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_animation.xhp	0	help	par_id3149819	21			0	it	Nella casella \<item type=\"menuitem\"\>Effetto\</item\>, selezionate l'opzione desiderata.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_animation.xhp	0	help	par_id3145786	22			0	it	Impostate le proprietà dell'effetto e fate clic su \<emph\>OK\</emph\>.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_capital.xhp	0	help	tit				0	it	Rendere un testo maiuscolo o minuscolo				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_capital.xhp	0	help	bm_id3155182				0	it	\<bookmark_value\>Carattere;maiuscolo o minuscolo\</bookmark_value\>\<bookmark_value\>Testo;maiuscolo o minuscolo\</bookmark_value\>\<bookmark_value\>Minuscolo;testo\</bookmark_value\>\<bookmark_value\>Maiuscolo;testo\</bookmark_value\>\<bookmark_value\>Maiuscolo;convertire in minuscolo\</bookmark_value\>\<bookmark_value\>Modifica;maiuscolo/minuscolo\</bookmark_value\>\<bookmark_value\>Iniziali maiuscole nei titoli\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_capital.xhp	0	help	hd_id3155182	1			0	it	\<variable id=\"text_capital\"\>\<link href=\"text/swriter/guide/text_capital.xhp\" name=\"Scrivere con lettere maiuscole o minuscole\"\>Scrivere con lettere maiuscole o minuscole\</link\>\</variable\>				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_capital.xhp	0	help	par_id3155916	2			0	it	Potete rendere il testo maiuscolo o minuscolo, formattarlo in maiuscoletto oppure rendere maiuscola solo la prima lettera di ogni parola della selezione.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_capital.xhp	0	help	par_idN10728				0	it	Quando formattate un testo scegliendo \<emph\>Formato - Carattere\</emph\>, il testo rimane uguale ma viene visualizzato in modo diverso. Se invece scegliete \<emph\>Formato - Maiuscole/minuscole\</emph\>, il testo viene cambiato in modo permanente.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_capital.xhp	0	help	hd_id3155861	8			0	it	Per rendere il testo maiuscolo:				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_capital.xhp	0	help	par_id3147420	9			0	it	Selezionate il testo da formattare con lettere maiuscole.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_capital.xhp	0	help	par_id3149841	10			0	it	Usate una delle procedure seguenti:				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_capital.xhp	0	help	par_id1120200910485778				0	it	Scegliete \<item type=\"menuitem\"\>Formato - Maiuscole/minuscole - Maiuscole\</item\>.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_capital.xhp	0	help	par_id1120200910485775				0	it	Scegliete \<item type=\"menuitem\"\>Formato - Carattere\</item\>, fate clic sulla scheda Effetto carattere quindi selezionate il tipo di maiuscole nella casella Effetti. "Maiuscole" converte in maiuscolo tutte le lettere. "Titolo" converte in maiuscolo la prima lettera di ogni parola. "Maiuscoletto" rende i caratteri maiuscoli, ma con dimensioni ridotte.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_capital.xhp	0	help	hd_id3149644	11			0	it	Per rendere il testo minuscolo:				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_capital.xhp	0	help	par_id3149964	12			0	it	Selezionate il testo da formattare a lettere minuscole.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_capital.xhp	0	help	par_id3149606	13			0	it	Usate una delle procedure seguenti:				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_capital.xhp	0	help	par_id112020091049000				0	it	Scegliete \<item type=\"menuitem\"\>Formato - Maiuscole/minuscole - Minuscole\</item\>.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_capital.xhp	0	help	par_id1120200910490034				0	it	Scegliete \<item type=\"menuitem\"\>Formato - Carattere\</item\>, fate clic sulla scheda Effetto carattere quindi selezionate "Minuscole" nella casella Effetti.				20130618 17:22:18
helpcontent2	source\text\swriter\guide\text_centervert.xhp	0	help	tit				0	it	Centrare un testo nella pagina con una cornice				20130618 17:22:18
