helpcontent2	source\text\shared\00\00000003.xhp	0	help	par_idN106D4				0	it	cm				20200411 15:09:53
helpcontent2	source\text\shared\00\00000003.xhp	0	help	par_idN106DA				0	it	Centimetro				20200411 15:09:53
helpcontent2	source\text\shared\00\00000003.xhp	0	help	par_idN106E1				0	it	in oppure "				20200411 15:09:53
helpcontent2	source\text\shared\00\00000003.xhp	0	help	par_idN106E7				0	it	Pollice				20200411 15:09:53
