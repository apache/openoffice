helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_idN115B7				0	it	Colore  simbolo				20130618 17:22:18
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_idN115BB				0	it	\<ahelp hid=\".\"\>Specifica il colore dei simboli da visualizzare sui controlli, ad esempio sulle frecce di una barra di scorrimento.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\shared\02\01170101.xhp	0	help	hd_id3149314	131			0	it	Data min				20130618 17:22:18
