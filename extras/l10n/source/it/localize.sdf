helpcontent2	source\text\shared\02\20020000.xhp	0	help	par_id3148731				0	it	\<ahelp hid=\".uno:LayoutStatus\"\>Visualizza lo stile di pagina corrente. Fate doppio clic per modificarlo oppure fate clic con il pulsante destro del mouse per scegliere un altro stile.\</ahelp\>!				20200411 15:09:53
helpcontent2	source\text\shared\02\20020000.xhp	0	help	par_id3149283	3			0	it	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Fate doppio clic sul campo\<emph\> Stile di pagina \</emph\>per aprire il dialogo \<link href=\"text/swriter/01/05040000.xhp\" name=\"Page Style\"\>Stile di pagina\</link\> e modificare lo stile della pagina corrente. Nel menu di contesto di questo campo, potete applicare uno stile di pagina. \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\02\20020000.xhp	0	help	par_id3151234	4			0	it	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>Fate doppio clic nel campo \<emph\>Stile di pagina\</emph\> per aprire la finestra di dialogo \<link href=\"text/scalc/01/05070000.xhp\" name=\"Stile di pagina\"\>Stile di pagina\</link\>, in cui potete modificare gli attributi della pagina attiva. \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\02\20020000.xhp	0	help	par_id3149346	5			0	it	\<switchinline select=\"appl\"\>\<caseinline select=\"IMPRESS\"\>Fate doppio clic in questo campo per aprire la finestra di dialogo \<link href=\"text/simpress/01/05120000.xhp\" name=\"Stile di pagina\"\>Stile di pagina\</link\>, in cui potete selezionare lo stile da applicare alla diapositiva attiva. Potete scegliere un formato diverso per il foglio o uno sfondo differente. \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\02\20020000.xhp	0	help	par_id3147008	6			0	it	\<switchinline select=\"appl\"\>\<caseinline select=\"DRAW\"\>Fate doppio clic in questo campo per aprire la finestra di dialogo \<link href=\"text/simpress/01/05120000.xhp\" name=\"Stile di pagina\"\>Stile di pagina\</link\>, in cui potete selezionare lo stile da applicare alla pagina attiva. Potete scegliere un formato diverso per il foglio o uno sfondo differente. \</caseinline\>\</switchinline\>				20200411 15:09:53
