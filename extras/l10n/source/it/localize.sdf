helpcontent2	source\text\schart\01\03010000.xhp	0	help	par_id4089175				0	it	\<ahelp hid=\".\" visibility=\"hidden\"\>Scambia la colonna attuale con quella alla sua destra.\</ahelp\>				20130618 17:22:18
