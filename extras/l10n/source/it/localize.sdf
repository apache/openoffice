helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id2113711				0	it	DOMENICA.DI.PASQUA(Anno)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3938413				0	it	\<emph\>Year\</emph\> è un intero compreso tra 1583 e 9956 oppure 0 e 99. Potete anche calcolare le altre festività con una semplice addizione.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3156156				0	it	Pasquetta = DOMENICA.DI.PASQUA(Anno) + 1				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3147521				0	it	Venerdì Santo = DOMENICA.DI.PASQUA(Anno) - 2				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3146072				0	it	Domenica di Pentecoste = DOMENICA.DI.PASQUA(Anno) + 49				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_eastersunday.xhp	0	help	par_id3149553				0	it	Lunedì di Pentecoste  = DOMENICA.DI.PASQUA(Anno) + 50				20200411 15:09:53
