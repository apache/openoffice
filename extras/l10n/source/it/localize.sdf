helpcontent2	source\text\shared\02\fontwork.xhp	0	help	par_idN10567				0	it	\<ahelp hid=\".\"\>L'icona apre la Galleria fontwork, da cui potete inserire oggetti di testo in forma grafica nel documento.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\fontwork.xhp	0	help	par_idN10591				0	it	Galleria fontwork				20200411 15:09:53
helpcontent2	source\text\shared\02\fontwork.xhp	0	help	par_idN10595				0	it	\<ahelp hid=\".\"\>La Galleria fontwork mostra un'anteprima degli oggetti fontwork disponibili. Per inserire un oggetto nel documento, selezionatelo e fate clic su OK.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\fontwork.xhp	0	help	par_idN105AF				0	it	\<embedvar href=\"text/shared/guide/fontwork.xhp#fontwork\"/\>				20200411 15:09:53
helpcontent2	source\text\shared\02\fontwork.xhp	0	help	par_idN10623				0	it	\<link href=\"text/shared/fontwork_toolbar.xhp\"\>barra degli strumenti fontwork\</link\>				20200411 15:09:53
