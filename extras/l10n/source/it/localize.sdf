helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	par_id3150771	2			0	it	\<variable id=\"farbentext\"\>\<ahelp hid=\".\"\>Vi permette di definire i vostri colori.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	par_id9701528				0	it	%PRODUCTNAME usa solo il modello di colore RGB per stampare a colori. I controlli CMYK vengono forniti soltanto per facilitare l'inserimento dei valori di colore usando la corrispondente notazione.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	hd_id5566778801				0	it	Campo colore				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	par_id5566778801				0	it	\<ahelp hid=\"cui:Control:ColorPicker:ColorField\"\>Nel grande campo colore basta un clic per selezionare un nuovo colore.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	hd_id5566778802				0	it	Regolatore di colore				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	par_id5566778802				0	it	Fate clic su uno dei sei pulsanti di opzione: rosso, verde, blu, tonalità, saturazione o luminosità. Il regolatore di colore mostrerà l'intervallo di valori disponibili. \<ahelp hid=\"cui:Control:ColorPicker:ColorSlider\"\>A seconda del pulsante di opzione selezionato, nel regolatore vedrete l'intervallo di valori modificabili. Fate clic nel regolatore di colore per modificare i valori nel grande campo di colore.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	hd_id5566778803				0	it	Anteprima colore corrente				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	par_id5566778803				0	it	\<ahelp hid=\"cui:Control:ColorPicker:ColorPreview\"\>Nella metà sinistra del campo di anteprima vedrete sempre il risultato attuale delle vostre modifiche in questa finestra di dialogo.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	hd_id5566778803b				0	it	Colore precedente				20200411 15:09:53
