helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id6969512				0	it	'Option Explicit				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id1196935				0	it	Sub demoBug				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id1423993				0	it	CompatibilityMode( vero )				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id6308786				0	it	initMyText				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id4104129				0	it	' Ora restituisce una stringa vuota				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id7906125				0	it	' (o restituisce un errore per Option Explicit)				20130618 17:22:18
