helpcontent2	source\text\shared\02\04210000.xhp	0	help	par_id3145412				0	it	\<ahelp hid=\".uno:OptimizeTable\"\>Apre una barra degli strumenti che contiene funzionalità per ottimizzare le righe e le colonne di una tabella.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\04210000.xhp	0	help	par_id3155899				0	it	\<image id=\"img_id3149684\" src=\"res/commandimagelist/sc_optimizetable.png\" width=\"0.423cm\" height=\"0.423cm\"\>\<alt id=\"alt_id3149684\"\>Icona\</alt\>\</image\>				20200411 15:09:53
