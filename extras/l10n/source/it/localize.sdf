helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id8455153				0	it	\<ahelp hid=\".\"\>La funzione ASC converte i caratteri ASCII e katakana da larghezza piena in larghezza dimezzata. Restituisce una stringa di testo.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id9912411				0	it	Fate riferimento a \<link href=\"http://wiki.services.openoffice.org/mwiki/index.php?title=Calc/Features/JIS_and_ASC_functions\"\>http://wiki.services.openoffice.org/mwiki/index.php?title=Calc/Features/JIS_and_ASC_functions\</link\> per la tabella di conversione.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id9204992				0	it	Sintassi				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id1993774				0	it	ASC("testo")				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id2949919				0	it	\<emph\>Testo\</emph\> è il testo che contiene i caratteri da convertire.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id2355113				0	it	Vedete anche la funzione JIS.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id9323709				0	it	\<bookmark_value\>TESTO.BAHT, funzione\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id6695455				0	it	TESTO.BAHT				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id354014				0	it	Converte un numero in testo Thai, inclusi i nomi di valute Thai.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id9942014				0	it	Sintassi				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id8780785				0	it	TESTO.BAHT(Numero)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id1539353				0	it	\<emph\>Numero\</emph\> è qualsiasi numero. "Baht" viene aggiunta alla parte integrale del numero e "Satang" viene aggiunta alla parte decimale del numero.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id9694814				0	it	Esempio				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3289284				0	it	\<item type=\"input\"\>=TESTO.BAHT(12.65)\</item\> restituisce una stringa in caratteri Thai con il significato di "12 Baht e 65 Satang".				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3153072				0	it	\<bookmark_value\>BASE, funzione\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153072	213			0	it	BASE				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153289	214			0	it	\<ahelp hid=\"HID_FUNC_BASIS\"\>Converte un numero intero positivo in un testo da un \<link href=\"text/shared/00/00000005.xhp#zahlensystem\" name=\"sistema numerico\"\>sistema numerico\</link\> alla base indicata.\</ahelp\> Vengono usate le cifre 0-9 e le lettere A-Z.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146097	215			0	it	Sintassi				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155743	216			0	it	BASE(Numero; Radice; [Lunghezza minima])				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151339	217			0	it	\<emph\>Numero\</emph\> è l'intero positivo da convertire.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3159262	218			0	it	\<emph\>Radice\</emph\> indica la base del sistema numerico. Può essere un numero intero tra 2 e 36.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148746	219			0	it	\<emph\>Lunghezza minima\</emph\> (opzionale) determina la lunghezza minima della sequenza di caratteri creata. Indicando questo parametro, se il testo è più breve verrà completato con degli zeri a sinistra della stringa.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146323	220			0	it	Esempio				20130618 17:22:18
