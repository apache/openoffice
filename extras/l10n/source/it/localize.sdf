helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3154330				0	it	\<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>setenv STAR_SPOOL_DIR /usr/local/tmp (in csh/tcsh) o \</caseinline\>\</switchinline\>				20200411 15:09:53
