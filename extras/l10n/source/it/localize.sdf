helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3148576				0	it	REM If Instr(Input, "e")<>0 Then...				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3154014				0	it	REM la funzione CBool viene applicata come segue:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3155413				0	it	If CBool(Instr(sTesto, "e")) Then				20200411 15:09:53
