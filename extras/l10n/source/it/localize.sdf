helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E0F				0	it	=A1:A2+1				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E17				0	it	2				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E1D				0	it	=MATR.SOMMA.PRODOTTO(A1:A2+1)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E25				0	it	5				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E2D				0	it	2				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN10E34				0	it	2				20200411 15:09:53
