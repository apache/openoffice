helpcontent2	source\text\schart\01\05040200.xhp	0	help	par_id3155628	2			0	it	\<variable id=\"yachse\"\>\<ahelp hid=\".uno:DiagramAxisY\"\>Apre la finestra di dialogo per l'\<emph\>asse Y \</emph\>dalla quale è possibile modificare le proprietà dell'asse Y.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\schart\01\05040200.xhp	0	help	hd_id3145171				0	it	\<link href=\"text/shared/01/05020100.xhp\" name=\"Caratteri\"\>Caratteri\</link\>				20200411 15:09:53
