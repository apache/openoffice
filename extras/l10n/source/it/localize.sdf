helpcontent2	source\text\swriter\01\03080000.xhp	0	help	par_id3147513	2			0	it	\<ahelp hid=\".uno:Marks\"\>Mostra o nasconde i contrassegni nel documento, inclusi gli spazi non divisibili, le sillabazioni inserite manualmente, le voci dell'indice e le note a piè pagina.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\03080000.xhp	0	help	par_id3153540	17			0	it	\<link href=\"text/swriter/01/03100000.xhp\" name=\"Caratteri non stampabili\"\>Caratteri non stampabili\</link\>				20130618 17:22:18
