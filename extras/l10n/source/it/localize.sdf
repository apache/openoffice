helpcontent2	source\text\swriter\guide\insert_graphic_fromdraw.xhp	0	help	par_id3153414				0	it	Aprite il documento in cui volete inserire l'oggetto.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\insert_graphic_fromdraw.xhp	0	help	par_id3149640				0	it	Aprite il documento di Draw o Impress contenente l'oggetto che volete copiare.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\insert_graphic_fromdraw.xhp	0	help	par_id3145098				0	it	Temete premuto \<item type=\"keycode\"\>Ctrl\</item\> e fate clic sull'oggetto.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\insert_graphic_fromdraw.xhp	0	help	par_id3156250				0	it	Trascinate l'oggetto nel punto del documento in cui volete inserirlo.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	tit				0	it	Inserire ed eliminare un'interruzione di pagina				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	bm_id3155183				0	it	\<bookmark_value\>Pagina;inserire e eliminare un'interruzione\</bookmark_value\>\<bookmark_value\>Inserimento;interruzione di pagina\</bookmark_value\>\<bookmark_value\>Eliminazione;interruzioni di pagina\</bookmark_value\>\<bookmark_value\>Pagina;inserire/eliminare interruzioni \</bookmark_value\>\<bookmark_value\>Interruzione di pagina manuale\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	hd_id3155183				0	it	\<variable id=\"page_break\"\>\<link href=\"text/swriter/guide/page_break.xhp\" name=\"Inserire ed eliminare un'interruzione di pagina\"\>Inserire ed eliminare un'interruzione di pagina\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	hd_id3149833				0	it	Per inserire manualmente un'interruzione di pagina:				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	par_id3153402				0	it	Fate clic nel punto del documento in cui volete che inizi la nuova pagina.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	par_id3153119				0	it	Premete Ctrl+Invio.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	hd_id3153135				0	it	Per eliminare un'interruzione di pagina inserita manualmente:				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	par_id3149641				0	it	Fate clic davanti al primo carattere della pagina successiva all'interruzione manuale.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	par_id3149608				0	it	Premete Backspace.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	hd_id3149624				0	it	Per eliminare un'interruzione di pagina manuale che precede una tabella:				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	par_id3145111				0	it	Fate clic con il pulsante destro del mouse nella tabella e scegliete \<emph\>Tabella\</emph\>.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	par_id3156254				0	it	Andate alla scheda \<link href=\"text/swriter/01/05090300.xhp\" name=\"Flusso di testo\"\>\<emph\>Flusso di testo\</emph\>\</link\>.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	par_id3153380				0	it	Deselezionate la casella \<emph\>Interruzione\</emph\>.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\page_break.xhp	0	help	par_id3154249				0	it	\<link href=\"text/swriter/01/04010000.xhp\" name=\"Finestra di dialogo Inserisci interruzione\"\>Finestra di dialogo Inserisci interruzione\</link\>				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	tit				0	it	Definire le voci di un indice				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	bm_id3149689				0	it	\<bookmark_value\>Indice;definire una voce\</bookmark_value\>\<bookmark_value\>Indice generale;definire le voci\</bookmark_value\>\<bookmark_value\>Voce;definire in un indice analitico\</bookmark_value\>\<bookmark_value\>Voce;definire in un indice generale\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	hd_id3149689				0	it	\<variable id=\"indices_enter\"\> \<link href=\"text/swriter/guide/indices_enter.xhp\" name=\"Definire le voci di un indice\"\>Definire le voci di un indice\</link\> \</variable\>				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	hd_id3155862				0	it	Per definire voci d'indice				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	par_id3156380				0	it	Fate clic su una parola, oppure selezionate le parole del documento da usare come voci dell'indice.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	par_id3147409				0	it	Scegliete \<emph\>Inserisci - Indici - Voce\</emph\> e usate una delle procedure seguenti:				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	par_id3153417				0	it	Per modificare il testo che appare nell'indice, digitate il testo desiderato nella casella \<emph\>Voce\</emph\>. Il testo inserito qui non sostituisce quello selezionato nel documento.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	par_id3154258				0	it	Per aggiungere un contrassegno di indice alle parole simili all'interno del documento, selezionate \<emph\>Applica a tutti i testi simili\</emph\>.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	par_id3155889				0	it	Per aggiungere delle voci a un indice personalizzato, fate clic sull'icona \<emph\>Nuovo indice personalizzato\</emph\>, inserite il nome dell'indice, poi premete \<emph\>OK\</emph\>.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	hd_id3147119				0	it	Per definire delle voci di un indice generale:				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	par_id3147132				0	it	Il modo migliore per generare un indice generale consiste nell'applicare i modelli di paragrafo predefiniti per le intestazioni, ad esempio "Intestazione 1", ai paragrafi da includere nell'indice.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	hd_id3150230				0	it	Per usare uno stile di paragrafo personalizzato come voce di un indice generale:				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	par_id3150933				0	it	Scegliete \<emph\>Strumenti - Numerazione capitolo\</emph\> e fate clic sulla scheda \<emph\>Numerazione\</emph\>.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	par_id3150964				0	it	Selezionate lo stile di paragrafo che desiderate includere nell'indice generale nella casella \<emph\>Stili di paragrafo\</emph\>.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	par_id3150523				0	it	Nell'elenco \<emph\>Livello\</emph\>, fate clic sul livello gerarchico che volete assegnare allo stile di paragrafo.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\indices_enter.xhp	0	help	par_id3153730	17			0	it	Fate clic su \<emph\>OK\</emph\>. A questo punto potete applicare lo stile alle intestazioni presenti nel documento e includerle nell'indice generale.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	tit				0	it	Definire i bordi degli oggetti 				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	bm_id3146957				0	it	\<bookmark_value\>Oggetto;definire bordo\</bookmark_value\>\<bookmark_value\>Bordo;per oggetti\</bookmark_value\>\<bookmark_value\>Cornice;attorno ad oggetti\</bookmark_value\>\<bookmark_value\>Grafico;bordi\</bookmark_value\>\<bookmark_value\>Immagine;bordi\</bookmark_value\>\<bookmark_value\>Oggetto OLE;bordi\</bookmark_value\>\<bookmark_value\>Aggiunta;bordi degli oggetti\</bookmark_value\>\<bookmark_value\>Definizione;bordi degli oggetti\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	hd_id3146957				0	it	\<variable id=\"border_object\"\>\<link href=\"text/swriter/guide/border_object.xhp\" name=\"Definire bordi per gli oggetti\"\>Definire bordi per gli oggetti\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	par_id3146797				0	it	In Writer potete definire bordi attorno ad oggetti OLE, plugin, diagrammi/grafici, immagini e cornici. Il nome del menu da utilizzare dipende dall'oggetto selezionato.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	hd_id3145673				0	it	Per impostare uno stile bordo predefinito:				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	par_id3155388				0	it	Selezionate l'oggetto per il quale desiderate definire un bordo.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	par_id3149578	4			0	it	Fate clic sull'icona \<emph\>Bordo\</emph\> nella barra degli strumenti \<emph\>Oggetto OLE\</emph\> o nella barra degli strumenti \<emph\>Cornice\</emph\> per aprire la finestra \<emph\>Bordo\</emph\>. 				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	par_id3159176				0	it	Fate clic su uno degli stili bordo predefiniti. Lo stile bordo attuale dell'oggetto verrà sostituito con lo stile selezionato.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	hd_id3152474				0	it	Per impostare uno stile bordo personalizzato:				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	par_id3153896				0	it	Selezionate l'oggetto che desiderate modificare.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	par_id3156344	9			0	it	Scegliete \<item type=\"menuitem\"\>Formato - (nome oggetto) – Bordi\</item\>.\<br/\>Sostituite (nome oggetto) con il tipo di oggetto selezionato.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	par_id3148797				0	it	Nell'area \<emph\>Personalizzato\</emph\> selezionate i lati del bordo che desiderate fare apparire in un layout comune. Fate clic su un lato del bordo nell'anteprima per attivarne/disattivarne la selezione.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	par_id3152933				0	it	Selezionate uno stile linea e un colore per lo stile bordo selezionato nell'area \<emph\>Linea\</emph\>. Queste impostazioni si applicano a tutte le linee incluse nello stile di bordo selezionato.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	par_id3125865				0	it	Ripetete le ultime due operazioni per ciascun lato del bordo.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	par_id3150447				0	it	Selezionate la distanza tra le linee del bordo e il contenuto della pagina nell'area \<emph\>Distanza dal contenuto\</emph\>.				20200411 15:09:53
helpcontent2	source\text\swriter\guide\border_object.xhp	0	help	par_id3154908				0	it	Per applicare le modifiche, fate clic su \<emph\>OK\</emph\>.				20200411 15:09:53
helpcontent2	source\text\swriter\01\05130004.xhp	0	help	tit				0	it	Stile di numerazione				20200411 15:09:53
helpcontent2	source\text\swriter\01\05130004.xhp	0	help	hd_id3155961				0	it	\<link href=\"text/swriter/01/05130004.xhp\" name=\"Stile di numerazione\"\>Stile di numerazione\</link\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05130004.xhp	0	help	par_id3149501				0	it	In questa finestra di dialogo potete creare uno stile di numerazione. Gli stili di numerazione sono organizzati nella finestra \<link href=\"text/swriter/01/05140000.xhp\" name=\"Stili e formattazione\"\>Stili e formattazione\</link\>.				20200411 15:09:53
helpcontent2	source\text\swriter\01\05130004.xhp	0	help	par_id3151390				0	it	Quando si crea uno stile di numerazione alla numerazione viene assegnato un nome, ecco perché questi modelli vengono definiti anche numerazioni nominate. Per creare numerazioni senza nome da utilizzare per la \<link href=\"text/shared/00/00000005.xhp#formatierung\" name=\"formattazione diretta\"\>formattazione diretta\</link\>, potete usare la finestra di dialogo \<link href=\"text/shared/01/06050000.xhp\" name=\"Elenchi puntati e numerati\"\>Elenchi puntati e numerati\</link\> o le icone della \<link href=\"text/swriter/main0206.xhp\" name=\"barra degli strumenti\"\>barra degli strumenti\</link\>.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	tit				0	it	Tag speciali				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	bm_id3154106				0	it	\<bookmark_value\>Tag; in $[officename] Writer\</bookmark_value\>\<bookmark_value\>$[officename] Writer; tag HTML speciali\</bookmark_value\>\<bookmark_value\>HTML; tag speciali per i campi\</bookmark_value\>\<bookmark_value\>Campo; importare ed esportare in formato HTML\</bookmark_value\>\<bookmark_value\>Ora; comando di campo nei documenti HTML\</bookmark_value\>\<bookmark_value\>Data; comando di campo nei documenti HTML\</bookmark_value\>\<bookmark_value\>Comando di campo; informazioni sul documento\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	hd_id3154106				0	it	\<link href=\"text/swriter/01/04090007.xhp\" name=\"Tag speciali\"\>Tag speciali\</link\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3153669				0	it	Quando salvate in formato HTML un documento che contiene comandi di campo,  $[officename] converte automaticamente i campi di data e ora e i campi info in speciali tag HTML. Il contenuto dei comandi di campo viene inserito tra i tag di apertura e di chiusura HTML dei campi convertiti. Questi speciali tag HTML non corrispondono ai tag HTML standard.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3152960				0	it	I campi di $[officename] Writer vengono identificati dal tag <SDFIELD> nei documenti HTML. Il tipo, il formato e il nome del campo speciale vengono inclusi nel tag HTML di apertura. Il formato dei tag riconosciuti dal filtro HTML dipende dal tipo di campo.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	hd_id3154570				0	it	Campi Data e Orario				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3149696				0	it	Per i comandi di campo "Data" e "Orario", il parametro TYPE equivale a DATETIME. Il formato della data o dell'ora è specificato dal parametro SDNUM, ad esempio DD:MM:YY per la data o HH:MM:SS per l'ora.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3155183				0	it	Per i comandi di campo con contenuto fisso, la data e l'ora sono specificati dal parametro SDVAL.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3149485				0	it	La tabella seguente contiene alcuni esempi dei tag HTML speciali usati per la data e per l'ora che vengono riconosciuti da $[officename] come comandi di campo:				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3151257				0	it	\<emph\>Comando di campo\</emph\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3148970				0	it	\<emph\>Tag di $[officename]\</emph\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3147102				0	it	Data fissa				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3153634				0	it	<SDFIELD TYPE=DATETIME SDVAL="35843,4239988426" SDNUM="1031;1031;GG.MM.AA">17.02.98</SDFIELD>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3155137				0	it	Data				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3156275				0	it	<SDFIELD TYPE=DATETIME SDNUM="1031;1031;GG.MM.AA">17.02.98</SDFIELD>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3145774				0	it	Orario fisso				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3155915				0	it	<SDFIELD TYPE=DATETIME SDVAL="35843,4240335648" SDNUM="1031;1031;HH:MM:SS">10:10:36</SDFIELD>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3150110				0	it	Orario				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3155862				0	it	<SDFIELD TYPE=DATETIME SDNUM="1031;1031;HH:MM:SS">10:10:36</SDFIELD>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	hd_id3147409				0	it	Campi informazioni documento				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3147487				0	it	Per i campi "Info", il parametro TYPE equivale a DOCINFO. Il parametro SUBTYPE mostra il tipo di campo specifico; ad esempio, per il campo di informazioni "Creato", SUBTYPE=CREATE. Per i comandi di campo di data e ora usati in "Info documento", il parametro FORMAT equivale a DATE o TIME, mentre il parametro SDNUM indica il formato utilizzato per i numeri. Il parametro SDFIXED indica se il contenuto del comando di campo "Info documento" è fisso o meno.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3147501				0	it	Se i comando di campo di data e ora sono fissi, il loro contenuto equivale al parametro SDVAL, diversamente equivale al testo che compare tra i tag HTML SDFIELD.				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3149562				0	it	La tabella seguente contiene alcuni esempi dei tag HTML speciali usati per i campi "Info documento" che vengono riconosciuti da $[officename] come comandi di campo:				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3147738				0	it	\<emph\>Comando di campo\</emph\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3146334				0	it	\<emph\>Tag di $[officename]\</emph\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3149846				0	it	Descrizione (contenuto fisso)				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3148863				0	it	<SDFIELD TYPE=DOCINFO SUBTYPE=COMMENT SDFIXED>Descrizione</SDFIELD>				20200411 15:09:53
