helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3145172				0	it	const b1=12,345e12				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3159254				0	it	const b2=1,345e34				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3147287				0	it	dValore=Exp( Log(b1)+Log(b2) )				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3161832				0	it	MsgBox "" & dValore & chr(13) & (b1*b2) ,0,"Moltiplicazione per logaritmo"				20200411 15:09:53
