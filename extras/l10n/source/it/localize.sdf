helpcontent2	source\text\shared\01\05340500.xhp	0	help	par_id3155620				0	it	\<ahelp hid=\".\"\>Nasconde la colonna o le colonne selezionate. Per visualizzare le colonne nascoste, fate clic con il pulsante destro del mouse su un'intestazione e scegliete \<emph\>Mostra colonne\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	tit				0	it	Conversione cinese				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	bm_id49745				0	it	\<bookmark_value\>Cinese;sistemi di scrittura\</bookmark_value\>\<bookmark_value\>Cinese semplificato;conversione in cinese tradizionale\</bookmark_value\>\<bookmark_value\>Cinese tradizionale;conversione in cinese semplificato\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10547				0	it	\<link href=\"text/shared/01/06010600.xhp\"\>Conversione cinese\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10557				0	it	\<ahelp hid=\".\"\>Converte il testo cinese selezionato da un sistema di scrittura all'altro. Se il testo non è selezionato, viene convertito l'intero documento.\</ahelp\> Questo comando è disponibile solo se avete attivato il supporto per le lingue asiatiche in \<emph\>Strumenti - Opzioni - Impostazioni lingua - Lingue\</emph\>.				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10572				0	it	Direzione della conversione				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10576				0	it	\<ahelp hid=\".\"\>Selezionate la direzione della conversione.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10579				0	it	Da cinese tradizionale a cinese semplificato				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1057D				0	it	Converte i caratteri dal cinese tradizionale al cinese semplificato.\<ahelp hid=\".\"\>. Fate clic su \<emph\>OK\</emph\> per convertire il testo selezionato. Se il testo non è selezionato, viene convertito l'intero documento.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10580				0	it	Da cinese semplificato a cinese tradizionale				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10584				0	it	\<ahelp hid=\".\"\>Converte i caratteri dal cinese semplificato al cinese tradizionale. Fate clic su \<emph\>OK\</emph\> per convertire il testo selezionato. Se il testo non è selezionato, viene convertito l'intero documento.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1058E				0	it	Termini comuni				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10592				0	it	\<ahelp hid=\".\"\>I termini comuni sono parole che hanno lo stesso significato nel cinese tradizionale e in quello semplificato ma sono scritte con caratteri diversi.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10595				0	it	Conversione dei termini comuni				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10599				0	it	\<ahelp hid=\".\"\>Converte le parole di due o più caratteri incluse nell'elenco dei termini comuni. Dopo l'analisi dell'elenco, il testo restante viene convertito carattere per carattere.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1059C				0	it	Modifica termini				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN105A0				0	it	\<ahelp hid=\".\"\>Apre la finestra di dialogo \<link href=\"text/shared/01/06010601.xhp\"\>Modifica dizionario\</link\> in cui potete modificare l'elenco dei termini usati per la conversione.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	tit				0	it	Commento				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	hd_id3083278				0	it	Commento				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	par_id3148983				0	it	\<variable id=\"kommentartext\"\>\<ahelp hid=\"HID_REDLINING_EDIT\"\>Inserite un commento per la modifica registrata.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	par_id3155391	3			0	it	Potete digitare un commento quando \<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>il cursore si trova in un passaggio di testo modificato\</caseinline\>\<caseinline select=\"CALC\"\>è selezionata la cella modificata\</caseinline\>\</switchinline\> oppure nella finestra di dialogo \<emph\>Accetta o annulla le modifiche\</emph\>.				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	par_id3156426	5			0	it	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>Posizionando il puntatore del mouse su una cella contenente una modifica registrata, i relativi commenti vengono visualizzati come legende. Oppure, per visualizzare i commenti associati a una cella modificata, potete esaminare l'elenco delle modifiche nella finestra di dialogo \<link href=\"text/shared/01/02230400.xhp\" name=\"Accetta o annulla modifiche\"\>\<emph\>Accetta o annulla modifiche\</emph\>\</link\>.\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	tit				0	it	Elenco delle espressioni regolari				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	bm_id3146765				0	it	\<bookmark_value\>Espressioni regolari; elenco di\</bookmark_value\>\<bookmark_value\>Elenco;espressioni regolari\</bookmark_value\>\<bookmark_value\>Sostituzione;tabulazioni (espressioni regolari)\</bookmark_value\>\<bookmark_value\>Tabulazione;espressioni regolari\</bookmark_value\>\<bookmark_value\>Concatenazione, vedere simbolo &\</bookmark_value\>\<bookmark_value\>&, simbolo;vedere anche Operatore\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	hd_id3146765				0	it	\<variable id=\"02100001\"\>\<link href=\"text/shared/01/02100001.xhp\"\>Elenco delle espressioni regolari\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149741				0	it	Carattere				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155577				0	it	\<emph\>Effetto/uso\</emph\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id6600543				0	it	Qualsiasi carattere				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9824518.00000001				0	it	Rappresenta il carattere dato se non diversamente specificato.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152427				0	it	.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149031				0	it	Rappresenta qualsiasi carattere singolo, ad eccezione dei caratteri di interruzione riga o interruzione di paragrafo. Ad esempio, la ricerca di "R.ssi" restituisce sia "Rossi" che "Russi".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154682				0	it	^				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155351				0	it	Trova il termine ricercato solo se appare all'inizio di un paragrafo. Eventuali oggetti speciali (come campi vuoti o cornici ancorate a caratteri) all'inizio di un paragrafo vengono ignorati. Esempio: "^Mario".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3159194				0	it	$				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152542				0	it	Trova il termine ricercato solo se appare alla fine di un paragrafo. Eventuali oggetti speciali (come campi vuoti o cornici ancorate a caratteri) alla fine di un paragrafo vengono ignorati. Esempio: "Mario$".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156414				0	it	*				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155555				0	it	Identifica l'assenza o la presenza di uno o più dei caratteri che precedono "*". Ad esempio, "Ab*c" trova "Ac", "Abc", "Abbc", "Abbbc" e così via.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147399				0	it	+				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3157958				0	it	Identifica uno o più caratteri che precedono "+". Ad esempio, "AX.+4" trova "AXx4", ma non "AX4".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145313				0	it	Viene sempre trovata la stringa più lunga corrispondente al modello di ricerca in un paragrafo. Se il paragrafo contiene la stringa "AX 4 AX4", viene evidenziato l'intero passaggio.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3143267				0	it	?				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153684				0	it	Identifica l'assenza o una singola occorrenza dei caratteri che precedono "?". Ad esempio, "Testi?" restituisce "Test" e "Testi", mentre "x(ab|c)?y" restituisce "xy", "xaby" o "xcy".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3166410				0	it	\\				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147209				0	it	La ricerca interpreta il carattere speciale che segue "\\" come un carattere normale e non come un'espressione regolare (ad eccezione delle combinazioni \\n, \\t, \\> e \\<). Ad esempio, "figli\\." trova "figli.", non "figlio" o "figlia".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152945				0	it	\\n				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153700				0	it	Rappresenta un'interruzione di riga inserita con la combinazione di tasti Maiusc+Invio. Per trasformare l'interruzione di riga in un'interruzione di paragrafo, inserite \<emph\>\\n\</emph\> nelle caselle \<emph\>Cerca\</emph\> e \<emph\>Sostituisci con\</emph\>, quindi eseguite un'operazione di ricerca e sostituzione.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9262672				0	it	\\n nella casella di testo \<emph\>Cerca\</emph\> rappresenta un'interruzione di riga inserita con la combinazione di tasti Maiusc+Invio.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id2366100				0	it	\\n nella casella di testo \<emph\>Sostituisci con\</emph\> rappresenta un'interruzione di paragrafo che può essere inserita col tasto Invio.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153258				0	it	\\t				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3157809				0	it	Rappresenta una tabulazione. Potete utilizzare questa espressione anche nella casella \<emph\>Sostituisci con\</emph\>.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150670				0	it	\\b				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153666				0	it	Indica il limite di una parola. Per esempio, "\\blibro" trova "librone" ma non "calibro" mentre "libro\\b" trova "calibro" ma non "librone". La parola singola "libro" è trovata da entrambi i criteri di ricerca.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149576				0	it	^$				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3151245				0	it	Individua un paragrafo vuoto.				20200411 15:09:53
