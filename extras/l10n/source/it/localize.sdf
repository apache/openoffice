helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3155855	15			0	it	REM Verifica se la frase contiene la parola "e".				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3146984	16			0	it	REM Invece della riga di comando				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3148576	17			0	it	REM If Instr(Input, "e")<>0 Then...				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3154014	18			0	it	REM la funzione CBool viene applicata come segue:				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3155413	19			0	it	If CBool(Instr(sTesto, "e")) Then				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3152940	20			0	it	MsgBox "La frase inserita contiene la parola "e""				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3153954	21			0	it	EndIf				20130618 17:22:18
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3152886	22			0	it	End Sub				20130618 17:22:18
