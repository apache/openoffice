helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id3153249				0	it	\<ahelp hid=\".\"\>Deviazione standard: visualizza la deviazione standard (radice quadrata della varianza).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id3149870				0	it	\<ahelp hid=\".\"\>Margine dell'errore: mostra il più elevato margine di errore espresso in percentuale riferito al valore più elevato del gruppo di dati. Impostate la percentuale nell'area Parametri.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	hd_id350962				0	it	Intervallo di celle				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id6679586				0	it	\<ahelp hid=\".\"\>Fate clic sull'Intervallo di celle, e poi specificate l'intervallo di celle dal quale prendere i valori delle barre dell'errore positivo e negativo.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id3872188				0	it	\<ahelp hid=\".\" visibility=\"hidden\"\>Fate clic su un pulsante per ridurre la finestra di dialogo, poi selezionate l'intervallo di celle del foglio di lavoro utilizzando il mouse. Fate clic ancora sul pulsante per ripristinare le dimensioni massime della finestra di dialogo.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	hd_id2633747				0	it	Dalla tabella dei dati				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id6633503				0	it	\<ahelp hid=\".\"\>In un grafico con i propri dati, potete inserire i valori della barra dell'errore nella tabella dei dati del grafico. La finestra di dialogo Tabella dei dati, mostra delle colonne aggiuntive denominate Barre dell'errore positivo Y e Barre dell'errore negativo Y.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id0428200810573839				0	it	\<ahelp hid=\".\" visibility=\"hidden\"\>Inserite il valore da aggiungere al valore visualizzato come valore dell'errore positivo.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id0428200810573862				0	it	\<ahelp hid=\".\" visibility=\"hidden\"\>Inserite il valore da sottrarre al valore visualizzato come valore dell'errore negativo.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id0428200810573844				0	it	\<ahelp hid=\".\" visibility=\"hidden\"\>Inserite l'intervallo di indirizzi dai quali ottenere i valori dell'errore positivo. Utilizzate il pulsante Riduci per selezionare l'intervallo all'interno di un foglio di lavoro.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id0428200810573970				0	it	\<ahelp hid=\".\" visibility=\"hidden\"\>Inserite l'intervallo di indirizzi dai quali ottenere i valori dell'errore negativo. Utilizzate il pulsante Riduci per selezionare l'intervallo all'interno di un foglio di lavoro.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	hd_id0428200810573977				0	it	Valori identici				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id0428200810573991				0	it	\<ahelp hid=\".\"\>Abilitate l'uso dei valori dell'errore positivo anche come valori dell'errore negativo. Potete cambiare solo il valore della casella "Positivo (+)". Quel valore viene copiato automaticamente nella casella "Negativo (-)" .\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	hd_id3156396				0	it	Indicatore di errore				20200411 15:09:53
helpcontent2	source\text\schart\01\04050000.xhp	0	help	par_id3150539				0	it	\<ahelp hid=\"HID_SCH_CT_INDICATE2\"\>Specificate l'indicatore di errore.\</ahelp\>				20200411 15:09:53
