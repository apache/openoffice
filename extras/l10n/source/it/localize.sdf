helpcontent2	source\text\schart\01\05040202.xhp	0	help	hd_id1006200801024782				0	it	Linea dell'asse				20200411 15:09:53
helpcontent2	source\text\schart\01\05040202.xhp	0	help	par_id1006200801024970				0	it	\<ahelp hid=\".\"\>Selezionate dove intersecare l'altro asse: all'inizio, alla fine, in corrispondenza di un determinato valore, o in corrispondenza di una categoria.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\05040202.xhp	0	help	par_id1006200801024957				0	it	\<ahelp hid=\".\" visibility=\"hidden\"\>Digitate il valore dove l'asse dovrebbe intersecare l'altro asse.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\05040202.xhp	0	help	par_id100620080102503				0	it	\<ahelp hid=\".\" visibility=\"hidden\"\>Selezionate la categoria dove l'asse dovrebbe intersecare l'altro asse.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\05040202.xhp	0	help	hd_id100620080102509				0	it	Etichette				20200411 15:09:53
helpcontent2	source\text\schart\01\05040202.xhp	0	help	hd_id1006200801523879				0	it	Posiziona le etichette				20200411 15:09:53
helpcontent2	source\text\schart\01\05040202.xhp	0	help	par_id1006200801523889				0	it	\<ahelp hid=\".\"\>Selezionate dove disporre le etichette: vicino all'asse, vicino all'asse (dall'altro lato), fuori dall'inizio, fuori dalla fine.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\05040202.xhp	0	help	hd_id1006200801025030				0	it	Contrassegni per intervalli				20200411 15:09:53
helpcontent2	source\text\schart\01\05040202.xhp	0	help	hd_id3149048				0	it	Principali:				20200411 15:09:53
helpcontent2	source\text\schart\01\05040202.xhp	0	help	par_id3150397				0	it	Specifica se i contrassegni dovranno comparire all'interno o all'esterno dell'asse. Combinando le due opzioni, i contrassegni compariranno su entrambi i lati.				20200411 15:09:53
