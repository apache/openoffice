helpcontent2	source\text\shared\02\02170000.xhp	0	help	hd_id3154232				0	it	\<link href=\"text/shared/02/02170000.xhp\" name=\"Colore di sfondo\"\>Colore di sfondo\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\02\02170000.xhp	0	help	par_id3149140				0	it	\<variable id=\"hintergrundfarbetext\"\>\<ahelp hid=\".\"\>Fate clic per aprire una barra degli strumenti dove selezionare il colore di sfondo per il paragrafo. Il colore è applicato allo sfondo del paragrafo corrente o ai paragrafi selezionati.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\02\02170000.xhp	0	help	par_id3147276				0	it	\<image id=\"img_id3148538\" src=\"res/commandimagelist/sc_backgroundcolor.png\"\>\<alt id=\"alt_id3148538\"\> Icona\</alt\>\</image\>				20200411 15:09:53
