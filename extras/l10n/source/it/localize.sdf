helpcontent2	source\text\scalc\01\02150000.xhp	0	help	par_id3148405	10			0	it	\<ahelp hid=\"SC_CHECKBOX_RID_SCDLG_DELCONT_BTN_DELNUMBERS\"\>Elimina solo i numeri. Eventuali formati e formule presenti nelle celle rimangono invariati.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	hd_id3155764	11			0	it	Data & ora				20130618 17:22:18
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	par_id3149567	12			0	it	\<ahelp hid=\"SC_CHECKBOX_RID_SCDLG_DELCONT_BTN_DELDATETIME\"\>Elimina i valori di data e orario. Eventuali formati, stringhe di testo e formule presenti nelle celle rimangono invariati.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	hd_id3154703	13			0	it	Formule				20130618 17:22:18
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	par_id3148485	14			0	it	\<ahelp hid=\"SC_CHECKBOX_RID_SCDLG_DELCONT_BTN_DELFORMULAS\"\>Elimina le formule. Eventuali stringhe di testo, numeri, formati e valori di data e orario presenti nelle celle rimangono invariati.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\02150000.xhp	0	help	hd_id3150300	15			0	it	Commenti				20130618 17:22:18
