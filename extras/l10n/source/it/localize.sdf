helpcontent2	source\text\scalc\01\06030200.xhp	0	help	hd_id3155628	1			0	it	\<link href=\"text/scalc/01/06030200.xhp\" name=\"Rimuovi traccia sul precedente\"\>Rimuovi traccia sul precedente\</link\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\06030200.xhp	0	help	par_id3149456	2			0	it	\<ahelp hid=\".uno:ClearArrowPrecedents\"\>Elimina un livello delle frecce di traccia inserite con il comando \<emph\>Individua precedenti\</emph\>.\</ahelp\>				20130618 17:22:18
