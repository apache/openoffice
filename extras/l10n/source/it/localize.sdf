helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN10585				0	it	Cerca				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN10589				0	it	\<ahelp hid=\".\"\>Apre la finestra di dialogo \<link href=\"text/swriter/01/mm_finent.xhp\"\>Cerca elemento\</link\>. Durante la modifica degli elementi potete lasciare aperta la finestra di dialogo.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN1059A				0	it	Personalizza				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN1059E				0	it	\<ahelp hid=\".\"\>Apre la finestra di dialogo \<link href=\"text/swriter/01/mm_cusaddlis.xhp\"\>Personalizza elenco di indirizzi\</link\>, in cui potete ridisporre, rinominare, aggiungere ed eliminare i campi.\</ahelp\>				20200411 15:09:53
