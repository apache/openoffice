helpcontent2	source\text\shared\explorer\database\02010100.xhp	0	help	par_id3155947	257			0	it	Orario				20130618 17:22:18
helpcontent2	source\text\shared\explorer\database\02010100.xhp	0	help	par_id3150964	258			0	it	{D'HH:MM:SS'}				20130618 17:22:18
