helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165856	472			0	it	MEDIA				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165883	473			0	it	2				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165906	474			0	it	CONTA.NUMERI				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165933	475			0	it	3				20130618 17:22:18
