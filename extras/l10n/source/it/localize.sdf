helpcontent2	source\text\swriter\01\02110000.xhp	0	help	par_id3150707	59			0	it	\<ahelp hid=\"HID_NAVI_TBX15\"\>Diminuisce di uno il livello di struttura dell'intestazione selezionata e delle intestazioni sottostanti. Per diminuire solo il livello di struttura dell'intestazione selezionata, premete Ctrl e fate clic su questa icona.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\02110000.xhp	0	help	par_id3148414				0	it	\<image id=\"img_id3148420\" src=\"sw/imglst/sc20173.png\" width=\"0.2228in\" height=\"0.2228in\"\>\<alt id=\"alt_id3148420\"\>Icona\</alt\>\</image\>				20130618 17:22:18
