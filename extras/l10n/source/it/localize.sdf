helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1180455				0	it	\<item type=\"input\"\>=ARROTONDA.PER.ECC(45.67;0)\</item\> restituisce 46.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3405560				0	it	\<item type=\"input\"\>=ARROTONDA.PER.ECC(-45,67)\</item\> restituisce -46.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3409527				0	it	\<item type=\"input\"\>=ARROTONDA.PER.ECC(987,65;-2)\</item\> restituisce 1000.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144877				0	it	\<bookmark_value\>SEN, funzione\</bookmark_value\>				20200411 15:09:53
