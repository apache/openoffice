helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	hd_id3150616				0	he	\<link href=\"text/sbasic/shared/03080201.xhp\" name=\"Exp Function [Runtime]\"\>Exp Function [Runtime]\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3155555				0	he	Returns the base of the natural logarithm (e = 2.718282) raised to a power.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	hd_id3150984				0	he	תחביר:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3145315				0	he	Exp (Number)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	hd_id3154347				0	he	Return value:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3149670				0	he	Double				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	hd_id3154760				0	he	Parameters:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3150793				0	he	\<emph\>Number:\</emph\> Any numeric expression that specifies the power that you want to raise "e" to (the base of natural logarithms). The power must be for both single-precision numbers less than or equal to 88.02969 and double-precision numbers less than or equal to 709.782712893, since $[officename] Basic returns an Overflow error for numbers exceeding these values.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	hd_id3156280				0	he	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3153193				0	he	Sub ExampleLogExp				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3125864				0	he	Dim dValue as Double				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3145172				0	he	const b1=12.345e12				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3159254				0	he	const b2=1.345e34				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3147287				0	he	dValue=Exp( Log(b1)+Log(b2) )				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3161832				0	he	MsgBox "" & dValue & chr(13) & (b1*b2) ,0,"Multiplication by logarithm"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3151112				0	he	end sub				20200411 15:09:53
