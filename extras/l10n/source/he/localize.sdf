helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3145349				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3150569				0	he	DEC2BIN(Number;Places)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3148768				0	he	Number: the decimal number. If \<emph\>Number\</emph\> is negative, the function returns a binary number with 10 characters. The most significant bit is the sign bit, the other 9 bits return the value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3149537				0	he	Places: the number of places to be output.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3150265				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3150662				0	he	=DEC2BIN(100;8) returns 01100100.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	bm_id3149388				0	he	\<bookmark_value\>DEC2HEX function\</bookmark_value\>\<bookmark_value\>converting;decimal numbers, into hexadecimal numbers\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3149388				0	he	DEC2HEX				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3149030				0	he	\<ahelp hid=\"HID_AAI_FUNC_DEC2HEX\"\>The result is the hexadecimal number for the decimal number entered.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3150691				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3147535				0	he	DEC2HEX(Number;Places)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3152820				0	he	Number: the decimal number. If \<emph\>Number\</emph\> is negative, the function returns a hexadecimal number with 10 characters (40 bits). The most significant bit is the sign bit, the other 39 bits return the value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3153221				0	he	Places: the number of places to be output.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3154869				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3150476				0	he	=DEC2HEX(100;4) returns 0064.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	bm_id3154948				0	he	\<bookmark_value\>DEC2OCT function\</bookmark_value\>\<bookmark_value\>converting;decimal numbers, into octal numbers\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3154948				0	he	DEC2OCT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3153920				0	he	\<ahelp hid=\"HID_AAI_FUNC_DEC2OCT\"\>The result is the octal number for the decimal number entered.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3153178				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3148427				0	he	DEC2OCT(Number; Places)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3155991				0	he	Number: the decimal number. If \<emph\>Number\</emph\> is negative, the function returns an octal number with 10 characters (30 bits). The most significant bit is the sign bit, the other 29 bits return the value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3152587				0	he	Places: the number of places to be output.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3147482				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3154317				0	he	=DEC2OCT(100;4) returns 0144.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	bm_id3083446				0	he	\<bookmark_value\>ERF function\</bookmark_value\>\<bookmark_value\>Gaussian error integral\</bookmark_value\>				20200411 15:09:53
