helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	par_id8469191				0	he	\<ahelp hid=\".\"\>Inserts a hyphen that will keep bordering characters together on line breaks.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	hd_id3306680				0	he	Optional hyphen				20200411 15:09:53
helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	par_id9407330				0	he	\<ahelp hid=\".\"\>Inserts an invisible hyphen within a word that will appear and create a line break once it becomes the last character in a line.\</ahelp\>				20200411 15:09:53
