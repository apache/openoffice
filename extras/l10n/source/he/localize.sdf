helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3146923				0	he	Single				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3150011	31			0	he	\<variable id=\"einzeiligtext\"\>Applies single line spacing to the current paragraph. This is the default setting. \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3148500				0	he	1.5 lines				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3150094	34			0	he	\<variable id=\"eineinhalbzeiligtext\"\>Sets the line spacing to 1.5 lines. \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3149378				0	he	Double				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3154512	37			0	he	\<variable id=\"zweizeiligtext\"\>Sets the line spacing to two lines. \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3151206				0	he	Proportional				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3147494				0	he	Select this option and then enter a percentage value in the box, where 100% corresponds to single line spacing.				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3156332				0	he	At Least				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3157965				0	he	Sets the minimum line spacing to the value that you enter in the box.				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3150744				0	he	If you use different font sizes within a paragraph, the line spacing is automatically adjusted to the largest font size. If you prefer to have identical spacing for all lines, specify a value in \<emph\>At least\</emph\> that corresponds to the largest font size.				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3153927				0	he	Leading				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3153354				0	he	Sets the height of the vertical space that is inserted between two lines.				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3155443	54			0	he	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Fixed \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3153711	55			0	he	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Sets the line spacing to exactly match the value that you enter in the box. This can result in cropped characters. \</caseinline\>\</switchinline\>				20200411 15:09:53
