helpcontent2	source\text\schart\01\wiz_chart_type.xhp	0	help	par_id9930722				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Displays stacked series for Line charts.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\wiz_chart_type.xhp	0	help	par_id5749687				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Stack series display values on top of each other.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\wiz_chart_type.xhp	0	help	par_id79348				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Stack series display values as percent.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\wiz_chart_type.xhp	0	help	par_id2414014				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>The lines are shown as curves.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\wiz_chart_type.xhp	0	help	par_id7617114				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Opens a dialog to set the curve properties.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\wiz_chart_type.xhp	0	help	par_id6649372				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Connects points by ascending X values, even if the order of values is different, in an XY scatter diagram.\</ahelp\>				20200411 15:09:53
