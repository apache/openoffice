helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3155854				0	he	April				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3148575				0	he	May				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3145271				0	he	June				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3145648				0	he	2nd Quarter				20200411 15:09:53
