helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3152986				0	he	\<variable id=\"texttext\"\>This section contains descriptions of the \<emph\>Text\</emph\> functions.\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149384				0	he	\<bookmark_value\>ARABIC function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149384				0	he	ARABIC				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153558				0	he	\<ahelp hid=\"HID_FUNC_ARABISCH\"\>Calculates the value of a Roman number. The value range must be between 0 and 3999.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153011				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155523				0	he	ARABIC (Text)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151193	243			0	he	\<emph\>Text\</emph\> is the text that represents a Roman number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155758				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154621	245			0	he	ARABIC("MXIV") returns 1014				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147553	246			0	he	ARABIC("MMII") returns 2002				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id8796349				0	he	\<bookmark_value\>ASC function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id7723929				0	he	ASC				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id8455153				0	he	\<ahelp hid=\".\"\>The ASC function converts full-width to half-width ASCII and katakana characters. Returns a text string.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id9912411				0	he	See \<link href=\"https://wiki.openoffice.org/wiki/Calc/Features/JIS_and_ASC_functions\"\>JIS and ASC Spreadsheet Functions\</link\> for a conversion table.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id9204992				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id1993774				0	he	ASC("Text")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id2949919				0	he	            \<emph\>Text\</emph\> is the text that contains characters to be converted.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id2355113				0	he	See also JIS function.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id9323709				0	he	\<bookmark_value\>BAHTTEXT function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id6695455				0	he	BAHTTEXT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id354014				0	he	Converts a number to Thai text, including the Thai currency names.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id9942014				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id8780785				0	he	BAHTTEXT(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id1539353				0	he	\<emph\>Number\</emph\> is any number. "Baht" is appended to the integral part of the number, and "Satang" is appended to the decimal part of the number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id9694814				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3289284				0	he	BAHTTEXT(12.65) returns a string in Thai characters with the meaning of "Twelve Baht and sixty five Satang".				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3153072				0	he	\<bookmark_value\>BASE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153072				0	he	BASE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153289				0	he	\<ahelp hid=\"HID_FUNC_BASIS\"\>Converts a positive integer to a specified base into a text from the \<link href=\"text/shared/00/00000005.xhp#zahlensystem\" name=\"numbering system\"\>numbering system\</link\>.\</ahelp\> The digits 0-9 and the letters A-Z are used.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146097				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155743				0	he	‎BASE(Number; Radix; [MinimumLength])‎				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151339	217			0	he	\<emph\>number\</emph\> is the positive integer to be converted.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3159262	218			0	he	\<emph\>radix\</emph\> indicates the base of the number system. It may be any positive integer between 2 and 36.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148746	219			0	he	\<emph\>Minimum length\</emph\> (optional) determines the minimum length of the character sequence that has been created. If the text is shorter than the indicated minimum length, zeros are added to the left of the string.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146323				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3156399				0	he	\<bookmark_value\>decimal system; converting to\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156399	221			0	he	BASE(17;10;4) returns 0017 in the decimal system.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3157871				0	he	\<bookmark_value\>binary system; converting to\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3157871	222			0	he	BASE(17;2) returns 10001 in the binary system.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3145226				0	he	\<bookmark_value\>hexadecimal system; converting to\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145226	223			0	he	BASE(255;16;4) returns 00FF in the hexadecimal system.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149321				0	he	\<bookmark_value\>CHAR function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149321				0	he	CHAR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149150				0	he	\<ahelp hid=\"HID_FUNC_ZEICHEN\"\>Converts a number into a character according to the current code table.\</ahelp\> The number can be a two-digit or three-digit integer number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149945				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145634				0	he	CHAR(number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155906	205			0	he	\<emph\>number\</emph\> is a number between 1 and 255 representing the code value for the character.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152982				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149890	208			0	he	CHAR(100) returns the character "d".				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id0907200910283297				0	he	="abc" & CHAR(10) & "def" inserts a newline character into the string.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149009				0	he	\<bookmark_value\>CLEAN function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149009				0	he	CLEAN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150482				0	he	\<ahelp hid=\"HID_FUNC_SAEUBERN\"\>All non-printing characters are removed from the string.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146880				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147472				0	he	CLEAN(text)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150695	136			0	he	\<emph\>text\</emph\> refers to the text from which to remove all non-printable characters.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3155498				0	he	\<bookmark_value\>CODE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155498				0	he	CODE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3152770				0	he	\<ahelp hid=\"HID_FUNC_CODE\"\>Returns a numeric code for the first character in a text string.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155830				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149188				0	he	CODE(Text)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154383	7			0	he	\<emph\>Text\</emph\> is the text for which the code of the first character is to be found.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3154394				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3159209	9			0	he	CODE("Hieronymus") returns 72, CODE("hieroglyphic") returns 104.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150280				0	he	The code used here does not refer to ASCII, but to the code table currently loaded.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149688				0	he	\<bookmark_value\>CONCATENATE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149688				0	he	CONCATENATE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154524				0	he	\<ahelp hid=\"HID_FUNC_VERKETTEN\"\>Combines several text strings into one string.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149542				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155954				0	he	CONCATENATE(Text 1;...;Text 30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146847	171			0	he	\<emph\>Text 1; text 2; ...\</emph\> represent up to 30 text passages which are to be combined into one string.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153110				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150008	173			0	he	CONCATENATE("Good ";"Morning ";"Mrs. ";"Doe") returns \<emph\>Good Morning Mrs. Doe\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3145166				0	he	\<bookmark_value\>DECIMAL function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3145166				0	he	DECIMAL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156361				0	he	\<ahelp hid=\"HID_FUNC_DEZIMAL\"\>Converts text with characters from a \<link href=\"text/shared/00/00000005.xhp#zahlensystem\" name=\"number system\"\>number system\</link\> to a positive integer in the base radix given.\</ahelp\> The radix must be in the range 2 to 36. Spaces and tabs are ignored. The \<emph\>Text\</emph\> field is not case-sensitive.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3157994				0	he	If the radix is 16, a leading x or X or 0x or 0X, and an appended h or H, is disregarded. If the radix is 2, an appended b or B is disregarded. Other characters that do not belong to the number system generate an error.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150014				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154328				0	he	DECIMAL(Text; Radix)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150128	230			0	he	\<emph\>text\</emph\> is the text to be converted. To differentiate between a hexadecimal number, such as A1 and the reference to cell A1, you must place the number in quotation marks, for example, "A1" or "FACE".				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145241	231			0	he	\<emph\>radix\</emph\> indicates the base of the number system. It may be any positive integer between 2 and 36.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3156062				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145355	233			0	he	DECIMAL("17";10) returns 17.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155622	234			0	he	DECIMAL("FACE";16) returns 64206.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151015	235			0	he	DECIMAL("0101";2) returns 5.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3148402				0	he	\<bookmark_value\>DOLLAR function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148402				0	he	DOLLAR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153049	12			0	he	\<ahelp hid=\"HID_FUNC_DM\"\>Converts a number to an amount in the currency format, rounded to a specified decimal place.\</ahelp\> In the \<item type=\"literal\"\>Value\</item\> field enter the number to be converted to currency. Optionally, you may enter the number of decimal places in the \<item type=\"literal\"\>Decimals\</item\> field. If no value is specified, all numbers in currency format will be displayed with two decimal places. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151280				0	he	You set the currency format in your system settings.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150569				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154188				0	he	DOLLAR(value; decimals)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145299	15			0	he	\<emph\>value\</emph\> is a number, a reference to a cell containing a number, or a formula which returns a number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145629	16			0	he	\<emph\>decimals\</emph\> is the optional number of decimal places.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149030				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153546	18			0	he	DOLLAR(255) returns $255.00.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154635	19			0	he	            \<item type=\"input\"\>=DOLLAR(367.456;2)\</item\> returns $367.46. Use the decimal separator that corresponds to the \<link href=\"text/shared/optionen/01140000.xhp\" name=\"current locale setting\"\>current locale setting\</link\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3150685				0	he	\<bookmark_value\>EXACT function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150685				0	he	EXACT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3158413				0	he	\<ahelp hid=\"HID_FUNC_IDENTISCH\"\>Compares two text strings and returns TRUE if they are identical.\</ahelp\> This function is case-sensitive.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152817				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148594				0	he	EXACT(text_1;text_2)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153224	82			0	he	\<emph\>text_1\</emph\> refers to the first text to compare.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148637	83			0	he	\<emph\>text_2\</emph\> is the second text to compare.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149777				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156263	85			0	he	EXACT("Sun microsystems";"Sun Microsystems") returns FALSE.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3152589				0	he	\<bookmark_value\>FIND function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152589				0	he	FIND				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146149				0	he	\<ahelp hid=\"HID_FUNC_FINDEN\"\>Looks for a string of text within another string.\</ahelp\> You can also define where to begin the search. The search term can be a number or any string of characters. The search is case-sensitive.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3083284				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3083452				0	he	FIND(find_text; text; position)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150608	48			0	he	\<emph\>find_text\</emph\> refers to the text to be found.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3152374	49			0	he	\<emph\>text\</emph\> is the text where the search takes place.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3152475	50			0	he	\<emph\>position\</emph\> (optional) is the position in the text from which the search starts.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3154812				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156375	52			0	he	FIND(76;998877665544) returns 6.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149268				0	he	\<bookmark_value\>FIXED function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149268				0	he	FIXED				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155833				0	he	\<ahelp hid=\"HID_FUNC_FEST\"\>Returns a number as text with a specified number of decimal places and optional thousands separators.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152470				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147567				0	he	FIXED(Number; decimals; no thousands separators)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151272	38			0	he	\<emph\>Number\</emph\> refers to the number to be formatted.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156322	39			0	he	\<emph\>Decimals\</emph\> refers to the number of decimal places to be displayed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150877	40			0	he	            \<emph\>NoThousandsSeparators\</emph\> (optional) determines whether the thousands separator is used. If the parameter is a number not equal to 0, the thousands separator is suppressed. If the parameter is equal to 0 or if it is missing altogether, the thousands separators of your \<link href=\"text/shared/optionen/01140000.xhp\" name=\"current locale setting\"\>current locale setting\</link\> are displayed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149040				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145208	42			0	he	FIXED(1234567.89;3) returns 1,234,567.890 as a text string. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id5282143				0	he	FIXED(1234567.89;3;1) returns 1234567.890 as a text string.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id7319864				0	he	\<bookmark_value\>JIS function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3666188				0	he	JIS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id964384				0	he	\<ahelp hid=\".\"\>The JIS function converts half-width to full-width ASCII and katakana characters. Returns a text string.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id1551561				0	he	See \<link href=\"https://wiki.openoffice.org/wiki/Calc/Features/JIS_and_ASC_functions\"\>JIS and ASC Spreadsheet Functions\</link\> for a conversion table.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id2212897				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id2504654				0	he	JIS("Text")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id5292519				0	he	            \<emph\>Text\</emph\> is the text that contains characters to be converted.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3984496				0	he	See also ASC function.				20200411 15:09:53
