helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3166425				0	he	\<variable id=\"kl\"\>\<link href=\"text/scalc/01/04060183.xhp\" name=\"Statistical Functions Part Three\"\>Statistical Functions Part Three\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3149530				0	he	\<bookmark_value\>LARGE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3149530				0	he	LARGE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150518				0	he	\<ahelp hid=\"HID_FUNC_KGROESSTE\"\>Returns the Rank_c-th largest value in a data set.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3152990				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154372				0	he	LARGE(Data; Rank_c)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3152986				0	he	\<emph\>Data\</emph\> is the cell range of data.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3156448				0	he	\<emph\>Rank_c\</emph\> is the ranking of the value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3152889				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3148702				0	he	=LARGE(A1:C50; 2) gives the second largest value in A1:C50.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3154532				0	he	\<bookmark_value\>SMALL function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3154532				0	he	SMALL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3157981				0	he	\<ahelp hid=\"HID_FUNC_KKLEINSTE\"\>Returns the Rank_c-th smallest value in a data set.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3154957				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153974				0	he	SMALL(Data; Rank_c)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154540				0	he	\<emph\>Data\</emph\> is the cell range of data.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155094				0	he	\<emph\>Rank_c\</emph\> is the rank of the value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3153247				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149897				0	he	=SMALL(A1:C50; 2) gives the second smallest value in A1:C50.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3153559				0	he	\<bookmark_value\>CONFIDENCE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3153559				0	he	CONFIDENCE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153814				0	he	\<ahelp hid=\"HID_FUNC_KONFIDENZ\"\>Returns the (1-alpha) confidence interval for a normal distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3149315				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3147501				0	he	CONFIDENCE(Alpha; STDEV; Size)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149872				0	he	\<emph\>Alpha\</emph\> is the level of the confidence interval.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145324				0	he	\<emph\>STDEV\</emph\> is the standard deviation for the total population.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153075				0	he	\<emph\>Size\</emph\> is the size of the total population.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150435				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153335				0	he	=CONFIDENCE(0.05; 1.5; 100) gives 0.29.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3148746				0	he	\<bookmark_value\>CORREL function\</bookmark_value\>\<bookmark_value\>coefficient of correlation\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3148746				0	he	CORREL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3147299				0	he	\<ahelp hid=\"HID_FUNC_KORREL\"\>Returns the correlation coefficient between two data sets.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3156397				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153023				0	he	CORREL(Data_1; Data_2)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150036				0	he	\<emph\>Data_1\</emph\> is the first data set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153021				0	he	\<emph\>Data_2\</emph\> is the second data set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3149720				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149941				0	he	=CORREL(A1:A50; B1:B50) calculates the correlation coefficient as a measure of the linear correlation of the two data sets.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3150652				0	he	\<bookmark_value\>COVAR function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150652				0	he	COVAR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3146875				0	he	\<ahelp hid=\"HID_FUNC_KOVAR\"\>Returns the covariance of the product of paired deviations.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3149013				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150740				0	he	COVAR(Data_1; Data_2)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145827				0	he	\<emph\>Data_1\</emph\> is the first data set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150465				0	he	\<emph\>Data_2\</emph\> is the second data set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3154677				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3144748				0	he	=COVAR(A1:A30; B1:B30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3147472				0	he	\<bookmark_value\>CRITBINOM function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3147472				0	he	CRITBINOM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149254				0	he	\<ahelp hid=\"HID_FUNC_KRITBINOM\"\>Returns the smallest value for which the cumulative binomial distribution is less than or equal to a criterion value.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3153930				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3148586				0	he	CRITBINOM(Trials; SP; Alpha)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145593				0	he	\<emph\>Trials\</emph\> is the total number of trials.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153084				0	he	\<emph\>SP\</emph\> is the probability of success for one trial.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149726				0	he	\<emph\>Alpha\</emph\> is the threshold probability to be reached or exceeded.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3148752				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3148740				0	he	=CRITBINOM(100; 0.5; 0.1) yields 44.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3155956				0	he	\<bookmark_value\>KURT function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3155956				0	he	KURT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153108				0	he	\<ahelp hid=\"HID_FUNC_KURT\"\>Returns the kurtosis of a data set (at least 4 values required).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150334				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154508				0	he	KURT(Number 1; Number 2; ...Number 30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145167				0	he	\<emph\>Number 1,Number 2,...Number 30\</emph\> are numeric arguments or ranges representing a random sample of distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3158000				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150016				0	he	=KURT(A1;A2;A3;A4;A5;A6)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3150928				0	he	\<bookmark_value\>LOGINV function\</bookmark_value\>\<bookmark_value\>inverse of lognormal distribution\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150928				0	he	LOGINV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145297				0	he	\<ahelp hid=\"HID_FUNC_LOGINV\"\>Returns the inverse of the lognormal distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3151016				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153049				0	he	LOGINV(Number; Mean; STDEV)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3148390				0	he	\<emph\>Number\</emph\> is the probability value for which the inverse standard logarithmic distribution is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149538				0	he	\<emph\>Mean\</emph\> is the arithmetic mean of the standard logarithmic distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145355				0	he	\<emph\>STDEV\</emph\> is the standard deviation of the standard logarithmic distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3148768				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155623				0	he	=LOGINV(0.05; 0; 1) returns 0.19.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3158417				0	he	\<bookmark_value\>LOGNORMDIST function\</bookmark_value\>\<bookmark_value\>cumulative lognormal distribution\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3158417				0	he	LOGNORMDIST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154953				0	he	\<ahelp hid=\"HID_FUNC_LOGNORMVERT\"\>Returns the cumulative lognormal distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150474				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150686				0	he	LOGNORMDIST(Number; Mean; STDEV)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154871				0	he	\<emph\>Number\</emph\> is the probability value for which the standard logarithmic distribution is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155820				0	he	\<emph\>Mean\</emph\> is the mean value of the standard logarithmic distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155991				0	he	\<emph\>STDEV\</emph\> is the standard deviation of the standard logarithmic distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155992				0	he	\<emph\>Cumulative\</emph\> (optional) = 0 calculates the density function, Cumulative = 1 calculates the distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3153178				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149778				0	he	=LOGNORMDIST(0.1; 0; 1) returns 0.01.				20200411 15:09:53
