helpcontent2	source\text\sbasic\shared\main0601.xhp	0	help	hd_id3154232				0	he	\<link href=\"text/sbasic/shared/main0601.xhp\" name=\"$[officename] Basic Help\"\>%PRODUCTNAME Basic Help\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\main0601.xhp	0	help	par_id3153894				0	he	%PRODUCTNAME %PRODUCTVERSION provides an Application Programming Interface (API) that allows controlling the $[officename] components with different programming languages by using the $[officename] Software Development Kit (SDK). For more information about the $[officename] API and the Software Development Kit, visit \<link href=\"https://api.openoffice.org/\" name=\"https://api.openoffice.org\"\>https://api.openoffice.org\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\main0601.xhp	0	help	par_id3147226	10			0	he	This help section explains the most common runtime functions of %PRODUCTNAME Basic. For more in-depth information please refer to the \<link href=\"https://wiki.openoffice.org/wiki/Documentation/BASIC_Guide\"\>OpenOffice.org BASIC Programming Guide\</link\> on the OpenOffice.org Wiki.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\main0601.xhp	0	help	hd_id3146957				0	he	Working with %PRODUCTNAME Basic				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\main0601.xhp	0	help	hd_id3148473				0	he	Help about the Help				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	tit				0	he	HasUnoInterfaces Function [Runtime]				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	bm_id3149987				0	he	\<bookmark_value\>HasUnoInterfaces function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	hd_id3149987				0	he	\<link href=\"text/sbasic/shared/03104400.xhp\" name=\"HasUnoInterfaces Function [Runtime]\"\>HasUnoInterfaces Function [Runtime]\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	par_id3151262				0	he	Tests if a Basic Uno object supports certain Uno interfaces.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	par_id3154232				0	he	Returns True, if \<emph\>all\</emph\> stated Uno interfaces are supported, otherwise False is returned.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	hd_id3150040				0	he	Syntax:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	par_id3155555				0	he	HasUnoInterfaces( oTest, Uno-Interface-Name 1 [, Uno-Interface-Name 2, ...])				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	hd_id3153345				0	he	Return value:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	par_id3148538				0	he	Bool				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	hd_id3159157				0	he	Parameters:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	par_id3155419				0	he	\<emph\>oTest:\</emph\> the Basic Uno object that you want to test.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	par_id3149236				0	he	\<emph\>Uno-Interface-Name:\</emph\> list of Uno interface names.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	hd_id3147574				0	he	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03104400.xhp	0	help	par_id3149580				0	he	bHas = HasUnoInterfaces( oTest, "com.sun.star.beans.XIntrospection" )				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	tit				0	he	FileCopy Statement [Runtime]				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	bm_id3154840				0	he	\<bookmark_value\>FileCopy statement\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	hd_id3154840				0	he	\<link href=\"text/sbasic/shared/03020406.xhp\" name=\"FileCopy Statement [Runtime]\"\>FileCopy Statement [Runtime]\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	par_id3149497				0	he	Copies a file.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	hd_id3147443				0	he	תחביר:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	par_id3146957				0	he	FileCopy TextFrom As String, TextTo As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	hd_id3153825				0	he	Parameters:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	par_id3155390				0	he	\<emph\>TextFrom:\</emph\> Any string expression that specifies the name of the file that you want to copy. The expression can contain optional path and drive information. If you want, you can enter a path in \<link href=\"text/sbasic/shared/00000002.xhp\" name=\"URL notation\"\>URL notation\</link\>.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	par_id3150669				0	he	\<emph\>TextTo:\</emph\> Any string expression that specifies where you want to copy the source file to. The expression can contain the destination drive, the path, and file name, or the path in URL notation.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	par_id3150791				0	he	You can only use the FileCopy statement to copy files that are not opened.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	hd_id3125863				0	he	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	par_id3150869				0	he	Sub ExampleFilecopy				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	par_id3154685				0	he	Filecopy "c:\\autoexec.bat", "c:\\Temp\\Autoexec.sav"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	par_id3154123				0	he	end sub				20200411 15:09:53
