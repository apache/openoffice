helpcontent2	source\text\swriter\01\04090003.xhp	0	help	par_id3149837				0	he	\<ahelp hid=\"SW_LISTBOX_DLG_FLD_DROPDOWN_LB_LISTITEMS\"\>Choose the item that you want to display in the document, then click \<emph\>OK\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090003.xhp	0	help	hd_id3147602				0	he	Edit				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090003.xhp	0	help	par_id3148855				0	he	\<ahelp hid=\"SW_PUSHBUTTON_DLG_FLD_DROPDOWN_PB_EDIT\"\>Displays the \<emph\>Edit Fields: Functions\</emph\> dialog, where you can edit the \<emph\>Input list\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\04090003.xhp	0	help	hd_id3155558				0	he	Next				20200411 15:09:53
