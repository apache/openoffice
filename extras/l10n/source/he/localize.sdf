helpcontent2	source\text\shared\01\03010000.xhp	0	help	hd_id3154682				0	he	\<link href=\"text/shared/01/03010000.xhp\"\>Zoom & View Layout\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id3149578	2			0	he	\<variable id=\"massstabtext\"\>\<ahelp hid=\".uno:Zoom\"\>Reduces or enlarges the screen display of %PRODUCTNAME.\</ahelp\>\</variable\> The current zoom factor is displayed as a percentage value on the \<emph\>Status\</emph\> bar.				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id3149655				0	he	Zooming is handled differently on Unix, Linux, and Windows platforms. A document saved with a 100% zoom factor in Windows is displayed at a larger zoom factor on Unix/Linux platforms. To change the zoom factor, double-click or right-click the percentage value on the \<emph\>Status\</emph\> bar, and select the zoom factor that you want.				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	hd_id3149669				0	he	Zoom factor				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id3154389				0	he	Set the zoom factor at which to display the current document and all documents of the same type that you open thereafter.				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	hd_id3153351				0	he	Optimal				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id3144760				0	he	\<ahelp hid=\"HID_MNU_ZOOM_OPTIMAL\"\>\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>Resizes the display to fit the width of the selected cell area at the moment the command is started.\</caseinline\>\<defaultinline\>Resizes the display to fit the width of the text in the document at .\</defaultinline\>\</switchinline\>\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	hd_id3151210				0	he	Page Width				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id3150543				0	he	\<ahelp hid=\"HID_MNU_ZOOM_WHOLE_PAGE\"\>\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>Resizes the display to fit the width and height of the selected cell area at the moment the command is started.\</caseinline\>\<defaultinline\>Displays the entire page on your screen.\</defaultinline\>\</switchinline\>\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	hd_id3152771				0	he	Fit width				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id3143231				0	he	\<ahelp hid=\"HID_MNU_ZOOM_PAGE_WIDTH\"\>Displays the complete width of the document page. The top and bottom edges of the page may not be visible.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id3159151				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Displays the document at two times its actual size.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id3145173				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Displays the document at one and a half times its actual size.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	hd_id3153106	9			0	he	100 %				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id3147353				0	he	\<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXDLG_ZOOM:BTN_100\"\>Displays the document at its actual size.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id3152791				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Displays the document at 75% of its actual size.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id3156005				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Displays the document at half of its actual size.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	hd_id3153191				0	he	Variable				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id3159125				0	he	\<ahelp hid=\"SVX:METRICFIELD:RID_SVXDLG_ZOOM:ED_USER\"\>Enter the zoom factor at which you want to display the document. Enter a percentage in the box.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	hd_id7319864				0	he	View layout				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id3423871				0	he	For text documents, you can set the view layout. Reduce the zoom factor to see the effects of different view layout settings.				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	hd_id3818475				0	he	Automatic				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id3187353				0	he	\<ahelp hid=\".\"\>The automatic view layout displays pages side by side, as many as the zoom factor allows.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	hd_id8455153				0	he	Single page				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id9912411				0	he	\<ahelp hid=\".\"\>The single page view layout displays pages beneath each other, but never side by side.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	hd_id9204992				0	he	Columns				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id1993774				0	he	\<ahelp hid=\".\"\>In columns view layout you see pages in a given number of columns side by side. Enter the number of columns.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	hd_id2949919				0	he	Book mode				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id2355113				0	he	\<ahelp hid=\".\"\>In book mode view layout you see two pages side by side as in an open book. The first page is a right page with an odd page number.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update.xhp	0	help	tit				0	he	Check for Updates 				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update.xhp	0	help	bm_id7647328				0	he	\<bookmark_value\>updates;checking manually\</bookmark_value\>      \<bookmark_value\>online updates;checking manually\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update.xhp	0	help	hd_id315256				0	he	\<variable id=\"online_update\"\>\<link href=\"text/shared/01/online_update.xhp\"\>Check for Updates\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id3174230				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Mark to enable the automatic check for updates. Choose %PRODUCTNAME - Online Update in the Options dialog box to disable or enable this feature.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id0116200901063996				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Click to select a folder to download the files.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id6797082				0	he	\<ahelp hid=\".\"\>You can check for updates manually or automatically.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id4218878				0	he	Checking for updates will also look for updates of all installed extensions.				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id8132267				0	he	Choose \<item type=\"menuitem\"\>Help - Check for Updates\</item\> to check manually.				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id702230				0	he	You can disable or enable the automatic check in \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - %PRODUCTNAME - \<link href=\"text/shared/optionen/online_update.xhp\"\>Online Update\</link\>.				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id3422345				0	he	If an update is available, an icon\<image id=\"img_id3155415\" src=\"extensions/source/update/ui/onlineupdate_16.png\" width=\"0.4583in\" height=\"0.1354in\"\>\<alt id=\"alt_id3155415\"\>Icon\</alt\>\</image\> on the menu bar will notify you of the update. Click the icon to open a dialog with more information.				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id9313638				0	he	You will see the \<link href=\"text/shared/01/online_update_dialog.xhp\"\>Check for Updates\</link\> dialog with some information about the online update of %PRODUCTNAME.				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id9951780				0	he	Enable an Internet connection for %PRODUCTNAME.				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id6479384				0	he	If you need a proxy server, enter the proxy settings in \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - Internet - Proxy.				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id3639027				0	he	Choose \<item type=\"menuitem\"\>Check for Updates\</item\> to check for the availability of a newer version of your office suite.				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id3722342				0	he	If a newer version is available and %PRODUCTNAME is not set up for automatic downloading, then you can select any of the following actions:				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id5106662				0	he	Download the new version.				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id4931485				0	he	Install the downloaded files.				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id9168980				0	he	Abort this check for updates for now.				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id9766533				0	he	If %PRODUCTNAME is configured to download the files automatically, the download starts immediately. A download continues even when you minimize the dialog.				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id927152				0	he	If automatic downloads are disabled, start the download manually.				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id6081728				0	he	If no update was found, you can close the dialog.				20200411 15:09:53
helpcontent2	source\text\shared\01\online_update.xhp	0	help	par_id9219641				0	he	You need Administrator rights to update %PRODUCTNAME.				20200411 15:09:53
