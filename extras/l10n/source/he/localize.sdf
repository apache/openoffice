helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id0907200904123846				0	he	UNICODE("Text")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id0907200904123899				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id0907200904123919				0	he	=UNICODE("©") returns the Unicode number 169 for the Copyright character.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3145178				0	he	\<bookmark_value\>UPPER function\</bookmark_value\>				20200411 15:09:53
