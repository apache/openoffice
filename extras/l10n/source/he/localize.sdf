helpcontent2	source\text\scalc\01\05030300.xhp	0	help	par_id3156281				0	he	\<ahelp hid=\".uno:Hide\"\>Hides selected rows, columns or individual sheets.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05030300.xhp	0	help	par_id3148645	3			0	he	Select the rows or columns that you want to hide, and then choose \<emph\>Format - Row - Hide \</emph\>or\<emph\> Format - Column - Hide\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05030300.xhp	0	help	par_id3147427				0	he	You can hide a sheet by selecting the sheet tab and then choosing \<emph\>Format - Sheet - Hide\</emph\>. Hidden sheets are not printed unless they occur within a \<link href=\"text/scalc/01/05080000.xhp\" name=\"print range\"\>print range\</link\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05030300.xhp	0	help	par_id3153157				0	he	A break in the row or column header indicates whether the row or column is hidden.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05030300.xhp	0	help	par_id3145251				0	he	To display hidden rows, columns or sheets				20200411 15:09:53
helpcontent2	source\text\scalc\01\05030300.xhp	0	help	par_id8337046				0	he	Select the range that includes the hidden objects. You can also use the box in the corner above row 1 and beside column A. For sheets, this step is not necessary.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05030300.xhp	0	help	par_id5532090				0	he	Choose \<link href=\"text/scalc/01/05030400.xhp\" name=\"Format - Row/Column - Show\"\>Format - Row/Column - Show\</link\> or \<link href=\"text/scalc/01/05050300.xhp\" name=\"Format - Sheet - Show\"\>Format - Sheet - Show\</link\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140300.xhp	0	help	tit				0	he	Up				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140300.xhp	0	help	hd_id3147264				0	he	\<link href=\"text/scalc/01/02140300.xhp\" name=\"Up\"\>Up\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140300.xhp	0	help	par_id3150793				0	he	\<ahelp hid=\".uno:FillUp\" visibility=\"visible\"\>Fills a selected range of at least two rows with the contents of the bottom most cell.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140300.xhp	0	help	par_id3150447				0	he	If a selected range has only one column, the content of the bottom most cell is copied into the selected cells. If several columns are selected, the contents of the bottom most cells are copied into those selected above.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06030400.xhp	0	help	tit				0	he	Remove Dependents				20200411 15:09:53
helpcontent2	source\text\scalc\01\06030400.xhp	0	help	bm_id3147335				0	he	\<bookmark_value\>cells; removing dependents\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06030400.xhp	0	help	hd_id3147335				0	he	\<link href=\"text/scalc/01/06030400.xhp\" name=\"Remove Dependents\"\>Remove Dependents\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06030400.xhp	0	help	par_id3148663				0	he	\<ahelp visibility=\"visible\" hid=\".uno:ClearArrowDependents\"\>Deletes one level of tracer arrows created with \<emph\>Trace Dependents\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	tit				0	he	WEEKNUM				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	bm_id3159161				0	he	\<bookmark_value\>WEEKNUM function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	hd_id3159161				0	he	\<variable id=\"weeknum\"\>\<link href=\"text/scalc/01/func_weeknum.xhp\"\>WEEKNUM\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3149770				0	he	\<ahelp hid=\"HID_FUNC_KALENDERWOCHE\"\>WEEKNUM calculates the week number of the year for the internal date value.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_idN105E4				0	he	The International Standard ISO 8601 has decreed that Monday shall be the first day of the week. A week that lies partly in one year and partly in another is assigned a number in the year in which most of its days lie. That means that week number 1 of any year is the week that contains the January 4\<emph\>th\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	hd_id3153055				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3147236				0	he	WEEKNUM(number; mode)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3147511				0	he	\<emph\>Number\</emph\> is the internal date number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3154269				0	he	\<emph\>Mode\</emph\> sets the start of the week and the calculation type.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3148930				0	he	1 = Sunday				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3154280				0	he	2 = Monday				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	hd_id3146948				0	he	Examples				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3150704				0	he	WEEKNUM("1/1/95";1) returns 1 (1/1/95 was a Sunday)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3149792				0	he	WEEKNUM("1/1/95";2) returns 52. If the week starts on Monday, Sunday belongs to the last week of the previous year.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04050100.xhp	0	help	tit				0	he	Sheet from file				20200411 15:09:53
helpcontent2	source\text\scalc\01\04050100.xhp	0	help	par_idN105C1				0	he	\<link href=\"text/scalc/01/04050100.xhp\"\>Sheet from file\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04050100.xhp	0	help	par_idN105D1				0	he	\<ahelp hid=\"26275\"\>Inserts a sheet from a different spreadsheet file.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04050100.xhp	0	help	par_idN105F7				0	he	Use the \<link href=\"text/shared/01/01020000.xhp\"\>File - Open\</link\> dialog to locate the spreadsheet.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04050100.xhp	0	help	par_idN10609				0	he	In the \<link href=\"text/scalc/01/04050000.xhp\"\>Insert Sheet\</link\> dialog, select the sheet that you want to insert.				20200411 15:09:53
