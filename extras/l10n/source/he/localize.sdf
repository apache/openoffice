helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id0818200912531449				0	he	\<emph\>General printing:\</emph\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id0818200912284952				0	he	The settings that you define in the Print dialog are valid only for the current print job that you start by clicking the Print button. If you want to change some options permanently, open Tools - Options - %PRODUCTNAME (application name) - Print.				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3156080				0	he	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>To set the default \<item type=\"productname\"\>%PRODUCTNAME\</item\> printer options for text documents, choose \<link href=\"text/shared/optionen/01040400.xhp\" name=\"Tools - Options - Writer - Print\"\>\<emph\>Tools - Options - %PRODUCTNAME Writer - Print\</emph\>\</link\>.\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_idN1099E				0	he	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>To set the default \<item type=\"productname\"\>%PRODUCTNAME\</item\> printer options for spreadsheet documents, choose \<link href=\"text/shared/optionen/01060700.xhp\" name=\"Tools - Options - Calc - Print\"\>\<emph\>Tools - Options - %PRODUCTNAME Calc - Print\</emph\>\</link\>.\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_idN109CD				0	he	\<switchinline select=\"appl\"\>\<caseinline select=\"IMPRESS\"\>To set the default \<item type=\"productname\"\>%PRODUCTNAME\</item\>printer options for presentation documents, choose \<link href=\"text/shared/optionen/01070400.xhp\" name=\"Tools - Options - Impress - Print\"\>\<emph\>Tools - Options - %PRODUCTNAME Impress - Print\</emph\>\</link\>.\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id0818200901194137				0	he	Press Shift+F1 or choose \<item type=\"menuitem\"\>Help - What's This?\</item\> and point to any control element in the Print dialog to see an extended help text.				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	hd_id0818200912284914				0	he	Preview				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id081820091228505				0	he	The preview shows how each sheet of paper will look. You can browse through all sheets of paper with the buttons below the preview.				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	hd_id0818200912285056				0	he	General				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id0818200912285064				0	he	On the General tab page, you find the most important control elements for printing. You can define which contents of your document are to be printed. You can select the printer and open the printer settings dialog.				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id2				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Specifies whether to print colors and objects that are inserted to the background of the page (Format - Page - Background).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id4				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Specifies whether the graphics and drawings or OLE objects of your text document are printed.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id6				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Enable this option to print text that is marked as hidden.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id8				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Enable this option to print text placeholders. Disable this option to leave the text placeholders blank in the printout.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id10				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Specifies whether the form control fields of the text document are printed.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id12				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Specifies whether to always print text in black.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id14				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>If this option is enabled automatically inserted blank pages are printed. This is best if you are printing double-sided. For example, in a book, a "chapter" paragraph style has been set to always start with an odd numbered page. If the previous chapter ends on an odd page, %PRODUCTNAME inserts an even numbered blank page. This option controls whether to print that even numbered page.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id16				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Specify where to print comments (if any).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id18				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>"Specify where to print comments (if any)."\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id20				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Specifies whether you want the name of the document to be included in the printout.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id22				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Specifies whether to include the contents of the Commands window at the bottom of the printout.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id24				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Applies a thin border to the formula area in the printout.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id26				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Prints the formula without adjusting the current font size.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id28				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Adjusts the formula to the page format used in the printout.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id30				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Reduces or enlarges the size of the printed formula by a specified factor.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id32				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Reduces or enlarges the size of the printed formula by a specified factor.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id34				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>If checked empty pages that have no cell contents or draw objects are printed.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id36				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>For printers with multiple trays this option specifies whether the paper tray used is specified by the system settings of the printer.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3149164				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Prints the entire document.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3152944				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Prints only the pages or slides that you specify in the \<emph\>Pages\</emph\> box.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3150244				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Prints only the selected area(s) or object(s) in the current document.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3146848				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>To print a range of pages, use a format like 3-6. To print single pages, use a format like 7;9;11. You can print a combination of page ranges and single pages, by using a format like 3-6;8;10;12.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3150772				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Prints to a file instead of to a printer.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id38				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Check to not rely on the printer to create collated copies but create a print job for each copy instead.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id40				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Check to print pages in reverse order.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3145069				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Enter the number of copies that you want to print.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3150865				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Preserves the page order of the original document.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3156113				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Opens the printer properties dialog. The printer properties vary according to the printer that you select.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id42				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Show/Hide detailed information of the selected printer.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3149511				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>The list box shows the installed printers. Click the printer to use for the current print job. Click the Printer details button to see some information about the selected printer. Click the Properties button to change some of the printer properties.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id44				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Specify which pages to include in the output.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id46				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Select the Brochure option to print the document in brochure format.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id48				0	he	\<ahelp hid=\".\" visibility=\"hidden\"\>Select which pages of a brochure to print.\</ahelp\>				20200411 15:09:53
