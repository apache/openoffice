helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3151377				0	he	\<ahelp hid=\"SW_RADIOBUTTON_TP_FRM_STD_RB_ANCHOR_AT_CHAR\"\>Anchors the selection to a character.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3150115				0	he	As character				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3155863				0	he	\<ahelp hid=\"SW_RADIOBUTTON_TP_FRM_STD_RB_ANCHOR_AS_CHAR\"\>Anchors the selection as character. The height of the current line is resized to match the height of the selection.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	hd_id3150693				0	he	Position				20200411 15:09:53
helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3147413				0	he	Specify the location of the selected object on the current page.				20200411 15:09:53
