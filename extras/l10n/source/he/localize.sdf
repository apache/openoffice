helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3157888				0	he	\<ahelp hid=\"HID_FUNC_GLAETTEN\"\>Removes spaces from a string, leaving only a single space character between words.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152913				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151349				0	he	TRIM(Text)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151362	58			0	he	\<emph\>Text\</emph\> refers to text in which spaces are removed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146838				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156074	60			0	he	TRIM(" hello") returns "hello".				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id0907200904030935				0	he	\<bookmark_value\>UNICHAR function\</bookmark_value\>				20200411 15:09:53
