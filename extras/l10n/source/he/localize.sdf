helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105A5				0	he	Use Outer Join syntax '{OJ }'				20200411 15:09:53
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105A9				0	he	\<ahelp hid=\".\"\>Use escape sequences for outer joins. The syntax for this escape sequence is {oj outer-join}\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105BE				0	he	Example:				20200411 15:09:53
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105C1				0	he	select Article.* from {oj item LEFT OUTER JOIN orders ON item.no=orders.ANR}				20200411 15:09:53
