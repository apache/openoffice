helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148742				0	he	\<link href=\"text/scalc/01/04060103.xhp\" name=\"Back to Financial Functions Part One\"\>Back to Financial Functions Part One\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151341				0	he	\<link href=\"text/scalc/01/04060118.xhp\" name=\"Forward to Financial Functions Part Three\"\>Forward to Financial Functions Part Three\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3150026				0	he	\<bookmark_value\>PPMT function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150026				0	he	PPMT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146942				0	he	\<ahelp hid=\"HID_FUNC_KAPZ\"\>Returns for a given period the payment on the principal for an investment that is based on periodic and constant payments and a constant interest rate.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150459				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146878				0	he	PPMT(Rate;Period;NPER;PV;FV;Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151228				0	he	\<emph\>Rate\</emph\> is the periodic interest rate.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148887				0	he	Period: the amortizement period. P=1 for the first and P=NPER for the last period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148436				0	he	NPER: the total number of periods during which annuity is paid.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153035				0	he	PV. the present value in the sequence of payments.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147474				0	he	FV (optional): the desired (future) value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3144744				0	he	Type (optional): defines the due date. F=1 for payment at the beginning of a period and F=0 for payment at the end of a period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_idN1067C				0	he	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3148582				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154811				0	he	How high is the periodic monthly payment at an annual interest rate of 8.75% over a period of 3 years? The cash value is 5,000 currency units and is always paid at the beginning of a period. The future value is 8,000 currency units.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149246				0	he	PPMT(8.75%/12;1;36;5000;8000;1) = -350.99 currency units.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3146139				0	he	\<bookmark_value\>calculating; total amortizement rates\</bookmark_value\>\<bookmark_value\>total amortizement rates\</bookmark_value\>\<bookmark_value\>amortization installment\</bookmark_value\>\<bookmark_value\>repayment installment\</bookmark_value\>\<bookmark_value\>CUMPRINC function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3146139				0	he	CUMPRINC				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150140				0	he	\<ahelp hid=\"HID_FUNC_KUMKAPITAL\"\>Returns the cumulative interest paid for an investment period with a constant interest rate.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149188				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148733				0	he	CUMPRINC(Rate;NPER;PV;S;E;Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150864				0	he	\<emph\>Rate\</emph\> is the periodic interest rate.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3166052				0	he	NPER: the payment period with the total number of periods. NPER can also be a non-integer value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150007				0	he	\<emph\>PV\</emph\> is the current value in the sequence of payments.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153112				0	he	S: the first period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146847				0	he	E: the last period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145167				0	he	Type: the due date of the payment at the beginning or end of each period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154502				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153570				0	he	What are the payoff amounts if the yearly interest rate is 5.5% for 36 months? The cash value is 15,000 currency units. The payoff amount is calculated between the 10th and 18th period. The due date is at the end of the period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149884				0	he	CUMPRINC(5.5%/12;36;15000;10;18;0) = -3669.74 currency units. The payoff amount between the 10th and 18th period is 3669.74 currency units.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3150019				0	he	\<bookmark_value\>CUMPRINC_ADD function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150019				0	he	CUMPRINC_ADD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145246				0	he	\<ahelp hid=\"HID_AAI_FUNC_CUMPRINC\"\> Calculates the cumulative redemption of a loan in a period.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153047				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3157970				0	he	CUMPRINC_ADD(Rate;NPER;PV;Start period;End period;Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145302				0	he	Rate: the interest rate for each period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151017				0	he	NPER: the total number of payment periods. The rate and NPER must refer to the same unit, and thus both be calculated annually or monthly.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155620				0	he	\<emph\>PV\</emph\> is the current value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145352				0	he	Start period: the first payment period for the calculation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3157986				0	he	End period: the last payment period for the calculation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150570				0	he	Type: the maturity of a payment at the end of each period (Type = 0) or at the start of the period (Type = 1).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150269				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148774				0	he	The following mortgage loan is taken out on a house:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150661				0	he	Rate: 9.00 per cent per annum (9% / 12 = 0.0075), Duration: 30 years (payment periods = 30 * 12 = 360), NPV: 125000 currency units.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155512				0	he	How much will you repay in the second year of the mortgage (thus from periods 13 to 24)?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149394				0	he	CUMPRINC_ADD(0.0075;360;125000;13;24;0) returns -934.1071				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149026				0	he	In the first month you will be repaying the following amount:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154636				0	he	CUMPRINC_ADD(0.0075;360;125000;1;1;0) returns -68.27827				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3155370				0	he	\<bookmark_value\>calculating; accumulated interests\</bookmark_value\>\<bookmark_value\>accumulated interests\</bookmark_value\>\<bookmark_value\>CUMIPMT function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155370				0	he	CUMIPMT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3158411				0	he	\<ahelp hid=\"HID_FUNC_KUMZINSZ\"\>Calculates the cumulative interest payments, that is, the total interest, for an investment based on a constant interest rate.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155814				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147536				0	he	CUMIPMT(Rate;NPER;pv;S;E;Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150475				0	he	\<emph\>Rate\</emph\> is the periodic interest rate.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153921				0	he	NPER: the payment period with the total number of periods. NPER can also be a non-integer value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153186				0	he	\<emph\>PV\</emph\> is the current value in the sequence of payments.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156259				0	he	S: the first period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155990				0	he	E: the last period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149777				0	he	Type: the due date of the payment at the beginning or end of each period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153723				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147478	277			0	he	What are the interest payments at a yearly interest rate of 5.5 %, a payment period of monthly payments for 2 years and a current cash value of 5,000 currency units? The start period is the 4th and the end period is the 6th period. The payment is due at the beginning of each period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149819				0	he	CUMIPMT(5.5%/12;24;5000;4;6;1) = -57.54 currency units. The interest payments for between the 4th and 6th period are 57.54 currency units.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3083280				0	he	\<bookmark_value\>CUMIPMT_ADD function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3083280				0	he	CUMIPMT_ADD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3152482				0	he	\<ahelp hid=\"HID_AAI_FUNC_CUMIPMT\"\>Calculates the accumulated interest for a period.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149713				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145087				0	he	CUMIPMT_ADD(Rate;NPER;Pv;Start period;End period;Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149277				0	he	Rate: the interest rate for each period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149270				0	he	NPER: the total number of payment periods. The rate and NPER must refer to the same unit, and thus both be calculated annually or monthly.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3152967				0	he	\<emph\>PV\</emph\> is the current value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156308				0	he	Start period: the first payment period for the calculation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149453				0	he	End period: the last payment period for the calculation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150962				0	he	Type: the maturity of a payment at the end of each period (Type = 0) or at the start of the period (Type = 1).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3152933				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156324				0	he	The following mortgage loan is taken out on a house:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147566				0	he	Rate: 9.00 per cent per annum (9% / 12 = 0.0075), Duration: 30 years (NPER = 30 * 12 = 360), Pv: 125000 currency units.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151272				0	he	How much interest must you pay in the second year of the mortgage (thus from periods 13 to 24)?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156130				0	he	=CUMIPMT_ADD(0.0075;360;125000;13;24;0) returns -11135.23.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150764				0	he	How much interest must you pay in the first month?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146857				0	he	=CUMIPMT_ADD(0.0075;360;125000;1;1;0) returns -937.50.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3150878				0	he	\<bookmark_value\>PRICE function\</bookmark_value\>\<bookmark_value\>prices; fixed interest securities\</bookmark_value\>\<bookmark_value\>sales values;fixed interest securities\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150878				0	he	PRICE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153210				0	he	\<ahelp hid=\"HID_AAI_FUNC_PRICE\"\>Calculates the market value of a fixed interest security with a par value of 100 currency units as a function of the forecast yield.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154646				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3152804				0	he	PRICE(Settlement;Maturity;Rate;Yield;Redemption;Frequency;Basis)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156121				0	he	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149983				0	he	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153755				0	he	\<emph\>Rate\</emph\> is the annual nominal rate of interest (coupon interest rate)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155999				0	he	\<emph\>Yield\</emph\> is the annual yield of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156114				0	he	Redemption: the redemption value per 100 currency units of par value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155846				0	he	\<emph\>Frequency\</emph\> is the number of interest payments per year (1, 2 or 4).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153148				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150260				0	he	A security is purchased on 2/15/1999; the maturity date is 11/15/2007. The nominal rate of interest is 5.75%. The yield is 6.5%. The redemption value is 100 currency units. Interest is paid half-yearly (frequency is 2). With calculation on basis 0 the price is as follows:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147273				0	he	=PRICE("2/15/1999"; "11/15/2007"; 0.0575; 0.065; 100; 2; 0) returns 95.04287.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3151297				0	he	\<bookmark_value\>PRICEDISC function\</bookmark_value\>\<bookmark_value\>prices;non-interest-bearing securities\</bookmark_value\>\<bookmark_value\>sales values;non-interest-bearing securities\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3151297				0	he	PRICEDISC				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155100				0	he	\<ahelp hid=\"HID_AAI_FUNC_PRICEDISC\"\>Calculates the price per 100 currency units of par value of a non-interest- bearing security.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149294				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146084				0	he	PRICEDISC(Settlement;Maturity;Discount;Redemption;Basis)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3159179				0	he	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154304				0	he	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156014				0	he	Discount: the discount of a security as a percentage.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147489				0	he	Redemption: the redemption value per 100 currency units of par value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3152794				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149198				0	he	A security is purchased on 2/15/1999; the maturity date is 3/1/1999. Discount in per cent is 5.25%. The redemption value is 100. When calculating on basis 2 the price discount is as follows:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151178				0	he	=PRICEDISC("2/15/1999"; "3/1/1999"; 0.0525; 100; 2) returns 99.79583.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3154693				0	he	\<bookmark_value\>PRICEMAT function\</bookmark_value\>\<bookmark_value\>prices;interest-bearing securities\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154693				0	he	PRICEMAT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153906				0	he	\<ahelp hid=\"HID_AAI_FUNC_PRICEMAT\"\>Calculates the price per 100 currency units of par value of a security, that pays interest on the maturity date.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154933				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155393				0	he	PRICEMAT(Settlement;Maturity;Issue;Rate;Yield;Basis)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153102				0	he	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150530				0	he	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149903				0	he	Issue: the date of issue of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148828				0	he	Rate: the interest rate of the security on the issue date.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146993				0	he	\<emph\>Yield\</emph\> is the annual yield of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150507				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154289				0	he	Settlement date: February 15 1999, maturity date: April 13 1999, issue date: November 11 1998. Interest rate: 6.1 per cent, yield: 6.1 per cent, basis: 30/360 = 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154905				0	he	The price is calculated as follows:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3158409				0	he	=PRICEMAT("2/15/1999";"4/13/1999";"11/11/1998"; 0.061; 0.061;0) returns 99.98449888.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3148448				0	he	\<bookmark_value\>חישוב; משך\</bookmark_value\>\<bookmark_value\>משך;חישוב\</bookmark_value\>\<bookmark_value\>פונקציית DURATION\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3148448				0	he	DURATION				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153056				0	he	\<ahelp hid=\"HID_FUNC_LAUFZEIT\"\>Calculates the number of periods required by an investment to attain the desired value.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3145421				0	he	תחביר				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148933				0	he	‎DURATION(Rate; PV; FV)‎				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148801				0	he	\<emph\>Rate\</emph\> is a constant. The interest rate is to be calculated for the entire duration (duration period). The interest rate per period is calculated by dividing the interest rate by the calculated duration. The internal rate for an annuity is to be entered as Rate/12.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147239				0	he	\<emph\>PV\</emph\> is the present (current) value. The cash value is the deposit of cash or the current cash value of an allowance in kind. As a deposit value a positive value must be entered; the deposit must not be 0 or <0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147515				0	he	\<emph\>FV\</emph\> is the expected value. The future value determines the desired (future) value of the deposit.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153579				0	he	דוגמא				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148480				0	he	At an interest rate of 4.75%, a cash value of 25,000 currency units and a future value of 1,000,000 currency units, a duration of 79.49 payment periods is returned. The periodic payment is the resulting quotient from the future value and the duration, in this case 1,000,000/79.49=12,850.20.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3148912				0	he	\<bookmark_value\>calculating;linear depreciations\</bookmark_value\>\<bookmark_value\>depreciations;linear\</bookmark_value\>\<bookmark_value\>linear depreciations\</bookmark_value\>\<bookmark_value\>straight-line depreciations\</bookmark_value\>\<bookmark_value\>SLN function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3148912				0	he	SLN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149154	291			0	he	\<ahelp hid=\"HID_FUNC_LIA\"\>Returns the straight-line depreciation of an asset for one period.\</ahelp\>The amount of the depreciation is constant during the depreciation period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153240				0	he	תחביר				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3166456				0	he	SLN(COST; SALVAGE; LIFE)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146955				0	he	\<emph\>Cost\</emph\> is the initial cost of an asset.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149796				0	he	\<emph\>Salvage\</emph\> is the value of an asset at the end of the depreciation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3166444				0	he	LIFE: the depreciation period determining the number of periods in the depreciation of the asset.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155579				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154098				0	he	Office equipment with an initial cost of 50,000 currency units is to be depreciated over 7 years. The value at the end of the depreciation is to be 3,500 currency units.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153390				0	he	SLN(50000;3,500;84) = 553.57 currency units. The periodic monthly depreciation of the office equipment is 553.57 currency units.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3153739				0	he	\<bookmark_value\>MDURATION function\</bookmark_value\>\<bookmark_value\>Macauley duration\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153739				0	he	MDURATION				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149923				0	he	\<ahelp hid=\"HID_AAI_FUNC_MDURATION\"\>Calculates the modified Macauley duration of a fixed interest security in years.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149964				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148987				0	he	MDURATION(Settlement;Maturity;Coupon;Yield;Frequency;Basis)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148619				0	he	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149805				0	he	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154338				0	he	Coupon: the annual nominal rate of interest (coupon interest rate)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148466				0	he	\<emph\>Yield\</emph\> is the annual yield of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149423				0	he	\<emph\>Frequency\</emph\> is the number of interest payments per year (1, 2 or 4).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154602				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148652				0	he	A security is purchased on 1/1/2001; the maturity date is 1/1/2006. The nominal rate of interest is 8%. The yield is 9.0%. Interest is paid half-yearly (frequency is 2). Using daily balance interest calculation (basis 3) how long is the modified duration?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145378				0	he	=MDURATION("1/1/2001"; "1/1/2006"; 0.08; 0.09; 2; 3)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3149242				0	he	\<bookmark_value\>calculating;net present values\</bookmark_value\>\<bookmark_value\>net present values\</bookmark_value\>\<bookmark_value\>NPV function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149242				0	he	NPV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145308				0	he	\<ahelp hid=\"HID_FUNC_NBW\"\>Returns the present value of an investment based on a series of periodic cash flows and a discount rate. To get the net present value, subtract the cost of the project (the initial cash flow at time zero) from the returned value.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149937				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153321				0	he	NPV(RATE;Value 1;Value 2;...)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150630				0	he	RATE: the discount rate for a period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150427				0	he	Value1;... are up to 30 values, which represent deposits or withdrawals.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153538				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154800				0	he	What is the net present value of periodic payments of 10, 20 and 30 currency units with a discount rate of 8.75%. At time zero the costs were paid as -40 currency units.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3143270				0	he	NPV(8.75%;10;20;30) = 49.43 currency units. The net present value is the returned value minus the initial costs of 40 currency units, therefore 9.43 currency units.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3149484				0	he	\<bookmark_value\>calculating;nominal interest rates\</bookmark_value\>\<bookmark_value\>nominal interest rates\</bookmark_value\>\<bookmark_value\>NOMINAL function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149484				0	he	NOMINAL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149596				0	he	\<ahelp hid=\"HID_FUNC_NOMINAL\"\>Calculates the yearly nominal interest rate, given the effective rate and the number of compounding periods per year.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3151252				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3152769				0	he	NOMINAL(EFFECT_RATE;NPERY)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147521				0	he	EFFECT_RATE: the effective interest rate				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156334				0	he	NPERY: the number of periodic interest payments per year.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154473				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147091				0	he	What is the nominal interest per year for an effective interest rate of 13.5% if twelve payments are made per year.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154831				0	he	NOMINAL(13.5%;12) = 12.73%. The nominal interest rate per year is 12.73%.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3155123				0	he	\<bookmark_value\>NOMINAL_ADD function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155123				0	he	NOMINAL_ADD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148671				0	he	\<ahelp hid=\"HID_AAI_FUNC_NOMINAL\"\>Calculates the annual nominal rate of interest on the basis of the effective rate and the number of interest payments per annum.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155611				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156157				0	he	NOMINAL_ADD(Effective rate;Npery)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153777				0	he	Effective rate: the effective annual rate of interest.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150409				0	he	Npery: the number of interest payments per year.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3146789				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145777				0	he	What is the nominal rate of interest for a 5.3543% effective rate of interest and quarterly payment.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156146				0	he	=NOMINAL_ADD(5.3543%; 4) returns 0.0525 or 5.25%.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3159087				0	he	\<bookmark_value\>DOLLARFR function\</bookmark_value\>\<bookmark_value\>converting;decimal fractions, into mixed decimal fractions\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3159087				0	he	DOLLARFR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150593				0	he	\<ahelp hid=\"HID_AAI_FUNC_DOLLARFR\"\>Converts a quotation that has been given as a decimal number into a mixed decimal fraction.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3151106				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3152959				0	he	DOLLARFR (Decimal dollar;Fraction)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149558				0	he	Decimal dollar: a decimal number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153672				0	he	Fraction: a whole number that is used as the denominator of the decimal fraction.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3156274				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153795				0	he	=DOLLARFR(1.125;16) converts into sixteenths. The result is 1.02 for 1 plus 2/16.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150995				0	he	=DOLLARFR(1.125;8) converts into eighths. The result is 1.1 for 1 plus 1/8.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3154671				0	he	\<bookmark_value\>fractions; converting\</bookmark_value\>\<bookmark_value\>converting;decimal fractions, into decimal numbers\</bookmark_value\>\<bookmark_value\>DOLLARDE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154671				0	he	DOLLARDE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154418				0	he	\<ahelp hid=\"HID_AAI_FUNC_DOLLARDE\"\>Converts a quotation that has been given as a decimal fraction into a decimal number.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3146124				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150348				0	he	DOLLARDE(Fractional dollar;Fraction)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154111				0	he	Fractional dollar: a number given as a decimal fraction.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153695				0	he	Fraction: a whole number that is used as the denominator of the decimal fraction.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153884				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150941				0	he	=DOLLARDE (1.02;16) stands for 1 and 2/16. This returns 1.125.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150830				0	he	=DOLLARDE (1.1;8) stands for 1 and 1/8. This returns 1.125.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3148974				0	he	\<bookmark_value\>calculating;modified internal rates of return\</bookmark_value\>\<bookmark_value\>modified internal rates of return\</bookmark_value\>\<bookmark_value\>MIRR function\</bookmark_value\>\<bookmark_value\>internal rates of return;modified\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3148974				0	he	MIRR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155497				0	he	\<ahelp hid=\"HID_FUNC_QIKV\"\>Calculates the modified internal rate of return of a series of investments.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154354				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148399				0	he	MIRR(Values; investment; reinvest_rate)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155896				0	he	Values:corresponds to the array or the cell reference for cells whose content corresponds to the payments.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149998				0	he	investment:the rate of interest of the investments (the negative values of the array)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3159408				0	he	reinvest_rate:the rate of interest of the reinvestment (the positive values of the array)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154714				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147352				0	he	Assuming a cell content of A1=-5, A2=10, A3=15, and A4=8, and an investment value of 0.5 and a reinvestment value of 0.1, the result is 94.16%.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3149323				0	he	\<bookmark_value\>YIELD function\</bookmark_value\>\<bookmark_value\>rates of return;securities\</bookmark_value\>\<bookmark_value\>yields, see also rates of return\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149323				0	he	YIELD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150643				0	he	\<ahelp hid=\"HID_AAI_FUNC_YIELD\"\>Calculates the yield of a security.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149344				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149744				0	he	YIELD(Settlement;Maturity;Rate;Price;Redemption;Frequency;Basis)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154526				0	he	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153266				0	he	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151284				0	he	Rate: the annual rate of interest.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147314				0	he	Price: the price (purchase price) of the security per 100 currency units of par value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145156				0	he	Redemption: the redemption value per 100 currency units of par value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3159218				0	he	\<emph\>Frequency\</emph\> is the number of interest payments per year (1, 2 or 4).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3147547				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151214				0	he	A security is purchased on 2/15/1999. It matures on 11/15/2007. The rate of interest is 5.75%. The price is 95.04287 currency units per 100 units of par value, the redemption value is 100 units. Interest is paid half-yearly (frequency = 2) and the basis is 0. How high is the yield?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154194				0	he	=YIELD("2/15/1999"; "11/15/2007"; 0.0575 ;95.04287; 100; 2; 0) returns 0.065 or 6.5 per cent.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3150100				0	he	\<bookmark_value\>YIELDDISC function\</bookmark_value\>\<bookmark_value\>rates of return;non-interest-bearing securities\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150100				0	he	YIELDDISC				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150486				0	he	\<ahelp hid=\"HID_AAI_FUNC_YIELDDISC\"\>Calculates the annual yield of a non-interest-bearing security.\</ahelp\>				20200411 15:09:53
