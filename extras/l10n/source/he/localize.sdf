helpcontent2	source\text\sbasic\shared\03030103.xhp	0	help	bm_id3153345				0	he	\<bookmark_value\>Day function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030103.xhp	0	help	hd_id3153345				0	he	\<link href=\"text/sbasic/shared/03030103.xhp\" name=\"Day Function [Runtime]\"\>Day Function [Runtime]\</link\>				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030103.xhp	0	help	par_id3147560				0	he	Returns a value that represents the day of the month based on a serial date number generated by \<emph\>DateSerial\</emph\> or \<emph\>DateValue\</emph\>.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030103.xhp	0	help	hd_id3149456				0	he	תחביר:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030103.xhp	0	help	par_id3150358				0	he	Day (Number)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030103.xhp	0	help	hd_id3148798				0	he	Return value:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030103.xhp	0	help	par_id3125865				0	he	Integer				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030103.xhp	0	help	hd_id3150448				0	he	Parameters:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030103.xhp	0	help	par_id3156423				0	he	\<emph\>Number:\</emph\> A numeric expression that contains a serial date number from which you can determine the day of the month.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030103.xhp	0	help	par_id3145786				0	he	This function is basically the opposite of the DateSerial function, returning the day of the month from a serial date number generated by the \<emph\>DateSerial\</emph\> or the \<emph\>DateValue\</emph\> function. For example, the expression				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030103.xhp	0	help	par_id3145364				0	he	Print Day (DateSerial(1994, 12, 20))				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030103.xhp	0	help	par_id3153190				0	he	returns the value 20.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030103.xhp	0	help	hd_id3149481				0	he	Example:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030103.xhp	0	help	par_id3155413				0	he	sub ExampleDay				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030103.xhp	0	help	par_id3149260				0	he	Print "Day " & Day(DateSerial(1994, 12, 20)) & " of the month"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03030103.xhp	0	help	par_id3148645				0	he	end sub				20200411 15:09:53
