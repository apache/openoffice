helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147249				0	he	\<ahelp hid=\"HID_FUNC_MINA\"\>Returns the minimum value in a list of arguments. Here you can also enter text. The value of the text is 0.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id4294564				0	he	The functions MINA() and MAXA() return 0 if no value (numeric or text) and no error was encountered.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150435				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153336				0	he	MINA(Value 1; Value 2; ... Value 30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146098				0	he	\<emph\>Value 1; Value 2;...Value 30\</emph\> are values or ranges. Text has the value of 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148743				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147401				0	he	=MINA(1; "Text"; 20) returns 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147295				0	he	=MINA(A1:B100) returns the smallest value in the list.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3166465				0	he	\<bookmark_value\>AVEDEV function\</bookmark_value\>\<bookmark_value\>averages;statistical functions\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3166465				0	he	AVEDEV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150373				0	he	\<ahelp hid=\"HID_FUNC_MITTELABW\"\>Returns the average of the absolute deviations of data points from their mean.\</ahelp\> Displays the diffusion in a data set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150038				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145636				0	he	AVEDEV(Number 1; Number 2; ...Number 30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3157871				0	he	\<emph\>Number 1, Number 2,...Number 30\</emph\> are values or ranges that represent a sample. Each number can also be replaced by a reference.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149725				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153122				0	he	=AVEDEV(A1:A50)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3145824				0	he	\<bookmark_value\>AVERAGE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3145824				0	he	AVERAGE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150482				0	he	\<ahelp hid=\"HID_FUNC_MITTELWERT\"\>Returns the average of the arguments.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3146943				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154679				0	he	AVERAGE(Number 1; Number 2; ...Number 30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150741				0	he	\<emph\>Number 1; Number 2;...Number 30\</emph\> are numerical values or ranges.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153039				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151232				0	he	=AVERAGE(A1:A50)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148754				0	he	\<bookmark_value\>AVERAGEA function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148754				0	he	AVERAGEA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145138				0	he	\<ahelp hid=\"HID_FUNC_MITTELWERTA\"\>Returns the average of the arguments. The value of a text is 0.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153326				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149734				0	he	AVERAGEA(Value 1; Value 2; ... Value 30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155260				0	he	\<emph\>Value 1; Value 2;...Value 30\</emph\> are values or ranges. Text has the value of 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149504				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150864				0	he	=AVERAGEA(A1:A50)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148754K1				0	he	\<bookmark_value\>AVERAGEIF function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148754K1				0	he	AVERAGEIF				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145138K1				0	he	\<ahelp hid=\"HID_FUNC_MITTELWERTB\"\>Average the values of cells in a range that meet a criteria.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153326K1				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149734K1				0	he	AVERAGEIF( Reference R ; Criterion C [ ; Reference A ] )				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155260K1				0	he	 If reference A is omitted, averages the values of cells in the reference range R that meet the Criterion C. If reference A is given, averages the values of cells of a range that is constructed using the top left cell of reference A and applying the dimensions, shape and size, of reference R.  Does not accept constant values as reference parameters.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145139K1				0	he	If no cell in range R matches the Criterion C, an Error is returned. If no Numbers are in the range to be averaged, an Error is returned.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149504K1				0	he	Examples				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150864K1				0	he	\<item type=\"input\"\>=AVERAGEIF(A1:A50;">"0)\</item\>will return the average of A1:A50 of all positive values in the range.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148754K2				0	he	\<bookmark_value\>AVERAGEIFS function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148754K2				0	he	AVERAGEIFS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145138K2				0	he	\<ahelp hid=\"HID_FUNC_MITTELWERTC\"\>Average the values of cells that meet multiple criteria in multiple ranges.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153326K2				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149734K2				0	he	AVERAGEIFS( Reference A ; Reference R1 ; Criterion C1 [ ; Reference R2 ; Criterion C2 ]... )				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155260K2				0	he	Averages the values of cells in the reference range A that meet the Criterion C1 in the reference range R1 and the Criterion C2 in the reference range R2, and so on.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145139K2				0	he	All reference ranges shall have the same dimension and size, else an Error is returned. A logical AND is applied between each array result of each selection; a cell of reference range A is evaluated only if the same position in each array is the result of a Criterion match. If no numbers are in the result set to be averaged, an Error is returned.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149504K2				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150864K2				0	he	\<item type=\"input\"\>=AVERAGEIFS(A1:A50;B1:B25;">"0)\</item\>+will return the average of A1:A50 if all cells in the range B1 to B25 are greater than 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153933				0	he	\<bookmark_value\>MODE function\</bookmark_value\>\<bookmark_value\>most common value\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153933				0	he	MODE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153085				0	he	\<ahelp hid=\"HID_FUNC_MODALWERT\"\>Returns the most common value in a data set.\</ahelp\> If there are several values with the same frequency, it returns the smallest value. An error occurs when a value doesn't appear twice.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153003				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155950				0	he	MODE(Number 1; Number 2; ...Number 30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150337				0	he	\<emph\>Number 1; Number 2;...Number 30\</emph\> are numerical values or ranges.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153571				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153733				0	he	=MODE(A1:A50)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3149879				0	he	\<bookmark_value\>NEGBINOMDIST function\</bookmark_value\>\<bookmark_value\>negative binomial distribution\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149879				0	he	NEGBINOMDIST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155437				0	he	\<ahelp hid=\"HID_FUNC_NEGBINOMVERT\"\>Returns the negative binomial distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3145351				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150935				0	he	NEGBINOMDIST(X; R; SP)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153044				0	he	\<emph\>X\</emph\> represents the value returned for unsuccessful tests.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151018				0	he	\<emph\>R\</emph\> represents the value returned for successful tests.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148878				0	he	\<emph\>SP\</emph\> is the probability of the success of an attempt.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149539				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148770				0	he	=NEGBINOMDIST(1; 1; 0.5) returns 0.25.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3155516				0	he	\<bookmark_value\>NORMINV function\</bookmark_value\>\<bookmark_value\>normal distribution;inverse of\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155516				0	he	NORMINV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154634				0	he	\<ahelp hid=\"HID_FUNC_NORMINV\"\>Returns the inverse of the normal cumulative distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153227				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147534				0	he	NORMINV(Number; Mean; STDEV)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154950				0	he	\<emph\>Number\</emph\> represents the probability value used to determine the inverse normal distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150690				0	he	\<emph\>Mean\</emph\> represents the mean value in the normal distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148594				0	he	\<emph\>STDEV\</emph\> represents the standard deviation of the normal distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155822				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153921				0	he	=NORMINV(0.9; 63; 5) returns 69.41. If the average egg weighs 63 grams with a standard deviation of 5, then there will be 90% probability that the egg will not be heavier than 69.41g grams.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153722				0	he	\<bookmark_value\>NORMDIST function\</bookmark_value\>\<bookmark_value\>density function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153722				0	he	NORMDIST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150386				0	he	\<ahelp hid=\"HID_FUNC_NORMVERT\"\>Returns the density function or the normal cumulative distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3083282				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150613				0	he	NORMDIST(Number; Mean; STDEV; C)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149820				0	he	\<emph\>Number\</emph\> is the value of the distribution based on which the normal distribution is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146063				0	he	\<emph\>Mean\</emph\> is the mean value of the distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156295				0	he	\<emph\>STDEV\</emph\> is the standard deviation of the distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145080				0	he	\<emph\>C\</emph\> = 0 calculates the density function; \<emph\>C\</emph\> = 1 calculates the distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152972				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149283				0	he	=NORMDIST(70; 63; 5; 0) returns 0.03.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149448				0	he	=NORMDIST(70; 63; 5; 1) returns 0.92.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3152934				0	he	\<bookmark_value\>PEARSON function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152934				0	he	PEARSON				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153216				0	he	\<ahelp hid=\"HID_FUNC_PEARSON\"\>Returns the Pearson product moment correlation coefficient r.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147081				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156133				0	he	PEARSON(Data_1; Data_2)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151272				0	he	\<emph\>Data_1\</emph\> represents the array of the first data set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153279				0	he	\<emph\>Data_2\</emph\> represents the array of the second data set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147567				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151187				0	he	=PEARSON(A1:A30; B1:B30) returns the Pearson correlation coefficient of both data sets.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3152806				0	he	\<bookmark_value\>PHI function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152806				0	he	PHI				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150254				0	he	\<ahelp hid=\"HID_FUNC_PHI\"\>Returns the values of the distribution function for a standard normal distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154748				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149976				0	he	PHI(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156108				0	he	\<emph\>Number\</emph\> represents the value based on which the standard normal distribution is calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153621				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155849				0	he	PHI(2.25) = 0.03				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3143236				0	he	PHI(-2.25) = 0.03				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149286				0	he	PHI(0) = 0.4				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153985				0	he	\<bookmark_value\>POISSON function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153985				0	he	POISSON				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154298				0	he	\<ahelp hid=\"HID_FUNC_POISSON\"\>Returns the Poisson distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3159183				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146093				0	he	POISSON(Number; Mean; C)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147253				0	he	\<emph\>Number\</emph\> represents the value based on which the Poisson distribution is calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151177				0	he	\<emph\>Mean\</emph\> represents the middle value of the Poisson distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149200				0	he	\<emph\>C\</emph\> (optional) = 0 or False calculates the density function; \<emph\>C\</emph\> = 1 or True calculates the distribution. When omitted, the default value True is inserted when you save the document, for best compatibility with other programs and older versions of %PRODUCTNAME.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3159347				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150113				0	he	=POISSON(60;50;1) returns 0.93.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153100				0	he	\<bookmark_value\>PERCENTILE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153100				0	he	PERCENTILE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154940				0	he	\<ahelp hid=\"HID_FUNC_QUANTIL\"\>Returns the alpha-percentile of data values in an array.\</ahelp\> A percentile returns the scale value for a data series which goes from the smallest (Alpha=0) to the largest value (alpha=1) of a data series. For \<item type=\"literal\"\>Alpha\</item\> = 25%, the percentile means the first quartile; \<item type=\"literal\"\>Alpha\</item\> = 50% is the MEDIAN.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150531				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148813				0	he	PERCENTILE(Data;Alpha)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153054				0	he	\<emph\>Data\</emph\> represents the array of data.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154212				0	he	\<emph\>Alpha\</emph\> represents the percentage of the scale between 0 and 1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154290				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159147				0	he	=PERCENTILE(A1:A50; 0.1) represents the value in the data set, which equals 10% of the total data scale in A1:A50.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148807				0	he	\<bookmark_value\>PERCENTRANK function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148807				0	he	PERCENTRANK				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153573				0	he	\<ahelp hid=\"HID_FUNC_QUANTILSRANG\"\>Returns the percentage rank of a value in a sample.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147512				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147238				0	he	PERCENTRANK(Data; Value)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154266				0	he	\<emph\>Data\</emph\> represents the array of data in the sample.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148475				0	he	\<emph\>Value\</emph\> represents the value whose percentile rank must be determined.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155364				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149163				0	he	=PERCENTRANK(A1:A50; 50) returns the percentage rank of the value 50 from the total range of all values found in A1:A50. If 50 falls outside the total range, an error message will appear.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3166442				0	he	\<bookmark_value\>QUARTILE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3166442				0	he	QUARTILE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146958				0	he	\<ahelp hid=\"HID_FUNC_QUARTILE\"\>Returns the quartile of a data set.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152942				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153684				0	he	QUARTILE(Data; Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153387				0	he	\<emph\>Data\</emph\> represents the array of data in the sample.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155589				0	he	\<emph\>Type\</emph\> represents the type of quartile. (0 = MIN, 1 = 25%, 2 = 50% (MEDIAN), 3 = 75% and 4 = MAX.)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149103				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159276				0	he	=QUARTILE(A1:A50; 2) returns the value of which 50% of the scale corresponds to the lowest to highest values in the range A1:A50.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	tit				0	he	Hyphenation				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	bm_id3159399				0	he	\<bookmark_value\>automatic hyphenation in spreadsheets\</bookmark_value\>\<bookmark_value\>hyphenation; in spreadsheets\</bookmark_value\>\<bookmark_value\>syllables in spreadsheets\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	hd_id3159399				0	he	Hyphenation				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3145068	2			0	he	\<variable id=\"silben\"\>\<ahelp hid=\".uno:Hyphenate\"\>The \<emph\>Hyphenation \</emph\>command calls the dialog for setting the hyphenation in $[officename] Calc.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3154366				0	he	You can only turn on the automatic hyphenation in $[officename] Calc when the \<link href=\"text/shared/01/05340300.xhp\" name=\"row break\"\>row break\</link\> feature is active.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	hd_id3153192				0	he	Hyphenation for selected cells.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3150868				0	he	Select the cells for which you want to change the hyphenation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3150440				0	he	Choose \<emph\>Tools - Language - Hyphenation\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3156441				0	he	The \<emph\>Format Cells\</emph\> dialog appears with the \<emph\>Alignment\</emph\> tab page open.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3149260				0	he	Mark the \<emph\>Automatic line break\</emph\> and the \<emph\>Hyphenation active\</emph\> check boxes.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	hd_id3153094				0	he	Hyphenation for Drawing Objects				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3148577				0	he	Select a drawing object.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3156285				0	he	Choose \<emph\>Tools - Language - Hyphenation\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3147394				0	he	Each time you call the command you turn the hyphenation for the drawing object on or off. A check mark shows the current status.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	tit				0	he	NOW				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	bm_id3150521				0	he	\<bookmark_value\>NOW function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	hd_id3150521				0	he	\<variable id=\"now\"\>\<link href=\"text/scalc/01/func_now.xhp\"\>NOW\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	par_id3148829				0	he	\<ahelp hid=\"HID_FUNC_JETZT\"\>Returns the computer system date and time.\</ahelp\> The value is updated when you recalculate the document or each time a cell value is modified.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	hd_id3146988				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	par_id3154897				0	he	NOW()				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	par_id4598529				0	he	NOW is a function without arguments.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	hd_id3154205				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	par_id3150774				0	he	=NOW()-A1 returns the difference between the date in A1 and now. Format the result as a number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	tit				0	he	TIMEVALUE 				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	bm_id3146755				0	he	\<bookmark_value\>TIMEVALUE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	hd_id3146755				0	he	\<variable id=\"timevalue\"\>\<link href=\"text/scalc/01/func_timevalue.xhp\"\>TIMEVALUE\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3148502				0	he	\<ahelp hid=\"HID_FUNC_ZEITWERT\"\>TIMEVALUE returns the internal time number from a text enclosed by quotes and which may show a possible time entry format.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3150794				0	he	The internal number indicated as a decimal is the result of the date system used under $[officename] to calculate date entries.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id011920090347118				0	he	If the text string also includes a year, month, or day, TIMEVALUE only returns the fractional part of the conversion.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	hd_id3150810				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3150823				0	he	TIMEVALUE("Text")				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3152556	165			0	he	\<emph\>Text\</emph\> is a valid time expression and must be entered in quotation marks.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	hd_id3146815				0	he	Examples				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3146829	167			0	he	TIMEVALUE("4PM") returns 0.67. When formatting in time format HH:MM:SS, you then get 16:00:00.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3153632	168			0	he	TIMEVALUE("24:00") returns 1. If you use the HH:MM:SS time format, the value is 00:00:00.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12090100.xhp	0	help	tit				0	he	Select Source				20200411 15:09:53
