helpcontent2	source\text\shared\01\05340500.xhp	0	help	par_id3155620				0	he	\<ahelp hid=\".\"\>Hides the selected column(s). To display hidden columns, right-click any column header, and then choose \<emph\>Show Columns\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	tit				0	he	Chinese Conversion				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	bm_id49745				0	he	\<bookmark_value\>Chinese writing systems\</bookmark_value\>\<bookmark_value\>simplified Chinese;conversion to traditional Chinese\</bookmark_value\>\<bookmark_value\>traditional Chinese;conversion to simplified Chinese\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10547				0	he	\<link href=\"text/shared/01/06010600.xhp\"\>Chinese Conversion\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10557				0	he	\<ahelp hid=\".\"\>Converts the selected Chinese text from one Chinese writing system to the other. If no text is selected, the entire document is converted.\</ahelp\> You can only use this command if you enable Asian language support in \<emph\>Tools - Options - Language Settings - Languages\</emph\>.				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10572				0	he	Conversion direction				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10576				0	he	\<ahelp hid=\".\"\>Select the conversion direction.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10579				0	he	Traditional Chinese to Simplified Chinese				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1057D				0	he	\<ahelp hid=\".\"\>Converts traditional Chinese text characters to simplified Chinese text characters. Click \<emph\>OK\</emph\> to convert the selected text. If no text is selected, the whole document is converted.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10580				0	he	Simplified Chinese to Traditional Chinese				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10584				0	he	\<ahelp hid=\".\"\>Converts simplified Chinese text characters to traditional Chinese text characters. Click \<emph\>OK\</emph\> to convert the selected text. If no text is selected, the whole document is converted.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1058E				0	he	Common terms				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10592				0	he	\<ahelp hid=\".\"\>Common terms are words that have the same meaning in traditional and simplified Chinese but are written with different characters.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10595				0	he	Convert Common Terms				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10599				0	he	\<ahelp hid=\".\"\>Converts words with two or more characters that are in the list of common terms. After the list is scanned, the remaining text is converted character by character.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1059C				0	he	Edit terms				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN105A0				0	he	\<ahelp hid=\".\"\>Opens the \<link href=\"text/shared/01/06010601.xhp\"\>Edit Dictionary\</link\> dialog where you can edit the list of conversion terms.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	tit				0	he	Comment				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	hd_id3083278				0	he	Comment				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	par_id3148983				0	he	\<variable id=\"kommentartext\"\>\<ahelp hid=\"HID_REDLINING_EDIT\"\>Enter a comment for the recorded change.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	par_id3155391	3			0	he	You can attach a comment when \<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>the cursor is in a changed text passage \</caseinline\>\<caseinline select=\"CALC\"\>the changed cell is selected\</caseinline\>\</switchinline\>, or in the \<emph\>Accept or Reject Changes\</emph\> dialog.				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	par_id3156426	5			0	he	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>Comments are displayed as callouts in the sheet when you rest your mouse pointer over a cell with a recorded change. You can also view comments that are attached to a changed cell in the changes list in the \<link href=\"text/shared/01/02230400.xhp\" name=\"Accept or Reject Changes\"\>\<emph\>Accept or Reject Changes\</emph\>\</link\> dialog. \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	tit				0	he	List of Regular Expressions				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	bm_id3146765				0	he	\<bookmark_value\>regular expressions; list of\</bookmark_value\>\<bookmark_value\>lists;regular expressions\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	hd_id3146765				0	he	\<variable id=\"02100001\"\>\<link href=\"text/shared/01/02100001.xhp\"\>List of Regular Expressions\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149741				0	he	Character				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155577				0	he	Result/Use				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id6600543				0	he	Any character				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9824518.00000001				0	he	Represents any single character unless otherwise specified.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152427				0	he	.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149031				0	he	Represents any single character except for a line break or paragraph break. For example, the search term "sh.rt" returns both "shirt" and "short".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154682				0	he	^				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155351				0	he	Only finds the search term if the term is at the beginning of a paragraph. Special objects such as empty fields or character-anchored frames, at the beginning of a paragraph are ignored. Example: "^Peter".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3159194				0	he	$				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152542				0	he	Only finds the search term if the term appears at the end of a paragraph. Special objects such as empty fields or character-anchored frames at the end of a paragraph are ignored. Example: "Peter$".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156414				0	he	*				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155555				0	he	Finds zero or more of the characters in front of the "*". For example, "Ab*c" finds "Ac", "Abc", "Abbc", "Abbbc", and so on.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147399				0	he	+				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3157958				0	he	Finds one or more of the characters in front of the "+". For example, "AX.+4" finds "AXx4", but not "AX4".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145313				0	he	The longest possible string that matches this search pattern in a paragraph is always found. If the paragraph contains the string "AX 4 AX4", the entire passage is highlighted.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3143267				0	he	?				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153684				0	he	Finds zero or one of the characters in front of the "?". For example, "Texts?" finds "Text" and "Texts" and "x(ab|c)?y" finds "xy", "xaby", or "xcy".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3166410				0	he	\\				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147209				0	he	Search interprets the special character that follows the "\\" as a normal character and not as a regular expression (except for the combinations \\n, \\t, \\>, and \\<). For example, "tree\\." finds "tree.", not "treed" or "trees".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152945				0	he	\\n				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153700				0	he	Represents a line break that was inserted with the Shift+Enter key combination. To change a line break into a paragraph break, enter \<emph\>\\n\</emph\> in the \<emph\>Search for\</emph\> and \<emph\>Replace with\</emph\> boxes, and then perform a search and replace.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9262672				0	he	\\n in the \<emph\>Search for\</emph\> text box stands for a line break that was inserted with the Shift+Enter key combination.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id2366100				0	he	\\n in the \<emph\>Replace with\</emph\> text box stands for a paragraph break that can be entered with the Enter or Return key.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153258				0	he	\\t				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3157809				0	he	Represents a tab. You can also use this expression in the \<emph\>Replace with\</emph\> box.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150670				0	he	\\b				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153666				0	he	Match a word boundary. For example, "\\bbook" finds "bookmark" but not "checkbook" whereas "book\\b" finds "checkbook" but not "bookmark". The discrete word "book" is found by both search terms.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149576				0	he	^$				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3151245				0	he	Finds an empty paragraph.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148550				0	he	^.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3159413				0	he	Finds the first character of a paragraph.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147282				0	he	& או $0				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153961				0	he	Adds the string that was found by the search criteria in the \<emph\>Search for\</emph\> box to the term in the \<emph\>Replace with\</emph\> box when you make a replacement.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149650				0	he	For example, if you enter "window" in the \<emph\>Search for\</emph\> box and "&frame" in the \<emph\>Replace with\</emph\> box, the word "window" is replaced with "windowframe".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150543				0	he	You can also enter an "&" in the \<emph\>Replace with\</emph\> box to modify the \<emph\>Attributes\</emph\> or the \<emph\>Format\</emph\> of the string found by the search criteria.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145419				0	he	[abc123]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154630				0	he	Represents one of the characters that are between the brackets.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156293				0	he	[a-e]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149167				0	he	Represents any of the characters that are between a and e, including both start and end characters				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id100520090232005				0	he	The characters are ordered by their code numbers.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155994				0	he	[a-eh-x]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148676				0	he	Represents any of the characters that are between a-e and h-x.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145318				0	he	[^a-s]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153351				0	he	Represents everything that is not between a and s.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156543				0	he	\\xXXXX				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153768				0	he	Represents a special character based on its four-digit hexadecimal code (XXXX).				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3159252				0	he	The code for the special character depends on the font used. You can view the codes by choosing \<emph\>Insert - Special Character\</emph\>.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153951				0	he	|				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154985				0	he	Finds the terms that occur before the "|" and also finds the terms that occur after the "|". For example, "this|that" finds "this" and "that".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147376				0	he	{2}				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150103				0	he	Defines the number of times that the character in front of the opening bracket occurs. For example, "tre{2}" finds and selects "tree".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3151289				0	he	{1,2}				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147317				0	he	Defines the minimum and maximum number of times that the character in front of the opening bracket can occur. For example, "tre{1,2}" finds and selects "tre" and "tree".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id4870754				0	he	{1,}				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id843836				0	he	Defines the minimum number of times that the character in front of the opening bracket can occur. For example, "tre{2,}" finds "tree", "treee", and "treeeee".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148616				0	he	( )				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id2701803				0	he	In the \<emph\>Search for\</emph\> box:				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153573				0	he	Defines the characters inside the parentheses as a reference. You can then refer to the first reference in the current expression with "\\1", to the second reference with "\\2", and so on.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156061				0	he	For example, if your text contains the number 13487889 and you search using the regular expression (8)7\\1\\1, "8788" is found.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id2367931				0	he	You can also use () to group terms, for example, "a(bc)?d" finds "ad" or "abcd".				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9200109				0	he	In the \<emph\>Replace with\</emph\> box:				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id5766472				0	he	Use $ (dollar) instead of \\ (backslash) to replace references. Use $0 to replace the whole found string.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154790				0	he	[:alpha:]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147397				0	he	Represents an alphabetic character. Use [:alpha:]+ to find one or more of them.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152885				0	he	[:digit:]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150010				0	he	Represents a decimal digit. Use [:digit:]+ to find one or more of them.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153743				0	he	[:alnum:]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153281				0	he	Represents an alphanumeric character ([:alpha:] and [:digit:]).				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153726				0	he	[:space:]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150961				0	he	Represents a white space character such as space.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150486				0	he	[:print:]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150872				0	he	Represents a printable character.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155854				0	he	[:cntrl:]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152576				0	he	Represents a nonprinting character.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149958				0	he	[:lower:]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145730				0	he	Represents a lowercase character if \<emph\>Match case\</emph\> is selected in \<emph\>Options\</emph\>.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148455				0	he	[:upper:]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150092	231			0	he	Represents an uppercase character if \<emph\>Match case\</emph\> is selected in \<emph\>Options.\</emph\>               				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	hd_id5311441				0	he	Examples				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id956834773				0	he	e([:digit:])?    -- finds 'e' followed by zero or one digit. Note that currently all named character classes like [:digit:] must be enclosed in parentheses.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id952368773				0	he	^([:digit:])$    -- finds lines or cells with exactly one digit.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9568773				0	he	You can combine the search terms to form complex searches.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	hd_id71413				0	he	To find three-digit numbers alone in a paragraph				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id2924283				0	he	^[:digit:]{3}$				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id5781731				0	he	^ means the match has to be at the start of a paragraph, 				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id6942045				0	he	[:digit:] matches any decimal digit, 				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id4721823				0	he	{3} means there must be exactly 3 copies of "digit", 				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id5806756				0	he	$ means the match must end a paragraph. 				20200411 15:09:53
