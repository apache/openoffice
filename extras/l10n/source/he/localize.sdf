helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3150381				0	he	\<ahelp hid=\"HID_AAI_FUNC_ERF\"\>Returns values of the Gaussian error integral.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3152475				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3163824				0	he	ERF(Lower limit;Upper limit)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3149715				0	he	Lower limit; lower limit of integral.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3156294				0	he	Upper limit: optionally, the upper limit of the integral. If this value is missing, the calculation takes places between 0 and the lower limit.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3154819				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3152974				0	he	=ERF(0;1) returns 0.842701.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	bm_id3145082				0	he	\<bookmark_value\>ERFC function\</bookmark_value\>				20200411 15:09:53
