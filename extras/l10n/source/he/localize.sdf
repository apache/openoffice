helpcontent2	source\text\scalc\01\07080000.xhp	0	help	hd_id3163800				0	he	\<link href=\"text/scalc/01/07080000.xhp\" name=\"Split\"\>Split\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\07080000.xhp	0	help	par_id3150084				0	he	\<ahelp hid=\".uno:SplitWindow\" visibility=\"visible\"\>Divides the current window at the top left corner of the active cell.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\07080000.xhp	0	help	par_id3154910				0	he	You can also use the mouse to split the window horizontally or vertically. To do this, drag the thick black line located directly above the vertical scrollbar or directly to the right of the horizontal scrollbar into the window. A thick black line will show where the window is split.				20200411 15:09:53
helpcontent2	source\text\scalc\01\07080000.xhp	0	help	par_id3149263				0	he	A split window has its own scrollbars in each partial section; by contrast, \<link href=\"text/scalc/01/07090000.xhp\" name=\"fixed window sections\"\>fixed window sections\</link\> are not scrollable.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_edate.xhp	0	help	tit				0	he	EDATE				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_edate.xhp	0	help	bm_id3151184				0	he	\<bookmark_value\>EDATE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_edate.xhp	0	help	hd_id3151184				0	he	\<variable id=\"edate\"\>\<link href=\"text/scalc/01/func_edate.xhp\"\>EDATE\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_edate.xhp	0	help	par_id3150880	214			0	he	\<ahelp hid=\"HID_AAI_FUNC_EDATE\"\>The result is a date which is a number of m\<emph\>onths\</emph\> away from the \<emph\>start date\</emph\>. Only months are considered; days are not used for calculation.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_edate.xhp	0	help	hd_id3154647				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_edate.xhp	0	help	par_id3153212				0	he	EDATE(Start date;Months)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_edate.xhp	0	help	par_id3146860				0	he	\<emph\>Start date\</emph\>: a date.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_edate.xhp	0	help	par_id3152929				0	he	\<emph\>Months\</emph\> is the number of months before (negative) or after (positive) the start date.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_edate.xhp	0	help	hd_id3151289				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_edate.xhp	0	help	par_id3155845				0	he	What date is one month prior to 3.31.2001?				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_edate.xhp	0	help	par_id3155999				0	he	=EDATE("3.31.2001";-1) returns 2.28.2001.				20200411 15:09:53
