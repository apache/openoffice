helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3153768				0	he	Dim sText As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3155132				0	he	sText = InputBox("Please enter a short sentence:")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3155855				0	he	REM Proof if the word »and« appears in the sentence.				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3146984				0	he	REM Instead of the command line				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3148576				0	he	REM If Instr(Input, "and")<>0 Then...				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3154014				0	he	REM the CBool function is applied as follows:				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3155413				0	he	If CBool(Instr(sText, "and")) Then				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3152940				0	he	MsgBox "The word »and« appears in the sentence you entered!"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03100100.xhp	0	help	par_id3153954				0	he	EndIf				20200411 15:09:53
