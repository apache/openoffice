helpcontent2	source\text\scalc\01\12040000.xhp	0	help	par_id3155131				0	he	\<ahelp hid=\".\"\>Shows commands to filter your data.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040000.xhp	0	help	par_id3146119				0	he	$[officename] automatically recognizes predefined database ranges.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040000.xhp	0	help	par_id3153363				0	he	The following filtering options are available:				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040000.xhp	0	help	hd_id3153728				0	he	\<link href=\"text/shared/02/12090000.xhp\" name=\"Standard filter\"\>Standard filter\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040000.xhp	0	help	hd_id3159153				0	he	\<link href=\"text/scalc/01/12040300.xhp\" name=\"Advanced filter\"\>Advanced filter\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	tit				0	he	DAYS 				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	bm_id3151328				0	he	\<bookmark_value\>DAYS function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	hd_id3151328				0	he	\<variable id=\"days\"\>\<link href=\"text/scalc/01/func_days.xhp\"\>DAYS\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3155139				0	he	\<ahelp hid=\"HID_FUNC_TAGE\"\>Calculates the difference between two date values.\</ahelp\> The result returns the number of days between the two days.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	hd_id3155184				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3149578				0	he	DAYS(Date_2;Date_1)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3151376				0	he	\<emph\>Date_1\</emph\> is the start date, \<emph\>Date_2\</emph\> is the end date. If \<emph\>Date_2\</emph\> is an earlier date than \<emph\>Date_1\</emph\> the result is a negative number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	hd_id3151001				0	he	Examples				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3159101				0	he	DAYS("1/1/2010"; NOW()) returns the number of days from today until January 1, 2010.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_days.xhp	0	help	par_id3163720				0	he	DAYS("10/10/1990";"10/10/1980") returns 3652.				20200411 15:09:53
