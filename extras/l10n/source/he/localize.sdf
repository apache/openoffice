helpcontent2	source\text\sbasic\shared\03090410.xhp	0	help	par_id3149579				0	he	sGender = GetGenderIndex( "John" )				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090410.xhp	0	help	par_id3153626				0	he	MsgBox sGender				20200411 15:09:53
