helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3159191				0	he	YIELDDISC(Settlement;Maturity;Price;Redemption;Basis)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150237				0	he	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146924				0	he	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151201				0	he	Price: the price (purchase price) of the security per 100 currency units of par value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156049				0	he	Redemption: the redemption value per 100 currency units of par value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154139				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3163815				0	he	A non-interest-bearing security is purchased on 2/15/1999. It matures on 3/1/1999. The price is 99.795 currency units per 100 units of par value, the redemption value is 100 units. The basis is 2. How high is the yield?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155187				0	he	=YIELDDISC("2/15/1999"; "3/1/1999"; 99.795; 100; 2) returns 0.052823 or 5.2823 per cent.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3155140				0	he	\<bookmark_value\>YIELDMAT function\</bookmark_value\>\<bookmark_value\>rates of return;securities with interest paid on maturity\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155140				0	he	YIELDMAT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151332				0	he	\<ahelp hid=\"HID_AAI_FUNC_YIELDMAT\"\>Calculates the annual yield of a security, the interest of which is paid on the date of maturity.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3159100				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3159113				0	he	YIELDMAT(Settlement;Maturity;Issue;Rate;Price;Basis)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149309				0	he	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151381				0	he	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153302				0	he	Issue: the date of issue of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147140				0	he	Rate: the interest rate of the security on the issue date.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151067				0	he	Price: the price (purchase price) of the security per 100 currency units of par value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155342				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3163717				0	he	A security is purchased on 3/15/1999. It matures on 11/3/1999. The issue date was 11/8/1998. The rate of interest is 6.25%, the price is 100.0123 units. The basis is 0. How high is the yield?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155311				0	he	=YIELDMAT("3/15/1999"; "11/3/1999"; "11/8/1998"; 0.0625; 100.0123; 0) returns 0.060954 or 6.0954 per cent.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3149577				0	he	\<bookmark_value\>calculating;annuities\</bookmark_value\>\<bookmark_value\>annuities\</bookmark_value\>\<bookmark_value\>PMT function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149577				0	he	PMT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148563				0	he	\<ahelp hid=\"HID_FUNC_RMZ\"\>Returns the periodic payment for an annuity with constant interest rates.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3145257				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147278				0	he	PMT(Rate; NPER; PV; FV; Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147291				0	he	\<emph\>Rate\</emph\> is the periodic interest rate.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148641				0	he	NPER: the number of periods in which annuity is paid.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156360				0	he	PV: the present value (cash value) in a sequence of payments.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154920				0	he	FV (optional): the desired value (future value) to be reached at the end of the periodic payments.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156434				0	he	Type (optional): the due date for the periodic payments. Type=1 is payment at the beginning and Type=0 is payment at the end of each period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_idN11645				0	he	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3152358				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154222				0	he	What are the periodic payments at a yearly interest rate of 1.99% if the payment time is 3 years and the cash value is 25,000 currency units. There are 36 months as 36 payment periods, and the interest rate per payment period is 1.99%/12.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3155943				0	he	PMT(1.99%/12;36;25000) = -715.96 currency units. The periodic monthly payment is therefore 715.96 currency units.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3155799				0	he	\<bookmark_value\>TBILLEQ function\</bookmark_value\>\<bookmark_value\>treasury bills;annual return\</bookmark_value\>\<bookmark_value\>annual return on treasury bills\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155799				0	he	TBILLEQ				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154403				0	he	\<ahelp hid=\"HID_AAI_FUNC_TBILLEQ\"\>Calculates the annual return on a treasury bill ().\</ahelp\> A treasury bill is purchased on the settlement date and sold at the full par value on the maturity date, that must fall within the same year. A discount is deducted from the purchase price.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155080				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150224				0	he	TBILLEQ(Settlement;Maturity;Discount)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156190				0	he	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153827				0	he	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150310				0	he	\<emph\>Discount\</emph\> is the percentage discount on acquisition of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150324				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153173				0	he	Settlement date: March 31 1999, maturity date: June 1 1999, discount: 9.14 per cent.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153520				0	he	The return on the treasury bill corresponding to a security is worked out as follows:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154382				0	he	=TBILLEQ("3/31/99";"6/1/99"; 0.0914) returns 0.094151 or 9.4151 per cent.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3151032				0	he	\<bookmark_value\>TBILLPRICE function\</bookmark_value\>\<bookmark_value\>treasury bills;prices\</bookmark_value\>\<bookmark_value\>prices;treasury bills\</bookmark_value\>				20200411 15:09:53
