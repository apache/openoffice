helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153485				0	he	\<ahelp hid=\"HID_FUNC_SCHIEFE\"\>Returns the skewness of a distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3154733				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3151191				0	he	SKEW(Number 1; number 2; ...number 30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3155757	16			0	he	\<emph\>Number 1, number 2...number 30\</emph\> are numerical values or ranges.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3153297				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3145118	18			0	he	=SKEW(A1:A50) calculates the value of skew for the data referenced.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3149051				0	he	\<bookmark_value\>regression lines\</bookmark_value\>\<bookmark_value\>extrapolations\</bookmark_value\>\<bookmark_value\>FORECAST function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3149051				0	he	FORECAST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153290				0	he	\<ahelp hid=\"HID_FUNC_SCHAETZER\"\>Extrapolates future values based on existing x and y values.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3151343				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3147404				0	he	FORECAST(Value; data_Y; data_X)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3148743	24			0	he	\<emph\>Value\</emph\> is the x value, for which the y value on the linear regression is to be returned.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3146325	25			0	he	\<emph\>Data_Y\</emph\> is the array or range of known y's.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150536	26			0	he	\<emph\>Data_X\</emph\> is the array or range of known x's.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3147416				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3157874	28			0	he	=FORECAST(50; A1:A50; B1;B50) returns the Y value expected for the X value of 50 if the X and Y values in both references are linked by a linear trend.				20200411 15:09:53
