helpcontent2	source\text\shared\autopi\01090600.xhp	0	help	par_idN1055A				0	he	\<ahelp hid=\".\"\>Specifies the name of the form.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01090600.xhp	0	help	par_idN1055D				0	he	Work with the form				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01090600.xhp	0	help	par_idN105C5				0	he	\<ahelp hid=\".\"\>Saves the form, and opens it as a form document to enter and display data.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01090600.xhp	0	help	par_idN10563				0	he	Modify the form				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01090600.xhp	0	help	par_idN105D2				0	he	\<ahelp hid=\".\"\>Saves the form, and opens it in edit mode to change the layout.\</ahelp\>				20200411 15:09:53
