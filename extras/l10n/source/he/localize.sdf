helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149171				0	he	\<bookmark_value\>REPLACE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149171				0	he	REPLACE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148925				0	he	\<ahelp hid=\"HID_FUNC_ERSETZEN\"\>Replaces part of a text string with a different text string.\</ahelp\> This function can be used to replace both characters and numbers (which are automatically converted to text). The result of the function is always displayed as text. If you intend to perform further calculations with a number which has been replaced by text, you will need to convert it back to a number using the \<link href=\"text/scalc/01/04060110.xhp\" name=\"VALUE\"\>VALUE\</link\> function.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3158426				0	he	Any text containing numbers must be enclosed in quotation marks if you do not want it to be interpreted as a number and automatically converted to text.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149159				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147286				0	he	REPLACE(text; position; length; new text)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149797	27			0	he	\<emph\>Text\</emph\> refers to text of which a part will be replaced.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3166451	28			0	he	\<emph\>position\</emph\> refers to the position within the text where the replacement will begin.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156040	29			0	he	\<emph\>length\</emph\> is the number of characters in \<emph\>text\</emph\> to be replaced.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3159188	30			0	he	\<emph\>new text\</emph\> refers to the text which replaces \<emph\>text\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146958				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154096	32			0	he	REPLACE("1234567";1;1;"444") returns "444234567". One character at position 1 is replaced by the complete \<emph\>new text\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149741				0	he	\<bookmark_value\>REPT function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149741				0	he	REPT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153748				0	he	\<ahelp hid=\"HID_FUNC_WIEDERHOLEN\"\>Repeats a character string by the given \<emph\>number\</emph\> of copies.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152884				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150494				0	he	REPT(text; number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154859	197			0	he	\<emph\>text\</emph\> is the text to be repeated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150638	198			0	he	\<emph\>number\</emph\> is the number of repetitions.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149922				0	he	The result can be a maximum of 255 characters.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3156213				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148626	200			0	he	REPT("Good morning"; 2) returns \<emph\>Good morningGood morning\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149805				0	he	\<bookmark_value\>RIGHT function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149805				0	he	RIGHT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145375				0	he	\<ahelp hid=\"HID_FUNC_RECHTS\"\>Returns the last character or characters of a text.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150837				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154344				0	he	RIGHT(text; number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149426	117			0	he	\<emph\>text\</emph\> is the text of which the right part is to be determined.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153350	118			0	he	\<emph\>number\</emph\> (optional) is the number of characters from the right part of the text.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148661				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151132	120			0	he	RIGHT("Sun";2) returns \<emph\>un\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3153534				0	he	\<bookmark_value\>ROMAN function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153534				0	he	ROMAN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151256				0	he	\<ahelp hid=\"HID_FUNC_ROEMISCH\"\>Converts a number into a Roman numeral. The value range must be between 0 and 3999, the modes can be integers from 0 to 4.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149299				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150593				0	he	ROMAN(Number; Mode)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156139	252			0	he	\<emph\>Number\</emph\> is the number that is to be converted into a Roman numeral.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153318	253			0	he	\<emph\>Mode\</emph\> (optional) indicates the degree of simplification. The higher the value, the greater is the simplification of the Roman number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3145306				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151371	255			0	he	ROMAN(999) returns CMXCIX				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153938	256			0	he	ROMAN(999;0) returns CMXCIX				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148412	257			0	he	ROMAN (999;1) returns LMVLIV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155421	258			0	he	ROMAN(999;2) returns XMIX				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149235	259			0	he	ROMAN(999;3) returns VMIV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150624	260			0	he	ROMAN(999;4) returns IM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3151005				0	he	\<bookmark_value\>SEARCH function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3151005				0	he	SEARCH				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148692				0	he	\<ahelp hid=\"HID_FUNC_SUCHEN\"\>Returns the position of a text segment within a character string.\</ahelp\> You can set the start of the search as an option. The search text can be a number or any sequence of characters. The search is not case-sensitive.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152964				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154671				0	he	SEARCH(find_text; text; position)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146080	126			0	he	\<emph\>find_text\</emph\> is the text to be searched for.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154111	127			0	he	\<emph\>text\</emph\> is the text where the search will take place.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149559	128			0	he	\<emph\>position\</emph\> (optional) is the position in the text where the search is to start.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3147322				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154564	130			0	he	SEARCH(54;998877665544) returns 10.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3154830				0	he	\<bookmark_value\>SUBSTITUTE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3154830				0	he	SUBSTITUTE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153698				0	he	\<ahelp hid=\"HID_FUNC_WECHSELN\"\>Substitutes new text for old text in a string.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150994				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147582				0	he	SUBSTITUTE(text; search_text; new text; occurrence)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153675	178			0	he	\<emph\>text\</emph\> is the text in which text segments are to be exchanged.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156155	179			0	he	\<emph\>search_text \</emph\>is the text segment that is to be replaced (a number of times).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145779	180			0	he	\<emph\>new text\</emph\> is the text that is to replace the text segment.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150348	181			0	he	\<emph\>occurrence\</emph\> (optional) indicates which occurrence of the search text is to be replaced. If this parameter is missing the search text is replaced throughout.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150946				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150412	183			0	he	SUBSTITUTE("123123123"; "3"; "abc") returns \<emph\>12abc12abc12abc\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154915	238			0	he	SUBSTITUTE("123123123"; "3"; "abc"; 2) returns \<emph\>12312abc123\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3148977				0	he	\<bookmark_value\>T function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148977				0	he	T				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154359				0	he	\<ahelp hid=\"HID_FUNC_T\"\>This function returns the target text, or a blank text string if the target is not text.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155858				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155871				0	he	T(value)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154726				0	he	If \<emph\>value\</emph\> is a text string or refers to a text string, T returns that text string; otherwise it returns a blank text string.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155544				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151062	146			0	he	T(12345) returns an empty string "". 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id4650105				0	he	T("12345") returns the string 12345.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3147132				0	he	\<bookmark_value\>TEXT function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3147132				0	he	TEXT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147213				0	he	\<ahelp hid=\"HID_FUNC_TEXT\"\>Converts a number into text according to a given format.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153129				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147377				0	he	TEXT(Number; Format)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147389	162			0	he	\<emph\>Number\</emph\> is the numerical value to be converted.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156167	163			0	he	\<emph\>Format\</emph\> is the text which defines the format. Use decimal and thousands separators according to the language set in the cell format.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id1243629				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id9044770				0	he	            \<item type=\"input\"\>=TEXT(12.34567;"###.##")\</item\> returns the text 12.35				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3674123				0	he	            \<item type=\"input\"\>=TEXT(12.34567;"000.00")\</item\> returns the text 012.35				20200411 15:09:53
