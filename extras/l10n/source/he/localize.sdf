helpcontent2	source\text\shared\optionen\01030300.xhp	0	help	par_id3153255				0	he	\<ahelp hid=\".\"\>Defines the security options for saving documents, for web connections, and for opening documents that contain macros.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01030300.xhp	0	help	par_idN10640				0	he	Options				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01030300.xhp	0	help	par_idN10644				0	he	\<ahelp hid=\".\"\>Opens the "Security options and warning" dialog.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01030300.xhp	0	help	par_id5616626				0	he	The Security options and warnings dialog contains the following controls:				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01030300.xhp	0	help	par_idN10647				0	he	When saving or sending				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01030300.xhp	0	help	par_idN1064B				0	he	\<ahelp hid=\"703988739\"\>Select to see a warning dialog when you try to save or send a document that contains recorded changes, versions, or comments.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01030300.xhp	0	help	par_idN1064E				0	he	When printing				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01030300.xhp	0	help	par_idN10652				0	he	\<ahelp hid=\"703988740\"\>Select to see a warning dialog when you try to print a document that contains recorded changes or comments.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01030300.xhp	0	help	par_idN10655				0	he	When signing				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01030300.xhp	0	help	par_idN10659				0	he	\<ahelp hid=\"703988741\"\>Select to see a warning dialog when you try to sign a document that contains recorded changes, versions, fields, references to other sources (for example linked sections or linked pictures), or comments.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01030300.xhp	0	help	par_idN1065C				0	he	When creating PDF files				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01030300.xhp	0	help	par_idN10660				0	he	\<ahelp hid=\"703988742\"\>Select to see a warning dialog when you try to export a document to PDF format that displays recorded changes in Writer, or that displays comments.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01030300.xhp	0	help	par_idN10663				0	he	Remove personal information on saving				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01030300.xhp	0	help	par_idN10667				0	he	\<ahelp hid=\"703988743\"\>Select to always remove user data from the file properties. If this option is not selected, you can still remove the personal information for the current document with the \<emph\>Reset\</emph\> button on \<emph\>File - Properties - General\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01030300.xhp	0	help	par_idN1067C				0	he	Recommend password protection on saving				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01030300.xhp	0	help	par_idN10680				0	he	\<ahelp hid=\"703988744\"\>Select to always enable the \<emph\>Save with password\</emph\> option in the file save dialogs. Deselect the option to save files by default without password.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01030300.xhp	0	help	hd_id1972106				0	he	Ctrl-click required to follow hyperlinks				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01030300.xhp	0	help	par_id79042				0	he	\<ahelp hid=\".\"\>If enabled, you must hold down the Ctrl key while clicking a hyperlink to follow that link. If not enabled, a click opens the hyperlink.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01030300.xhp	0	help	hd_id4076357				0	he	Passwords for web connections				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01030300.xhp	0	help	par_id8231757				0	he	You can enter a master password to enable easy access to sites that require a user name and password.				20200411 15:09:53
