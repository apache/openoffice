helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3149210				0	he	sEntry(iCount2) = sTemp				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3153781				0	he	End If				20200411 15:09:53
