helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3153220				0	he	ERFC(Lower limit)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3147620				0	he	Lower limit; lower limit of integral				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3146861				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3156102				0	he	=ERFC(1) returns 0.157299.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	bm_id3152927				0	he	\<bookmark_value\>GESTEP function\</bookmark_value\>\<bookmark_value\>numbers;greater than or equal to\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3152927				0	he	GESTEP				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3150763				0	he	\<ahelp hid=\"HID_AAI_FUNC_GESTEP\"\>The result is 1 if \<item type=\"literal\"\>Number\</item\> is greater than or equal to \<item type=\"literal\"\>Step\</item\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3150879				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3145212				0	he	GESTEP(Number; Step)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3153275				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3156132				0	he	=GESTEP(5;1) returns 1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	bm_id3147276				0	he	\<bookmark_value\>HEX2BIN function\</bookmark_value\>\<bookmark_value\>converting;hexadecimal numbers, into binary numbers\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3147276				0	he	HEX2BIN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3150258				0	he	\<ahelp hid=\"HID_AAI_FUNC_HEX2BIN\"\>The result is the binary number for the hexadecimal number entered.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3156117				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3155847				0	he	HEX2BIN(Number;Places)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3152810				0	he	Number: the hexadecimal number. The number can have a maximum of 10 places. The most significant bit is the sign bit, the following bits return the value. Negative numbers are entered as two's complement.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3153758				0	he	Places: the number of places to be output.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3154052				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3156002				0	he	=HEX2BIN(64;8) returns 01100100.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	bm_id3154742				0	he	\<bookmark_value\>HEX2DEC function\</bookmark_value\>\<bookmark_value\>converting;hexadecimal numbers, into decimal numbers\</bookmark_value\>				20200411 15:09:53
