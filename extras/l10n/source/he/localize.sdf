helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153196				0	he	\<ahelp hid=\"HID_FUNC_ZELLE\"\>Returns information on address, formatting or contents of a cell.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3149323				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3147355				0	he	CELL(Info_type; Reference)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154716				0	he	\<emph\>Info_type\</emph\> is the character string that specifies the type of information. The character string is always in English. Upper or lower case is optional.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150636				0	he	Info_type				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149344				0	he	Meaning				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153266				0	he	COL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156204				0	he	Returns the number of the referenced column.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150094				0	he	Cell("COL";D2) returns 4.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151276				0	he	ROW				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3147583				0	he	Returns the number of the referenced row.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151222				0	he	Cell("ROW";D2) returns 2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3159217				0	he	SHEET				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151201				0	he	Returns the number of the referenced sheet.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149169				0	he	Cell("Sheet";Sheet3.D2) returns 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149431				0	he	ADDRESS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156054				0	he	Returns the absolute address of the referenced cell.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154136				0	he	CELL("ADDRESS";D2) returns $D$2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3159198				0	he	CELL("ADDRESS";Sheet3.D2) returns $Sheet3.$D$2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150245				0	he	CELL("ADDRESS";'X:\\dr\\test.sxc'#$Sheet1.D2) returns 'file:///X:/dr/test.sxc'#$Sheet1.$D$2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3146811				0	he	FILENAME				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151328				0	he	Returns the file name and the sheet number of the referenced cell.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3148896				0	he	CELL("FILENAME";D2) returns 'file:///X:/dr/own.sxc'#$Sheet1, if the formula in the current document X:\\dr\\own.sxc is located in Sheet1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155144				0	he	CELL("FILENAME";'X:\\dr\\test.sxc'#$Sheet1.D2) returns 'file:///X:/dr/test.sxc'#$Sheet1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151381				0	he	COORD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151004				0	he	Returns the complete cell address in Lotus(TM) notation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3159104				0	he	CELL("COORD"; D2) returns $A:$D$2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3163720				0	he	CELL("COORD"; Sheet3.D2) returns $C:$D$2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155910				0	he	CONTENTS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156041				0	he	Returns the contents of the referenced cell, without any formatting.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151069				0	he	TYPE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155344				0	he	Returns the type of cell contents.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3145217				0	he	b = blank. empty cell				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155176				0	he	l = label. Text, result of a formula as text				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3147280				0	he	v = value. Value, result of a formula as a number				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156348				0	he	WIDTH				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154920				0	he	Returns the width of the referenced column. The unit is the number of zeros (0) that fit into the column in the default text and the default size.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3152355				0	he	PREFIX				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154230				0	he	Returns the alignment of the referenced cell.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155946				0	he	' = align left or left-justified				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3147220				0	he	" = align right				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149038				0	he	^ = centered				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153129				0	he	\\ = repeating (currently inactive)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154406				0	he	PROTECT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3145127				0	he	Returns the status of the cell protection for the cell.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155794				0	he	1 = cell is protected				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155072				0	he	0 = cell is not protected				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156178				0	he	FORMAT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150220				0	he	Returns a character string that indicates the number format.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153824				0	he	, = number with thousands separator				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153837				0	he	F = number without thousands separator				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150318				0	he	C = currency format				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153168				0	he	S = exponential representation, for example, 1.234+E56				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153515				0	he	P = percentage				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154375				0	he	In the above formats, the number of decimal places after the decimal separator is given as a number. Example: the number format #,##0.0 returns ,1 and the number format 00.000% returns P3				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150575				0	he	D1 = MMM-D-YY, MM-D-YY and similar formats				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150589				0	he	D2 = DD-MM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3151034				0	he	D3 = MM-YY				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156371				0	he	D4 = DD-MM-YYYY HH:MM:SS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3157881				0	he	D5 = MM-DD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3157894				0	he	D6 = HH:MM:SS AM/PM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154068				0	he	D7 = HH:MM AM/PM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150286				0	he	D8 = HH:MM:SS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3145756				0	he	D9 = HH:MM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3145768				0	he	G = All other formats				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153375				0	he	- (Minus) at the end = negative numbers are formatted in color				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3155545				0	he	() (brackets) at the end = there is an opening bracket in the format code				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154594				0	he	COLOR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3152922				0	he	Returns 1, if negative values have been formatted in color, otherwise 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3145563				0	he	PARENTHESES				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156072				0	he	Returns 1 if the format code contains an opening bracket (, otherwise 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3156090				0	he	\<emph\>Reference\</emph\> (list of options) is the position of the cell to be examined. If \<emph\>Reference\</emph\> is a range, the cell moves to the top left of the range. If \<emph\>Reference\</emph\> is missing, $[officename] Calc uses the position of the cell in which this formula is located. Microsoft Excel uses the reference of the cell in which the cursor is positioned.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140200.xhp	0	help	tit				0	he	Right				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140200.xhp	0	help	hd_id3153896				0	he	\<link href=\"text/scalc/01/02140200.xhp\" name=\"Right\"\>Right\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140200.xhp	0	help	par_id3153361				0	he	\<ahelp hid=\".uno:FillRight\" visibility=\"visible\"\>Fills a selected range of at least two columns with the contents of the left most cell.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140200.xhp	0	help	par_id3154684				0	he	If a range of only one row is selected, the contents of the far left cell are copied to all the other selected cells. If you have selected several rows, each of the far left cells is copied into those cells to the right.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	tit				0	he	Spreadsheet Functions				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3148522				0	he	\<bookmark_value\>spreadsheets; functions\</bookmark_value\>\<bookmark_value\>Function Wizard; spreadsheets\</bookmark_value\>\<bookmark_value\>functions; spreadsheets\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3148522				0	he	Spreadsheet Functions				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3144508				0	he	\<variable id=\"tabelletext\"\>This section contains descriptions of the \<emph\>Spreadsheet\</emph\> functions together with an example.\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3146968				0	he	\<bookmark_value\>ADDRESS function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3146968				0	he	ADDRESS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155762				0	he	\<ahelp hid=\"HID_FUNC_ADRESSE\"\>Returns a cell address (reference) as text, according to the specified row and column numbers.\</ahelp\> You can determine whether the address is interpreted as an absolute address (for example, $A$1) or as a relative address (as A1) or in a mixed form (A$1 or $A1). You can also specify the name of the sheet.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301348				0	he	For interoperability the ADDRESS and INDIRECT functions support an optional parameter to specify whether the R1C1 address notation instead of the usual A1 notation should be used.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301445				0	he	In ADDRESS, the parameter is inserted as the fourth parameter, shifting the optional sheet name parameter to the fifth position.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id102720080230153				0	he	In INDIRECT, the parameter is appended as the second parameter.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id102720080230151				0	he	In both functions, if the argument is inserted with the value 0, then the R1C1 notation is used. If the argument is not given or has a value other than 0, then the A1 notation is used. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301556				0	he	In case of R1C1 notation, ADDRESS returns address strings using the exclamation mark '!' as the sheet name separator, and INDIRECT expects the exclamation mark as sheet name separator. Both functions still use the dot '.' sheet name separator with A1 notation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301521				0	he	When opening documents from ODF 1.0/1.1 format, the ADDRESS functions that show a sheet name as the fourth paramater will shift that sheet name to become the fifth parameter. A new fourth parameter with the value 1 will be inserted.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301650				0	he	When storing a document in ODF 1.0/1.1 format, if ADDRESS functions have a fourth parameter, that parameter will be removed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id102720080230162				0	he	Do not save a spreadsheet in the old ODF 1.0/1.1 format if the ADDRESS function's new fourth parameter was used with a value of 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802301756				0	he	The INDIRECT function is saved without conversion to ODF 1.0/1.1 format. If the second parameter was present, an older version of Calc will return an error for that function.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3151196				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154707				0	he	ADDRESS(row; column; abs;sheet)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147505	7			0	he	\<emph\>row\</emph\> represents the row number for the cell reference				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3145323	8			0	he	\<emph\>column\</emph\> represents the column number for the cell reference (the number, not the letter)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153074	9			0	he	\<emph\>abs\</emph\> determines the type of reference:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153298				0	he	1: absolute ($A$1)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150431				0	he	2: row reference type is absolute; column reference is relative (A$1)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3146096				0	he	3: row (relative); column (absolute) ($A1)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153334				0	he	4: relative (A1)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802465915				0	he	            \<emph\>A1\</emph\> (optional) - if set to 0, the R1C1 notation is used. If this parameter is absent or set to another value than 0, the A1 notation is used.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153962	14			0	he	\<emph\>sheet\</emph\> represents the name of the sheet. It must be placed in double quotes.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3147299				0	he	Example:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148744	16			0	he	ADDRESS(1; 1; 2; "Sheet2") returns the following: Sheet2.A$1				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3159260				0	he	If the cell A1 in sheet 2 contains the value -6, you can refer indirectly to the referenced cell using a function in B2 by entering =ABS(INDIRECT(B2)). The result is the absolute value of the cell reference specified in B2, which in this case is 6.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3150372				0	he	\<bookmark_value\>AREAS function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3150372				0	he	AREAS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150036				0	he	\<ahelp hid=\"HID_FUNC_BEREICHE\"\>Returns the number of individual ranges that belong to a multiple range.\</ahelp\> A range can consist of contiguous cells or a single cell.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id061020090307073				0	he	The function expects a single argument. If you state multiple ranges, you must enclose them into additional parentheses. Multiple ranges can be entered using the semicolon (;) as divider, but this gets automatically converted to the tilde (~) operator. The tilde is used to join ranges.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3145222				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155907				0	he	AREAS(Reference)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153118				0	he	Reference represents the reference to a cell or cell range.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3148891				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149946	25			0	he	=AREAS(A1:B3;F2;G1) returns 3, as it is a reference to three cells and/or areas.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3146820	26			0	he	=AREAS(All) returns 1 if you have defined an area named All under \<emph\>Data - Define Range\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3148727				0	he	\<bookmark_value\>DDE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3148727				0	he	DDE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149434				0	he	\<ahelp hid=\"HID_FUNC_DDE\"\>Returns the result of a DDE-based link.\</ahelp\> If the contents of the linked range or section changes, the returned value will also change. You must reload the spreadsheet or choose \<emph\>Edit - Links\</emph\> to see the updated links. Cross-platform links, for example from a \<item type=\"productname\"\>%PRODUCTNAME\</item\> installation running on a Windows machine to a document created on a Linux machine, are not allowed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3150700				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148886				0	he	DDE(server;file;range;mode)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154842	32			0	he	\<emph\>Server\</emph\> is the name of a server application. \<item type=\"productname\"\>%PRODUCTNAME\</item\> applications have the server name "Soffice".				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153034	33			0	he	\<emph\>File\</emph\> is the complete file name, including path specification.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147472	34			0	he	\<emph\>Range\</emph\> is the area containing the data to be evaluated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3152773	184			0	he	\<emph\>Mode\</emph\> is an optional parameter that controls the method by which the DDE server converts its data into numbers.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154383	185			0	he	\<emph\>Mode\</emph\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3145146	186			0	he	\<emph\>Effect\</emph\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154558				0	he	0 or missing				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3145596				0	he	Number format from the "Default" cell style				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3152785				0	he	1				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154380				0	he	Data are always interpreted in the standard format for US English				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150279				0	he	2				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153775				0	he	Data are retrieved as text; no conversion to numbers				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3149546				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148734	36			0	he	            \<item type=\"input\"\>‎=DDE("soffice";"c:\\office\\document\\data1.sxc";"sheet1.A1")‎\</item\> קורא את תוכן תא A1 ב-sheet1 בגיליון העבודה ‎\<item type=\"productname\"\>%PRODUCTNAME\</item\> Calc ‏בשם data1.sxc.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153081	37			0	he	\<item type=\"keycode\"\>=DDE("soffice";"c:\\office\\document\\motto.sxw";"Today's motto")\</item\> returns a motto in the cell containing this formula. First, you must enter a line in the motto.sxw document containing the motto text and define it as the first line of a section named \<item type=\"literal\"\>Today's Motto\</item\> (in \<item type=\"productname\"\>%PRODUCTNAME\</item\> Writer under \<emph\>Insert - Section\</emph\>). If the motto is modified (and saved) in the \<item type=\"productname\"\>%PRODUCTNAME\</item\> Writer document, the motto is updated in all \<item type=\"productname\"\>%PRODUCTNAME\</item\> Calc cells in which this DDE link is defined.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3153114				0	he	\<bookmark_value\>ERRORTYPE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153114				0	he	ERRORTYPE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148568				0	he	\<ahelp hid=\"HID_FUNC_FEHLERTYP\"\>Returns the number corresponding to an \<link href=\"text/scalc/05/02140000.xhp\" name=\"error value\"\>error value\</link\> occurring in a different cell.\</ahelp\> With the aid of this number, you can generate an error message text.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149877				0	he	The Status Bar displays the predefined error code from \<item type=\"productname\"\>%PRODUCTNAME\</item\> if you click the cell containing the error.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3154327				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3151322				0	he	ERRORTYPE(Reference)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150132	43			0	he	\<emph\>Reference\</emph\> contains the address of the cell in which the error occurs.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3145248				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3146904				0	he	If cell A1 displays Err:518, the function =ERRORTYPE(A1) returns the number 518.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3151221				0	he	\<bookmark_value\>INDEX function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3151221				0	he	INDEX				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150268				0	he	\<ahelp hid=\"HID_FUNC_INDEX\"\>INDEX returns a sub range, specified by row and column number, or an optional range index. Depending on context, INDEX returns a reference or content.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3156063				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149007				0	he	INDEX(reference;row;column;range)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153260	51			0	he	\<emph\>reference\</emph\> is a cell reference, entered either directly or by specifying a range name. If the reference consists of multiple ranges, you must enclose the reference or range name in parentheses.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3145302	52			0	he	\<emph\>row\</emph\> (optional) represents the row number of the reference range, for which to return a value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154628	53			0	he	\<emph\>column\</emph\> (optional) represents the column number of the reference range, for which to return a value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155514	54			0	he	\<emph\>range\</emph\> (optional) represents the index of the subrange if referring to a multiple range.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3145264				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3159112	56			0	he	=INDEX(Prices;4;1) returns the value from row 4 and column 1 of the database range defined in \<emph\>Data - Define\</emph\> as \<emph\>Prices\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150691	57			0	he	=INDEX(SumX;4;1) returns the value from the range \<emph\>SumX\</emph\> in row 4 and column 1 as defined in \<emph\>Insert - Names - Define\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id4109012				0	he	            \<item type=\"input\"\>=INDEX(A1:B6;1)\</item\> returns a reference to the first row of A1:B6.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id9272133				0	he	            \<item type=\"input\"\>=INDEX(A1:B6;0;1)\</item\> returns a reference to the first column of A1:B6.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3158419	58			0	he	=INDEX((multi);4;1) indicates the value contained in row 4 and column 1 of the (multiple) range, which you named under \<emph\>Insert - Names - Set\</emph\> as \<emph\>multi\</emph\>. The multiple range may consist of several rectangular ranges, each with a row 4 and column 1. If you now want to call the second block of this multiple range enter the number 2 as the \<emph\>range\</emph\> parameter.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148595	59			0	he	=INDEX(A1:B6;1;1) indicates the value in the upper-left of the A1:B6 range.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id9960020				0	he	            \<item type=\"input\"\>=INDEX((multi);0;0;2)\</item\> returns a reference to the second range of the multiple range.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3153181				0	he	\<bookmark_value\>INDIRECT function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153181				0	he	INDIRECT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147169				0	he	\<ahelp hid=\"HID_FUNC_INDIREKT\"\>Returns the \<emph\>reference\</emph\> specified by a text string.\</ahelp\> This function can also be used to return the area of a corresponding string.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153717				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149824				0	he	INDIRECT(ref)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154317	66			0	he	\<emph\>ref\</emph\> represents a reference to a cell or an area (in text form) for which to return the contents.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1027200802470312				0	he	            \<emph\>A1\</emph\> (optional) - if set to 0, the R1C1 notation is used. If this parameter is absent or set to another value than 0, the A1 notation is used.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN10CAE				0	he	If you open an Excel spreadsheet that uses indirect addresses calculated from string functions, the sheet addresses will not be translated automatically. For example, the Excel address in INDIRECT("filename!sheetname"&B1) is not converted into the Calc address in INDIRECT("filename.sheetname"&B1).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3150389				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150608	68			0	he	=INDIRECT(A1) equals 100 if A1 contains C108 as a reference and cell C108 contains a value of 100.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3083286	181			0	he	=SUM(INDIRECT("a1:" & ADDRESS(1;3))) totals the cells in the area of A1 up to the cell, whose address is defined by row 1 and column 3. Therefore, area A1:C1 is totaled.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3154818				0	he	\<bookmark_value\>COLUMN function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3154818				0	he	COLUMN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149711				0	he	\<ahelp hid=\"HID_FUNC_SPALTE\"\>Returns the column number of a cell reference.\</ahelp\> If the reference is a cell the column number of the cell is returned; if the parameter is a cell area, the corresponding column numbers are returned in a single-row \<link href=\"text/scalc/01/04060107.xhp#wasmatrix\" name=\"array\"\>array\</link\> if the formula is entered \<link href=\"text/scalc/01/04060107.xhp#somatrixformel\" name=\"as an array formula\"\>as an array formula\</link\>. If the COLUMN function with an area reference parameter is not used for an array formula, only the column number of the first cell within the area is determined.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3149283				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149447				0	he	COLUMN(reference)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3156310	74			0	he	\<emph\>Reference\</emph\> is the reference to a cell or cell area whose first column number is to be found.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155837				0	he	If no reference is entered, the column number of the cell in which the formula is entered is found. \<item type=\"productname\"\>%PRODUCTNAME\</item\> Calc automatically sets the reference to the current cell.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3152932				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147571	76			0	he	=COLUMN(A1) equals 1. Column A is the first column in the table.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147079	77			0	he	=COLUMN(C3:E3) equals 3. Column C is the third column in the table.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3146861	195			0	he	=COLUMN(D3:G10) returns 4 because column D is the fourth column in the table and the COLUMN function is not used as an array formula. (In this case, the first value of the array is always used as the result.)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3156320	196			0	he	{=COLUMN(B2:B7)} and =COLUMN(B2:B7) both return 2 because the reference only contains column B as the second column in the table. Because single-column areas have only one column number, it does not make a difference whether or not the formula is used as an array formula.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150872	197			0	he	=COLUMN() returns 3 if the formula was entered in column C.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153277	198			0	he	{=COLUMN(Rabbit)} returns the single-row array (3, 4) if "Rabbit" is the named area (C1:D3).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3154643				0	he	\<bookmark_value\>COLUMNS function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3154643				0	he	COLUMNS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3151182				0	he	\<ahelp hid=\"HID_FUNC_SPALTEN\"\>Returns the number of columns in the given reference.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3149141				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154047				0	he	COLUMNS(array)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154745	83			0	he	\<emph\>array\</emph\> is the reference to a cell range whose total number of columns is to be found. The argument can also be a single cell.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153622				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149577	200			0	he	=COLUMNS(B5) returns 1 because a cell only contains one column.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3145649	85			0	he	=COLUMNS(A1:C5) equals 3. The reference comprises three columns.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155846	201			0	he	=COLUMNS(Rabbit) returns 2 if "Rabbit" is the named range (C1:D3).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3153152				0	he	\<bookmark_value\>vertical search function\</bookmark_value\>\<bookmark_value\>VLOOKUP function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153152				0	he	VLOOKUP				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149984				0	he	\<ahelp hid=\"HID_FUNC_SVERWEIS\"\>Vertical search with reference to adjacent cells to the right.\</ahelp\> This function checks if a specific value is contained in the first column of an array. The function then returns the value in the same row of the column named by \<item type=\"literal\"\>Index\</item\>. If the \<item type=\"literal\"\>SortOrder\</item\> parameter is omitted or set to TRUE or one, it is assumed that the data is sorted in ascending order. In this case, if the exact \<item type=\"literal\"\>SearchCriterion\</item\> is not found, the last value that is smaller than the criterion will be returned. If \<item type=\"literal\"\>SortOrder\</item\> is set to FALSE or zero, an exact match must be found, otherwise the error \<emph\>Error: Value Not Available\</emph\> will be the result. Thus with a value of zero the data does not need to be sorted in ascending order.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3146898				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150156				0	he	=VLOOKUP(Search criterion;array;index;Sort order)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149289	91			0	he	\<emph\>Search criterion\</emph\> is the value searched for in the first column of the array.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153884	92			0	he	\<emph\>array\</emph\> is the reference, which is to comprise at least two columns.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3156005	93			0	he	\<emph\>index\</emph\> is the number of the column in the array that contains the value to be returned. The first column has the number 1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3151208	94			0	he	\<emph\>Sort order\</emph\> is an optional parameter that indicates whether the first column in the array is sorted in ascending order. Enter the Boolean value FALSE if the first column is not sorted in ascending order. Sorted columns can be searched much faster and the function always returns a value, even if the search value was not matched exactly, if it is between the lowest and highest value of the sorted list. In unsorted lists, the search value must be matched exactly. Otherwise the function will return this message: \<emph\>Error: Value Not Available\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3147487				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154129				0	he	You want to enter the number of a dish on the menu in cell A1, and the name of the dish is to appear as text in the neighboring cell (B1) immediately. The Number to Name assignment is contained in the D1:E100 array. D1 contains 100, E1 contains the name \<emph\>Vegetable Soup\</emph\>, and so forth, for 100 menu items. The numbers in column D are sorted in ascending order; thus, the optional \<emph\>Sort order\</emph\> parameter is not necessary.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3145663				0	he	Enter the following formula in B1:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3151172	98			0	he	=VLOOKUP(A1; D1:E100; 2)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149200				0	he	As soon as you enter a number in A1 B1 will show the corresponding text contained in the second column of reference D1:E100. Entering a nonexistent number displays the text with the next number down. To prevent this, enter FALSE as the last parameter in the formula so that an error message is generated when a nonexistent number is entered.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3153905				0	he	\<bookmark_value\>sheet numbers; looking up\</bookmark_value\>\<bookmark_value\>SHEET function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153905				0	he	SHEET				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150309				0	he	\<ahelp hid=\"HID_FUNC_TABELLE\"\>Returns the sheet number of a reference or a string representing a sheet name.\</ahelp\> If you do not enter any parameters, the result is the sheet number of the spreadsheet containing the formula.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3148564				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153095				0	he	SHEET(Reference)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154588	219			0	he	\<emph\>Reference\</emph\> is optional and is the reference to a cell, an area, or a sheet name string.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3155399				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3146988	221			0	he	=SHEET(Sheet2.A1) returns 2 if Sheet2 is the second sheet in the spreadsheet document.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3148829				0	he	\<bookmark_value\>number of sheets; function\</bookmark_value\>\<bookmark_value\>SHEETS function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3148829				0	he	SHEETS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148820				0	he	\<ahelp hid=\"HID_FUNC_TABELLEN\"\>Determines the number of sheets in a reference.\</ahelp\> If you do not enter any parameters, it returns the number of sheets in the current document.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3154220				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150777				0	he	SHEETS(Reference)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153060	226			0	he	\<emph\>Reference\</emph\> is the reference to a sheet or an area. This parameter is optional.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3149766				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150507	228			0	he	=SHEETS(Sheet1.A1:Sheet3.G12) returns 3 if Sheet1, Sheet2, and Sheet3 exist in the sequence indicated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3158407				0	he	\<bookmark_value\>MATCH function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3158407				0	he	MATCH				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154896				0	he	\<ahelp hid=\"HID_FUNC_VERGLEICH\"\>Returns the relative position of an item in an array that matches a specified value.\</ahelp\> The function returns the position of the value found in the lookup_array as a number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153834				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3159152				0	he	MATCH(search criterion;lookup_array;type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149336	105			0	he	\<emph\>Search Criterion\</emph\> is the value which is to be searched for in the single-row or single-column array.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3159167	106			0	he	\<emph\>lookup_array\</emph\> is the reference searched. A lookup array can be a single row or column, or part of a single row or column.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147239	107			0	he	\<emph\>Type\</emph\> may take the values 1, 0, or -1. If Type = 1 or if this optional parameter is missing, it is assumed that the first column of the search array is sorted in ascending order. If Type = -1 it is assumed that the column in sorted in descending order. This corresponds to the same function in Microsoft Excel.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154265				0	he	If Type = 0, only exact matches are found. If the search criterion is found more than once, the function returns the first one found. Only if Type = 0 can you search for regular expressions.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147528				0	he	If Type = 1 or the third parameter is missing, the last value that is smaller or equal to the search criterion is returned. This applies even when the search array is not sorted. For Type = -1, the first value that is larger or equal is returned.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3155119				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155343	109			0	he	=MATCH(200; D1:D100) searches the area D1:D100, which is sorted by column D, for the value 200. As soon as this value is reached, the number of the row in which it was found is returned. If a higher value is found during the search in the column, the number of the previous row is returned.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3158430				0	he	\<bookmark_value\>OFFSET function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3158430				0	he	OFFSET				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149167				0	he	\<ahelp hid=\"HID_FUNC_VERSCHIEBUNG\"\>Returns the value of a cell offset by a certain number of rows and columns from a given reference point.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3146952				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3159194				0	he	OFFSET(reference;rows;columns;height;width)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3152360	115			0	he	\<emph\>Reference\</emph\> is the cell from which the function searches for the new reference.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3156032	116			0	he	\<emph\>Rows\</emph\> is the number of cells by which the reference was corrected up (negative value) or down.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3166458	117			0	he	\<emph\>Columns\</emph\> is the number of columns by which the reference was corrected to the left (negative value) or to the right.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150708	118			0	he	\<emph\>Height\</emph\> is the optional vertical height for an area that starts at the new reference position.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147278	119			0	he	\<emph\>Width\</emph\> is the optional horizontal width for an area that starts at the new reference position.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id8662373				0	he	Arguments \<emph\>Rows\</emph\> and \<emph\>Columns\</emph\> must not lead to zero or negative start row or column.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id9051484				0	he	Arguments \<emph\>Height\</emph\> and \<emph\>Width\</emph\> must not lead to zero or negative count of rows or columns.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN1104B				0	he	            \<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>         				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3155586				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149744	121			0	he	=OFFSET(A1; 2; 2) returns the value in cell C3 (A1 moved by two rows and two columns down). If C3 contains the value 100 this function returns the value 100.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id7439802				0	he	            \<item type=\"input\"\>=OFFSET(B2:C3;1;1)\</item\> returns a reference to B2:C3 moved down by 1 row and one column to the right (C3:D4).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3009430				0	he	            \<item type=\"input\"\>=OFFSET(B2:C3;-1;-1)\</item\> returns a reference to B2:C3 moved up by 1 row and one column to the left (A1:B2).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id2629169				0	he	            \<item type=\"input\"\>=OFFSET(B2:C3;0;0;3;4)\</item\> returns a reference to B2:C3 resized to 3 rows and 4 columns (B2:E4).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id6668599				0	he	            \<item type=\"input\"\>=OFFSET(B2:C3;1;0;3;4)\</item\> returns a reference to B2:C3 moved down by one row resized to 3 rows and 4 columns (B2:E4).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153739	122			0	he	=SUM(OFFSET(A1; 2; 2; 5; 6)) determines the total of the area that starts in cell C3 and has a height of 5 rows and a width of 6 columns (area=C3:H7).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3159273				0	he	\<bookmark_value\>LOOKUP function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3159273				0	he	LOOKUP				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153389				0	he	\<ahelp hid=\"HID_FUNC_VERWEIS\"\>Returns the contents of a cell either from a one-row or one-column range.\</ahelp\> Optionally, the assigned value (of the same index) is returned in a different column and row. As opposed to \<link href=\"text/scalc/01/04060109.xhp\" name=\"VLOOKUP\"\>VLOOKUP\</link\> and \<link href=\"text/scalc/01/04060109.xhp\" name=\"HLOOKUP\"\>HLOOKUP\</link\>, search and result vector may be at different positions; they do not have to be adjacent. Additionally, the search vector for the LOOKUP must be sorted ascending, otherwise the search will not return any usable results.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id4484084				0	he	If LOOKUP cannot find the search criterion, it matches the largest value in the search vector that is less than or equal to the search criterion.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3152947				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154104				0	he	LOOKUP(Search criterion;Search vector;result_vector)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150646	127			0	he	\<emph\>Search criterion\</emph\> is the value to be searched for; entered either directly or as a reference.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154854	128			0	he	\<emph\>Search vector\</emph\> is the single-row or single-column area to be searched.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149925	129			0	he	\<emph\>result_vector\</emph\> is another single-row or single-column range from which the result of the function is taken. The result is the cell of the result vector with the same index as the instance found in the search vector.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3148624				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149809	131			0	he	=LOOKUP(A1; D1:D100;F1:F100) searches the corresponding cell in range D1:D100 for the number you entered in A1. For the instance found, the index is determined, for example, the 12th cell in this range. Then, the contents of the 12th cell are returned as the value of the function (in the result vector).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3149425				0	he	\<bookmark_value\>STYLE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3149425				0	he	STYLE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150826				0	he	\<ahelp hid=\"HID_FUNC_VORLAGE\"\>Applies a style to the cell containing the formula.\</ahelp\> After a set amount of time, another style can be applied. This function always returns the value 0, allowing you to add it to another function without changing the value. Together with the CURRENT function you can apply a color to a cell regardless of the value. For example: =...+STYLE(IF(CURRENT()>3;"red";"green")) applies the style "red" to the cell if the value is greater than 3, otherwise the style "green" is applied. Both cell formats have to be defined beforehand.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3145373				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149302				0	he	STYLE(style;time;style2)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150596	137			0	he	\<emph\>Style\</emph\> is the name of a cell style assigned to the cell. Style names must be entered in quotation marks.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3156149	138			0	he	\<emph\>Time\</emph\> is an optional time range in seconds. If this parameter is missing the style will not be changed after a certain amount of time has passed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149520	139			0	he	\<emph\>Style2\</emph\> is the optional name of a cell style assigned to the cell after a certain amount of time has passed. If this parameter is missing "Standard" is assumed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN111CA				0	he	            \<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>         				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3159254				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3151374	141			0	he	=STYLE("Invisible";60;"Default") formats the cell in transparent format for 60 seconds after the document was recalculated or loaded, then the Default format is assigned. Both cell formats have to be defined beforehand.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id8056886				0	he	Since STYLE() has a numeric return value of zero, this return value gets appended to a string. This can be avoided using T() as in the following example 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3668935				0	he	            \<item type=\"input\"\>="Text"&T(STYLE("myStyle"))\</item\>         				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3042085				0	he	See also CURRENT() for another example.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3150430				0	he	\<bookmark_value\>CHOOSE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3150430				0	he	CHOOSE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3143270				0	he	\<ahelp hid=\"HID_FUNC_WAHL\"\>Uses an index to return a value from a list of up to 30 values.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153533				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155425				0	he	CHOOSE(Index; value1;...value30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3144755	146			0	he	\<emph\>Index\</emph\> is a reference or number between 1 and 30 indicating which value is to be taken from the list.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149939	147			0	he	\<emph\>Value1...Value30\</emph\> is the list of values entered as a reference to a cell or as individual values.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3151253				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150625	149			0	he	=CHOOSE(A1; B1; B2; B3; "Today"; "Yesterday"; "Tomorrow"), for example, returns the contents of cell B2 for A1 = 2; for A1 = 4, the function returns the text "Today".				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3151001				0	he	\<bookmark_value\>HLOOKUP function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3151001				0	he	HLOOKUP				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148688				0	he	\<ahelp hid=\"HID_FUNC_WVERWEIS\"\>Searches for a value and reference to the cells below the selected area.\</ahelp\> This function verifies if the first row of an array contains a certain value. The function returns then the value in a row of the array, named in the \<emph\>Index\</emph\>, in the same column.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3154661				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3146070				0	he	=HLOOKUP(search_criteria;array;Index;sorted)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148672				0	he	See also:\<link href=\"text/scalc/01/04060109.xhp\" name=\"VLOOKUP\"\>VLOOKUP\</link\> (columns and rows are exchanged)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3147321				0	he	\<bookmark_value\>ROW function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3147321				0	he	ROW				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154564				0	he	\<ahelp hid=\"HID_FUNC_ZEILE\"\>Returns the row number of a cell reference.\</ahelp\> If the reference is a cell, it returns the row number of the cell. If the reference is a cell range, it returns the corresponding row numbers in a one-column \<link href=\"text/scalc/01/04060107.xhp#wasmatrix\" name=\"Array\"\>Array\</link\> if the formula is entered \<link href=\"text/scalc/01/04060107.xhp#somatrixformel\" name=\"as an array formula\"\>as an array formula\</link\>. If the ROW function with a range reference is not used in an array formula, only the row number of the first range cell will be returned.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3158439				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154916				0	he	ROW(reference)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3156336	161			0	he	\<emph\>Reference\</emph\> is a cell, an area, or the name of an area.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3151109				0	he	If you do not indicate a reference, the row number of the cell in which the formula is entered will be found. \<item type=\"productname\"\>%PRODUCTNAME\</item\> Calc automatically sets the reference to the current cell.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3155609				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154830	205			0	he	=ROW(B3) returns 3 because the reference refers to the third row in the table.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147094	206			0	he	{=ROW(D5:D8)} returns the single-column array (5, 6, 7, 8) because the reference specified contains rows 5 through 8.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153701	207			0	he	=ROW(D5:D8) returns 5 because the ROW function is not used as array formula and only the number of the first row of the reference is returned.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150996	208			0	he	{=ROW(A1:E1)} and =ROW(A1:E1) both return 1 because the reference only contains row 1 as the first column in the table. (Because single-row areas only have one row number it does not make any difference whether or not the formula is used as an array formula.)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153671	209			0	he	=ROW() returns 3 if the formula was entered in row 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153790	210			0	he	{=ROW(Rabbit)} returns the single-column array (1, 2, 3) if "Rabbit" is the named area (C1:D3).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3145772				0	he	\<bookmark_value\>ROWS function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3145772				0	he	ROWS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148971				0	he	\<ahelp hid=\"HID_FUNC_ZEILEN\"\>Returns the number of rows in a reference or array.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3156051				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154357				0	he	ROWS(array)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155942	170			0	he	\<emph\>array\</emph\> is the reference or named area whose total number of rows is to be determined.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3155869				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154725	212			0	he	=Rows(B5) returns 1 because a cell only contains one row.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150102	172			0	he	=ROWS(A10:B12) returns 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155143	213			0	he	=ROWS(Rabbit) returns 3 if "Rabbit" is the named area (C1:D3).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id9959410				0	he	\<bookmark_value\>HYPERLINK function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11798				0	he	HYPERLINK				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN117F1				0	he	\<ahelp hid=\"HID_FUNC_HYPERLINK\"\>When you click a cell that contains the HYPERLINK function, the hyperlink opens.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11800				0	he	If you use the optional \<emph\>cell text\</emph\> parameter, the formula locates the URL, and then displays the text.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11803				0	he	To open a hyperlinked cell with the keyboard, select the cell, press F2 to enter the Edit mode, move the cursor in front of the hyperlink, press Shift+F10, and then choose \<emph\>Open Hyperlink\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN1180A				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN1180E				0	he	HYPERLINK (URL) or HYPERLINK (URL;cell text)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11811				0	he	\<emph\>URL\</emph\> specifies the link target. The optional \<emph\>cell text\</emph\> parameter is the text that is displayed in the cell and the result of the function. If the \<emph\>cell text\</emph\> parameter is not specified, the \<emph\>URL\</emph\> is displayed in the cell text and in the result of the function.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id0907200912224576				0	he	The number 0 is returned for empty cells and matrix elements.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11823				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11827				0	he	=HYPERLINK("http://www.example.org") displays the text "http://www.example.org" in the cell and executes the hyperlink http://www.example.org when clicked.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN1182A				0	he	=HYPERLINK("http://www.example.org";"Click here") displays the text "Click here" in the cell and executes the hyperlink http://www.example.org when clicked.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id0907200912224534				0	he	=HYPERLINK("http://www.example.org";12345) displays the number 12345 and executes the hyperlink http://www.example.org when clicked.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN1182D				0	he	=HYPERLINK($B4) where cell B4 contains "http://www.example.org". The function adds "http://www.example.org" to the URL of the hyperlink cell and returns the same text which is used as formula result.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_idN11830				0	he	=HYPERLINK("http://www.";"Click ") & "example.org" displays the text "Click example.org" in the cell and executes the hyperlink http://www.example.org when clicked.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id8859523				0	he	            \<item type=\"input\"\>=HYPERLINK("#Sheet1.A1";"Go to top")\</item\> displays the text Go to top and jumps to cell Sheet1.A1 in this document.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id2958769				0	he	            \<item type=\"input\"\>=HYPERLINK("file:///C:/writer.odt#Specification";"Go to Writer bookmark")\</item\>displays the text Go to Writer bookmark, loads the specified text document and jumps to bookmark "Specification".				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id7682424				0	he	\<bookmark_value\>GETPIVOTDATA function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3747062				0	he	GETPIVOTDATA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3593859				0	he	\<ahelp hid=\".\"\>The GETPIVOTDATA function returns a result value from a pivot table. The value is addressed using field and item names, so it remains valid if the layout of the pivot table changes.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id9741508				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id909451				0	he	Two different syntax definitions can be used:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1665089				0	he	GETPIVOTDATA(TargetField; pivot table; [ Field 1; Item 1; ... ])				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id4997100				0	he	GETPIVOTDATA(pivot table; Constraints)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id1672109				0	he	The second syntax is assumed if exactly two parameters are given, of which the first parameter is a cell or cell range reference. The first syntax is assumed in all other cases. The Function Wizard shows the first syntax.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id9464094				0	he	First Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id9302346				0	he	            \<emph\>TargetField\</emph\> is a string that selects one of the pivot table's data fields. The string can be the name of the source column, or the data field name as shown in the table (like "Sum - Sales").				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id8296151				0	he	            \<emph\>pivot table\</emph\> is a reference to a cell or cell range that is positioned within a pivot table or contains a pivot table. If the cell range contains several pivot tables, the table that was created last is used.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id4809411				0	he	If no \<emph\>Field n / Item n\</emph\> pairs are given, the grand total is returned. Otherwise, each pair adds a constraint that the result must satisfy. \<emph\>Field n\</emph\> is the name of a field from the pivot table. \<emph\>Item n\</emph\> is the name of an item from that field.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id6454969				0	he	If the pivot table contains only a single result value that fulfills all of the constraints, or a subtotal result that summarizes all matching values, that result is returned. If there is no matching result, or several ones without a subtotal for them, an error is returned. These conditions apply to results that are included in the pivot table.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id79042				0	he	If the source data contains entries that are hidden by settings of the pivot table, they are ignored. The order of the Field/Item pairs is not significant. Field and item names are not case-sensitive.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id7928708				0	he	If no constraint for a page field is given, the field's selected value is implicitly used. If a constraint for a page field is given, it must match the field's selected value, or an error is returned. Page fields are the fields at the top left of a pivot table, populated using the "Page Fields" area of the pivot table layout dialog. From each page field, an item (value) can be selected, which means only that item is included in the calculation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3864253				0	he	Subtotal values from the pivot table are only used if they use the function "auto" (except when specified in the constraint, see \<item type=\"literal\"\>Second Syntax\</item\> below).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3144016				0	he	Second Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id9937131				0	he	            \<emph\>pivot table\</emph\> has the same meaning as in the first syntax.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id5616626				0	he	            \<emph\>Constraints\</emph\> is a space-separated list. Entries can be quoted (single quotes). The whole string must be enclosed in quotes (double quotes), unless you reference the string from another cell.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id4076357				0	he	One of the entries can be the data field name. The data field name can be left out if the pivot table contains only one data field, otherwise it must be present.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id8231757				0	he	Each of the other entries specifies a constraint in the form \<item type=\"literal\"\>Field[Item]\</item\> (with literal characters [ and ]), or only \<item type=\"literal\"\>Item\</item\> if the item name is unique within all fields that are used in the pivot table.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3168736				0	he	A function name can be added in the form \<emph\>Field[Item;Function]\</emph\>, which will cause the constraint to match only subtotal values which use that function. The possible function names are Sum, Count, Average, Max, Min, Product, Count (Numbers only), StDev (Sample), StDevP (Population), Var (Sample), and VarP (Population), case-insensitive.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	tit				0	he	DAY 				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	bm_id3147317				0	he	\<bookmark_value\>DAY function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	hd_id3147317				0	he	\<variable id=\"day\"\>\<link href=\"text/scalc/01/func_day.xhp\"\>DAY\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3147584				0	he	\<ahelp hid=\"HID_FUNC_TAG\"\>Returns the day of given date value.\</ahelp\> The day is returned as an integer between 1 and 31. You can also enter a negative date/time value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	hd_id3150487				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3149430				0	he	DAY(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3149443				0	he	\<emph\>Number\</emph\>, as a time value, is a decimal, for which the day is to be returned.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	hd_id3163809	111			0	he	Examples 				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3151200				0	he	DAY(1) returns 31 (since $[officename] starts counting at zero from December 30, 1899)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3154130				0	he	DAY(NOW()) returns the current day.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3159190				0	he	DAY(C4) returns 5 if the contents of C4 = 8/5/1901.				20200411 15:09:53
