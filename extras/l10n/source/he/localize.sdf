helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3154124				0	he	Dim sUS_date As String				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3159252				0	he	sInput = InputBox("Please input a date in the international format 'YYYY-MM-DD'")				20200411 15:09:53
