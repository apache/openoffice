helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3147100				0	he	\<ahelp hid=\"HID_AAI_FUNC_COUPDAYSNC\"\>Returns the number of days from the settlement date until the next interest date.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3151312				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155121				0	he	COUPDAYSNC (Settlement;Maturity;Frequency;Basis)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3158440				0	he	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3146075				0	he	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154620	159			0	he	Frequency: number of interest payments per year (1, 2 or 4).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3155604				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148671				0	he	A security is purchased on 1.25.2001; the date of maturity is 11.15.2001. Interest is paid half-yearly (frequency is 2). Using daily balance interest calculation (basis 3) how many days are there until the next interest payment?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3156158				0	he	=COUPDAYSNC("1.25.2001"; "11.15.2001"; 2; 3) returns 110.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3150408				0	he	\<bookmark_value\>COUPDAYBS function\</bookmark_value\>\<bookmark_value\>durations;first interest payment until settlement date\</bookmark_value\>\<bookmark_value\>securities;first interest payment until settlement date\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3150408				0	he	COUPDAYBS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3146795				0	he	\<ahelp hid=\"HID_AAI_FUNC_COUPDAYBS\"\>Returns the number of days from the first day of interest payment on a security until the settlement date.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3156142				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3159083				0	he	COUPDAYBS (Settlement;Maturity;Frequency;Basis)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3146907				0	he	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3159390				0	he	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154414				0	he	\<emph\>Frequency\</emph\> is the number of interest payments per year (1, 2 or 4).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3153880				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150592				0	he	A security is purchased on 1.25.2001; the date of maturity is 11.15.2001. Interest is paid half-yearly (frequency is 2). Using daily balance interest calculation (basis 3) how many days is this?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3151103				0	he	=COUPDAYBS("1.25.2001"; "11.15.2001"; 2; 3) returns 71.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3152957				0	he	\<bookmark_value\>COUPPCD function\</bookmark_value\>\<bookmark_value\>dates;interest date prior to settlement date\</bookmark_value\>				20200411 15:09:53
