helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3156385				0	he	Zero Values				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3149258				0	he	\<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_TABLE:BTN_NULLVALS\"\>Specifies that cells with a zero value are printed.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3154022				0	he	Page Order				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3166423				0	he	Defines the order in which data in a sheet is numbered and printed when it does not fit on one printed page.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3152580				0	he	Top to bottom, then right				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3150205				0	he	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCPAGE_TABLE:BTN_TOPDOWN\"\>Prints vertically from the left column to the bottom of the sheet.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	hd_id3150786				0	he	Left to right, then down				20200411 15:09:53
helpcontent2	source\text\scalc\01\05070500.xhp	0	help	par_id3154657				0	he	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCPAGE_TABLE:BTN_LEFTRIGHT\"\>Prints horizontally from the top row of the sheet to the right column.\</ahelp\>				20200411 15:09:53
