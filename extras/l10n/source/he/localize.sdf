helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3146984				0	he	sUS_date = sUS_date & "/"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3155308				0	he	sUS_date = sUS_date & Right(sInput, 2)				20200411 15:09:53
