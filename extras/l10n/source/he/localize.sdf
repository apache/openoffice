helpcontent2	source\text\swriter\01\05030200.xhp	0	help	par_id3149040				0	he	\<ahelp hid=\"SVX:TRISTATEBOX:RID_SVXPAGE_EXT_PARAGRAPH:BTN_KEEPTOGETHER\"\>Shifts the entire paragraph to the next page or column after a break is inserted.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05030200.xhp	0	help	hd_id3147585				0	he	Keep with next paragraph				20200411 15:09:53
helpcontent2	source\text\swriter\01\05030200.xhp	0	help	par_id3152779				0	he	\<ahelp hid=\"SVX:TRISTATEBOX:RID_SVXPAGE_EXT_PARAGRAPH:CB_KEEPTOGETHER\"\>Keeps the current paragraph and the following paragraph together when a break or column break is inserted.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05030200.xhp	0	help	hd_id3153345				0	he	Orphan control				20200411 15:09:53
helpcontent2	source\text\swriter\01\05030200.xhp	0	help	par_id3156279	34			0	he	\<ahelp hid=\"SVX:NUMERICFIELD:RID_SVXPAGE_EXT_PARAGRAPH:ED_ORPHANS\"\>Specifies the minimum number of lines in a paragraph before a page break. Select this check box, and then enter a number in the \<emph\>Lines \</emph\>box.\</ahelp\> If the number of lines at the end of the page is less than the amount specified in the \<emph\>Lines \</emph\>box, the paragraph is shifted to the next page.				20200411 15:09:53
helpcontent2	source\text\swriter\01\05030200.xhp	0	help	hd_id3149180				0	he	Widow control				20200411 15:09:53
helpcontent2	source\text\swriter\01\05030200.xhp	0	help	par_id3155918	36			0	he	\<ahelp hid=\"SVX:NUMERICFIELD:RID_SVXPAGE_EXT_PARAGRAPH:ED_WIDOWS\"\>Specifies the minimum number of lines in a paragraph in the first page after the break. Select this check box, and then enter a number in the \<emph\>Lines \</emph\>box.\</ahelp\> If the number of lines at the top of the page is less than the amount specified in the \<emph\>Lines \</emph\>box, the position of the break is adjusted.				20200411 15:09:53
