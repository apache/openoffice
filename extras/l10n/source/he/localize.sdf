helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id09022809540918				0	he	\<link href=\"https://wiki.openoffice.org/wiki/Documentation/How_Tos/Calc:_CONVERT_ADD_function\"\>Current list of CONVERT_ADD units in the OpenOffice.org Wiki.\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3156270				0	he	Examples				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3156336	215			0	he	=CONVERT_ADD(10;"HP";"PS") returns, rounded to two decimal places, 10.14. 10 HP equal 10.14 PS.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3154834	216			0	he	=CONVERT_ADD(10;"km";"mi")returns, rounded to two decimal places, 6.21. 10 Kilometers equal 6.21 miles. The k is the permitted prefix character for the factor 10^3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	bm_id3147096				0	he	\<bookmark_value\>FACTDOUBLE function\</bookmark_value\>\<bookmark_value\>factorials;numbers with increments of two\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3147096				0	he	FACTDOUBLE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3151309				0	he	\<ahelp hid=\"HID_AAI_FUNC_FACTDOUBLE\"\>Returns the double factorial of a number.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3154666				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3155121				0	he	FACTDOUBLE(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3158440	40			0	he	Number: if the number is even, the following factorial is calculated: n*(N-2)*(n-4)*...*4*2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id2480849				0	he	For even numbers FACTDOUBLE(n) returns:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id4181951				0	he	2*4*6*8* ... *n				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id2927335				0	he	For odd numbers FACTDOUBLE(n) returns:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id2107303				0	he	1*3*5*7* ... *n				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id4071779				0	he	FACTDOUBLE(0) returns 1 by definition.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3154622				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id7844477				0	he	            \<item type=\"input\"\>=FACTDOUBLE(5)\</item\> returns 15.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3154116	43			0	he	=FACTDOUBLE(6) returns 48.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id6478469				0	he	            \<item type=\"input\"\>=FACTDOUBLE(0)\</item\> returns 1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05040200.xhp	0	help	tit				0	he	Optimal Column Width				20200411 15:09:53
helpcontent2	source\text\scalc\01\05040200.xhp	0	help	bm_id3155628				0	he	\<bookmark_value\>spreadsheets; optimal column widths\</bookmark_value\>\<bookmark_value\>columns; optimal widths\</bookmark_value\>\<bookmark_value\>optimal column widths\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05040200.xhp	0	help	hd_id3155628				0	he	Optimal Column Width				20200411 15:09:53
helpcontent2	source\text\scalc\01\05040200.xhp	0	help	par_id3145068				0	he	\<variable id=\"optitext\"\>\<ahelp hid=\".uno:SetOptimalColumnWidthDi\"\>Defines the optimal column width for selected columns.\</ahelp\>\</variable\> The optimal column width depends on the longest entry within a column. You can choose from the available \<link href=\"text/shared/00/00000003.xhp#metrik\" name=\"measurement units\"\>measurement units\</link\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05040200.xhp	0	help	hd_id3150767				0	he	Add				20200411 15:09:53
helpcontent2	source\text\scalc\01\05040200.xhp	0	help	par_id3150449				0	he	\<ahelp hid=\"SC:METRICFIELD:RID_SCDLG_COL_OPT:ED_VALUE\"\>Defines additional spacing between the longest entry in a column and the vertical column borders.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05040200.xhp	0	help	hd_id3145785				0	he	Default value				20200411 15:09:53
helpcontent2	source\text\scalc\01\05040200.xhp	0	help	par_id3146120				0	he	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_COL_OPT:BTN_DEFVAL\"\>Defines the optimal column width in order to display the entire contents of the column.\</ahelp\> The additional spacing for the optimal column width is preset to 0.1 in.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	tit				0	he	Conditional Formatting				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	hd_id3155132				0	he	Conditional Formatting				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3163710				0	he	\<variable id=\"bedingtetext\"\>\<ahelp hid=\".uno:ConditionalFormatDialog\"\>Choose \<emph\>Conditional Formatting\</emph\> to define format styles depending on certain conditions.\</ahelp\>\</variable\> If a style was already assigned to a cell, it remains unchanged. The style entered here is then evaluated. You can enter three conditions that query the contents of cell values or formulas. The conditions are evaluated from 1 to 3. If the condition 1 matches the condition, the defined style will be used. Otherwise, condition 2 is evaluated, and its defined style used. If this style does not match, condition 3 is evaluated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id2414014				0	he	To apply conditional formatting, AutoCalculate must be enabled. Choose Tools - Cell Contents - AutoCalculate (you see a check mark next to the command when AutoCalculate is enabled).				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	bm_id3153189				0	he	\<bookmark_value\>conditional formatting; conditions\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	hd_id3153189				0	he	Condition 1/2/3				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3149413				0	he	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_CONDFORMAT:CBX_COND3\"\>Mark the boxes corresponding to each condition and enter the corresponding condition.\</ahelp\> To close the dialog, click \<emph\>OK\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	hd_id3147394				0	he	Cell Value / Formula				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3155602				0	he	\<ahelp hid=\"SC:LISTBOX:RID_SCDLG_CONDFORMAT:LB_COND3_1\"\>Specifies if conditional formatting is dependent on a cell value or a formula.\</ahelp\> If you select a formula as a reference, the \<emph\>Cell Value Condition\</emph\> box is displayed to the right of the \<emph\>Cell value/Formula\</emph\> field. If the condition is "Formula is", enter a cell reference. If the cell reference is a value other than zero, the condition matches.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	hd_id3153709				0	he	Cell Value Condition				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3153764				0	he	\<ahelp hid=\"SC:LISTBOX:RID_SCDLG_CONDFORMAT:LB_COND3_2\"\>Choose a condition for the format to be applied to the selected cells.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	hd_id3156384				0	he	Cell Style				20200411 15:09:53
