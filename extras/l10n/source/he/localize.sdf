helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3153364				0	he	sUS_date = sUS_date & Right(sInput, 2)				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3146975				0	he	sUS_date = sUS_date & "/"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120306.xhp	0	help	par_id3149665				0	he	sUS_date = sUS_date & Left(sInput, 4)				20200411 15:09:53
