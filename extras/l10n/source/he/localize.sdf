helpcontent2	source\text\sbasic\shared\03090301.xhp	0	help	par_id3146970				0	he	iInputa = Int(InputBox$ ("Enter the first number: ","NumberInput"))				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090301.xhp	0	help	par_id3150329				0	he	iInputb = Int(InputBox$ ("Enter the second number: ","NumberInput"))				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090301.xhp	0	help	par_id3156277				0	he	iInputc=iInputa				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090301.xhp	0	help	par_id3150321				0	he	GoSub SquareRoot				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090301.xhp	0	help	par_id3154756				0	he	Print "The square root of";iInputa;" is";iInputc				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090301.xhp	0	help	par_id3155764				0	he	iInputc=iInputb				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090301.xhp	0	help	par_id3152960				0	he	GoSub SquareRoot				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090301.xhp	0	help	par_id3147340				0	he	Print "The square root of";iInputb;" is";iInputc				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03090301.xhp	0	help	par_id3166450				0	he	Exit Sub				20200411 15:09:53
