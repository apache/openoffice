helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153790				0	he	COUPPCD(Settlement;Maturity;Frequency;Basis)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150989				0	he	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154667				0	he	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154569				0	he	\<emph\>Frequency\</emph\> is the number of interest payments per year (1, 2 or 4).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3150826				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148968				0	he	A security is purchased on 1.25.2001; the date of maturity is 11.15.2001. Interest is paid half-yearly (frequency is 2). Using daily balance interest calculation (basis 3) what was the interest date prior to purchase?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149992				0	he	=COUPPCD("1.25.2001"; "11.15.2001"; 2; 3) returns 11.15.2000.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3150673				0	he	\<bookmark_value\>COUPNUM function\</bookmark_value\>\<bookmark_value\>number of coupons\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3150673				0	he	COUPNUM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154350				0	he	\<ahelp hid=\"HID_AAI_FUNC_COUPNUM\"\>Returns the number of coupons (interest payments) between the settlement date and the maturity date.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3148400				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153200				0	he	COUPNUM (Settlement;Maturity;Frequency;Basis)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3159406				0	he	\<emph\>Settlement\</emph\> is the date of purchase of the security.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155864				0	he	\<emph\>Maturity\</emph\> is the date on which the security matures (expires).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154720				0	he	\<emph\>Frequency\</emph\> is the number of interest payments per year (1, 2 or 4).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3149319				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3152460				0	he	A security is purchased on 1.25.2001; the date of maturity is 11.15.2001. Interest is paid half-yearly (frequency is 2). Using daily balance interest calculation (basis 3) how many interest dates are there?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150640				0	he	=COUPNUM("1.25.2001"; "11.15.2001"; 2; 3) returns 2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3149339				0	he	\<bookmark_value\>IPMT function\</bookmark_value\>\<bookmark_value\>periodic amortizement rates\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3149339				0	he	IPMT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154522				0	he	\<ahelp hid=\"HID_FUNC_ZINSZ\"\>Calculates the periodic amortizement for an investment with regular payments and a constant interest rate.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3153266				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3151283				0	he	IPMT(Rate;Period;NPER;PV;FV;Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3147313				0	he	\<emph\>Rate\</emph\> is the periodic interest rate.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145158				0	he	\<emph\>Period\</emph\> is the period, for which the compound interest is calculated. Period=NPER if compound interest for the last period is calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3147577				0	he	\<emph\>NPER\</emph\> is the total number of periods, during which annuity is paid.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3156211				0	he	\<emph\>PV\</emph\> is the present cash value in sequence of payments.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3151213				0	he	\<emph\>FV\</emph\> (optional) is the desired value (future value) at the end of the periods.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154195				0	he	\<emph\>Type\</emph\> is the due date for the periodic payments.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3150102				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149438				0	he	What is the interest rate during the fifth period (year) if the constant interest rate is 5% and the cash value is 15,000 currency units? The periodic payment is seven years.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150496				0	he	IPMT(5%;5;7;15000) = -352.97 currency units. The compound interest during the fifth period (year) is 352.97 currency units.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3151205				0	he	\<bookmark_value\>calculating;future values\</bookmark_value\>\<bookmark_value\>future values;constant interest rates\</bookmark_value\>\<bookmark_value\>FV function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3151205				0	he	FV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154140				0	he	\<ahelp hid=\"HID_FUNC_ZW\"\>Returns the future value of an investment based on periodic, constant payments and a constant interest rate (Future Value).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3155178				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145215				0	he	FV(Rate; NPER; PMT; PV; Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155136				0	he	\<emph\>Rate\</emph\> is the periodic interest rate.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3156029				0	he	\<emph\>NPer\</emph\> is the total number of periods (payment period).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3151322				0	he	PMT: the annuity paid regularly per period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145256				0	he	PV (optional): the (present) cash value of an investment.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150999				0	he	Type (optional): defines whether the payment is due at the beginning or the end of a period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_idN114D8				0	he	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3146800				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3146813				0	he	What is the value at the end of an investment if the interest rate is 4% and the payment period is two years, with a periodic payment of 750 currency units. The investment has a present value of 2,500 currency units.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149302				0	he	FV(4%;2;750;2500) = -4234.00 currency units. The value at the end of the investment is 4234.00 currency units.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3155912				0	he	\<bookmark_value\>FVSCHEDULE function\</bookmark_value\>\<bookmark_value\>future values;varying interest rates\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3155912				0	he	FVSCHEDULE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3163726				0	he	\<ahelp hid=\"HID_AAI_FUNC_FVSCHEDULE\"\>Calculates the accumulated value of the starting capital for a series of periodically varying interest rates.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3149571				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148891				0	he	FVSCHEDULE(Principal;Schedule)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148904				0	he	Principal: is the starting capital.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148562				0	he	Schedule: a series of interest rates, for example, as a range H3:H5 or as a (List) (see example).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3147288				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148638				0	he	1000 currency units have been invested in for three years. The interest rates were 3%, 4% and 5% per annum. What is the value after three years?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3156358				0	he	=FVSCHEDULE(1000; {0.03; 0.04; 0.05}) returns 1124.76.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3156435				0	he	\<bookmark_value\>calculating;number of payment periods\</bookmark_value\>\<bookmark_value\>payment periods;number of\</bookmark_value\>\<bookmark_value\>number of payment periods\</bookmark_value\>\<bookmark_value\>NPER function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3156435				0	he	NPER				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3152363				0	he	\<ahelp hid=\"HID_FUNC_ZZR\"\>Returns the number of periods for an investment based on periodic, constant payments and a constant interest rate.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3147216				0	he	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155934				0	he	NPER(Rate;PMT;PV;FV;Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155946				0	he	\<emph\>Rate\</emph\> is the periodic interest rate.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149042				0	he	PMT: the constant annuity paid in each period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153134				0	he	PV: the present value (cash value) in a sequence of payments.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3154398				0	he	FV (optional): the future value, which is reached at the end of the last period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3145127				0	he	Type (optional): the due date of the payment at the beginning or at the end of the period.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_idN1166C				0	he	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3155795				0	he	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3147378				0	he	How many payment periods does a payment period cover with a periodic interest rate of 6%, a periodic payment of 153.75 currency units and a present cash value of 2.600 currency units.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3156171				0	he	NPER(6%;153.75;2600) = -12,02. The payment period covers 12.02 periods.				20200411 15:09:53
