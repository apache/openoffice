helpcontent2	source\text\shared\01\06200000.xhp	0	help	hd_id3152360				0	he	Ignore				20200411 15:09:53
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3153896				0	he	\<ahelp hid=\"HID_HANGULDLG_BUTTON_IGNORE\"\>No changes will be made to the current selection. The next word or character will be selected for conversion.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06200000.xhp	0	help	hd_id3148550				0	he	Always Ignore				20200411 15:09:53
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3154937				0	he	\<ahelp hid=\"HID_HANGULDLG_BUTTON_IGNOREALL\"\>No changes will be made to the current selection, and every time the same selection is detected it will be skipped automatically.\</ahelp\> The next word or character will be selected for conversion. The list of ignored text is valid for the current $[officename] session.				20200411 15:09:53
