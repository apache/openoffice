helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	tit				0	he	New Address List				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN10542				0	he	New Address List				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN10546				0	he	Enter new addresses or edit the addresses for \<link href=\"text/swriter/01/mailmerge03.xhp\"\>mail merge\</link\> documents. When you click \<emph\>OK\</emph\>, a dialog prompts you for the location to save the address list.				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN10557				0	he	Address Information				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN1055B				0	he	\<ahelp hid=\".\"\>Enter or edit the field contents for each mail merge recipient.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN1055E				0	he	Show Entry Number				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN10574				0	he	\<ahelp hid=\".\"\>Click the buttons to navigate through the records or enter a record number to display a record.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN10577				0	he	New				20200411 15:09:53
helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN1057B				0	he	\<ahelp hid=\".\"\>Adds a new blank record to the address list.\</ahelp\>				20200411 15:09:53
