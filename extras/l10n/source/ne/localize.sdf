helpcontent2	source\text\swriter\01\05060100.xhp	0	help	par_id3153675				0	ne	\<ahelp hid=\"SW:CHECKBOX:TP_FRM_STD:CB_FIXEDRATIO\"\>जब तपाईँंले चौडाइ वा उचाइ सेटिङ परिवर्तन गरेको बेला उचाइ र चौडाइ अनुपात बनाउनुहोस्.\</ahelp\>				2002-02-02 02:02:02
