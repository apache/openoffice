helpcontent2	source\text\shared\optionen\01010600.xhp	0	help	par_id3145174				0	ne	\<ahelp hid=\"OFFMGR_CHECKBOX_OFA_TP_MISC_CB_HELPAGENT\"\>चयन गरिएको अवस्थाहरूमा मद्दत प्रतिनीधि स्वचालित तवरले प्रदर्शित हुने छ भन्ने कुरा वर्णन गर्दछ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010600.xhp	0	help	par_id3145800				0	ne	\<ahelp hid=\"OFFMGR_CHECKBOX_OFA_TP_MISC_CB_DOCSTATUS\"\>कागजातको मुद्रण परिमार्जनको रूपमा गन्ति गरिन्छ की भन्ने कुरा बताउँछ।\</ahelp\> यो विकल्प चिनो गरेको बेलामा,तत्कालै कागजात बन्द गर्दा यदि परिवर्तन बचत गर्नुपरेमा तपाईँंलाई सोधिन्छ। त्यसपछि मुद्रण मिति परिवर्तनको रूपमा कागजाता गुणमा प्रविष्टि हुन्छ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010600.xhp	0	help	par_id3147530				0	ne	\<ahelp hid=\"OFFMGR:NUMERICFIELD:OFA_TP_MISC:NF_YEARVALUE\"\>एउटा मिति दायरा परिभाषित गर्दछ,जस भित्र प्रणालीले दुई-अंकिय वर्ष चिन्दछ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010600.xhp	0	help	par_id3151176				0	ne	यदि तपाईँले अनुक्रममा तीन पटक निश्चित अवस्थाका लागि मद्दत अभिकर्ता खोल्नु भएन, तर यसलाई स्वचालित रुपमा बन्द हुन दिनु भयो भने, यो अवस्थाका लागि मद्दत अभिकर्ता फेरि देखापर्ने छैन ।				2002-02-02 02:02:02
