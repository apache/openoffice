helpcontent2	source\text\swriter\01\05060200.xhp	0	help	par_id3150100				0	ne	\<variable id=\"hintergrundtext\"\>\<ahelp hid=\".uno:WrapThroughTransparent\"\>पृष्ठभूमिमा चयन वस्तु लैजानुहोस्. यो विकल्प मात्र उपलब्ध हुन्छ यदि तपाईँंले \<emph\> बेर्ने प्रकार\</emph\> मार्फत चयन गर्नु भयो भने.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060200.xhp	0	help	par_id3150678				0	ne	\<ahelp hid=\"SW:METRICFIELD:TP_FRM_WRAP:ED_LEFT_MARGIN\"\>खाली स्थानको मात्रा प्रविष्ट गर्नुहोस् जुन तपाईँं वस्तुको बायाँ कुना र पाठ बीचमा चाहनुहुन्छ.\</ahelp\>				2002-02-02 02:02:02
