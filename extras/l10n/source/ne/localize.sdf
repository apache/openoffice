helpcontent2	source\text\swriter\01\05060200.xhp	0	help	par_id3154333				0	ne	\<variable id=\"ersterabsatztext\"\>\<ahelp hid=\".uno:WrapAnchorOnly\"\>Starts a new paragraph below the object after you press Enter.\</ahelp\> The space between the paragraphs is determined by the size of the object. \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060200.xhp	0	help	par_id3154478				0	ne	\<variable id=\"umlauftext\"\>\<ahelp hid=\".uno:TextWrap\"\>तरीका निश्चित गर्नुहोस् जुन तपाईँंले पाठ वस्तुको वरिपरि बेर्न चाहनुहुन्छ.\</ahelp\> तपाईँंले पाठ र वस्तु बीचको स्पेसिङ पनि निश्चित गर्न सक्नुहुन्छ. \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060200.xhp	0	help	par_id3154716	24			0	ne	\<variable id=\"dynamischertext\"\>\<ahelp hid=\".uno:WrapIdeal\"\>Automatically wraps text to the left, to the right, or on all four sides of the border frame of the object. If the distance between the object and the page margin is less than 2 cm, the text is not wrapped. \</ahelp\>\</variable\>				2002-02-02 02:02:02
