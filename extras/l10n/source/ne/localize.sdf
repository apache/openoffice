helpcontent2	source\text\smath\01\03090600.xhp	0	help	par_id3153619				0	ne	\<ahelp hid=\"HID_SMA_BREVEX\"\>न्यून ब्रिभ सँग प्लेसहोल्डर घुसाउनुहोस्.\</ahelp\> तपाईँ टाइप पनि गर्न सक्नुहुन्छ \<emph\>ब्रिभ <?>\</emph\> \<emph\>आदेश\</emph\> सञ्झ्यालहरूमा ।				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090600.xhp	0	help	par_id3154116	55			0	ne	\<ahelp hid=\"HID_SMA_WIDETILDEX\"\>प्लेसहोल्डर सँग चौडा टिल्ड घुसाउनुहोस्. \</ahelp\> तपाईँ टाइप पनि गर्न सक्नुहुन्छ \<emph\>widetilde\</emph\> सिधा \<emph\>आदेश\</emph\> सञ्झ्यालहरूमा ।				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090600.xhp	0	help	par_id3154201				0	ne	सर्कमफ्लेक्स				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090600.xhp	0	help	par_id3154221				0	ne	सूचना \<link href=\"text/smath/01/03091300.xhp\" name=\"attributes\"\>विशेषताहरूमा\</link\>, \<link href=\"text/smath/01/03091200.xhp\" name=\"indexes and exponents\"\>अनुक्रमणिकाहरू र एक्सपोनेन्टहरू\</link\>, र \<link href=\"text/smath/01/03091400.xhp\" name=\"scaling\"\>स्केलिङले\</link\> तपाईँको कागजातहरूलाई अझ दक्षको साथ बनावट गर्न मद्दत गर्दछ.				2002-02-02 02:02:02
