helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3145728				0	ne	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>तपाईँले \<emph\>ढाँचा - स्वतढाँचा - लागू गर्नुहोस्\</emph\> रोज्दा हालको कागजातबाट खाली अनुच्छेदहरू हटाउँदछ । \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3146119				0	ne	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\> तालिका सिर्जना गर्छ जब तपाईँ धनात्मक चिन्हद्वारा छुट्याइएको हाफनहरू (-) वा ट्याबहरूको शृङ्खला टाइप गरिसके पाछि Enter थिच्नुहोस् जुन +------+---+हो । धनात्मक चिन्हहरू स्तम्भ बिभाजकद्वारा तोकिन्छ जतिबेला स्तम्भको चौडाइमा योजक चिन्ह राख्नेकाम र ट्याबहरू तोकिन्छ । \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3146874				0	ne	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>एउटा क्रमाङकन प्रतीकद्वारा सुरु हुने एउटा रेखाको अन्त्यमा तपाईँले इन्टर थिच्दा स्वचालित क्रमाङकन रद्द गर्न, फेरि इन्टर थिच्नुहोस् । \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3146946				0	ne	\<ahelp hid=\"HID_OFAPAGE_AUTOFORMAT_CLB\"\>तपाईँले टाइपको रूपमा स्वचालित तवरले त्रुटिहरू सुधार गर्दाका लागि विकल्प चयन गर्नुहोस् र त्यसपछि \<emph\>ठीक छ\</emph\>क्लिक गर्नुहोस् ।\</ahelp\>				2002-02-02 02:02:02
