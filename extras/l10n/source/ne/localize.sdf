helpcontent2	source\text\shared\01\05040100.xhp	0	help	par_id3147588				0	ne	\<ahelp hid=\"HID_MANAGE_STYLES\"\>चयन गरिएको शैलीका लागि विकल्प सेट गर्दछ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05040100.xhp	0	help	par_id3150771				0	ne	तपाईँले एउटा पुर्वपरिभाषित शैलीका लागि कोटि परिवर्तन गर्न सक्नुहुन्न ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05040100.xhp	0	help	par_id3153749				0	ne	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<ahelp hid=\"SFX2:CHECKBOX:TP_MANAGE_STYLES:CB_AUTO\"\>तपाईँको कागजातमा यो शैली प्रयोग गरेर एउटा अनुच्छेदमा तपाईँले प्रत्यक्ष ढाँचा लागू गर्दा शैली अद्यावधिक गर्दछ । यो शैली प्रयोग गर्नका लागि सबै अनुच्छेदहरूको ढाँचा स्वचालित रूपमा अद्यावधिक हुन्छ ।\</ahelp\>\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05040100.xhp	0	help	par_id3154306				0	ne	\<ahelp hid=\"SFX2:MULTILINEEDIT:TP_MANAGE_STYLES:ED_DESC\"\>हालको शैलीमा प्रयोग गरिएको सम्बन्धित ढाँचा वर्णन गर्दछ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05040100.xhp	0	help	par_id3155941				0	ne	\<ahelp hid=\"SFX2:LISTBOX:TP_MANAGE_STYLES:LB_NEXT\"\>तपाईँको कागजातमा हालको शैली अनुशरण गर्न तपाईँले चाहेको एउटा अवस्थित शैली चयन गर्नुहोस्। अनुच्छेद शैलीहरूका लागि, तपाईँले इन्टर थिच्दा सिर्जना हुने अनुच्छेदमा पछिल्लो शैली लागू हुन्छ । पृष्ठ शैलीहरूका लागि, एउटा नयाँ पृष्ठ सिर्जना गरिँदा पछिल्लो शैली लागू हुन्छ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05040100.xhp	0	help	par_id3159269				0	ne	\<ahelp hid=\"SFX2:LISTBOX:TP_MANAGE_STYLES:LB_REGION\"\>हालको शैलीका लागि कोटि प्रदर्शन गर्दछ । यदि तपाईँले एउटा शैली सिर्जना वा परिमार्जन गर्दै हुनुहुन्छ भने, सूचीबाट 'अनुकूल शैली' चयन गर्नुहोस्।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05040100.xhp	0	help	par_id3160481				0	ne	\<ahelp hid=\"SFX2:EDIT:TP_MANAGE_STYLES:ED_NAME\"\>चयन गरिएको शैलीको नाम प्रदर्शन गर्दछ. यदि तपाईँले एउटा अनुकूल शैली सिर्जना वा परिमार्जन गर्दै हुनुहुन्छ भने, शैलीका लागि एउटा नाम प्रविष्ट गर्नुहोस्। तपाईँले एउटा पूर्वपरिभाषित शैलीको नाम परिवर्तन गर्न सक्नुहुन्न ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05040100.xhp	0	help	par_id3166461				0	ne	\<ahelp hid=\"SFX2:LISTBOX:TP_MANAGE_STYLES:LB_BASE\"\>एउटा अवस्थित शैली चयन गर्नुहोस् जुनमा तपाईँले नयाँ शैली आधारित गर्न चाहनुहुन्छ, वा तपाईँको आफ्नो शैली परिभाषित गर्न कुनै पनि चयन नगर्नुहोस्।\</ahelp\>				2002-02-02 02:02:02
