helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3147396				0	ne	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>शीर्षक १ देखि शीर्षक ८ अनुच्छेद शैलीहरू सँग "Default" अनुच्छेद शैली स्वचालित रूपमा प्रतिस्थापन गर्दछ. शीर्षक १ अनुच्छेद शैली लागू गर्न, तपाईँले एउटा शीर्षक (एउटा अवधि बिनाको) को रूपमा प्रयोग गर्न चाहेको पाठ टाइप गर्नुहोस् र त्यसपछि इन्टर दुइपटक थिच्नुहोस्. एउटा उप-शीर्षक लागू गर्न, एक वा बढी पटक ट्याब थिच्नुहोस्, पाठ (एउटा अवधि बिनाको) टाइप गर्नुहोस् र त्यसपछि इन्टर थिच्नुहोस् । \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
