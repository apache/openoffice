helpcontent2	source\text\shared\02\01170801.xhp	0	help	hd_id3153323				0	ne	\<link href=\"text/shared/02/01170801.xhp\" name=\"Table Element / List Box / Combo Box Wizard: Data\"\>तालिका तत्व / सूची बाकस / कम्बो बाकस विजार्ड: डेटा\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170801.xhp	0	help	hd_id3153894				0	ne	डेटा स्रोत				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170801.xhp	0	help	par_id3150476				0	ne	फारम फाँट समन्वय हुने ठाउँमा डेटा स्रोत चयन गर्नुहोस.यदि तपाईँंले पहिले नै डेटा स्रोतमा लिङ्क भएको कागजातमा फारम फाँट घुसाउनु भयो भने,यो पृष्ठ अदृश्य बन्दछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170801.xhp	0	help	par_id3150774				0	ne	\<ahelp hid=\"DBP_LISTBOX_RID_PAGE_TABLESELECTION_LB_TABLE\"\>आवश्यक तालिका निर्दिष्ट गर्दछ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170801.xhp	0	help	par_id3153114				0	ne	\<ahelp hid=\"DBP_LISTBOX_RID_PAGE_TABLESELECTION_LB_DATASOURCE\"\>आवश्यक तालिका समावेश गर्ने डेटा स्रोत निर्दिष्ट गर्दछ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170801.xhp	0	help	tit				0	ne	तालिका तत्व/ सूची बाकस/ कम्बो बाकस विजार्ड:डेटा				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170802.xhp	0	help	hd_id3149346				0	ne	चयन फाँटहरू				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170802.xhp	0	help	hd_id3155934				0	ne	\<link href=\"text/shared/02/01170802.xhp\" name=\"Table Element Wizard: Field Selection\"\>तालिका तत्व विजार्ड: फाँट चयन\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170802.xhp	0	help	par_id3150476				0	ne	तालिका नियन्त्रण फाँटमा कुन फाँटहरू प्रर्दशन गर्नु पर्दछ भन्ने वर्णन गर्दछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170802.xhp	0	help	par_id3155941				0	ne	\<ahelp hid=\"DBP_LISTBOX_RID_PAGE_GW_FIELDSELECTION_LB_SELECTED_FIELDS\"\>फारम फाँटमा स्विकृत डेटा फाँटहरू प्रर्दशित गर्दछ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170802.xhp	0	help	tit				0	ne	तालिका तत्व विजार्ड: फाँट चयन				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170900.xhp	0	help	hd_id3154094				0	ne	\<link href=\"text/shared/02/01170900.xhp\" name=\"Combo Box/List Box Wizard\"\>कम्बो बाकस/ सूची बाकस विजार्ड\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170900.xhp	0	help	par_id3145211				0	ne	तपाईँले स्वचालित रूपमा विजार्ड सुरु भइराख्न\<link href=\"text/shared/02/01171100.xhp\" name=\"Wizards On/Off\"\>\<emph\>विजार्ड खुल्ला/बन्द\</emph\>\</link\> प्रतिमा प्रयोग गर्न सक्नुहुन्छ ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170900.xhp	0	help	par_id3145673				0	ne	अरू तालिकामा आवश्यक फाँट चाही फाँट नामहरूको प्रयोगद्वारा खोजीन्छ र त्यसपछि फाँटहरू तदनुसार समाप्त हुने छन । यदि फाँट नाम नभेटिएमा, सूची खाली रहने छ। जब सूची फाँटहरूमा लिङ्क गरिएको स्तम्भहरू समावेश भएमा, अरू तालिकाको पहिलो स्तम्भ एउटा पहिले देखाईएको क्वेरी बाहेक प्रयोग हुन्छ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170900.xhp	0	help	par_id3146949				0	ne	सूची बाकसको केसमा,तपाईँंले प्रविष्टिहरूलाई सूचीबाट चयन गरिएका, र तिनीहरू सूची तालिकामा बचत गरिए। कम्बो बाकसको केसमा,तपाईँंले थप तालिका थप गर्न सक्नुहुन्छ जुन फारम(मानहरू तालिका)को हालको तालिकामा लेख्न सकिन्छ र चाहेको रूपमा त्यहाँ बचत हुन्छ। यो कार्यका लागि,\<emph\>Combo Box Wizard\</emph\> सँग \<emph\>Data Processing\</emph\> पृष्ठ अन्तिम पृष्ठको रूपमा छ,जबकी सूची बाकसको केसमा यो पृष्ठ अवस्थित हुँदैन।यात यहाँ तपाईँंले मानहरू तालिकामा बचत गरिनुपर्ने पाठ गरिएको लाई प्रविष्टि गर्न सक्नुहुन्छ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170900.xhp	0	help	par_id3150977				0	ne	\<emph\>कम्बो बाकस\</emph\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170900.xhp	0	help	par_id3152363				0	ne	यदि तपाईँंले एउटा कागजातमा कम्बो बाकस वा सूची बाकस घुसाउनुहुन्छ भने, एउटा विजार्ड स्वचालित तवरले सुरु हुन्छ। यो विजार्डले तपाईँंले कुन सूचना देखाउने भन्ने अन्तर्क्रियात्मक तरीकाले वर्णन गर्न दिन्छ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170900.xhp	0	help	par_id3154046				0	ne	कम्बो बाकसहरूले कुनै तालिकाको डेटा प्रर्दशन गर्न सक्दछ। हालको फारम तालिका र कम्बो बाकसमा मा देखाईनुपर्ने मानहरू भएको तालिका आवश्यक छैन। कम्बो बाकसले सन्दर्भहरू सँग काम गर्दैन। यदि प्रयोगकर्ताले मान चयन गर्दछ र यसलाई बचत गर्दछ भने,वास्तविक प्रदर्शित मान फारम तालिकामा प्रविष्टि गर्ने छन। त्यहा फारम तालिका र सूची तालिका बीचमा लिङ्क नभएकोले, \<emph\>फाँट लिङ्क\</emph\> तालिका यहाँ देखिदैन।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170900.xhp	0	help	par_id3154860				0	ne	यदि एउटा लेख तालिका समाविष्ट भएमा,उदाहरणका लागि, एउटा आपुर्तीकर्ताको सङ्ख्या, सूची बाकसले "Supplier number" लिङ्कलाई आपूर्तिकर्ताको तालिकाबाट आपूर्तिकर्ताको नाम देखाउनका लागि प्रयोग गर्न सक्दछ । \<emph\>Field links\</emph\> पृष्ठमा विजार्डले यो लिङ्कलाई चाहिने सबै सेटिङहरूको बारेमा सोध्नेछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170900.xhp	0	help	par_id3155391				0	ne	कम्बो बाकस र सूची बाकसका लागि विजार्डहरू तिनीहरूको अन्तिम चरणमा एक अर्का देखी फरक हुन्छन। यो नियन्त्रण फाँटहरूको विशेषताको कारणले गर्दा हो।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170900.xhp	0	help	par_id3158430				0	ne	कम्बो बाकसको केसमा,प्रयोगकर्ताले सूची प्रविष्टिहरूबाट एउटा प्रविष्टि चयन गर्दछ वा तिनीहरू आफैले पाठ प्रविष्टि गर्दछन। प्रविष्टिहरू,जुन प्रयोगकर्ताले चयन गर्न सक्नेबाट सूचीको रूपमा प्रस्तावित भएका,कुनै पनि डाटाबेस तालिकाबाट उत्पन्न हुन सक्दछन। प्रयोगकर्ताले चयन गरेका र प्रविष्टि गरेका प्रविष्टिहरू जुन बचत गर्न सकिन्छ यात फारमको रूपमा वा एउटा डाटाबेसको रूपमा। यदि तिनीहरू एउटा डाटाबेसमा बचत गरिएमा,तिनीहरू डाटाबेस तालिकामा लेखिन्छन जसमा फारम आधारित हुन्छ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170900.xhp	0	help	par_id3159233				0	ne	\<emph\>सूची बाकसहरू\</emph\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170900.xhp	0	help	par_id3166410				0	ne	एउटा सूची बाकसको केसमा, प्रयोगकर्ताले एउटा प्रविष्टिहरूको सूचीबाट एउटा प्रविष्टि चयन गर्दछ। यि तालिकाहरू एउटा डाटाबेस तालिकामा बचत हुन्छन र सूची बाकसबाट परिमार्जन हुन सक्दैनन।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170900.xhp	0	help	par_id3166460				0	ne	साधारण नियमको रूपमा,फारममा मा दृश्य सूची प्रविष्टिहरू समावेश डाटाबेस तालिका त्यो तालिका होइन जसमा फारम आधारित छ। फारमको सूची बाकसले सन्दर्भहरू प्रयोग गरेर कार्य गर्दछ,त्यो,दृश्य प्रविष्टिहरूमा भएका सन्दर्भहरू फारम तालिकाहरू(मानहरू तालिका)मा रहेका हुन्छन र मानहरूमा जस्तै गरि तालिकाहरूमा प्रविष्टि गर्दछन यदि प्रयोगकर्ताले सूचीबाट एउटा प्रविष्टि चयन र बचत गरेमा । सन्दर्भ मानहरूबाट, हालको फारम तालिकामा लिङ्क भएको एउटा तालिकाबाट सूची बाकसले डेटा प्रदर्शन गर्न सक्दछ । यस प्रकार \<emph\>सूची बाकस विजार्ड\</emph\> ले एउटा डाटाबेसको दुई तालिका लिङ्क हुनका लागि स्विकार्दछ, ताकी नियन्त्रण फाँटले फाँटको बिस्तृत सूची प्रदर्शन गर्न सकोस जुन बिभिन्न तालिकामा एउटा देखी अर्को सम्म स्थित हुन्छ जसले फारम सन्दर्भ गर्दछ।ष्ट				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170900.xhp	0	help	tit				0	ne	कम्बो बाकस/ सूची बाकस विजार्ड				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170901.xhp	0	help	hd_id3147226				0	ne	तालिका				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170901.xhp	0	help	hd_id3154228				0	ne	\<link href=\"text/shared/02/01170901.xhp\" name=\"Combo Box / List Box Wizard: Table Selection\"\>कम्बो बाकस / सूची बाकस विजार्ड: तालिका चयन\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170901.xhp	0	help	par_id3149716				0	ne	उपलब्ध डाटाबेस तालिकाहरूबाट एउटा तालिका वर्णन गर्न सक्दछ जसमा डेटा फाँट समाविष्ट हुन्छ  जसको्को सामग्री एउटा सूची प्रविष्टिको रूपमा प्रदर्शित हुनु पर्दछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170901.xhp	0	help	par_id3153114				0	ne	सूची बाकसका लागि,हालको फारम तालिका सँग लिङ्क गर्न सकिने एउटा तालिका सूचीत गरियो। हालको फारमको तालिका सँग लिङ्क तालिकाको स्तम्भमा कम्तिमा एउटा फाँट हुनै पर्दछ। यसले एउटा स्पष्ट सन्दर्भ स्थापना गर्न सम्भव बनाउँदछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170901.xhp	0	help	par_id3155338	7			0	ne	\<ahelp hid=\"DBP_LISTBOX_RID_PAGE_LCW_CONTENTSELECTION_TABLE_LB_SELECTTABLE\"\> \<emph\> तालिका \</emph\>फाँटमा, डेटा फाँट समावेश गर्ने तलिका चयन गर्नुहोस् जसको सामग्री नियन्त्रण फाँटमा प्रर्दशित हुनुपर्दछ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170901.xhp	0	help	par_id3155555				0	ne	कम्बो बाकसका लागि, फारम तालिका र कम्बो बाकसमा डेटा देखाउनका लागि डेटा समाविष्ट तालिका बीचमा एउटा सम्बन्ध हुनै पर्दछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170901.xhp	0	help	par_id3159233				0	ne	यहाँ दिइएको तालिका \<link href=\"text/shared/02/01170102.xhp\" name=\"Control properties\"\>नियन्त्रण गुणहरू\</link\> मा  \<emph\>सूची सामग्रीहरू\</emph\> फाँटमा भएको SQL कथनको एउटा तत्वको रूपमा देखापर्दछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170901.xhp	0	help	tit				0	ne	कम्बो बाकस/ सूची बाकस विजार्ड: तालिका चयन				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170902.xhp	0	help	hd_id3145669				0	ne	फाँट प्रदर्शन गर्नुहोस				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170902.xhp	0	help	hd_id3153323				0	ne	\<link href=\"text/shared/02/01170902.xhp\" name=\"Combo/List Box Wizard: Field Selection\"\>कम्बो/सूची बाकस विजार्ड: फाँट चयन\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170902.xhp	0	help	hd_id3153894				0	ne	उपलब्ध फाँटहरू				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170902.xhp	0	help	par_id3093440				0	ne	\<ahelp hid=\"DBP_LISTBOX_RID_PAGE_LCW_CONTENTSELECTION_FIELD_LB_SELECTFIELD\"\>अघिल्लो विजार्ड पृष्ठमा रोजिएको सम्पूर्ण तालिका फाँटहरू प्रर्दशित गर्दछ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170902.xhp	0	help	par_id3145136				0	ne	\<ahelp hid=\"DBP_EDIT_RID_PAGE_LCW_CONTENTSELECTION_FIELD_ET_DISPLAYEDFIELD\"\>कम्बो वा सूची बाकसहरूमा डेटा देखिन पर्ने फाँट निर्दिष्ट गर्दछ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170902.xhp	0	help	par_id3145345				0	ne	यहाँ दिइएका फाँट नाम  \<link href=\"text/shared/02/01170102.xhp\" name=\"Control properties\"\>Control properties\</link\>मा  \<emph\>List Contents\</emph\> मा SQL कथनको रूपमा देखा पर्दछन।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170902.xhp	0	help	par_id3154228				0	ne	पहिलेको पृष्ठको तालिकामा वर्णन गरिएको डेटा फाँट चयन गर्नुहोस् , जस्को सामग्रीहरू सूची बाकस वा कम्बो बाकसमा प्रदर्शन गर्नु पर्दछ।				2002-02-02 02:02:02
