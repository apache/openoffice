helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3151175	24			0	ne	\<variable id=\"endnotetext\"\>पादटिप्पणीहरू पृष्ठको अन्तिममा घुसाइन्छ, र अन्तटिप्पणीहरू कागजातको अन्तमा घुसाइन्छ.\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3151256				0	ne	पादटिप्पणी घुसाउने कि अन्तटिप्पणी घुसाउने चयन गर्नुहोस्. अन्तटिप्पणी क्रमाङ्कन पादटिप्पणी क्रमाङ्कनबाट छुट्टेको छ.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3152770				0	ne	\<ahelp hid=\"SW:RADIOBUTTON:DLG_INS_FOOTNOTE:RB_TYPE_ENDNOTE\"\>कागजातको हालको कर्सर अवस्थामा अन्तटिप्पणी एङ्कर घुसाउनुहोस्, र कागजातको अन्तमा अन्तटिप्पणी थप गर्नुहोस्.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3153526				0	ne	\<variable id=\"bearbeitensonderzeichen\"\>\<ahelp hid=\"SW:PUSHBUTTON:DLG_INS_FOOTNOTE:BT_NUMBER_CHAR\"\>Inserts a \<link href=\"text/shared/01/04100000.xhp\" name=\"special character \"\>स्पेसल क्यारेक्टर \</link\> पादटिप्पणी वा अन्तटिप्पणीको रूपमा.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3153670	17			0	ne	\<variable id=\"bearbeitenautomatisch\"\>\<ahelp hid=\"SW:RADIOBUTTON:DLG_INS_FOOTNOTE:RB_NUMBER_AUTO\"\>तपाईँंले घुसाउने पादटिप्पणीहरू वा अन्त्यटिप्पणीहरूमा क्रमागत सङ्ख्याहरू स्वत:तरीकाले मानाङ्कन गर्दछ।\</ahelp\> स्वाचालित क्रमाङ्कनका लागि सेटिङहरू परिवर्तन गर्नलाई, \<link href=\"text/swriter/01/06080000.xhp\" name=\"Tools - Footnotes\"\>\<emph\>उपकरणहरू - पादटिप्पणीहरू\</emph\>\</link\> रोज्नुहोस्।\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3154645	23			0	ne	\<variable id=\"endnoten\"\>तलकाले दुबै पादटिप्पणीहरू र अन्तटिप्पणीलाई लागू हुन्छ.\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3155135				0	ne	\<link href=\"text/swriter/guide/footnote_usage.xhp\" name=\"Tips for working with footnotes\"\>पादटिप्पणीहरू सँग कार्य गर्दा टिपहरू\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3155901	18			0	ne	\<variable id=\"bearbeitenzeichen\"\>\<ahelp hid=\"SW:EDIT:DLG_INS_FOOTNOTE:ED_NUMBER_CHAR\"\>हालको पादटिप्पणीका लागि क्यारेक्टर वा प्रतीक परिभाषित गर्न यो विकल्प चयन गर्नुहोस्.\</ahelp\> यो पत्र वा सङ्ख्या हुन सक्छ. स्पेसल क्यारेक्टर निर्धारित गर्नलाई, तल बटन क्लिक गर्नुहोस्.\</variable\>				2002-02-02 02:02:02
