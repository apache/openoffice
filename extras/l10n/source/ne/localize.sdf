helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3159150				0	ne	\<ahelp hid=\".uno:GraphicFilterSolarize\"\> पारिभाषिक सौर्यीकरणका लागि एउटा संवाद खोल्दछ।\</ahelp\> सौर्यीकरण ले एउटा प्रभाव सन्दर्भ गर्दछ जुन फोटो विकासमा त्यहाँनिकै धेरै प्रकाश भएको बेलामा केही हुन सक्छ भन्ने जस्तो देखिन्छ। रङ आंशिक रूपमा उल्टा बन्दछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3159399				0	ne	\<ahelp hid=\".uno:GraphicFilterSmooth\"\>एउटा छविमा व्यतिरेक नरम पार्दछ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3163712				0	ne	\<ahelp hid=\".uno:GraphicFilterSepia\"\> पाको हुदै कार्य सेट गर्नका लागि एउटा संवाद खोल्दछ। \</ahelp\> हरेक पटक तपाईँंले यो कार्य बोलाउदा छवि केही मधुरो देखिन्छ, रङहरू अझ खरानी रङको वा खैरो बनाउन सकिन्छ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3163807				0	ne	\<ahelp hid=\".uno:GraphicFilterMosaic\"\> पिक्सेलको सानो समूह उस्तै रङको आयातकार क्षेत्रमा जोड्दछ।\</ahelp\> जती ठुला अलग अलग आयातनहरू हुन्छन,त्यती थोरै नै ग्राफिक छविमा बिवरण हुन्छ।				2002-02-02 02:02:02
