helpcontent2	source\text\shared\autopi\startup.xhp	0	help	par_idN10562				0	ne	स्वागत				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\startup.xhp	0	help	par_idN10566				0	ne	\<ahelp hid=\".\"\>स्टार्ट-अप विजार्डले %PRODUCTNAME का लागि प्रयोगकर्ता सेटिङहरू वर्णन गर्न मद्दत गर्दछ । यो विजार्ड एक पटक मात्र चल्दछ ।\</ahelp\>				2002-02-02 02:02:02
