helpcontent2	source\text\simpress\02\10080000.xhp	0	help	par_id3148833				0	ne	\<image id=\"img_id3145410\" src=\"res/commandimagelist/sc_freeline.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3145410\"\>प्रतिमा\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\simpress\02\10080000.xhp	0	help	par_id3149801				0	ne	वक्र				2002-02-02 02:02:02
helpcontent2	source\text\simpress\02\10080000.xhp	0	help	par_id3150016				0	ne	\<ahelp hid=\".uno:BezierFill\"\>भरिएको बन्द आकार कोर्नुहोस् जुन बेजियर बक्रमा आधारित छ. क्लिक गर्नुहोस् जहाँ तपाईँ बक्र सुरु गर्न चाहनुहुन्छ, तान्नुहोस्, छोड्नुहोस्, र पछि सूचक चलाउनुहोस् जहाँ तपाईँ बक्र अन्त्य गर्न चाहनुहुन्छ र क्लिक गर्नुहोस् । सूचक लैजानुहोस् र फेरि क्लिक गर्नुहोस् बक्रमा सिधा पङ्क्ति बिबाजक थप गर्नका लागि, आकार बन्द गर्न डबल-क्लिक गर्नुहोस्\</ahelp\> 				2002-02-02 02:02:02
helpcontent2	source\text\simpress\02\10080000.xhp	0	help	par_id3150354				0	ne	\<ahelp hid=\".uno:Polygon_Diagonal_Unfill\"\>सिधा रेखा खण्डहरूको एउटा श्रृङ्खलाको रचना गरिएको एउटा रेखा कोर्दछ, जुन ४५ डिग्रीको कोणहरूद्वारा अवरोध गरिएको छ, रेखा खण्डको अन्त्य बिन्दु परिभाषित गर्न,र तब एउटा नयाँ रेखा खण्ड कोर्न तान्नुहोस,रेखा कोर्न समाप्त गर्न डबल क्लिक गर्नुहोस.एउटा बन्द गरिएको आकार सिर्जना गर्न, तल राख्नुहोस \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Options \</caseinline\>\<defaultinline\>Alt\</defaultinline\>\</switchinline\> र डबल-क्लिक\</ahelp\> 				2002-02-02 02:02:02
