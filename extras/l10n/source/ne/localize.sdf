helpcontent2	source\text\shared\01\05020300.xhp	0	help	par_id3147352	12			0	ne	\<ahelp hid=\"SVX:NUMERICFIELD:RID_SVXPAGE_NUMBERFORMAT:ED_LEADZEROES\"\>दशमलव स्थानको अगाडि प्रदर्शन गर्न शून्यहरूको अधिकतम सङ्ख्या प्रविष्ट गर्नुहोस्।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020300.xhp	0	help	par_id3148491				0	ne	\<ahelp hid=\"HID_NUMBERFORMAT_LB_FORMAT\"\>चयन गर्नुहोस्कसरी तपाईँले चयन गरिएको कक्ष(हरू) को सामग्रीहरू प्रदर्शित भएको चाहनुहुन्छ ।\</ahelp\> चयन गरिएको विकल्पका लागि सङ्केत \<emph\>ढाँचा सङ्केत\</emph\> बाकसमा प्रदर्शित गरिन्छ ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020300.xhp	0	help	par_id3148563				0	ne	\<ahelp hid=\"SVX:LISTBOX:RID_SVXPAGE_NUMBERFORMAT:LB_CURRENCY\"\>एउटा मुद्रा चयन गर्नुहोस् र त्यस पछि मुद्राका लागि ढाँचा विकल्प हेर्न \<emph\>ढाँचा\</emph\> सूचीको माथिसम्म स्क्रोल गर्नुहोस्।\</ahelp\>				2002-02-02 02:02:02
