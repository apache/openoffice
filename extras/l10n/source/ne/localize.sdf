helpcontent2	source\text\shared\01\04050000.xhp	0	help	par_id3151100				0	ne	\<variable id=\"notizbearbeitentext\"\>\<ahelp hid=\".uno:InsertAnnotation\"\>हालको कर्सर स्थितिमा एउटा द्रष्टव्य घुसाउँछ । एउटा द्रष्टव्यको सामग्रीहरू हेर्न वा सम्पादन गर्न, द्रष्टव्य चयन गर्नुहोस्र यो आदेश रोज्नुहोस् ।\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\04050000.xhp	0	help	par_id3153362	14			0	ne	\<ahelp hid=\"SVX:MULTILINEEDIT:RID_SVXDLG_POSTIT:ED_EDIT\"\>\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>\</caseinline\>\<defaultinline\>तपाईँको द्रष्टव्यका लागि पाठ प्रविष्टि गराउनुहोस् ।\</defaultinline\>\</switchinline\>\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\04050000.xhp	0	help	par_id3153716				0	ne	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>तपाईँको स्प्रेडसिटको द्रष्टव्यहरूका लागि मुद्रण विकल्प सेट गर्न, \<emph\>ढाँचा - पृष्ठ\</emph\> रोज्नुहोस्, र त्यसपछि \<emph\>पाना\</emph\> ट्याबमा क्लिक गर्नुहोस्।\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\04050000.xhp	0	help	par_id3154153	16			0	ne	\<ahelp hid=\"SVX:PUSHBUTTON:RID_SVXDLG_POSTIT:BTN_AUTHOR\"\>\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>\</caseinline\>\<defaultinline\>द्रष्टव्यको सामग्रीहरूमा तपाईँको प्रथमाक्षरहरू र हालको मिति र समय प्रविष्टि गर्दछ ।\</defaultinline\>\</switchinline\>\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\04050000.xhp	0	help	par_id3155390				0	ne	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>एउटा द्रष्टव्य सम्पादन गर्न, त्यो कक्षमा क्लिक गर्नुहोस् जसले द्रष्टव्य समाहित गर्दछ, र त्यसपछि \<emph\>घुसाउनुहोस् - द्रष्टव्य\</emph\> रोज्नुहोस् । द्रष्टव्य पाठको ढाँचा निर्दिष्ट गर्न, द्रष्टव्यमा दायाँ-क्लिक गर्नुहोस्। \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\04050000.xhp	0	help	par_id3166460				0	ne	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>जब तपाईँले कक्षमा एउटा द्रष्टव्य संलग्न गर्नुहुन्छ, एउटा कलआउट देखा पर्दछ जहाँ तपाईँले तपाईँको पाठ प्रविष्टि गर्न सक्नुहुन्छ. एउटा सानो रातो वर्गले एउटा पानामा एउटा द्रष्टव्यको स्थिति चिनो लगाउँछ. स्थायी रूपमा द्रष्टव्य प्रदर्शन गर्न, द्रष्टव्यमा दायाँ-क्लिक गर्नुहोस् र \<emph\>द्रष्टव्य देखाउनुहोस्\</emph\> रोज्नुहोस्् ।\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\04050000.xhp	0	help	par_idN107A1				0	ne	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>एउटा द्रष्टव्यको साइजको स्थिति परिवर्तन गर्न, द्रष्टव्यको एउटा किनारा वा कुना तान्नुहोस् । \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
