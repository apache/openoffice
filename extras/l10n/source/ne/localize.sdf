helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3145763				0	ne	\<ahelp hid=\"SW:METRICFIELD:TP_FORMAT_TABLE:ED_BOTTOM_DIST\"\>खाली स्थानको मात्रा प्रविष्ट गर्नुहोस् जुन तपाईँं तालिकाको तल कुनो र तालिका तलको पाठ बीचमा छोड्न चाहनुहुन्छ.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3145782				0	ne	तालिका अघि कागजात, हेडर वा फुटरमा सुरुमा अनुच्छेद घुसाउनका लागि, कर्सर पहिलो कक्षमा कुनै सामाग्री अघि राख्नुहोस्, र थिच्नुहोस् प्रविष्ट.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3146322				0	ne	\<ahelp hid=\"HID_FORMAT_TABLE\"\>चयन तालिकाका लागि साइज, अवस्था, स्पेसिङ र पङ्क्तिबद्व विकल्प निश्चित गर्नुहोस्.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3147220	30			0	ne	\<ahelp hid=\"SW:METRICFIELD:TP_FORMAT_TABLE:ED_RIGHT_DIST\"\>खाली स्थानको मात्रा प्रविष्ट गर्नुहोस् जुन तपाईँं बायाँ पृष्ठ सीमान्त र तालिकाको कुना बीचमा छोड्न चाहनुहुन्छ.\</ahelp\> यो विकल्प उपलब्ध हुँदैन यदि \<emph\>स्वचालित \</emph\>वा \<emph\>दायाँ\</emph\> विकल्प चयन गरिन्छ \<emph\>पङ्क्तिबद्व\</emph\> क्षेत्रमा.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3149026				0	ne	\<ahelp hid=\"SW:METRICFIELD:TP_FORMAT_TABLE:ED_WIDTH\"\>तालिकाको चौडाइ प्रविष्ट गर्नुहोस्.\</ahelp\> यो जाँच बाकस मात्र उपलब्ध हुन्छ यदि \<emph\>स्वचालित\</emph\> विकल्प \<emph\>पङ्क्तिबद्वमा\</emph\> क्षेत्र चयन गरिएको छैन.				2002-02-02 02:02:02
