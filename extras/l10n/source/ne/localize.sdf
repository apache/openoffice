helpcontent2	source\text\shared\01\01010201.xhp	0	help	par_id3150838				0	ne	\<ahelp hid=\"SW_MULTILINEEDIT_TP_LAB_LAB_EDT_WRITING\"\>तपाईँले लेबुलमा देखाउन चाहेको पाठ प्रविष्ट गर्नुहोस्। तपाईँले डाटाबेस फाँट घुसाउन पनि सक्नुहुन्छ ।\</ahelp\>				2002-02-02 02:02:02
