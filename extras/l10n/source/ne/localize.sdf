helpcontent2	source\text\scalc\01\06060000.xhp	0	help	par_id3153362	2			0	ne	\<emph\>सुरक्षा कागजात\</emph\>आदेशले पानाहरूमा कक्षलाई वा कागजातमा कक्षहरूलाई परिवर्तन हुनबाट रोक्छ । विकल्पको रूपमा तपाईँं पास वर्ड परिभाषा गर्न सक्नुहुन्छ । यदि पासवर्ड परिभाषा गरेको खण्डमा सुरक्षा हटाउन प्रयोगकर्ताले सही पासवर्ड प्रविष्टि गरेको खण्डमा मात्र सम्भव हुन्छ ।				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\06060000.xhp	0	help	par_idN10622				0	ne	\<embedvar href=\"text/scalc/guide/cell_protect.xhp#cell_protect\"/\>				2002-02-02 02:02:02
