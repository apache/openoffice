helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3150356				0	ne	\<ahelp hid=\"HID_SMA_LRBRACKETX\"\>वर्ग कोष्ठकहरू बीचमा प्लेसहोल्डर घुसाउनुहोस्.\</ahelp\> तपाईँ टाइप पनि गर्न सक्नुहुन्छ \<emph\>[<?>]\</emph\> \<emph\>आदेश\</emph\> सञ्झ्यालहरूमा.				2002-02-02 02:02:02
