helpcontent2	source\text\swriter\01\04060000.xhp	0	help	par_id3149288	2			0	ne	\<variable id=\"beschrifttext\"\>\<ahelp hid=\"HID_DLG_CAPTION\"\>क्रमाङ्कित क्याप्सन चयन गरिएको ग्राफिकमा, तालिकामा, फ्रममा, पाठ फ्रेममा, वा चित्रपट वस्तुमा थप गर्नुहोस्.\</ahelp\> तपाईँं यो आदेशलाई पहुँच गर्न सक्नुहुन्छ वस्तुलाई दायाँ-क्लिक गरेर जुन तपाईँं क्याप्सन थप गर्न चाहनुहुन्थ्यो. \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04060000.xhp	0	help	par_id3149486				0	ne	\<ahelp hid=\"SW:LISTBOX:DLG_CAPTION:BOX_POS\"\>चयन गरिएको वस्तु माथि वा तल क्याप्सन थप गर्नुहोस्. Tयो विकल्प केही वस्तुहरूका लागि मात्र उपलब्ध हुन्छ.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04060000.xhp	0	help	par_id3149688				0	ne	\<ahelp hid=\"SW:EDIT:DLG_CAPTION:EDT_TEXT\"\>पाठ टाइप गर्नुहोस् जुन तपाईँं क्याप्सन सङ्ख्या पछि देखाउन चाहनुहुन्छ.\</ahelp\> उदाहरणका लागि, यदि तपाईँं आफ्नो वस्तुहरू लेबुल गर्न चाहनुहुन्छ "Object 1: Text", बिरामचिन्ह टाइप गर्नुहोस् (:), खाली स्थान र पाठ.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04060000.xhp	0	help	par_id3149804				0	ne	हालको चयनका लागि क्याप्सन विकल्प सेट गर्नुहोस्				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04060000.xhp	0	help	par_id3152962				0	ne	\<ahelp hid=\"SW:LISTBOX:DLG_CAPTION:BOX_FORMAT\"\>क्रमाङ्कनको प्रकार चयन गर्नुहोस् जुन तपाईँं क्याप्सनमा प्रयोग गर्न चाहनुहुन्थ्यो.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04060000.xhp	0	help	par_id3154574	6			0	ne	\<ahelp hid=\"SW:COMBOBOX:DLG_CAPTION:BOX_CATEGORY\"\>क्यापसन बर्ग चयन गर्नुहोस्, वा एउटा नयाँ बर्ग सिर्जना गर्नलाई एउटा नाम टाइप गर्नुहोस्। बर्ग पाठ क्याप्सन लेबुलमा क्याप्सन सङ्ख्या भन्दा पहिले देखापर्दछ। हरेक पूर्वपरिभाषित बर्ग उस्तै नामको एउटा अनुच्छेद शैली सँग ढाँचाबद्ध हुन्छ। \</ahelp\> उदाहरणका लागि, "उदाहरण" क्याप्सन बर्ग "उदाहरण" अनुच्छेद शैली सँग ढाँचाबद्ध हुन्छ।				2002-02-02 02:02:02
