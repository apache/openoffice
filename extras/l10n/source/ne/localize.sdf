helpcontent2	source\text\shared\01\05020400.xhp	0	help	par_id3148943				0	ne	<A HREF="http://www.sun.com/" NAME="Nametext" TARGET="_blank">द्रष्टव्य</A>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020400.xhp	0	help	par_id3149388				0	ne	\<variable id=\"hyperlinktext\"\>\<ahelp hid=\".uno:InsertHyperlinkDlg\"\>एउटा नयाँ हाइपरलिङ्क मानाङ्कन गर्दछ वा चयन गरिइको हाइपरलिङ्क सम्पादन गर्दछ ।\</ahelp\>\</variable\> एउटा हाइपरलिङ्क इन्टरनेटमा वा तपाईँको स्थानीय प्रणालीमा एउटा फाइलको एउटा लिङ्क हो ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020400.xhp	0	help	par_id3150359				0	ne	\<ahelp hid=\"SW:LISTBOX:TP_CHAR_URL:LB_VISITED\"\>सूचीबाट भ्रमण गरिएको लिङ्कहरूका लागि प्रयोग गर्न एउटा ढाँचा शैली चयन गर्नुहोस्। यो सूचीमा एउटा शैली थप्न वा परिमार्जन गर्न, यो संवाद बन्द गर्नुहोस् र \<emph\>ढाँचा\</emph\> उपकरणपट्टीको \<emph\>शैलीहरू र ढाँचा\</emph\> प्रतिमामा क्लिक गर्नुहोस्।\</ahelp\>				2002-02-02 02:02:02
