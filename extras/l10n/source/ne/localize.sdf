helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3149192				0	ne	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVX_MDLG_HANGULHANJA_RB_HANGUL_HANJA_BRACKETED\"\>हेङुल भाग पछि कोष्ठकमा हान्जा भाग प्रदर्शित हुनेछ.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3149205				0	ne	\<ahelp hid=\"HID_HANGULDLG_EDIT_NEWWORD\"\>शब्दकोशबाट पहिलो प्रतिस्थापन सुझाव प्रदर्शन गर्छ ।\</ahelp\> तपाईँले सुझाव गरिएको शब्द सम्पादन गर्न सक्नुहुन्छ वा अर्को शब्द प्रविष्टि गर्न सक्नुहुन्छ । \<emph\>Find\</emph\> सम्बन्धित प्रतिस्थापन शब्द सहित तपाईँको मौलिक शब्द बदल्न बटन क्लिक गर्नुहोस् ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3150771				0	ne	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVX_MDLG_HANGULHANJA_RB_HANJA_HANGUL_ABOVE\"\>हान्जा भाग माथि रुवि पाठको रूपमा हेङुल भाग प्रदर्शित हुनेछ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3150775				0	ne	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVX_MDLG_HANGULHANJA_RB_SIMPLE_CONVERSION\"\>सुझाव गरिएको क्यारेक्टरहरूद्वारा मौलिक क्यारेक्टरहरू प्रतिस्थापित हुन्छन् ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3153338				0	ne	\<ahelp hid=\"HID_HANGULDLG_BUTTON_CHANGEALL\"\>ढाँचा विकल्प अनुसार चयनलाई सुझाइएको क्यारेक्टरहरू वा शब्द सँग प्रतिस्थापन गर्दछ । प्रत्येक पटक उही चयन पत्ता लाग्दा यो स्वचालित रूपमा प्रतिस्थापित हुन्छ ।\</ahelp\> रूपान्तरणका लागि पछिल्लो शब्द वा क्यारेक्टर चयन गरिन्छ । प्रतिस्थापन पाठको सूची हालको $[officename] सत्रका लागि वैध हुन्छ ।				2002-02-02 02:02:02
