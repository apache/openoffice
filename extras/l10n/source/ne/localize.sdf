helpcontent2	source\text\shared\optionen\01060400.xhp	0	help	par_id3150503				0	ne	\<ahelp hid=\"SC:LISTBOX:RID_SCPAGE_USERLISTS:LB_LISTS\"\>उपलब्ध सबै सूचीहरू प्रदर्शन गर्दछ। यि सूचीहरू सम्पादनका लागि चयन गर्न सकिन्छ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01060400.xhp	0	help	par_id3153825	2			0	ne	\<ahelp hid=\"HID_SCPAGE_USERLISTS\"\>प्रयोगकर्ता-परिभाषित सबै सूचीहरू\<emph\>सूची क्रमबद्ध गर्नुहोस \</emph\>संवादमा प्रदर्शन गरिए। तपाईँंले आफ्नो सूचीहरू परिभाषित र सम्पादन गर्न सक्नुहुन्छ। पाठ मात्र क्रम सूचीहरूको रूपमा प्रयोग गर्न सकिन्छ तर सङ्ख्याहरू होइन।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01060400.xhp	0	help	par_id3153970				0	ne	\<ahelp hid=\"SC:PUSHBUTTON:RID_SCPAGE_USERLISTS:BTN_NEW\"\>नयाँ सूचीको सामग्री \<emph\>प्रविष्टिहरू\</emph\> बाकसमा प्रविष्टि गर्नुहोस।\</ahelp\> यो बटन \<emph\>नयाँ\</emph\> बाट \<emph\>अस्विकार\</emph\> मा परिवर्तन गर्नेछ, जसलेतपाईँंलाई नयाँ सूची मेट्न सक्षम गराउछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01060400.xhp	0	help	par_id3158409				0	ne	\<ahelp hid=\"SC:PUSHBUTTON:RID_SCPAGE_USERLISTS:BTN_COPY\"\>कक्षहरूको सामग्री\<emph\>बाट सूची प्रतिलिपि गर्नुहोस\</emph\> बाकसमा प्रतिलिपि गर्नुहोस। यदितपाईँंले पङ्क्ति वा स्तम्भहरू सँग सम्बन्धित सन्दर्भ चयन गर्नुभएमा, \<link href=\"text/shared/optionen/01060401.xhp\" name=\"Copy List\"\>\<emph\>सूची प्रतिलिपि गर्नुहोस\</emph\>\</link\> संवाद बटन क्लिक गरिसकेपछि देखापर्छ।तपाईँंले यदि सन्दर्भ पङ्क्ति वा स्तम्भद्वारा क्रम सूचीहरूमा बदलिएमा यो संवाद प्रयोग गर्न सक्नुहुन्छ।\</ahelp\>				2002-02-02 02:02:02
