helpcontent2	source\text\shared\guide\data_search2.xhp	0	help	par_id3145273				0	ne	\<ahelp hid=\".uno:FormFilterExit\"\>यदि तपाईँले \<emph\>फारम फिल्टर\</emph\>उपकरणपट्टीमा \<emph\>बन्द गर्नुहोस\</emph\> बटन क्लिक गर्नुभएमा, फारम फिल्टर बिनानै प्रदर्शिन हुन्छ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\data_search2.xhp	0	help	par_id3146898	12			0	ne	\<link href=\"text/shared/02/12040000.xhp\" name=\"Remove Filter/Sort\"\>\<emph\>फिल्टर/क्रमबद्ध हटाउनुहोस्\</emph\>\</link\> प्रतिमा \<image id=\"img_id3151318\" src=\"res/commandimagelist/sc_removefiltersort.png\" width=\"5.64mm\" height=\"5.64mm\"\>\<alt id=\"alt_id3151318\"\>प्रतिमा\</alt\>\</image\>क्लिक गरेर सेट भएको फिल्टर हटाउन सकिन्छ ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\data_search2.xhp	0	help	par_id3148672	6			0	ne	\<emph\>फर्म नेभिगेसन\</emph\> उपकरणपट्टीमा, \<emph\>फर्म-आधारित फिल्टरहरू\</emph\> प्रतिमा \<image id=\"img_id3149807\" src=\"res/commandimagelist/sc_formfilter.png\" width=\"5.64mm\" height=\"5.64mm\"\>\<alt id=\"alt_id3149807\"\>प्रतिमा\</alt\>\</image\> क्लिक गर्नुहोस् । हालको कागजात एउटा खाली सम्पादन मास्कको रुपमा यसको फर्म नियन्त्रणहरू सँगै प्रदर्शित हुन्छ । \<emph\>फर्म फिल्टर \</emph\>उपकरणपट्टी देखापर्दछ ।				2002-02-02 02:02:02
