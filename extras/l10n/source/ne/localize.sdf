helpcontent2	source\text\shared\01\01020000.xhp	0	help	par_id3147618				0	ne	\<ahelp hid=\"HID_FILEVIEW_MENU_RENAME\"\>फाइललाई पुन: नामकरण गर्नका लागि,फाइलमा दायाँ क्लिक गर्नुहोस्र त्यसपछि \<emph\>पुन: नामकरण\</emph\>रोज्नुहोस् ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01020000.xhp	0	help	par_id3149291				0	ne	\<ahelp hid=\"HID_FILEOPEN_VERSION\"\> यदि त्यहाँ चयन गरिएका फाइलको बहु संस्करण छन् भने,तपाईँले खोल्न चाहनुभएको संस्करण चयन गर्नुहोस्।\</ahelp\> तपाईँले संस्करणलाई बचत गर्नका लागि \<emph\>फाइल - संस्करणहरू\</emph\> रोज्न सक्नुहुन्छ । कागजातको संस्करणहरू पढ्ने मात्र मोडमा खोलिन्छन् ।				2002-02-02 02:02:02
