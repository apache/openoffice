helpcontent2	source\text\shared\autopi\01050100.xhp	0	help	par_id3149388				0	ne	\<ahelp hid=\"SD:RADIOBUTTON:DLG_ASS:RB_PAGE1_EMPTY\"\>नयाँ (खाली) प्रस्तुतीकरण सिर्जना गर्दछ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\01050100.xhp	0	help	par_id3150256				0	ne	\<ahelp hid=\"SD:CHECKBOX:DLG_ASS:CB_PREVIEW\"\>वर्णन गर्दछ कि पूर्वावलोकन सञ्झ्याल भित्र टेम्प्लेटहरू देखापर्दछ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\01050100.xhp	0	help	par_id3150503				0	ne	\<ahelp hid=\"HID_SD_AUTOPILOT_TEMPLATES\"\>प्रस्तुतीकरणहरूका लागि उपलब्ध टेम्प्लेट कोटिहरूको सूची बनाउँदछ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\01050100.xhp	0	help	par_id3152594				0	ne	\<ahelp hid=\"HID_SD_AUTOPILOT_PAGE1\"\>प्रस्तुतीकरण प्रकार वर्णन गर्दछ र टम्प्लेट चयन गर्न तपाईँलाई अनुमति दिन्छ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\01050100.xhp	0	help	par_id3153061				0	ne	\<ahelp hid=\"SD:CHECKBOX:DLG_ASS:CB_STARTWITH\"\>वर्णन गर्दछ कि तपाईँ विजार्ड मात्र सुरु गर्न चाहनुहुन्छ जब तपाईँले मात्र विइजार्ड सुरु गर्न चाहनुहुन्छ जब तपाईँ यसलाई \<emph\>फाइल - विजार्ड - प्रस्तुतीकरण\</emph\> सँग खुलेर अनुमति लिनुहुन्छ ।\</ahelp\> यो फाँट त्यतिबेला मात्र दृश्यात्मक हुन्छ जब तपाईँले \<emph\>फाइल - नयाँ - प्रस्तुतीकरण\</emph\> रोजेरप्रस्तुतीकरण सिर्जना गर्नुहुन्छ । तपाईँले \<emph\>विजार्डसँग सुरु गर्नुहोस्\</emph\> जाँच बाकससँगै \<emph\>उपकरणहरू - विकल्प - %PRODUCTNAME छाप - सामान्य\</emph\> भित्र संवाद देखाउने कि पनि वर्णन गर्न सक्नुहुन्छ ।				2002-02-02 02:02:02
