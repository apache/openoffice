helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3151282	36			0	ne	\<ahelp hid=\".uno:Bib/Mapping\"\>एउटा भिन्न डेटा स्रोतबाट डेटा फाँटहरूमा स्तम्भ शीर्षकहरू मानचित्रांकित गर्न अनुमति दिन्छ । तपाईँको सन्दर्भ सूचीका लागि एउटा भिन्न डेटा स्रोत परिभाषित गर्न, रेकर्ड\<emph\> वस्तु पट्टि\</emph\> को \<emph\> डेटा स्रोत\</emph\> बटनमा क्लिक गर्नुहोस्।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3152920				0	ne	\<ahelp hid=\"HID_BIB_AUTHORITYTYPE_POS\"\>तपाईँले सिर्जना गर्न चाहनु भएको रेकर्डको प्रकार चयन गर्नुहोस्। $[officename]ले\<emph\>प्रकार\</emph\>मा एउटा सङ्ख्या घुसाँउछ तपाईँले चयन गरेको जुन रेकर्डको स्तम्भ हो जसलेन प्रकारलाई मिलान गर्छ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3153223	40			0	ne	\<ahelp hid=\"SID_ON_OPENDOC\"\>$[officename] मा दर्ता भएका डेटा स्रोतहरू मात्र सूचीबद्ध गरिएको छ । सूचीमा एउटा डेटा स्रोत थप गर्न, \<emph\>उपकरणहरू – डेटा स्रोतहरू\</emph\>.\</ahelp\> रोज्नुहोस्् ।				2002-02-02 02:02:02
