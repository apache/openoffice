helpcontent2	source\text\simpress\02\10080000.xhp	0	help	par_id3151108				0	ne	\<image id=\"img_id3150987\" src=\"res/commandimagelist/sc_polygon_diagonal_unfilled.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3150987\"\>प्रतिमा\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\simpress\02\10080000.xhp	0	help	par_id3151267				0	ne	\<ahelp hid=\".uno:Polygon_Diagonal\"\>सिधा रेखा खण्डहरूको समाविष्ट एउटा बन्द गरिएको आकार कोर्दछ.जुन ४५ डिग्रीको कोण अनुसार समाविष्ट गरिएका छन, तपाईँंले बहुभुज सुरु गर्न चाहेको ठाउँमा क्लिक गर्नुहोस् , र एउटा रेखा खण्ड कोर्न तान्नुहोस । रेखा खण्डहरूको अन्त्य परिभाषित गर्न फेरि क्लिक गर्नुहोस् , बहुभुजको बाँकि रहेका रेखाखण्ड परिभाषित गर्न क्लिक गर्ने कामलाइ निरन्तरता दिनुहोस. बहुभुज कोर्ने काम समाप्त गर्न डबल-क्लिक गर्नुहोस । एउटा बहुभुज कोर्न जुन ४५ डिग्रीको कोणमा नियन्त्रित गरिएको छैन ,सिफ्ट तल राख्नुहोस जहिले तपाईँंले क्लिक गर्नुहुन्छ.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\simpress\02\10080000.xhp	0	help	par_id3152926				0	ne	बहुभुज, भरिएको				2002-02-02 02:02:02
helpcontent2	source\text\simpress\02\10080000.xhp	0	help	par_id3153083	8			0	ne	\<emph\>पङ्क्ति र फाइलिङ\</emph\> पट्टीमा \<emph\>क्षेत्र शैली/फाइलिङ\</emph\> बाकसमा प्रदर्शन भएको बन्द आकारमा स्वचालित रूपले भराई प्राप्त गर्दछन् ।				2002-02-02 02:02:02
