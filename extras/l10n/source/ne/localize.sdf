helpcontent2	source\text\swriter\01\04120213.xhp	0	help	par_id3153677				0	ne	\<ahelp hid=\"SW:RADIOBUTTON:TP_TOX_SELECT:RB_FROMCAPTIONS\"\>वस्तु क्याप्सनहरूबाट अनुक्रमणिका प्रविष्टीहरू सिर्जना गर्दछ।\</ahelp\> एउटा वस्तुमा एउटा क्याप्सन थप गर्नलाई वस्तु चयन गर्नुहोस् र त्यसपछी \<emph\>घुसाउनुहोस् - क्याप्सन\</emph\> रोज्नुहोस्।				2002-02-02 02:02:02
