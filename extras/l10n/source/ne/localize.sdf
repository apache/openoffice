helpcontent2	source\text\shared\01\02060000.xhp	0	help	par_id3147834	5			0	ne	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>स्प्रेडसिटमा, जब तपाईँले क्लिपबोर्डबाट कक्षका दायरा टाँस्नुहुन्छ, परिणाम हालको चयनमा निर्भर गर्दछ: यदि एउटा मात्र कक्ष चयन गरिन्छ भने, कक्ष दायरा त्यो कक्षबाट टाँस्न सुरु हुनेछ । यदि तपाईँले कक्ष दायरा क्लिकबोर्डमा कक्ष दायरा भन्दा चौडा चिनो लगाउनु भयो भने, कक्ष दायरा चयन गरिएको कक्ष दायरा भर्न बारम्बार टाँसिनेछ । \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
