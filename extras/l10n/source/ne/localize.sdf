helpcontent2	source\text\shared\01\05210400.xhp	0	help	par_id3148924				0	ne	\<ahelp hid=\"SVX:PUSHBUTTON:RID_SVXPAGE_HATCH:BTN_ADD\"\>हालको सूचीमा एउटा अनुकूल ह्याचिंग बान्की थप्दछ । तपाईँको ह्याचिंग बान्कीको गुणहरू निर्दिष्ट गर्नुहोस् र त्यसपछि यो बटनमा क्लिक गर्नुहोस्।\</ahelp\>				2002-02-02 02:02:02
