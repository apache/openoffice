helpcontent2	source\text\shared\01\05290300.xhp	0	help	par_id3146856				0	ne	\<variable id=\"betretentext\"\>\<ahelp hid=\".uno:EnterGroup\" visibility=\"visible\"\>चयन गरिएको समूह खोल्दछ, ता कि तपाईँले अलग वस्तुहरू खोल्नुहोस् । यदि चयन गरिएको समूहहरूमा नेस्ट गरिएको समूह समाहित छ भने, तपाईँले यो आदेश उपसमूहहरूमा दोहोर्याउन सक्नुहुन्छ ।\</ahelp\>\</variable\> यो आदेशले स्थायी रूपमा वस्तुहरूको समूह छुट्ट्याउँदैन्				2002-02-02 02:02:02
