helpcontent2	source\text\shared\02\09070200.xhp	0	help	par_id3149955				0	ne	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_HYPERLINK_MAIL_RB_LINKTYP_NEWS\"\> हाइपरलिङ्क सम्म एउटा समाचार ठेगाना मानाङ्कन गर्दछ। \</ahelp\> कागजातमा भएको हाइपरलिङ्कमा क्लिक गर्दा  तपाईँंले प्रविष्टि गरेको \<emph\>Receiver\</emph\> फाँटमा समाचार समूहका लागि एउटा नयाँ सन्देश कागजात खोल्ने छ।				2002-02-02 02:02:02
