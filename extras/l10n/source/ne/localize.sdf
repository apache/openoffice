helpcontent2	source\text\scalc\01\04070400.xhp	0	help	par_id3150868				0	ne	\<variable id=\"beschtext\"\>\<ahelp hid=\".uno:DefineLabelRange\"\>संवाद खोल्नुहोस् जसलाई तपाईँं लेबुल दायरामा परिभाषित गर्न सक्नुहुन्छ\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070400.xhp	0	help	par_id3154703				0	ne	\<ahelp hid=\"SC:EDIT:RID_SCDLG_COLROWNAMERANGES:ED_DATA\"\>डेटा दायरा सेट गर्दछ जसका लागि चयनगरेको लेबुल दायरा वैध हुन्छ । यसलाई परिमार्जन गर्न पानामा क्लिक गर्नु होस् र माउस सहितको अर्को दायरा चयन गर्नु होस् ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070400.xhp	0	help	par_id3154731				0	ne	\<ahelp hid=\"SC:EDIT:RID_SCDLG_COLROWNAMERANGES:ED_AREA\"\>प्रत्येक लेबुल दायराको कक्ष सन्दर्भ प्रदर्शन गर्दछ । \</ahelp\>यस क्रममा सूची बाकसबाट लेबुल दायराहरू हटाउन लाई यसलाई \<emph\>मेट्नुहोस्\</emph\> चयन गरेर क्लिक गर्नुहोस् ।				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070400.xhp	0	help	par_id3154754				0	ne	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_COLROWNAMERANGES:BTN_ROWHEAD\"\>हालको लेबुल दायरामा पङ्क्ति लेबुलहरू संलग्न गर्दछ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070400.xhp	0	help	par_id3155411				0	ne	लेबुल दायराको कक्ष सामग्रीहरू नामहरूको रूपमा $[officename]मा प्रयोग गर्न सकिन्छ तिनीहरूले नामहरू उही आचरणमा सङठित गर्न् जसमा यसले हप्तादिनहरू र महिनाहरूको पूर्वपरिभाषित नामहरूको काम गर्दछ । जब सूत्रमा टाइप गरिन्छ ती नामहरूले स्वचालित रूपमा नै पूरा हुन्छन् । थपमा, लेबुल दायराद्वारा परिभाषित नामहरू स्वाचालित रूपमा उत्पादित नामहरूद्वारा परिभाषित नामहरूको प्राथमिकतामा पर्ने छन् ।.				2002-02-02 02:02:02
