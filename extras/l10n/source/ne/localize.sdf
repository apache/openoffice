helpcontent2	source\text\swriter\01\04090001.xhp	0	help	par_id3150678	28			0	ne	\<ahelp hid=\"SW:LISTBOX:TP_FLD_DOK:LB_DOKSELECTION\"\>प्रकार सूचीमा चयन गरेको फाँट प्रकारको उपलब्ध फाँटहरू सूची गर्नुहोस्. \<emph\>\</emph\>फाँट घुसाउनका लागि, फाँट क्लिक गर्नुहोस्, र पछि क्लिक गर्नुहोस् \<emph\>Insert\</emph\>.\</ahelp\>				2002-02-02 02:02:02
