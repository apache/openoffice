helpcontent2	source\text\swriter\01\04070000.xhp	0	help	par_id3149289				0	ne	\<variable id=\"briefum\"\>\<ahelp hid=\".uno:InsertEnvelope\"\>खाम निर्माण गर्नुहोस्.\</ahelp\> तीन पाठ पृष्ठहरूमा, तपाईँं प्रेषिती र प्रेषक निर्धारित गर्न सक्नुहुन्छ,  स्थान र ढाँचा दुबै प्रषितीका लागि, खामको साइज, र खामको पृष्ठबिन्यास. \</variable\>				2002-02-02 02:02:02
