helpcontent2	source\text\shared\01\06150200.xhp	0	help	par_id3144436				0	ne	\<ahelp hid=\"HID_XML_FILTER_TEST_EXPORT_BROWSE\"\>तपाईँले XML निर्यात फिल्टरमा लागू गर्न चाहेको फाइल स्थित गर्नुहोस् बदलिएको फाइलको XML सङ्केत \<link href=\"text/shared/01/06150210.xhp\"\>XML फिल्टर निर्गत\</link\> सञ्झ्यालमा प्रदर्शित हुन्छ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06150200.xhp	0	help	par_id3146137				0	ne	\<ahelp hid=\"HID_XML_FILTER_TEST_IMPORT_RECENT\"\>यो संवाद सहित अन्तिम खोलिएको कागजात पुन-खोल्दछ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06150200.xhp	0	help	par_id3147250				0	ne	\<ahelp hid=\"HID_XML_FILTER_TEST_EXPORT_CURRENT\"\>सबभन्दा अगाडिको खुला फाइल जसले XML फिल्टर मापदण्ड पूरा गर्दछ त्यो फिल्टर परिक्षण गर्न प्रयोग गरिनेछ । हालको XML निर्यात फिल्टरले फाइल बदल्दछ र परिणाम दिने XML सङ्केत \<link href=\"text/shared/01/06150210.xhp\"\>XML फिल्टर निर्गत\</link\> सञ्झ्यालमा प्रदर्शित हुन्छ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06150200.xhp	0	help	par_id3149885				0	ne	\<ahelp hid=\"HID_XML_FILTER_TEST_IMPORT_BROWSE\"\>एउटा फाइल चयन संवाद खोल्दछ । चयन गरिएको फाइल हालको XML आयात फिल्टर प्रयोग गरेर खोलिन्छ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06150200.xhp	0	help	par_id3150444				0	ne	\<ahelp hid=\"HID_XML_FILTER_TEST_IMPORT_DISPLAY_SOURCE\"\> \<embedvar href=\"text/shared/01/06150210.xhp#xmlfilteroutput\"/\> सञ्झ्याल खोल्दछ, जहाँ चयन गरिएको कागजातको XML स्रोत प्रदर्शित हुन्छ । कागजात आयात फिल्टर परीक्षण गर्न प्रयोग गरिन्छ ।\</ahelp\> सञ्झ्याल\<emph\>वैध गर्नुहोस्\</emph\> बटनले कागजातको XML स्रोत OpenOffice.org DTD को विरुद्धमा वैध गर्दछ ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06150200.xhp	0	help	par_id3153681				0	ne	\<ahelp hid=\"HID_XML_FILTER_TEST_EXPORT_CURRENT\"\> XSLT फिल्टरको फाइल नाम प्रदर्शन गर्छ जुन तपाईँले \<emph\>रूपान्तरण\</emph\> ट्याब पृष्ठमा प्रविष्टि गर्नुभएको छ । \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06150200.xhp	0	help	par_id3156410				0	ne	\<ahelp hid=\"HID_XML_FILTER_TEST_EXPORT_CURRENT\"\>टेम्प्लेटको फाइल नाम प्रदर्शन गर्छ जुन तपाईँले \<emph\>रूपान्तरण\</emph\>ट्याब पृष्ठमा प्रविष्टि गर्नु भएको छ ।\</ahelp\>				2002-02-02 02:02:02
