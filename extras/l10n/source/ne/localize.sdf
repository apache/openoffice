helpcontent2	source\text\shared\01\05020400.xhp	0	help	par_id3153257				0	ne	\<ahelp hid=\"SW:PUSHBUTTON:TP_CHAR_URL:PB_EVENT\"\>तपाईँले हाइपरलिङ्कमा क्लिक गर्दा ट्रिगर हुने एउटा घटना निर्दिष्ट गर्नुहोस्।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020400.xhp	0	help	par_id3153332				0	ne	\<variable id=\"texturl\"\>\<ahelp hid=\"SW:EDIT:TP_CHAR_URL:ED_URL\"\>तपाईँले हाइपरलिङ्क क्लिक गर्दा तपाईँले खोल्न चाहेको फाइलका लागि एउटा \<link href=\"text/shared/00/00000002.xhp#url\" name=\"URL\"\>URL\</link\> प्रविष्ट गर्नुहोस्।\</ahelp\> यदि तपाईँले एउटा लक्ष्य फ्रेम निर्दिष्ट गर्नुहुन्न भने,फाइल हालको कागजात वा फ्रेममा खुल्दछ । \</variable\>				2002-02-02 02:02:02
