helpcontent2	source\text\shared\autopi\webwizard01.xhp	0	help	par_idN10565				0	ne	\<link href=\"text/shared/autopi/webwizard02.xhp\"\>वेब विजार्ड - कागजातहरू\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard01.xhp	0	help	tit				0	ne	वेब विजार्ड - सूचना				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN10547				0	ne	\<link href=\"text/shared/autopi/webwizard02.xhp\"\>वेब विजार्ड - कागजातहरू\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN10557				0	ne	तपाईँले आफ्नो वेब साइटमा अपलोड गर्न चाहनु भएको फाइलहरू चयन गर्नुहोस् । तपाईँले सर्भर वा स्थानिय निर्देशिकामा फाइलहरू अपलोड गर्न सक्नुहुन्छ ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN1055A				0	ne	कागजातहरू				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN1055E				0	ne	\<ahelp hid=\"34210\"\>तपाईँले आफ्नो वेब साइटमा प्रकाशन गर्न चाहनु भएको कागजातहरू सूचीत गर्दछ । कागजातहरू अपलोडेड गर्नु अघि विजार्ड %PRODUCTNAME कागजातहरू HTML, PDF, वा केही केसहरूमा, फ्ल्यास ढाँचामा रूपान्तरण गर्न सक्छ । सबै अन्य फाइलहरू तिनीहरूको वास्तविक फाइल ढाँचामा अपलोड हुन्छ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN10561				0	ne	थप्नुहोस्				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN10565				0	ne	\<ahelp hid=\"34211\"\>संवाद खोल्दछ जहाँ तपाईँले आफ्नो वेब साइटमा राख्न चाहनु भएको फाइलहरू चयन गर्न सक्नुहुन्छ । सूचीको क्रमले क्रम निर्धारन गर्दछ जसमा कागजातहरूमा हाइपरलिङ्कहरू तपाईँको वेब साइटको अनुक्रमणिका पृष्ठमा प्रदर्शन हुन्छ ।\</ahelp\>				2002-02-02 02:02:02
