helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3154022				0	ne	\<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_CONVERTTOGREYSCALES\"\>मुद्रण प्रारम्भ भन्दा पहिले कुन रङ देखा पर्दछ भन्ने कुरा वर्णन गर्दछ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3154270				0	ne	\<ahelp hid=\"SFX2_LISTBOX_TP_COMMONPRINTOPTIONS_LB_REDUCEBITMAPS_RESOLUTION\"\>अधिकतम मुद्रण गुणलाई dpi मा वर्णन गर्दछ। रिज्योल्यूसन घटाउन मात्र सकिन्छ र बढाउन सकिँदैन।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3154510	76			0	ne	\<ahelp hid=\"SFX2_RADIOBUTTON_TP_COMMONPRINTOPTIONS_RB_REDUCEBITMAPS_NORMAL\"\>उच्च मुद्रण गुण 300dpi सँग मिल्दछ। साधारण मुद्रण गुण 200dpi को रिजोल्युसन सँग मिल्दछ। \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3154910				0	ne	तपाईँंले मुद्रकमा पठाउनका लागि डेटाको मात्रा घटाउन सक्नुहुन्छ।मुद्रण डेटा घटाउनुले मुद्रण गति बढाउँछ किनकी मुद्रण फाइलहरू साना हुन्छन।यसले थोरै स्मृति बाट मुद्रण गर्नलाई मुद्रणलाई सजिलो पार्दछ। मुद्रण डेटा घटाउनुले मुद्रण गुण परिणाममा थोरै असर गर्न सक्दछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3156382				0	ne	\<ahelp hid=\"SFX2_NUMERICFIELD_TP_COMMONPRINTOPTIONS_NF_REDUCEGRADIENTS_STEPCOUNT\"\>मुद्रणका लागि ग्रेडियन्ट स्ट्रिप्सको अधिकतम सङ्ख्या वर्णन गर्दछ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3156444				0	ne	पारदर्शिता एउटा मुद्रकमा सिधै निर्गत गर्न सकिँदैन। पारदर्शिता दृश्य हुनुपर्ने कागजातको क्षेत्रहरू त्यसपछि बिटम्यापमा गणना हुनै पर्दछ र मुद्रणमा पठाईनु पर्दछ। बिटम्यापको साइज र मुद्रण रिजोल्युसनमा निर्भर गरेर एउटा ठुलो मात्रमा डेटा परिणत हुन सक्छ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3158407				0	ne	\<ahelp hid=\"SFX2_RADIOBUTTON_TP_COMMONPRINTOPTIONS_RB_PRINTFILEOUTPUT\"\>सिधै मुद्रण वा एउटा फाइल मुद्रण गर्न मुद्रण सेटिङहरू लागू हुन्छ कि भन्ने बारेमा वर्णन गर्दछ। \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3159154				0	ne	\<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_REDUCETRANSPARENCY\"\>यदि तपाईँंले यो फाँटलाई चिनो गर्नुभयो भने पारदर्शी वस्तुहरू सामान्य, अ-पारदर्शी वस्तुहरू जस्तै गरी निम्न दुई विकल्प बटन भित्र छनोटमा निर्भर गरेर मुद्रण हुनेछन।\</ahelp\>				2002-02-02 02:02:02
