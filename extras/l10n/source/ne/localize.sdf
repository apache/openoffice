helpcontent2	source\text\shared\01\02230500.xhp	0	help	par_id3154408				0	ne	\<variable id=\"dokzus\"\>\<ahelp hid=\".uno:MergeDocuments\" visibility=\"visible\"\>मौलिक कागजातमा उस्तै कागजातको प्रतिलिपिहरूमा गरिएको परिवर्तनहरू आयात गर्दछ । पादटिप्पणीहरू, हेडरहरू, फ्रेमहरू र फाँटहरूमा गरिएको परिवर्तनहरू बेवास्ता गरिन्छ ।\</ahelp\>\</variable\> उस्तै परिवर्तनहरू स्वचालित रूपमा गाभिन्छ ।				2002-02-02 02:02:02
