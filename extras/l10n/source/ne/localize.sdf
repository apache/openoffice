helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_id3144766				0	ne	\<ahelp hid=\".uno:FontColor\" visibility=\"hidden\"\>\<variable id=\"textfarbe\"\>चयन गरिएको क्यारेक्टरहरूमा हालको फन्ट रङ लागू गर्न क्लिक गर्नुहोस्। तपाईँले यहाँ पनि क्लिक गर्न सक्नुहुन्छ, र त्यसपछि पाठ रङ परिवर्तन गर्न एउटा चयनलाई तान्नुहोस् \<emph\>फन्ट रङ \</emph\>उपकरणपट्टी खोल्न प्रतिमाको पछिल्लो बाँणमा क्लिक गर्नुहोस्। \</variable\>\</ahelp\>				2002-02-02 02:02:02
