helpcontent2	source\text\shared\optionen\01050100.xhp	0	help	par_id3150592				0	ne	\<ahelp hid=\".uno:HelplinesFront\"\>\<switchinline select=\"appl\"\>\<caseinline select=\"DRAW\"\>सबै वस्तुहरूको आगाडी स्न्याप हरफहरू सेट गर्दछ। \</caseinline\>\<caseinline select=\"IMPRESS\"\>सबै वस्तुहरूको आगाडी स्न्याप हरफहरू सेट गर्दछ। \</caseinline\>\</switchinline\>\</ahelp\>				2002-02-02 02:02:02
