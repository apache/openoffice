helpcontent2	source\text\swriter\01\05030400.xhp	0	help	par_id3154554				0	ne	\<ahelp hid=\"SW_CHECKBOX_TP_DROPCAPS_CB_WORD\"\>अनुच्छेदमा पहिलो शव्दको पहिलो अक्षर एउटा ड्रप क्यापको रूपमा प्रदर्शन गर्दछ, र शव्दको बाँकी अक्षरहरू ठुलो प्रकारको रूपमा प्रदर्शन गर्दछ।\</ahelp\>				2002-02-02 02:02:02
