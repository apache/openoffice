helpcontent2	source\text\shared\01\06130000.xhp	0	help	par_id3153257				0	ne	\<ahelp hid=\"BASCTL_PUSHBUTTON_RID_MACROCHOOSER_RID_PB_DEL\"\>एउटा नयाँ मोड्युल वा म्याक्रो सिर्जना गर्दछ, वा चयन गरिएको म्याक्रो मेट्दछ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06130000.xhp	0	help	par_id3153394				0	ne	\<ahelp hid=\"HID_BASICIDE_LIBS\"\>लाइब्रेरीहरू र मोड्युलहरू सूचीबद्ध गर्दछ जहाँ तपाईँले तपाईँको म्याक्रोहरू खोल्न वा बचत गर्न सक्नुहुन्छ. एउटा निश्चित कागजात सँग एउटा म्याक्रो बचत गर्न, कागजात खोल्नुहोस्, र त्यसपछि यो संवाद खोल्नुहोस् ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06130000.xhp	0	help	par_id3153577				0	ne	\<ahelp hid=\"BASCTL_PUSHBUTTON_RID_MACROCHOOSER_RID_PB_ASSIGN\"\> \<link href=\"text/shared/01/06140000.xhp\" name=\"Customize\"\>अनुकूलन गर्नुहोस्\</link\> संवाद खोल्दछ, जहाँ तपाईँले एउटा मेनु आदेश, एउटा सर्टकट कुञ्जी संयोजन वा एउटा घटना मानाङ्कन गर्न सक्नुहुन्छ ।\</ahelp\>				2002-02-02 02:02:02
