desktop	source\migration\wizard.src	0	fixedtext	TP_MIGRATION	FT_MIGRATION_BODY			0	ne	%OLDPRODUCT स्थापनाबाट धेरै जसो व्यक्तिगत डेटा %PRODUCTNAME %PRODUCTVERSION मा पुन: प्रयोग गर्न सकिन्छ ।\n\nयदि तपाईँले %PRODUCTNAME %PRODUCTVERSION मा कुनै पनि सेटिङहरू पुन: प्रयोग गर्न चाहनुहुन्न भने, जाँच बाकसबाट चिनो हटाउनुहोस् ।				2002-02-02 02:02:02
