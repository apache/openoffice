helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3144511				0	ne	यदि तपाईँंले चाहेको ढाँचा सूचीकृत नगरिएको भए,"Other Formats..." चयन गर्नुहोस र  \<link href=\"text/shared/01/05020300.xhp\" name=\"Number Format\"\>\<emph\>अंक ढाँचा\</emph\>\</link\> संवादमा चाहेको ढाँचा परिभाषित गर्नुहोस।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3148685	24			0	ne	\<ahelp hid=\"SW_IMAGEBUTTON_DLG_AP_INSERT_DB_SEL_IB_DBCOL_ONE_FROM\"\> चयन गरिएका डाटाबेस फाँटलाई \<emph\>तालिका स्तम्भ(हरू) \</emph\> सूची बाकस\</ahelp\> बाट हटाउँदछ। हटाईएको फाँट कागजात भित्र घुसाईएन।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3149415				0	ne	\<ahelp hid=\"SW:RADIOBUTTON:DLG_AP_INSERT_DB_SEL:RB_DBFMT_FROM_DB\"\>डाटाबेस ढाँचा स्विकार गर्दछ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3149750				0	ne	\<ahelp hid=\"SW_IMAGEBUTTON_DLG_AP_INSERT_DB_SEL_IB_DBCOL_ALL_TO\"\> सबै सूचीकृत डाटाबेस फाँटहरूलाई \<emph\>तालिका स्तम्भ(हरू)\</emph\> सूची बाकस भित्र सर्दछ। \</ahelp\> सूची बाकस\<emph\>तालिका स्तम्भ(हरू)\</emph\> मा सूचीकृत सबै फाँटहरू कागजात भित्र घुसाईन्छ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3150497				0	ne	\<ahelp hid=\"SW:CHECKBOX:DLG_AP_INSERT_DB_SEL:CB_TABLE_HEADON\"\>या पाठ तालिकामा स्तम्भहरूका लागि एउटा शीर्षक रेखा घुसाउने भन्ने बारेमा वर्णन गर्दछ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3152349				0	ne	\<ahelp hid=\"SW:LISTBOX:DLG_AP_INSERT_DB_SEL:LB_DBFMT_FROM_USR\"\>यदि निश्चित डेटा फाँटहरूको सूचना स्विकार नगरिएमा,सूचीबाट एउटा ढाँचा वर्णन गर्दछ। \</ahelp\> यहा पूर्ति गरिएको ढाँचाहरू मात्र केही डाटाबेस फाँटहरू जस्तै: सङ्ख्यासूचक वा बुलियन फाँटहरूका लागि उपलब्ध हुन्छन। यदि तपाईँंले पाठ ढाँचामा एउटा डाटाबेस फाँट चयन गर्नुभएमा,पाठ ढाँचा स्वचालित तवरले सम्बर्धन नहुँदासम्म तपाईँंले चयन सूचीबाट कुनै ढाँचा चयन गर्न सक्षम हुनुहुने छैन।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3152425	20			0	ne	\<ahelp hid=\"SW:LISTBOX:DLG_AP_INSERT_DB_SEL:LB_TBL_DB_COLUMN\"\> पाठ तालिका भित्र घुसाईनका लागि डाटाबेस स्तम्भहरू वर्णन गर्दछ। \</ahelp\> \<emph\>तालिका स्तम्भ(हरू)\</emph\>सूची बाकसमा अस्विकार्य सबै डाटाबेस तालिकाहरू यहाँ सूचीकृत गरिएका छन। प्रविष्टिहरू बर्णानुक्रमानुसार क्रमबद्ध गरिएका छन।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3152918				0	ne	\<emph\>Table\</emph\> क्षेत्रमा, तपाईँंले पाठ तालिकामा लागू गर्न चाहेको डाटाबेसको स्तम्भ चयन गर्नुहोस।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3152922				0	ne	\<ahelp hid=\"SW:RADIOBUTTON:DLG_AP_INSERT_DB_SEL:RB_HEADL_COLNMS\"\> हरेक पाठ तालिका स्तम्भहरूका लागि डाटाबेस तालिकाको फाँट नामहरू शीर्षकको रूपमा प्रयोग गर्दछ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3153194	29			0	ne	\<ahelp hid=\"SW:RADIOBUTTON:DLG_AP_INSERT_DB_SEL:RB_HEADL_EMPTY\"\> पाठ तालिका भित्र एउटा खाली हेडिङ रेखा घुसाउँदछ। \</ahelp\> \<emph\> पङ्क्ति मात्र सिर्जना गर्नुहोस\</emph\> विकल्प प्रयोग गरेर, तपाईँंले कागजातमा शीर्षक परिभाषित गर्न सक्नुहुन्छ,जुन डेटाबेश फाँट सँग सम्बन्धित हुँदैन।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3153527				0	ne	\<ahelp hid=\"SW:LISTBOX:DLG_AP_INSERT_DB_SEL:LB_TABLE_COL\"\>कागजात भित्र घुसाउनका लागि सबै डाटाबेस स्तम्भहरू सूचीकृत गर्नुहोस\</ahelp\> तालिकामा एउटा स्तम्भ सम्बन्धित प्रविष्टि लाई मानाङ्कन गरिनेछ।\<emph\>तालिका स्तम्भ(हरू)\</emph\> सूची बाकसमा प्रविष्टिले पाठ तालिकामा डेटा क्रम निर्धारण गर्दछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3153662	23			0	ne	\<ahelp hid=\"SW_IMAGEBUTTON_DLG_AP_INSERT_DB_SEL_IB_DBCOL_ONE_TO\"\> चयन गरिएका डाटाबेस फाँटलाई \<emph\>तालिका स्तम्भ(हरू)\</emph\> सूची बाकस भित्र सर्दछ। \</ahelp\> तपाईँंले यसलाई \<emph\>तालिका स्तम्भ(हरू)\</emph\> सूची बाकसमा सार्नका लागि एउटा प्रविष्टिलाई डबल-क्लिक गर्न सक्नुहुन्छ। \<emph\>तालिका स्तम्भ(हरू)\</emph\> सूची बाकसमा सूचीकृत गरिएका सबै फाँटहरू कागजात भित्र घुसाईएका छन्.				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3154138				0	ne	एउटा तालिकाको रूपमा कागजात भित्र डेटा घुसाउनका लागि, ठीक \<emph\>तालिका\</emph\> विकल्प सक्रिय हुनै पर्दछ। तपाईँंले त्यसपछि \<emph\>तालिका स्तम्भ(हरू)\</emph\> सूची बाकसबाट डाटाबेस फाँट डाटाबेस फाँटको ढाँचा परिभाषित गर्नका लागि चयन गर्न सक्नुहुन्छ। अंक चयनमा भएको परिवर्तन अन्तिम चयनमा लागू हुन्छ। यसले  \<emph\>डाटाबेस स्तम्भ\</emph\> सूची बाकसबाट वा  \<emph\>तालिका स्तम्भ(हरू)\</emph\> सूची बाकस जुन चाहीबाट डाटाबेस फाँट चयन गरेपनि मतलव राख्दैन।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3154282				0	ne	चयन सूची प्रयोग गरेर मानाङ्कन गरिएको अंक ढाँचाले सधै  \<emph\>डाटाबेस स्तम्भहरू\</emph\> सूची बाकसमा चयन गरिएको डाटाबेस सन्दर्भ गर्दछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3154299				0	ne	\<ahelp hid=\"SW:PUSHBUTTON:DLG_AP_INSERT_DB_SEL:PB_TBL_FORMAT\"\> \<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<link href=\"text/swriter/01/05090000.xhp\" name=\"Table Format\"\>\<emph\>तालिका ढाँचा\</emph\>\</link\>\</caseinline\>\<defaultinline\>\<emph\>तालिका ढाँचा\</emph\>\</defaultinline\>\</switchinline\> संवाद खोल्दछ,जसले तपाईँंलाई तालिका गुणहरू जस्तै: किनाराहरू,पृष्ठभूमि,र स्तम्भ चौडाइ परिभाषित गर्नका लागि सक्षम पार्दछ। \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3154380				0	ne	कागजात भित्र डाटाबेस फाँटहरू घुसाउनका लागि ढाँचा वर्णन गर्दछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3154897				0	ne	\<ahelp hid=\"SW_IMAGEBUTTON_DLG_AP_INSERT_DB_SEL_IB_DBCOL_ALL_FROM\"\>सबै डाटाबेस फाँटहरूलाई \<emph\>तालिका स्तम्भ(हरू)\</emph\> सूची बाकसबाट हटाउँदछ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3154988				0	ne	\<ahelp hid=\"SW:PUSHBUTTON:DLG_AP_INSERT_DB_SEL:PB_TBL_AUTOFMT\"\>Opens the \<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<link href=\"text/swriter/01/05150101.xhp\" name=\"AutoFormat\"\>\<emph\>AutoFormat\</emph\>\</link\>\</caseinline\>\<defaultinline\>\<emph\>AutoFormat\</emph\>\</defaultinline\>\</switchinline\> dialog, in which you can select format styles that are immediately applied when inserting the table.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3156183	18			0	ne	\<ahelp hid=\"SW:RADIOBUTTON:DLG_AP_INSERT_DB_SEL:RB_AS_TABLE\" visibility=\"hidden\"\> डेटा स्रोत ब्राउजरबाट चयन गरिएका डेटालाई कागजात भित्र एउटा तालिकाको रूपमा प्रविष्टि गर्दछ। \</ahelp\> \<emph\>डाटाबेस स्तम्भहरू घुसाउनुहोस\</emph\> संवादमा,चयन गरिएका डेटालाई कागजात भित्र एउटा तालिकाको रूपमा प्रविष्टि गर्नका लागि \<emph\>तालिका\</emph\> विकल्प चयन गर्नुहोस। संवादमा,तपाईँंले कुन डाटाबेस फाँटहरू वा स्तम्भहरू स्थानान्तरण गर्ने भन्ने कुरा निर्णय गर्न सक्नुहुन्छ, र कसरी पाठ तालिका ढाँचाबद्ध गर्ने भन्ने कुरा पनि निर्धारण गर्न सक्नुहुन्छ्। 				2002-02-02 02:02:02
