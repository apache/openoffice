helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3147167	2			0	ne	\<variable id=\"fussnoteein\"\>\<ahelp hid=\".uno:InsertFootnote\"\>कागजातमा पादटिप्पणी वा अन्तटिप्पणी घुसाउनुहोस्. द्रष्टव्यका लागि एङ्कर .\</ahelp\> तपाईँं स्वचालित क्रमाङ्कन वा अनुकूलन प्रतीक बीचमा रोज्नुहोस् गर्न सक्नुहुन्छ.\</variable\>				2002-02-02 02:02:02
