helpcontent2	source\text\smath\01\05030000.xhp	0	help	par_id3153818				0	ne	\<variable id=\"abstaendetext\"\>\<ahelp hid=\"SID_DISTANCE\"\>सूत्र तत्वहरू बीच स्पेसिङ निश्चित गर्नका लागि यो संवाद  प्रयोग गर्नुहोस्. आधार साइजसँग सम्बन्धित प्रतिशतको रूपमा स्पेसिङ निश्चित गरिन्छ  \<emph\>ढाँचा - फन्ट साइज तल परिभाषित गरिएको\</emph\>.\</ahelp\>\</variable\>				2002-02-02 02:02:02
