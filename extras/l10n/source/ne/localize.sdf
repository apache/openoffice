helpcontent2	source\text\simpress\02\10120000.xhp	0	help	par_id3145790				0	ne	\<ahelp hid=\".uno:ArrowsToolbox\"\>बाँण the \<emph\>उपकरणपट्टी\</emph\> खोल्नुहोस्, जहाँ तपाईँ सिधा रेखाहरू थप गर्न सक्नुहुन्छ, बाँणसँग रेखाहरू, र हालको स्लाईड वा पृष्ठमा बिकर्ण रेखाहरू.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\simpress\02\10120000.xhp	0	help	par_id3146124				0	ne	\<ahelp hid=\".uno:MeasureLine\"\> मार्गदर्शकहरू अनुसार सिमा गरिएको आयाम लम्बाइ प्रदर्शन गर्ने एउटा रेखा कोर्दछ.\</ahelp\> आयाम रेखाहरू स्वचालित तवरले गणना गरिन्छ र रेखात्मक आयामहरू प्रदर्शन हुन्छ. एउटा आयाम रेखा कोर्न, खोल्नुहोस \<emph\>Arrows\</emph\> उपकरण पट्टि, र क्लिक गर्नुहोस् \<emph\>Dimension Line\</emph\> प्रतिमा,तपाईँंले रेखा सुरु गर्न र आयाम रेखा कोर्न तानेको ठाउँमा माउस सूचक सार्नुहोस्.समाप्त भएपछि छोड्नुहोस्.				2002-02-02 02:02:02
helpcontent2	source\text\simpress\02\10120000.xhp	0	help	par_id3147218				0	ne	\<image id=\"img_id3147224\" src=\"res/commandimagelist/sc_linearrows.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3147224\"\>प्रतिमा\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\simpress\02\10120000.xhp	0	help	par_id3147370				0	ne	\<ahelp hid=\".uno:LineArrowCircle\"\>तपाईँले हालको कागजात तान्नु भएको स्थानमा, बाँण बाट सुरुहुने र वृत्त सँग अन्त्य हुने सीधा लाइन कोर्दछ । ४५ डिग्रीमा लाइन स्थिर राख्न, तपाईँले तानेको बेलामा तल्लो सिफ्ट समात्नुहोस् ।\</ahelp\>				2002-02-02 02:02:02
