helpcontent2	source\text\scalc\01\02110000.xhp	0	help	par_id3153929				0	ne	\<ahelp hid=\"HID_SC_NAVIPI_DOC\"\>सबै खुला कागजातहरूको नाम प्रदर्शन गर्दछ ।\</ahelp\> नेभिगेटरमा अर्को कागजात खोलर स्विच गर्नलाई कागजात नाम क्लिक गर्नुहोस् । कागजातको वस्तुस्थिति (सक्रिय,निस्क्रिय) मान पछाडि कोष्ठकहरूमा देखाइन्छ । तपाईँं \<emph\>सञ्झ्याल\</emph\>मेनुमा सक्रिय कागजात स्विच गर्न सक्नुहुन्छ ।				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02110000.xhp	0	help	par_id3153955				0	ne	\<ahelp hid=\"HID_SC_NAVIPI_SCEN\"\>सबै उपलब्ध परिदृश्य प्रदर्शन गर्दछ । त्यो परिदृश्य लागू गर्न नाम डबल-क्लिक गर्नुहोस् ।\</ahelp\> पानामा परिणाम देखाइन्छ । अरू धेरै जानकारीका लागि \<link href=\"text/scalc/01/06050000.xhp\" name=\"Tools - Scenarios\"\>\<emph\>उपकरणहरू -परिदृश्यहरू\</emph\>\</link\> रोज्नुहोस् ।				2002-02-02 02:02:02
