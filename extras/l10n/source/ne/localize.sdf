helpcontent2	source\text\shared\autopi\startup.xhp	0	help	par_idN105B2				0	ne	प्रयोगकर्ता नाम				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\startup.xhp	0	help	par_idN105B6				0	ne	\<ahelp hid=\".\"\>प्रयोगकर्ता नाम कागजात गुणहरू, टेम्प्लेट, र जब तपाईँले कागजातहरूमा भएको परिवर्तन रेकर्ड गर्नुहुन्छ, तब प्रयोग गरिन्छ । यदि %PRODUCTNAME को पहिलेको स्थापना तपाईँको कम्प्युटरमा फेला परेन भने मात्र यो पृष्ठ प्रदर्शन हुन्छ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\startup.xhp	0	help	par_idN105C8				0	ne	\<ahelp hid=\".\"\>पाठ बाकसहरू भित्र तपाईँवक व्यक्तिगत डेटा प्रविष्ट गर्नुहोस् ।\</ahelp\>				2002-02-02 02:02:02
