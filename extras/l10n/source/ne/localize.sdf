helpcontent2	source\text\shared\02\12090100.xhp	0	help	par_id3147834				0	ne	तपाईँंले रेखाको प्रकार,फाँटको नाम,एउटा वैचारिक सर्त र एउटा मान वा तर्कहरूको समिश्रण ईङित गरेर एउटा फिल्टर परिभाषित गर्न सक्नुहुन्छ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12090100.xhp	0	help	par_id3149177				0	ne	\<ahelp hid=\"DBACCESS_LISTBOX_DLG_FILTERCRIT_LB_WHERECOND3\"\>निम्न तर्कहरूका लागि, तपाईँंले वैचारिक सञ्चालक AND / OR विचमा रोज्न सक्नुहुन्छ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12090100.xhp	0	help	par_id3149398				0	ne	\<ahelp hid=\"DBACCESS_LISTBOX_DLG_FILTERCRIT_LB_WHEREFIELD3\"\> हालको तालिकाबाट फाँट नामहरू तर्कमा सेट गर्नका लागि तिनीहरूलाई वर्णन गर्दछ। \</ahelp\> यदि फाँट नामहरूका लागि कुनै पाठ उपलब्ध नभएमा तपाईँंले स्तम्भ परिचायकहरू देख्नुहुनेछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12090100.xhp	0	help	par_id3149716				0	ne	\<ahelp hid=\".uno:DataFilterStandardFilter\"\> तपाईँंको तालिका डेटा फिल्टर गर्नका लागि वैचारिक सर्तहरू वर्णन गर्दछ। \</ahelp\> यो संवादलाई स्प्रेडसिट कागजातमा \<emph\>उच्चस्तरिय फिल्टर\</emph\> र डाटाबेस तालिकाहरू वा डाटाबेस फारमहरूमा \<emph\>फिल्टर\</emph\> भनिन्छ। \<emph\>फिल्टर\</emph\> संवादमा \<emph\>अरू \</emph\> बटन समावेश हुँदैनन।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12090100.xhp	0	help	par_id3149795				0	ne	\<ahelp hid=\"DBACCESS_EDIT_DLG_FILTERCRIT_ET_WHEREVALUE3\"\>फाँट फिल्टर गर्नका लागि एउटा मान वर्णन गर्दछ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12090100.xhp	0	help	par_id3150254				0	ne	\<ahelp hid=\"DBACCESS_LISTBOX_DLG_FILTERCRIT_LB_WHERECOMP3\"\> \<link href=\"text/shared/02/12090101.xhp\" name=\"comparative operators\"\>तुलनात्मक सञ्चालनकर्ता\</link\> वर्णन गर्दछ जसबाटबाट \<emph\>फाँट नाम\</emph\> र \<emph\>Value\</emph\> फाँटहरूमा प्रविष्टिहरू लिङ्क गर्न सकिन्छ। \</ahelp\> 				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12090100.xhp	0	help	par_id3150976	14			0	ne	\<emph\> Value \</emph\> सूची बाकसमा \<emph\>फाँट नाम\</emph\> का लागि सबै संभाव्य मानहरू समावेश छन। फिल्टरमा प्रयोग गर्नका लागि मान रोज्नुहोस। तपाईँंले  \<emph\>- खाली -\</emph\> वा \<emph\>-खाली छैन -\</emph\> प्रविष्टिहरू रोज्न सक्नुहुन्छ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12090100.xhp	0	help	par_id3154897	16			0	ne	\<emph\>फिल्टर\</emph\> संवादमा  \<emph\>विकल्प\</emph\> बटन समावेश छैन।				2002-02-02 02:02:02
