helpcontent2	source\text\shared\02\02140000.xhp	0	help	par_id3149798				0	ne	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\> यदि थुप्रै अनुच्छेदहरू चयन गरिएमा, सबै चयन गरिएका अनुच्छेदहरूको ईन्डेन्सन बढ्दछ। \</caseinline\>\<caseinline select=\"CALC\"\> कक्ष सामग्री \<link href=\"text/shared/01/05340300.xhp\" name=\"Format - Cell - Alignment\"\>\<emph\>ढाँचा - कक्ष - पङ्क्तिबद्धता\</emph\>\</link\> अन्तर्गत हालको मानलाई स्थगित गर्नेछ।\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
