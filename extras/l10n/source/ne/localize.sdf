helpcontent2	source\text\shared\01\gallery.xhp	0	help	par_id3149783	46			0	ne	\<ahelp hid=\"HID_GALLERY_ICONVIEW\" visibility=\"hidden\"\> \<emph\>संग्राहलय \</emph\>प्रतिमाहरूको रूपमा सामग्रीहरू प्रदर्शन गर्छ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\gallery.xhp	0	help	par_id3150275				0	ne	\<ahelp hid=\"HID_GALLERY_NEWTHEME\"\>एउटा नयाँ बिषयवस्तु लाई थप्छ \<emph\>Gallery \</emph\>र विषयवस्तुमा फाइलहरू समावेश गर्न तपाईँले रोज्नुहोस् ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\gallery.xhp	0	help	par_id3150789				0	ne	\<ahelp hid=\".uno:Gallery\"\>खोल्दछ \<emph\>सङ्रहालय\</emph\>, जहाँ तपाईँले ग्राफिक्स चयन गर्न सक्नुहुन्छ र तपाईँको कागजात भित्र ध्वनिहरू घुसाउन सक्नुहुन्छ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\gallery.xhp	0	help	par_id3153032				0	ne	\<emph\>सँग्रहालय\</emph\> मा एउटा फाइल थप्न, एउटा विषयवस्तुमा दायाँ-क्लिक गर्नुहोस् \<emph\>गुणहरू\</emph\> रोज्नुहोस्, \<emph\>फाइलहरू \</emph\>ट्याबमा क्लिक गर्नुहोस् र त्यसपछि \<emph\>थप्नुहोस्\</emph\> मा क्लिक गर्नुहोस् तपाईँले हालको कागजातको एउटा वस्तुमा क्लिक गर्न पनि सक्नुहुन्छ, होल्ड गर्नुहोस् र त्यसपछि यसलाई \<emph\>सँग्रहालय\</emph\> सञ्झ्यालमा तान्नुहोस् ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\gallery.xhp	0	help	par_id3153394				0	ne	\<emph\>संग्राहलय\</emph\> को एउटा एकल वस्तुमा जुम बढाउन वा जुम घटाउन, वस्तुमा डबल-क्लिक गर्नुहोस् वा वस्तु चयन गर्नुहोस् र त्यसपछि स्पेसबार थिच्नुहोस् ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\gallery.xhp	0	help	par_id3155355	50			0	ne	\<ahelp hid=\"HID_GALLERY_WINDOW\"\>एउटा घुसाउन \<emph\>Gallery \</emph\>वस्तु, वस्तु चयन गर्नुहोस् र त्यसपछि कागजात भित्र यसलाई तान्नुहोस् ।\</ahelp\>				2002-02-02 02:02:02
