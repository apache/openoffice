helpcontent2	source\text\shared\01\05030700.xhp	0	help	par_id3154331				0	ne	\<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_ALIGN_PARAGRAPH_CB_SNAP\"\>एउटा पाठ ग्रिडमा अनुच्छेद पङ्क्तिबद्ध गर्दछ । पाठ ग्रिड सक्रिय पार्न, \<link href=\"text/swriter/01/05040800.xhp\" name=\"ढाँचा - पृष्ठ - पाठ ग्रिड\"\>\<emph\>ढाँचा - पृष्ठ - पाठ ग्रिड\</emph\>\</link\> रोज्नुहोस््\</ahelp\>				2002-02-02 02:02:02
