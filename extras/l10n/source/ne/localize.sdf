helpcontent2	source\text\swriter\01\04020100.xhp	0	help	par_id3156274				0	ne	\<ahelp hid=\"SW:PUSHBUTTON:MD_EDIT_REGION:PB_FILE\"\>लिङ्कको रूपमा घुसाउन लागिएको फाइलको स्थान निर्धारण गर्नुहोस्, र क्लिक गर्नुहोस् \<emph\>इन्सर्ट\</emph\>.\</ahelp\>				2002-02-02 02:02:02
