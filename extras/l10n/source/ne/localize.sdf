helpcontent2	source\text\shared\01\05040200.xhp	0	help	par_id3149811				0	ne	\<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXPAGE_PAGE:RB_PORTRAIT\"\>ठाडो रूपमा पृष्ठविन्यस्त कागजसँग हालको कागजात प्रदर्शन गर्दछ वा छाप्दछ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05040200.xhp	0	help	par_id3149827	34			0	ne	\<ahelp hid=\"SVX:LISTBOX:RID_SVXPAGE_PAGE:LB_PAPER_SIZE\"\>एउटा पुर्वपरिभाषित कागज साइज चयन गर्नुहोस् वा \<emph\>उचाइ \</emph\>र \<emph\>चौडाइ \</emph\>बाकसहरूको कागजका लागि आयामहरू प्रविष्टि गरेर एउटा अनुकूल ढाँचा सिर्जना गर्नुहोस्।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05040200.xhp	0	help	par_id3150417				0	ne	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>एउटा छापिएको पृष्ठमा कक्षहरूका लागि पङ्क्तिबद्धता विकल्प निर्दिष्ट गर्नुहोस्। \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05040200.xhp	0	help	par_id3150710				0	ne	पूर्वपरिभाषित कागज साइजहरूको एउटा सूचीबाट चयन गर्नुहोस् वा एउटा अनुकूल कागज ढाँचा परिभाषित गर्नुहोस्।				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05040200.xhp	0	help	par_id3150771				0	ne	\<ahelp hid=\"SVX:LISTBOX:RID_SVXPAGE_PAGE:LB_PAPER_TRAY\"\>तपाईँको मुद्रकका लागि कागज स्रोत चयन गर्नुहोस्। तपाईँले चाहनुहुन्छ भने, तपाईँले भिन्न पृष्ठ शैलीहरूमा एउटा भिन्न ट्रे मानाङ्कन गर्न सक्नुहुन् । उदाहरणका लागि, पहिलो पृष्ठ शैलीमा एउटा भिन्न ट्रे मानाङ्कन गर्नुहोस्र तपाईँको कम्पनीको लेटरहेड कागज सँग ट्रे लोड गर्नुहोस् ।.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05040200.xhp	0	help	par_id3151112				0	ne	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<ahelp hid=\"SVX:CHECKBOX:RID_SVXPAGE_PAGE:CB_REGISTER\"\>चयन गरिएको पृष्ठ शैलीको पाठलाई एउटा ठाडो पृष्ठ ग्रिडमा पङ्क्तिबद्ध गर्दछ ।\</ahelp\> ग्रिडको खाली स्थानलाई \<emph\>सन्दर्भ शैली\</emph\>द्वारा परिभाषित गरिन्छ । \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05040200.xhp	0	help	par_id3151384				0	ne	\<ahelp hid=\"SVX:METRICFIELD:RID_SVXPAGE_PAGE:ED_LEFT_MARGIN\"\>पृष्ठको बायाँ किनाराहरू र कागजात पाठको बीचमा छोड्ने खाली स्थानको मात्रा प्रविष्ट गर्नुहोस्। यदि तपाईँले \<emph\>मिरर गरिएको\</emph\> पृष्ठ सजावट प्रयोग गर्दै हुनुहुन्छ भने, पृष्ठको भित्री पाठ सीमान्त र भित्री किनाराको बीचमा छोड्ने खाली स्थानको मात्रा प्रविष्ट गर्नुहोस्।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05040200.xhp	0	help	par_id3152885				0	ne	\<switchinline select=\"appl\"\>\<caseinline select=\"DRAW\"\>\</caseinline\>\<caseinline select=\"IMPRESS\"\>\</caseinline\>\<defaultinline\>हालको पृष्ठ शैली प्रयोग गर्न विषम पृष्ठहरूमा मात्र हालको ढाँचा सेटिङ लागू गर्दछ । कागजातको पहिलो पृष्ठ एउटा विषम पृष्ठ हो ।\</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
