helpcontent2	source\text\swriter\01\04120213.xhp	0	help	par_id3155186				0	ne	\<ahelp hid=\"SW:LISTBOX:TP_TOX_SELECT:LB_DISPLAYTYPE\"\> तपाईँंले अनुक्रमणिका प्रविष्टीहरूका लागि प्रयोग गर्न चाहेको क्याप्सनको भाग चयन गर्नुहोस्। \</ahelp\> निम्न तालिकाले "Illustration 24: The Sun" मा आधारित भएर, चयन गर्न सकिने क्याप्सन विकल्प सूचीकृत गर्दछ, जहाँ "Illustration 24" स्वत:तरीकाले उत्पन्न भएको हो र "The Sun" प्रयोगकर्ताद्वारा थप गरिएको हो।				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120213.xhp	0	help	par_id3155863				0	ne	\<ahelp hid=\"SW:RADIOBUTTON:TP_TOX_SELECT:RB_FROMOBJECTNAMES\"\>वस्तु नामहरूबाट अनुक्रमणिका प्रविष्टीहरू सिर्जना गर्दछ।\</ahelp\> तपाईँंले नेभिगेटरमा वस्तु नामहरू दृश्य गर्न सक्नुहुन्छ, र उदाहरणका लागि, तिनीहरूलाई प्रसङ्ग मेनुमा परिवर्तन गर्न सक्नुहुन्छ।				2002-02-02 02:02:02
