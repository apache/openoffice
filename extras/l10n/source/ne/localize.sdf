helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3145673	37			0	ne	\<ahelp hid=\"SVX_PUSHBUTTON_RID_SFXPAGE_LINGU_PB_LINGU_MODULES_EDIT\"\>एउटा भाषा मोड्युल क्लिक गर्नलाई, यसलाई चयन गर्नुहोस र \<emph\>सम्पादन गर्नुहोस\</emph\>क्लिक गर्नुहोस।\</ahelp\> \<link href=\"text/shared/optionen/01010401.xhp\" name=\"Edit Modules\"\>\<emph\>मोड्युलहरू सम्पादन गर्नुहोस\</emph\>\</link\> संवाद देखापर्दछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3145750	76			0	ne	एउटा शव्दकोष सम्पादन, फाइलको स्थितिमा एउटा जाँच गरियो। यदि फाइल लेखन-सुरक्षित हो भने,यसलाई परिवर्तन गर्न सकिँदैन। त्यसपछि \<emph\>नयाँ\</emph\> र \<emph\>मेट्नुहोस\</emph\> बटनहरू निस्क्रिय पारियो।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3145790				0	ne	\<ahelp hid=\"SVX:PUSHBUTTON:RID_SFXDLG_EDITDICT:PB_DELETE_REPLACE\"\>हालको अनुकूल शव्दकोष बाट चिन्हित शव्द हटाँउछ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3146794				0	ne	\<ahelp hid=\"SVX_PUSHBUTTON_RID_SFXPAGE_LINGU_PB_LINGU_DICS_NEW_DIC\"\>\<emph\>नयाँ शव्दकोष\</emph\> संवाद खोल्दछ, जसमा तपाईँंले प्रयोगकर्ता-परिभाषित शव्दकोष वा अपवादको शव्दकोष लाई नामकरण गर्न सक्नुहुन्छ र भाषा निर्दिष्ट गर्न सक्नुहुन्छ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3147323				0	ne	\<ahelp hid=\"SVX:EDIT:RID_SFXDLG_EDITDICT:ED_REPLACE\"\>यदि तपाईंले एउटा अपवाद शव्दकोश सम्पादन गर्दै हुनुहुन्छ भने मात्र यो  आगत फाँट उपलब्ध हुन्छ। फाँटले "Word" पाठ बाकसमा रूपान्तरक सुझाव लिन्छ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3147394				0	ne	\<ahelp hid=\"SVX:LISTBOX:RID_SFXDLG_EDITDICT:LB_ALLDICTS\"\>सम्पादित गर्न किताब निर्दिष्ट गर्छ.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3147436	75			0	ne	\<emph\>अनुकूल शव्दकोष सम्पादन गर्नुहोस\</emph\> संवादमा तपाईँंसँग नयाँ टर्महरू प्रविष्टि गर्न वा अवस्थित प्रविष्टिहरू सम्पादन गर्न विकल्प हुन्छ। यदि तपाईँंले अपवाद शव्दकोष सम्पादन गर्नुभयो भने,संवादमा शव्दका लागि अपवाद परिभाषित गर्नका लागि थप गरिएको सुविधा हुन्छ। हिज्जेपरिक्षणको अवधीमा यो अपवाद त्यसपछि एउटा सुझावको रूपमा सूचीकृत गरियो।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3148920				0	ne	\<ahelp hid=\"SVX:LISTBOX:RID_SFXDLG_NEWDICT:LB_DICTLANG\"\>निश्चित भाषा चयन गरेर तपाईँंले अनुकूल शव्दकोषको प्रयोग सिमित पार्न सक्नुहुन्छ।\</ahelp\>\<emph\>सबै\</emph\> चयन गरेर हालको भाषाको अनुकूल शव्दकोष  स्वतन्त्ररूपले प्रयोग गरिन्छ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3149439				0	ne	अर्को हरफमा चाँहिने योजक चिन्ह राखिएका शव्दको क्यारेक्टरहरूको न्यूनतम सङ्ख्या वर्णन गर्दछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3149561				0	ne	\<ahelp hid=\"SVX:CHECKBOX:RID_SFXDLG_NEWDICT:BTN_EXCEPT\"\>तपाईँंको कागजातमा तपाईँंले निश्चित शव्दहरू अस्विकारगर्न चाहनुहुन्छ कि भन्ने वारे वर्णन गर्दछ।\</ahelp\> तपाईँंले सबै शव्दहरू अस्विकारगरिने किसिमले परिभाषित अनुकूल शव्दकोष समावेश गर्न सक्नुहुन्छ। हिज्जेपरिक्षणको अवधीमा, यदि यो अपवाद शव्दकोष सक्रिय पारिएमा,यो शव्द अस्विकारगरिनु पर्छ भन्ने किसिमको द्रष्टव्य तपाईँंले प्राप्त गर्नुहुनेछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3150208				0	ne	सङ्ख्याहरू साथ साथै अक्षरहरू पनि समावेश गरेका शव्दहरू जाँच गर्नुपर्दछ भन्ने कुरा वर्णन गर्दछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3150316				0	ne	स्वचालित योजक चिन्ह राख्ने काम लागू हुनका लागि आवश्यक पर्ने क्यारेक्टरहरूको न्यूनतम सङ्ख्या निर्दिष्ट गर्दछ।  \<ahelp hid=\"HID_LNGDLG_NUM_PREBREAK\" visibility=\"hidden\"\> योजक चिन्ह को अगाडि वा पछाडि आउनै पर्ने क्यारेक्टरहरूको न्यूनतम सङ्ख्या टाइप गर्नुहोस। \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3150345				0	ne	विशेष क्षेत्रहरू वर्णन गर्दछ, जस्तै हेडरहरू र फुटरहरू, कागजात तालिकाहरू, र पाठ फ्रेमहरूमा पाठ हिज्जेपरिक्षणको क्रममा जाँच गरियो।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3151130				0	ne	तपाईँंले म्यानुअल योजक चिन्ह राख्ने कामका लागि कहिले पनि सोधिनुहुने छैन भन्ने कुरा वर्णन गर्दछ। यदि फाँट चिन्हित नगरिएमा, अक्षर नचिनिएको बेलामा तपाईँं योजकचिन्ह प्रविष्टिका लागि एउटा संवाद सँग प्रस्तुत हुनु हुनेछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3151252				0	ne	\<ahelp hid=\"SVX:EDIT:RID_SFXDLG_EDITDICT:ED_WORD\"\> डाइरेक्टरीमा नयाँ शव्द समावेशका लागि तपाईँंले टाइप गर्न सक्नुहुन्छ। तल सूचीमा तपाईँंले हालको अनुकूल शव्दकोषको सामग्री देख्नुहुनेछ। \</ahelp\> यदि तपाईँंले यो सूची बाट एउटा शव्द चयन गरेमा यो पाठ फाँटमा प्रदर्शन हुन्छ। यदि तपाईँंले यस पछि एउटा शव्द बराबर चिन्ह सँग टाइप गर्नुभएमा जस्तै:"AutoComplete=", शव्द नत स्वचालित तवरले योजक चिन्हित हुन्छ नत योजक चिन्ह सल्लाह गरिन्छ। यो बिन्दुमा, "Auto=Complete" टाइप गर्दा शव्दमा परिणाम योजक चिन्हित भईरहेको छ वा एउटा योजक चिन्ह राख्ने काम सुझाव दिईयो।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3151277				0	ne	\<ahelp hid=\"SVX_PUSHBUTTON_RID_SFXPAGE_LINGU_PB_LINGU_DICS_DEL_DIC\"\> यो लेख सुरक्षित छैन भन्ने यकीन गरिए पछि चयन गरिएका शव्दकोश मेट्दछ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3152576				0	ne	\<ahelp hid=\"SVX_PUSHBUTTON_RID_SFXPAGE_LINGU_PB_LINGU_DICS_EDIT_DIC\"\> \<emph\>अनुकूल शव्दकोष सम्पादन गर्नुहोस\</emph\> संवाद खोल्दछ, जसमा तपाईँंले अनुकूल शव्दकोष थप गर्न वा अवस्थित प्रविष्टिहरू सम्पादन गर्न सक्नुहुन्छ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3152582				0	ne	हिज्जेपरिक्षणको अवधीमा ठूलो बर्ण बनाउने काम जाँच गरियो भन्ने कुरा वर्णन गर्दछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3153192				0	ne	\<ahelp hid=\"SVX:EDIT:RID_SFXDLG_NEWDICT:ED_DICTNAME\"\>नयाँ अनुकूल शव्दकोषको नाम वर्णन गर्दछ।\</ahelp\> फाइल विस्तार "*.DIC" स्वचालित तवरले सम्मिलित भयो।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3153231				0	ne	\<ahelp hid=\"SVX_PUSHBUTTON_RID_SFXPAGE_LINGU_PB_LINGU_OPTIONS_EDIT\"\>यदि तपाईँंले एउटा मान परिवर्तन गर्न चाहनुहुन्छ भने, प्रविष्टि चयन गर्नुहोस र त्यसपछि \<emph\>सम्पादन गर्नुहोस\</emph\> क्लिक गर्नुहोस।\</ahelp\> एउटा नयाँ मान प्रविष्टि गर्नलाई तपाईँंले एउटा संवाद देख्नुहुनेछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3153360				0	ne	\<emph\>शव्दकोष\</emph\> सेक्सनमा तपाईँंले प्रयोगकर्ता-परिभाषित शव्दकोष वा अपवादको शव्दकोष लाई नामकरण गर्न सक्नुहुन्छ र भाषा निर्दिष्ट गर्न सक्नुहुन्छ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3153527				0	ne	\<ahelp hid=\"HID_OPTIONS_LINGU\"\>हिज्जेपरिक्षण,शव्दकोष र हाईफनेसनको गुणहरू निर्दिष्ट गर्दछ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3153663	35			0	ne	एउटा भाषा मोड्युलले एक, दुई, वा तिन सहायक मोड्युलहरू समावेश गर्न सक्दछ: हिज्जेजाँच, योजक चिन्ह  र शव्दकोशहरू । हरेक सहायक-मोड्युलहरू एक वा धेरै भाषाहरूमा उपलब्ध हुन सक्छन। यदि तपाईंले मोड्युलको नामको अगाडि क्लिक गर्नुभयो भने, तपाईंले एकै साथ सबै उपलब्ध सहायक-मोड्युलहरू सक्रिय पार्नुहुन्छ। यदि तपाईंले एउटा सेट चिन्ह हटाउनुभयो भने,तपाईंले एकै साथ सबै उपलब्ध सहायक-मोड्युलहरू निस्क्रिय पार्नुहुन्छ। यदि तपाईंले अलग सहायक-मोड्युलहरूलाई सक्रिय वा निष्क्रिय पार्न चाहनुहुन्छ भने \<link href=\"text/shared/optionen/01010401.xhp\" name=\"Edit Modules\"\>\<emph\>मोड्युलहरू सम्पादन गर्नुहोस \</emph\>\</link\> खोल्नलाई \<emph\>बटन सम्पादन गर्नुहोस \</emph\>संवाद क्लिक गर्नुहोस।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3153815				0	ne	\<link href=\"text/shared/01/06040200.xhp\" name=\"AutoCorrect replacement table\"\>स्वत:सुधार प्रसङ्ग मेनु\</link\>मा शव्द जोडा राख्नलाई,  \<link href=\"text/shared/01/06040500.xhp\" name=\"AutoCorrect context menu\"\>स्वत:सुधार प्रसङ्ग मेनु\</link\> खोल्नुहोस र \<emph\>स्वत:सुधार\</emph\> रोज्नुहोस। तपाईँंको चयन सहायक मेनुबाट बनाउनुहोस। शव्द प्रतिश्थापित भयो र शव्द जोडा प्रतिस्थापन तालिकामा राखियो।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3154200				0	ne	हिज्जेपरिक्षणको क्रममा शव्दको सुरुमा ठुलो बर्णको प्रयोग जाँच गर्दछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3154255				0	ne	\<ahelp hid=\"SVX:LISTBOX:RID_SFXDLG_EDITDICT:LB_DICTLANG\"\>हालको अनुकूल शव्दकोषलाई एउटा नयाँ भाषा मानाङ्कन गर्दछ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3154730	79			0	ne	\<variable id=\"ignore\"\>\<emph\>IgnoreAllList (All) \</emph\>हिज्जेपरिक्षणको समयमा\<emph\>बेवास्ता गर्नुहोस \</emph\>सँग चिन्हित सबै शव्दहरू समावेश गर्दछ, यो हालको हिज्जेपरिक्षणका लागि भोलाटाईल RAM मा मात्र प्रशासित हुन्छ। केही प्रयोगकर्ता डेटा कार्यक्रम सुरुआतमा सूचीमा प्रविष्टि हुनेछन।\<emph\>IgnoreAllList (All) \</emph\>मेट्न सकिँदैन। \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3154749				0	ne	\<ahelp hid=\"HID_CLB_LINGU_MODULES\"\>स्थापित भाषा मोड्युलहरू समावेश गर्दछ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3154757				0	ne	\<emph\>IgnoreAllList\</emph\> प्रविष्टि चयन गर्न र मेट्न सकिँदैन। सामग्रीको रूपमा संलग्न गरिएको शव्दहरू मात्र मेट्न सकिन्छ। हरेक पटक$[officename] बन्द हुँदाँ यस्तो हुन्छ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3155098				0	ne	योजक चिन्ह पादटिप्पणीहरू,हेडरहरू र फुटरहरूमा ल्याईन्छ भन्ने कुरा वर्णन गर्दछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3155419				0	ne	\<ahelp hid=\"HID_CLB_EDIT_MODULES_DICS\"\>उपलब्ध प्रयोगकर्ता शव्दकोषहरू सूचीकृत गर्दछ।\</ahelp\> तपाईँंले हिज्जे परिक्षण र योजक चिन्हका लागि प्रयोग गर्न चाहेको शव्दकोषहरू चिन्हित गर्नुहोस।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3155531				0	ne	\<variable id=\"automatisch\"\>\<ahelp hid=\".uno:SpellOnline\"\>तपाईँंले टाइप गर्नासाथ अक्षर विन्यास स्वचालित तवरले जाँच गर्दछ, त्रुटिहरूलाई कच गर्दछ।\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3156029				0	ne	हरफको अन्तिममा रहनै पर्ने शव्दको क्यारेक्टरहरूको न्यूनतम सङ्ख्या योजक चिन्ह राखिनका लागि सेट गर्दछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3156291				0	ne	टाइप त्रुटिहरू कागजातमा एउटा रातो कचले हाइलाइट गरिएका छन । यदि तपाईँंले यस प्रकारले चिन्हित शव्दमाथि कर्सर राख्नुहुन्छ भने, सुझाव गरिएका सुधार सूची प्राप्त गर्नलाई तपाईँंले प्रसङ्ग मेनु खोल्न सक्नुहुन्छ। सुझाव सँग शंकास्पद शव्द बदल्नलाई सुझाव गरिएको सुधार चयन गर्नुहोस। कागजात सम्पादन गरेको बेलामा तपाईँंले फेरि उस्तै गल्ती गर्नुभयो भने,यो स्वचालित तवरले सुधार हुनेछ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3163808	89			0	ne	\<ahelp hid=\"SVX:PUSHBUTTON:RID_SFXDLG_EDITDICT:PB_NEW_REPLACE\"\> शव्दलाई\<emph\>शव्द \</emph\>पाठ फाँटमा तपाईँको हालको अनुकूल शव्दकोषमा थप गर्दछ। अपवाद शव्दकोषहरू सँग कार्य गर्दा \<emph\>सुझाव \</emph\>फाँटमा भएका शव्द पनि थप गरिन्छन।\</ahelp\>				2002-02-02 02:02:02
