helpcontent2	source\text\swriter\01\04060100.xhp	0	help	par_id3151177				0	ne	\<variable id=\"optionentext\"\>\<ahelp hid=\"SW:PUSHBUTTON:DLG_CAPTION:BTN_OPTION\"\>क्याप्सन लेबुलमा अध्याय सङ्ख्या थप गर्नुहोस्. यो सुबिधा प्रयोग गर्नका लागि, तपाईँंले पहिला निश्चित गर्नुपर्दछ \<link href=\"text/swriter/guide/chapter_numbering.xhp\" name=\"outline level\"\>रूपरेखा स्तर\</link\> अनुच्छेद शैलीमा, र तपाईँंको कागजातको अध्याय हेडिङहरूमा शैली लागू गर्नुहोस्.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04060100.xhp	0	help	par_id3152954				0	ne	\<ahelp hid=\"SW:LISTBOX:DLG_SEQUENCE_OPTION:LB_LEVEL\"\>अध्यायको हाइरेर्की तलको माथिबाट रूपरेखा स्तरहरूको सङ्ख्या चयन गर्नुहोस् क्याप्सन लेबुलमा समावेश गर्नका लागि.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04060100.xhp	0	help	par_id3153532				0	ne	जब तपाईँं क्याप्सन लेबुलहरूमा अध्याय सङ्ख्याहरू थप गर्नुहुन्छ, क्याप्सन क्रमाङ्कन रिसेट हुन्छ जब अध्याय हेडिङ इन्काउन्टर हुन्छ. उदाहरणका लागि, यदि त्यो अन्तिम चित्र अध्याय १ मा "Figure 1.12" हो भने, अन्तिम चित्र अर्को अध्यायमा  "Figure 2.1" हुन्छ.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04060100.xhp	0	help	par_id3155892				0	ne	\<ahelp hid=\"SW:EDIT:DLG_SEQUENCE_OPTION:ED_SEPARATOR\"\>क्यारेक्टर प्रविष्ट गराउनुहोस् जुन तपाईँं च्याप्टर सङ्ख्या र क्याप्सन सङ्ख्या बीचमा घुसाउन चाहनुहुन्थ्यो.\</ahelp\>				2002-02-02 02:02:02
