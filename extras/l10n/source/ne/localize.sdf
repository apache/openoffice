helpcontent2	source\text\shared\01\05030700.xhp	0	help	par_id3154224				0	ne	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<ahelp hid=\"SVX:CHECKBOX:RID_SVXPAGE_ALIGN_PARAGRAPH:CB_EXPAND\"\>यदि एउटा समरेखन गरिएको अनुच्छेदको अन्तिम रेखामा एउटा शब्द छ भने, त्यो शब्द अनुच्छेदको चौडाइ भरी तन्किन्छ ।\</ahelp\>\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
