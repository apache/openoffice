helpcontent2	source\text\scalc\01\05110000.xhp	0	help	par_id3145799				0	ne	\<ahelp hid=\"SC:LISTBOX:RID_SCDLG_AUTOFORMAT:LB_FORMAT\"\>तपाईँंको पानामा चयन गरेको क्षेत्र लागू गर्न पहिल्यै परिभाषा गरेको स्वत: ढाँचाँ रोज्नुहोस् ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	par_id3146920				0	ne	\<ahelp hid=\"SC:MOREBUTTON:RID_SCDLG_AUTOFORMAT:BTN_MORE\"\>\<emph\>ढाँचा\</emph\> सेक्सन खोल्दछ जुन ढाँचाले अगाडि बडाउँदछ जसमा स्प्रेडसिटमा लागू गर्न सकिन्छ । चयन गर्न नमिल्ने विकल्पले हालको स्प्रेडसिटको त्यो ढाँचा प्रकारका लागि ढाँचा राख्छ \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	par_id3148703				0	ne	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_AUTOFORMAT:BTN_ADJUST\"\>जब चिन्ह लगाइन्छ गरिन्छ, निर्दिष्ट गर्नुहोस् जसमा तपाईँं चयन गरेको ढाँचाको चौडाइ र उचाइ कायम राख्न चाहनुहुन्छ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	par_id3150368				0	ne	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_AUTOFORMAT:BTN_PATTERN\"\> जब चिन्ह लगाइन्छ गरिन्छ, निर्दिष्ट गर्नुहोस् जसमा तपाईँं चयन गरेको ढाँचाको बान्की कायम राख्न चाहनुहुन्छ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	par_id3152990				0	ne	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_AUTOFORMAT:BTN_FONT\"\> जब चिन्ह लगाइन्छ गरिन्छ, निर्दिष्ट गर्नुहोस् जसमा तपाईँं चयन गरेको ढाँचाको फन्ट कायम राख्न चाहनुहुन्छ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	par_id3153064				0	ne	\<ahelp hid=\"HID_SC_RENAME_AUTOFMT\"\> संवाद खोल्दछ जहाँ तपाईँं चयन गरेको स्वत: ढाँचाको विशिष्टिकरण परिवर्तन गर्न सक्नुहुन्छ ।\</ahelp\> यदि तपाईँंले \<emph\>अझ धेरै\</emph\> बटनमा क्लिक गर्नुभयो भने मात्र बटन दृश्यात्मक हुन्छ.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	par_id3153708	29			0	ne	\<ahelp hid=\"HID_SC_AUTOFMT_NAME\"\>नाम घुसाएर र \<emph\>ठीक छ\</emph\>क्लिक गर्नुहोस् ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	par_id3153912				0	ne	\<emph\>स्वत:ढाँचा पुन: नामकरण गर्नुहोस्\</emph\> संवाद खोल्दछ ।\<ahelp hid=\"HID_SC_REN_AFMT_NAME\"\> याहाको स्वत:ढाँचामा नयाँ नाम प्रविष्ट गर्नुहोस् ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	par_id3153965				0	ne	यो सेक्सनमा तपाईँं उपलब्ध ढाँचा विकल्प चयन गर्न वा नगर्न सक्नुहुन्छ । तपाईँंको स्प्रेडसिटमा हालैका कुनै पानि सेटिङहरू राख्न चाहनुहुन्छ भने अनुरूप विकल्प चयन नगर्नुहोस् ।				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	par_id3154017				0	ne	\<ahelp hid=\"SC:PUSHBUTTON:RID_SCDLG_AUTOFORMAT:BTN_ADD\"\>पूर्वपरिभाषित स्वत:ढाँचाहरूको सूचीमा कम्तीमा ४*४ कक्षहरूको दायराको हालको ढाँचा थप्न तपाईँंलाई अनुमति दिन्छ । \</ahelp\> The \<link href=\"text/shared/01/05150101.xhp\" name=\"Add AutoFormat\"\>स्वत:ढाँचा जोड्नुहोस् \</link\>संवाद त्यसपछि देखा पर्दछ ।				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05110000.xhp	0	help	par_id3156445				0	ne	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_AUTOFORMAT:BTN_ALIGNMENT\"\> जब चिन्ह लगाइन्छ गरिन्छ, निर्दिष्ट गर्नुहोस् जसमा तपाईँं चयन गरेको ढाँचाको पङ्क्तिबद्धता कायम राख्न चाहनुहुन्छ ।\</ahelp\>				2002-02-02 02:02:02
