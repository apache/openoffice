helpcontent2	source\text\shared\explorer\database\30100000.xhp	0	help	par_id3149064				0	ne	\<ahelp hid=\"HID_DLG_ADABAS_SYSDEVSPACE\"\>प्रणाली DEVSPACE का लागि बाटो प्रविष्ट गर्नुहोस् ।\</ahelp\>  SYSDEVSPACE ले डाटाबेसका लागि कन्फिगरेसन डेटा व्याबस्था गर्दछ ।  SYSDEVSPACE साइज डाटाबेसको साइजमा भर पर्दछ ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\30100000.xhp	0	help	par_id3149294				0	ne	\<ahelp hid=\"HID_DLG_ADABAS_CONUSR\"\>डाटाबेसको केही परामितिहरू परिमार्जन गर्न सिमित नियन्त्रण दिन चाहरेको प्रयोगकर्ताको नाम प्रविष्ट गर्नुहोस् ।समान्यतया,नियन्त्रणको नाम र पासवर्डका लागि पूर्वनिर्धारित सेटिङहरू परिवर्तन गरिँदैनन् ।\</ahelp\> नियन्त्रण प्रयोगकर्ताले तिन-प्रयोगकर्ता सिमालाई असर गर्दैन ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\30100000.xhp	0	help	par_id3149378	31			0	ne	\<ahelp hid=\"HID_DLG_ADABAS_CACHE_SIZE\"\>डेटा केसको साइज मेगाबाइट्समा प्रविष्ट गर्नुहोस् । \</ahelp\> डेटा बफरले एकै साथ सबै प्रयोगकर्ताद्वारा पहुँच गर्न सकिन्छ र सबै भन्दा पहुँच गरिएको पृष्ठहरू DATADEVSPACEs बाट सँग्रह गर्दछ ।				2002-02-02 02:02:02
