helpcontent2	source\text\smath\01\05030000.xhp	0	help	par_id3145824				0	ne	\<ahelp hid=\"HID_SMA_LINE_DIST\"\>रेखाहरू बीचमा स्पेसिङ निर्धारित गर्दछ\</ahelp\> 				2002-02-02 02:02:02
