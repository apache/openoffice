helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	par_id3145271				0	ne	\<variable id=\"opunkte\"\>\<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_GRID_CBX_SNAP_POINTS\"\>ग्राफिकको वस्तुको रूपरेखा सबै भन्दा नजिकको ग्राफिक वस्तुको बिन्दुहरूमा पङ्क्तिवद्ध गर्ने कि भन्ने कुरा वर्णन गर्छ। \</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	par_id3146146				0	ne	एउटा प्रस्तुतीकरण वा चित्र वस्तुमा, यो कार्य  \<switchinline select=\"appl\"\>\<caseinline select=\"IMPRESS\"\>\<link href=\"text/simpress/02/13170000.xhp\" name=\"Snap to Object Points\"\>वस्तु बिन्दुहरूमा स्न्याप गर्नुहोस\</link\>\</caseinline\>\<caseinline select=\"DRAW\"\>\<link href=\"text/simpress/02/13170000.xhp\" name=\"Snap to Object Points\"\>वस्तु बिन्दुहरूमा स्न्याप गर्नुहोस\</link\>\</caseinline\>\<defaultinline\>\<emph\>वस्तु बिन्दुहरूमा स्न्याप गर्नुहोस\</emph\>\</defaultinline\>\</switchinline\> प्रतिमा सँग पनि विकल्प पट्टीमा पहुँच हुन सक्छ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	par_id3147228				0	ne	\<variable id=\"rahmtext\"\>ग्राफिक वस्तुको कर्सर वा रूपरेखा लाइन स्न्याप दायरामा हुनैपर्छ। \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	par_id3148674				0	ne	\<variable id=\"rahmen\"\>\<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_GRID_CBX_SNAP_FRAME\"\>ग्राफिक वस्तुको रूपरेखा नजिकको ग्राफिक वस्तुमा पङ्क्तिबद्ध गर्ने कि भन्ने कुरा वर्णन गर्दछ।\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	par_id3148922				0	ne	प्रस्तुतीकरण वा चित्र कागजातमा, यो कार्य \<emph\>विकल्प \</emph\> पट्टीमा \<switchinline select=\"appl\"\>\<caseinline select=\"IMPRESS\"\>\<link href=\"text/simpress/02/13160000.xhp\" name=\"Snap to Object Border\"\>वस्तु किनारामा स्न्याप गर्नुहोस् \</link\>\</caseinline\>\<caseinline select=\"DRAW\"\>\<link href=\"text/simpress/02/13160000.xhp\" name=\"Snap to Object Border\"\>वस्तु किनारामा स्न्याप गर्नुहोस\</link\>\</caseinline\>\<defaultinline\>\<emph\>वस्तु किनारामा स्न्याप गर्नुहोस् \</emph\>\</defaultinline\>\</switchinline\> संग पनि पहुँच गर्न सकिन्छ ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	par_id3148947				0	ne	प्रस्तुतीकरण वा चित्र कागजातमा, कार्य \<emph\>विकल्प \</emph\>पट्टीमा \<switchinline select=\"appl\"\>\<caseinline select=\"IMPRESS\"\>\<link href=\"text/simpress/02/13150000.xhp\" name=\"Snap to Page Margins\"\>पृष्ठ सीमान्तहरूमा स्न्याप गर्नुहोस \</link\>\</caseinline\>\<caseinline select=\"DRAW\"\>\<link href=\"text/simpress/02/13150000.xhp\" name=\"Snap to Page Margins\"\>पृष्ठ सीमान्तहरूमा स्न्याप गर्नुहोस् \</link\>\</caseinline\>\<defaultinline\>\<emph\>पृष्ठ सीमान्तहरूमा स्न्याप गर्नुहोस् \</emph\>\</defaultinline\>\</switchinline\> प्रतिमा संग पहुँच गर्न सकिन्छ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	par_id3149177				0	ne	यदि तपाईँंले स्न्याप ग्रिड सक्रिय पार्नुभयो तर अलग अलग वस्तुहरू स्न्याप अवस्थाहरू बिना सिर्जना गर्न वा सार्न चाहनुहुन्छ भने \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>आदेश \</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\> कुञ्जी तपाईँंले यो कार्यलाई निस्क्रिय पार्न चाहेजति थिचिराख्नुहोस।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	par_id3149483				0	ne	\<variable id=\"opunktetext\"\>यदि रूपरेखा वा ग्राफिक वस्तुको लाइन स्न्याप दायरामा भएमा मात्र यो लागू हुन्छ। \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	par_id3149516				0	ne	\<variable id=\"anlinie\"\>\<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_GRID_CBX_SNAP_HELPLINES\"\>तपाईँंले माउस छोड्दा तानेको वस्तुको किनारा नजिकको स्न्याप लाइन सम्म स्न्याप गर्दछ।\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	par_id3149670				0	ne	\<variable id=\"seittext\"\>ग्राफिक वस्तुको कर्सर वा रूपरेखा लाइन स्न्याप दायारामा हुनै पर्दछ।\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	par_id3150417				0	ne	\<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_GRID_CBX_ORTHO\"\>ग्राफिक वस्तुहरू लाई सिर्जना गर्दा वा सार्दा ठाडो गरी, तेर्सो गरी,छड्के गरी(४५°) अवरोध गरिन्छन कि भन्ने कुरा वर्णन गर्दछ।\</ahelp\> तपाईँंले शिफ्ट कुञ्जी थिचेर अस्थायी रूपमा यो सेटिङ निस्क्रिय पार्न सक्नुहुन्छ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	par_id3150717				0	ne	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRID_MTR_FLD_ANGLE\"\>तपाईँंले \<emph\>घुमाईरहेको बेलामा \</emph\> स्पिन बाकसमा चयन गर्नुभएको परिक्रमण कोण भित्र मात्रै ग्राफिक वस्तुलाई घुमाउन सकिन्छ भन्ने कुरा वर्णन गर्दछ।\</ahelp\> यदि तपाईँंले परिभाषित कोण बाहिर एउटा वस्तुलाई घुमाउन चाहनुहुन्छ भने, घुमाईरहेको बेलामा \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>आदेश \</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>कुञ्जी थिच्नुहोस। चाहेको परिक्रमण कोण पुगे पछि कुञ्जी छाड्नुहोस।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	par_id3152801				0	ne	\<ahelp hid=\"HID_SD_OPTIONS_SNAP\"\>वस्तुहरू सिर्जना गर्न र सार्नका लागि ग्रिड सेटिङहरू परिभाषित गर्दछ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	par_id3154142				0	ne	तपाईँंले  \<switchinline select=\"appl\"\>\<caseinline select=\"IMPRESS\"\>\<link href=\"text/simpress/02/13140000.xhp\" name=\"Snap to Snap Lines\"\>\<emph\>स्न्याप लाइनहरूमा स्न्याप गर्नुहोस\</emph\>\</link\>\</caseinline\>\<caseinline select=\"DRAW\"\>\<link href=\"text/simpress/02/13140000.xhp\" name=\"Snap to Snap Lines\"\>\<emph\>स्न्याप लाइनहरूमा स्न्याप गर्नुहोस\</emph\>\</link\>\</caseinline\>\<defaultinline\>\<emph\>स्न्याप लाइनहरूमा स्न्याप गर्नुहोस\</emph\>\</defaultinline\>\</switchinline\> प्रतिमा प्रयोग गरेर पनि यो सेटिङ परिभाषित गर्न सक्नुहुन्छ,जुन चाँहि एउटा प्रस्तुतीकरण वा चित्र कागजातमा \<emph\>विकल्प\</emph\> पट्टीमा उपलब्ध हुन्छ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	par_id3154145				0	ne	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRID_MTR_FLD_SNAP_AREA\"\>माउस सूचक र वस्तु रूपरेखा बीचमा स्न्याप दुरी परिभाषित गर्दछ। यदि माउस सूचक \<emph\>Snap range \</emph\>स्पिन बाकसमा चयन गरिएकोमा भन्दा नजिक भएमा $[officename] इम्प्रेस स्न्याप बिन्दुमा स्न्याप हुन्छ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	par_id3154942	24			0	ne	\<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_GRID_CBX_BIGORTHO\"\>तपाईँंले माउस छाड्नु भन्दा पहिले Shift कुञ्जी थिचेको बेलामा एउटा आयातनको लामो साइडमा आधारित भएर एउटा वर्ग सिर्जना गरियो भन्ने कुरा वर्णन गर्दछ।यो पनि एउटा दीर्घवृतमा लागू हुन्छ (एउटा दीर्घवृत्रको लामव्यासमामा आधारित भएर सिर्जना गरिनेछ। जब \<emph\> किनाराहरू विस्तार गर्नुहोस \</emph\>बाकस चिनो गरिँदैन,एउटा वर्ग वा वृत छोटो साइड वा अर्धव्यासमा आधारित भएर सिर्जना गरिनेछ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	par_id3156024				0	ne	\<variable id=\"seitenrand\"\>\<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_GRID_CBX_SNAP_BORDER\"\>ग्राफिक वस्तुको रूपरेखा नजिकको पृष्ठ सीमान्तमा पङ्क्तिबद्ध गर्ने कि भन्ने कुरा वर्णन गर्दछ।\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01070300.xhp	0	help	par_id3156275				0	ne	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRID_MTR_FLD_BEZ_ANGLE\"\>बिन्दु घटाउका लागि कोण परिभाषित गर्दछ।\</ahelp\> बहुभुजहरू सँग कार्य गरिरहेको बेलामा,तपाईँंले यसलाई सम्पादन बिन्दुहरू घटाउनलाई उपयोगी पाउनुभयो होला।				2002-02-02 02:02:02
