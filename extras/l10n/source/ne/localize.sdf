helpcontent2	source\text\shared\02\18010000.xhp	0	help	par_id3143267				0	ne	\<switchinline select=\"appl\"\> \<caseinline select=\"WRITER\"/\> \<caseinline select=\"CALC\"/\> \<caseinline select=\"CHART\"/\> \<caseinline select=\"MATH\"/\> \<defaultinline\>तपाईँंले एउटा समूहको अलग अलग तत्वहरू सम्पादन गर्न सक्नुहुन्छ। तपाईँंले तत्वहरू \<switchinline select=\"sys\"\> \<caseinline select=\"MAC\"\>आदेश\</caseinline\> \<defaultinline\>Shift\</defaultinline\> \</switchinline\>+क्लिकबाट पनि मेट्न सक्नुहुन्छ।\</defaultinline\> \</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\18010000.xhp	0	help	par_id3147571				0	ne	चयन				2002-02-02 02:02:02
