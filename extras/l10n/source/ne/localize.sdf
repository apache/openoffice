helpcontent2	source\text\shared\explorer\database\05010100.xhp	0	help	par_id3154758				0	ne	\<ahelp hid=\"HID_DLGIDX_RESETINDEX\" visibility=\"visible\"\>संवाद सुरु भएपछि हालको अनुक्रमणिकालाई सेटिङमा रिसेट गर्दछ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\05010100.xhp	0	help	par_id3154860				0	ne	\<ahelp hid=\"HID_DLGIDX_DROPINDEX\" visibility=\"visible\"\>हालको अनुक्रमणिका मेट्नुहोस् ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\05010100.xhp	0	help	par_id3154938	16			0	ne	तपाईँले हालको अनुक्रमणिकाको बिवरण परिवर्तन गरेर र त्यसपछि अर्को अनुक्रमणिका चयन गरेपछि,परिवर्तन तुरुन्तै डेटा स्रोतमा पास हुन्छ । यदि परिवर्तन डेटा स्रोतद्वारा सफलतापूर्वक गरियो भने मात्र तपाईँले संवाद छोड्न सक्नुहुन्छ , वा अर्को अनुक्रमणिका चयन गर्न सक्नुहुन्छ । यद्यपी, तपाईँले \<emph\>हालको अनुक्रमणिका रिसेट गर्नुहोस् \</emph\> प्रतिमा क्लिक गरेर परिवर्तनलाई पूर्वस्थीतीमा ल्याउन सक्नुहुन्छ ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\05010100.xhp	0	help	par_id3155342				0	ne	\<ahelp hid=\"HID_DLGIDX_INDEXLIST\" visibility=\"visible\"\>उपलब्ध अनुक्रमणिकाहरू प्रदर्शन गर्दछ । सम्पादन गर्नका लागि एउटा अनुक्रमणिका चयन गर्नुहोस् ।\</ahelp\> चयन गरिएका अनुक्रमणिकाको सम्बन्धित बिवरणहरू त्यसपछि संवादको दायाँ क्षेत्रमा दृश्य हुन्छन ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\05010100.xhp	0	help	par_id3156282	18			0	ne	\<ahelp hid=\"DBACCESS_CHECKBOX_DLG_INDEXDESIGN_CB_UNIQUE\" visibility=\"visible\"\>हालको अनुक्रमणिकाले अद्वितिय मानहरू मात्र समर्थन गर्दछ कि भन्ने कुरा बर्णन गर्दछ ।\</ahelp\> \<emph\>अद्वितिय \</emph\>विकल्पको जाँचले नक्कली डेटा लाई फाँटमा प्रबिष्टि हुन वाट रोक्दछ र डेटा अखण्डता आश्वस्त पार्दछ ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\05010100.xhp	0	help	par_id3158408				0	ne	\<ahelp hid=\"HID_DLGINDEX_INDEXDETAILS_FIELD\" visibility=\"visible\"\>हालको तालिकामा सूची फाँटहरू प्रदर्शन गर्दछ । तपाईँले एक भन्दा बढी फाँट चयन गर्न सक्नुहुन्छ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\05010100.xhp	0	help	par_id3166460	2			0	ne	\<ahelp visibility=\"visible\" hid=\".uno:DBIndexDesign\"\>\<emph\>अनुक्रमणिका डिजाइन \</emph\>संवादले तपाईँलाई हालको तालिकाका लागि अनुक्रमणिकाहरू सम्पादन गर्न समर्थन गर्दछ ।\</ahelp\>				2002-02-02 02:02:02
