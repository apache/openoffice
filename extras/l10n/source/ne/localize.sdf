helpcontent2	source\text\shared\01\05030600.xhp	0	help	par_id3145419				0	ne	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<ahelp hid=\"SVX:LISTBOX:RID_SVXPAGE_BACKGROUND:LB_TBL_BOX\"\>त्यो क्षेत्र चयन गर्नुहोस् जुनमा तपाईँले पृष्ठभूमि रङ लागू गर्न चाहनुहुन्छ ।\</ahelp\> उदाहरणका लागि, जब तपाईँले एउटा तालिकाका लागि पृष्ठभूमि परिभाषित गर्नुहुन्छ, तपाईँले यसलाई तालिकामा, सक्रिय कक्षमा, पङ्क्तिमा, वा स्तम्भमा लागू गर्न लागू गर्न सक्नुहुन्छ । \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
