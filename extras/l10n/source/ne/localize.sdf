helpcontent2	source\text\swriter\01\04040000.xhp	0	help	par_id3149483				0	ne	तपाईँंले तलका क्यारेक्टरहरू पुस्तकचिनो नाममा प्रयोग गर्न सक्नुहुन्न: / \\ @ : * ? " ; , . #				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04040000.xhp	0	help	par_id3149806	2			0	ne	\<variable id=\"textmarkeein\"\>\<ahelp hid=\".uno:InsertBookmark\"\>कर्सर अवस्थामा एउटा पुस्तकचिनो घुसाउछ। पछिल्लो समयमा चिनो गरिएको स्थानमा छिटो उफ्रन लाई तपाईँंले नेभिगेटर प्रयोग गर्न सक्नुहुन्छ। \</ahelp\>एउटा HTML कागजातमा,पुस्तकचिनोहरू एङ्करमा रूपान्तरित हुन्छन जुनई तपाईँंल हाइपरलिङ्क बाट उफ्रिन सक्नुहुन्छ.े \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04040000.xhp	0	help	par_id3151251				0	ne	\<ahelp hid=\"SW:PUSHBUTTON:DLG_INSERT_BOOKMARK:BT_DELETE\"\>पुस्तकचिनो मेटाउन, पुस्तकचिनो चयन गर्नुहोस् \<emph\>पुस्तकचिनो घुसाउनुहोस्\</emph\> संवादबाट र क्लिक गर्नुहोस् \<emph\>Delete\</emph\> बटन. कुनै निश्चित संवाद अनुगमन हुँदैन.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04040000.xhp	0	help	par_id3151308				0	ne	\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>\</caseinline\>\<defaultinline\>तपाईँं दायाँ-क्लिक गर्न सक्नुहुन्छ \<emph\>पृष्ठ सङ्ख्या\</emph\> फाँट \<emph\>स्थितिपट्टीको बायाँ अन्त्यको\</emph\> कागजात सञ्झ्यालको तल्लोमा, र पुस्तकचिनो रोज्नुहोस् गर्नुहोस् जुन तपाईँं जान चाहनुहुन्छ.\</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04040000.xhp	0	help	par_id3153677	3			0	ne	निश्चित पुस्तकचिनोमा जानका लागि, F5 थिच्नुहोस् खोल्नका लागि, \<link href=\"text/swriter/01/02110000.xhp\" name=\"Navigator\"\>नेभिगेटर\</link\>, जोड सङ्केत क्लिक गर्नुहोस् (+) पुस्तकचिनो प्रविष्टि पछि\<emph\> \</emph\> र त्यसपछि डबल क्लिक गर्नुहोस् पुस्तकचिनोमा.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04040000.xhp	0	help	par_id3155178				0	ne	\<ahelp hid=\"SW:COMBOBOX:DLG_INSERT_BOOKMARK:CB_BOOKMARK\"\>पुस्तकचिनोको नाम लेख्नुहोस् जुन तपाईँंले निर्मान गर्न चाहनु भएको थियो. तल्लो सूचीले सबै हालको कागजातको पुस्तकचिनोहरू देखाउँदछ. पुस्तकचिनो मेटाउन, सूचीमा चयन गर्नुहोस् , र त्यसपछि क्लिक गर्नुहोस् \<emph\>Delete\</emph\>.\</ahelp\>				2002-02-02 02:02:02
