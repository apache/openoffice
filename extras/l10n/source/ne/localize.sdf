helpcontent2	source\text\shared\01\01190000.xhp	0	help	par_id3156327				0	ne	\<ahelp hid=\"SFX2:MODALDIALOG:DLG_VERSIONS\"\>हालका कागजातको अवस्थित संस्करणहरू, तिनीहरू सिर्जना गरिएको मिति र समय, लेखक र सम्बन्धित टिप्पणीहरू सूची गर्दछ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01190000.xhp	0	help	par_id3157898				0	ne	\<variable id=\"versionentext\"\>\<ahelp hid=\".uno:VersionDialog\"\>हालको कागजातको बहु संस्करण समान फाइलमा बचत गर्दछ र सङ्गठित गर्छ । तपाईँले पहिलेका संस्करण खोल्न, मेटाउन, र दाँज्न पनि सक्नुहुन्छ ।\</ahelp\>\</variable\>				2002-02-02 02:02:02
