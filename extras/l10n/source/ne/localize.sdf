helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3151183				0	ne	\<ahelp hid=\"SW:CHECKBOX:TP_FORMAT_TABLE:CB_REL_WIDTH\"\>पृष्ठ चौडाइको प्रतिशतको रूपमा तालिकाको चौडाइ प्रदर्शन गर्नुहोस्.\</ahelp\>				2002-02-02 02:02:02
