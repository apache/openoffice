helpcontent2	source\text\swriter\01\02170000.xhp	0	help	hd_id3153638				0	ne	विकल्प				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02170000.xhp	0	help	hd_id3153673				0	ne	सेक्सनहरू सम्पादन गर्नुहोस्				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02170000.xhp	0	help	hd_id3155143				0	ne	पूर्वस्थितिमा फर्काउनुहोस्				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02170000.xhp	0	help	par_id3143275				0	ne	The \<emph\>विभागहरू सम्पादन गर्नुहोस्\</emph\> संवाद \<link href=\"text/swriter/01/04020100.xhp\" name=\"Insert - Section\"\>\<emph\>विभाग - घुसानुहोस्\</emph\>\</link\> संवाद, र तलका थप विकल्पलाई अफर गर्नुहोस्:				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02170000.xhp	0	help	par_id3145413				0	ne	\<ahelp hid=\"SW:PUSHBUTTON:MD_EDIT_REGION:CB_DISMISS\" visibility=\"visible\"\>कागजातबाट रोज्नुहोस् गरिएको विभागहरू हटाउनुहोस्, र विभागको सामाग्रीहरू कागजातमा घुसाउनुहोस्.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02170000.xhp	0	help	par_id3149040				0	ne	सेक्सनको हालको लेखन सुरक्षा स्थिति ताल्चा लगाइएको प्रतीकद्वारा सूचीत गरिन्छ सूचीको सेक्सन नामको अगाडि. खुला ताल्चा लगाइएको असुरक्षित हुन्छ र बन्द ताल्चा लगाइएको सुरक्षित हुन्छ. त्यसैले, दृश्यात्मक सेक्सनहरू ग्लासहरूको प्रतीकद्वारा सूचीत गरिन्छ.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02170000.xhp	0	help	par_id3149104	5			0	ne	\<ahelp visibility=\"visible\" hid=\"HID_REGION_TREE\"\>सेक्सनको नाम टाइप गर्नुहोस् जुन तपाईँं सम्पादन गर्न चाहनुहुन्छ, वा नाम क्लिक गर्नुहोस् \<emph\>सेक्सन \</emph\>सूचीमा.\</ahelp\> यदि कर्सर हालमा सेक्सनमा छ भने, सेक्सन नाम कागजात सञ्झ्यालको तलको स्थितिपट्टीको दायाँ साइडमा प्रदर्शन हुन्छ.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02170000.xhp	0	help	par_id3152773				0	ne	\<ahelp visibility=\"visible\" hid=\"HID_REGION_TREE\"\>खोल्नुहोस् \<link href=\"text/swriter/01/05040501.xhp\" name=\"Options\"\>\<emph\>विकल्प\</emph\>\</link\> संवादहरू, जहाँ तपाईँं चयन सेक्सनको स्तम्भ सजावट, पृष्ठभूमि, पादटिप्पणी र अन्तटिप्पणी ब्यवहार सम्पादन गर्न सक्नुहुन्छ.\</ahelp\> यदि सेक्सन पासवर्ड सुरक्षित छ भने, तपाईँंले पहिला पासवर्ड प्रविष्ट गर्नुपर्दछ.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02170000.xhp	0	help	par_id3155902				0	ne	\<variable id=\"bereichetext\"\>\<ahelp hid=\".uno:EditRegion\" visibility=\"visible\"\>तपाईँंको कागजातमा परिभाषित भएको विभागहरूको गुणहरू परिवर्तन गर्नुहोस्.\</ahelp\> विभाग घुसाउनका लागि, पाठ रोज्नुहोस् गर्नुहोस् वा तपाईँंको कागजातमा क्लिक गर्नुहोस्, र त्यसपछि रोज्नुहोस् गर्नहोस् \<emph\>घुसाउनुहोस् - विभाग\</emph\>.\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02170000.xhp	0	help	tit				0	ne	सेक्सनहरू सम्पादन गर्नुहोस्				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\03050000.xhp	0	help	hd_id3149287				0	ne	\<link href=\"text/swriter/01/03050000.xhp\" name=\"Ruler\"\>रुलर\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\03050000.xhp	0	help	par_id3147514				0	ne	\<ahelp hid=\".uno:Ruler\"\>तेर्सो रुलर देखाउनुहोस् वा लुकाउनुहोस्, जुन तपाईँं पृष्ठ सीमान्तहरू, ट्याब रोकावटहरू, इन्डेन्टहरू, किनाराहरू, तालिका कक्षहरू, र पृष्ठमा वस्तुहरू मिलाउनका लागि समायोजन गर्न प्रयोग गर्न सक्नुहुन्छ.\</ahelp\> तेर्सो रुलर देखाउनका लागि, रोज्नुहोस् गर्नुहोस् \<link href=\"text/shared/optionen/01040200.xhp\" name=\"उपकरणहरू - विकल्प - राइटर - दृश्य\"\>\<emph\>उपकरणहरू - विकल्प - %PRODUCTNAME राइटर - दृश्य\</emph\>\</link\>, र चयन गर्नुहोस् \<emph\>ठाडो रुलर\</emph\> जाँच बाकस \<emph\>रुलर\</emph\> क्षेत्रमा.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\03050000.xhp	0	help	par_idN1061A				0	ne	\<embedvar href=\"text/swriter/guide/ruler.xhp#ruler\"/\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\03050000.xhp	0	help	tit				0	ne	रुलर				2002-02-02 02:02:02
