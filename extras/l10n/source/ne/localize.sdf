helpcontent2	source\text\shared\optionen\01050100.xhp	0	help	par_id3149294				0	ne	\<switchinline select=\"appl\"\>\<caseinline select=\"DRAW\"\>\<variable id=\"rastertextdraw\"\>पृष्ठका लागि प्रसङ्ग मेनुमा\<emph\>ग्रिड - दृश्यात्मक ग्रिड\</emph\> सँग ग्रिडको दृश्यता स्विच गर्न सम्भव छ। तपाईँंले वस्तुहरूको अगाडि ग्रिड प्रदर्शन गर्नलाई यो प्रसङ्ग मेनुको\<emph\>ग्रिड - अगाडि ग्रिड गर्नुहोस\</emph\> सहायक मेनु पनि चयन गर्न सक्नुहुन्छ। \</variable\>\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
