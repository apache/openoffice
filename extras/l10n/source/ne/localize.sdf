helpcontent2	source\text\schart\01\05020201.xhp	0	help	par_id3147436	75			0	ne	\<variable id=\"sytextbeschr\"\>\<ahelp hid=\".uno:ToggleAxisDescr\"\>ले\<emph\>अक्षहरू शिर्ष खूला/बन्द \</emph\>प्रतिमा  \<emph\>ढाँचा\</emph\> पट्टिमा सबै अक्षहरू खुला अथवा बन्दको लेबुल गर्दा स्विच गर्दछ ।\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\05020201.xhp	0	help	par_id3149018				0	ne	\<ahelp hid=\"HID_SCH_ALIGNMENT_CTR_DIAL\"\>व्हिलको कुनैपनि स्थान क्लिक गर्दा चल पाठ पृष्ठविन्यास परिभाषित गर्दछ ।\</ahelp\> बटका अक्षरहरू "ABCD" ले नयाँ अक्षरलाई अनुरूप गराउँदछन् ।				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\05020201.xhp	0	help	par_id3149353				0	ne	यदि तपाईँंको चित्रपट धेरै सानो भएको खण्डमा लेबुलहरू प्रदर्शनमा समस्या आउन पनि सक्दछन् । तपाईँं कि त दृश्यलाई  बढाउँदा यात फन्ट साइज घट्दो क्रमद्वारा यसलाई बिर्सन सक्नुहुन्छ ।				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\05020201.xhp	0	help	par_id3150199				0	ne	\<ahelp hid=\"HID_SCH_ALIGNMENT_DEGREES\"\>तपाईँंलाई पृष्ठविन्यास कोण हातैले प्रविष्ट गर्न अनुमति दिन्छ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\05020201.xhp	0	help	par_id3150342				0	ne	यदि तपाईँंले ठाडो x-अक्ष लेबुल परिभाषित गरेको खण्डमा, पाठले x-अक्षको पाठ रेखाद्वारा हटाउन पनि सक्दछन्.				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\05020201.xhp	0	help	par_id3150439				0	ne	सबै लेबुलहरूका लागि केही सूचीकृत विकल्प उपलब्ध हुँदैनन् । उदाहरणका लागि, द्वि आयामिक अथबा त्रि आयामिक वस्तु लेबुलहरूका लागि त्यहाँ सबै फरक विकल्प हुन्छन् ।				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\05020201.xhp	0	help	par_id3151240				0	ne	\<ahelp hid=\"SCH:CHECKBOX:TP_AXIS_LABEL:CB_AXIS_LABEL_TEXTOVERLAP\"\>निर्दिष्ट गर्दछ जसले कक्षहरूका पाठहरू अरू कक्षहरूमा खप्ट्याउन पनि सक्दछ \</ahelp\> यदि त्यहाँ स्थानको अभाव भएको खण्डमा यो विशेष रूपमा उपयोगी हुनसक्दछ । यो विकल्प फरक शीर्षक दिशाहरूमा उपलब्ध हुँदैन ।				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\05020201.xhp	0	help	par_id3153958				0	ne	\<ahelp hid=\"SCH:RADIOBUTTON:TP_AXIS_LABEL:RB_AXIS_LABEL_DOWNUP\"\>बिजोर सङ्ख्याहरू त्यसपछि साना जोर सङ्ख्याहरू अक्षमा मिलाउनुहोस् \</ahelp\>				2002-02-02 02:02:02
