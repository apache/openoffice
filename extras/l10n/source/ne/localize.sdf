helpcontent2	source\text\shared\02\06050000.xhp	0	help	par_id3149549	4			0	ne	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\> \<emph\> एक तह तल लैजानुहोस \</emph\> प्रतिमा \<emph\>गोलिचिन्हहरू र सङ्ख्यांकन\</emph\>पट्टीमा छ, जुन चाही जब सूचक सङ्ख्यात्मक वा गोलिचिन्ह वस्तुहरूमा अवस्थित गरिएको बेलामा देखा पर्दछ। \</caseinline\>\<caseinline select=\"IMPRESS\"\>  \<emph\>अवनत गर्नुहोस \</emph\> प्रतिमा \<emph\>पाठ ढाँचा\</emph\> पट्टीमा छ,जुन चाही जब बाह्यरेखा दृष्टीमा काम गरिरहेको बेलामा देखा पर्दछ।\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
