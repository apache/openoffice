helpcontent2	source\text\swriter\01\05060200.xhp	0	help	par_id3147284				0	ne	\<ahelp hid=\"SW:METRICFIELD:TP_FRM_WRAP:ED_TOP_MARGIN\"\>खाली स्थानको मात्रा प्रविष्ट गर्नुहोस् जुन तपाईँं वस्तुको माथि कुना र पाठ बीचमा चाहनुहुन्छ.\</ahelp\>				2002-02-02 02:02:02
