helpcontent2	source\text\smath\01\03090800.xhp	0	help	par_id3154376	56			0	ne	\<ahelp hid=\"HID_SMA_XUNIONY\"\>घुसाउनका लागि यो प्रतिमा प्रयोग गर्नुहोस् \<emph\>union\</emph\> दुईवटा प्लेसहोल्डर सँग सेट सञ्चालनकर्ता.\</ahelp\> तपाईँ प्रविष्ट पनि गर्न सक्नुहुन्छ \<emph\><?> union <?> \</emph\>आदेश सञ्झ्यालहरूमा सिधा 				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090800.xhp	0	help	par_id3154641	2			0	ne	\<ahelp hid=\"HID_SMA_SETOPERATIONS_CAT\"\>क्यारेक्टरहरूलाई बिभिन्न सेट सञ्चालनकर्ताहरू मानाङ्कन गर्नुहोस् \<emph\>$[officename] म्याथ\</emph\> सूत्रमा. व्यक्तिगत सञ्चालनकर्ताहरू चयन सञ्झ्यालको तल्लो सेक्सनमा देखाइन्छ\</ahelp\>. बोलानुहोस् \<link href=\"text/shared/00/00000001.xhp#kontextmenue\" name=\"context menu\"\>सामाग्री मेनु\</link\> \<emph\>आदेश\</emph\> सञ्झ्यालहरूमा व्यक्तिगत प्रकार्यहरूको पहिचायक सूची हेर्नका लागि. कुनै सञ्चालनकर्ताहरू जुन चयन सञ्झ्यालमा पत्ता लाग्दैन सिधा आदेश सञ्झ्यालहरूमा प्रविष्ट गर्नुपर्दछ. तपाईँ अन्य सूत्रहरूको अंश घुसाउन सक्नुहुन्छ यदि प्रतीकहरू तिनीहरूका लागि पहिले नै बन्द भइसक्यो भने 				2002-02-02 02:02:02
