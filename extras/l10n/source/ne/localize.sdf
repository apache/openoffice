helpcontent2	source\text\shared\01\01020000.xhp	0	help	par_id3153779	24			0	ne	\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>\</caseinline\>\<defaultinline\>उदाहरणका लागि, निर्देशिकामा सबै पाठ फाइलहरूको सूची बनाउँन, पाठ फाइल विस्तार (*.txt) सँगै एस्ट्रिक वाईल्डकार्ड प्रविष्ट गर्नुहोस् र त्यसपछि\<emph\> खोल्नुहोस्\</emph\> मा क्लिक गर्नुहोस्। (??3*.txt) मा जस्तै कुनै पनि क्यारेक्टर प्रस्तुत गर्न प्रश्न चिन्ह (?) प्रयोग गर्नुहोस् जसले फाइल नाममा तेर्सो क्यारेक्टरको रूपमा '3' सँग पाठ फाइलहरू मात्र प्रदर्शन गर्दछ ।\</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
