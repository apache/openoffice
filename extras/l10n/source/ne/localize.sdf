helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3153672	37			0	ne	\<ahelp hid=\"SW:RADIOBUTTON:TP_FORMAT_TABLE:RB_FROM_LEFT\"\>तालिकाको बायाँ कुना इन्डेन्ट जुन तपाईँंले \<emph\>बायाँ \</emph\>बाकस \<emph\>स्पेसिङ \</emph\>क्षेत्रमा पङ्क्तिबद्व गर्नुहोस्.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3154108				0	ne	\<ahelp hid=\"SW:RADIOBUTTON:TP_FORMAT_TABLE:RB_FULL\"\>बायाँ र दायाँ पृष्ठ सीमान्तहरूमा तालिका तेर्सो रूपमा विस्तार गर्नुहोस्.\</ahelp\> HTML कागजातहरूमा यो तालिकाहरूका लागि सिफारिस सेटिङ हो.				2002-02-02 02:02:02
