uui	source\cookiedg.src	0	string	STR_COOKIES_RECV_START				295	ne	'${HOST}' सर्भरले एक वा सो भन्दा बढी कुकीहरू सेट गर्न चाहान्छ ।\nकुकीहरूमा निश्चित URL वर्गहरूलाई अपिल गर्ने सूचना समावेश छ । यदि %PRODUCTNAME पछिका अनुरोधहरूको कागजात पहिलेका कुकिसेटको वर्गमा URL सँग सम्बन्धित छ भने, %PRODUCTNAME को यो सूचना सर्भरसँग पठाइने छ । यसले WWW अनुप्रयोगको वस्तुस्थिति पहिचान गर्ने सर्भरलाई अनुमति दिन्छ,उदाहरण का लागि-अनलाइनमा किनमेल गरींदा ।\n\n निम्न कुकीहरू सेट हुनै पर्दछ:\n\n				2002-02-02 02:02:02
uui	source\cookiedg.src	0	string	STR_COOKIES_RECV_TITLE				295	ne	कुकी सोधपुछ				2002-02-02 02:02:02
uui	source\cookiedg.src	0	string	STR_COOKIES_SEND_COOKIES				295	ne	डोमेन: ${DOMAIN}, मार्ग: ${PATH}, कुकी: ${COOKIE} ।\n				2002-02-02 02:02:02
uui	source\cookiedg.src	0	string	STR_COOKIES_SEND_START				295	ne	%PRODUCTNAME सर्भरका लागि '${HOST}कुकीहरू बचत गरिएको छ,जब कागजात अनुरोध गरिन्छ तब त्यसलाई पठाइने छ । ${PATH}\nनिश्चित URL वर्गहरूमा प्रेषित गरिंदा कुकीहरूको सूचना समावेश गरिन्छ । तिनीहरू केही सर्भरहरूद्वारा %PRODUCTNAME मा पठाइन्छ, जहाँ तिनीहरू बचत गरिएकाछन्, त्यहाँ निश्चित कागजातहरू पहुँच प्राप्त हुन्छन् । यदि %PRODUCTNAME कागजात लोड गरिन्छन् कि URL को अनुसार ति पहिलेका प्राप्त कुकीहरू को एउटा वर्ग मा सम्बन्धित हुन्छ , %PRODUCTNAME को यो सूचना त्यो सर्भर मा पठाइने छ । यो योग्य बनाइने सर्भर अनुप्रयोग WWW को स्तरको ट्राकमा राखिन्छ, उदाहरणका लागि -अनलाइनमा किनमेल गरिंदा ।\n\n निम्न कुकीहरू सेट हुनै पर्दछ:\n\n				2002-02-02 02:02:02
