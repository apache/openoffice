helpcontent2	source\text\swriter\01\05140000.xhp	0	help	par_id3149800				0	ne	\<ahelp hid=\".uno:ParaStyle\"\> अनुच्छेदहरूका लागि ढाँचा शैलीहरू प्रदर्शन गर्दछ। \</ahelp\> उस्तै \<link href=\"text/shared/00/00000005.xhp#formatierung\" name=\"formatting\"\>ढाँचा\</link\> लागू गर्नलाई अनुच्छेद शैलीहरू प्रयोग गर्नुहोस्,जस्तै फन्ट,क्रमाङ्कन र तपाईँंको कागजात भित्र अनुच्छेदहरूमा सजावट।				2002-02-02 02:02:02
