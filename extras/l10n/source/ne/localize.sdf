helpcontent2	source\text\swriter\01\01160300.xhp	0	help	hd_id3151316				0	ne	प्रति तह सहायकबिन्दुहरू				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\01160300.xhp	0	help	par_id3149286	2			0	ne	\<variable id=\"autoabstracttext\"\>\<ahelp hid=\".uno:CreateAbstract\"\>सक्रिय कागजात नयाँ AutoAbstract पाठ कागजातमा पछिल्लो अनुचछेदहरूको हेडिङहरू र सङ्ख्याहरू प्रतिलिपि बनाउनुहोस्. AutoAbstract प्रयोगशाली छ लामो कागजातहरूको अधिदृश्य स्थापित गर्नका लागि \</ahelp\> तपाईँं रूपरेखा स्तरहरूको सङ्ख्या निश्चित गर्न सक्नुहुन्छ साथसाथै अनुच्छेदहरूको सङ्ख्या जुन त्यहाँ प्रदर्शन भएको थियो. निश्चित सेटिङहरू मार्फतको सबै स्तरहरू र अनुच्छेदहरू लुकाइएको छ । \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\01160300.xhp	0	help	par_id3149804				0	ne	\<ahelp hid=\"SW:NUMERICFIELD:DLG_INSERT_ABSTRACT:NF_LEVEL\"\>नयाँ कागजातमा प्रतिलिपि गर्नका लागि रूपरेखा स्तरहरूको विस्तार प्रविष्ट गर्नुहोस्.\</ahelp\> उदाहरणका लागि, यदि तपाईँं ४ स्तरहरू रोज्नुहोस् गर्नुभयो भने, सबै अनुच्छेदहरू हेडिङ १ देखि हेडिङ ४ सम्म ढाँचा गरिन्छ, पछिल्लो अनुच्छेदहरूको सङ्ख्या सँग जुन निश्चित गरिएको थियो \<emph\>उपबिन्दुहरू प्रति स्तरमा\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\01160300.xhp	0	help	par_id3155892				0	ne	\<ahelp hid=\"SW:NUMERICFIELD:DLG_INSERT_ABSTRACT:NF_PARA\"\>क्रमागत अनुच्छेदहरूको अधिकतम सङ्ख्या AutoAbstract कागजातमा समावेश गर्नका लागि निश्चित गर्नुहोस् प्रत्येक हेडिङ पछि.\</ahelp\> अनुच्छेदहरूको सबै अधिकतम परिभाषित सम्म समावेश गरिन्छ जुन अर्को अनुच्छेद हेडिङ शैली सँग पुग्दैन ।				2002-02-02 02:02:02
