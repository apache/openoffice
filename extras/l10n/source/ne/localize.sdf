helpcontent2	source\text\scalc\01\04070100.xhp	0	help	par_id3154123	31			0	ne	\<emph\>परिभाषित नाम \</emph\>संवाद फाँटहरू भित्र दायराहरू अथवा सन्दर्भ प्रकार परिभाषा गर्न माउसको प्रयोग गर्नु होस् ।				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	par_id3154366				0	ne	\<variable id=\"namenfestlegentext\"\>\<ahelp hid=\".uno:DefineName\"\>संवाद खोल्नुहोस् जहाँ तपाईँंले चयन गरेको क्षेत्रका लागि नाम निर्दिष्ट गर्न सक्नु हुन्छ ।\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	par_id3155131				0	ne	सूत्र पट्टिमा \<emph\>पाना क्षेत्र\</emph\> बाकसले दायराहरूका लागि परिभाषित नामहरूको सूची समाहित गर्नुहोस् । स्प्रेडसिटमा अनुरूप भएका सन्दर्भ हाइलाइटगर्नलाई यो बाकसबाट नाममा क्लिक गर्नु होस् । दिएका सूत्रहरू वा सूत्रको खण्डहरूमा दिएका नामहरू यहाँ सूचीकृत हुँदैन ।				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	par_id3155416				0	ne	सन्दर्भ क्षेत्रको प्रकारमा सम्बन्धित थप विकल्प परिभाषित गर्दछ ।				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	par_id3155766				0	ne	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_NAMES:BTN_CRITERIA\"\>ले चयन भएका क्षेत्र \<link href=\"text/scalc/01/12040300.xhp\" name=\"advanced filter\"\>उन्नत फिल्टर\</link\>मा प्रयोग गर्न परिभाषित गर्दछ ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	par_id3159236				0	ne	\<ahelp hid=\"SC:PUSHBUTTON:RID_SCDLG_NAMES:BTN_ADD\"\>सूचीमा परिभाषित नाम थप्नलाई \<emph\>थप्नुहोस्\</emph\> बटन क्लिक गर्नुहोस् । सूचीबाट चयन गरिएका पहिलेनै अवस्थित नामका लागि अर्को कुनै नाम प्रविष्टि गर्नलाई \<emph\>परिमार्जन गर्नुहोस्\</emph\> बटनमा क्लिक गर्नुहोस् ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	par_id3163712				0	ne	\<ahelp hid=\"SC:COMBOBOX:RID_SCDLG_NAMES:ED_NAME\"\>क्षेत्रको नाम प्रविष्ट गर्नुहोस् जसलाई तपाईँं सन्दर्भका लागि परिभाषित गर्न चाहनुहुन्छ । स्प्रेडसिटमा पहिलेनै परिभाषित भएका सबै क्षेत्र नामहरू तल पाठ फाँटमा सूचीकृत हुन्छन् ।\</ahelp\> यदि सूचीमा नाम क्लिक गरेको खण्डमा कागजातमा अनुरूप सन्दर्भहरू निलो फ्रेममा देखाउने छ । यदि बहुविध कक्ष दायराहरू सोहि क्षेत्र नामको अधिनमा रहे तिनी फरक रङिएका फ्रेमहरूमा प्रदर्शन गरिन्छन्.				2002-02-02 02:02:02
