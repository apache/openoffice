helpcontent2	source\text\smath\01\03090100.xhp	0	help	par_id3151197				0	ne	\<emph\><?>ominus<?>\</emph\>टाइप गर्नुहोस् \<emph\>आदेश\</emph\> सञ्झ्याल\<emph\>वृत्त घटाउ सञ्चालनकर्ता घुसाउन\</emph\> 				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090100.xhp	0	help	par_id3151241				0	ne	\<ahelp hid=\"HID_SMA_UNBINOPS_CAT\"\>तपाईँ बिभिन्न युनरी र बाइनरी सञ्चालनकर्ताहरू छनौट गर्न सक्नुहुन्छ तपाईँको $[officename] म्याथ सूत्र बनाउनका लागि. युनरीले सञ्चालनकर्ताहरू दर्साउँदछ जुनले एउटा प्लेसहोल्डरलाई प्रभाव पार्दछ । बाइनरीले सञ्चालनकर्ताहरूलाई दर्साउँदछ जसले दुई प्लेसहोल्डरहरूलाई जडान गर्दछ. चयन सञ्झ्यालको तल्लो क्षेत्रले व्यक्तिगत सञ्चालनकर्ताहरू प्रदर्शन गर्दछ.\</ahelp\>\<link href=\"text/shared/00/00000001.xhp#kontextmenue\" name=\"context menu\"\> सामाग्री मेनु\</link\>\<emph\>आदेशहरूको\</emph\> सञ्झ्यालले यी सञ्चालनकर्ताहरूको सूची समावेश गर्दछ, साथसाथै थप सञ्चालनकर्ताहरू, यदि तपाईँ सञ्चालनकर्ता चाहनुहुन्छ जुन चयन सञ्झ्याल , सामाग्री मेनु प्रयोग गर्नुहोस् वा सिधा रूपमा टाइप गर्नुहोस् \<emph\>आदेश\</emph\> सञ्झ्यालमा 				2002-02-02 02:02:02
