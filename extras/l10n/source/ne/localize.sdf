helpcontent2	source\text\swriter\01\06060000.xhp	0	help	hd_id3154572				0	ne	शीर्षक नभएको १ - ९				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06060000.xhp	0	help	par_id3145246				0	ne	\<variable id=\"kapnum\"\>\<ahelp hid=\".uno:ChapterNumberingDialog\"\>हालको कागजात भित्र अध्याय क्रमाङ्कनका लागि सङ्ख्या ढाँचा र श्रृङ्खला बर्णन गर्दछ।\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06060000.xhp	0	help	par_id3147512				0	ne	\<ahelp hid=\"HID_OUTLINE_FORM\"\>एउटा रूपरेखा सङ्ख्या ढाँचा वचत वा लोड गर्दछ। वचत गरिएको रूपरेखा सङ्ख्या ढाँचा सबै पाठ कागजातहरूमा उपलब्ध हुन्छ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06060000.xhp	0	help	par_id3147567	55			0	ne	रूपरेखा सङ्ख्याहरूको पर्दा प्रदर्शन हाइलाइट गर्नलाई ,\<emph\>दृश्य -\</emph\>\<emph\>फाँट छायाँङ्कनहरूु\</emph\> रोज्नुहोस्।				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06060000.xhp	0	help	par_id3150350				0	ne	\<ahelp hid=\"HID_NUM_OUTL_NAMED_NUMS\"\>तपाईँंले चयन गरिएको रूपरेखा तहमा मानाङ्कन गर्न चाहेको पूर्वपरिभाषित क्रमाङ्कन शैली चयन गर्नुहोस्।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06060000.xhp	0	help	par_id3150934				0	ne	रूपरेखा क्रमाङ्कन अनुच्छेद शैलीहरूमा लिंक गरिएको हुन्छ. पूर्वनिर्धारित अनुसार, "शीर्षक" अनुच्छेद शैलीहरू (१-१०) समनुरूप रूपरेखा सङ्ख्या स्तरहरू (१-१०) मा मानांकित हुन्छन. यदि तपाईँले चाहनुहुन्छ भने, तपाईँले रूपरेखा सङ्ख्या स्तरमा विभिन्न अनुच्छेद शैलीहरू मानाङ्कन गर्न सक्नुहुन्छ.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06060000.xhp	0	help	par_id3150979				0	ne	\<emph\>ढाँचाबद्ध गर्नुहोस्\</emph\> बटन रूपरेखा क्रमाङ्कनका लागि मात्र उपलब्ध हुन्छ। क्रमाङ्कित वा गोलिचिन्हित सूची शैलीहरूका लागि, अनुच्छेदहरूको क्रमाङ्कन शैलीहरू परिमार्जन गर्नुहोस्।				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06060000.xhp	0	help	par_id3154200				0	ne	\<ahelp hid=\"SW:LISTBOX:DLG_NUM_NAMES:LB_FORM\"\>सूचीमा क्रमाङ्कन शैली क्लिक गर्नुहोस् र त्यसपछि शैलीका लागि एउटा नाम प्रविष्टी गर्नुहोस्। रूपरेखा तह सँग सापेक्ष सङ्ख्याहरू मा शैलीहरू मानाङ्कन गरिएका हुन्छन। \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06060000.xhp	0	help	par_id3155892				0	ne	\<ahelp hid=\"HID_NUM_OUTL_NUM_SAVEAS\"\>एउटा संवाद खोल्दछ जहाँ तपाईँंले हालको सेटिङहरू चयन गरिएको रूपरेखा तहका लागि वचत गर्न सक्नुहुन्छ। तपाईँंले त्यसपछी यि सेटिङहरूलाई अन्य कागजात बाट लोड गर्न सक्नुहुन्छ।\</ahelp\>				2002-02-02 02:02:02
