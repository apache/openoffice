desktop	source\migration\wizard.src	0	fixedtext	TP_UPDATE_CHECK	FT_UPDATE_CHECK_BODY			0	ne	%PRODUCTNAME ले नयाँ संस्करणका लागि नियमित अन्तरालमा स्वचालित रूपमा खोजी गर्दछ ।\nसो कार्यमा अनलाइन अद्यावधिकले व्यक्तिगत डेटा स्थानान्तरण गर्दैन ।\nनयाँ संस्करण उपलब्ध हुने बित्तिकै, तपाईँलाई सूचित गरिनेछ ।\n\nतपाईँ यो विशेषतालाई उपकरण / विकल्प... / %PRODUCTNAME / अनलाइन अद्यावधिकमा कन्फिगर गर्न सक्नुहुन्छ ।				2002-02-02 02:02:02
