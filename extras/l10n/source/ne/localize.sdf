helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3147508				0	ne	\<ahelp hid=\"SW:CHECKBOX:TP_OPTSHDWCRSR:CB_ALLOW_IN_PROT\"\>तपाईँंले कर्सरलाई रक्षित क्षेत्रमा सेट गर्न सक्नुहुन्छ, तर कुनै परिवर्तनहरू गर्न सकिँदैन।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3149020				0	ne	प्रत्यक्ष कर्सरका लागि घुसाउनुहोस विकल्प परिभाषित गर्दछ। यदि तपाईँंले कागजातमा कुनै अवस्थामा क्लिक गर्नुभएमा,ठीक यो अवस्थामा एउटा नयाँ अनुच्छेद लेख्न वा घुसाउन सकिन्छ। यो अनुच्छेदको गुणहरू चयन गरिएको विकल्पमा निर्भर गर्दछ।तपाईँंले निम्न विकल्पबाट चयन गर्न सक्नुहुन्छ:				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3149413				0	ne	\<ahelp hid=\"SW_CHECKBOX_TP_OPTSHDWCRSR_CB_HIDDEN\"\>\<emph\>ससर्त पाठ\</emph\> वा \<emph\>लुकेको पाठ\</emph\> फाँटहरूबाट लुकाईएको पाठ प्रदर्शन गर्दछ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3149418				0	ne	\<ahelp hid=\"SW_CHECKBOX_TP_OPTSHDWCRSR_CB_HIDDEN_PARA\"\>यदि तपाईँंले \<emph\>Hidden Paragraph\</emph\> फाँट प्रयोग गरेर पाठ घुसाउनुभयो भने, लुकाईएको अनुच्छेद देखाउनु पर्छ कि भन्ने कुरा वर्णन गर्दछ।\</ahelp\> यो विकल्प सँग खुला पाठ कागजातहरूमा उपलब्ध मेनु आदेश\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<link href=\"text/swriter/01/03140000.xhp\" name=\"View - Hidden Paragraphs\"\>दृश्य - लुकाईएको अनुच्छेदहरू\</link\>\</caseinline\>\<defaultinline\>दृश्य - लुकाईएकोअनुच्छेदहरू\</defaultinline\>\</switchinline\>मा भए जस्तै कार्यहरू छन।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3149964				0	ne	सबै घुसाउनुहोस विकल्पले प्रत्यक्ष कर्सर बाट उत्पन्न गरिएको हालको अनुच्छेद मात्र सन्दर्भ गर्छन।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3150749				0	ne	\<ahelp hid=\"SW:CHECKBOX:TP_OPTSHDWCRSR:CB_SHDWCRSONOFF\"\>प्रत्यक्ष कर्सर सक्रिय बनाउछ।\</ahelp\> तपाईँंले पाठ कागजातमा \<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<link href=\"text/swriter/02/18130000.xhp\" name=\"Direct Cursor On/Off\"\>प्रत्यक्ष कर्सरrसुरु/बन्द\</link\>\</caseinline\>\<defaultinline\>प्रत्यक्ष कर्सरrसुरु/बन्द\</defaultinline\>\</switchinline\> प्रतिमा क्लिक गरेर यो कार्यलाई सक्रिय पार्न पनि सक्नुहुन्छ				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3150874				0	ne	\<ahelp hid=\"SW_CHECKBOX_TP_OPTSHDWCRSR_CB_BREAK\"\> Shift+Enter सर्टकट सँग घुसाईएका सबै रेखा बिच्छेदहरू प्रदर्शन गर्दछ।यि बिच्छेदले एउटा नयाँ हरफ सिर्जना गर्दछ , तर नयाँ अनुच्छेद सुरु गर्दैन।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3151188	12			0	ne	\<ahelp hid=\"SW:RADIOBUTTON:TP_OPTSHDWCRSR:RB_SHDWCRSFILLINDENT\"\>जब प्रत्यक्ष कर्सर प्रयोग गरिन्छ,बायाँ अनुच्छेद ईन्डेन्ट तपाईँंले प्रत्यक्ष कर्सर क्लिक गर्नु भएको ठाउँमा तेर्सो अवस्थामा सेट हुन्छ जहाँ । अनुच्छेद बायाँ पङ्क्तिबद्ध गरिएको छ। \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3152938	36			0	ne	\<ahelp hid=\"SW_CHECKBOX_TP_OPTSHDWCRSR_CB_HSPACE\"\>अविछिन्न खाली स्थानहरू खरानी रङको बाकसहरूको रूपमा देखाइएको छ भन्ने कुरा वर्णन गर्दछ। अविछिन्न खाली स्थानहरू हरफको अन्त्यमा बिच्छेद भएका छैनन् र  \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command+Spacebar \</caseinline\>\<defaultinline\>Ctrl+खाली स्थानपट्टी\</defaultinline\>\</switchinline\> सर्टकट कुञ्जी बाट प्रविष्टि गरिए\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3153574				0	ne	\<ahelp hid=\"SW_CHECKBOX_TP_OPTSHDWCRSR_CB_TAB\"\>ट्याब रोकाईहरू साना बाँणहरूमा प्रदर्शित भएका छन भन्ने कुरा वर्णन गर्दछ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3154123				0	ne	\<ahelp hid=\"SW_CHECKBOX_TP_OPTSHDWCRSR_CB_PARA\"\>यात अनुच्छेद परामितिहरू प्रदर्शित भए भन्ने कुरा वर्णन गर्दछ। अनुच्छेद डेलिमिटरहरूमा अनुच्छेद ढाँचा सूचना पनि समावेश रहेको हुन्छ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3155174				0	ne	\<ahelp hid=\"SW:RADIOBUTTON:TP_OPTSHDWCRSR:RB_SHDWCRSFILLTAB\"\>जब प्रत्यक्ष कर्सर प्रयोग गरिन्छ,क्लिक गरेको अवस्था पूरा नहुँदासम्म नयाँ अनुच्छेदमा आवश्यक ट्याबहरू थप गरिन्छन।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3155450				0	ne	\<ahelp hid=\"HID_OPTSHDWCRSR\"\>$[officename] पाठ र HTML कागजातहरूमा, निश्चित क्यारेक्टरका लागि र प्रत्यक्ष कर्सरका लागि प्रदर्शन परिभाषित गर्दछ।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3155904				0	ne	\<ahelp hid=\"SW:RADIOBUTTON:TP_OPTSHDWCRSR:RB_SHDWCRSFILLSPACE\"\>जब प्रत्यक्ष कर्सर प्रयोग गरिन्छ,क्लिक गरेको अवस्था पूरा नहुँदासम्म नयाँ अनुच्छेदमा सम्बन्धित ट्याबहरूको सङ्ख्या थप गरिन्छन।\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3156343				0	ne	कुन मुद्रण नहुने क्यारेक्टरहरू पर्दामा दृश्य छन भन्ने कुरा परिभाषित गर्दछ। \<emph\>मानक\</emph\>पट्टीमा \<link href=\"text/swriter/01/03100000.xhp\" name=\"Non-printing Characters On/Off\"\>\<emph\> नहुने क्यारेक्टरहरू \</emph\>\</link\>प्रतिमा सक्रिय पार्नुहोस्। तपाईंले \<emph\>सहायताहरू ढाँचाबद्ध गर्दा \</emph\> ट्याब पृष्ठमा चयन गरेका सबै पृष्ठ प्रदर्शन हुनेछन् ।				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3156384	10			0	ne	\<ahelp hid=\"SW:RADIOBUTTON:TP_OPTSHDWCRSR:RB_SHDWCRSFILLMARGIN\"\>प्रत्यक्ष कर्सर प्रयोग भएको बेलामा अनुच्छेद पङ्क्तिबद्धता सेट गर्दछ।माउस कहाँ क्लिक गरिन्छ भन्ने कुरामा निर्भर गरेर,अनुच्छेद चाँहि बायाँ पङ्क्तिबद्धता,केन्द्रीकृत पङ्क्तिबद्धता वा दायाँ पङ्क्तिबद्धता ढाँचाबद्ध हुन्छ।त्रिभुजको माध्यममबाट,कुन पङ्क्तिबद्धता सेट छ भन्ने कुरा कर्सरले माउस-क्लिक भन्दा पहिले देखाँउछ। \</ahelp\>				2002-02-02 02:02:02
