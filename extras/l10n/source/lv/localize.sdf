helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3150010				0	lv	REM rounded Pi = 3.14159				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3149959				0	lv	Dim d1 as Double, dAngle as Double				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3144764				0	lv	d1 = InputBox$ (""Enter the length of the adjacent side: ","Adjacent")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3154491				0	lv	dAngle = InputBox$ ("Enter the angle Alpha (in degrees): ","Alpha")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080102.xhp	0	help	par_id3151074				0	lv	Print "The length of the hypothenuse is"; (d1 / cos (dAngle * Pi / 180))				20200411 15:09:53
