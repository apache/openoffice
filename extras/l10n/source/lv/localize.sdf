helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	hd_id3149803				0	lv	\<variable id=\"minute\"\>\<link href=\"text/scalc/01/func_minute.xhp\"\>MINUTE\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	par_id3148988				0	lv	\<ahelp hid=\"HID_FUNC_MINUTE\"\>Calculates the minute for an internal time value.\</ahelp\> The minute is returned as a number between 0 and 59.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	hd_id3154343				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	par_id3148660				0	lv	MINUTE(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	par_id3154611				0	lv	\<emph\>Number\</emph\>, as a time value, is a decimal number where the number of the minute is to be returned.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	hd_id3145374				0	lv	Examples				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	par_id3148463				0	lv	\<item type=\"input\"\>=MINUTE(8.999)\</item\> returns 58				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	par_id3149419				0	lv	\<item type=\"input\"\>=MINUTE(8.9999)\</item\> returns 59				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_minute.xhp	0	help	par_id3144755				0	lv	\<item type=\"input\"\>=MINUTE(NOW())\</item\> returns the current minute value.				20200411 15:09:53
