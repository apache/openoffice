helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3150523				0	lv	OCT2HEX(Number; Places)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3159162	236			0	lv	            \<emph\>Number\</emph\> is the octal number. The number can have a maximum of 10 places. The most significant bit is the sign bit, the following bits return the value. Negative numbers are entered as two's complement.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3145420	237			0	lv	            \<emph\>Places\</emph\> is the number of places to be output.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3150504				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3148802	239			0	lv	            \<item type=\"input\"\>=OCT2HEX(144;4)\</item\> returns 0064.				20200411 15:09:53
