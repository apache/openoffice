helpcontent2	source\text\shared\optionen\macrosecurity.xhp	0	help	tit				0	lv	Macro Security				20200411 15:09:53
helpcontent2	source\text\shared\optionen\macrosecurity.xhp	0	help	par_idN1054C				0	lv	\<variable id=\"macrosecurity\"\>\<link href=\"text/shared/optionen/macrosecurity.xhp\"\>Macro Security\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\macrosecurity.xhp	0	help	par_idN1056A				0	lv	The Macro Security dialog appears when a document contains one or more macros. You can also call the dialog from the \<emph\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - \<link href=\"text/shared/optionen/01030300.xhp\"\>%PRODUCTNAME - Security\</link\>\</emph\> page.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01090000.xhp	0	help	tit				0	lv	Formula				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01090000.xhp	0	help	hd_id3150040				0	lv	%PRODUCTNAME Math Options				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01090000.xhp	0	help	par_id3166460				0	lv	\<variable id=\"druckentext\"\>\<ahelp hid=\".uno:SmEditOptions\"\>Defines the print format and print options for all new formula documents. These options apply when you print a formula directly from \<item type=\"productname\"\>%PRODUCTNAME\</item\> Math.\</ahelp\>\</variable\> You can also call the dialog by clicking the \<emph\>Options\</emph\> button in the \<emph\>Print\</emph\> dialog. The settings you define in the \<emph\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\>\</emph\> dialog will be permanent settings, whereas the settings in the Print dialog are only valid for the current document.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01090000.xhp	0	help	hd_id3154143				0	lv	\<link href=\"text/shared/optionen/01090100.xhp\" name=\"Options\"\>Options\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	tit				0	lv	Formatting Aids				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	bm_id3144510				0	lv	\<bookmark_value\>non-printing characters (Writer)\</bookmark_value\>\<bookmark_value\>displaying; non-printing characters (Writer)\</bookmark_value\>\<bookmark_value\>paragraph marks; displaying (Writer)\</bookmark_value\>\<bookmark_value\>characters; displaying only on screen (Writer)\</bookmark_value\>\<bookmark_value\>optional hyphens (Writer)\</bookmark_value\>\<bookmark_value\>hyphens; displaying custom (Writer)\</bookmark_value\>\<bookmark_value\>custom hyphens (Writer)\</bookmark_value\>\<bookmark_value\>spaces; displaying (Writer)\</bookmark_value\>\<bookmark_value\>spaces; showing protected spaces (Writer)\</bookmark_value\>\<bookmark_value\>protected spaces; showing (Writer)\</bookmark_value\>\<bookmark_value\>non-breaking spaces (Writer)\</bookmark_value\>\<bookmark_value\>tab stops; displaying (Writer)\</bookmark_value\>\<bookmark_value\>break display (Writer)\</bookmark_value\>\<bookmark_value\>hidden text;showing (Writer)\</bookmark_value\>\<bookmark_value\>hidden fields display (Writer)\</bookmark_value\>\<bookmark_value\>paragraphs; hidden paragraphs (Writer)\</bookmark_value\>\<bookmark_value\>cursor; allowing in protected areas (Writer)\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	hd_id3154285				0	lv	\<link href=\"text/shared/optionen/01040600.xhp\" name=\"Formatting Aids\"\>Formatting Aids\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3155450				0	lv	\<ahelp hid=\"HID_OPTSHDWCRSR\"\>In $[officename] text and HTML documents, defines the display for certain characters and for the direct cursor.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	hd_id3144510				0	lv	Display of				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3156343				0	lv	Defines which non-printing characters are visible on screen. Activate the \<link href=\"text/swriter/01/03100000.xhp\" name=\"Non-printing Characters On/Off\"\>\<emph\>Non-printing Characters\</emph\>\</link\> icon on the \<emph\>Standard\</emph\> bar. All characters that you have selected on the \<emph\>Formatting Aids\</emph\> tab page will be displayed.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	hd_id3154140				0	lv	Paragraph end				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3154123				0	lv	\<ahelp hid=\"SW_CHECKBOX_TP_OPTSHDWCRSR_CB_PARA\"\>Specifies whether paragraph delimiters are displayed. The paragraph delimiters also contain paragraph format information.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	hd_id3153193				0	lv	Custom hyphens				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3147230	32			0	lv	\<ahelp hid=\"SW_CHECKBOX_TP_OPTSHDWCRSR_CB_SHYPH\"\>Specifies whether user-defined delimiters are displayed. These are hidden delimiters that you enter within a word by pressing \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command+Hyphen(-) \</caseinline\>\<defaultinline\>Ctrl+Hyphen(-).\</defaultinline\>\</switchinline\> Words with user-defined delimiters are only separated at the end of a line at the point where a user-defined delimiter has been inserted, irrespective of whether the automatic hyphenation is activated or deactivated.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	hd_id3147287				0	lv	Spaces				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3147427				0	lv	\<ahelp hid=\"SW_CHECKBOX_TP_OPTSHDWCRSR_CB_SPACE\"\>Specifies whether to represent every space in the text with a dot.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	hd_id3145750				0	lv	Non-breaking spaces				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3152938	36			0	lv	\<ahelp hid=\"SW_CHECKBOX_TP_OPTSHDWCRSR_CB_HSPACE\"\>Specifies that non-breaking spaces are shown as gray boxes. Non-breaking spaces are not broken at the end of a line and are entered with the \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command+Shift+Spacebar \</caseinline\>\<defaultinline\>Ctrl+Shift+Spacebar\</defaultinline\>\</switchinline\> shortcut keys.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	hd_id3147348				0	lv	Tabs				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3153574				0	lv	\<ahelp hid=\"SW_CHECKBOX_TP_OPTSHDWCRSR_CB_TAB\"\>Specifies that tab stops are displayed as small arrows.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	hd_id3159154				0	lv	Breaks				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3150874				0	lv	\<ahelp hid=\"SW_CHECKBOX_TP_OPTSHDWCRSR_CB_BREAK\"\>Displays all line breaks inserted with the Shift+Enter shortcut. These breaks create a new line, but do not start a new paragraph.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_idN108E5				0	lv	Hidden text				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_idN108FB				0	lv	\<ahelp hid=\"sw:CheckBox:TP_OPTSHDWCRSR:CB_CHAR_HIDDEN\"\>Displays text that uses the character format "hidden", when \<emph\>View - Non-printing Characters\</emph\> is enabled.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	hd_id3149481				0	lv	Fields: Hidden text (not for HTML documents)				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3149413				0	lv	\<ahelp hid=\"SW_CHECKBOX_TP_OPTSHDWCRSR_CB_HIDDEN\"\>Displays text that is hidden by \<emph\>Conditional Text\</emph\> or \<emph\>Hidden Text\</emph\> fields.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	hd_id3149300				0	lv	Fields: Hidden paragraphs (not for HTML documents)				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3149418				0	lv	\<ahelp hid=\"SW_CHECKBOX_TP_OPTSHDWCRSR_CB_HIDDEN_PARA\"\>If you have inserted text using the \<emph\>Hidden Paragraph\</emph\> field, specifies whether to display the hidden paragraph.\</ahelp\> This option has the same function as the menu commands \<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<link href=\"text/swriter/01/03140000.xhp\" name=\"View - Hidden Paragraphs\"\>View - Hidden Paragraphs\</link\>\</caseinline\>\<defaultinline\>View - Hidden Paragraphs\</defaultinline\>\</switchinline\> available in open text documents.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	hd_id3156180				0	lv	Direct cursor (not for HTML documents)				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3146900				0	lv	Defines all the properties of the direct cursor.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	hd_id3154273				0	lv	Direct cursor				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3150749				0	lv	\<ahelp hid=\"SW:CHECKBOX:TP_OPTSHDWCRSR:CB_SHDWCRSONOFF\"\>Activates the direct cursor.\</ahelp\> You can also activate this function by clicking the \<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<link href=\"text/swriter/02/18130000.xhp\" name=\"Direct Cursor On/Off\"\>Direct Cursor On/Off\</link\>\</caseinline\>\<defaultinline\>Direct Cursor On/Off\</defaultinline\>\</switchinline\> icon in a text document.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	hd_id3152962				0	lv	Insert (not for HTML document)				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3149020				0	lv	Defines the insert options for the direct cursor. If you click at any position in your document, a new paragraph can be written or inserted exactly at this position. The properties of this paragraph depend on the selected option. You can select from the following options:				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	hd_id3148995				0	lv	Paragraph alignment				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3156384	10			0	lv	\<ahelp hid=\"SW:RADIOBUTTON:TP_OPTSHDWCRSR:RB_SHDWCRSFILLMARGIN\"\>Sets the paragraph alignment when the direct cursor is used. Depending on where the mouse is clicked, the paragraph is formatted left aligned, centered or right aligned. The cursor before the mouse-click shows, by means of a triangle, which alignment is set. \</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	hd_id3150387				0	lv	Left paragraph margin				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3151188	12			0	lv	\<ahelp hid=\"SW:RADIOBUTTON:TP_OPTSHDWCRSR:RB_SHDWCRSFILLINDENT\"\>When the direct cursor is used, the left paragraph indent is set at the horizontal position where you click the direct cursor. The paragraph is left aligned. \</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	hd_id3145147				0	lv	Tabs				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3155174				0	lv	\<ahelp hid=\"SW:RADIOBUTTON:TP_OPTSHDWCRSR:RB_SHDWCRSFILLTAB\"\>When the direct cursor is used, as many tabs as necessary are added in the new paragraph until the clicked position is reached.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	hd_id3166449				0	lv	Tabs and Spaces				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3155904				0	lv	\<ahelp hid=\"SW:RADIOBUTTON:TP_OPTSHDWCRSR:RB_SHDWCRSFILLSPACE\"\>When the Direct Cursor is used, a corresponding number of tabs and spaces are inserted in the new paragraph as necessary until the clicked position is reached.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3149964				0	lv	All insert options refer only to the current paragraph generated with the Direct Cursor.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	hd_id3146134				0	lv	Cursor in protected areas - Enabled				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01040600.xhp	0	help	par_id3147508				0	lv	\<ahelp hid=\"SW:CHECKBOX:TP_OPTSHDWCRSR:CB_ALLOW_IN_PROT\"\>Specifies that you can set the cursor in a protected area, but cannot make any changes.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	tit				0	lv	Writing Aids				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	bm_id7986388				0	lv	\<bookmark_value\>writing aids options\</bookmark_value\>\<bookmark_value\>custom dictionaries; editing\</bookmark_value\>\<bookmark_value\>user-defined dictionaries; editing\</bookmark_value\>\<bookmark_value\>dictionaries; editing user-defined\</bookmark_value\>\<bookmark_value\>exceptions; user-defined dictionaries\</bookmark_value\>\<bookmark_value\>user-defined dictionaries; dictionary of exceptions\</bookmark_value\>\<bookmark_value\>spellcheck; dictionary of exceptions\</bookmark_value\>\<bookmark_value\>ignore list for spellcheck\</bookmark_value\>\<bookmark_value\>spellcheck; ignore list\</bookmark_value\>\<bookmark_value\>hyphenation; minimal number of characters\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3145136				0	lv	\<link href=\"text/shared/optionen/01010400.xhp\" name=\"Writing Aids\"\>Writing Aids\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3153527				0	lv	\<ahelp hid=\"HID_OPTIONS_LINGU\"\>Specifies the properties of the spellcheck, thesaurus and hyphenation.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3149096				0	lv	Available Language Modules				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3154749				0	lv	\<ahelp hid=\"HID_CLB_LINGU_MODULES\"\>Contains the installed language modules.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3153663	35			0	lv	A language module can contain one, two or three submodules: Spellcheck, hyphenation and thesaurus. Each sub-module can be available in one or more languages. If you click in front of the name of the module, you activate all the available sub-modules simultaneously. If you remove a set mark, you deactivate all the available sub-modules simultaneously. If you wish to activate or deactivate individual sub-modules, click the\<emph\> Edit button \</emph\>to open the \<link href=\"text/shared/optionen/01010401.xhp\" name=\"Edit Modules\"\>\<emph\>Edit Modules\</emph\>\</link\> dialog.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3294778				0	lv	The configuration allows for two different directories: one folder where the user has write permissions, and one without write permissions. The user can only edit and delete the user dictionaries that are located in the writable path. Other dictionaries can be read only.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3154307				0	lv	Edit				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3145673	37			0	lv	\<ahelp hid=\"SVX_PUSHBUTTON_RID_SFXPAGE_LINGU_PB_LINGU_MODULES_EDIT\"\>To edit a language module, select it and click \<emph\>Edit\</emph\>.\</ahelp\> The \<link href=\"text/shared/optionen/01010401.xhp\" name=\"Edit Modules\"\>\<emph\>Edit \</emph\>\<emph\>Modules\</emph\>\</link\> dialog appears.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3153348				0	lv	User-defined dictionaries				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3155419				0	lv	\<ahelp hid=\"HID_CLB_EDIT_MODULES_DICS\"\>Lists the available user dictionaries.\</ahelp\> Mark the user dictionaries that you want to use for spellcheck and hyphenation.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3144511				0	lv	New				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3146794				0	lv	\<ahelp hid=\"SVX_PUSHBUTTON_RID_SFXPAGE_LINGU_PB_LINGU_DICS_NEW_DIC\"\>Opens the \<emph\>New Dictionary\</emph\> dialog, in which you can name a new user-defined dictionary or dictionary of exceptions and specify the language.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3151054				0	lv	New Dictionary				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3153360				0	lv	In the \<emph\>Dictionary\</emph\> section you can name a new user-defined dictionary or dictionary of exceptions and specify the language.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3150398				0	lv	Name				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3153192				0	lv	\<ahelp hid=\"SVX:EDIT:RID_SFXDLG_NEWDICT:ED_DICTNAME\"\>Specifies the name of the new custom dictionary.\</ahelp\> The file extension "*.DIC" is automatically appended.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3150767				0	lv	Language				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3148920				0	lv	\<ahelp hid=\"SVX:LISTBOX:RID_SFXDLG_NEWDICT:LB_DICTLANG\"\>By selecting a certain language you can limit the use of the custom dictionary.\</ahelp\> By selecting \<emph\>All\</emph\> the custom dictionary is used independently of the current language.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3153106				0	lv	Exceptions (-)				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3149561				0	lv	\<ahelp hid=\"SVX:CHECKBOX:RID_SFXDLG_NEWDICT:BTN_EXCEPT\"\>Specifies whether you wish to avoid certain words in your documents.\</ahelp\> In this way, you can create a custom dictionary of all the words to be avoided. If this exception dictionary is activated, during spellchecking you receive a corresponding note about any words which should be avoided.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3145785				0	lv	Edit				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3152576				0	lv	\<ahelp hid=\"SVX_PUSHBUTTON_RID_SFXPAGE_LINGU_PB_LINGU_DICS_EDIT_DIC\"\>Opens the \<emph\>Edit custom dictionary\</emph\> dialog, in which you can add to your custom dictionary or edit existing entries.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3147436	75			0	lv	In the \<emph\>Edit custom dictionary \</emph\>dialog you have the option to enter new terms or edit existing entries. If you edit an exception dictionary, the dialog has the added facility of defining an exception for a word. During the spellcheck this exception is then listed as a suggestion.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3145750	76			0	lv	When a dictionary is edited, a check is made on the status of the file. If the file is write-protected, it cannot be changed. The buttons \<emph\>New\</emph\> and \<emph\>Delete\</emph\> are then deactivated. 				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3150116				0	lv	Book				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3147394				0	lv	\<ahelp hid=\"SVX:LISTBOX:RID_SFXDLG_EDITDICT:LB_ALLDICTS\"\>Specifies the book to be edited.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3154730	79			0	lv	\<variable id=\"ignore\"\>The \<emph\>IgnoreAllList (All) \</emph\>includes all words that have been marked with \<emph\>Ignore\</emph\> during spellcheck. This list is valid only for the current spellcheck. \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3154757				0	lv	The \<emph\>IgnoreAllList\</emph\> entry cannot be selected and cannot be deleted. Only the words included as content can be deleted. This happens automatically each time that $[officename] is closed.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3149018				0	lv	Language				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3154255				0	lv	\<ahelp hid=\"SVX:LISTBOX:RID_SFXDLG_EDITDICT:LB_DICTLANG\"\>Assigns a new language to the current custom dictionary.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3151189				0	lv	Word				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3151252				0	lv	\<ahelp hid=\"SVX:EDIT:RID_SFXDLG_EDITDICT:ED_WORD\"\>You can type a new word for inclusion in the dictionary. In the list below you will see the contents of the current custom dictionary.\</ahelp\> If you select a word from this list it is displayed in the text field. If you type a word with a trailing = character, such as "AutoComplete=", the word is never automatically hyphenated and no hyphenation is suggested. Typing "Auto=Complete" results in the word being hyphenated, or a hyphenation suggested, where you insert the = sign.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3155175				0	lv	Suggestion				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3147323				0	lv	\<ahelp hid=\"SVX:EDIT:RID_SFXDLG_EDITDICT:ED_REPLACE\"\>This input field is only available if you are editing an exception dictionary. The field shows the alternative suggestion for the current word in the "Word" text box.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3147361				0	lv	New				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3163808	89			0	lv	\<ahelp hid=\"SVX:PUSHBUTTON:RID_SFXDLG_EDITDICT:PB_NEW_REPLACE\"\>Adds the word in the \<emph\>Word \</emph\>text field to your current custom dictionary. The word in the \<emph\>Suggestion \</emph\>field is also added when working with exception dictionaries.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3145790				0	lv	\<ahelp hid=\".\" visibility=\"hidden\"\>Removes the marked word from the current custom dictionary.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3151277				0	lv	\<ahelp hid=\".\" visibility=\"hidden\"\>Deletes the selected dictionary after a confirmation, provided it is not write-protected.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3149032				0	lv	Options				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3145259				0	lv	\<ahelp hid=\"HID_CLB_LINGU_OPTIONS\"\>Defines the options for the spellcheck and hyphenation.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3149965				0	lv	Edit				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3153231				0	lv	\<ahelp hid=\"SVX_PUSHBUTTON_RID_SFXPAGE_LINGU_PB_LINGU_OPTIONS_EDIT\"\>If you want to change a value, select the entry and then click \<emph\>Edit\</emph\>.\</ahelp\> You will see a dialog for entering a new value.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3150983				0	lv	Check uppercase words				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3152582				0	lv	Specifies that capitalization is checked during spellcheck.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3150826				0	lv	Check words with numbers.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3150208				0	lv	Specifies that words that contain numbers as well as letters are to be checked.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3147509				0	lv	Check capitalization				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3154200				0	lv	Checks for the correct use of capitals at the start of words during spellcheck.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3166424				0	lv	Check special regions				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3150345				0	lv	Specifies that special regions, such as drawing text, are checked during spellcheck.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3166429				0	lv	Check spelling as you type				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3155531				0	lv	\<variable id=\"automatisch\"\>\<ahelp hid=\".uno:SpellOnline\"\>Automatically checks spelling as you type, and underlines errors.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3156291				0	lv	Typing errors are highlighted in the document with a red underline. If you place the cursor over a word marked in this way, you can open the context menu to obtain a list of corrections. Select a correction to replace the word. If you make the same mistake again while editing the document, it will be marked as an error again.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3153815				0	lv	To place the word pair in the \<link href=\"text/shared/01/06040200.xhp\" name=\"AutoCorrect replacement table\"\>AutoCorrect replacement table\</link\>, open the \<link href=\"text/shared/01/06040500.xhp\" name=\"AutoCorrect context menu\"\>AutoCorrect context menu\</link\> and choose \<emph\>AutoCorrect\</emph\>. Make your selection from the submenu. The word is replaced and at the same time the word pair is placed in the replacement table.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3150111	53			0	lv	Minimal number of characters for hyphenation 				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3150316				0	lv	Specifies the minimum number of characters required for automatic hyphenation to be applied. \<ahelp hid=\"HID_LNGDLG_NUM_PREBREAK\" visibility=\"hidden\"\> Type the minimum number of characters that must come before or after the hyphen.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3148823				0	lv	Characters before line break				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3156029				0	lv	Sets the minimum number of characters of the word to be hyphenated that must remain at the end of the line.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3154956				0	lv	Characters after line break				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3149439				0	lv	Specifies the minimum number of characters of a hyphenated word required at the next line.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3156337				0	lv	Hyphenate without inquiry				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3151130				0	lv	Specifies that you will never be asked for a manual hyphenation. If the field is not marked, when a word is not recognized you will be presented with a dialog for entering hyphens.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	hd_id3155900				0	lv	Hyphenate special regions				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3155098				0	lv	Specifies that hyphenation will also be carried out in footnotes, headers and footers.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01011000.xhp	0	help	tit				0	lv	Memory				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01011000.xhp	0	help	bm_id3153881				0	lv	\<bookmark_value\>undoing; number of steps\</bookmark_value\>\<bookmark_value\>graphics; cache\</bookmark_value\>\<bookmark_value\>cache for graphics\</bookmark_value\>\<bookmark_value\>Quickstarter\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01011000.xhp	0	help	hd_id3157909				0	lv	\<link href=\"text/shared/optionen/01011000.xhp\" name=\"Memory\"\>Memory\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01011000.xhp	0	help	par_id3154307				0	lv	\<ahelp hid=\".\"\>Defines the settings for the graphics cache and the number of steps you can undo.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01011000.xhp	0	help	hd_id3155390				0	lv	Undo				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01011000.xhp	0	help	par_id3145673				0	lv	Defines the maximum number of reverse steps allowed.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01011000.xhp	0	help	hd_id3153881				0	lv	Number of steps				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01011000.xhp	0	help	par_id3148685				0	lv	\<ahelp hid=\"OFFMGR_NUMERICFIELD_OFA_TP_MEMORY_ED_UNDO\"\>You can specify the number of steps which can be undone by selecting a number from the list.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01011000.xhp	0	help	hd_id3147530				0	lv	Graphics cache				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01011000.xhp	0	help	par_id3145069				0	lv	The graphics cache saves the graphics contained in a document in your computer's main memory. This means that the attributes of a graphic stored in the cache do not have to be re-calculated if you return to the page containing the graphic after scrolling through a document.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01011000.xhp	0	help	hd_id3154924				0	lv	Use for $[officename] (MB)				20200411 15:09:53
