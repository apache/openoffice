helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150205				0	lv	ISLEAPYEAR("Date")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3159239				0	lv	\<emph\>Date\</emph\> specifies whether a given date falls within a leap year. The Date parameter must be a valid date according to the locale settings of %PRODUCTNAME.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3149817				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150786				0	lv	=ISLEAPYEAR(A1) returns 1, if A1 contains 1968-02-29, the valid date 29th of February 1968 in your locale setting.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_idN107E7				0	lv	You may also use =ISLEAPYEAR("1968-02-29") or =ISLEAPYEAR("2/29/68").				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_idN107EA				0	lv	Never use =ISLEAPYEAR(2/29/68), because this would first evaluate 2 divided by 29 divided by 68, and then calculate the ISLEAPYEAR function from this small number as a serial date number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3154656				0	lv	\<bookmark_value\>YEARS function\</bookmark_value\>\<bookmark_value\>number of years between two dates\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3154656				0	lv	YEARS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150886				0	lv	\<ahelp hid=\"HID_DAI_FUNC_DIFFYEARS\"\>Calculates the difference in years between two dates.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3154370				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3146114				0	lv	YEARS(StartDate; EndDate; Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3145387				0	lv	\<emph\>StartDate\</emph\> is the first date				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3156290				0	lv	\<emph\>EndDate\</emph\> is the second date				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3152893				0	lv	\<emph\>Type\</emph\> calculates the type of difference. Possible values are 0 (interval) and 1 (in calendar years).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3152898				0	lv	\<bookmark_value\>MONTHS function\</bookmark_value\>\<bookmark_value\>number of months between two dates\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3152898				0	lv	MONTHS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153066				0	lv	\<ahelp hid=\"HID_DAI_FUNC_DIFFMONTHS\"\>Calculates the difference in months between two dates.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3151240				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3146869				0	lv	MONTHS(StartDate; EndDate; Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3145075				0	lv	\<emph\>StartDate\</emph\> is the first date				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3157981				0	lv	\<emph\>EndDate\</emph\> is the second date				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150111				0	lv	\<emph\>Type\</emph\> calculates the type of difference. Possible values include 0 (interval) and 1 (in calendar months).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3159094				0	lv	\<bookmark_value\>ROT13 function\</bookmark_value\>\<bookmark_value\>encrypting text\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3159094				0	lv	ROT13				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3146781				0	lv	\<ahelp hid=\"HID_DAI_FUNC_ROT13\"\>Encrypts a character string by moving the characters 13 positions in the alphabet.\</ahelp\> After the letter Z, the alphabet begins again (Rotation). By applying the encryption function again to the resulting code, you can decrypt the text.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3150893				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3159205				0	lv	ROT13(Text)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153249				0	lv	\<emph\>Text\</emph\> is the character string to be encrypted. ROT13(ROT13(Text)) decrypts the code.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3151300				0	lv	\<bookmark_value\>DAYSINYEAR function\</bookmark_value\>\<bookmark_value\>number of days; in a specific year\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3151300				0	lv	DAYSINYEAR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3143220				0	lv	\<ahelp hid=\"HID_DAI_FUNC_DAYSINYEAR\"\>Calculates the number of days of the year in which the date entered occurs.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3145358				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3154651				0	lv	DAYSINYEAR(Date)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153803				0	lv	\<emph\>Date\</emph\> is any date in the respective year. The Date parameter must be a valid date according to the locale settings of %PRODUCTNAME.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3153487				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153811				0	lv	=DAYSINYEAR(A1) returns 366 days if A1 contains 1968-02-29, a valid date for the year 1968.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3154737				0	lv	\<bookmark_value\>DAYSINMONTH function\</bookmark_value\>\<bookmark_value\>number of days;in a specific month of a year\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3154737				0	lv	DAYSINMONTH				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3149316				0	lv	\<ahelp hid=\"HID_DAI_FUNC_DAYSINMONTH\"\>Calculates the number of days of the month in which the date entered occurs.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3145114				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3150955				0	lv	DAYSINMONTH(Date)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3147501				0	lv	\<emph\>Date\</emph\> is any date in the respective month of the desired year. The Date parameter must be a valid date according to the locale settings of %PRODUCTNAME.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3149871				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3155742				0	lv	=DAYSINMONTH(A1) returns 29 days if A1 contains 1968-02-17, a valid date for February 1968.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3149048				0	lv	\<bookmark_value\>WEEKS function\</bookmark_value\>\<bookmark_value\>number of weeks;between two dates\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3149048				0	lv	WEEKS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3153340				0	lv	\<ahelp hid=\"HID_DAI_FUNC_DIFFWEEKS\"\>Calculates the difference in weeks between two dates.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3150393				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3147402				0	lv	WEEKS(StartDate; EndDate; Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3151387				0	lv	\<emph\>StartDate\</emph\> is the first date				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3146324				0	lv	\<emph\>EndDate\</emph\> is the second date				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3166467				0	lv	\<emph\>Type\</emph\> calculates the type of difference. The possible values are 0 (interval) and 1 (in numbers of weeks).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	bm_id3145237				0	lv	\<bookmark_value\>WEEKSINYEAR function\</bookmark_value\>\<bookmark_value\>number of weeks;in a specific year\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3145237				0	lv	WEEKSINYEAR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3147410				0	lv	\<ahelp hid=\"HID_DAI_FUNC_WEEKSINYEAR\"\>Calculates the number of weeks of the year in which the date entered occurs.\</ahelp\> The number of weeks is defined as follows: a week that spans two years is added to the year in which most days of that week occur.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3149719				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3145638				0	lv	WEEKSINYEAR(Date)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3149946				0	lv	\<emph\>Date\</emph\> is any date in the respective year. The Date parameter must be a valid date according to the locale settings of %PRODUCTNAME.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3150037				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3147614				0	lv	WEEKSINYEAR(A1) returns 53 if A1 contains 1970-02-17, a valid date for the year 1970.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	hd_id3157901				0	lv	Add-ins through %PRODUCTNAME API				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060111.xhp	0	help	par_id3149351				0	lv	Add-ins can also be implemented through the %PRODUCTNAME \<link href=\"https://api.openoffice.org/\"\>API\</link\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05050100.xhp	0	help	tit				0	lv	Rename Sheet				20200411 15:09:53
helpcontent2	source\text\scalc\01\05050100.xhp	0	help	bm_id3147336				0	lv	\<bookmark_value\>worksheet names\</bookmark_value\>\<bookmark_value\>changing; sheet names\</bookmark_value\>\<bookmark_value\>sheets; renaming\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05050100.xhp	0	help	hd_id3147336				0	lv	Rename Sheet				20200411 15:09:53
helpcontent2	source\text\scalc\01\05050100.xhp	0	help	par_id3150792				0	lv	\<variable id=\"umbenennentext\"\>\<ahelp hid=\".uno:RenameTable\"\>This command opens a dialog where you can assign a different name to the current sheet.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05050100.xhp	0	help	hd_id3153968				0	lv	Name				20200411 15:09:53
helpcontent2	source\text\scalc\01\05050100.xhp	0	help	par_id3155131				0	lv	\<ahelp hid=\"HID_SC_APPEND_NAME\"\>Enter a new name for the sheet here.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05050100.xhp	0	help	par_id3153092	5			0	lv	You can also open the\<emph\> Rename Sheet \</emph\>dialog through the context menu by positioning the mouse pointer over a sheet tab at the bottom of the window and \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>clicking while pressing Control\</caseinline\>\<defaultinline\>clicking the right mouse button\</defaultinline\>\</switchinline\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05050100.xhp	0	help	par_id3147396				0	lv	Alternatively, click the sheet tab while pressing the \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Alt\</defaultinline\>\</switchinline\> key. Now you can change the name directly. \<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>\<embedvar href=\"text/shared/00/00000099.xhp#winmanager\"/\>\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	tit				0	lv	Options				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	hd_id2794274				0	lv	Options				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	par_id6776940				0	lv	The Options dialog for the \<link href=\"text/scalc/01/solver.xhp\"\>Solver\</link\> is used to set some options.				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	par_id393993				0	lv	\<ahelp hid=\".\" visibility=\"hidden\"\>Select a solver engine. The listbox is disabled if only one solver engine is installed. Solver engines can be installed as extensions.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	par_id5871761				0	lv	\<ahelp hid=\".\" visibility=\"hidden\"\>Configure the current solver.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	par_id6531266				0	lv	\<ahelp hid=\".\" visibility=\"hidden\"\>If the current entry in the Settings listbox allows to edit a value, you can click the Edit button. A dialog opens where you can change the value.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	par_id3912778				0	lv	\<ahelp hid=\".\" visibility=\"hidden\"\>Enter or change the value.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	par_id3163853				0	lv	Use the Options dialog to configure the current solver engine.				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	par_id121158				0	lv	You can install more solver engines as extensions, if available. Open Tools - Extension Manager and browse to the Extensions web site to search for extensions.				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	par_id3806878				0	lv	Select the solver engine to use and to configure from the listbox. The listbox is disabled if onle one solver engine is installed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	par_id130619				0	lv	In the Settings box, check all settings that you want to use for the current goal seeking operation. If the current option offers different values, the Edit button is enabled. Click Edit to open a dialog where you can change the value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver_options.xhp	0	help	par_id9999694				0	lv	Click OK to accept the changes and to go back to the \<link href=\"text/scalc/01/solver.xhp\"\>Solver\</link\> dialog.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	tit				0	lv	HOUR 				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	bm_id3154725				0	lv	\<bookmark_value\>HOUR function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	hd_id3154725				0	lv	\<variable id=\"hour\"\>\<link href=\"text/scalc/01/func_hour.xhp\"\>HOUR\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	par_id3149747				0	lv	\<ahelp hid=\"HID_FUNC_STUNDE\"\>Returns the hour for a given time value.\</ahelp\> The hour is returned as an integer between 0 and 23.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	hd_id3149338				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	par_id3150637				0	lv	HOUR(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	par_id3147547				0	lv	\<emph\>Number\</emph\>, as a time value, is a decimal, for which the hour is to be returned.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	hd_id3153264				0	lv	Examples				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	par_id3159215				0	lv	\<item type=\"input\"\>=HOUR(NOW())\</item\> returns the current hour				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	par_id3145152				0	lv	\<item type=\"input\"\>=HOUR(C4)\</item\> returns 17 if the contents of C4 = \<item type=\"input\"\>17:20:00\</item\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_hour.xhp	0	help	par_id3154188				0	lv	\<link href=\"text/scalc/01/04060102.xhp\" name=\"YEAR\"\>YEAR\</link\>, \<link href=\"text/scalc/01/04060102.xhp\" name=\"NOW\"\>NOW\</link\>, \<link href=\"text/scalc/01/04060102.xhp\" name=\"MINUTE\"\>MINUTE\</link\>, \<link href=\"text/scalc/01/04060102.xhp\" name=\"MONTH\"\>MONTH\</link\>, \<link href=\"text/scalc/01/04060102.xhp\" name=\"DAY\"\>DAY\</link\>, \<link href=\"text/scalc/01/04060102.xhp\" name=\"WEEKDAY\"\>WEEKDAY\</link\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140500.xhp	0	help	tit				0	lv	Fill Sheet				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140500.xhp	0	help	hd_id3153897				0	lv	Fill Sheet				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140500.xhp	0	help	par_id3150791				0	lv	\<variable id=\"tabellenfuellentext\"\>\<ahelp hid=\".uno:FillTable\" visibility=\"visible\"\>Specifies the options for transferring sheets or ranges of a certain sheet.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140500.xhp	0	help	par_id3150767				0	lv	In contrast to copying an area to the clipboard, you can filter certain information and calculate values. This command is only visible if you have selected two sheets in the document. To select multiple sheets, click each sheet tab while pressing \<switchinline select=\"sys\"\> \<caseinline select=\"MAC\"\>Command\</caseinline\> \<defaultinline\>Ctrl\</defaultinline\> \</switchinline\> or Shift.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140500.xhp	0	help	hd_id3155131				0	lv	Filling a Sheet				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140500.xhp	0	help	par_id3146119				0	lv	Select the entire sheet by clicking the empty gray box in the upper left of the sheet. You can also select an area of the sheet to be copied.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140500.xhp	0	help	par_id3153726				0	lv	Press \<switchinline select=\"sys\"\> \<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\> and click the tab of the sheet where you want to insert the contents.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140500.xhp	0	help	par_id3147436				0	lv	Select the command \<emph\>Edit - Fill - Sheet\</emph\>. In the dialog which appears, the check box \<emph\>Numbers\</emph\> must be selected (or \<emph\>Paste All\</emph\>) if you want to combine operations with the values. You can also choose the desired operation here.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140500.xhp	0	help	par_id3154942				0	lv	Click \<emph\>OK\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140500.xhp	0	help	par_id3156283				0	lv	This dialog is similar to the \<link href=\"text/shared/01/02070000.xhp\" name=\"Paste Contents\"\>Paste Contents\</link\> dialog, where you can find additional tips.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05030400.xhp	0	help	tit				0	lv	Show				20200411 15:09:53
helpcontent2	source\text\scalc\01\05030400.xhp	0	help	bm_id3147264				0	lv	\<bookmark_value\>spreadsheets; showing columns\</bookmark_value\>\<bookmark_value\>showing; columns\</bookmark_value\>\<bookmark_value\>showing; rows\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05030400.xhp	0	help	hd_id3147264				0	lv	\<link href=\"text/scalc/01/05030400.xhp\" name=\"Show\"\>Show\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05030400.xhp	0	help	par_id3150447				0	lv	\<ahelp hid=\".uno:ShowColumn\"\>Choose this command to show previously hidden rows or columns.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05030400.xhp	0	help	par_id3155131				0	lv	To show a column or row, select the range of rows or columns containing the hidden elements, then choose \<emph\>Format - Row - Show\</emph\> or \<emph\>Format - Column - Show\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05030400.xhp	0	help	par_id3145748				0	lv	To show all hidden cells, first click in the field in the upper left corner. This selects all cells of the table.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05030300.xhp	0	help	tit				0	lv	Hide				20200411 15:09:53
helpcontent2	source\text\scalc\01\05030300.xhp	0	help	bm_id3147265				0	lv	\<bookmark_value\>spreadsheets; hiding functions\</bookmark_value\>\<bookmark_value\>hiding; rows\</bookmark_value\>\<bookmark_value\>hiding; columns\</bookmark_value\>\<bookmark_value\>hiding; sheets\</bookmark_value\>\<bookmark_value\>sheets;hiding\</bookmark_value\>\<bookmark_value\>columns;hiding\</bookmark_value\>\<bookmark_value\>rows;hiding\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05030300.xhp	0	help	hd_id3147265				0	lv	\<link href=\"text/scalc/01/05030300.xhp\" name=\"Hide\"\>Hide\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05030300.xhp	0	help	par_id3156281				0	lv	\<ahelp hid=\".uno:Hide\"\>Hides selected rows, columns or individual sheets.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05030300.xhp	0	help	par_id3148645	3			0	lv	Select the rows or columns that you want to hide, and then choose \<emph\>Format - Row - Hide \</emph\>or\<emph\> Format - Column - Hide\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05030300.xhp	0	help	par_id3147427				0	lv	You can hide a sheet by selecting the sheet tab and then choosing \<emph\>Format - Sheet - Hide\</emph\>. Hidden sheets are not printed unless they occur within a \<link href=\"text/scalc/01/05080000.xhp\" name=\"print range\"\>print range\</link\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05030300.xhp	0	help	par_id3153157				0	lv	A break in the row or column header indicates whether the row or column is hidden.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05030300.xhp	0	help	par_id3145251				0	lv	To display hidden rows, columns or sheets				20200411 15:09:53
helpcontent2	source\text\scalc\01\05030300.xhp	0	help	par_id8337046				0	lv	Select the range that includes the hidden objects. You can also use the box in the corner above row 1 and beside column A. For sheets, this step is not necessary.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05030300.xhp	0	help	par_id5532090				0	lv	Choose \<link href=\"text/scalc/01/05030400.xhp\" name=\"Format - Row/Column - Show\"\>Format - Row/Column - Show\</link\> or \<link href=\"text/scalc/01/05050300.xhp\" name=\"Format - Sheet - Show\"\>Format - Sheet - Show\</link\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140300.xhp	0	help	tit				0	lv	Up				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140300.xhp	0	help	hd_id3147264				0	lv	\<link href=\"text/scalc/01/02140300.xhp\" name=\"Up\"\>Up\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140300.xhp	0	help	par_id3150793				0	lv	\<ahelp hid=\".uno:FillUp\" visibility=\"visible\"\>Fills a selected range of at least two rows with the contents of the bottom most cell.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140300.xhp	0	help	par_id3150447				0	lv	If a selected range has only one column, the content of the bottom most cell is copied into the selected cells. If several columns are selected, the contents of the bottom most cells are copied into those selected above.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06030400.xhp	0	help	tit				0	lv	Remove Dependents				20200411 15:09:53
helpcontent2	source\text\scalc\01\06030400.xhp	0	help	bm_id3147335				0	lv	\<bookmark_value\>cells; removing dependents\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06030400.xhp	0	help	hd_id3147335				0	lv	\<link href=\"text/scalc/01/06030400.xhp\" name=\"Remove Dependents\"\>Remove Dependents\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06030400.xhp	0	help	par_id3148663				0	lv	\<ahelp visibility=\"visible\" hid=\".uno:ClearArrowDependents\"\>Deletes one level of tracer arrows created with \<emph\>Trace Dependents\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	tit				0	lv	WEEKNUM				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	bm_id3159161				0	lv	\<bookmark_value\>WEEKNUM function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	hd_id3159161				0	lv	\<variable id=\"weeknum\"\>\<link href=\"text/scalc/01/func_weeknum.xhp\"\>WEEKNUM\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3149770				0	lv	\<ahelp hid=\"HID_FUNC_KALENDERWOCHE\"\>WEEKNUM calculates the week number of the year for the internal date value.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_idN105E4				0	lv	The International Standard ISO 8601 has decreed that Monday shall be the first day of the week. A week that lies partly in one year and partly in another is assigned a number in the year in which most of its days lie. That means that week number 1 of any year is the week that contains the January 4th.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	hd_id3153055				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3147236				0	lv	WEEKNUM(Number; Mode)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3147511				0	lv	\<emph\>Number\</emph\> is the internal date number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3154269				0	lv	\<emph\>Mode\</emph\> sets the start of the week and the calculation type.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3148930				0	lv	1 = Sunday				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3154280				0	lv	2 = Monday				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	hd_id3146948				0	lv	Examples				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3150704				0	lv	=WEEKNUM("1995-01-01";1) returns 1				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknum.xhp	0	help	par_id3149792				0	lv	=WEEKNUM("1995-01-01";2) returns 52. If the week starts on Monday, Sunday belongs to the last week of the previous year.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04050100.xhp	0	help	tit				0	lv	Sheet from file				20200411 15:09:53
