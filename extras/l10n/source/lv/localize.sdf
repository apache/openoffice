helpcontent2	source\text\sbasic\shared\03101600.xhp	0	help	par_id3153189				0	lv	DefObj o				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03101600.xhp	0	help	par_id3152576				0	lv	DefVar v				20200411 15:09:53
