helpcontent2	source\text\schart\01\05040202.xhp	0	help	par_id1006200801024970				0	lv	\<ahelp hid=\".\"\>Select where to cross the other axis: at start, at end, at a specified value, or at a category.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\05040202.xhp	0	help	par_id1006200801024957				0	lv	\<ahelp hid=\".\" visibility=\"hidden\"\>Enter the value where the axis line should cross the other axis.\</ahelp\>				20200411 15:09:53
