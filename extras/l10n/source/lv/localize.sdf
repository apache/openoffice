helpcontent2	source\text\shared\01\05340600.xhp	0	help	hd_id3152876				0	lv	\<link href=\"text/shared/01/05340600.xhp\" name=\"Show Columns\"\>Show Columns\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05340600.xhp	0	help	par_id3147212	2			0	lv	\<ahelp hid=\".\"\>Displays hidden columns. Choose the column that you want to display from the list, or click \<emph\>All \</emph\>to display all of the hidden columns.\</ahelp\>				20200411 15:09:53
