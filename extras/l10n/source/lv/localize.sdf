helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3147299				0	lv	\<emph\>Text Extension From Lower Cell Border:\</emph\> Writes the rotated text from the bottom cell edge outwards.				20200411 15:09:53
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3149561				0	lv	\<emph\>Text Extension From Upper Cell Border:\</emph\> Writes the rotated text from the top cell edge outwards.				20200411 15:09:53
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3163712				0	lv	\<emph\>Text Extension Inside Cells:\</emph\> Writes the rotated text only within the cell.				20200411 15:09:53
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_idN109F4				0	lv	Vertically stacked				20200411 15:09:53
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_idN109F8				0	lv	\<ahelp hid=\".\"\>Aligns text vertically.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05340300.xhp	0	help	hd_id3152576				0	lv	Asian layout mode				20200411 15:09:53
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3150010				0	lv	This checkbox is only available if Asian language support is enabled and the text direction is set to vertical. \<ahelp hid=\"SVX_TRISTATEBOX_RID_SVXPAGE_ALIGNMENT_BTN_ASIAN_VERTICAL\"\>Aligns Asian characters one below the other in the selected cell(s). If the cell contains more than one line of text, the lines are converted to text columns that are arranged from right to left. Western characters in the converted text are rotated 90 degrees to the right. Asian characters are not rotated.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05340300.xhp	0	help	hd_id3150032				0	lv	Properties				20200411 15:09:53
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3146120				0	lv	Determine the text flow in a cell.				20200411 15:09:53
helpcontent2	source\text\shared\01\05340300.xhp	0	help	hd_id3145590				0	lv	Wrap text automatically				20200411 15:09:53
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3148555				0	lv	\<ahelp hid=\"SVX:TRISTATEBOX:RID_SVXPAGE_ALIGNMENT:BTN_WRAP\"\>Wraps text onto another line at the cell border. The number of lines depends on the width of the cell.\</ahelp\> To enter a manual line break, press \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+Enter in the cell.				20200411 15:09:53
helpcontent2	source\text\shared\01\05340300.xhp	0	help	hd_id3147380				0	lv	Hyphenation active				20200411 15:09:53
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3148458				0	lv	\<ahelp hid=\"SVX_TRISTATEBOX_RID_SVXPAGE_ALIGNMENT_BTN_HYPH\"\>Enables word hyphenation for text wrapping to the next line.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_idN10AD3				0	lv	Shrink to fit cell size				20200411 15:09:53
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_idN10AD7				0	lv	\<ahelp hid=\".\"\>Reduces the apparent size of the font so that the contents of the cell fit into the current cell width. You cannot apply this command to a cell that contains line breaks.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05350000.xhp	0	help	tit				0	lv	3D Effects				20200411 15:09:53
