helpcontent2	source\text\shared\01\03010000.xhp	0	help	hd_id3154682				0	lv	\<link href=\"text/shared/01/03010000.xhp\"\>Zoom & View Layout\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id3149578	2			0	lv	\<variable id=\"massstabtext\"\>\<ahelp hid=\".uno:Zoom\"\>Reduces or enlarges the screen display of %PRODUCTNAME.\</ahelp\>\</variable\> The current zoom factor is displayed as a percentage value on the \<emph\>Status\</emph\> bar.				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id3149655				0	lv	Zooming is handled differently on Unix, Linux, and Windows platforms. A document saved with a 100% zoom factor in Windows is displayed at a larger zoom factor on Unix/Linux platforms. To change the zoom factor, double-click or right-click the percentage value on the \<emph\>Status\</emph\> bar, and select the zoom factor that you want.				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	hd_id3149669				0	lv	Zoom factor				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id3154389				0	lv	Set the zoom factor at which to display the current document and all documents of the same type that you open thereafter.				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	hd_id3153351				0	lv	Optimal				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id3144760				0	lv	\<ahelp hid=\"HID_MNU_ZOOM_OPTIMAL\"\>\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>Resizes the display to fit the width of the selected cell area at the moment the command is started.\</caseinline\>\<defaultinline\>Resizes the display to fit the width of the text in the document at .\</defaultinline\>\</switchinline\>\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	hd_id3151210				0	lv	Fit width and height				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id3150543				0	lv	\<ahelp hid=\"HID_MNU_ZOOM_WHOLE_PAGE\"\>\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>Resizes the display to fit the width and height of the selected cell area at the moment the command is started.\</caseinline\>\<defaultinline\>Displays the entire page on your screen.\</defaultinline\>\</switchinline\>\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	hd_id3152771				0	lv	Fit width				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id3143231				0	lv	\<ahelp hid=\"HID_MNU_ZOOM_PAGE_WIDTH\"\>Displays the complete width of the document page. The top and bottom edges of the page may not be visible.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id3159151				0	lv	\<ahelp hid=\".\" visibility=\"hidden\"\>Displays the document at two times its actual size.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\03010000.xhp	0	help	par_id3145173				0	lv	\<ahelp hid=\".\" visibility=\"hidden\"\>Displays the document at one and a half times its actual size.\</ahelp\>				20200411 15:09:53
