helpcontent2	source\text\simpress\02\10090000.xhp	0	help	hd_id3149930				0	lv	Torus				20200411 15:09:53
helpcontent2	source\text\simpress\02\10090000.xhp	0	help	par_id3153533				0	lv	\<ahelp hid=\".uno:Torus\"\>Draws a ring-shaped object that is based on a circle where you drag in the slide. To draw a torus that is based on an oval, hold down Shift while you drag.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\simpress\02\10090000.xhp	0	help	par_id3151312				0	lv	\<image id=\"img_id3151319\" src=\"res/commandimagelist/sc_torus.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3151319\"\>Icon\</alt\>\</image\>				20200411 15:09:53
