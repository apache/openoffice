helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3146898				0	lv	\<ahelp hid=\"HID_AAI_FUNC_OCT2BIN\"\>The result is the binary number for the octal number entered.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3146088				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3154303				0	lv	OCT2BIN(Number; Places)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3156013	221			0	lv	            \<emph\>Number\</emph\> is the octal number. The number can have a maximum of 10 places. The most significant bit is the sign bit, the following bits return the value. Negative numbers are entered as two's complement.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3153984	222			0	lv	            \<emph\>Places\</emph\> is the number of places to be output.				20200411 15:09:53
