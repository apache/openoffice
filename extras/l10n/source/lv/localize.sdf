helpcontent2	source\text\schart\01\05040202.xhp	0	help	par_id1006200801523889				0	lv	\<ahelp hid=\".\"\>Select where to place the labels: near axis, near axis (other side), outside start, or outside end.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\05040202.xhp	0	help	hd_id1006200801025030				0	lv	Interval marks				20200411 15:09:53
helpcontent2	source\text\schart\01\05040202.xhp	0	help	hd_id3149048				0	lv	Major:				20200411 15:09:53
helpcontent2	source\text\schart\01\05040202.xhp	0	help	par_id3150397				0	lv	Specifies whether the marks are to be on the inner or outer side of the axis. It is possible to combine both: you will then see marks on both sides.				20200411 15:09:53
helpcontent2	source\text\schart\01\05040202.xhp	0	help	hd_id3151387				0	lv	Inner				20200411 15:09:53
helpcontent2	source\text\schart\01\05040202.xhp	0	help	par_id3156399				0	lv	\<ahelp hid=\"SCH:CHECKBOX:TP_SCALE_Y:CBX_TICKS_INNER\"\>Specifies that marks are placed on the inner side of the axis.\</ahelp\>				20200411 15:09:53
