helpcontent2	source\text\swriter\01\mm_newaddlis.xhp	0	help	par_idN1055B				0	lv	\<ahelp hid=\".\"\>Enter or edit the field contents for each mail merge recipient.\</ahelp\>				20200411 15:09:53
