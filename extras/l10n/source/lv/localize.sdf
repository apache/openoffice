helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3145368				0	lv	\<ahelp hid=\"HID_FUNC_ISTTEXT\"\>Returns TRUE if the cell contents refer to text.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id6779686				0	lv	If an error occurs, the function returns FALSE.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3154332				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3148649				0	lv	ISTEXT(Value)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150417				0	lv	\<emph\>Value\</emph\> is a value, number, Boolean value, or an error value to be tested.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3149239				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3144756				0	lv	\<item type=\"input\"\>=ISTEXT(D9)\</item\> returns TRUE if cell D9 contains the text \<item type=\"input\"\>abcdef\</item\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3148416				0	lv	\<item type=\"input\"\>=ISTEXT(C3)\</item\> returns FALSE if cell C3 contains the number \<item type=\"input\"\>3\</item\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3153939				0	lv	\<bookmark_value\>ISODD_ADD function\</bookmark_value\>				20200411 15:09:53
