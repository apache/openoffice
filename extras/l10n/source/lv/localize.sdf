helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3162905				0	lv	\<ahelp hid=\"HID_FUNC_GROSS\"\>Converts the string specified in the \<emph\>text\</emph\> field to uppercase.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148526				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148539				0	lv	UPPER("Text")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148496	66			0	lv	            \<emph\>Text\</emph\> refers to the lower case letters you want to convert to upper case.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148516				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146757	68			0	lv	            \<item type=\"input\"\>=UPPER("Good Morning")\</item\> returns GOOD MORNING.				20200411 15:09:53
