helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153021				0	lv	\<emph\>Data2\</emph\> is the second data set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3149720				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149941				0	lv	\<item type=\"input\"\>=CORREL(A1:A50;B1:B50)\</item\> calculates the correlation coefficient as a measure of the linear correlation of the two data sets.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3150652				0	lv	\<bookmark_value\>COVAR function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150652				0	lv	COVAR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3146875				0	lv	\<ahelp hid=\"HID_FUNC_KOVAR\"\>Returns the covariance of the product of paired deviations.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3149013				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150740				0	lv	COVAR(Data1; Data2)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145827				0	lv	\<emph\>Data1\</emph\> is the first data set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150465				0	lv	\<emph\>Data2\</emph\> is the second data set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3154677				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3144748				0	lv	\<item type=\"input\"\>=COVAR(A1:A30;B1:B30)\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3147472				0	lv	\<bookmark_value\>CRITBINOM function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3147472				0	lv	CRITBINOM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149254				0	lv	\<ahelp hid=\"HID_FUNC_KRITBINOM\"\>Returns the smallest value for which the cumulative binomial distribution is less than or equal to a criterion value.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3153930				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3148586				0	lv	CRITBINOM(Trials; SP; Alpha)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145593				0	lv	\<emph\>Trials\</emph\> is the total number of trials.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153084				0	lv	\<emph\>SP\</emph\> is the probability of success for one trial.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149726				0	lv	\<emph\>Alpha\</emph\> is the threshold probability to be reached or exceeded.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3148752				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3148740				0	lv	\<item type=\"input\"\>=CRITBINOM(100;0.5;0.1)\</item\> yields 44.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3155956				0	lv	\<bookmark_value\>KURT function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3155956				0	lv	KURT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153108				0	lv	\<ahelp hid=\"HID_FUNC_KURT\"\>Returns the kurtosis of a data set (at least 4 values required).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150334				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154508				0	lv	KURT(Number1; Number2; ...Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145167				0	lv	\<emph\>Number1,Number2,...Number30\</emph\> are numeric arguments or ranges representing a random sample of distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3158000				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150016				0	lv	\<item type=\"input\"\>=KURT(A1;A2;A3;A4;A5;A6)\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3150928				0	lv	\<bookmark_value\>LOGINV function\</bookmark_value\>\<bookmark_value\>inverse of lognormal distribution\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150928				0	lv	LOGINV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145297				0	lv	\<ahelp hid=\"HID_FUNC_LOGINV\"\>Returns the inverse of the lognormal distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3151016				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153049				0	lv	LOGINV(Number; Mean; StDev)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3148390				0	lv	\<emph\>Number\</emph\> is the probability value for which the inverse standard logarithmic distribution is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149538				0	lv	\<emph\>Mean\</emph\> is the arithmetic mean of the standard logarithmic distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3145355				0	lv	\<emph\>StDev\</emph\> is the standard deviation of the standard logarithmic distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3148768				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155623				0	lv	\<item type=\"input\"\>=LOGINV(0.05;0;1)\</item\> returns 0.19.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3158417				0	lv	\<bookmark_value\>LOGNORMDIST function\</bookmark_value\>\<bookmark_value\>cumulative lognormal distribution\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3158417				0	lv	LOGNORMDIST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154953				0	lv	\<ahelp hid=\"HID_FUNC_LOGNORMVERT\"\>Returns the cumulative lognormal distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150474				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150686				0	lv	LOGNORMDIST(Number; Mean; StDev; Cumulative)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154871				0	lv	\<emph\>Number\</emph\> is the probability value for which the standard logarithmic distribution is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155820				0	lv	\<emph\>Mean\</emph\> (optional) is the mean value of the standard logarithmic distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155991				0	lv	\<emph\>StDev\</emph\> (optional) is the standard deviation of the standard logarithmic distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155992				0	lv	\<emph\>Cumulative\</emph\> (optional) = 0 calculates the density function, Cumulative = 1 calculates the distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3153178				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149778				0	lv	\<item type=\"input\"\>=LOGNORMDIST(0.1;0;1)\</item\> returns 0.01.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06070000.xhp	0	help	tit				0	lv	AutoCalculate				20200411 15:09:53
helpcontent2	source\text\scalc\01\06070000.xhp	0	help	bm_id3145673				0	lv	\<bookmark_value\>calculating; auto calculating sheets\</bookmark_value\>\<bookmark_value\>recalculating;auto calculating sheets\</bookmark_value\>\<bookmark_value\>AutoCalculate function in sheets\</bookmark_value\>\<bookmark_value\>correcting sheets automatically\</bookmark_value\>\<bookmark_value\>formulas;AutoCalculate function\</bookmark_value\>\<bookmark_value\>cell contents;AutoCalculate function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06070000.xhp	0	help	hd_id3145673				0	lv	\<link href=\"text/scalc/01/06070000.xhp\" name=\"AutoCalculate\"\>AutoCalculate\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06070000.xhp	0	help	par_id3148798				0	lv	\<ahelp hid=\".uno:AutomaticCalculation\"\>Automatically recalculates all formulas in the document.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06070000.xhp	0	help	par_id3145173				0	lv	All cells are recalculated after a sheet cell has been modified. Any charts in the sheet will also be refreshed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	tit				0	lv	DATE				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	bm_id3155511				0	lv	\<bookmark_value\>DATE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	hd_id3155511				0	lv	\<variable id=\"date\"\>\<link href=\"text/scalc/01/func_date.xhp\"\>DATE\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3153551				0	lv	\<ahelp hid=\"HID_FUNC_DATUM\"\>This function calculates a date specified by year, month, day and displays it in the cell's formatting.\</ahelp\> The default format of a cell containing the DATE function is the date format, but you can format the cells with any other number format.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	hd_id3148590				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3150474				0	lv	DATE(Year; Month; Day)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3152815				0	lv	\<emph\>Year\</emph\> is an integer between 1583 and 9957 or between 0 and 99.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3153222				0	lv	In \<item type=\"menuitem\"\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - $[officename] - General \</item\>you can set from which year a two-digit number entry is recognized as 20xx.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3155817				0	lv	\<emph\>Month\</emph\> is an integer indicating the month.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3153183				0	lv	\<emph\>Day\</emph\> is an integer indicating the day of the month.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3156260				0	lv	If the values for month and day are out of bounds, they are carried over to the next digit. If you enter \<item type=\"input\"\>=DATE(00;12;31)\</item\> the result will be 12/31/00. If, on the other hand, you enter \<item type=\"input\"\>=DATE(00;13;31)\</item\> the result will be 1/31/01.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	hd_id3147477				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_date.xhp	0	help	par_id3152589				0	lv	\<item type=\"input\"\>=DATE(00;1;31)\</item\> yields 1/31/00 if the cell format setting is MM/DD/YY.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	tit				0	lv	Consolidate by				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	hd_id3151210				0	lv	Consolidate by				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	hd_id3125864				0	lv	Consolidate by				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	par_id3154909				0	lv	Use this section if the cell ranges that you want to consolidate contain labels. You only need to select these options if the consolidation ranges contain similar labels and the data arranged is arranged differently.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	hd_id3153968				0	lv	Row labels				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	par_id3150441				0	lv	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_CONSOLIDATE:BTN_BYROW\" visibility=\"visible\"\>Uses the row labels to arrange the consolidated data.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	hd_id3146976				0	lv	Column labels				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	par_id3155411				0	lv	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_CONSOLIDATE:BTN_BYCOL\" visibility=\"visible\"\>Uses the column labels to arrange the consolidated data.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	hd_id3153191				0	lv	Options				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	hd_id3159154				0	lv	Link to source data				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	par_id3146986				0	lv	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_CONSOLIDATE:BTN_REFS\" visibility=\"visible\"\>Links the data in the consolidation range to the source data, and automatically updates the results of the consolidation when the source data is changed.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	hd_id3163708				0	lv	More <<				20200411 15:09:53
helpcontent2	source\text\scalc\01\12070100.xhp	0	help	par_id3151118				0	lv	Hides the additional options.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	tit				0	lv	Add-in for Programming in $[officename] Calc				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	bm_id3151076				0	lv	\<bookmark_value\>programming; add-ins\</bookmark_value\>\<bookmark_value\>shared libraries; programming\</bookmark_value\>\<bookmark_value\>external DLL functions\</bookmark_value\>\<bookmark_value\>functions; $[officename] Calc add-in DLL\</bookmark_value\>\<bookmark_value\>add-ins; for programming\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	hd_id3151076				0	lv	Add-in for Programming in $[officename] Calc				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3147001				0	lv	The method of extending Calc by Add-Ins that is described in the following is outdated. The interfaces are still valid and supported, to ensure compatibility with existing Add-Ins, but for programming new Add-Ins you should use the new \<link href=\"text/shared/guide/integratinguno.xhp\" name=\"API functions\"\>API functions\</link\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3150361	2			0	lv	$[officename] Calc can be expanded by Add-Ins, which are external programming modules providing additional functions for working with spreadsheets. These are listed in the \<emph\>Function Wizard\</emph\> in the \<emph\>Add-In\</emph\> category. If you would like to program an Add-In yourself, you can learn here which functions must be exported by the \<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>shared library \</caseinline\>\<defaultinline\>external DLL\</defaultinline\>\</switchinline\> so that the Add-In can be successfully attached.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3149211	3			0	lv	$[officename] searches the Add-in folder defined in the configuration for a suitable \<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>shared library \</caseinline\>\<defaultinline\>DLL\</defaultinline\>\</switchinline\>. To be recognized by $[officename], the \<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>shared library \</caseinline\>\<defaultinline\>DLL\</defaultinline\>\</switchinline\> must have certain properties, as explained in the following. This information allows you to program your own Add-In for \<emph\>Function Wizard\</emph\> of $[officename] Calc.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	hd_id3146981				0	lv	The Add-In Concept				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3156292				0	lv	Each Add-In library provides several functions. Some functions are used for administrative purposes. You can choose almost any name for your own functions. However, they must also follow certain rules regarding parameter passing. The exact naming and calling conventions vary for different platforms.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	hd_id3152890	6			0	lv	Functions of \<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>Shared Library \</caseinline\>\<defaultinline\>AddIn DLL\</defaultinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3148837				0	lv	At a minimum, the administrative functions \<link href=\"text/scalc/01/04060112.xhp\" name=\"GetFunctionCount\"\>GetFunctionCount\</link\> and \<link href=\"text/scalc/01/04060112.xhp\" name=\"GetFunctionData\"\>GetFunctionData\</link\> must exist. Using these, the functions as well as parameter types and return values can be determined. As return values, the Double and String types are supported. As parameters, additionally the cell areas \<link href=\"text/scalc/01/04060112.xhp\" name=\"Double Array\"\>Double Array\</link\>, \<link href=\"text/scalc/01/04060112.xhp\" name=\"String Array\"\>String Array\</link\>, and \<link href=\"text/scalc/01/04060112.xhp\" name=\"Cell Array\"\>Cell Array\</link\> are supported.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3148604				0	lv	Parameters are passed using references. Therefore, a change of these values is basically possible. However, this is not supported in $[officename] Calc because it does not make sense within spreadsheets.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3150112				0	lv	Libraries can be reloaded during runtime and their contents can be analyzed by the administrative functions. For each function, information is available about count and type of parameters, internal and external function names and an administrative number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3155269				0	lv	The functions are called synchronously and return their results immediately. Real time functions (asynchronous functions) are also possible; however, they are not explained in detail because of their complexity.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	hd_id3145077				0	lv	General information about the interface				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3146776				0	lv	The maximum number of parameters in an Add-In function attached to $[officename] Calc is 16: one return value and a maximum of 15 function input parameters.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3149899				0	lv	The data types are defined as follows:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3151302				0	lv	\<emph\>Data types\</emph\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3143222				0	lv	\<emph\>Definition\</emph\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3149384				0	lv	CALLTYPE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3146963				0	lv	Under Windows: FAR PASCAL (_far _pascal)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3153809				0	lv	Other: default (operating system specific default)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3154734				0	lv	USHORT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3155760				0	lv	2 Byte unsigned Integer				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3145320				0	lv	DOUBLE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3150956				0	lv	8 byte platform-dependent format				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3146097				0	lv	Paramtype				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3150432				0	lv	Platform-dependent like int				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3153955				0	lv	PTR_DOUBLE =0 pointer to a double				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3159262				0	lv	PTR_STRING =1 pointer to a zero-terminated string				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3148747				0	lv	PTR_DOUBLE_ARR =2 pointer to a double array				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060112.xhp	0	help	par_id3147406				0	lv	PTR_STRING_ARR =3 pointer to a string array				20200411 15:09:53
