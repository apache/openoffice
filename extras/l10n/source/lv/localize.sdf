helpcontent2	source\text\shared\01\xformsdatatab.xhp	0	help	par_id3394573				0	lv	\<ahelp hid=\".\"\>Specifies an exclusive upper bound for values.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\xformsdatatab.xhp	0	help	hd_id7594225				0	lv	Min. (inclusive)				20200411 15:09:53
helpcontent2	source\text\shared\01\xformsdatatab.xhp	0	help	par_id8147221				0	lv	\<ahelp hid=\".\"\>Specifies an inclusive lower bound for values.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\xformsdatatab.xhp	0	help	hd_id5081637				0	lv	Min. (exclusive)				20200411 15:09:53
