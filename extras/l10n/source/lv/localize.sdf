helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903061174				0	lv	Information units "bit" and "byte" may also be prefixed by one of the following IEC 60027-2 / IEEE 1541 prefixes:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903090966				0	lv	ki kibi 1024				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903090958				0	lv	Mi mebi 1048576				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903090936				0	lv	Gi gibi 1073741824				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903090975				0	lv	Ti tebi 1099511627776				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903090930				0	lv	Pi pebi 1125899906842620				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903091070				0	lv	Ei exbi 1152921504606850000				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903091097				0	lv	Zi zebi 1180591620717410000000				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id0908200903091010				0	lv	Yi yobi 1208925819614630000000000				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3146125				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3153695				0	lv	CONVERT_ADD(Number; "FromUnit"; "ToUnit")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3147522	211			0	lv	            \<emph\>Number\</emph\> is the number to be converted.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3154472	212			0	lv	            \<emph\>FromUnit\</emph\> is the unit from which conversion is taking place.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3153790	213			0	lv	            \<emph\>ToUnit\</emph\> is the unit to which conversion is taking place. Both units must be of the same type.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id09022809540918				0	lv	\<link href=\"https://wiki.openoffice.org/wiki/Documentation/How_Tos/Calc:_CONVERT_ADD_function\"\>Current list of CONVERT_ADD units in the OpenOffice.org Wiki.\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3156270				0	lv	Examples				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3156336	215			0	lv	            \<item type=\"input\"\>=CONVERT_ADD(10;"HP";"PS") \</item\>returns, rounded to two decimal places, 10.14. 10 HP equal 10.14 PS.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3154834	216			0	lv	            \<item type=\"input\"\>=CONVERT_ADD(10;"km";"mi") \</item\>returns, rounded to two decimal places, 6.21. 10 kilometers equal 6.21 miles. The k is the permitted prefix character for the factor 10^3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	bm_id3147096				0	lv	\<bookmark_value\>FACTDOUBLE function\</bookmark_value\>         \<bookmark_value\>factorials;numbers with increments of two\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3147096				0	lv	FACTDOUBLE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3151309				0	lv	\<ahelp hid=\"HID_AAI_FUNC_FACTDOUBLE\"\>Returns the double factorial of a number.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3154666				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3155121				0	lv	FACTDOUBLE(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3158440	40			0	lv	Returns \<emph\>Number\</emph\>            \<emph\>!!\</emph\>, the double factorial of \<emph\>Number\</emph\>, where \<emph\>Number\</emph\> is an integer greater than or equal to zero.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id2480849				0	lv	For even numbers FACTDOUBLE(n) returns:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id4181951				0	lv	2*4*6*8* ... *n				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id2927335				0	lv	For odd numbers FACTDOUBLE(n) returns:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id2107303				0	lv	1*3*5*7* ... *n				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id4071779				0	lv	FACTDOUBLE(0) returns 1 by definition.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3154622				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id7844477				0	lv	            \<item type=\"input\"\>=FACTDOUBLE(5)\</item\> returns 15.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3154116	43			0	lv	            \<item type=\"input\"\>=FACTDOUBLE(6)\</item\> returns 48.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id6478469				0	lv	            \<item type=\"input\"\>=FACTDOUBLE(0)\</item\> returns 1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05040200.xhp	0	help	tit				0	lv	Optimal Column Width				20200411 15:09:53
helpcontent2	source\text\scalc\01\05040200.xhp	0	help	bm_id3155628				0	lv	\<bookmark_value\>spreadsheets; optimal column widths\</bookmark_value\>\<bookmark_value\>columns; optimal widths\</bookmark_value\>\<bookmark_value\>optimal column widths\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05040200.xhp	0	help	hd_id3155628				0	lv	Optimal Column Width				20200411 15:09:53
helpcontent2	source\text\scalc\01\05040200.xhp	0	help	par_id3145068				0	lv	\<variable id=\"optitext\"\>\<ahelp hid=\".uno:SetOptimalColumnWidthDi\"\>Defines the optimal column width for selected columns.\</ahelp\>\</variable\> The optimal column width depends on the longest entry within a column. You can choose from the available \<link href=\"text/shared/00/00000003.xhp#metrik\" name=\"measurement units\"\>measurement units\</link\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05040200.xhp	0	help	hd_id3150767				0	lv	Add				20200411 15:09:53
helpcontent2	source\text\scalc\01\05040200.xhp	0	help	par_id3150449				0	lv	\<ahelp hid=\"SC:METRICFIELD:RID_SCDLG_COL_OPT:ED_VALUE\"\>Defines additional spacing between the longest entry in a column and the vertical column borders.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05040200.xhp	0	help	hd_id3145785				0	lv	Default value				20200411 15:09:53
helpcontent2	source\text\scalc\01\05040200.xhp	0	help	par_id3146120				0	lv	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_COL_OPT:BTN_DEFVAL\"\>Defines the optimal column width in order to display the entire contents of the column.\</ahelp\> The additional spacing for the optimal column width is preset to 0.1 in.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	tit				0	lv	Conditional Formatting				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	hd_id3155132				0	lv	Conditional Formatting				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3163710				0	lv	\<variable id=\"bedingtetext\"\>\<ahelp hid=\".uno:ConditionalFormatDialog\"\>Choose \<emph\>Conditional Formatting\</emph\> to define format styles depending on certain conditions.\</ahelp\>\</variable\> If a style was already assigned to a cell, it remains unchanged. The style entered here is then evaluated. You can enter three conditions that query the contents of cell values or formulas. The conditions are evaluated from 1 to 3. If the condition 1 matches the condition, the defined style will be used. Otherwise, condition 2 is evaluated, and its defined style used. If this style does not match, condition 3 is evaluated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id2414014				0	lv	To apply conditional formatting, AutoCalculate must be enabled. Choose Tools - Cell Contents - AutoCalculate (you see a check mark next to the command when AutoCalculate is enabled).				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	bm_id3153189				0	lv	\<bookmark_value\>conditional formatting; conditions\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	hd_id3153189				0	lv	Condition 1/2/3				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3149413				0	lv	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_CONDFORMAT:CBX_COND3\"\>Mark the boxes corresponding to each condition and enter the corresponding condition.\</ahelp\> To close the dialog, click \<emph\>OK\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	hd_id3147394				0	lv	Cell Value / Formula				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3155602				0	lv	\<ahelp hid=\"SC:LISTBOX:RID_SCDLG_CONDFORMAT:LB_COND3_1\"\>Specifies if conditional formatting is dependent on a cell value or a formula.\</ahelp\> If you select a formula as a reference, the \<emph\>Cell Value Condition\</emph\> box is displayed to the right of the \<emph\>Cell value/Formula\</emph\> field. If the condition is "Formula is", enter a cell reference. If the cell reference is a value other than zero, the condition matches.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	hd_id3153709				0	lv	Cell Value Condition				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3153764				0	lv	\<ahelp hid=\"SC:LISTBOX:RID_SCDLG_CONDFORMAT:LB_COND3_2\"\>Choose a condition for the format to be applied to the selected cells.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	hd_id3156384				0	lv	Cell Style				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3145228				0	lv	\<ahelp hid=\"SC:LISTBOX:RID_SCDLG_CONDFORMAT:LB_COND3_TEMPLATE\"\>Choose the style to be applied if the specified condition matches.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	hd_id0509200913175331				0	lv	New Style				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id0509200913175368				0	lv	\<ahelp hid=\".\"\>If you haven't already defined a style to be used, you can click New Style to open the Organizer tab page of the Cell Style dialog. Define a new style there and click OK.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	hd_id3146316				0	lv	Parameter field				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3155114				0	lv	\<ahelp hid=\"SC:EDIT:RID_SCDLG_CONDFORMAT:EDT_COND3_2\" visibility=\"hidden\"\>Enter a reference, value or formula.\</ahelp\> Enter a reference, value or formula in the parameter field, or in both parameter fields if you have selected a condition that requires two parameters. You can also enter formulas containing relative references.				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3145257				0	lv	Once the parameters have been defined, the condition is complete. It may appear as:				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3150784				0	lv	Cell value is equal 0: Cell style Null value (You must have already defined a cell style with this name before assigning it to a condition).				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3150365				0	lv	Cell value is between $B$20 and $B$21: Cell style Result (The corresponding value limits must already exist in cells B20 and B21).				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3152992				0	lv	Formula is SUM($A$1:$A$5)=10: Cell style Result (The selected cells are formatted with the Result style if the sum of the contents in cells A1 to A5 is equal to 10).				20200411 15:09:53
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_idN107E1				0	lv	            \<embedvar href=\"text/scalc/guide/cellstyle_conditional.xhp#cellstyle_conditional\"/\>         				20200411 15:09:53
