helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3157320				0	lv	\<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>If you want, you can use the STAR_SPOOL_DIR environment variable to specify the directory where the Xprinter spoolfiles are saved. For example:\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3154330				0	lv	\<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>setenv STAR_SPOOL_DIR /usr/local/tmp (in the csh/tcsh) or\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3150768				0	lv	\<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>export STAR_SPOOL_DIR=/usr/local/tmp (in the sh/bash)\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3150449				0	lv	\<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>You can also use the \<link href=\"text/shared/guide/spadmin.xhp\" name=\"spadmin printer setup program\"\>spadmin printer setup program\</link\> to specify additional printer options.\</caseinline\>\</switchinline\>				20200411 15:09:53
