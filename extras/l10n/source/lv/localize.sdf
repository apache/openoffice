helpcontent2	source\text\schart\01\05040000.xhp	0	help	par_id3149401				0	lv	\<ahelp hid=\".uno:DiagramAxisA\"\>Opens a dialog where you can edit the properties of the secondary X axis. To insert a secondary X axis, choose \<emph\>Insert - Axes\</emph\> and select \<emph\>X axis\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\05040000.xhp	0	help	hd_id3145640				0	lv	\<link href=\"text/schart/01/05040200.xhp\" name=\"Secondary Y Axis\"\>Secondary Y Axis\</link\>				20200411 15:09:53
helpcontent2	source\text\schart\01\05040000.xhp	0	help	par_id3159264				0	lv	\<ahelp hid=\".uno:DiagramAxisB\"\>Opens a dialog where you can edit the properties of the secondary Y axis. To insert a secondary Y axis, choose \<emph\>Insert - Axes\</emph\> and select \<emph\>Y axis\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\05040000.xhp	0	help	hd_id3145228				0	lv	\<link href=\"text/schart/01/05040100.xhp\" name=\"Z axis\"\>Z axis\</link\>				20200411 15:09:53
