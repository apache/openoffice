helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	par_id5566778805				0	lv	            \<ahelp hid=\"cui:MetricField:ColorPicker:Red\"\>Sets the Red color value in the RGB color model.\</ahelp\>        				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	hd_id5566778806				0	lv	Green				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	par_id5566778806				0	lv	            \<ahelp hid=\"cui:RadioButton:ColorPicker:Green\"\>Sets the Green color value in the RGB color model.\</ahelp\>        				20200411 15:09:53
