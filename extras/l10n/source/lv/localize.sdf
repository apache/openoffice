helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3148946				0	lv	\<link href=\"text/shared/optionen/01010900.xhp\" name=\"Print Options\"\>Print Options\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3150359				0	lv	\<ahelp hid=\".\"\>Specifies the print setting options.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3148451				0	lv	Reduce print data				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3154910				0	lv	You can reduce the amount of data to be sent to the printer. Reducing the print data increases the print speed because the print files are smaller. This makes it easier for printers with a smaller memory to print. Reducing print data can result in slightly lower print quality.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3147085				0	lv	Settings for				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3158407				0	lv	\<ahelp hid=\"SFX2_RADIOBUTTON_TP_COMMONPRINTOPTIONS_RB_PRINTFILEOUTPUT\"\>Specifies whether the print settings apply to direct printing or to printing to a file.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3145786				0	lv	Reduce transparency				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3159154				0	lv	\<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_REDUCETRANSPARENCY\"\>If you mark this field the transparent objects will be printed like normal, non-transparent objects, depending on your selection in the following two option buttons.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3156444				0	lv	Transparency cannot be output directly to a printer. The areas of the document in which transparency is to be visible must therefore always be calculated as bitmaps and sent to the printer. Depending on the size of the bitmaps and the print resolution a large amount of data may result.				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3147441				0	lv	Automatically				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3150488				0	lv	\<ahelp hid=\"SFX2_RADIOBUTTON_TP_COMMONPRINTOPTIONS_RB_REDUCETRANSPARENCY_AUTO\"\>Specifies that the transparency is only printed if the transparent area covers less than a quarter of the entire page.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3149417				0	lv	No transparency				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3153878				0	lv	\<ahelp hid=\"SFX2_RADIOBUTTON_TP_COMMONPRINTOPTIONS_RB_REDUCETRANSPARENCY_NONE\"\>With this option transparency is never printed.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3149960				0	lv	Reduce bitmaps				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3148455				0	lv	\<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_REDUCEBITMAPS\"\>Specifies that bitmaps are printed with reduced quality. The resolution can only be reduced and not increased.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3149400				0	lv	High/normal print quality				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3154510	76			0	lv	\<ahelp hid=\"SFX2_RADIOBUTTON_TP_COMMONPRINTOPTIONS_RB_REDUCEBITMAPS_NORMAL\"\>High print quality corresponds to a resolution of 300dpi. Normal print quality corresponds to a resolution of 200dpi. \</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3146969				0	lv	Resolution				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3154270				0	lv	\<ahelp hid=\"SFX2_LISTBOX_TP_COMMONPRINTOPTIONS_LB_REDUCEBITMAPS_RESOLUTION\"\>Specifies the maximum print quality in dpi. The resolution can only be reduced and not increased.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3146789				0	lv	Include transparent objects				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	par_id3150749				0	lv	\<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_REDUCEBITMAPS_TRANSPARENCY\"\>If this field is marked, the reduction in print quality for bitmaps also applies to the transparent areas of objects.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\optionen\01010900.xhp	0	help	hd_id3154362				0	lv	Reduce gradients				20200411 15:09:53
