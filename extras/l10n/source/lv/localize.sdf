helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3158407	156			0	lv	            \<item type=\"input\"\>=MID("office";2;2)\</item\> returns ff.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3159143				0	lv	\<bookmark_value\>PROPER function\</bookmark_value\>				20200411 15:09:53
