helpcontent2	source\text\scalc\01\04060182.xhp	0	help	tit				0	lv	Statistical Functions Part Two				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3154372				0	lv	\<variable id=\"fh\"\>\<link href=\"text/scalc/01/04060182.xhp\" name=\"Statistical Functions Part Two\"\>Statistical Functions Part Two\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3145388				0	lv	\<bookmark_value\>FINV function\</bookmark_value\>         \<bookmark_value\>inverse F probability distribution\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3145388				0	lv	FINV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155089				0	lv	\<ahelp hid=\"HID_FUNC_FINV\"\>Returns the inverse of the F probability distribution.\</ahelp\> The F distribution is used for F tests in order to set the relation between two differing data sets.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3153816				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153068				0	lv	FINV(Number; DegreesFreedom1; DegreesFreedom2)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146866	6			0	lv	            \<emph\>Number\</emph\> is probability value for which the inverse F distribution is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153914	7			0	lv	            \<emph\>DegreesFreedom1\</emph\> is the number of degrees of freedom in the numerator of the F distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3148607	8			0	lv	            \<emph\>DegreesFreedom2\</emph\> is the number of degrees of freedom in the denominator of the F distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3156021				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145073	10			0	lv	            \<item type=\"input\"\>=FINV(0.5;5;10)\</item\> yields 0.93.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3150888				0	lv	\<bookmark_value\>FISHER function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150888				0	lv	FISHER				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155384				0	lv	\<ahelp hid=\"HID_FUNC_FISHER\"\>Returns the Fisher transformation for x and creates a function close to a normal distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3149898				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3143220				0	lv	FISHER(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3159228	16			0	lv	            \<emph\>Number\</emph\> is the value to be transformed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3154763				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3149383	18			0	lv	            \<item type=\"input\"\>=FISHER(0.5)\</item\> yields 0.55.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3155758				0	lv	\<bookmark_value\>FISHERINV function\</bookmark_value\>         \<bookmark_value\>inverse of Fisher transformation\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3155758				0	lv	FISHERINV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154734				0	lv	\<ahelp hid=\"HID_FUNC_FISHERINV\"\>Returns the inverse of the Fisher transformation for x and creates a function close to a normal distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3155755				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146108				0	lv	FISHERINV(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145115	24			0	lv	            \<emph\>Number\</emph\> is the value that is to undergo reverse-transformation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3155744				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150432	26			0	lv	            \<item type=\"input\"\>=FISHERINV(0.5)\</item\> yields 0.46.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3151390				0	lv	\<bookmark_value\>FTEST function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3151390				0	lv	FTEST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150534				0	lv	\<ahelp hid=\"HID_FUNC_FTEST\"\>Returns the result of an F test.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3166466				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153024				0	lv	FTEST(Data1; Data2)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150032	32			0	lv	            \<emph\>Data1\</emph\> is the first record array.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153018	33			0	lv	            \<emph\>Data2\</emph\> is the second record array.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3153123				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3159126	35			0	lv	            \<item type=\"input\"\>=FTEST(A1:A30;B1:B12)\</item\> calculates whether the two data sets are different in their variance and returns the probability that both sets could have come from the same total population.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3150372				0	lv	\<bookmark_value\>FDIST function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150372				0	lv	FDIST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3152981				0	lv	\<ahelp hid=\"HID_FUNC_FVERT\"\>Calculates the values of an F distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150484				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145826				0	lv	FDIST(Number; DegreesFreedom1; DegreesFreedom2)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150461	41			0	lv	            \<emph\>Number\</emph\> is the value for which the F distribution is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150029	42			0	lv	            \<emph\>degreesFreedom1\</emph\> is the degrees of freedom in the numerator in the F distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146877	43			0	lv	            \<emph\>degreesFreedom2\</emph\> is the degrees of freedom in the denominator in the F distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3147423				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150696	45			0	lv	            \<item type=\"input\"\>=FDIST(0.8;8;12)\</item\> yields 0.61.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id0119200903223192				0	lv	\<bookmark_value\>GAMMA function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id0119200903205393				0	lv	GAMMA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id0119200903205379				0	lv	\<ahelp hid=\".\"\>Returns the Gamma function value.\</ahelp\> Note that GAMMAINV is not the inverse of GAMMA, but of GAMMADIST.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id0119200903271613				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id0119200903271614				0	lv	            \<emph\>Number\</emph\> is the number for which the Gamma function value is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3154841				0	lv	\<bookmark_value\>GAMMAINV function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3154841				0	lv	GAMMAINV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153932				0	lv	\<ahelp hid=\"HID_FUNC_GAMMAINV\"\>Returns the inverse of the Gamma cumulative distribution GAMMADIST.\</ahelp\> This function allows you to search for variables with different distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3149949				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155828				0	lv	GAMMAINV(Number; Alpha; Beta)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145138	51			0	lv	            \<emph\>Number\</emph\> is the probability value for which the inverse Gamma distribution is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3152785	52			0	lv	            \<emph\>Alpha\</emph\> is the parameter Alpha of the Gamma distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154561	53			0	lv	            \<emph\>Beta\</emph\> is the parameter Beta of the Gamma distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3148734				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153331	55			0	lv	            \<item type=\"input\"\>=GAMMAINV(0.8;1;1)\</item\> yields 1.61.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3154806				0	lv	\<bookmark_value\>GAMMALN function\</bookmark_value\>         \<bookmark_value\>natural logarithm of Gamma function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3154806				0	lv	GAMMALN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3148572				0	lv	\<ahelp hid=\"HID_FUNC_GAMMALN\"\>Returns the natural logarithm of the Gamma function: G(x).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3152999				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153112				0	lv	GAMMALN(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154502	61			0	lv	            \<emph\>Number\</emph\> is the value for which the natural logarithm of the Gamma function is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3153568				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153730	63			0	lv	            \<item type=\"input\"\>=GAMMALN(2)\</item\> yields 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3150132				0	lv	\<bookmark_value\>GAMMADIST function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150132				0	lv	GAMMADIST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155931				0	lv	\<ahelp hid=\"HID_FUNC_GAMMAVERT\"\>Returns the values of a Gamma distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id0119200903333675				0	lv	The inverse function is GAMMAINV.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3147373				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155436				0	lv	GAMMADIST(Number; Alpha; Beta; C)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150571	69			0	lv	            \<emph\>Number\</emph\> is the value for which the Gamma distribution is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145295	70			0	lv	            \<emph\>Alpha\</emph\> is the parameter Alpha of the Gamma distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3151015	71			0	lv	            \<emph\>Beta\</emph\> is the parameter Beta of the Gamma distribution				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3157972	72			0	lv	            \<emph\>C\</emph\> (optional) = 0 or False calculates the density function \<emph\>C\</emph\> = 1 or True calculates the distribution.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3149535				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145354	74			0	lv	            \<item type=\"input\"\>=GAMMADIST(2;1;1;1)\</item\> yields 0.86.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3150272				0	lv	\<bookmark_value\>GAUSS function\</bookmark_value\>         \<bookmark_value\>normal distribution; standard\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150272				0	lv	GAUSS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3149030				0	lv	\<ahelp hid=\"HID_FUNC_GAUSS\"\>Returns the standard normal cumulative distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id2059694				0	lv	It is GAUSS(x)=NORMSDIST(x)-0.5				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3153551				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155368				0	lv	GAUSS(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153228	80			0	lv	            \<emph\>Number\</emph\> is the value for which the value of the standard normal distribution is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150691				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154867	82			0	lv	            \<item type=\"input\"\>=GAUSS(0.19)\</item\> = 0.08				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3148594	83			0	lv	            \<item type=\"input\"\>=GAUSS(0.0375)\</item\> = 0.01				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3148425				0	lv	\<bookmark_value\>GEOMEAN function\</bookmark_value\>         \<bookmark_value\>means;geometric\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3148425				0	lv	GEOMEAN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3156257				0	lv	\<ahelp hid=\"HID_FUNC_GEOMITTEL\"\>Returns the geometric mean of a sample.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3147167				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153720				0	lv	GEOMEAN(Number1; Number2; ...Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3152585	89			0	lv	            \<emph\>Number1, Number2,...Number30\</emph\> are numeric arguments or ranges that represent a random sample.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3146146				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3149819	92			0	lv	            \<item type=\"input\"\>=GEOMEAN(23;46;69)\</item\> = 41.79. The geometric mean value of this random sample is therefore 41.79.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3152966				0	lv	\<bookmark_value\>TRIMMEAN function\</bookmark_value\>         \<bookmark_value\>means;of data set without margin data\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3152966				0	lv	TRIMMEAN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3149716				0	lv	\<ahelp hid=\"HID_FUNC_GESTUTZTMITTEL\"\>Returns the mean of a data set without the Alpha percent of data at the margins.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3149281				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154821				0	lv	TRIMMEAN(Data; Alpha)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155834	98			0	lv	            \<emph\>Data\</emph\> is the array of data in the sample.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3156304	99			0	lv	            \<emph\>Alpha\</emph\> is the percentage of the marginal data that will not be taken into consideration.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3151180				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3156130	101			0	lv	            \<item type=\"input\"\>=TRIMMEAN(A1:A50; 0.1)\</item\> calculates the mean value of numbers in A1:A50, without taking into consideration the 5 percent of the values representing the highest values and the 5 percent of the values representing the lowest ones. The percentage numbers refer to the amount of the untrimmed mean value, not to the number of summands.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3153216				0	lv	\<bookmark_value\>ZTEST function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3153216				0	lv	ZTEST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150758				0	lv	\<ahelp hid=\"HID_FUNC_GTEST\"\>Calculates the probability of observing a z-statistic greater than the one computed based on a sample.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150872				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153274				0	lv	ZTEST(Data; mu; Sigma)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3156109	107			0	lv	            \<emph\>Data\</emph\> is the given sample, drawn from a normally distributed population.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3149977	108			0	lv	            \<emph\>mu\</emph\> is the known mean of the population.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154740	109			0	lv	            \<emph\>Sigma\</emph\> (optional) is the known standard deviation of the population. If omitted, the standard deviation of the given sample is used.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id0305200911372999				0	lv	See also the \<link href=\"https://wiki.openoffice.org/wiki/Documentation/How_Tos/Calc:_ZTEST_function\"\>Wiki page\</link\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3153623				0	lv	\<bookmark_value\>HARMEAN function\</bookmark_value\>         \<bookmark_value\>means;harmonic\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3153623				0	lv	HARMEAN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155102				0	lv	\<ahelp hid=\"HID_FUNC_HARMITTEL\"\>Returns the harmonic mean of a data set.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3146900				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3149287				0	lv	HARMEAN(Number1; Number2; ...Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154303	117			0	lv	            \<emph\>Number1,Number2,...Number30\</emph\> are up to 30 values or ranges, that can be used to calculate the harmonic mean.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3159179				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146093	120			0	lv	            \<item type=\"input\"\>=HARMEAN(23;46;69)\</item\> = 37.64. The harmonic mean of this random sample is thus 37.64				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3152801				0	lv	\<bookmark_value\>HYPGEOMDIST function\</bookmark_value\>         \<bookmark_value\>sampling without replacement\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3152801				0	lv	HYPGEOMDIST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3159341				0	lv	\<ahelp hid=\"HID_FUNC_HYPGEOMVERT\"\>Returns the hypergeometric distribution.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3154697				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155388				0	lv	HYPGEOMDIST(X; NSample; Successes; NPopulation)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154933	126			0	lv	            \<emph\>X\</emph\> is the number of results achieved in the random sample.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153106	127			0	lv	            \<emph\>NSample\</emph\> is the size of the random sample.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146992	128			0	lv	            \<emph\>Successes\</emph\> is the number of possible results in the total population.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3148826	129			0	lv	            \<emph\>NPopulation \</emph\>is the size of the total population.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150529				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154904	131			0	lv	            \<item type=\"input\"\>=HYPGEOMDIST(2;2;90;100)\</item\> yields 0.81. If 90 out of 100 pieces of buttered toast fall from the table and hit the floor with the buttered side first, then if 2 pieces of buttered toast are dropped from the table, the probability is 81%, that both will strike buttered side first.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06050000.xhp	0	help	tit				0	lv	Create Scenario				20200411 15:09:53
helpcontent2	source\text\scalc\01\06050000.xhp	0	help	hd_id3156023				0	lv	Create Scenario				20200411 15:09:53
helpcontent2	source\text\scalc\01\06050000.xhp	0	help	par_id3150541				0	lv	\<variable id=\"szenariotext\"\>\<ahelp hid=\".uno:ScenarioManager\"\>Defines a scenario for the selected sheet area.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06050000.xhp	0	help	par_idN10637				0	lv	\<embedvar href=\"text/scalc/guide/scenario.xhp#scenario\"/\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06050000.xhp	0	help	hd_id3156280				0	lv	Name of scenario				20200411 15:09:53
helpcontent2	source\text\scalc\01\06050000.xhp	0	help	par_id3151041	13			0	lv	\<ahelp hid=\"HID_SC_SCENWIN_TOP\"\>Defines the name for the scenario. Use a clear and unique name so you can easily identify the scenario.\</ahelp\> You can also modify a scenario name in the Navigator through the \<emph\>Properties \</emph\>context menu command.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06050000.xhp	0	help	hd_id3153954				0	lv	Comment				20200411 15:09:53
helpcontent2	source\text\scalc\01\06050000.xhp	0	help	par_id3155411	15			0	lv	\<ahelp hid=\"HID_SC_SCENWIN_BOTTOM\"\>Specifies additional information about the scenario. This information will be displayed in the \<link href=\"text/scalc/01/02110000.xhp\" name=\"Navigator\"\>Navigator\</link\> when you click the \<emph\>Scenarios\</emph\> icon and select the desired scenario.\</ahelp\> You can also modify this information in the Navigator through the \<emph\>Properties \</emph\>context menu command.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06050000.xhp	0	help	hd_id3145273				0	lv	Settings				20200411 15:09:53
helpcontent2	source\text\scalc\01\06050000.xhp	0	help	par_id3153364				0	lv	This section is used to define some of the settings used in the scenario display.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06050000.xhp	0	help	hd_id3145367				0	lv	Display border				20200411 15:09:53
helpcontent2	source\text\scalc\01\06050000.xhp	0	help	par_id3151073				0	lv	\<ahelp hid=\"SC:LISTBOX:RID_SCDLG_NEWSCENARIO:LB_COLOR\"\>Highlights the scenario in your table with a border. The color for the border is specified in the field to the right of this option.\</ahelp\> The border will have a title bar displaying the name of the last scenario. The button on the right of the scenario border offers you an overview of all the scenarios in this area, if several have been defined. You can choose any of the scenarios from this list without restrictions.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06050000.xhp	0	help	hd_id3149582				0	lv	Copy back				20200411 15:09:53
helpcontent2	source\text\scalc\01\06050000.xhp	0	help	par_id3154942				0	lv	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_NEWSCENARIO:CB_TWOWAY\"\>Copies the values of cells that you change into the active scenario. If you do not select this option, the scenario is not changed when you change cell values. The behavior of the \<emph\>Copy back\</emph\> setting depends on the cell protection, the sheet protection, and the \<emph\>Prevent changes\</emph\> settings.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06050000.xhp	0	help	hd_id3149402				0	lv	Copy entire sheet				20200411 15:09:53
helpcontent2	source\text\scalc\01\06050000.xhp	0	help	par_id3146969	23			0	lv	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_NEWSCENARIO:CB_COPYALL\"\>Copies the entire sheet into an additional scenario sheet. \</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06050000.xhp	0	help	par_idN1075A				0	lv	Prevent changes				20200411 15:09:53
helpcontent2	source\text\scalc\01\06050000.xhp	0	help	par_idN1075E				0	lv	\<ahelp hid=\"sc:CheckBox:RID_SCDLG_NEWSCENARIO:CB_PROTECT\"\>Prevents changes to the active scenario. The behavior of the \<emph\>Copy back\</emph\> setting depends on the cell protection, the sheet protection, and the \<emph\>Prevent changes\</emph\> settings.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06050000.xhp	0	help	par_idN10778				0	lv	You can only change the scenario properties if the \<emph\>Prevent changes\</emph\> option is not selected and if the sheet is not protected.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06050000.xhp	0	help	par_idN10780				0	lv	You can only edit cell values if the \<emph\>Prevent changes\</emph\> option is selected, if the \<emph\>Copy back\</emph\> is option is not selected, and if the cells are not protected.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06050000.xhp	0	help	par_idN1078C				0	lv	You can only change scenario cell values and write them back into the scenario if the \<emph\>Prevent changes\</emph\> option is not selected, if the \<emph\>Copy back\</emph\> option is selected, and if the cells are not protected.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06080000.xhp	0	help	tit				0	lv	Recalculate				20200411 15:09:53
helpcontent2	source\text\scalc\01\06080000.xhp	0	help	bm_id3157909				0	lv	\<bookmark_value\>recalculating;all formulas in sheets\</bookmark_value\>\<bookmark_value\>formulas; recalculating manually\</bookmark_value\>\<bookmark_value\>cell contents; recalculating\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06080000.xhp	0	help	hd_id3157909				0	lv	\<link href=\"text/scalc/01/06080000.xhp\" name=\"Recalculate\"\>Recalculate\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06080000.xhp	0	help	par_id3154758				0	lv	\<ahelp hid=\".uno:Calculate\"\>Recalculates all changed formulas. If AutoCalculate is enabled, the Recalculate command applies only to formulas like RAND or NOW.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06080000.xhp	0	help	par_id315475899				0	lv	Press F9 to recalculate. Press Shift+\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+F9 to recalculate all formulas in the document.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06080000.xhp	0	help	par_id3150793				0	lv	After the document has been recalculated, the display is refreshed. All charts are also refreshed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06080000.xhp	0	help	par_id315475855				0	lv	The Add-In functions like RANDBETWEEN currently cannot respond to the Recalculate command or F9. Press Shift+\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+F9 to recalculate all formulas, including the Add-In functions.				20200411 15:09:53
helpcontent2	source\text\scalc\01\06990000.xhp	0	help	tit				0	lv	Cell Contents				20200411 15:09:53
helpcontent2	source\text\scalc\01\06990000.xhp	0	help	hd_id3153087				0	lv	\<link href=\"text/scalc/01/06990000.xhp\" name=\"Cell Contents\"\>Cell Contents\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06990000.xhp	0	help	par_id3145674				0	lv	Opens a submenu with commands to calculate tables and activate AutoInput.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080200.xhp	0	help	tit				0	lv	Show Details				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080200.xhp	0	help	bm_id3153561				0	lv	\<bookmark_value\>tables; showing details\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080200.xhp	0	help	hd_id3153561				0	lv	\<link href=\"text/scalc/01/12080200.xhp\" name=\"Show Details\"\>Show Details\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080200.xhp	0	help	par_id3153822				0	lv	\<ahelp hid=\".uno:ShowDetail\"\>Shows the details of the grouped row or column that contains the cursor. To show the details of all of the grouped rows or columns, select the outlined table, and then choose this command.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080200.xhp	0	help	par_id3155922	3			0	lv	To hide a selected group, choose \<emph\>Data -Outline – \</emph\>\<link href=\"text/scalc/01/12080100.xhp\" name=\"Hide Details\"\>\<emph\>Hide Details\</emph\>\</link\>.				20200411 15:09:53
