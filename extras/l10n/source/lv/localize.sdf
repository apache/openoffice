helpcontent2	source\text\sbasic\shared\03060500.xhp	0	help	par_id3155856				0	lv	vA = 10: vB = 8: vC = 6: vD = Null				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03060500.xhp	0	help	par_id3152460				0	lv	vOut = vA > vB Or vB > vC REM -1				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03060500.xhp	0	help	par_id3147349				0	lv	vOut = vB > vA Or vB > vC REM -1				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03060500.xhp	0	help	par_id3151114				0	lv	vOut = vA > vB Or vB > vD REM -1				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03060500.xhp	0	help	par_id3153726				0	lv	vOut = (vB > vD Or vB > vA) REM 0				20200411 15:09:53
