helpcontent2	source\text\shared\autopi\01110300.xhp	0	help	hd_id3153323				0	lv	\<link href=\"text/shared/autopi/01110300.xhp\" name=\"HTML Export - Page 3\"\>HTML Export - Page 3\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110300.xhp	0	help	par_id3147102				0	lv	Specifies the graphics type and the target screen resolution.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110300.xhp	0	help	hd_id3155341				0	lv	Save graphics as				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110300.xhp	0	help	par_id3157909				0	lv	Determines the image format. You can also define the compression value for the export.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110300.xhp	0	help	hd_id2298959				0	lv	PNG - Portable Network Graphics format				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110300.xhp	0	help	par_id4653767				0	lv	\<ahelp hid=\".\"\>The files are exported as PNG files. PNG files are compressed without loss of data, and can contain more than 256 colors.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110300.xhp	0	help	hd_id3147618				0	lv	GIF - Graphics Interchange Format				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110300.xhp	0	help	par_id3154860				0	lv	\<ahelp hid=\"SD:RADIOBUTTON:DLG_PUBLISHING:PAGE3_GIF\"\>The files are exported as GIF files. GIF files are compressed without loss of data, and have a maximum of 256 colors.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110300.xhp	0	help	hd_id3154306				0	lv	JPG - Compressed file format				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110300.xhp	0	help	par_id3153665				0	lv	\<ahelp hid=\"SD:RADIOBUTTON:DLG_PUBLISHING:PAGE3_JPG\"\>The files are exported as JPEG files. JPEG files are compressed, with adjustable compression and can contain more than 256 colors.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110300.xhp	0	help	hd_id3149763				0	lv	Quality				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110300.xhp	0	help	par_id3151384				0	lv	\<ahelp hid=\"SD:COMBOBOX:DLG_PUBLISHING:PAGE3_QUALITY\"\>Specifies the compression factor of the JPEG graphic. A 100% value offers the best quality for a large data range. The 25% factor indicates small files with inferior image quality.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110300.xhp	0	help	hd_id3148552				0	lv	Monitor resolution				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110300.xhp	0	help	par_id3148947				0	lv	Defines the resolution for the target screen. Depending on the selected resolution, the image will be displayed in a reduced size. You can specify a reduction of up to 80% from the original size.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110300.xhp	0	help	hd_id3152361				0	lv	Low resolution (640x480 pixels)				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110300.xhp	0	help	par_id3153380				0	lv	\<ahelp hid=\"SD:RADIOBUTTON:DLG_PUBLISHING:PAGE3_RESOLUTION_1\"\>Select the low resolution to keep the file size small, even for presentations with many slides.\</ahelp\>				20200411 15:09:53
