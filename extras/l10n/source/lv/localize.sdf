helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3145172				0	lv	const b1=12.345e12				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3159254				0	lv	const b2=1.345e34				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3147287				0	lv	dValue=Exp( Log(b1)+Log(b2) )				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3161832				0	lv	MsgBox "" & dValue & chr(13) & (b1*b2) ,0,"Multiplication by logarithm"				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3151112				0	lv	end sub				20200411 15:09:53
