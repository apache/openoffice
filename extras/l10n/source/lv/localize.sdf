helpcontent2	source\text\schart\01\04010000.xhp	0	help	par_id3150298				0	lv	\<variable id=\"titel\"\>\<ahelp hid=\".uno:InsertMenuTitles\"\>Opens a dialog to enter or modify the titles in a chart.\</ahelp\>\</variable\> You can define the text for the main title, subtitle and the axis labels, and specify if they are displayed.				20200411 15:09:53
helpcontent2	source\text\schart\01\04010000.xhp	0	help	hd_id3150207				0	lv	Main Title				20200411 15:09:53
helpcontent2	source\text\schart\01\04010000.xhp	0	help	par_id3150371				0	lv	\<ahelp hid=\"SCH:EDIT:DLG_TITLE:EDT_MAINTITLE\"\>Marking the \<emph\>Main Title\</emph\> option activates the main title. Enter the desired title in the corresponding text field.\</ahelp\>				20200411 15:09:53
