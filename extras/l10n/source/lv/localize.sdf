helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154046				0	lv	\<ahelp hid=\".\"\>Displays a preview of the current selection.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3145609				0	lv	Next				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3152473	71			0	lv	\<ahelp hid=\".\"\>Click the\<emph\> Next \</emph\>button, and the wizard uses the current dialog settings and proceeds to the next step. If you are on the last step, this button becomes \<emph\>Create\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3149670				0	lv	Back				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3145068				0	lv	\<ahelp hid=\"OFFMGR_PUSHBUTTON_RID_OFADLG_OPTIONS_TREE_PB_BACK\"\>Resets modified values back to the $[officename] default values.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3148755				0	lv	Reset				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3149651				0	lv	\<ahelp hid=\"HID_TABDLG_RESET_BTN\"\>Resets changes made to the current tab to those applicable when this dialog was opened. A confirmation query does not appear when you close the dialog.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3143278				0	lv	Reset				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3150791				0	lv	\<ahelp hid=\"HID_TABDLG_RESET_BTN\"\>Resets modified values back to the default values.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154331				0	lv	A confirmation query does not appear. If you confirm the dialog with OK all settings in this dialog are reset.				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3145173				0	lv	Standard				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154153				0	lv	\<ahelp hid=\"HID_TABDLG_STANDARD_BTN\"\>Resets the values visible in the dialog back to the default installation values.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154299				0	lv	A confirmation does not appear before the defaults are reloaded.				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3147502				0	lv	Back				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3150439				0	lv	\<ahelp hid=\"HID_TABDLG_STANDARD_BTN\"\>View the selections in the dialog made in the previous step. The current settings remain unchanged.\</ahelp\> This button can only be activated from page two on.				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	hd_id3147352				0	lv	More				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3155314	53			0	lv	\<ahelp hid=\"HID_TABDLG_STANDARD_BTN\"\>Click the\<emph\> More\</emph\> button to expand the dialog to show further options. Click again to restore the dialog.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3161659	41			0	lv	\<variable id=\"siehe\"\>See also the following functions: \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3147418				0	lv	\<variable id=\"regulaer\"\>The search supports \<link href=\"text/shared/01/02100001.xhp\" name=\"regular expressions\"\>regular expressions\</link\>. You can enter "all.*", for example to find the first location of "all" followed by any characters. If you want to search for a text that is also a regular expression, you must precede every character with a \\ character. You can switch the automatic evaluation of regular expression on and off in \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - \<link href=\"text/shared/optionen/01060500.xhp\"\>%PRODUCTNAME Calc - Calculate\</link\>.\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3163714	56			0	lv	\<variable id=\"wahr\"\>If an error occurs, the function returns a logical or numerical value. \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154145	54			0	lv	\<variable id=\"kontext\"\>(This command is only accessible through the \<link href=\"text/shared/00/00000005.xhp#kontextmenue\" name=\"context menu\"\>context menu\</link\>). \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3152791	61			0	lv	\<variable id=\"wiederholen\"\>By double-clicking a tool, you can use it for multiple tasks. If you call the tool with a single-click, it reverts back to the last selection after completing the task. \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id9345377				0	lv	\<variable id=\"ShiftF1\"\>Press Shift+F1 and point to a control to learn more about that control. \</variable\>				20200411 15:09:53
