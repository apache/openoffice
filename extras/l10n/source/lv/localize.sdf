helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154063				0	lv	LEN("Text")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146894	108			0	lv	            \<emph\>Text\</emph\> is the text whose length is to be determined.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153884				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156008	110			0	lv	            \<item type=\"input\"\>=LEN("Good Afternoon")\</item\> returns 14.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154300	111			0	lv	            \<item type=\"input\"\>=LEN(12345.67)\</item\> returns 8.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3153983				0	lv	\<bookmark_value\>LOWER function\</bookmark_value\>				20200411 15:09:53
