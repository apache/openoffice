helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3157960				0	lv	\<ahelp hid=\".\" visibility=\"hidden\"\>Type the number of the record that you want to display, and then press Enter.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	hd_id3150868				0	lv	Inserting a New Record				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3149168	6			0	lv	\<ahelp hid=\"HID_GRID_TRAVEL_NEW\" visibility=\"hidden\"\>Inserts a new record into the current table.\</ahelp\>To create a record, click the asterisk (*) button at the bottom of the table view. An empty row is added at the end of the table.				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3152920				0	lv	\<ahelp hid=\".\" visibility=\"hidden\"\>Select the type of record that you want to create. $[officename] inserts a number in the \<emph\>Type\</emph\> column of the record that corresponds to the type that you select here.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3156423				0	lv	\<ahelp hid=\".\" visibility=\"hidden\"\>Enter a short name for the record. The short name appears in the \<emph\>Identifier\</emph\> column in the list of records.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	par_id3155994				0	lv	\<ahelp hid=\".\" visibility=\"hidden\"\>Enter additional information for the selected record. If you want, you can also enter the information in the corresponding field in the table.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02250000.xhp	0	help	hd_id3163716				0	lv	Finding and Filtering Records				20200411 15:09:53
