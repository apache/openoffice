helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN11E45				0	lv	\<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3163527				0	lv	\<bookmark_value\>SUMXMY2 function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3163527				0	lv	SUMXMY2				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163556				0	lv	\<ahelp hid=\"HID_FUNC_SUMMEXMY2\"\>Adds the squares of the variance between corresponding values in two arrays.\</ahelp\>				20200411 15:09:53
