helpcontent2	source\text\scalc\01\format_graphic.xhp	0	help	par_id2480544				0	lv	\<ahelp hid=\".\"\>Switches \<emph\>Edit Points\</emph\> mode for an inserted freeform line on and off.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04010000.xhp	0	help	tit				0	lv	Manual Break				20200411 15:09:53
helpcontent2	source\text\scalc\01\04010000.xhp	0	help	bm_id3153192				0	lv	\<bookmark_value\>spreadsheets; inserting breaks in\</bookmark_value\>\<bookmark_value\>inserting; breaks\</bookmark_value\>\<bookmark_value\>page breaks; inserting in spreadsheets\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04010000.xhp	0	help	hd_id3153192				0	lv	\<link href=\"text/scalc/01/04010000.xhp\" name=\"Manual Break\"\>Manual Break\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04010000.xhp	0	help	par_id3125864				0	lv	\<ahelp hid=\".\"\>This command inserts manual row or column breaks to ensure that your data prints properly. You can insert a horizontal page break above, or a vertical page break to the left of, the active cell.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04010000.xhp	0	help	par_id3155133				0	lv	Choose \<link href=\"text/scalc/01/02190000.xhp\" name=\"Edit - Delete Manual Break\"\>Edit - Delete Manual Break\</link\> to remove breaks created manually.				20200411 15:09:53
