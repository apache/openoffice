helpcontent2	source\text\shared\01\06010000.xhp	0	help	hd_id3154071				0	lv	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>AutoCorrect\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010000.xhp	0	help	par_id3153798				0	lv	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<ahelp hid=\"SVX_PUSHBUTTON_RID_SVXDLG_SPELLCHECK_BTN_AUTOCORR\"\>Adds the current combination of the incorrect word and the replacement word to the AutoCorrect replacements table.\</ahelp\>\</caseinline\>\</switchinline\>				20200411 15:09:53
