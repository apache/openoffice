helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3149792				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166440				0	lv	COSH(Number)				20200411 15:09:53
