helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155364	76			0	lv	            \<item type=\"input\"\>=PROPER("open office")\</item\> returns Open Office.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149171				0	lv	\<bookmark_value\>REPLACE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149171				0	lv	REPLACE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148925				0	lv	\<ahelp hid=\"HID_FUNC_ERSETZEN\"\>Replaces part of a text string with a different text string.\</ahelp\> This function can be used to replace both characters and numbers (which are automatically converted to text). The result of the function is always displayed as text. If you intend to perform further calculations with a number which has been replaced by text, you will need to convert it back to a number using the \<link href=\"text/scalc/01/04060110.xhp\" name=\"VALUE\"\>VALUE\</link\> function.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3158426				0	lv	Any text containing numbers must be enclosed in quotation marks if you do not want it to be interpreted as a number and automatically converted to text.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149159				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147286				0	lv	REPLACE("Text"; Position; Length; "NewText")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149797	27			0	lv	            \<emph\>Text\</emph\> refers to text of which a part will be replaced.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3166451	28			0	lv	            \<emph\>Position\</emph\> refers to the position within the text where the replacement will begin.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156040	29			0	lv	            \<emph\>Length\</emph\> is the number of characters in \<emph\>Text\</emph\> to be replaced.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3159188	30			0	lv	            \<emph\>NewText\</emph\> refers to the text which replaces \<emph\>Text\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146958				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154096	32			0	lv	            \<item type=\"input\"\>=REPLACE("1234567";1;1;"444")\</item\> returns "444234567". One character at position 1 is replaced by the complete \<item type=\"literal\"\>NewText\</item\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149741				0	lv	\<bookmark_value\>REPT function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149741				0	lv	REPT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153748				0	lv	\<ahelp hid=\"HID_FUNC_WIEDERHOLEN\"\>Repeats a character string by the given \<emph\>number\</emph\> of copies.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152884				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150494				0	lv	REPT("Text"; Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154859	197			0	lv	            \<emph\>Text\</emph\> is the text to be repeated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150638	198			0	lv	            \<emph\>Number\</emph\> is the number of repetitions.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149922				0	lv	The result can be a maximum of 255 characters.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3156213				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148626	200			0	lv	            \<item type=\"input\"\>=REPT("Good morning";2)\</item\> returns Good morningGood morning.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149805				0	lv	\<bookmark_value\>RIGHT function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149805				0	lv	RIGHT				20200411 15:09:53
