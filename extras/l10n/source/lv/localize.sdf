helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148616				0	lv	\<item type=\"input\"\>=COT(PI()/4)\</item\> returns 1, the cotangent of PI/4 radians.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148986				0	lv	\<item type=\"input\"\>=COT(RADIANS(45))\</item\> returns 1, the cotangent of 45 degrees.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3154337				0	lv	\<bookmark_value\>COTH function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154337				0	lv	COTH				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149419				0	lv	\<ahelp hid=\"HID_FUNC_COTHYP\"\>Returns the hyperbolic cotangent of a given number (angle).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3149242				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143280				0	lv	COTH(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154799				0	lv	 Returns the hyperbolic cotangent of \<emph\>Number\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155422				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144754				0	lv	\<item type=\"input\"\>=COTH(1)\</item\> returns the hyperbolic cotangent of 1, approximately 1.3130.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3145314				0	lv	\<bookmark_value\>DEGREES function\</bookmark_value\>\<bookmark_value\>converting;radians, into degrees\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145314				0	lv	DEGREES				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149939				0	lv	\<ahelp hid=\"HID_FUNC_DEG\"\>Converts radians into degrees.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150623				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145600				0	lv	DEGREES(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149484				0	lv	\<emph\>Number\</emph\> is the angle in radians to be converted to degrees.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3669545				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3459578				0	lv	\<item type=\"input\"\>=DEGREES(PI())\</item\> returns 180 degrees.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3148698				0	lv	\<bookmark_value\>EXP function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3148698				0	lv	EXP				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150592				0	lv	\<ahelp hid=\"HID_FUNC_EXP\"\>Returns e raised to the power of a number.\</ahelp\> The constant e has a value of approximately 2.71828182845904.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150351				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146786				0	lv	EXP(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155608				0	lv	\<emph\>Number\</emph\> is the power to which e is to be raised.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154418				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156340				0	lv	\<item type=\"input\"\>=EXP(1)\</item\> returns 2.71828182845904, the mathematical constant e to Calc's accuracy.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3145781				0	lv	\<bookmark_value\>FACT function\</bookmark_value\>\<bookmark_value\>factorials;numbers\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145781				0	lv	FACT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151109				0	lv	\<ahelp hid=\"HID_FUNC_FAKULTAET\"\>Returns the factorial of a number.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146902				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154661				0	lv	FACT(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152952				0	lv	 Returns Number!, the factorial of \<emph\>Number\</emph\>, calculated as 1*2*3*4* ... * Number.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3834650				0	lv	=FACT(0) returns 1 by definition. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8429517				0	lv	The factorial of a negative number returns the "invalid argument" error.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154569				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154476				0	lv	\<item type=\"input\"\>=FACT(3)\</item\> returns 6.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147525				0	lv	\<item type=\"input\"\>=FACT(0)\</item\> returns 1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3159084				0	lv	\<bookmark_value\>INT function\</bookmark_value\>\<bookmark_value\>numbers;rounding down to next integer\</bookmark_value\>\<bookmark_value\>rounding;down to next integer\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3159084				0	lv	INT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158441				0	lv	\<ahelp hid=\"HID_FUNC_GANZZAHL\"\>Rounds a number down to the nearest integer.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146132				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156146				0	lv	INT(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154117				0	lv	Returns \<emph\>Number\</emph\> rounded down to the nearest integer.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id153508				0	lv	Negative numbers round down to the integer below.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155118				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156267				0	lv	\<item type=\"input\"\>=INT(5.7)\</item\> returns 5.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147323				0	lv	\<item type=\"input\"\>=INT(-1.3)\</item\> returns -2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3150938				0	lv	\<bookmark_value\>EVEN function\</bookmark_value\>\<bookmark_value\>numbers;rounding up/down to even integers\</bookmark_value\>\<bookmark_value\>rounding;up/down to even integers\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150938				0	lv	EVEN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149988				0	lv	\<ahelp hid=\"HID_FUNC_GERADE\"\>Rounds a positive number up to the next even integer and a negative number down to the next even integer.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3148401				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150830				0	lv	EVEN(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153350	231			0	lv	 Returns \<emph\>Number\</emph\> rounded to the next even integer up, away from zero. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155508				0	lv	Examples				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154361				0	lv	\<item type=\"input\"\>=EVEN(2.3)\</item\> returns 4.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8477736				0	lv	\<item type=\"input\"\>=EVEN(2)\</item\> returns 2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id159611				0	lv	\<item type=\"input\"\>=EVEN(0)\</item\> returns 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6097598				0	lv	\<item type=\"input\"\>=EVEN(-0.5)\</item\> returns -2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3147356				0	lv	\<bookmark_value\>GCD function\</bookmark_value\>\<bookmark_value\>greatest common divisor\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3147356				0	lv	GCD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152465				0	lv	\<ahelp hid=\"HID_FUNC_GGT\"\>Returns the greatest common divisor of two or more integers.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2769249				0	lv	The greatest common divisor is the positive largest integer which will divide, without remainder, each of the given integers.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150643				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154524				0	lv	GCD(Integer1; Integer2; ...; Integer30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149340				0	lv	\<emph\>Integer1 To 30\</emph\> are up to 30 integers whose greatest common divisor is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3147317				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151285				0	lv	\<item type=\"input\"\>=GCD(16;32;24) \</item\>gives the result 8, because 8 is the largest number that can divide 16, 24 and 32 without a remainder.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1604663				0	lv	\<item type=\"input\"\>=GCD(B1:B3)\</item\> where cells B1, B2, B3 contain \<item type=\"input\"\>9\</item\>, \<item type=\"input\"\>12\</item\>, \<item type=\"input\"\>9\</item\> gives 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3151221				0	lv	\<bookmark_value\>GCD_ADD function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3151221				0	lv	GCD_ADD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153257				0	lv	\<ahelp hid=\"HID_AAI_FUNC_GCD\"\> The result is the greatest common divisor of a list of numbers.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3147548				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156205				0	lv	GCD_ADD(Number(s))				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145150				0	lv	\<emph\>Number(s)\</emph\> is a list of up to 30 numbers.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150239				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159192				0	lv	\<item type=\"input\"\>=GCD_ADD(5;15;25)\</item\> returns 5.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3156048				0	lv	\<bookmark_value\>ISEVEN function\</bookmark_value\>\<bookmark_value\>even integers\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3156048				0	lv	ISEVEN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149169				0	lv	\<ahelp hid=\"HID_FUNC_ISTGERADE\"\>Returns TRUE if the value is an even integer, or FALSE if the value is odd.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146928				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151203				0	lv	ISEVEN(Value)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150491				0	lv	\<emph\>Value\</emph\> is the value to be checked.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3445844				0	lv	If Value is not an integer any digits after the decimal point are ignored. The sign of Value is also ignored.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154136				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163813				0	lv	\<item type=\"input\"\>=ISEVEN(48)\</item\> returns TRUE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8378856				0	lv	\<item type=\"input\"\>=ISEVEN(33)\</item\> returns FALSE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7154759				0	lv	\<item type=\"input\"\>=ISEVEN(0)\</item\> returns TRUE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1912289				0	lv	\<item type=\"input\"\>=ISEVEN(-2.1)\</item\> returns TRUE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5627307				0	lv	\<item type=\"input\"\>=ISEVEN(3.999)\</item\> returns FALSE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3156034				0	lv	\<bookmark_value\>ISODD function\</bookmark_value\>\<bookmark_value\>odd integers\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3156034				0	lv	ISODD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155910				0	lv	\<ahelp hid=\"HID_FUNC_ISTUNGERADE\"\>Returns TRUE if the value is odd, or FALSE if the number is even.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3151006				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151375				0	lv	ISODD(value)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155139				0	lv	\<emph\>Value\</emph\> is the value to be checked.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9027680				0	lv	If Value is not an integer any digits after the decimal point are ignored. The sign of Value is also ignored.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163723				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155345				0	lv	\<item type=\"input\"\>=ISODD(33)\</item\> returns TRUE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9392986				0	lv	\<item type=\"input\"\>=ISODD(48)\</item\> returns FALSE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5971251				0	lv	\<item type=\"input\"\>=ISODD(3.999)\</item\> returns TRUE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id4136478				0	lv	\<item type=\"input\"\>=ISODD(-3.1)\</item\> returns TRUE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3145213				0	lv	\<bookmark_value\>LCM function\</bookmark_value\>\<bookmark_value\>least common multiples\</bookmark_value\>\<bookmark_value\>lowest common multiples\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145213				0	lv	LCM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146814				0	lv	\<ahelp hid=\"HID_FUNC_KGV\"\>Returns the least common multiple of one or more integers.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3148632				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147279				0	lv	LCM(Integer1; Integer2; ...; Integer30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156348				0	lv	\<emph\>Integer1 to 30\</emph\> are up to 30 integers whose lowest common multiple is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3156431				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154914				0	lv	If you enter the numbers \<item type=\"input\"\>512\</item\>;\<item type=\"input\"\>1024\</item\> and \<item type=\"input\"\>2000\</item\> in the Integer 1;2 and 3 text boxes, 128000 will be returned as the result.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3154230				0	lv	\<bookmark_value\>LCM_ADD function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154230				0	lv	LCM_ADD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3149036				0	lv	\<ahelp hid=\"HID_AAI_FUNC_LCM\"\> The result is the lowest common multiple of a list of numbers.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153132				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154395				0	lv	LCM_ADD(Number(s))				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3147377				0	lv	\<emph\>Number(s)\</emph\> is a list of up to 30 numbers.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145122				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145135				0	lv	\<item type=\"input\"\>=LCM_ADD(5;15;25)\</item\> returns 75.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3155802				0	lv	\<bookmark_value\>COMBIN function\</bookmark_value\>\<bookmark_value\>number of combinations\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155802				0	lv	COMBIN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3156172				0	lv	\<ahelp hid=\"HID_FUNC_KOMBINATIONEN\"\>Returns the number of combinations for elements without repetition.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3156193				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150223				0	lv	COMBIN(Count1; Count2)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150313				0	lv	\<emph\>Count1\</emph\> is the number of items in the set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153830				0	lv	\<emph\>Count2\</emph\> is the number of items to choose from the set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6807458				0	lv	COMBIN returns the number of ordered ways to choose these items. For example if there are 3 items A, B and C in a set, you can choose 2 items in 3 different ways, namely AB, AC and BC.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7414471				0	lv	COMBIN implements the formula: Count1!/(Count2!*(Count1-Count2)!)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153171				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153517				0	lv	\<item type=\"input\"\>=COMBIN(3;2)\</item\> returns 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3150284				0	lv	\<bookmark_value\>COMBINA function\</bookmark_value\>\<bookmark_value\>number of combinations with repetitions\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3150284				0	lv	COMBINA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157894				0	lv	\<ahelp hid=\"HID_FUNC_KOMBINATIONEN2\"\>Returns the number of combinations of a subset of items including repetitions.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145752				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145765				0	lv	COMBINA(Count1; Count2)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153372				0	lv	\<emph\>Count1\</emph\> is the number of items in the set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155544				0	lv	\<emph\>Count2\</emph\> is the number of items to choose from the set.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1997131				0	lv	COMBINA returns the number of unique ways to choose these items, where the order of choosing is irrelevant, and repetition of items is allowed. For example if there are 3 items A, B and C in a set, you can choose 2 items in 6 different ways, namely AA, AB, AC, BB, BC and CC.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2052064				0	lv	COMBINA implements the formula: (Count1+Count2-1)! / (Count2!(Count1-1)!)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154584				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152904				0	lv	\<item type=\"input\"\>=COMBINA(3;2)\</item\> returns 6.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3156086				0	lv	\<bookmark_value\>TRUNC function\</bookmark_value\>\<bookmark_value\>decimal places;cutting off\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3156086				0	lv	TRUNC				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157866				0	lv	\<ahelp hid=\"HID_FUNC_KUERZEN\"\>Truncates a number by removing decimal places.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3148499				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148511				0	lv	TRUNC(Number; Count)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150796				0	lv	Returns \<emph\>Number\</emph\> with at most \<emph\>Count\</emph\> decimal places. Excess decimal places are simply removed, irrespective of sign.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3150816				0	lv	\<item type=\"literal\"\>TRUNC(Number; 0)\</item\> behaves as \<item type=\"literal\"\>INT(Number)\</item\> for positive numbers, but effectively rounds towards zero for negative numbers.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3148548				0	lv	The \<emph\>visible\</emph\> decimal places of the result are specified in \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - \<link href=\"text/shared/optionen/01060500.xhp\"\>%PRODUCTNAME Calc - Calculate\</link\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152555				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152569				0	lv	\<item type=\"input\"\>=TRUNC(1.239;2)\</item\> returns 1.23. The 9 is lost.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7050080				0	lv	\<item type=\"input\"\>=TRUNC(-1.234999;3)\</item\> returns -1.234. All the 9s are lost.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3153601				0	lv	\<bookmark_value\>LN function\</bookmark_value\>\<bookmark_value\>natural logarithm\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153601				0	lv	LN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154974				0	lv	\<ahelp hid=\"HID_FUNC_LN\"\>Returns the natural logarithm based on the constant e of a number.\</ahelp\> The constant e has a value of approximately 2.71828182845904.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154993				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155284				0	lv	LN(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155297				0	lv	\<emph\>Number\</emph\> is the value whose natural logarithm is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153852				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153866				0	lv	\<item type=\"input\"\>=LN(3)\</item\> returns the natural logarithm of 3 (approximately 1.0986).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5747245				0	lv	\<item type=\"input\"\>=LN(EXP(321))\</item\> returns 321.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3109813				0	lv	\<bookmark_value\>LOG function\</bookmark_value\>\<bookmark_value\>logarithms\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3109813				0	lv	LOG				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3109841				0	lv	\<ahelp hid=\"HID_FUNC_LOG\"\>Returns the logarithm of a number to the specified base.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144719				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144732				0	lv	LOG(Number; Base)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144746				0	lv	\<emph\>Number\</emph\> is the value whose logarithm is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152840				0	lv	\<emph\>Base\</emph\> (optional) is the base for the logarithm calculation. If omitted, Base 10 is assumed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152860				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3154429				0	lv	\<item type=\"input\"\>=LOG(10;3)\</item\> returns the logarithm to base 3 of 10 (approximately 2.0959).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5577562				0	lv	\<item type=\"input\"\>=LOG(7^4;7)\</item\> returns 4.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3154187				0	lv	\<bookmark_value\>LOG10 function\</bookmark_value\>\<bookmark_value\>base-10 logarithm\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3154187				0	lv	LOG10				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155476				0	lv	\<ahelp hid=\"HID_FUNC_LOG10\"\>Returns the base-10 logarithm of a number.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155494				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159294				0	lv	LOG10(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159308				0	lv	Returns the logarithm to base 10 of \<emph\>Number\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3159328				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157916				0	lv	\<item type=\"input\"\>=LOG10(5)\</item\> returns the base-10 logarithm of 5 (approximately 0.69897).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152518				0	lv	\<bookmark_value\>CEILING function\</bookmark_value\>\<bookmark_value\>rounding;up to multiples of significance\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152518				0	lv	CEILING				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153422				0	lv	\<ahelp hid=\"HID_FUNC_OBERGRENZE\"\>Rounds a number up to the nearest multiple of Significance.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3153440				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153454				0	lv	CEILING(Number; Significance; Mode)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3153467				0	lv	\<emph\>Number\</emph\> is the number that is to be rounded up.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155000				0	lv	\<emph\>Significance\</emph\> is the number to whose multiple the value is to be rounded up.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155020				0	lv	\<emph\>Mode\</emph\> is an optional value. If the Mode value is given and not equal to zero, and if Number and Significance are negative, then rounding is done based on the absolute value of Number. This parameter is ignored when exporting to MS Excel as Excel does not know any third parameter.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163792				0	lv	If both parameters Number and Significance are negative and the Mode value is equal to zero or is not given, the results in $[officename] and Excel will differ after the import has been completed. If you export the spreadsheet to Excel, use Mode=1 to see the same results in Excel as in Calc.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145697				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145710				0	lv	\<item type=\"input\"\>=CEILING(-11;-2)\</item\> returns -10				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145725				0	lv	\<item type=\"input\"\>=CEILING(-11;-2;0)\</item\> returns -10				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145740				0	lv	\<item type=\"input\"\>=CEILING(-11;-2;1)\</item\> returns -12				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3157762				0	lv	\<bookmark_value\>PI function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157762				0	lv	PI				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157790				0	lv	\<ahelp hid=\"HID_FUNC_PI\"\>Returns 3.14159265358979, the value of the mathematical constant PI to 14 decimal places.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157809				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157822				0	lv	PI()				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157836				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152370				0	lv	\<item type=\"input\"\>=PI()\</item\> returns 3.14159265358979.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152418				0	lv	\<bookmark_value\>MULTINOMIAL function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152418				0	lv	MULTINOMIAL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152454				0	lv	\<ahelp hid=\"HID_AAI_FUNC_MULTINOMIAL\"\> Returns the factorial of the sum of the arguments divided by the product of the factorials of the arguments.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155646				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155660				0	lv	MULTINOMIAL(Number(s))				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155673				0	lv	\<emph\>Number(s)\</emph\> is a list of up to 30 numbers.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155687				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3155701				0	lv	\<item type=\"input\"\>=MULTINOMIAL(F11:H11)\</item\> returns 1260, if F11 to H11 contain the values \<item type=\"input\"\>2\</item\>, \<item type=\"input\"\>3\</item\> and \<item type=\"input\"\>4\</item\>. This corresponds to the formula =(2+3+4)! / (2!*3!*4!)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3155717				0	lv	\<bookmark_value\>POWER function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3155717				0	lv	POWER				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159495				0	lv	\<ahelp hid=\"HID_FUNC_POTENZ\"\>Returns a number raised to another number.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3159513				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159526				0	lv	POWER(Base; Exponent)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159540				0	lv	Returns \<emph\>Base\</emph\> raised to the power of \<emph\>Exponent\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5081637				0	lv	The same result may be achieved by using the exponentiation operator ^:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9759514				0	lv	\<item type=\"literal\"\>Base^Exponent\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3159580				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159594				0	lv	\<item type=\"input\"\>=POWER(4;3)\</item\> returns 64, which is 4 to the power of 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1614429				0	lv	=4^3 also returns 4 to the power of 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152651				0	lv	\<bookmark_value\>SERIESSUM function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152651				0	lv	SERIESSUM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152688				0	lv	\<ahelp hid=\".\"\>Sums the first terms of a power series.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152708				0	lv	SERIESSUM(x;n;m;coefficients) = coefficient_1*x^n + coefficient_2*x^(n+m) + coefficient_3*x^(n+2m) +...+ coefficient_i*x^(n+(i-1)m)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152724				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_idN11BD9				0	lv	SERIESSUM(X; N; M; Coefficients)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152737				0	lv	\<emph\>X\</emph\> is the input value for the power series.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144344				0	lv	\<emph\>N\</emph\> is the initial power				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144357				0	lv	\<emph\>M\</emph\> is the increment to increase N				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144370				0	lv	\<emph\>Coefficients\</emph\> is a series of coefficients. For each coefficient the series sum is extended by one section.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144386				0	lv	\<bookmark_value\>PRODUCT function\</bookmark_value\>\<bookmark_value\>numbers;multiplying\</bookmark_value\>\<bookmark_value\>multiplying;numbers\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144386				0	lv	PRODUCT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144414				0	lv	\<ahelp hid=\"HID_FUNC_PRODUKT\"\>Multiplies all the numbers given as arguments and returns the product.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144433				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144446				0	lv	PRODUCT(Number1; Number2; ...; Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144460				0	lv	\<emph\>Number1 to 30\</emph\> are up to 30 arguments whose product is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1589098				0	lv	PRODUCT returns number1 * number2 * number3 * ...				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144480				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144494				0	lv	\<item type=\"input\"\>=PRODUCT(2;3;4)\</item\> returns 24.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3160340				0	lv	\<bookmark_value\>SUMSQ function\</bookmark_value\>\<bookmark_value\>square number additions\</bookmark_value\>\<bookmark_value\>sums;of square numbers\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160340				0	lv	SUMSQ				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160368				0	lv	\<ahelp hid=\"HID_FUNC_QUADRATESUMME\"\>If you want to calculate the sum of the squares of numbers (totaling up of the squares of the arguments), enter these into the text fields.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160388				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160402				0	lv	SUMSQ(Number1; Number2; ...; Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160415				0	lv	\<emph\>Number1 to 30\</emph\> are up to 30 arguments the sum of whose squares is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3160436				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3160449				0	lv	If you enter the numbers \<item type=\"input\"\>2\</item\>; \<item type=\"input\"\>3\</item\> and \<item type=\"input\"\>4\</item\> in the Number 1; 2 and 3 text boxes, 29 is returned as the result.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3158247				0	lv	\<bookmark_value\>MOD function\</bookmark_value\>\<bookmark_value\>remainders of divisions\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158247				0	lv	MOD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158276				0	lv	\<ahelp hid=\"HID_FUNC_REST\"\>Returns the remainder when one integer is divided by another.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158294				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158308				0	lv	MOD(Dividend; Divisor)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158321				0	lv	 For integer arguments this function returns Dividend modulo Divisor, that is the remainder when \<emph\>Dividend\</emph\> is divided by \<emph\>Divisor\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158341				0	lv	This function is implemented as \<item type=\"literal\"\>Dividend - Divisor * INT(Dividend/Divisor)\</item\> , and this formula gives the result if the arguments are not integer.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158361				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158374				0	lv	\<item type=\"input\"\>=MOD(22;3)\</item\> returns 1, the remainder when 22 is divided by 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1278420				0	lv	\<item type=\"input\"\>=MOD(11.25;2.5)\</item\> returns 1.25.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144592				0	lv	\<bookmark_value\>QUOTIENT function\</bookmark_value\>\<bookmark_value\>divisions\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144592				0	lv	QUOTIENT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144627				0	lv	\<ahelp hid=\"HID_AAI_FUNC_QUOTIENT\"\>Returns the integer part of a division operation.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144646				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144659				0	lv	QUOTIENT(Numerator; Denominator)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9038972				0	lv	Returns the integer part of \<emph\>Numerator\</emph\> divided by \<emph\>Denominator\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7985168				0	lv	QUOTIENT is equivalent to \<item type=\"literal\"\>INT(numerator/denominator)\</item\>, except that it may report errors with different error codes.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144674				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144687				0	lv	\<item type=\"input\"\>=QUOTIENT(11;3)\</item\> returns 3. The remainder of 2 is lost.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144702				0	lv	\<bookmark_value\>RADIANS function\</bookmark_value\>\<bookmark_value\>converting;degrees, into radians\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144702				0	lv	RADIANS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158025				0	lv	\<ahelp hid=\"HID_FUNC_RAD\"\>Converts degrees to radians.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158042				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158055				0	lv	RADIANS(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158069				0	lv	\<emph\>Number\</emph\> is the angle in degrees to be converted to radians.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id876186				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3939634				0	lv	\<item type=\"input\"\>=RADIANS(90)\</item\> returns 1.5707963267949, which is PI/2 to Calc's accuracy.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3158121				0	lv	\<bookmark_value\>ROUND function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158121				0	lv	ROUND				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158150				0	lv	\<ahelp hid=\"HID_FUNC_RUNDEN\"\>Rounds a number to a certain number of decimal places.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3158169				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158182				0	lv	ROUND(Number; Count)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3158196				0	lv	Returns \<emph\>Number\</emph\> rounded to \<emph\>Count\</emph\> decimal places. If Count is omitted or zero, the function rounds to the nearest integer. If Count is negative, the function rounds to the nearest 10, 100, 1000, etc.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id599688				0	lv	This function rounds to the nearest number. See ROUNDDOWN and ROUNDUP for alternatives.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145863				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145876				0	lv	\<item type=\"input\"\>=ROUND(2.348;2)\</item\> returns 2.35				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3145899				0	lv	\<item type=\"input\"\>=ROUND(-32.4834;3)\</item\> returns -32.483. Change the cell format to see all decimals.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1371501				0	lv	\<item type=\"input\"\>=ROUND(2.348;0)\</item\> returns 2.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id4661702				0	lv	\<item type=\"input\"\>=ROUND(2.5)\</item\> returns 3. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7868892				0	lv	\<item type=\"input\"\>=ROUND(987.65;-2)\</item\> returns 1000.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3145991				0	lv	\<bookmark_value\>ROUNDDOWN function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3145991				0	lv	ROUNDDOWN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146020				0	lv	\<ahelp hid=\"HID_FUNC_ABRUNDEN\"\>Rounds a number down, toward zero, to a certain precision.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3146037				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146051				0	lv	ROUNDDOWN(Number; Count)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3146064				0	lv	Returns \<emph\>Number\</emph\> rounded down (towards zero) to \<emph\>Count\</emph\> decimal places. If Count is omitted or zero, the function rounds down to an integer. If Count is negative, the function rounds down to the next 10, 100, 1000, etc.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2188787				0	lv	This function rounds towards zero. See ROUNDUP and ROUND for alternatives.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163164				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163178				0	lv	\<item type=\"input\"\>=ROUNDDOWN(1.234;2)\</item\> returns 1.23.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5833307				0	lv	\<item type=\"input\"\>=ROUNDDOWN(45.67;0)\</item\> returns 45.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7726676				0	lv	\<item type=\"input\"\>=ROUNDDOWN(-45.67)\</item\> returns -45.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3729361				0	lv	\<item type=\"input\"\>=ROUNDDOWN(987.65;-2)\</item\> returns 900.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3163268				0	lv	\<bookmark_value\>ROUNDUP function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163268				0	lv	ROUNDUP				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163297				0	lv	\<ahelp hid=\"HID_FUNC_AUFRUNDEN\"\>Rounds a number up, away from zero, to a certain precision.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163315				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163328				0	lv	ROUNDUP(Number; Count)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163342				0	lv	Returns \<emph\>Number\</emph\> rounded up (away from zero) to \<emph\>Count\</emph\> decimal places. If Count is omitted or zero, the function rounds up to an integer. If Count is negative, the function rounds up to the next 10, 100, 1000, etc.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9573961				0	lv	This function rounds away from zero. See ROUNDDOWN and ROUND for alternatives.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163381				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144786				0	lv	\<item type=\"input\"\>=ROUNDUP(1.1111;2)\</item\> returns 1.12.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7700430				0	lv	\<item type=\"input\"\>=ROUNDUP(1.2345;1)\</item\> returns 1.3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1180455				0	lv	\<item type=\"input\"\>=ROUNDUP(45.67;0)\</item\> returns 46.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3405560				0	lv	\<item type=\"input\"\>=ROUNDUP(-45.67)\</item\> returns -46.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3409527				0	lv	\<item type=\"input\"\>=ROUNDUP(987.65;-2)\</item\> returns 1000.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144877				0	lv	\<bookmark_value\>SIN function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144877				0	lv	SIN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144906				0	lv	\<ahelp hid=\"HID_FUNC_SIN\"\>Returns the sine of the given angle (in radians).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144923				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144937				0	lv	SIN(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144950				0	lv	Returns the (trigonometric) sine of \<emph\>Number\</emph\>, the angle in radians.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8079470				0	lv	To return the sine of an angle in degrees, use the RADIANS function.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144969				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144983				0	lv	\<item type=\"input\"\>=SIN(PI()/2)\</item\> returns 1, the sine of PI/2 radians.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3916440				0	lv	\<item type=\"input\"\>=SIN(RADIANS(30))\</item\> returns 0.5, the sine of 30 degrees.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3163397				0	lv	\<bookmark_value\>SINH function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163397				0	lv	SINH				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163426				0	lv	\<ahelp hid=\"HID_FUNC_SINHYP\"\>Returns the hyperbolic sine of a number.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163444				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163457				0	lv	SINH(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163471				0	lv	Returns the hyperbolic sine of \<emph\>Number\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163491				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163504				0	lv	\<item type=\"input\"\>=SINH(0)\</item\> returns 0, the hyperbolic sine of 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3163596				0	lv	\<bookmark_value\>SUM function\</bookmark_value\>\<bookmark_value\>adding;numbers in cell ranges\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163596				0	lv	SUM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163625				0	lv	\<ahelp hid=\"HID_FUNC_SUMME\"\>Adds all the numbers in a range of cells.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163643				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163656				0	lv	SUM(Number1; Number2; ...; Number30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163671				0	lv	\<emph\>Number 1 to Number 30\</emph\> are up to 30 arguments whose sum is to be calculated.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163690				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163704				0	lv	If you enter the numbers \<item type=\"input\"\>2\</item\>; \<item type=\"input\"\>3 \</item\>and \<item type=\"input\"\>4\</item\> in the Number 1; 2 and 3 text boxes, 9 will be returned as the result.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151740				0	lv	\<item type=\"input\"\>=SUM(A1;A3;B5)\</item\> calculates the sum of the three cells. \<item type=\"input\"\>=SUM (A1:E10)\</item\> calculates the sum of all cells in the A1 to E10 cell range.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151756				0	lv	Conditions linked by AND can be used with the function SUM() in the following manner:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151774				0	lv	Example assumption: You have entered invoices into a table. Column A contains the date value of the invoice, column B the amounts. You want to find a formula that you can use to return the total of all amounts only for a specific month, e.g. only the amount for the period >=2008-01-01 to <2008-02-01. The range with the date values covers A1:A40, the range containing the amounts to be totaled is B1:B40. C1 contains the start date, 2008\<item type=\"input\"\>-01-01\</item\>, of the invoices to be included and C2 the date, 2008\<item type=\"input\"\>-02-01\</item\>, that is no longer included.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151799				0	lv	Enter the following formula as an array formula:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151813				0	lv	\<item type=\"input\"\>=SUM((A1:A40>=C1)*(A1:A40<C2)*B1:B40)\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151828				0	lv	In order to enter this as an array formula, you must press the Shift\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>+Command \</caseinline\>\<defaultinline\>+ Ctrl\</defaultinline\>\</switchinline\>+ Enter keys instead of simply pressing the Enter key to close the formula. The formula will then be shown in the \<emph\>Formula\</emph\> bar enclosed in braces.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151869				0	lv	{=SUM((A1:A40>=C1)*(A1:A40<C2)*B1:B40)}				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151884				0	lv	The formula is based on the fact that the result of a comparison is 1 if the criterion is met and 0 if it is not met. The individual comparison results will be treated as an array and used in matrix multiplication, and at the end the individual values will be totaled to give the result matrix.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3151957				0	lv	\<bookmark_value\>SUMIF function\</bookmark_value\>\<bookmark_value\>adding;specified numbers\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3151957				0	lv	SUMIF				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151986				0	lv	\<ahelp hid=\"HID_FUNC_SUMMEWENN\"\>Adds the cells specified by a given criteria.\</ahelp\> This function is used to browse a range when you search for a certain value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152015				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152028				0	lv	SUMIF(Range; Criteria; SumRange)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152043				0	lv	\<emph\>Range\</emph\> is the range to which the criteria are to be applied.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152062				0	lv	\<emph\>Criteria\</emph\> is the cell in which the search criterion is shown, or the search criterion itself. If the criteria is written into the formula, it has to be surrounded by double quotes.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152083				0	lv	\<emph\>SumRange\</emph\> is the range from which values are summed. If this parameter has not been indicated, the values found in the Range are summed.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8347422				0	lv	SUMIF supports the reference concatenation operator (~) only in the Criteria parameter, and only if the optional SumRange parameter is not given.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152110				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152148				0	lv	To sum up only negative numbers: \<item type=\"input\"\>=SUMIF(A1:A10;"<0")\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6670125				0	lv	\<item type=\"input\"\>=SUMIF(A1:A10;">0";B1:10)\</item\> - sums values from the range B1:B10 only if the corresponding values in the range A1:A10 are >0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6062196				0	lv	See COUNTIF() for some more syntax examples that can be used with SUMIF().				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3151957K				0	lv	\<bookmark_value\>SUMIFS function\</bookmark_value\>\<bookmark_value\>adding;specified numbers\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3151957K				0	lv	SUMIFS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3151986K				0	lv	\<ahelp hid=\"HID_FUNC_SUMMEWNRNG\"\>Sum the values of cells in a range that meet multiple criteria in multiple ranges.\</ahelp\> 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152015K				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152028K				0	lv	SUMIFS( Reference R ; Reference R1 ; Criterion C1 [ ; Reference R2 ; Criterion C2 ]... )				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152043K				0	lv	Sums the value of cells in range R that meet the Criterion C1 in the reference range R1, and the Criterion C2 in the reference range R2, and so on. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152062K				0	lv	A \<emph\>Criterion\</emph\> is a single cell Reference, Number or Text. If the criterion is written into the formula, it has to be surrounded by double quotes.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152083K				0	lv	All \<emph\>Reference\</emph\> ranges shall have the same dimension and size, else an Error is returned.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152110K				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152148K				0	lv	Sum up cells in range A1:10 if the entries in B1:B10 are positive, and the entries in D1:D10 are the letter "A": \<item type=\"input\"\>=SUMIFS(A1:A10;B1:B10;">0";D1:D10;"A")\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6062196K				0	lv	See COUNTIFS() for some more syntax examples that can be used with SUMIFS().				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152195				0	lv	\<bookmark_value\>TAN function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152195				0	lv	TAN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152224				0	lv	\<ahelp hid=\"HID_FUNC_TAN\"\>Returns the tangent of the given angle (in radians).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152242				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152255				0	lv	TAN(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152269				0	lv	Returns the (trigonometric) tangent of \<emph\>Number\</emph\>, the angle in radians.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5752128				0	lv	To return the tangent of an angle in degrees, use the RADIANS function.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152287				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152301				0	lv	\<item type=\"input\"\>=TAN(PI()/4) \</item\>returns 1, the tangent of PI/4 radians.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1804864				0	lv	\<item type=\"input\"\>=TAN(RADIANS(45))\</item\> returns 1, the tangent of 45 degrees.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3165434				0	lv	\<bookmark_value\>TANH function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165434				0	lv	TANH				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165462				0	lv	\<ahelp hid=\"HID_FUNC_TANHYP\"\>Returns the hyperbolic tangent of a number.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165480				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165494				0	lv	TANH(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165508				0	lv	Returns the hyperbolic tangent of \<emph\>Number\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165527				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165541				0	lv	\<item type=\"input\"\>=TANH(0)\</item\> returns 0, the hyperbolic tangent of 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3165633				0	lv	\<bookmark_value\>AutoFilter function; subtotals\</bookmark_value\>\<bookmark_value\>sums;of filtered data\</bookmark_value\>\<bookmark_value\>filtered data; sums\</bookmark_value\>\<bookmark_value\>SUBTOTAL function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165633				0	lv	SUBTOTAL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165682				0	lv	\<ahelp hid=\"HID_FUNC_TEILERGEBNIS\"\>Calculates subtotals.\</ahelp\> If a range already contains subtotals, these are not used for further calculations. Use this function with the AutoFilters to take only the filtered records into account.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165704				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165717				0	lv	SUBTOTAL(Function; Range)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165731				0	lv	\<emph\>Function\</emph\> is a number that stands for one of the following functions:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165782				0	lv	Function index				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165806				0	lv	Function				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165833				0	lv	1				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165856				0	lv	AVERAGE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165883				0	lv	2				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165906				0	lv	COUNT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165933				0	lv	3				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165956				0	lv	COUNTA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165983				0	lv	4				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166006				0	lv	MAX				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166033				0	lv	5				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166056				0	lv	MIN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143316				0	lv	6				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143339				0	lv	PRODUCT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143366				0	lv	7				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143389				0	lv	STDEV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143416				0	lv	8				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143439				0	lv	STDEVP				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143466				0	lv	9				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143489				0	lv	SUM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143516				0	lv	10				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143539				0	lv	VAR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143566				0	lv	11				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143589				0	lv	VARP				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143606				0	lv	\<emph\>Range\</emph\> is the range whose cells are included.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3143625				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143638				0	lv	You have a table in the cell range A1:B5 containing cities in column A and accompanying figures in column B. You have used an AutoFilter so that you only see rows containing the city Hamburg. You want to see the sum of the figures that are displayed; that is, just the subtotal for the filtered rows. In this case the correct formula would be:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143658				0	lv	\<item type=\"input\"\>=SUBTOTAL(9;B2:B5)\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3143672				0	lv	\<bookmark_value\>Euro; converting\</bookmark_value\>\<bookmark_value\>EUROCONVERT function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3143672				0	lv	EUROCONVERT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143708				0	lv	\<ahelp hid=\"HID_FUNC_UMRECHNEN\"\>Converts between old European national currency and to and from Euros.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143731				0	lv	\<emph\>Syntax\</emph\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143748				0	lv	EUROCONVERT(Value; "From_currency"; "To_currency", full_precision, triangulation_precision)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143763				0	lv	\<emph\>Value\</emph\> is the amount of the currency to be converted.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143782				0	lv	\<emph\>From_currency\</emph\> and \<emph\>To_currency\</emph\> are the currency units to convert from and to respectively. These must be text, the official abbreviation for the currency (for example, "EUR"). The rates (shown per Euro) were set by the European Commission.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0119200904301810				0	lv	\<emph\>Full_precision\</emph\> is optional. If omitted or False, the result is rounded according to the decimals of the To currency. If Full_precision is True, the result is not rounded.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0119200904301815				0	lv	\<emph\>Triangulation_precision\</emph\> is optional. If Triangulation_precision is given and >=3, the intermediate result of a triangular conversion (currency1,EUR,currency2) is rounded to that precision. If Triangulation_precision is omitted, the intermediate result is not rounded. Also if To currency is "EUR", Triangulation_precision is used as if triangulation was needed and conversion from EUR to EUR was applied.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143819				0	lv	\<emph\>Examples\</emph\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143837				0	lv	\<item type=\"input\"\>=EUROCONVERT(100;"ATS";"EUR")\</item\> converts 100 Austrian Schillings into Euros.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143853				0	lv	\<item type=\"input\"\>=EUROCONVERT(100;"EUR";"DEM")\</item\> converts 100 Euros into German Marks.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id0908200902090676				0	lv	\<bookmark_value\>CONVERT function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id0908200902074836				0	lv	CONVERT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902131122				0	lv	\<ahelp hid=\".\"\>Converts a value from one unit of measurement to another unit of measurement. The conversion factors are given in a list in the configuration.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902475420				0	lv	At one time the list of conversion factors included the legacy European currencies and the Euro (see examples below). We suggest using the new function EUROCONVERT for converting these currencies.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id0908200902131071				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902131191				0	lv	CONVERT(value;"text";"text")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id0908200902131152				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id090820090213112				0	lv	\<item type=\"input\"\>=CONVERT(100;"ATS";"EUR")\</item\> returns the Euro value of 100 Austrian Schillings.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id0908200902475431				0	lv	=CONVERT(100;"EUR";"DEM") converts 100 Euros into German Marks. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3157177				0	lv	\<bookmark_value\>ODD function\</bookmark_value\>\<bookmark_value\>rounding;up/down to nearest odd integer\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157177				0	lv	ODD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157205				0	lv	\<ahelp hid=\"HID_FUNC_UNGERADE\"\>Rounds a positive number up to the nearest odd integer and a negative number down to the nearest odd integer.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157223				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157237				0	lv	ODD(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157250				0	lv	 Returns \<emph\>Number\</emph\> rounded to the next odd integer up, away from zero.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157270				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157283				0	lv	\<item type=\"input\"\>=ODD(1.2)\</item\> returns 3.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8746910				0	lv	\<item type=\"input\"\>=ODD(1)\</item\> returns 1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9636524				0	lv	\<item type=\"input\"\>=ODD(0)\</item\> returns 1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5675527				0	lv	\<item type=\"input\"\>=ODD(-3.1)\</item\> returns -5.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3157404				0	lv	\<bookmark_value\>FLOOR function\</bookmark_value\>\<bookmark_value\>rounding;down to nearest multiple of significance\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157404				0	lv	FLOOR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157432				0	lv	\<ahelp hid=\"HID_FUNC_UNTERGRENZE\"\>Rounds a number down to the nearest multiple of Significance.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3157451				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157464				0	lv	FLOOR(Number; Significance; Mode)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157478				0	lv	\<emph\>Number\</emph\> is the number that is to be rounded down.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157497				0	lv	\<emph\>Significance\</emph\> is the value to whose multiple the number is to be rounded down.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3157517				0	lv	\<emph\>Mode\</emph\> is an optional value. If the Mode value is given and not equal to zero, and if Number and Significance are negative, then rounding is done based on the absolute value of the number. This parameter is ignored when exporting to MS Excel as Excel does not know any third parameter.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163894				0	lv	If both parameters Number and Significance are negative, and if the Mode value is equal to zero or is not specified, then the results in $[officename] Calc and Excel will differ after exporting. If you export the spreadsheet to Excel, use Mode=1 to see the same results in Excel as in Calc.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3163932				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163945				0	lv	\<item type=\"input\"\>=FLOOR( -11;-2)\</item\> returns -12				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163966				0	lv	\<item type=\"input\"\>=FLOOR( -11;-2;0)\</item\> returns -12				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3163988				0	lv	\<item type=\"input\"\>=FLOOR( -11;-2;1)\</item\> returns -10				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164086				0	lv	\<bookmark_value\>SIGN function\</bookmark_value\>\<bookmark_value\>algebraic signs\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164086				0	lv	SIGN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164115				0	lv	\<ahelp hid=\"HID_FUNC_VORZEICHEN\"\>Returns the sign of a number. Returns 1 if the number is positive, -1 if negative and 0 if zero.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164136				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164150				0	lv	SIGN(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164164				0	lv	\<emph\>Number\</emph\> is the number whose sign is to be determined.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164183				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164197				0	lv	\<item type=\"input\"\>=SIGN(3.4)\</item\> returns 1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164212				0	lv	\<item type=\"input\"\>=SIGN(-4.5)\</item\> returns -1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164252				0	lv	\<bookmark_value\>MROUND function\</bookmark_value\>\<bookmark_value\>nearest multiple\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164252				0	lv	MROUND				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164288				0	lv	\<ahelp hid=\"HID_AAI_FUNC_MROUND\"\>Returns a number rounded to the nearest multiple of another number.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164306				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164320				0	lv	MROUND(Number; Multiple)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3486434				0	lv	Returns \<emph\>Number\</emph\> rounded to the nearest multiple of \<emph\>Multiple\</emph\>. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3068636				0	lv	An alternative implementation would be \<item type=\"literal\"\>Multiple * ROUND(Number/Multiple)\</item\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164333				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164347				0	lv	\<item type=\"input\"\>=MROUND(15.5;3)\</item\> returns 15, as 15.5 is closer to 15 (= 3*5) than to 18 (= 3*6).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_idN14DD6				0	lv	\<item type=\"input\"\>=MROUND(1.4;0.5)\</item\> returns 1.5 (= 0.5*3).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164375				0	lv	\<bookmark_value\>SQRT function\</bookmark_value\>\<bookmark_value\>square roots;positive numbers\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164375				0	lv	SQRT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164404				0	lv	\<ahelp hid=\"HID_FUNC_WURZEL\"\>Returns the positive square root of a number.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164424				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164437				0	lv	SQRT(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164451				0	lv	Returns the positive square root of \<emph\>Number\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6870021				0	lv	 Number must be positive.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164471				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164484				0	lv	\<item type=\"input\"\>=SQRT(16)\</item\> returns 4.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3591723				0	lv	\<item type=\"input\"\>=SQRT(-16)\</item\> returns an \<item type=\"literal\"\>invalid argument\</item\> error.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164560				0	lv	\<bookmark_value\>SQRTPI function\</bookmark_value\>\<bookmark_value\>square roots;products of Pi\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164560				0	lv	SQRTPI				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164596				0	lv	\<ahelp hid=\"HID_AAI_FUNC_SQRTPI\"\>Returns the square root of (PI times a number).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164614				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164627				0	lv	SQRTPI(Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1501510				0	lv	Returns the positive square root of (PI multiplied by \<emph\>Number\</emph\>).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9929197				0	lv	This is equivalent to \<item type=\"literal\"\>SQRT(PI()*Number)\</item\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164641				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164654				0	lv	\<item type=\"input\"\>=SQRTPI(2)\</item\> returns the squareroot of (2PI), approximately 2.506628.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164669				0	lv	\<bookmark_value\>random numbers; between limits\</bookmark_value\>\<bookmark_value\>RANDBETWEEN function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164669				0	lv	RANDBETWEEN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164711				0	lv	\<ahelp hid=\"HID_AAI_FUNC_RANDBETWEEN\"\>Returns an integer random number in a specified range.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164745				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164758				0	lv	RANDBETWEEN(Bottom; Top)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id7112338				0	lv	Returns an integer random number between integers \<emph\>Bottom\</emph\> and \<emph\>Top\</emph\> (both inclusive).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2855616				0	lv	This function produces a new random number each time Calc recalculates. To force Calc to recalculate manually press Shift+\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command \</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+F9.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2091433				0	lv	To generate random numbers which never recalculate, copy cells containing this function, and use \<item type=\"menuitem\"\>Edit - Paste Special\</item\> (with \<item type=\"menuitem\"\>Paste All\</item\> and \<item type=\"menuitem\"\>Formulas\</item\> not marked and \<item type=\"menuitem\"\>Numbers\</item\> marked).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164772				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164785				0	lv	\<item type=\"input\"\>=RANDBETWEEN(20;30)\</item\> returns an integer of between 20 and 30.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164800				0	lv	\<bookmark_value\>RAND function\</bookmark_value\>\<bookmark_value\>random numbers;between 0 and 1\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164800				0	lv	RAND				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164829				0	lv	\<ahelp hid=\"HID_FUNC_ZUFALLSZAHL\"\>Returns a random number between 0 and 1.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164870				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164884				0	lv	RAND()				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5092318				0	lv	This function produces a new random number each time Calc recalculates. To force Calc to recalculate manually press Shift+\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command \</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+F9.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9312417				0	lv	To generate random numbers which never recalculate, copy cells each containing =RAND(), and use \<item type=\"menuitem\"\>Edit - Paste Special\</item\> (with \<item type=\"menuitem\"\>Paste All\</item\> and \<item type=\"menuitem\"\>Formulas\</item\> not marked and \<item type=\"menuitem\"\>Numbers\</item\> marked).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id9089022				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9569078				0	lv	\<item type=\"input\"\>=RAND()\</item\> returns a random number between 0 and 1.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164897				0	lv	\<bookmark_value\>COUNTIF function\</bookmark_value\>\<bookmark_value\>counting;specified cells\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164897				0	lv	COUNTIF				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164926				0	lv	\<ahelp hid=\"HID_FUNC_ZAEHLENWENN\"\>Returns the number of cells that meet with certain criteria within a cell range.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164953				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164967				0	lv	COUNTIF(Range; Criteria)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164980				0	lv	\<emph\>Range\</emph\> is the range to which the criteria are to be applied.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165000				0	lv	\<emph\>Criteria\</emph\> indicates the criteria in the form of a number, an expression or a character string. These criteria determine which cells are counted. You may also enter a search text in the form of a regular expression, e.g. b.* for all words that begin with b. You may also indicate a cell range that contains the search criterion. If you search for literal text, enclose the text in double quotes.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165037				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166505				0	lv	A1:A10 is a cell range containing the numbers \<item type=\"input\"\>2000\</item\> to \<item type=\"input\"\>2009\</item\>. Cell B1 contains the number \<item type=\"input\"\>2006\</item\>. In cell B2, you enter a formula:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3581652				0	lv	\<item type=\"input\"\>=COUNTIF(A1:A10;2006)\</item\> - this returns 1				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id708639				0	lv	\<item type=\"input\"\>=COUNTIF(A1:A10;B1)\</item\> - this returns 1				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5169225				0	lv	\<item type=\"input\"\>=COUNTIF(A1:A10;">=2006") \</item\>- this returns 4				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id2118594				0	lv	\<item type=\"input\"\>=COUNTIF(A1:A10;"<"&B1)\</item\> - when B1 contains \<item type=\"input\"\>2006\</item\>, this returns 6				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id166020				0	lv	\<item type=\"input\"\>=COUNTIF(A1:A10;C2)\</item\> where cell C2 contains the text \<item type=\"input\"\>>2006\</item\> counts the number of cells in the range A1:A10 which are >2006 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id6386913				0	lv	To count only negative numbers: \<item type=\"input\"\>=COUNTIF(A1:A10;"<0")\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3164897K				0	lv	\<bookmark_value\>COUNTIFS function\</bookmark_value\>\<bookmark_value\>counting;specified cells\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164897K				0	lv	COUNTIFS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164926K				0	lv	\<ahelp hid=\"HID_FUNC_ZAEHLENWNRNG\"\>Count the number of cells that meet multiple criteria in multiple ranges.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3164953K				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164967K				0	lv	COUNTIFS( Reference R1 ; Criterion C1 [ ; Reference R2 ; Criterion C2 ]... )				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3164980K				0	lv	\<emph\>Reference R1\</emph\> is the  range to which the \<emph\>Criterion C1\</emph\>applies. \<emph\>Reference R2\</emph\> is the  range to which the \<emph\>Criterion C2\</emph\>applies, and so on.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165000K				0	lv	All \<emph\>Reference \</emph\> ranges shall have the same dimension and size, else an Error is returned. \<emph\>Criteria\</emph\> indicates the criteria in the form of a number, an expression or a character string. These criteria determine which cells are counted. You may also enter a search text in the form of a regular expression, e.g. b.* for all words that begin with b. You may also indicate a cell range that contains the search criterion. If you search for literal text, enclose the text in double quotes.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3165037K				0	lv	Examples:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166505K				0	lv	A1:A10 is a cell range containing the numbers \<item type=\"input\"\>2000\</item\> to \<item type=\"input\"\>2009\</item\>. B1:B10 is a cell range containing the numbers \<item type=\"input\"\>2007\</item\> to \<item type=\"input\"\>2016\</item\>:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3581652K				0	lv	\<item type=\"input\"\>=COUNTIFS(A1:A10;2006;B1:B10;2014)\</item\> - this returns 2				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5169225K				0	lv	\<item type=\"input\"\>=COUNTIFS(A1:A10;">=2006";B1:B10;">=2006") \</item\>- this returns 14				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040201.xhp	0	help	tit				0	lv	More				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040201.xhp	0	help	hd_id3148492				0	lv	\<link href=\"text/scalc/01/12040201.xhp\" name=\"More\"\>More\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040201.xhp	0	help	par_id3159400				0	lv	\<variable id=\"zusaetzetext\"\>\<ahelp hid=\"SC:MOREBUTTON:RID_SCDLG_SPEC_FILTER:BTN_MORE\"\>Shows additional filter options.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040201.xhp	0	help	hd_id3150791				0	lv	Options				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040201.xhp	0	help	hd_id3154138				0	lv	Case sensitive				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040201.xhp	0	help	par_id3147228				0	lv	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_SPEC_FILTER:BTN_CASE\"\>Distinguishes between uppercase and lowercase letters when filtering the data.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040201.xhp	0	help	hd_id3154908				0	lv	Range contains column labels				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040201.xhp	0	help	par_id3153768				0	lv	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_SPEC_FILTER:BTN_HEADER\"\>Includes the column labels in the first row of a cell range.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040201.xhp	0	help	hd_id3155306				0	lv	Copy results to				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040201.xhp	0	help	par_id3154319				0	lv	\<ahelp hid=\"SC:EDIT:RID_SCDLG_SPEC_FILTER:ED_COPY_AREA\"\>Select the check box, and then select the cell range where you want to display the filter results.\</ahelp\> You can also select a named range from the list.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040201.xhp	0	help	hd_id3145272				0	lv	Regular expression				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040201.xhp	0	help	par_id3152576				0	lv	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_SPEC_FILTER:BTN_REGEXP\"\>Allows you to use wildcards in the filter definition.\</ahelp\> For a list of the regular expressions that $[officename] supports, click \<link href=\"text/shared/01/02100001.xhp\" name=\"here\"\>here\</link\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040201.xhp	0	help	par_id3149377				0	lv	If the \<emph\>Regular Expressions\</emph\> check box is selected, you can use regular expressions in the Value field if the Condition list box is set to '=' EQUAL or '<>' UNEQUAL. This also applies to the respective cells that you reference for an advanced filter.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040201.xhp	0	help	hd_id3149958				0	lv	No duplication				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040201.xhp	0	help	par_id3153876				0	lv	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_SPEC_FILTER:BTN_UNIQUE\"\>Excludes duplicate rows in the list of filtered data.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040201.xhp	0	help	hd_id3154018				0	lv	Keep filter criteria				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040201.xhp	0	help	par_id3149123				0	lv	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_FILTER:BTN_DEST_PERS\"\>Select the \<emph\>Copy results to\</emph\> check box, and then specify the destination range where you want to display the filtered data. If this box is checked, the destination range remains linked to the source range. You must have defined the source range under \<emph\>Data - Define range\</emph\> as a database range.\</ahelp\> Following this, you can reapply the defined filter at any time as follows: click into the source range, then choose \<emph\>Data - Refresh Range\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040201.xhp	0	help	hd_id3149018				0	lv	Data range				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040201.xhp	0	help	par_id3150042				0	lv	Displays the cell range or the name of the cell range that you want to filter.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	tit				0	lv	WORKDAY				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	bm_id3149012				0	lv	\<bookmark_value\>WORKDAY function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	hd_id3149012				0	lv	\<variable id=\"workday\"\>\<link href=\"text/scalc/01/func_workday.xhp\"\>WORKDAY\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	par_id3149893				0	lv	\<ahelp hid=\"HID_AAI_FUNC_WORKDAY\"\> The result is a date number that can be formatted as a date. You then see the date of a day that is a certain number of \<emph\>workdays\</emph\> away from the \<emph\>start date\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	hd_id3146944				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	par_id3154844				0	lv	WORKDAY(StartDate; Days; Holidays)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	par_id3147469				0	lv	\<emph\>StartDate\</emph\> is the date from when the calculation is carried out. If the start date is a workday, the day is included in the calculation.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	par_id3153038				0	lv	\<emph\>Days\</emph\> is the number of workdays. Positive value for a result after the start date, negative value for a result before the start date.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	par_id3150693				0	lv	\<emph\>Holidays\</emph\> is a list of optional holidays. These are non-working days. Enter a cell range in which the holidays are listed individually.				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	hd_id3150141				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	par_id3152782				0	lv	What date came 17 workdays after 1 December 2001? Enter the start date "2001-12-01" in C3 and the number of workdays in D3. Cells F3 to J3 contain the following Christmas and New Year holidays: "2001-12-24", "2001-12-25", "2001-12-26", "2001-12-31", "2002-01-01".				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_workday.xhp	0	help	par_id3146142				0	lv	=WORKDAY(C3;D3;F3:J3) returns 2001-12-28. Format the serial date number as a date, for example in the format YYYY-MM-DD.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080300.xhp	0	help	tit				0	lv	Group				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080300.xhp	0	help	hd_id3153088				0	lv	\<link href=\"text/scalc/01/12080300.xhp\" name=\"Group\"\>Group\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080300.xhp	0	help	par_id3153821				0	lv	\<variable id=\"gruppierung\"\>\<ahelp hid=\".uno:Group\" visibility=\"visible\"\>Defines the selected cell range as a group of rows or columns.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080300.xhp	0	help	par_id3145069	3			0	lv	When you group a cell range, and outline icon appears in the margins next to the group. To hide or show the group, click the icon. To ungroup the selection, choose \<emph\>Data – Outline -\</emph\> \<link href=\"text/scalc/01/12080400.xhp\" name=\"Ungroup\"\>\<emph\>Ungroup\</emph\>\</link\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080300.xhp	0	help	hd_id3125863				0	lv	Include				20200411 15:09:53
