helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	par_id3154125				0	lv	iPos = Instr(sInput,"c")				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03120401.xhp	0	help	par_id3145173				0	lv	print iPos				20200411 15:09:53
