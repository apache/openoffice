helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3149105				0	lv	\<ahelp hid=\"HID_FUNC_ISTNV\"\>Returns TRUE if a cell contains the #N/A (value not available) error value.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id6018860				0	lv	If an error occurs, the function returns FALSE.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3152947				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3153748				0	lv	ISNA(Value)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3152884				0	lv	\<emph\>Value\</emph\> is the value or expression to be tested.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	hd_id3149964				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154852				0	lv	\<item type=\"input\"\>=ISNA(D3)\</item\> returns FALSE as a result.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	bm_id3149426				0	lv	\<bookmark_value\>ISTEXT function\</bookmark_value\>\<bookmark_value\>cell contents;text\</bookmark_value\>				20200411 15:09:53
