helpcontent2	source\text\swriter\01\05140000.xhp	0	help	par_id3154106				0	lv	Paragraph Styles				20200411 15:09:53
helpcontent2	source\text\swriter\01\05140000.xhp	0	help	par_id3149800				0	lv	\<ahelp hid=\".uno:ParaStyle\"\>Displays formatting styles for paragraphs.\</ahelp\> Use paragraph styles to apply the same \<link href=\"text/shared/00/00000005.xhp#formatierung\" name=\"formatting\"\>formatting\</link\>, such as font, numbering, and layout to the paragraphs in your document.				20200411 15:09:53
helpcontent2	source\text\swriter\01\05140000.xhp	0	help	par_id3151319				0	lv	\<image id=\"img_id3152955\" src=\"sfx2/res/styfam1.png\" width=\"0.1665in\" height=\"0.1665in\"\>\<alt id=\"alt_id3152955\"\>Icon\</alt\>\</image\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05140000.xhp	0	help	par_id3150351				0	lv	Character Styles				20200411 15:09:53
helpcontent2	source\text\swriter\01\05140000.xhp	0	help	par_id3154570				0	lv	\<ahelp hid=\".uno:CharStyle\"\>Displays formatting styles for characters.\</ahelp\> Use character styles to apply font styles to selected text in a paragraph.				20200411 15:09:53
helpcontent2	source\text\swriter\01\05140000.xhp	0	help	par_id3159194				0	lv	\<image id=\"img_id3159200\" src=\"sw/imglst/sf03.png\" width=\"0.1665in\" height=\"0.1665in\"\>\<alt id=\"alt_id3159200\"\>Icon\</alt\>\</image\>				20200411 15:09:53
