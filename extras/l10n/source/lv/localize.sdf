helpcontent2	source\text\swriter\01\06100000.xhp	0	help	hd_id072020090105453				0	lv	Ascending				20200411 15:09:53
helpcontent2	source\text\swriter\01\06100000.xhp	0	help	par_id3154270				0	lv	\<ahelp hid=\"SW:RADIOBUTTON:DLG_SORTING:RB_UP3\"\>Sorts in ascending order, (for example, 1, 2, 3 or a, b, c).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\06100000.xhp	0	help	hd_id3150708				0	lv	Descending				20200411 15:09:53
