helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3154751				0	lv	Defines the basic settings for the intended export.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3147399				0	lv	Standard HTML format				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3147088				0	lv	\<ahelp hid=\"SD:RADIOBUTTON:DLG_PUBLISHING:PAGE2_STANDARD\"\>Creates standard HTML pages from export pages.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3145071				0	lv	Standard HTML with frames				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3154824				0	lv	\<ahelp hid=\"SD:RADIOBUTTON:DLG_PUBLISHING:PAGE2_FRAMES\"\>Creates standard HTML pages with frames. The exported page will be placed in the main frame, and the frame to the left will display a table of contents in the form of hyperlinks.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3149398				0	lv	Create title page				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3152780				0	lv	\<ahelp hid=\"SD:CHECKBOX:DLG_PUBLISHING:PAGE2_CONTENT\"\>Creates a title page for your document.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3163804				0	lv	\<switchinline select=\"appl\"\>\<caseinline select=\"IMPRESS\"\>Show notes \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3157909				0	lv	\<ahelp hid=\"SD:CHECKBOX:DLG_PUBLISHING:PAGE2_NOTES\"\>Specifies that your notes are also displayed.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3156117				0	lv	Automatic				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3149233				0	lv	\<ahelp hid=\"SD:RADIOBUTTON:DLG_PUBLISHING:PAGE2_KIOSK\"\>Creates a default HTML presentation as a kiosk export, in which the slides are automatically advanced after a specified amount of time.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3155421				0	lv	As stated in document				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3150275				0	lv	\<ahelp hid=\"SD:RADIOBUTTON:DLG_PUBLISHING:PAGE2_CHG_DEFAULT\"\>The slide transition depends on the timing that you set for each slide in the presentation. If you set a manual page transition, the HTML presentation introduces a new page by pressing any key from your keyboard.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3156307				0	lv	Automatic				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3153126				0	lv	\<ahelp hid=\"SD:RADIOBUTTON:DLG_PUBLISHING:PAGE2_CHG_AUTO\"\>The page transition takes place automatically after the specified period of time elapses and does not depend on the presentation's contents\</ahelp\>.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3150503				0	lv	Slide view time				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3151245				0	lv	\<ahelp hid=\"SD:TIMEFIELD:DLG_PUBLISHING:PAGE2_DURATION_TMF\"\>Defines the amount of time for each slide display.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3154347				0	lv	Endless				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3149655				0	lv	\<ahelp hid=\"SD:CHECKBOX:DLG_PUBLISHING:PAGE2_ENDLESS\"\>Automatically restarts the HTML presentation after the last slide has been displayed.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3151054				0	lv	WebCast				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3150543				0	lv	\<ahelp hid=\"SD:RADIOBUTTON:DLG_PUBLISHING:PAGE2_WEBCAST\"\>In a WebCast export, automatic scripts will be generated with Perl or ASP support.\</ahelp\> This enables the speaker (for example, a speaker in a telephone conference using a slide show on the Internet) to change the slides in the audience's web browsers. You will find more information on \<link href=\"text/shared/autopi/01110200.xhp\" name=\"WebCast\"\>WebCast\</link\> later in this section.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3154365				0	lv	Active Server Pages (ASP)				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3148922	28			0	lv	\<ahelp hid=\"SD:RADIOBUTTON:DLG_PUBLISHING:PAGE2_ASP\"\>When you select the\<emph\> ASP \</emph\>option, the WebCast export creates ASP pages. Note that the HTML presentation can only be offered by a web server supporting ASP.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3149765				0	lv	Perl				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3145174				0	lv	\<ahelp hid=\"SD:RADIOBUTTON:DLG_PUBLISHING:PAGE2_PERL\"\>Used by WebCast export to create HTML pages and Perl scripts.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3150868				0	lv	URL for listeners				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3149203				0	lv	\<ahelp hid=\"SD:EDIT:DLG_PUBLISHING:PAGE2_INDEX\"\>Specifies the URL (absolute or relative) to be entered by the viewer in order to see the presentation.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3147228				0	lv	URL for presentation				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3156214				0	lv	\<ahelp hid=\"SD:EDIT:DLG_PUBLISHING:PAGE2_URL\"\>Specifies the URL (absolute or relative), where the created HTML presentation on the web server has been saved.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3153367				0	lv	URL for Perl scripts				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3159255				0	lv	\<ahelp hid=\"SD:EDIT:DLG_PUBLISHING:PAGE2_CGI\"\>Specifies the URL (absolute or relative) for the generated Perl scripts.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3150486				0	lv	More Information on WebCast Export				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3152578				0	lv	There are two possible options for exporting $[officename] Impress presentations using WebCast technology: Active Server Pages (ASP) and Perl.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3153364				0	lv	In either case, the WebCast needs an HTTP server offering either Perl or ASP as scripting. Therefore, the exporting option depends on the HTTP server used.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3151112				0	lv	WebCast in ASP				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3159197				0	lv	Exporting				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3146119				0	lv	To export to ASP, in a $[officename] Impress document choose \<emph\>File - Export\</emph\>. You then see the \<emph\>Export\</emph\> dialog in which you select \<emph\>HTML Document\</emph\> as the file type. Once you have selected a directory and entered a file name, click \<emph\>Export\</emph\>. For export as ASP, we recommend selecting a "secret" file name for the HTML file (see below for more details). You then see the \<emph\>HTML Export\</emph\> dialog. Several files will be written to the directory you have just selected.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3149410				0	lv	The presenter uses the entered file name to change between the slides viewed by the audience. You can save the WebCast files locally or save them directly to an HTTP server. You can later transfer locally saved files to the HTTP server by FTP. Note that WebCast only works if the files are requested over an HTTP server.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3157974				0	lv	Do not use the same directory for two different HTML exports.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3153157				0	lv	Select \<emph\>WebCast\</emph\> as a publishing type on the second page of the HTML Export Wizard.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3154790				0	lv	In the options area for WebCast, select the \<emph\>Active Server Pages (ASP)\</emph\> option. You can now continue defining other settings or start the export by clicking the \<emph\>Create\</emph\> button.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3153281				0	lv	Using ASP WebCast				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3149910				0	lv	You can use WebCast as soon as the exported files can be accessed from an HTTP server.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3154503				0	lv	\<emph\>Example\</emph\>:				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3152375				0	lv	Let's assume that you installed the Microsoft Internet Information Server on your computer. You entered the "c:\\Inet\\wwwroot\\presentation" directory as an HTML output directory during the IIS setup. The URL of your computer is assumed as follows: "http://myserver.com".				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3150715				0	lv	You have saved the files that have been created during the Export process in the c:\\Inet\\wwwroot\\presentation\\ directory. In this directory, the Export creates an HTML file that can be named, for example, as "secret.htm". You entered this name in the Save dialog (see above). The presenter can now browse to the HTML Export files by entering the http://myserver.com/presentation/secret.htm URL in any HTTP Browser having JavaScript support. The presenter is now able to modify the page using some form controls.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3159110				0	lv	The audience can now view the slide selected by the presenter through the URL http://myserver.com/presentation/webcast.asp. They cannot move to other slides found at this URL, unless the file names are known. Please ensure that the HTTP server does not show the directory listing.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3153732				0	lv	WebCast over Perl				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3152999				0	lv	Exporting				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3146972				0	lv	To export, in a $[officename] Impress document choose \<emph\>File - Export\</emph\>. This opens the \<emph\>Export\</emph\> dialog, in which you select \<emph\>HTML Document\</emph\> as the file type. After selecting a folder and entering a file name, click \<emph\>Save\</emph\>. This opens the \<emph\>HTML Export Wizard\</emph\>. This will write some files to the folder you have just selected.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3156362				0	lv	The entered file name will be used by the presenter to switch through the slides. Please select an empty directory.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3148432				0	lv	In the second page of the HTML Export, select \<emph\>WebCast\</emph\> as the publication type.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3149018				0	lv	In the option area for WebCast, select \<emph\>Perl\</emph\>.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3154509				0	lv	In the \<emph\>URL for listeners\</emph\> text box, enter the file name of the HTML document that will be used by the audience. In \<emph\>URL for presentation\</emph\>, enter the URL of the directory that will be used for the presentation and, in \<emph\>URL for Perl scripts\</emph\>, enter the URL for the CGI script directory. You can now define further settings on the following pages of the Wizard or start the export process by clicking the \<emph\>Create\</emph\> button.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	hd_id3148996				0	lv	Using Perl WebCast				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3159268				0	lv	The files that have been created during the export must now be set up in the Perl enabled HTTP server. This cannot be done automatically because of the variety of different HTTP servers having Perl support. The steps to follow will be described next. Please refer to your server manual or ask your network administrator how to apply these steps on your server.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3147340				0	lv	You should first move the files that have been created during the export into the correct directory on the HTTP server.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3155936				0	lv	Move all files having the htm, jpg and gif extensions into the directory on your HTTP server that has been referred to in the text box \<emph\>URL for presentation\</emph\>.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3151014				0	lv	All files having the pl and txt extensions have to be moved into the directory on your HTTP server that has been referred to in the \<emph\>URL for Perl scripts\</emph\> text box. This directory has to be configured in a way that the Perl scripts contained there can also be run by an HTTP request.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3151250				0	lv	On UNIX systems grant the files with the pl extension the rights to be executable by the HTTP server. Normally, this is done with the chmod command. The rights of the currpic.txt file must be set to be writable by the HTTP server.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3153534				0	lv	Now you should be able to use WebCast.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3156711	66			0	lv	\<emph\>Example\</emph\>:				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3147313				0	lv	In this example, you have a Linux computer with an HTTP server. The URL of your HTTP server is http://myserver.com and the output directory of your HTML documents is the //user/local/http/ directory. Your Perl scripts are contained in the //user/local/http/cgi-bin/ directory. Enter secret.htm as an export file name and presentation.htm as \<emph\>URL for listeners\</emph\>. In the \<emph\>URL for presentation\</emph\> text box enter http://myserver.com/presentation/ and for the \<emph\>URL for Perl scripts\</emph\> enter http://myserver.com/cgi-bin/.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3145792				0	lv	Now, copy all *.htm, *.jpg and *.gif files from the directories that were specified during the export into the //user/local/http/presentation/ directory on your HTTP Server and copy all files with the *.pl and *.txt extensions into the //user/local/http/cgi-bin/ directory.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3153920				0	lv	Login on your server as root and switch to the //user/local/http/cgi-bin/ directory. You can define the corresponding rights using the chmod command.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110200.xhp	0	help	par_id3148479				0	lv	Once you have finished installing the Perl files, the presenter will be able to give the presentation. The listeners can view this presentation under the URL http://myserver.com/presentation/presentation.htm.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01090600.xhp	0	help	tit				0	lv	Form Wizard - Set Name				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01090600.xhp	0	help	par_idN10543				0	lv	\<link href=\"text/shared/autopi/01090600.xhp\"\>Form Wizard - Set Name\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01090600.xhp	0	help	par_idN10553				0	lv	\<ahelp hid=\".\"\>Specifies the name of the form and how to proceed.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01090600.xhp	0	help	par_idN10556				0	lv	Name of the form				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01090600.xhp	0	help	par_idN1055A				0	lv	\<ahelp hid=\".\"\>Specifies the name of the form.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01090600.xhp	0	help	par_idN1055D				0	lv	Work with the form				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01090600.xhp	0	help	par_idN105C5				0	lv	\<ahelp hid=\".\"\>Saves the form, and opens it as a form document to enter and display data.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01090600.xhp	0	help	par_idN10563				0	lv	Modify the form				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01090600.xhp	0	help	par_idN105D2				0	lv	\<ahelp hid=\".\"\>Saves the form, and opens it in edit mode to change the layout.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01090600.xhp	0	help	par_idN10569				0	lv	\<link href=\"text/shared/autopi/01090000.xhp\" name=\"Form Wizard\"\>Form Wizard\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01040000.xhp	0	help	tit				0	lv	Agenda Wizard				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01040000.xhp	0	help	bm_id3149031				0	lv	\<bookmark_value\>wizards;agendas\</bookmark_value\>\<bookmark_value\>Agenda Wizard\</bookmark_value\>\<bookmark_value\>templates;agendas\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01040000.xhp	0	help	hd_id3149031				0	lv	Agenda Wizard				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01040000.xhp	0	help	par_id3147102				0	lv	\<variable id=\"agenda\"\>\<ahelp hid=\".uno:AutoPilotAgenda\"\>Starts the wizard to help you create an agenda template.\</ahelp\>\</variable\> You can use an agenda to specify discussion topics for conferences and meetings.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01040000.xhp	0	help	par_id3156414				0	lv	$[officename] comes with a sample template for agendas that you can modify to suit your own needs. The wizard offers numerous layout and design options for creating document templates. The preview gives you an impression of how the finished agenda will appear.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01040000.xhp	0	help	par_id3147571				0	lv	Within the wizard, you can modify your entries at any time. You may also skip an entire page or even all the pages, in which case the current (or default) settings remain in effect.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01040000.xhp	0	help	hd_id3147088				0	lv	Back				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01040000.xhp	0	help	par_id3149177				0	lv	Returns to the selections made on the previous page. The current settings remain in effect. This button only becomes active after the first page.				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01040000.xhp	0	help	hd_id3155391				0	lv	Next				20200411 15:09:53
