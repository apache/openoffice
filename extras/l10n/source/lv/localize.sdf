helpcontent2	source\text\scalc\01\04090000.xhp	0	help	hd_id3145785				0	lv	\<link href=\"text/scalc/01/04090000.xhp\" name=\"External Data\"\>Link to External Data\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04090000.xhp	0	help	par_id3149262				0	lv	\<ahelp hid=\".uno:InsertExternalDataSourc\"\>Inserts data from an HTML, Calc, or Excel file into the current sheet as a link. The data must be located within a named range.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04090000.xhp	0	help	hd_id3146984				0	lv	URL of external data source.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04090000.xhp	0	help	par_id3145366				0	lv	\<ahelp hid=\"HID_SCDLG_LINKAREAURL\"\>Enter the URL or the file name that contains the data that you want to insert, and then press Enter.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04090000.xhp	0	help	hd_id3145251				0	lv	Available tables/ranges				20200411 15:09:53
helpcontent2	source\text\scalc\01\04090000.xhp	0	help	par_id3147397				0	lv	\<ahelp hid=\"SC_MULTILISTBOX_RID_SCDLG_LINKAREA_LB_RANGES\"\>Select the table or the data range that you want to insert.\</ahelp\>				20200411 15:09:53
