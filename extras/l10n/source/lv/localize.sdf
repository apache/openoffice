helpcontent2	source\text\swriter\01\06100000.xhp	0	help	hd_id3149812				0	lv	Direction				20200411 15:09:53
helpcontent2	source\text\swriter\01\06100000.xhp	0	help	hd_id3153540				0	lv	Columns				20200411 15:09:53
