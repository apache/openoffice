helpcontent2	source\text\sbasic\shared\03060600.xhp	0	help	par_id3153144				0	lv	vOut = vA > vB Xor vB > vD REM returns -1				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03060600.xhp	0	help	par_id3154944				0	lv	vOut = (vB > vD Xor vB > vA) REM returns 0				20200411 15:09:53
