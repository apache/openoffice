helpcontent2	source\text\smath\04\01020000.xhp	0	help	hd_id3155620				0	lv	Shift+F3				20200411 15:09:53
helpcontent2	source\text\smath\04\01020000.xhp	0	help	par_id3149355				0	lv	Previous Error				20200411 15:09:53
