helpcontent2	source\text\shared\01\05030800.xhp	0	help	tit				0	lv	Crop				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	bm_id3148585				0	lv	\<bookmark_value\>cropping pictures\</bookmark_value\>\<bookmark_value\>pictures; cropping and zooming\</bookmark_value\>\<bookmark_value\>zooming; pictures\</bookmark_value\>\<bookmark_value\>scaling;pictures\</bookmark_value\>\<bookmark_value\>sizes; pictures\</bookmark_value\>\<bookmark_value\>original size;restoring after cropping\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3154044				0	lv	\<link href=\"text/shared/01/05030800.xhp\" name=\"Crop\"\>Crop\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3150603				0	lv	\<ahelp hid=\".\"\>Trims or scales the selected graphic. You can also restore the graphic to its original size.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3148585				0	lv	Crop				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3152372				0	lv	Use this area to trim or scale the selected graphic, or to add white space around the graphic.				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3145669				0	lv	Keep scale				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3149346				0	lv	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_GRFCROP_RB_ZOOMCONST\"\>Maintains the original scale of the graphic when you crop, so that only the size of the graphic changes.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3156426				0	lv	Keep image size				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3155892				0	lv	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_GRFCROP_RB_SIZECONST\"\>Maintains the original size of the graphic when you crop, so that only the scale of the graphic changes. To reduce the scale of the graphic, select this option and enter negative values in the cropping boxes. To increase the scale of the graphic, enter positive values in the cropping boxes.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3153683				0	lv	Left				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3145313				0	lv	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_LEFT\"\>If the \<emph\>Keep Scale\</emph\> option is selected, enter a positive amount to trim the left edge of the graphic, or a negative amount to add white space to the left of the graphic. If the \<emph\>Keep image size\</emph\> option is selected, enter a positive amount to increase the horizontal scale of the graphic, or a negative amount to decrease the horizontal scale of the graphic.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3163803				0	lv	Right				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3145382				0	lv	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_RIGHT\"\>If the \<emph\>Keep Scale\</emph\> option is selected, enter a positive amount to trim the right edge of the graphic, or a negative amount to add white space to the right of the graphic. If the \<emph\>Keep image size\</emph\> option is selected, enter a positive amount to increase the horizontal scale of the graphic, or a negative amount to decrease the horizontal scale of the graphic.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3156153				0	lv	Top				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3154514				0	lv	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_TOP\"\>If the \<emph\>Keep Scale\</emph\> option is selected, enter a positive amount to trim the top of the graphic, or a negative amount to add white space above the graphic. If the \<emph\>Keep image size\</emph\> option is selected, enter a positive amount to increase the vertical scale of the graphic, or a negative amount to decrease the vertical scale of the graphic.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3149956				0	lv	Bottom				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3150084				0	lv	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_BOTTOM\"\>If the \<emph\>Keep Scale\</emph\> option is selected, enter a positive amount to trim the bottom of the graphic, or a negative amount to add white space below the graphic. If the \<emph\>Keep image size\</emph\> option is selected, enter a positive amount to increase the vertical scale of the graphic, or a negative amount to decrease the vertical scale of the graphic.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3158432				0	lv	Scale				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3153257				0	lv	Changes the scale of the selected graphic.				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3155504				0	lv	Width				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3148943				0	lv	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_WIDTHZOOM\"\>Enter the width for the selected graphic as a percentage.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3145609				0	lv	Height				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3154348				0	lv	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRFCROP_MF_HEIGHTZOOM\"\>Enter the height of the selected graphic as a percentage.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	hd_id3154924				0	lv	Image size				20200411 15:09:53
helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3148755				0	lv	Changes the size of the selected graphic.				20200411 15:09:53
