helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150121				0	lv	LOWER("Text")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153910	91			0	lv	            \<emph\>Text\</emph\> refers to the text to be converted.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3159343				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155329	93			0	lv	            \<item type=\"input\"\>=LOWER("Sun")\</item\> returns sun.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3154589				0	lv	\<bookmark_value\>MID function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3154589				0	lv	MID				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154938				0	lv	\<ahelp hid=\"HID_FUNC_TEIL\"\>Returns a text string of a text. The parameters specify the starting position and the number of characters.\</ahelp\>				20200411 15:09:53
