helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	hd_id9996948				0	lv	Non-breaking space				20200411 15:09:53
helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	par_id8326975				0	lv	\<ahelp hid=\".\"\>Inserts a space that will keep bordering characters together on line breaks.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	hd_id6383556				0	lv	Non-breaking hyphen				20200411 15:09:53
helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	par_id8469191				0	lv	\<ahelp hid=\".\"\>Inserts a hyphen that will keep bordering characters together on line breaks.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	hd_id3306680				0	lv	Optional hyphen				20200411 15:09:53
helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	par_id9407330				0	lv	\<ahelp hid=\".\"\>Inserts an invisible hyphen within a word that will appear and create a line break once it becomes the last character in a line.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	hd_id2295907				0	lv	No-width optional break				20200411 15:09:53
helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	par_id1536301				0	lv	\<ahelp hid=\".\"\>Inserts an invisible space within a word that will insert a line break once it becomes the last character in a line. Available when complex text layout (CTL) is enabled.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	hd_id3245643				0	lv	No-width no break				20200411 15:09:53
helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	par_id1085238				0	lv	\<ahelp hid=\".\"\>Inserts an invisible space within a word that will keep the word together at the end of a line. Available when complex text layout (CTL) is enabled.\</ahelp\>				20200411 15:09:53
