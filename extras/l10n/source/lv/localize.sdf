helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id0907200904022538				0	lv	\<ahelp hid=\".\"\>Converts a code number into a Unicode character or letter.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id0907200904123753				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id0907200904123753				0	lv	UNICHAR(number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id0907200904123720				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id090720090412378				0	lv	=UNICHAR(169) returns the Copyright character \<emph\>©\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id0907200904033543				0	lv	\<bookmark_value\>UNICODE function\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id0907200904022588				0	lv	UNICODE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id0907200904022594				0	lv	\<ahelp hid=\".\"\>Returns the numeric code for the first Unicode character in a text string.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id0907200904123874				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id0907200904123846				0	lv	UNICODE("Text")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id0907200904123899				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id0907200904123919				0	lv	=UNICODE("©") returns the Unicode number 169 for the Copyright character.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3145178				0	lv	\<bookmark_value\>UPPER function\</bookmark_value\>				20200411 15:09:53
