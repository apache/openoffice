helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153573				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154260				0	lv	PROPER("Text")				20200411 15:09:53
