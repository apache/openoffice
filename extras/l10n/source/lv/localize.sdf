helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3151175				0	lv	TTEST(Data1; Data2; Mode; Type)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149202	111			0	lv	            \<emph\>Data1\</emph\> is the dependent array or range of data for the first record.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3145666	112			0	lv	            \<emph\>Data2\</emph\> is the dependent array or range of data for the second record.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153903	113			0	lv	            \<emph\>Mode\</emph\> = 1 calculates the one-tailed test, \<emph\>Mode\</emph\> = 2 the two- tailed test.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3155327	114			0	lv	            \<emph\>Type\</emph\> is the kind of t-test to perform. Type 1 means paired. Type 2 means two samples, equal variance (homoscedastic). Type 3 means two samples, unequal variance (heteroscedastic).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3159342				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150119	116			0	lv	            \<item type=\"input\"\>=TTEST(A1:A50;B1:B50;2;2)\</item\>         				20200411 15:09:53
