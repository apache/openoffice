helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3153764				0	lv	If sValue <> "." and sValue <> ".." Then				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3155766				0	lv	if (GetAttr( sPath + getPathSeparator + sValue) AND 16) >0 then				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3154253				0	lv	REM get the directories				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3159264				0	lv	sDir = sDir & chr(13) & sValue				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_id3145148				0	lv	End If				20200411 15:09:53
helpcontent2	source\text\sbasic\shared\03020404.xhp	0	help	par_idN10700				0	lv	End If				20200411 15:09:53
