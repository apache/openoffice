helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3154532				0	lv	SMALL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3157981				0	lv	\<ahelp hid=\"HID_FUNC_KKLEINSTE\"\>Returns the Rank_c-th smallest value in a data set.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3154957				0	lv	Syntax				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3153974				0	lv	SMALL(Data; RankC)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154540				0	lv	\<emph\>Data\</emph\> is the cell range of data.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155094				0	lv	\<emph\>RankC\</emph\> is the rank of the value.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3153247				0	lv	Example				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149897				0	lv	\<item type=\"input\"\>=SMALL(A1:C50;2)\</item\> gives the second smallest value in A1:C50.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3153559				0	lv	\<bookmark_value\>CONFIDENCE function\</bookmark_value\>				20200411 15:09:53
