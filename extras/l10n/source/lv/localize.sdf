helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150526				0	lv	MID("Text"; Start; Number)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148820	152			0	lv	            \<emph\>Text\</emph\> is the text containing the characters to extract.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150774	153			0	lv	            \<emph\>Start\</emph\> is the position of the first character in the text to extract.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153063	154			0	lv	            \<emph\>Number\</emph\> specifies the number of characters in the part of the text.				20200411 15:09:53
