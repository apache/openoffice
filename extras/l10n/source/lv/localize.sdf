helpcontent2	source\text\swriter\01\05140000.xhp	0	help	par_id3146333				0	lv	\<ahelp hid=\"HID_TEMPLDLG_UPDATEBYEXAMPLE\"\>The manually formatted attributes of the text at the cursor position in the document will be added to the style that is selected in the Styles and Formatting window.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05140000.xhp	0	help	par_idN10A31				0	lv	Load style				20200411 15:09:53
helpcontent2	source\text\swriter\01\05140000.xhp	0	help	par_idN10A36				0	lv	\<ahelp hid=\".\"\>Opens the Load Styles dialog to import styles from another document.\</ahelp\>				20200411 15:09:53
