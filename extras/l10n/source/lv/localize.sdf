helpcontent2	source\text\shared\01\02210101.xhp	0	help	hd_id3150347				0	lv	\<link href=\"text/shared/01/02210101.xhp\" name=\"Floating Frame Properties\"\>Floating Frame Properties\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02210101.xhp	0	help	par_id3149031				0	lv	\<ahelp hid=\"SFX2:TABPAGE:TP_FRAMEPROPERTIES\"\>Changes the properties of the selected floating frame. Floating frames work best when they contain an html document, and when they are inserted in another html document.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02210101.xhp	0	help	hd_id3155364				0	lv	Name				20200411 15:09:53
helpcontent2	source\text\shared\01\02210101.xhp	0	help	par_id3149511				0	lv	\<ahelp hid=\"SFX2:EDIT:TP_FRAMEPROPERTIES:ED_FRAMENAME\"\>Enter a name for the floating frame. The name cannot contain spaces, special characters, or begin with an underscore ( _ ).\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02210101.xhp	0	help	hd_id3150789				0	lv	Contents				20200411 15:09:53
helpcontent2	source\text\shared\01\02210101.xhp	0	help	par_id3156414				0	lv	\<ahelp hid=\"SFX2:EDIT:TP_FRAMEPROPERTIES:ED_URL\"\>Enter the path and the name of the file that you want to display in the floating frame. You can also click the \<emph\>...\</emph\> button and locate the file that you want to display.\</ahelp\> For example, you can enter:				20200411 15:09:53
helpcontent2	source\text\shared\01\02210101.xhp	0	help	par_id3147399				0	lv	http://www.example.com				20200411 15:09:53
