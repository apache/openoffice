helpcontent2	source\text\shared\02\02170000.xhp	0	help	par_id3149140				0	zh-CN	\<variable id=\"hintergrundfarbetext\"\>\<ahelp hid=\".\"\>点击打开工具栏，可以在工具栏中为段落设置背景颜色。颜色被应用到当前段落或所选定的段落上。\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\02\02170000.xhp	0	help	par_id3147276				0	zh-CN	\<image id=\"img_id3148538\" src=\"res/commandimagelist/sc_backgroundcolor.png\"\>\<alt id=\"alt_id3148538\" xml-lang=\"zh-CN\"\>图标\</alt\>\</image\>				20200411 15:09:53
