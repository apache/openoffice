helpcontent2	source\text\schart\01\wiz_chart_type.xhp	0	help	par_id9930722				0	zh-CN	\<ahelp hid=\".\" visibility=\"hidden\"\>显示折线图表的堆叠序列。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\wiz_chart_type.xhp	0	help	par_id5749687				0	zh-CN	\<ahelp hid=\".\" visibility=\"hidden\"\>堆叠序列显示彼此的累加值。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\wiz_chart_type.xhp	0	help	par_id79348				0	zh-CN	\<ahelp hid=\".\" visibility=\"hidden\"\>堆叠序列显示为百分比值。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\wiz_chart_type.xhp	0	help	par_id2414014				0	zh-CN	\<ahelp hid=\".\" visibility=\"hidden\"\>线条显示为曲线。\</ahelp\>				20200411 15:09:53
