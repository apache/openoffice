helpcontent2	source\text\swriter\01\03080000.xhp	0	help	par_id3147513	2			0	fr	\<ahelp hid=\".uno:Marks\"\>Affiche ou masque les trames de fond des champs dans le document, notamment les espaces insécables, les tirets utilisateur, les index et les notes de bas de page.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\swriter\01\03080000.xhp	0	help	par_id3153540	17			0	fr	\<link href=\"text/swriter/01/03100000.xhp\" name=\"Afficher/masquer les caractères non imprimables\"\>Afficher/masquer les caractères non imprimables\</link\>				20130618 17:22:18
