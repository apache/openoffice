helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id3151348				0	fr	\<bookmark_value\>INVERSEMAT, fonction\</bookmark_value\>\<bookmark_value\>Matrices inverses\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3151348	39			0	fr	INVERSEMAT				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3145569	40			0	fr	\<ahelp hid=\"HID_FUNC_MINV\"\>Renvoie la matrice inverse.\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3156072	41			0	fr	Syntaxe				20130618 17:22:18
