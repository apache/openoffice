helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144906	409			0	fr	\<ahelp hid=\"HID_FUNC_SIN\"\>Renvoie le sinus du nombre donné (angle).\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144923	410			0	fr	Syntaxe				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144937	411			0	fr	SIN(nombre)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144950	412			0	fr	Renvoie le sinus (trigonométrique) de \<emph\>nombre\</emph\>, l'angle est en radians.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id8079470				0	fr	Pour renvoyer le sinus d'un angle en degrés, utilisez la fonction RADIANS.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3144969	413			0	fr	Exemple				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144983	414			0	fr	\<item type=\"input\"\>=SIN(PI()/2)\</item\> renvoie 1, le sinus de PI/2 radians.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3916440				0	fr	\<item type=\"input\"\>=SIN(RADIANS(30))\</item\> renvoie 0,5, le sinus de 30 degrés.				20130618 17:22:18
