helpcontent2	source\text\shared\01\05020301.xhp	0	help	par_id3147264	24			0	fr	15.000 pour 15000				20130618 17:22:18
helpcontent2	source\text\shared\01\05020301.xhp	0	help	par_id3151223	25			0	fr	# ###				20130618 17:22:18
