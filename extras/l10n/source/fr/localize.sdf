helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3146009	150			0	fr	LOGREG				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3146037	151			0	fr	\<ahelp hid=\"HID_FUNC_RKP\"\>Cette fonction calcule l'ajustement des données saisies sous forme de courbe de régression exponentielle (y=b*m^x).\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3146056	152			0	fr	Syntaxe				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163123	153			0	fr	LOGREG(données_Y;données_X;type_fonction;stats)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163137	154			0	fr	\<emph\>données_Y\</emph\> représente la matrice de données Y.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163155	155			0	fr	\<emph\>données_X\</emph\> (facultatif) représente la matrice de données X.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163174	156			0	fr	\<emph\>type_fonction\</emph\> (facultatif). Si type_fonction = 0, les fonctions de la forme y = m^x seront calculées. Sinon, les fonctions y = b*m^x seront calculées.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163196	157			0	fr	\<emph\>stats\</emph\> (facultatif). Si stats=0, seul le coefficient de régression est calculé.				20130618 17:22:18
