helpcontent2	source\text\schart\01\type_stock.xhp	0	help	par_id8982207				0	fr	1000				20130618 17:22:18
helpcontent2	source\text\schart\01\type_stock.xhp	0	help	par_id7074190				0	fr	15				20130618 17:22:18
