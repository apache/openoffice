helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id5081637				0	fr	On obtiendra le même résultat en utilisant l'opérateur d'exposant ^ :				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id9759514				0	fr	\<item type=\"literal\"\>base^exposant\</item\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3159580	356			0	fr	Exemple				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3159594	357			0	fr	\<item type=\"input\"\>=PUISSANCE(4;3)\</item\> renvoie 64, qui correspond à 4 à la puissance 3.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id1614429				0	fr	=4^3 renvoie aussi 4 à la puissance 3.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3152651				0	fr	\<bookmark_value\>SOMME.SERIES, fonction\</bookmark_value\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152651	642			0	fr	SOMME.SERIES				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152688	643			0	fr	\<ahelp hid=\".\"\>Additionne les premiers termes d'une série de puissances\</ahelp\>				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152708	644			0	fr	SOMME.SERIES(x;n;m;coefficients) = coefficient_1*x^n + coefficient_2*x^(n+m) + coefficient_3*x^(n+2m) +...+ coefficient_i*x^(n+(i-1)m)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	hd_id3152724	645			0	fr	Syntaxe				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_idN11BD9				0	fr	SOMME.SERIES(x;n;m;coefficients)				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3152737	646			0	fr	\<emph\>x\</emph\> est la valeur de saisie de la série de puissances.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144344	647			0	fr	\<emph\>n\</emph\> est la puissance initiale				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144357	648			0	fr	\<emph\>m\</emph\> est l'incrément pour augmenter n				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3144370	649			0	fr	\<emph\>coefficients\</emph\> est une série de coefficients. Pour chaque coefficient, la somme des séries est étendue d'une section.				20130618 17:22:18
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	bm_id3144386				0	fr	\<bookmark_value\>PRODUIT, fonction\</bookmark_value\>\<bookmark_value\>Nombres;multiplication\</bookmark_value\>\<bookmark_value\>Multiplication;nombres\</bookmark_value\>				20130618 17:22:18
