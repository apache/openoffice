helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id7576525				0	fr	Format				20130618 17:22:18
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id641193				0	fr	Signification				20130618 17:22:18
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3150039	23			0	fr	Page				20130618 17:22:18
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3153134	24			0	fr	Insère le numéro de la page qui contient la cible de la référence.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3150681	27			0	fr	Texte de référence				20130618 17:22:18
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3154040	28			0	fr	Insère la référence complète du texte cible. Pour les notes de bas de page, le numéro de la note de bas de page est inséré.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3149972	29			0	fr	Supra/infra				20130618 17:22:18
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3149619	30			0	fr	Insère "au-dessus" ou "en dessous" selon la position de la cible de la référence par rapport à la position du renvoi.				20130618 17:22:18
helpcontent2	source\text\swriter\01\04090002.xhp	0	help	par_id3148705	31			0	fr	D'après le style de page				20130618 17:22:18
