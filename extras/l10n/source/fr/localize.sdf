helpcontent2	source\text\swriter\guide\shortcut_writing.xhp	0	help	hd_id3149689	1			0	fr	\<variable id=\"shortcut_writing\"\>\<link href=\"text/swriter/guide/shortcut_writing.xhp\" name=\"Application d'un formatage de texte pendant la saisie\"\>Application d'un formatage de texte pendant la saisie\</link\>\</variable\>				20130618 17:22:18
