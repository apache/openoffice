helpcontent2	source\text\swriter\01\04070000.xhp	0	help	par_id3149289				0	mk	\<variable id=\"briefum\"\>\<ahelp hid=\".uno:InsertEnvelope\"\>Креира плик.\</ahelp\> На трите страници можете да го наведете испраќачот и примачот,позицијата и форматот на двете адреси, големината на пликот, и насоката на пликот. \</variable\>				2002-02-02 02:02:02
