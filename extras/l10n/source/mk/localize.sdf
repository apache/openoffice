helpcontent2	source\text\swriter\02\19020000.xhp	0	help	par_id3148768				0	mk	\<ahelp hid=\"FN_INSERT_FOOTER\"\>Го прикажува подножјето на HTML-документот ако подножјата се оневозможени во ливчето \<link href=\"text/shared/01/05040400.xhp\" name=\"Format - Page - Footer\"\>\<emph\>Формат - Страница - Подножје\</emph\>\</link\>.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\19030000.xhp	0	help	tit				0	mk	Вметни				2002-02-02 02:02:02
