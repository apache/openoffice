helpcontent2	source\text\shared\explorer\database\11090000.xhp	0	help	par_id3149164				0	dz	\<ahelp hid=\".\" visibility=\"hidden\"\>གནད་སྡུད་ཚུའི་རྗེས་ལམ་དག་པ་ཅིག་བསྒྱུར་བཅོས་འབད་ཡོད་མི་ས་སྒོ་ཚུ་ལུ་ཐོན་རིམ་གྱི་གྲངས་འགན་སྤྲོད་འབད་ཐོག་ལས་དྲན་ཐོ་རེ་ལུ་བསྒྱུར་བཅོས་འབདཝ་ཨིན། ཨ་ནི་ཨང་གྲངས་འདི་ས་སྒོ་བསྒྱུར་བཅོས་འབད་བའི་སྐབས་དུས་ཚོད་རེ་ལུ་༡གིས་ཡར་འཕར་འབདཝ་ཨིན། གནད་སྡུད་གཞི་རྟེན་ཐིག་ཁྲམ་ནང་དྲན་ཐོ་གི་ནང་འཁོད་ཀྱི་ཐོན་རིམ་གྱི་གྲངས་བཀྲམ་སྟོན་འབདཝ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
