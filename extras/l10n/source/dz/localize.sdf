helpcontent2	source\text\shared\explorer\database\02010100.xhp	0	help	par_id3157312				0	dz	འདྲི་དཔྱད་འདི་གསར་བསྐྲུན་འབད་ནི་ལུ་ འགྱུར་ཅན་ཚད་བཟུང་ཚུ་དང་བཅས་  འདྲི་དཔྱད་འདི་གསར་བསྐྲུན་འབད་ནི་ལུ་  ཁྱོད་ཀྱིས་ གྲུ་བཞི་གུག་ཤད་(=[x]) བར་ན་  འགྱུར་ཅན་ཚུ་བཙུགས་དགོ།   ཁྱོད་ཀྱིས་ཐབས་གཞན་གྱི་ཐོག་ལས་  ཀོ་ལཱོན་ (=:x)གིས་རྗེས་སུ་གྲངས་པའི་ མཉམ་པའི་མིང་རྟགས་འདི་ལག་ལེན་འཐབ།  འདྲི་དཔྱད་འདི་ལག་ལེན་འཐབ་པའི་བསྒང་ འགྱུར་ཅན་ཨེགསི་འདི་འགན་སྤྲོད་འབད་དགོ་ཟེར་བའི་  གསལ་བརྗོད་ཀྱི་དོན་ལུ་ ལས་རིམ་གིས་ ཌའི་ལོག་ཅིག་འདྲི་མི་འདི་བཀྲམ་སྟོན་འབད་འོང་། 				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\02010100.xhp	0	help	par_id3150818				0	dz	ཁྱོད་ཀྱིས་ དུས་ཡུན་གཅིག་ལུ་ ཚད་བཟུང་འདི་སྣ་མང་འདྲི་དཔྱད་འབད་བ་ཅིན་  ཚད་བཟུང་ཚུ་ཆ་མཉམ་ཡོད་མི་ཌའི་ལོག་ནང་  ཁྱོད་ཀྱིས་ཡིག་ཐོ་ས་སྒོ་དང་  རེ་རེ་གི་སྦོ་ལོག་ཁར་  ཨིན་པུཊི་གྲལ་ཐིག་འདི་ མཐོངམ་ཨིན།  གནས་གོང་འདི་མགོ་ལས་མཇུག་ཚུན་བཙུགས་ནི་དང་  གྲལ་ཐིག་རེ་རེ་གི་ཤུལ་ལས་ ཐོ་བཀོད་ལྡེ་མིག་འདི་ ཨེབ་གཏང་།				2002-02-02 02:02:02
