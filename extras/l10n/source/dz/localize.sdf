helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3148664				0	dz	\<variable id=\"tabelletext\"\>\<ahelp hid=\".uno:Protect\"\> ད་ལྟོའི་ཤོག་ལེབ་ནང་ལུ་ ནང་ཐིག་ཚུ་ ལེགས་བཅོས་འབད་ནི་ལས་ ཉེན་སྐྱོ་འབདཝ་ཨིན། \</ahelp\>\</variable\> ཁྱོད་ཀྱིས་ \<emph\> ཆོག་ཡིག་དང་བཅསཔ་སྦེ་ ཡང་ན་ ཆོག་ཡིག་མེདཔ་སྦེ་ \</emph\> ཤོག་ལེབ་ཉེན་སྐྱོབ་གསལ་བཀོད་འབད་ཚུགས་པའི་ \<emph\> ཤོག་ལེབ་ཉེན་སྐྱོབ་ཌའི་ལོག་ཁ་ཕྱེ་ནིའི་དོན་ལུ་ \</emph\> ལག་ཆས་ཚུ་-ཡིག་ཆ་ཉེན་སྐྱོབ་འབད་-ཤོག་ལེབ་ཚུ་གདམ།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3149664				0	dz	ནང་ཐིག་ཚུ་ཧེང་སྐལ་ཞུན་དག་འབད་ནི་ལས་ཉེན་སྐྱོབ་འབད་ནིའི་དོན་ལུ་ \<emph\> རྩ་སྒྲིག་-ནང་ཐིག་ཚུ་- ནང་ཐིག་ཉེན་སྐྱོབ་ \</emph\> \<link href=\"text/scalc/01/05020600.xhp\" name=\"Format - Cells - Cell Protection\"\>\<emph\> མཆོང་ལྡེ་ ཡང་ན་ \</emph\>\</link\> རྩ་སྒྲིག་ནང་དིག་ཚུ་ \<emph\> སྐབས་དོན་དཀར་ཆག་གུ་ལུ་ \</emph\> ཉེན་སྐྱོབ་འབད་ཡོདཔ་པའི་ཞིབ་དཔྱད་སྒྲོམ་དེ་ཞིབ་དཔྱད་འབད་དགོཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3154490	8			0	dz	ཉེན་སྐྱོབ་འབད་ཡོད་པའི་ཤོག་ལེབ་གུ་ལུ་ ཉེན་སྐྱོབ་མ་འབད་བའི་ནང་ཐིག་ཚུའམ་ ཁྱབ་ཚད་ཚུ་  \<emph\> ལག་ཆས་ཚུ་ - ཡིག་ཆ་ཉེན་སྐྱོབ་འབད་ - ཤོག་ལེབ་ \</emph\> དང་ \<emph\> རྩ་སྒྲིག་ - ནང་ཐིག་ཚུ་ - ནང་ཐིག་ཉེན་སྐྱོབ་ \</emph\> དཀར་ཆག་ཚུ་ལག་ལེན་ཐོག་ལས་ གཞི་སྒྲིག་འབད་ཚུགསཔ་ཨིན།: 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3149123				0	dz	ཉེན་སྐྱོབ་མི་འབད་ནི་ཨིན་པའི་ནང་ཐིག་ཚུ་སེལ་འཐུ་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3150329				0	dz	 \<emph\> རྩ་སྒྲིག་ - ནང་ཐིག་ཚུ་ - ནང་ཐིག་ཉེན་སྐྱོབ་ \</emph\> སེལ་འཐུ་འབད། ཉེན་སྐྱོབ་འབད་ཡོད་པའི་སྒྲོམ་འདི་ \<emph\> རྟགས་བཀལ་བཤོལ་ཞིནམ་ལས་ \</emph\> བཏུབ་  \<emph\> ཨེབ་གཏང་། \</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3156384				0	dz	\<emph\> ལག་ཆས་ཚུ་ - ཡིག་ཆ་ཉེན་སྐྱོབ་འབད་ - ཤོག་ལེབ་ \</emph\> དཀར་ཆག་གུ་ལུ་ ཤོག་ལེབ་དོན་ལུ་ཉེན་སྐྱོབ་ཤུགས་ལྡན་བཟོ། དེ་འཕྲོ་ལས་རང་ནུས་ཅན་ ཁྱོད་ཀྱིས་ རིམ་པ་ ༡ ནང་སེལ་འཐུ་གྲུབ་ཡོད་པའི་ནང་ཐིག་ཁྱབ་ཚད་རྐྱངམ་ཅིག་ཞུན་དག་འབད་ཚུགསཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3149566	9			0	dz	ཤུལ་ལས་ ཉེན་སྐྱོབ་འབད་དེ་མེད་པའི་མངའ་ཁོངས་དེ་ ཉེན་སྐྱོབ་འབད་ཡོད་པའི་མངའ་ཁོངས་ལུ་བསྒྱུར་བཅོས་འབད་ནིའི་དོན་ལུ་ ཁྱབ་ཚད་སེལ་འཐུ་འབད། དེའི་ཤུལ་ལས་ \<emph\> རྩ་སྒྲིག་ - ནང་ཐིག་ཚུ་ - ནང་ཐིག་ཉེན་སྐྱོབ་ \</emph\> མཆོང་ལྡེ་ཤོག་ལེབ་གུ་ལུ་ \<emph\> ཉེན་སྐྱོབ་འབད་ཡོད་པའི་སྒྲོམ་ \</emph\> ཞིབ་དཔྱད་འབད། མཐའ་མཇུག་ལུ་  \<emph\> ལག་ཆས་ཚུ་ - ཡིག་ཆ་ཉེན་སྐྱོབ་འབད་ - ཤོག་ལེབ་ \</emph\> དཀར་ཆག་གདམ། ཧེ་མ་ལས་རང་ཞུན་དག་འབད་བཏུབ་པའི་ཁྱབ་ཚད་དེ་ ད་འབདན་ཉེན་སྐྱོབ་འབད་དེ་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3153964				0	dz	ཤོག་ལེབ་ཉེན་སྐྱོབ་ཀྱིས་ གསལ་གཞིའི་མཇུག་ལུ་ ཤོག་ལེབ་མཆོང་ལྡེ་གི་སྐབས་དོན་དཀར་ཆག་ཡང་ གནོད་སྐྱོན་འབྱུངམ་ཨིན། \<emph\> བཏོན་གཏང་ \</emph\> དང་ \<emph\> སྤོ་/འདྲ་བཤུས་བརྐྱབ་བརྡ་བཀོད་ཚུ་ \</emph\> སེལ་འཐུ་འབད་མི་ཚུགསཔ་ཨིན། 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3150301				0	dz	ཤོག་ལེབ་དེ་ཉེན་སྐྱོབ་འབད་དེ་ཡོད་པ་ཅིན་ ཁྱོད་ཀྱིས་ ནང་ཐིག་གང་རུང་ཅིག་ ལེགས་བཅོས་དང་བཏོན་གཏང་ནི་ཚུ་འབད་མི་ཚུགསཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3154656				0	dz	ཉེན་སྐྱོབ་འབད་ཡོད་པའི་ཤོག་ལེབ་དང་ཡང་ན་ ནང་ཐིག་ཁྱབ་ཚད་ཚུ་ འ་ནི་ཉེན་སྐྱོབ་དེ་ལྕོགས་མིན་མ་བཟོ་ཚུན་ ལེགས་བཅོས་འབད་མི་ཚུགསཔ་ཨིན། ཉེན་སྐྱོབ་དེ་ལྕོགས་མིན་བཟོ་ནིའི་དོན་ལུ་ \<emph\> ལག་ཆས་ - ཡིག་ཆ་ཉེན་སྐྱོབ་འབད་ - ཤོག་ལེབ་ \</emph\> ཟེར་བའི་བརྡ་བཀོད་ཚུ་གདམ། ཆོག་ཡིག་གཅིག་གཞི་སྒྲིག་འབད་དེ་མེད་པ་ཅིན་ ཤོག་ལེབ་ཉེན་སྐྱོབ་དེ་འདི་འཕྲལ་ལས་རང་ ལྕོགས་མིན་བཟོ་ཡོདཔ་ཨིན། ཤོག་ལེབ་འདི་ ཆོག་ཡིག་ཉེན་སྐྱོབ་འབད་ཡོད་མི་ཅིག་ཨིན་པ་ཅིན་ ཁྱོད་ཀྱིས་ ཆོག་ཡིག་བཙུགས་དགོ་པའི་ \<emph\> ཉེན་སྐྱོབ་རྩ་བསྐྲད་གཏང་ \</emph\> ཟེར་བའི་ཌའི་ལོག་གཅིག་ཁ་ཕྱེཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\06060100.xhp	0	help	par_id3149815				0	dz	ཉེན་སྐྱོབ་འབད་ཡོད་པའི་ཤོག་ལེབ་ཚུ་ཚར་གཅིག་སྲུང་བཞག་འབད་བཞིནམ་ལས་ ལོག་སྟེ་རང་སྲུང་དགོ་པ་ཅིན་  \<emph\> ཡིག་སྣོད་ - བརྡ་བཀོད་སྦེ་སྲུང་བཞག་ \</emph\> ལག་ལེན་ཐོག་ལས་རྐྱངམ་ཅིག་སྲུང་ཚུགསཔ་ཨིན།				2002-02-02 02:02:02
