helpcontent2	source\text\shared\00\00000099.xhp	0	help	par_idN10632				0	dz	\<ahelp hid=\".uno:HelperDialog\"\>གིས་ཁྱོད་ལུ་ རང་བཞིན་གྱི་སྒྲོག་རམ་ལས་ཚབ་འདི་ཤུགས་ལྡན་བཟོ་བཅུགཔ་ཨིན།  \<emph\>ལག་ཆས་ཚུ་ - གདམ་ཁ་ཚུ་ - $[officename] - སྤྱིར་གཏང་ - སྒྲོག་རམ་ལས་ཚབ་\</emph\>.\</ahelp\>བརྒྱུད་དེ་ཁྱོད་ཀྱིས་སྒྲོག་རམ་ལས་ཚབ་འདི་ཤུགས་ལྡན་བཟོ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000099.xhp	0	help	par_id6200750				0	dz	མགྱོགས་ཐབས་ལྡེ་མིག་ཚུ་ལ་ལོ་ཅིག་ཁྱོད་རའི་ཌེཀསི་ཊོཔ་རིམ་ལུགས་ལུ་འགན་སྤྲོད་ཡོདཔ་འོང་།  ཌེཀསི་ཊོཔ་རིམ་ལུགས་འདི་ལུ་འགན་སྤྲོད་ཡོད་མི་ལྡེ་མིག་ལ་ལོ་%PRODUCTNAME ལུ་འཐོབ་མི་ཚུགས་པས། གཞན་ལྡེ་མིག་འགན་སྤྲོད་ནི་ལུ་ %PRODUCTNAME དོན་ལུ་\<emph\>ལག་ཆས་ཚུ་ - སྲོལ་སྒྲིག་ - ལྡེ་སྒྲོམ་ནང\</emph\>ཡང་་ན་ཁྱོད་རའི་ཌེཀསི་ཊོཔ་རིམ་ལུགས་ནང་འགན་སྤྲོད་བཏུབ།				2002-02-02 02:02:02
