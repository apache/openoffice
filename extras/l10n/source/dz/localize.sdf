helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_idN1215A				0	dz	\<ahelp hid=\"37931\"\>སེལ་འཐུ་གྲུབ་ཡོད་པའི་ འགྲུལ་བསྐྱོད་ཕྲ་རིང་གི་ཚད་འཛིན་ནང་  བཙག་ནི་དང་ གསོག་འཇོག་འབད་ནིའི་རྣམ་གྲངས་ཚུ་  སྟོན་ ཡང་ན་ སྦ་བཞག་ནི་  གསལ་བཀོད་འབདཝ་ཨིན།\</ahelp\> བཙག་ནི་དང་ གསོག་འཇོག་འབད་ནིའི་རྣམ་གྲངས་ཚུ་འོག་གི་:  ཡར་འཛེགས་དབྱེ་སེལ་དང་  མར་བབ་དབྱེ་སེལ་  དབྱེ་སེལ་ རང་བཞིན་གྱི་ཚགས་མ་  སྔོན་སྒྲིག་གི་ཚགས་མ་  ཚགས་མ་འཇུག་སྤྱོད་འབད་ནི་ ཚགས་མ་བཏོན་གཏང་ནི་ དེ་ལས་གོ་རིམ་ཚུ་ཨིན།				2002-02-02 02:02:02
