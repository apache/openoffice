helpcontent2	source\text\shared\01\05190100.xhp	0	help	par_id1283608				0	dz	\<ahelp hid=\".\"\> མགོ་མིང་ཚིག་ཡིག་ཅིག་ཐོ་བཀོད་འབད།  མིང་ཐུང་ཀུ་འདི་  ཨེཆ་ཊི་ཨེམ་ཨེལ་རྩ་སྒྲིག་ནང་ལུ་  ཐབས་གཞན་ངོ་རྟགས་སྦེ་མཐོང་ཚུགས། འཛུལ་སྤྱོད་འབད་ཚུགས་པའི་ལག་ཆས་ཚུ་གིས་  ཚིག་ཡིག་འདི་ལྷག་ཚུགས།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05190100.xhp	0	help	hd_id8173467				0	dz	འགྲེལ་བཤད་				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05190100.xhp	0	help	par_id693685				0	dz	\<ahelp hid=\".\"\> འགྲེལ་བཤད་འབད་བའི་ཚིག་ཡིག་ཅིག་ཐོ་བཀོད་འབད།  འགྲེལ་བཤད་ཚིག་ཡིག་རིངམ་འདི་  གསལ་གཞིའི་ལྷག་བྱེད་མཉེན་ཆས་དང་ཅིག་ཁར་  ལག་ལེན་པ་དེ་ཚུ་ལུ་  གོ་དཀའ་བའི་དངོས་པོ་ཡང་ན་དངོས་པོ་ཚུ་གི་སྡེ་ཚན་ཅིག་ལུ་  འགྲེལ་བཤད་བརྐྱབ་ནི་ལུ་ཐོ་བཀོད་འབད་ཚུགས།  འགྲེལ་བཤད་འདི་  འཛུལ་སྤྱོད་འབད་ཚུགས་པའི་ལག་ཆས་ཚུ་གི་དོན་ལུ་  ཐབས་གཞན་ངོ་རྟགས་ཅིག་མཐོང་ཚུགས། \</ahelp\>				2002-02-02 02:02:02
