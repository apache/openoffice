helpcontent2	source\text\shared\02\01170004.xhp	0	help	par_id3153750				0	dz	\<ahelp hid=\"SID_FM_INSERTCOL\"\>གིས་  ཐིག་ཁྲམ་ཚད་འཛིན་ནང་ལུ་བརྟེན་ནི་དོན་ལུ་  གནད་སྡུད་ས་སྒོ་འདི་སེལ་འཐུ་འབད་ནི་ལུ་  ཡན་ལག་དཀར་ཆག་འདི་བོད་བརྡ་འབྱིན་དོ་ཡོདཔ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170004.xhp	0	help	par_id3155552				0	dz	འདྲུད་བཞག་དང་བཀོག་བཞག་ལག་ལེན་འཐབ་ཐོག་ལས་  ཐིག་ཁྲམ་གི་ཚད་འཛིན་དེ་ རིམ་སྒྲིག་འབད: གནད་སྡུད་འབྱུང་ཁུངས་ཀྱི་བརྡ་འཚོལ་འདི་ཁ་ཕྱེ་བཞིནམ་ལས་ རེ་འདུན་བསྐྱེདཔ་དེ་ཡོད་པའི་ས་སྒོ་འདི་ གནད་སྡུད་འབྱུང་ཁུངས་བརྡ་འཚོལ་གྱི་ཕྱི་ཁར་དང་ ཐིག་ཁྲམ་ཚད་འཛིན་འདི་གི་ ཀེར་ཐིག་གི་མགུ་ཏོ་གུར་ལུ་ འདྲུད་བཞག་འབད། སྔོན་རིམ་སྒྲིག་འབད་ཡོད་པའི་ཀེར་ཐིག་དེ་ ཁསར་བསྐྲུན་འབད་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
