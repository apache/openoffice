helpcontent2	source\text\shared\guide\data_register.xhp	0	help	par_idN105C1				0	dz	\<link href=\"text/shared/explorer/database/dabadoc.xhp\"\>གནད་སྡུད་གཞི་རྟེན་ཡིག་སྣོད་\</link\> ག་ཅི་འབད་རུང་ལས་ གནད་སྡུད་འདི་  %PRODUCTNAME ལུ་ཐོ་བཀོད་འབད་བཏུབ། ཐབས་ཤེས་འདི་  %PRODUCTNAME ལུ་ གནད་སྡུད་འདི་ག་སྟེ་ཡོདཔ་ཨིན་ན་ ག་དེ་སྦེ་འགོ་འདྲེན་འཐབ་ཡོདཔ་ཨིན་ན་ གནད་སྡུད་འདི་ག་སྦེ་ལེན་ནི་ཨིན་ན་ དེ་ལས་ལྷག་སྟེ་ སླབ་ནིའི་དོན་ལས་ ཐོ་བཀོད་འབད་ནིའི་དོན་ལུ། གནད་སྡུད་གཞི་རྟེན་འདི་ཚར་གཅིག་ཐོ་བཀོད་འབད་ཚར་ཞིནམ་ལས་  ཁྱོད་ཀྱིས་དཀར་ཆག་བརྡ་བཀོད་  \<emph\>སྟོན་ - གནད་སྡུད་འབྱུང་ཁུངས་\</emph\> འདི་ ཁྱོད་རའི་ ཚིག་ཡིག་ཡིག་ཆ་ཚུ་དང་ ཤོག་ཁྲམ་ཚུ་ལས་ གནད་སྡུད་དྲན་ཐོ་འདི་ཚུ་འཛུལ་སྤྱོད་འབད་ནིའི་དོན་ལས་ ལག་ལེན་འཐབ་བཏུབ།				2002-02-02 02:02:02
