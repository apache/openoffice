helpcontent2	source\text\smath\01\03090200.xhp	0	help	par_id3150866				0	dz	\<ahelp hid=\"HID_SMA_DRARROW\"\>གཏན་ཚིག་ཅན་གྱི་བཀོལ་སྤྱོད་པ་ \<emph\>མདའ་རྟགས་ ལོག་བལྟབ་ཀྱི་ཕྲ་རིང་གཡས་ལུ་རྩེ་དཔག་འབད་མི་\</emph\> འདི་ས་གནས་འཛིན་མི་གཉིས་དང་ཅིག་ཁར་བཙུགསཔ་ཨིན།\</ahelp\> ཁྱོད་ཀྱིས་ \<emph\>ཌི་མདའ་རྟགས་\</emph\> འདི་ \<emph\>བརྡ་བཀོད་ཚུའི་\</emph\> སྒོ་སྒྲིག་ནང་ལུ་ཡིག་དཔར་ཡང་རྐྱབས་ཚུགས།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090200.xhp	0	help	par_id3153545	74			0	dz	\<emph\> \</emph\>ལས་སྦོམ་མི་མཐུན་འབྲེལ་ ས་གནས་འཛིན་མི་གཉིས་དང་ཅིག་ཁར་འབད་མི་འདི་གསར་བསྐྲུན་འབད་ནིའི་དོན་ལས་  \<emph\><?> ཇི་ཇི་ <?> \</emph\>ཡང་ན་ \<emph\>>>\</emph\> འདི་ \<emph\>བརྡ་བཀོད་ཚུའི་\</emph\> སྒོ་སྒྲིག་ནང་ལུ་ཡིག་དཔར་རྐྱབས།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090200.xhp	0	help	par_id3156000				0	dz	\<emph\>ཨེལ་ཨེལ་\</emph\> ཡང་ན་ \<emph\><<\</emph\> འདི་ \<emph\>བརྡ་བཀོད་ཚུའི་\</emph\> སྒོ་སྒྲིག་ནང་ལུ་  \<emph\> \</emph\> ལས་ཉུང་མི་མཐུན་འབྲེལ་འདི་མན་ངག་ནང་ལུ་བཙུགས་ནིའི་དོན་ལས་ ཡིག་དཔར་རྐྱབས།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090200.xhp	0	help	par_id3153749				0	dz	\<emph\>འདི་ \</emph\> མཐུན་འབྲེལ་ ས་གནས་འཛིན་མི་གཉིས་དང་ཅིག་ཁར་སྦེ་ངེས་འཛིན་འབད་ཡོད་མི་འདི་  \<emph\><?>ཌེཕ་<?>\</emph\> ཡིག་དཔར་རྐྱབས་ཐོག་བཙུགས་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090200.xhp	0	help	par_id3154068				0	dz	\<emph\>པར་འདི་\</emph\> ཡིག་འགྲུལ་ཡིག་འབྲུ་ ས་གནས་འཛིན་མི་གཉིས་དང་ཅིག་ཁར་འབད་མི་འདི་གིས་  \<emph\><?> ཊ་འནསི་ཨེལ་ <?>\</emph\> འདི་ \<emph\>བརྡ་བཀོད་ཚུའི་\</emph\> སྒོ་སྒྲིག་ནང་ལུ་ཡིག་དཔར་རྐྱབས་ཐོག་ བཙུགས།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090200.xhp	0	help	par_id3149592				0	dz	\<emph\><?>ཊ་འནསི་ཨར་<?>\</emph\> བརྡ་བཀོད་ཀྱིས་  \<emph\>ངོ་མ་འདི་\</emph\> ཡིག་འགྲུལ་ཡིག་འབྲུ་ ས་གནས་འཛིན་མི་གཉིས་དང་ཅིག་ཁར་བཙུགསཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090200.xhp	0	help	par_id3154735				0	dz	\<emph\>བརྡ་བཀོད་ཚུའི་\</emph\> སྒོ་སྒྲིག་ནང་ལུ་ བརྡ་དོན་འདི་ལག་ཐོག་ལས་ཐོ་བཀོད་འབད་བའི་སྐབས་ ད་ལྟོའི་གཞི་བཀོད་ཀྱི་དོན་ལུ་བཀོལ་སྤྱོད་པའི་གྲངས་ལུ་བར་སྟོང་དགོས་མཁོ་ཡོདཔ་དྲན་དགོ ཁྱོད་ཀྱིས་ས་གནས་འཛིན་མི་གི་ཚབ་ལུ་གནས་གོང་ཚུ་དང་ཅིག་ཁར་ལཱ་འབདཝ་ཨིན་པ་ཅིན་ འ་ནི་འདི་ལྷག་པར་དུ་བདེན་པ་ཨིན། དཔེར་ན་ "ཆ་འཇོག་ཅན་སྦེ་སྦོམ་མི་" མཐུན་འབྲེལ་གྱི་དོན་ལུ་ ཡང་ཅིན་\<emph\>༡༠ ཇི་ཇི་ ༡\</emph\> ཡང་ན \<emph\>ཨེ་ ཇི་ཇི་ བི་\</emph\> ཡིག་དཔར་རྐྱབས།				2002-02-02 02:02:02
