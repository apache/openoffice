helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3148990				0	dz	\<ahelp hid=\"SVX:METRICFIELD:RID_SVXPAGE_STD_PARAGRAPH:ED_LEFTINDENT\"\>ཁྱོད་ཀྱིས་  ཤོག་ལེབ་ས་སྟོང་ལས་དོན་མཚམས་འདི་འགོ་མཚམས་བཅད་ནི་དོན་ལུ་  མང་ཉུང་ཚད་འདི་ཐོ་བཀོད་འབད།  ཁྱོད་ཀྱིས་  དོན་མཚམས་འདི་ཤོག་ལེབ་ཀྱི་ས་སྟོང་ནང་ལུ་རྒྱ་ཡཕར་གཏང་ནི་ཨིན་པ་ཅིན་   མེད་ཆའི་ཨང་གྲངས་ཅིག་ཐོ་བཀོད་འབད།  གཡས་དང་གཡོན་གྱི་སྐད་ཡིག་ཚུ་ནང་   དོན་མཚམས་གཡོན་གྱི་མཐའམ་འདི་  ཤོག་ལེབ་གཡོན་གྱི་ས་སྟོང་དང་ཅིག་ཁར་  རེ་བ་ལྟར་དུ་སོང་ཡོད།  \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3152361				0	dz	ཚིག་ཡིག་གི་ཤུལ་ལས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3154390				0	dz	\<ahelp hid=\"SVX:METRICFIELD:RID_SVXPAGE_STD_PARAGRAPH:ED_RIGHTINDENT\"\>ཤོག་ལེབ་ས་སྟོང་ལས་  ཁྱོད་ཀྱིས་  དོན་མཚམས་འདི་འགོ་མཚམས་བཅད་ནི་ལུ་  བར་སྟོང་གི་ཚད་མང་ཉུང་འདི་ཐོ་བཀོད་འབད།  ཁྱོད་ཀྱིས་  དོན་མཚམས་འདི་  ཤོག་ལེབ་ས་སྟོང་ནང་ལུ་རྒྱ་འཕར་གཏང་ནི་ཨིན་པ་ཅིན་   མེད་ཆའི་ཨང་གྲངས་འདི་ཐོ་བཀོད་འབད།  སྐད་ཡིག་གཡས་ལས་གཡོན་ཚུ་ནང་  དོན་མཚམས་ཀྱི་མཐའམ་གཡས་འདི་  རེ་བ་ལྟར་དུ་  ཤོག་ལེབ་ས་སྟོང་གཡས་ལུ་འགོ་མཚམས་འབད་ཡོདཔ་ཨིན།  གཡས་ལས་གཡོན་གྱི་སྐད་ཡིག་ནང་ལུ་  དོན་མཚམས་གཡོན་གྱི་མཐའམ་འདི་  ཤོག་ལེབ་གཡོན་གྱི་ས་སྟོང་དང་བཅས་འགོ་མཚམས་བཅད་དེ་ཡོད།\</ahelp\>				2002-02-02 02:02:02
