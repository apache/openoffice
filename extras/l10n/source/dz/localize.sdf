helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3153711	55			0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>ཁྱོད་ཀྱིས་སྒྲོམ་ནང་ལུ་ཐོ་བཀོད་འབད་མི་གི་གནད་གོང་འདི་ ངེས་པར་དུ་མཐུན་སྒྲིག་འབད་ནི་ལུ་  གྲལ་ཐིག་གི་བར་སྟོང་བཞག་ཐང་འདི་གཞི་སྒྲིག་འབདཝ་ཨིན།  དེ་གིས་  བཏོག་བཅོས་འབད་ཡོད་པའི་ཡིག་འབྲུ་ཚུ་ལུ་འགྲུབ་འབྲས་སྟོནམ་ཨིན།\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
