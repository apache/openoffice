helpcontent2	source\text\shared\02\01170500.xhp	0	help	par_id3150040				0	dz	\<ahelp hid=\".uno:SwitchControlDesignMode\"\>བཀོད་སྒྲིག་ཐབས་ལམ་  ཨཱོན་ ཡང་ན་ ཨཱོཕ་དེ་  སོར་སྟོན་འབདཝ་ཨིན།  འ་ནཱི་ལས་འགན་འདི་  \<link href=\"text/shared/explorer/database/04030000.xhp\" name=\"Design\"\>བཀོད་སྒྲིག་\</link\> དང་ ལག་ལེན་པའི་ཐབས་ལམ་གྱི་བར་ན་  འཕྲལ་མགྱོས་རང་  སོར་བསྒྱུར་འབད་ནི་ལུ་  ལག་ལེན་འཐབ་ཨིན།   འབྲི་ཤོག་ཚད་འཛིན་ཚུ་ཞུན་དག་འབད་ནི་ལུ་  ཤུགས་ལྡན་བཟོ་   འབྲི་ཤོག་ཚད་འཛིན་འདི་ཚུ་  ལག་ལེན་འཐབ་ནི་ལུ་  ཤུགས་མེད་བཟོ།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170500.xhp	0	help	par_id3153528				0	dz	བཀོད་སྒྲིག་ཐབས་ལམ་གྱི་ \<link href=\"text/shared/02/01171000.xhp\" name=\"Open in Design Mode\"\>\<emph\>ལས་འགན་ནང་\</emph\>\</link\>ཁ་ཕྱེ་ནི་འདི་  སེམས་ཁར་བཞག་གནང་།  བཀོད་སྒྲིག་ཐབས་ལམ་ནང་ \<emph\>ཁ་ཕྱེ་ཡོད་མི་འདི་  \</emph\> ཤུགས་ལྡན་བཟོ་ཡོད་པ་ཅིན་ ཡིག་ཆ་སྲུང་བཞག་འབད་ཡོད་མི་ནང་  ས་ཁོངས་དབྱེ་བ་མེད་པར་  བཀོད་སྒྲིག་ཐབས་ལམ་ནང་ ཨ་རྟག་ར་  ཁ་ཕྱེ་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170500.xhp	0	help	par_id3147088				0	dz	ཁྱོད་ཀྱི་འབྲི་ཤོག་འདི་   གནད་སྡུད་གཞི་རྟེན་དང་གཅིག་ཁར་  འབྲེལ་མཐུད་འབདཡོདཔ་དང་  ཁྱོད་ཀྱི་བཀོད་སྒྲིག་ཐབས་ལམ་འདི་  སོར་བསྒྱུར་འབད་བ་ཅིན་ \<link href=\"text/shared/main0213.xhp\" name=\"Form Bar\"\>འབྲི་ཤོག་ཕྲ་རིང་འདི་\</link\>ཡིག་ཆ་ཝིན་ཌོ་གི་འོག་གི་ས་སྟོང་ནང་ལུ་  བཀྲམ་སྟོན་འབདཝ་ཨིན།  ཁྱོད་ཀྱི་\<link href=\"text/shared/02/01170201.xhp\" name=\"Form Properties\"\>འབྲི་ཤོག་གི་ཕྲ་རིང་ནང་\</link\>གནད་སྡུད་གཞི་རྟེན་ལུ་   ཡབྲེལ་ལམ་འདི་  ཞུན་དག་འབད་བཏུབ།				2002-02-02 02:02:02
