helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3146823	171			0	dz	\<ahelp hid=\"HID_PROP_TAG\" visibility=\"hidden\"\>གིས་  ཚད་འཛིན་ས་སྒོའི་དོན་ལུ་  བརྡ་དོན་ཁ་སྐོངས་  ཡང་ན་  འགྲེལ་བཤད་འབད་བཏུབ་པའི་ཚིག་ཡིག་ཅིག་  གསལ་བཀོད་འབདཝ་ཨིན།  \</ahelp\> ཚད་འཛིན་ས་སྒོ་རེ་གི་ནང་ལུ་  ཁྱོད་ཀྱིས་  བརྡ་དོན་ཁ་སྐོངས་ཡང་ན་ འགྲེལ་བཤད་འབད་བཏུབ་པའི་ཚིག་ཡིག་ཅིག་ གསལ་བཀོད་འབད་བཏུབ་ཨིན།  རྒྱུ་དངོས་དེ་གིས་  ལས་རིམ་བཟོ་མི་ལུ་  ལས་རིམ་ཨང་རྟགས་ནང་ལུ་ལག་ལེན་འཐབ་བཏུབ་པའི་  ཁ་སྐོང་བརྡ་དོན་འདི་སྲུང་ནི་ལུ་གྲོགས་རམ་འབདཝ་ཨིན།  ས་སྒོ་འདི་ལག་ལེན་འཐབ་བཏུབ་ཨིན་  དཔེར་ན་  འགྱུར་ཅན་ཚུ་ཡང་ན་  བརྟག་ཞིབ་ཚད་བཟུང་དོན་ལུ།				2002-02-02 02:02:02
