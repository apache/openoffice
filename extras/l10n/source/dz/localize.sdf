helpcontent2	source\text\shared\optionen\01030500.xhp	0	help	par_id3146120				0	dz	\<ahelp hid=\"OFFMGR:CHECKBOX:RID_OFAPAGE_HTMLOPT:CB_STARBASIC\"\>ཨེཆ་ཊི་ཨེམ་ཨེལ་རྩ་སྒྲིག་ལུ་ཕྱིར་འདྲེན་འབད་བའི་སྐབས་ $[officename] གཞི་རིམ་བསླབ་སྟོན་ཚུ་གྲངས་སུ་བཙུགས་ནི་ལུ་ཨ་ནི་དཔྱད་སྒྲོམ་རྟགས་བཀལ།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01030500.xhp	0	help	par_id3150872				0	dz	ཁྱོད་ཀྱིས་ $[officename] གཞི་རིམ་ཡིག་ཚུགས་གསར་བསྐྲུན་མ་འབད་བའི་ཧེ་མ་ཨ་ནི་གདམ་ཁ་འདི་ངེས་པར་ཤུགས་ལྡན་བཟོ་དགོ། དེ་མིན་པ་ཅིན་འ་ནི་དེ་གཞི་བཙུགས་མི་འབད་འོང་། $[officename] གཞི་རིམ་ཡིག་ཚུགས་ཚུ་ཨེཆ་ཊི་ཨེམ་ཨེལ་ཡིག་ཆ་གི་མགོ་ཡིག་ནང་ངེས་པར་བཞག་དགོཔ་ཨིན། ཐེངས་གཅིག་ཁྱོད་ཀྱིས་ $[officename] གཞི་རིམ་ཨའི་ཌི་ཨི་ནང་མའི་ཀོརོ་གསར་བསྐྲུན་འབདཝ་ད་ དེ་མགོ་ཡིག་ནང་ཨེཆ་ཊི་ཨེམ་ཨེལ་ཡིག་ཆ་གི་འབྱུང་ཁུངས་ཚིག་ཡིག་ནང་འབྱུངམ་ཨིན།				2002-02-02 02:02:02
