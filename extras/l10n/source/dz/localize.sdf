helpcontent2	source\text\shared\02\14020100.xhp	0	help	par_id3152821	2			0	dz	\<variable id=\"tabellehinzufuegentext\"\>\<ahelp hid=\"HID_JOINSH_ADDTAB_TABLELIST\" visibility=\"hidden\"\>ཐིག་ཁྲམ་ཚུ་བཀོད་སྒྲིག་སྒོ་སྒྲིག་ནང་བཙུག་ནི་གི་གསལ་བཀོད་འབདཝ་ཨིན། \</ahelp\>ཁྱོད་ཀྱིས་ \<emph\> ཐིག་ཁྲམ་ཁ་སྐོང་རྐྱབས་\</emph\>ཌའི་ལོག་ནང་ ད་ལྟོ་ཁྱོད་ར་ལུ་དགོ་པའི་ཐིག་ཁྲམ་ཚུ་ སེལ་འཐུ་འབད། \</variable\>འདྲི་དཔྱད་ཅིག་ ཡང་ན་ ཐིག་ཁྲམ་གསལ་སྟོན་གསརཔ་ཅིག་གསར་བསྐྲུན་འབད་བའི་སྐབས་ལུ་ འདྲི་དཔྱད་ ཡངན་ ཐིག་ཁྲམ་གསལ་སྟོན་གྱིས་གཞི་བསྟུན་འབད་དགོ་པའི་ ཆ་མཉམ་པའི་ཐིག་ཁྲམ་སེལ་འཐུ་འབད། མཐུན་འབྲེལ་གྱི་གནད་སྡུད་གཞི་རྟེན་དང་གཅིག་ཁར་ལཱ་འབད་བའི་སྐབས་ལུ་ ཁྱོད་ཀྱིས་མཐུན་འབྲེལ་ག་ཅི་བཟོ་ནི་ཨིན་ན་ བར་ནའི་ཐིག་ཁྲམ་ཚུ་སེལ་འཐུ་འབད།				2002-02-02 02:02:02
