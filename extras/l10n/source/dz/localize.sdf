helpcontent2	source\text\scalc\guide\database_define.xhp	0	help	par_id3153768				0	dz	ཁྱོད་ཀྱིས་ ནང་ཐིག་ཁྱབ་ཚད་ཅིག་ གནད་སྡུད་གཞི་རྟེན་སྦེ་ལག་ལེན་འཐབ་ནི་གི་དོན་ལུ་ ཤོག་ཁྲམ་ཅིག་ནང་ངེས་འཛིན་འབདཝ་ཨིན། གནད་སྡུད་གཞི་རྟེན་གྱི་ཁྱབ་ཚད་ཀྱི་གྲལ་ཐིག་རེ་རེ་བཞིན་ གནད་སྡུད་གཞི་རྟེན་གྱི་དྲན་ཐོ་དང་ཆ་མཉམ་ཨིནམ་དང་ གྲལ་ཐིག་ནང་གི་ནང་ཐིག་རེ་རེ་བཞིན་ གནད་སྡུད་གཞི་རྟེན་གྱི་ས་སྒོ་དང་ཆ་མཉམ་ཨིན། ཁྱོད་ཀྱིས་ གནད་སྡུད་གཞི་རྟེན་ནང་བཟུམ་སྦེ་ དབྱེ་སེལ་དང་སྡེ་ཚན་བཟོ་ནི་ དེ་ལས་གཞན་འཚོལ་ཞིབ་དང་ཁྱབ་ཚད་གུ་ལུ་རྩིས་སྟོན་འབད་ཚུགས། 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\guide\database_define.xhp	0	help	par_id3145801	82			0	dz	ཁྱོད་ཀྱིས་ ཞུན་དག་རྐྱངམ་ཅིག་འབད་ཚུགསཔ་དང་ ཁྱབ་ཚད་དང་ལྡན་པའི་ཤོག་ཁྲམ་ནང་ལུ་ གནད་སྡུད་གཞི་རྟེན་གྱི་ཁྱབ་ཚད་ཅིག་འཛུལ་སྤྱོད་འབད་ཚུགས། དེ་འབདཝ་ད་ གནད་སྡུད་གཞི་རྟེན་གྱི་ཁྱབ་ཚད་འདི་ %PRODUCTNAME གནད་སྡུད་འབྱུང་ཁུངས་ཀྱི་མཐོང་སྣང་ནང་ལུ་ འཛུལ་སྤྱོད་འབད་མི་ཚུགས།				2002-02-02 02:02:02
