helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3155355				0	dz	ནང་ཐིག་ནང་ལུ་ ངོ་རྐྱང་གསན་གོང་ཚུ་བརྟག་ཞིབ་འབད་ཡོད་པའི་ མན་ངག་དེ་ ཨེ་རེ་མན་ངག་སྦེ་གཞི་བསྟུན་འབད་ཡོདཔ་ཨིན། ཨེ་རེ་མན་ངག་དང་ མན་ངག་གཞན་མི་བར་གྱི་ཁ་ཁྱད་པར་དེ་ ཨེ་རེ་མན་ངག་གིས་ གནས་གོང་གཅིག་དང་ འབྲེལ་བ་འཐབ་ནི་ཚབ་མ་ལུ་ དུས་མཉམ་་ལུ་ གནས་གོང་ལེ་ཤ་དང་འབྲེལ་བ་འཐབ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3151052				0	dz	ཨེ་རེ་མན་ངག་གིས་ གནས་གོང་ལེ་ཤ་ལས་སྦྱོར་འབད་ནི་རྐྱངམ་ཅིག་མེན་པར་ དེ་གིས་ གནས་གོང་ལེ་ཤ་སླར་ལོག་འབད་ཚུགསཔ་ཨིན། ཨེ་རེ་མན་ངག་གི་གྲུབ་འབྲས་དེ་ཡང་ ཨེ་རེ་རང་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3158432				0	dz	ལྟག་གི་ཨེ་རེ་ནང་ལུ་ གནས་གོང་ཚུ་ ༡༠ གིས་ དགུ་མཐའ་རྐྱབ་ནིའི་དོན་ལུ་ ཁྱོད་ཀྱིས་ ནང་ཐིག་གམ་ གནས་གོང་ངོ་རྐྱང་རེ་རེ་ལུ་མན་ངག་འཇུག་སྤྱོད་འབད་དགོཔ་མེདཔ་ཨིན། དེའི་ཚབ་ལུ་ ཁྱོད་ཀྱིས་ ཨེ་རེ་བན་ངག་རྐྱང་པ་ཅིག་ལག་ལེན་འཐབ་དགོཔ་ཨིན། ཤོག་ཁྲམ་གྱི་ ཡན་ལག་གཞན་མི་ཅིག་གུ་  ནང་ཐིག་ ༣ x ༣ གི་ཁྱབ་ཚད་སེལ་འཐུ་འབད་དེ་ མན་ངག་"=10*A1:C3" བཙུགས་ཞིནམ་ལས་ འ་ནི་ཐོ་བཀོད་དེ་ \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\> བརྡ་བཀོད་ \</caseinline\>\<defaultinline\> ཚད་འཛིན་ \</defaultinline\>\</switchinline\>+སོར་ལྡེ་+ལོག་ལྡེ་ ལྡེ་མིག་མཉམ་སྦྲགས་ལག་ལེན་འཐབ་ཐོག་ལས་ངེས་དཔྱད་འབད།  གྲུབ་འབྲས་དེ་ ནང་ཐིག་ཁྱབ་ཚད་ (A1:C3) ནང་ གནས་གོང་ངོ་རྐྱང་ཚུ་༡༠ གི་ཆ་རྐྱེན་གྱིས་ དགུ་མཐའ་རྐྱབས་ཡོད་པའི་ ༣ x ༣ ཨེ་རེ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3149156				0	dz	དགུ་མཐའ་རྐྱབ་ནི་ཁ་སྐོང་ལུ་ ཁྱོད་ཀྱིས་ གཞི་བསྟུན་ཁྱབ་ཚད་གུ་ལུ་ བཀོལ་སྤྱོདཔ་གཞན་མི་ཚུ་ཡང་ལག་ལེན་འཐབ་བཏུབ་ཨིན་(ཨེ་རེ་ཅིག་)། $[officename] ཀེལ་སི་དང་ གཅིག་ཁར་་ཁྱོད་ཀྱིས་ (+) ཕབ་ (-) དགུ་མཐའ་རྐྱབ་ (*) བགོ་ (/) བསྒྱུར་གྲངས་ཚུ་ (^) རྒྱུན་རིམ་ (&) དང་ག་བསྡུར་ཚུ་ལག་ལེན་འཐབ་ (=, <>, <, >, <=, >=)། བཀོལ་སྤྱོདཔ་ཚུ་ ནང་ཐིག་ཁྱབ་ཚད་ནང་ གནས་གོང་ངོ་རྐྱང་རེ་རེའི་གུ་ལུ་ལག་ལེན་འཐབ་བཏུབ་མ་ཚད་ ཨེ་རེ་མན་ངག་བཙུགས་ཏེ་ཡོད་པ་ཅིན་ གྲུབ་འབྲས་དེ་ཨེ་རེ་སྦེ་སླར་ལོག་འབདཝ་ཨིན། 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3166456				0	dz	ཨེ་རེ་མན་ངག་ནང་ཁ་བསྡུར་བཀོལ་སྤྱོདཔ་ཚུ་གིས་A1 དང་ A2 འདི་སྟོངམ་ཡོད་པ་ཅིན་  ཨེ་རེ་མན་ངག་{=A1:A2=""} དང་ {=A1:A2=0}དེ་གིས་  TRUE ཡོད་པའི་ནང་ཐིག་གི་ཨེ་རེ་ ཀེར་ཐིག་ ༡་ གྲལ་ཐིག་ ༢་ གཉིས་ཆ་རང་སླར་ལོག་འབདཝ་ཨིན།				2002-02-02 02:02:02
