helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3154069				0	dz	\<ahelp hid=\"HID_ALIGNMENT_CTR_BORDER_LOCK\"\>བསྒྱིར་འགྱོ་མི་ཚིག་ཡིག་འདི་འབྲི་ནི་ཨིན་པའི་ ནང་ཐིག་གི་མཐའམ་འདི་གསལ་བཀོད་འབད།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3147299				0	dz	\<emph\>འོག་གི་ནང་ཐིག་མཐའམ་ལས་ ཚིག་ཡིག་རྒྱ་བསྐྱེད་ཀྱིས་:\</emph\>བསྒྱིར་འགྱོ་མི་ཚིག་ཡིག་འདི་  མཇུག་གི་ནང་ཐིག་མཐའམ་ལས་ ཕྱི་ཁ་ཐུག་ལུ་འབྲིཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3149561				0	dz	\<emph\>ལྟག་གི་ནང་ཐིག་མཐའམ་ལས་  ཚིག་ཡིག་རྒྱ་བསྐྱེད་ཀྱིས་ :\</emph\> བསྒྱིར་འགྱོ་བའི་ཚིག་ཡིག་འདི་  མགོའི་ནང་ཐིག་མཐའམ་ལས་ ཕྱི་ཁ་ཐུག་ལུ་འབྲིཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05340300.xhp	0	help	par_id3163712				0	dz	\<emph\>ནང་ཐིག་ནང་ལུ་ ཚིག་ཡིག་རྒྱ་བསྐྱེད་ཀྱི་ :\</emph\>བསྒྱིར་འགྱོ་མི་ཚིག་ཡིག་འདི་ ནང་ཐིག་གི་ནང་འཁོད་ལུ་་རྐྱངམ་ཅིག་འབྲིཝ་ཨིན།				2002-02-02 02:02:02
