helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3147505	134			0	dz	\<ahelp hid=\"HID_PROP_EFFECTIVEMIN\" visibility=\"hidden\"\>ལག་ལེན་པ་འདི་གིས་ གནས་གོང་ཉུང་མི་ཅིག་  ཐོ་བཀོད་འབད་ནི་ བཀག་ནི་ལུ་ ཚད་འཛིན་ས་སྒོ་གི་དོན་ལུ་  ཁྱོད་ཀྱི་ནཱ་ལུ་  གནས་གོང་ཅིག་གཏན་འབེབས་བཟོ་བཏུབ་ཨིན།\</ahelp\>ཨང་གྲངས་དང་ དངུལ་གྱི་ས་སྒོ་ཚུ་གི་དོན་ལུ་  ལག་ལེན་པ་འདི་གིས་ གནས་གོང་ཉུང་མི་ཅིག་ ཐོ་བཀོད་འབད་ནི་བཀག་ནི་ལུ་ ཁྱོད་ཀྱི་ཉུང་མཐའི་གནས་གོང་ཅིག་ གཏན་འབེབས་བཟོ་བཏུབ།				2002-02-02 02:02:02
