helpcontent2	source\text\shared\02\01170700.xhp	0	help	par_id3152425				0	dz	འ་ནི་གདམ་ཁ་འདི་གི་ ཨེགསི་ཉེན་བྱེད་དང་-ཐབས་ལམ་ཆ་ཤས་འདི་ཚུ་ ཡི་གུ་ཚོར་ཅན་ཨིནམ་སེམས་ཁར་བཞག				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170700.xhp	0	help	par_id3153683				0	dz	ཚད་འཛིན་གྱི་ལེགས་སྐྱོང་འཐབ་མི་  བྱུང་ལས་འདི་ཚུ་ $[officename] ཨེ་པི་ཨའི་  ལག་ལེན་འཐབ་ཐོག་ལས་  ལས་འགན་འགྲུབ་ཨིན།  ཁྱོད་ཀྱི་བྱུང་ལས་ཅིག་  ཚད་འཛིན་ཅིག་ལུ་  འགན་སྤྲོད་འབད་བ་ཅིན་  དངོས་པ་འདི་གིས་  ཁོ་རང་ ནང་འཁོད་ལས་  དམིགས་བསལ་གྱི་  ཚད་འཛིན་བྱུང་ལས་ཅིག་གི་དོན་ལུ་ "Listener"སྦེ་ ཐོ་བཀོད་འབདཝ་ཨིན། འདི་འབད་ནི་ལུ་  དངོས་པོ་འདི་གིས་  དམིགས་བསལ་གྱི་ངོས་འདྲ་བ་ཅིག་  ལག་ལེན་འཐབ་དགོ་   དཔྱེ་འབད་བ་ཅིན་  XFocusListener ་ངོས་འདྲ་བ་བཟུམ་  འདི་འབདཝ་ལས་  འདི་གིས་  ཆེད་དམིགས་ཀྱི་བྱུང་ལས་ལུ་  གདོང་ལེན་འབད་འོང་།  བྱུང་ལས་འདི་བྱུང་པའི་སྐབས  ཚད་འཛིན་འདི་ལུ་ཆེད་དམིགས་དེ་  འཐོབ་ད་  ཚད་འཛིན་འདི་གིས་དེ་ལས་  ཉེན་བྱེད་ངོས་འདྲ་བའི་ དམིགས་བསལ་གྱི་ ཐབས་ལམ་འདི་ཚུ་  ལས་བཀོལ་འབདཝ་ཨིན།  ནང་འཁོད་ལུ་  ཐོ་བཀོད་འབད་ཡོད་མི་  དངོས་པོ་འདི་གིས་  བྱུང་ལས་ལུ་འགན་སྤྲོད་འབད་ཡོད་པའི་  javaScript་ཡང་ན་ $[officename]གི་ཨང་རྟགས་འདི་  དེ་ལས་ ལས་བཀོལ་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170700.xhp	0	help	par_id3156410				0	dz	ད་འབདན་  ཨེཆ་ཊི་ཨེམ་ཨེལ་ ཚགས་མ་འདི་གིས་  ཁོང་རའི་དང་འདོད་བཟུམ་སྦེ་རང་  བྱུང་ལས་འདི་ཚུ་  ནང་འདྲེད་དང་  ཕྱིར་འདྲེན་འབད་བཏུབ་ནི་ལུ་  འ་ནཱི་ཉེན་བྱེད་ངོས་འདྲ་བ་དང་  ཐབས་ལམ་གྱི་མིང་འདི་ཚུ་  ཀྲིག་ཀྲི་སྦེ་ལག་ལེན་འཐབ་ཨིན།  ཁྱོད་ཀྱི་ཆེད་དམིགས་ཀྱི་བྱུང་ལས་འདི་  དེ་ལས་བརྒྱུད་དེ་ཐོ་བཀོད་འབད།				2002-02-02 02:02:02
