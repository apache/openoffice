helpcontent2	source\text\shared\01\06040000.xhp	0	help	par_id3150838				0	dz	\<variable id=\"autoko\"\>\<ahelp hid=\".uno:AutoCorrectDlg\"\>ཁྱོད་ཀྱིས་ཡིག་དཔར་བརྐྱབ་པའི་བསྒང་  ཚིག་ཡིག་འདི་རང་བཞིན་གྱིས་  ཚབ་བཟོ་ནི་དོན་ལུ་་ གདམ་ཁ་ཚུ་གཞི་སྒྲིག་འབདཝ་ཨིན།\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040000.xhp	0	help	par_id3147261				0	dz	ཁྱོད་ཀྱིས་མིང་ཚིག་འདི་ཐོ་བཀོད་འབད་ཚར་བའི་ཤུལ་ལས་  ཁྱོད་ཀྱིས་བར་སྟོང་ཕྲ་རིང་འདི་ཨེབ་པའི་བསྒང་  རང་བཞིན་བདེན་པའི་སྒྲིག་སྟངས་ཚུ་འཇུག་སྤྱོད་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040000.xhp	0	help	par_id3153394				0	dz	$[officename] Calc ནང་  རང་བཞིན་བདེན་པའི་ཁྱད་རྣམ་འདི་ཨོན་དང་ཨོཕ་འབད་ནི་དོན་ལུ་ \<emph\>ལག་ཆས་ཚུ་ - ནང་ཐིག་གི་ནང་དོན་ཚུ་ - རང་བཞིན་ཨིན་པུཊི་\</emph\>གདམ་ཁ་བརྐྱབ་ནི་དང་  in $[officename] Writer  \<emph\>རྩ་སྒྲིག་ - རང་བཞིན་རྩ་སྒྲིག་- ཡིག་དཔར་བརྐྱབ་པའི་བསྒང་\</emph\>འདི་གདམ་ཁ་བརྐྱབ། ཡིག་ཆའི་ཚིག་ཡིག་ཧྲིལ་བུ་ལུ་  རང་བཞིན་རྩ་སྒྲིག་སྒྲིག་སྟངས་འཇུག་སྤྱོད་འབད་ནི་ལུ་   \<emph\>རྩ་སྒྲིག་ - རང་བཞིན་རྩ་སྒྲིག་ - འཇུག་སྤྱོད་\</emph\>གདམ་ཁ་བརྐྱབ།				2002-02-02 02:02:02
