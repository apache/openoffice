helpcontent2	source\text\shared\02\03130000.xhp	0	help	par_id3153255				0	dz	\<ahelp hid=\".uno:SetBorderStyle\"\>ཁྱོད་ཀྱི་ལེབ་གྲངས་ཀྱི་མངའ་ཁོངས་སམ་  དངོས་པོ་ཅིག་གི་  མཐའ་མཚམས་ཚུ་  ལེགས་བཅོས་འབད་བཏུབ་ས་ལུ་ \<emph\>མཐའ་མཚམས་ \</emph\>ལག་ཆས་ཕྲ་རིང་ཁ་ཕྱེ་ནི་ལུ་ \<emph\>མཐའ་མཚམས་ཀྱི་\</emph\>ངོས་དཔར་ལུ་ཨེབ་གཏང་འབད།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\03130000.xhp	0	help	par_id3147261				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>\</caseinline\>\<defaultinline\>འ་ནཱི་དངོས་པོ་འདི་  ཚིག་ཡིག་གཞི་ཁྲམ་དང་  ཚད་རིས་ཡང་ན་ ཐིག་ཁྲམ་གྱི་མཐའ་མཚམས་སྦེ་  འབད་བཏུབ་ཨིན།  ཚད་རིས་དང་  ཐིག་ཁྲམ་ དངོས་པོ་ ཡང་ན་ གཞི་ཁྲམ་ཅིག་སེལ་འཐུ་འབད་ཡོད་པ་ཅིན་རྐྱངམ་ཅིག་  འ་ནཱི་དངོས་པོ་འདི་མཐོང་ཚུགས།\</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\03130000.xhp	0	help	par_id3147226	6			0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>མཐའ་མཚམས་ཀྱི་བྱེ་བྲག་གི་དབྱེ་བ་ཅིག་   རྐྱང་པ་ནང་ཐིག་ལུ་  འཛུག་སྤྱོད་འབད་ནི་ལུ་  འོད་རྟགས་འདི་  ནང་ཐིག་ནང་བཞག་ \<emph\>མཐའ་མཚམས་\</emph\>ལག་ཆས་ཕྲ་རིང་འདི་  ཁ་ཕྱེ་ཞིནམ་ལས་  མཐའ་མཚམས་དེ་  སེལ་འཐུ་འབད།\</caseinline\>\<defaultinline\>ཁྱོད་ཀྱི་ཚད་རིས་སམ་ ཐིག་ཁྲམ་ཅིག་ནམ་རང་བཙུགས་རུང་  དེ་ཚུ་ལུ་ ཧེ་མ་ལས་རང་  ཡོངས་གྲུབ་  མཐའ་མཚམས་ཚུ་ཡོད།  འ་ནཱི་མཐའ་མཚམས་འདི་  རྩ་བསྐྲད་གཏང་ནི་ལུ་  ཚད་རིས་ཀྱི་དངོས་པོའམ་  ཐིག་ཁྲམ་ཧྲིལ་བུ་འདི་སེལའཐུ་འབད་ཞིནམ་ལས་ \<emph\>མཐའ་མཚམས་ \</emph\>ལག་ཆས་ཕྲ་རིང་གུར་"no border"ངོས་དཔར་ལུ་  ཨེབ་གཏང་འབད།\</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
