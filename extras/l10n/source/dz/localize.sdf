helpcontent2	source\text\shared\01\01160000.xhp	0	help	par_id4546342				0	dz	\<ahelp hid=\".\" visibility=\"hidden\"\>ཁྱོད་རའི་སྔོན་སྒྲིག་གློག་འཕྲིན་ལས་རིམ་དང་གཅིག་ཁར་ད་ལྟོའི་ཡིག་ཆ་མཉམ་སྦྲགས་སྦེ་ཝིནཌོ་གསརཔ་ཅིག་ནང་ཁ་ཕྱེཝ་ཨིན། ཨོ་པཱན་ཌོ་ཀུ་མེནཊི་ཡིག་སྣོད་རྩ་སྒྲིག་འདི་ལག་ལེན་འཐབ་ཡོདཔ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01160000.xhp	0	help	par_id6845301				0	dz	\<ahelp hid=\".\" visibility=\"hidden\"\>ཁྱོད་ཀྱི་སྔོན་སྒྲིག་གློག་འཕྲིན་ལས་རིམ་དང་གཅིག་ཁར་ད་ལྟོའི་ཡིག་ཆ་མཉམ་སྦྲགས་སྦེ་ཝིནཌོ་གསརཔ་ཅིག་ནང་ཁ་ཕྱེཝ་ཨིན། མའི་ཀོརོ་སོཕཊི་ཡིག་སྣོད་རྩ་སྒྲིག་འདི་ལག་ལེན་འཐབ་ཡོདཔ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
