helpcontent2	source\text\shared\01\01010000.xhp	0	help	par_id3149182				0	dz	\<ahelp hid=\"HID_TBXCONTROL_FILENEW\" visibility=\"hidden\"\>$[officename] ཡིག་ཆ་གསརཔ་ཅིག་གསར་བསྐྲུན་འབདཝ་ཨིན།   ཡིག་ཆའི་དབྱེ་བ་སེལ་འཐུ་འབད་ནི་དོན་ལུ་  མདའ་རྟགས་འདི་གུ་ཨེབ་གཏང་།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01010000.xhp	0	help	par_id3153528				0	dz	\<ahelp hid=\".\"\>ཊེམ་པེལེཊི་ཅིག་ལས་  ཡིག་ཆ་ཅིག་ ཁྱོད་ཀྱིས་གསར་བསྐྲུན་འབད་དགོ་པ་ཅིན་   \<emph\>གསརཔ་ - ཊེམ་པེལེཊིསི་དང་ཡིག་ཆ་སེལ་འཐུ་འབད།\</emph\>\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01010000.xhp	0	help	par_id3147009				0	dz	ཊེམ་པེལེཊི་ཟེར་མི་འདི་  རྩ་སྒྲིག་གི་བཟོ་རྣམ་དང་རྒྱབ་གཞི་ཚུ་  དེ་ལས་  གཞི་ཁྲམ་དང་ཚད་རིས་ཚུ་  ས་སྒོ་ཚུ་དང་ཤོག་ལེབ་སྒྲིག་བཀོད་དེ་ལས་ཚིག་ཡིག་ བརྩི་སྟེ་ཡོད་པའི་  ཡིག་ཆའི་དོན་ལུ་  བཀོད་སྒྲིག་ཆ་ཤས་ཚུ་ཡོད་པའི་  ཡིག་སྣོད་ཅིག་ཨིན།				2002-02-02 02:02:02
