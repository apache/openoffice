helpcontent2	source\text\shared\01\01010000.xhp	0	help	par_idN10AB6				0	dz	\<ahelp hid=\".\" visibility=\"hidden\"\> གིས་  ཁྱོད་ཀྱིས་   ཁྱོད་རའི་ཁ་ཡིག་ཚུ་གི་དོན་ལུ་  གདམ་ཁ་ཚུ་གཞི་སྒྲིག་འབད་བཏུབ་པའི་  ཁ་ཡིག་ཚུ་ཁ་ཕྱེཝ་ཨིནམ་དང་  དེ་ལས་  ཁ་ཡིག་ ($[officename] Writer) དོན་ལུ་  ཚིག་ཡིག་ཡིག་ཆ་གསརཔ་ཅིག་  གསར་བསྐྲུན་འབདཝ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01010000.xhp	0	help	par_idN10ACD				0	dz	\<ahelp hid=\".\" visibility=\"hidden\"\> གིས་  ཁྱོད་ཀྱིས་  ཁྱོད་རའི་ཚོང་འབྲེལ་ཤོག་བྱང་ཚུ་གི་དོན་ལུ་  གདམ་ཁ་ཚུ་གཞི་སྒྲིག་འབད་བཏུབ་པའི་   ཚོང་འབྲེལ་ཤོག་བྱང་ཚུའི་ཌའི་ལོག་འདི་  ཁ་ཕྱེཝ་ཨིནམ་དང་  དེ་ལས་  ཚིག་ཡིག་ཡིག་ཆ་གསརཔ་ཅིག་གསར་བསྐྲུན་འབདཝ་ཨིན། ($[officename] Writer).\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01010000.xhp	0	help	par_idN10AE4				0	dz	\<ahelp hid=\".\" visibility=\"hidden\"\>གིས་  གནས་དེ་ཡོད་པའི་ཊེམ་པེལེཊི་  ལག་ལེན་འཐབ་ཐོག་ལས་  ཡིག་ཆ་གསརཔ་ཅིག་གསར་བསྐྲུན་འབད་ནི་དང་  ཡང་ན་  དཔེ་ཚད་ཡིག་ཆ་འདི་ཁ་ཕྱེཝ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
