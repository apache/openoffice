helpcontent2	source\text\shared\02\01170100.xhp	0	help	par_id3145345				0	dz	\<variable id=\"kontroll\"\>\<ahelp hid=\".uno:ControlProperties\"\> སེལ་འཐུ་འབད་ཡོད་པའི་ཚད་འཛིན་གྱི་རྒྱུ་དངོས་ཞུན་དག་འབད་ནི་དོན་ལུ་  ཌའི་ལོག་འདི་ཁ་ཕྱེཝ་ཨིན།   \</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170100.xhp	0	help	par_id3157910	17			0	dz	\<variable id=\"hinweis\"\>ཚད་འཛིན་དང་གཅིག་ཁར་  \<emph\> བཀོད་སྒྲིག་ཐབས་ལམ་འདི་སེལ་འཐུ་འབད་ཡོད་པ་ཅིན་རྐྱངམ་ཅིག་ \</emph\>དེ་ནང་ལུ་ཁྱོད་ཀྱི་  རྒྱུ་དངོས་ཀྱི་ཌའི་ལོག་འདི་ལུ་བོད་བརྡ་འབད་ཚུགས།\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170100.xhp	0	help	par_id3153760				0	dz	ཁྱོད་ཀྱི་གནད་སྡུད་འདི་ \<emph\>རྒྱུ་དངོས་ \</emph\>ཌའི་ལོག་ནང་ལུ་   ཐོ་བཀོད་འབད་བ་ཅིན་ ཐིག་མིང་ཨིན་པུཊི་འདི་  ཀོམ་བོ་སྒྲོམ་ཚུ་གི་གདམ་ཐོ་ ལ་ལོ་ཅིག་ལུ་ཡརྐྱངམ་ཅིག་སྲིདཔ་ཨིན།  འ་ནི་འདི་གིས་  ཨེསི་ཀིའུ་ཨེལ་གསལ་བཤད་  ཐོ་བཀོད་འབད་བཏུབ་པའི་ས་སྒོ་ཚུ་གི་མ་ཚད་  ཚིག་ཡིག་སྒྲོམ་གྱི་་རྒྱུ་དངོས་ཡང་ན་ ཁ་ཡིག་ས་སྒོ་ཚུ་ལུ་  འབྲེལ་བ་འབདཝ་ཨིན།  ཁྱོད་ཀྱི་འ་ནི་ས་སྒོ་འདི་ཚུ་ཁ་ཕྱོ་ཞིནམ་ལས་ ཁ་ཕྱེ་ཡོད་པའི་ཐོ་ཡིག་ནང་ ཚིག་ཡིག་འདི་ཐོ་བཀོད་འབད།  འོག་གི་མགྱོགས་ཐབས་ཀྱི་ལྡེ་མིག་འདི་ཚུ་ ནུས་ཅན་ཨིན། 				2002-02-02 02:02:02
