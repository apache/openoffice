helpcontent2	source\text\simpress\01\04110000.xhp	0	help	par_id3145799	2			0	dz	\<variable id=\"dateitext\"\>\<ahelp hid=\".uno:ImportFromFile\"\>གིས་  ཤུགས་ལྡན་བཤུད་ནི་ནང་ལུ་ཡིག་སྣོད་གཅིག་བཙུགསཔ་ཨིན།   ཨེཆ་ཊི་ཨེམ་ཨེལ་ཡིག་ཆ་ཡང་ན་ཚིག་ཡིག་ཡིག་ཆ་ལས་  ཁྱོད་ཀྱིས་  $[officename] འཐེན་ནི་  ཡང་ན་  ཡིག་སྣོད་ཨིམ་པེརེསི་བཙུགས་བཏུབ་ཨིན།\</ahelp\>\</variable\> ཁྱོད་ལུ་ཤུགས་ལྡན་ཨིན་ཊར་ནེཊི་འབྲེལ་ལམ་ཡོད་པ་ཅིན་  ཡུ་ཨར་ཨེལ་འདི་  \<emph\>ཡིག་སྣོད་མིང་ \</emph\>སྒྲོམ་ནང་ཐོ་བཀོད་འབད་ཐོག་ལས་  ཁྱོད་ཀྱིས་  ཝེབ་ཤོག་ལེབ་གཅིག་ལས་  ཚིག་ཡིག་བཙུགས་བཏུབ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\simpress\01\04110000.xhp	0	help	par_id3155446				0	dz	ཁྱོད་ཀྱིས་ཡང་དམིགས་བསལ་བཤུད་ཚུ་ཡང་ན་དངོས་པོ་ཚུ་བཙུགས་ནི་རྐྱངམ་གཅིག་ལུ་ \<link href=\"text/simpress/01/04110100.xhp\" name=\"slides or objects\"\>$[officename]ཌྲོ་ཡང་ན་ཨིམ་པེརེསི་ཡིག་སྣོད་ཚུ་ལས་དམིགས་བསལ་བཤུད་ཚུ་ཡང་ན་\</link\>དངོས་པོ་ཚུ་བཙུགས་ནི་རྐྱངམ་གཅིག་གདམ་ཁ་རྐྱབ་ཚུགས།				2002-02-02 02:02:02
