helpcontent2	source\text\smath\01\06010000.xhp	0	help	par_id3146313				0	dz	\<variable id=\"symboletext\"\>\<ahelp hid=\"SID_SYMBOLS_CATALOGUE\"\> \<emph\>བརྡ་མཚོན་ཚུ་\</emph\> ཌའི་ལོག་  མན་ངག་ནང་བཙུགས་ནིའི་དོན་ལས་ཁྱོད་ཀྱིས་བརྡ་མཚོན་ཅིག་སེལ་འཐུ་འབད་ཚུགས་མི་ འདི་ཁ་ཕྱེ།\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\06010000.xhp	0	help	hd_id3150202				0	dz	བརྡ་མཚོན་ཆ་ཚན།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\06010000.xhp	0	help	par_id3148699				0	dz	\<ahelp hid=\"STARMATH_LISTBOX_RID_SYMBOLDIALOG_1\"\>བརྡ་མཚོན་ཚུ་གེ་ར་ བརྡ་མཚོན་ཆ་ཚན་ཚུ་ནང་ལུ་འགོ་འདྲེན་འཐབ་ཡོདཔ་ཨིན། ཐོ་ཡིག་སྒྲོམ་ནང་ལས་རེ་འདུན་ཡོད་པའི་བརྡ་མཚོན་གྱི་ཆ་ཚན་འདི་སེལ་འཐུ་འབད། བརྡ་མཚོན་ཚུའི་མཉམ་པའི་སྡེ་ཚན་འདི་ འོག་གི་ས་སྒོ་དེ་ནང་བྱུངམ་ཨིན།་\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\06010000.xhp	0	help	par_id3153917				0	dz	བརྡ་མཚོན་ཅིག་སེལ་འཐུ་འབད་ཡོད་པའི་སྐབས་ དེའི་བརྡ་བཀོད་ཀྱི་མིང་དེ་ བརྡ་མཚོན་ཐོ་ཡིག་གི་འོང་ལུ་བྱུངམ་ཨིན་ དེ་ལས་ ཆེར་སྐྱེད་འབད་ཡོད་པའི་ཐོན་རིམ་ཅིག་ གཡས་ཁ་ཐུག་ལུ་སྒྲོམ་ཅིག་ནང་བྱུངམ་ཨིན། མིང་འདི་ ནཱ་ལུ་བཀྲམ་སྟོན་འབད་ཡོད་མི་(ཡི་གུ་ཆེ་ཆུང་གི་ཉེན་ཁ་)བཟུམ་སྦེ་ \<emph\>Commands\</emph\> སྒོ་སྒྲིག་དེ་ནང་ཡིག་དཔར་རྐྱབས་དགོ				2002-02-02 02:02:02
