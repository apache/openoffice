helpcontent2	source\text\swriter\01\04070100.xhp	0	help	par_id3145415	4			0	dz	\<ahelp hid=\"SW:MULTILINEEDIT:TP_ENV_ENV:EDT_ADDR\" visibility=\"visible\"\>འགྲེམ་སྤེལ་ཁ་ཡིག་དེ་བཙུགས།\</ahelp\>ཁྱོད་ཀྱིས་སྒྲོམ་འདི་ལུ་ཡང་ཨེབ་གཏང་འབད་དེ་ གནད་སྡུད་གཞི་རྟེན་ ཐིག་ཁྲམ་ ས་སྒོ་ཚུ་སེལ་འཐུ་འབད་ཞིནམ་ལས་ དེ་ལས་ ས་སྒོ་དེ་ཁ་ཡིག་ནང་ལུ་བཙུགས་ནིའི་དོན་ལུ་ མདའ་རྟགས་ཨེབ་རྟ་དེ་ལུ་ ཨེབ་གཏང་འབད། ཁྱོད་ལུ་དགོ་པ་ཅིན་ ཚིག་ཡིག་དེ་ལུ་ཁ་ཡི༥ག་བཏགས་ནིའི་དོན་ལུ་ རྒྱགས་པ་དང་འོག་ཐིག་བཟུམ་མའི་རྩ་སྒྲིག་འབད་ནི་དེ་འཇུག་སྤྱོད་འབད་ཚུགས།				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070100.xhp	0	help	par_id3153527	6			0	dz	\<ahelp visibility=\"visible\" hid=\"SW:MULTILINEEDIT:TP_ENV_ENV:EDT_SEND\"\>ཡིག་ཤུབས་གུར་སླར་ལོག་ཁ་ཡིག་ཅིག་གྲངས་སུ་བཙུགསཔ་ཨིན། \<emph\>གཏང་མི་\</emph\>ཞིབ་དཔྱད་སྒྲོམ་དེ་སེལ་འཐུ་འབད་ཞིནམ་ལས་ དེ་ལས་ སླར་ལོག་ཁ་ཡིག་དེ་བཙུགས། \</ahelp\> $[officename] ཁྱོད་རའི་ལག་ལེན་པའི་གནད་སྡུད་དེ་\<emph\>གཏང་མི་\</emph\>སྒྲོམ་ནང་ལུ་རང་བཞིན་གྱིས་བཙུགསཔ་ཨིན་ དེ་འབདཝ་ད་ ཁྱོད་ར་ལུ་དགོ་པའི་གནད་སྡུད་ཡང་བཙུགས་ཚུགས།				2002-02-02 02:02:02
