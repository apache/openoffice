helpcontent2	source\text\swriter\01\04090003.xhp	0	help	par_id3150343				0	dz	\<ahelp hid=\"SW_EDIT_TP_FLD_FUNC_ED_FUNCVALUE\" visibility=\"hidden\"\>ས་སྒོ་གི་དོན་ལུ་ ལས་འགན་ཚད་བཟུང་ཁ་སྐོང་གཞི་སྒྲིག་འབདཝ་ཨིན། ཚད་བཟུང་གྱི་དབྱེ་བ་དེ་ཡང་ ཁྱོད་ཀྱིས་སེལ་འཐུ་འབད་མི་ས་སྒོའི་དབྱེ་བ་དང་འཁྲིལ་ཏེ་འོངམ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04090003.xhp	0	help	par_id3151242				0	dz	ཁྱོད་ཀྱིས་སེལ་འཐུའབད་མི་ས་སྒོའི་དབྱེ་བ་དང་འཁྲིལ་དེ་ ལས་འགན་ལ་ལོ་ཅིག་ལུ་ ཁྱོད་ཀྱིས་གནས་སྟངས་འགན་སྤྲོད་འབད་ཚུགས། དཔེ་འབད་བ་ཅིན་ ཁྱོད་ཀྱིས་ཡིག་ཆ་ནང་གི་ས་སྒོ་དེ་ལུ་ཨེབ་གཏང་འབད་བའི་སྐབས་ལུ་དང་ ཡང་ན་ ཕྱེད་པའི་སྐབས་ལུ་ས་སྒོ་སྦ་བཞག་པའི་སྐབས་ལུ་ ཁྱོད་ཀྱིས་མེཀརོ་ལག་ལེན་འཐབ་མི་ས་སྒོ་ཅིག་ངེས་འཛིན་འབད་ཚུགས། ཁྱོད་ཀྱིས་ཁྱོད་ར་ལུ་དགོ་པའི་སྐབས་ལུ་ཁྱོད་རའི་ཡིག་ཆ་ནང་ལུ་ ཚད་རིས་དང་ ཐིག་ཁྲམ་ གཞི་ཁྲམ་ དེ་ལས་དངོས་པོ་གཏན་མི་ཚུ་བཙུགས་མི་ས་གནས་འཆང་མི་ས་སྒོ་ཚུ་ངེས་འཛིན་འབད་ཚུགས། 				2002-02-02 02:02:02
