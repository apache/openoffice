helpcontent2	source\text\shared\01\extensionupdate.xhp	0	help	par_id5189062				0	dz	ཐད་ཀར་དུ་ཕབ་ལེན་འབད་བཏུབ་པའི་རྒྱ་བསྐྱེད་ཚུ་  ད་ལྟོ་ཕབ་ལེན་འབད་ཚུགས།  ཡར་འཕེལ་འདི་  ཕབ་ལེན་དང་གཞི་བཙུག་ཌའི་ལོག་ནང་ལུ་སྟོན་སྟེ་ཡོད།  ག་དེམ་ཅིག་འབད་རྒྱ་བསྐྱེད་འདི་ཕབ་ལེན་འབད་མ་ཚུགས་པ་ཅིན་  འཕྲིན་དོན་ཅིག་བཀྲམ་སྟོན་འབདཝ་ཨིན།  བཀོལ་སྤྱོདཔ་འདི་  རྒྱ་བསྐྱེད་ལྷག་ལུས་ཀྱི་དོན་ལུ་འཕྲོ་མཐུདཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\extensionupdate.xhp	0	help	par_id6854457				0	dz	མཇུག་གི་རྒྱ་བསྐྱེད་འདི་ཕབ་ལེན་འབད་ཚར་བའི་ཤུལ་ལུ་  གཞི་བཙུག་འབད་ནི་འདི་འགོ་བཙུགཔ་ཨིན།  དུས་མཐུན་བཟོ་ནི་ཚུ་མཐར་འཁྱོལཝ་འབད་ཚུགས་མི་འདི་  རྩ་བསྐྲད་གཏང་ནིའི་དོན་ལུ་  དང་པ་རང་གཞི་བཙུགས་འབད་ཡོད་པའི་རྒྱ་བསྐྱེད་ཚུ་ཨིན།  དེ་ལས་དུས་མཐུན་བཟོ་ཡོད་པའི་རྒྱ་བསྐྱེད་ཚུ་གཞི་བཙུགས་འབདཝ་ཨིན།  འཛོལ་བ་འདི་འབྱུང་པ་ཅིན་  གཞི་བཙུག་འབད་མ་ཚུགས་ཟེར་བའི་འཕྲིན་དོན་ཅིག་བཀྲམ་སྟོན་འབདཝ་ཨིན་  དེ་འབདཝ་ད་བཀོལ་སྤྱོདཔ་འདི་ཡར་འཕེལ་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\extensionupdate.xhp	0	help	par_id3372295				0	dz	དུས་མཐུན་ཚུ་ཆ་མཉམ་ལས་སྦྱོར་འབད་དེ་ཡོད་པ་ཅིན་  ཕབ་ལེན་དང་གཞི་བཙུག་ཌའི་ལོག་དེ་གིས་  ཚར་ཡི་  ཟེར་སྟོནམ་ཨིན།  ཁྱོད་ཀྱིས་ཕབ་ལེན་དང་གཞི་བཙུགས་ལས་སྦྱོར་འདི་  \<emph\>དུས་མཐུན་བར་ཤོལ་འབད་\</emph\>ཨེབ་རྟ་ཨེབ་གཏང་གི་ཐོག་སལ་  བར་བཤོལ་འབད་ཚུགས།				2002-02-02 02:02:02
