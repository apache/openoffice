helpcontent2	source\text\swriter\01\02110000.xhp	0	help	par_id3148784				0	dz	\<ahelp hid=\".\" visibility=\"hidden\"\> དེ་གིས་ ཡིག་ཆ་ནང་གི་རཧེ་མམ་གྱི་རྣམ་གྲངས་ལུ་མཆོངམ་ཨིན། ལུ་ མཆོངས་ནིའི་དོན་ལུ་ རྣམ་གྲངས་ཀྱི་དབྱེ་བ་གསལ་བཀོད་འབད་ནིའི་དོན་ལུ་\<emph\>འགྲུལ་བསྐྱོདཔ་\</emph\>ངོས་དཔར་དེ་ ཨེབ་གཏང་འབད་ཞིནམ་ལས་ དེ་ལས་ རྣམ་གྲངས་དབྱེ་རིམ་དེ་ཨེབ་གཏང་འབད-དཔེ་འབད་བ་ཅིན་ "Graphics".\</ahelp\> དེ་གིས་ ཡིག་ཆ་ནང་གི་ཧེ་མམ་གྱི་རྣམ་གྲངས་ལུ་མཆོངམ་ཨིན། ལུ་མཆོངས་ནི་ཟེར་མི་གི་དོན་ལུ་རྣམ་གྲངས་ཀྱི་དབྱེ་བ་གསལ་བཀོད་འབད་ནིའི་དོན་ལུ་\<link href=\"text/swriter/01/02110100.xhp\" name=\"Navigation\"\>འགྲུལ་བསྐྱོདཔ་\</link\>ངོས་དཔར་དེ་ལུ་ ཨེབ་གཏང་འབད་ཞིནམ་ལས་ རྣམ་གྲངས་ཀྱི་དབྱེ་རིམ་དེ་ཨེབ་གཏང་འབད་-དཔེ་འབད་བ་ཅིན་ "Graphics".				2002-02-02 02:02:02
