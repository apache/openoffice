helpcontent2	source\text\shared\02\02020000.xhp	0	help	par_id3156414				0	dz	\<variable id=\"schriftarttext\"\>\<ahelp hid=\".uno:CharFontName\"\>ཁྱོད་ལུ་  ཐོ་ཡིག་ནང་ལས་  ཡིག་གཟུགས་ཀྱི་མིང་སེལ་འཐུ་འབད་ནི་དང་  ཡང་ན་  ཡིག་གཟུགས་ཀྱི་མིང་  ཐད་ཀར་དུ་བཙུགས།\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\02020000.xhp	0	help	par_id3153750				0	dz	ཁྱོད་ཀྱི་ སེ་མི་ཀོ་ལཱོན་ (;)་གིས་  སོ་སོ་འཕྱལ་ཡོད་པའི་  ཡིག་གཟུགས་ལེ་ཤ་ཅིག་  ཐོ་བཀོད་འབད་བཏུབ།  ཧེ་མའི་ཡིག་གཟུགས་འདི་ཚུ་  འཐོབ་མ་ཚུགས་པ་ཅིན་$[officename] འདི་གིས་  རྗེས་འཛིན་ནང་ མིང་བཏགས་ཡོད་མི་  རེ་རེ་བཞིན་ ལག་ལེན་འཐབ་ཨིན།  				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\02020000.xhp	0	help	par_id3153394				0	dz	བསྒྱུར་བཅོས་འབད་ཡོད་པའི་ཡིག་གཟུགས་འདི་  སེལ་འཐུ་གྲུབ་ཡོད་པའི་ཚིག་ཡིག་  ཡང་ན་  འོད་རྟགས་འདི་གི་གནས་སའི་  མིང་ཚིག་གང་རུང་ལུ་  འཇུག་སྤྱོད་འབདཝ་ཨིན།  ཚིག་ཡིག་ཅིག་སེལ་འཐུ་མ་འབད་བར་ཡོན་པ་ཅིན་  ཡིག་གཟུགས་འདི་གིས་  ཚིག་ཡིག་ཤུལ་ལས་  ཡིག་དཔར་རྐྱབ་ཡོད་མི་ལུ་  འཇུག་སྤྱོད་འབདཝ་ཨིན།				2002-02-02 02:02:02
