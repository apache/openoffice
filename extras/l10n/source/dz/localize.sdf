helpcontent2	source\text\swriter\02\18030000.xhp	0	help	par_id3147403	2			0	dz	\<ahelp hid=\".\" visibility=\"hidden\"\> ས་སྒོའི་ཌའི་ལོག་དེ་  ཁ་ཕྱེ་ནིལུ་ཨེབ་གཏང་འབད།  ཡན་ལག་དཀར་ཆག་ཅིག་ ཁ་ཕྱེ་ནི་དོན་ལུ་ ངོས་དཔར་གྱི་ཤུལ་ལས་་ཡོད་པའི་  མདའ་རྟགས་དེ་ལུ་  ཨེབ་གཏང་འབད།\</ahelp\>ས་སྒོའི་ཌའི་ལོག་དེ་ཁ་ཕྱེ་ནི་ལུ་\<link href=\"text/swriter/01/04090000.xhp\"\>ཨེབ་གཏང་\</link\>འབད། ཡན་ལག་དཀར་ཆག་ཅིག་ ཁ་ཕྱེ་ནི་དོན་ལུ་ ངོས་དཔར་གྱི་ཤུལ་ལས་་ཡོད་པའི་  མདའ་རྟགས་དེ་ལུ་  ཨེབ་གཏང་འབད།				2002-02-02 02:02:02
