helpcontent2	source\text\shared\02\20020000.xhp	0	help	par_id3148731				0	dz	\<ahelp hid=\".uno:LayoutStatus\"\>ད་ལྟོའི་ཤོག་ལེབ་བཟོ་རྣམ་བཀྲམ་སྟོན་འབདཝ་ཨིན། བཟོ་རྣམ་ཞུན་དག་འབད་ནི་ལུ་ཐེངས་གཉིས་ཨེབ་གཏང་འབད་ བཟོ་རྣམ་གཞན་སེལ་འཐུ་འབད་ནི་ལུ་གཡས་ཨེབ་གཏང་།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\20020000.xhp	0	help	par_id3149283	3			0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>ཁྱོད་ཀྱིས་ད་ལྟོའི་ཤོག་ལེབ་ཀྱི་དོན་ལས་ཞུན་དག་འབད་ཚུགས་ནི་ཨིན་མི་ནང་\<emph\> ཤོག་ལེབ་བཟོོ་རྣམ་ཌའི་ལོག་ཁ་ཕྱེ་ནི་ལུ་ \</emph\>ཤོག་ལེབ་བཟོ་རྣམ་ས་སྒོ་ \<link href=\"text/swriter/01/05040000.xhp\" name=\"Page Style\"\>ཐེངས་གཉིས་-\</link\> ཨེབ་གཏང་། ས་སྒོ་འདི་གི་སྐབས་དོན་དཀར་ཆག་ནང་ ཁྱོད་ཀྱིས་ཤོག་ལེབ་བཟོ་རྣམ་འཇུག་སྤྱོད་འབད་ཚུགས། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\20020000.xhp	0	help	par_id3151234	4			0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>   \<emph\>ཤོག་ལེབ་བཟོ་རྣམ་\</emph\> ས་སྒོ་འདི་ \<link href=\"text/scalc/01/05070000.xhp\" name=\"Page Style\"\>ཤོག་ལེབ་བཟོ་རྣམ་\</link\> ཌའི་ལོག་  ཁྱོད་ཀྱིས་ད་ལྟོའི་ཤོག་ལེབ་ཀྱི་དོན་ལུ་ བཟོ་རྣམ་ཞུན་དག་འབད་བཏུབ་མི་ ནང་ཚར་གཉིས་ཨེབ་གཏང་། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\20020000.xhp	0	help	par_id3149346	5			0	dz	ཤུགས་ལྡན་ཤོག་ལེབ་ཀྱི་དོན་ལུ་ \<switchinline select=\"appl\"\>\<caseinline select=\"IMPRESS\"\>ཁྱོད་ཀྱི་བཟོ་རྣམ་ཅིག་\<emph\> སེལ་འཐུ་འབད་བཏུབ་ས་ལུ་ \</emph\> ཤོག་ལེབ་བཟོ་རྣམ་གྱི་ཌའི་ལོག་ཅིག་ཁ་ཕྱེ་ནི་ལུ་\<link href=\"text/simpress/01/05120000.xhp\" name=\"Page Style\"\>ཤོག་ལེབ་ཀྱི་བཟོ་རྣམ་ལུ་ \</link\> ཨེབ་གཏང་ཐེངས་གཉིས་འབད།  ཁྱོད་ཀྱི་ཤོག་ལེབ་ཀྱི་རྩ་སྒྲིག་དང་ ཡང་ན་ རྒྱབ་གཞི་སོ་སོ་ཅིག་སེལ་འཐུ་འབད་བཏུབ།\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\20020000.xhp	0	help	par_id3147008	6			0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"DRAW\"\>ཁྱོད་ཀྱིས་ ད་ལྟོའི་ཡིག་ཆའི་དོན་ལུ་ བཟོ་རྣམ་སེལ་འཐུ་འབད་ཚུགས་པའི་ \<emph\>ཤོག་ལེབ་བཟོ་རྣམ་ཌའི་ལོག་དེ་\</emph\> ཁ་ཕྱེ་ནིའི་དོན་ལུ་ \<link href=\"text/simpress/01/05120000.xhp\" name=\"Page Style\"\> ཤོག་ལེབ་བཟོ་རྣམ་ ས་སྒོ་དེ་ལུ་ \</link\>ཐེངས་གཉིས་ཨེབ་གཏང་འབད། ཁྱོད་ཀྱིས་ རྩ་སྒྲིག་དང་ ཡང་ན་ རྒྱབ་གཞི་སོ་སོ་ཅིག་སེལ་འཐུ་འབད་ཚུགས། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
