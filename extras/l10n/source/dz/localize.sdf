helpcontent2	source\text\shared\01\02090000.xhp	0	help	par_id3155261				0	dz	\<switchinline select=\"appl\"\> \<caseinline select=\"CALC\"\>ལེབ་གྲངས་གུ་ནང་ཐིག་ཚུ་ཆ་མཉམ་སེལ་འཐུ་འབད་ནི་དོན་ལུ་  ལེབ་གྲངས་ཀྱི་མགོའི་གཡོན་གྱི་སྒྱིད་ཁུག་ནང་གི་  ཀེར་ཐིག་དང་གྲལ་ཐིག་མགོ་ཡིག་གི་དུམ་བུར་གཅོད་པ་གི་  ཨེབ་རྟ་གུ་ཨེབ་གཏང་།\</caseinline\> \<defaultinline/\> \</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02090000.xhp	0	help	par_id3154046				0	dz	\<switchinline select=\"appl\"\> \<caseinline select=\"CALC\"\>ཤོག་ཁྲམ་ཡིག་སྣོད་ནང་ལུ་  ལེབ་གྲངས་ཚུ་ཆ་མཉམ་སེལ་འཐུ་འབད་ནི་དོན་ལུ་  ལེབ་གྲངས་ཀྱི་མིང་ཨེབ་ལྡེ་འདི་ གཡས་ཨེབ་གཏང་ནི་དང་  དེ་ལས་  \<emph\>ལེབ་གྲངས་ཚུ་ཆ་མཉམ་སེལ་འཐུ་འབད་\</emph\>གདམ་ཁ་བརྐྱབ།\<ahelp hid=\".uno:TableSelectAll\" visibility=\"hidden\"\>གིས་  ད་ལྟོའི་ཤོག་ཁྲམ་ནང་གི་ལེབ་གྲངས་ཚུ་ཆ་མཉམ་སེལ་འཐུ་འབདཝ་ཨིན།  \</ahelp\>\</caseinline\> \<defaultinline/\> \</switchinline\>				2002-02-02 02:02:02
