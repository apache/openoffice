helpcontent2	source\text\scalc\01\func_weekday.xhp	0	help	par_id3149046				0	dz	\<emph\> ཨང་ \</emph\> ཚེས་གནས་གོང་བཟུམ་སྦེ་ཡོད་མི་འདི་ བདུན་ཕྲག་ཉིནམ་སླར་ལོག་འབད་ནི་ཨིན་པའི་བཅུ་ཚག་ཨིན། 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_weekday.xhp	0	help	par_id3154394				0	dz	\<emph\> དབྱེ་བ་གིས་ \</emph\> རྩིས་སྟོན་གྱི་དབྱེ་བ་གཏན་འབེབས་བཟོཝ་ཨིན། དབྱེ་བ་ =༡ དོན་ལུ་  བདུན་ཕྲག་ཉིནམ་ཚུ་གཟའ་ཟླཝ་ལས་རྩིས་ཡོདཔ་ཨིན། (འ་ནི་འདི་དབྱེ་བ་ཚད་བཟུང་ཡང་བརླག་སྟོར་ཞུགས་པའི་སྐབས་ཀྱི་སྔོན་སྒྲིག་ཨིན།) དབྱེ་བ་ =༢ དོན་ལུ་ བདུན་ཕྲག་ཉིནམ་ཚུ་གཟའ་མིག་དམར་ =༡ ལས་འགོ་བཙུགས་ཏེ་རྩིས་ཡོདཔ་ཨིན། དབྱེ་བ་ = ༣ དོན་ལུ་ བདུན་ཕྲག་ཉིནམ་ཚུ་ གཟའ་མིག་དམར་ = ༠ ལས་འགོ་བཙུགས་ཏེ་རྩིས་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
