helpcontent2	source\text\sbasic\shared\01020100.xhp	0	help	par_id3143222				0	dz	\<emph\>ཨང་གྲངས་ཀྱི་\</emph\> འགྱུར་ཅན་ཚུ་ཆ་མཉམ་རང་བཞིན་གྱིས་  "0" གནས་གོང་འདི་་ ཁོང་་ཆ་མཉམ་མགྱོགས་པ་རང་གསལ་བསྒྲགས་འབད་ཚརཝ་ཅིན་འགན་སྤྲོད་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020100.xhp	0	help	par_id3150693				0	dz	\<emph\>ཚེས་འགྱུར་ཅན་ཚུ་\</emph\> ཆ་མཉམ་གནས་གོང་ ༠་ ནང་འཁོད་འགན་སྤྲོདཔ་ཨིན  གནས་གོང་ལུ་ "0" གཞི་བསྒྱུར་ལུ་འདྲ་མཉམ་་དང་གཅིག་ཁར་ \<link href=\"text/sbasic/shared/03030103.xhp\" name=\"Day\"\>\<emph\>ཉིནམ་\</emph\>\</link\>, \<link href=\"text/sbasic/shared/03030104.xhp\" name=\"Month\"\>\<emph\>ཟླ་\</emph\>\</link\>, \<link href=\"text/sbasic/shared/03030106.xhp\" name=\"Year\"\>\<emph\>ལོ་\</emph\>\</link\> ཡང་ན་ \<link href=\"text/sbasic/shared/03030201.xhp\" name=\"Hour\"\>\<emph\>ཆུ་ཚོད་\</emph\>\</link\>, \<link href=\"text/sbasic/shared/03030202.xhp\" name=\"Minute\"\>\<emph\>སྐར་མ\</emph\>\</link\>, \<link href=\"text/sbasic/shared/03030204.xhp\" name=\"Second\"\>\<emph\>སྐར་ཆག་\</emph\>\</link\> ལས་འགན་ལུ་གཞི་བསྒྱུར་འབདཝ་ཨིན།				2002-02-02 02:02:02
