helpcontent2	source\text\swriter\02\02110000.xhp	0	help	par_id3150240				0	dz	\<ahelp hid=\".uno:DefaultNumbering\"\>གིས་  སེལ་འཐུ་འབད་དེ་ཡོད་པའི་དོན་མཚམས་ལས་  ཨང་གྲངས་འདི་ཚུ་ཁ་སྐོང་བརྐྱབ་ནི་དང་རྩ་བསྐྲད་གཏངམ་ཨིན།\</ahelp\>ཨང་གྲངས་རྩ་སྒྲིག་ངེས་འཛིན་འབད་ནི་ལུ་   \<emph\>རྩ་སྒྲིག་ - འགོ་ཚག་དང་ཨང་བཏགས་བཀལ་ནི་\</emph\>གདམ་ཁ་བརྐྱབ།  \<emph\>འགོ་ཚག་དང་ཨང་བཏགས་ནི་\</emph\>ཕྲ་རིང་གདམ་ཁ་བརྐྱབ་ནི་ལུ་ ,  \<emph\>སྟོན་ - ལག་ཆས་ཕྲ་རིང་ - འགོ་ཚག་དང་ཨང་བཏགས་ནི་\</emph\>གདམ་ཁ་བརྐྱབ།				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\02110000.xhp	0	help	par_id3150952				0	dz	 \<link href=\"text/swriter/01/03120000.xhp\" name=\"Web Layout\"\>Web Layout\</link\>ལཱ་འབད་བའི་བསྒང་   འགོ་ཚག་ལ་ལོ་ཅིག་དང་ཨང་བཏགས་ནིའི་གདམ་ཁ་ཚུ་འཐོབ་ཚུགས་མིན་འདུག།				2002-02-02 02:02:02
