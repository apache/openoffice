helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3156553				0	dz	\<variable id=\"context\"\>དངོས་པོ་གི་སྐབས་དོན་་དཀར་ཆག་འདི་ཤུགས་ལྡན་བཟོ་ནའི་དོན་ལས་ དང་པ་རང་ དངོས་པོ་འདི་  \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>\</caseinline\>\<defaultinline\>གཡོན་\</defaultinline\>\</switchinline\> དང་བཅས་ཨེབ་ནི་དང་  མཱའུསི་ཨེབ་རྟ་འདི་སེལ་འཐུ་འབད་ནའི་དོན་ལུ་ཨིན་  དེ་ལས་ \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\> གདམ་ཁའི་ལྡེ་མིག་དང་ བརྡ་བཀོད་ ཡང་ཅིན་ ཚད་འཛིན་གྱི་ལྡེ་མིག་འདི་མར་འབད་འཆང་བའི་བསྒང་  མཱའུསི་ཨེབ་རྟ་འདི་ཨེབ་གཏང་།\</caseinline\>\<defaultinline\>གཡས་ཀྱི་མཱའུསི་ཨེབ་རྟ་འདི་ཨེབ་གཏང་།\</defaultinline\>\</switchinline\>  དངོས་པོ་འདི་སེལ་འཐུ་འདབ་འདི་མེད་རུང་ནང་དོན་དཀར་ཆག་ལ་ལོ་ཅིག་བོད་བརྡ་འབད་བཏུབ། $[officename] ནང་ལུ་ནང་དོན་གྱི་དཀར་ཆག་འདི་ག་སྟེ་རང་ཐོབ་ཚུགས། \</variable\>				2002-02-02 02:02:02
