helpcontent2	source\text\shared\04\01010000.xhp	0	help	hd_id3150702				0	dz	མགྱོགས་ཐབས་ལྡེ་མིག་ལག་ལེན་འཐབ་ནི།				2002-02-02 02:02:02
helpcontent2	source\text\shared\04\01010000.xhp	0	help	par_id3151299				0	dz	ཁྱོད་ཀྱི་གློག་རིམ་ལས་འགན་གྱི་བཀྲམ་སྤེལ་སྦོམ་ཤོས་ཅིག་ མགྱོགས་ཐབས་ལྡེ་མིག་ལག་ལེན་འཐབ་པའི་ཐོག་ལས་ བོད་བརྡ་འབད་བཏུབ། དཔེར་ན་ \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>བརད་བཀོད་+ཨོ་ \</caseinline\>\<defaultinline\>ཚད་འཛིན་+ཨོ་\</defaultinline\>\</switchinline\> མགྱོགས་ཐབས་ལྡེ་མིག་ཚུ་  \<emph\>ཡིག་སྣོད་  \</emph\>དཀར་ཆག་ནང་  \<emph\>ཁ་ཕྱེ་\</emph\>ཐོ་འགོད་ལས་གཞན་ཅིག་ཁར་སྟོནམ་ཨིན།ཁྱོད་ཀྱིས་ མགྱོགས་ཐབས་ལྡེ་མིག་ལག་ལེན་འཐབ་པའི་ཐོག་ལས་ ལས་འགན་འདི་འཇུག་སྤྱོད་འབད་ནི་ཨིན་པ་ཅིན་ ཨེབ་ཞིནམ་ལས་ལྡེ་མིག་འདི་མར་སྦེ་བཟུང་  \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>བརྡ་བཀོད་ \</caseinline\>\<defaultinline\>ཚད་འཛིན་\</defaultinline\>\</switchinline\>དེ་ལས་ ཨོ་ལྡེ་མིག་ལུ་ཨེབ།  ཌའི་ལོག་འབྱུང་པའི་ཤུལ་ལུ་ ལྡེ་མིག་གཉིས་ཀུ་འཛིན་གྲོལ་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\04\01010000.xhp	0	help	par_id3153894				0	dz	ཁྱོད་རའི་གློག་རིམ་འདི་བཀོལ་སྤྱོད་འབད་བའི་བསྒང་ འཐོབ་ཚུགས་པའི་བཀོལ་སྤྱོད་ཆ་མཉམ་གྱི་དོན་ལས་ མའུསི་ ཡང་ན་ ལྡེ་སྒྲོམ་གཉིས་ལས་གང་རུང་ཅིག་ལག་ལེན་འཐབ་པའི་ཐོག་ལས་ གདམ་ཁ་རྐྱབས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\04\01010000.xhp	0	help	hd_id3154186				0	dz	\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>\</caseinline\>\<defaultinline\>མགྱོགས་ཐབས་ལྡེ་མིག་དང་གཅིག་ཁར་དཀར་ཆག་ཚུ་འབོ་པའི་བསྒང་\</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\04\01010000.xhp	0	help	par_id3152425				0	dz	\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>\</caseinline\>\<defaultinline\> དཀར་ཆག་ཕྲ་རིང་གུ་སྟོན་ཡོད་པའི་ཡིག་འབྲུ་ལ་ལོ་ཅིག་འོག་ཐིག་བཀལ་ནུག ཁྱོད་ཀྱིས་ དཀར་ཆ་ཚུ་གདམ་ལྡེ་དང་མཉམ་འོག་ཐིག་བཀལ་ཡོད་པའི་ཡིག་འབྲུ་ཚུ་ཨེབ་པའི་ཐོག་ལས་ཐད་ཀར་དུ་འཛུལ་སྤྱོད་འབད་ཚུགསདཀར་ཆག་འདི་ཚར་ཅིག་ཁ་ཕྱེ་ཞིནམ་ལས་ དོ་རུང་ཁྱོད་ཀྱིས་འོག་ཐིག་བཀལ་ཡོད་པའི་ཡིག་འབྲུ་ཚུ་མཐོང་འོང་། དེ་མ་ཚད་ འོག་ཐིག་བཀལ་ཡོད་པའི་ཡིག་འབྲུ་ལྡེ་མིག་ལུ་ཨེབ་པའི་ཐོག་ལས་ དཀར་ཆག་རྣམ་གྲངས་ཚུ་ཐད་ཀར་དུ་འཛུལ་སྤྱོད་འབད་ཚུགས། \</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\04\01010000.xhp	0	help	hd_id3156410				0	dz	ཌའི་ལོགསི་ཚད་འཛིན་ནིའི་དོན་ལུ་མགྱོགས་ཐབས་ལྡེ་མིག་ལག་ལེན་འཐབ་དོ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\04\01010000.xhp	0	help	par_id3154288				0	dz	བྱིན་ཡོད་པའི་ཌའི་ལོག་གང་རུང་ཅིག་ནང་ ཆ་ཤས་ཅིག་གཙོ་དམིགས་འབད་དེ་ཡོདཔ་ཨིན་ -མང་ཤོས་རང་ཆད་པའི་གཞི་ཁྲམ་གྱི་ཐོག་ལས་སྟོནམ་ཨིན། ཆ་ཤས་འདི་ཐོ་ཡིག་སྒྲོམ་ནང་ ཨེབ་རྟ་ ཡང་ན་ གདམ་ཁའི་ས་སྒོ་ ཡང་ཅིན་ ཐོ་འགོད་ ཡངན་ ཞིབ་དཔྱད་སྒྲོམ་ལུ་ཆེད་དམིགས་ཡོདཔ་སྦེ་སླབ་ཨིན་པས། ཆེད་དམིགས་རྩེ་འདི་ཨེབ་རྟ་ཨིན་པ་ཅིན་ བཙུགས་ལུ་ཨེབ་གཏང་འབད་ཐོག་ལས་ ཁྱོད་ཀྱིས་ཨེབ་གཏང་འབད་ཡོདཔ་བཟུམ་སྦེ་ གཡོག་བཀོལཝ་ཨིན། ཞིབ་དཔྱད་སྒྲོམ་འདི་ བར་སྟོང་ཕྲ་རིང་ལུ་ཨེབ་ཐོག་ལས་སོར་སྟོན་འབད་ཡི། གདམ་ཁའི་ས་སྒོ་འདི་ལུ་ཆེད་དམིགས་ཡོད་པ་ཅིན་ མངའ་ཁོངས་དེ་ནང་ ཤུགས་ལྡན་བཟོ་ཡོད་པའི་གདམ་ཁ་འདི་བསྒྱུར་བཅོས་འབད་ནིའི་དོན་ལས་ མདའ་རྟགས་ལྡེ་མིག་ཚུ་ལག་ལེན་འཐབ། ཆ་ཤས་ ཡང་ན་ མངའ་ཁོངས་གཅིག་ལས་གཞན་ཅིག་ཁར་འགྱོ་ནི་ལུ་ མཆོང་ལྡེ་ལག་ལེན་འཐབ་ དེ་ལས་ཁ་ཕྱོགས་རིམ་ལོགས་ནང་སོར་ལྡེ་+མཆོང་ལྡེ་ལག་ལེན་འཐབ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\04\01010000.xhp	0	help	par_id3149177				0	dz	ཨི་ཨེསི་སི་ལུ་ཨེབ་མི་འདི་གིས་ བསྒྱུར་བཅོས་ཚུ་མ་སྲུངས་པར་ཌའི་ལོག་ཁ་བསྡམ་ཨིན། \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>\</caseinline\>\<defaultinline\>ཁྱོད་ཀྱིས་ཨེབ་རྟ་གུ་ཆེད་དམིགས་བཞག་པ་ཅིན་ ཁྱོད་ཀྱིས་ ཨེབ་རྟའི་ཚག་བཀལ་ཡོད་པའི་གྲལ་ཐིག་གཞི་ཁྲམ་མིང་རྐྱངམ་ཅིག་མེན་པར་ སེལ་འཐུ་འབད་ཡོད་པའི་ཨེབ་རྟའི་འོག་ལུ་གྱིབ་མ་སྟུག་པ་པ་ཡང་མཐོངམ་ཨིན། དེ་གིས་ ག་དེམ་ཅིག་སྦེ་ཁྱོད་ཀྱིས་བཙུགས་ལྡེ་ལུ་ཨེབ་པའི་ཐོག་ལས་ཌའི་ལོག་ཕྱི་ཁར་བཏོན་པ་ཅིན་ ཨེབ་རྟ་འདི་གུ་ཨེབ་དང་ཅོག་འཐད་པའི་སྐོར་ལས་བརྡ་སྟོན་འབདཝ་ཨིན།\</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\04\01010000.xhp	0	help	hd_id3147209				0	dz	མའུསི་བྱ་བའི་དོན་ལུ་མགྱོགས་ཐབས་ལྡེ་མིག་ཚུ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\04\01010000.xhp	0	help	par_id3154749				0	dz	ཁྱོད་ཀྱིས་ མའུསི་ ཡང་ན་ དངོས་པོ་དང་མིང་གུ་ཨེབ་གཏང་འབད་བའི་ཐོག་ལས་སེལ་འཐུ་འབད་དེ་ འདྲུད་ནི་དང་བཀོག་བཞག་ནི་གཉིས་ལག་ལེན་འཐབ་པ་ཅིན་ ཁ་སྐོང་ཅན་གྱི་ལས་འགན་འཛུལ་སྤྱོད་འབད་ནིའི་དོན་ལུ་ སོར་ལྡེ་ \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>བརྡ་བཀོད་ \</caseinline\>\<defaultinline\>ཚད་འཛིན་\</defaultinline\>\</switchinline\> དང་འཕྲལ་འཕྲལ་  \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>གདམ་ཁ་ \</caseinline\>\<defaultinline\>གདམ་ལྡེ་\</defaultinline\>\</switchinline\>ལག་ལེན་འཐབ་བཏུབ། འདྲུད་ནི་དང་བཀོག་བཞག་པའི་སྐབས་ལུ་ལྡེ་མིག་མར་བཟུངམ་ད་ ལེགས་བཅོས་འབད་ཡོད་པའི་ལས་འགན་ཚུ་ཡོད་མི་ཚུ་ མའུསི་དཔག་བྱེད་བསྒྱུར་བཅོས་རྣམ་པ་གིས་བརྡ་སྟོན་འབདཝ་ཨིན། ཡིག་སྣོད་ ཡངན་ དངོས་པོ་གཞན་ཚུ་སེལ་འཐུ་འབད་བའི་སྐབས་ ལེགས་བཅོསཔ་ལྡེ་མིག་གིས་ སེལ་འཐུ་རྒྱ་བསྐྱེད་འབད་ཚུགས་-ལས་འགན་ཚུ་འཇུག་སྤྱོད་འབད་བཏུབ་སར་བཤདཔ་ཨིན། \<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>\<embedvar href=\"text/shared/00/00000099.xhp#winmanager\"/\>\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
