helpcontent2	source\text\shared\explorer\database\main.xhp	0	help	par_idN10838				0	dz	གནད་སྡུད་གཞི་རྟེན་ཡིག་སྣོད་གསརཔ་ཅིག་  གསར་བསྐྲུན་འབད་ནི་ལུ་   \<emph\>ཡིག་སྣོད་ - གསརཔ་ - གནད་སྡུད་གཞི་རྟེན་\</emph\>གདམ་ཁ་རྐྱབས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\main.xhp	0	help	par_idN1083B				0	dz	\<link href=\"text/shared/explorer/database/dabawiz00.xhp\"\>གནད་སྡུད་གཞི་རྟེན་ཝི་ཛརཌི་གིས་  \</link\> གནད་སྡུད་གཞི་རྟོན་ཡིག་སྣོད་ཅིག་གསར་བསྐྲུན་འབད་ནི་དང་   %PRODUCTNAME  ནང་འཁོད་ གནད་སྡུད་གཞི་རྟེན་གསརཔ་ཅིག་ཐོ་འགོད་འབད་ནི་ལུ་གྲོགས་རམ་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\main.xhp	0	help	par_idN107E7				0	dz	གནད་སྡུད་གཞི་རྟེན་དེ་གིས་  འདྲི་དཔྱད་དང་སྙན་ཞུ་ཚུ་  དེ་ལས་   གནད་སྡུད་གཞི་རྟེན་དོན་ལུ་ རྣམ་པ་ཚུ་དང་  ཐོ་འགོད་ཚུ་གསོག་འཇོག་འབད་དེ་ཡོད་ས་ལུ་  གནད་སྡུད་གཞི་རྟེན་གྱི་འབྲེལ་མཐུད་ཚུ་ཡོདཔ་ཨིན།  རྩ་སྒྲིག་འབད་བའི་བརྡ་དོན་འདི་ཡང་  གནད་སྡུད་གཞི་རྟེན་ཡིག་སྣོད་ནང་ལུ་གསོག་འཇོག་འབད་དེ་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\main.xhp	0	help	par_idN1084A				0	dz	གནད་སྡུད་གཞི་རྟེན་ཡིག་སྣོད་ཅིག་ཁ་ཕྱེ་ནི་ལུ་  \<emph\>ཡིག་སྣོད་ -ཁ་ཕྱེ་\</emph\>གདམ་ཁ་རྐྱབས།  \<emph\>File type\</emph\>ཐོ་ཡིག་སྒྲོམ་ནང་  \<item type=\"literal\"\>གནད་སྡུད་གཞི་རྟེན་ཡིག་ཆ་\</item\>རྐྱངམ་ཅིག་མཐོང་ནིའི་དོན་ལུ་  སེལ་འཐུ་འབད།  གནད་སྡུད་གཞི་རྟེན་ཡིག་ཆ་འདི་སེལ་འཐུ་འབད་དེ་  \<emph\>Open\</emph\>ཨེབ་གཏང་།				2002-02-02 02:02:02
