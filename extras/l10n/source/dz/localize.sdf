helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3153669				0	dz	ཁྱོད་ཀྱིས་ ས་སྒོ་ཚུ་ཨེཆ་ཊི་ཨེམ་ཨེལ་ཡིག་ཆ་སྦེ་ཡོད་པའི་ཡིག་ཆ་ཅིག་བཙུགས་པའི་སྐབས་ལུ་$[officename] ཚེས་གྲངས་དང་ ཆུ་ཚོད་ དེ་ལས་ ཌོག་བརྡ་དོན་ས་སྒོ་ཚུ་དམིགས་གསལ་གྱི་ཨེཆ་ཊི་ཨེམ་ཨེལ་ངོ་རྟགས་ཚུ་ལུ་ རང་བཞིན་གྱིས་གཞི་བསྒྱུར་འབདཝ་ཨིན། ས་སྒོའི་ནང་དོན་ཚུ་ གཞི་བསྒྱུར་འབད་ཡོད་པའི་ཁ་ཕྱེ་ནི་དང་ཁ་བསྡམ་ནིའི་ཨེཆ་ཊི་ཨེམ་ཨེལ་ངོ་རྟགས་ཀྱི་བར་ན་ལུ་བཙུགས་ཡོདཔ་ཨིན། དམིགས་གསལ་གྱི་ ཨེཆ་ཊི་ཨེམ་ཨེལ་ངོ་རྟགས་འདི་ཚུ་གིས་ ཨེཆ་ཊི་ཨེམ་ཨེལ་ངོ་རྟགས་ཚད་ལྡན་དང་་ཆ་མི་མཉམ།				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3152960				0	dz	$[officename] རྩོམ་འབྲི་པའི་ས་སྒོ་ཚུ་ ཨེཆ་ཊི་ཨེམ་ཨེལ་ཡིག་ཆ་ཅིག་ནང་གི་ <SDFIELD>ངོ་རྟགས་ཀྱིས་ངོས་འཛིན་འབདཝ་ཨིན། ས་སྒོའི་དབྱེ་བ་དང་ རྩ་སྒྲིག་ དེ་ལས་ དམིགས་གསལ་གྱི་ས་སྒོ་གི་མིང་དེ་ཚུ་ ཨེཆ་ཊི་ཨེམ་ཨེལ་ངོ་རྟགས་འགོ་བཙུགས་ནང་ལུ་བཙུགས་ཏེ་ཡོདཔ་ཨིན། ཨེཆ་ཊི་ཨེམ་ཨེལ་ཚགས་མ་གིས་ངོས་འཛིན་འབད་ཡོད་པའི་ས་སྒོའི་ངོ་རྟགས་ཅིག་གི་རྩ་སྒྲིག་དེ་ ས་སྒོའི་དབྱེ་བ་དང་བསྟུན་དགོཔ་ཨིན། 				2002-02-02 02:02:02
