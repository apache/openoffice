helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3154944				0	dz	\<ahelp hid=\"HID_PROP_CYCLE\"\>འགྲུལ་བསྐྱོདཔ་དེ་  ཨེབ་ལྡེ་ལག་ལེན་འཐབ་ཐོག་ལས་  ག་དེ་སྦེ་  འབད་དགོཔ་ཨིན་ན་ཚུ་  གཏན་འབེབས་བཟོཝ་ཨིན།\</ahelp\>ཨེབ་ལྡེ་  ལག་ལེན་འཐབ་ཐོག་ལས་  ཁྱོད་ཀྱི་འབྲི་ཤོག་ནང་  གདོང་ཁར་ལུ་  སྤོ་བཤུད་འབད་བཏུབ།  ཁྱོད་ཀྱི་དུ་མཉམ་དུ་  སོར་ལྡེ་འདི་ལུ་  ཨེབ་གཏང་འབད་བ་ཅིན་  འགྲུལ་བསྐྱོདཔ་འདི་གིས་  འགལ་ཟླ་ཁ་ཕྱོགས་ཀྱི་  རྗེས་སུ་འབྲངམ་ཨིན།  ཁྱོད་ཀྱི་མཇུག་གི་ (ཡང་ན་ མགོའི་) ས་སྒོ་དེ་ནང་ལྷོད་པ་ཅིན་  ཨེལ་ལྡེ་འདི་  ལེག་སྟེ་རང་  ཨེབ་གཏང་འབད།  འདི་ལུ་འདྲ་མིན་སྣ་ཚོགས་ཀྱི་  ནུས་པ་འདི་ཚུ་འོང་།  འོག་གི་གདམ་ཁ་ཚུ་དང་གཅིག་ཁར་  ཚད་འཛིན་ཁྱི་ལྡེ་མིག་དེ་  ངེས་འཛིན་འབད།				2002-02-02 02:02:02
