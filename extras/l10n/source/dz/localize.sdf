helpcontent2	source\text\shared\guide\xsltfilter.xhp	0	help	par_idN10927				0	dz	%PRODUCTNAME \<link href=\"text/shared/00/00000021.xhp\"\>འདི་གིས་ཨེཀསི་ཨེམ་ཨེལ་རྩ་སྒྲིག་ནང་ཡིག་ཆ་ཚུ་བསག་བཞགཔ་ཨིན།\</link\>. ཁྱོད་ཀྱིས་རྩ་སྒྲིག་གཞན་མི་ནང་ལུ་%PRODUCTNAMEགིས་ལག་ལེན་འཐབ་ཡོད་མི་རང་ཡུལ་ཁ་ཕྱེ་ཡིག་ཆ་ཨེཀསི་ཨེམ་ཨེལ་ཡིག་སྣོད་རྩ་སྒྲིག་གཞི་བསྒྱུར་འབད་མི་སྲོལ་སྒྲིག་འབད་ཡོད་མི་ཚགས་མ་ཚུ་གསར་བསྐྲུན་འབད་ཚུགས། འ་ནི་ཚགས་མ་ཚུ་%PRODUCTNAMEནང་ལུ་ཚེམས་སྲུབས་མེད་པའི་ཐོག་ལས་མཉམ་སྒྲིལ་འབད་ཚུགས་དེ་འབདཝ་ལས་ཁྱོད་ཀྱིས་འ་ནི་རྩ་སྒྲིག་ཚུ་དྭངས་གསལ་ཅན་སྦེ་མངོན་གསལ་ཡང་ན་སྲུང་བཞག་འབད་ཚུགས།  				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\xsltfilter.xhp	0	help	par_idN1093A				0	dz	ཨེཀསི་ཨེམ་ཨེལ་ཚགས་མ་གསར་བསྐྲུན་འབད་ནི་ལུ་ ཁྱོད་ལུ་ཨེཀསི་ཨེམ་ཨེལ་དང་ཨེཀསི་ཨེསི་ཨེལ་ཊི་བསམ་གཞི་ཚུ་གི་གོ་བ་ལེགས་ཤོམ་ཅིག་ངེས་པར་དུ་དགོ། འ་ནི་བསམ་གཞི་འདི་ཚུ་གྲོགས་རམ་འདི་གི་འོས་སྐབས་ལས་ལྷགཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\xsltfilter.xhp	0	help	par_idN1093D				0	dz	ཨེཀསི་ཨེམ་ཨེལ་ཚགས་མ་འདི་ལུ་\<emph\>ཨེཀསི་ཨེསི་ཨེལ་ཊི་སྐད་ཡིག་ནང་འབྲི་ཡོད་མི་བཟོ་རྣམ་འབྲི་ཤོག་ཚུ་ནང་ན་ཡོདཔ་ཨིན།\</emph\>བཟོ་རྣམ་འབྲི་ཤོག་འདི་གིས་ཕྱིར་འདྲེན་དང་ནང་འདྲེན་ཚགས་མ་ཚུ་བརྒྱུད་དེ་ཨེཀསི་ཨེམ་ཨེལ་རྩ་སྒྲིག་གཞན་མི་ལུ་ཁ་ཕྱེ་ཡིག་ཆ་ཡིག་སྣོད་རྩ་སྒྲིག་ལས་བཟོ་བསྒྱུར་ངེས་འཛིན་འབདཝ་ཨིན། ཨེཀསི་ཨེམ་ཨེལ་ཚགས་མ་ལུ་དབྱེ་བ་གསུམ་ཡོད་:				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\xsltfilter.xhp	0	help	par_idN10947				0	dz	\<emph\>ནང་འདྲེན་ཚགས་མ་ཚུ་གིས་ཕྱིའི་ཨེཀསུ་ཨེམ་ཨེལ་ཡིག་སྣོད་ཚུ་མངོན་གསལ་འབདཝ་ཨིནམ་དང་\</emph\>ཁ་ཕྱེ་ཡིག་ཆ་ཨེཀསེ་ཨེམ་ཨེལ་ཡིག་སྣོད་རྩ་སྒྲིག་ནང་ལུ་ཡིག་སྣོད་ཚུ་གི་རྩ་སྒྲིག་བཟོ་བསྒྱུར་འབདཝ་ཨིན། ཁྱོད་ཀྱིས་ནང་འདྲེན་ཚགས་མ་གཞི་བཙུགས་འབད་བའི་ཤུལ་ལས་ ཚགས་མ་གི་མིང་འདི་ \<link href=\"text/shared/01/01020000.xhp\"\>ཡིག་སྣོད་ཁ་ཕྱེ་ཌའི་ལོག་ནང་ཡིག་སྣོད་དབྱེ་བ་ཚུ་གི་ཐོ་ཡིག་ལུ་ཁ་སྐོང་འབདཝ་ཨིན།\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\xsltfilter.xhp	0	help	par_idN10960				0	dz	\<emph\>ཕྱིར་འདྲེན་ཚགས་མ་ཚུ་གིས་\</emph\>ཁ་ཕྱེ་ཡིག་ཆ་ཨེཀསི་ཨེམ་ཨེལ་ཡིག་སྣོད་ཚུ་བཟོ་བསྒྱུར་འབདཝ་ཨིནམ་དང་ཡིག་སྣོད་ཚུ་ཨེཀསི་ཨེམ་ཨེལ་རྩ་སྒྲིག་སོ་སོ་ལུ་སྲུང་བཞག་འབདཝ་ཨིན། \<emph\>ཁྱོད་ཀྱིས་ཕྱིར་འདྲེན་ཚགས་མ་འདིགཞི་བཙུགས་འབད་བའི་ཤུལ་ལས་\</emph\> ཚགས་མ་གི་མིང་འདི་ཕྱིར་འདྲེན་ཌའི་ལོག་ནང་ \<link href=\"text/shared/01/01070001.xhp\"\>ཡིག་སྣོད་དབྱེ་བ་ཚུ་གི་ཐོ་ཡིག་ལུ་ཁ་སྐོང་འབདཝ་ཨིན། \</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\xsltfilter.xhp	0	help	par_idN10979				0	dz	\<emph\>ནང་འདྲེན་/ཕྱིར་འདྲེན་ཚགས་མ་ཚུ་\</emph\>ཨེཀསི་ཨེམ་ཨེལ་རྩ་སྒྲིག་སོ་སོ་ནང་ལུ་ \<emph\>ཁ་ཕྱེ་ཡིག་ཆ་ཨེཀསི་ཨེམ་ཨེལ་ཡིག་སྣོད་ཚུ་མངོན་གསལ་དང་སྲུང་བཞག་འབད།\</emph\>ཁྱོད་ཀྱིས་ཚགས་མ་འདི་ཚུ་གཞི་བཙུགས་འབད་བའི་ཤུལ་ལས་ ཚགས་མ་ཚུའི་མིང་ཚུ་ཡིག་སྣོད་ཁ་ཕྱེ་ཌའི་ལོག་ནང་ཡིག་སྣོད་དབྱེ་བ་ཚུ་གི་ཐོ་ཡིག་ལུ་ཁ་སྐོང་འབདཝ་ཨིནམ་དང་ \<link href=\"text/shared/01/01020000.xhp\"\>ཡིག་སྣོད་འདི་\</link\> ཌའི་ལོག་བཟུམ་སྦེ་ \<link href=\"text/shared/01/01070000.xhp\"\>སྲུང་བཞགཔ་ཨིན།\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\xsltfilter.xhp	0	help	par_idN10B39				0	dz	\<link href=\"http://www.w3.org/Style/XSL/\"\>རྒྱ་བསྐྱེད་ཅན་གྱི་  \<emph\>སི་ཊ་ཡེལ་ཤིཊ་\</emph\> སྐད་ཡིག་ (ཨེཀསི་ཨེསི་ཨེལ་)གུ་ འཛམ་གླིང་ཡོངས་འབྲེལ་གནས་སྐབསཚོགས་སྡེ་ཤོག་ལེབ་ཚུ།\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\xsltfilter.xhp	0	help	par_idN10B4E				0	dz	\<link href=\"http://www.w3.org/XML/\"\>རྒྱ་བསྐྱེད་ཅན་གྱི་རྟགས་བཀོད་སྐད་ཡིག་(ཨེཀསི་ཨེམ་ཨེལ་)གུ་འཇམ་གླིང་ཡོངས་འབྲེལ་གནས་སྐབས་ཚོགས་སྡེ་ཤོག་ལེབ་ཚུ།\</link\>				2002-02-02 02:02:02
