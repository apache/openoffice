helpcontent2	source\text\shared\02\01170000.xhp	0	help	par_id3154572				0	dz	\<ahelp hid=\".uno:GroupBox\"\> སྣ་མང་ཚད་འཛིན་ཚུ་སྡེ་ཚན་མཐོང་ཚུགསཔ་བཟོ་ནི་དོན་ལུ་  གཞི་ཁྲམ་ཅིག་གསར་བསྐྲུན་འབདཝ་ཨིན།  \</ahelp\> སྡེ་ཚན་གྱི་སྒྲོམ་ཚུ་གིས་ཁྱོད་ལུ་  གཞི་ཁྲམ་ནང་ལུ་  གདམ་ཁའི་ཨེབ་ལྡེ་ཚུ་སདེ་ཚན་བཟོ་བཅུགསཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170000.xhp	0	help	par_id3148394				0	dz	ཁྱོད་ཀྱིས་ཡིག་ཅ་ནང་ལུ་  ཚྡེ་ཚན་གྱི་གཞི་ཁྲམ་འདི་བཙུགས་པ་ཅིན་  ཁྱོད་ལུ་ སྡེ་ཚན་གདམ་ཁ་འདི་འཇམ་ཏོག་ཏོ་སྦེ་ གསར་བསྐྲུན་འབད་བཅུག་མི་\<link href=\"text/shared/autopi/01120000.xhp\" name=\"Group Element Wizard\"\>ཆ་ཤས་ཝི་ཛརཌི་འདི་ཚྡེ་ཚན་བཟོ་ཟེར་མི་འདི་\</link\>འགོ་བཙུགསཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170000.xhp	0	help	par_id3150567				0	dz	\<emph\>དྲན་འཛིན།:\</emph\>ཁྱོད་ཀྱི་སྡེ་ཚན་གྱི་སྒྲོམ་འདི་  ཧེ་མ་ལས་རང་ ཡོད་བཞིན་པའི་ཚད་འཛིན་གྱི་  ལྟག་ལས་ཕར་  འདྲུད་བཞག་འབད་ཞིནམ་ལས་  ཚད་འཛིན་ཅིག་སེལ་འཐུ་འབད་དགོ་པ་ཅིན་  ཁྱོད་ཀྱི་དང་པ་རང་  སྡེ་ཚན་སྒྲོམ་གྱི་སྐབས་དོན་དཀར་ཆག་དེ་  ཕྱེ་ཞིནམ་ལས་\<emph\>བདེ་ཞིབ་- རྒྱབ་ལོག་གཏང་ནི་\</emph\>དེ་གདམ་ཁ་རྐྱབ་དགོ  དེ་ལས་  \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>བརྡ་བཀོད་ \</caseinline\>\<defaultinline\>ཚད་འཛིན་ལུ་\</defaultinline\>\</switchinline\>མར་་མནན་འབད་བའི་སྐབས་  ཚད་འཛིན་དེ་  སེལ་འཐུ་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170000.xhp	0	help	par_id3145615				0	dz	སྡེ་ཚན་གྱི་སྒྲོམ་འདི་ཚུ་ མཐོང་བའི་འཆར་སྣང་གི་དོན་ལུ་རྐྱངམ་ཅིག་ལག་ལེན་འཐབ་ཨིན།   གདམ་ཁ་ས་སྒོ་ཆ་མཉམ་གྱི་རྒྱུ་དངོས་ཀྱི་མིང་ཚུ་གི་འོག་ལུ་ \<link href=\"text/shared/02/01170101.xhp\" name=\"Name\"\>\<emph\> གདམ་ཁ་ས་སྒོ་ཚུ་གི་  ལས་འགན་གྱི་སྡེ་ཚན་བཟོ་ནི་འདི་\</emph\>\</link\> མིང་གི་ངེས་ཚིག་བརྒྱུད་དེ་བཟོ་བཏུབ་ཨིན་  སྡེ་ཚན་སྦེ་བཟོ་ནིའི་དོན་ལུ་ མིང་གེ་ར་ཅོག་འཐདཔ་སྦེ་ཐོ་བཀོད་འབད། 				2002-02-02 02:02:02
