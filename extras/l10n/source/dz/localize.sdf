helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_idN107A4				0	dz	\<ahelp hid=\".\"\>དེ་གིས་པི་ཌི་ཨེཕ་ངོ་རྟགས་ཚུ་འབྲ་ནི་ལུ་སེལ་འཐུ་འབདཝ་ཨིན།  འདི་གིས་ཡིགསྣོད་ཀྱི་ཚད་འདི་  སྦོམ་སྦེ་འཛེགས་འགྱོཝ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_idN107B3				0	dz	ངོ་རྟགས་སྦྱར་ཡོད་པའི་པི་ཌི་ཨེཕ་དེ་ལུ་  ཡིག་ཆའི་ནང་དོན་ཚུ་གི་གཞི་བཀོད་ཀྱི་སྐོར་ལས་བརྡ་དོན་ཡོདཔ་ཨིན།  འདི་གིས་སྦེ་ཡིག་ཆ་འདི་   གསལ་གཞི་སོ་སོ་ཚུ་དང་ཅིག་ཁར་ཐབས་འཕྲུལ་དང་  གསལ་གཞི་ལྷག་བྱེད་མཉེན་ཆས་ལག་ལེན་འཐབ་ད་གུ་བཀྲམ་སྟོན་འབད་བཏུབ།				2002-02-02 02:02:02
