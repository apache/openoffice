helpcontent2	source\text\shared\00\00000005.xhp	0	help	par_id3155854				0	dz	སྒོ་སྒྲིག་འདི་ཌོཀཊི་འབད་ཡོད་པའི་ སྒོ་སྒྲིག་ག་ཅི་འབད་རུང་ཅིག་གི་མཐའམ་ལུ་  ཁྱོད་ལུ་སྒོ་སྒྲིག་སྟོན་ནི་ ཡང་ཅིན་ སྦ་བཅུགས་མི་གི་ཨེབ་རྟ་ཅིག་ཁྱོད་ཀྱིས་མཐོངམ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000005.xhp	0	help	par_id3143274				0	dz	ཁྱོད་ཀྱིས་ སྒོ་སྒྲིག་སྟོན་ནིའི་དོན་ལས་ སྒོ་སྒྲིག་གི་མཐའམ་གུ་ཡོད་པའ་ཨེབ་རྟ་འདི་ཨེབ་གཏང་པ་ཅིན་ སྒོ་སྒྲིག་དེ་གིས་  ཁྱོད་ཀྱི་ལག་ཐོ་ལས་མ་སྦ་ཚུན་ཚོད་ མཐོང་ཚུགསཔ་འབད་ལུསཔ་ཨིན། (ཨེབ་རྟ་ཅིག་པ་དང་བཅས།)				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000005.xhp	0	help	par_id3153093				0	dz	ཁྱོད་ཀྱིས་ སྒོ་་སྒྲིག་འདི་ ཨེབ་རྟ་མེན་པར་ སྒོ་སྒྲིག་གི་མཐའམ་ཨེབ་སྦེ་སྟོན་པ་ཅིན་  ཁྱོད་ཀྱིས་\<emph\>རང་བཞིན་གྱི་སྦ་\</emph\> ལས་འགན་དེ་ཤུགས་ལྡན་བཟོ། རང་བཞིན་གྱི་ལས་འགན་དེ་གིས་ དེ་གི་མཐའམ་ལུ་ཨེབ་སྟེ་ ཁྱོད་ལུ་ གནས་སྐབས་ཀྱི་སྦ་འདི་ཡོད་མི་སྒོ་སྒྲིག་སྟོནམ་ཨིན།  ཁྱོད་ཀྱིས་ཡིག་ཆ་ནང་ལུ་ཨེབ་གཏང་པའི་བསྒང་  ལོག་འདི་རང་ཌོཀཊི་སྒོ་སྒྲིག་སྦ་ནཞགཔ་ཨིན།				2002-02-02 02:02:02
