helpcontent2	source\text\shared\02\02140000.xhp	0	help	par_id3152996				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>  \<emph\>འགོ་མཚམས་ཡར་འཕར་\</emph\> ངོས་དཔར་འདི་ \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>བརྡ་བཀོད་ལྡེ་མིག་\</caseinline\>\<defaultinline\>ཚད་འཛིན་ལྡེ་མིག་\</defaultinline\>\</switchinline\> འདི་འཆང་བཞག་པའི་སྐབས་  \<link href=\"text/shared/optionen/01040200.xhp\" name=\"Tools - Options - Writer - General\"\>\<emph\>ལག་ཆས་ཚུ་ - གདམ་ཁ་ཚུ་ - %PRODUCTNAME རྩོམ་འབྲི་པ་ - ཡོངས་ཁྱབ་\</emph\>\</link\>གི་འོག་ལུ་ གཞི་སྒྲིག་འབད་ཡོད་པའི་ སྔོན་སྒྲིག་མཆོང་ལྡེ་གྱང་ཚད་ཀྱིས་ སེལ་འཐུ་འབད་ཡོད་པའི་འགོ་མཚམས་འདི་ སྤོ་བཤུད་འབད་ནིའི་དོན་ལས་ ཨེབ་གཏང་།\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
