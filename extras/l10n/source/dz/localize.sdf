helpcontent2	source\text\shared\guide\text_color.xhp	0	help	par_id3149795				0	dz	འོག་གི་འདི་\<item type=\"productname\"\>%PRODUCTNAME\</item\> རྩོམ་འབྲི་པ་རྐྱངམ་ཅིག་ལུ་འཇུག་སྤྱོད་འབདཝ་ཨིན་: ཁྱོད་ཀྱིས་ཚིག་ཡིག་སེལ་འཐུ་མ་འབད་བའི་སྐབས་ལུ་ཨེབ་གཏང་ཐུང་ཀུ་དང་གཅིག་ཁར་ངོས་དཔར་ཨེབ་གཏང་པ་ཅིན་ དེ་ལས་མཱའུསི་དཔག་བྱེད་དེ་གི་འབྱུང་སྣང་བསྒྱུར་བཅོས་འབདཝ་ཨིནམ་དང་པེནཊི་ཀེན་བཟུམ་སྦེ་བཀྲམ་སྟོན་འབདཝ་ཨིན། ཚིག་ཡིག་མངའ་ཁོངས་ཀྱི་ཡན་ཆད་འདྲུད་ནི་ལུ་མཱའུསི་ལྡེ་མིག་ཨེབ་པ་གཅིག་ཁར་པེནཊི་ཀེན་བརྡ་མཚོན་འདི་ལག་ལེན་འཐབ། འ་ནི་མངའ་ཁོངས་འདི་གིས་སེལ་འཐུ་འབད་ཡོད་པའི་ཚོས་གཞི་འབགཔ་ཨིན། ལས་འགན་འདི་ངོས་དཔར་མ་ཨེབ་ཚུན་ཚོད་དང་ཁྱོད་ཀྱིས་མ་འདྲུད་པར་ཨེབ་གཏང་མ་འབདཝ་ཚུན་ཚོད་ཡང་ན་ཁྱོད་ཀྱིས་ཐར་ལྡེ་མ་ཨེབ་ཚུན་ཚོད་དུས་ཡུན་རིངམ་སྦེ་ཤུགས་ལྡན་སྦེ་ལུསཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\text_color.xhp	0	help	par_id3145120				0	dz	འོག་གི་(\<item type=\"productname\"\>%PRODUCTNAME\</item\> རྩོམ་འབྲི་པ་ ཀེལསི་ ཨིམ་པེརེསི་)འདི་ཚད་གཞི་ཚུ་ཆ་མཉམ་ལུ་འཇུག་སྤྱོད་འབདཝ་ཨིན་: ཚོས་གཞི་གཞན་མི་འབག་ནི་ཨིན་མི་ཚིག་ཡིག་སེལ་འཐུ་འབད་ དེ་ལས་ཁྱོད་ལུ་ལག་ཆས་ཕྲ་རིང་གུ་དགོ་མི་ཚོས་གཞི་ཨེབ་གཏང་། 				2002-02-02 02:02:02
