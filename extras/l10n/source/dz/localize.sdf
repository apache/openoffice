helpcontent2	source\text\shared\01\05040200.xhp	0	help	par_id3154380				0	dz	\<ahelp hid=\"SVX_LISTBOX_RID_SVXPAGE_PAGE_LB_TEXT_FLOW\"\>ཁྱོད་ཀྱིས་ཁྱོད་རའི་ཡིག་ཆ་ནང་ལུ་ ལག་ལེན་འཐབ་དགོ་པའི་ ཚིག་ཡིག་བཀོད་རྒྱ་འདི་སེལ་འཐུ་འབད།  \</ahelp\> The "right-to-left (vertical)"མགོ་ཡིག་དང་མཇུག་ཡིག་མ་ཡིན་པ་གཞན་   ཚིག་ཡིག་འབབ་རྒྱུན་བཀོད་རྒྱ་དེ་གིས་  དབྱེ་རིམ་ ༩༠་  གིས་  གཡས་ལུ་སྦེ་  སྒྲིག་བཀོད་སྒྲིག་སྟངས་ཚུ་ཆ་མཉམ་བསྒྱིརཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05040200.xhp	0	help	hd_id3156327				0	dz	ཤོག་ལེབ་ཀྱི་ཤོག་སྣོད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05040200.xhp	0	help	par_id3150771				0	dz	\<ahelp hid=\"SVX:LISTBOX:RID_SVXPAGE_PAGE:LB_PAPER_TRAY\"\>ཁྱོད་རའི་དཔར་འཕྲུལ་དོན་ལུ་  ཤོག་ལེབ་འབྱུང་ཁུངས་འདི་སེལ་འཐུ་འབད།  ཁྱོད་རང་དགོ་པ་ཅིན་  ཁྱོད་ཀྱིས་  ཤོག་ལེབ་ཤོག་སྣོད་སོ་སོ་དེ་ཚུ་  ཤོག་ལེབ་བཟོ་རྣམ་སོ་སོ་ལུ་འགན་སྤྲོད་འབད་བཏུབ་ཨིན།  དཔེར་ན་   ཤོག་སྣོད་སོ་སོ་ཚུ་  ཤོག་ལེབ་དང་པའི་བཟོ་རྣམ་ལུ་འགན་སྤྲོད་འབད་ནི་དང་   ཤོག་སྣོད་འདི་  ཁྱོད་རའི་ཚོང་ལྡེའི་ཡིག་གུའི་མགོ་གི་ཤོག་ལེབ་དང་བཅས་ མངོན་གསལ་འབད། \</ahelp\>				2002-02-02 02:02:02
