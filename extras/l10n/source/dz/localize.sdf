helpcontent2	source\text\swriter\01\04120100.xhp	0	help	par_id3149484				0	dz	\<ahelp hid=\"HID_INSERT_IDX_MRK_PHONETIC_READING\"\>ཆ་མཉམ་པའི་ཐོ་འགོད་ཀྱི་དོན་ལུ་ སྒྲ་རྟགས་ལྷག་ནི་དེ་ཐོ་བཀོད་འབད། དཔེ་འབད་བ་ཅིན་ ཇ་པ་ནིསི་ཀན་ཇི་ཡིག་འབྲུ་དེ་ལུ་བརྗོད་སྒྲ་གཅིག་ལས་ལྷག་སྟེ་ཡོད་པ་ཅིན་ བརྗོད་སྒྲ་བདེན་མི་དེ་ ཀ་ཊ་ཀ་ན་ཡིག་འབྲུ་སྦེ་ཐོ་བཀོད་འབད། ཀན་ཇི་ཡིག་འབྲུ་དེ་དེ་ལས་ སྒྲ་རྟགས་ལྷག་ནིའི་ཐོ་འགོད་དང་འཁྲིལ་ཏེ་དབྱེ་སེལ་འབད་དོ་ཡོདཔ་ཨིན། \</ahelp\>  ཨེ་ཤི་ཡན་ཁ་སྐད་རྒྱབ་སྐྱོར་འདི་ལྕོགས་ཅན་བཟོ་བ་ཅིན་རྐྱངམ་ཅིག་ གདམ་ཁ་འཐོབ་ཚུགསཔ་ཨིན།				2002-02-02 02:02:02
