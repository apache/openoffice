helpcontent2	source\text\shared\01\06140200.xhp	0	help	par_id3149811				0	dz	\<ahelp hid=\"HID_ACCELCONFIG_LISTBOX\"\>འབྲེལ་བ་ཡོད་པའི་བརྡ་བཀོད་དང་  མགྱོགས་ཐབས་ལྡེ་མིག་ཚུ་ ཐོ་ཡིག་བརྐྱབ་ཨིན།   \<emph\>ལས་འགན་\</emph\> ཐོ་ཡིག་ནང་ལུ་ སེལ་འཐུ་འབད་ཡོད་པའི་བརྡ་བཀོད་དོན་ལུ་  མགྱོགས་ཐབས་ལྡེ་མིག་འདི་ལེགས་བཅོས་འབད་ནི་  ཡང་ན་  འགན་སྤྲོད་འབད་ནི་དོན་ལུ་ ཐོ་ཡིག་འདི་ནང་གི་མགྱོགས་ཐབས་ཅིག་ཨེབ་གཏང་ནི་དང་   དེ་ལས་ \<emph\>ལེགས་བཅོས་འབད་\</emph\>འདི་ཨེབ་གཏང་འབད།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06140200.xhp	0	help	hd_id3157909				0	dz	ལས་འགན་ཚུ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06140200.xhp	0	help	par_id3155388				0	dz	ཁྱོད་ཀྱིས་མགྱོགས་ཐབས་ལྡེ་མིག་འདི་འགན་སྤྲོད་འབདཝ་ད་  ལས་འགན་གྱི་དབྱེ་རིམ་ཚུ་དང་  $[officename]ལས་འགན་ཚུ་ཐོ་ཡིག་བརྐྱབ་ཨིན།				2002-02-02 02:02:02
