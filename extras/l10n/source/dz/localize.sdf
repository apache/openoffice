helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id6092715				0	dz	\<ahelp hid=\"HID_PROP_REPEAT_DELAY\"\> ཡང་བསྐྱར་འབད་མི་བྱུང་ལས་ཚུ་གི་བར་ནའི་ མི་ལི་སྐར་ཆག་གི་ནང་ ཕྱིར་འགྱངས་འདི་གསལ་བཀོད་འབདཝ་ཨིན། \</ahelp\> ཁྱོད་ཀྱི་མདའ་རྟགས་ཀྱི་ཨེབ་རྟ་ཅིག་  ཡང་ན་བཤུད་ཕྲ་གི་རྒྱབ་གཞི་ཅིག་ ཡང་ན་དྲན་ཐོ་འགྲུལ་བསྐྱོདཔ་ཨེབ་རྟ་ཚུ་ལུ་ ཨེབ་གཏང་འབདཝ་ད་ ཡང་བསྐྱར་འབད་མི་གི་བྱུང་ལས་འདི་ བྱུངམ་ཨིནམ་དང་  དེ་ལས་ཁྱོད་ཀྱི་དུས་ཡུན་དུམ་གྲ་ཅིག་གི་དོན་ལུ་ མའུསི་གི་ཨེབ་རྟ་འདི་ མར་མནན་འབད་འདི་བཞག   ཁྱོད་ཀྱི་ནུས་ཅན་ཆུ་ཚོད་ཆ་ཕྲན་གྱི་རྗེས་གྲངས་པའི་ གནས་གོང་ཅིག་ཐོ་བཀོད་འབད། དཔེར་ན་  ༢ཨེསི་ཡང་ན་༥༠༠ཨེམ་ཨེསི་བཟུམ།				2002-02-02 02:02:02
