helpcontent2	source\text\shared\01\06040300.xhp	0	help	par_id3154749				0	dz	\<ahelp hid=\"OFFMGR:EDIT:RID_OFAPAGE_AUTOCORR_EXCEPT:ED_DOUBLE_CAPS\"\>ཁྱོད་ཀྱིས་ $[officename] འདི་  འགོ་ཐོག་ཚུགས་ཡིག་གཅིག་ལུ་བསྒྱུར་བཅོས་མ་དགོ་པའི་  ཚུགས་ཡིག་ཡིག་གུ་གཉིས་དང་བཅས་འགོ་བཙུགས་པའི་  མིང་ཚིག་ཡང་ན་  སྡུད་ཚིག་ འདི་ཡིག་དཔར་བརྐྱབ།  དཔེར་ན་ པི་སི་འདི་ $[officename] པི་སི་ལས་པི་སི་ལུ་   བསྒྱུར་བཅོས་འགྱུར་ནི་འདི་སྔོན་བཀག་འབད་ནི་དོན་ལུ་ ཐོ་བཀོད་འབད།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040300.xhp	0	help	par_id3143271				0	dz	\<ahelp hid=\"OFFMGR:LISTBOX:RID_OFAPAGE_AUTOCORR_EXCEPT:LB_DOUBLE_CAPS\"\>རང་བཞིན་གྱིས་ནོར་བཅོས་མ་འབད་མི་  འགོ་ཐོག་གི་ཚུགས་ཡིགགཉིས་དང་བཅས་འགོ་བཙུགས་པའི་  མིང་ཚིག་ཡངན་  སྡུད་ཚིག་འདི་ཐོ་ཡིག་བརྐྱབ།  ཚུགས་ཡིག་ཡིག་གུ་གཉིས་དང་བཅས་འགོ་བཙུགས་པའི་  མིང་ཚིག་ཚུ་ཆ་མཉམ་རང་  ས་སྒོ་གིནང་ལུ་ཐོ་ཡིག་བརྐྱབ་ཡོད།  \</ahelp\> རྣམ་གྲངས་འདི་ཐོ་ཡིག་ལས་རྩ་བསྐྲད་གཏང་ནི་དོན་ལུ་   རྣམ་གྲངས་འདི་སེལ་འཐུ་འབད་  དེ་ལས་  \<emph\>བཏོན་གཏང་\</emph\>ཨེབ་གཏང་འབད།				2002-02-02 02:02:02
