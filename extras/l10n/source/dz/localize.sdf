helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3163712				0	dz	\<ahelp hid=\"HID_PROP_SORT_CRITERIA\"\>གནད་སྡུད་དེ་  འབྲི་ཤོག་ནང་ལུ་  དབྱེ་སེལ་འབད་ནི་ལུ་  གནས་སྟངས་དེ་ཚུ་  གསལ་བཀོད་འབདཝ་ཨིན།  གནས་སྟངས་ཚུ་  དབྱེ་སེལ་འབད་ནིའི་  གསལ་བཀོད་འདི་གིས་ ORDER BY clauseདེ་ ལག་ལེན་མ་འཐབ་པར་  ཨེསི་ཀིའུ་ཨེལ་གྱི་ ལམ་ལུགས་དེ་ཚུ་གི་  རྗེས་སུ་འབྲངམ་ཨིན།\</ahelp\> དཔེ་ར་ན་  ཁྱོད་ལུ་  གནད་སྡུད་གཞི་རྟེན་དྲན་ཐོ་དེ་ཚུ་  ས་སྒོ་གཅིག་ནང་  ཡར་འཛེགས་གོ་རིམ་དང་  ས་སྒོ་གཞན་མི་ནང་  མར་བབ་གོ་རིམ་ནང་   བསག་བཞག་དགོ་པ་ཅིན་ མིང་དང་པམ་ ASC་དང་  མིང་DESC( མིང་དང་པམ་ཁས་ལེན་ནི་དང་  མིང་དེ་ཚུ་  གནད་སྡུད་ས་སྒོ་ཚུ་གི་ མིང་ཨིན།) ཚུ་ཐོ་བཀོད་འབད།  				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3156444				0	dz	འབྲི་ཤོག་འགྲུལ་བསྐྱོད་པ་ \<link href=\"text/shared/main0213.xhp\" name=\"Form Navigation Bar\"\>\<emph\>ཕྲ་རིང་འདི་གུའི་་\</emph\>་འོས་ལྡན་ངོས་དཔར་ཚུ་ \</link\> ལག་ལེན་པ་ཐབས་ལམ་ནང་དབྱེ་སེལ་ལུ་ལག་ལེན་འཐབ་བཏུབ་ཨིན: \<link href=\"text/shared/02/12010000.xhp\" name=\"Sort Ascending\"\>\<emph\>ཡར་འཛེགས་དབྲེ་སེལ\</emph\>\</link\>, \<link href=\"text/shared/02/12020000.xhp\" name=\"Sort Descending\"\>\<emph\>མར་འབབ་དབྱེ་སེལ་\</emph\>\</link\>, \<link href=\"text/shared/02/12100100.xhp\" name=\"Sort\"\>\<emph\>དབྱེ་སེལ་འབད།\</emph\>\</link\>				2002-02-02 02:02:02
