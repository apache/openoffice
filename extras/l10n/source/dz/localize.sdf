helpcontent2	source\text\simpress\01\13050300.xhp	0	help	par_id3149127	3			0	dz	ཁྱོད་ཀྱིས་དངོས་པོ་ཚུ་གཉིས་ཡང་ན་དེ་ལས་མངམ་སེལ་འཐུ་འབད་འདི་དེ་ཚུ་༣ཌི་ལུ་གཞི་བསྒྱུར་འབད་བ་ཅིན་ གྲུབ་འབྲས་འདི་དངོས་པོ་རྐྱང་པ་སྦེ་ལས་ཚབ་འབད་མི་༣ཌི་སྡེ་ཚན་འདི་ཨིན། ཁྱོད་ཀྱིས་ \<switchinline select=\"appl\"\>\<caseinline select=\"DRAW\"\>\<emph\>རྩ་སྒྲིག་-སྡེ་ཚན་-ཞུན་དག་སྡེ་ཚན་་\</emph\> - \<emph\>ཐོ་བཀོད་སྡེ་ཚན་འདི་་\</emph\>\</caseinline\>\<defaultinline\>\<emph\>ལེགས་བཅོས་འབད་ནི་གདམ་ཁ་རྐྱབ་ཐོག་ལས་སྡེ་ཚན་འདི་ནང་ངོ་རྐྱང་དངོས་པོ་ཚུ་ཞུན་དག་འབད་ཚུགས།\</emph\>\</defaultinline\>\</switchinline\>.ཁྱོད་ཀྱིས་མཇུག་བསྡུཝ་ད་ \<switchinline select=\"appl\"\>\<caseinline select=\"DRAW\"\>\<emph\>ལེགས་བཅོས་ – ཕྱིར་ཐོན་སྡེ་ཚན་\</emph\>\</caseinline\>\<defaultinline\>\<emph\>རྩ་སྒྲིག་ – སྡེ་ཚན་ – ཕྱིར་ཐོན་སྡེ་ཚན་\</emph\>\</defaultinline\>\</switchinline\> གདམ་ཁ་རྐྱབས།				2002-02-02 02:02:02
