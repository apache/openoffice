helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154222				0	dz	གླ་དངུལ་དུས་ཚོད་དེ་ ལོ་ངོ་གསུམ་དང་ དངུལ་རྐྱང་གནས་གོང་དེ་ ༢༥༠༠༠ དངུལ་ཆ་ཕྲན་ཨིན་པ་ཅིན་ ལོ་བསྟར་སྐྱེད་གོང་ཚད་དེ་ ༡་༩༩% ཡོད་པའི་དུས་མཚམས་གླ་དངུལ་ག་ཅི་དང་ག་ཅི་རང་སྨོ? དེ་ཁར་ལུ་ གླ་དངུལ་དུས་ཡུན་ ༣༦ སྦེ་ ཟླཝ་ ༣༦ ཡོདཔ་གི་མ་ཚད་པར་ གླ་དངུལ་དུས་ཡུན་རེ་རེར་སྐྱེད་གོང་ཚད་དེ་ ༡་༩༩%/༡༢ ཨིན་པས།				2002-02-02 02:02:02
