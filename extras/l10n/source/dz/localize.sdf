helpcontent2	source\text\shared\guide\spadmin.xhp	0	help	bm_id3154422				0	dz	\<bookmark_value\>སི་པེཌི་མིན་\</bookmark_value\>\<bookmark_value\>དཔར་འཕྲུལ་ཚུ་; ཁ་སྐོང་བརྐྱབ་དོ་, ཡུ་ནིགསི་\</bookmark_value\>\<bookmark_value\>སྔནོ་སྒྲིག་དཔར་འཕྲུལ་; ཡུ་ནིགསི་\</bookmark_value\>\<bookmark_value\>ཡུ་ནིགསི་གི་འོག་ལུ་ཚད་ལྡན་པའི་དཔར་འཕྲུལ་\</bookmark_value\>\<bookmark_value\>དཔར་འཕྲིན་ཚུ་; དཔར་འཕྲིན་ཚུའི་ལས་རིམ་/ཡུ་ནིགསི་གི་འོག་ལུ་དཔར་འཕྲིན་དཔར་འཕྲུལ་\</bookmark_value\>\<bookmark_value\>དཔར་འཕྲུལ་ཚུ་; ཡུ་ནིགསི་གི་འོག་ལུ་དཔར་འཕྲིན་\</bookmark_value\>\<bookmark_value\>པོསིཊི་སིཀིརིཔཊི་; པི་ཌི་ཨེཕ་གཞི་བསྒྱུར་པ་, ཡུ་ནིགསི་\</bookmark_value\>\<bookmark_value\>གཞི་བསྒྱུར་པ་; པོསིཊི་སིཀིརིཔཊི་, ཡུ་ནིགསི་\</bookmark_value\>\<bookmark_value\>པི་ཌི་ཨེཕ་; པི་ཌི་ཨེཕ་གཞི་བསྒྱུར་པ་ལུ་ པོསོཊི་སིཀིརིཔཊི་, ཡུ་ནིགསི་\</bookmark_value\>\<bookmark_value\>ཡིག་གཟུགས་ཚུ་; ཡུ་ནིགསི་གི་འོག་ལུ་ཁ་སྐོང་བརྐྱབ་དོ་\</bookmark_value\>\<bookmark_value\>ཡིག་བཟོ་; ཡུ་ནིགསི་གི་འོག་ལུ་ཁ་སྐོང་བརྐྱབ་དོ་\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\spadmin.xhp	0	help	hd_id3147834				0	dz	\<variable id=\"spadmin\"\>\<link href=\"text/shared/guide/spadmin.xhp\" name=\"Setting up Printer, Fax and Fonts Under UNIX Based Platforms\"\>མཉེན་རིམ་ཚུ་ལུ་བརྟེན་པའི་ཡུ་ནིགསི་གི་འོག་ལུ་དཔར་འཕྲུལ་དང་དཔར་འཕྲིན་དེ་ལས་ཡིག་གཟུགས་ཚུ་གཞི་སྒྲིག་འབད་དོ།\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\spadmin.xhp	0	help	par_id3159233				0	dz	ཡུ་ནིགསི་ལུ་བརྟེན་པའི་མཉེན་རིམ་ཚུ་གི་འོག་ལུ་ དཔར་འཕྲུལ་བདག་སྐྱོང་ལས་རིམ་ \<emph\>spadmin\</emph\> འདི་ ཁྱོད་ལུ་ དཔར་འཕྲུལ་ཚུ་ དཔར་འཕྲིན་ཚུ་ དང་ཡིག་གཟུགས་ཚུ་  $[officename] མཉེན་ཆས་དང་གཅིག་ཁར་ལག་ལེན་འཐབ་ནིའི་དོན་ལས་གཞི་སྒྲིག་འབད་ནིའི་དོན་ལུ་ བྱིན་ཏེ་ཡོད།				2002-02-02 02:02:02
