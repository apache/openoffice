helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3157320				0	dz	\<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>ཁྱོད་རང་དགོ་པ་ཅིན་  ཨེགསི་དཔར་འཕྲུལ་འཕྲལ་གསོག་ཚུ་སརུངས་བཞག་ཡོད་པའི་  སྣོད་ཐོ་འདི་གསལ་བཀོད་འབད་ནི་དོན་ལུ་  ཁྱོད་ཀྱིས་  STAR_SPOOL_DIR མཐའ་འཁོར་འགྱུར་ཅན་འདི་ལག་ལེན་འཐབ་བཏུབ་ཨིན། དཔེར་ན: \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
