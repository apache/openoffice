helpcontent2	source\text\scalc\01\12040201.xhp	0	help	par_id3152576				0	dz	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_SPEC_FILTER:BTN_REGEXP\"\> ཁྱོད་ལུ་ ཚགཧ་མའི་ངེས་ཚིག་ནང་གི་ ཝའིལ་ཀཌིསི་ ལག་ལེན་འཐབ་བཅུགཔ་ཨིན།\</ahelp\>  $[officename] གིས་རྒྱབ་སྐྱོར་འབད་མི་ དུས་རྒྱུན་གསལ་བརྗོད་འདི་གི་ཐོ་ཡིག་ཅིག་གི་དོན་ལུ་  \<link href=\"text/shared/01/02100001.xhp\" name=\"here\"\>ནཱ་ལུ་\</link\>ཨེབ་གཏང་།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12040201.xhp	0	help	par_id3149377				0	dz	\<emph\>དུས་རྒྱུན་གསལ་བརྗོད་ཀྱི་\</emph\> དཔྱད་སྒྲོམ་འདི་སེལ་འཐུ་འབད་ཡོདཔ་ཨིན་པ་ཅིན་ ཁྱོད་ཀྱིས་ དུས་རྒྱུན་གསལ་བརྗོད་འདི་ གནས་གོང་ས་སྒོ་ནང་ལུ་ གནས་སྟངས་ཐོ་ཡིག་སྒྲོམ་འདི་  '=' མཉམ་པ་ ཡང་ན་ '<>' མཉམ་པ་མིན་པ་ལུ་གཞི་སྒྲིག་འབད་ཡོདཔ་ཨིན་པ་ཅིན་ ལག་ལེན་འཐབ་བཏུབ། འ་ནི་འདི་གི་ ཁྱོད་ཀྱིས་ མཐོ་རིམ་ཚགས་མའི་དོན་ལུ་གཞི་བསྟུན་འབད་མི་ རིམ་བཞིན་ནང་ཐིག་ཚུ་ལུ་ཡང་ འཇུག་སྤྱོད་འབདཝ་ཨིན།				2002-02-02 02:02:02
