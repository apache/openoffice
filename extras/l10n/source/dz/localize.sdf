helpcontent2	source\text\shared\02\12100200.xhp	0	help	par_id3154823				0	dz	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXDLG_SEARCHFORM_RB_SEARCHFORTEXT\"\> སྒྲོམ་ནང་ལུ་འཚོལ་ཞིབ་ཐ་སྙད་བཙུགས་ ཡངན་ ཐོ་ཡིག་ནང་ལས་སེལ་འཐུ་འབད། \</ahelp\>འོད་རྟགས་འོག་གི་ཚིག་ཡིག་འདི་ཧེ་མ་ལས་ར་ \<emph\>ཚིག་ཡིག་\</emph\>ཀོམ་བོ་སྒྲོམ་ནང་ལུ་འདྲ་བཤུས་བརྐྱབས་ཅི། འཚོལ་ཞིབ་འདི་འབྲི་ཤོག་ནང་གཡོག་བཀོལ་བའི་བསྒང་ལུ་ མཆོང་ལྡེ་དང་གྲལ་ཐིག་མཚམས་ཚུ་ལས་སྦྱོར་འབད་མི་ཚུགསཔ་ཨིནམ་སེམས་ཁར་ངེས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12100200.xhp	0	help	par_id3148539				0	dz	ཁྱོད་ཀྱི་འཚོལ་ཞིབ་ཐ་སྙད་འདི་ ཐིག་ཁྲམ་ ཡང་ན་ མན་ངག་ཡིག་ཆ་འདི་ཁ་མ་ཕྱེ་བར་དུ་ སྲུང་བཞག་འབད་དེ་བཞག་འོང་། ཁྱོད་ཀྱིས་ འཚོལ་ཞིབ་གཅིག་ལས་ལྷག་སྟེ་གཡོག་བཀོལ་ནི་དང་ འཚོལ་ཞིབ་ཐ་སྙད་འདི་ཡང་བསྐྱར་འབད་དགོ་མནོ་བ་ཅིན་ ཀོམ་བོ་སྒྲོམ་ནང་ལས་ ཧེ་མ་ལས་ལག་ལེན་འཐབ་ཡོད་པའི་འཚོལ་ཞིབ་ཐ་སྙད་འདི་སེལ་འཐུ་འབད།				2002-02-02 02:02:02
