helpcontent2	source\text\shared\02\01170102.xhp	0	help	par_id3151221	89			0	dz	\<variable id=\"filtervorschlag\"\>\<ahelp hid=\"HID_PROP_FILTERPROPOSAL\"\>ཁྱོད་རའི་འབྲི་ཤོག་ཅིག་ བཀོད་སྒྲིག་འབདཝ་ད་  ཁྱོད་ཀྱི་ཆ་མཉམ་ རྒྱུ་དངོས་ཚུ་གི་གནད་སྡུད་ཨེབ་ལྡེ་གི་ཌའི་ལོག་ནང་ \<emph\>ཚིག་ཡིག་གི་སྒྲོམ་རེ་རེ་བཞིན་གྱི་དོན་ལུ་\</emph\>  "ཚགས་གྲོས་འཆར་"རྒྱུ་དངོས་དེ་\<emph\>གཞི་སྒྲིག་\</emph\>འབད་བཏུབ། ཚགས་མ་ཐབས་ལམ་གྱི་འཚོལ་ཞིབ་ཀྱི་ཤུལ་ལུ་  ཁྱོད་ཀྱི་ འ་ནཱི་ས་སྒོ་ནང་ཡོད་པའི་ བརྡ་དོན་ཆ་མཉམ་ནང་ལས་  སེལ་འཐུ་འབད་བཏུབ།\</ahelp\> རང་བཞིན་མཇུག་བསྡུའི་ ལས་འགན་དེ་ ལག་ལེན་འཐབ་ཐོག་ལས་  ས་སྒོའི་ནང་དོན་ཚུ་སེལ་འཐུ་འབད་བཏུབ། འ་ནཱི་ལས་འགན་འདི་ལུ་ དྲན་ཚད་ཀྱི་ས་སྒོ་དང་  དུས་ཚོད་  དེ་ལས་དམིགས་བསལ་གྱི་ གནད་སྡུད་གཞི་རྟེན་ཆེ་བ་ཚུ་ནང་  ག་དེ་སྦེ་དགོཔ་ཨིན་ན་དང་  ་དེ་མ་ཚད་ཉུང་སུ་སྦེ་ལག་ལེན་འཐབ་དགོཔ་ཨིན་ན་ཚུ་སེམས་ཁར་བཞག \</variable\>				2002-02-02 02:02:02
