helpcontent2	source\text\shared\02\12070200.xhp	0	help	par_id3158430				0	dz	སྔོན་སྒྲིག་གི་ཐོག་ལས་ བཙུགས་ཡོད་པའི་དོན་མཚམས་ཚུ་ ད་ལྟོའི་དོན་མཚམས་བཟོ་རྣམ་དང་གཅིག་ཁར་ རྩ་སྒྲིག་འབད་ཡི། རྩ་སྒྲིག་འདི་ "none" entry in the \<emph\>དོན་མཚམས་བཟོ་རྣམ་\</emph\> ཐོ་ཡིག་སྒྲོམ་དང་ཆ་མཉམ་ཨིན། \<ahelp hid=\"SW_LISTBOX_DLG_AP_INSERT_DB_SEL_LB_DB_PARA_COLL\" visibility=\"visible\"\> འ་ནི་འདི་ ཁྱོད་ཀྱིས་ཡིག་ཆ་ནང་བཙུག་དགོ་མནོ་མི་དོན་མཚམས་ལུ་འཇུག་སྤྱོད་འབད་ནི་ཨིན་པའི་དོན་མཚམས་བཟོ་རྣམ་སོ་སོ་སེལའཐུ་འབད་ས་ཨིན། \</ahelp\>ཐོ་ཡིག་སྒྲོམ་འདི་གིས་  \<item type=\"productname\"\>%PRODUCTNAME\</item\> ནང་ངེས་འཛིན་འབད་ཡོད་པའི་དོན་མཚམས་བཟོ་རྣམ་ཚུ་བཀྲམ་སྟོན་འབདཝ་ཨིནམ་དང་  \<link href=\"text/swriter/01/05130000.xhp\" name=\"Style Catalog\"\>བཟོ་རྣམ་ཐོ་གཞུང་\</link\>ནང་འཛིན་སྐྱོང་འཐབ་ཅི།				2002-02-02 02:02:02
