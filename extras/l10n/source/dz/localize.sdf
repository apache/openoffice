helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3153273	187			0	dz	གནད་སྡུད་གཞི་རྟེན་ས་སྒོ་ཚད་བཟུང་གི་དོན་ལུ་ ཁྱོད་ཀྱིས་ ཀེར་ཐིག་གསལ་བཀོད་འབད་ནི་དོན་ལུ་ནང་ཐིག་གཅིག་བཙུགས་ཚུགས་ནི་དང་ ཡང་ན་ གནད་སྡུད་གཞི་རྟེན་ཧྲིལ་བུའི་དོན་ལུ་ཨང་ ༠ འདི་བཙུགས་བཏུབ་ཨིན། ཚད་བཟུང་འདི་སྟོངམ་མེནམ་འོང་། \<embedvar href=\"text/scalc/01/04060101.xhp#quotes\"/\>				2002-02-02 02:02:02
