helpcontent2	source\text\scalc\guide\calc_date.xhp	0	help	par_id3150304				0	dz	ཁ་སྐོང་ཅན་གྱི་མན་ངག་ལ་ལོ་ཅིག་གི་ཐོག་ལས་ མོ་བཏབ་འབད་ནི་: ཆུ་ཚོད་ཀྱི་རྩིས་སྟོན་ནིའི་དོན་ལུ་ A4 ནང་ལུ་ =A3*24 བཙུགས་ སྐར་མའི་རྩིས་སྟོན་ནི་གི་དོན་ལུ་ A5 ནང་ལུ་ =A4*60 བཙུགས་ དེ་ལས་སྐར་ཆའི་རྩིས་སྟོན་ནི་གི་དོན་ལུ་ A6 ནང་ལུ་  =A5*60 བཙུགས། མན་ངག་རེ་རེའི་ཤུལ་ལུ་ \<item type=\"keycode\"\>བཙུགས་\</item\> ལྡེ་མིག་ལུ་ཨེབས།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\guide\calc_date.xhp	0	help	par_id3149207				0	dz	ཁྱོད་ཀྱི་ སྐྱེ་བའི་ཚེས་གྲངས་འདི་ ཆ་ཕྲན་སྣ་ཚོགས་ནང་རྩིས་སྟོན་དང་བཀྲམ་སྟོན་འབད་བའི་གནས་སྐབས་ལུ་ བེ་ལུས་ཚུ་ ཁྱོད་ཀྱིས་ མཇུག་གི་མན་ངག་བཙུགས་ཡོདཔ་བཟུམ་སྦེ་ རྩིས་སྟོན་འབད་ཡོདཔ་དང་ \<item type=\"keycode\"\>བཙུགས་\</item\> ལྡེ་མིག་ལུ་ ཨེབས། "Now"འདི་ འཕྲོ་མཐུད་དེ་འགྱུརཝ་ཨིན་རུང་ བེ་ལུ་འདི་རང་བཞིན་གྱིས་དུས་མཐུན་མི་བཟོ། \<emph\>ལག་ཆས་\</emph\> དཀར་ཆག་ནང་ དཀར་ཆག་རྣམ་གྲངས་ \<emph\>ནང་ཐིག་ནང་དོན་ - རང་བཞིན་རྩིས་སྟོན་\</emph\> འདི་ཤུགས་ལྡན་སྦེ་སྡོདཔ་ཨིན་ ག་དེ་ཨིན་རུང་ རང་བཞིན་རྩིས་སྟོན་འདི་ ལས་འགན་ NOW ལུ་འཇུག་སྤྱོད་མིའབད། འདི་གིས་ག་ཅི་སྟོན་སྨོ་ཟེར་བ་ཅིན་ ཁྱོད་ཀྱི་གློག་རིག་འདི་ ལེབ་གྲངས་དུས་མཐུན་གྱིས་ རྩ་ལས་དབང་མཚུགསཔ་ཨིནམ་སྟོནམཨིན།				2002-02-02 02:02:02
