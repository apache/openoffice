helpcontent2	source\text\shared\02\01170300.xhp	0	help	par_id3150789	5			0	dz	\<ahelp hid=\"HID_TABORDER_CONTROLS\"\>འབྲི་ཤོག་ནང་ཚད་འཛིན་ཚུ་ཆ་མཉམ་ཐོ་བཀོད་འབདཝ་ཨིན། ཚད་འཛིན་འདི་ཚུ་མགོ་ལས་མཇུག་ལུ་འབྱིན་ཡོད་པའི་གོ་རིམ་ནང་མཆོང་ལྡེ་གཅིག་ཁར་སེལ་འཐུ་འབད་ཚུགས། \</ahelp\> མཆོང་ལྡེའི་གོ་རིམ་ནང་རེ་འདུན་བསྐྱེད་པའི་གནས་ས་འགན་སྤྲོད་འབད་ནི་ལུ་ \<emph\>ཚད་འཛིན་ཚུའི་ཐོ་ཡིག་ལས་ \</emph\>ཚད་འཛིན་སེལ་འཐུ་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170300.xhp	0	help	par_id3154751	7			0	dz	\<ahelp hid=\"SVX_PUSHBUTTON_RID_SVXDLG_TAB_ORDER_PB_MOVE_UP\"\>སེལ་འཐུ་འབད་ཡོད་པའི་ཚད་འཛིན་འདི་\<emph\> མཆོང་ལྡེ་གོ་རིམ་ནང་\</emph\> གནས་ས་གཅིག་ཡར་བཤུད་ནི་ལུ་ཡར་བཤུད་ཨེབ་རྟ་ཨེབ་གཏང་།\</ahelp\>				2002-02-02 02:02:02
