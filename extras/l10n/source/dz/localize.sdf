helpcontent2	source\text\shared\guide\email.xhp	0	help	par_id3153127				0	dz	$[officename]གིས་ ཁྱོད་རའི་སྔོན་སྒྲིག་གློག་འཕྲིན་ལས་རིམ་ཁ་ཕྱེཝ་ཨིན། \<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\> ཁྱོད་ཀྱིས་ ད་ལྟོའི་ཡིག་ཆ་འདི་ གློག་འཕྲིན་ལས་རིམ་གཞན་དང་གཅིག་ཁར་གཏང་དགོ་མནོ་བ་ཅིན་ \<emph\>ལག་ཆས་ - གདམ་ཁ་ - ཨིན་ཊར་ནེཊི་ - གློག་འཕྲིན་\</emph\>དང་གཅིག་ཁར་ལག་ལེན་འཐབ་ནིའི་དོན་ལུ་ ལས་རིམ་འདི་སེལ་འཐུ་འབད་ཚུགས། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\email.xhp	0	help	par_id3150986				0	dz	ཁྱོད་ཀྱི་གློག་འཕྲིན་ལས་རིམ་ནང་ ཁྱོད་ཀྱིས་ཁ་སྐོང་རྐྱབ་ནི་ཨིན་མི་ཚིག་ཡིག་གང་རུང་དང་དོན་ཚན་ ལེན་མཁན་བཙུགས དེ་ལས་གློག་འཕྲིན་གཏང་།				2002-02-02 02:02:02
