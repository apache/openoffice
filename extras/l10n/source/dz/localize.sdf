helpcontent2	source\text\shared\02\02020000.xhp	0	help	par_id3156024				0	dz	$[officename] ནང་  དཔར་འཕྲུལ་དེ་  ཁྱོད་རའི་རིམ་ལུགས་ནང་  སྔོན་སྒྲིག་དཔར་འཕྲུལ་སྦེ་  གཞི་བཙུགས་འབད་ཡོད་པ་ཅིན་  ཁྱོད་ཀྱི་ ཐོབ་ཚུགས་པའི་  ཡིག་གཟུགས་ཚུ་\<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>མཐོངམ་ཨིན། \<link href=\"text/shared/guide/spadmin.xhp\" name=\"spadmin\"\>spadmin\</link\> ལས་རིམ་དང་གཅིག་ཁར་  ཁྱོད་ཀྱི་དཔར་འཕྲུལ་དེ་  སྔོན་སྒྲིག་གི་དཔར་འཕྲུལ་སྦེ་  ངེས་འཛིན་འབད་བཏུབ།  \</caseinline\>\<defaultinline\>  དཔར་འཕྲུལ་ཅིག་  སྔོན་སྒྲིག་དཔར་འཕྲུལ་སྦེ་  གཞི་བཙུགས་འབད་ནི་ལུ་  ཁྱོད་རའི་བཀོལ་སྤྱོད་རིམ་ལུགས་ཀྱི་  ཡིག་ཐོ་བཀོད་པ་དང་གཅིག་ཁར་  གཞི་བསྟུན་མཛན་གནང་།\</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\02020000.xhp	0	help	par_id3148550				0	dz	\<variable id=\"vorschautext\"\>ཁྱོད་ཀྱི་\<emph\>ཡིག་གཟུགས་ཀྱི་ཐོ་ཡིག་ཚུ་གི་སྔོན་ལྟ\</emph\>ས་སྒོ་འདི་\<link href=\"text/shared/optionen/01010800.xhp\" name=\"Tools - Options - $[officename] - View\"\>ལག་ཆས་ - གདམ་ཁ་ - $[officename] - མཐོ་སྣང་\</link\>ནང་ལུ་  རྟགས་བཀལ་བ་ཅིན་  ཁྱོད་ཀྱི་  ཁོང་རའི་  རིམ་བཞིན་གྱི་ཡིག་གཟུགས་ནང་  ཡིག་གཟུགས་རྩ་སྒྲིག་འབད་འབདཝ་ཚུ་གི་  མིང་དེ་ཚུ་མཐོང་ཚུགས།\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\02020000.xhp	0	help	par_id3154125				0	dz	ཁྱོད་ལུ་  ཡིག་གཟུགས་ ཧ་ལམ་ཅིག་ མ་ཐོབ་ཟེར་  བཀོད་ཡོད་མི་ འཛོལ་བའི་འཕྲིན་དོན་ཅིག་ལྷོད་ཡོདཔ་དང་  འདི་ $[officename]ཡིག་གཟུགས་ཨིན་པ་ཅིན་  ཁྱོད་ཀྱི་ཉམས་བཅོས་\<emph\>ཐབས་ལམ་ནང་ལུ་ \</emph\>$[officename]གཞི་སྒྲིག་ \<emph\>དང་གཅིག་ཁར་ \</emph\>གཞི་བཙུགས་འབད་བཏུབ།				2002-02-02 02:02:02
