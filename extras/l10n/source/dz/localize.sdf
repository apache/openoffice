helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3147487				0	dz	ཌོག་བརྡ དོན་ས་སྒོ་ཚུ་གི་དོན་ལུ་ TYPE ཚད་བཟུང་དེ་ DOCINFO དང་མཉམ་པ་སྦེ་འོངམ་ཨིན། SUBTYPE ཚད་འཛིན་དེ་གིས་ གསལ་བཀོད་འབད་ཡོད་མི་ས་སྒོ་བཟུམ་ཡོད་མི་བཀྲམ་སྟོན་འབདཝ་ཨིན། དཔེ་འབད་བ་ཅིན་ "Created" ཌོག་བརྡ་དོན་ས་སྒོ་དེ་གི་དོན་ལུ་SUBTYPE=CREATE. ཚེས་གྲངས་དང་ཆུ་ཚོད་ཀྱི་ཌོག་བརྡ་དོན་ས་སྒོ་གི་དོན་ལུ་FORMAT ཚད་བཟུང་དེ་ ཚེས་གྲངས་ ཡང་ན་ ཆུ་ཚོད་དང་མཉམ་པ་སྦེ་འོངམ་ཨིནམ་དང་ SDNUMཚད་བཟུང་དེ་གིས་ ལག་ལེན་འཐབ་ཡོད་པའི་ཨང་གྲངས་ཀྱི་རྩ་སྒྲིག་གི་བརྡ་སྟོནམ་ཨིན།SDFIXEDཚད་བཟུང་དེ་གིས་ ཌོག་བརྡ་དོན་གྱི་ས་སྒོ་དེ་གི་ནང་དོན་འདི་གཏན་བཟོས་བཟོ་སྟེ་ཡོད་དང་མེད་ཀྱི་བརྡ་སྟོནམ་ཨིན། 				2002-02-02 02:02:02
