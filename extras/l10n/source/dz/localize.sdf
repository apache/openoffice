helpcontent2	source\text\shared\01\02230500.xhp	0	help	par_id3154408				0	dz	\<variable id=\"dokzus\"\>\<ahelp hid=\".uno:MergeDocuments\" visibility=\"visible\"\>ཡིག་ཆ་གཅིག་པ་ལུ་བཟོ་ཡོད་པའི་བསྒྱུར་བཅོས་འདི་  ཡིག་ཆ་ངོ་མ་གི་ནང་ལུ་ནང་འདྲེན་འབདཝ་ཨིན། མཇུག་གི་དྲན་ཐོ་ཚུ་དང་མགོ་ཡིག་ཚུ་  དེ་ལས་  གཞི་ཁྲམ་ཚུ་དང་ས་སྒོ་ཚུ་ལུ་བཟོ་ཡོད་པའི་བསྒྱུར་བཅོས་ཚུ་སྣང་མེདཔ་སྦེ་བཞག་ཡོད། \</ahelp\>\</variable\>དབྱེར་མེད་བསྒྱུར་བཅོས་ཚུ་  རང་བཞིན་གྱིས་མཉམ་བསྡོམས་འབད་ཡོད།				2002-02-02 02:02:02
