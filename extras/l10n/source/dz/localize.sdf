helpcontent2	source\text\shared\02\12100200.xhp	0	help	par_id3147588				0	dz	\<variable id=\"suchentext\"\>\<ahelp hid=\".uno:RecSearch\" visibility=\"hidden\"\> གནད་སྡུད་གཞི་རྟེན་གྱི་ཐིག་ཁྲམ་དང་འབྲི་ཤོག་ཚུ་འཚོལ་ཞིབ་འབདཝ་ཨིན། \</ahelp\>ཁྱོད་ཀྱིས་ དམིགས་བསལ་བེ་ལུསི་གི་དོན་ལུ་ འབྲི་ཤོག་ ཡང་ན་ གནད་སྡུད་གཞི་རྟེན་གྱི་ཐིག་ཁྲམ་ནང་ གནད་སྡུད་ས་སྒོ་དང་ཐོ་ཡིག་སྒྲོམ་ དེ་ལས་ ཞིབ་དཔྱད་སྒྲོམ་ཚུ་འཚོལ་ཞིབ་འབད་ཚུགས། \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12100200.xhp	0	help	par_id3149355				0	dz	ཐིག་ཁྲམ་འཚོལ་བཞི་སྐབས་ལུ་ ད་ལྟོའི་ཐིག་ཁྲམ་གྱི་གནད་སྡུད་ས་སྒོ་ཚུ་འཚོལ་ཞིབ་འབདཝ་ཨིན། འདི་བཟུམ་སྦེ་འབྲི་ཤོག་ཅིག་ནང་འཚོལ་ཞིབ་འབདཝ་ད་ འབྲི་ཤོག་དང་འབྲེལ་མཐུད་འབད་ཡོད་པའི་ཐིག་ཁྲམ་གྱི་གནད་སྡུད་ས་སྒོ་ཚུ་འཚོལ་ཞིབ་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12100200.xhp	0	help	par_id3153394				0	dz	ནཱ་ལུ་འགྲེལ་བཤད་བརྐྱབས་ཡོད་མི་འཚོལ་ཞིབ་དེ་  \<item type=\"productname\"\>%PRODUCTNAME\</item\> གིས་འབདཝ་ཨིན། ཁྱོད་ཀྱིས་ གནད་སྡུད་གཞི་རྟེན་ཅིག་ནང་ལུ་འཚོལ་ཞིབ་འབད་ནའི་དོན་ལུ་ ཨེསི་ཀིཡུ་ཨེལ་སར་བར་དེ་ལག་ལེན་འཐབ་དགོ་མནོ་བ་ཅིན་ ཁྱོད་ཀྱིས་\<link href=\"text/shared/02/12110000.xhp\" name=\"Form-based Filters\"\>གཞི་སྒྲུབ་ཕྲ་རིང་གུ་ཡོད་མི་ \</link\>གཞི་གྲུབ་-གཞི་རྟེན་འབད་ཡོད་མི་ཚགས་མ་ཚུ་ \<link href=\"text/shared/main0213.xhp\" name=\"Form Bar\"\>དེ་ལག་ལེན་འཐབ་དགོཔ་ཨིན།\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12100200.xhp	0	help	par_id3149095				0	dz	 འཚོལ་ཞིབ་ལས་འགན་འདི་ཡང་ ཐིག་ཁྲམ་ཚད་འཛིན་གྱི་དོན་ལུ་ལངམ་སྦེ་ཐོབ་ཚུགས། འཚོལ་ཞིབ་ལས་འགན་འདི་ ཐིག་ཁྲམ་ཚད་འཛིན་ཅིག་ནང་ལས་བོད་བརྡ་འབད་བའི་སྐབས་ ཁྱོད་ཀྱིས་ འབྲེལ་མཐུད་འབད་ཡོད་པའི་གནད་སྡུད་གཞི་རྟེན་གྱི་ཐིག་ཁྲམ་གྱི་གནད་སྡུད་གཞི་རྟེན་ཀེར་ཐིག་ལུ་ཆ་མཉམ་པའི་ཐིག་ཁྲམ་ཚད་འཛིན་གྱི་ཀེར་ཐིག་རེ་རེ་འཚོལ་ཞིབ་འབད་ཚུགས།				2002-02-02 02:02:02
