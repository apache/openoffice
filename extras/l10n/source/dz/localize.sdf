helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3150481				0	dz	\<ahelp hid=\"HID_SC_FAP_STRUCT\"\> ད་ལྟོའི་ལས་འགན་གྱི་ལྡེ་རིམ་ཁྱད་ཚད་བཀྲམ་སྟོན་འབདཝ་ཨིན། \</ahelp\> གདོང་ཁར་ལུ་བསྡོམས་རྟགས་ཡང་ན་ཕབ་རྟགས་ཚར་གཅིག་ཨེབ་གཏང་གི་ཐོག་ལས་ ཁྱོད་ཀྱིས་སྒྲུབ་རྟགས་འདི་སྦ་ཡང་ན་སྟོན་ཚུགསཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3148886				0	dz	ཚག་སྔོན་ཚུ་གིས་ངེས་བདེན་སྦེ་བཙུགས་ཡོད་པའི་སྒྲུབ་རྟགས་ཚུ་མཚོན་རྟགས་སྟོནམ་ཨིན། ཚག་དམརཔོ་ཚུ་གིས་ བདེན་མེད་གནད་སྡུད་དབྱེ་བ་ཚུ་བརྡ་སྟོནམ་ཨིན། དཔེ་འབད་བ་ཅིན་ དངུལ་བསྡོམས་ལས་འགན་ལུ་སྒྲུབ་རྟགས་གཅིག་ཚིག་ཡིག་སྦེ་བཙུགས་ཏེ་ཡོད་པ་ཅིན་ དངུལ་བསྡོམས་ཀྱིས་ཨང་གྲངས་ཐོ་བཀོད་ཚུ་རྐྱངམ་ཅིག་ཆོགཔ་ལས་འ་ནི་འདི་དམརཔོ་ནང་གཙོ་དམིགས་འབད་དེ་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
