helpcontent2	source\text\shared\02\01140000.xhp	0	help	par_id3149106				0	dz	\<ahelp hid=\".uno:CircleCut\"\>ད་ལྟོའི་ཡིག་ཆ་ནང་  སྒོར་ཐིག་ཅིག་གི་གཞུ་དབྱིབས་དང་ སྒོར་ཚད་གྲལ་ཐིག་ཅིག་གི་སྦེ་ངེས་འཛིན་འབད་ཡོད་མི་འདི་གིས་  ལྟེམས་ལྟེམས་གང་ཡོད་པའི་དབྱིབས་ཅིག་འབྲིཝ་ཨིན།  སྒོར་ཐིག་གི་ཆ་བགོས་ཅིག་འབྲི་ནི་ལུ་  སྒོར་ཐིག་འདི་ ཁྱོད་ར་ ག་དགོ་པའི་ཚད་དེ་ནང་ལུ་འདྲུད་བཞིནམ་ལས་  སྒོར་ཚད་གྲལ་ཐིག་གི་ འགོ་བཙུགས་ས་ཚིགས་དེ་  ངེས་འཛིན་འབད་ནི་ལུ་ ཨེབ་གཏང་འབད།  སྒོར་ཚད་གྲལ་ཐིག་གི་འདི་གི་ མཐའ་རྩེ་འདི་ ས་གནས་ག་སྟེ་ལུ་བཀལ་བཞག་ནི་ཨིན་ན་  འདི་ནང་ལུ་ཁྱོད་རའི་དཔག་བྱེད་དེ་སྤོ་བཤུད་འབད་བཞིནམ་ལས་ཨེབ་གཏང་། ཁྱོད་ཀྱི་སྒོར་ཐིག་འདི་གུར་ཨེབ་གཏང་འབད་མི་དགོ  སྒོར་དབྱིབས་ཆ་བགོས་ཅིག་འབྲི་ནིའི་དོན་ལུ་  ཁྱོད་ཀྱི་འདྲུད་བཞག་འབདཝ་ད་ སོར་ལྡེ་འདི་བཟུང་བཞག་འབད། \</ahelp\>				2002-02-02 02:02:02
