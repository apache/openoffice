helpcontent2	source\text\shared\02\02130000.xhp	0	help	par_id3153031				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>ཁྱོད་ཀྱིས་\<emph\> འགོ་མཚམས་མར་ཕབ་འབད་\</emph\> ངོས་དཔར་འདི་  \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>བརྡ་བཀོད་ལྡེ་མིག་\</caseinline\>\<defaultinline\>ཚད་འཛིན་ལྡེ་མིག་\</defaultinline\>\</switchinline\>འཆང་བཞག་པའི་སྐབས་ ཨེབ་གཏང་འབད་བ་ཅིན་  སེལ་འཐུ་འབད་ཡོད་པའི་དོན་མཚམས་ཀྱི་དོན་ལུ་ འགོ་མཚམས་འདི་  \<link href=\"text/shared/optionen/01040200.xhp\" name=\"Tools - Options - Writer - General\"\>\<emph\>ལག་ཆས་ཚུ་ - གདམ་ཁ་ཚུ་ - %PRODUCTNAME རྩོམ་འབྲི་པ་ - ཡོངས་ཁྱབ་\</emph\>\</link\> གི་འོག་ལུ་གཞི་སྒྲིག་འབད་ཡོད་མི་ སྔོན་སྒྲིག་མཆོང་ལྡེ་བཀག་འདི་གིས་ སྤོ་བཤུད་འབད་ཡོད།\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
