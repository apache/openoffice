helpcontent2	source\text\shared\01\05030500.xhp	0	help	par_idN109BE				0	dz	\<ahelp hid=\"700793922\"\>རྩོམ་འབྲི་པའི་ཐིག་ཁྲམ་འདི་  མཐའ་མཚམས་བཟོ་རྣམ་གཅིག་གི་ནང་ལུ་  ནང་ཐིག་གི་སྦོ་ལོག་ཁར་གྱི་མཐའ་མཚམས་སོ་སོ་གཉིསཔ་འདི་མཉམ་བསྡོམས་འབདཝ་ཨིན།   རྒྱུ་དངོས་འདི་  རྩོམ་འབྲི་པའི་ཡིག་ཆ་ནང་གི་  ཐིག་ཁྲམ་ཆ་མཉམ་ལུ་ནུས་ཅན་ཡོདཔ་ཨིན། \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030500.xhp	0	help	par_idN109C1				0	dz	སྒྲིང་སྒྲིང་འབད་ཡོད་པའི་ཁྱད་ཆོས་རྒྱལ་ཁ་འཐོབ་ས་གི་  གསལ་བཤད་ལུ་ལམ་ལུགས་འདི་ཚུ་  སྲབ་དམ་འབད་བཏུབ་ཨིན།  དཔེར་ན་  ནང་ཐིག་གཅིག་ལུ་  ས་ཚིག་རྒྱ་ཚད་ ༢ གི་མཐའ་མཚམས་དམརཔོ་ཡོདཔ་དང་  སྦོ་ལོག་ཁར་གྱི་ནང་ཐིག་དེ་ལུ་  ས་ཚིག་རྒྱ་ཚད་ ༣ དང་བཅས་ཧོནམ་ཡོདཔ་ཨིན་  དེ་ལས་  ནང་ཐིག་གཉིས་ཀྱི་བར་ནའི་མཐུན་མོང་གི་མཐའ་མཚམས་འདི་  ས་ཚིག་རྒྱ་ཚད་  ༣  དང་བཅས་སྦེ་ཧོནམ་འོངམ་ཨིན།				2002-02-02 02:02:02
