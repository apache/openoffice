helpcontent2	source\text\shared\02\01170300.xhp	0	help	par_id3150347	2			0	dz	\<variable id=\"text\"\>\<ahelp hid=\".uno:TabDialog\"\>ལག་ལྡེ་\<emph\>གོ་རིམ་ \</emph\>ཌའི་ལོག་གི་ནང་  ལག་ལེན་པ་འདི་གིས་  ལོག་ལྡེ་དེ་མར་མནན་འབདཝ་ད་  ཚད་འཛིན་གྱི་ས་སྒོ་ཚུ་ག་ཅི་ནང་  ཆེད་དམིགས་དེ་ལེནམ་ཨིན་ནའི་གོ་རིམ་འདི་ཚུ་  ལེགས་བཅོས་འབད་བཏུབ།\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170300.xhp	0	help	par_id3109850				0	dz	འབྲི་ཤོག་གི་ ཆ་ཤས་ཚུ་  ཡིག་ཆ་ནང་  བཙུགས་སྟེ་ཡོད་པ་ཅིན་  \<item type=\"productname\"\>%PRODUCTNAME\</item\>འདི་གི་ རང་བཞིན་གྱིས་  མཆོང་ལྡེ་འདི་  ལག་ལེན་འཐབ་པའི་སྐབས་   ཚད་འཛིན་གཅིག་ནང་ལས་གཅིག་ལུ་  གོ་རིམ་ག་ཅིག་ནང་  སྤོ་བཤུད་འབད་ནི་ཨིན་ན་  གཏན་འབེབས་བཟོཝ་ཨིན། ཚད་འཛིན་གསརཔ་འདི་ཚུ་ རེ་རེ་བཞིན་ རང་བཞིན་གྱིས་  འ་ནཱི་རྒྱུན་རིམ་འདི་གི་  མཇུག་ལུ་ བཞགཔ་ཨིན། \<emph\>ཨེབ་ལྡེ་ གོ་རིམ་གྱི་\</emph\> ཌའི་ལོག་ནང་  ཁྱོད་ཀྱི་  འ་ནཱི་རྒྱུན་རིམ་གྱི་གོ་རིམ་འདི་ཚུ་    ཁྱོད་རའི་ངོ་རྐྱང་གི་དགོཔ་ཚུ་ལུ་  འདྲིས་མཐུན་འབད་བཏུབ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170300.xhp	0	help	par_id3155934				0	dz	ཁྱོད་ཀྱིས་ཡང་ཚད་འཛིན་གྱི་རྒྱུ་དངོས་ཚུའི་ཌའི་ལོག་ནང་ \<link href=\"text/shared/02/01170101.xhp\" name=\"Order\"\>\<emph\>གོ་རིམ་གྱི་འོག་ལུ་\</emph\>\</link\> རེ་འདུན་བསྐྱེད་པའི་གནས་གོང་ \<emph\>ཐོ་བཀོད་འབད་ཐོག་ལས་དེའི་དམིགས་བསལ་གྱི་རྒྱུ་དངོས་ཚུ་བརྒྱུད་དེ་\</emph\> ཚད་འཛིན་གྱི་ཟུར་ཐོ་ངེས་འཛིན་འབད་ཚུགས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170300.xhp	0	help	par_id3149760				0	dz	རེ་ཌིའོ་ཨེབ་རྟ་ཅིག་  སེལ་འཐུ་འབད་ཡོད་པ་ཅིན་རྐྱངམ་ཅིག་  རེ་ཌིའོ་ཨེབ་རྟ་འདི་  ལག་ལྡེ་གིས་ འཇུག་སྤྱོད་འབད་བཏུབ་ཨིན།  ག་ནཱི་ཡང་ སེལ་འཐུ་མ་འབད་བར་ཡོད་མི་ནང་  ཁྱོད་ཀྱི་ རེ་ཌིའོ་ཨེབ་རྟ་  སྡེ་ཚན་གཅིག་  བཀོད་སྒྲིག་འབད་ཡོད་པ་ཅིན་  དེ་ལས་ལག་ལེན་པ་འདི་གིས་  ལྡེ་སྒྲོམ་གྱི་ཐོག་ལས སྡེ་ཚན་ ཡང་ན་ རེ་ཌིའོ་ཨེབ་རྟ་ཚུ་ག་ནི་ཡང་  འཇུག་སྤྱོད་འབད་མི་ཚུགས།				2002-02-02 02:02:02
