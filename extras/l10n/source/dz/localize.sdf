helpcontent2	source\text\shared\explorer\database\11020000.xhp	0	help	par_id3151245				0	dz	\<ahelp hid=\"HID_DSADMIN_CHARSET_ODBC\"\>་ $[officename] ནང་གནད་སྡུད་གཞི་རྟེན་གྱི་མཐོང་སྣང་ལག་ལེན་འཐབ་ནི་ལུ་  ཁྱོད་ཀྱིས་དགོ་པའི་ ཨང་རྟགས་གཞི་བསྒྱུར་འདི་སེལ་འཐུ་འབད།  དེ་གིས་གནད་སྡུད་གཞི་རྟེན་ལུ་ ཕན་གནོད་མེད།  ཁྱོད་རའི་བཀོལ་སྤྱོད་རིམ་ལུགས་ཀྱི་ སྔོན་སྒྲིག་ཡིག་འབྲུ་གཞི་སྒྲིག་ལག་ལེན་འཐབ་ནི་ལུ་  \</ahelp\>གདམ་ཁ་རྐྱབས། "System"  ཚིག་ཡིག་དང་ཌི་གཞི་རྟེན་ གནད་སྡུད་གཞི་རྟེན་ཚུ་  ཡིག་འབྲུ་ཚུ་ཆ་མཉམ་རང་ བཱའིཊིསི་གི་ཨང་གྲངས་ལྕོག་ཐདཔ་དང་བཅས་  ཨིན་ཀོ་ཌེཌི་འབད་ཡོད་པའི་ གཏན་བཟོས་འབད་བའི་ཚད་ཀྱི་ཡིག་འབྲུའི་རིང་ཚད་དང་བཅས་  ཡིག་འབྲུ་གཞི་སྒྲིག་འབད་ནི་འདི་ བཀག་དམ་རྐྱབས་ཡོད།				2002-02-02 02:02:02
