helpcontent2	source\text\swriter\02\14020000.xhp	0	help	par_id3143270	2			0	dz	\<ahelp hid=\"FN_FORMULA_CALC\"\>ཁྲོད་ཀྱི་ཐིག་ཁྲམ་ཅིག་གི་ནང་ཐིག་ནང་  མན་ངག་ཅིག་བཙུགས་བཏུབ་ས་ལུ་ ཡན་ལག་དཀར་ཆག་ཅིག་ཁ་ཕྱེཝ་ཨིན།\</ahelp\> འོད་རྟགས་དེ་  ཐིག་ཁྲམ་གྱི་  ནང་ཐིག་ནང་དང་  ཡང་ན་  ཁྱོད་རང་གི་གྲུབ་འབྲས་དེ་ ག་སྟེ་འབྱུང་དགོ་སའི་  ཡིག་ཆ་འདི་ནང་གི་གནས་ས་ལུ་བཞག    \<emph\> ངོས་དཔར་མན་ངག་\</emph\>དེ་ལུ་ ཨེབ་གཏང་འབད་ཞིནམ་ལས་  ཡན་ལག་དཀར་ཆག་ནང་ལས་  འདོད་པ་བསྐྱེད་ཡོད་པའི་  མན་ངག་དེ་གདམ་ཁ་རྐྱབ།				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\14020000.xhp	0	help	par_id3149096				0	dz	མན་ངག་འདི་ ཨིན་པུཊི་གི་གྲལ་ཐིག་ནང་ བྱུངམ་ཨིན། ཐིག་ཁྲམ་ཅིག་ནང་ ནང་ཐིག་གི་ཁྱབ་ཚད་དེ་  གསལ་བཀོད་འབད་ནི་ལུ་ མའུསི་དང་གཅིག་ཁར་ འདོད་པ་བསྐྱེདཔ་ཡོད་པའི་ནང་ཐིག་ཚུ་  སེལ་འཐུ་འབད། ཆ་མཉམ་པའི་ ནང་ཐིག་གི་གཞི་བསྟུན་ཚུཡང་  ཨིན་པའུཊི་གི་གྲལ་ཐིག་ནང་བྱུངམ་ཨིན།  ཁ་སྐོང་ཚད་བཟུང་དེ་ ཉེ་བར་མཁོ་བ་སྦེ་ ཐོ་བཀོད་འབད་ཞིནམ་ལས་\<emph\>ཁྱོད་རའི་ཐོ་བཀོད་དེ་\</emph\>  ངེས་དཔྱད་འབད་ནི་ལུ་  འཇུག་སྤྱོད་ལུ་ཨེབ་གཏང་འབད། ཁྱོད་ཀྱི་འོས་ལྡན་གྱི་ཚིག་སྦྱོར་དེ་ ཤེས་པ་ཅིན་ མན་ངག་འདི་ཐད་ཀར་དུ་ ཐོ་བཀོད་འབད་བཏུབ།   དཔེར་ན་ \<link href=\"text/swriter/01/04090000.xhp\" name=\"Insert Fields\"\>\<emph\>བཙུགས་ནིའི་ས་སྒོ་\</emph\>\</link\>དང་\<emph\>ཞུན་དག་འབད་ནི་ས་སྒོ\</emph\>ཌའི་ལོག་ཚུ་ནང་ འ་ནི་དེ་ཚུ་ཉ་བར་མཁོ་བ་ཅིག་ཨིན།				2002-02-02 02:02:02
