helpcontent2	source\text\swriter\01\06100000.xhp	0	help	bm_id3149353				0	dz	\<bookmark_value\>ཐིག་ཁྲམ་ཚུ་;གྲལ་ཐིག་ཚུ་དབྱེ་སེལ་འབད་དོ་\</bookmark_value\>\<bookmark_value\>sདབྱེ་སེལ་འབད་དོ་;དོན་མཚམས་/ཐིག་ཁྲམ་གྲལ་ཐིག་ཚུ་\</bookmark_value\>\<bookmark_value\>ཚིག་ཡིག་; དོན་མཚམས་ཚུ་དབྱེ་སེལ་འབད་དོ་\</bookmark_value\>\<bookmark_value\>ཚིག་ཡིག་གི་གྲལ་ཐིག་ཚུ་; དོན་མཚམས་ཚུ་དབྱེ་སེལ་འབད་དོ་\</bookmark_value\>\<bookmark_value\>དབྱེ་སེལ་འབད་དོ་;དམིགས་བསལ་གྱི་སྐད་ཡིག་ནང་ལུ་ཡོད་མི་དོན་མཚམས་ཚུ་\</bookmark_value\>\<bookmark_value\>ཨེ་ཤི་ཡན་སྐད་ཡིག་;དོན་མཚམས་/ཐིག་ཁྲམ་གྲལ་ཐིག་ཚུ་དབྱེ་སེལ་འབད་དོ་\</bookmark_value\>				2002-02-02 02:02:02
