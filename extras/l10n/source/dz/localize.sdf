helpcontent2	source\text\shared\02\12070200.xhp	0	help	par_id3149987	8			0	dz	\<ahelp hid=\"SW_RADIOBUTTON_DLG_AP_INSERT_DB_SEL_RB_AS_FIELD\" visibility=\"hidden\"\> ཡིག་ཆ་ནང་ལུ་ གནད་སྡུད་འབྱུང་ཁུངས་\</ahelp\>\<emph\>གནད་སྡུད་གཞི་རྟེན་གྱི་ཀེར་ཐིག་བཙུགས་\</emph\> ཌའི་ལོག་ནང་ ཡིག་ཆ་ནང་སེལའ་ཐུ་འབད་ཡོད་པའི་གནད་སྡུད་འདི་ས་སྒོ་སྦེ་\<link href=\"text/swriter/01/04090000.xhp\" name=\"Fields\"\>ས་སྒོ་ཚུ་\</link\>སེལ་འཐུ་འབད། གནད་སྡུད་གཞི་རྟེན་ཀེར་ཐིག་རེ་རེ་བཞིན་གྱི་དོན་ལུ་ \<link href=\"text/swriter/01/04090006.xhp\" name=\"database fields\"\>གནད་སྡུད་གཞི་རྟེན་གྱི་ས་སྒོ་འདི་ \</link\> ཝའིལ་ཀརཌིསི་སྦེ་ལཱ་འབདཝ་ཨིནམ་དང་ དེ་འབྲི་ཤོག་ཡི་གུ་གི་དོན་ལུ་ཡང་ལག་ལེན་འཐབ་བཏུབ་ཨིན། ད་ལྟོ་སེལའ་ཐུ་འབད་ཡོད་པའི་དྲན་ཐོ་ལུ་ ས་སྒོའི་ནང་དོན་དང་མཐུན་སྒྲིག་འབད་ནི་གི་དོན་ལུ་ \<link href=\"text/shared/02/12080000.xhp\" name=\"Data to Fields\"\>\<emph\>ས་སྒོ་ལུ་གནད་སྡུད་\</emph\>\</link\> ངོས་པར་གུ་ཨེབ་གཏང་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070200.xhp	0	help	par_id3153114				0	dz	ཁྱོད་ཀྱིས་ \<emph\>གནད་སྡུད་ལས་ཚིག་ཡིག་\</emph\> ལས་འགན་གདམ་ཁ་རྐྱབ་པའི་བསྒང་ དྲན་ཐོ་ལེ་ཤ་ཅིག་སེལ་འཐུ་འབད་ཡོད་པ་ཅིན་ ཡིག་འཕྲིན་མཉམ་སྡོམ་ས་སྒོ་ཚུ་ དྲན་ཐོའི་མང་ཉུང་དང་འཁྲིལ་ཏེ་བཙུགས་འོང་། དེ་མ་ཚད་ ས་སྒོའི་བརྡ་བཀོད་དཔེར་ན་ "Next record" བཟུམ་ རང་བཞིན་གྱིས་ ངོ་རྐྱང་ས་སྒོའི་བརྡ་བཀོད་སྡེབ་ཚན་ཚུ་གགི་བར་ན་ བཙུགས་འོང་།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070200.xhp	0	help	par_id3145090				0	dz	\<emph\>གནད་སྡུད་གཞི་རྟེན་གྱི་ཀེར་ཐིག་བཙུགས་\</emph\> ཌའི་ལོག་གིས་ཁྱོད་ལུ་ གནད་སྡུད་གཞི་རྟེན་ག་འདི་ཡིག་ཆ་ནང་བཙུག་ནི་ཨིན་ནའི་ངེས་འཛིན་དང་དོན་མཚམས་རྩ་སྒྲིག་བཟོ་ཐངས་ཚུ་ འབད་བཅུགཔ་ཨིན།				2002-02-02 02:02:02
