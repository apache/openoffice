helpcontent2	source\text\shared\02\05090000.xhp	0	help	par_id3149716	5			0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"IMPRESS\"\>དངོས་པོ་ཅིག་ སེལ་འཐུ་འབད་ཞིནམ་ལས་    \<emph\> འབྲི་ནིའི་ \</emph\>  ལག་ཆས་ཕྲ་རིང་གུར་\<emph\> ཡོད་པའི་\</emph\>བསྒྱིར་ནིའི་ངོས་དཔར་དེ་ལུ་  ཨེབ་གཏང་འབད། \</caseinline\>\<caseinline select=\"DRAW\"\>དངོས་པོ་ཅིག་  སེལ་འཐུ་འབད་ཞིནམ་ལས་འབྲི་ནིའི་ལག་ཆས་ཕྲ་རིང་གུར་ཡོད་པའི་  བསྒྱིར་ནིའི་ ངོས་དཔར་འདི་  ཨེབ་གཏང་འབད། \</caseinline\>\<defaultinline\>དངོས་པོ་ཅིག་སེལ་འཐུ་འབད་ཞིནམ་ལས་    \<emph\>  འབྲི་ནིའི་ དངོས་པོའི་\</emph\> རྒྱུ་དངོས་  \<emph\>ཕྲ་རིང་གུར་ཡོད་པའི་ \</emph\> བསྒྱིར་ནིའི་དངོས་པོ་ལུ་  ཨེབ་གཏང་འབད།\</defaultinline\>\</switchinline\> ཁྱོད་རང་ ག་དགོ་པའི་  ཁ་ཕྱོགས་ནང་  བསྒྱིར་ནི་ལུ་  དངོས་པོ་གི་ སྒྱིད་ཁུག་ལེགས་སྐྱོང་འཐབ་ནི་ཚུ་  འདྲུད་བཞག་འབད།				2002-02-02 02:02:02
