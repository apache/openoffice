helpcontent2	source\text\simpress\01\13050700.xhp	0	help	par_id3146974				0	dz	\<ahelp hid=\".uno:convert_to_contour\"\>ཟུར་མང་དབྱིབས་ཚུ་གི་སྡེ་ཚན་ཡང་ན་ཟུར་མང་དབྱིབས་ལུ་སེལ་འཐུ་འབད་ཡོད་པའི་དངོས་པོ་འདི་གཞི་བསྒྱུར་འབདཝ་ཨིན།\</ahelp\> གཞི་བསྒྱུར་འདི་གིས་ཟུར་མང་དབྱིབས་ཚུ་གི་སྡེ་ཚན་ཅིག་གསར་བསྐྲུན་འབད་བ་ཅིན་ (དཔེར་ན་ ཁྱོད་ཀྱིས་ཚིག་ཡིག་དངོས་པོ་ཅིག་གསར་བསྐྲུན་འབདཝ་ད་) ཁྱོད་ཀྱིས་ངོ་རྐྱང་ཟུར་མང་དབྱིབས་སེལ་འཐུ་མ་འབད་བའི་ཧེ་མ་སྡེ་ཚན་ཐོ་བཀོད་ནི་ལུ་ཨེཕ་༣་ཨེབ་གཏང་།				2002-02-02 02:02:02
helpcontent2	source\text\simpress\01\13050700.xhp	0	help	par_id3155601	3			0	dz	བུར་གཞོང་འདི་ལུ་ཁྱོད་ཀྱིས་ཚིག་ཡིག་དངོས་པོ་ཡང་ན་གྲལ་ཐིག་ཅིག་ཚར་གཅིག་གཞི་བསྒྱུར་འབད་བ་ཅིན་ ཁྱོད་ཀྱིས་ཨ་རྟག་ཞུན་དག་འབད་དོ་བཟུམ་སྦེ་ད་ལས་ཕར་་འབད་མི་ཚུགས། ཚབ་ལུ་ ཁྱོད་ཀྱིས་ཟུར་མང་དབྱིབས་གང་རུང་་འབད་ཚུགས་དོ་བཟུམ་སྦེ་བུར་གཞོང་འདི་ ཁོ་རའི་དབྱིབས་བདེ་སྒྲི་གའབད་ནི་ལུ་\<emph\>ཞུན་དག་ – ས་ཚིགས་བརྡ་བཀོད་འདི་ \</emph\>ལག་ལེན་འཐབ་ནི་ལུ་གྲངས་སུ་བཙུགས་ཏེ་ ཞུན་དག་འབད་ཚུགས།				2002-02-02 02:02:02
