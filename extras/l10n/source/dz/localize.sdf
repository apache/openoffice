helpcontent2	source\text\simpress\02\10030000.xhp	0	help	par_id3148489				0	dz	ལྟེ་བའི་ས་ཚིགས་ཀྱི་མཐའ་སྐོར་ལུ་སེལ་འཐུ་འབད་ཡོད་པའི་༢ཌི་དངོས་པོ་(ཚུ་)གསེག་ལོག་ཡང་ན་བསྒྱིརཝ་ཨིན། ཁྱོད་ཀྱིས་བསྒྱིར་ནི་ཨིན་མི་ཁ་ཕྱོགས་འདི་ནང་དངོས་པོ་གི་བཤེད་བཟུང་གི་ཟུར་འདྲུད། དངོས་པོ་གསེག་ལོག་འབད་ནི་ལུ་ ཁྱོད་ཀྱིས་གསེག་ལོག་འབད་ནི་ཨིན་མིའི་ཁ་ཕྱོགས་ནང་དབུས་ཀྱི་བཤེད་བཟུང་འདྲུད།				2002-02-02 02:02:02
helpcontent2	source\text\simpress\02\10030000.xhp	0	help	par_id3154022				0	dz	བཤུད་རེ་རེ་ལུ་ལྟེ་བའི་ས་ཚིགས་གཅིག་རྐྱངམ་གཅིག་ཡོདཔ་ཨིན། དངོས་པོ་གི་དབུས་ལུ་ལྟེ་བའི་ས་ཚིགས་སྤོ་བཤུད་འབད་ནི་ལུ་དངོས་པོ་གུ་ཐེངས་གཉིས་ཨེབ་གཏང་འབད། ཁྱོད་ཀྱིས་ཡང་གསལ་གཞི་གུ་གནས་ཁོངས་གསརཔ་ལུ་ལྟེ་བའི་ས་ཚིགས་འདྲུད་ཚུགས་ནི་དང་དེ་ལས་དངོས་པོ་བསྒྱིར།				2002-02-02 02:02:02
helpcontent2	source\text\simpress\02\10030000.xhp	0	help	par_id3153914				0	dz	ཁྱོད་ཀྱིས་༣ཌི་དངོས་པོ་གྲངས་སུ་བཙུགས་མི་སྡེ་ཚན་སེལ་འཐུ་འབད་བ་ཅིན་ ༣ཌི་དངོས་པོ་རྐྱངམ་གཅིག་བསྒྱིརཝ་ཨིན། ཁྱོད་ཀྱིས་༣ཌི་དངོས་པོ་གསེག་ལོག་འབད་མི་ཚུགས་ ཚབ་ལུ་ ཁྱོད་ཀྱིས་དབུས་བཤེད་བཟུང་ཚུ་འདྲུད་གཏང་བའི་ཐོག་ལས་ཨེཀསི་དང་ཝའི་ཚད་ཐིག་ཚུའི་སྐོར་ལས་བསྒྱིར་ཚུགས།				2002-02-02 02:02:02
