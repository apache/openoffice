helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3147242	2			0	dz	གནད་སྡུད་\<emph\> མཆོང་ལྡེ་གི་  ཤོག་ལེབ་འདི་གིས་ \</emph\>འབྲི་ཤོག་དང་ འབྲེལ་མཐུད་འབད་བའི་  གནད་སྡུད་གཞི་རྟེན་ལུ་  གཞི་བསྟུན་འབད་མི་  འབྲི་ཤོག་གི་རྒྱུ་དངོས་ཚུ་  ངེས་འཛིན་འབདཝ་ཨིན།  				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3149398				0	dz	འབྲི་ཤོག་དེ་ བརྟེན་པའི་གནད་སྡུད་འབྱུང་ཁུངས་འདི་  ངེས་འཛིན་འབདཝ་ཨིན་   ཡང་ན་  གནད་སྡུད་དེ་  ལག་ལེན་པ་འདི་གིས་  ཞུན་དག་འབད་བཏུབ་ཨིན་ན་  གསལ་བཀོད་འབདཝ་ཨིན།  དབྱེ་སེལ་དང་  ཚགས་མའི་  ལས་འགན་  ཚུ་ལས་   \<link href=\"text/shared/02/01170203.xhp\" name=\"subform\"\>ཡན་ལག་འབྲི་ཤོག་ \</link\>ཅིག་  གསར་བསྐྲུན་འབད་ནི་ལུ་   ཁྱོད་ཀྱི་ ཉེ་བར་མཁོ་བའི་  རྒྱུ་དངོས་ཆ་མཉམ་རང་  འཐོབ་ཚུགས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170203.xhp	0	help	hd_id3154810				0	dz	གནད་སྡུད་འབྱུང་ཁུངས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3152349				0	dz	\<ahelp hid=\"HID_PROP_DATASOURCE\"\>འབྲི་ཤོག་འདི་གིས་  གཞི་བསྟུན་འབད་དགོ་པའི་   གནད་སྡུད་འབྱུང་ཁུངས་དེ་  ངེས་འཛིན་འབདཝ་ཨིན།\</ahelp\> ཁྱོད་ཀྱི་ \<emph\>...\</emph\>ཨེབ་རྟ་ལུ་  ཨེབ་གཏང་འབད་བ་ཅིན་  ཁྱོད་ཀྱི་  ཁྱོད་རའི་གནད་སྡུད་འབྱུང་ཁུངས་ཚུ་  གདམ་ཁ་རྐྱབ་བཏུབ་པའི་\<link href=\"text/shared/01/01020000.xhp\" name=\"Open\"\>\<emph\>ཁ་ཕྱེ་\</emph\>\</link\>ཌའི་ལོག་ལུ་  བོད་བརྡ་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170203.xhp	0	help	hd_id3146948				0	dz	ནང་དོན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3155922				0	dz	\<ahelp hid=\"HID_PROP_CURSORSOURCE\"\>འབྲི་ཤོག་གི་དོན་ལུ་  ལག་ལེན་འཐབ་ནི་ཨིན་པའི་  ནང་དོན་དེ་ གཏན་འབེབས་བཟོཝ་ཨིན།  ནང་དོན་དེ་ཚུ་  ཡོད་བཞིན་པའི་  ཐིག་ཁྲམ་དང་  ཡང་ན་  འདྲི་དཔྱད་ (ཧེ་མ་ལས་  གནད་སྡུད་གཞི་རྟེན་ནང་  གསར་བསྐྲུན་འབད་ཡོདཔ།) ཡང་ན་ དེ་ཚུ་ ཨེསི་ཀིའུ་ཨེལ་  གསལ་བཤད་ཀྱིས་ངེས་འཛིན་འབད་བཏུབ་ཅིག་ཨིན།  གྱོད་ཀྱི་ཧེ་མ་  ནང་དོན་ཅིག་ ཐོ་བཀོད་མ་འབདཝ་ལས་  \<emph\>ནང་དོན་གྱི་དབྱེ་བ་ནང་ལུ་ \</emph\>ཁྱོད་ཀྱི་དབྱེ་བ་ཏག་ཏག་དེ་  ངེས་འཛིན་འབད་དགོཔ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3149657				0	dz	ཁྱོད་ཀྱི་  ནང་དོན་གྱི་དབྱེ་བ་ནང་"Table" ཡང་ན་  "Query"ཅིག་སེལ་འཐུ་\<emph\>འབད་\</emph\>ཡོད་པ་ཅིན་  སྒྲོམ་འདི་གིས་  སེལ་འཐུ་འབད་ཡོད་པའི་  གནད་སྡུད་གཞི་རྟེན་ནང་  ཐིག་ཁྲམ་དང་  འདྲི་དཔྱད་གཞི་སྒྲིག་འབད་ཡོད་མི་ཚུ་  ཐོ་བཀོད་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170203.xhp	0	help	hd_id3148755				0	dz	ནང་དོན་དབྱེ་བ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3150541				0	dz	\<ahelp hid=\"HID_PROP_CURSORSOURCETYPE\"\>གནད་སྡུད་འབྱུང་ཁུངས་དེ་  ཡོད་བཞིན་པའི་  གནད་སྡུད་འབྱུང་ཁུངས་  ཐིག་ཁྲམ་ཨིན་དགོཔ་འབད་དང་  ཡངན་  འབྲི་ཤོག་དེ་    ཨེསི་ཀིའུ་ཨེལ་  གསལ་བཤད་དང་བསྟུན་  འབད་དགོ་ནི་ཨིན་མི་དེ་  ངེས་འཛིན་འབདཝ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3153192				0	dz	ཁྱོད་ཀྱི་ "Table" ཡང་ན་ "Query"ཅིག་གདམ་ཁ་རྐྱབ་པའི་སྐབས་  འབྲི་ཤོག་འདི་གིས་  ཁྱོད་ཀྱི་\<emph\>ནང་དོན་གྱི་འོག་ལུ་\</emph\>གསལ་བཀོད་འབད་མི་  ཐིག་ཁྲམ་དང་ ཡང་ན་ འདྲི་དཔྱད་ལུ་  གཞི་བསྟུན་འབད་འོང་།  ཁྱོད་ཀྱི་ འདྲི་དཔྱད་དང་  ཡང་ན་ \<link href=\"text/shared/02/01170203.xhp\" name=\"subform\"\>ཡན་ལག་འབྲི་ཤོག་གསརཔ་ཅིག་ \</link\>གསར་བསྐྲུན་འབད་དགོ་པ་ཅིན་  ཁྱོད་ཀྱི་   "SQL"གྱི་གདམ་ཁ་ཅིག་  གདམ་ཁ་རྐྱབ་དགོ    དེ་ལས་ཁྱོད་ཀྱི་  ཚད་འཛིན་རྒྱུ་དངོས་གྱི་  གནད་སྡུད་མཆོང་ལྡེའི་ཤོག་ལེབ་གུར་\<emph\>ཐོ་ཡིག་ནང་དོན་\</emph\> གྱི་སྒྲོམ་ནང་  ཐད་ཀར་དུ་ ཨེསི་ཀིའུ་ཨེལ་ འདྲི་དཔྱད་དང་  ཡང་ན་  ཡན་ལག་འབྲི་ཤོག་གི་དོན་ལུ་  གསལ་བཤད་ཚུ་ ཐོ་བཀོད་འབད་བཏུབ།   				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170203.xhp	0	help	hd_id3158409				0	dz	ཨེསི་ཀིའུ་ཨེལ་བརྡ་བཀོད་འདི་དཔྱད་ཞིབ་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3145171				0	dz	\<ahelp hid=\"HID_PROP_ESCAPE_PROCESSING\"\>ཨེསི་ཀིའུ་ཨེལ་གྱི་ གསལ་བཤད་དེ་  %PRODUCTNAME་གིས་  དབྱེ་དཔྱད་འབད་ནི་ཨིན་ན་  གསལ་བཀོད་འབདཝ་ཨིན།\</ahelp\> ཨིན་ལུ་ གཞི་སྒྲིག་འབད་ཡོད་པ་ཅིན་  ཁྱོད་ཀྱི་\<emph\>...\</emph\> ཨེབ་རྟ་དེ་   \<emph\>ནང་དོན་\</emph\> ཐོག་ཡིག་སྒྲོམ་གྱི་ རྒྱབ་ལས་ཡོད་མི་ འདི་ལུ་  ཨེབ་གཏང་འབད་བཏུབ། འ་ནཱ་འདི་གིས་ ཁྱོད་ཀྱི་ཚད་རིས་ཀྱི་ཐོག་ལས་  གནད་སྡུད་གཞི་རྟེན་གྱི་ འདྲི་འཔྱད་ཅིག་   གསར་བསྐྲུན་འབད་བཏུབ་ས་ལུ་  ཝིན་ཌོ་ཅིག་ ཁ་ཕྱེ་འོང་།  ཁྱོད་ཀྱི་ ཝིན་ཌོ་དེ་  ཁ་བསྡམ་དང་  འདྲི་དཔྱད་  གསར་བསྐྲུན་འབད་ཡོད་མི་དེ་གི་དོན་ལུ་  ཨེསི་ཀིའུ་ཨེལ་ གསལ་བཤད་དེ་ \<emph\>ནང་དོན་\</emph\> ཐོ་ཡིག་གི་སྒྲོམ་ནང་བཙུགས་འོང་།				2002-02-02 02:02:02
