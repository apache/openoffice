helpcontent2	source\text\shared\explorer\database\11020000.xhp	0	help	par_id3151054				0	dz	\<ahelp hid=\"HID_DSADMIN_AUTORETRIEVEENABLED\"\>གིས་  ད་ལྟོའི་ཨོ་ཌི་བི་སི་ཡང་ན་ ཇེ་ཌི་བི་སི་གནད་སྡུད་འབྱུང་ཁུངས་དོན་ལས་  རང་བཞིན་གྱི་ ཡར་འཕར་འབད་ཡོད་པའི་གནད་སྡུད་ས་སྒོ་ཚུ་གི་ $[officename] རྒྱབ་སྐྱོར་འདི་  ལྕོག་ཅན་བཟོཝ་ཨིན།  ཨེསི་ཌི་བི་སི་ཨེགསི་ བང་རིམ་ནང་གི་རང་བཞིན་གྱི་ཡར་འཕར་ཁྱད་རྣམ་ལུ་  གནད་སྡུད་གཞི་རྟེན་གྱིས་རྒྱབ་སྐྱོར་མ་འབད་བ་ཅིན་  \</ahelp\>འ་ནི་ ཞིབ་དཔྱད་ཀྱི་སྒྲོམ་འདི་སེལ་འཐུ་འབད།  སྤྱིར་གཏང་ལུ་འབད་བ་ཅིན་  རང་བཞིན་གྱི་ཡར་འཕར་འདི་ གཞི་རིམ་ལྡེ་མིག་ས་སྒོའི་དོན་ལུ་ སེལ་འཐུ་འབད་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
