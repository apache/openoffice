helpcontent2	source\text\smath\01\03090100.xhp	0	help	par_id3156102	39			0	dz	\<ahelp hid=\"HID_SMA_XCIRCY\"\> \<emph\>རྒྱུན་མཐུད་འབད་ནིའི་བརྡ་རྟགས་ཅིག་\</emph\> ས་གནས་འཛིན་མི་གཉིས་དང་ཅིག་ཁར་བཙུགསཔ་ཨིན། \</ahelp\> ཁྱོད་ཀྱིས་ \<emph\>ཀིརཀ་\</emph\> འདི་ \<emph\>བརྡ་བཀོད་ཚུའི་\</emph\> སྒོ་སྒྲིག་ནང་ལུ་ཡིག་དཔར་ཡང་རྐྱབས་ཚུགས།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090100.xhp	0	help	par_id3150906				0	dz	\<emph\><?>ཨོ་པ་ལཱསི་<?>\</emph\>འདི་\<emph\>བརྡ་བཀོད་ཚུའི་\</emph\>སྒོ་སྒྲིག་ནང་ལུ་ཡིག་དཔར་རྐྱབས་ཐོག་ ཁྱོད་ཀྱིས་ \<emph\>སྒོར་ཐིག་འབད་ཡོད་པའི་པ་ལཱསི་བཀོལ་སྤྱོད་པ་\</emph\>ཅིག་ ཁྱོད་རའི་ཡིག་ཆ་ནང་ལུ་བཙུགས།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090100.xhp	0	help	par_id3151197				0	dz	\<emph\><?>ཨོ་མའི་ནའསི་<?>\</emph\>འདི་\<emph\>བརྡ་བཀོད་ཚུའི་\</emph\> སྒོ་སྒྲིག་ནང་ལུ་ \<emph\>སྒོར་ཐིག་འབད་ཡོད་པའི་མའི་ནའསི་བཀོལ་སྤྱོད་པ་ཅིག་བཙུགས་ནིའི་དོན་ལས་ཡིག་དཔར་རྐྱབས།\</emph\>				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090100.xhp	0	help	par_id3155082				0	dz	\<emph\><?>ཨོ་ཚག་<?>\</emph\> འདི་ \<emph\>བརྡ་བཀོད་ཚུའི་\</emph\> སྒོ་སྒྲིག་ནང་ \<emph\>སྒོར་ཐིག་འབད་ཡོད་པའི་ཚག་བཀོལ་སྤྱོད་པ་\</emph\>ཅིག་མན་ངག་ནང་ལུ་བཙུགས་ནིའི་དོན་ལས་ཡིག་དཔར་རྐྱབས།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090100.xhp	0	help	par_id3154331				0	dz	\<emph\><?>ཨོ་བགོ་ནི་<?>\</emph\> འདི་ \<emph\>བརྡ་བཀོད་ཚུའི་\</emph\> སྒོ་སྒྲིག་ནང་ \<emph\>སྒོར་ཐིག་བགོ་རྩིས་བཀོལ་སྤྱོད་པ་\</emph\>ཅིག་མན་ངག་ནང་བཙུགས་ནིའི་དོན་ལས་ཡིག་དཔར་རྐྱབས།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090100.xhp	0	help	par_id3150089				0	dz	\<ahelp hid=\"HID_SMA_XWIDESLASHY\"\> \<emph\>རྒྱ་ཅན་གཡོ་ཤད་བི་\</emph\> འདི་ \<emph\>Commands\</emph\> སྒོ་སྒྲིག་ནང་ལུ་ ཡིག་འབྲུ་གཉིས་ གཡོ་ཤད་ཅིག་དང་ཅིག་ཁར་(འོག་གི་གཡོན་ལས་ཡར་གྱི་གཡས་ལུ་)དེ་ཚུ་གི་བར་ན་བཟོ་སྟོན་འབད་ནིའི་དོན་ལས་ ཡིག་དཔར་རྐྱབས། \</ahelp\> ཡིག་འབྲུ་ཚུ་ གཡོ་ཤད་ཀྱི་གཡོན་ལུ་ཡོད་མི་ཆ་མཉམ་ཡར་ དང་གཡོ་ཤད་ཀྱི་གཡས་ལུ་ཡོད་མི་ཆ་མཉམ་མར་ཨིན་ནིའི་དོན་ལས་གཞི་སྒྲིག་འབད་ཡོད། འ་ནི་བརྡ་བཀོད་འདི་\<emph\>བརྡ་བཀོད་ཚུའི་\</emph\> སྒོ་སྒྲིག་དེ་གི་སྐབས་དོན་གྱི་དཀར་ཆག་ནང་ལུ་ཐོབ་ཚུགསཔ་ཡོད།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090100.xhp	0	help	par_id3150024				0	dz	\<ahelp hid=\"HID_SMA_XWIDEBSLASHY\"\> \<emph\>རྒྱ་ཅན་གཡོ་ཤད་བི་\</emph\> འདི་ \<emph\>བརྡ་བཀོད་ཚུའི་\</emph\> སྒོ་སྒྲིག་ནང་ལུ་ཡིག་འབྲུ་གཉིས་ གཡོ་ཤད་(ཡར་གྱི་གཡོན་ལས་མར་གྱི་གཡས་ལུ་)དང་ཅིག་ཁར་ དེ་ཚུ་གི་བར་ན་བཟོ་སྟོན་འབད་ནིའི་དོན་ལས་ ཡིག་དཔར་རྐྱབས།\</ahelp\> ཡིག་འབྲུ་ཚུ་ གཡོ་ཤད་ཀྱི་གཡོན་ལུ་ཡོད་མི་ཆ་མཉམ་མར་དང་ གཡོ་ཤད་ཀྱི་གཡས་ལུ་ཡོད་མི་ཆ་མཉམ་ཡར་ཨིན་ནིའི་དོན་ལུ་ གཞི་སྒྲིག་འབད་ཡོད། འ་ནི་བརྡ་བཀོད་འདི་  \<emph\>བརྡ་བཀོད་ཚུའི་\</emph\> སྒོ་སྒྲིག་གི་སྐབས་དོན་དཀར་ཆག་ནང་ལུ་ཐོབ་ཚུགསཔ་ཡོད།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090100.xhp	0	help	par_id3149376				0	dz	\<emph\>sub\</emph\> ཡང་ན་ \<emph\>sup\</emph\> འདི་བརྡ་བཀོད་ཀྱི་སྒོ་སྒྲིག་ནང་ལུ་ཟུར་ཐོ་ཚུ་དང་ནུས་ཤུགས་ཚུ་ཁྱོད་རའི་མན་ངག་ནང་གི་ཡིག་འབྲུ་ཚུ་ལུ་ཁ་སྐོང་རྐྱབས་ནིའི་དོན་ལས་ ཡིག་དཔར་རྐྱབས། དཔེར་ན་ ཡན་ལག་ ༢				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090100.xhp	0	help	par_id3147398				0	dz	བརྡ་བཀོད་ཀྱི་སྒོ་སྒྲིག་ནང་ལུ་བརྡ་དོན་ལག་ཐོག་ལས་ཐོ་བཀོད་འབད་བའི་སྐབས་ གཞི་བཀོད་ངེས་བདེན་གྱི་དོན་ལུ་ རྒྱུ་རྫས་ཚུའི་བར་ན་བར་སྟོང་ཚུ་ བཀོལ་སྤྱོད་པའི་གྲངས་ཅིག་ལུ་དགོས་མཁོ་ཡོདཔ་དྲན་གནང་། འ་ནི་འདི་ ཁྱོད་ཀྱིས་ཁྱོད་རའི་བཀོལ་སྤྱོད་པ་ནང་ལུ་གནས་གོང་ཚུ་གི་ཚབ་ལུ་ས་གནས་འཛིན་མི་ཚུ་ལག་ལེན་འཐབ་ཨིན་པ་ཅིན་ དམིགས་བསལ་གྱི་བདེན་པ་ཨིན། དཔེར་ན་ བགོ་རྩིས་ ༤ ཌིབ་ ༣ ཡང་ན་ ཌིབ་ བི་ ཅིག་བཟོ་བསྐྲུན་འབད་ནིའི་དོན་ལས།				2002-02-02 02:02:02
