helpcontent2	source\text\smath\01\05030000.xhp	0	help	par_id3147524				0	dz	\<ahelp hid=\"HID_SMA_BRACKET_EXCHEIGHT2\"\>བརྒྱ་ཆ་ལྷག་ཡོད་པའི་ཚད་འདི་བདེ་སྒྲིག་འབདཝ་ཨིན། \</ahelp\> བརྒྱ་ཆ་ ༠ ལུ་ གུག་ཤད་ཚུ་ མཐོ་ཚད་གཅིག་པ་ལུ་སྒྲུབ་རྟགས་ཚུ་མཐའ་སྐོར་ནིའི་དོན་ལས་ གཞི་སྒྲིག་འབད་ཡོད། ཐོ་བཀོད་འབད་མི་གནས་གོང་འདི་མཐོ་སུ་ཨིནམ་ད་ལུ་ གུག་ཤད་ཚུའི་ནང་དོན་དང་ གུག་ཤད་ཀྱི་ཕྱིའི་མཐའ་མཚམས་དེའི་བར་གྱི་ཀེར་ཕྲང་བར་སྟོང་འདི་སྦོམ་ཨིན། ས་སྒོ་འདི་ \<emph\>གུག་ཤད་ཚུ་གེ་ར་ཚད་འཇལ་\</emph\> དང་ཅིག་ཁར་རྐྱངམ་ཅིག་མཉམ་མཐུད་འབད་ལག་ལེན་འཐབ་བཏུབ།				2002-02-02 02:02:02
