helpcontent2	source\text\simpress\main0209.xhp	0	help	par_id3149666				0	dz	ཁྱོད་ཀྱིས་ཁྱོད་ཀྱི་བཤུད་གསར་བསྐྲུན་འབད་ནི་ནང་ཁྱོད་ལུ་ཕན་ནི་ལུ་$[officename]ཨིམ་པེརེསི་ལཱ་གི་ས་སྒོ་གི་ཡར་གྱི་མཐའམ་ཚུ་དང་གཡོན་ལུ་ཀེར་ཕྲང་དང་ཐད་སྙོམས་ཐིག་ཤིང་ཚུ་ལག་ལེན་འཐབ་ཚུགས། བཤུད་ཀྱི་མངའ་ཁོངས་ཁེབས་མི་ཐིག་ཤིང་ཚུ་གི་སེལ་འཐུ་ཚུ་དཀརཔོ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\simpress\main0209.xhp	0	help	par_id3153963				0	dz	ཁྱོད་ཀྱིས་དངོས་པོ་སེལ་འཐུ་འབདཝ་ད་ དེའི་རྒྱ་ཁྱོན་ཚུ་སྐྱ་ཐལ་གྲལ་ཐིག་གཉིས་ལྡན་སྦེ་ཐིག་ཤིང་གུ་བཀྲམ་སྟོན་འབད་ཡོདཔ་ཨིན། དངོས་པོ་འདི་ཀྲིག་ཀྲི་སྦེ་ཚད་བསྐྱར་བཟོ་འབད་ནི་ལུ་ ཐིག་ཤིང་གུ་གནས་ཁོངས་གསརཔ་ལུ་གྲལ་ཐིག་ཚུ་གཉིས་ལྡན་ལས་གཅིག་འདྲུད།				2002-02-02 02:02:02
helpcontent2	source\text\simpress\main0209.xhp	0	help	par_id3150206				0	dz	ཁྱོད་ཀྱིས་བཤུད་གུ་ཚིག་ཡིག་དངོས་པོ་སེལ་འཐུ་འབདཝ་ད་ འགོ་མཚམས་དང་མཆོང་ལྡེ་ཚུ་ཐད་སྙོམས་ཐིག་ཤིང་གུ་བཀྲམ་སྟོན་འབད་ཡོདཔ་ཨིན། ཚིག་ཡིག་དངོས་པོའི་དོན་ལུ་འགོ་མཚམས་ཡང་ན་མཆོང་ལྡེ་སྒྲིག་སྟངས་ཚུ་བསྒྱུར་བཅོས་འབད་ནི་ལུ་ ཐིག་ཤིང་གུ་གནས་ཁོངས་གསརཔ་ལུ་འགོ་མཚམས་ཡང་ན་མཆོང་ལྡེ་རྟགས་བཀོདཔ་འདྲུད།				2002-02-02 02:02:02
helpcontent2	source\text\simpress\main0209.xhp	0	help	par_id3150253				0	dz	ཁྱོད་ཀྱིས་ཡང་\<link href=\"text/simpress/01/04030000.xhp\" name=\"snap line\"\>ཁྱོད་ཀྱི་བཤུད་གུ་\</link\> ཕྲང་སྒྲིག་དངོས་པོ་ཚུ་ཁྱོད་ལུ་གྲོགས་རམ་འབད་ནི་ལུ་ཐིག་ཤིང་ལས་པར་ཐིག་འདྲུད་ཚུགས། ཐིག་ཤིང་ལག་ལེན་འཐབ་ཐོག་ལས་པར་ཐིག་བཙུགས་ནི་ལུ་ བཤུད་ནང་ལུ་ཐིག་ཤིང་གི་མཐའམ་འདྲུད།				2002-02-02 02:02:02
