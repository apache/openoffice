helpcontent2	source\text\shared\01\05290300.xhp	0	help	par_id3146856				0	dz	\<variable id=\"betretentext\"\>\<ahelp hid=\".uno:EnterGroup\" visibility=\"visible\"\>སེལ་འཐུ་འབདཡོད་པའི་སྡེ་ཚན་འདི་ཁ་ཕྱེཝ་ཨིན་  དེ་འབད་བ་ཅིན་  ཁྱོད་ཀྱིས་ དངོས་པོ་རྐྱང་པ་འདི་ཞུན་དག་འབད་བཏུབ་ཨིན།  སེལ་འཐུ་འབདཡོད་པའི་སྡེ་ཚན་དེ་གིས་  སྤུང་ཡོད་པའི་སྡེ་ཚན་འདི་ཡོད་པ་ཅིན་ ཁྱོད་ཀྱིས་  བརྡ་བཀོད་འདི་ཡན་ལག་སྡེ་ཚན་ཚུ་ལུ་ཡང་བསྐྱར་འབད་བཏུབ། \</ahelp\>\</variable\> བརྡ་བཀོད་དེ་གིས་  དངོས་པོ་ཚུ་ རྟག་བརྟེན་སྦེ་སྡེ་ཚན་ཤུབ་མི་གཏང་།				2002-02-02 02:02:02
