helpcontent2	source\text\shared\01\xformsdataadd.xhp	0	help	par_idN1054B				0	dz	\<ahelp hid=\".\"\>རྣམ་གྲངས་གསརཔ་ཅིག་ཁ་སྐོང་དང་  ཡང་ན་  ཨེགསི་འབྲི་ཤོག་གི་ གནད་སྡུད་འགྲུལ་བསྐྱོདཔ་ནང་ལུ་  སེལ་འཐུ་འབད་ཡོད་པའི་  རྣམ་གྲངས་དེ་་ ཞུན་དག་འབདཝ་ཨིན།\</ahelp\> རྣམ་གྲངས་འདི་ཚུ་  རྒྱུ་རྫས་དང་ ཁྱད་ཆོས་ དེ་ལས་ཞུ་འབུལ་ ཡང་ན་ བསྡམ་ཐག་ཚུ་འབད་རུང་བཏུབ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\xformsdataadd.xhp	0	help	par_idN10560				0	dz	\<ahelp hid=\".\"\>%PRODUCTNAMEགིས་  གནས་སྡུད་འགྲུལ་བསྐྱོདཔ་ནང་  ད་ལྟོ་སེལ་འཐུ་འབད་ཡོད་པའི་རྣམ་གྲངས་ཀྱི་ཤུལ་ལས་  ཐད་ཀར་དུ་རྣམ་གྲངས་གསརཔ་གཅིག་བཙུགསཔ་ཨིན།  ཁྱད་རྣམ་གསརཔ་གཅིག་  ད་ལྟོ་སེལ་འཐུ་འབད་དེ་ཡོད་པའི་ཆ་ཤས་ལུ་ཁ་སྐོང་བརྐྱབ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
