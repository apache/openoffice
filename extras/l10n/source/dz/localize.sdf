helpcontent2	source\text\shared\02\01170000.xhp	0	help	par_id3154127				0	dz	འབྲི་ཤོག་ལུ་འདྲི་དཔྱད་ཡང་ན་ཐིག་ཁྲམ་གྱི་ས་སྒོའི་ཐོ་ཡིག་ལས་ས་སྒོ་ཁ་སྐོང་རྐྱབ་ནི་ལུ་ འབྲི་ཤོག་ནང་ལུ་ནང་ཐིག་འདྲུད། ཚིག་ཡིག་ཡིག་ཆ་ནང་ ཁྱོད་ཀྱིས་ཡང་འབྲི་ཤོག་ལུ་ས་སྒོ་ཁ་སྐོང་རྐྱབ་ནི་ལུ་ཀེར་ཐིག་མགོ་ཡིག་འདྲུད་ཚུགས། ས་སྒོ་ལུ་ཁ་ཡིག་གྲངས་སུ་བཙུགས་ནི་ལུ་ \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>ཁྱོད་ཀྱིས་ཀེར་ཐིག་གི་མགོ་འདྲུད་པའི་སྐབས་ བརྡ་བཀོད་ \</caseinline\>\<defaultinline\>ཚད་འཛིན་\</defaultinline\>\</switchinline\>+སོར་ལྡེ་བཀག་བཞག།				2002-02-02 02:02:02
