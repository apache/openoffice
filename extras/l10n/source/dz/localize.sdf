helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3154681	145			0	dz	\<ahelp hid=\"HID_PROP_DEFAULT_BUTTON\" visibility=\"hidden\"\>སྔོན་སྒྲིག་\<emph\>ཨེབ་རྟའི་\</emph\>རྒྱུ་དངོས་དེ་གིས་  ཁྱོད་ཀྱི་སླར་ལོག་ལྡེ་མིག་དེ་ཨེབ་ད་  ཆ་མཉམ་པའི་ཨེབ་རྟ་འདི་བཀོལ་སྤྱོད་འབདཝ་ཨིནམ་སྦེ་ གསལ་བཀོད་འབདཝ་ཨིན།\</ahelp\>སྔོན་སྒྲིག\<emph\>ཨེབ་རྟའི་\</emph\>རྒྱུ་དངོས་དེ་གིས་  ཁྱོད་ཀྱི་སླར་ལོག་ལྡེ་མིག་དེ་ཨེབ་ད་  ཆ་མཉམ་པའི་ཨེབ་རྟ་འདི་བཀོལ་སྤྱོད་འབདཝ་ཨིནམ་སྦེ་ གསལ་བཀོད་འབདཝ་ཨིན།  ཁྱོད་ཀྱི་ཌའི་ལོག་ ཡང་ན་ འབྲི་ཤོག་ཅིག་ ཁ་ཕྱེ་ཞིནམ་ལས་  བྱ་བ་ཐེབས་ག་ནི་ཡང་  མ་བསྐྱེལ་བ་ཅིན་ འ་ནཱི་རྒྱུ་དངོས་དང་བཅས་པའི་ཨེབ་རྟ་དེ་  སྔོན་སྒྲིག་གི་ཨེབ་རྟ་དེ་ཨིན།				2002-02-02 02:02:02
