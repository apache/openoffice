helpcontent2	source\text\shared\02\06110000.xhp	0	help	par_id3154228				0	dz	\<ahelp hid=\".uno:MoveDown\"\>འདི་གི་འོག་ལུ་ཡོད་མི་གཅིག་གི་ ཤུལ་ལས་ སེལ་འཐུ་གྲུབ་ཡོད་པའི་ དོན་མཚམས་དེ་ གནས་ས་བཞགཔ་ཨིན།   \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\06110000.xhp	0	help	par_id3158405	5			0	dz	ཁྱོད་ཀྱི་དོན་མཚམས་འདི་ཚུ་  ཨང་བཏགས་ཡོདཔ་དང་  ངོས་དཔར་འདི་\<emph\> མར་བཤུད་དེ \</emph\>ཡོད་པ་ཅིན་  ཨང་གྲངས་འདི་ཚུ་  ད་ལྟོའི་གོ་རིམ་ནང་ལུ་  བདེ་སྒྲིག་འབད་འོང་།\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>མར་བཤུད་གྱི་\<emph\>ངོས་དཔར་འདི་ \</emph\>འོད་རྟགས་དེ་  འགོ་ཚག་བཙུགས་ཡོད་མི་དང་  ཡང་ན་  ཨང་བཏགས་ཡོད་པའི་ཐོ་ཡིག་ནང་ ཡོད་པ་ཅིན་རྐྱངམ་ཅིག་  མཐོང་ཚུགསཔ་ཨིན།\</caseinline\>\</switchinline\>\<switchinline select=\"appl\"\>\<caseinline select=\"IMPRESS\"\> ཁྱོད་ཀྱི་བསྡུས་དོན་གི་  མཐོང་སྣང་འདི་  ལག་ལེན་འཐབ་ད་  \<emph\>མར་བཤུད་ཀྱི་ \</emph\>ངོས་དཔར་འདི་  \<emph\>ཚིག་ཡིག་རྩ་སྒྲིག་འབད་ནིའི་\</emph\>ཕྲ་རིང་གུར་  བྱུངམ་ཨིན།\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
