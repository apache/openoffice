helpcontent2	source\text\shared\01\01020000.xhp	0	help	par_id3156113				0	dz	\<ahelp hid=\"HID_FILEDLG_STANDARD\"\>ནང་ན་ཁྱོད་ཡོད་སའི་སྣོད་ཐོ་ནང་ལུ་  ཡིག་སྣོད་ཚུ་དང་སྣོད་ཐོ་ཚུ་བཀྲམ་སྟོན་འབདཝ་ཨིན།  \</ahelp\> ཡིག་སྣོད་ཅིག་སེལ་འཐུ་འབད་ནི་དོན་ལུ་  ཡིག་སྣོད་འདི་སེལ་འཐུ་འབད་བཞིནམ་ལས་  \<emph\>ཁ་ཕྱེ་\</emph\>ཨེབ་གཏང་།.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01020000.xhp	0	help	par_id3159256				0	dz	དུས་ཡུན་ཅིག་ལུ་  ཡིག་སྣོད་གཅིག་ལས་ལྷག་སྟེ་ཁ་ཕྱེ་ནི་དོན་ལུ་  ཁྱོད་ཀྱིས་ཡིག་སྣོད་ཚུ་ལུ་ཨེབ་གཏང་པའི་བསྒང་\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>བརྡ་བཀོད་ \</caseinline\>\<defaultinline\>ཚད་འཛིན་\</defaultinline\>\</switchinline\>འཆང་བཞག་  དེ་ལས་  \<emph\>ཁ་ཕྱེ་\</emph\>ཨེབ་གཏང་།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01020000.xhp	0	help	par_id3154514				0	dz	ཡིག་སྣོད་ཚུ་དབྱེ་སེལ་འདབ་ནི་དོན་ལུ་  ཀེར་ཐིག་འདི་གུ་ཨེབ་གཏང་།  དབྱེ་སེལ་རིམ་པ་འདི་རིམ་ལོག་འབད་ནི་དོན་ལུ་  ལོག་འདི་རང་ཨེབ་གཏང་།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01020000.xhp	0	help	par_id3149514				0	dz	\<ahelp hid=\"HID_FILEVIEW_MENU_DELETE\"\>ཡིག་སྣོད་ཅིག་བཏོན་གཏང་ནི་དོན་ལུ་  ཡིག་སྣོད་ལུ་གཡས་ཀྱིས་ཨེབ་གཏང་ནི་དང་   དེ་ལས་   \<emph\>བཏོན་གཏང་\</emph\>གདམ་ཁ་བརྐྱབ།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01020000.xhp	0	help	par_id3147618				0	dz	\<ahelp hid=\"HID_FILEVIEW_MENU_RENAME\"\>ཡིག་སྣོད་ལུ་བསྐྱར་མིང་བཏགས་ནི་དོན་ལུ་  ཡིག་སྣོད་གཡས་ལུ་ཨེབ་གཏང་ནི་དང་  དེ་ལས་   \<emph\>Rename\</emph\>གདམ་ཁ་བརྐྱབ།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01020000.xhp	0	help	par_id3153331				0	dz	\<ahelp hid=\"SVTOOLS_PUSHBUTTON_DLG_SVT_QUERYDELETE_BTN_YES\" visibility=\"hidden\"\>ཌའི་ལོག་དེ་གི་ནང་ལུ་སྟོན་དེ་ཡོད་པའི་  མིང་དང་བཅས་པའི་ཡིག་སྣོད་འདི་  བཏོན་གཏང་ནི་དོན་ལུ་ཨེབ་གཏང་།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01020000.xhp	0	help	par_id3161458				0	dz	\<ahelp hid=\"SVTOOLS_PUSHBUTTON_DLG_SVT_QUERYDELETE_BTN_NO\" visibility=\"hidden\"\>ཌའི་ལོག་དེའི་ནང་ལུ་སྟོན་དེ་ཡོད་པའི་  མིང་དང་བཅས་པའི་ཡིག་སྣོད་ཀྱི་བཏོན་གཏང་འདི་  ཆ་མེད་གཏང་ནི་དོན་ལུ་ཨེབ་གཏང་།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01020000.xhp	0	help	par_id3147531				0	dz	\<ahelp hid=\"SVTOOLS_PUSHBUTTON_DLG_SVT_QUERYDELETE_BTN_ALL\" visibility=\"hidden\"\>སེལ་འཐུ་འབད་ཡོད་པའི་ཡིག་སྣོད་ཚུ་  ཆ་མཉམ་བཏོན་གཏང་ནི་དོན་ལུ་ ཨེབ་གཏང་།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01020000.xhp	0	help	par_id3161656				0	dz	\<ahelp hid=\"HID_FILEDLG_AUTOCOMPLETEBOX\"\>ཡིག་སྣོད་ཀྱི་དོན་ལུ་  འགྲུལ་ལམ་ཡང་ན་ཡིག་སྣོད་ཅིག་གི་མིང་  ཐོ་བཀོད་འབད།   ཁྱོད་ཀྱིས་   \<link href=\"text/shared/00/00000002.xhp#url\" name=\"URL\"\>ཡུ་ཨར་ཨེལ་\</link\>ཡང་ཐོ་བཀོད་འབད་བཏུབ།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01020000.xhp	0	help	par_id3150541	72			0	dz	ཁྱོད་རང་དགོ་པ་ཅིན་  བཀྲམ་སྟོན་འབད་ཡོད་པའི་ཡིག་སྣོད་ཚུ་གི་ཐོ་ཡིག་འདི་ཚགས་མ་བཙུགས་ནི་དོན་ལུ་  ཁྱོད་ཀྱིས་  \<emph\>ཡིག་སྣོད་ཀྱི་མིང་ \</emph\>ནང་ལུ་ ཝའིལ་ཀརཌིསི་འདི་ལག་ལེན་འཐབ་བཏུབ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01020000.xhp	0	help	par_id3153779	24			0	dz	\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>\</caseinline\>\<defaultinline\> དཔེར་ན་  ཚིག་ཡིག་གི་ཡིག་སྣོད་ཚུ་  ཆ་མཉམ་རང་སྣོད་ཐོ་ནང་ལུ་  ཐོ་ཡིག་བརྐྱབ་ནི་དོན་ལུ་  ཚིག་ཡིག་ཡིག་སྣོད་བརྒྱ་བསྐྱེད་(*.txt)དང་བཅས་ སྐར་རྟགས་ཝའིལ་ཀརཌི་འདི་ཐོ་བཀོད་འབད་ནི་དང་  དེ་ལས་  \<emph\> ཁ་ཕྱེ་ \</emph\>གུ་ཨེབ་གཏང་། ཡིག་སྣོད་མིང་ནང་ལུ་ཡིག་འབྲུ་གསུམ་པ་སྦེ་  ཚིག་ཡིག་ཡིག་སྣོད་ཚུ་'3'དང་བཅས་རྐྱངམ་ཅིག་བཀྲམ་སྟོན་འབད་མི་ (??3*.txt)ནང་བཟུམ་སྦེ་  ཡིག་འབྲུ་གང་རུང་ཅིག་གི་ཚབ་འབད་ནི་དོན་ལུ་  འདྲི་རྟགས་ (?) ཝའིལ་ཀརཌི་འདི་ལག་ལེན་འཐབ།\</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
