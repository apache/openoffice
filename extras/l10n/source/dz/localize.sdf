helpcontent2	source\text\simpress\main0210.xhp	0	help	par_id3148488				0	dz	ད་ལྟོའི་བཤུད་གུ་དངོས་པོ་སེལ་འཐུ་འབད་ནི་ལུ་ \<emph\>Select\</emph\> པར་རིས་ཕྲ་རིང་གུ་ལག་ཆས་ (མདའ་རྟགས་དཀརཔོ་) ཨེབ་གཏང་ཞིནམ་དང་དེ་ལས་དངོས་པོ་ཨེབ་གཏང་།				2002-02-02 02:02:02
helpcontent2	source\text\simpress\main0210.xhp	0	help	par_id3148610				0	dz	དངོས་པོ་གཅིག་ལས་ལྷག་སྟེ་སེལ་འཐུ་འབད་ནི་ལུ་ ཁྱོད་ཀྱིས་ཨེབ་གཏངམ་ད་སོར་ལྡེ་བཀག་བཞག།				2002-02-02 02:02:02
helpcontent2	source\text\simpress\main0210.xhp	0	help	par_id3148699				0	dz	དངོས་པོ་གཞན་མི་གི་རྒྱབ་ཁར་ཡོད་མི་དངོས་པོ་སེལ་འཐུ་འབད་ནི་ལུ་ \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>གདམ་ཁའི་གདམ་ལྡེ་ \</caseinline\>\<defaultinline\>བཀག་ཞིནམ་དང་\</defaultinline\>\</switchinline\>,དེ་ལས་དངོས་པོ་ཨེབ་གཏང་། བརྩེགས་ཕུང་ནང་འོག་ལུ་ཡོད་མི་དངོས་པོ་གཞན་སེལ་འཐུ་འབད་ནི་ལུ་ \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>གདམ་ཁའི་ \</caseinline\>\<defaultinline\>གདམ་ལྡེ་\</defaultinline\>\</switchinline\>, བཀག་ཞིནམ་དང་དེ་ལས་ལོག་སྟེ་ཨེབ་གཏང་། ཧེ་མ་ལས་སེལ་འཐུ་འབད་ཡོད་པའི་དངོས་པོ་སླར་ལོག་འབད་ནི་ལུ་སོར་ལྡེ་ + \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>གདམ་ཁའི་ \</caseinline\>\<defaultinline\>གདམ་ལྡེ་\</defaultinline\>\</switchinline\>, བཀག་བཞག་ཞིནམ་དང་དེ་ལས་ཨེབ་གཏང་།				2002-02-02 02:02:02
