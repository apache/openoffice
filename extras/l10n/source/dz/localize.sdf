helpcontent2	source\text\scalc\01\05050300.xhp	0	help	par_id3148799				0	dz	\<variable id=\"tabeintext\"\>\<ahelp visibility=\"visible\" hid=\".uno:Show\"\> ཧེ་མ་ལས་རང་ \<emph\> བརྡ་བཀོད་སྦ་དང་ \</emph\> བཅསཔ་སྦེ་ སྦ་ཡོད་པའི་ ཤོག་ཁྲམ་ཚུ་བཀྲམ་སྟོན་འབདཝ་ཨིན། \</ahelp\>\</variable\> བརྡ་བཀོད་བོད་ནིའི་དོན་ལུ་ ཤོག་ཁྲམ་གཅིག་རྐྱངམ་ཅིག་སེལ་འཐུ་འབད། ད་ལྟོའི་ཤོག་ཁྲམ་དེ་ ཨ་རྟག་རང་སེལ་འཐུ་གྲུབ་ཡོད། ད་ལྟོའི་ཤོག་ཁྲམ་མ་ཡིན་པའི་ཤོག་ཁྲམ་གཞན་སེལ་འཐུ་གྲུབ་ཡོད་པ་ཅིན་ ཁྱོད་ཀྱིས་  སྒོ་སྒྲིག་གི་མཇུག་ལུ་ མཉམ་ཐོག་པའི་ཤོག་ཁྲམ་ཨེབ་གཏང་བའི་སྐབས་སུ་ \<switchinline select=\"sys\"\> \<caseinline select=\"MAC\"\> བརྡ་བཀོད་ \</caseinline\> \<defaultinline\> ཚད་འཛིན་ \</defaultinline\> \</switchinline\> ཨེབ་ཐོག་ལས་ སེལ་འཐུ་བཤོལ་ཚུགསཔ་ཨིན། 				2002-02-02 02:02:02
