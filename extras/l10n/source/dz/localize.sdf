helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3155073				0	dz	\<ahelp hid=\"HID_PROP_BACKGROUNDCOLOR\" visibility=\"hidden\"\>ཚད་འཛིན་ས་སྒོའི་ རྒྱབ་གཞིའི་ ཚོས་གཞི་འདི་གཞི་སྒྲིག་འབདཝ་ཨིན།\</ahelp\>རྒྱབ་གཞིའི་ཚོས་གཞི་འདི་  ཚད་འཛིན་ས་སྒོ་ཚུ་མང་ཤོས་ཀྱི་དོན་ལུ་འཐོབ་ཚུགསཔ་ཨིན། ཁྱོད་ཀྱི་\<emph\>རྒྱབ་གཞིའི་ཚོས་གཞུའི་གུར་ \</emph\>ཨེབ་གཏང་འབད་བ་ཅིན་ ཁྱོད་ལུ་ འདྲ་མིན་སྣ་ཚོགས་ཀྱི་ཚོས་གཞི་ནང་ལས་ སེལ་འཐུ་འབད་ནི་ལུ་ལྕོགས་ཅན་བཟོ་མི་ ཐོ་ཡིག་ཅིག་ཁ་ཕྱེཝ་ཨིན།  "ཚད་ལྡན་"གདམ་ཁ་འདི་གིས་རིམ་ལུགས་གཞི་སྒྲིག་འདི་བསྟེནམ་ཨིན། རེ་འདུན་བསྐྱེདཔ་ཡོད་མི་  ཚོས་གཞུ་འདི་ཐོ་བཀོད་མ་འབད་བར་ཡོད་པ་ཅིན་ \<emph\>...\</emph\>  ཚོས་གཞི་ཌའི་ལོག་ནང་གི་ ཚོས་གཞི་ཅིག་ ་ངེས་འཛིན་འབདནིའི་དོན་ལུ་  ཨེབ་རྟ་འདི་ལུ་\<link href=\"text/shared/optionen/01010501.xhp\" name=\"Color\"\>\<emph\>ཨེབ་གཏང་\</emph\>\</link\> འབད།				2002-02-02 02:02:02
