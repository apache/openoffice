helpcontent2	source\text\shared\01\05340100.xhp	0	help	par_id3150756	7			0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>ཁྱོད་ཀྱིས་གྲལ་ཐིག་གི་མཐོ་ཚད་འདི་  འདྲེན་བྱེད་འདི་ གྲལ་ཐིག་མགོ་ཡིག་ལུ་འདྲུད་པའི་ཐོག་ལས་  བསྒྱུར་བཅོས་འབདཝ་ཨིན།  གྲལ་ཐིག་མཐོ་ཚད་འདི་ནང་ཐིག་ནང་དོན་ལུ་ཚུད་སྒྲིག་འབད་ནི་ལུ་    འདྲེན་བྱེད་གུ་ཨེབ་གཏང་ཐེང་གཉིས་ཨེབ་ད།\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
