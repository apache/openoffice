helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3147396				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>གིས་  རང་བཞིན་གྱིས་  "Default" དོན་མཚམས་བཟོ་རྣམ་འདི་  དོན་མཚམས་བཟོ་རྣམ་ མགུ་རྒྱན་ ༡ ལས་  མགུ་རྒྱན་ ༨ དང་བཅས་ ཚབ་བཙུགསཔ་ཨིན།  དོན་མཚམས་བཟོ་རྣམ་གྱི་མགུ་རྒྱན་ ༡འཇུག་སྤྱོད་འབད་ནི་ལུ་   ཁྱོད་ཀྱིས་  མགོ་རྒྱན་འབད་(དུས་ཡུན་མེད་པར་)ལག་ལེན་འཐབ་ནི་ཨིན་པའི་  ཚིག་ཡིག་འདི་ཡིག་དཔར་བརྐྱབ་ནི་དང་  དེ་ལས་  བཙུགས་འདི་ཚར་གཉིས་ཨེབ་གཏང་འབད།   ཡན་ལག་མགུ་རྒྱན་ཅིག་འཇུག་སྤྱོད་འབད་ནི་ལུ་  ཨེབ་ལྡེ་འདི་ཚར་གཅིག་ཡང་ན་མངམ་འབད་ཨེབ་ནི་དང་  ཚིག་ཡིག་འདི་ཡིག་དཔར་བརྐྱབ་ནི་དང་   (དུས་ཡུན་མེདཔ་འབད་), དེ་ལས་བཙུགས་འདི་ཨེབ་ད། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3151075				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>དོན་མཚམས་སྟོངམ་ཚུ་རྩ་བསྐྲད་གཏང་།\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3145728				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>ཁྱོད་ཀྱིས་\<emph\>རྩ་སྒྲིག་ - རང་བཞིན་རྩ་སྒྲིག་ -འཇུག་སྤྱོད་\</emph\>གདམ་ཁ་བརྐྱབ་ད་  ད་ལྟོའི་ཡིག་ཆ་ལས་  དོན་མཚམས་སྟོངམ་ཚུ་རྩ་བསྐྲད་གཏངམ་ཨིན།\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3152375				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>སྲོལ་སྒྲིག་བཟོ་རྣམ་ཚུ་ཚབ་བཙུགས།\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3156299				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>གིས་ "Default", the "Text Body", ཡང་ན་ "Text Body Indent" དོན་མཚམས་བཟོ་རྣམ་དང་བཅས་  ད་ལྟོའི་ཡིག་ཆ་ནང་གི་  སྲོལ་སྒྲིག་དོན་མཚམས་བཟོ་རྣམ་འདི་  ཚབ་བཙུགསཔ་ཨིན།\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3147045				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>འགོ་ཚག་འདི་ \</caseinline\>\</switchinline\>དང་བཅས་ཚབ་བཙུགས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3150420				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>འགོ་ཚག་བཀོད་ཡོད་པའི་ཐོ་ཡིག་ཚུ་ལུ་   བར་སྟོང་ཡང་ན་ ཨེབ་ལྡེ་གིས་ཐད་ཀར་དུ་རྗེས་སུ་འཇུག་མི་ སྦྲེལ་རྟགས་  (-) བསྡོམས་རྟགས་(+)ཡང་ན་ སྐར་རྟགས་(*)དང་བཅས་འགོ་བཙུགས་མི་  དོན་མཚམས་འདི་གཞི་བསྒྱུར་འབདཝ་ཨིན།   གདམ་ཁ་འདི་གིས་  "Default", "Text Body", or "Text Body Indent"དོན་མཚམས་བཟོ་རྣམ་ཚུ་དང་བཅས་རྩ་སྒྲིག་འབད་ཡོད་པའི་  དོན་མཚམས་གུ་རྐྱངམ་ཅིག་  ལཱ་འབདཝ་ཨིན།  ལག་ལེན་འཐབ་ཡོད་པའི་འགོ་ཚག་བཟོ་རྣམ་འདི་བསྒྱུར་བཅོས་འབད་ནི་ལུ་     གདམ་ཁ་འདི་སེལ་འཐུ་འབད་ནི་དང་  དེ་ལས་  \<emph\>ཞུན་དག་འབད་\</emph\>ཨེབ་གཏང་འབད། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3151019				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>རིང་ཚད་འདི་ ... \</caseinline\>\</switchinline\>འདི་ལས་  སྦོམ་ཡོད་པ་ཅིན་  གྲལ་ཐིག་རྐྱང་པའི་དོན་མཚམས་ཚུ་ མཉམ་མཐུད་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3154162				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>རིམ་མཐུད་རྒྱང་པའི་གྲལ་ཐིག་དོན་མཚམས་འདི་  དོན་མཚམས་རྐྱང་པའི་ནང་ལུ་  མཉམ་མཐུད་འབདཝ་ཨིན།  གདམ་ཁ་དེ་གིས་   "Default" དོན་མཚམས་བཟོ་རྣམ་ལག་ལེན་འཐབ་མི་གི་ དོན་མཚམས་ཚུ་ལུ་རྐྱངམ་ཅིག་ལཱ་འབདཝ་ཨིན།  དོན་མཚམས་འདི་  གསལ་བཀོད་འབད་ཡོད་པའི་རིང་ཚད་གནས་གོང་ལས་རིངམ་ཡོད་པ་ཅིན་  དོན་མཚམས་འདི་ ཤུལ་མའི་དོན་མཚམས་དང་ཅིག་ཁར་  མཉམ་མཐུད་འབདཝ་ཨིན།  རིང་ཚད་གནས་གོང་མ་འདྲཝ་ཅིག་ཐོ་བཀོད་འབད་ནི་ལུ་ གདམ་ཁ་འདི་སེལ་འཐུ་འབད་བཞིནམ་ལས་   \<link href=\"text/swriter/01/05150104.xhp\"\>\<emph\>ཞུན་དག་འབད་\</emph\>\</link\>ཨེབ་གཏང་འབད། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3144749				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>ཞུན་དག་འབད། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3153841				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<ahelp hid=\"OFFMGR:PUSHBUTTON:RID_OFAPAGE_AUTOFMT_APPLY:PB_EDIT\"\>གིས་  སེལ་འཐུ་འབད་ཡོད་པའི་  རང་བཞིན་ནོར་བཅོས་གདམ་ཁ་འདི་ལེགས་བཅོས་འབདཝ་ཨིན།\</ahelp\>\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
