helpcontent2	source\text\swriter\01\04020000.xhp	0	help	par_id3154480				0	dz	\<variable id=\"bereich\"\>\<ahelp hid=\"FN_INSERT_COLUMN_SECTION\"\> ཡིག་ཆའི་ནང་ལུ་འོད་རྟགས་ཀྱི་གནས་ས་ལུ་ ཚིག་ཡིག་གི་དབྱེ་ཚན་ཅིག་བཙུགསཔ་ཨིན། ཁྱོད་ཀྱིས་ཚིག་ཡིག་གི་སྡེབ་ཚན་ཅིག་སེལ་འཐུ་འབད་ཞིནམ་ལས་ དེ་ལས་ དབྱེ་ཚན་གསར་བསྐྲུན་འབད་ནིའི་དོན་ལུ་བརྡ་བཀོད་དེ་གདམ་ཁ་རྐྱབས། ཁྱོད་ཀྱིས་ ཡིག་ཆ་གཞན་མི་ཚུ་ནང་ལས་ཚིག་ཡིག་སྡེབ་ཚན་བཙུགས་ནིའི་དོན་ལུ་དང་ སྲོལ་སྒྲིག་ཀེར་ཐིག་སྒྲིག་བཀོད་ ཡང་ན་ གནས་སྟངས་དང་ལྡན་ཏོག་ཏོ་ཡོད་པ་ཅིན་ ཚིག་ཡིག་གི་སྡེབ་ཚན་ཉེན་སྐྱོབ་འབད་ནིི་དང་ ཡང་ན་ སྦ་བཞག་ནིའི་དོན་ལུ་ དབྱེ་ཚན་ཚུ་ལག་ལེན་འཐབ།\</ahelp\>\</variable\>				2002-02-02 02:02:02
