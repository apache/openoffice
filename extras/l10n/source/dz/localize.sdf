helpcontent2	source\text\shared\guide\space_hyphen.xhp	0	help	par_id3154306	60			0	dz	རང་བཞིན་སྦྲེལ་རྟགས་བཀལ་ནི་འདི་ ཁྱོད་རང་གིས་འབད་མིང་ཚིག་ཅིག་ནང་ དབྱེ་བྱེད་ཅིག་ཐོ་བཀོད་འབད་ཐོག་ རྒྱབ་སྐྱོར་འབད་ནིའི་དོན་ལས་ ལྡེ་མིག་ \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>བརྡ་བཀོད་ \</caseinline\>\<defaultinline\>ཚད་འཛིན་\</defaultinline\>\</switchinline\>+ཕབ་རྟགས་འདི་ལག་ལེན་འཐབ། མིང་ཚིག་འདི་ འ་ནི་དོན་མཚམས་ཀྱི་དོན་ལུ་རང་བཞིན་སྦྲེལ་རྟགས་བཀལ་ནི་འདི་ ཨོཕ་ལུ་སོར་བསྒྱུར་འབད་ཡོད་རུང་ གྲལ་ཐིག་གི་མཇུག་ལུ་ཨིན་པའི་སྐབས་ འ་ནི་གནས་སུ་ལུ་སོ་སོ་འཕྱལ་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
