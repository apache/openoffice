helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154904	131			0	dz	=HYPGEOMDIST(2; 2; 90; 100) གིས་ ཐོན་བསྐྱེད་ ༠་༨༡ འབྱུངམ་ཨིན། འབྲི་ཁྲི་གུ་ལས་ མར་དབུར་དབུར་བའི་བམ་རོ་ཊི་ ༡༠༠ ཡོད་ས་ལས་ ༩༠ འབུད་དེ་ དང་པ་རང་མར་དབུར་དབུར་བའི་ཕྱོགས་ལས་མར་ས་ཁར་ལུ་རེག་སྟེ་ འབྲི་ཁྲི་གུ་ལས་ མར་དབུར་དབུར་བའི་བམ་རོ་ཊི་གཉིས་ མར་བཀོ་བ་ཅིན་ འབྱུང་འགྱུར་དེ་ ༨༡% ཨིནམ་མ་ཚད་ བམ་རོ་ཊི་གཉིས་ཆ་རང་གིས་ དང་པ་རང་ མར་དབུར་དབུར་བའི་ཕྱོགས་ལུ་ཕོགཔ་ཨིན།				2002-02-02 02:02:02
