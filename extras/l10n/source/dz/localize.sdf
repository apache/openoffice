helpcontent2	source\text\shared\01\02230100.xhp	0	help	par_id3155934				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>ཁྱོད་ཀྱིས་ \<emph\>དྲན་ཐོ་ - སྟོན་\</emph\>གདམ་ཁ་བརྐྱབ་པ་ཅིན་  བསྒྱར་བཅོས་འབད་ཡོད་པའི་ཚིག་ཡིག་དོན་ཚན་ཡོད་མི་གྲལ་ཐིག་ཚུ་  ཤོག་ལེབ་གཡོན་གྱི་ས་སྟོང་ནང་ལུ་ཀེར་ཕྲང་གྲལ་ཐིག་གིས་  བརྡ་སྟོནམ་ཨིན།  \<link href=\"text/shared/optionen/01040700.xhp\" name=\"Tools - Options - Writer - Changes\"\>\<emph\>ལག་ཆས་ཚུ་ - གདམ་ཁ་ཚུ་ - %PRODUCTNAME Writer - བསྒྱུར་བཅོས་ཚུ་\</emph\>\</link\>གདམ་ཁ་བརྐྱབ་སྟེ་  ཁྱོད་ཀྱིས་  ཀེར་ཕྲང་གྲལ་ཐིག་དང་རྟགས་བཀོད་པའི་ཆ་ཤས་ཚུ་གི་  རྒྱུ་དངོས་འདི་གཞི་སྒྲིག་འབད་བཏུབ་ཨིན། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
