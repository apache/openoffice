helpcontent2	source\text\swriter\01\04060000.xhp	0	help	par_id3149288	2			0	dz	\<variable id=\"beschrifttext\"\>\<ahelp hid=\"HID_DLG_CAPTION\"\>སེལ་འཐུ་འབད་ཡོད་པའི་ཚད་རིས་དང་ ཐིག་ཁྲམ་ གཞི་ཁྲམ་ ཚིག་ཡིག་གཞི་ཁྲམ་ ཡང་ན་ དངོས་པོའི་དཔར་རིས་འབྲི་ནི་ཅིག་ལུ་ཨང་ཡིག་བཏགས་ཡོད་མི་དཔར་བཤད་ཅིག་ཁ་སྐོང་བརྐྱབ་ཨིན།\</ahelp\> ཁྱོད་ཀྱིས་ དེ་ལུ་ དཔར་བཤད་དེ་ཁ་སྐོང་བརྐྱབ་དགོ་མནོ་མི་རྣམ་གྲངས་དེེ་ལུ་ གཡས་ཀྱི་ཨེབ་གཏང་འབད་བའི་ཐོག་ལས་ བརྡ་བཀོད་འདི་ཡང་འཛུལ་སྤྱོད་འབད་འབད་ཚུགས།\</variable\>				2002-02-02 02:02:02
