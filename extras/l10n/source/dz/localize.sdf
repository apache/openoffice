helpcontent2	source\text\shared\01\05210500.xhp	0	help	par_id3153827				0	dz	\<ahelp hid=\"SVX:PUSHBUTTON:RID_SVXPAGE_BITMAP:BTN_MODIFY\"\>ཁྱོད་ཀྱིས་ \<emph\>དཔེ་རིས་ཞུན་དགཔ་\</emph\>ནང་ཁསར་བསྐྲུན་འབད་ཡོད་པའི་ བིཊི་མེཔ་འདི་  བིཊི་མེཔ་དཔེ་རིས་དང་བཅས་ཚབ་བཙུགས་འབདཝ་ཨིན།ཁྱོད་རང་དགོ་པ་ཅིན་  དཔེ་རིས་འདི་ཁྱོད་ཀྱིས་  མིང་སོ་སོ་གི་འོག་ལུ་སྲུང་བཞག་འབད་བཏུབ་ཨིན།་\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05210500.xhp	0	help	par_id3148473				0	dz	\<ahelp hid=\"SVX:PUSHBUTTON:RID_SVXPAGE_BITMAP:BTN_IMPORT\"\>ཁྱོད་ཀྱིས་ནང་འདྲེན་འབད་དགོ་པའི་  བིཊི་མེཔ་འདི་ག་ཡོད་འཚོལ་ནི་དང་   \<emph\>ཁ་ཕྱེ་གུ་\</emph\>ཨེབ་གཏང་འབད། བིཏི་མེཔ་འདི་  འཐོབ་ཚུགས་པའི་བིཊི་མེཔ་གི་ཐོ་ཡིག་ལུ་ཁ་སྐོང་བརྐྱབ་ཡོད།\</ahelp\>				2002-02-02 02:02:02
