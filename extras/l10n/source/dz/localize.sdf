helpcontent2	source\text\sbasic\shared\03020402.xhp	0	help	par_id3145172				0	dz	\<emph\>ཚིག་ཡིག:\</emph\> ཡིག་རྒྱུན་གསལ་བརྗོད་གང་རུང་འདི་དྲེན་འཕྲུལ་གསརཔ་གི་དྲེན་འཕྲུལ་ཡིག་གུ་འདི་ནང་ན་ཡོདཔ་ཨིན། ཁྱོད་ཀྱིས་ཡང་ \<link href=\"text/sbasic/shared/00000002.xhp\" name=\"URL notation\"\>ཡུ་ཨར་ཨེལ་དབྱངས་རྟགས་འདི་ལག་ལེན་འཐབ་བཏུབ་ཨིན།\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03020402.xhp	0	help	par_id3145785				0	dz	དྲན་འཕྲུལ་དེ་ཚུགས་ཡིག་གི་ཡིག་གུ་ཅིག་སྦེ་འགན་སྤྲོད་དགོཔ་ཨིན། ཝིན་ཌོསི་གི་འོག་ལུ་ ཁྱོད་ཀྱིས་འགན་སྤྲོད་མི་དྲེན་འཕྲུལ་དེ་ མཇུག་དྲེན་འཕྲུལ་་ནང་སྒྲིག་སྟངས་ཚུ་གིས་འབད་བསྐྱར་ལོག་དམ་དྲགས་འབད་ཡོདཔ་ཨིན། དྲན་འཕྲུལ་སྒྲུག་རྟགས་དེ་སྣ་མང་ཡིག་འབྲུ་ཡིག་རྒྱུན་ཨིན་པ་ཅིན་ ཡིག་གུ་དང་པམ་རྐྱངམ་ཅིག་འབྲེལ་བ་ཡོདཔ་ཨིན། ཁྱོད་ཀྱིས་གནས་པ་མེད་པའི་དྲན་འཕྲུལ་ཅིག་འཛུལ་སྤྱོད་འབད་ནི་ལུ་དཔའ་བཅམ་པ་ཅིན་་འཛོལ་བ་ཅིག་ཁྱོད་ཀྱིས་ལན་བཀོད་ནི་དང་གཅིག་ཁར་འཛོལ་བ་གུ་གསལ་བཤད་དེ་འབྱུངམ་ཨིན།				2002-02-02 02:02:02
