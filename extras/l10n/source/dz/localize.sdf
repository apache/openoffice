helpcontent2	source\text\smath\01\05010000.xhp	0	help	par_id3154566				0	dz	\<emph\>Fonts\</emph\> ཌའི་ལོག་འདི་གི་དབྱེ་ཚན་ནང་ལུ་  ཁྱོད་ཀྱིས་མན་ངག་ནང་ལུ་ཚིག་ཡིག་ཆ་ཤས་གཞན་མི་རྩ་སྒྲིག་འབད་ཚུགས་མི་ ཡིག་གཟུགས་ཚུ་ངེས་འཛིན་འབད་ཚུགས། གཞི་རིམ་ཡིག་གཟུགས་གསུམ་ \<emph\>སེ་རིཕ་ སཱནསི་\</emph\> དང་ \<emph\>གཏན་བཟོས་\</emph\> ཚུ་འཐོབ་ཚུགསཔ་ཡོད། ཚད་ལྡན་སྦེ་གཞི་བཙུགས་འབད་ཡོད་པའི་གཞི་རིམ་ཡིག་གཟུགས་རེ་རེའི་དོན་ལས་ཁྱོད་ཀྱིས་ ཡིག་གཟུགས་གཞན་མི་ག་སྦེ་རུང་ཁ་སྐོང་རྐྱབས་ཚུགས། ཁྱོད་རའི་རིམ་ལུགས་གུ་ལུ་གཞི་བཙུགས་འབད་ཡོད་པའི་ཡིག་གཟུགས་རེ་རེ་བཞིན་ཁྱོད་ཀྱི་ལག་ལེན་གྱི་དོན་ལུ་འཐོབ་ཚུགསཔ་ཡོད།  \<emph\>ལེགས་བཅོས་\</emph\> ཨེབ་རྟ་འདི་ ཐོ་ཡིག་སྒྲོམ་ནང་ལུ་བྱིན་ཏེ་ཡོད་པའི་སེལ་འཐུ་འདི་རྒྱ་འཕར་འབད་ནིའི་དོན་ལས་སེལ་འཐུ་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05010000.xhp	0	help	par_id3151315	17			0	dz	འ་ནི་སྲོལ་སྒྲིག་ཡིག་གཟུགས་ཚུ་ག་དེམ་ཅིག་སྦེ་ཁྱོད་ཀྱིས་ \<emph\>བརྡ་བཀོད་ཚུའི་\</emph\> སྒོ་སྒྲིག་ནང་ལུ་ཡིག་གཟུགས་བརྡ་བཀོད་འདི་དང་ཅིག་ཁར་ཡིག་གཟུགས་སོ་སོ་ཅིག་གཞི་སྒྲིག་འབདཝ་ཨིན་པ་ཅིན་ལག་ལེན་འཐབ་ཨིན།				2002-02-02 02:02:02
