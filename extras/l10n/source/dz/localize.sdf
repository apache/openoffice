helpcontent2	source\text\shared\explorer\database\02010100.xhp	0	help	par_id3156372				0	dz	\<ahelp hid=\"HID_QRYDGN_ROW_FIELD\"\> ཁྱོད་ཀྱིས་འདྲི་དཔྱད་ནང་ལུ་ གཞི་བསྟུན་འབད་ཡོད་པའི་ གནད་སྡུད་ས་སྒོ་གི་མིང་འདི་བཙུགས།  འོག་གི་གྲལ་ཐིག་ཚུ་གི་ནང་ལུ་  བཟོ་ཡོད་མི་སྒྲིག་སྟང་ཚུ་ཆ་མཉམ་རང་  ས་སྒོ་དེ་ལུ་གཞི་བསྟུན་འབད་ཡོདཔ་ཨིན།   \</ahelp\> ཁྱོད་ཀྱིས་ནང་ཐིག་འདི་མཱའུསི་དང་བཅས་ཤུགས་ལྡན་བཟོ་བ་ཅིན་  ཁྱོད་ལུ་ ས་སྒོ་སེལ་འཐུ་ལྕོག་ཅན་བཟོ་བཅུགས་མི་ མདའ་རྟགས་ཀྱི་ཨེབ་རྟ་འདི་མཐོངམ་ཨིན།  "Table name.*" དེ་གིས་ གནད་སྡུད་ས་སྒོ་ཚུ་ཆ་མཉམ་རང་སེལ་འཐུ་འབདཝ་ཨིནམ་དང་  ཁྱད་ཚད་འདི་  ཐིག་ཁྲམ་ས་སྒོ་ཆ་མཉམ་གྱི་དོན་ལས་  ནུས་ཅན་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
