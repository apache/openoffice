helpcontent2	source\text\shared\02\12110000.xhp	0	help	par_id3154230				0	dz	\<variable id=\"formfiltertext\"\>\<ahelp hid=\".uno:FormFilter\"\>གསལ་བཀོད་འབད་ཡོད་པའི་ཁྱད་ཚད་ཀྱིས་ མཐོང་ཚུགས་པའི་གནད་སྡུད་འདི་བཙག་ནི་གི་དོན་ལུ་ གནད་སྡུད་གཞི་རྟེན་གྱི་སར་བར་འདི་ལུ་ནུས་པ་སྤེལཝ་ཨིན། \</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12110000.xhp	0	help	par_id3152918				0	dz	སྤྱིར་བཏང་འཚོལ་ཞིབ་དང་མ་འདྲ་བའི་  \<link href=\"text/shared/02/12100200.xhp\" name=\"Find Record\"\>འབྲི་ཤོག་གི་ཕྲ་རིང་གུ་\</link\>འཚོལ་ཞིབ་\<emph\>དྲན་ཐོ་ངོས་དཔར་གིས་\</emph\>ཤུགས་ལྡན་བཟོ་མི་་འདི་ལུ་  ཁྱོད་ཀྱི་འབྲི་ཤོག་ལུ་ གཞི་བཞག་མི་  ཚགས་མ་འདི་ལག་ལེན་འཐབ་ཐོག་ལས་  འཕྲལ་མགྱོགས་རང་འཚོལ་ཞིབ་འབད་བཏུབ་ཨིན།  ཨ་རྟག་བཟུམ་སྦེ་རང་ འཕྲལ་མགྱོགས་གནད་སྡུད་གཞི་རྟེན་གྱི་སར་བར་འདི་ འཚོལ་ཞིབ་དང་གཅིག་ཁར་ ཤུགས་ཚད་བཟོཝ་ཨིན།  ད་མ་ཚད་ཁྱོད་ཀྱི་  གོ་དཀའ་བའི་འཚོལ་ཞིབ་གནས་སྟངས་ཧེང་བཀལ་ཐོ་བཀོད་འབད་བཏུབ་ཨིན།				2002-02-02 02:02:02
