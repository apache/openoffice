helpcontent2	source\text\shared\02\01170004.xhp	0	help	par_id3159400				0	dz	\<ahelp hid=\"SID_FM_SHOWCOLS\"\>ཁྱོད་ཀྱི་ཀེར་ཐིག་འདི་ཚུ་ ལོག་སྟེ་རང་སྟོན་ནི་སེལ་འཐུ་འབད་བཏུབ་ས་ལུ་  ཡན་ལག་དཀར་ཆག་ཅིག་བོད་བརྡ་འབདཝ་ཨིན། \</ahelp\> ཀེར་ཐིག་གཅིག་རྐྱངམ་ཅིག་སྟོན་ནི་ལུ་ ཀེར་ཐིག་གི་མིང་འདི་ལུ་ཨེབ་གཏང་འབད། ཁྱོད་ཀྱི་དང་པའི་གསང་བའི་ཀེར་ཐིག་ ༡༦་འདི་ལུ་རྐྱངམ་ཅིག་བལྟ། ཀོར་ཐིག་གསང་བ་ད་རུང་ཡང་ལེ་ཤཱ་ཡོད་པ་ཅིན་ སྟོན་ནིའི་ཀོར་ཐིག་གི་\<emph\>ཌའི་ལོག་འདི་ \</emph\> བོད་བརྡ་འབད་ནིའི་དོན་ལུ་\<emph\>བརྡ་བཀོད་ལེ་ཤཱ་འདི་\</emph\> གདམ་ཁ་རྐྱབ།				2002-02-02 02:02:02
