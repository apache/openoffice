helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3145801				0	dz	\<ahelp hid=\"HID_PROP_CONTROLLABEL\"\>ཚད་འཛིན་གྱི་ཁ་ཡིག་འདི་གི་དོན་ལུ་ འབྱུང་ཁུངས་དེ་གསལ་བཀོད་འབདཝ་ཨིན།\</ahelp\> གནད་སྡུད་གཞི་རྟེན་ས་སྒོ་ཅིག་གི་ མིང་གི་ཚབ་ལུ་ ཁ་ཡིག་ས་སྒོ་འདི་གི་ཚིག་ཡིག་འདི་ལག་ལེན་འཐབ་འོང་།  དཔེ་འབད་བ་ཅིན་  ཚགས་མ་\<emph\>ཕྲང་སྒྲིག་ནང་\</emph\>\<emph\>འཚོལ་ཞིབ་\</emph\>ཌའི་ལོག་དང་ ཐིག་ཁྲམ་གི་མཐོང་སྣང་ཡདི་ནང་ཀོར་ཐིག་གི་མིང་བཟུམ་ཅིག་སྦེ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3153223				0	dz	ལྡེ་སྒྲོམ་གུར་ཡོད་པའི་ཡིག་འབྲུ་དེ་མནན་ཐོོག་ལས་  ལག་ལེན་པ་འདི་གིས འ་ནི་ཚད་འཛིན་འདི་ འཛུལ་སྤྱོད་འབད་ནིའི་དོན་ལུ་ ཁ་ཡིག་གི་ཡིག་འབྲུ་གཅིག་ དྲན་སྐྱེད་སྦེ་ངེས་འཛིན་འབད་ནང་ལུ་ ཁ་ཡིག་འདི་ནང་  ཡིག་འབྲུ་འདི་གི་གདོང་ཁར་ སྣ་སྒྲ་ཅན་གྱི་རྟགས་ (~)ཡིག་འབྲུ་ཅིག་བཙུགས་བཞག་འབད།  				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3154502				0	dz	རེ་ཌིའོ་ཨེབ་རྟ་ཚུ་ལག་ལེན་འཐབ་ད་ སྡེ་ཚན་གཞི་ཁྲམ་གི་ཚིག་ཡིག་འདི་རྐྱངམ་ཅིག་  ཁ་ཡིག་གི་ས་སྒོ་སྦེ་ལག་ལེན་འཐབ་བཏུབ་ཨིན། འ་ནི་ཚིག་ཡིག་་དི་གིས་  སྡེ་ཚན་གཅིག་པའི་ རེ་ཌིའོ་གི་ཨེབ་རྟ་ཚུ་ཆ་མཉམ་ལུ་  འཇུགསྤྱོད་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3148587				0	dz	ཁྱོད་ཀྱིས་  ཚིག་ཡིག་ས་སྒོ་གི་སྦོ་ལོག་ཁར་ཡོད་པའི་\<emph\>...\</emph\>ཨེབ་རྟ་གུ་  ཨེབ་གཏང་པ་ཅིན་  ཁྱོད་ཀྱིས་  \<emph\>ཁ་ཡིག་ས་སྒོའིསེལ་འཐུ་\</emph\> ཌའི་ལོག་འདི་མཐོངམ་ཨིན།  ཐོ་ཡིག་ལས་ཁ་ཡིག་ཅིག་སེལ་འཐུ་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3154512	220			0	dz	\<ahelp hid=\"PCR_CHECKBOX_RID_DLG_SELECTLABELCONTROL_1\"\>Check the \<emph\>འགན་ལས་མེད་\</emph\>སྲོམ་འདི་  ཚད་འཛིན་དང་  འགན་སྤྲོད་འབད་ཡོད་པའི་ཁ་ཡིག་ས་སྒོའི་བར་ན་  ཡོད་པའི་འབྲེལ་ལམ་འདི་  རྩ་བསྐྲད་གཏང་ནི་དོན་ལུ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
