helpcontent2	source\text\sbasic\shared\00000002.xhp	0	help	par_id3156443				0	dz	ཨང་གྲངས་ཚུ་གཞི་བསྒྱུར་འབད་བའི་སྐབས་  $[officename] གཞི་རིམ་གྱིས་དབྱེ་སེལ་སྟོང་ཁྲག་དང་བཅུ་ཚག་གི་དབྱེ་བ་འདི་གཏན་འབེབས་བཟོ་ནིའི་དོན་ལུ་རིམ་ལུགས་འདིའི་ཉེན་གནས་སྒྲིག་སྟངས་ཚུ་ལག་ལེན་འཐབ་ཨིན། 				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\00000002.xhp	0	help	par_id3153092				0	dz	སྤྱོད་ལམ་འདི་གིས་བསམ་པའི་སྒོ་ལས་གཞི་བསྒྱུར་་འདི་གཉིས་ཆ་རང་གུ་ནུས་པ་ཡོད་ ( 1 + "2.3" = 3.3 ) པའི་ཁར་དེ་བཟུམ་སྦེ་རཱན་ཊའིམ་ལས་འགན་ \<link href=\"text/sbasic/shared/03102700.xhp\" name=\"IsNumeric\"\>ཨའི་ཨེསི་ཨང་གྲངས་ཀྱི་\</link\>.				2002-02-02 02:02:02
