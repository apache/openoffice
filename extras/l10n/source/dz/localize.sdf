helpcontent2	source\text\shared\autopi\01040000.xhp	0	help	par_id3147102				0	dz	\<variable id=\"agenda\"\>\<ahelp hid=\".uno:AutoPilotAgenda\"\>ལས་ཚབ་ཊེམ་པེལེཊི་གསར་བསྐྲུན་འབད་ནི་ནང་གྲོགས་རམ་འབད་ནི་ལུ་ ཝི་ཛརཌི་འགོ་བཙུགསཔ་ཨིན། \</ahelp\>\</variable\>ཞལ་འཛོམས་དང་འཛོམས་འདུའི་གྲོས་བསྡུར་གནད་དོན་ཚུ་གསལ་བཀོན་འབད་ནི་ལུ་ ཁྱོད་ཀྱིས་ལས་ཚབ་ཅིག་ལག་ལེན་འཐབ་ཚུགས། 				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\01040000.xhp	0	help	par_id3156414				0	dz	$[officename]འདི་ ཁྱོད་ཀྱིས་དགོ་འདོད་འགྲུབ་ནིའི་ལེགས་བཅོས་འབད་བཏུབ་པའི་གྲོས་གཞི་ཚུ་གི་དོན་ལུ་ དཔེ་ཚད་ཊེམ་པེལེཊི་ཅིག་དང་བཅས་འབྱུངམ་ཨིན། ཝི་ཛརཌི་འདི་གིས་ ཡིག་ཆ་ཊེམ་པེལེཊི་གསར་བསྐྲུན་འབད་ནི་ནང་ སྒྲིག་བཀོད་དང་བཀོད་སྒྲིག་གདམ་ཁ་སྣ་ཚོགས་ཚུ་བྱིནམ་ཨིན། དེ་ལས་སྔོན་ལྟ་གིས་ རྫོགས་ཡོད་པའི་གྲོས་གཞི་འདི་ག་དེ་སྦེ་འབྱུང་འོང་ག་གི་སྤྲོ་སྣང་བྱིནམ་ཨིན། 				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\01040000.xhp	0	help	par_id3147571				0	dz	ཝི་ཛརཌི་ནང་འཁོད་ལུ་ ཁྱོད་རའི་ཐོ་བཀོད་ཚུ་ནམ་འབད་རུང་ལེགས་བཅོས་འབད་བཏུབ།  དེ་མ་ཚད་ ཁྱོད་ཀྱིས་ ཤོག་ལེབ་ཧྲིལ་བུ་གོམ་འགྱོ་ཚུགསཔ་འོང་ ཡང་ན་ ཝི་ཛརཌི་ཤོག་ལེབ་ཚུ་ཆ་མཉམ་ནང་ (སྔོན་སྒྲིག་)ད་ལྟོའི་སྒྲིག་སྟངས་ཚུ་ནུས་ལྡན་སྦེ་སྡོད་འོང་།				2002-02-02 02:02:02
