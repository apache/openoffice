helpcontent2	source\text\shared\00\00000002.xhp	0	help	par_id3156360				0	dz	\<link href=\"text/shared/00/00000002.xhp#html\" name=\"HTML\"\>ཨེཆ་ཊི་ཨེམ་ཨེལ་\</link\> ཤོག་ལེབ་ཀྱིས་ ངོ་རྟགས་ཚུ་ཟེར་མི་གི་རྩ་སྒྲིག་བསླབ་སྟོན་དང་ གཞི་བཀོད་ལ་ལོ་ཅིག་ཡོདཔ་ཨིན། ཨེཆ་ཊི་ཨེམ་ཨེལ་ སྐད་ཡིག་འགྲེལ་བཤད་ཡིག་ཆ་ནང་ གུག་ཤད་ཚུ་གི་ནང་ན་ཚུད་ཡོད་པའི་ཨང་རྟགས་ཀྱི་མིང་ཚིག་ཨིན།  གུག་ཤད་ཁ་ཕྱེ་མི་དང་ཁ་བསྡམས་མི་གཉིས་ཀྱི་བར་ན་ཚིག་ཡིག་ཡང་ན་ ཧའི་པར་ལིངཀི་གཞི་བསྟུན་ཚུ་ ངོ་རྟགས་ཚུ་ལུ་ཡོདཔ་ཨིན།  དཔེར་ན་ མགོ་མིང་ཚུ་འགོ་བཙུགསཔ་ད་<h1>གིས་རྟགས་དང་ མགོ་མིང་གི་མཇུག་ལུ་</h1>ཡོདཔ་ཨིན། ངོ་རྟགས་ལ་ལོ་ཅིག་གིས་ གྲལ་ཐིག་མཚམས་ཀྱི་དོན་ལུ་<br> དང་ཡང་ན་ ཚད་རིས་འབྲེལ་མཐུད་ལུ་<img ...>བཟུམ་སྦེ་ཁོང་རང་གི་རྐྱངམ་ཅིག་འབྱུང་ནི་ཡོད།				2002-02-02 02:02:02
