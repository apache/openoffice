helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3145107				0	dz	བར་སྟོང་ཚུ་(བར་སྟོང་ཚུ་)ཐད་ཀར་དུ་བརྡ་བཀོད་ཚུའི་སྒོ་སྒྲིག་ནང་ལུ་ཐོ་བཀོད་འབད་བའི་སྐབས་ རྒྱུ་རྗས་ཚུའི་བར་ན་བཙུགས་ནི་ངེས་ཏིག་བཟོ། འ་ནི་འདི་གིས་གཞི་བཀོད་ངེས་བདེན་འདི་ངོས་འཛིན་བྱུང་ཡོདཔ་སྦེ་ངེས་ཏིག་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3153198				0	dz	\<link href=\"text/smath/01/03091200.xhp\" name=\"indexes and exponents\"\> ཟུར་ཐོ་ཚུ་དང་བསྒྱུར་གྲངས་ཚུ་\</link\> དེ་ལས་ \<link href=\"text/smath/01/03091400.xhp\" name=\"scaling\"\>ཚད་འཇལ་ནི་\</link\> ཚུའི་སྐོར་གྱི་ཕན་ཐོགས་ཅན་གྱི་བརྡ་དོན་ཚུ་གིས་ མན་ངག་ཚུ་ནུས་པ་ཅན་སྦེ་གཞི་བཀོད་འབད་ནི་ལུ་གྲོགས་རམ་འབདཝ་ཨིན། གུག་ཤད་ཚུའི་སྐོར་ལས་བརྡ་དོན་ཧེང་བཀལ་གྱི་དོན་ལུ་  \<link href=\"text/smath/01/03091100.xhp\" name=\"Brackets and Groups\"\>གུག་ཤད་ཚུ་དང་སྡེ་ཚན་བཟོ་ནི་ཚུ་\</link\> བལྟ།				2002-02-02 02:02:02
