helpcontent2	source\text\shared\explorer\database\05020100.xhp	0	help	par_id3153880	28			0	dz	\<ahelp hid=\"DBACCESS_LISTBOX_DLG_REL_PROPERTIES_LB_RIGHT_TABLE\" visibility=\"hidden\"\> འ་ནི་འདི་འབྲེལ་བ་ཡོད་མི་ཐིག་ཁྲམ་གཉིས་ཐོ་ཡགོད་འབད་ས་ཨིན།  \</ahelp\> ཁྱོད་ཀྱིས་ འབྲེལ་མཐུད་གསརཔ་ཅིག་གསར་བསྐྲུན་འབད་བ་ཅིན་  ཁྱོད་ཀྱིས་  ཌའི་ལོག་གིི་མགོའི་ཆ་ཤས་ནང་  ཀོམ་བོའི་སྒྲོམ་རེ་རེ་ལས་ ཐིག་ཁྲམ་སེལ་འཐུ་འབད་བཏུབ། 				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\05020100.xhp	0	help	par_id3154047				0	dz	འབྲེལ་མཐུད་སྒོ་སྒྲིག་ནང་ལུ་ཡོད་མི་ མཐུན་འབྲེལ་ལམ་ལུ་  གཡེབ་གཏང་ཐེང་གཉིས་ཨེབ་པའི་ཐོག་ལས་  གནས་དེ་ཡོད་པའི་འབྲེལ་མཐུད་དེ་གི་དོན་ལུ་  ཁྱོད་ཀྱིས་  \<emph\>འབྲེལ་མཐུད་\</emph\>ཁ་ཕྱེ་བ་ཅིན་  འབྲེལ་མཐུད་ནང་འབྲེལ་བ་ཡོད་མི་ཐིག་ཁྲམ་ཚུ་ ལེགས་བཅོས་འབད་མི་བཏུབ།				2002-02-02 02:02:02
