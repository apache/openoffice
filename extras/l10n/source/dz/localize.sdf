helpcontent2	source\text\shared\01\05340200.xhp	0	help	par_id3147008				0	dz	\<ahelp hid=\"DBACCESS_CHECKBOX_DLG_COLWIDTH_CB_STANDARD\" visibility=\"visible\"\>ད་ལྟོའི་ཡིག་གཟུགས་ལུ་གཞི་བཞག་སྟེ་  ཀེར་ཐིག་གི་རྒྱ་ཚད་འདི་  རང་བཞིན་གྱིས་ བདེ་སྒྲིག་བཟོཝ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06010600.xhp	0	help	bm_id49745				0	dz	\<bookmark_value\>རྒྱ་ནག་གི་རྩོམ་སྒྲིག་རིམ་ལུགས་\</bookmark_value\>\<bookmark_value\>རྒྱ་ནག་གིས་འཇམ་སམ་བཟོ་བཟོཝ་;རྒྱ་ནག་གི་སྔོན་སྲོལ་ལུ་སྐད་བསྒྱུར་འབད་འབདཝ་\</bookmark_value\>\<bookmark_value\>སྔོན་སྲོལ་གྱི་རྒྱ་ནག་;འཇམ་སམ་བཟོ་བཟོཝ་གི་རྒྱ་ནག་ལུ་  སྐད་བསྒྱུར་འབད་དོ།\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10547				0	dz	\<link href=\"text/shared/01/06010600.xhp\"\>རྒྱ་ནག་གི་སྐད་བསྒྱུར།\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10557				0	dz	\<ahelp hid=\".\"\>སེལ་འཐུ་འབད་ཡོད་པའི་ཚིག་ཡིག་འདི་  རྒྱ་ནག་གི་རྩོམ་སྒྲིག་རིམ་ལུགས་གཅིག་ལས་  གཞན་མི་ལུ་སྐད་བསྒྱུར་འབདཝ་ཨིན།  ཚིག་ཡིག་འདི་སེལ་འཐུ་མ་འབད་བར་ཡོད་པ་ཅིན་  ཡིག་ཆ་ཧྲིལ་བུ་འདི་སྐད་བསྒྱུར་འབདཝ་ཨིན།\</ahelp\> ཁྱོད་ཀྱིས་\<emph\>ལག་ཆས་ཚུ་ - གདམ་ཁ་ཚུ་ - སྐད་ཡིག་སྒྲིག་སྟངས་ཚུ་ - སྐད་ཡིག་ཚུ་\</emph\>ནང་ཡོད་པའི་ཨེ་ཤི་ཡཱན་སྐད་ཡིག་རྒྱབ་སྐྱོར་འདི་  ལྕོགས་ཅན་བཟོ་བ་ཅིན་རྐྱངམ་ཅིག་  ཁྱོད་ཀྱིས་བརྡ་བཀོད་འདི་ལག་ལེན་འཐབ་བཏུབ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10576				0	dz	\<ahelp hid=\".\"\>སྐད་བསྒྱུར་གྱི་བཀོད་རྒྱ་འདི་སེལ་འཐུ་འབད།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10579				0	dz	སྔོན་སྲོལ་རྒྱ་ནག་ལས་ འཇམ་སམ་བཟོ་བཟོཝ་གི་རྒྱ་ནག་ལུ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1057D				0	dz	\<ahelp hid=\".\"\>སྔོན་སྲོལ་རྒྱ་ནག་གི་ཚིག་ཡིག་འདི་  འཇམ་སམ་བཟོ་བཟོཝ་གི་རྒྱ་ནག་ ཚིག་ཡིག་ཡིག་འབྲུ་ཚུ་ནང་ སྐད་བསྒྱུར་འབདཝ་ཨིན།   སེལ་འཐུ་འབད་ཡོད་པའི་ཚིག་ཡིག་འདི་སྐད་བསྒྱུར་འབད་ནི་དོན་ལུ་   \<emph\>བཏུབ་\</emph\> ཨེབ་གཏང་འབད། ཚིག་ཡིག་འདི་སེལ་འཐུ་མ་འབད་བར་ཡོད་པ་ཅིན་   ཡིག་ཆ་ཆ་མཉམ་རང་སྐད་བསྒྱུར་འབདཝ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10580				0	dz	འཇམ་སམ་བཟོ་བཟོཝ་གི་རྒྱ་ནག་ལས་  སྔོན་སྲོལ་གྱི་རྒྱ་ནག་ལུ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10584				0	dz	\<ahelp hid=\".\"\>འཇམ་སམ་བཟོ་བཟོཝ་གི་རྒྱ་ནག་ཚིག་ཡིག་ཡིག་འབྲུ་ཚུ་  སྔོན་སྲོལ་ཚིག་ཡིག་ཡིག་འབྲུ་ཚུ་ནང་  སྐད་བསྒྱུར་འབདཝ་ཨིན།   སེལ་འཐུ་འབད་ཡོད་པའི་ཚིག་ཡིག་འདི་སྐད་བསྒྱུར་འབད་ནི་དོན་ལུ་ \<emph\>བཏུབ་\</emph\> ཨེབ་གཏང་འབད།   ཚིག་ཡིག་འདི་སེལ་འཐུ་མ་འབད་བར་ཡོད་པ་ཅིན་  ཡིག་ཆ་ཆ་མཉམ་རང་སྐད་བསྒྱུར་འབདཝ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1058E				0	dz	མཐུན་མོང་གི་ལམ་ལུགས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10592				0	dz	\<ahelp hid=\".\"\>མཐུན་མོང་གི་ལམ་ལུགས་འདི་  སྔོན་སྲོལ་དང་འཇམ་སམ་བཟོ་བཟོཝ་གི་རྒྱ་ནག་གི་མིང་ཚིག་ཨིནམ་ད་   དེ་འབདཝ་ད་  ཡིག་འབྲུ་སོ་སོ་དང་བཅས་འབྲི་ཡོད་མི་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10599				0	dz	\<ahelp hid=\".\"\>མཐུན་མོང་གི་ལམ་ལུགས་ཐོ་ཡིག་ཚུ་ནང་ཡོད་པའི་  མིང་ཚིག་གཉིས་ཡང་ན་མངམ་ཡོད་མི་ཚུ་སྐད་བསྒྱུར་འབདཝ་ཨིན། ཐོ་ཡིག་འདི་ཞིབ་ལྟ་འབད་ཚར་བའི་ཤུལ་ལས་  ལྷག་ལུས་ཡོད་པའི་ཚིག་ཡིག་འདི་  ཡིག་འབྲུ་གིས་ སྐད་བསྒྱུར་འབད་ཡོད་པའི་ཡིག་འབྲུ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1059C				0	dz	ལམ་ལུགས་ཚུ་ཞུན་དག་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN105A0				0	dz	\<ahelp hid=\".\"\>Opens the \<link href=\"text/shared/01/06010601.xhp\"\>ཚིག་མཛོད་དང་\</link\>ཌའི་ལོག་འདི་ཞུན་དག་འབད་  དེ་ཡང་   ཁྱོད་ཀྱིས་སྐད་བསྒྱུར་གྱི་ལམ་ལུགས་ཚུ་གི་ཐོ་ཡིག་ཞུན་དག་འབད་བཏུབ་མི།\</ahelp\>				2002-02-02 02:02:02
