helpcontent2	source\text\swriter\02\08010000.xhp	0	help	par_id3151184				0	dz	\<ahelp hid=\".uno:StatePageNumber\"\> ད་ལྟོའི་ ཤོག་ལེབ་ཀྱི་ཨང་དེ་ འ་ནི་གནས་ཚད་ཚད་ཕྲ་རིང་གི་ ས་སྒོ་ནང་བཀྲམ་སྟོན་འབད་ཡོདཔ་ཨིན།  ཁྱོད་ཀྱི་ཡིག་ཆ་ནང་  འགྲུལ་བསྐྱོད་འབད་བཏུབ་མི་དང་གཅིག་ཁར་  ཨེབ་གཏང་ཐེངས་གཉིས་ཀྱིས་  འགྲུལ་བསྐྱོདཔ་དེ་ཁ་ཕྱེཝ་ཨིན། གཡས་ཀྱི་ཨེབ་གཏང་གིས་  ཡིག་ཆ་ནང་གི་ དེབ་རྟགས་ཆ་མཉམ་སྟོནམ་ཨིན། ཚིག་ཡིག་གི་འོད་རྟགས་འདི་  དེབ་རྟགས་ཀྱི་གནས་ཁོངས་ནང་ལུ་  བཞག་ནི་ལུ་  དེབ་རྟགས་ལུ་ཨེབ་གཏང་འབད། \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\08010000.xhp	0	help	par_id3145078				0	dz	བཀྲམ་སྟོན་འབད་ཡོད་པའི་ ཤོག་ལེབ་ (x) དང་ ཤོག་ལེབ་(y)་ཚུ་གི་ བསྡོམས་གྲངས་དེ་ \<emph\>ཤོག་ལེབ་ x/y་ གི་འབྲི་ཤོག་ ནང་ལུ་\</emph\> སྟོན་ཡོདཔ་ཨིན། ཁྱོད་ཀྱི་ ཡིག་ཆ་བརྒྱུད་དེ་ མཱའུསི་གི་ཐོག་ལས་ བཤུད་སྒྲིལ་འབད་བའི་སྐབས་ ཁྱོད་ཀྱི་མཱའུསི་གི་ཨེབ་རྟ་དེ་ གཏངམ་ཅིག་ ཤོག་ལེབ་ཀྱི་ཨང་དེ་ བཀྲམ་སྟོན་འབདཝ་ཨིན།  ཁྱོད་ཀྱི་ གཡས་ཀྱི་བཤུད་ཕྲ་དེ་ ལག་ལེན་འཐབ་ཐོག་ལས་  བཤུད་སྒྲིལ་འབདཝ་ད་  ཤོག་ལེབ་ཀྱི་གྲངས་དེ་ཚུ་  གྲོགས་རམ་གྱི་ཕན་བསླབ་སྦེ་  བཀྲམ་སྟོན་འབདཝ་ཨིན།  གནས་ཚད་ཕྲ་རིང་དང་  བཤུད་ཕྲ་གི་  ཤོག་ལེབ་ཨང་བཏགས་བཀོད་ནིའི་  རྩ་སྒྲིག་འདི་  དབྱེར་མེད་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\08010000.xhp	0	help	par_id3145417	3			0	dz	ཁྱོད་ཀྱི་ \<link href=\"text/swriter/01/02110000.xhp\" name=\"Navigator\"\>Navigator\</link\>\<emph\>ཤོག་ལེབ་ཨང་\</emph\>གི་ས་སྒོ་དེ་ལུ་  ཨེབ་གཏང་ཐེངས་གཉིས་འབད་ཐོག་ལས་འགྲུལ་བསྐྱོདཔ་བཀྲམ་སྟོན་དེ་ཊཱན་ཨོཕ་འབད་ཨཱོན་ ཡང་ན་ ཨོཕ་འབད་བཏུབ།				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\08010000.xhp	0	help	par_id3149806				0	dz	དམིགས་བསལ་གྱི་ཤོག་ལེབ་ནང་ འགྱོ་ནི་ལུ་  ཤོག་ལེབ་ཀྱི་ཨང་དེ་  \<emph\>འགྲུལ་བསྐྱོདཔ་ནང་གི་ \</emph\> ཤོག་ལེབ་བསྒྱིར་རྟ་ནང་ ཐོ་བཀོད་འབད་ཞིནམ་ལས་  ལོང་ལྡེ་ལུ་ཨེབ་གཏང་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\08010000.xhp	0	help	par_id3149095				0	dz	མགྱོགས་ཐབས་ཀྱི་ལྡེ་མིག་  སོར་ལྡེ+\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>བརྡ་བཀོད་\</caseinline\>\<defaultinline\>ཚད་འཛིན་\</defaultinline\>\</switchinline\>+F5་ཨེབ་ཐོག་ལས་ ཁྱོད་ཀྱི་  ཤོག་ལེབ་ཀྱི་ཨང་ཅིག་ ཐོ་བཀོད་འབད་ནི་ལུ་  སོར་བསྒྱུར་འབདཝ་ཨིན།  ཁྱོད་ཀྱི་ལོག་ལྡེ་འདི་ ཨེབ་ད་  འོད་རྟགས་དེ་  སེལ་འཐུ་གྲུབ་པའི་ ཤོག་ལེབ་ནང་ སྤོ་བཤུད་འབདཝ་ཨིན།				2002-02-02 02:02:02
