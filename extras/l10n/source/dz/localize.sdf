helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3155114				0	dz	\<ahelp hid=\"SC:EDIT:RID_SCDLG_CONDFORMAT:EDT_COND3_2\" visibility=\"hidden\"\> གཞི་བསྟུན་ནའམ་གནས་གོང་ཡང་ན་མན་ངག་བཙུགས། \</ahelp\> ཁྱོད་ཀྱིས་ ཚད་བཟུང་གཉིས་དགོས་མཁོ་བའི་གནས་སྟངས་གཅིག་སེལ་འཐུ་གྲུབ་སྟེ་ཡོད་པ་ཅིན་ཚད་བཟུང་ས་སྒོ་ནང་ལུ་ཡང་ན་ཚད་བཟུང་གཉིས་ཆ་རང་ གཞི་བསྟུན་ཡང་ན་གནས་གོང་ངའམ་མན་ངག་བཙུགས། ཁྱོད་ཀྱིས་ འབྲེལ་བའི་གཞི་བསྟུན་ཚུ་ཤོམ་ཏེ་ཡོད་པའི་མན་ངག་ཚུ་ཡང་ལག་ལེན་འཐབ་བཏུབ་ཨིན། 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3145257				0	dz	ཚད་བཟུང་དེ་ཚར་གཅིག་ངེས་འཛིན་འབད་ཚར་ཞིནམ་ལས་ གནས་སྟངས་དེ་ མཇུག་བསྡུཝ་ཨིན། དེ་ཚུ་ བཟུམ་སྦེ་འབྱུང་འོང་:				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3150784				0	dz	ནང་ཐིག་གནས་གོང་དེ་ ༠ ཨིན་: ནང་ཐིག་བཟོ་རྣམ་གནས་གོང་སྟོང་ཆ  (ཁྱོད་ཀྱིས་ དེ་གནས་སྟངས་ལུ་འགན་སྤྲོད་མ་འབད་བའི་ཧེ་མ་ལས་རང་ ནང་ཐིག་བཟོ་རྣམ་ངེས་འཛིན་འབད་དགོཔ་ཨིན་)།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3150365				0	dz	ནང་ཐིག་གནས་གོང་དེ་  $B$20 དང་ $B$21བར་ཨིན་: ནང་ཐིག་བཟོ་རྣམ་གྲུབ་འབྲས་ (མཉམ་ཐོག་པའི་ གནས་གོང་བཅད་མཚམས་དེ་ ཧེ་མ་ལས་རང་ ནང་ཐིག་ B20 དང་ B21 ནང་གནས་དགོཔ་ཨིན་)།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3152992				0	dz	མན་ངག་དེ་ SUM($A$1:$A$5)= ༡༠: ནང་ཐིག་བཟོ་རྣམ་གྲུབ་འབྲས། ( A1 ལས་ A5 ཚུན་གྱི་ནང་ཐིག་ཚུ་ནང་ནང་དོན་ཚུའི་གྱངས་ཁ་དེ་ ༡༠ དང་མཉམ་པ་ཅིན་ སེལ་འཐུ་གྲུབ་ཡོད་པའི་ནང་ཐིག་ཚུ་གྲུབ་འབྲས་བཟོ་རྣམ་དང་གཅིག་ཁར་རྩ་སྒྲིག་འབད་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
