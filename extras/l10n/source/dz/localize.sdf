helpcontent2	source\text\simpress\guide\animated_gif_create.xhp	0	help	par_id3149377				0	dz	ཁྱོད་ཀྱི་གསལ་སྟོན་འདི་ཧེང་བཀལ་དང་འདོད་ཅན་བཟོ་ནི་ལུ་ཁྱོད་ཀྱི་བཤུད་ཚུ་གུ་ཚད་རིས་དངོས་པོ་ཚུའི་(གཟུགས་བརྙན་ཚུ་)དང་ཚིག་ཡིག་དངོས་པོ་ཚུ་དེ་ལས་པར་རིས་དངོས་པོ་ཚུ་ཁྱོད་ཀྱིས་བསྒུལ་ཅན་བཟོ་ཚུགས། $[officename] ཨིམ་པེརེསི་འདི་གིས་ཁྱོད་ཀྱི་བཤུད་ལས་དངོས་པོ་ཚུ་འཛོམས་ཐོག་ལས་ཁྱོད་ཀྱིས་བསྒུལ་བཟོ་གཟུགས་བརྙན་ཚུའི་(གཞི་ཁྲམ་ཚུ་)གསར་བསྐྲུན་འབད་ཚུགས་ནི་ཨིན་མི་འཇམ་སམ་བསྒུལ་བཟོ་ཞུན་དགཔ་བྱིནམ་ཨིན།				2002-02-02 02:02:02
