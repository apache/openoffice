helpcontent2	source\text\shared\02\01110000.xhp	0	help	par_id3154398				0	dz	\<ahelp hid=\".uno:PrintDefault\"\>ཤུགས་ལྡན་གྱི་ཡིག་ཆ་འདི་  ད་ལྟོའི་སྔོན་སྒྲིག་དཔར་བསྐྲུན་གྱི་སྒྲིག་སྟངས་དང་གཅིག་ཁར་དཔར་བསྐྲུན་འབད་ནི་དོན་ལུ་   དཔར་སྐྲུན་ཡིག་སྣོད་ཐད་ཀར་དུ་ཡོད་པའི་ \<emph\> ངོས་དཔར་འདི་ལུ་\</emph\> ཨེབ་གཏང་འབད།\</ahelp\>ཁྱོད་ཀྱི \<emph\>་དཔར་འཕྲུལ་སྒྲིག་སྟངས་ཀྱི་\</emph\> དཀར་ཆག་བརྡ་བཀོད་དང་གཅིག་ཁར་ བོད་བརྡ་འབད་བཏུབ་པའི་\<link href=\"text/shared/01/01140000.xhp\" name=\"Printer Settings\"\>\<emph\>དཔར་འཕྲུལ་གཞི་སྒྲིག་གི་ཌེའི་ལོག་ནང་\</emph\>\</link\> འ་ནིའདི་ཚུ་འཐོབ་ཚུགས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01110000.xhp	0	help	par_id3147275	3			0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>ཁྱོད་ཀྱི་ཆིག་ཡིག་ཡང་ན་ཚད་རིས་ཅིག་སེལ་འཐུ་འབད་བཞིནམ་ལས་\<emph\>དཔར་བསྐྲུན་ཡིག་སྣོད་ཐད་ཀར་གྱི་ངོས་དཔར་འདི་ལུ་\</emph\>ཨེབ་གཏང་འབད་བ་ཅིན་ ཁྱོད་ལུ་ཡིག་ཆ་ཡང་ན་སེལ་འཐུ་འདི་དཔར་བསྐྲུན་འབད་ནི་ལུ་ ནུས་སྤེལ་འབད་ཝ་ཨིན། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01110000.xhp	0	help	par_id9547105				0	dz	ད་ལྟོའི་ཡིག་ཆ་འདི་གིས་ ཁྱོད་རའི་རིམ་ལུགས་བཀོལ་བསྐྱོད་འབད་ནིའི་དོན་ལུ་ དཔར་འཕྲུལ་   སྔོན་སྒྲིག་མེན་པའི་དཔར་འཕྲུལ་ཅིག་ལག་ལེན་འཐབ་པ་ཅིན་  \<emph\>དཔར་བསྐྲུན་ཡིག་སྣོད་ཐད་ཀར་གྱི་ངོས་དཔརཕ་འདི་གིས་ \</emph\>དཔར་བསྐྲུན་\<link href=\"text/shared/01/01130000.xhp\"\>\<emph\>ཌའི་ལོག་ཅིག་\</emph\>\</link\>ཁ་ཕྱེཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01110000.xhp	0	help	par_idN10679				0	dz	ད་ལྟོའི་ཡིག་ཆ་འདི་གིས་ སི་པེཌི་མིན་\<link href=\"text/shared/guide/spadmin.xhp\"\> དཔར་འཕྲུལ་ \</link\>བདག་སྐྱོང་ཀྱི་ལས་རིམ་ནང་ གསལ་བཀོད་འབད་ཡོད་པའི་ དཔར་འཕྲུལ་  སྔོན་སྒྲིག་དཔར་འཕྲུལ་མེན་མི་ཅིག་ལག་ལེན་འཐབ་པ་ཅིན་  \<emph\>དཔར་བསྐྲུན་ཡིག་ཆ་ཐད་ཀར་གྱི་\</emph\>ངོས་དཔར་འདི་གིས་  \<link href=\"text/shared/01/01130000.xhp\"\>\<emph\>དཔར་བསྐྲུན་\</emph\>\</link\> ཅིག་ཁ་ཕྱེཝ་ཨིན།				2002-02-02 02:02:02
