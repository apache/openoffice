helpcontent2	source\text\smath\main0503.xhp	0	help	par_id3156386				0	dz	དབྱེ་ཚན་འདི་ནང་ $[officename]ཨང་རྩིས་ཀྱིས་བྱིན་པའི་གལ་ཅན་ལས་འགན་ལ་ལོ་ཅིག་གི་སྤྱི་མཐོང་དང་ལྕོགས་གྲུབ་ཚུ་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\smath\main0503.xhp	0	help	par_id3148486				0	dz	$[officename] ཨང་རྩིས་ཀྱིས་ ཁྱོད་ཀྱིས་མན་ངག་གསར་བསྐྲུན་འབད་ནིའི་གྲོགས་རམ་གྱི་དོན་ལུ་ བཀོལ་སྤྱོད་པ་སྣ་ཚོགས་དང་ལས་འགན་དེ་ལས་རྩ་སྒྲིག་ལས་རོགས་ཚུ་བྱིནམ་ཨིན། དེ་ཚུ་ཆ་མཉམ་ར་སེལ་འཐུའི་སྒོ་སྒྲིག་ཅིག་ནང་ཐོ་ཡིག་བཀོད་དེ་ཡོད་ དེ་ཡང་ ཁྱོད་རའི་ལཱ་ནང་དངོས་པོ་བཙུགས་ནིའི་དོན་ལུ་ མའུསི་གི་ཐོག་ལས་དགོ་པའི་ཆ་ཤས་ལུ་ཨེབ་གཏང་འབད་ཚུགས།  དེ་ནང་ རྫོགས་ནི་ཡོད་པའི་\<link href=\"text/smath/01/03091500.xhp\" name=\"reference\"\>གཞི་བསྟུན་\</link\> ཐོ་ཡིག་དང་ གྲོགས་རམ་ནང་\<link href=\"text/smath/01/03090900.xhp\" name=\"samples\"\>དཔེ་ཚད་\</link\>སྣ་ཚོགས་ཚུ་ཡོདཔ་ཨིན། .				2002-02-02 02:02:02
helpcontent2	source\text\smath\main0503.xhp	0	help	hd_id3150207				0	dz	མན་ངག་ཅིག་གསར་བསྐྲུན་འབད་དོ།				2002-02-02 02:02:02
helpcontent2	source\text\smath\main0503.xhp	0	help	par_id3145386				0	dz	དཔེ་རིས་དང་གཟུགས་བརྙན་ཚུ་གི་ཐོག་ལས་ མན་ངག་ཚུ་དངོས་པོ་བཟུམ་སྦེ་ཡིག་ཆ་ནང་ལུ་གསར་བསྐྲུན་འབད་ཡི། ཡིག་ཆ་ནང་ལུ་མན་ངག་ཅིག་བཙུགས་མི་འདི་གིས་ $[officename]ཨང་རྩིས་ རང་བཞིན་གྱིས་འགོ་བཙུགསཔ་ཨིན། ཁྱོད་ཀྱིས་ སྔ་གོང་ལས་ངེས་འཛིན་འབད་ཡོད་པའི་བརྡ་མཚོན་སེལ་འཐུ་སྦོམ་དང་ལས་འགན་ཚུ་ལག་ལེན་འཐབ་པའི་ཐོག་ལས་ གསར་བསྐྲུན་དང་ཞུན་དག་དེ་ལས་རྩ་སྒྲིག་འབད་ཚུགས།				2002-02-02 02:02:02
helpcontent2	source\text\smath\main0503.xhp	0	help	hd_id3153916				0	dz	མན་ངག་ཅིག་ཐད་ཀར་དུ་ཡིག་དཔར་རྐྱབ་དོ།				2002-02-02 02:02:02
helpcontent2	source\text\smath\main0503.xhp	0	help	par_id3150213				0	dz	 $[officename] ཨང་རྩིས་སྐད་ཡིག་དང་འབྲེལ་བ་ཡོད་པ་ཅིན་ ཁྱོད་ཀྱིས་ཡིག་ཆའི་ནང་ལུ་ མན་ངག་ཐད་ཀར་དུ་ཡིག་དཔར་བརྐྱབ་ཚུགས། དཔེར་ན་ མན་ངག་འདི་ཚིག་ཡིག་ཡིག་ཆ་་ནང་ཡིག་དཔར་རྐྱབས་:"a sup 2 + b sup 2 = c sup 2". ཚིག་ཡིག་འདི་སེལ་འཐུ་འབད་ཞིནམ་ལས་ \<emph\>བཙུགས་ - དངོས་པོ་ - མན་ངག་\</emph\>གདམས། ཚིག་ཡིག་འདི་ རྩ་སྒྲིག་འབད་ཡོད་པའི་མན་ངག་ནང་གཞི་བསྒྱུར་འབད་འོང་།				2002-02-02 02:02:02
helpcontent2	source\text\smath\main0503.xhp	0	help	par_id3146325				0	dz	མན་ངག་ཚུ་  $[officename]ཨང་རྩིས་ནང་རྩིས་བཏོན་མི་ཚུགས་ ག་ཅི་སྦེ་ཟེར་བ་ཅིན་ འདི་མན་ངག་ཞུན་དགཔ་(མན་ངག་བྲིས་ནི་དང་སྟོན་ནིའི་དོན་ལུ་)དང་རྩིས་ལས་ལས་རིམ་མེན། མན་ངག་ཚུ་རྩིས་བཏོན་ནིའི་དོན་ལུ་ ཤོག་ཁྲམ་ལག་ལེན་འཐབ་ ཡང་ན་ འཇམ་སམ་རྩིས་ལས་ཨིན་པ་ཅིན་ ཚིག་ཡིག་ཡིག་ཆའི་རྩིས་ལས་ལས་འགན་འདི་ ལག་ལེན་འཐབ།				2002-02-02 02:02:02
helpcontent2	source\text\smath\main0503.xhp	0	help	hd_id3145829				0	dz	བརྡ་བཀོད་སྒོ་སྒྲིག་ནང་ མན་ངག་ཅིག་གསར་བསྐྲུན་འབད་དོ།				2002-02-02 02:02:02
helpcontent2	source\text\smath\main0503.xhp	0	help	par_id3153001				0	dz	\<ahelp hid=\"HID_SMA_COMMAND_WIN_EDIT\"\>མན་ངག་ཐོ་འགོད་དང་ཞུན་དག་འབད་ནིའི་དོན་ལས་ $[officename] ཨང་རྩིས་བརྡ་བཀོད་ཚུ་ལག་ལེན་འཐབ། ཁྱོད་ཀྱིས་ བརྡ་བཀོད་སྒོ་སྒྲིག་ནང་ཐོ་འགོད་འབད་ཡོདཔ་ལས་ ཡིག་ཆ་ནང་གྲུབ་འབྲས་ཚུ་མཐོང་ཚུགས། \</ahelp\>མན་ངག་ཐུང་ཀུ་དང་གོ་དཀའ་བ་ཚུ་གསར་བསྐྲུན་འབད་བའི་སྐབས་ལུ་ སྤྱི་མཐོང་རྒྱུན་སྐྱོང་གི་དོན་ལུ་ ལག་ཆས་ཕྲ་རིང་གུ་ མན་ངག་འོད་རྟགས་འདི་ལག་ལེན་འཐབ། ལས་འགན་འདི་ཤུགས་ལྡན་བཟོ་ཞིནམ་ལས་ བརྡ་བཀོད་སྒོ་སྒྲིག་ནང་ཡོད་མི་འོད་རྟགས་ཀྱི་གནས་ཁོངས་འདི་ཡང་ ཚིག་ཡིག་སྒོ་སྒྲིག་ནང་ལུ་སྟོན་འོང་།				2002-02-02 02:02:02
