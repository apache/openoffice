helpcontent2	source\text\swriter\01\06180000.xhp	0	help	par_id3150249	2			0	dz	\<variable id=\"zeinum\"\>དེ་གིས་ ད་ལྟོའི་ཡིག་ཆའི་ནང་ལུ་ ཁ་སྐོང་དང་རྩ་བསྐྲད་ངཏམ་ཨིནམ་དང་ ཡང་ན་ གྲལ་ཐིག་གི་གྱངས་ཁ་ཚུ་རྩ་སྒྲིག་འབདཝ་ཨཨིན། དོན་མཚམས་ཅིག་ གྲལ་ཐིག་ཨང་གྲངས་བཏགས་ནི་ལས་བཏོན་གཏང་ནིའི་དོན་ལུ་ དོན་མཚམས་ལུ་ཨེབ་གཏང་འབད་ནི་དང་  \<emph\>རྩ་སྒྲིག་ - དོན་མཚམས་\</emph\>དེ་གདམ་ཁ་བརྐྱབ་ནི་དང་ \<emph\>ཨང་གྲངས་བཏགས་ནིའི་ \</emph\>མཆོང་ལྡེ་དེ་ལུ་ཨེབ་གཏང་འབད་ཞིནམ་ལས་ དེ་ལས་ \<emph\>དོན་མཚམས་འདི་ གྲལ་ཐིག་ཨང་གྲངས་བཏགས་ནི་\</emph\>ཞིབ་དཔྱད་སྒྲོམ་གྱི་གྲངས་སུ་བཙུགས་ཟེར་མི་འདི་བསལ། \</variable\> ཁྱོད་ཀྱིས་ གྲལ་ཐིག་ཨང་གྲངས་བཏགས་ནི་ལས་ དོན་མཚམས་གྱི་བཟོ་རྣམ་ཅིག་གྲངས་ལས་བཏོན་གཏང་ཚུགས།				2002-02-02 02:02:02
