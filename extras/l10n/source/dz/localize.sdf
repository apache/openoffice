helpcontent2	source\text\shared\02\01170600.xhp	0	help	par_id3149760				0	dz	\<ahelp hid=\".uno:ShowFmExplorer\"\>འབྲི་ཤོག་འགྲུལ་བསྐྱོདཔ་འདི་\<emph\>ཁ་ཕྱེཝ་ཨིན།\</emph\>. འབྲི་ཤོག་  \<emph\>འགྲུལ་བསྐྱོདཔ་འདི་གིས་ \</emph\> ཁོང་རའི་ རིམ་བཞིན་གྱི་ཚད་འཛིན་དང་གཅིག་ཁར་  ད་ལྟོའི་ཡིག་ཆ་གི་  འབྲི་ཤོག་དང་ ཡན་ལག་འབྲི་ཤོག་འདི་ཚུ་ཆ་མཉམ་ བཀྲམ་སྟོན་འབདཝ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170600.xhp	0	help	par_id3147399				0	dz	འབྲི་ཤོག་ལག་ལེན་འཐབ་པའི་སྐབས་  འབྲི་ཤོག་འགྲུལ་བསྐྱོདཔ་འདི་གིས་  འབྲི་ཤོག་ཆ་མཉམ་གི་  སྤྱི་མཐོང་ཚུ་སྟོནམ་ཨིམ་དང་  ཞུན་དག་འབད་ནིའི་དོན་ལུ་   འདྲ་མིན་སྣ་ཚོགས་ཀྱི་ ལས་འགན་ཚུ་བྱིནམ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170600.xhp	0	help	par_id3155552				0	dz	\<ahelp hid=\"HID_FORM_NAVIGATOR\"\>འབྲི་ཤོག་ \<emph\>འགྲུལ་བསྐྱོདཔ་འདི་གི་ནང་ན་\</emph\>ཆ་མཉམ་པའི་  ཚད་འཛིན་གྱི་  ས་སྒོ་ཚུ་དང་གཅིག་ཁར་  གསར་བསྐྲུན་འབད་ཡོད་པའི་(གཏན་ཚིག་ཅན་གྱི་)འབྲི་ཤོག་ཚུ་  གེ་རང་ཡོདཔ་ཨིན།\</ahelp\>ཐོ་བཀོད་གི་ཧེ་མ་ བཀྲམ་སྟོན་འབད་ཡོད་པའི་  བསྡོམས་རྟགས་ཀྱི་  མིང་བཏགས་བཀོད་ཡོད་མི་འདི་གིས་ ཁྱོད་ཀྱི་འབྲི་ཤོག་འདི་ལུ་  ཚད་འཛིན་ས་སྒོ་འདི་ཚུ་ ཡོདཔ་ཨིན་ན་དང་མེན་ན་ཚུ་མཐོང་ཚུགསཔ་ཨིན།    འབྲི་ཤོག་ཆ་ཤས་ཀྱི་  ཐོ་ཡིག་འདི་ཁ་ཕྱེ་ནི་ལུ་   བསྡོམས་རྟགགས་མིང་རྟགས་དེ་ལུ་  ཨེབ་གཏང་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170600.xhp	0	help	par_id3155892				0	dz	འབྲི་ཤོག་ \<emph\>འགྲུལ་བསྐྱོདཔ་ནང་ \</emph\>མིང་འདི་ཞུན་དག་འབད་ནི་ལུ་  མིང་ལི་ཨེབ་གཏང་འབད་ཞིནམ་ལས་ མིང་གསརཔ་ཅིག་ ཐོ་བཀོད་འབད་  ཡང་ན་ སྐབས་དོན་དཀར་ཆག་ནང་  བརྡ་བཀོད་དེ་ལག་ལེན་འཐབ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170600.xhp	0	help	par_id3156347				0	dz	ཁྱོད་ཀྱི་\<emph\>འབྲི་ཤོག་འགྲུལ་བསྐྱོདཔ་ནང་ལུ་  \</emph\>ཚད་འཛིན་ཅིག་  སེལ་འཐུ་འབད་བ་ཅིན་  ཆ་མཉམ་པའི་ཆ་ཤས་ཅིག་  ཡིག་ཆ་ནང་  སེལ་འཐུ་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170600.xhp	0	help	par_id3153662				0	dz	ཁྱོད་ཀྱི་ སེལ་འཐུ་གྲུབ་པའི་ཐོ་བཀོད་ཀྱི་ སྐབས་དོན་དཀར་ཆག་དེ་ལུ་ བོད་བརྡ་འབད་བ་ཅིན་ \<emph\>འབྲི་ཤོག་འགྲུལ་བསྐྱོདཔ་འདི་གིས་\</emph\>འོག་གི་ལས་འགན་འདི་ཚུ་བྱིནམ་ཨིན།				2002-02-02 02:02:02
