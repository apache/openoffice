helpcontent2	source\text\shared\01\05040200.xhp	0	help	par_id3151112				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<ahelp hid=\"SVX:CHECKBOX:RID_SVXPAGE_PAGE:CB_REGISTER\"\>སེལ་འཐུ་འབད་ཡོད་པའི་ཤོག་ལེབ་ཀྱི་བཟོ་རྣམ་འདི་  ཀེར་ཕྲང་ཤོག་ལེབ་གིརིཌི་ལུ་  ཚིག་ཡིག་འདི་ཕྲངམ་ཨིན།  \</ahelp\> གིརིཌི་གི་བར་སྟོང་བཞག་ཐང་འདི་  \<emph\>གཞི་བསྟུན་བཟོ་རྣམ་\</emph\>གིས་ངེས་འཛིན་འབད་ཡོད། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05040200.xhp	0	help	hd_id3150686				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>གཞི་བསྟུན་བཟོ་རྣམ། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05040200.xhp	0	help	par_id3146146				0	dz	\<ahelp hid=\"SVX:LISTBOX:RID_SVXPAGE_PAGE:LB_REGISTER\"\>\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>སེལ་འཐུ་འབད་ཡོད་པའི་ཤོག་ལེབ་བཟོ་རྣམ་གུ་  ཁྱོད་ཀྱིས་ ཚིག་ཡིག་འདི་གྲལ་ཐིག་འབད་མི་དོན་ལུ་   དོན་མཚམས་བཟོ་རྣམ་འདི་སེལ་འཐུ་འབད།  གཞི་བསྟུན་བཟོ་རྣམ་ནང་ལུ་གསལ་བཀོད་འབད་ཡོད་པའི་  མཐོ་ཚད་འདི་གིས་  གིརིཌི་ཤོག་ལེབ་ཀེར་ཕྲང་གི་བར་སྟོང་བཞག་ཐང་འདི་གཞི་སྒྲིག་འབདཝ་ཨིན།\</caseinline\>\</switchinline\>\</ahelp\>				2002-02-02 02:02:02
