helpcontent2	source\text\swriter\01\02110000.xhp	0	help	par_id3150558	70			0	dz	\<ahelp hid=\".\" visibility=\"hidden\"\>ཁྱོད་ཀྱིས་སེལ་འཐུ་འབད་ཡོད་མི་དབྱེ་རིམ་ནང་ལུ་ ཤུལ་མམ་ཡང་ན་ ཧེ་མམ་གྱི་འདི་ནང་ལུ་མཆོངས་ཚུགས་པའི་\<emph\>ལག་ཆས་ཕྲ་རིང་\</emph\>དེ་ཁ་ཕྱེཝ་ཨིན། དབྱེ་རིམ་སེལ་འཐུ་འབད་ཞིནམ་ལས་ "Previous" དང་ "Next" མདའ་རྟགས་ཚུ་ཨེབ་གཏང་འབད། \</ahelp\>ཁྱོད་ཀྱིས་སེལ་འཐུ་འབད་ཡོད་མི་དབྱེ་རིམ་ནང་ལུ་ ཤུལ་མམ་ཡང་ན་ ཧེ་མམ་གྱི་འདི་ནང་ལུ་འཕྲལ་མགྱོགས་རང་མཆོངས་ཚུགས་པའི་\<link href=\"text/swriter/01/02110100.xhp\" name=\"Navigation\"\>འགྲུལ་བསྐྱོདཔ་\</link\>ཁ་ཕྱེཝ་ཨིན།དབྱེ་རིམ་སེལ་འཐུ་འབད་ཞིནམ་ལས་ "Previous" དང་ "Next"མདའ་རྟགས་དེ་ལུ་ཨེབ་གཏང་འབད།				2002-02-02 02:02:02
