helpcontent2	source\text\swriter\02\18030300.xhp	0	help	par_id3150760				0	dz	\<ahelp hid=\".uno:InsertPageNumberField\"\>འོད་རྟགས་ཀྱི་གནས་ས་ལུ་  ད་ལྟོའི་ཤོག་ལེབ་ཀྱི་ཨང་གྲངས་དེ་  ས་སྒོ་བཟུམ་སྦེ་ བཙུགསཔ་ཨིན།\</ahelp\> སྔོན་སྒྲིག་གི་སྒྲིག་སྟངས་འདི་  ཤོག་ལེབ་རྩ་སྒྲིག་གི་བཟོ་རྣམ་དེ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\18030300.xhp	0	help	par_id3151175				0	dz	ཁྱོད་ཀྱིས་ རྩ་སྒྲིག་སོ་སོ་ཅིག་ངེས་འཛིན་འབད་ནི་ཡང་ན་ ཤོག་ལེབ་ཨང་འདི་ལེགས་བཅོས་འབད་དགོ་མནོ་བ་ཅིན་ ས་སྒོ་ \<emph\>བཙུགས་ - ས་སྒོ་ཚུ་ - གཞན་མི་\</emph\> ཡོད་མི་ཅིག་བཙུགས་ དེ་ལས་རེ་འདུན་ཡོད་པའི་སྒྲིག་སྟངས་འདི་ \<link href=\"text/swriter/01/04090000.xhp\" name=\"Fields\"\>\<emph\>ས་སྒོའི་\</emph\>\</link\> ཌའི་ལོག་ནང་བཟོ། ས་སྒོ་ \<emph\>ཤོག་ལེབ་ཨང་\</emph\> བརྡ་བཀོད་ \<link href=\"text/swriter/01/02140000.xhp\" name=\"Edit - Fields\"\>\<emph\>ཞུན་དག་ - ས་སྒོ་ཚུ་\</emph\>\</link\>ཡོད་མི་དང་གཅིག་ཁར་བཙུགས་ཡོད་མི་ ཞུན་དག་འབད་ནི་འདི་ཡང་སྲིན་པ་ཨིན། ཤོག་ལེབ་ཨང་བསྒྱུར་བཅོས་འབད་ནིའི་དོན་ལས་  \<link href=\"text/swriter/guide/pagenumbers.xhp\" name=\"Page Numbers\"\>\<emph\>ཤོག་ལེབ་ཨང་\</emph\>\</link\> ལམ་སྟོན་པ་འདི་ལྷག				2002-02-02 02:02:02
