helpcontent2	source\text\shared\02\06120000.xhp	0	help	par_id3148520				0	dz	\<ahelp hid=\".uno:DefaultBullet\"\>སེལ་འཐུ་འབད་ཡོད་པའི་  དོན་མཚམས་ཚུ་ནང་ལུ་  འགོ་ཚག་གི་ས་ཚིགས་ཚུ་  འགན་སྤྲོད་དང་  ཡང་ན་  འགོ་ཚག་འབད་ཡོད་པའི་  དོན་མཚམས་ཚུ་ནང་ལས་  རྩ་བསྐྲད་གཏངམ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\06120000.xhp	0	help	par_id3155150				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>དབྱེ་བ་དང་གནས་ས་བཟུམ་མི་  འོག་ཚག་གི་གདམ་ཁ་འདི་ཚུ་ \<link href=\"text/shared/01/06050000.xhp\" name=\"Bullets and Numbering\"\>\<emph\>འགོ་ཚག་ དང་ ཨང་བཏགས་ནིའི་\</emph\>\</link\> ཌའི་ལོག་ནང་ལུ་  ངེས་འཛིན་འབད་ཡོདཔ་ཨིན། འ་ནཱི་ ཌའི་ལོག་ཅིག་ཁ་ཕྱེ་ནི་ལུ་  \<emph\>འགོ་ཚག་ དང་ ཨང་བཏགས་ནིའི་\</emph\> ངོས་དཔར་ \<link href=\"text/swriter/main0206.xhp\" name=\"Bullets and Numbering Bar\"\>འགོ་ཚག་དང་ ཨང་བཏགས་ནིའི་ཕྲ་རིང་གུར་ཡོད་མི་འདི་ལུ་ ཨེབ་གཏང་འབད།\</link\>\</caseinline\>\</switchinline\> 				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\06120000.xhp	0	help	par_id3145669	8			0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"IMPRESS\"\>དབྱེ་བ་དང་གནས་ས་བཟུམ་མའི་འགོ་ཚག་གདམ་ཁ་ཚུ་ \<link href=\"text/shared/01/06050000.xhp\" name=\"Bullets and Numbering\"\>འགོ་ཚག་ཚུ་དང་ཨང་བཏགས་ནིའི་ཌའི་ལོག་ནང་\</link\> ངེས་འཛིན་འབད་ཡོདཔ་ཨིན། ཨ་ནི་ཌའི་ལོག་འདི་ཁ་ཕྱེ་ནི་ལུ་ \<emph\>ཚིག་ཡིག་རྩ་སྒྲིག་འབད་ནིའི་ཕྲ་རིང་གུ་་འགོ་ཚག་ཚུ་དང་\</emph\> ཨང་བཏགས་ནིའི་ \<emph\>ངོས་དཔར་\</emph\> ཨེབ་གཏང་། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
