helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3154023				0	dz	\<ahelp hid=\"HID_SMA_XUNDERBRACEY\"\>ས་གནས་འཛིན་མི་ཚུ་དང་གཅིག་ཁར་ཚད་འཇལ་བཏུབ་པའི་ཐད་སྙོམས་འོག་གི་གུག་ཤད་གཅིག་བཙུགསཔ་ཨིན།\</ahelp\> ཁྱོད་ཀྱིས་ \<emph\><?> འོག་ཤད་ <?>\</emph\> འདི་ \<emph\>བརྡ་བཀོད་ཚུའི་\</emph\> སྒོ་སྒྲིག་ནང་ལུ་ཐད་ཀར་དུ་ཡིག་དཔར་རྐྱབས་ཚུགས། གུག་ཤད་ཀྱི་ཚད་འདི་རང་བཞིན་གྱིས་བདེ་སྒྲིག་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3149954				0	dz	\<ahelp hid=\"HID_SMA_LRFLOORX\"\>འཐིང་གཞིའི་གུག་ཤད་ཚུ་བཙུགས་ནིའི་དོན་ལས་  \<emph\>ཨེལ་འཐིང་གཞི་<?>ཨར་འཐིང་གཞི་\</emph\> འདི་ \<emph\>བརྡ་བཀོད་ཚུའི་\</emph\> སྒོ་སྒྲིག་ནང་ལུ་ཐད་ཀར་དུ་ཡིག་དཔར་རྐྱབས།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3150592				0	dz	\<ahelp hid=\"HID_SMA_LRCEILX\"\>ཐོག་པང་གི་གུག་ཤད་ཚུ་བཙུགས་ནིའི་དོན་ལས་ \<emph\>ཨེལ་ཐོག་པང་<?>ཨར་ཐོག་པང་\</emph\> འདི་ \<emph\>བརྡ་བཀོད་ཚུའི་\</emph\> སྒོ་སྒྲིག་ནང་ལུ་ཐད་ཀར་དུ་ཡིག་དཔར་རྐྱབས་ཚུགས།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3149623				0	dz	\<ahelp hid=\"HID_SMA_SLRFLOORX\"\>ཚད་འཇལ་བཏུབ་པའི་འཐིང་གཞིའི་གུག་ཤད་ཚུ་བཙུགས་ནིའི་དོན་ལས་ \<emph\>གཡོན་གྱི་ཨེལ་འཐིང་གཞི་<?>གཡས་ཀྱི་ཨར་འཐིང་གཞི་\</emph\> འདི་ཐད་ཀར་དུ་ \<emph\>བརྡ་བཀོད་ཚུའི་\</emph\> སྒོ་སྒྲིག་ནང་ལུ་ཡིག་དཔར་རྐྱབས།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3145668				0	dz	\<ahelp hid=\"HID_SMA_SLRCEILX\"\>ཚད་འཇལ་བཏུབ་པའི་ཐོག་པང་གི་གུག་ཤད་ཚུ་བཙུགས་ནིའི་དོན་ལས་ \<emph\>གཡོན་གྱི་ཨེལ་ཐོག་པང་<?>གཡས་ཀྱི་ཨར་ཐོག་པང་\</emph\> འདི་ཐད་ཀར་དུ་ \<emph\>བརྡ་བཀོད་ཚུའི་\</emph\> སྒོ་སྒྲིག་ནང་ལུ་ཡིག་དཔར་རྐྱབས།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3149208				0	dz	གུག་ཤད་ཚུ་ཁྱོད་ཀྱིས་ གུག་ཤད་བརྡ་བཀོད་ཀྱི་གདོང་ཁར་ \<emph\>གཡོན་\</emph\> དང་ \<emph\>གཡས་\</emph\> ཡིག་དཔར་རྐྱབས་པའི་སྐབས་རང་བཞིན་གྱིས་ཚད་བཟོཝ་ཨིན། དཔེར་ན་  \<emph\>གཡོན་(a འདི་ b གཡས་ཀྱི་ལྟག་ལུ་) \</emph\>   ཁྱོད་ཀྱིས་གུག་ཤད་ཚུའི་ཚད་དང་བར་སྟོང་བཞག་ཐངས་འདི་ \<emph\>རྩ་སྒྲིག་ - བར་སྟོང་བཞག་ཐངས་ - དབྱེ་རིམ་ - གུག་ཤད་ཚུ་\</emph\> གདམ་ཁ་རྐྱབས་ཐོག་དང་རེ་འདུན་ཡོད་པའི་བརྒྱ་ཆ་ཚུ་གཞི་སྒྲིག་འབད་ཐོག་ཚད་འདི་གཞི་སྒྲིག་འབད་ཚུགས།  གུག་ཤད་ \<emph\> དཔྱད་སྒྲོམ་གེ་ར་མན་ངག་ནང་གི་གུག་ཤད་གེ་ར་བསྒྱུར་བཅོས་འབད་ནིའི་འཇུག་སྤྱོད་འབད་ནིའི་དོན་ལུ་  \</emph\> ཚད་ཤིང་རྟགས་བཀལ།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090500.xhp	0	help	par_id3150857				0	dz	ཁྱོད་ཀྱིས་གཞན་ཡང་གུག་ཤད་རྐྱང་པ་ཚུ་ལག་ལེན་འཐབ་ཚུགས།  འདི་འབད་ནི་ལུ་  བརྡ་བཀོད་ཀྱི་གདོང་ཁར་  གཡོ་ཤད་ལོག་པ་ \<emph\>\\\</emph\>གཅིག་ཡིག་དཔར་བརྐྱབ།  དཔེར་ན་  ཁྱོད་ཀྱིས་\<emph\>\\[\</emph\>ཡིག་དཔར་བརྐྱབ་པའི་བསྒང་  གཡོན་གྱི་གྲུ་བཞིའི་གུག་ཤད་འདི་  དེའི་ངོ་ཡ་མེདཔ་སྦེ་འབྱུངམ་ཨིན།  རིམ་ལོག་གུག་ཤད་ཡང་ན་  བར་མཚམས་གསར་བསྐྲུན་འབད་ནི་དོན་ལུ་ཕན་ཐོག་ཅན་ཡོདཔ་ཨིན།  ཆ་ཚད་འབད་མ་བཏུབ་པའི་གུག་ཤད་ཚུ་ངོ་རྐྱང་སྦེ་ལག་ལེན་འཐབ་ཚུགས།  ཚད་གཞི་འདི་བསྒྱུར་བཅོས་འབད་ནི་ལུ་  \<emph\>ཚད་\</emph\>བརྡ་བཀོད་འདི་ལག་ལེན་འཐབ།				2002-02-02 02:02:02
