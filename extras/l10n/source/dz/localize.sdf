helpcontent2	source\text\smath\01\03090300.xhp	0	help	par_id3154715				0	dz	\<ahelp hid=\"HID_SMA_TOX\"\>ཁྱབ་ཚད་ཀྱི་གསལ་བཤད་ \<emph\>ཡར་གྱི་ཚད་འདི་\</emph\> ས་གནས་འཛིན་མི་གཅིག་དང་ཅིག་ཁར་མེད་ཐབས་མེདཔ་དང་ཕྱོགས་བསྡོམས་ཀྱི་དོན་ལུ།\</ahelp\> ཁྱོད་ཀྱིས་ཡང་ \<emph\>འདི་ <?><?>\</emph\> ཐད་ཀར་དུ་ \<emph\>བརྡ་བཀོད་ཚུའི་\</emph\> སྒོ་སྒྲིག་ནང་ཡིག་དཔར་རྐྱབས་ཚུགས། ཚད་ཀྱི་གསལ་བཤད་འདི་ཚུ་འོས་ལྡན་བཀོལ་སྤྱོད་པ་ཚུ་དང་ཅིག་ཁར་མཉམ་མཐུད་འབད་ཡོདཔ་ཨིན་པ་ཅིན་རྐྱངམ་ཅིག་ལག་ལེན་འཐབ་བཏུབ།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090300.xhp	0	help	par_id3149233				0	dz	ཁྱོད་ཀྱིས་ཚད་ཚུ་བཀོལ་སྤྱོད་པ་ཅིག་ལུ་(དཔེར་ན་ མེད་ཐབས་མེདཔ་ཅིག་)དང་པ་རང་རེ་འདུན་ཡོད་པའི་བཀོལ་སྤྱོད་པ་ཨེབ་གཏང་ཞིནམ་ལས་དེ་ལས་  \<emph\>limit\</emph\> བརྡ་མཚོན་ཨེབ་གཏང་ཐོག་ཁ་སྐོང་རྐྱབས་ཚུགས། འ་ནི་ཐབས་ལམ་འདི་བརྡ་བཀོད་འདི་ཚུ་ཐད་ཀར་དུ་ཡིག་དཔར་རྐྱབས་ནི་ལས་མགྱོགས་སུ་ཨིན།				2002-02-02 02:02:02
