helpcontent2	source\text\shared\01\05020100.xhp	0	help	par_id3150359				0	dz	\<ahelp hid=\"SVX_METRICBOX_RID_SVXPAGE_CHAR_NAME_LB_CTL_SIZE\"\>ཁྱོད་ཀྱིས་འཇུག་སྤྱོད་འབད་ནི་ཨིན་པའི་  ཡིག་གཟུགས་ཚད་འདི་སེལ་འཐུ་འབད་ནི་དང་ ཐོ་བཀོད་འབད།  ཆ་ཚད་འབད་ཚུགས་པའི་ཡིག་གཟུགས་ཀྱི་དོན་ལུ་  ཁྱོད་ཀྱིས་  བཅུ་ཚག་གནས་གོང་འདི་ཐོ་བཀོད་འབད་བཏུབ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020100.xhp	0	help	par_id3148797				0	dz	བཟོ་རྣམ་གཞན་མི་ལུ་གཞི་བཞག་སྟེ་  ཁྱོད་ཀྱིས་  བཟོ་རྣམ་ཅིག་གསར་བསྐྲུན་འབད་དོ་ཡོད་པ་ཅིན་  ཁྱོད་ཀྱིས་  བརྒྱ་ཆའི་གནས་གོང་ཡང་ན་ ས་ཚིགས་གནས་གོང་(དཔེར་ན་ -2pt ཡང་ན་ +5pt)འདི་ཐོ་བཀོད་འབད་བཏུབ་ཨིན།				2002-02-02 02:02:02
