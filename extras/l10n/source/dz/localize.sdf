helpcontent2	source\text\shared\optionen\01040500.xhp	0	help	par_id3145609				0	dz	ཀེར་ཐིག་ཚུ་དང་གྱལ་ཚུ་དེ་ལས་ཐིག་ཁྲམ་ཐབས་ལམ་གྱི་དོན་ལས་སྔོན་སྒྲིག་སྒྲིག་སྟངས་ཚུ་གསལ་བཀོད་འབདཝ་ཨིན། ཡང་ཀེར་ཐིག་ཚུ་དང་གྱལ་ཚུ་བཙུགས་ནི་དང་སྤོ་བཤུད་འབད་ནིའི་དོན་ལས་ཚད་ལྡན་གནས་གོང་ཚུ་གསལ་བཀོད་འབདཝ་ཨིན། བརྡ་དོན་ཧེང་བཀལ་གྱི་དོན་ལས་ \<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<link href=\"text/swriter/01/05090201.xhp\" name=\"Editing Tables Using the Keyboard\"\>$[officename] རྩོམ་འབྲི་པའི་གྲོགས་རམ་ནང་\</link\>\</caseinline\>\<defaultinline\> ལྡེ་སྒྲོམ་ལག་ལེན་འཐབ་ཐོག་ལས་ཞུན་དག་འབད་ནིའི་ཐིག་ཁྲམ་ཚུ་བལྟ།\</defaultinline\>\</switchinline\>.				2002-02-02 02:02:02
