helpcontent2	source\text\swriter\01\01160300.xhp	0	help	par_id3149286	2			0	dz	\<variable id=\"autoabstracttext\"\>\<ahelp hid=\".uno:CreateAbstract\"\>རྗེས་ཐོག་དོན་མཚམས་ཀྱི་མགོ་ཡིག་དང་ཨང་ཡིག་དེ་ ཤུགས་ལྡན་ཡིག་ཆའི་ནང་ལས་ རང་བཞིན་སྙིན་བཅུད་ཀྱི་ཚིག་ཡིག་ཡིག་ཆ་གསརཔ་པའི་ནང་ལུ་ འདྲ་བཤུས་རྐྱབས་ཨིན། རང་བཞིན་སྙིང་བཅུད་དེ་ ཡིག་ཆ་རིངམོ་ཚུ་གི་ སྤྱི་མཐོང་ལེན་ནི་ལུ་ ཕན་ཐོགས་ཡོདཔ་ཨིན། \</ahelp\> ཁྱོད་ཀྱིས་མཐའ་ཐིག་གི་གནས་རིམ་དང་ དེ་བཟུམ་སྦེ་ དེ་ནང་ལུ་བསྐྲམ་སྟོན་འབད་ཡོད་པའི་དོན་མཚམས་ཀྱི་གྱངས་ཁ་དེ་ གསལབཀོད་འབད་ཚུགས། སྒྲིག་སྟངས་ཀྱི་བྱེ་བྲག་སོ་སོའི་འོག་ལུ་ཡོད་མི་ གནས་རིམ་དང་དོན་མཚམས་ཚུ་ཆ་མཉམ་ སྦ་བཞག་ནུག\</variable\>				2002-02-02 02:02:02
