helpcontent2	source\text\shared\00\00000099.xhp	0	help	par_id3156069				0	dz	\<link href=\"text/shared/guide/main.xhp\" name=\"$[officename] general\"\>$[officename] སྤྱིར་གཏང་\</link\>དོན་ལུ་སྒྲོག་རམ་ཤོག་ལེབ་གུ་  ཝིན་ཌཱསི་དང་ཅིག་ཁར་ལཱ་འབད་མི་དང་ དཀར་ཆག་ $[officename] སྲོལ་སྒྲིག་ གནད་སྡུད་བྱུང་ཁུངས་  སྟོན་ཁང་དང་འདྲུད་ནི་དང་བཞག་ནི་བཟུམ་གྱི་ཚད་གཞི་ལུ་ ཁྱོད་ཀྱིས་འཇུག་སྤྱོད་འབད་བཏུབ་པའི་བརྡ་དོན་འཐོབ་ཚུགས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000099.xhp	0	help	par_id3149662				0	dz	ཁྱོད་རང་ ཚད་གཞི་གཞན་མི་དང་ཅིག་ཁར་སྒྲོག་རམ་དགོ་པ་ཅིན་  འགྲུལ་བསྐྱོད་མངའ་ཁོངས་ནང་ཡོད་མི་ཀོམ་བོ་སྒྲོམ་དང་བཅས་  ཚད་གཞི་དེ་གི་དོན་ལུ་སྒྲོག་རམ་ལུ་སོར་བསྒྱུར་འབད།				2002-02-02 02:02:02
