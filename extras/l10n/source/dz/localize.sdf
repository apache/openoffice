helpcontent2	source\text\swriter\01\02170000.xhp	0	help	par_id3149104	5			0	dz	\<ahelp hid=\"HID_REGION_TREE\"\>ཁྱོད་ཀྱིས་ ཞུན་དག་འབད་དགོ་མནོ་མི་ དབྱེ་ཚན་གྱི་མིང་དེ་ཡིག་དཔར་རྐྱབས་ ཡང་ན་ \<emph\>Seདབྱེ་ཚན་ \</emph\>ཐོ་ཡིག་ནང་ལུ་ མིང་ཅིག་ལུ་ཨེབ་གཏང་འབད།\</ahelp\> འོད་རྟགས་དེ་ད་ལྟོ་དབྱེ་ཚད་ནང་ལུ་ཡོད་པ་ཅིན་ ཡིག་ཆའི་སྒོ་སྒྲིག་དེ་གི་གཤམ་ལུ་ཡོད་མི་ གནས་ཚད་ཕྲ་རིང་གི་གཡས་ཁ་ཐུག་ལུ་ བཀྲམ་་སྟོན་འབདཝ་འབད་འོང་།				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02170000.xhp	0	help	par_id3149040				0	dz	ཐོ་ཡིག་ནང་གི་དབྱེ་ཚན་མིང་གི་གདོང་ཁ་ལུ་ཡོད་མི་ ལྡེ་མིག་བརྡ་མཚོན་དེ་གིས་བརྡ་སྟོན་འབད་ཡོད་མི་ ད་ལྟོའི་འབྲི་ནིའི་ཉེན་སྐྱོབ་གནས་ཚད། ཁ་ཕྱེ་ནིའི་ལྡེ་མིག་འདི་ ཉེན་སྐྱོབ་མ་འབད་ཁ་བསྡམས་ཏེ་ཡོད་མི་ལྡེ་མིག་དེ་ཉེན་སྐྱོབ་འབད་བཞག་ནུག འདི་བཟུམ་སྦེ་ མཐོང་ཚུགས་པའི་དབྱེ་ཚན་ཚུ་ མིག་ཤལ་གྱིས་བརྡ་སྟོན་འབདཝ་ཨིན།				2002-02-02 02:02:02
