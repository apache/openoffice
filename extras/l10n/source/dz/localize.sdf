helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3151300				0	dz	\<ahelp hid=\"HID_PROP_STRINGITEMLIST\" visibility=\"hidden\"\>དེ་གིས་  ཡིག་ཆའི་ནང་མཐོང་ཚུགས་པའི་འཛུལ་ཞུགས་ཐོ་ཡིག་འདི་ངེས་འཛིན་འབདཝ་ཨིན།  ཐོ་ཡིག་འདི་ཁ་ཕྱེ་ནི་དང་ཁྱོད་རའི་ཚིག་ཡིག་ཡིག་དཔར་བརྐྱབ།\</ahelp\>ཐོ་ཡིག་དང་ཀོམ་བོ་སྒྲོམ་ཚུ་དང་ཅིག་ཁར་, ཡིག་ཆའི་ནང་མཐོང་ཚུགས་པའི་ཐོ་ཡིག་འཛུལ་ཞུགས་འདི་ཁྱོད་ཀྱིས་ངེས་འཛིན་འབད་ཚུགས། \<emph\>ཐོ་ཡིག་འཛུལ་ཞུགས་\</emph\> ས་སྒོ་འདི་ཁ་ཕྱེ་ནི་དང་ཁྱོད་རའི་ཚིག་ཡིག་འདི་ཡིག་དཔར་བརྐྱབ།  དྲན་འཛིན་འབད་གནང་ \<link href=\"text/shared/02/01170100.xhp\" name=\"tips\"\>ཕན་བསླབ་ \</link\> འཛུལ་ཞུགས་ཚད་འཛིན་དང་ལྡེ་སྒྲོམ་ལུ་གཞི་བསྟུན་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3152874				0	dz	སྔོན་མ་ངེས་འཛིན་འབད་ཡོད་པའི་སྔོན་སྒྲིག་ཐོ་ཡིག་ཐོ་བཀོད་འདི་  \<emph\>སྔོན་སྒརིག་སེལ་འཐུའི་ཀོམ་བོ་\</emph\> སྒྲོམ་ནང་ལུ་ཐོ་བཀོད་འབད་དེ་ཡོད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3154610				0	dz	ཐོ་ཡིག་ནང་དོན་གི་འོག་ལུ་ གནད་སྡུད་ཀྱི་མཆོང་ལྡེ་གུར་ གདམ་ཁ་ "གནས་གོང་གི་ཐོ་ཡིག་"དེ་སེལ་འཐུ་འབད་ད་པ་ཅིན་  \<emph\>འ་ན་ལུ་ ཐོ་བཀོད་འབད་ཡོད་པའི་\</emph\> ཐོ་ཡིག་ཧྲིལ་བུ་འདི་ཚུ་\<emph\> རྐྱངམ་ཅིག་ འབྲི་ཤོག་འདི་ནང་ལུ་\</emph\> གཅིག་ཁར་སྡེབ་བཞགཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3154767				0	dz	གནས་སྡུད་གཞི་རྟེན་ལུ་ཁྱོད་ཀྱིས་ཐོ་ཡིག་འཛུལ་ཞུགས་ཚུ་མི་འབྲི་ནི་ཡང་ན་  ཝེབ་འབྲི་ཤོག་གི་ཐོབ་མཁན་ལུ་སྤེལ་བཀྲམ་མི་འབད་ནི་   དེ་འབདཝ་ད་  འབྲི་ཤོག་ནང་མཐོང་ཚུགས་མེད་མི་ཚུ་འགན་སྤྲོད་འབད་ཡོད་པའི་གནས་གོང་ཚུ་  ཁྱོད་ཀྱིས་ཐོ་ཡིག་འཛུལ་ཞུགས་ཚུ་  གནས་གོང་ཐོ་ཡིག་ཅིག་ནང་གནས་གོང་གཞན་མི་ལུ་འགན་སྤྲོད་འབད་ཚུགས།  གནས་གོང་ཐོ་ཡིག་འདི་\<link href=\"text/shared/02/01170102.xhp\" name=\"Data\"\>\<emph\>གནས་སྡུད་\</emph\>\</link\>མཆོང་ལྡེ་གུ་གཞན་འབེབས་བཟོ་ཚུགས།  གདམ་ཁ་"Value List" under \<emph\>ཐོ་ཡིག་བསམ་བཀོད་ཀྱི་དབྱེ་བ་\</emph\>སེལ་འཐུ་འབད་ནི་དང་  གནས་གོང་ཚུ་ \<emph\>ཐོ་ཡིག་དང་དོན་ཚུ་\</emph\>འོག་ལུ་ཐོ་བཀོད་འབད་ནི་  དེ་ཡང་ འབྲི་ཤོག་གི་ཆ་མཉམ་པའི་མཐོང་ཚུགསཔ་ཐོ་ཡིག་འཛུལ་ཞུགས་ལུ་འགན་སྤྲོད་འབད་ནི་ཨིན་མི་ཚུ་ཨིན།   ནོར་བ་མེད་པའི་འགན་སྤྲོད་འབད་ནི་ལུ་  གནས་གོང་ཐོ་ཡིག་ནང་གི་རིམ་པ་འདི་འབྲེལ་བ་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3150511				0	dz	ཨེཆ་ཊི་ཨེམ་ཨེལ་ཡིག་ཆའི་དོན་ལུ་, \<emph\>ཡོངས་ཁྱབ་\</emph\>མཆོང་ལྡེ་གུ་ཡོད་པའི་ཐོ་ཡིག་འཛུལ་ཞུགས་ཐོ་བཀོད་འདི་གིས་  ཨེཆ་ཊི་ཨེམ་ཨེལ་ངོ་རྟགས་<OPTION>གུ་ཆ་མཉམ་ཨིན་;གནས་གོང་ཐོ་ཡིག་གི་ཐོ་བཀོད་ \<emph\>ཚེས་གྲངས་\</emph\>ངོ་རྟགས་འོག་ལུ་ \<emph\>ཐོ་ཡིག་ནང་དོན་ཚུ་\</emph\>གུ་འབད་ཡོད་མི་འདི་གིས་ <OPTION VALUE=...> ངོ་རྟགས་ལུ་ཆ་མཉམ་ཨིན།				2002-02-02 02:02:02
