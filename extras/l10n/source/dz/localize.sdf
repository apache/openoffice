helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id1416974				0	dz	ཚིག་ཡིག་འདི་ལུ་ ཧང་ག་རི་ཡཱན་ཡང་ན་ཕིན་ནིཤ་གི་སྐད་ཡིག་ཁྱད་ཆོས་ཡོད་པ་ཅིན་  འབྱུང་རིམ་ A--B ནང་གི་སྦྲེལ་རྟགས་གཉིསཔ་འདི་  em-dash མེན་པར་ en-dashགིས་ཚབ་བཙུགས་འབད་དེ་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3152472				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>དོན་མཚམས་ཀྱི་མགོ་དང་མཇུག་ལུ་  བར་སྟོང་དང་ཨེབ་ལྡེ་ཚུ་བཏོན་གཏང་ད། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3156024				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>དོན་མཚམས་ཀྱི་མགོ་ལུ་  ཨེབ་ལྡེ་དང་བར་སྟོང་ཚུ་རྩ་བསྐྲད་གཏངམ་ཨིན།  གདམ་ཁ་འདི་ལག་ལེན་འཐབ་ནི་དོན་ལུ་ \<emph\>བཟོ་རྣམ་ཚུ་འཇུག་སྤྱོད་འབད་\</emph\> གདམ་ཁ་དེ་ཡང་སེལ་འཐུ་འབད་དགོ། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3147303				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>གྲལ་ཐིག་གི་མགོ་དང་མཇུག་ལུ་  སྟོངམ་ཚུ་དང་ཨེབ་ལྡེ་ཚུ་བཏོན་གཏངམ་ཨིན། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3150866				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>གྲལ་ཐིག་རེ་གི་མགོ་དང་མཇུག་ལུ་  བར་སྟོང་ཚུ་དང་ཨེབ་ལྡེ་ཚུ་ རྩ་བསྐྲད་གཏངམ་ཨིན།  གདམ་ཁ་འདི་ལག་ལེན་འཐབ་ནི་དོན་ལུ་  \<emph\>བཟོ་རྣམ་ཚུ་འཇུག་སྤྱོད་འབད་\</emph\>གདམ་ཁ་འདི་སེལ་འཐུ་འབད་དགོ། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
