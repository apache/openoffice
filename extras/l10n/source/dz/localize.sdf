helpcontent2	source\text\shared\01\05030000.xhp	0	help	par_id3148668				0	dz	\<variable id=\"absatztext\"\>\<ahelp hid=\".uno:EditStyle\"\>གིས་ འགོ་མཚམས་དང་ཕྲང་སྒྲིག་བཟུམ་གྱི་ ད་ལྟོའི་དོན་མཚམས་གི་རྩ་སྒྲིག་འདི་ ལེགས་བཅོས་འབདཝ་ཨིན། \</ahelp\>\</variable\>ད་ལྟོའི་དོན་མཚམས་ཀྱི་ཡིག་གཟུགས་འདི་  ལེགས་བཅོས་འབད་ནི་ལུ་  དོན་མཚམས་ཧྲིལ་བུ་སེལ་འཐུ་འབད་ནི་དང་   རྩ་སྒྲིག་ཡིག་འབྲུ་འདི་གདམ་ཁ་བརྐྱབ་ནི་དང་  དེ་ལས་  ཡིག་གཟུགས་ཀྱི་ཨེབ་ལྡེ་གུ་ཨེབ་གཏང་།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030000.xhp	0	help	par_id3156042	3			0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>ད་ལྟོའི་དོན་མཚམས་ཀྱི་ཡིག་འབྲུ་གི་དོན་ལུ་   དོན་མཚམས་བཟོ་རྣམ་འདི་  \<emph\>རྩ་སྒྲིག་འབད་དོ་\</emph\>ལག་ཆས་ཕྲ་རིང་གུ་བཀྲམ་སྟོན་འབད་ཡོདཔ་དང་  \<link href=\"text/swriter/01/05140000.xhp\" name=\"Styles\"\>བཟོ་རྣམ་དང་རྩ་སྒྲིག་སྒོ་སྒྲིག་\</link\>ནང་ལུ་གཙོ་དམིགས་བཀོད་དེ་ཡོད། \</caseinline\>\</switchinline\> 				2002-02-02 02:02:02
