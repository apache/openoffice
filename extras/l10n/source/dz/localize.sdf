helpcontent2	source\text\smath\01\05030000.xhp	0	help	par_id3153818				0	dz	\<variable id=\"abstaendetext\"\>\<ahelp hid=\"SID_DISTANCE\"\> འ་ནི་ཌའི་ལོག་འདི་མན་ངག་རྒྱུ་རྫས་ཚུའི་བར་ན་བར་སྟོང་བཞག་ཐངས་འདི་གཏན་འབེབས་བཟོ་ནིའི་དོན་ལས་ལག་ལེན་འཐབ། བར་སྟོང་བཞག་ཐངས་འདི་  \<emph\>རྩ་སྒྲིག་ - ཡིག་གཟུགས་ཚད་\</emph\> གི་འོག་ལུ་ངེས་འཛིན་འབད་ཡོད་པའི་གཞི་རྟེན་ཚད་འདི་ལུ་མཐུན་འབྲེལ་ཡོདཔ་སྦེ་ བརྒྱ་ཆ་སྦེ་གསལ་བཀོད་འབད་འདི་ཡོདཔ་ཨིན།\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05030000.xhp	0	help	par_id3143228				0	dz	ཁྱོད་ཀྱིས་བར་སྟོང་བཞག་ཐངས་གསལ་བཀོད་འབད་དགོ་མནོ་མི་གི་དོན་ལུ་མན་ངག་གི་རྒྱུ་རྫས་འདི་གཏན་འབེབས་བཟོ་ནིའི་དོན་ལས་  \<emph\>Category\</emph\> ཨེབ་རྟ་འདི་ལག་ལེན་འཐབ། ཌའི་ལོག་གི་འབྱུང་སྣང་འདི་སེལ་འཐུ་འབད་འབད་བའི་དབྱེ་རིམ་དང་འཁྲིལཝ་ཨིན། སྔོན་ལྟའི་སྒོ་སྒྲིག་འདི་གིས་སྒྲོམ་སོ་སོ་ཚུ་བརྒྱུད་དེ་བར་སྟོང་བཞག་ཐངས་ག་འདི་ལེགས་བཅོས་ག་དེ་སྦེ་འབདཝ་ཨིན་ན་སྟོནམ་ཨིན།				2002-02-02 02:02:02
