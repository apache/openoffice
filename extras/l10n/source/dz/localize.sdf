helpcontent2	source\text\shared\01\05030600.xhp	0	help	par_id3145419				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<ahelp hid=\"SVX:LISTBOX:RID_SVXPAGE_BACKGROUND:LB_TBL_BOX\"\>ཁྱོད་ཀྱིས་རྒྱབ་གཞི་ཚོས་གཞི་འདི་འཇུག་སྤྱོད་འབད་ནི་ཨིན་པའི་ མངའ་ཁོངས་འདི་སེལ་འཐུ་འབད། \</ahelp\>དཔེར་ན་  ཁྱོད་ཀྱིས་  རྒྱབ་གཞི་ཚོས་གཞི་ཚུ་  ཐིག་ཁྲམ་དོན་ལུ་ངེས་འཛིན་འབདཝ་ད་  ཁྱོད་ཀྱིས་  ཐིག་ཁྲམ་ལུ་འཇུག་སྤྱོད་འབད་ནི་ལུ་  ནང་ཐིག་འདི་ཤུགས་ལྡན་བཟོ་ནི་དང་   གྲལ་ཐིག་ ཡང་ན་ ཀེར་ཐིག་ཚུ་ གདམ་ཁ་བརྐྱབ།\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
