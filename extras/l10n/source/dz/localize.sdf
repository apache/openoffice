helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3149566	9			0	dz	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_FORMULA:BTN_MATRIX\"\> སེལ་འཐུ་གྲུབ་ཡོད་པའི་ལས་འགན་འདི་སེལ་འཐུ་གྲུབ་ཡོད་པའི་ཁྱབ་ཚད་ནང་ན་ ཨེ་རེ་མན་ངག་སྦེ་བཙུགས་ཡོདཔ་སྦེ་གསལ་བཀོད་འབདཝ་ཨིན། \</ahelp\> ཨེ་རེ་མན་ངག་ཚུ་གིས་ ནང་ཐིག་སྣ་མང་ཚུ་གུ་བཀོལ་སྤྱོད་འབད་ནི་ཨིན། ཨེ་རེ་ནང་ལུ་ནང་ཐིག་རེ་རེ་གི་ནང་ན་འདྲ་བཤུས་སྦེ་མེན་པར་ མེ་ཊིགསི་ནང་ཐིག་ཚུ་ཆ་མཉམ་གྱི་རུབ་སྤྱོད་འབད་ཡོད་པའི་མན་ངག་ཤོམ་ཏེ་ཡོད།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060000.xhp	0	help	par_id3155959				0	dz	གདམ་ཁ་འདི་ \<emph\>Array\</emph\> option is identical to the \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\> བརྡ་བཀོད་ \</caseinline\>\<defaultinline\> ཚད་འཛིན་ \</defaultinline\>\</switchinline\>+ སོར་ལྡེ་ +བརྡ་བཀོད་བཙུགས་  ཤོག་ཁྲམ་ནང་ལུ་མན་ངག་ཚུ་ངེས་དཔྱད་འབད་ནི་དང་བཙུགས་ནི་ལུ་ལག་ལེན་འཐབ་ཡོད་མི་ལུ་དབྱེར་མེདཔ་ཨིན་ : མན་ངག་འདི་གུག་ཤད་གཉིས་ཀྱིས་བརྡ་མཚོན་ཏེ་ཡོད་པའི་མེ་ཊིགསི་མན་ངག་བཟེམ་སྦེ་བཙུགས་ཏེ་ཡོདཔ་ཨིན། { }.				2002-02-02 02:02:02
