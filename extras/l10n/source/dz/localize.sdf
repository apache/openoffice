helpcontent2	source\text\scalc\01\02140500.xhp	0	help	par_id3150767				0	dz	མངའ་ཁོངས་གཅིག་འཛིན་པང་ནང་འདྲ་བཤུས་རྐྱབ་ནིའི་ཁྱད་པར་ལུ་ ཁྱོད་ཀྱིས་ བརྡ་དོན་ལ་ལོ་ཅིག་བཙག་སྟེ་གནས་གོངས་ཚུ་རྩིས་སྟོན་འབད་ཚུགསཔ་ཨིན། འ་ནི་བརྡ་བཀོད་འདི་ ཡིག་ཆ་ནང་ལུ་ཤོག་ཁྲམ་གཉིས་སེལ་འཐུ་འབད་བ་ཅིན་རྐྱངམ་ཅིག་མཐོང་ཚུགསཔ་ཨིན། ཤོག་ཁྲམ་སྣ་མང་སེལ་འཐུ་འབད་ནིའི་དོན་ལུ་  \<switchinline select=\"sys\"\> \<caseinline select=\"MAC\"\> བརྡ་བཀོད་ \</caseinline\> \<defaultinline\>ཚད་འཛིན་ \</defaultinline\> \</switchinline\>ཨེབ་པའི་སྐབས་ཤོག་ཁྲམ་རེ་རེའི་མཆོང་ལྡེ་ ཡང་ན་སོར་ལྡེ་ཨེབ་གཏང་།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\02140500.xhp	0	help	par_id3146119				0	dz	ཤོག་ཁྲམ་གྱི་ཡར་གཡོན་ནང་ལུ་སྐྱ་ཐལ་སྒྲོམ་སྟོངམ་ཨེབ་གཏང་གི་ཐོག་ལས་ ཤོག་ཁྲམ་ཧྲིལ་བུ་སེལ་འཐུ་འབད། ཁྱོད་ཀྱིས་འདྲ་བཤུས་རྐྱབ་ནི་ཨིན་པའི་ ཤོག་ཁྲམ་གྱི་མངའ་ཁོངས་ཡང་ སེལ་འཐུ་འབད་ཚུགསཔ་ཨིན།				2002-02-02 02:02:02
