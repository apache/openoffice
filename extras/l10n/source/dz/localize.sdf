helpcontent2	source\text\shared\05\00000140.xhp	0	help	par_id3152552				0	dz	$[officename] གྲོགས་རམ་ནང་ལུ་ ཚིག་ཡིག་ཆ་ཚང་འཚོལཞིབ་ལས་འགན་གྱིས་ ཁྱོད་ལུ་ འཚོལ་ཞིབ་ཡི་གུའི་མཉམ་མཐུད་གང་རུང་ཡོད་པའི་གྲོགས་རམ་ཡིག་ཆ་འཚོལ་བཅུགཔ་ཨིན། དེ་འབད་ནིའི་དོན་ལས་  \<emph\>འཚོལ་ཞིབ་ཡི་གུ་\</emph\> ཚིག་ཡིག་ས་སྒོ་ནང་ མིང་ཚིག་གཅིག་ ཡང་ན་ ལེ་ཤ་ར་ཡིག་དཔར་རྐྱབས། 				2002-02-02 02:02:02
helpcontent2	source\text\shared\05\00000140.xhp	0	help	par_id3153345				0	dz	\<emph\>འཚོལ་ཞིབ་ཡི་གུ་\</emph\>ཚིག་ཡིག་ས་སྒོ་གིས་ ཁྱོད་ཀྱིས་མཇུག་ལུ་ཐོ་བཀོད་འབད་ཡོད་པའི་མིང་ཚིག་ཚུ་གསོག་འཇོག་འབདཝ་ཨིན། ཧེ་མའི་འཚོལ་ཞིབ་འདི་ཡང་བསྐྱར་འབད་ནིའི་དོད་ལུ་ མདའ་རྟགས་ངོས་པར་ལུ་ཨེབ་གཏང་འབད་ཞིནམ་ལས་ ཐོ་ཡིག་ནང་ལས་ཡི་གུ་སེལ་འཐུ་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\05\00000140.xhp	0	help	par_id3155941				0	dz	འཚོལ་ཞིབ་འདི་མཇུག་བསྡུ་ཞིནམ་ལས་ གྲུབ་འབྲསཀྱི་ཡིག་ཆ་མགུ་རྒྱན་ཚུ་ དབྱོ་སེལ་འཐབ་ཡོད་པའི་ཐོ་ཡིག་ཅིག་ནང་མཐུན་སྒྲིག་ལེགས་ཤོས་དང་བཅས་ ལྟག་ལུ་འབྱུངམ་ཨིན། ཆ་མཉམ་པའི་གྲོགས་རམ་ཡིག་ཆ་འདི་མངོན་གསལ་འབད་ནིའི་དོན་ལས་ ཐོ་བཀོད་ལུ་ཚར་གཉིས་ཨུབ་གཏང་འབད་ནི་དང་ ཡང་ན་ སེལ་འཐུ་འབད་ནི་ དེ་ལས་ \<emph\>བཀྲམ་སྟོན་\</emph\>ལུ་ཨེབ གཏང་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\05\00000140.xhp	0	help	par_id3157958				0	dz	ཡིག་ཆ་མགོ་མིང་ལུ་འཚོལ་ཞིབ་ཚད་བཟུང་ནིའི་དོན་ལུ་ ཞིབ་དཔྱད་སྒྲོམ་\<emph\>མགུ་རྒྱན་ནང་རྐྱངམ་ཅིག་འཚོལ་\</emph\>འདི་ལག་ལེན་འཐབ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\05\00000140.xhp	0	help	par_id3147210				0	dz	 \<emph\>ཆ་ཚང་མིང་ཚིག་རྐྱངམ་ཅིག་གི་\</emph\>ཞིབ་དཔྱད་སྒྲོམ་གྱིས་ ཁྱོད་ལུ་ངེས་ལྡན་གྱི་ལས་འགན་འགྲུབ་བཅུགཔ་ཨིན། སྒྲོམ་འདི་རྟགས་བཀལ་ཡོད་པ་ཅིན་ ཆ་མ་ཚང་བའི་མིང་ཚིག་ཚུ་མི་འཐོབ། ཁྱོད་ཀྱིས་ བཙུགས་པའི་འཚོལ་ཞིབ་ཡི་གུ་འདི་ མིང་ཚིག་རིང་མིའི་ཆ་ཤས་སྦེ་ཡང་མ་འཐོབ་པ་ཅིན་ ཞིབ་དཔྱད་སྒྲོམ་འདི་གུ་རྟགས་མ་བཀལ།				2002-02-02 02:02:02
