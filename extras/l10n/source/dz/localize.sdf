helpcontent2	source\text\shared\02\01140000.xhp	0	help	par_id3153876				0	dz	\<image id=\"img_id3149379\" src=\"res/commandimagelist/sc_bezier_unfilled.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3149379\"\>ངོས་དཔར།\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01140000.xhp	0	help	par_id3148878	57			0	dz	\<variable id=\"kurvetext\"\>\<ahelp hid=\".uno:Bezier_Unfilled\"\>ཧུམ་ཁྱུག་ཁྱུ་ཡོད་པའི་ བི་ཛར་གུགགུགཔ་ཅིག་ འབྲིཝ་ཨིན། ཁྱོད་ཀྱི་གུག་གུགཔ་འདི་ འགོ་བཙུགས་དང་ འཛིན་གྲོལ་ འདྲུད་ནི་ཚུ་ག་སྟེ་འབད་ནི་ཨིན་ན་འདི་ནང་ལུ་ཨེབ་གཏང་འབད་ནི་དང་  དེ་ལས་ཁྱོད་ཀྱི་གུག་གུགཔ་འདི་གི་མཇུག་ག་སྟེ་ལུ་མཇུག་བསྡུ་ནི་ཨིན་ན་  འདི་ནང་དཔག་བྱེད་འདི་སྤོ་བཤུད་འབད་ཞིནམ་དང་ཨེབ་གཏང་འབད། དཔག་བྱེད་འདི་  སྤོ་བཤུད་འབད་བཞིནམ་ལས་  གུག་གུགཔ་འདི་ལུ་ ཆ་བགོས་ཀྱི་གྲལ་ཐིག་ཕྲང་ཕྲངམ་ཅིག་ཁ་སྐོང་རྐྱབ་ནིའི་ལུ་  ལོག་སྟེ་ཨེབ་གཏང་འབད།  གུག་གུགཔ་འབྲི་ནི་མཇུག་བསྡུ་ནིའི་དོན་ལུ་ ཨེབ་གཏང་ཐེངས་གཉིས་འབད། ཁ་བསྡམས་ནིའི་དབྱིབས་ཅིག་ གསར་བསྐྲུན་འབད་ནི་ལུ་ གུག་གུགཔ་འདི་གི་འགོ་བཙུགས་ས་ཚིགས་འདི་ལུ་ ཨེབ་གཏང་ཐེངས་གཉིས་འབད།\</ahelp\>གུག་གུགཔ་གི་གཞུ་དབྱིབས་འདི་ ཁྱོད་ཀྱི་འདྲུད་བཞག་འབད་འབད་བའི་གྱང་ཚད་གྱི་སྦེ་ གཏན་འབེབས་བཟོཝ་ཨིན། \</variable\>				2002-02-02 02:02:02
