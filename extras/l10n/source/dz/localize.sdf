helpcontent2	source\text\swriter\01\02120000.xhp	0	help	par_id3154571				0	dz	\<variable id=\"autotexttext\"\>\<ahelp hid=\".uno:EditGlossary\"\>དེ་གིས་ རང་བཞིན་ཚིག་ཡིག་ གསར་བསྐྲུན་ ཞུན་དག་ ཡང་ན་ བཙུགསཔ་ཨིན། ཁྱོད་ཀྱིས་ རྩ་སྒྲིག་འབད་ཡོད་པའི་ཚིག་ཡིག་དེ་ ཚད་རིས་ གཞི་ཁྲམ་དང་ དེ་ལས་ ས་སྒོ་ཚུ་རང་བཞིན་ཚིག་ཡིག་སྦེ་གསོག་འཇོག་འབད་ཚུགས། རང་བཞིན་ཚིག་ཡིག་དེ་མགྱོགས་པ་རང་བཙུགས་ནིའི་དོན་ལུ་ ཁྱོད་རའི་ཡིག་ཆ་ནང་གི་རང་བཞིན་ཚིག་ཡིག་གི་དོན་ལུ་ མགྱོགས་ཐབས་དེ་ཡིག་དཔར་བརྐྱབ་ནི་དང་ དེ་ལས་ F3.\</ahelp\>\</variable\>དེ་ཨེབ།				2002-02-02 02:02:02
