helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3152417	155			0	dz	\<ahelp hid=\"HID_PROP_HIDDEN_VALUE\" visibility=\"hidden\"\>ཁྱོད་ཀྱི་ གསང་བའི་ཚད་འཛིན་འདི་གིས་ བརྒྱུད་དེ་ཐོབ་པའི་གནད་སྡུད་དེ་ ཐོ་བཀོད་འབད་བཏུབ།\</ahelp\>གནས་གོང་གི་འོག་ལུ་ \<link href=\"text/shared/02/01170600.xhp\" name=\"hidden control\"\>གསང་བའི་ཚད་འཛིན་གྱི་\</link\>ནང་ན་ \<emph\>ཁྱོད་ཀྱི་\</emph\>གསང་བའི་ཚད་འཛིན་གྱིས་བརྒྱུད་དེ་ཐོབ་པའི་ གནད་སྡུད་དེ་ཐོ་བཀོད་འབད་བཏུབ། འབྲི་ཤོག་འདི་གཏང་བའི་སྐབས་ འ་ནཱི་གནད་སྡུད་དེ་ གནས་སོར་འགྱོ་འོང་།				2002-02-02 02:02:02
