helpcontent2	source\text\scalc\guide\currency_format.xhp	0	help	par_id3150010				0	dz	ཁྱོད་ཀྱི་ \<item type=\"productname\"\>%PRODUCTNAME\</item\> ཀེལཀི་ཡིག་ཆ་འདི་ སྔོན་སྒྲིག་དངུལ་གྱི་རྩ་སྒྲིག་སོ་སོར་ཅིག་ལག་ལེན་འཐབ་ཨིན་པའི་ལག་ལེན་པ་ཅིག་གིས་ མངོན་གསལ་འབད་ཡོད་པ་ཅིན་ \<item type=\"productname\"\>%PRODUCTNAME\</item\> ཀེལཀི་ཡིག་ཆ་ བརྗེ་སོར་འབད་མི་གིས་ གོ་ལོག་ཆགས་འོང་། 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\guide\currency_format.xhp	0	help	par_id3156442				0	dz	 \<item type=\"productname\"\>%PRODUCTNAME\</item\> ཀེལཀི་ནང་ ཁྱོད་ཀྱིས་"1,234.50 €" སྦེ་རྩ སྒྲིག་འབད་དེ་ཡོད་པའི་ཨང་གྲངས་འདི་,   ད་ལྟོ་ཡང་རྒྱལ་ཁབ་གཞན་མི་ནང་ཡུ་རོསི་སྦེ་ཡོད་པ་དང་ ཌོ་ལརསི་ལུ་མ་འགྱུར་བས་ཟེར་ངོས་འཛིན་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\guide\currency_format.xhp	0	help	par_id3150749				0	dz	དཔེར་ན་ ཁྱོད་ཀྱིས་ སྐད་ཡིག་འདི་ "Default" ལུ་གཞི་སྒྲིག་འབད་ཞིནམ་ལས་ ཇར་མཱན་ལོ་ཀེལ་སྒྲིག་སྟངས་ཅིག་ལག་ལེན་འཐབ་པ་ཅིན་ དངུལ་གྱི་སྒྲིག་སྟངས་འདི་ "1.234,00 €" ཨིན། ཚགས་མ་འདི་ སྟོང་ཕྲག་བཅུ་ཚག་གི་གདོང་ཁར་ལག་ལེན་འཐབ་ཨིནམ་དང་ ལྷད་རྟགས་འདི་བཅུ་ཚག་ས་སྒོའི་གདོང་ཁར་ལག་ལེན་འཐབ་ཨིན། ད་འབདན་ཁྱོད་ཀྱིས་ \<emph\>Format\</emph\> ཐོ་ཡིག་སྒྲོམ་ནང་ལས་ གལ་ཆུང་བའི་དངུལ་གྱི་རྩ་སྒྲིག་  "$ English (US)" སེལ་འཐུ་འབད་བ་ཅིན་ འོག་གི་རྩ་སྒྲིག་འདི་འཐོབ་: "$ 1.234,00". དབྱེ་བྱེད་ཚུ་ཧེ་མ་ག་ཨིནམ་སྦེ་མཐོང་ཚུགས། དངུལ་གྱི་བརྡ་མཚོེན་རྐྱངམ་ཅིག་བསྒྱུར་ཡོདཔ་དང་གཞི་བསྒྱུར་འབད་ཡོདཔ་ཨིན་རུང་ དབྱངས་རྟགས་ཀྱི་འོག་ཐིག་བཅས་པའི་རྩ་སྒྲིག་འདི་ ལོ་ཀེལ་སྒྲིག་སྟངས་ནང་བཟུམ་སྦེ་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\guide\currency_format.xhp	0	help	par_id3145640				0	dz	\<emph\>སྐད་ཡིག་\</emph\> ཀྱི་འོག་ལུ་ཨིན་པ་ཅིན་ ནང་ཐིག་ཚུ་ "English (US)" ལུ་གཞི་བསྒྱུར་འབད་ ཨིང་ལིཤི་-སྐད་ཡིག་ལོ་ཀེལ་སྒྲིག་སྟངས་འདི་ཡང་གནས་སོར་བཏང་ཡོདཔ་ལས་ སྔོན་སྒྲིག་དངུལ་གྱི་རྩ་སྒྲིག་འདི་ད་ལས་ཕར་ "$ 1,234.00" ཨིན།				2002-02-02 02:02:02
