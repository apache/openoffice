helpcontent2	source\text\swriter\01\02120000.xhp	0	help	par_id3155358				0	dz	\<ahelp hid=\"HID_MD_GLOS_EDIT\"\> ཡིག་ཆ་སོ་སོའི་ནང་ལུ་ཞུན་དག་འབད་ནིའི་དོན་ལུ་ སེལ་འཐུ་འབད་ཡོད་པའི་རང་བཞིན་ཚིག་ཡིག་ཐོ་བཀོད་དེ་ཁ་ཕྱེཝ་ཨིན། ཁྱོད་ར་ལུ་དགོ་པའི་བསྒྱུར་བཅོས་ཚུ་བཟོ་ \<emph\>ཡིག་སྣོད་ - རང་བཞིན་ཚིག་ཡིག་སྲུང་བཞག་འབད་ ཟེར་མི་དེ་\</emph\> གདམ་ཁ་བརྐྱབ་ཞིནམ་ལས་ དེ་ལས་ \<emph\>ཡིག་སྣོད་ - ཁ་བསྡམས་ཟེར་མི་དེ་ \</emph\>.\</ahelp\>གདམ་ཁ་རྐྱབས།				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02120000.xhp	0	help	par_id3145106	44			0	dz	\<ahelp hid=\".\" visibility=\"hidden\"\>སེལ་འཐུ་འབད་ཡོད་མི་རང་བཞིན་ཚིག་ཡིག་ཐོ་བཀོད་དེ་ལུ་ ཁྱོད་ཀྱིས་མེཀ་རོ་མཉམ་སྦྲགས་འབད་སྲོལ་ཡོད་མི་ འགན་སྤྲོད་མེཀ་རོ་ཌའི་ལོག་དེ་ཁ་ཕྱེཝ་ཨིན། \</ahelp\> ཁྱོད་ཀྱིས་སེལ་འཐུ་འབད་ཡོད་མི་ རང་བཞིན་ཚིག་ཡིག་ཐོ་བཀོད་དེ་ནང་ལུ་མཉམ་སྦྲགས་འབད་སྲོལ་ཡོད་མི་ \<link href=\"text/swriter/01/05060700.xhp\" name=\"Assign Macro\"\>འགན་སྤྲོད་མེཀ་རོ་\</link\>ཌའི་ལོག་དེ་ཁ་ཕྱེཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02120000.xhp	0	help	par_id3149583				0	dz	ཁྱོད་ཀྱིས་གསར་བསྐྲུན་འབད་སྲོལ་ཡོད་མི་རང་བཞིན་ཚིག་ཡིག་ཐོ་བཀོད་ཚུ་ནང་ལུ་བྱིན་ཏེ་ཡོད་མི་རང་བཞིན་ཚིག་ཡིག་ཐོ་བཀོད་ལ་ལུ་ཅིག་དང་འབྲེལ་མཐུད་འབད་དེ་ཡོད་པའི་མེཀ་རོ་ཚུ་དེ་ཚུ་ལག་ལེན་འཐབ་ཚུགས། རང་བཞིན་ཚིག་ཡིག་ཐོ་བཀོད་ཚུ་ "text only" ཟེར་མི་གདམ་ཁ་དང་ཅིག་ཁར་གསར་བསྐྲུན་འབད་དགོཔ་ཨིན། དཔེ་འབད་བ་ཅིན་ ཡིག་ཚུགས་<field:company>དེ་རང་བཞིན་ཚིག་ཡིག་ཐོ་བཀོད་ནང་ལུ་བཙུགས་ཞིནམ་ལས་ $[officename] ཆ་མཉམ་པའི་གནད་སྡུད་ས་སྒོ་དེ་གི་ནང་དོན་ཚུ་དང་གཅིག་ཁར་ཡིག་ཚུགས་དེ་ཚབ་བཙུགསཔ་ཨིན།				2002-02-02 02:02:02
