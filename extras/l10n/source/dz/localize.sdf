helpcontent2	source\text\shared\01\06140100.xhp	0	help	par_id3152952				0	dz	\<ahelp hid=\"HID_CONFIG_MENU\"\>ད་ལྟོའི་དཀར་ཆག་སྒྲིག་བཀོད་འདི་ཚུ་  སྲོལ་སྒྲིག་འབད་ནི་དང་སྲུང་ནི་  དེ་ལས་ དཀར་ཆག་གསརཔ་ཚུ་གསར་བསྐྲུན་འབདཝ་ཨིན།  ཁྱོད་ཀྱིས་  ནང་དོན་དཀར་ཆག་ཚུ་སྲོལ་སྒྲིག་འབད་མི་བཏུབ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06140100.xhp	0	help	par_id3146873				0	dz	ཁྱོད་ཀྱིས་  བརྡ་བཀོད་གསརཔ་ཁ་སྐོང་བརྐྱབ་ནི་དང་  གནས་དེ་ཡོད་པའི་བརྡ་བཀོད་ཚུ་ལེགས་བཅོས་འབད་ནི་དང་  ཡང་ན་  དཀར་ཆག་རྣམ་གྲངས་ཚུ་  སླར་བདེ་སྒྲིག་བཟོ།				2002-02-02 02:02:02
