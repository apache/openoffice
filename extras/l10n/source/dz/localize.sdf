helpcontent2	source\text\shared\optionen\01010100.xhp	0	help	par_id3156410				0	dz	\<ahelp hid=\"HID_OPTIONS_GENERAL\"\>ལག་ལེན་པའི་གནད་སྡུད་ཞུན་དག་ ཡང་ན་ བཙུགས་ནི་ལུ་མཆོང་ལྡེ་ཤོག་ལེབ་འདི་ལག་ལེན་འཐབ།\</ahelp\> གནད་སྡུད་ལ་ལོ་ཅིག་ $[officename] གཞི་བཙུགས་འབདཝ་ད་ལག་ལེན་པ་གིས་ཧེ་མ་ལས་བཙུགས་འདི་ཡོདཔ་འོང་།				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010100.xhp	0	help	par_id3153748				0	dz	ལག་ལེན་པའི་གནད་སྡུད་འདི་ $[officename] ནང་ཝི་ཛརཌིསི་དང་ཊེམ་པེལེཊིསི་གིས་ལག་ལེན་འཐབཔ་ཨིན། དཔེར་ན་  "འགོ་མིང་" དང་ "མཇུག་མིང་" གནད་སྡུད་ས་སྒོ་ཚུ་ཡིག་ཆ་གསརཔ་གི་རྩོམ་པ་པོ་སྦེ་ཁྱོད་ཀྱི་མིང་རང་བཞིན་གྱིས་བཙུགས་ནི་ལུ་ལག་ལེན་འཐབཔ་ཨིན། ཁྱོད་ཀྱིས་འ་ནི་འདི་ \<emph\>ཡིག་སྣོད་ - རྒྱུ་དངོས་ཚུའི་འོག་ལུ་མཐོང་ཚུགས།\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010100.xhp	0	help	par_id3153031				0	dz	ལག་ལེན་པའི་གནད་སྡུད་ལ་ལོ་ཅིག་ནང་འཁོད་ཀྱི་ཚིག་མཛོད་ནང་རང་བཞིན་གྱིས་གྲངས་སུ་བཙུགས་ཏེ་ཡོདཔ་ཨིན་ དེ་འབདཝ་ལས་འ་ནི་དེ་སྡེབ་དཔྱོདཔ་གིས་ངོས་འཛིན་འབདཝ་ཨིན། ཡིག་དཔར་འཛོལ་བ་ཚུ་བཟོ་བ་ཅིན་ ལས་རིམ་འདི་གིས་ཚབ་མ་ཚུ་བསམ་འཆར་བཀོད་ནི་ལུ་གནད་སྡུད་འདི་ལག་ལེན་འཐབ་ཚུགས། གནད་སྡུད་ལུ་བསྒྱུར་བཅོས་ཚུ་ $[officename] ལོག་འགོ་བཙུགས་པའི་ཤུལ་ལས་རྐྱངམ་གཅིག་ནུས་པ་ཐོབ་ཨིནམ་དྲན་འཛིན་འབད།				2002-02-02 02:02:02
