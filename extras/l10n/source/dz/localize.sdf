helpcontent2	source\text\shared\autopi\webwizard00.xhp	0	help	par_idN1055D				0	dz	\<ahelp hid=\"34200\"\>ཝེབ་ཝི་ཛརཌི་གིས་ཁྱོད་ལུ་ ཨིན་ཊར་ནེཊི་སར་བར་གུ་ཝེབ་ས་ཁོངས་ཅིག་ རྒྱུན་སྐྱོང་འབད་ནི་ལུ་གྲོགས་རམ་འབདཝ་ཨིན། \</ahelp\>ཝེབ་ཝི་ཛརཌི་གིས་ ཡིག་སྣོད་ཚུ་ཉེ་གནས་སྣོད་འཛིན་ནང་ལས་ཝེབ་རྩ་སྒྲིག་ལུ་ གཞི་བསྒྱུར་འབདཝ་ཨིནམ་དང་ དེ་ལས་ཡིག་སྣོད་ཚུ་སར་བར་ལུ་སྐྱེལ་བཙུགས་འབདཝ་ཨིན། དེ་མ་ཚད་ཝི་ཛརཌི་གིས་ ཡིག་སྣོད་ཚུ་སྐྱེལ་བཙུགས་འབད་ནིའི་དོན་ལུ་ ཧའི་པར་ལིངཀསི་ཡོད་པའི་ཟུར་ཐོའི་ཤོག་ལེབ་ཅིག་གསར་བསྐྲུན་འབད་ནི་ལུ་ བཀྲམ་སྤེལ་འབད་ཡོད་པའི་ཊེམ་པེལེཊིསི་ནང་ལས་གཅིག་ ལག་ལེན་འཐབ་ཨིན། 				2002-02-02 02:02:02
