helpcontent2	source\text\shared\01\01020000.xhp	0	help	par_id3149291				0	dz	\<ahelp hid=\"HID_FILEOPEN_VERSION\"\> སེལ་འཐུ་འབད་ཡོད་པའི་  ཡིག་སྣོད་ཀྱི་ཐོན་རིམ་སྣ་མང་ཚུ་ཡོད་པ་ཅིན་  ཁྱོད་ཀྱིས་ཁ་ཕྱེ་དགོ་པའི་  ཐོན་རིམ་འདི་སེལ་འཐུ་འབད།  \</ahelp\> ཁྱོད་ཀྱིས་ཡིག་ཆ་ཅིག་གི་སྣ་མང་ཐོན་རིམ་ཚུ་  འགོ་འདྲེན་འཐབ་ནི་དང་སྲུངས་ནི་འདི་  \<emph\>ཡིག་སྣོད་ - ཐོན་རིམ་ཚུ་\</emph\>སེལ་འཐུ་འབད་དེ་བཏུབ་ཨིན།  ཡིག་ཆ་གི་ཐོན་རིམ་ཚུ་ ལྷག་ནི་ཙམ་གྱི་་ཐབས་ལམ་ནང་ལུ་ཁ་ཕྱེཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01020000.xhp	0	help	par_id3153969				0	dz	\<ahelp hid=\"SVTOOLS_LISTBOX_DLG_SVT_EXPLORERFILE_LB_EXPLORERFILE_FILETYPE\"\>ཁྱོད་ཀྱིས་ཁ་ཕྱེ་དགོ་པའི་ཡིག་སྣོད་ཀྱི་དབྱེ་བ་འདི་  སེལ་འཐུ་འབད་ནི་དང་ཡང་ན་  སྣོད་ཐོ་ནང་ལུ་ཡིག་སྣོད་ཆ་མཉམ་གྱི་ཐོ་ཡིག་ཅིག་  བཀྲམ་སྟོན་འབད་ནི་དོན་ལུ་   \<emph\>ཡིག་སྣོད་ཚུ་ཆ་མཉམ་ (*)\</emph\>སེལ་འཐུ་འབད།\</ahelp\>				2002-02-02 02:02:02
