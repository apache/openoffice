helpcontent2	source\text\shared\explorer\database\dabawiz02oracle.xhp	0	help	par_idN105C1				0	dz	སོ་ལ་རིསི་ཡང་ན་ལི་ནགསི་ལས་  ཨོ་རེ་ཀཱལ་གནད་སྡུད་གཞི་རྟེན་འཛུལ་སྤྱོད་འབད་ནི་ལུ་  ཁྱོད་ཀྱིས་ ཇེ་ཌི་བི་སི་འདྲེན་བྱེད་འདི་ལག་ལེན་འཐབ།  ཝིན་ཌཱསི་ལས་གནད་སྡུད་གཞི་རྟེན་འཛུལ་སྤྱོད་འབད་ནིའི་དོན་ལས་ ཁྱོད་ལུ་ ཨོ་ཌི་བི་སི་འདྲེན་བྱེད་འདི་དགོ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\dabawiz02oracle.xhp	0	help	par_idN105D4				0	dz	ཡུ་ནིགསི་གུ་ ཨོ་རེ་ཀཱལ་གནད་སྡུད་གཞི་རྟེན་ཞབས་ཏོག་སྤྱོད་མི་འདི་  ཇེ་ཌི་བི་སི་རྒྱབ་སྐྱོར་དང་བཅས་གཞི་བཙུགས་ཡོད་ཟེར་ ངེས་བརྟེན་བཟོ།   ཇེ་ཌི་བི་སི་འདྲེན་བྱེད་དབྱེ་རིགས་འདི་ སོ་ལ་རིསི་ཨོ་རེ་ཀཱལ་ཞབས་ཏོག་སྤྱོད་མིའི་ཐོན་རིམ་  8.x དོན་ལུ་  Oracle client>/product/jdbc/lib/classes111.zip  སྣོད་ཐོ་ནང་ལུ་གནས་དེ་ཡོདཔ་ཨིན། ཨོ་རེ་ཀཱལ་ཝེབ་ས་སྟོང་ལས་ འདྲེན་བྱེད་ཀྱི་མཐའ་མཇུག་གི་ཐོན་རིམ་འདི་  ཁྱོད་ཀྱིས་ ཕབ་ལེན་འབད་བཏུབ:				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\dabawiz02oracle.xhp	0	help	par_idN105D7				0	dz	http://otn.oracle.com/tech/java/sqlj_jdbc/content.html				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\dabawiz02oracle.xhp	0	help	par_idN105EA				0	dz	\<ahelp hid=\".\"\>In the \<emph\>གནད་སྡུད་འབྱུང་ཁུངས་ཡུ་ཨར་ཨེལ་\</emph\>སྒྲོམ་ནང་ལུ་  ཨོ་རེ་ཀཱལ་གནད་སྡུད་གཞི་རྟེན་སར་བར་གྱི་གནས་ཁོངས་འདི་བཙུགས།  ཡུ་ཨར་ཨེལ་གྱི་ཚིག་སྦྱོར་འདི་ གནད་སྡུད་གཞི་རྟེན་གྱི་དབྱེ་བ་ལུ་རག་ལས།  བརྡ་དོན་མངམ་གྱི་དོན་ལུ་ ཇེ་ཌི་བི་སི་འདྲེན་བྱེད་དང་ཅིག་ཁར་འོང་ཡོད་པའི་ཡིག་ཐོག་བཀོད་པ་དེ་ལུ་བལྟ་ད། \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\dabawiz02oracle.xhp	0	help	par_idN105F1				0	dz	ཨོ་རེ་ཀཱལ་གནད་སྡུད་གཞི་རྟེན་དོན་ལུ་  ཡུ་ཨར་ཨེལ་གྱི་ཚིག་སྦྱོར་འདི:				2002-02-02 02:02:02
