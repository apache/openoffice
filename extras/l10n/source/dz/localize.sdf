helpcontent2	source\text\swriter\01\05060900.xhp	0	help	par_id3154192				0	dz	\<ahelp hid=\"SW_LISTBOX_TP_FRM_ADD_LB_PREV\"\>དེ་གིས་ ད་ལྟོའི་རྣམ་གྲངས་ནང་གི་ཧེ་མ་འོང་མི་ རྣམ་གྲངས་(དངོས་པོ་ ཚད་རིས་ ཡང་ན་ གཞི་ཁྲམ་) འབྲལ་མཐུད་འབད་ཡོད་པའི་གོརིམ་ནང་སྦེ་བཀྲམ་སྟོན་འབདཝ་ཨིན། ཁ་སྐོང་བརྐྱབ་ནི་དང་ ཡང་ན་ ཧེ་མའི་འབྲལ་ལམ་དེ་བསྒྱུར་བཅོས་འབད་ནིའི་དོན་ལུ་ ཐོ་ཡིག་ནང་ལས་མིང་ཅིག་སེལ་འཐུ་འབད། ཁྱོད་ཀྱིས་གཞི་ཁྲམ་ཚུ་འབྲལ་མཐུད་འབད་དོ་ཡོདཔ་ཨིན་པ་ཅིན་ ད་ལྟོའི་གཞི་ཁྲམ་དང་ དམིགས་གཏད་གཞི་ཁྲམ་དེ་སྟོངམ་སྦེ་དགོཔ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
