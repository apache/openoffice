helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	par_id9407330				0	dz	\<ahelp hid=\".\"\>གྲལ་ཐིག་ནང་  ཚར་གཅིག་འདི་གིས་  མཇུག་གི་ཡིག་འབྲུ་སྦེ་འགྱོ་ཚར་ཞིནམ་ལས་  གྲལ་ཐིག་གི་བཅད་མཚམས་གསར་བསྐྲུན་དང་ འབྱུང་ནི་ཨིན་མི་  མིང་ཚིག་གི་ནང་འཁོད་  མཐོང་མ་ཚུགས་པའི་ སྦྲེལ་རྟགས་ཅིག་ བཙུགསཔ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	hd_id2295907				0	dz	རྒྱ་ཚད་གདམ་ཁ་མེད་པའི་བཅད་མཚམས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\formatting_mark.xhp	0	help	par_id1536301				0	dz	\<ahelp hid=\".\"\>གྲལ་ཐིག་ནང་  འདི་གིས་ ཚར་གཅིག་མཇུག་གི་གྲལ་ཐིག་སྦེ་ འགྱོ་ཚར་ཞིནམ་ལས་  གྲལ་ཐིག་གི་བཅད་མཚམས་བཙུགས་ནི་ཨིན་མི་  མིང་ཚིག་གི་ནང་འཁོད་  མཐོང་མ་ཚུགས་པའི་བར་སྟོང་ཅིག་ བཙུགསཔ་ཨིན། གོ་དཀའ་བའི་ ཚིག་ཡིག་གི་སྒྲིག་བཀོད་ (སི་ཊི་ཨེལ་)འདི་  ལྕོགས་ཅན་བཟོ་ཚར་ཞིནམ་ལས་  འཐོབ་ཚུགསཔ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
