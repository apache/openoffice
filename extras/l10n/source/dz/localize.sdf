helpcontent2	source\text\shared\02\01170400.xhp	0	help	par_id3166460				0	dz	\<variable id=\"text\"\>\<ahelp hid=\".uno:AddField\" visibility=\"visible\"\> ཁྱོད་ཀྱི་འབྲི་ཤོག་ནང་ལུ་  ཁ་སྐོང་རྐྱབ་ནི་ལུ་ གནད་སྡུད་གཞི་རྟེན་གྱི་ས་སྒོ་ཅིག་  སེལ་འཐུ་འབད་བཏུབ་ས་ལུ་  ཝིན་ཌོ་ཅིག་  ཁ་ཕྱེཝ་ཨིན།\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170400.xhp	0	help	par_id3156114				0	dz	\<ahelp visibility=\"visible\" hid=\"HID_FIELD_SEL\"\>ས་སྒོ་སེལ་འཐུ་གི་ ཝིན་ཌོ་འདི་གིས་  ཐིག་ཁྲམ་གྱི་གནད་སྡུད་གཞི་རྟེན་གྱི་ས་སྒོ་  ཆ་མཉམ་དང་  ཡང་ན་   \<link href=\"text/shared/02/01170201.xhp\" name=\"Form Properties\"\>འབྲི་ཤོག་གི་རྒྱུ་དངོས་ཚུ་ནང་\</link\>གནད་སྡུད་གཞི་རྟེན་གྱི་འབྱུང་ཁུངས་སྦེ་  གསལ་བཀོད་འབད་ཡོད་མི་  འདྲི་དཔྱད་དེ་ ཐོ་བཀོད་འབདཝ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
