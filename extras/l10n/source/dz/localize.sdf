helpcontent2	source\text\shared\guide\hyperlink_edit.xhp	0	help	par_id3145119				0	dz	གདམ་ཁ་ ༢:  \<link href=\"text/shared/main0209.xhp\" name=\"Hyperlink Bar\"\>ཚད་བརྒལ་འབྲེལ་ལམ་ཕྲ་རིང་\</link\> (\<emph\>སྟོན་ - ལག་ཆས་ཕྲ་རིང་ཚུ་ - ཚད་བརྒལ་འབྲེལ་ལམ་ཕྲ་རིང་\</emph\>) ཁ་ཕྱེ། ཚད་བརྒལ་འབྲེལ་ལམ་གུ་ཨེབ་གཏང་ མའུསི་ཨེབ་རྟ་འདི་གསར་བཏོན་མ་འབད་ དེ་ལས་ ཚད་བརྒལ་འབྲེལ་ལམ་འདི་ ཚད་བརྒལ་འབྲེལ་ལམ་ཕྲ་རིང་འདི་ལུ་མ་འདྲུད། ཚད་བརྒལ་འབྲེལ་ལམ་ཕྲ་རིང་གུའི་ཡུ་ཨར་ཨེལ་འདི་ཞུན་དག་འབད་ དེ་ལས་ སླར་ལོག་ལྡེ་མིག་འདི་ཨེབ།				2002-02-02 02:02:02
