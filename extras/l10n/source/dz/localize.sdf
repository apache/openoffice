helpcontent2	source\text\shared\01\02070000.xhp	0	help	par_id3156283	56			0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>འཛིན་སྤང་ནང་དོན་ཚུ་གི་དོན་ལུ་  སྦྱར་ནིའི་གདམ་ཁ་འདི་གཞི་སྒྲིག་འབད་དོ་ཡོདཔ་ཨིན། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
