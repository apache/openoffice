helpcontent2	source\text\shared\02\06100000.xhp	0	help	par_id3109850				0	dz	\<ahelp hid=\".uno:MoveUp\"\>འདི་གི་ཧེ་མ་ཡོད་མི་ཅིག་གི་ཤུལ་ལས་  སེལ་འཐུ་གྲུབ་ཡོད་པའི་  དོན་མཚམས་དེ་  གནས་ས་བཞགཔ་ཨིན། \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\06100000.xhp	0	help	par_id3149283	5			0	dz	ཁྱོད་ཀྱི་དོན་མཚམས་འདི་  ཨང་བཏགས་ཡོདཔ་དང་ \<emph\> ཡར་བཤུད་ \</emph\>ངོས་དཔར་འདི་ལུ་  ཨེབ་གཏང་འབད་ཡོད་པ་ཅིན་  ཨང་གྲངས་འདི་ཚུ་ ད་ལྟོའི་གོ་རིམ་ནངལུ་  བདེ་སྒྲིག་འབད་འོང་།\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>ཡར་བཤུད་ \<emph\>ངོས་དཔར་འདི་\</emph\>  འགོ་བཙུགས་ཡོདཔ་  ཡང་ན་  ཨང་བཏགས་ཡོད་མི་ཅིག་ནང་  འོད་རྟགས་འདི་  གནས་ས་བཙུགས་ཡོད་པ་ཅིན་ རྐྱངམ་ཅིག་  མཐོང་ཚུགསཔ་ཨིན། ཁྱོད་ཀྱི་བསྡུསདོན་གྱི་ མཐོང་སྣང་འདི་ ལག་ལེན་འཐབ་ད་\</caseinline\>\</switchinline\>\<switchinline select=\"appl\"\>\<caseinline select=\"IMPRESS\"\>ཡར་བཤུད་ཀྱི་ \<emph\>ངོས་དཔར་འདི་ \</emph\>ཚིག་ཡིག་རྩ་སྒྲིག་གི་ \<emph\>ཕྲ་རིང་ནང་ལུ་\</emph\> བྱུངམ་ཨིན།\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
