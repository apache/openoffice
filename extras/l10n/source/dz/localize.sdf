helpcontent2	source\text\shared\01\05010000.xhp	0	help	par_id3147261				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"CHART\"\>\</caseinline\>\<defaultinline\>ཐད་ཀར་གྱི་རྩ་སྒྲིག་འདི་   \<emph\>རྒྱགས་པ་\</emph\> ངོས་དཔར་གུ་ཨེབ་གཏང་འབད་དེ་  ཡིག་བཟོ་རྒྱགས་པ་སྒྲིག་སྟངས་འབད་ནི་བཟུམ་གྱི་  བཟོ་རྣམ་ཚུ་ཁྱོད་ཀྱིས་ལག་ལེན་མ་འཐབ་པར་  འཇུག་སྤྱོད་འབད་མི་རྩ་སྒྲིག་འདི་ཨིན།\</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05010000.xhp	0	help	par_id3157959				0	dz	ཁྱོད་ཀྱིས་ འོག་ཐིག་བཟུམ་གྱི་ གྲལ་ཐིག་གི་མཇུག་ལུ་ཚིག་ཡིག་གསརཔ་ཅིག་ཡིག་དཔར་བརྐྱབ་ད་  ཐད་ཀར་གྱི་རྩ་སྒྲིག་གི་འཇུག་སྤྱོད་འདི་བཀག་ནི་དོན་ལུ་  མདའ་རྟགས་གཡས་ཀྱི་ལྡེ་མིག་འདི་གུ་ཨེབ་གཏང་།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05010000.xhp	0	help	par_id3146797	4			0	dz	\<emph\>རྩ་སྒྲིག་- སྔོན་སྒྲིག་རྩ་སྒྲིག་འབད་དོ་  སེལ་འཐུ་འབད་དེ་  ཁྱོད་ཀྱིས་  ཧའི་པར་ལིངཀསི་འདི་ ཚིག་ཡིག་ནང་ལུ་སེལ་འཐུ་འབད་དེ་ཡོད་མི་ཚུ་  སྤྱིར་གཏང་གི་ཚིག་ཡིག་ནང་ལུ་ལོག་འདི་རང་ བསྒྱུར་བཅོས་འབད་བཏུབ་ཨིན། \</emph\>				2002-02-02 02:02:02
