helpcontent2	source\text\shared\01\04150100.xhp	0	help	par_id3149748				0	dz	\<variable id=\"ole\"\>\<ahelp hid=\".uno:InsertObject\"\>Inserts an \<link href=\"text/shared/00/00000005.xhp#ole\" name=\"OLE\"\>ཨོ་ཨེལ་ཨི་\</link\>དངོས་པོ་འདི་ ་ད་ལྟོའི་ཡིག་ཆ་ནང་ལུ།  ཨོ་ཨེལ་ཨི་དངོས་པོ་འདི་  འབྲེལ་ལམ་དང་  ཡང་ན་  གནས་འདྲེན་དངོས་པོ་སྦེ་བཙུགས་ཡོད།\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\04150100.xhp	0	help	par_id3149205				0	dz	ཡིག་ཆ་འདི་བཀྲམ་སྟོན་འདི་མགྱོགས་ཚད་བཟོ་ནི་ལུ་  ཨོ་ཨེལ་ཨི་དངོས་པོ་ཚུ་ལས་རིམ་འདྲ་མཛོད་ནང་བཞག་ཡོད།  ཁྱོད་ཀྱིས་ ་འདྲ་མཛོད་སྒྲིག་སྟངས་ཚུ་བསྒྱུར་བཅོས་འབད་དགོ་པ་ཅིན་   \<link href=\"text/shared/optionen/01011000.xhp\" name=\"Tools - Options - $[officename] - དྲན་ཚད་\"\>\<emph\>ལག་ཆས་ཚུ་- གདམ་ཁ་ཚུ་ - $[officename] - དྲན་ཚད་\</emph\>\</link\>གདམ་ཁ་བརྐྱབ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\04150100.xhp	0	help	par_id3145314				0	dz	ཨོ་ཨེལ་ཨི་དངོས་པོ་ཚུ་ཡིག་སྣོད་གཞན་མི་ཚུ་ལུ་སྤོ་བཤུད་འབད་ནི་དོན་ལུ་   ཁྱོད་ཀྱིས་  འཛིན་སྤངས་ཡང་ན་ འདྲུད་ནི་དང་བཞག་ནི་འདི་  ལག་ལེན་འཐབ་མི་བཏུབ།				2002-02-02 02:02:02
