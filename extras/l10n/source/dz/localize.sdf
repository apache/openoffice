helpcontent2	source\text\shared\guide\protection.xhp	0	help	par_id3150775				0	dz	ཡིག་ཆ་ཚུ་ཆ་མཉམ་ \<link href=\"text/shared/00/00000021.xhp\" name=\"OpenDocument format\"\>ཨོ་པཱན་ཡིག་ཆའི་རྩ་སྒྲིག་\</link\>ནང་སྲུང་སྟེ་ཡོད་མི་ཚུ་  ཆོག་ཡིག་དང་ཅིག་ཁར་སྲུང་ཚུགས།  ཆོག་ཡིག་དང་ཅིག་ཁར་སྲུང་སྟེ་ཡོད་མི་ཡིག་ཆ་ཚུ་  ཆོག་ཡིག་མེད་པར་ཁ་ཕྱེ་མི་ཚུགས།   ནང་དོན་འདི་མཐའ་བཙན་བཟོ་ཡོདཔ་ལས་   ཕྱིའི་ཞུན་དགཔ་ཅིག་དང་ཅིག་ཁར་ལྷག་མི་ཚུགས།  འདི་གིས་  ནང་དོན་ ཚད་རིས་དང་ཨོ་ཨེལ་ཨི་དངོས་པོ་ཚུ་ལུ་འཇུག་སྤྱོད་འབདཝ་ཨིན།				2002-02-02 02:02:02
