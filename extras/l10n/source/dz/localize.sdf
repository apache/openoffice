helpcontent2	source\text\shared\explorer\database\04030000.xhp	0	help	par_id3154230				0	dz	$[officename] ཡིག་ཆ་གང་རུང་ཅིག་རྣམ་པའི་ནང་ལུ་ རྒྱ་འཕར་འབད་བཏུབ།  རྣམ་པའི་ཚད་འཛིན་ཚུ་གཅིག་  ཡང་ན་  མངམ་ཁ་སྐོང་རྐྱབས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\04030000.xhp	0	help	par_id3145382				0	dz	ལག་ཆས་ཕྲ་རིང་ཚད་འཛིན་འབད་མིའི་རྣམ་པ་འདི་ཁ་ཕྱེ།  རྣམ་པ་གིས་ \<link href=\"text/shared/02/01170000.xhp\" name=\"functions\"\>functions\</link\>རྣམ་པ་ཅིག་ཞུན་དག་འབད་དགོ་པས་ཟེར་མི་འདི་ ཚད་འཛིན་འབདཝ་ཨིན།  རྣམ་པ་མང་ཤོས་རང་   \<emph\>རྣམ་པའི་བཀོད་སྒྲིག་\</emph\> ཕྲ་རིང་དང་  \<emph\>ཚད་འཛིན་མངམ་\</emph\> ཕྲ་རིང་ནང་ལུ་ ཐོབ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\04030000.xhp	0	help	par_id3153146				0	dz	རྣམ་པའི་བཀོད་སྒྲིག་ནང་ ཁྱོད་ཀྱིས་ \<link href=\"text/shared/02/01170000.xhp\" name=\"include controls\"\>ཚད་འཛིན་འདི་གྲངས་སུ་བཙུགས་བཏུབ་\</link\>, \<link href=\"text/shared/02/01170100.xhp\" name=\"apply properties\"\>དེ་ཚུ་ལུ་ རྒྱུ་དངོས་འཇུག་སྤྱོད་འབད་བཏུབ་\</link\> ,ངེས་འཛིན་འབད་\<link href=\"text/shared/02/01170200.xhp\" name=\"Form properties\"\>རྣམ་པའི་རྒྱུ་དངོས་ཚུ་\</link\>, དང་ \<link href=\"text/shared/02/01170203.xhp\" name=\"define subforms\"\>རྣམ་པའི་ཡན་ལག་ཚུ་ངེས་འཛིན་འབད།\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\04030000.xhp	0	help	par_id3154924	9			0	dz	འབྲི་ཤོག་དངོས་པོའི་ཕྲ་རིང་གུ་\<emph\> འབྲི་ཤོག་འགྲུལ་བསྐྱོདཔ་\</emph\> ངོས་དཔར་ \<image id=\"img_id3156002\" src=\"res/commandimagelist/sc_showfmexplorer.png\" width=\"4.23mm\" height=\"4.23mm\"\>\<alt id=\"alt_id3156002\"\>ངོས་དཔར་གྱིས་\</alt\>\</image\> འབྲི་ཤོག་འགྲུལ་བསྐྱོདཔ་ \<link href=\"text/shared/02/01170600.xhp\" name=\"Form Navigator\"\>\<emph\>ཁ་ཕྱེཝ་ཨིན།\</emph\>\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\04030000.xhp	0	help	par_id3153968	6			0	dz	བཀོད་སྒྲིག་ཐབས་ལམ་ \<link href=\"text/shared/02/01171000.xhp\" name=\"Open in Design Mode\"\>\<emph\>ངོས་དཔར་\</emph\>\</link\> ངོས་དཔར་ནང་ \<image id=\"img_id1871395\" src=\"res/commandimagelist/sc_openreadonly.png\" width=\"5.59mm\" height=\"5.59mm\"\>\<alt id=\"alt_id1871395\"\>ཁ་ཕྱེ་འདི་གིས་\</alt\>\</image\> ཁྱོད་ལུ་འབྲི་ཤོག་རྣམ་པ་བསྲུང་བཞག་འབད་བཅུགཔ་ཨིན་ དེ་འབདཝ་ལས་དེ་གིས་ཨ་རྟག་རང་ཞུན་དག་འབད་ནིའི་ཐབས་ལམ་ནང་ཁ་ཕྱེཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\04030000.xhp	0	help	par_id3154948				0	dz	རྣམ་པའི་ནང་ལུ་ཡོད་པའི་དངོས་པོ་ལུ་ རྒྱུ་དངོས་འགན་སྤྲོད་འབདཝ་ད་ འཛོལ་བ་འབྱུང་པ་ཅིན་ (དཔེར་ན་ དངས་པོ་ལུ་ གནས་དེ་མེད་པའི་གནད་སྡུད་གཞི་རྟེན་ཅིག་འགན་སྤྲོད་འབདཝ་ད་བཟུམ་) ཆ་མཉམ་པའི་འཕྲིན་དོན་ཅིག་འབྱུངམ་ཨིན། འ་ནི་འཛོལ་བའི་འཕྲིན་དོན་དེ་གིས་ \<emph\>མངམ་\</emph\> ཨེབ་རྟ་འདི་ཤོངམ་ཨིན། ཁྱོད་ཀྱིས་ \<ahelp hid=\"dummy\"\> \<emph\>མངམ་\</emph\>ཨེབ་གཏང་པ་ཅིན་ ད་ལྟོའི་དཀའ་ངལ་གྱི་སྐོར་ལས་ བརྡ་དོན་མངམ་བཀྲམ་སྟོན་འབད་མི་ཌའི་ལོག་འདི་འབྱུངམ་ཨིན། ་\</ahelp\>				2002-02-02 02:02:02
