helpcontent2	source\text\shared\guide\dragdrop_beamer.xhp	0	help	par_id3155132				0	dz	ཁྱོད་ཀྱིས་གནད་སྡུད་གཞི་རྟེན་ལུ་འབྲེལ་མཐུད་འབད་ཡོད་མི་ ཚིག་ཡིག་འབྲི་ཤོག་ཅིག་གསར་བསྐྲུན་འབད་བའི་སྐབས་ ཁྱོད་ཀྱིས་ཚད་འཛིན་ཚུ་ གནད་སྡུད་འབྱུང་ཁུངས་མཐོང་སྣང་འདི་ལས་ འདྲུད་-དང་-བཀོག་བཞག་གིས་སྦེ་ བཟོ་བཏོན་འབད་ཚུགས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\dragdrop_beamer.xhp	0	help	par_id3149562				0	dz	ཚིག་ཡིག་ཡིག་ཆའི་ནང་ལུ་ གནད་སྡུད་གཞི་རྟེན་ཅིག་འདྲུད་པའི་སྐབས་ ཁྱོད་ཀྱིས་ ས་སྒོ་ཅིག་བཙུགཔ་ཨིན། ཁྱོད་ཀྱིས་ འདྲུད་པའི་ཚེ་ སོར་ལྡེ་+\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>བརྡ་བཀོད་ \</caseinline\>\<defaultinline\>ཚད་འཛིན་\</defaultinline\>\</switchinline\> མར་འབད་བཟུང་པ་ཅིན་ ཚིག་ཡིག་ས་སྒོ་འདི་ བཙུགཔ་ཨིནམ་དང་ འོས་ལྡན་ཁ་ཡིག་ས་སྒོ་དང་གཅིག་ཁར་ སྡེ་ཚན་བཟོ་ཡོདཔ་ཨིན། ཚིག་ཡིག་ས་སྒོ་ནང་ལུ་ འབྲི་ཤོག་ལུ་དགོ་པའི་གནད་སྡུད་གཞི་རྟེན་གྱི་བརྡ་དོན་འདི་ ཧེ་མ་ལས་འདི་ནང་ཡོདཔ་ཨིན། 				2002-02-02 02:02:02
