helpcontent2	source\text\shared\01\05070400.xhp	0	help	par_id3154613				0	dz	\<ahelp hid=\".uno:AlignTop\"\>སེལ་འཐུ་འབད་ཡོད་པའི་དངོཅས་པོ་ཚུ་གི་མགོའི་མཐའམ་ཚུ་  ཐད་སྙོམས་སྦེ་ཕྲངམ་ཨིན།  འབྲི་ནི་ཡང་ན་ཨིམ་པེརེསི་ནང་ལུ་  དངོས་པོ་གཅིག་རྐྱངམ་ཅིག་སེལ་འཐུ་འབད་དེ་ཡོད་པ་ཅིན་  དངོས་པོ་གི་མགོའི་མཐའམ་འདི་མགོའི་ཤོག་ལེབ་ས་སྟོང་ལུ་ཕྲང་སྒྲིག་འབད་དེ་ཡོད། \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05070400.xhp	0	help	par_id3154230				0	dz	སེལ་འཐུ་གི་ནང་ལུ་  དངོས་པོ་ཚུ་མགོའིདངོས་པོ་གི་མཐའམ་ལུ་ ཕྲང་སྒྲིག་འབད་དེ་ཡོད།\<embedvar href=\"text/shared/01/05070100.xhp#mehrfachselektion\"/\>				2002-02-02 02:02:02
