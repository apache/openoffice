helpcontent2	source\text\shared\02\06060000.xhp	0	help	par_id3149999				0	dz	\<ahelp hid=\".uno:IncrementLevel\"\>ཨང་བཏགས་ནི་ ཡང་ན་ འགོ་ཚག་གི་སྡེ་རིམ་ནང་ལུ་  སེལ་འཐུ་གྲུབ་ཡོད་པའི་དོན་མཚམས་འདི་  གནས་རིམ་ཅིག་  ཡར་འགྱོཝ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\06060000.xhp	0	help	par_id3149205	4			0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>The\<emph\> གནས་རིམ་གཅིག་ཡར་བསྐྱེད་\</emph\>ངོས་དཔར་འདི་ \<emph\>འགོ་ཚག་དང་ཨང་བཏགས་ནི་\</emph\> ཕྲ་རིང་གུ་ཡོདཔ་ཨིན་,དེ་ཡང་འོད་རྟགས་འདི་ཨང་བཏགས་ནི་ཡང་ན་འགོ་ཚག་གུ་བཀལཝ་ད་བྱུང་མི་འདི་ཨིན། \</caseinline\>\<caseinline select=\"IMPRESS\"\>The\<emph\> ཡར་བསྐྱེད་ \</emph\>ངོས་དཔར་འདི་ \<emph\>ཚིག་ཡིག་རྩ་སྒྲིག་\</emph\> ཕྲ་རིང་གུ་ཡོདཔ་ཨིན་, དེ་ཡང་ མཐའ་ཐིག་མཐོང་སྣང་ནང་ལཱ་འབདཝ་ད་བྱུངམ་ཨིན། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
