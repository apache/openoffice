helpcontent2	source\text\shared\02\12000000.xhp	0	help	par_id3145345				0	dz	གནད་སྡུད་ འབྱུང་ཁུངས་དཔྱད་ཞིབ་འབད་མི་གི་ནང་ན་  ཁྱོད་ཀྱི་གནད་སྡུད་གཞི་རྟེན་འདི་ཚུ་  ཁོང་རའི་འབྲེལ་ལམ་དང་འདྲི་དཔྱད་  དེ་ལས་  ཐིག་ཁྲམ་ཚུ་དང་གཅིག་ཁར་   $[officename] ནང་ཐོ་བཀོད་འབད་ཡོད་མི་  ཚུ་མཐོང་ཚུགས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12000000.xhp	0	help	par_id3159233				0	dz	\<emph\>མཐུད་ལམ་གཞི་བཙུགས་འབད་དོ།\</emph\> -ཁྱོད་ཀྱི་ངོ་་རྐྱང་གྱི་ཐིག་ཁྲམ་དང་  ཡང་ན་  འདྲི་དཔྱད་ཅིག་ སེལ་འཐུ་འབད་ཚརཝ་ཅིག་  གནད་སྡུད་འབྱུང་ཁུངས་ལུ་  མཐུད་ལམ་འདི་  གཞི་བཙུགས་འབད་ཡོད།  ཚར་གཅིག་མཐུད་ལམ་འདི་  ཁ་ཕྱེ་ཚར་ཞིནམ་ལས་  གནད་སྡུད་འབྱུང་ཁུངས་ཀྱི་མིང་དང་  འདྲི་དཔྱད་ ཡང་ན ཐིག་ཐོ་བཀོད་  དེ་ལས་འདྲི་དཔྱད་ཀྱི་མིང་  ཡང་ན་ སེལ་འཐུ་འབད་ཡོད་པའི་ཐིག་ཁྲམ་འདི་ཚུ་  རྒྱགས་པའི་དབྱེ་བ་ནང་  སྟོན་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12000000.xhp	0	help	par_id3151379				0	dz	\<ahelp hid=\".\" visibility=\"hidden\"\>ཐོ་བཀོད་བསྐྱར་མིང་བཏགས་ནི་ལུ་ ཨ་ནི་བརྡ་བཀོད་འདི་བོད་བརྡ་འབད་ཞིནམ་དང་མིང་གསརཔ་བཙུགས། ཁྱོད་ཀྱིས་ཡང་ཨ་ནི་འདི་སེལ་འཐུ་འབད་ཐོག་ལས་དང་ཨེཕ་༢་ཨེབ་ཐོག་ལས་འབད་ཚུགས། གནད་སྡུད་གཞི་རྟེན་འདི་གིས་བསྐྱར་མིང་བཏགས་ནི་འདི་ངེས་པར་རྒྱབ་སྐྱོར་འབད་དགོ་ དེ་མིན་པ་ཅིན་ཨ་ནི་བརྡ་བཀོད་འདི་ལྕོགས་ཅན་མི་བཟོ། \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12000000.xhp	0	help	par_id273445				0	dz	\<ahelp hid=\".\" visibility=\"hidden\"\>ཞུན་དག་འབད་ནིའི་དོན་ལུ་སེལ་འཐུ་འབད་ཡོད་པའི་གནད་སྡུད་གཞི་རྟེན་ཡིག་སྣོད་ཁ་ཕྱེཝ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12000000.xhp	0	help	par_id5943479				0	dz	\<ahelp hid=\".\" visibility=\"hidden\"\>ཐོ་བཀོད་ཡོད་པའི་གནད་སྡུད་གཞི་རྟེན་ཚུ་གི་ཐོ་ཡིག་ལས་གནད་སྡུད་གཞི་རྟེན་ཡིག་སྣོད་ཁ་སྐོང་/ཞུན་དག་/རྩ་བསྐྲད་གཏང་ནི་ལུ་ཌའི་ལོག་ཁ་ཕྱེཝ་ཨིན། \<emph\>ལག་ཆས་ཚུ་ - གདམ་ཁ་ཚུ་ - %PRODUCTNAME གཞི་རྟེན་ - གནད་སྡུད་གཞི་རྟེན་ཚུ་གདམ་ཁ་རྐྱབ་ཐོག་ལས་ཌའི་ལོག་གཅིག་པ་ཁ་ཕྱེཝ་ཨིན།\</emph\>.\</ahelp\>				2002-02-02 02:02:02
