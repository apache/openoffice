helpcontent2	source\text\shared\02\01170000.xhp	0	help	par_id3151312				0	dz	\<ahelp hid=\".uno:DateField\"\>ས་སྒོའི་ཚེས་གྲངས་འདི་གསར་བསྐྲུན་འབདཝ་ཨིན། \</ahelp\> རྣམ་པ་འདི་གནད་སྡུད་གཞི་རྟེན་ལུ་  འབྲེལ་དེ་ཡོད་པ་ཅིན་  ཚེས་གྲངས་གནད་གོང་འདི་  གནད་སྡུད་གཞི་རྟེན་ལས་སྟོན་བཏུབ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170000.xhp	0	help	par_id3151302				0	dz	ཁྱོད་ཀྱིས་  གནད་སྡུད་ས་སྒོ་ལུ་  "Dropdown"འདི་འགན་སྤྲོད་འབད་བ་ཅིན་  ལག་ལེན་པ་གིས་  གནད་སྡུད་ས་སྒོའི་འོག་ལུ་  གནད་སྡུད་ཅིག་སེལ་འཐུ་འབད་ནི་དོན་ལུ་  ཟླ་ཐོ་ཅིག་ཁ་ཕྱེཝ་ཨིན།  དེ་གིས་  ཐིག་ཁྲམ་ཚད་འཛིན་ས་སྒོ་ཅིག་གི་ནང་འཁོད་ལུ་ཡང་  འཇུག་སྤྱོད་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170000.xhp	0	help	par_id3154395				0	dz	ཚེས་གྲངས་སྒོ་འདི་ཚུ་  ལག་ལེན་པ་འདི་གིས་ ཡར་གྱི་མདའ་རྟགས་དང་མཡ་གྱི་མདའ་རྟགས་ཀྱི་ལྡེ་མིག་དང་བཅས་ འཇམ་ཏོོང་ཏོ་སྦེ་ཞུན་དག་འབད་བཏུབ།   འོད་རྟགས་ཀྱི་གནས་ས་དང་བསྟུན་  ཉིམ་དང་ ཟླཝ་ཡང་ན་ལོ་འདི་ཚུ་ ཡར་འཕར་འབད་བཏུབ་  ཡང་ན་མདའ་རྟགས་ཀྱི་ལྡེ་མིག་འདི་ལག་ལེན་འཐབ་ཐོག་ལས་  མར་འཕབ་ཡང་འགྱོ་བཏུབ་ཨིན།				2002-02-02 02:02:02
