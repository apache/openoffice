helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3147167	2			0	dz	\<variable id=\"fussnoteein\"\>\<ahelp hid=\".uno:InsertFootnote\"\>དེ་གིས་  ཡིག་ཆའི་ནང་མཇུག་གི་མཇུག་གི་དྲན་ཐོ་ཡང་ན་མཐའི་དྲན་འཛིན་ཅིག་བཙུགསཔ་ཨིན།   དྲན་འཛིན་འདི་གི་དོན་ལུ་  ཨེན་ཀོར་འདི་ད་ལྟོའི་འོད་རྟགས་གནས་ས་ལུ་བཙུགས་ཏེ་ཡོད།\</ahelp\> ཁྱོད་ཀྱིས་  རང་བཞིན་གྱི་ཨང་བཏགས་བཀལ་ནི་ཡང་ན་  སྲོལ་སྒྲིག་བརྡ་མཚོན་ཅིག་གི་བར་ན་གདམ་ཁ་བརྐྱབ་ཚུགས། \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3154645	23			0	dz	\<variable id=\"endnoten\"\>འོག་ལུ་ཡོད་མི་དེ་གས་  མཇུག་གི་དྲན་ཐོ་དང་མཐའི་དྲན་འཛིན་གཉིས་ཆ་རང་ལུ་མཇུག་སྤྱོད་འབདཝ་ཨིན། \</variable\>				2002-02-02 02:02:02
