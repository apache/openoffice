helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id3163710				0	dz	\<variable id=\"bedingtetext\"\>\<ahelp hid=\".uno:ConditionalFormatDialog\"\> གནས་སྟངས་ལ་ལོ་ཅིག་ལུ་བརྟེན་ཏེ་ \<emph\> རྩ་སྒྲིག་བཟོ་རྣམ་ \</emph\> ཚུ་ངེས་འཛིན་འབད་ནིའི་དོན་ལུ་རགས་ལས་པའི་རྩ་སྒྲིག་འབད་ནི་འདི་གདམ། \</ahelp\>\</variable\> ནང་ཐིག་གཅིག་ལུ་ བཟོ་རྣམ་གཅིག་ཧེ་མ་ལས་རང་འགན་སྤྲོད་དེ་ཡོད་པ་ཅིན་ འདི་བསྒྱུར་བཅོས་མེདཔ་སྦེ་ལུསཔ་ཨིན། དེ་ལས་འབདན་ ནཱ་ལུ་བཙུགས་ཡོད་པའི་ བཟོ་རྣམ་འདི་ བརྟག་ཞིབ་འབད་ནི་ཨིན། ཁྱོད་ཀྱིས་ ནང་ཐིག་གནས་གོང་ཚུའམ་མན་ངག་གི་ནང་དོན་ཚུ་འདྲི་དཔྱད་འབད་བའི་ གནས་སྟངས་གསུམ་བཙུགས་ཚུགསཔ་ཨིན། གནས་སྟངས་ཚུ་ ༡ ལས་ ༣ ཚུན་ཞིབ་བརྟག་འབད་ཡོདཔ་ཨིན། གནས་སྟངས་ ༡ གིས་ གནས་སྟངས་འདྲ་མཚུངས་པ་ཅིན་ ངེས་འཛིན་འབད་ཡོད་པའི་བཟོ་རྣམ་འདི་ལག་ལེན་འཐབ་ནི་ཨིན། དེ་མེན་པ་ཅིན་ གནས་སྟངས་ ༢ འདི་ བརྟག་ཞིབ་འབད་དེ་ དེའི་ངེས་འཛིན་འབད་ཡོད་པའི་བཟོ་རྣམ་འདི་ལག་ལེན་འཐབ་ནི་ཨིན། སྟེ་ འ་ནི་ བཟོ་རྣམ་འདི་ འདྲ་མ་མཚུངས་པ་ཅིན་ གནས་སྟངས་ ༣ འདི་བརྟག་ཞིབ་འབད་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\05120000.xhp	0	help	par_id2414014				0	dz	གནས་སྟངས་ཅན་གྱི་རྩ་སྒྲིག་འབད་ནི་འཇུག་སྤྱོད་འབད་ནིའི་དོན་ལས་  རང་བཞིན་རྩིས་སྟོན་འདི་ལྕོགས་ཅན་བཟོ་དགོ།  ལག་ཆས་ - ནང་ཐིག་ནང་དོན་  རང་བཞིན་རྩིས་སྟོན་ (རང་བཞིན་རྩིས་སྟོན་འདི་ལྕོགས་ཅན་བཟོ་ཡོད་པའི་སྐབས་ ཁྱོད་ཀྱིས་དཔྱད་རྟགས་ཅིག་ བརྡ་བརྐོད་ཀྱི་ཤུལ་མ་མཐོང་ཚུགས་) གདམ་ཁ་རྐྱབས།				2002-02-02 02:02:02
