helpcontent2	source\text\shared\01\05280000.xhp	0	help	par_id3151097				0	dz	\<ahelp hid=\".uno:FontWork\"\>སྔོན་མའི་ཡིག་གཞུགས་ཀྱི་ལཱ་གི་ཌའི་ལོག་དང་བཅས་  གསར་བསྐྲུན་འབད་ཡོད་པའི་  སེལ་འདུ་འབད་ཡོད་པའི་དངོས་པོ་གི་  ཡིག་གཟུགས་ལཱ་གི་ནུས་པ་ཚུ་ཞུན་དག་འབདཝ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05280000.xhp	0	help	par_id3155934				0	dz	This \<emph\>Fontwork\</emph\>  %PRODUCTNAME %PRODUCTVERSION  གི་གོང་ལུ་འབད་གསར་བསྐྲུན་འབད་ཡོད་པའི་  རྩོམ་འབྲི་པ་བརྙིངམ་གྱི་ཚིག་ཡིག་ཡིག་ཆ་ནང་གི་  ཡིགགཟུགས་ལཱ་གི་དོན་ལུ་  ཌའི་ལོག་འདི་འཐོབ་ཚུགས་ཡོད། ཌའི་ལོག་འདི་ཁ་ཕྱེ་ནི་དོན་ལུ་  དཀར་ཆག་བརྡ་བཀོད་ཅིག་ཁ་སྐོང་བརྐྱབ་ནི་ལུ་     ཁྱོད་ཀྱིས་ \<emph\>ལག་ཆས་ཚུ་ - སྲོལ་སྒྲིག་\</emph\> འབོ་དགོཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05280000.xhp	0	help	par_id3154497				0	dz	སྒོར་སྒོརམ་ཕྱེད་དང་གཞུ་དབྱིབས་  དེ་ལས་  སྒོར་ཐིག་ཚུ་དང་བར་སྟོང་རྣམ་པའི་གྲལ་ཐིག་ཚུ་ལུ་མཐུན་སྒྲིག་འབད་ནི་དོན་ལུ་   ཁྱོད་ཀྱིས་  ཚིག་ཡིག་གཞི་རྟེན་གྱི་དབྱིབས་འདི་བསྒྱུར་བཅོས་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05280000.xhp	0	help	hd_id3152372				0	dz	ཕྲང་སྒྲིག་འབད་ཡོད་པའི་ངོས་དཔར་ཚུ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05280000.xhp	0	help	par_id3149760				0	dz	\<ahelp hid=\"HID_FONTWORK_CTL_FORMS\" visibility=\"hidden\"\>ཚིག་ཡིག་དོན་ལུ་ཁྱོད་ཀྱིས་ལག་ལེན་འཐབ་ནི་ཨིན་པའི་ གཞི་རྟེན་གྱི་དབྱིབས་འདི་ཨེབ་གཏང་འབད། \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05280000.xhp	0	help	par_id3152542				0	dz	མགོའི་གྲལ་ཐིག་དེ་གིས་  འོག་གི་གཞི་རྟེན་དབྱིབས་ཚུ་ཡོད་: \<emph\>ལྟག་གི་སྒོར་ཐིག་ཕྱེད་\</emph\>, \<emph\>འོག་གི་སྒོར་ཐིག་ཕྱེད་\</emph\>, \<emph\>གཡོན་གྱི་སྒོར་ཐིག་ཕྱེད་\</emph\> དང་  \<emph\>གཡས་ཀྱི་སྒོར་ཐིག་ཕྱེད།\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05280000.xhp	0	help	par_id3150774				0	dz	བར་ན་གི་གྲལ་ཐིག་གིས་ འོག་གི་གཞི་རྟེན་དབྱིབས་ཚུ་ཡོད་: \<emph\>ལྟག་གི་གཞུ་དབྱིབས་\</emph\>, \<emph\>འོག་གི་གཞུ་དབྱིབས་ གཡོན་གྱི་གཞུ་དབྱིབས་\</emph\> དང་ \<emph\>གཡས་ཀྱི་གཞུ་དབྱིབས།\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05280000.xhp	0	help	par_id3159158				0	dz	མཇུག་གི་གྲལ་ཐིག་དེ་གིས་  འོག་གི་གཞི་རྟེན་གྲལ་ཐིག་གི་དབྱིབས་ཚུ་ཡོད་: \<emph\>སྒོར་ཐི་གཚུ་ཁ་ཕྱེ་, སྒོར་ཐིག་ཚུ་ཁ་བསྡམས་, སྒོར་ཐི་གཚུ་ཁ་བསྡམས་ II\</emph\>, དང་ \<emph\>སྒོར་ཐིག་ཀེར་ཕྲང་འདི་ཁ་ཕྱེ།\</emph\>. འགྲུབ་འབྲས་བཟང་པོའི་དོན་ལུ་ པར་རིས་དངོས་པོ་དེ་གིས་  ཚིག་ཡིག་གི་གྲལ་ཐིག་གཉིས་ལས་ལྷག་སྟེ་འོང་དགོཔ་ཨིན།				2002-02-02 02:02:02
