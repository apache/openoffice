helpcontent2	source\text\shared\explorer\database\05030100.xhp	0	help	par_id3153252				0	dz	\<ahelp hid=\"DBACCESS_RADIOBUTTON_TAB_WIZ_COPYTABLE_RB_APPENDDATA\"\>གནད་སྡུད་འདི་མཉམ་སྦྲགས་འབད་མ་བཏུབ་པ་ཅིན་  གནད་སྡུད་འདྲ་བཤུས་རྐྱབས་མ་བཏུབ་པའི་ \<emph\>ཀེར་ཐིག་གི་བརྡ་དོན་\</emph\> ཌའི་ལོག་ནང་ ས་སྒོ་གི་ཐོ་ཡིག་ཅིག་ཁྱོད་ཀྱིས་མཐོངམ་ཨིན།  \</ahelp\> ཁྱོད་ཀྱིས་འ་ནི་ཌའི་ལོག་འདི་ བཏུབ་དང་ བཅས་་ངེས་དཔྱདའབད་བ་ཅིན་  ཐོ་བཀོད་ནང་མ་འབྱུང་མི་གནད་སྡུད་རྐྱངམ་ཅིག་མཉམ་སྦྲགས་སྦེ་འོངམ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\05030100.xhp	0	help	par_id3158430				0	dz	གནད་སྡུད་འདི་མཉམ་སྦྲགས་འབདཝ་ད་ འབྱུང་ཁུངས་ཐིག་ཁྲམ་ལས་   དམིགས་གཏད་ཐིག་ཁྲམ་གྱི་ས་སྒོ་ལུ་ ས་སྒོའི་རིང་ཚད་ཆུང་ཀུ་ཨིན་པ་ཅིན་  དམིགས་གཏད་ནང་གི་ས་སྒོའི་རིང་ཚད་མཐུན་སྒྲིག་འབད་ནི་ལུ་  འབྱུང་ཁུངས་གནད་སྡུད་ས་སྒོ་ཚུ་ རང་བཞིན་གྱིས་ ཆུང་ཀུ་བཟོཝ་ཨིན།  				2002-02-02 02:02:02
