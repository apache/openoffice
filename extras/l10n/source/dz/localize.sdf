helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3146946				0	dz	\<variable id=\"druckentext\"\>\<ahelp hid=\".uno:Print\"\>གིས་  ཁྱོད་ཀྱིས་གསལ་བཀོད་འབད་ཡོད་པའི་  ད་ལྟོའི་ཡིག་ཆ་དང་  སེལ་འཐུ་ཡང་ན་  ཤོག་ལེབ་འདི་ཚུ་དཔར་བསྐྲུན་འབདཝ་ཨིན།  ད་ལྟོའི་ཡིག་ཆའི་དོན་ལུ་  ཁྱོད་ཀྱིས་  དཔར་བསྐྲུན་གྱི་གདམ་ཁ་ཚུ་གཞི་སྒྲིག་འབད་བཏུབ།   \</ahelp\>\</variable\> དཔར་བསྐྲུན་འབད་བའི་གདམ་ཁ་ཚུ་གིས་  དཔར་འཕྲུལ་དང་  ཁྱོད་ཀྱིས་ལག་ལེན་འཐབ་པའི་  བཀོལ་སྤྱོདཔ་རིམ་ལུགས་དང་འཁྲིལ་ཏེ་  འགྱུར་བ་འགྱོཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_id3156080				0	dz	  \<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>To set the default \<item type=\"productname\"\>%PRODUCTNAME\</item\> ཚིག་ཡིག་ཡིག་ཆ་ཚུ་གི་དོན་ལུ་  སྔོན་སྒྲིག་གཞི་སྒྲིག་འབད་ན་དོན་ལུ་  \<link href=\"text/shared/optionen/01040400.xhp\" name=\"Tools - Options - Writer - Print\"\>\<emph\>ལག་ཆས་ཚུ་ - གདམ་ཁ་ཚུ་ - %PRODUCTNAME རྩོམ་འབྲི་པ་ - དཔར་བསྐྲུན་འབད་\</emph\>\</link\>གདམ་ཁ་བརྐྱབ།\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_idN1099E				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>To set the default \<item type=\"productname\"\>%PRODUCTNAME\</item\>ཤོག་ཁྲམ་ཡིག་ཆ་ཚུ་གི་དོན་ལུ་  སྔོན་སྒྲིག་དཔར་འཕྲུལ་གདམ་ཁ་ཚུ་གཞི་སྒྲིག་འབད་ནི་དོན་ལུ་   \<link href=\"text/shared/optionen/01060700.xhp\" name=\"Tools - Options - Calc - Print\"\>\<emph\>ལག་ཆས་ཚུ་ - གདམ་ཁ་ཚུ་ - %PRODUCTNAME Calc - དཔར་བསྐྲུན་འབད་\</emph\>\</link\>གདམ་ཁ་བརྐྱབ། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01130000.xhp	0	help	par_idN109CD				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"IMPRESS\"\>To set the default \<item type=\"productname\"\>%PRODUCTNAME\</item\>གསལ་སྟོན་ཡིག་ཆ་ཚུ་གི་དོན་ལུ་  སྔོན་སྒྲིག་དཔར་འཕྲུལ་གདམ་ཁ་ཚུ་གཞི་འབད་ནི་ལུ་  \<link href=\"text/shared/optionen/01070400.xhp\" name=\"Tools - Options - Impress - Print\"\>\<emph\>ལག་ཆས་ཚུ་ - གདམ་ཁ་ཚུ་ - %PRODUCTNAME ཨིམ་པེརེསི་ - དཔར་བསྐྲུན་འབད་\</emph\>\</link\>གདམ་ཁ་བརྐྱབ།\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
