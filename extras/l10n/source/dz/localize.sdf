helpcontent2	source\text\swriter\01\02110000.xhp	0	help	par_id3154028	32			0	dz	\<ahelp hid=\".\" visibility=\"hidden\"\>ཡིག་ཆའི་ནང་གི་རྣམ་གྲངས་ཤུལ་མམ་ལུ་མཆོངམ་ཨིན། མཆོང་ནའི་དོན་ལས་རྣམ་གྲངས་ཀྱི་དབྱེ་བ་གསལ་བཀོད་འབད་ནིའི་དོན་ལུ་ \<link href=\"text/swriter/01/02110100.xhp\" name=\"Navigation\"\>\<emph\>Navigation\</emph\>\</link\>ངོས་དཔར་དེ་ལུ་ཨེབ་གཏང་འབད་ཞིནམ་ལས་ དེ་ལས་ རྣམ་གྲངས་ཀྱི་དབྱེ་རིམ་དེ་ལུ་ཨེབ་གཏང་འབད། དཔེ་འབད་བ་ཅིན་"Graphics".\</ahelp\> དེ་གིས་ ཡིག་ནང་གི་རྣམ་གྲངས་ཤུལ་མམ་ལུ་མཆོངསམ་ཨིན། མཆོང་ནིའི་དོན་ལུ་རྣམ་གྲངས་ཀྱི་དབྱེ་བ་གསལ་བཀོད་འབད་ནིའི་དོན་ལུ་ \<link href=\"text/swriter/01/02110100.xhp\" name=\"Navigation\"\>Navigation\</link\>ངོས་དཔར་དེ་ལུ་ཨེབ་གཏང་འབད་ཞིནམ་ལས་ དེ་ལས་ རྣམ་གྲངས་ཀྱི་དབྱེ་རིམ་དེ་ལུ་ཨེབ་གཏང་འབད། དཔེ་འབད་བ་ཅིན་"Graphics".				2002-02-02 02:02:02
