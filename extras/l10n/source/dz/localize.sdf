helpcontent2	source\text\shared\01\03110000.xhp	0	help	par_id3148983				0	dz	\<ahelp hid=\".uno:FullScreen\"\>རྩོམ་འབྲི་པ་ཡང་ན་ཀེལཀི་ནང་ལུ་ དཀར་ཆག་ཚུ་དང་ལག་ཆས་ཕྲ་རིང་ཚུ་ སྟོན་ཡང་ན་སྦ་བཞགཔ་ཨིན།  གསལ་གཞི་གངམ་གི་ཐབས་ལམ་འདི་ཕྱིར་བཏོན་འབད་ནིའི་དོན་ལས་   \<emph\>གསལ་གཞི་གངམ་ ཨཱོན་/ཨོཕ་\</emph\> ཨེབ་རྟ་འདི་ཨེབ་གཏང་།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\03110000.xhp	0	help	par_id3152594				0	dz	\<ahelp hid=\"HID_FULLSCREENTOOLBOX\"\>རྩོས་འབྲི་པ་དང་ཀེལཀི་ནང་ལུ་ ཁྱོད་ཀྱིས་ མགྱོགས་ཐབས་ལྡེ་མིག་ \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>བརྡ་བཀོད་ \</caseinline\>\<defaultinline\>ཚད་འཛིན་\</defaultinline\>\</switchinline\>+སོར་ལྡེ་+J འདི་ སྤྱིར་བཏང་དང་གསལ་གཞི་གངམ་གི་ཐབས་ལམ་གྱི་བར་ན་ སོར་བསྒྱུར་འབད་ནིའི་དོན་ལས་ཡང་ལག་ལེན་འཐབ་བཏུབ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\03110000.xhp	0	help	par_id3154318	28			0	dz	དཀར་ཆག་ཚུ་འཐོབ་ཚུགས་མེད་རུང་  ཁྱོད་ཀྱིས་  \<emph\>གསལ་གཞི་ཧྲིལ་བུ་\</emph\>ཐབས་ལམ་ནང་ལུ་  མགྱོགས་ཐབས་ལྡེ་མིག་འདི་ལག་ལེན་འཐབ་བཏུབ་ཨིན། \<switchinline select=\"sys\"\>\<caseinline select=\"WIN\"\>\<emph\> སྟོན་\</emph\> དཀར་ཆག་འདི་ཁ་ཕྱེ་ནི་དོན་ལུ་  གདམ་ལྡེ་+ཝི་འདི་ཨེབ་གཏང་།\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
