helpcontent2	source\text\smath\01\06020000.xhp	0	help	par_id3153916	3			0	dz	 \<emph\>Insert\</emph\> གི་ཌའི་ལོག་དེ་  \<link href=\"text/shared/01/01020000.xhp\" name=\"Open\"\>བཟུམ་སྦེ་གཞི་སྒྲིག་འབད་ཡོད། \</link\> ཌའི་ལོག་དེ་  \<emph\>ཡིག་སྣོད་\</emph\>གི་འོག་ལུ་ཁ་ཕྱེ། \<emph\>བརྡ་བཀོད་ཀྱི་\</emph\>སྒོ་སྒྲིག་ནང་ལུ་ཡིག་སྣོད་བཟུམ་སྦེ་སྲུང་བཞག་འབད་ཡོད་མི་མན་ངག་ཅིག་ མངོན་གསལ་འབད་ནི་ ཞུན་དག་འབད་ནི་ དང་བཀྲམ་སྟོན་འབད་ནིའི་དོན་ལས་ ཌའི་ལོག་ \<emph\>བཙུགས་ཡོད་མི་\</emph\> དེ་ལག་ལེན་འཐབ།				2002-02-02 02:02:02
