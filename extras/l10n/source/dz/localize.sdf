helpcontent2	source\text\shared\explorer\database\02010100.xhp	0	help	par_id3148799				0	dz	ཁྱོད་ཀྱིས་འདྲི་དཔྱད་འདི་  གསར་བསྐྲུན་འབད་ནིའི་དོན་ལས་  ཁྱོད་ཀྱིས་འདྲི་དཔྱད་བཀོད་སྒྲིག་འདི་གོ་དང་པ་ཁ་ཕྱེཝ་ད་  ཁྱོད་ཀྱིས་   \<link href=\"text/shared/02/14020100.xhp\" name=\"Add Tables\"\>\<emph\>ཐིག་ཁྲམ་ཚུ་ཁ་སྐོང་རྐྱབས་\</emph\>\</link\>ཨེབ་གཏང་།  དེ་ལས་ཁྱོད་ཀྱིས་ འདྲི་དཔྱད་ཀྱི་དོན་ལུ་ ཁྱོད་ཀྱིས་དང་པ་རང་ གཞི་རྩ་འབད་བཏུབ་པའི་ ཐིག་ཁྲམ་འདི་སེལ་འཐུ་འབད་དགོཔ་ནང་ཌའི་ལོག་མཐོངམ་ཨིན། 				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\02010100.xhp	0	help	par_id3144762				0	dz	\<ahelp hid=\"HID_CTL_QRYDGNTAB\"\> དེ་ཚུ་འདྲི་དཔྱད་ལུ་ཁ་སྐོང་རྐྱབས་ནིའི་དོན་ལས་  ས་སྒོ་ཚུ་ལུ་གཡེབ་གཏང་ཐེང་གཉིས་ཨེབ་གཏང་།  མཐུན་འབྲེལ་ཚུ་ངེས་འཛིན་འབད་ནི་ལུ་ འདྲུད་བཞིནམ་ལས་མར་བཞག \</ahelp\>				2002-02-02 02:02:02
