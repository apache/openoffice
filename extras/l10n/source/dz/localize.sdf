helpcontent2	source\text\swriter\01\02110000.xhp	0	help	par_id3148999				0	dz	\<ahelp hid=\"HID_NAVIGATOR_LISTBOX\"\>དེ་གིས་ ཁ་ཕྱེ་སྟེ་ཡོད་མི་ཚིག་ཡིག་ ཡིག་ཆ་ཚུ་ཆ་མཉམ་ཐོ་འགོད་འབདཝ་ཨིན། ཡིག་ཆ་ཅིག་གི་ནང་དོན་དེ་འགྲུལ་བསྐྱོདཔ་སྒོ་སྒྲིག་ནང་ལུ་སྟོན་ནིའི་དོན་ལུ་ ཡིག་ཆའི་མིང་དེ་ཐོ་ཡིག་ནང་ལུ་སེལ་འཐུ་འབད། འགྲུལ་བསྐྱོདཔ་ནང་ལུ་ད་ལྟོ་བཀྲམ་སྟོན་འབད་ཡོད་མི་ཡིག་ཆ་འདི་མིང་ཚིག་ "active"་གིས་ཐོ་ཡིག་ནང་ལུ་་ཁོ་རའི་མིང་གི་ཤུལ་ལས་བརྡ་སྟོནམ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
