helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3150449				0	dz	\<ahelp hid=\"HID_PROP_FILTER_CRITERIA\"\>འབྲི་ཤོག་ནང་གནས་སྡུད་ཚག་མ་དོན་ལུ་དགོས་མཁོ་ཡོད་པའི་གནས་སྟངས་ཚུ་བཙུགས། ཚག་མ་གསལ་བཀོད་ཚུ་དབྱེ་དོན་ག་ཏེ་འདི་ལག་ལེན་མ་འཐབ་པར་ཨེསི་ཀིའུ་ཨེལ་ལམ་ལུགས་ཚུ་རྗེས་སུ་འབྲངམ་ཨིན། \</ahelp\> དཔེར་ན་ཁྱོད་ཀྱིས་དྲན་ཐོ་ཚུ་་ཆ་མཉམ་ "Mike" སྔོན་མིང་དང་གཅིག་ཁར་བཀྲམ་བཏོན་འབད་ནི་ཨིན་པ་ཅིན་ གནས་སྡུད་ས་སྒོ་འདི་ནང་ཡིག་དཔར་རྐྱབས: སྔོན་མིང་ = 'Mike'།  གནས་སྟངས་ཚུ་ཡང་མཉམ་མཐུད་འབད་བཏུབ་ཨིན་: སྔོན་མིང་ = 'Mike' ཡང་ན་སྔོན་མིང་ = 'Peter'། དེ་གཉིས་་དང་མཐུན་སྒྲིག་འབད་མི་དྲན་ཐོ་ཆ་མཉམ་གནས་སྟངས་ཚུ་ག་འབད་རུང་བཀྲམ་བཏོན་འབད་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170203.xhp	0	help	par_id3156212				0	dz	ཚག་མ་ལས་འགན་འདི་ལག་ལེན་པ་ཐབས་ལམ་ནང་ \<link href=\"text/shared/02/12030000.xhp\" name=\"AutoFilter\"\>\<emph\>རང་བཞིན་ཚག་མ་\</emph\>\</link\> དང་ \<link href=\"text/shared/02/12090000.xhp\" name=\"Default Filter\"\>\<emph\>སྔོན་སྒྲིག་ཚག་མ་\</emph\>\</link\> ངོས་དཔར་ \<link href=\"text/shared/main0213.xhp\" name=\"Form Navigation Bar\"\>\<emph\>འགྲུལ་བསྐྱོད་པ་ཕྲ་རིང་ལས་འགན་འགྲུབ་\</emph\> ཕྲ་རིང་གུ་ཡོད་མི་འདི་་བརྒྱུད་དེ་འཐོབ་ཚུགསཔ་ཨིན།\</link\>				2002-02-02 02:02:02
