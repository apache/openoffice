helpcontent2	source\text\sbasic\shared\03102101.xhp	0	help	par_id3155601				0	dz	$[officename] གཞི་རིམ་ནང་་ཁྱོད་ཀྱིས་འགྱུར་ཅན་ཚུ་བསམ་པའི་སྒོ་ལས་གསལ་བསྒྲགས་འབད་མི་དགོ། ག་དེམ་ཅི་འབད་ ཁྱོད་ཀྱིས་ཨེ་རེ་ཧེ་མ་གསལ་བསྒྲགས་འབད་དགོ་པ་ཅིན་ དེ་ཚུ་ལག་ལེན་འཐབ་བཏུབ། ཁྱོད་ཀྱིས་འགྱུར་ཅན་གཅིག་ཁར་ཌི་ཨའི་ཨེམ་གསལ་བཤད་ སྣ་མང་གསལ་བསྒྲགས་ཚུ་སོ་སོ་ཁ་དབྱེ་ནི་ལུ་ལྷོད་རྟགས་ལག་ལེན་འཐབ་དེ་གསལ་བསྒྲགས་འབད་བཏུབ་ཨིན། འགྱུར་ཅན་དབྱེ་བ་གསལ་བསྒྲགས་འབད་ནི་ལུ་ དབྱེ་བ་གསལབསྒྲགས་ཡིག་འབྲུ་མིང་རྗེས་སུ་གྲངས་མི་བཙུགས་ཡང་ན་ཆ་མཉམ་པའི་གཙོ་ཚིག་ཅིག་ལག་ལེན་འཐབ།				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03102101.xhp	0	help	par_id3153415				0	dz	$[officename] གཞི་རིམ་གྱིས་ གསལ་བཀོད་འབད་ཡོད་མི་འགྱུར་ཅན་དབྱེ་བ་གིས་ངེས་འཛིན་འབད་ཡོད་མི་་རྐྱང་པ་ཡང་ན་་མཚོན་གྲངས་ཀྱི་སྣ་མངཨེ་རེ་ཚུ་རྒྱབ་སྐྱོར་འབདཝ་ཨིན། ཨེ་རེ་ཚུ་ལས་རིམ་དེ་ནང་ན་ཐོ་ཡིག་ཚུ་ཡང་ན་ཐིག་ཁྲམ་ཁྱོད་ཀྱིས་ཞུན་དག་འབད་ནི་ཨིན་མི་ཡོད་པ་ཅིན་འོས་འབབ་ཡོདཔ་ཨིན། ཨེ་རེ་ཚུ་གི་ཕན་པ་དེ་ཟུར་ཐོ་དང་འཁྲིལ་ཆ་ཤས་ཚི་ངོ་རྐྱང་ཁ་བྱང་བཏགས་ནི་ལུ་ཚུགསཔ་ དེ་ཡང་ཨང་གྲངས་ཀྱི་གསལ་བརྗོད་ཚུ་ཡང་ན་འགྱུར་ཅན་ཚུ་སྦེ་རྩ་སྒྲིག་འབད་བཏུབ་ཨིན།				2002-02-02 02:02:02
