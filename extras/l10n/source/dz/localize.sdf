helpcontent2	source\text\shared\explorer\database\02000002.xhp	0	help	par_id3150247	2			0	dz	འདྲི་དཔྱད་ནང་ལུ་ཐིག་ཁྲམ་ཡང་ན་ ས་སྒོ་གནས་དེ་མེད་མི་འདི་ཁ་ཕྱེ་སྟེ་ཡོད་པ་ཅིན་  \<emph\>ཆ་ཤས་བརླག་སྟོར་ཞུགས་ཡོད་མི་ \</emph\>ཌའི་ལོག་འདི་འབྱུངམ་་ཨིན།  ཌའི་ལོག་དེ་གིས་ བརླག་སྟོར་ཞུགས་ཡོད་པའི་ཐིག་ཁྲམ་ ཡང་ན་  ཁ་སྒྱུར་འབད་མ་ཚུགས་པའི་ ས་སྒོའི་མིང་བཏགསཔ་ཨིནམ་དང་ བྱ་སྒོའི་ལམ་ལུགས་དང་ཅིག་ཁར་   ག་དེ་སྦེ་འཕྲོ་མཐུད་ནི་ཨིན་ན་  ཁྱོད་ལུ་གྲོས་ཐག་བཅད་བཅུགཔ་ཨིན།				2002-02-02 02:02:02
