helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3146962				0	dz	 \<emph\>བརྡ་བཀོད་ཀྱི་\</emph\> སྒོ་སྒྲིག་ནང་ལུ་དཔེར་བརྗོད་མན་ངག་ཚུ་ཡིག་དཔར་རྐྱབས་པའི་སྐབས་ ངེས་བདེན་གཞི་བཀོད་ཀྱི་དོན་ལུ་བར་སྟོང་ཚུ་འཕྲལ་འཕྲལ་དགོཔ་ཨིནམ་དྲན་དགོ				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3149054				0	dz	གུག་ཤད་ "{}" ཚུ་གསལ་བརྗོད་ཚུ་གཅིག་ཁར་སྡེ་ཚན་བཟོ་ཞིནམ་ལས་ གསལ་བརྗོད་གསརཔ་ཅིག་འབྱུང་ནིའི་དོན་ལས་ལག་ལེན་འཐབ་ཡོདཔ་ཨིན། དཔེར་ན་  "sqrt {x * y}" འདི་ ཐོན་སྐྱེད་ x*y ཧྲིལ་བུའི་ རང་བསྒྱུར་རྩ་གྲངས་ཨིན་ དེ་འབདཝ་ད་  "sqrt x * y" འདི་  x  y གིས་དགུ་མཐའ་རྐྱབས་ཡོད་པའི་རང་བསྒྱུར་རྩ་གྲངས་ཨིན། གུག་ཤད་ཚུ་ལུ་བར་སྟོང་ཐེབས་ག་ནི་ཡང་མི་དགོཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3147403				0	dz	འདི་ནང་ལུ་འཐོབ་ཚུགས་པའི་གུག་ཤད་ཚུའི་དབྱེ་བ་སོ་སོ་བསྡོམས་བརྒྱད་(༨)ཡོདཔ་ཨིན།  "ceil" དང་ "floor"  གུག་ཤད་ཚུ་འཕྲལ་འཕྲལ་ཧྲིལ་ཨང་ཤུལ་མམ་འདི་གི་དོན་ལས་སྒྲུབ་རྟགས་འདི་ཡར་ཡང་ན་མར་ཧྲིལ་གྲངས་བཟོ་ནིའི་དོན་ལུ་ལགལེན་འཐབ་ཡོད་: "lceil -3.7 rceil = -3" ཡང་ན་ "lfloor -3.7 rfloor = -4"				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3146320				0	dz	བཀོལ་སྤྱོད་པའི་གུག་ཤད་ བི་རེ་-ཀེཊིསི་ཟེར་ཡང་སླབ་མི་(ཀེར་ཐིག་གྲལ་ཐིག་བར་ན་ཡོད་མི་གྲུ་ཟུར་གུག་ཤད་) ཚུ་ཕི་སིགསི་གི་དབྱངས་རྟགས་ནང་ཡོདཔ་ཨིན་:  "langle a mline b rangle" ཡང་ན་ "langle a mline b mline c over d mline e rangle." ཀེར་ཐིག་གྲལ་ཐིག་ཚུའི་མཐོ་ཚད་དང་གནས་ས་བཟོ་ནི་ཚུ་ཨ་རྟག་རང་ མཉམ་སྦྲགས་འབད་ནིའི་གུག་ཤད་ཚུ་འི་ཏག་ཏག་ཆ་མཉམ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3157870				0	dz	གུག་ཤད་ཚུ་ཆ་མཉམ་ཟུང་སྦེ་རྐྱངམ་ཅིག་ལག་ལེན་འཐབ་བཏུབ་འོང་། གུག་ཤད་ཚུ་ལུ་མཐུན་མོང་གི་ཆ་འདྲ་བ་ཚུ་ཡོད་:				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3155761				0	dz	གུག་ཤད་ཚུ་ཆ་མཉམ་ལུ་ "{}"\<emph\>-\</emph\> གུག་ཤད་ཚུ་གི་དོན་ལུ་འགྲེལ་བཤད་རྐྱབས་ཡོད་དོ་བཟུམ་སྦེ་ སྡེ་ཚན་བཟོ་ནིའི་ལས་འགན་གཅིག་པ་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3145590				0	dz	གུག་ཤད་ཀྱི་དབྱེ་བ་ཆ་མཉམ་གྱིས་ མཐོང་ཚུགས་མི་ཚུ་གྲངས་སུ་བཙུགས་ཏེ་ སྡེ་ཚན་གྱི་ངེས་ཚིག་སྟོངམ་གནང་བ་བྱིནམ་ཨིན། དེ་འབདཝ་ལས་མཉམ་སྦྲགས་འབད་ཡོད་པའི་གསལ་བརྗོད་འདི་སྟོངམ་འོང་།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3154562				0	dz	གུག་ཤད་ཚུ་གིས་ཁོང་རའི་ཚད་འདི་ མཉམ་སྦྲགས་འབད་ཡོད་པའི་གསལ་བརྗོད་ལུ་བདེ་སྒྲིག་མི་འབད། དཔེར་ན་ ཁྱོད་ལུ "( a over b )" འདི་ གུག་ཤད་ཀྱི་ཚད་འདི་  a དང་ b ལུ་བདེ་སྒྲིག་འབད་ཡོད་མི་དང་གཅིག་ཁར་དགོ་ནི་ཨིན་པ་ཅིན་ ཁྱོད་ཀྱིས་ "left" དང་ "right" བཙུགས་དགོཔ་ཨིན། "left(a over b right)" འདི་ཐོ་བཀོད་འབདཝ་ད་ འོས་ལྡན་ཚད་བཟོ་ནི་བྱིནམ་ཨིན། གང་ལྟར་ཡང་ ག་དེམ་ཅིག་སྦེ་གུག་ཤད་ཚུ་ཁོང་ར་ བསྒྱུར་བཅོས་འབད་ཡོད་པའི་གསལ་བརྗོད་ཀྱི་ཡན་ལག་ཨིན་པ་ཅིན་ འདི་ཚུ་ཚད་བསྒྱུར་བཅོས་ཀྱི་གྲངས་སུ་བཙུགས་ཡོད་ཨིན་:  "size 3(a over b)" དང་ "size 12(a over b)"  གུག་ཤད་-ལས་-གུག་ཤད་ལུ་གསལ་བརྗོད་དཔྱ་ཚད་ཀྱི་ཚད་བཟོ་ནི་འདི་ ག་དེ་སྦེ་ཡང་བསྒྱུར་བཅོས་མི་འགྱོ།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3153002				0	dz	"left" དང་ "right" གིས་མཐུན་མོང་མ་ཡིན་པའི་འགན་ལས་ངེས་ཏིག་འབདཝ་ཨིནམ་ལས་  གཡས་ཀྱི་གུག་ཤད་ཚུ་གཡོན་ཁ་ཐུག་ ཡང་ན་གཡོན་གྱི་གུག་ཤད་ཚུ་གཡས་ཁ་ཐུག་བཞག་འདི་འབད་ས་ཅིག་རུང་ གུག་ཤད་རྐྱང་པ་རེ་རེ་བཞིན་ འ་ནི་བརྡ་བཀོད་གཉིས་ཀྱི་དོན་ལུ་སྒྲུབ་རྟགས་ཅིག་སྦེ་ལག་ལེན་འཐབ་བཏུབ། གུག་ཤད་ཀྱི་ཚབ་ལུ་ ཁྱོད་ཀྱིས་ "none" ཁྱད་ཆོས་ཚང་མི་འདི་ལག་ལེན་འཐབ་བཏུབ་ འདི་གི་དོན་དག་འདི་ དེ་ནང་ལུ་གུག་གཅིག་ཡང་མ་སྟོནམ་དང་གུག་ཤད་ཀྱི་དོན་ལུ་ཟུར་གསོག་འབད་ཡོད་པའི་བར་སྟོང་མེད་ཟེར་སྟོནམ་ཨིན།				2002-02-02 02:02:02
