helpcontent2	source\text\swriter\01\04020100.xhp	0	help	par_id3154343				0	dz	\<ahelp hid=\"SW:EDIT:MD_EDIT_REGION:ED_CONDITION\"\>དབྱེ་ཚན་དེ་སྦ་བཞག་ནིའི་དོན་ལུ་ ཚང་དགོ་པའི་གནས་སྟངས་ཚུ་བཙུགས།\</ahelp\> གནས་སྟངས་འདི་\<link href=\"text/swriter/01/04090200.xhp\" name=\"logical expression\"\>གཏན་ཚིག་ཅན་གྱི་གསལ་བརྗོད་\</link\>བཟུམ་ཨིན། དཔེ་འབད་བ་ཅིན་ ཁྱོད་ཀྱིས་ "Salutation" that contains "Mr.", "Ms.", or "Sir or Madam"གནས་སྡུད་གཞི་རྟེན་ གཅིག་ངོས་འཛིན་འབད་ནི་ལུ་  ཡི་གུའི་ཁྱད་རྣམ་ལས་  \<link href=\"text/swriter/guide/form_letters_main.xhp\" name=\"mail merge\"\>ཡིག་འཕྲིན་མཉམ་བསྡོམས་འབད་ནི་\</link\>ལག་ལེན་འཐབ་པ་ཅིན་  གུས་བཏུད་འདི་"Mr."ཟེར་ཡོད་པ་ཅིན་རྐྱངམ་ཅིག་  དབྱེ་ཚན་འདི་དེ་ལས་རྐྱངམ་ཅིག་དཔར་བསྐྲུན་འབད་ནི་ཨིན་ཟེར་  ཁྱོད་ཀྱིས་གསལ་བཀོད་འབད་བཏུབ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04020100.xhp	0	help	par_id3150086				0	dz	དཔེ་གཉིས་པམ་དེ་ ས་སྒོ་བསྒྱུར་ཅན་"x" གསར་བསྐྲུན་འབད་ནི་དང་ དེའི་གནས་གོང་དོ་ ༡ ལུ་གཞི་སྒྲིག་འབད་ནི་དེ་ཨིན། དེ་ལས་"x eq 1"བཟུམ་མའི་དབྱེ་ཚན་དེ་སྦ་བཞག་ནིའི་དོན་ལུ་ བསྒྱུར་ཅན་འདི་ལུ་གཞི་བཞག་སྟེ་གནས་སྟངས་ཅིག་གསལ་བཀོད་འབད། ཁྱིས་ཀྱིས་དབྱེ་ཚན་དེ་བཀྲམ་སྟོན་འབད་ནི་ཨིན་པ་ཅིན་ བསྒྱུར་ཅན་གྱི་གནས་གོང་"x"དེ་"0"ལུ་གཞི་སྒྲིག་འབད།				2002-02-02 02:02:02
