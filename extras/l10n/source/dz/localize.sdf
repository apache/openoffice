helpcontent2	source\text\simpress\01\06100100.xhp	0	help	par_id3156449				0	dz	\<ahelp visibility=\"visible\" hid=\"SD_PUSHBUTTON_DLG_DEFINE_CUSTOMSHOW_BTN_ADD\"\>སེལ་འཐུ་འབད་ཡོད་པའི་བཤུད་ཚུའི་ \<emph\>ཐོ་ཡིག་གི་གཤམ་ལུ་ཡོད་བཞིན་པའི་བཤུད་ཁ་སྐོང་འབདཝ་ཨིན།་\</emph\>ཁྱོད་ཀྱིས་ཨེབ་རྟ་འདི་ལག་ལེན་འཐབ་ཚུགས་པའི་ཧེ་མ་ \<emph\>ཡོད་བཞིན་པའི་བཤུད་ཚུའི་་\</emph\> ཐོ་ཡིག་འདི་ནང་ཁྱོད་ཀྱིས་བཤུད་སེལ་འཐུ་འབད་དགོ།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\simpress\01\06100100.xhp	0	help	par_id3151240	5			0	dz	\<ahelp visibility=\"visible\" hid=\"SD_PUSHBUTTON_DLG_DEFINE_CUSTOMSHOW_BTN_REMOVE\"\>སེལ་འཐུ་འབད་ཡོད་པའི་བཤུད་ཀྱི་\<emph\>ཐོ་ཡིག་འདི་ལས་\</emph\>བཤུད་རྩ་བསྐྲད་གཏངམ་ཨིན། ཁྱོད་ཀྱིས་ཨེབ་རྟ་འདི་ལག་ལེན་འཐབ་མ་ཚུགས་པའི་ཧེ་མ་ \<emph\>སེལ་འཐུ་འབད་ཡོད་པའི་བཤུད་ཚུ་གི་ཐོ་ཡིག་ནང་་ \</emph\>ཁྱོད་ཀྱིས་བཤུད་གདམ་ཁ་རྐྱབ་དགོ\</ahelp\>				2002-02-02 02:02:02
