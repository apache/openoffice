helpcontent2	source\text\shared\01\06140100.xhp	0	help	par_idN1091C				0	dz	\<ahelp hid=\"705498948\"\>ཁྱོད་ཀྱིས་དཀར་ཆག་འདི་ཁ་སྐོང་བརྐྱབ་མི་གཞན་གྱིས་སྤྱོད་ཚུགས་པའི་ ཡང་ན་  འཇུག་སྤྱོད་འདི་སེལ་འཐུ་འབད།  \</ahelp\> དཀར་ཆག་རིམ་སྒྲིག་འདི་  ཁྱོད་ཀྱིས་སེལ་འཐུ་འབད་ཡོད་པའི་རྣམ་གྲངས་དོན་ལུ་སྲུངམ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06140100.xhp	0	help	par_idN10AFB				0	dz	ཐོ་ཡིག་ནང་གི་རྣམ་གྲངས་དང་བཅས་འབྲེལ་བའི་རིམ་སྒྲིག་དཀར་ཆག་ཅིག་ ཞུན་དག་འབད་ནི་ལུ་  རྣམ་གྲངས་འདི་སེལ་འཐུ་འབད་ནི་དང་  ཁྱོད་ཀྱིས་དགོ་པའི་བསྒྱུར་བཅོས་འདི་བཟོ་ནི་དང་  དེ་ལས་  \<emph\>བཏུབ་\</emph\>ཨེབ་རྟ་ལུ་ཨེབ་གཏང་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06140100.xhp	0	help	par_idN10922				0	dz	ཁྱོད་ཀྱིས་  དཀར་ཆག་རིམ་སྒྲིག་འདི་ གནས་ཁོངས་ཅིག་ལུ་མངོན་གསལ་འབད་ནི་དང་  རིམ་སྒྲིག་འདི་གནས་ཁོངས་གཞན་མི་ཅིག་ལུ་སྲུང་ནི་འདི་མི་བཏུབ།				2002-02-02 02:02:02
