helpcontent2	source\text\shared\optionen\01030300.xhp	0	help	par_idN10659				0	dz	\<ahelp hid=\"703988741\"\>ཁྱོད་ཀྱིས་ཡིག་ཆ་ནང་དྲན་ཐོ་བཀོད་ཡོད་པའི་བསྒྱུར་བཅོས་ཚུ་ ཐོན་རིམ་ཚུ་ ས་སྒོ་ཚུ་ གཞན་འབྱུང་ཁུངས་ཚུ་གི་གཞི་བསྟུན་ཚུ་(དཔེར་ན་ འབྲེལ་མཐུད་འབད་ཡོད་པའི་དབྱེ་ཚན་ཚུ་ ཡང་ན་ འབྲེལ་མཐུད་འབད་ཡོད་པའི་པར་ཚུ་) ཡང་ན་ དྲན་ཐོ་ཚུ་མིང་རྟགས་བཀོད་ནི་ལུ་འབད་རྩོལ་བསྐྱེད་པའི་སྐབས་ཉེན་བརྡའི་ཌའི་ལོག་མཐོང་ནི་ལུ་སེལ་འཐུ་འབད།\</ahelp\>				2002-02-02 02:02:02
