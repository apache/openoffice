helpcontent2	source\text\swriter\02\18030400.xhp	0	help	par_id3148772				0	dz	\<ahelp hid=\".uno:InsertPageCountField\"\>ཡིག་ཆ་ནང་ ཤོག་ལེབ་ཚུ་གི་བསྡོམས་གྲངས་དེ་  ས་སྒོ་བཟུམ་ཅིག་སྦེ་བཙུགསཔ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\18030400.xhp	0	help	par_id3149294				0	dz	ཁྱོད་ར་ ཨང་བཏགས་ཀྱི་བཟོ་རྣམ་སོ་སོ་དང་བཅས་ རྩ་སྒྲིག་འབད་ཡོད་པའི་ ཤོག་ལེབ་ཀྱི་ཨང་གྲངས་དེ་ དགོ་ནིའི་ རེ་འདོད་ཡོད་པ་ཅིན་  དགོས་མཁོ་ཡོད་པའི་  ས་སྒོ་ཚུ་བཙུགས་ནི་ལུ་ དང་\<emph\> ས་སྒོའི་ཌའི་ལོག་ནང་ \</emph\> སྒྲིག་སྟངས་ཚུ་ \<link href=\"text/swriter/01/04090000.xhp\" name=\"Field\"\>\<emph\>གསལ་བཀོད་\</emph\>\</link\> འབད་ནི་ལུ་  བཙུགས་ནིའི་-ས་སྒོ་-གཞན་ཚུ་གདམ་ཁ་རྐྱབ།  ཤོག་ལེབ་ཨང་གྲངས་ཀྱི་བརྡ་བཀོད་དེ་ \<emph\>ལག་ལེན་འཐབ་ཐོག་ལས་ \</emph\> བཙུགས་ཡོད་པའི་ས་སྒོའི་རྩ་སྒྲིག་དེ་ཡང་  ཞུན་དག་ས་སྒོ་གི་བརྡ་བཀོད་དེ་ \<link href=\"text/swriter/01/02140000.xhp\" name=\"Edit - Field\"\>\<emph\>  ལག་ལེན་འཐབ་སྟེ་  ལེགས་བཅོས་འབད་བཏུབ་ཨིན།\</emph\>\</link\>				2002-02-02 02:02:02
