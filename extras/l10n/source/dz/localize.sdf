helpcontent2	source\text\shared\optionen\01041000.xhp	0	help	par_idN10837				0	dz	ཡིག་འབྲུ་ཡང་ན་དོན་མཚམས་ལུ་ཨེན་ཀོར་འབད་ཡོད་མི་འཕུར་ལྡིང་དངོས་པོ་ཚུ་བཞག་ནི་གི་གོ་དཀའ་བའི་ཁས་ལེན་འབད་བཏུབ་པའི་ལས་སྦྱོར་འདི་ག་དེེ་འབད་ལཱ་འབད་དགོཔ་ཨིན་ན་གསལ་བཀོད་འབདཝ་ཨིན།  མའི་ཀོརོ་སོཕཊི་ཝརཌི་ནང་ལས་སྦྱོར་གཅིག་པ་ལུ་ཆ་འདྲ་བ་ཨིན་མི་ %PRODUCTNAME %PRODUCTVERSION ནང་ཕྲང་ཕྲངམ་གདོང་བསྐྱོད་ལས་སྦྱོར་ལག་ལེན་འཐབ་པའི་སྐབས་ ཐོན་རིམ་ %PRODUCTVERSION ལུ་ %PRODUCTNAME གཙོ་རིམ་ནང་ ཁས་ལེན་འབད་བཏུབ་པའི་ལས་སྦཡོར་ལག་ལེན་འཐབ་ནུག།				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01041000.xhp	0	help	par_idN10943				0	dz	གདམ་ཁ་འདི་ཨོཕ་ཨིན་པ་ཅིན་ དངོས་པོ་བཞག་ནི་གི་%PRODUCTNAME ཁས་ལེན་འབད་བཏུབ་མི་ལས་སྦྱོར་ལག་ལེན་འཐབ་ཨིན། གདམ་ཁ་འདི་ཨོན་ཨིན་པ་ཅིན་ མའི་ཀོརོ་སོཕཊི་ཝརཌི་ཡིག་ཆ་ཚུ་དང་གཅིག་ཁར་མཐུན་འགྱུར་ངེས་གཏན་བཟོ་ནི་ལུ་ཕྲང་ཕྲངམ་གདོང་བསྐྱོད་འདི་ལག་ལེན་འཐབ་ཨིན།				2002-02-02 02:02:02
