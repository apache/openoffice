helpcontent2	source\text\simpress\02\10030000.xhp	0	help	par_id3154258				0	dz	\<ahelp hid=\".uno:InteractiveTransparence\"\>སེལ་འཐུ་འབད་ཡོད་པའི་དངོས་པོ་ལུ་དྭངས་གསལ་སྟེགས་རིས་འཇུག་སྤྱོད་འབདཝ་ཨིན།\</ahelp\>  ༡༠༠% དྭངས་གསལ་ལུ་བཤེད་བཟུང་དཀརཔོ་དང་ ༠% དྭངས་གསལ་ལུ་བཤེད་བཟུང་གནགཔོ་ཆ་མཉམ་འབད་ནི་དང་གཅིག་ཁར་དྭངས་གསལ་གྲལ་ཐིག་འདི་གིས་གེརེ་སིཀེལ་སྦེ་ཁྱད་ཚབ་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\simpress\02\10030000.xhp	0	help	par_id3147516				0	dz	དྭངས་གསལ་སྟེགས་རིས་ཀྱི་ཁ་ཕྱོགས་བསྒྱུར་བཅོས་འབད་ནི་ལུ་བཤེད་བཟུང་དཀརཔོ་འདྲུད། སྟེགས་རིས་ཀྱི་རིང་ཚད་བསྒྱུར་བཅོས་འབད་ནི་ལུ་བཤེད་བཟུང་གནགཔོ་འདྲུད། ཁྱོད་ཀྱིས་ཡང་དེ་ཚུའི་གེརེ་སིཀེལ་གནས་གོང་ཚུ་བསྒྱུར་བཅོས་འབད་ནི་ལུ་  \<emph\>ཚོས་གཞི་ཕྲ་རིང་ལས་\</emph\>བཤེད་བཟུང་གུ་ལུ་འདྲུད་ནི་དང་ཚོས་གཞི་ཚུ་བཀོག་བཞག་ཚུགས།				2002-02-02 02:02:02
