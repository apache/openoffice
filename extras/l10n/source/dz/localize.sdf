helpcontent2	source\text\shared\main0213.xhp	0	help	par_id3154751				0	dz	\<emph\>འབྲི་ཤོག་འགྲུལ་བསྐྱོད་\</emph\>ཕྲ་རིང་ནང་ གནད་སྡུད་གཞི་རྟེན་གྱི་ཐིག་ཁྲམ་ཅིག་ཞུན་དག་འབད་ནི་དང་ ཡང་ན་ གནད་སྡུད་ཀྱི་མཐོང་སྣང་ཚད་འཛིན་འབད་ནིའི་དོན་ལུ་ ངོས་པར་ཚུ་ཡོདཔ་ཨིན། ཕྲ་རིང་འདི་གནད་སྡུད་གཞི་རྟེན་ལུ་འབྲེལ་མཐུད་འབད་དེ་ཡོད་མི་ས་སྒོ་ཚུ་ཡོདཔ་ཨིན་པའི་ཡིག་ཆ་་ཅིག་གི་མཇུག་ལུ་ བཀྲམ་སྟོན་འབད་དེ་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\main0213.xhp	0	help	par_id3157958				0	dz	ཁྱོད་ཀྱིས་ དྲན་ཐོ་ནང་འཁོད་ལུ་སྤོ་ནི་དང་ དེ་ལས་གཞན་བཙུགས་ནི་དང་དྲན་ཐོ་ཚུ་བཏོན་བཀོག་ནིའི་དོན་ལུ་  \<emph\>འགྲུལ་བསྐྱོད་རྣམ་པ་\</emph\> ཕྲ་རིང་ལག་ལེན་འཐབ་བཏུབ། གནད་སྡུད་འདི་འབྲི་ཤོག་ཅིག་ནང་སྲུང་སྟེ་ཡོད་པ་ཅིན་ བསྒྱུར་བཅོས་ཚུ་གནད་སྡུད་གཞི་རྟེན་ནང་གནས་སོར་གཏངམ་ཨིན། \<emph\>འགྲུལ་བསྐྱོད་རྣམ་པ་\</emph\>ཕྲ་རིང་ནང་ལུ་ གནད་སྡུད་དྲན་ཐོའི་དོན་ལུ་ དབྱེ་སེལ་དང་ཚགས་མ་དེ་ལས་ འཚོལ་ཞིབ་ལས་འགན་ཚུ་ཡང་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\main0213.xhp	0	help	par_idN10717				0	dz	ཁྱོད་ཀྱིས་ འབྲི་ཤོག་ཅིག་ལུ་འགྲུལ་བསྐྱོད་ཕྲ་རིང་ཁ་སྐོང་འབད་ནིའི་དོན་ལས་ \<link href=\"text/shared/02/01170000.xhp\"\>ཚད་འཛིན་ལེ་ཤ་ \</link\> ཕྲ་རིང་གུ་ འགྲུལ་བསྐྱོད་ཕྲ་རིང་གི་ངོས་པར་ལག་ལེན་འཐབ་ཚུགས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\main0213.xhp	0	help	par_id3157910				0	dz	འགྲུལ་བསྐྱོད་ཕྲ་རིང་འདི་ གནད་སྡུད་གཞི་རྟེན་ཅིག་ལུ་འབྲེལ་མཐུད་འབད་ཡོད་པའི་འབྲི་ཤོག་གི་དོན་ལུ་རྐྱངམ་ཅིག་མཐོང་ཚུགས།  \<link href=\"text/shared/explorer/database/04030000.xhp\" name=\"Design view\"\>བཀོད་སྒྲིག་མཐོང་སྣང་\</link\>འབྲི་ཤོག་གི་ནང་ན་ འགྲུལ་བསྐྱོད་ཕྲ་རིང་འཐོབ་མི་ཚུགས། དེ་མ་ཚད་ \<link href=\"text/shared/main0212.xhp\" name=\"Database Bar\"\>ཐིག་ཁྲམ་གནད་སྡུད་ཕྲ་རིང་\</link\>ལུ་ཡང་བལྟ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\main0213.xhp	0	help	par_id3153880				0	dz	ཁྱོད་ཀྱིས་ དབྱེ་སེལ་དང་ལས་འགན་ཚུ་བཙགས་པའི་ཐོག་ལས་ གནད་སྡུད་མཐོང་སྣང་ཚད་འཛིན་འབད་ཚུགས། ཐིག་ཁྲམ་ངོ་མ་ཚུ་བསྒྱུར་བཅོས་མ་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\main0213.xhp	0	help	par_id3153062				0	dz	ད་ལྟོའི་དབྱེ་སེལ་གོ་རིམ་ ཡང་ན་ ཚགས་མ་འདི་ ད་ལྟོའི་ཡིག་ཆ་དང་བཅས་སྲུངས་ཡི། ཚགས་མ་འདི་སྲུང་ཡོད་པ་ཅིན་  \<emph\>ཚགས་མ་འཇུག་སྤྱོད་འབད་\</emph\> གུ་ལུ་ \<emph\>འགྲུལ་བསྐྱོད་\</emph\> ཕྲ་རིང་འདི་ཤུགས་ལྡན་བཟོ་འོང་། ཡིག་ཆ་ནང་དབྱེ་སེལ་དང་བཙགས་ནིའི་ཁྱད་རྣམ་ཚུ་ \<emph\>རྒྱུ་དངོས་རྣམ་པ་ཚུ་\</emph\>ཌའི་ལོག་ནང་ལུ་ཡང་རིམ་སྒྲིག་འབད་ཚུགས། ( \<emph\>རྒྱུ་དངོས་རྣམ་པ་ - གནད་སྡུད་\</emph\> - རྒྱུ་དངོས་ཚུ་ \<link href=\"text/shared/02/01170203.xhp\" name=\"Sort\"\>\<emph\>Sort\</emph\>\</link\> དང་ \<link href=\"text/shared/02/01170203.xhp\" name=\"Filter\"\>\<emph\>ཚགས་མ་\</emph\>\</link\> གདམས་)།				2002-02-02 02:02:02
