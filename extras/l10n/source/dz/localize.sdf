helpcontent2	source\text\smath\01\03090300.xhp	0	help	par_id3153518				0	dz	\<ahelp hid=\"HID_SMA_FROMXTOY\"\>ཁྱབ་ཚད་ཀྱི་གསལ་བཤད་ \<emph\>ཡར་དང་མར་གྱི་ཚད་\</emph\> ས་གནས་འཛིན་མི་གཅིག་དང་ཅིག་ཁར་ མེད་ཐབས་མེདཔ་དང་ཕྱོགས་བསྡོམས་ཀྱི་དོན་ལུ་བཙུགསཔ་ཨིན། \</ahelp\> ཁྱོད་ཀྱིས་\<emph\>འདི་ {<?>} ལས་ {<?>} <?>\</emph\> ལུ་ཐད་ཀར་དུ་ \<emph\>བརྡ་བཀོད་ཚུའི་\</emph\> སྒོ་སྒྲིག་ནང་ལུ་ཡང་ཡིག་དཔར་རྐྱབས་ཚུགས། ཚད་ཀྱི་གསལ་བཤད་འདི་འོས་ལྡན་བཀོལ་སྤྱོད་པ་ཚུ་དང་ཅིག་ཁར་མཉམ་མཐུད་འབད་འབདཝ་ཨིན་དགོ ཚད་འདི་ཚུ་ ཕྱོགས་བསྡོམས་ཡིག་འབྲུའི་མགོ་/མཇུག་ལུ་དབུས་སྒྲིག་འབད་འོང་།				2002-02-02 02:02:02
