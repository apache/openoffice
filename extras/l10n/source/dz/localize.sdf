helpcontent2	source\text\shared\02\14030000.xhp	0	help	par_id3155535				0	dz	སྤྱིར་བཏང་ཐབས་ལམ་ལུ་སླར་ལོག་ནི་གི་དོན་ལུ་ དོ་རུང་ངོས་པར་གུ་ཨེབ་གཏང་འབད་ དེ་ནང་ \<link href=\"text/shared/explorer/database/02010100.xhp\" name=\"New Query Design\"\>འདྲི་དཔྱད་བཀོད་སྒྲིག་གསརཔ་\</link\>བསྒྱུར་བཅོས་འབད་ཡོད་མི་ཚུ་ ཨེསི་ཀིའུ་ཨེལ་ལས་བརྒྱུད་དེ་གནང་བའི་བསྒྱུར་བཅོས་ཚུ་དང་གཅིག་ཁར་ མཉམ་འབྱུང་འབད་ནུག				2002-02-02 02:02:02
