helpcontent2	source\text\shared\02\01140000.xhp	0	help	par_id3150771				0	dz	ཁྱོད་ལུ་ད་ལྟོའི་ཡིག་ཆ་ནང་ལུ་ དངོས་པོ་ཚུ་སེལ་འཐུ་འབད་བཅུགཔ་ཨིན། དངོས་པོ་ཅིག་སེལ་འཐུ་འབད་ནིའི་དོན་ལུ་  དངོས་པོ་འདི་མདའ་རྟགསམ་དང་བཅས་ཨེབ་གཏང་འབད། དངོས་པོ་གཅིག་བ་ཡང་ལྷགཔ་སྦེ་སེལ་འཐུ་འབད་ནི་དོན་ལུ་  སེལ་འཐུ་གི་གཞི་ཁྲམ་འདི་ དངོས་པོ་ཚུ་བསྐོར་ར་རྐྱབ་སྟེ་འདྲུད་། དངོས་པོ་ཅིག་སེལ་འཐུ་འདི་ལུ་ ཁ་སྐོངས་རྐྱབ་ནིའི་དོན་ལུ་ སོར་ལྡེ་འདི་མནན་བཞིནམ་ལས་ དངོས་པོ་འདི་ལུ་ ཨེབ་གཏང་འབད།				2002-02-02 02:02:02
