helpcontent2	source\text\shared\explorer\database\05010000.xhp	0	help	par_id3150398				0	dz	\<ahelp hid=\"SID_TABLEDESIGN_TABED_PRIMARYKEY\"\> འ་ནི་བརྡ་བཀོད་དེ་ལུ་ ཞིབ་དཔྱད་ཀྱི་ཨང་རྟགས་ཡོད་པ་ཅིན་  གྲལ་ཐིག་དེ་ནང་ཡོད་པའི་གནད་སྡུད་སསྒོ་འདི་  གཞི་རིམ་གྱི་གཙོ་བོ་ཨིན།   \</ahelp\>བརྡ་བཀོད་ལུ་ཨེབ་གཏང་བཞིནམ་ལས་ ཁྱོད་རང་  གནས་ཚད་འདི་ཤུགས་ལྡན་བཟོ་ནི/ཡང་ན་ ཤུགས་མེད་བཟོ།  གནད་སྡུད་འབྱུང་ཁུངས་དེ་གིས་ གཞི་རིམ་གཙོ་བོ་འདི་རྒྱབ་སྐྱོར་འབད་བ་ཅིན་རྐྱངམ་ཅིག་  བརྡ་བཀོད་འདི་མཐོང་ཚུགས།				2002-02-02 02:02:02
