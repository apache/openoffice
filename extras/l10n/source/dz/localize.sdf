helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3150358				0	dz	\<emph\>གྱངས་ཁ་རྐྱབས་མི་:\</emph\> འཕྲལ་བཀོལ་གྱངས་ཁ་རྐྱབས་འགོ་ཐོག་བསྒང་དེ་རྟགས་འདྲ་མཉམ་(འགོ་བཙུགས)གྱི་གཡས་ཕྱོགས་ལུ་གནས་གོང་དེ་འགན་སྤྲོད་ཡོདཔ་ཨིན། ཨང་གྲངས་ཀཡི་འགྱུར་ཅན་ཚུ་རྐྱངམ་ཅིག་ནུས་ཅན་ཨིན། འཕྲལ་བཀོལ་གྱངས་ཁ་རྐྱབས་མི་དེ་གིས་་ཡར་འཕར་ཡང་ན་མར་འབབ་དེ་འགྱུར་ཅན་གྱི་རིམ་པ་མཇུག་ལུ་རྩིས་སྤྲོད་ཚུན་ཚོད་འཁྲིལ་ཏེ་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3152455				0	dz	\<emph\>འགོ་བཙུགས་:\</emph\> ཨང་གྲངས་ཀྱི་འགྱུར་ཅན་དེ་འཕྲལ་བཀོལ་གྱི་འགོ་བཙུགསཔ་ད་ལུ་འགོ་ཐོག་གནས་གོང་དེ་ངེས་འཛིན་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3151043				0	dz	\<emph\>མཇུག་:\</emph\> ཨང་གྲངས་ཀྱི་འགྱུར་ཅན་དེ་འཕྲལ་བཀོལ་གྱི་མཇུག་ལུ་མཐའ་མཇུག་གནས་གོང་དེ་ངེས་འཛིན་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3156281				0	dz	\<emph\>རིམ་པ་:\</emph\> གནས་གོང་དེ་འཕྲལ་བཀོལ་གདོང་ལན་ག་ཡར་འཕར་ཡང་ན་མར་ཕབ་འབད་ནི་ཨིན་ན་གཞི་སྒྲིག་འབདཝ་ཨིན། རིམ་པ་དེ་གསལ་བཀོད་མ་འབད་བ་ཅིན་ འཕྲལ་བཀོལ་གདོང་ལན་དེ་ ༡ གི་འབད་ཡར་འཕར་འབད་ཡོདཔ་ཨིན། གནད་དོན་དེ་ནང་ མཇུག་དེ་འགོ་བཙུགསཔ་དེ་ལས་སྦོམ་མི་དགོཔ་ཨིན། ཁྱོད་ཀྱིས་གདོང་ལན་མར་ཕབ་འབད་ནི་ཨིན་པ་ཅིན་ མཇུག་བསྡུ་དེ་འགོ་བཙུགས་ལས་ཉུང་མི་དང་ རིམ་པ་དེ་མེད་ཆ་གནས་གོང་ཅིག་འགན་སྤྲོད་དགོཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3154684				0	dz	\<emph\>དོན་ལུ་...ཤུལ་མ་\</emph\> འཕྲལ་བཀོལ་གྱིས་ཚད་བཟུང་གིས་གསལ་བཀོད་འབད་ཡོད་མི་དུས་ཚོད་ཚུའི་ཨང་དོན་ལུ་འཕྲལ་བཀོལ་ནང་གསལ་བཤད་ཚུ་བསྐྱར་ལོག་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3147287				0	dz	གདོང་ལན་འགྱུར་ཅན་དེ་མར་ཕབ་ཡོདཔ་ད་$[officename] གཞི་རིམ་གྱིས་མཇུག་བསྡུ་གནས་གོང་དེ་ལྷོད་པ་ཅིན་བརྟག་ཞིབ་འབདཝ་ཨིན། གདོང་ལན་དེ་་མཇུག་བསྡུ་གནས་གོང་་ལུ་རྩིས་སྤྲོདཔ་ཅིན་འཕྲལ་བཀོལ་རང་བཞིན་གྱིས་མཇུག་བསྡུཝ་ཨིན། 				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3159154				0	dz	དོན་ལུ་ ...ཤུལ་མ་ \<emph\>གསལ་བཤད་ཚུ་\</emph\> ནེསིཊི་ལུ་ཚུགསཔ་ཨིན།  ཁྱོད་ཀྱིས་འགྱུར་ཅན་འོག་ལུ་ཡོད་མི་\<emph\>ཤུལ་མ་\</emph\> གསལ་བཤད་ \<emph\>ཤེལ་མམ་དེ་\</emph\> རང་བཞིན་གྱིས་ད་ལྟོའི་མང་ཤོས་ \<emph\>གསལ་བཤད་\</emph\> དོན་ལུ་འབྲེལ་བ་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3155306				0	dz	ཁྱོད་ཀྱིས་ ༠ གི་ཡར་འཕར་ ཅིག་ གསལ་བཤད་ཚུ་  \<emph\>དོན་ལུ་\</emph\> དང་ \<emph\>ཤུལ་མ་\</emph\> བར་ན་འཕྲོ་མཐུད་བསྐྱར་ལོག་ཡོདཔ་ཆ་མཉམ་གསལ་བཀོད།				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3155854				0	dz	གདོང་ལན་འགྱུར་ཅན་དེ་གྱངས་ཁ་རྐྱབས་པའི་སྐབས་$[officename] གཞི་རིམ་གྱིས་ལུད་སོང་མི་ཡང་ན་ལུད་ནི་ཨིན་མི་དོན་ལུ་བརྟག་ཞིབ་འབདཝ་ཨིན། འཕྲལ་བཀོལ་དེ་གདོང་ལན་མཇུག་ལྷགཔ་(ཡོད་ཆ་རིམ་པ་གནས་གོང་) ཡང་ན་མཇུག་ལས་ཉུང་མི་(མེད་ཆ་རིམ་པ་གནས་གོང་)སྐབས་མཇུག་བསྡུཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090202.xhp	0	help	par_id3145273				0	dz	ཕྱིར་ཐོན་དོན་ལུ་ \<emph\>གསལ་བཤད་\</emph\> དེ་འཕྲལ་བཀོལ་གནས་སྟངས་མེནམ་ལུ་ཕྱིར་ཐོན་ལུ་ལག་ལེན་འཐབ། གསལ་བཤད་དེ་ \<emph\>དོན་ལུ་...ཤུལ་མ་\</emph\>འཕྲལ་བཀོལ་ནང་འཁོད་དགོཔ་ཨིན།  ཅིན་...དེ་ལས་ \<emph\>གསལ་བཤད་དེ་\</emph\> ཕྱིར་ཐོན་གནས་སྟངས་བཟུམ་བརྟག་ཞིབ་འོག་གི་ལག་ལེན་འཐབ:				2002-02-02 02:02:02
