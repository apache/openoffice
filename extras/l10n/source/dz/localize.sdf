helpcontent2	source\text\shared\02\01170102.xhp	0	help	par_id3155306	2			0	dz	གནད་སྡུད་\<emph\>མཆོང་ལྡེ་གི་ཤོག་ལེབ་དེ་གིས་ \</emph\>ཁྱོད་ལུ་ སེལ་འཐུ་གྲུབ་ཡོད་པའི་ཚད་འཛིན་ནང་ལུ་  གནད་སྡུད་ཀྱི་འབྱུང་ཁུངས་ཅིག་  འགན་སྤྲོད་འབད་བཅུགཔ་ཨིན།  				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170102.xhp	0	help	par_id3148773				0	dz	གནད་སྡུད་གཞི་རྟེན་འབྲེལ་ལམ་ཚུ་དང་བཅས་པའི་འབྲི་ཤོག་གི་དོན་ལུ་  འབྲེལ་བའི་གནད་སྡུད་གཞི་རྟེན་འདི་  \<link href=\"text/shared/02/01170200.xhp\" name=\"Form Properties\"\>འབྲི་ཤོག་གི་རྒྱུ་དངོས་ཚུ་\</link\>ནང་ལུ་ངེས་འཛིན་འབད་དེ་ཡོད།  འདི་གི་དོན་ལུ་ཁྱོད་ཀྱིས་   \<link href=\"text/shared/02/01170203.xhp\" name=\"Data\"\>\<emph\>གནད་སྡུད་\</emph\>\</link\> མཆོང་ལྡེ་ཤོག་ལེབ་གུ་  ལས་འགན་ཚུ་འཐོབ་ཚུགསཔ་ཨིན། 				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170102.xhp	0	help	par_id3149377				0	dz	ཚད་འཛིན་ཅིག་གི་ \<emph\>གནད་སྡུད་\</emph\> མཆོང་ལྡེ་ཤོག་ལེབ་ཀྱི་སྲིད་པའི་སྒྲིག་སྟངས་ཚུ་  རིམ་བཞིན་ཚད་འཛིན་ལུ་རག་ལས།  ད་ལྟོའི་ཚད་འཛིན་དང་སྐབས་དོན་དོན་ལུ་ཡོད་པའི་ གདམ་ཁ་ཚུ་རྐྱངམ་ཅིག་  ཁྱོད་ཀྱིས་མཐོངམ་ཨིན:				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170102.xhp	0	help	par_idN108B4				0	dz	གཞི་བསྟུན་གནས་གོང་(ཨོཕི)				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170102.xhp	0	help	par_idN108B8				0	dz	\<ahelp hid=\".\"\>ཤོག་ཁྲམ་ནང་གི་  ཞིབ་དཔྱད་སྒྲོམ་ཚུ་དང་  རེ་ཌིའོ་ཨེབ་རྟ་ཚུ་  ད་ལྟོའི་ཡིག་ཆ་ནང་གི་ནང་ཐིག་ལུ་གནས་དེ་ཡོད།  ཚད་འཛིན་འདི་ལྕོགས་ཅན་བཟོ་བ་ཅིན་  ཁྱོད་ཀྱིས་  གཞི་བསྟུན་གནས་གོང་ནང་ཐོ་བཀོད་འབད་མི་གནས་གོང་འདི་  ནང་ཐིག་ལུ་འདྲ་བཤུས་བརྐྱབ་ཨིན།  ཚད་འཛིན་འདི་ལྕོགས་མེད་བཟོ་བ་ཅིན་  གཞི་བསྟུན་གནས་གོང་(ཨོཕ་)ལས་གནས་གོང་འདི་  ནང་ཐིག་ལུ་འདྲ་བཤུས་བརྐྱབ་ཨིན།  \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170102.xhp	0	help	hd_id3159121				0	dz	གཞི་བསྟུན་གྱི་གནས་གོང་(ཨཱོན)				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170102.xhp	0	help	par_id3163812	141			0	dz	\<ahelp hid=\"HID_PROP_REFVALUE\" visibility=\"hidden\"\>ཝེབ་འབྲི་ལོག་གི་དོན་ལུ་  ཁྱོད་ཀྱིས་  སར་བར་ལུ་ཡང་ཆག་གཏང་ནི་ འབྲི་ཤོག་འདི་གཏང་པའི་སྐབས་ལུ་  གཞི་བསྟུན་གནས་གོང་ཅིག་ཐོ་བཀོད་འབད།  གནད་སྡུད་གཞི་རྟེན་འབྲི་ཤོག་དང་བཅས་  ཐོ་བཀོད་འབད་ཡོད་པའི་གནས་གོང་འདི་  གནད་སྡུད་གཞི་རྟེན་ས་སྒོའི་ནང་འབྲི་དེ་ཡོདཔ་དང་  ཚད་འཛིན་ས་སྒོ་ནང་ལུ་ཡང་ འགན་སྤྲོད་འབད་དེ་ཡོད།\</ahelp\>ཁྱོད་ཀྱིས་  གཞི་བསྟུན་གནས་གོང་འདི་  གདམ་ཁའི་ཨེབ་རྟ་ཚུ་ལུ་དང་  ཞིཔ་དཔྱད་སྒྲོམ་ཚུ་ལུ་  འགན་སྤྲོད་འབད་བཏུབ་ཨིན།  ཝེབ་ཀྱི་འབྲི་ཤོག་འདི་གཏངམ་ད་  གཞི་བསྟུན་གནས་གོང་འདི་ སར་བར་ལུ་ཡང་ཆག་གཏངམ་ཨིན།  གནད་སྡུད་གཞི་རྟེན་འབྲི་ཤོག་དང་བཅས་  འདི་ནང་ཐོ་བཀོད་འབད་ཡོད་པའི་གནས་གོང་འདི་  ཚད་འཛིན་ས་སྒོ་ལུ་འགན་སྤྲོད་འབད་ཡོད་པའི་གནད་སྡུད་གཞི་རྟེན་ནང་ལུ་  འབྲི་འོང་།				2002-02-02 02:02:02
