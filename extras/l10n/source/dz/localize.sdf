helpcontent2	source\text\shared\optionen\01060300.xhp	0	help	par_id3154684				0	dz	\<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_LAYOUT_CB_EXPREF\"\>གཞི་བསྟུན་ཁྱབ་ཚད་ལུ་ཉེ་འདབས་ཀྱི་གྱལ་ཚུ་ ཡང་ན་ ཀེར་ཐིག་ཚུ་བཙུགསཔ་ད་གཞི་བསྟུན་ཚུ་རྒྱ་འཕར་འབད་ནི་ཨིན་ན་གསལ་བཀོད་འབདཝ་ཨིན། ཨ་ནི་འདི་གཞི་བསྟུན་ཁྱབ་ཚད་འདི་རེ་འདུན་བསྐྱེད་ཡོད་པའི་ཁ་ཕྱོགས་ནང་ནང་ཐིག་གཉིས་ཙམ་ངོ་མ་སྦེ་འཕར་ཚད་འབད་ཡོདཔ་ ཀེར་ཐིག་ ཡང་ན་ གྱལ་བཙུགས་ཡོད་པ་ཅིན་རྐྱངམ་གཅིག་སྲིད་པ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01060300.xhp	0	help	par_id3153194				0	dz	\<emph\>དཔེར་ན་:\</emph\> ཁྱབ་ཚད་ ཨེ་༡:བི་༡ འདི་མན་ངག་ནང་གཞི་བསྟུན་འབད་ཡོད་པ་ཅིན་དང་ཁྱོད་ཀྱིས་ཀེར་ཐིག་བི་གི་ཤུལ་ལས་ཀེར་ཐིག་གསརཔ་བཙུགས་པ་ཅིན་ གཞི་བསྟུན་འདི་ཨེ་༡:སི་༡ ལུ་རྒྱ་འཕར་འབདཝ་ཨིན། ཁྱབ་ཚད་ཨེ་༡:བི་༡་འདི་གཞི་བསྟུན་འབད་ཡོད་པ་ཅིན་དང་གྱལ་༡་གི་འོག་ལུ་གྱལ་གསརཔ་བཙུགས་ཡོད་པ་ཅིན་ ཀེར་ཕྲང་ཁ་ཕྱོགས་ནང་ནང་ཐིག་ངོ་རྐྱང་རྐྱངམ་གཅིག་ཡོདཔ་ལས་ གཞི་བསྟུན་འདི་རྒྱ་འཕར་མི་འབད།				2002-02-02 02:02:02
