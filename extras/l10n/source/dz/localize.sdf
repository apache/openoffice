helpcontent2	source\text\swriter\guide\form_letters_main.xhp	0	help	par_idN10685				0	dz	\<item type=\"literal\"\>ཚོང་འབྲེལ་ཡིག་འགྲུལ་\</item\> འདི་གཡོན་གྱི་ཐོ་ཡིག་ནང་ལུ་ དང་དེ་ལས་ \<item type=\"literal\"\>དེང་སང་ཡིག་གུ་\</item\> འདི་གཡས་ཀྱི་ཐོ་ཡིག་ནང་ལུ་སེལ་འཐུ་འབད། ཊེམ་པེལེཊིསི་ཌའི་ལོག་ཁ་བསྡམ་ནིའི་དོན་ལས་ བཏུབ་ཨེབ་གཏང་ དེ་ལས་ཝི་ཛརཌི་ནང་ལུ་ ཤུལ་མམ་ ཨེབ་གཏང་།				2002-02-02 02:02:02
helpcontent2	source\text\swriter\guide\form_letters_main.xhp	0	help	par_idN106BD				0	dz	ཝི་ཛརཌི་འདི་གི་རིམ་པ་ཤུལ་མམ་འདི་ལུ་  \<emph\>ཁ་བྱང་ཀི་དེབ་སེལ་འཐུ་འབད་\</emph\> ཨེབ་རྟ་འདི་ ཁྱོད་ཀྱིས་ངེས་བདེན་ཁ་བྱང་ཐོ་ཡིག་འདི་ལག་ལེན་འཐབ་ཨིན་མེན་ཞིབ་དཔྱད་འབད་ནིའི་དོན་ལས་ ཨེབ་གཏང་། ཁ་བྱང་སྡེབ་ཚན་དབྱེ་བ་ཅིག་སེལ་འཐུ་འབད་ དེ་ལས་ \<emph\>ཤུལ་མམ་\</emph\>ཨེབ་གཏང་།				2002-02-02 02:02:02
helpcontent2	source\text\swriter\guide\form_letters_main.xhp	0	help	par_idN106C5				0	dz	\<emph\>ལེགས་སྨོན་ཅིག་གསར་བསྐྲུན་འབད་ནིའི་\</emph\> རིམ་པ་འདི་གིས་རྗེས་སུ་འབྲངམ་ཨིན།  \<emph\>རང་དོན་བཟོ་ཡོད་པའི་ལེགས་སྨོན་བཙུགས་\</emph\> སྒྲོམ་སེལ་འཐུ་མ་འབད།  \<emph\>ཡོངས་ཁྱབ་ལེགས་སྨོན་\</emph\>གྱི་འོག་ལུ་ ཡིག་གུ་ཚུ་ཆ་མཉམ་གྱི་མགོ་ལུ་དགོ་ནི་ཨིན་མི་ ལེགས་སྨོན་འདི་སེལ་འཐུ་འབད།				2002-02-02 02:02:02
