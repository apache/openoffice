helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3156291				0	dz	ཡིག་དཔར་འཛོལ་བ་ཚུ་ཡིག་ཆ་ནང་འོག་ཐིག་དམརཔ་ཅིག་གཙོ་དམིགས་བཀལ་ཡོདཔ་ཨིན། ཁྱོད་ཀྱིས་དེ་བཟུམ་སྦེ་འོད་འདི་རྟགས་བཀལ་ཡོད་མི་མིང་ཚིག་ལྟག་ལུ་བཏག་པ་ཅིན་ ངེས་བདེན་གྱི་ཐོ་ཡིག་ཅིག་ལེན་ནི་ལུ་སྐབས་དོན་དཀར་ཆག་འདི་ཁ་ཕྱེ་བཏུབ་ཨིན། མིང་ཚིག་འདི་ཚབ་མ་བཙུགས་ནི་ལུ་ངེས་བདེན་ཅིག་སེལ་འཐུ་འབད། ཁྱོད་ཀྱིས་ཡིག་ཆ་འདི་ཞུན་དག་འབད་བའི་སྐབས་ལོག་སྟེ་འཛོལ་བ་ཅོག་འཐདཔ་འབད་བ་ཅིན་ ལོག་སྟེ་རང་འཛོལ་བ་སྦེ་རྟགས་བཀལ་བཞག་འོང་།				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010400.xhp	0	help	par_id3153815				0	dz	རང་བཞིན་ནོར་བཅོས་ཚབ་མའི་ཐིག་ཁྲམ་ནང་\<link href=\"text/shared/01/06040200.xhp\" name=\"AutoCorrect replacement table\"\>མིང་ཚིག་ཟུང་བཞག་ནི་ལུ་\</link\>, open the \<link href=\"text/shared/01/06040500.xhp\" name=\"AutoCorrect context menu\"\>རང་བཞིན་ནོར་བཅོས་འབད་ནིའི་སྐབས་དོན་དཀར་ཆག་ཁ་ཕྱེ་ཞིནམ་དང་\</link\>རང་བཞིན་ནོར་བཅོས་ \<emph\>གདམ་ཁ་རྐྱབས།\</emph\>. ཁྱོད་ཀྱི་སེལ་འཐུ་འདི་ཡན་ལག་དཀར་ཆག་ནང་ལས་བཟོ། མིང་ཚིག་འདི་ཚབ་བཙུགས་འབདཝ་ཨིནམ་དང་འདི་དང་གཅིག་ཁར་མིང་ཚིག་ཟུང་འདི་ཚབ་མའི་ཐིག་ཁྲམ་ནང་བཞགཔ་ཨིན།  				2002-02-02 02:02:02
