helpcontent2	source\text\shared\00\00000005.xhp	0	help	par_id3152863				0	dz	གཞི་བཀོད་འདྲི་དཔྱད་སྐད་ཡིག་(SQL)ཟེར་མི་འདི་ གནད་སྡུད་གཞི་རྟེན་འདྲི་དཔྱད་འབད་ནིའི་དོན་ལུ་ལག་ལེན་འཐབ་པའི་སྐད་ཡིག་འདི་ཨིན།  $[officename] ནང་ལུ་ འདྲན་བྱེད་ཚུ་ ཨེསི་ཀིའུ་ཨེལ་ཡང་ན་  མཱའུསི་དང་ཅིག་ཁར་་ཕན་ཚུན་འབྲེལ་ལྡན་ནང་ལུ་འབད་སྒྲིག་རུང་བཏུབ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000005.xhp	0	help	hd_id3147552				0	dz	ཨེསི་ཀིའུ་ཨེལ་གནད་སྡུད་གཞ་རྟེན་/ཨེསི་ཀིའུ་ཨེལ་སར་བར།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000005.xhp	0	help	par_id3159239				0	dz	ཨེསི་ཀིའུ་ཨེལ་གནད་སྡུད་གཞི་རྟེན་ཟེར་མི་འདི་  \<link href=\"text/shared/00/00000005.xhp#sql\"\>ཨེསི་ཀིའུ་ཨེལ་\</link\> ངོས་འདྲ་བ་འབྱིན་མི་གནད་སྡུད་གཞི་རྟེན་གྱི་རིམ་ལུགས་ཅིག་ཨིན།  ཨེསི་ཀིའུ་ཨེལ་གནད་སྡུད་གཞི་རྟེན་ཚུ་འཕྲལ་འཕྲལ་རང་  དབུས་ཀྱི་སར་བར་ སོ་སོ་ཞབས་རྟོག་སྤྱོད་མི་ནང་གི་ ཞབས་རྟོག་སྤྱོད་མི་ཡོངས་འབྲེལ་ནང་ལག་ལེན་འཐབ་ཨིན་  (དཔེར་ན་, ཨེསི་ཀིའུ་ཨུལ་སར་བར་བཟུམ་) དེ་བཟུམ་སྦེ་  དེ་ཚུ་ལུ་ཨེསི་ཀིའུ་ཨེལ་སར་བར་གནད་སྡུད་ཡང་ཅིན་ ཐུང་ཀུ་གི་དོན་ལུ་ ཨེསི་ཀིའུ་ཨེལ་སར་བར་ཟེར་ཡང་སླབ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000005.xhp	0	help	par_id3159118				0	dz	$[officename] ནང་ ཁྱོད་ཀྱིས་ ཕྱིའི་ཨེསི་ཀིའུ་ཨེལ་གནད་སྡུད་གཞི་རྟེན་ཧྲིལ་པོ་བཟོ།  དེ་ཡང་ ཁྱོད་རའི་ཉེས་གནས་ཀྱི་ཧརཌི་ཌིཀིསི་ དང་ ཡོངས་འབྲེལ་གུ་གནས་དེ་འོང་།  \<link href=\"text/shared/00/00000005.xhp#odbc\"\>ཨོ་ཌི་བི་སི་\</link\> ལས་བརྒྱུད་དེ་ ཡང་ན་  $[officename] ནང་ལུ་ཡུལ་མི་འདྲེན་བྱེད་ ཧྲིལ་པོ་ལས་བརྒྱུད་དེ་  འཛུལ་སྤྱོད་འདི་གྲུབ་ཡོད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000005.xhp	0	help	hd_id3166423				0	dz	ཝི་ཌོསི་དང་ཨོར་ཕེནསི།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000005.xhp	0	help	par_id3149448				0	dz	ཝི་ཌོསི་དང་ཨོར་ཕེནསི་ཚུ་  ལོ་མང་རབ་ཅིག་ལག་ལེན་འཐབ་འདི་ཡོད་པའི་སྔོན་རབ་དཔར་བསྐྲུན་རིག་པ་གི་ཐ་སྙད་ཅིག་ཨིན།  ཝི་ཌོ་ཟེར་མི་འདི་ དོན་མཚམས་མཇུག་ལུ་ཡོད་མི་གི་གྲལ་ཐིག་ཐུང་ཀུ་འདི་ལུ་སླབ་ཨིན་  དེ་ཡང་  དཔར་བསྐྲུན་འབད་བའི་བསྒང་ ཤུལ་མའི་ཤོག་ལེབ་ཀྱི་མགོ་ལུ་རྐྱངམ་ཅིག་འབྱུངམ་་ཨིན།  ཨོར་ཕེན་འདི་ ཁྱད་པར་ནང་འབད་བ་ཅིན་ སྔོན་མའི་ཤོག་ལེབ་ཀྱི་འོག་ལུ་ དཔར་བསྐྲུན་འབད་ཡོད་མི་ དོན་མཚམས་ཀྱི་གྲལ་ཐིག་དང་པ་འདི་ཨིན།  $[officename] ཚིག་ཡིག་ཡིག་ཆ་ནང་  རེ་འདུན་དོན་མཚམས་བཟོ་རྣམ་ནང་ནི་བཟུམ་འབྱུང་མི་འདི་  ཁྱོད་ཀྱིས་རང་བཞིན་གྱིས་འབད་སྔོན་བཀག་འབད་བཏུབ།   ནི་འབད་བའི་བསྒང་  ཤོག་ལེབ་གུ་ཅིག་ཁར་བཞག་ནིའི་དོན་ལས་  གྲལ་ཐིག་ཚུ་གི་མང་ཉུང་ ཉུང་མཐའ་འདི་ ཁྱོད་ཀྱིས་གཏན་འབེབས་བཟོ་བཏུབ།				2002-02-02 02:02:02
