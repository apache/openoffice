helpcontent2	source\text\swriter\01\04120212.xhp	0	help	par_id3149880				0	dz	\<ahelp hid=\"SW_CHECKBOX_TP_TOX_SELECT_CB_CASESENSITIVE\"\>ཚུགས་ཡིག་དང་མགྱོགས་ཡིག་ཚུ་ དབྱེར་མེད་ཟུར་ཐོའི་ཐོ་འགོད་ཚུ་ནང་ལུ་ ཁྱད་པར་སྟོནམ་ཨིན། ཨེ་ཤི་ཡན་ ཁ་སྐད་ཀྱི་དོན་ལས་ དམིགས་བསལ་གྱི་ལེགས་སྐྱོང་འཐབ་ནི་དེ་འཇུག་སྤྱོད་འབདཝ་ཨིན།\</ahelp\> ཁྱོད་ལུ་ཐོ་འགོད་ཀྱི་འགོ་ཐོག་བྱུང་མི་དེ་ ཐོ་འགོད་ཀྱི་ཡི་གུ་དེ་གཏན་འབེབས་བཟོ་ནིའ་དོན་ལུ་ ཡིག་ཆའི་ནང་ལུ་དགོ་ནི་ཨིན་པ་ཅིན་ \<emph\>དབྱེར་མེད་ཐོ་འགོད་ཚུ་མཉམ་མཐུད་འབད་ཟེར་མི་དེ་སེལ་འཐུ་འབད།\</emph\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120212.xhp	0	help	par_idN10671				0	dz	ཨེ་ཤི་ཡན་ ཁ་སྐད་ཀྱི་དོན་ལས་ སྣ་མང་གནས་རིམ་གོ་སྒྲིག་དེ་ལག་ལེན་འཐབ་ནིའི་དོན་ལུ་ \<emph\>ཡི་གུ་ཆེ་ཆུང་གི་ཉེན་ཁ།\</emph\>དེ་སེལ་ཟཏུ་འབད སྣ་མང་གནས་རིམ་གོ་སྒྲིག་དེ་ནང་ལུ་ ཐོ་འགོད་ཀྱི་ཡི་གུ་དང་ ཌའི་ཀིརི་ཊིཀསི་ཚུ་སྣང་མེད་འབད་ཞབག་ཞིནམ་ལས་ སྔོན་གྱི་འབྲི་ཤོག་ཚུ་རྐྱངམ་ཅིག་ག་བསྡུར་བརྐྱབ་ཨིན། འབྲི་ཤོག་ཚུ་དབྱེར་མེད་ཨིན་པ་ཅིན་ འབྲི་ཤོག་གི་ཌའི་ཀིརི་ཊིཀསི་ཚུ་ག་བསྡུར་བརྐྱབ་ཨིན། དོ་རུང་འབྲི་ཤོག་ཚུ་དབྱེར་མེད་ཨིན་པ་ཅིན་ འབྲི་ཤོག་གི་ཡི་གུ་ཚུ་དང་ ཡི་གུ་ཚུ་གི་རྒྱ་ཚད་ དེ་ལས་ ཇ་པ་ནིསི་ ཀ་ན་ ནང་ལུ་ཡོད་མི་ཁྱད་པར་ཚུ་ ག་བསྡུར་བརྐྱབ་ཨིན།				2002-02-02 02:02:02
