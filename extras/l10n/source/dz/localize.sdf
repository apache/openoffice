helpcontent2	source\text\scalc\guide\cellreferences.xhp	0	help	par_id7099826				0	dz	ཁྱོད་ཀྱིས་ ནང་ཐིག་ཁྱབ་ཚད་ཅིག་སེལ་འཐུ་འབད་ནིའི་དོན་ལས་ ཤུགས་ལྡན་ནང་ཐིག་འདིག་གི་འོག་གི་གཡས་སྒྱིད་ཁུག་འདི་ནང་ སྒྲོམ་འདི་འདྲུདཔ་ཨིན་པ་ཅིན་  $[officename] གི་རང་བཞིན་གྱིས་ ཉེ་འདབས་ཀྱི་ནང་ཐིག་འདི་ནང་ལུ་ ཆ་མཉམ་པའི་གཞི་བསྟུན་འདི་ཚུ་བཙུགསཔ་ཨིན། དེ་འབདཝ་ལས་ ལེབ་གྲངས་མིང་འདི་  "$" རྟགས་ཅིག་དང་གཅིག་ཁར་ ཡང་དག་གཞི་བསྟུན་ཅིག་སྦེ་གོ་གནས་སྤྲོད་ནིའི་དོན་ལས་ སྔོན་དཔེ་འབད་ཡོད། 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\guide\cellreferences.xhp	0	help	par_id674459				0	dz	ཁྱོད་ཀྱིས་ འ་ནི་མན་ངག་ནང་ལུ་ ཡིག་ཆ་གཞན་མི་འདི་གི་མིང་འདི་བརྟག་དཔྱད་འབད་བ་ཅིན་  ཁྱོད་ཀྱིས་འདི་  \<link href=\"text/shared/00/00000002.xhp#url\" name=\"URL\"\>ཡུ་ཨར་ཨེལ་\</link\> ཅིག་སྦེ་འབྲི་ཡོདཔ་སྦེ་ མཐོང་ཚུགསཔ། འ་ནི་འདི་ཁྱོད་ཀྱིས་ ཨིན་ཊར་ནེཊི་འདི་ལས་ ཡུ་ཨར་ཨེལ་ཅིག་ཡང་ཐོ་བཀོད་འབད་ཚུགས་པའི་དོན་ཨིན།				2002-02-02 02:02:02
