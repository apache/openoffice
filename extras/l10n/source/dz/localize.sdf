helpcontent2	source\text\shared\00\00000020.xhp	0	help	hd_id3154232				0	dz	ཕྱིའི་རྩ་སྒྲིག་ཚུ་དང་ཡིག་སྣོད་དབྱེ་བ་ཚུ་གི་དོན་ལུ་དྲན་འཛིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3154230				0	dz	དེ་ཚུ་གཞི་བཙུགས་མ་འབད་བར་ཡོད་རུང་ ཚགས་མ་ལ་ལོ་ཅིག་ \<emph\>ཁ་ཕྱེ་\</emph\> དང་ \<emph\>སྲུང་\</emph\> ཌའི་ལོག་ནང་སེལ་འཐུ་འབད་བཏུབ།  ནི་བཟུམ་གྱི་ཚགས་མ་ཁྱོད་ཀྱིས་སེལ་འཐུ་འབད་བ་ཅིན་  ཁྱོད་དགོ་པ་ཅིན་ད་ལྟོ་ཡང་གཞི་བཙུགས་འབད་བཏུབ་ཟེར་བའི་ འཕྲིན་དོན་ཅིག་འབྱུང་འོང་།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	hd_id3156027				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>\</caseinline\>\<caseinline select=\"DRAW\"\>\</caseinline\>\<caseinline select=\"IMPRESS\"\>\</caseinline\>\<defaultinline\>ཚིག་ཡིག་ཡིག་ཆ་ཚུ་ནང་འདྲེན་དང་ཕྱིར་འདྲེན་འབད་དོ་\</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3145669				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>\</caseinline\>\<caseinline select=\"DRAW\"\>\</caseinline\>\<caseinline select=\"IMPRESS\"\>\</caseinline\>\<defaultinline\>$[officename] རྩོམ་འབྲི་པ་གིས་ མའི་ཀོརོ་སོཕཊི་མིང་ཚིག་གི་ཚིག་་ཡིག་རྩ་སྒྲིག་གི་ཐོན་རིམ་སྣ་མང་ལྷག་བཏུབ།  ཨིན་རུང་ $[officename]རྩོམ་འབྲི་པ་དང་བཅས་འཐོབ་ཚུགསཡོད་མི་ག་རང་ ཨེམ་ཨེསི་མིང་ཚིག་ལུ་གནས་སོར་འབད་མི་བཏུབ་  དེ་ལས་ག་རང་ནང་འདྲེན་ཡང་འབད་མི་བཏུབ། \</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3150144				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>\</caseinline\>\<caseinline select=\"DRAW\"\>\</caseinline\>\<caseinline select=\"IMPRESS\"\>\</caseinline\>\<defaultinline\>ནང་འདྲེན་འབད་ནི་འདི་སྤྱིར་བཏང་དཀའ་ངལ་ཅན་ཅིག་མེན། གྱལ་དམརཔོ་བརྡ་དོན་དང་ཚད་འཛིན་ཚུ་ཡང་ནང་འདྲེན་འབད་ཡོདཔ་ཨིན (དང་ཕྱིར་འདྲེན་འབད་ཡོདཔ) དེ་ལས་ $[officename] གིས་ཚིག་ཡིག་བཙུགས་ཡོད་མི་ཡང་ན་བཏོན་གཏང་ཡོད་མི་མིང་ཚིག་ཡིག་ཆ་ཚུ་ནང་དེ་བཟུམ་སྦེ་ཡིག་གཟུགས་ཁྱད་ཆོས་ལེགས་བཅོས་འབད་ཡོད་མི་ཚུ་ངོ་ཤེསཔ་ཨིན།  རྩོམ་པ་པོ་རེ་རེ་དོན་ལུ་་ཚོས་གཞི་བཏང་་ཐངས་སོ་སོ་དང་དུས་ཚོད་བསྒྱུར་བཅོས་ཚུ་ཡང་གྲངས་སུ་བཙུགས་ཡོདཔ་ཨིན།  ཚིག་ཡིག་ཚད་རིས་བོགསི་སེ་སྐབས་དང་ཊེམ་པེལེཊི་ཚུ་ལས་ནང་འདྲེན་འབདཝ་ད་ ཁྱད་ཆོས་ཚུ་མང་ཤོས་རང་ཐད་ཀར་མཚམས་དོན་དང་པར་རིས་ཁྱད་ཆོས་ཚུ་སྦེ་ནང་འདྲེན་འབད་ཡོདཔ་ཨིན།  ག་དེ་འབད་ཨིན་རུང་ལས་སྦྱོར་ནང་འདྲེན་འབད་བའི་སྐབས་ཁྱད་ཆོས་ཚུ་ལ་ལོ་བརླག་སྟོར་ཞུགས་འོང་།\</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3149095				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>\</caseinline\>\<caseinline select=\"DRAW\"\>\</caseinline\>\<caseinline select=\"IMPRESS\"\>\</caseinline\>\<defaultinline\>ཡིག་སྣོད་ཚུ་ནང་འདྲེན་དངཕྱིར་འདྲེན་འབད་ཚུགས་ \<link href=\"text/shared/00/00000005.xhp#rtf\" name=\"RTF\"\>ཨར་ཊི་ཨེཕ་\</link\> ཡིག་སྣོད་ཚུ།  ཡིག་སྣོད་རྩ་སྒྲིག་འདི་  འཇུག་སྤྱོད་ཚུ་དང་མཉེན་རིམ་སྣ་མང་ཡན་ཆད་ཀྱི་རྩ་སྒྲིག་འབད་ཡོད་པའི་ཚིག་ཡིག་བསྒྱུར་བཅོས་འབདཝ་ད་ལག་ལེན་འཐབ་བཏུབ།  ཐབས་ལམ་ནི་གི་ཐོག་ལས་  ལས་རིམ་མང་ཤོས་ཀྱིས་ལྷག་མི་རྩ་སྒྲིག་ཚུ་ དཀའ་ངལ་མེད་པར་གནས་སོར་འབད་ཚུགས།  $[officename] སི་ཨེ་ཨེལ་སི་བརྒྱུད་དེ་ \<link href=\"text/shared/00/00000005.xhp\" name=\"DDE\"\>ཌི་ཌི་ཨི་\</link\>  $[officename] བརྩོམ་འབྲི་པའི་ནང་ལུ་.\</defaultinline\>\</switchinline\> ལས་ཁྱོད་ཀྱིས་  ཤོག་ཁྲམ་ཡན་ལག་ཅིག་བཙུགསཔ་ད་  འཛིན་པང་དེ་གིས་ ཨར་ཊི་ཨེཕ་རྩ་སྒྲིག་ལག་ལེན་འཐབ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3151378				0	dz	\<emph\>ཚིག་ཡིག་ཨིན་ཀོཌིཊ\</emph\>ཚགས་མ་དེ་གིས་ ཁྱོད་ལུ་  ཨིན་ཀོ་ཌིང་ཡིག་གཟུགས་གཞན་མི་དང་བཅས་ ཚིག་ཡིག་གི་ཡི་གཆ་སྲུང་ནི་ལུ་སྒྲོག་རམ་འབདཝ་ཨིན།  ཡིག་འབྲུའི་གཞི་སྒྲིག་དང་སྔོན་སྒྲིག་ཡི་གགཟུགས་ དེ་ལས་སྐད་ཡིག་དང་དོན་མཚམས་ཀྱི་མཚམས་ཚུ་  ཁྱོད་ཀྱིས་ལྕོགས་ཅན་བཟོ་བཅུག་ནིའི་དོན་ལུ་  ཚགས་མ་གིས་ཌའི་ལོག་ཅིག་ཁ་ཕྱེཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	hd_id3149763	11			0	dz	ཨེཆ་ཊི་ཨེམ་ཨེལ་རྩ་སྒྲིག་ནང་གི་ནང་འདྲེན་དང་པྱིར་འདྲེན་འབད་དོ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3150244				0	dz	$[officename] རྩོམ་འབྲི་པ་དང་བཅས་ ཁྱོད་རའི་ ཨེཆ་ཊི་ཨེམ་ཨེལ་ཡིག་ཆ་ནང་ ཁྱོད་ཀྱིས་ མཇུག་གི་དྲན་ཐོ་དང་མཐའི་དྲན་འཛིན་ བཙུགས་བཏུབ།  དེ་ཚུ་མེ་ཊ་ངོ་རྟགས་སྦེ་ཕྱིར་འདྲེན་འབད།  མཇུག་གི་དྲན་ཐོ་དང་མཐའི་དྲན་འཛིན་ཡིག་འབྲུ་ཚུ་ ཧའི་པར་ལིངཀིསི་སྦེ་ཕྱིར་འདྲེན་འབད་ཡོད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3149800				0	dz	ཨེཆ་ཊི་ཨེམ་ཨེལ་ཡིག་ཆ་ནང་ མ་ཤེས་པའི་ཡིག་འབྲུ་ཚུ་གྲངས་སུ་བཙུགས་ནི་ལུ་ དྲན་འཛིན་ཚུ་ལག་ལེན་འཐབ་ཨིན།  "HTML:..." དང་བཅས་མཇུག་བསྡུ་ ">"དང་བཅས་འགོ་བཙུགས་མི་དྲན་འཛིན་ག་རང་  ཨེཆ་ཊི་ཨེམ་ཨེལ་ཨང་རྟགས་སྦེ་བརྩི་འཇོག་འབདཝ་ཨིན་  དེ་འབདཝ་ད་གནས་རིམ་དེ་ཚུ་མེད་པར་ཕྱིར་འདྲེན་འབད་ཡོད།  "HTML:..."གི་ཤུལ་ལས་ ཚིག་ཡིག་གི་མཐའ་འཁོར་ ངོ་རྟགས་ལེ་ཤ་ཅིག་གྲངས་སུ་བཙུགས་བཏུབ།  སྒྲ་མདངས་ཡིག་འབྲུ་ཚུ་ ཨེ་ཨེན་ཨེསི་ཨའི་ཡིག་འབྲུ་གི་གཞི་སྒྲིག་ནང་ལུ་གཞི་བསྒྱུར་འབད་ཡོད། ནང་འདྲེན་གྱི་སྐབས་ལུ་འདྲེན་འཛིན་ཚུ་གསར་བསྐྲུན་འབདཡོད་ (དཔེར་ན་  མེ་ཊ་ངོ་རྟགས་ཚུ་གི་དོན་ལུ་ ཡིག་སྣོད་ཀྱི་རྒྱུ་དངོས་ཡང་ན་ མ་ཤེས་པའི་ངོ་རྟགས་ནང་ཁང་མིག་མེད།)				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3149734				0	dz	$[officename]་རྩོམ་འབྲི་པའི་ཨེཆ་ཊི་ཨེམ་ཨེལ་ནང་འདྲེན་པ་འདི་གིས་  ཡུ་ཏི་ཨེཕ་-༨་ ཡང་ན་ ཡུ་སི་ཨེསི་༢་ཡིག་འབྲུ་ཀོ་ཌིང་ཡོད་མི་ ཡིག་སྣོད་ཚུ་ལྷག་ཚུགས།  ཨེ་ཨེན་ཨེསི་ཨའི་ཡིག་འབྲུ་གི་གཞི་སྒྲིག་ཡང་ན་རིམ་ལུགས་ཀྱི་ཡིག་འབྲུ་ནང་ཡོད་མི་ཡིག་འབྲུ་ཆ་མཉམ་རང་བཀྲམ་སྟོན་འབད་བཏུབ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3154143				0	dz	 "font" རྒྱུ་དངོས་ཀྱིས་ནེཊི་སིཀེཔ་འགྲུལ་བསྐྱོདཔ་ ཆ་མཉམ་ཨིན།  དེ་ཡང་  ཡིག་གཟུགས་ཚད་ཀྱི་ཧེ་མ་ལས་  ཁྱོད་ཀྱིས་"font-style" (ཨའི་ཊ་ལིཀ་, ཅི་མེད་), "font-variant" (སྤྱིར་གཏང་, ཀེཔསི་ཆུང་ཀུ་) དང་ "font-weight" (སྤྱིར་གཏང་, རྒྱགས་པ་) གི་དོན་ལས་གདམ་ཁའི་གནས་གོང་ཚུ་གསལ་བཀོད་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3153760				0	dz	དཔེར་ན་  ཡིག་གཟུགས་རིགས་ཚན་ཨེ་རིཡལ་ཡང་ན་  ཨེ་རིཡལ་གནས་འདི་མེད་པ་ཅིན་ཧེལ་བི་ཊི་ཀ་་དང་བཅས་"Font: bold italic small-caps 12pt/200% Arial, Helvetica"གིས་རྒྱགས་པ་  ཨའི་ཊ་ལིཀ་  ཀེཔསི་ཆུང་ཀུ་དང་བར་སྟོང་གཉིས་ལྡན་ལུ་སོར་བསྒྱུར་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3150129				0	dz	"Font: 10pt"གིས་ རྒྱགས་པ་དང་ཨི་ཊ་ལིཀ་དེ་ལས་ཀེཔསི་ཆུང་ཀུ་ཨོཕ་དང་བཅས་  ༡༠ པི་ཊི་ཡིག་གཟུགས་ལུ་སོར་བསྒྱུར་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3155135				0	dz	ཨེམ་ཨེསི་ཨིན་ཊར་ནེཊི་དཔྱད་ཞིབ་འབད་མི་ཡང་ན་ $[officename] རྩོམ་འབྲི་པ་ཚུ་ཕྱིར་འདྲེན་གདམ་ཁ་སྦེ་གཞི་སྒྲིག་འབད་ཡོད་པ་ཅིན་ ཚད་འཛིན་ས་སྒོ་གི་ཚད་ཚུ་དང་འདིའི་ནང་འཁོད་ས་སྟོང་ཚུ་བཟོ་རྣམ་སྦེ་ (དཔར་བསྐྲུན་རྩ་སྒྲིག་ཚུ)ཕྱིར་འདྲེན་འབད་ཡོདཔ་ཨིན། སི་ཨེསི་ཨེསི་༡་ ཚད་རྒྱུ་དངོས་ཚུ་ "width" དང་ "height" གནས་གོང་ཚུ་ལུ་གཞི་བཞགཔ་ཨིན། རྒྱུ་དངོས་འདི་ "Margin" ཤོག་ལེབ་ཀྱི་ཟུར་ཆ་མཉམ་གུ་ས་སྟོང་ཚུ་འདྲ་མཉམ་གཞི་སྒྲིག་འབདཝ་ཨིན།  ས་སྟོང་སོ་སོ་བཅུག་ནི་ལུ་ "Margin-Left", "Margin-Right", "Margin-Top" དང་ "Margin-Bottom" རྒྱུ་དངོས་ཚུ་ལག་ལེན་འཐབ་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000020.xhp	0	help	par_id3147530				0	dz	དེ་ཚུ་ལུ་ཀེར་ཐིག་མེད་པ་ཅིན་ ཚིག་ཡིག་གཞི་ཁྲམ་ཚུ་ "<SPAN>" or "<DIV>" ངོ་རྟགས་སྦེ་ཕྱིར་འདྲེན་འབདཝ་ཨིན།  དེ་ཚུ་ལུ་ཀེར་ཐིག་མེད་པ་ཅིན་ དེ་ཚུ་ "<MULTICOL>"སྦེ་ཕྱིར་འདྲེན་འབདཝ་ཨིན།				2002-02-02 02:02:02
