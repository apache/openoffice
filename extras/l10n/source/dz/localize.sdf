helpcontent2	source\text\simpress\02\10100000.xhp	0	help	par_id3148604				0	dz	ཁྱོད་ཀྱིས་མཐུད་བྱེད་ཨེབ་གཏང་ཞིནམ་དང་ མ་བཀང་བའི་དངོས་པོ་གི་མཐའམ་ཡང་ན་ ལྟེམས་ལྟེམས་གང་ཡོད་པའི་དངོས་པོ་གི་ལྟག་ལུ་ཁྱོད་ཀྱི་མཱའུསི་དཔག་བྱེད་སྤོ་བཤུད་འབདཝ་ད་ མཐུད་མཚམས་འབྱུང་ནི་ཨིན། མཐུད་མཚམས་འདི་ཁྱོད་ཀྱིས་མཐུད་བྱེད་གྲལ་ཐིག་མཉམ་སྦྲགས་འབད་ཚུགས་མི་གི་གཏན་བཟོས་ས་ཚིགས་ཨིན། ཁྱོད་ལུ་དགོ་པ་ཅིན་ ཁྱོད་ཀྱིས་དངོས་པོ་ལུ་ \<link href=\"text/simpress/02/10030200.xhp\" name=\"glue point\"\>གུ་ལུ་པོའིནཊི་ཟེར་མི་སྲོལ་སྒྲིག་མཐུད་མཚམས་ཁ་སྐོང་རྐྱབ་ཚུགས།\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\simpress\02\10100000.xhp	0	help	par_id3154762				0	dz	མཐུད་བྱེད་གྲལ་ཐིག་འབྲི་ནི་ལུ་ དངོས་པོ་གུ་གི་མཐུད་མཚམས་ཨེབ་གཏང་ དངོས་པོ་གཞན་ལུ་མཐུད་མཚམས་ལུ་འདྲུད་ཞིནམ་དང་ དེ་ལས་གཏང་། ཁྱོད་ཀྱིས་ཡང་ཁྱོད་ཀྱི་ཡིག་ཆ་གི་སྟོངམ་ཡོད་ས་ལུ་འདྲུད་ཞིནམ་དང་ཨེབ་གཏང་ཚུགས། ཁྱོད་ཀྱིས་གནས་ཁོངས་སོ་སོ་ལུ་མཇུག་འདི་མ་འདྲུད་ཚུན་ཚོད་ མཐུད་བྱེད་ཀྱི་མཉམ་སྦྲགས་མ་འབད་བའི་མཇུག་ས་གནས་ནང་ལྡེ་མིག་རྐྱབས་ཨིན། མཐུད་བྱེད་ཁ་འཕྱེལ་ནི་ལུ་ ཡང་ཅིན་གནས་ཁོངས་སོ་སོ་ལུ་མཐུད་བྱེད་གྲལ་ཐིག་འདི་གི་མཇུག་འདྲུད་ད།				2002-02-02 02:02:02
