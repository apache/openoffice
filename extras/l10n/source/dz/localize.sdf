helpcontent2	source\text\shared\01\02230200.xhp	0	help	par_id3152425				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<link href=\"text/shared/optionen/01060600.xhp\" name=\"Tools - Options - Writer - Changes\"\>\<emph\>Tools - Options - %PRODUCTNAME Writer - Changes\</emph\>\</link\>གདམ་ཁ་བརྐྱབ་སྟེ་  རྟགས་བཀོད་པའི་ཆ་ཤས་ཚུ་གི་རྒྱུ་དངོས་བཀྲམ་སྟོན་འདི་  ཁྱོད་ཀྱིས་བསྒྱུར་བཅོས་འབད།  \</caseinline\>\</switchinline\>\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>\<link href=\"text/shared/optionen/01060600.xhp\" name=\"Tools - Options - Calc - Changes\"\>\<emph\>ལག་ཆས་ཚུ་ - གདམ་ཁ་ཚུ་ - %PRODUCTNAME Calc - བསྒྱུར་བཅོས་ཚུ།\</emph\>\</link\>. \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02230200.xhp	0	help	par_id3155356				0	dz	མཱའུསི་དཔག་བྱེད་འདི་  ཁྱོད་ཀྱིས་  ཡིག་ཆ་གི་ནང་གི་རྟགས་བསྒྱུར་བཅོས་གུ་ ངལ་འཚོ་འབདཝ་ད་  \<emph\>ཕན་བསླབ་\</emph\>གིས་  བསྒྱུར་བཅོས་བཟོ་ཡོད་པའི་རྩོམ་པ་པོ་དང་ཚེས་གྲངས་དེ་ལས་ཆུ་ཚོད་འདི་བཀྲམ་སྟོན་འབདཝ་ཨིན།  \<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\> If the \<emph\>རྒྱ་བསྐྱེད་ཕན་བསླབ་\</emph\>ཤུགས་ལྡན་བཟོ་ཡོད་པ་ཅིན་  བསྒྱུར་བཅོས་དང་མཉམ་སྦྲག་འབད་ཡོད་པའི་བརྡ་བཀོད་ཚུ་བཀྲམ་སྟོན་འབདཝ་ཨིན།\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
