helpcontent2	source\text\shared\01\02220000.xhp	0	help	par_id3159194				0	dz	\<variable id=\"imagemaptext\"\>\<ahelp hid=\"SVX:FLOATINGWINDOW:RID_SVXDLG_IMAP\"\>ཚད་རིས་ཡང་ན་ཚད་རིས་ཀྱི་སྡེ་ཚན་གུ་ འཁྱམས་གནས་ཟེར་མི་ དམིགས་བསལ་གྱི་མངའ་ཁོངས་ལུ་  ཡུ་ཨར་ཨེལ་འདི་མཉམ་སྦྲག་འབད་བཅུགསཔ་ཨིན།  གཟུགས་བརྙན་ས་ཁྲ་འདི་  འཁྱམས་གནས་གཅིག་དང་མངམ་གྱི་སྡེ་ཚན་ཨིན།\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02220000.xhp	0	help	par_id3149751				0	dz	ཁྱོད་ཀྱིས་   འཁྱམས་གནས་ཀྱི་དབྱེ་བ་གསུམ་འབྲི་བཏུབ་ཨིན་: གྲུ་བཞི་ནར་ནོ་ དང་ སྒོང་དབྱིབས་ དེ་ལས་  ཟུར་མང་དབྱིབས་ཚུ་ཨིན།  ཁྱོད་ཀྱིས་འཁྱམས་གནས་གུ་ཨེབ་གཏངམ་ད་  ཡུ་ཨར་ཨེལ་འདི་  བརྡ་འཚོལ་སྒོ་སྒྲིག་ཡང་ན་  ཁྱོད་ཀྱིས་  གསལ་བཀོད་འབད་ཡོད་པའི་ གཞི་ཁྲམ་ནང་ལུ་ཁ་ཕྱེཝ་ཨིན།  གཞན་ཡང་  ཁྱོད་ཀྱི་མཱའུསི་འདི་འཁྱམས་གནས་གུ་ངལ་འཚོ་བའི་བསྒང་  འབྱུང་མི་ཚིག་ཡིག་འདི་ཡང་  ཁྱོད་ཀྱིས་གསལ་བཀོད་འབད་བཏུབ་ཨིན། 				2002-02-02 02:02:02
