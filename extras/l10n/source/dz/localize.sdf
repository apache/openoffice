helpcontent2	source\text\swriter\01\04150000.xhp	0	help	par_id3149355				0	dz	\<variable id=\"tabelletext\"\>\<ahelp hid=\".uno:InsertTable\"\>དེ་གིས་ ཐིག་ཁྲམ་དེ་ཡིག་ཆའི་ནང་ལུ་བཙུགསཔ་ཨིན། ཁྱོད་ཀྱིས་ མདའ་རྟགས་དེ་ལུ་ཡང་ཨེབ་གཏང་འབད་ནི་དང་ ཐིག་ཁྲམ་ནང་ལུ་བཙུགས་ནིའི་དོན་ལུ་ གྲལ་ཐིག་དང་ཀེར་ཐིག་ཚུ་སེལ་འཐུའབད་ནིའི་དོན་ལུ་འདྲུད་ཞིནམ་ལས་ དེ་ལས་ མཇུག་གི་ནང་ཐིག་ལུ་ཨེབ་གཏང་འབད།\</ahelp\>\</variable\>				2002-02-02 02:02:02
