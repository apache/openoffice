helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3150870				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Automatically creates a numbered list when you press Enter at the end of a line that starts with a number followed by a period, a space, and text. If a line starts with a hyphen (-), a plus sign (+), or an asterisk (*), followed by a space, and text, a bulleted list is created when you press Enter. \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3146874				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>ཨང་བཏགས་བཀལ་ནི་གི་བརྡ་རྟགས་དང་བཅས་གྲལ་ཐིག་གཅིག་གི་མཇུག་ལུ་  ཁྱོད་ཀྱིས་  བཙུགས་ཟེར་མི་འདི་ཨེབ་གཏང་འབད་བའི་བསྒང་  རང་བཞིན་གྱི་ཨང་བཏགས་བཀལ་ནི་འདི་  ཆ་མེད་གཏང་ནི་དོན་ལུ་  བཙུགས་ཟེར་མི་འདི་ལོག་འདི་རང་ ཨེབ་ད། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3145606				0	dz	རང་བཞིན་གྱི་ཨང་བཏགས་ནིའི་ གདམ་ཁ་འདི་ཚུ་ "Default", "Text body", ཡང་ན་ "Text body indent" དོན་མཚམས་ཀྱི་བཟོ་རྣམ་གཅིག་ཁར་  རྩ་སྒརིག་འབད་ཡོད་པའི་  དོན་མཚམས་ཚུ་ལུ་ རྐྱངམ་ཅིག་འཇུག་སྤྱོད་འབདཝ་ཨིན།				2002-02-02 02:02:02
