helpcontent2	source\text\shared\optionen\01130200.xhp	0	help	par_id3150670	4			0	dz	\<ahelp visibility=\"visible\" hid=\"HID_OFAPAGE_MSFLTR2_CLB\"\>ཐོ་ཡིག་སྒྲོམ་གྱི་ས་སྒོ་\<emph\> འདི་གིས་ \</emph\>མའི་ཀོརོ་སོཕཊི་རྩ་སྒྲིག་ (ཨེསི་) ནང་ལུ་སྲུང་བཞག་འབདཝ་ད་དང་ $[officename] (ཨེལ་)ནང་ལུ་མངོན་གསལ་འབདཝ་ད་གཞི་བསྒྱུར་འབད་ཚུགས་ནི་ཨིན་མི་ཨོ་ཨེལ་ཨི་དངོས་པོ་ཟུང་གི་དོན་ལུ་ཐོ་བཀོད་ཚུ་བཀྲམ་སྟོན་འབདཝ་ཨིན།  \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01130200.xhp	0	help	par_id3154286				0	dz	མའི་ཀོརོ་སོཕཊི་ཡིག་ཆ་འདི་ $[officename] ནང་ལུ་མངོན་གསལ་འབདཝ་ད་ མའི་ཀོརོ་སོཕཊི་ཨོ་ཨེལ་ཨི་དངོས་པོ་འདི་གསལ་བཀོད་འབད་ཡོད་པའི་$[officename] དངོས་པོ་ནང་ལུ་གཞི་བསྒྱུར་འབད་ནི་ཨིན་པ་ཅིན་ ཐོ་བཀོད་ཀྱི་གདོང་ཁར་ [L] ཀེར་ཐིག་ནང་སྒྲོམ་རྟགས་བཀལ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01130200.xhp	0	help	par_id3153880				0	dz	ཡིག་ཆ་འདི་མའི་ཀོརོ་སོཕཊི་ཡིག་སྣོད་རྩ་སྒྲིག་ནང་སྲུང་བཞག་འབདཝ་ད་ $[officename] ཨོ་ཨེལ་ཨི་དངོས་པོ་འདི་ གསལ་བཀོད་འབད་ཡོད་པའི་མའི་ཀོརོ་སོཕཊི་ཨོ་ཨེལ་ཨི་དངོས་པོ་ནང་ལུ་གཞི་བསྒྱུར་འབད་ནི་ཨིན་པ་ཅིན་ ཐོ་བཀོད་ཀྱི་གདོང་ཁར་ [S] ཀེར་ཐིག་ནང་སྒྲོམ་རྟགས་བཀལ།				2002-02-02 02:02:02
