helpcontent2	source\text\shared\01\05020700.xhp	0	help	bm_id3155620				0	dz	\<bookmark_value\>ཨེ་ཤི་ཡན་དཔར་བསྐྲུན་རིག་པ་\</bookmark_value\>\<bookmark_value\>རྩ་སྒྲིག་ཚུ་; ཨེ་ཤི་ཡན་དཔར་བསྐྲུན་རིག་པ་\</bookmark_value\>\<bookmark_value\>དོན་མཚམས་ཚུ་; ཨེ་ཤི་ཡན་དཔར་བསྐྲུན་རིག་པ་\</bookmark_value\>\<bookmark_value\>ཚིག་ཡིག་; ཨེ་ཤི་ཡན་དཔར་བསྐྲུན་རིག་པ་\</bookmark_value\>\<bookmark_value\>དཔར་བསྐྲུན་རིག་པ་; ཨེ་ཤི་ཡན།\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020700.xhp	0	help	hd_id3155620				0	dz	\<link href=\"text/shared/01/05020700.xhp\" name=\"Asian Typography\"\>ཨེ་ཤི་ཡན་དཔར་བསྐྲུན་རིག་པ།\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020700.xhp	0	help	par_id3153124				0	dz	\<ahelp hid=\".\"\>ཨེ་ཤི་ཡཱན་སྐད་ཡིག་ཡིག་སྣོད་ཚུ་ནང་  ནང་ཐིག་ཡང་ན་དོན་མཚམས་ཀྱི་དོན་ལུ་  དཔར་བསྐྲུན་རིག་པའི་གདམ་ཁ་ཚུ་གཞི་སྒྲིག་འབད།  ཨེ་ཤི་ཡཱན་སྐད་ཡིག་རྒྱབ་སྐྱོར་ལྕོགས་ཅན་བཟོ་ནི་ལུ་   \<emph\>ལག་ཆས་ཚུ་ - གདམ་ཁ་ཚུ་ - སྐད་ཡིག་སྒྲིག་སྟངས་ཚུ་ - སྐད་ཡིག་ཚུ་\</emph\>གདམ་ཁ་བརྐྱབ་ནི་དང་  དེ་ལས་   \<emph\>ཨེ་ཤི་ཡཱན་སྐད་ཡིག་རྒྱབ་སྐྱོར་ཚུ་ \</emph\>མངའ་ཁོངས་ནང་གི་ \<emph\>ལྕོགས་ཅན་བཟོ་ཡོདཔ་\</emph\>\</ahelp\>སྒྲོམ་འདི་སེལ་འཐུ་འབད།				2002-02-02 02:02:02
