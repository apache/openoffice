helpcontent2	source\text\shared\02\14020100.xhp	0	help	par_id3156042				0	dz	\<ahelp hid=\"HID_JOINSH_ADDTAB_TABLELIST\"\>འཐོབ་ཚུགས་པའི་ཐིག་ཁྲམ་ཚུ་ ཐོ་བཀོད་འབདཝ་ཨིན། \</ahelp\> ཐིག་ཁྲམ་ཅིག་བཙུག་དགོ་པ་ཅིན་ ཐོ་ཡིག་ནང་ལས་གཅིག་སེལ་འཐུ་འབད་ཞིནམ་ལས་ \<emph\>ཁ་སྐོང་\</emph\>ལུ་ཨེབ་གཏང་འབད། དེ་མ་ཚད་ཁྱོད་ཀྱིས་ ཐིག་ཁྲམ་མིང་གུ་ཨེབ་གཏང་ཚར་གཉིས་འབད་བཏུབ་དང་ སྒོ་སྒྲིག་འདི་ཐིག་ཁྲམ་ས་སྒོ་ཚུ་དང་བཅས་ འདྲི་དཔྱད་བཀོད་སྒྲིག་ ཡང་ན་ མཐུན་འབྲེལ་སྒོ་སྒྲིག་གི་མགུ་ལུ་ བཀྲམ་སྟོན་འབད་འོང་།				2002-02-02 02:02:02
