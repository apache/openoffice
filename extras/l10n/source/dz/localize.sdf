helpcontent2	source\text\shared\autopi\webwizard02.xhp	0	help	par_idN1055E				0	dz	\<ahelp hid=\"34210\"\>ཁྱོད་ཀྱིས་ཁྱོད་རའི་ཝེབ་ས་ཁོངས་ལུ་པར་བསྐྲུན་འབད་ནི་ཨིན་མི་ཡིག་ཆ་ཚུ་ ཐོ་བཀོད་འབདཝ་ཨིན། ཝི་ཛརཌི་གིས་ %PRODUCTNAME ཡི་གཆ་ཚུ་ ཨེཅ་ཊི་ཨེམ་ཨེལ་དང་པི་ཌི་ཨེཕ་ལུ་གཞི་སྒྱུར་འབད་བཏུབ་དང་ ཡང་ན་ གནད་དོན་གཞན་ཡང་ ཡིག་ཆ་ཚུ་སྐྱེལ་བཙུགས་མ་འབད་བའི་ཧེ་མ་ རྩ་སྒྲིག་རིབ་སྟོན་འབད་བཏུབ། གཞན་ཡིག་སྣོད་ཚུ་ཆ་མཉམ་ར་ ཁོང་རའི་ཡིག་སྣོད་རྩ་སྒྲིག་ངོ་མ་ནང་ སྐྱེལ་བཙུགས་འབདཝ་ཨིན། \</ahelp\>				2002-02-02 02:02:02
