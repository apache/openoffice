helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3149205				0	dz	\<ahelp hid=\"HID_HANGULDLG_EDIT_NEWWORD\"\>ཧེ་མའི་ཚབ་མ་གི་བསམ་འཆར་འདི་ཚིག་མཛོད་ལས་བཀྲམ་སྟོན་འབདཝ་ཨིན།  \</ahelp\> ཁྱོད་ཀྱིས་  བསམ་ཡོད་པའི་མིང་ཚིག་འདི་  ཞུན་དག་འབད་རུང་  ཡང་ན་  མིང་ཚིག་གཞན་ཐོ་བཀོད་འབད་རུང་བཏུབ་ཨིན།   ཆ་མཉམ་པའི་ཚབ་མའི་མིང་ཚིག་དང་བཅས་  ཁྱོད་རའི་མིང་ཚིག་ངོ་མ་འདི་ཚབ་བཙུགས་ནི་ལུ་  \<emph\>འཚོལ་\</emph\>ཨེབ་རྟ་འདི་གུ་ཨེབ་གཏང་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	hd_id3154673				0	dz	འཚོལ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3156560				0	dz	\<ahelp hid=\"SVX_PUSHBUTTON_RID_SVX_MDLG_HANGULHANJA_PB_FIND\"\>ཁྱོད་ཀྱི་ཧེན་གུལ་ཨིན་པུཊི་འདི་  ཚིག་མཛོད་ནང་ལས་འཚོལ་འཐོབ་ནི་དང་  ཆ་མཉམ་པའི་ཧེན་ཇ་དང་བཅས་ཚབ་བཙུགས་འབདཝ་ཨིན།   འཚོལ་བའི་ལས་འགན་འདི་ ཆ་མེད་གཏང་ནི་དོན་ལུ་\</ahelp\> \<emph\>སྣང་མེད་བཞག་ལུ་ཨེབ་གཏང་འབད།\</emph\> 				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	hd_id3147291				0	dz	བསམ་འཆར་ཚུ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3154823				0	dz	\<ahelp hid=\"SVX_LISTBOX_RID_SVX_MDLG_HANGULHANJA_LB_SUGGESTIONS\"\>ཚིག་མཛོད་ནང་ལུ་  འཐོབ་ཚུགས་པའི་ཚབ་མ་ཚུ་ཆ་མཉམ་རང་བཀྲམ་སྟོན་འབདཝ་ཨིན། \</ahelp\> ག་དེམ་ཅིག་འབད་ \<emph\>ཡིག་འབྲུ་གིས་འབད་ཚབ་ཀྱི་\</emph\> སྒྲོམ་འདི་ལྕོགས་ཅན་བཟོ་ཡོད་པ་ཅིན་   ཁྱོད་ཀྱིས་ཡིག་འབྲུ་གི་གིརིཌི་འདི་མཐོངམ་ཨིན།   ག་དེམ་ཅིག་འབད་\<emph\>ཡིག་འབྲུ་གིས་ཚབ་མའི་\</emph\> སྒྲོམ་འདི་ཞིབ་དཔྱད་མ་འབད་བར་ཡོད་པ་ཅིན་  ཁྱོད་ཀྱིས་མིང་ཚིག་གི་ཐོ་ཡིག་ཅིག་མཐོངམ་ཨིན།				2002-02-02 02:02:02
