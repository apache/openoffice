helpcontent2	source\text\shared\optionen\01041000.xhp	0	help	par_id3155602				0	dz	\<ahelp hid=\"SW_CHECKBOX_TP_OPTLOAD_PAGE_CB_PRINTER_METRICS\"\>དཔར་འཕྲུལ་མེ་ཊིཀ་ཚུ་དཔར་བསྐྲུན་འབད་ནིའི་དོན་ལས་དང་ ཡང་ གསལ་གཞི་གུ་བཀྲམ་སྟོན་རྩ་སྒྲིག་འབད་ནིའི་དོན་ལས་འཇུག་སྤྱོད་འབདཝ་ཨིནམ་གསལ་བཀོད་འབདཝ་ཨིན།\</ahelp\> ཨ་ནི་སྒྲོམ་འདི་ཞིབ་དཔྱད་མ་འབད་བ་ཅིན་ དཔར་འཕྲུལ་རང་དབང་སྒྲིག་བཀོད་འདི་གསལ་གཞི་བཀྲམ་སྟོན་དང་དཔར་བསྐྲུན་གྱི་དོན་ལས་ལག་ལེན་འཐབ་འོང་།				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01041000.xhp	0	help	par_id3155768				0	dz	ཁྱོད་ཀྱིས་ཨ་ནི་གདམ་ཁ་འདི་ད་ལྟོའི་ཡིག་ཆ་གི་དོན་ལས་གཞི་སྒྲིག་འབད་བ་ཅིན་དང་དེ་ལས་ཡིག་ཆ་སྲུང་བཞག་འབད་བ་ཅིན་ དཔེར་ན་ ཟུང་ལྡན་རྩ་སྒྲིག་གོ་རིམ་ནང་ ཨ་ནི་གདམ་ཁ་འདི་སྲུང་བཞག་མི་འབད། ཁྱོད་ཀྱིས་ཤུལ་ལས་རྩ་སྒྲིག་རྙིངམ་ལས་ཡིག་སྣོད་ཁ་ཕྱེ་བ་ཅིན་ ཨ་ནི་གདམ་ཁ་འདི་སྔོན་སྒྲིག་གིས་གཞི་སྒྲིག་འབད་འོང་།				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01041000.xhp	0	help	hd_id3145640				0	dz	(ད་ལྟོའི་ཡིག་ཆ་ནང་) དོན་མཚམས་ཚུ་དང་ཐིག་ཁྲམ་ཚུའི་བར་ན་བར་སྟོང་བཞག་ཐངས་ཁ་སྐོང་རྐྱབས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01041000.xhp	0	help	par_id3147339				0	dz	$[officename] རྩོམ་འབྲི་པ་ནང་ དོན་མཚམས་བར་སྟོང་བཞག་ཐངས་འདི་ཨེམ་ཨེསི་མིང་ཚིག་ཡིག་ཆ་ཚུ་ནང་ཡོད་མི་ལས་སོ་སོ་སྦེ་ངེས་འཛིན་འབདཝ་ཨིན། ཁྱོད་ཀྱིས་དོན་མཚམས་གཉིས་ཡང་ན་ཐིག་ཁྲམ་ཚུའི་བར་ན་ངེས་འཛིན་འབད་ཡོད་པ་ཅིན་བར་སྟོང་བཞག་ཐངས་འདི་ཡང་ཆ་མཉམ་ནིའི་ཨེམ་ཨེསི་མིང་ཚིག་ཡིག་ཆ་ཚུ་ནང་ཁ་སྐོང་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01041000.xhp	0	help	par_id3151250				0	dz	\<ahelp hid=\"SW:CHECKBOX:TP_OPTLOAD_PAGE:CB_MERGE_PARA_DIST\"\> $[officename] རྩོམ་འབྲི་པའི་ཚིག་ཡིག་ཡིག་ཆ་ཚུ་ནང་དོན་མཚམས་ཚུ་དང་ཐིག་ཁྲམ་ཚུའི་བར་ན་ཨེམ་ཨེསི་མིང་ཚིག་མཐུན་འགྱུར་ཅན་གྱི་བར་སྟོང་བཞག་ཐངས་ཁ་སྐོང་འབད་ནི་ཨིན་ན་གསལ་བཀོད་འབདཝ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
