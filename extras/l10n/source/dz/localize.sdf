helpcontent2	source\text\shared\01\01160300.xhp	0	help	par_id3148668				0	dz	\<variable id=\"globtext\"\>\<ahelp hid=\"HID_SEND_MASTER_CTRL_PUSHBUTTON_CANCEL\"\>ད་ལྟོའི་རྩོམ་འབྲི་པའི་ཡིག་ཆ་ལས་  ཡིག་ཆའི་ཨམ་འདི་གསར་བསྐྲུན་འབདཝ་ཨིན།  ཡན་ལག་ཡིག་ཆ་གསརཔ་འདི་  འབྱུང་ཁུངས་ཡིག་ཆ་ནང་ལུ་  དོན་མཚམས་བཟོ་རྣམ་  'Heading 1' གི་འབྱུང་སྣང་རེ་ལུ་གསར་བསྐྲུན་འབད་དེ་ཡོདཔ་ཨིན།  \</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01160300.xhp	0	help	par_id3149999				0	dz	\<link href=\"text/shared/01/02110000.xhp\" name=\"Navigator\"\>\<emph\>འགྲུལ་བསྐྱོདཔ་\</emph\>\</link\>འདི་  ཁྱོད་ཀྱིས་  ཡིག་ཆའི་ཨམ་ཅིག་གསར་བསྐྲུན་འབད་བའི་ཤུལ་ལུ་འབྱུངམ་ཨིན།  ཡན་ལག་ཡིག་ཆ་འདི་ཞུན་དག་འབད་ནི་དོན་ལུ་  \<emph\>འགྲུལ་བསྐྱོདཔ་\</emph\>ནང་གི་  ཡན་ལག་ཡིག་ཆའི་མིང་འདི་ལུ་ཨེ་གཏང་ཐེང་གཉིས་ཨེབ་ད།				2002-02-02 02:02:02
