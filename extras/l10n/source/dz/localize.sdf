helpcontent2	source\text\shared\02\12100200.xhp	0	help	par_id3150982				0	dz	\<ahelp hid=\"HID_SEARCH_REGULAR\"\>དུས་རྒྱུན་བརྗོད་པའི་ཐོག་ལས་འཚོལ་ཞིབ་འབདཝ་ཨིན། \</ahelp\> ནཱ་ལུ་རྒྱབ་སྐྱོར་འབད་དེ་ཡོད་པའི་ཅོག་འཐད་པའི་དུས་རྒྱུན་བརྗོད་པ་ཚུ་ \<item type=\"productname\"\>%PRODUCTNAME\</item\>\<link href=\"text/shared/01/02100000.xhp\" name=\"Find & Replace dialog\"\>འཚོལ་ཏེ་སྦྱར་བའི་ཌའི་ལོག་\</link\>ནང་ལུ་ཡང་རྒྱབ་སྐྱོར་འབད་ཡི།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12100200.xhp	0	help	par_id3154718				0	dz	དུས་རྒྱུན་བརྗོད་པའི་ཐོག་ལས་འཚོལ་ཞིབ་འབད་མི་འདི་བ་ཡང་ ཝའིལ་ཀརཌི་ཐོག་ལས་འཚོལ་ཞིབ་འབད་མི་འདི་གིས་ ལེ་ཤ་བྱིནམ་ཨིན། དུས་རྒྱུན་བརྗོད་པའི་ཐོག་ལས་འཚོལ་ཞིབ་འབད་བ་ཅིན་ འོག་གི་ཡིག་འབྲུ་ཚུ་ ཝའིལ་ཀརཌིསི་ཐོག་ལས་འཚོལ་ཞིབ་ནང་ལགལེན་འཐབ་ཡོད་མི་དང་ཆ་མཉམ་ཨིན་:				2002-02-02 02:02:02
