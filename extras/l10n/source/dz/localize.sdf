helpcontent2	source\text\shared\guide\dragdrop_table.xhp	0	help	par_id3152780	32			0	dz	\<switchinline select=\"sys\"\>\<caseinline select=\"WIN\"\>ཡིག་ཆ་ཚུ་ གཅིག་གིས་གཅིག་གི་སྦོ་ལོགས་ཁར་མ་མཐོང་པ་ཅིན་ དང་པ་ར་ མཱའུསི་དཔག་བྱེད་འདི་ འགྲོ་ཡུལ་ཡིག་ཆ་ཨེབ་གཏང་ལུ་འདྲུད། མཱའུསི་ཨེབ་རྟ་འདི་ འཕྲོ་མཐུད་དེ་མར་ལུ་བཟུང་། ཡིག་ཆ་འདི་བཀྲམ་སྟོན་འབད་ཡོདཔ་དང་ ཡིག་ཆའི་ནང་འཁོད་ལུ་ མཱའུསི་དཔག་བྱེད་འདི་ སྤོ་བཤུད་འབད་བཏུབ། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
