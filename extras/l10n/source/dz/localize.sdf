helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3148649				0	dz	\<ahelp hid=\"HID_PROP_HELPURL\"\>ཚིག་ཡིག་གི་ཡིག་ཆ་ལུ་འབྲེལ་བསྟུན་འབད་མི་དང་ ཚད་འཛིན་ས་སྒོ་གི་་གྲོགས་རམ་ལུ་བརྟེན་བོད་བརྡ་འབད་བཏུབ་པའི་  ཡུ་ཨར་ཨེལ་ཡིག་སྡེབ་ནང་ རུ་ཚན་གྱི་ཁ་ཡིག་ཅིག་གསལ་བཀོད་འབདཝ་ཨིན། \</ahelp\> ལག་ལེན་པ་འདི་གིས་ ཨེཕ་ ༡་ མནན་ནི་དང་ ཡང་ན་ ཆེད་དམིགས་འདི་ ཚད་འཛིན་ས་སྒོ་གུར་ གནས་ས་བཙུགས་ཏེ་ཡོད་པ་ཅིན་ ཚད་འཛིན་ས་སྒོའི་གྲོགས་རམ་གྱི་དོན་ལུ་  གྲོགས་རམ་འདི་གྲོགས་རམ་དེ་ཁ་ཕྱེ་བཏུབ།				2002-02-02 02:02:02
