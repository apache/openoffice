helpcontent2	source\text\shared\explorer\database\02000000.xhp	0	help	par_id3150499				0	dz	"query"ཟེར་མི་འདི་ཐིག་ཁྲམ་གྱི་  དམིགས་གསལ་མཐོང་སྣང་ཅིག་ཨིན།  འདྲི་དཔྱད་ཚུ་གིས་  དྲན་ཐོ་ལ་ལོ་ཅིག་བཀྲམ་སྟོན་འབད་ནི་དང་  ཡང་ན་  དྲན་ཐོ་རེ་ལུ་  ས་སྒོ་དག་པ་ཅིག་རྐྱངམ་ཅིག་  བཀྲམ་སྟོན་འབད་ནི་དང་   དགོས་ཁོ་ཡོད་པ་ཅིན་  དྲན་ཐོ་དེ་ཚུ་ཡང་  དབྱེ་སེལ་འབད་བཏུབ།  དེ་ཚུ་མཐུན་མོང་གནད་སྡུད་ས་སྒོ་ཚུ་གིས་  འབྲེལ་མཐུད་འབད་དེ་ཡོད་པ་ཅིན་  འདྲི་དཔྱད་དེ་གིས་  ཐིག་ཁྲམ་ཅིག་ལས་ལྷག་སྟེ་  ཐིག་ཁྲམ་སྣ་མང་ལུ་ འཇུག་སྤྱོད་འབད་བཏུབ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\02000000.xhp	0	help	par_id3147399				0	dz	འདྲི་དཔྱད་འདི་  ཁྱད་ཚད་ལ་ལོ་ཅིག་གུ་གཞི་བཞག་ཡོད་པའི་  གནད་སྡུད་ཐིག་ཁྲམ་ལས་  དྲན་ཐོ་འཚོལ་ནི་ལུ་ལག་ལེན་འཐབ་ཨིན།  གནད་སྡུད་གཞི་རྟེན་གྱི་དོན་ལས་  གསར་བསྐྲུན་འབད་མི་འདྲི་དཔྱད་ཚུ་ཆ་མཉམ་རང་  \<emph\>འདྲི་དཔྱད་ཚུ་\</emph\>ཐོ་བཀོད་་ཀྱི་འོག་ལུ་དྲན་ཐོ་་འབད་དེ་ཡོད།  ཐོ་བཀོད་དེ་གི་ནང་ལུ་  གནད་སྡུད་གཞི་རྟེན་འདྲི་དཔྱད་ཡོདཔ་ལས་    "query container" ཟེར་སླབ་ཨིན།				2002-02-02 02:02:02
