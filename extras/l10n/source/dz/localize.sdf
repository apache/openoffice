helpcontent2	source\text\swriter\01\05130004.xhp	0	help	par_id3149501				0	dz	ཀྱོད་ཀྱིས་ ནཱ་ལུ་ཨང་གྲངས་བཏགས་ནིའི་བཟོ་རྣམ་ཅིག་གསར་བསྐྲུན་འབད་ཚུགས། ཨང་གྲངས་བཏགས་ནིའི་བཟོ་རྣམ་ཚུ་ \<link href=\"text/swriter/01/05140000.xhp\" name=\"Styles and Formatting\"\>བཟོ་རྣམ་ཚི་དང་ རྩ་སྒྲིག་འབད་ནི་\</link\>སྒོ་སྒྲིག་ནང་ལུ་གོ་རིམ་བསྒྲིག་སྟེ་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05130004.xhp	0	help	par_id3151390				0	dz	ཨང་གྲངས་བཏགས་ནིའི་བཟོ་རྣམ་འདི་གསར་བསྐྲུན་འབད་ཚར་བའི་སྐབས་ལུ་ མིང་ཅིག་ཨང་གྲངས་བཏགས་ནི་ལུ་འགན་སྤྲོད་འབདཝ་ཨིན། དེ་འབད་ནི་དེ་གིས་ དེ་བཟུམ་མའི་ཊེམ་པེ་ལེཊི་ཚུ་"named" ཨང་གྲངས་བཏགས་ནི་ཟེར་སླབ་ཨིན། \<link href=\"text/shared/00/00000005.xhp#formatierung\" name=\"direct formatting\"\>ཐད་དཀར་དུ་རྩ་སྒྲིག་འབད་ནི་\</link\>གི་དོན་ལུ་ལག་ལེན་འཐབ་ཡོད་མི་ མིང་མ་བཏགས་པར་ཡོད་མི་ཨང་གྲངས་བཏགས་ནི་དེ་ \<link href=\"text/shared/01/06050000.xhp\" name=\"Numbering/bullets\"\>མགོ་ཚགས་དང་ ཨང་གྲངས་བཏགས་ནི་\</link\> ཌའི་ལོག་ ཡང་ན་ དངོས་པོའི་ཕྲ་རིང་\<link href=\"text/swriter/main0206.xhp\" name=\"object bar\"\>གི་ངོས་དཔར་ཚུ་དང་གཅིག་ཁར་\</link\>གསར་བསྐྲུན་འབད་ཚུགས།				2002-02-02 02:02:02
