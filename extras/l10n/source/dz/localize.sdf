helpcontent2	source\text\shared\01\02220000.xhp	0	help	par_id3153190				0	dz	\<ahelp hid=\"HID_IMAPDLG_POLY\"\>ཚད་རིས་ནང་ལུ་  ཟུར་མང་དབྱིབས་འཁྱམས་གནས་ཅིག་འབྲིཝ་ཨིན།  ངོས་དཔར་དེ་གུ་ཨེབ་གཏང་བཞིནམ་ལས་  ཚད་རིས་ལུ་འདྲུད་ད་  དེ་ལས་  ཟུར་མང་དབྱིབས་གཅིག་ངེས་འཛིན་འབད་ནི་དོན་ལུ་  ཨེབ་གཏང་ད།  ཁྱོད་ཀྱིས་  ཤུལ་མའི་མཇུག་གི་ཟུར་འདི་ག་སྟེ་ལུ་སྤོ་བཤུད་འབད་ནི་ཨིན་ན་འདི་གུ་བཞག་ནི་དང་ ་དེ་ལས་ཨེབ་གཏང་ད།  ཟུར་མང་དབྱིབས་ཀྱི་ཟུར་ཚུ་ཆ་མཉམ་རང་  ཁྱོད་ཀྱིས་ མ་འབྲི་ཚུན་ཚོད་  ཡང་བསྐྱར་འབད།  ཁྱོད་ཀྱིས་འབད་ཚར་བའི་ཤུལ་ལས་  ཟུར་མང་དབྱིབས་འདི་ཁ་བསྡམས་ནི་དོན་ལུ་  ཨེབ་གཏང་ཐེང་གཉིས་ཨེབ་གཏང་ད།  འཁྱམས་གནས་དོན་ལུ་  ཁྱོད་ཀྱིས་  \<emph\>ཁ་བྱང་དང་ཚིག་ཡིག་\</emph\>ཐོ་བཀོད་འབད་བའི་ཤུལ་ལས་  ཁྱོད་ཀྱིས་  ཡུ་ཨར་ཨེལ་ཁ་ཕྱེ་དགོ་མི་ལུ་   \<emph\>གཞི་ཁྲམ་\</emph\>འདི་སེལ་འཐུ་འབད།\</ahelp\>				2002-02-02 02:02:02
