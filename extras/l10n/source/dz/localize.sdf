helpcontent2	source\text\swriter\01\05120200.xhp	0	help	par_id3149050				0	dz	\<variable id=\"spaltenbreitetext\"\>\<ahelp hid=\".uno:SetOptimalColumnWidth\"\>ནང་ཐིག་ཚུ་གི་ནང་དོན་ཚུ་མཐུན་སྒྲིག་འབད་ནི་ལུ་  རང་བཞིན་གྱིས་སྦེ་ཀེར་ཐིག་རྒྱ་ཚད་ཚུ་བདེ་སྒྲིག་བཟོཝ་ཨིན།\</ahelp\> ཀེར་ཐིག་གི་རྒྱ་ཚད་བསྒྱུར་བཅོས་འབད་མི་དེ་གིས་  ཐིག་ཁྲམ་གཞན་མི་ནང་གི་རྒྱ་ཚད་ལུ་མི་གནོད།  ཐིག་ཁྲམ་གྱི་རྒྱ་ཚད་དེ་གིས་  ཤོག་ལེབ་ཀྱི་རྒྱ་ཚད་འདི་ལྷག་མི་ཚུགས།\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05120200.xhp	0	help	par_id5611743				0	dz	བསྒྱུར་བཅོས་འདི་གིས་  སེལ་འཐུ་འབད་དེ་ཡོད་པའི་ནང་ཐིག་ཚུ་རྐྱངམ་ཅིག་ལུ་གནོདཔ་ཨིན།  ཁྱོད་ཀྱིས་ནང་ཐིག་ཚུ་ཅིག་ཁར་སེལ་འཐུ་འབད་བ་ཅིན་  ཁྱོད་ཀྱིས་སྣ་མང་ནང་ཐིག་ཚུ་གཅིག་གི་གཅིག་ལུ་བདེ་སྒྲིག་འབད་ཚུགས།				2002-02-02 02:02:02
