helpcontent2	source\text\shared\autopi\webwizard07.xhp	0	help	par_idN10570				0	dz	\<ahelp hid=\"34265\"\>ཁྱོད་ཀྱི་ཟུར་ཐོ་ཤོག་ལེབ་དང་ཡིག་སྣོད་ཚུ་ ཨེབ་བཙུགས་འབད་ཡོད་པའི་ཡིག་མཛོད་ཡིག་སྣོད་ནང་ལུ་ ཁ་སྐོང་འབདཝ་ཨིནམ་དང་ ཁྱོད་རའི་ཝེབ་ས་ཁོངས་ལུ་ ཡིག་སྣོད་སྐྱེལ་བཙུགས་འབདཝ་ཨིན། ཟུར་ཐོའི་ཤོག་ལེབ་འདི་ ཁྱོད་རང་གིས་གསལ་བཀོད་འབད་ཡོད་པའི་གནས་ཁོངས་ལུ་ སྲུངས་ཡི། གཞན་ཡིག་སྣོད་ཆ་མཉམ་ར་ ཟུར་ཐོའི་ཤོག་ལེབ་དང་ལྡན་པའི་སྣོད་ཐོའི་ནང་ "myWebsite"སྣོད་ཐོ་ལུ་ སྲུངས་ཡི། \</ahelp\>				2002-02-02 02:02:02
