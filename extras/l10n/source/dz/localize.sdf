helpcontent2	source\text\simpress\01\05100000.xhp	0	help	par_id3150439				0	dz	ཨིམ་པརསི་ནང་ལུ་ཡོད་མི་ \<item type=\"productname\"\>%PRODUCTNAME\</item\> བཟོ་རྣམ་དང་རྩ་སྒྲིག་འབད་ནི་སྒོ་སྒྲིག་དེ་གིས་  \<item type=\"productname\"\>%PRODUCTNAME\</item\> ལས་རིམ་གཞན་མི་ཚུ་དང་ཕྱདཔ་ད་སོ་སོ་སྦེ་བྱ་སྤྱོད་སྟོནམ་ཨིན། དཔེ་འབད་བ་ཅིན་ ཁྱོད་ཀྱིས་ \<emph\>ཚད་རིས་བཟོ་རྣམ་ཚུ་ \</emph\>གསར་བསྐྲུན་དང་ ཞུན་དག་ དེ་ལས་འཇུག་སྤྱོད་ཚུ་འབད་ཚུགས་ དེ་འབདཝ་ད་ ཁྱོད་ཀྱིས་ \<emph\>གསལ་སྟོན་བཟོ་རྣམ་ཚུ་\</emph\>རྐྱངམ་ཅིག་ཞུན་དག་འབད་ཚུགས།				2002-02-02 02:02:02
helpcontent2	source\text\simpress\01\05100000.xhp	0	help	par_id3146121				0	dz	ཁྱོད་ཀྱིས་བཟོ་རྣམ་ཞུན་དག་འབདཝ་ད་ བསྒྱུར་བཅོས་ཚུ་རང་བཞིན་གྱིས་ཁྱོད་ཀྱི་ཡིག་ཆ་ནང་བཟོ་རྣམ་འདི་དང་གཅིག་ཁར་རྩ་སྒྲིག་འབད་ཡོད་པའི་ཆ་ཤས་ཆ་མཉམ་ལུ་འཇུག་སྤྱོད་འབད་ཡོདཔ་ཨིན། ཁྱོད་ཀྱིས་དམིགས་བསལ་བཤུད་གུ་གི་བཟོ་རྣམ་ཚུ་དུས་མཐུན་མ་བཟོ་ནི་ངེས་བརྟན་ཨིན་པ་ཅིན་  \<link href=\"text/simpress/guide/masterpage.xhp\" name=\"master page\"\>བཤུད་ཀྱི་དོན་ལུ་\</link\> ཤོག་ལེབ་ཨམ་གསརཔ་གསར་བསྐྲུན་འབད།				2002-02-02 02:02:02
