helpcontent2	source\text\shared\02\06050000.xhp	0	help	par_id3147285				0	dz	\<ahelp hid=\".uno:DecrementLevel\"\>སེལ་འཐུ་གྲུབ་ཡོད་པའི་  དོན་མཚམས་དེ་  ཨང་བཏགས་ནི་  ཡང་ན་  འགོ་ཚག་གི་རིམ་པ་ཅིག་ནང་  གནས་རིམ་པ་གཅིག་ མར་ཕབ་འབདཝ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\06050000.xhp	0	help	par_id3149549	4			0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>The\<emph\> གནས་རིམ་གཅིག་མར་ཕབ་ \</emph\>ངོས་དཔར་འདི་\<emph\>འགོ་ཚག་དང་ཨང་བཏགས་ནི་\</emph\>ཕྲ་རིང་གུ་ཡོདཔ་ཨིན་, དེ་ཡང་ འོད་རྟགས་འདི་ཨང་བཏགས་ཅིག་ཡང་ན་འགོ་ཚག་གུ་སྒྲིགཔ་ད་བྱུང་མི་ཨིན། \</caseinline\>\<caseinline select=\"IMPRESS\"\>The \<emph\>མར་ཕབ་ནི་ \</emph\>ངོས་དཔར་འདི་ \<emph\>ཚིག་ཡིག་རྩ་སྒྲིག་འབད་ནི་མཐའ་ཐིག་མཐོང་སྣང་ནང་ལཱ་འབདཝ་ད་བྱུང་མི་ཨིན།\</emph\> ཕྲ་རིང་གུ་ཡོདཔ་ཨིན་, དེ་ཡང་ \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
