helpcontent2	source\text\shared\autopi\01010000.xhp	0	help	par_id3149669				0	dz	\<ahelp hid=\"HID_LTRWIZARD_CREATE\"\>ཁྱོད་ཀྱི་སེལ་འཐུ་དང་འཁྲིལ་བ་ཅིན་ ཝི་ཛརཌི་གིས་ ཡིག་ཆ་ཊེམ་པེལེཊི་གསརཔ་ཅིག་གསར་བསྐྲུན་འབད་ཞིནམ་ལས་ ཁྱོད་རའི་ཧརཌི་ཌིཀིསི་གུ་སྲུང་བཞག་འབདཝ་ཨིན། \</ahelp\> $[officename]གིས་ ཡོད་བཞིན་པའི་ཊེམ་པེལེཊིསི་ལུ་གཞི་བཞག་སྟེ་ "Untitled X"མིང་(ཨེགསི་འདི་ རིམ་མཐུད་ཨང་རྟགས་ལུ་གོཝ་ཨིན་)དང་གཅིག་ཁར་ ཡིག་ཆ་ཅིག་གསར་བསྐྲུན་འབད་ཞིནམ་ལས་ ལཱ་གི་མངའ་ཁོངས་གུ་བཀྲམ་སྟོན་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\01010000.xhp	0	help	par_id3144433				0	dz	གདམས་ཡོད་པའི་ཊེམ་པེལེཊི་དང་འཁྲིལ་ཏེ་ $[officename] གིས་ ཝི་ཛརཌི་ནང་སྒྲིག་སྟངས་ཚུ་སྲུང་བཞག་འབདཝ་ཨིན། སྒྲིག་སྟངས་ཚུ་ ཤུལ་ལས་ཁྱོད་ཀྱིས་ཝི་ཛརཌི་ཤུགས་ལྡན་བཟོ་བའི་སྐབས་ལུ་ སྔོན་སྒྲིག་སྒྲིག་སྟངས་སྦེ་ལག་ལེན་འཐབ་ཨིན།				2002-02-02 02:02:02
