helpcontent2	source\text\shared\01\05020700.xhp	0	help	par_id3149096				0	dz	\<ahelp hid=\"SVX_TRISTATEBOX_RID_SVXPAGE_PARA_ASIAN_CB_AS_HANG_PUNC\"\>གྲལ་ཐིག་འདི་མཚམས་བཅད་འགྱོ་མི་བཅུགས་ནི་དོན་ལུ་  ལྷད་རྟགས་དང་དུས་ཚོད་ཚུ་ཉམས་སྲུང་འབདཝ་ཨིན།  ཡིག་འབྲུ་དེ་ཚུ་  ཤོག་ལེབ་ཐིག་གི་ནང་ལུ་ཡང་  གྲེལ་ཐིག་གི་མཇུག་ལུ་ཁ་སྐོང་བརྐྱབ་སྟེ་ཡོད།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020700.xhp	0	help	par_id3147275				0	dz	\<emph\>ཨེ་ཤི་ཡན་དང་ལེ་ཊིན་དེ་ལས་ གོ་དཀའ་བའི་ཚིག་ཡིག་གི་བར་ན་  བར་སྟོང་བཞག་ཐང་འདི་འཇུག་སྤྱོད་འབད། \</emph\>				2002-02-02 02:02:02
