helpcontent2	source\text\shared\02\12100200.xhp	0	help	par_id3154368				0	dz	\<ahelp hid=\"HID_SEARCH_BTN_SEARCH\" visibility=\"hidden\"\>འཚོལ་ཞིབ་འགོ་བཙུགཔ་ཨིན་ ཡང་ན་ ཆ་མེད་གཏངམ་ཨིན། \</ahelp\>འཚོལ་ཞིབ་འདི་མཐར་འཁྱོལ་སྦེ་མཇུག་བསྡུ་ཡོད་པ་ཅིན་ ཐིག་ཁྲམ་ནང་གི་ཆ་མཉམ་ས་སྒོ་འདི་གཙོ་དམིགས་འབད་དེ་སྡོད་འོང་། ཁྱོད་ཀྱིས་ལོག་སྟེ་ \<emph\>འཚོལ་ཞིབ་\</emph\> ཨེབ་རྟ་གུ་ཨེབ་གཏང་འབད་བའི་ཐོག་ལས་ འཚོལ་ཞིབ་འཕྲོ་མཐུད་ཚུགས། དོ་རུང་ཁྱོད་ཀྱིས་ \<emph\>ཆ་མེད་གཏང་\</emph\> ཨེབ་རྟ་གུ་ཨེབ་གཏང་འབད་བའི་ཐོག་ལས་ འཚོལ་ཞིབ་འབད་བའི་བསྒང་ཡོད་མི་འདི་ཆ་མེད་གཏང་བཏུབ།				2002-02-02 02:02:02
