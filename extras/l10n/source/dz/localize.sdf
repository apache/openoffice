helpcontent2	source\text\shared\01\05340200.xhp	0	help	par_id3153272				0	dz	\<variable id=\"spaltetext\"\>\<ahelp hid=\"HID_BROWSER_COLUMNWIDTH\" visibility=\"visible\"\>ད་ལྟོའི་ཀེར་ཐིག་གི་རྒྱ་ཚད་དང་  ཡང་ན་  སེལ་འཐུ་འབད་ཡོད་པའི་ཀེར་ཐིག་ཚུ་  བསྒྱུར་བཅོས་འབདཝ་ཨིན།\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05340200.xhp	0	help	par_id3152821				0	dz	ཁྱོད་ཀྱིས་  ཀེར་ཐིག་གི་རྒྱ་ཚད་འདི་  ཀེར་ཐིག་མགོ་ཡིག་གི་ཟུར་ཁ་ལུ་  འདྲེན་བྱེད་འདི་འདྲུད་པའི་ཐོག་ལས་  རྒྱ་ཚད་འདི་བསྒྱུར་བཅོས་འབད་བཏུབ་ཨིན། \<switchinline select=\"appl\"\> \<caseinline select=\"CALC\"\> ཀེར་ཐིག་རྒྱ་ཚད་འདི་ནང་ཐིག་ནང་དོན་ལུ་ ཚུད་སྒྲིག་འབད་ནི་ལུ་  འདྲེན་བྱེད་འདི་གུ་ཨེབ་གཏང་ཐེང་གཉིས་ཨེབ་ད། \</caseinline\> \</switchinline\>				2002-02-02 02:02:02
