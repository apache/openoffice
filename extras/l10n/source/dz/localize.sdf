helpcontent2	source\text\swriter\01\04120221.xhp	0	help	par_id3153631	20			0	dz	\<ahelp hid=\"SW:PUSHBUTTON:TP_TOX_ENTRY:PB_HYPERLINK\"\>ཁྱོད་ཀྱིས་ ཧའི་པར་ལིངཀི་ངོ་རྟགས་(LS) ཁ་ཕྱེ་བའི་ཐོག་ལས་དང་(LE) ཁ་བསྡམ་པའི་ཐོག་ལས་ མཉམ་སྦྲགས་འབད་མི་ཐོ་འགོད་ཡན་ལག་གི་དོན་ལུ་ ཧའི་པར་ལིངཀི་ཅིག་གསར་བསྐྲུན་འབདཝ་ཨིན། \<emph\>གཞི་བཀོད་ \</emph\>གྲལ་ཐིག་གུ་ ཁྱོད་ཀྱིས་ ཧའི་པར་ལིངཀི་ཅིག་གི་དོན་ལུ་གསར་བསྐྲུན་འབད་དགོ་མནོ་མི་ཡན་ལག་གི་ གདོང་ཁ་ཡོད་མི་སྒྲོམ་སྟོངམ་དེ་ནང་ལུ ་ཨེབ་གཏང་འབད་ཞིནམ་ལས་ དེ་ལས་ ཨེབ་རྟ་འདི་ལུ་ཨེབ་གཏང་འབད། ཁྱོད་ཀྱིས་ ཧའི་པར་ལིངཀི་སྦེ་བཟོ་དགོ་མནོ་མི་ཡན་ལག་གི་ཤུལ་ལས་ སྒྲོམ་སྟོངམ་དེ་ལུ་ཨེབ་གཏང་འབད་ཞིནམ་ལས་ དེ་ལས་ ཨེབ་རྟ་དེ་ལུ་དོ་རུང་ཨེབ་གཏང་འབད།\</ahelp\>				2002-02-02 02:02:02
