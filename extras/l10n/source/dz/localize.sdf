helpcontent2	source\text\swriter\01\03090000.xhp	0	help	par_id3147171				0	dz	\<ahelp hid=\".uno:Fieldnames\"\>ས་སྒོའི་མིང་དང་ ས་སྒོའི་ནང་དོན་གཉིས་ཀྱི་བར་ན་ལུ་ ས་སྒོ་བཀྲམ་སྟོན་དེ་སོར་བསྒྱུར་འབདཝ་ཨིན།\</ahelp\> ཞིབ་དཔྱད་རྟགས་དེ་གིས་ ས་སྒོའི་མིང་ཚུ་བཀྲམ་སྟོན་འབད་དེ་ཡོད་པའི་བརྡ་སྟོནམ་ཨིནམ་དང་ ཞིབ་དཔྱད་རྟགས་མེད་མི་དེ་གིས་ ས་སྒོའི་ནང་དོན་ཚུ་བཀྲམ་སྟོན་འབད་དེ་ཡོད་པའི་བརྡ སྟོནམ་ཨིན། ས་སྒོའི་ནང་དོན་ལ་ལུ་ཅིག་བཀྲམ་སྟོན་འབད་མི་ཚུགས།				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\03090000.xhp	0	help	par_id3154098				0	dz	ཁྱོད་ཀྱིས་ \<emph\>སྟོན་- ས་སྒོའི་མིང་ཚུ་\</emph\> ལྕོགས་ཅན་བཟོ་ཡོདཔ་ ཟེར་མི་དང་གཅིག་ཁར་ ཡིག་ཆ་ཅིག་དཔར་བསྐྲུན་འབདཝ་ད་ལུ་ ཁྱོད་ཀྱིས་ དཔར་བསྐྲུན་འབད་ཡོད་མི་ནང་ལུ་ས་སྒོའི་མིང་དེ་ཚུ་གྲངས་སུ་བཙུགས་ནི་ལུ་ ནུས་སྤེལ་འབདཝ་ཨིན།				2002-02-02 02:02:02
