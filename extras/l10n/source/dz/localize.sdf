helpcontent2	source\text\shared\explorer\database\02010100.xhp	0	help	bm_id3153323				0	dz	\<bookmark_value\>མཐོང་སྣང་ཚུ། གནད་སྡུད་གཞི་རྟེན་མཐོང་སནང་ཚུ་གསར་བསྐྲུན་འབདཝ་ཨིན་ (གཞི་རྟེན་)\</bookmark_value\>\<bookmark_value\>འདྲི་དཔྱད་ཚུ། བཀོད་སྒྲིག་མཐོང་སྣང་ནང་གསར་བསྐྲུན་འབདཝ་ཨིན་ (གཞི་རྟེན་)\</bookmark_value\>\<bookmark_value\>བཀོད་སྒྲིག་འབད་དོ། འདྲི་དཔྱད་ཚུ་ (གཞི་རྟེན་)\</bookmark_value\>\<bookmark_value\>བཀོད་སྒྲིག་མཐོང་སྣང་། འདྲི་དཔྱད་ཚུ་/མཐོང་སྣང་ཚུ་ (གཞི་རྟེན་)\</bookmark_value\>\<bookmark_value\>མཐུད་དོ། ཐིག་ཁྲམ་ཚུ་ (གཞི་རྟེན་)\</bookmark_value\>\<bookmark_value\>གནད་སྡུད་གཞི་རྟེན་ཚུ་ནང་ཐིག་ཁྲམ་ཚུ། འདྲི་དཔྱད་ཚུའི་དོན་ལས་མཐུད་དོ་ (གཞི་རྟེན་)\</bookmark_value\>\<bookmark_value\>འདྲི་དཔྱད་ཚུ། ཐིག་ཁྲམ་ཚུ་མཐུད་དོ་ (གཞི་རྟེན་)\</bookmark_value\>\<bookmark_value\>གནད་སྡུད་གཞི་རྟེན་ཚུ་ནང་ཐིག་ཁྲམ་ཚུ། མཐུན་འབྲེལ་ཚུ་ (གཞི་རྟེན་)\</bookmark_value\>\<bookmark_value\>མཐུན་འབྲེལ་ཚུ། ཐིག་ཁྲམ་ཚུ་མཐུད་དོ་ (གཞི་རྟེན་)\</bookmark_value\>\<bookmark_value\>འདྲི་དཔྱད་ཚུ། ཐིག་ཁྲམ་འབྲེལ་མཐུད་ཚུ་བཏོན་གཏང་དོ་ (གཞི་རྟེན་)\</bookmark_value\>\<bookmark_value\>འདྲི་དཔྱད་བཀོད་སྒྲིག་གི་ཁྱད་ཚད་ (གཞི་རྟེན་)\</bookmark_value\>\<bookmark_value\>འདྲི་དཔྱད་ཚུ། ཚགས་མའི་གནས་སྟངས་ཚུ་བཟོ་དོ་ (གཞི་རྟེན་)\</bookmark_value\>\<bookmark_value\>ཚགས་མའི་གནས་སྟངས་ཚུ། འདྲི་དཔྱད་ཚུ་ནང་ (གཞི་རྟེན་)\</bookmark_value\>\<bookmark_value\>ཚད་བཟུང་ཚུ། འདྲི་དཔྱད་ཚུ་ (གཞི་རྟེན་)\</bookmark_value\>\<bookmark_value\>འདྲི་དཔྱད་ཚུ། ཚད་བཟུང་འདྲི་དཔྱད་ཚུ་ (གཞི་རྟེན་)\</bookmark_value\>\<bookmark_value\>ཨེསི་ཀིའུ་ཨེལ་ འདྲི་དཔྱད་ཚུ་ (གཞི་རྟེན་)\</bookmark_value\>\<bookmark_value\>རང་ཡུལ་ཨེསི་ཀིའུ་ཨེལ་ (གཞི་རྟེན་)\</bookmark_value\>				2002-02-02 02:02:02
