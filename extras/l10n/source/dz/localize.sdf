helpcontent2	source\text\swriter\02\08080000.xhp	0	help	par_id3151172				0	dz	\<ahelp hid=\".uno:StatusBarFunc\" visibility=\"visible\"\>ཤུགས་ལྡན་ཡིག་ཆ་གི་ བསྐོར་ལས་ ད་ལྟོའི་བརྡ་དོན་དེ་ བཀྲམ་སྟོན་འབདཝ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\08080000.xhp	0	help	par_id3156375				0	dz	འོད་རྟགས་དེ་  མང་བཏགས་ཡོད་པའི་དབྱེ་ཚན་ནང་ འབདཝ་་དང་ དབྱེ་ཚན་གྱི་མིང་དེ་བྱུངམ་ཨིན།  འོད་རྟགས་དེ་  ཐིག་ཁྲམ་ཅིག་ནང་འབདཝ་ད་ ཐིག་ཁྲམ་གྱི་ནང་ཐིག་འདི་བྱུངམ་ཨིན།  ཁྱོད་ཀྱི་ གཞི་ཁྲམ་ ཡང་ན་ པར་རིས་དངོས་པོ་དེ་ཚུ་  ཞུན་དག་འབད་པའི་སྐབས་ དངོས་པོ་གི་ཚད་དེ་ སྟོན་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\08080000.xhp	0	help	par_id3145416				0	dz	འོད་རྟགས་དེ་ ཚིག་ཡིག་གི་ནང་འཁོད་ བཞག་སྟེ་ཡོད་པ་ཅིན་  ཁྱོད་ཀྱི་ས་སྒོ་ཚུ་གི་ ཌའི་ལོག་དེ་  ཁ་ཕྱེ་ནི་ལུ་ \<link href=\"text/swriter/01/04090000.xhp\" name=\"Fields\"\>\<emph\>འ་ནི་ས་སྒོ་འདི་ལུ་ཨེབ་གཏང་ཐེངས་གཉིས་ \</emph\>\</link\> འབད་བཏུབ། འ་ནི་ཌའི་ལོག་འདི་ནང་ལུ་ ཁྱོད་ཀྱི་ད་ལྟོའི་ འོད་རྟགས་ཀྱི་གནས་ས་ལུ་  ཁྱོད་རའི་ཡིག་ཆ་ནང་ བཙུགས་ནི་ཨིན་པའི་ ས་སྒོ་ཅིག་ངེས་འཛིན་འབད་བཏུབ། འོད་རྟགས་དེ་ ཐིག་ཁྲམ་ཅིག་གི་ནང་བཞག་ཡོད་པ་ཅིན་  འ་ནི་ས་སྒོ་ནང་ ཨེབ་གཏང་ཐེངས་གཉིས་ཀྱིས་  \<emph\> ཐིག་ཁྲམ་རྩ་སྒྲིག་གི་\</emph\> ཌའི་ལོག་དེ་ལུ་ བོད་བརྡ་འབདཝ་ཨིན། སེལ་འཐུ་གྲུབ་ཡོད་པའི་ དངོས་པོ་ལུ་བརྟེན་  ཁྱོད་ཀྱི་ དབྱེ་ཚན་དང་ ཚད་རིས་ཀྱི་དངོས་པོ་  འཕུར་ལྡིང་གི་གཞི་ཁྲམ་ ཨོ་ཨེལ་ཨི་གི་དངོས་པོ་  དེ་ལས་ཐད་ཀར་དུ་ཨང་བཏགས་ནི་ ཡང་ན་ པར་རིས་དངོས་པོ་གི་ཚད་དང་གནས་ས་ཚུ་ ཞུན་དག་འབད་ནི་ལུ་ ཌའི་ལོག་ཅིག་བོད་བརྡ་འབད་བཏུབ།				2002-02-02 02:02:02
