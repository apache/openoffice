helpcontent2	source\text\shared\guide\protection.xhp	0	help	par_id3161646				0	dz	\<item type=\"productname\"\>%PRODUCTNAME\</item\> ཀེལཀི་དང་ \<item type=\"productname\"\>%PRODUCTNAME\</item\> རྩོམ་འབྲི་པ་ནང་ལུ་ རེ་རེ་བཞིན་བསྒྱུར་བཅོས་འབད་ཡོད་མི་དང་གཅིག་ཁར་ བསྐྱར་ཞིབ་ལས་འགན་གྱིས་ བསྒྱུར་བཅོས་འདི་ག་གི་འབད་འབདཝ་ཨིན་ན་དྲན་ཐོ་བཀོདཔ་ཨིན། ལས་འགན་འདི་ ཉེན་སྐྱོབ་དང་གཅིག་ཁར་ ཆོག་ཡིག་ངེས་བདེན་འདི་ཐོ་བཀོད་འབད་བའི་སྐབས་རྐྱངམ་ཅིག་ཊཱན་ཨོཕ་འབད་བཏུབ་ནིའི་དོན་ལས་ ཊཱན་ཨཱོན་འབད་བཏུབ། དེ་ཚུན་ བསྒྱུར་བཅོས་ཚུ་ཆ་མཉམ་ དྲན་ཐོབཀོད་ནི་འཕྲོ་མཐུད་འོང་། བསྒྱུར་བཅོས་ཚུ་གི་དང་ལེན་དང་དང་ལེན་སྤང་ནི་འདི་ འབད་མི་ཚུགས།				2002-02-02 02:02:02
