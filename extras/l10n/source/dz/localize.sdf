helpcontent2	source\text\smath\01\05040000.xhp	0	help	par_id3152999				0	dz	\<variable id=\"ausrichtungtext\"\>\<ahelp hid=\"SID_ALIGN\" visibility=\"visible\"\>ཁྱོད་ཀྱིས་ སྣ་མང་-གྲལ་ཐིག་གི་མན་ངག་ཚུ་ དེ་ལས་ གྲལ་ཐིག་གཅིག་ནང་ལུ་རྒྱུ་རྫས་ལེ་ཤ་ཅིག་དང་ཅིག་ཁར་མན་ངག་ཚུ་གི་ཕྲང་སྒྲིག་འདི་ངེས་འཛིན་འབད་ཚུགས། \</ahelp\> \<emph\>NEWLINE\</emph\>བརྡ་བཀོད་ཅིག་ \<emph\>བརྡ་བཀོད་ཚུ་\</emph\>གི་སྒོ་སྒྲིག་ནང་ ཐོ་བཀོད་འབད་བའི་ཐོག་ལས་ སྣ་མང་-གྲལ་ཐིག་གི་མན་ངག་ཚུ་གསར་བསྐྲུན་འབད།\</variable\>				2002-02-02 02:02:02
