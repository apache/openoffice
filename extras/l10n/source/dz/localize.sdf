helpcontent2	source\text\shared\02\01140000.xhp	0	help	par_id3156443				0	dz	\<image id=\"img_id3153951\" src=\"res/commandimagelist/sc_ellipse.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3153951\"\>ངོས་དཔར།\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01140000.xhp	0	help	par_id3159197				0	dz	\<ahelp hid=\".uno:Ellipse\"\>ཁྱོད་ཀྱི་ ད་ལྟོའི་ཡིག་ཆ་འདི་  ནང་ན་ལུ་འདྲུད་ས་ལུ་ སྒོང་དབྱིབས་ཅིག་འབྲིཝ་ཨིན། ཁྱོད་ཀྱི་སྒོང་དབྱིབས་འདི་ག་སྟེ་འབྲི་དགོ་མནོ་ས་ལུ་ ཨེབ་གཏང་འབད་བཞིནམ་ལས་  ཁྱོད་རང་དགོ་པའི་ཚད་འདི་ནང་ཚུན་རང་འདྲུད་བཞག་འབད། སྒོར་ཐིག་ཅི་འབྲི་ནི་ལུ་ ཁྱོད་ཀྱི་འབྲིཝ་ད་ སོར་ལྟེ་དེ་བཟུང་བཞག་འབད། \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01140000.xhp	0	help	hd_id3155308				0	dz	ཟུར་མང་དབྱིབས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01140000.xhp	0	help	par_id3154129				0	dz	\<image id=\"img_id3152576\" src=\"res/commandimagelist/sc_polygon_unfilled.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3152576\"\>ངོས་དཔར།\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01140000.xhp	0	help	par_id3147214				0	dz	\<ahelp hid=\".uno:Polygon_Unfilled\"\>ཆ་བགོས་གྲལ་ཐིག་ཕྲང་ཕྲངམ་ཅིག་གི་  རྒྱུན་རིམ་གྱི་བརྩམ་ཡོད་པའི་གྲལ་ཐིག་ཅིག་འབྲིཝ་ཨིན། ཆ་བགོས་གྲལ་ཐིག་ཅིག་འབྲི་ནི་ལུ་ འདྲུད་བཞག་འབད་བཞིནམ་དང་ ཆ་བགོས་གྲལ་ཐིག་གི་མཐའ་རྩེ་འདི་་ངེས་འཛིན་འབད་ནི་ལུ་ ཨེབ་གཏང་འབད་ དེ་ལས་ཆ་བགོས་གྲལ་ཐིག་གསརཔ་ཅིག་འབྲི་ནི་ལུ་  འདྲུད་བཞག་འབད། གྲལ་ཐིག་འབྲི་ནིའི་ མཇུག་བསྡུ་ནི་ལུ་གཡེབ་གཏང་ཐེངས་གཉིས་འབད། ཁ་བསྡམས་ནིའི་དབྱིབས་ཅིག་  གསར་བསྐྲུན་འབད་ནི་ལུ་  གྲལ་ཐིག་གི་ འགོ་བཙུགས་ཀྱི་ས་ཆིགས་འདི་ལུ་  ཨེབ་གཏང་ཐེངས་གཉིས་འབད། \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01140000.xhp	0	help	par_id3154638				0	dz	ཁུག་ཟུར་༤༥་ གྲུ་ཟུར་གྱི་ས་ཚིགས་གསརཔ་ཅིག་གི་གནས་ས་བཙུགས་ནི་ལུ་  ཟུར་མང་དབྱིབས་ཅིག་འབྲིཝ་ད་  སོར་ལྡེ་གི་ལྡེ་མིག་འདི་བཤད་བཟུང་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01140000.xhp	0	help	par_id3154319				0	dz	ཞུན་དག་\<link href=\"text/shared/01/05270000.xhp\" name=\"Edit Points\"\>ས་ཚིགས་ཐབས་ལམ་འདི་གིས་ \</link\>  ཁྱོད་ལུ་ཟུར་མང་དབྱིབས་ཀྱི་ ངོརྐྱང་ས་ཚིགས་འདི་ ཕན་ཚུན་འབྲེལ་ལྡན་གྱི་ཐོག་ལས་ ལེགས་བཅོས་འབད་ནི་ལུ་ལྕོགས་ཅན་བཟོཝ་ཨིན།				2002-02-02 02:02:02
