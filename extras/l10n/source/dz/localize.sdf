helpcontent2	source\text\shared\autopi\01050000.xhp	0	help	par_id3156027				0	dz	\<variable id=\"autopilot\"\>\<ahelp hid=\"SID_AUTOPILOT\"\>ཕན་ཚུན་འབྲེལ་ལྡན་སྦེ་གསལ་སྟོན་ཅིག་གསར་བསྐྲུན་འབད་ནིའི་དོན་ལུ་ ཝི་ཛརཌི་ལག་ལེན་འཐབ། ཝི་ཛརཌི་གི་ཐོག་ལས་ ཁྱོད་ཀྱིས་ ཁྱོད་རའི་དགོ་འདོད་འགྲུབ་ནི་ལུ་ དཔེ་ཚན་ཊེམ་པེལེཊིསི་ ལེགས་བཅོས་འབད་བཏུབ། \</ahelp\>\</variable\> ཝི་ཛརཌི་གིས་ བཀོད་སྒྲིག་ཆ་ཤས་ལས་བརྒྱུད་དེ་ རིམ་པ་བཞིན་འཁྱིད་ཞིནམ་ལས་ ཞུན་དག་གདམ་ཁ་སྣ་ཚོགས་བྱིནམ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\01050000.xhp	0	help	par_id3166410				0	dz	ཝི་ཛརཌི་ཤོག་ལེབ་རེའི་ནང་ལུ་ ཁྱོད་ཀྱིས་ འབད་བཤོལ་དང་ལེགས་བཅོས་ ཡང་ན་ ཞུན་དག་གི་རིམ་པ་ཚུ་གེ་ར་ལས་གོམ་འགྱོ་ཚུགས།ཁྱོད་ཀྱིས་ ཤོག་ལེབ་གཅིག་གི་ནང་ལས་གོམ་འགྱོ་ནི་ཨིན་པ་ཅིན་ ཝི་ཛརཌི་གིས་ སྔོན་སྒྲིག་སྒྲིག་སྟངས་ཚུ་ལག་ལེན་འཐབ་ཨིན།				2002-02-02 02:02:02
