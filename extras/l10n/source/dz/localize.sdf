helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3154704				0	dz	\<emph\>[Variant]:\</emph\> མི་མཐུན་པ་འགྱུར་ཅན་དབྱེ་བ་ (ངེས་ཚིག་གིས་འབད་གསལ་བཀོད་འབད་ཡོད་མི་ དབྱ་ེ་བ་ཚུ་ཆ་མཉམ་ཡོདཔ)་གཙོ་ཚིག་ཅིག་གསལ་བཀོད་མ་འབད་བ་ཅིན་ འགྱུར་ཅན་ཚུ་རང་བཞིན་གྱིས་མི་མཐུན་དབྱེ་བ་སྦེ་ངེས་འཛིན་འབད་ཡོདཔ་ གསལ་བཤད་ཌིཕ་བུལ་ལས་་ཌིཕ་ཝར་ལག་ལེན་འཐབ་མི་ཚུན་ཚོད།				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03102100.xhp	0	help	par_id3146316				0	dz	 $[officename] གཞི་རིམ་ནང་ཁྱོད་ཀྱིས་འགྱུར་ཅན་ཚུ་བསམ་པའི་སྒོ་ལས་གསལ་བསྒྲགས་འབད་མ་དགོཔ་ཨིན།  ག་དེ་ཨིན་རུང་ཁྱོད་ཀྱིས་ཨེ་རེ་ཅིག་ལག་ལེན་མ་འཐབ་པའི་ཧེ་མ་གསལ་བསྒྲགས་འབད་དགོཔ་ཨིན། ཁྱོད་ཀྱིས་འགྱུར་ཅན་དང་གཅིག་ཁར་ཌི་ཨའི་ཨེམ་གསལ་བཤད་ སྣ་མང་གསལ་བསྒྲགས་ཚུ་སོ་སོ་ཁ་དབྱེལ་ནི་ལུ་ལྷོད་རྟགས་ལག་ལེན་འཐབ་དེ་གསལ་བསྒརགས་འབད་བཏུབ་ཨིན། འགྱུར་ཅན་དབྱེ་བ་གསལ་བསྒྲགས་འབད་ནི་ལུ་ དབྱེ་བ་གསལ་བསྒྲགས་ཡིག་འབྲུ་གི་རྗེས་སུ་གྲངས་མིང་ཡང་ན་ཆ་མཉམ་པའི་གཙོ་ཚིག་ཅིག་བཙུགས།				2002-02-02 02:02:02
