helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3153724				0	dz	\<ahelp hid=\"37933\"\>ཚིག་ཡིག་གི་སྒྲོམ་དང་ ཁ་ཡིག་བཟུམ་ ཚད་འཛིན་གྱི་ས་སྒོ་ནང་ ཁྱོད་ལུ་ གྲལ་ཐིག་གི་རྒྱུན་ཆད་དང་རྩ་སྒྲིག་འབད་ནི་ཚུ་ལག་ལེན་འཐབ་བཅུགཔ་ཨིན། ལག་ཐོག་ལས་གྲལ་ཐིག་གི་རྒྱུན་ཆད་ཅིག་ ཐོ་བཀོད་འབད་ནི་ལུ་ ཐོ་བཀོད་ཀྱི་ལྡེ་མིག་འདི་མར་མནན་འབད།  རྩ་སྒྲིག་འབད་ཡོད་པའི་ཚིག་ཡིག་དེ་ཐོ་བཀོད་འབད་ནི་ལུ་ རྩ་སྒྲིག་འབད་ནི་དང་བཅས་པའི་ སྣ་མང་གྲལ་ཐིག་"འདི་སེལ་འཐུ་འབད། \</ahelp\>				2002-02-02 02:02:02
