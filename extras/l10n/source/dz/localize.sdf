helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3148730	37			0	dz	\<ahelp hid=\"HID_PROP_DEFAULT_SELECT_SEQ\" visibility=\"hidden\"\>སྔོན་སྒྲིག་ཐོ་བཀོད་སྦེ་ རྟགས་བཀལ་ནི་ལུ་  ཐོ་ཡིག་སྒྲོམ་གྱི་ཐོ་བཀོད་དེ་ གསལ་བཀོད་འབདཝ་ཨིན། \</ahelp\>སྔོན་སྒྲིག་ཐོ་བཀོད་སྦེ་ རྟགས་བཀལ་ནི་ལུ་  ཐོ་ཡིག་སྒྲོམ་གྱི་ཐོ་བཀོད་དེ་ གསལ་བཀོད་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id919217				0	dz	གནས་གོང་གི་ཐོ་ཡིག་ཡོད་མི་  ཐོ་ཡིག་གི་སྒྲོམ་ཅིག་གི་དོན་ལུ་  སྔོན་སྒྲིག་སེལ་འཐུ་གི་ཌའི་ལོག་དེ་ ཁ་ཕྱེ་ནི་ལུ་\<emph\>...\</emph\> ཁྱོད་ཀྱི་\<emph\>ཨེབ་རྟ་དེ་ལུ་ \</emph\>ཨེབ་གཏང་འབད་བཏུབ།				2002-02-02 02:02:02
