helpcontent2	source\text\scalc\guide\goalseek.xhp	0	help	par_id3150871				0	dz	ལོ་བསྟར་གྱི་བསྐྱེད་རྩིས་ (I)སྟོན་དགོ་པ་ཅིན་ དངུལ་ (C) དང་ ལོ་གྲངས་ (n) དེ་ལས་ བསྐྱེད་ཚད་ (i) ཀྱི་དོན་ལུ་ བེ་ལུསི་དང་གཅིག་ཁར་ ཐིག་ཁྲམ་ཅིག་གསར་བསྐྲུན་འབད། མན་ངག་འདི་ཡང་: 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\guide\goalseek.xhp	0	help	par_id3152596				0	dz	I = C * n* i				2002-02-02 02:02:02
helpcontent2	source\text\scalc\guide\goalseek.xhp	0	help	par_id3155335				0	dz	ང་བཅས་ར་ \<item type=\"literal\"\>i\</item\> བསྐྱེད་ཚད་འདི་ ༧་༥% དང་ ལོ་གྲངས་\<item type=\"literal\"\>n\</item\> སྦེ་  (1) ལུ་འགྱུར་བ་མེད་པའི་དབང་ལུ་གཏང་། ག་དེ་འབད་རུང་ ག་ཅི་འབད་རུང་ཅིག་ལོག་འཐོབ་ནི་གི་དོན་ལུ་ \<item type=\"literal\"\>I\</item\> ཁྱོད་ཀྱིས་ མ་རྩ་མ་དངུལ་ \<item type=\"literal\"\>C\</item\> ག་དེམ་ཅིག་ ལེགས་བཅོས་འབད་དགོཔ་ཨིན་ན་ ཤེས་འདོད་འདུག དཔེ་འདི་གི་དོན་ལུ་ ཁྱོད་ཀྱིས་ ལོ་བསྟར་བཞིན་ དངུལ་ $15,000 ལོག་འཐོབ་དགོ་པ་ཅིན་ མ་དངུལ་ \<item type=\"literal\"\>C\</item\> ག་དེམ་ཅིག་དགོཔ་ཨིན་ན་ རྩིས་སྟོན།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\guide\goalseek.xhp	0	help	par_id3155960				0	dz	དངུལ་ \<item type=\"literal\"\>C\</item\> (མཐུན་སྒྲིག་བེ་ལུ་ དཔེར་ན་ \<item type=\"literal\"\>$100,000\</item\>བཟུམ་) དང་ ལོ་གྲངས་ \<item type=\"literal\"\>n \</item\>(\<item type=\"literal\"\>1\</item\>) དེ་ལས་ སྐྱེད་ཚད་ \<item type=\"literal\"\>i\</item\> (\<item type=\"literal\"\>༧་༥%\</item\>) གི་དོན་ལུ་ ནང་ཐིག་རེ་རེ་ནང་ བེ་ལུསི་རེ་རེ་བཙུགས།  ནང་ཐིག་གཞན་ཅིག་ནང་ སྐྱེད་ \<item type=\"literal\"\>I\</item\> རྩིས་སྟོན་ནི་གི་དོན་ལུ་ མན་ངག་བཙུགས། \<item type=\"literal\"\>C\</item\>, \<item type=\"literal\"\>n\</item\>, དང་  \<item type=\"literal\"\>i\</item\> གི་ཚབ་ལུ་ མཉམ་པའི་བེ་ལུ་གི་ཐོག་ལས་ \<link href=\"text/scalc/guide/relativ_absolut_ref.xhp\"\>ནང་ཐིག་ལུ་གཞི་བསྟུན་ \</link\> ལག་ལེན་འཐབ།				2002-02-02 02:02:02
