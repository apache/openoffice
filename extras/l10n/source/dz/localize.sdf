helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3147514				0	dz	ཐབས་ལམ་འ་ནི་བཟུམ་སྦེ་ གོང་གི་བར་མཚམས་བཟུམ་ཚུ་  \<emph\>$[officename] ཨང་རྩིས་\</emph\> ནང་དཀའ་ངལ་ག་ནི་ཡང་མེད་པར་བཟོ་བརྩིགས་འབད་ཚུགས་:  \\[2", "3\\) ཡང་ན་ "\\]2", "3\\[ (དྲན་བཀུག་: འ་ནི་འདྲེན་ཚིག་གི་རྟགས་ཚུ་ཐོ་བཀོད་འདི་གི་ཡན་ལག་ཨིན།)				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3153532				0	dz	འདྲེན་ཚིག་གི་རྟགས་ཚུ་ཐོ་བཀོད་འབད་དགོཔ་དང་ འདི་ཚུ་ \<emph\>སོར་ལྡེ་+2\</emph\> དང་གཅིག་ཁར་འཐོབ་ཨིནམ་ དང་ དཔར་བསྐྲུན་རིག་པའི་འདྲེན་ཚིག་རྟགས་ཚུ་གིས་མ་འཐོབ་ཨིནམ་དྲན་དགོ  སྤྱིར་བཏང་ལུ་ ཡིག་རྟགས་(གནད་དོན་འདི་ནང་ལུ་ལྷོད་རྟགས་བཟུམ་) ཚུ་ཚིག་ཡིག་སྦེ་གཞི་སྒྲིག་འབད་ཡོད།  "\\[2,~3\\)" འདི་ཡིག་དཔར་རྐྱབས་ནི་ལུ་སྲིད་པ་ཨིན་རུང་ཡང་ གོང་གི་གདམ་ཁ་འདི་དགའ་གདམ་ཨིན། ཧེ་མའི་དཔེར་བརྗོད་ནང་ལུ་  "fixed size" གིས་ཨ་རྟག་རང་ཡིག་གཟུགས་ཚད་ལག་ལེན་འཐབ་ཡོད་མི་ལུ་རྟེན་མི་ གུག་ཤད་ཚད་ཅིག་འགྲལ་བཤད་རྐྱབས་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3153674				0	dz	ནང་འཁོད་ལུ་སྡེ་ཚན་འཚོལ་ནི་འདི་འབྲེལ་ཅན་སྦེ་དཀའ་ངལ་-མེད་མི་ཨིན། མན་ངག་ཧེཊི་ "{a + b}" འདི་ནང་ལུ་  "hat" འདི་འཇམ་སམ་སྦེ་ "{a + b}" གི་དབུས་ལས་བཀྲམ་སྟོན་འབད་ཡོདཔ་ཨིན། ཡང་  "color red lceil a rceil" དང་ "grave hat langle x * y rangle" རེ་བ་བསྐྱེད་དོ་བཟུམ་སྦེ་ལཱ་འབདཝ་ཨིན། ཤུལ་ལས་ཀྱི་གྲུབ་འབྲས་འདི་ "grave {hat langle x * y rangle}" ལུ་ག་བསྡུར་རྐྱབས་བཏུབ། འ་ནི་ཁྱད་ཆོས་ཚུ་ག་བསྡུར་མི་རྐྱབས་ དེ་འབདཝ་ད་ མཉམ་མཐུད་འབད་བཏུབ།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3147526				0	dz	ག་བསྡུར་རྐྱབས་ནི་ཡང་ཁྱད་ཆོས་ཚུ་རྒྱུད་བསྐུལ་འབད་ནིའི་དོན་ལུ་འ་ནི་འདི་དུམ་གྲ་ཅིག་འགྱུར་འགྱོཝ་ཨིན། འ་ནི་འདི་ཡིག་གཟུགས་ཁྱད་ཆོས་ཚུའི་གནད་དོན་ཨིན། དཔེར་ན་ བི་ ལུ་ "color yellow color red (a + color green b)" ནང་ཚོས་གཞི་ག་འདི་ཡོདཔ་ཨིན་ན་ ཡང་ན་ འདི་ལུ་ "size *4 (a + size /2 b)" ཚད་ག་འདི་ཡོདཔ་ཨིན་ན? གཞི་རྟེན་གྱི་ཚད་ ༡༢ བྱིན་ཡོད་མི་འདི་ལུ་ ཚད་༤༨ ༦ ཡང་ན་ ༢༤ (མཉམ་མཐུད་སྦེ་མཐོང་ཚུགས་མི་)ཡོད་ག? འོག་གི་འདི་ཚུ་གཞི་རིམ་ཧུམ་ཆའི་ལམ་ལུགས་ མ་འོངས་པ་ནང་རྗེས་སུ་བཟུང་མི་ཅིག་ཨིན། སྤྱིར་བཏང་ལུ་ ལམ་ལུགས་འདི་སྡེ་ཚན་བཀོལ་སྤྱོད་པ་ཆ་མཉམ་ལུ་འཇུག་སྤྱོད་འབདཝ་ཨིན། འ་ནི་ལུ་ ཡིག་གཟུགས་ཁྱད་ཆོས་གུ་མཐོང་ཚུགས་པའི་ནུས་པ་  "bold", "ital", "phantom", "size", "color" དང་ "font" བཟུམ་རྐྱངམ་ཅིག་ཡོད:				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3152952				0	dz	འབྱུང་རིམ་ནང་གི་སྡེ་ཚན་བཀོལ་སྤྱོད་པ་ཚུ་ བཀོལ་སྤྱོད་པ་རྐྱང་པ་ཚུརེ་རེ་བཞིན་གུག་ཤད་ཚུ་གིས་མཉམ་སྦྲགས་འབད་ཡོད་དོ་བཟུམ་སྦེ་བརྩི་འཇོག་འབདཝ་ཨིན། དེ་ཚུ་འཚོལ་ཡོད་ དེ་ལས་གནས་རིམ་རེ་རེ་ནང་ལུ་ བཀོལ་སྤྱོད་པ་གཅིག་ལས་ལྷག་སྟེ་འོང་། འདི་ནང་ལུ་སྡེ་ཚན་བཀོལ་སྤྱོད་པ་ལེ་ཤ་འབད་མི་མན་ངག་གི་དཔེར་བརྗོད་ཡོད་: "ཚད་ 12 ཚོས་གཞི་དམརཔོ་ ཡིག་གཟུགས་སཱནསི་ ཚད་ -5 (a + ཚད་ 8 b)" བཟུམ་ "{size 12{ཚོས་གཞི་དམརཔོ་{ཡིག་གཟུགས་སཱནསི་{ཚད་ -5 (a + {ཚད་ 8 b})}}}}"				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3158441				0	dz	འ་ནི་དཔེར་བརྗོད་མན་ངག་འདི་གཡོན་ལས་གཡས་ལུ་ཁ་བསྒྱུར་འབད་ཡོདཔ་ཨིན། བཀོལ་སྤྱོད་པ་འདི་གིས་ཆ་མཉམ་པའི་སྡེ་ཚན་(ཡང་ན་གསལ་བརྗོད་)རྐྱངམ་ཅིག་གནོདཔ་ཨིན། བཀོལ་སྤྱོད་པ་ཚུ་་གཡས་ལུ་ "ཚབ་བཙུགས་" ཡང་ན་ "ཁོང་ར་མཉམ་མཐུད་" ཁོང་རའི་སྔོན་མམ་ཚུ་དང་གཅིག་ཁར་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03091100.xhp	0	help	par_id3150994				0	dz	སྡེ་ཚན་བཀོལ་སྤྱོད་པ་ཅིག་གིས་མཐོ་མི་-གནས་རིམ་བཀོལ་སྤྱོད་པ་ཚུ་ལུ་གནོད་པ་ག་ནི་ཡང་མེད་ དེ་འབདཝ་ད་ དམའ་མི་-གནས་རིམ་སྡེ་ཚན་དང་གསལ་བརྗོད་ཚུ་ ཁོང་རའི་གུག་ཤད་ཚུ་དང་ སྟེང་-/འོག་ཡིག་ཚུ་གྲངས་སུ་བཙུགས་ཏེ་ གནོདཔ་ཨིན། དཔེར་ན་"a + ཚད་ *2 (b * ཚད་ -8 c_1)^2"				2002-02-02 02:02:02
