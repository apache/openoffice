helpcontent2	source\text\scalc\01\02210000.xhp	0	help	par_id3153969	3			0	dz	\<ahelp hid=\"HID_SELECTTABLES\" visibility=\"visible\"\> ད་ལྟོའི་ཡིག་ཆ་ནང་ལུ་ཤོག་ཁྲམ་ཚུ་ཐོ་བཀོད་འབདཝ་ཨིན། ཤོག་ཁྲམ་གཅིག་སེལ་འཐུ་འབད་ནིའི་དོན་ལུ་ ཡར་ཡང་ན་མར་མདའ་རྟགས་ལྡེ་མིག་ཚུ་ ཐོ་བཀོད་ནང་གི་ཤོག་ཁྲམ་གཅིག་ནང་སྤོ་ནིའི་དོན་ལུ་ ཨེབ། སེལ་འཐུ་ལུ་ཤོག་ཁྲམ་ཁ་སྐོང་རྐྱབ་ནིའི་དོན་ལུ་ མདའ་རྟགས་ལྡེ་མིག་ཚུ་ཨེབ་པའི་སྐབས་ ཚད་འཛིན་འདི་མར་འཆང་སྟེ་ བར་སྟོང་ཕྲ་རིང་ཨེབ། ཤོག་ཁྲམ་ཚུའི་ཁྱབ་ཚད་སེལ་འཐུ་འབད་ནིའི་དོན་ལུ་ སོར་ལྡེ་འདི་མར་འཆང་སྟེ་ མདའ་རྟགས་ལྡེ་མིག་ཚུ་ཨེབ།  \</ahelp\>				2002-02-02 02:02:02
