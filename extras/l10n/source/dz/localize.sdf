helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3148566	143			0	dz	\<ahelp hid=\"HID_PROP_WIDTH\" visibility=\"hidden\"\>ཐིག་ཁྲམ་ཚད་འཛིན་གྱི་ས་སྒོ་འདི་ནང་ ཀེར་ཐིག་གི་རྒྱ་ཚད་དེ་གཞི་སྒྲིག་འབདཝ་ཨིན།\</ahelp\>%PRODUCTNAME་ ཚད་གཞི་གདམ་ཁ་ཚུ་གི་ནང་གསལ་བཀོད་འབད་ཡོད་མི་ ཆ་ཕྲན་ཚུ་གི་ནང་ ཐིག་ཁྲམ་ཚད་འཛིན་ས་སྒོའི་ནང་ཀེར་ཐིག་གི་རྒྱ་ཚད་འདི་གཞི་སྒྲིག་འབདཝ་ཨིན། ཁྱོད་རང་དགོ་པ་ཅིན་  ནུས་ཅན་ཚད་འཇལ་ཆ་ཕྲན་ཅིག་གི་རྗེས་སུ་འབྲང་ཐོག་ལས་ ཁྱོད་ཀྱི་གནས་གོང་ཅིག་ཐོ་བཀོད་འབད་ཚུགས། དཔེར་ན་  སི་ཨེམ་༢་བཟུམ།				2002-02-02 02:02:02
