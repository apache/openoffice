helpcontent2	source\text\shared\01\01070000.xhp	0	help	par_id3156343	40			0	dz	\<ahelp hid=\"HID_FILESAVE_FILETYPE\"\> ཁྱོད་ཀྱིས་སྲུངས་དོ་ཡོད་པའི་ཡིག་ཆ་དེ་གི་དོན་ལུ་  ཡིག་སྣོད་རྩ་སྒྲིག་འདི་སེལ་འཐུ་འབད།  \</ahelp\>བཀྲམ་སྟོན་གྱི་མངའ་ཁོངས་ནང་ལུ་  འ་ནི་ཡིག་སྣོད་དབྱེ་བ་དང་ཅིག་ཁར་ཡོད་པའི་  ཡིག་ཆ་ཚུ་ལུ་རྐྱངམ་ཅིག་  བཀྲམ་སྟོན་འབདཝ་ཨིན།  ཡིག་སྣོད་དབྱེ་བ་ཚུ་   \<link href=\"text/shared/00/00000020.xhp\" name=\"Information on Import and Export Filters\"\>ནང་འདྲེན་དང་ཕྱིར་འདྲེན་ཚགས་མ་གུ་ཡོད་པའི་བརྡ་དོན་ནང་ལུ་སྦེ་  འགྲེལ་བཤད་འབད་དེ་ཡོདཔ་ཨིན།\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01070000.xhp	0	help	par_id3145116				0	dz	ཁྱོད་རའི་ཡིག་ཆ་འདི་ཨ་རྟག་རང་  ཕྱིའི་ཡིག་སྣོད་དབྱེ་བ་ལུ་  མ་སྲུངས་པའི་ཧེ་མ་ \<item type=\"productname\"\>%PRODUCTNAME\</item\>ཡིག་སྣོད་དབྱེ་བ་ནང་ལུ་སྦེ་ སྲུངས་དགོ།  ཁྱོད་ཀྱིས་ཕྱིའི་ཡིག་སྣོད་དབྱེ་བ་ལུ་  ཕྱིར་འདྲེན་འབད་བའི་བསྒང་  རྩ་སྒྲིག་གི་ཁྱད་རྣམ་ལ་ལོ་ཅིག་བརླག་སྟོར་ཞུགསཔ་ཨིན།				2002-02-02 02:02:02
