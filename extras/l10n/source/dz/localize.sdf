helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3150084				0	dz	\<ahelp hid=\"HID_PROP_ENABLED\"\>ཚད་འཛིན་ས་སྒོ་འདི་ལུ་རྒྱུ་དངོས་ (ཨིན་མི་འདི་)"ལྕོགས་ཅན་བཟོ་ཡོད་པ་ཅིན་" འབྲི་ཤོག་ལག་ལེན་པ་འདི་གིས་ ཚད་འཛིན་ས་སྒོ་འདི་ལག་ལེན་འཐབ་ཚུགསཔ་ཨིན།\</ahelp\> རྒྱུ་དངོས་འདི་ལྕོགས་མིན་ཐལ་ཡོད་པ་ཅིན་ འདི་ལྕོགས་ཅན་བཟོ་མི་ཚུགསཔ (མེན།)་ཨིནམ་དང་ཚོས་གཞི་སྐྱ་ཐལ་ནང་ལུ་ བཀྲམ་སྟོན་འབདཝ་ཨིན།				2002-02-02 02:02:02
