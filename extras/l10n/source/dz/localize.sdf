helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3153087	48			0	dz	\<ahelp hid=\".\"\>ཌའི་ལོག་འདི་ཨིན་པུཊི་ས་སྒོ་གི་ཚད་ལུ་མར་ཕབ་འབད་ནའི་དོན་ལུ་  \<emph\>ངེས་དཔར་\</emph\> བསྐུམ་ ཨེབ་གཏང་།  ནེ་སྦེ་འབད་བ་ཅིན་ ཤོག་ཁྲམ་གྱི་ནང་ལུ་དགོས་མཁོ་ཡོད་མིའི་གཞི་བསྟུན་གུ་ རྟགས་བཀལ་ནི་འདི་འཇམ། དེ་ལས་ངེས་དཔར་ཚུ་རང་བཞིན་གྱིས་འབད་\<emph\>Maximize\</emph\>ངེས་དཔར་ལུ་གཞི་བསྒྱུར་འབད་ཚུགས།  ཌའི་ལོག་འདི་ཚད་ངོ་མ་ལུ་སོར་ཆུད་འབད་ནའི་དོན་ལུ་ཨེབ་གཏང་།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3155062				0	dz	མཱའུསི་དང་བཅས་ ཁྱོད་ཀྱིས་ ཤོག་ཁྲམ་གྱི་ནང་ལུ་ཨེབ་གཏང་པའི་བསྒང་ ཌའི་ལོག་འདི་རང་བཞིན་གྱིས་ཆུང་ཀུ་བཟོཝ་ཨིན།  ཁྱོད་ཀྱིས་མཱའུས་ཨེབ་རྟ་འདི་འཛིན་འགྲེལ་འབདཝ་ཅིག་  ཌའི་ལོག་འདི་སོར་ཆུད་འབད་ནི་དང་  མཱའུསི་དང་བཅས་ཡོད་མི་  གཞི་བསྟུན་ཁྱབ་ཚད་ངེས་འཛིན་འབད་ཡོད་མི་འདི་  ཡིག་ཆ་གི་ནང་ལུ་གཞི་ཁྲམ་ཧོནམ་གྱིས་གཙོ་དམིགས་བཀོད་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
