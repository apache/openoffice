helpcontent2	source\text\swriter\01\01160500.xhp	0	help	par_id3151175	2			0	dz	\<variable id=\"htmltext\"\>\<ahelp hid=\".uno:NewHtmlDoc\"\>ཝེབ་བ་རའུ་ཟར་ནང་ལུ་སྟོན་ཚུགས་ནིའི་དོན་ལུ་ ཡིག་སྣོད་དེ་ ཨེཆ་ཏི་ཨེམ་ཨེལ་སྦེ་སྲུང་བཞག་འབདཝ་ཨིན། ཁྱོད་ཀྱིས་སེལ་བཀོད་འབད་མི་མགོ་ཡིག་གི་བཟོ་རྣམ་་དེ་ ཡིག་ཆའི་ནང་ལུ་གདོང་ཐུག་བྱུང་པའི་སྐབས་ལུ་ ཤོག་ལེབ་སོ་སོ་གསར་བསྐྲུན་འབད་ནིའི་དོན་ལུ་ གདམ་ཁ་བརྐྱབ་་ཚུགས།\</ahelp\> ཁྱོད་ཀྱིས་གདམ་ཁ་འདི་བརྐྱབ་པ་ཅིན་  ཤོག་ལེབ་ཆ་མཉམ་ལུ་འབྲེལ་མཐུད་ཀྱི་ཤོག་ལེབ་སོ་སོ་ བཟོ་བཏོན་འབད་ཡོད་མི་ཚུ་ཡང་གསར་བསྐྲུན་འབད་འོང་། \</variable\>				2002-02-02 02:02:02
