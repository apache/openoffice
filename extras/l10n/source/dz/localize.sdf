helpcontent2	source\text\simpress\01\03120000.xhp	0	help	par_id3154684	2			0	dz	\<ahelp hid=\"HID_SD_BTN_HANDOUT\"\>གིས་  དཔར་བསྐྲུན་འབད་ཡོད་པའི་ཤོག་ལེབ་གཅིག་གུ་ཚུད་སྒྲིག་འབད་ནི་ལུ་ ཁྱོད་ཀྱིས་བཤུད་སྣ་མང་ཆ་ཚད་འབད་བཏུབ་མི་ལུ་  བཀྲམ་ཤོག་ཤོག་ལེབ་ལུ་སོར་བསྒྱུར་འབདཝ་ཨིན།\</ahelp\> ཁྱོད་ཀྱིས་ཤོག་ལེབ་གུ་དཔར་བསྐྲུན་འབད་བཏུབ་པའི་བཤུད་ཀྱི་ཨང་གྲངས་འདི་ལེགས་བཅོས་འབད་ནི་ལུ་   \<emph\>Layouts\</emph\> ལས་ཀ་པེན་ འདི་ཁ་ཕྱེ་ནི་དང་  སྒྲིག་བཀོད་གཅིག་གཡེབ་གཏང་ཐེང་གཉིས།				2002-02-02 02:02:02
