helpcontent2	source\text\shared\explorer\database\11080000.xhp	0	help	par_id3154288				0	dz	\<variable id=\"sqltext\"\>\<ahelp hid=\".\"\>ཁྱོད་ཀྱིས་གནད་སྡུད་གཞི་རྟེན་བདག་སྐྱོང་འཐབ་ནིའི་དོན་ལས་ཨེསི་ཀིའུ་ཨེལ་བརྡ་བཀོད་བཙུགས་ཚུགས་ནི་ཨིན་མི་དེ་ཁར་ཌའི་ལོག་ཁ་ཕྱེཝ་ཨིན།\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\11080000.xhp	0	help	par_id3147275				0	dz	ཌའི་དེ་གི་ནང་ལུ་  གེརེནཊི་ དང་ཐིག་ཁྲམ་གསར་བསྐྲུན་འབད་ ཡང་ན་ ཐིག་ཁྲམ་བཞག་ དང་ བརྡ་བཀོད་ཚགས་མ་མ་བཙུགས་བཟུམ་གྱི་ བདག་སྐྱོང་བརྡ་བཀོད་རྐྱངམ་ཅིག་ བཙུགས་བཏུབ།  ཁྱོད་ཀྱིས་བཙུགས་བཏུབ་པའི་བརྡ་བཀོད་འདི་  གནད་སྡུད་འབྱུང་ཁུངས་ལུ་རག་ལས་  དཔེར་ན་  ཌི་གཞི་རྟེན་གྱིས་ནཱ་ལུ་  ཨེསི་ཀིའུ་ཨེལ་བརྡ་བཀོད་ལ་ལོ་ཅིག་རྐྱངམ་ཅིག་གཡོག་བཀོལ་བཏུབ།				2002-02-02 02:02:02
