helpcontent2	source\text\schart\01\04070000.xhp	0	help	par_id3150749				0	dz	\<ahelp hid=\"SCH:CHECKBOX:DLG_GRID:CB_X_MAIN\"\>དཔེ་རིས་ཀྱི་ ཨེགསི་ཚད་ཐིག་ལུ་ གིརིཌི་གྲལ་ཐིག་ཚུ་ཁ་སྐོང་རྐྱབ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\04070000.xhp	0	help	par_id3154754				0	dz	\<variable id=\"sytextxgitter\"\>\<ahelp hid=\".uno:ToggleGridHorizontal\"\>ཐད་སྙོམས་\<emph\>གིརིཌི་ ཨཱོན་/ཨོཕ་ངོས་དཔར་་\</emph\>རྩ་སྒྲིག་འབད་ནིའི་ཕྲ་རིང་གུར་  \<emph\>ཡོད་མི་འདི་གིས\</emph\>ཨེགསི་ ཚད་ཐིག་གི་དོན་ལུ་གིརིཌི་ བཀྲམ་སྟོན་གྱི་མཐོང་གསལ་འདི་སོར་སྟོན་འབདཝ་ཨིན། དྲན་འཛིན: བཙུགས་ནིའི-་གིརིཌིསི་ནང་\<emph\>གིརིཌི་ཆུང་ཀུའི\</emph\>དཔྱད་སྒྲོམ་ཚུ་ \<emph\>སེལ་བཏང་སྟེ་ཡོད་པ་ཅིན་རྐྱངམ་ཅིག་\</emph\>  འདི་ ལཱ་འབདཝ་ཨིན། \</ahelp\>\</variable\>དེ་མེན་པ་ཅིན་ གིརིཌི་གཙོ་བོ་འདི་ཁ་བསྡམས་ད་རུང་ གིརིཌི་ཆུང་ཀུ་འདི་མཐོང་་ཚུགསཔ་སྦེ་རང་ལུསཔ་ཨིན།				2002-02-02 02:02:02
