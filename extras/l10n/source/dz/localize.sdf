helpcontent2	source\text\sbasic\shared\02\20000000.xhp	0	help	par_id3147382				0	dz	\<ahelp hid=\".uno:InsertPatternField\"\>གདོང་ཁེབས་བཟོ་ཡོད་པའི་ས་སྒོ་ཅིག་ ཁ་སྐོང་རྐྱབ་ཨིན། \</ahelp\> གདོང་ཁེབས་དང་ལྡན་པའི་ས་སྒོ་འདི་ ཨིན་པུཊི་གདོང་ཁེབས་དང་ཐད་དོན་གདོང་ཁེབས་དང་ལྡནམ་ཨིན། ཨིན་པུཊི་གདོང་ཁེབས་ཀྱིས་ ལག་ལེན་པའི་གནད་སྡུད་ག་འདི་བཙུག་ནི་ཨིན་ན་ གཏན་འབེབས་འབདཝ་ཨིན། དེ་ལས་ཐད་དོན་གདོང་ཁེབས་འདི་གིས་ འབྲི་ཤོག་མངོན་གསལ་འབད་ཡོད་པའི་སྐབས་ གདོང་ཁེབས་དང་ལྡན་པའི་ས་སྒོའི་གནས་ལུགས་གཏན་འབེབས་འབདཝ་ཨིན། 				2002-02-02 02:02:02
