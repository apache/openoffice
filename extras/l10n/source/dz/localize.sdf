helpcontent2	source\text\shared\explorer\database\05020100.xhp	0	help	par_id3155309				0	dz	\<ahelp hid=\"DBACCESS_RADIOBUTTON_DLG_REL_PROPERTIES_RB_CASC_DEL\"\> ཁྱོད་ཀྱིས་  ཆ་མཉམ་པའི་གཞི་རིམ་གཙོའི་ས་སྒོ་འདི་བཏོན་གཏང་པ་ཅིན་ ཕྱིའི་ལྡེ་མིག་གི་ས་སྒོ་ཚུ་ཡང་ཐོན་འགྱོ་འོང་ཟེར་ གསལ་བཀོད་འབདཝ་ཨིན།.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\05020100.xhp	0	help	par_id3153140	22			0	dz	\<emph\> ཀེསི་ཀེཊི་འདི་བཏོན་གཏང་ \</emph\>གདམ་ཁ་དང་བཅས་ ཁྱོད་ཀྱིས་གཞི་རིམ་གྱི་གཙོ་བོ་ས་སྒོ་འདི་བཏོན་གཏངམ་ད་  ཕྱི་རྒྱལ་གྱི་ལྡེ་མིག་སྦེ་ཡོད་མི་ འ་ནི་ལྡེ་མིག་ཡོད་མི་ཐིག་ཁྲམ་ལས་ཐོ་བཀོད་ཆ་མཉམ་ཐོན་འགྱོ་འོང་།  འ་ནི་གདམ་ཁ་འདི་བདག་འཛིན་ལེགས་ཤོམ་གྱི་ཐོག་ལས་ལག་ལེན་འཐབ་  དེ་མེན་པ་ཅིན་ གནད་སྡུད་གཞི་རྟེན་གྱི་ཆ་ཤས་སྦོམ་ཅིག་བཏོན་གཏང་ཚུགས།				2002-02-02 02:02:02
