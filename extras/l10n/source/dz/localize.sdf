helpcontent2	source\text\shared\01\ref_pdf_export.xhp	0	help	par_id9596850				0	dz	\<ahelp hid=\".\"\>འཕྲོ་མཐུད་ཀེར་ཐིག་ནང་ཤོག་ལེབ་ཟུར་ཟུར་འབད་སྟོན་མི་  པི་ཌི་ཨེཕ་ཡིག་སྣོད་གཅིག་བཟོ་བཏོན་འབད་ནི་ལུ་  སེལ་འཐུ་འབད།  ཤོག་ལེབ་གཉིས་ལས་ལྷག་མི་གི་དོན་ལུ་  ཤོག་ལེབ་དང་པ་འདི་གཡོན་གྱི་ཁ་ཐུག་ལུ་བཀྲམ་སྟོན་འབད་དེ་ཡོད།   ལག་ཆས་ཚུ་ - གདམ་ཁ་ཚུ་ - སྐད་ཡིག་སྒྲིག་སྟངས་ཚུ་ - སྐད་ཡིག་ཚུ་གུ་  ཁྱོད་ཀྱིས་  གོ་དཀའ་བའི་ཚིག་ཡིག་སྒྲིག་བཀོད་ཀྱི་དོན་ལུ་  རྒྱབ་སྐྱོར་ལྕོགས་ཅན་བཟོ་དགོ།\</ahelp\>				2002-02-02 02:02:02
