helpcontent2	source\text\shared\explorer\database\02000002.xhp	0	help	par_id3154285				0	dz	\<ahelp hid=\".\"\>ཁྱོད་ཀྱིས་གདམ་ཁ་དང་པམ་སེལ་འཐུ་འབད་ཡོད་པ་ཅིན་ དེ་འབདཝ་ད་ཆ་ཤས་ཚུ་མ་ཚང་འདི་འབད་རུང་ ཁྱོད་ཀྱིས་ཚད་རིས་ཚུའི་མཐོང་སྣང་ནང་འདྲི་དཔྱད་ཁ་ཕྱེ་ནི་ཨིན་པ་ཅིན་ ཁྱོད་ཀྱིས་གཞན་འཛོལ་བ་ཚུ་སྣང་མེད་བཞག་ཡོདཔ་ཨིན་ན་གསལ་བཀོད་འབད་ཚུགས།\</ahelp\> དེ་འབདཝ་ལས་ ད་ལྟོ་ཁ་ཕྱེ་ནིའི་ལས་སྦྱོར་ནང་ འདྲི་དཔྱད་ངེས་བདེན་སྦེ་ཁ་བསྒྱུར་འབད་མ་ཚུགས་པ་ཅིན་འཛོལ་བའི་འཕྲིན་དོན་བཀྲམ་སྟོན་མི་འབད།				2002-02-02 02:02:02
