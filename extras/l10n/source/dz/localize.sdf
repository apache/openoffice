helpcontent2	source\text\shared\01\05020400.xhp	0	help	par_id3147559				0	dz	\<variable id=\"textframe\"\>\<ahelp hid=\"SW:COMBOBOX:TP_CHAR_URL:LB_TARGET\"\>ཁྱོད་ཀྱིས་  འབྲེལ་ལམ་ཡོད་པའི་ཡིག་སྣོད་འདི་ཁ་ཕྱེ་དགོ་ནི་ལུ་  གཞི་ཁྲམ་གྱི་མིང་འདི་ཐོ་བཀོད་འབད་  ཡང་ན་  ཐོ་ཡིག་ལས་སྔོན་ངེས་འཛིན་འབད་ཡོད་པའི་གཞི་ཁྲམ་ཅིག་སེལ་འཐུ་འབད།  \</ahelp\>ཁྱོད་ཀྱིས་སྒྲོམ་འདི་སྟོངམ་བཞག་པ་ཅིན་  འབྲེལ་ལམ་ཡོད་པའི་ཡིག་སནོད་འདི་  ད་ལྟོའི་བརྡ་འཚོལ་ཝིན་ཌོ་ནང་ལུ་ཁ་ཕྱེཝ་ཨིན།\</variable\>				2002-02-02 02:02:02
