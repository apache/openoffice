helpcontent2	source\text\shared\02\18010000.xhp	0	help	par_id3155555				0	dz	དངོས་པོ་ཅིག་སེལ་འཐུ་འབད་དགོ་པ་ཅིན་ མདའ་རྟགས་ཐོག་ལས་དངོས་པོ་གུ་ཨེབ་གཏང་འབད། དངོས་པོ་ལེ་ཤ་ར་སེལ་འཐུ་འབད་དགོ་པ་ཅིན་ སེལ་འཐུའི་གཞི་ཁྲམ་ཅིག་ དངོས་པོའི་མཐའ་འཁོར་ལུ་འདྲུད། དེ་ལས་སེལ་འཐུ་ཅིག་ལུ་ དངོས་པོ་ཁ་སྐོང་བརྐྱབ་དགོ་མནོ་བ་ཅིན་ སོར་ལྡེ་ལུ་ཨེབས་ཞིནམ་ལས་ དངོས་པོའི་གུ་ཨེབ་གཏང་འབད། \<switchinline select=\"appl\"\> \<caseinline select=\"WRITER\"/\> \<caseinline select=\"CALC\"/\> \<caseinline select=\"CHART\"/\> \<caseinline select=\"MATH\"/\> \<defaultinline\> གཅིག་ཁར་སེལ་འཐུ་འབད་ཡོད་པའི་དངོས་པོ་ཚུ་ དེ་ལས་ དེ་ཚུ་སྡེ་ཚན་དངོས་པོ་རྐྱང་པ་ཅིག་ལུ་བསྒྱིར་ཏེ་  \<link href=\"text/shared/01/05290000.xhp\" name=\"group\"\>སྡེ་ཚན་\</link\> སྦེ་ངེས་འཛིན་འབདཝ་ཨིན། \</defaultinline\> \</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\18010000.xhp	0	help	par_id3143267				0	dz	\<switchinline select=\"appl\"\> \<caseinline select=\"WRITER\"/\> \<caseinline select=\"CALC\"/\> \<caseinline select=\"CHART\"/\> \<caseinline select=\"MATH\"/\> \<defaultinline\>ཁྱོད་ཀྱིས་ སྡེ་ཚན་རེ་རེའི་ངོ་རྐྱང་དངོས་པོ་ཚུ་ ཞེན་དག་འབད་བཏུབ། དེ་མ་ཚད་ ཁྱོད་ཀྱིས་ \<switchinline select=\"sys\"\> \<caseinline select=\"MAC\"\>བརྡ་བཀོད་\</caseinline\> \<defaultinline\>སོར་ལྡེ་\</defaultinline\> \</switchinline\>+ཨེབ་གཏང་དང་གཅིག་ཁར་ སྡེ་ཚན་ཅིག་ནང་ལས་ ཆ་ཤས་ཚུ་བཏོན་གཏང་བཏུབ་ཨིན། \</defaultinline\> \</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\18010000.xhp	0	help	par_id3166460				0	dz	\<switchinline select=\"appl\"\> \<caseinline select=\"WRITER\"/\> \<caseinline select=\"CALC\"/\> \<caseinline select=\"CHART\"/\> \<caseinline select=\"MATH\"/\> \<defaultinline\>ཁྱོད་ཀྱིས་ དང་པ་ར་ \<emph\>གདམ་ཁ་\</emph\> ཕྲ་རིང་ནང་ ངོས་པར་\<emph\>ཚིག་ཡིག་ཞུན་དག་འབད་ནི་ལུ་ ཨེབ་གཏང་ཚར་གཉིས་\</emph\> འདི་ ལྕོག་མིན་བཟོ་བ་ཅིན་ ཨེབ་གཏང་ཚར་གཉིས་ཀྱི་ཐོག་ལས་ སྡེ་ཚན་ཅིག་ནང་ལས་ དངོས་པོ་རྐྱང་པ་ཅིག་སེལ་འཐུ་འབད་ཚུགས། \</defaultinline\> \</switchinline\>				2002-02-02 02:02:02
