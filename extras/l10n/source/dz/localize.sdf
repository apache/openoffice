helpcontent2	source\text\shared\01\05200100.xhp	0	help	par_id3153272				0	dz	\<ahelp hid=\"HID_LINE_LINE\"\>སེལ་འཐུ་འབད་ཡོད་པའི་གྲལ་ཐིག་དོན་ལུ་དང་  ཡང་ན་  ཁྱོད་ཀྱིས་འབྲི་ནི་ཨིན་པའི་གྲལ་ཐིག་དོན་ལུ་  རྩ་སྒྲིག་གི་གདམ་ཁ་ཚུ་གཞི་སྒྲིག་འབད།  ཁྱོད་ཀྱིས་ མདའ་རྟགས་རྩེ་འདི་གྲལ་ཐིག་ཅིག་ལུ་ ཁ་སྐོང་བརྐྱབ་ནི་དང་  ཡང་ན་  དཔེ་རིས་བརྡ་མཚོན་ཚུ་བསྒྱུར་བཅོས་འབད།\</ahelp\>				2002-02-02 02:02:02
