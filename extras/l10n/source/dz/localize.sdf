helpcontent2	source\text\shared\02\03200000.xhp	0	help	par_id3150499	2			0	dz	\<variable id=\"verankerungtext\"\>\<ahelp hid=\".uno:ToggleAnchorType\"\>ཁྱོད་ལུ་ཨེན་ཀོ་རིང་གདམ་ཁ་ཚུའི་བར་ན་སོར་བསྒྱུར་འབད་བཅུགཔ་ཨིན།\</ahelp\>\</variable\> ཨེན་ཀོར་ངོས་དཔར་བསྒྱུར་བཅོས་འདི་\<emph\> ཚད་རིས་ཚུ་ \</emph\>དང་ཚད་འཛིན་ས་སྒོ་ཡང་ན་གཞི་ཁྲམ་བཟུམ་མའི་དངོས་པོ་སེལ་འཐུ་འབད་ཡོད་པ་ཅིན་\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\> རྐྱངམ་གཅིག་ \</caseinline\>\</switchinline\> མཐོང་ཚུགས།				2002-02-02 02:02:02
