helpcontent2	source\text\shared\01\05030800.xhp	0	help	par_id3150603				0	dz	\<ahelp hid=\".\"\>རྩེ་སྙོམ་ན་ ཡང་ན་ སེལ་འཐུ་གྲུབ་ཡོད་པའི་ ཚད་རིས་ཚུ་ ཚད་འཇལཝ་ཨིན།  ཁྱོད་ཀྱི་ཚད་རི་འདི་ཚུ་  ཁོ་ར་ངོ་མའི་ཚད་ནང་ལུ་  སོར་ཆུད་ཡང་འབད་བཏུབ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
