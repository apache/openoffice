helpcontent2	source\text\swriter\02\04250000.xhp	0	help	par_id3146899				0	dz	\<ahelp hid=\".uno:AutoSum\"\>དངུལ་བསྡོམས་ཀྱི་  ལས་འགན་དེ་ ཤུགས་ལྡན་བཟོཝ་ཨིན།  དངུལ་བསྡོམས་དེ་  ཁྱོད་རང་ག་དགོཔ་ནང་འབྱུང་ནི་ལུ་  འོད་རྟགས་དེ་ ནང་ཐིག་གི་ནང་དགོཔ་ཨིནམ་ སེམས་ཁར་བཞག \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\04250000.xhp	0	help	par_id3154504				0	dz	\<item type=\"productname\"\>%PRODUCTNAME\</item\> གིས་  ནང་ཐིག་ཚུ་ཨང་གྲངས་ཀྱིས་བཀང་ཡོདཔ་ལས་  བསྡོམས་ལས་འགན་དོན་ལུ་  ནང་ཐིག་ཁྱབ་ཚད་འདི་ངོས་འཛིན་འབདཝ་ཨིན།  གནས་སྡུད་འདི་ཐོ་བཀོད་འབད་ནི་ལུ་   ཁྱོད་ཀྱིས་  ཐིག་ཁྲམ་ནང་གི་སྐབས་དོན་དཀར་ཆག་ནང་ལུ་ \<emph\>ཨང་གྲངས་ངོས་འཛིན་འབད་ནི་\</emph\>འདི་ལྕོགས་ཅན་བཟོ་དགོ།				2002-02-02 02:02:02
