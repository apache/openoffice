helpcontent2	source\text\shared\00\00000002.xhp	0	help	par_id3156737				0	dz	པ་ལག་ཨིན་འདི་ཡོངས་ཁྱབ་ཀྱིས་སླབ་མི་ན་འབད་བ་ཅིན་  ལས་འགན་གོང་སྤེལ་བྱིན་མི་བྱེ་བྲག་ཏུ་འཇུག་སྤྱོད་འབད་མི་ལུ་ ཁ་སྐོང་མཉེན་ཆས་ཚུ་ཨིན།   ཡིག་སྣོད་རྩ་སྒྲིག་སྣ་མང་གི་དོན་ལུ་  ནང་འདྲེན་དང་ཕྱིར་འདྲེན་གྱི་ཚགས་མ་ཚུ་འཕྲལ་འཕྲལ་རང་  པ་ལ་གཨིན་སྣོད་ཐོ་ནང་ པ་ལག་ཨིན་སྦེ་གསོག་འཇོག་འབད་བཞགཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000002.xhp	0	help	par_id3149958				0	dz	ནེཊི་སིཀེཔ་རྒྱུན་འབྲེལ་ལས་འཛིན་གྱིས་ བཟོ་སྟོན་འབད་ཡོད་མི་  རྒྱ་བསྐྱེད་ཚུ་གི་ནེཊི་སིཀེཔི་ཝེབ་བརའུ་ཟར་ཚུ་ལུ་པ་ལག་ཨིནསི་ཟེར་སླབ་ཨིན།  དེ་ཚུ་  ཚད་ལྡན་བཟོ་ཡོད་མིའི་ངོས་འདྲ་བ་ལས་རྒྱུད་དེ་ བརའུ་ཟར་དང་བཅས་ རྒྱུན་འབྲེལ་འཐབ་མི་ སྣ་མང་བརྡ་ལམ་གྱི་ས་སྒོ་ལས་སྟོན་ཡོད་མིའི་ལས་རིམ་ཐེབས་ཨིན།  འ་ནི་པ་ལག་ཨིནསི་འདི་$[officename] ཡིག་ཆ་ཚུ་ལུ་འབྲེལ་མཐུད་འབད་བཏུབ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000002.xhp	0	help	hd_id3145647				0	dz	པོརོ་སི།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000002.xhp	0	help	par_id3148455				0	dz	པོརོ་སི་ཟེར་མི་འདི་  གནད་སྡུད་གནས་སོར་གྱི་དོན་ལུ་ འཛིན་པང་འབད་མི་ཡོངས་འབྲེལ་ནང་གི་ གློག་རིག་ཅིག་ལུ་སླབ་ཨིན། ཁྱོད་ཀྱིས་ནམ་རང་འབད་རུང་ ཚོང་སྡེ་ཡོངས་འབྲེལ་ལས་ཨིན་ཊར་ནེཊི་འཛུལ་སྤྱོད་འབདཝ་ད་དང་  ལས་རོགས་ཀྱིས་ཧེ་མ་ལས་ལྷག་ཚར་མི་གི་ཝེབ་ཤོག་ལེབ་ཞུ་བ་འབད་བའི་བསྒང་ དྲན་ཚད་ཀྱི་ནང་ལུ་ཡོད་རིང་  པོརོ་སི་གིས་ཤོག་ལེབ་འདི་འགྱོ་བ་འབད་རང་ བཀྲམ་སྟོན་འབད་ཚུགས།  གནད་དོན་དེ་ལུ་ཞིབ་དཔྱད་འབད་དགོཔ་འདི་  པོརོ་སི་ནང་གསོག་འཇོག་འབད་ཡོད་པའི་ཤོག་ལེབ་འདི་ཐོན་རིམ་མཐའ་མཇུག་ཨིན་ཅིག་དགོ། འ་ནི་འདི་གནད་དོན་ཨིན་པ་ཅིན་  ཤོག་ལེབ་དེ་ ཨིན་ཊར་ནེཊི་ལྷོད་ལྷོད་ཡོད་མི་ལས་ཕབ་ལེན་འབད་མ་དགོ་པའི་ཁར་ པོརོ་སི་ལས་ཐད་ཀར་དུ་མངོན་གསལ་འབདཝ་ཨིན།				2002-02-02 02:02:02
