helpcontent2	source\text\shared\01\05040200.xhp	0	help	par_id3154218				0	dz	\<ahelp hid=\"SVX:LISTBOX:RID_SVXPAGE_PAGE:LB_LAYOUT\"\>\<switchinline select=\"appl\"\>\<caseinline select=\"DRAW\"\>\</caseinline\>\<caseinline select=\"IMPRESS\"\>\</caseinline\>\<defaultinline\>ད་ལྟོའི་ཤོག་ལེབ་བཟོ་རྣམ་ལག་ལེན་འཐབ་མི་  ཤོག་ལེབ་ཡ་ཅན་དང་ཆ་ཅན་  དེ་ལས་  ཡ་ཅན་ཆ་ཅན་གཉིས་ཆ་རང་གི་ཤོག་ལེབ་ལུ་ རྩ་སྒྲིག་འདི་འཇུག་སྤྱོད་འབད་ནི་ཨིན་ན་མེན་གསལ་བཀོད་འབད། \</defaultinline\>\</switchinline\>\</ahelp\>				2002-02-02 02:02:02
