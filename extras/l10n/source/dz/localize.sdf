helpcontent2	source\text\shared\01\02060000.xhp	0	help	par_id3147834	5			0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>ཤོག་ཁྲམ་གྱི་ནང་ལུ་  ཁྱོད་ཀྱིས་  འཛིན་སྤང་ལས་ནང་ཐིག་གི་ཁྱབ་ཚད་ཅིག་སྦྱརཝ་ད་  གྲུབ་འབྲས་འདི་ད་ལྟོའི་སེལ་འཐུ་ལུ་རག་ལསཔ་ཨིན: ནང་ཐིག་གཅིག་རྐྱངམ་ཅིག་སེལ་འཐུ་འབད་ཡོད་པ་ཅིན་  ནང་ཐིག་ཁྱབ་ཚད་འདི་  ནང་ཐིག་ལས་འགོ་བཙུགས་ཏེ་སྦྱརཝ་ཨིན།  ཁྱོད་ཀྱིས་  ནང་ཐིག་གི་ཁྱབ་ཚད་འདི་   འཛིན་སྤང་ནང་གི་ནང་ཐིག་ཁྱབ་ཚད་ལས་  རྒྱ་ཅན་སྦེ་རྟགས་བཀལ་བ་ཅིན་  ནང་ཐིག་ཁྱབ་ཚད་འདི་  སེལ་འཐུ་འབད་ཡོད་པའི་ནང་ཐིག་ཁྱབ་ཚད་བཀང་ནི་དོན་ལུ་  ཡང་བསྐྱར་འབད་སྦྱརཝ་ཨིན།  \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
