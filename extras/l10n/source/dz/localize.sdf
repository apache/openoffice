helpcontent2	source\text\shared\explorer\database\30000000.xhp	0	help	par_id3151111				0	dz	ཁྱོད་ཀྱིས་ཡང་ཅིན་ $[officename] དང་ཅིག་ཁར་གཞི་བཙུགས་འབད་ཡོད་པའི་ ཨ་ཌ་བཱསི་གནད་སྡུད་གཞི་རྟེན་འདི་  ༡༠༠ ཨེབ་བི་གི་ཚད་དང་ ཡོངས་འབྲེལ་ལུ་ལག་ལེན་པ་མང་མཐའ་གསུམ་འདི་ མ་ཆོགཔ་སྦེ་ཚད་བཀག་དེ་ཡོདཔ་ཨིན།  རྒྱས་བཤད་མངམ་གི་དོན་ལུ་  ཨ་ཌ་བཱསི་སྣོད་ཐོ་ནང་ གི་ཡིག་སྣོད་"License.txt"ལུ་བལྟ་གནང་།  ཨ་ཌ་བཱསི་གནད་སྡུད་གཞི་རྟེན་འདི་  $[officename] ལས་ སྣོད་ཐོ་སོ་སོ་ནང་ལུ་གཞི་བཙུགས་འབད་དགོཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\30000000.xhp	0	help	par_id3154749				0	dz	ཨ་ཌ་བཱསི་ཡིག་སྣོད་ཀྱི་མིང་དེ་གིས་ ཡིག་འབྲུ་ ༨ ལས་ལྷག་མི་ཚུགས།  ཨ་ཌ་བཱསི་ཡིག་སྣོད་ལུ་འདྲེན་ལམ་འདི་ ཡིག་སྣོད་མིང་བརྩི་སྟེ་ ཡིག་འབྲུ་ ༣༠ ལས་ལྷག་མི་ཚུགས་ནི་དང་  དེ་ལས་  ཨེ་ཨེསི་སི་ཨའི་ཨའི་ཨང་རྟགས་ཀྱི་ བིཊི་ ༧ དང་བཅས་བསྟུན་དགོཔ་ཨིན།  འདྲེན་ལམ་དང་ཡིག་སྣོད་ཀྱི་མིང་གཉུས་ཆ་རང་གིས་ བར་སྟོང་འདི་ཤོང་མི་ཚུགས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\30000000.xhp	0	help	par_id3153254				0	dz	ཝིན་ཌཱསི་གི་འོག་ལུ་  གནད་སྡུད་གཞི་རྟེན་དོན་ལུ་བརྡ་དོན་འདྲེན་ལམ་ཡོད་པའི་ ཌི་བི་ཨར་ཨོ་ཨོ་ཊི་མཐའ་འཁོར་འགྱུར་ཅན་འདི་  ཨ་ཌ་བཱསི་གཞི་སྒྲིག་འཇུག་སྤྱོད་དེ་གིས་ཁ་སྐོང་རྐྱབས་ཨིན།  གཞི་སྒྲིག་འབད་དེ་ཡོད་པའི་འཇུག་སྤྱོད་དེ་གིས་ འ་ནི་འགྱུར་ཅན་འདི་ འཚོལ་འཐོབ་པ་ཅིན་  དེ་གིས་གནད་སྡུད་གཞི་རྟེན་འདི་གཞི་བཙུགས་མི་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\30000000.xhp	0	help	hd_id3154729				0	dz	ཨ་ཌ་བཱསི་གནད་སྡུད་གཞི་རྟེན་གསརཔ་འདི་གསར་བསྐྲུན་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\30000000.xhp	0	help	par_id3149378				0	dz	ཨ་ཌ་བཱསི་གནད་སྡུད་གཞི་རྟེན་འདི་ གསར་བསྐྲུན་འབད་ནི་ལུ་  \<link href=\"text/shared/explorer/database/30100000.xhp\" name=\"Create New Adabas Database\"\>\<emph\>ཨ་ཌ་བཱསི་གནད་སྡུད་གཞི་རྟེན་གསརཔ་གསར་བསྐྲུན་འབད་\</emph\>\</link\> ཌའི་ལོག་འདི་ལག་ལེན་འཐབ :				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\30000000.xhp	0	help	par_id3147045				0	dz	གནད་སྡུད་གཞི་རྟེན་ཝི་ཛརཌི་འདི་ཁ་ཕྱེ་ནི་ལུ་  \<emph\>ཡིག་སྣོད་ -གསརཔ་ - གནད་སྡུད་གཞི་རྟེན་\</emph\>གདམ་ཁ་རྐྱབས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\30000000.xhp	0	help	par_id3147394				0	dz	\<emph\>གནས་འདི་ཡོད་པའི་  གནད་སྡུད་གཞི་རྟེན་ལུ་མཐུད་ཟེར་མི་འདི་ ཨེབ་གཏང་བཞིནམ་ལས་ \</emph\>,  "Adabas" ནང་ཡོད་པའི་ཐོ་ཡིག་གི་སྒྲོམ་འདི་  (ཐོ་ཡིག་སྒྲོམ་ནང་ལུ་ བཤུད་སྒྲིལ་)སེལ་འཐུ་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\30000000.xhp	0	help	hd_id3154270				0	dz	ཨ་ཌ་བཱསི་གནད་སྡུད་གཞི་རྟེན་འདི་བཏོན་གཏང་དོ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\30000000.xhp	0	help	par_id3157869				0	dz	ཨ་ད་བཱསི་གནད་སྡུད་གཞི་རྟེན་ལུ་ གཞི་བསྟུན་འདི་བཏོན་གཏང་ནིའི་དོན་ལུ་  \<emph\>ལག་ཆས་ཚུ་ - གདམ་ཁ་ཚུ་ - %PRODUCTNAME གཞི་རྟེན་ - གནད་སྡུད་གཞི་རྟེན་ཚུ་\</emph\>གདམ་ཁ་རྐྱབས། གནད་སྡུད་གཞི་རྟེན་འདི་སེལ་འཐུ་འབད་བཞིནམ་ལས་  \<emph\>བཏོན་གཏང་\</emph\>ལུ་ཨེབ་གཏང་།				2002-02-02 02:02:02
