helpcontent2	source\text\shared\01\05030600.xhp	0	help	par_id3147653				0	dz	 \<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>དོན་མཚམས་ཚུ་དང་ ཤོག་ལེབ་ཚུ་  དེ་ལས་  མགོ་ཡིག་ཚུ་དང་མཇུག་ཡིག་ཚུ་ ཚིག་ཡིག་གཞི་ཁྲམ་ཚུ་དང་  ཐིག་ཁྲམ་ཚུ་  དེ་ལས་  ཐིག་ཁྲམ་ནང་ཐིག་ཚུ་དང་དབྱེ་ཚན་ཚུ་  དེ་ལས་ཟུར་ཐོ་འདི་ཚུ་གི་དོན་ལུ་  ཁྱོད་ཀྱིས་རྒྱབ་གཞི་འདི་གསལ་བཀོད་འབད་བཏུབ་ཨིན།  \</caseinline\>\<caseinline select=\"CALC\"\>ནང་ཐིག་ཚུ་དང་ཤོག་ལེབ་ཚུ།. \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
