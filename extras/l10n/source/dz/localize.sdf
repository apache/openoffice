helpcontent2	source\text\shared\guide\dragdrop_graphic.xhp	0	help	par_id3149763	21			0	dz	ཚད་རིས་འདི་ཡིག་ཆ་གཞན་མི་ནང་འདྲུད།  \<switchinline select=\"sys\"\>\<caseinline select=\"WIN\"\>ཡིག་ཆ་ཚུ་དུས་མཉམ་ལུ་མ་མཐོངམ་ཨིན་པ་ཅིན་ དང་པ་རང་ མའུསི་ཨེབ་རྟ་འདི་ཨེབ་ཡོད་པའི་སྐབས་ མའུསི་དཔག་བྱེད་འདི་ དམིགས་གཏད་ཡིག་ཆ་འདི་གི་ཨེབ་རྟ་འདི་ལུ་སྤོ། དྲི་བ་ནང་གི་ཡིག་ཆ་འདི་ དེ་ལས་བཀྲམ་སྟོན་འབད་ཞིནམ་ལས་ ཁྱོད་ཀྱིས་ མའུསི་དཔག་བྱེད་འདི་ཡིག་ཆ་འདི་ནང་ལུ་སྤོ་ཚུགས། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
