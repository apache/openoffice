helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3153215	43			0	dz	\<ahelp hid=\"HID_PROP_READONLY\" visibility=\"hidden\"\>ཚད་འཛིན་དེ་ ལྷག་ནི་ཙམ་ཨིན་པ་ཅིན་(ཨིན་)དང་ ཡང་ན་ ཞུན་དག་འབད་བཏུབ་ ཨིན་པ་ཅིན་(མེན)་གཏན་འབེབས་བཟོཝ་ཨིན། \</ahelp\>ལྷག་ནི་ཙམ་གྱི་\<emph\> རྒྱུ་དངོས་དེ་\</emph\> ལག་ལེན་པ་འདི་གིས་ ཐོ་བཀོད་འབད་བཏུབཔའི་ཚིག་ཡིག་གི་ནང་  ཚད་འཛིན་ཆ་མཉམ་ལུ་  འགན་སྤྲོད་འབད་བཏུབ་ཨིན། གནད་སྡུད་གཞི་རྟེན་ནང་ལས་  ཚད་རིས་ཅིག་ ཆ་འཇོག་འབད་མི་ གཟུགས་བརྙན་གྱི་ས་སྒོ་ཅིག་ལུ་  ཁྱོད་ཀྱི་ལྷག་ནི་ཙམ་གྱི་རྒྱུ་དངོས་དེ་ འགན་སྤྲོད་འབད་བ་ཅིན་  ལག་ལེན་པ་འདི་གིས་ གནད་སྡུད་གཞི་རྟེན་ནང་ལུ་ ཚད་རིས་གསརཔ་ཚུ་བཙུགས་མི་ཚུགས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170101.xhp	0	help	hd_id3148912				0	dz	མཐའ་མཚམས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3145637	140			0	dz	\<ahelp hid=\"HID_PROP_BORDER\" visibility=\"hidden\"\>ས་སྒོ་གི་མཐའ་མཚམས་དེ་ "གཞི་ཁྲམ་མེདཔ་སྦེ"དང་ "3-D look"་་ ཡང་ན་  "Flat"དང་གཅིག་ཁར་ བཀྲམ་སྟོན་འབད་དགོཔ་ཨིན་ན་ གཏན་འབེབས་བཟོཝ་ཨིན།\</ahelp\>གཞི་ཁྲམ་ཡོད་མི་ ཚད་འཛིན་གྱི་ས་སྒོ་ཚུ་དང་གཅིག་ཁར་  ཁྱོད་ཀྱི་མཐའ་མཚམས་ཀྱི་རྒྱུ་དངོས་ཚུ་  ལག་ལེན་འཐབ་ཐོག་ལས་ \<emph\> འབྲི་ཤོག་གུར་ མཐའ་མཚམས་ཀྱི་བཀྲམ་སྟོན་དེ་\</emph\>གཏན་འབེབས་བཟོ་བཏུབ། ཁྱོད་ཀྱི་ "གཞི་ཁྲམ་མེདཔ་", "3-D look" ཡང་ན་ "Flat"གདམ་ཁ་ཚུ་གི་གྱལ་ཁ་ལས་  སེལ་འཐུ་འབད་བཏུབ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170101.xhp	0	help	hd_id3149266				0	dz	ཨེབ་ལྡེ་རིམ་པ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3147483				0	dz	\<ahelp hid=\"HID_PROP_TABINDEX\"\>མཆོང་ལྡེ་ གོ་རིམ་གྱི་རྒྱུ་དངོས་འདི་གིས་ ཁྱོད་ཀྱི་ཨེབ་ལྡེ་\<emph\> ་ཨེབ་ད་\</emph\>འབྲི་ཤོག་ནང་ ཚད་འཛིན་ཚུ་ ཆེད་དམིགས་འབད་ཡོད་པའི་ གོ་རིམ་དེ་  གཏན་འབེབས་བཟོཝ་ཨིན།\</ahelp\>ཚད་འཛིན་གཅིག་ལས་ལྷག་སྟེ་ཡོད་མི་འབྲི་ཤོག་ཅིག་ནང་  ཁྱོད་ཀྱི་ཨེབ་ལྡེ་དེ་  ཨེབ་ད་ ཆེད་དམིགས་དེ་གིས་  ཤུལ་ལས་ཀྱི་ཚད་འཛིན་ནང་ལུ་ སྤོ་བཤུད་འབདཝ་ཨིན།  ཆེད་དམིགས་དེ་གིས་ ཨེབ་ལྡེ་གོ་རིམ་གི་འོག་ལུ་  ཟུར་ཐོ་དང་བཅས་ བསྒྱུར་བཅོས་འབད་ས་ལུ་ \<emph\> ཁྱོད་ཀྱི་གོ་རིམ་དེ་གསལ་བཀོད་འབད་བཏུབ།\</emph\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3156207				0	dz	ཨེབ་ལྡེ་གོ་རིམ་གྱི་རྒྱུ་དངོས་དེ་ \<emph\>སྦ་བཞག་ཡོད་པའི་\</emph\> ཚད་འཛིན་ཚུ་ལུ་ \<link href=\"text/shared/02/01170600.xhp\" name=\"Hidden Controls\"\> འཐོབ་ཚུགསཔ་མིན་འདུག\</link\>ཁྱོད་རང་དགོ་པ་ཅིན་  ཁྱོད་ཀྱི་ཨེབ་ལྡེ་དང་གཅིག་ཁར་  འ་ནི་ཚད་འཛིན་ཚུ་སེལ་འཐུ་འབད་བཏུབ་ནིའི་དོན་ལས་  གཟུགས་བརྙན་ཨེབ་རྟ་དང་ གཟུགས་བརྙན་ཚད་འཛིན་ཚུ་གི་དོན་ལུ་  ཁྱོད་ཀྱི་འ་ནི་རྒྱུ་དངོས་དེ་  གཞི་སྒྲིག་འབད་བཏུབ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3150640				0	dz	ཁྱོད་ཀྱི་ཨེབ་ལྡེ་གོ་རིམ་ནང་  ཚད་འཛིན་སོ་སོའི་ ཟུར་ཐོ་ཚུ་འཇམ་ཏོང་ཏོ་སྦེ་\<link href=\"text/shared/02/01170300.xhp\" name=\"Tab Order\"\>\<emph\>  ངེས་འཛིན་\</emph\>\</link\>འབད་བཏུབ།				2002-02-02 02:02:02
