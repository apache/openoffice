helpcontent2	source\text\shared\explorer\database\02000002.xhp	0	help	par_id3166461				0	dz	\<ahelp hid=\".\"\>ཆ་ཤས་ཚུ་མ་ཚང་འདི་འབད་རུང་ \<link href=\"text/shared/explorer/database/02010100.xhp\" name=\"Design View\"\>བཀོད་སྒྲིག་མཐོང་སྣང་ནང་\</link\> འདྲི་དཔྱད་ཁ་ཕྱེ་བཅུགཔ་ཨིན།\</ahelp\> ཨ་ནི་གདམ་ཁ་འདི་གིས་ཡང་གཞན་འཛོལ་བ་ཚུ་སྣང་མེད་བཞག་དགོ་པ་ཅིན་ཁྱོད་ལུ་གསལ་བཀོད་འབད་བཅུགཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\02000002.xhp	0	help	par_id3153031				0	dz	འདྲི་དཔྱད་འདི་བཀོད་སྒྲིག་མཐོང་སྣང་་ནང་ལུ་  ཁ་ཕྱེཝ་ཨིན་(ཚད་རིས་ཀྱི་ངོས་འདྲ་བ་)།  བརླག་སྟོར་ཞུགས་ཡོད་པའི་  ཐིག་ཁྲམ་འདི་སྟོངམ་སྦེ་འབྱུང་ནི་དང་  ནུས་ཅན་མེད་པའི་ས་སྒོ་ཚུ་ ས་སྒོ་ཚུའི་ཐོ་ཡིག་ནང་(ནུས་ཅན་མེད་)པའི་མིང་གི་ཐོག་ལས་འབྱུངམ་ཨིན།  དེ་གིས་  ཁྱོད་ལུ་  འཛོལ་བའི་རྒྱུ་རྐྱེན་གྱི་ས་སྒོ་ཏག་ཏག་དང་ཅིག་ཁར་ ལཱ་འབད་བཅུགཔ་ཨིན།				2002-02-02 02:02:02
