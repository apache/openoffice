helpcontent2	source\text\swriter\01\02110000.xhp	0	help	par_id3145587				0	dz	\<ahelp hid=\"HID_NAVI_TBX5\"\>དེ་གིས་ སེལ་འཐུ་འབད་ཡོད་མི་མགོ་མིང་དང་ མགོ་མིང་གི་འོག་ལུ་ཡོད་མི་ཚིག་ཡིག་དེ་ འགྲུལ་བསྐྱོདཔ་དང་ཡིག་ཆ་དེ་ནང་ལུ་ ཡར་ཁ་ཐུག་མགོ་མིང་གི་གནས་ས་ཅི་གི་རྩིས་སྤེ་བཤུད་འབདཝ་ཨིན། མགོ་མིང་དང་འབྲེལ་བའི་ཚིག་ཡིག་མ་ཡིན་པའི་ སེལ་འཐུ་འབད་ཡོད་མི་མགོ་མིང་དེ་རྐྱངམ་ཅིག་སྤོ་བཤུད་འབད་ནིའི་དོན་ལུ་ ཚད་འཛིན་དེ་མར་འཆང་ཞིནམ་ལས་ དེ་ལས་ ངོས་དཔར་འདི་ལུ་ཨེབ་གཏང་འབད།\</ahelp\>				2002-02-02 02:02:02
