helpcontent2	source\text\shared\guide\data_search2.xhp	0	help	par_id3152462				0	dz	\<ahelp hid=\".uno:FormFilterExecute\"\>ཁྱོད་ཀྱིས་འབྲི་ཤོག་ཚགས་མའི་ \<emph\>ལག་ཆས་ཕྲ་རིང་གུ་\</emph\> འཇུག་སྤྱོད་འབྲི་ཤོག་-གཞི་རྟེནཚགས་མའི་ \<emph\>ངོས་དཔར་\</emph\> ཨེབ་གཏང་པ་ཅིན་ ཚགས་མ་འདི་འཇུག་སྤྱོད་འབད་འོང་།\</ahelp\>ཁྱོད་ཀྱིས་ \<emph\>འབྲི་ཤོག་འགྲུལ་བསྐྱོད་\</emph\> ལག་ཆས་ཕྲ་རིང་བལྟ་ནི་དང་སྙན་ཞུ་ཚུ་ཐོབ་མི་བརྒྱུད་དེ་བརྡ་འཚོལ་ཚུགས།				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\data_search2.xhp	0	help	par_id3145273				0	dz	\<ahelp hid=\".uno:FormFilterExit\"\>ཁྱོད་ཀྱིས་འབྲི་ཤོག་ཚགས་མ་ལག་ཆས་ཕྲ་རིང་གུ་ \<emph\>ཁ་བསྡམས་\</emph\> ཨེབ་རྟ་གུ་ \<emph\>ཨེབ་གཏང་པ་ཅིན་\</emph\> འབྲི་ཤོག་འདི་ཚགས་མ་མེདཔ་སྦེ་བཀྲམ་སྟོན་འབདཝ་ཨིན།  \</ahelp\>				2002-02-02 02:02:02
