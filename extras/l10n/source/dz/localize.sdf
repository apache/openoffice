helpcontent2	source\text\shared\guide\dragdrop_beamer.xhp	0	help	par_id3154685				0	dz	ཁྱོད་ཀྱིས་གནད་སྡུད་གཞི་རྟེན་གྱི་ས་སྒོ་ཅིག་ ཚིག་ཡིག་གི་ཡིག་ཆ་ཅིག་ནང་ལུ་ ས་སྒོའི་མིང་ཅིག་ གནད་སྡུད་འབྱུང་ཁུངས་མཐོང་སྣང་གི་ཀེར་ཐིག་མགོ་ཡིག་འདི་ལས་ ཡིག་འདི་ནང་ལུ་ འདྲུད་པའི་ཐོག་ བཙུགས་ཚུགས། འ་ནི་འདི་ ཡིག་གུ་ཚུ་ལས་བཀོད་སྒྲིག་འབད་བའི་སྐབས་ལྷག་པར་དུ་ཕན་ཐོགས་ཅན་ཨིན། རེ་འདུན་ཡོད་པའི་ས་སྒོ་ཚུ་ - ཁྱིམ་ཁ་བྱང་ ཁ་བྱང་གི་འབྲི་ཤོག་ དང་དེ་ལས་ལྷག་སྟེ་ ཁྱོད་རའི་ཡིག་ཆ་ནང་ལུ་འདྲུད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\guide\dragdrop_beamer.xhp	0	help	par_id3153105				0	dz	དྲན་ཐོ་ཆ་ཚང་ཅིག་བཙུག་ནིའི་དོན་ལས་ ཆ་མཉམ་པའི་མགོ་ཡིག་འདི་སེལ་འཐུ་འབད་ཞིནམ་ལས་ ཡིག་ཆ་ནང་ལུ་འདྲུད། ཁྱོད་ཀྱིས་མའུསི་ཨེབ་རྟ་འདི་གསར་བཏོན་འབད་བའི་སྐབས་  \<link href=\"text/shared/02/12070000.xhp\" name=\"Insert database columns\"\>\<emph\>གནད་སྡུད་གཞི་རྟེན་ཀེར་ཐིག་\</emph\>\</link\> ཌའི་ལོག་ ཁྱོད་ཀྱིས་ ཡང་ཅིན་ གནད་སྡུད་གཞི་རྟེན་ས་སྒོ་ཚུ་ཆ་མཉམ་ལག་ལེན་འཐབ་ནི་ཨིན་ན་དང་ ཡང་ཅིན་གནད་སྡུད་འདི་ ཚིག་ཡིག་ ཐིག་ཁྲམ་ ཡང་ན་ས་སྒོ་སྦེ་ཡིག་ཆ་འདི་ནང་ལུ་འདྲ་བཤུས་རྐྱབས་ནི་ཨིན་ན་ གྲོས་ཐག་བཅད་ཚུགས་མི་ འབྱུངམ་ཨིན། ད་ལྟོ་སེལ་འཐུ་འབད་འབད་བའི་དྲན་ཐོ་ཚུ་ཆ་མཉམ་བཙུགས་འོང་།				2002-02-02 02:02:02
