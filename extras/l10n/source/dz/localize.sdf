helpcontent2	source\text\simpress\02\10080000.xhp	0	help	par_id3147301				0	dz	\<ahelp hid=\".uno:LineToolbox\"\>འབྲི་ནིའི་ཕྲ་རིང་འདི་གུ་གུག་གུགཔ་ངོས་དཔར་འདི་གིས་ \<emph\>ཁྱོད་ཀྱིས་\</emph\> ད་ལྟོའི་བཤུད་ལུ་དབྱིབས་ཚུ་དང་གྲལ་ཐིག་ཚུ་ཁ་སྐོང་རྐྱབ་ཚུག་ནི་ཨིན་མི་གྲལ་ཐིག་ལག་ཆས་ཕྲ་རིང་ཁ་ཕྱེཝ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\simpress\02\10080000.xhp	0	help	par_id3157873				0	dz	ཁྱོད་ཀྱིས་སོར་ལྡེ་མར་བཀག་བཞག་པ་ཅིན་ མཱའུསི་གི་འགུལ་བསྐྱོད་འདི་ཁུག་ཟུར་༤༥ གི་སྣ་མང་ཚུ་ལུ་ཚད་འབད་ཡོདཔ་ཨིན། ཁྱོད་ཀྱིས་གདམ་ཁ་ཚུའི་གདམ་ལྡེ་ལྡེ་མིག་བུ་བཀག་བཞག་པ་ཅིན་ \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>རྩེ་གསརཔ་འདི་ \</caseinline\>\<defaultinline\>མཐའ་རྩེ་ལུ་\</defaultinline\>\</switchinline\>མཐུད་མི་བཏུབ། འ་ནི་འདི་ཁྱོད་ལུ་གཅིག་ཁར་མཐུད་འདི་མེད་མི་གུག་གུགཔ་ཚུ་ཡོད་མི་དངོས་པོ་ཚུ་གསར་བསྐྲུན་འབད་བཅུགཔ་ཨིན། ཁྱོད་ཀྱིས་ད་ལྟོ་ཁ་མ་བསྡམས་མི་དངོས་པོ་སྦོམ་ཤོས་ནང་ལུ་གདམ་ཁ་ཚུའི་གདམ་ལྡེ་ལྡེ་མིག་བུ་བཀག་བཞགཔ་ད་ཁྱོད་ཀྱིས་དངོས་པོ་ཆུང་ཤོས་འབྲི་བ་ཅིན་ \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>སྦོམ་ཤོས་ནང་ལུ་ \</caseinline\>\<defaultinline\>དོང་ཕུ་སྦེ་\</defaultinline\>\</switchinline\>འབྱུང་མི་ལུ་བརྟེན་དངོས་པོ་ཆུང་ཤོས་འདི་སྦོམ་ཤོས་ལས་ཕབ་གཏངམ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\simpress\02\10080000.xhp	0	help	par_id3153083	8			0	dz	ཁ་བསྡམས་ཡོད་པའི་དབྱིབས་འདི་གིས་བཀང་ནིའི་ཕྲ་རིང་དང་གྲལ་ཐིག་གུ་མངའ་ཁོངས་བཟོ་རྣམ་སྒྲོམ་ནང་བཀྲམ་སྟོན་འབད་ཡོད་མི་ \<emph\>བཀང་ནི་དེ་\</emph\>རང་བཞིན་གྱིས་ \<emph\>ལེནམ་\</emph\> ཨིན། 				2002-02-02 02:02:02
