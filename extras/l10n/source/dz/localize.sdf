helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153081	37			0	dz	\<item type=\"keycode\"\>= ཌི་ཌི་ཨི་ ("soffice";"c:\\office\\document\\motto.sxw";"Today's motto")\</item\> གིས་ འ་ནི་མན་ངག་ནང་ན་ཤོམ་ཏེ་ཡོད་པའི་ ནང་ཐིག་ནང་ དམིགས་གཏད་སླར་ལོག་འབདཝ་ཨིན། དང་པ་རང་ ཁྱོད་ཀྱིས་ ནང་ན་དམིགས་གཏད་ཚིག་ཡིག་ཤོམ་ཏེ་ཡོད་པའི་ དམིགས་གཏད་  sxw ཡིག་ཆ་ནང་ལུ་ གྲལ་ཐིག་གཅིག་བཙུགས་བཞིནམ་ལས་ བཙུགས་ནིའི་དབྱེ་ཚན་འོག་ལུ་ཡོད་པའི་ \<item type=\"literal\"\> ད་རེས་ཀྱི་དམིགས་གཏད་ཟེར་མིང་བཏགས་ཡོད་པའི་དབྱེ་ཚན་གྱི་ \</item\> (in \<item type=\"productname\"\>%PRODUCTNAME\</item\> གྲལ་ཐིག་ \<emph\> དང་པམ་སྦེ་ \</emph\>) ངེས་འཛིན་འབད་དགོཔ་ཨིན། \<item type=\"productname\"\>%PRODUCTNAME\</item\> རའི་ཊར་ཡིག་ཆ་ནང་ལུ་ དམིགས་གཏད་དེ་ ལེགས་བཅོས་འབད་དེ་ཡོད་པ་ཅིན་(སྲུང་བཞག་འབད་ཡོད་པ་ཅིན་) དམིགས་གཏད་དེ་ ཌི་ཌི་ཨི་འབྲེལ་ལམ་དེ་ངེས་འཛིན་འབད་ཡོད་པའི་ \<item type=\"productname\"\>%PRODUCTNAME\</item\> ཀེལ་སི་ནང་ཐིག་ཚུ་ཆ་མཉམ་ནང་ དུས་མཐུནམ་བཟོ་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
