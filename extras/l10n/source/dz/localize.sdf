helpcontent2	source\text\shared\optionen\01070000.xhp	0	help	par_id3146957				0	dz	\<variable id=\"allgemein\"\>\<ahelp hid=\".uno:SdEditOptions\"\>དྲན་ཐོ་ཚུ་དང་བཀྲམ་ཤོག་ཚུ་ཨ་རྟག་རང་བཀྲམ་སྟོན་འབད་ཡོད་པ་ཅིན་དང་ གིརིདི་ཕྲང་སྒྲིག་འདི་ག་དེ་འབད་འབགཔ་ཨིན་ན་དང་འབག་པ་ཅིན་ ཚད་འཇལ་ཆ་ཕྲན་ལག་ལེན་ བཀྲམ་སྟོན་འབད་ནི་ལུ་ནང་དོན་ཚུ་བཟུམ་མའི་ གསརཔ་སྦེ་གསར་བསྐྲུན་འབད་ཡོད་པའི་གསལ་སྟོན་ཡིག་ཆ་ཚུ་གི་དོན་ལས་སྒྲིག་སྟངས་ཚུ་ལེ་ཤ་ཅིག་ངེས་འཛིན་འབདཝ་ཨིན།\</ahelp\>\</variable\>				2002-02-02 02:02:02
