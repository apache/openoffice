helpcontent2	source\text\swriter\02\18030100.xhp	0	help	par_id3147511				0	dz	\<ahelp hid=\".uno:InsertDateField\"\>ད་ལྟོའི་ཚེས་གྲངས་དེ་ ས་སྒོ་སྦེ་བཙུགསཔ་ཨིན།\</ahelp\> སྔོན་སྒྲིག་ཚེས་གྲངས་ཀྱི་རྩ་སྒྲིག་དེ་  ལག་ལེན་འཐབ་ཡོདཔ་ཨིནམ་དང་  ཚེས་གྲངས་དེ་  རང་བཞིན་གྱིས་དུས་མཐུན་མ་བཟོ་བར་བཞགཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\18030100.xhp	0	help	par_id3151312				0	dz	ཁྱོད་ཀྱི་ཚེས་གྲངས་ཀྱི་རྩ་སྒྲིག་སོ་སོ་ཅིག་  ངེས་འཛིན་འབད་དགོཔ་དང་  ཡང་ན་  རང་བཞིན་གྱིས་  དུས་མཐུན་བཟོ་ཡོད་པའི་ ཚེས་གྲངས་དེ་  ཡོད་པ་ཅིན་ \<emph\>ས་སྒོའི་ཌའི་ལོག་ནང་\</emph\> རེ་འདོད་བསྐྱེད་ཡོད་པའི་ སྒྲིག་སྟངས་ཚུ་བཟོ་ནི་དང་ ས་སྒོའི་བརྡ་བཀོད་ཅིག་ བཙུགས་ནི་ལུ་\<link href=\"text/swriter/01/04090000.xhp\" name=\"Fields\"\>\<emph\>བཙུགས་ནི་-ས་སྒོ་-གཞན་མི་ཚུ་\</emph\>\</link\>སེལ་འཐུ་འབད། ཞུན་དག་གི་-ས་སྒོ་ཚུ་ གདམ་ཁ་རྐྱབ་ཐོག་ལས་ \<link href=\"text/swriter/01/02140000.xhp\" name=\"Edit - Fields\"\>\<emph\>ཡོད་བཞིན་པའི་ཚེས་གྲངས་ས་སྒོ་གི་ རྩ་སྒྲིག་འདི་  དུས་ཚོད་ནམ་རང་འབད་རུང་  ལེགས་བཅོས་འབད་བཏུབ་ཨིན།\</emph\>\</link\>				2002-02-02 02:02:02
