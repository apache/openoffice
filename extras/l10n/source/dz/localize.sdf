helpcontent2	source\text\shared\01\06150200.xhp	0	help	par_id3147250				0	dz	\<ahelp hid=\"HID_XML_FILTER_TEST_EXPORT_CURRENT\"\>ཨེགསི་ཨེམ་ཨེལ་ཚགས་མའི་ཁྱད་ཚད་ལུ་མཐུན་མི་  ཡིག་སྣོད་ཁ་ཕྱེ་བའི་མདོང་འདི་   ཚགས་མ་བརྟག་ཞིབ་འབད་ནི་དོན་ལུ་ལག་ལེན་འཐབ་འོང་།  ད་ལྟོའི་ཨེགསི་ཨེམ་ཨེལ་ཕྱིར་འདྲེན་ཚགས་མ་གིས་  ཡིག་སྣོད་འདི་བཟོ་བསྒྱུར་འབད་ནི་དང་  ཨེགསི་ཨེམ་ཨེལ་ཨང་རྟགས་འགྲུབ་འབྲས་འདི་ \<link href=\"text/shared/01/06150210.xhp\"\>ཨེགསི་ཨེམ་ཨེལ་ཚགས་མའི་ཨའུཊི་པུཊི་\</link\> སྒོ་སྒྲིག་ནང་ལུ་བཀྲམ་སྟོན་འབད་ཡོད།\</ahelp\>				2002-02-02 02:02:02
