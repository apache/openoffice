helpcontent2	source\text\shared\02\01230000.xhp	0	help	par_id3144436				0	dz	\<ahelp hid=\".uno:DesignerDialog\"\>ཁྱོད་ཀྱི་བཟོ་རྣམ་འདི་ཚུ་  འགན་སྤྲོད་དང་  འགོ་འདྲེན་འཐབ་བཏུབ་ས་ལུ་  རྩ་སྒྲིག་འབད་ནིའི་ ཝིན་ཌོ་དང་  བཟོ་རྣམ་འདི་ཚུ་  སྟོན་ནི་དང་ བཞག་ནི་ཚུ་ ག་དེ་སྦེ་  འབད་ནི་ཨིན་ན་  གསལ་བཀོད་འབདཝ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01230000.xhp	0	help	par_id3153894				0	dz	$[officename] གི་གློག་རིམ་རེ་རེ་བཞིན་ལུ་  ཁོང་ར་  རང་དབང་གི་བཟོ་རྣམ་དང་ཝིན་ཌོ་རྩ་སྒྲིག་འབད་ནི་ཚུ་ཡོད།  ད་ལས་ཕར་\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<link href=\"text/swriter/01/05140000.xhp\" name=\"text documents\"\>ཚིག་ཡིག་གི་ཡིག་ཆ་ཚུ་\</link\>\</caseinline\>\<defaultinline\>ཚིག་ཡིག་གི་ཡིག་ཆ་ཚུ་\</defaultinline\>\</switchinline\>དང་  \<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>\<link href=\"text/scalc/01/05100000.xhp\" name=\"spreadsheets\"\>ཤོག་ཁྲམ་ཚུ\</link\>\</caseinline\>\<defaultinline\>ཤོག་ཁྲམ་ཚུ་\</defaultinline\>\</switchinline\>དེ་ལས་  \<switchinline select=\"appl\"\>\<caseinline select=\"IMPRESS\"\>\<link href=\"text/simpress/01/05100000.xhp\" name=\"presentations/drawing documents\"\>གསལ་སྟོན་/པར་རིས་ཡིག་ཆ་ཚུ་\</link\>\</caseinline\>\<caseinline select=\"DRAW\"\>\<link href=\"text/simpress/01/05100000.xhp\" name=\"presentations/drawing documents\"\>གསལ་སྟོན་/པར་རིས་ཡིག་ཆ་ཚུ་\</link\>\</caseinline\>\<defaultinline\>གསལ་སྟོན་/པར་རིས་ཡིག་ཆ་ཚུ་གི་དོན་ལུ་\</defaultinline\>\</switchinline\>ཝིན་ཌོ་སོ་སོ་སྦེ་ཡོད།				2002-02-02 02:02:02
