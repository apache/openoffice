helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3163714	56			0	dz	\<variable id=\"wahr\"\> འཛོལ་བ་འབྱུང་པ་ཅིན་ལས་འགན་འདི་གིས་གཏན་ཚིག་ཅན་  ཡང་ཅིན་  ཨང་གྲངས་ཀྱི་གནས་གོང་འདི་སླར་ལོག་འབདཝ་ཨིན།\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3154145	54			0	dz	\<variable id=\"kontext\"\>( འ་ནི་བརྡ་བཀོད་འདི་ \<link href=\"text/shared/00/00000005.xhp#kontextmenue\" name=\"context menu\"\>context menu\</link\>)ལས་རྐྱངམ་ཅིག་འཛུལ་སྤྱོད་འབད་ཚུགས། \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000001.xhp	0	help	par_id3152791	61			0	dz	\<variable id=\"wiederholen\"\> ལག་ཆས་ལུ་ཨེབ་གཏང་གཉིས་ལྡན་འབད་འདི་ ཁྱོད་རང་ལས་ཀ་སྣ་མང་ཚུ་གི་དོན་ལུ་ལག་ལེན་འཐབ་བཏུབ།  ཁྱོད་ཀྱིས་  ལག་ཅས་འདི་ཨེབ་གཏང་རྐྱང་པ་གི་ཐོག་ལས་འབད་བ་ཅིན་  ལས་ཀ་འདི་མཇུག་བསྡུ་བཞིནམ་ལས་ལོག་འདི་རང་མཇུག་གི་སེལ་འཐུ་ལུ་རྒྱབ་ལོགཔ་ཨིན། \</variable\>				2002-02-02 02:02:02
