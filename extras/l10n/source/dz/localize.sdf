helpcontent2	source\text\shared\02\07070200.xhp	0	help	par_id3163829	2			0	dz	\<ahelp hid=\".\"\>ད་ལྟོའི་གནད་སྡུད་གཞི་རྟེན་ཐིག་ཁྲམ་དྲན་ཐོ་བསྲུང་བཞག་འབདཝ་ཨིན།\</ahelp\> The\<emph\> བསྲུང་བཞག་དྲན་ཐོ་ \</emph\>ངོས་དཔར་འདི་ \<link href=\"text/shared/main0212.xhp\" name=\"Database Bar\"\>ཐིག་ཁྲམ་གནད་སྡུད་ཕྲ་རིང་གུ་ལུ་ཐོབ་ཨིན།\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\07070200.xhp	0	help	par_id3152372				0	dz	ཁྱོད་ཀྱི་དྲན་ཐོ་ གཞན་ཅིག་སེལ་འཐུ་འབད་ཚརཝ་ཅིན་  དྲན་ཐོ་ཅིག་གི་ ནང་དོན་ཚུ་ལུ་  བསྒྱུར་བཅོས་འདི་ཚུ་  རང་བཞིན་གྱི་སྲུངས་བཞག་འབད་འགྱོཝ་ཨིན།  དྲན་ཐོ་གཞན་ཅིག་སེལ་འཐུ་མ་འབད་བར་  བསྒྱུར་བཅོས་འདི་ཚུ་  སྲུངས་བཞག་འབད་ནི་ལུ་  \<emph\>སྲུངས་བཞག་དྲན་ཐོ་གི་\</emph\> ངོས་དཔར་འདི་ལུ་ ཨེབ་གཏང་འབད།				2002-02-02 02:02:02
