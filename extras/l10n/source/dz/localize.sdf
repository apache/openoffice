helpcontent2	source\text\shared\explorer\database\30100000.xhp	0	help	par_id3154190				0	dz	\<ahelp hid=\"HID_DLG_ADABAS_TRANSACTIONLOG\"\>སྤྲོད་ལེན་དྲེན་དེབ་ཡིག་སྣོད་དོན་ལུ་  འདྲེན་ལམ་འདི་བཙུགས།\</ahelp\> སྤྲོད་ལེན་ཅིག་གི་སྐབས་ལུ་  གནད་སྡུད་གཞི་རྟེན་ལུ་བཟོ་ཡོད་པའི་ ལེགས་བཅོས་ཚུ་ཆ་མཉམ་གྱི་  ཡིག་སྣོད་འདི་གིས་ཐོ་འགོད་འབདཝ་ཨིནམ་དང་  སྤྲོད་ལེན་འདི་མཇུག་བསྡུཝ་ད་  དེ་ཚུ་ཚབ་སྲུངས་འབདཝ་ཨིན།  སྤྲོད་ལེན་དྲེན་དེབ་འདི་  སྤྲོད་ལེན་ཅིག་གི་རྒྱབ་བསྒྲིལ་དོན་ལུ་ཡང་ ལག་ལེན་འཐབ་དོ་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
