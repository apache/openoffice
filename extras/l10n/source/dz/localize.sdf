helpcontent2	source\text\swriter\01\04120211.xhp	0	help	par_id3152772				0	dz	\<variable id=\"vorlg\"\>\<ahelp hid=\"SW:CHECKBOX:TP_TOX_SELECT:CB_ADDSTYLES\"\> ཁྱོད་ཀྱིས་  \<emph\>བཟོ་རྣམ་ཌའི་ལོག་\</emph\>འགན་སྤྲོད་ནང་ལུ་ཟུར་ཐོའི་ཐོ་འགོད་བཟུམ་སྦེ་ གསལ་བཀོད་འབད་དེ་ཡོད་མི་ དོན་མཚམས་ཀྱི་བཟོ་རྣམ་ཚུ་ གྲངས་སུ་བཙུགསཔ་ཨིན། ཁྱོད་ཀྱིས་ཟུར་ཐོའི་གྲངས་སུ་བཙུགས་འདོ་མནོ་མི་དོན་མཚམས་ཀྱི་བཞོརྣམ་ཚུ་སེལ་འཐུ་འབད་ནིའི་དོན་ལུ་ \<emph\>འགན་སྤྲོད་བཟོ་རྣམ་ (...\</emph\>)ཨེབ་རྟ་དེ་ སྒྲོམ་འདི་གི་གཡས་ཁ་ཐུག་ལུ་ཨེབ་གཏང་འབད།\</ahelp\>\</variable\>				2002-02-02 02:02:02
