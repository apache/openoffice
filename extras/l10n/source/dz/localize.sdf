helpcontent2	source\text\shared\explorer\database\30100000.xhp	0	help	par_id3152597				0	dz	\<ahelp hid=\"HID_DLG_ADABAS_DATADEVSPACE\"\>གནད་སྡུད་ཌེབ་བར་སྟོང་དོན་ལུ་ འདྲེན་བྱེད་འདི་བཙུགས། \</ahelp\>ཡིག་སྣོད་དེ་གིས་  ཐིག་ཁྲམ་ཚུ་དང་  ཟུར་ཐོ་ཚུ་ དེ་ལས་ ཨེསི་ཀིའུ་ཨེལ་ཐོ་གཞུང་(ལས་འཆར་བརྡ་དོན་)བཟུམ་གྱི་  ལག་ལེན་པའི་གནད་སྡུད་ གསོག་འཇོག་འབདཝ་ཨིན།  ལག་ལེན་པའི་ཐིག་ཁྲམ་གཅིག་གི་ནང་ལུ་ཡོད་པའི་གནད་སྡུད་འདི་   ཆ་ཅན་གྱིས་སྦེ་ ཌ་ཊ་ཌེབ་བར་སྟོང་ཨེསི་ ཆ་མཉམ་ཡན་ཆད་ལུ་  བགོ་བཀྲམ་འབད་ཡོདཔ་ཨིན།  ཌ་ཊ་ཌེབ་བར་སྟོང་ཨེསི་ལུ་མཉམ་མཐུད་སྦེ་ཡོད་པའི་ཚད་ཆ་མཉམ་རང་  གནད་སྡུད་གཞི་རྟེན་གྱི་ཚད་ལུ་ ཆ་མཉམ་དོ་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\30100000.xhp	0	help	par_id3150103				0	dz	ཨ་ཌ་བཱསི་གནད་སྡུད་གཞི་རྟེན་གྱི་ཐོན་རིམ་ཚད་ནང་གི་  ཌ་ཊ་ཌེབ་བར་སྟོང་ཅིག་གི་དོན་ལུ་ ཚད་མང་མཐའ་འདི་  ཨེམ་བི་ ༡༠༠ ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\30100000.xhp	0	help	par_id3147426				0	dz	གནད་སྡུད་བཀོལ་སྤྱོད་སྐབས་ལུ་  ཌ་ཊ་ཌེབ་བར་སྟོང་འདི་  ཤོང་ཚད་ཆ་ཚང་ལུ་ལྷོད་དེ་ཡོད་པ་ཅིན་  ཨ་ཌ་བཱསི་འདི་སྒོ་བསྡམས་ནི་དང་  ཌ་ཊ་ཌེབ་བར་སྟོང་(ཨེམ་བི་ ༡༠༠ ཚུན་) གི་ཤོང་ཚད་འདི་ཡར་འཕར་འབདཝ་ཨིནམ་དང་  གནད་སྡུད་གཞི་རྟེན་འདི་ལོག་འགོ་བཙུགསཔ་ཨིན།  སྲུངས་བཞག་སྟེ་ཡོད་པའི་གནད་སྡུད་འདི་བརླག་སྟོར་ཞུགས་དེ་མེདཔ་ཨིན།				2002-02-02 02:02:02
