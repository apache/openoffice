helpcontent2	source\text\shared\00\00000005.xhp	0	help	par_id3145154				0	dz	ཌི་ཌི་ཨི་འདི་ "Dynamic Data Exchange,"ལུ་ དེ་ཡང་ ཨོ་ཨེལ་ཨི་"Object Linking and Embedding"གི་སྔོན་མམ་ལུ་གོཝ་ཨིན། ཌི་ཌི་ཨ་དང་བཅས་ དངོས་པོ་ཚུ་ ཡིག་སྣོད་ཀྱི་གཞི་བསྟུན་ཐོག་ལས་འབྲེལ་མཐུད་འབད་ཡོདཔ་ དེ་འབདཝ་ད་གནས་འདྲེན་མ་འབད་བར་ཡོད་མི།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000005.xhp	0	help	par_id3154820				0	dz	ཁྱོད་ཀྱིས་ཌི་ཌི་ཨི་གི་འབྲེལ་མཐུད་འདི་ འོག་གི་བྱ་སྒོའི་ལམ་ལུགས་ལག་ལེན་འཐབ་སྟེ་གསར་བསྐྲུན་འབད་ཚུགས:སི་ཨེ་ཨེལ་སི་ཤོག་ཁྲམ་ལས་ནང་ཐིག་ཅིག་སེལ་འཐུ་འབད་བཞིནམ་ལས་  དེ་ཚུ་འཛིན་པང་ནང་ལུ་འདྲ་བཤུས་བརྐྱབ་ནི་དང་ དེ་ལས་ ཤོག་ཁྲམ་གཞན་མི་ཅིག་ལུ་སོར་བསྒྱུར་འབད་བཞིནམ་ལས་   \<emph\>ཞུན་དག་འབད་ - དམིགས་བསལ་གྱི་སྦྱར་\</emph\> dialog སེལ་འཐུ་འབད།  ཌི་ཌི་ཨི་འབྲེལ་མཐུད་སྦེ་ནང་དོན་བཙུགས་ནིའི་དོན་ལུ་ \<emph\>འབྲེལ་མཐུད་\</emph\>གདམ་ཁ་འདི་ སེལ་འཐུ་འབད།  འབྲེལ་མཐུད་དེ་ཤུགས་ལྡན་བཟོ་བའི་བསྒང་ ནང་ཐིག་གི་མངའ་ཁོངས་བཙུགས་ཡོད་མི་འདི་ ཁོ་རའི་ཡིག་སྣོད་ངོ་མ་ལས་ལྷབ་འོང་།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000005.xhp	0	help	hd_id3150439				0	dz	ཐད་ཀར་དང་བཟོ་རྣམ་རྩ་སྒྲིག་འབད་དོ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000005.xhp	0	help	par_id3159254				0	dz	ཁྱོད་ཀྱིས་ཡིག་ཆ་འདི་ བཟོ་རྣམ་མེད་པར་རྩ་སྒྲིག་འབད་བ་ཅིན་ དེ་ལུ་ "direct" རྩ་སྒྲིག་ཟེར་གཞི་བསྟུན་འབདཝ་ཨིན།  དེའི་དོན་དག་འདི་ ཁྱད་ཆོས་སྣ་མང་ཐད་ཀར་དུ་འཇུག་སྤྱོད་འབད་ གཞི་ཁྲམ་ཡང་ན་ཐིག་ཁྲམ་བཟུམ་གྱི་  ཚིག་ཡིག་ཡང་ན་ དངོས་པོ་གཞན་ལེགས་བཅོས་འདི་ཨིན།  རྩ་སྒྲིག་དེ་གིས་ སེལ་འཐུ་འབད་ཡོད་མི་མངའ་ཁོངས་རྐྱངམ་ཅིག་ལུ་འཇུག་སྤྱོད་འབདཝ་ལས་ བསྒྱུར་བཅོས་ཚུ་ཆ་མཉམ་སོ་སོ་བཟོ་དགོ།  གཞན་མི་ནང་བཟོ་རྣམ་འདི་ ཚིག་ཡིག་ལུ་ཐད་ཀར་དུ་འཇུག་སྤྱོད་འབད་ནི་མེད་པའི་ཁར་  བཟོ་རྣམ་ལུ་ངེས་འཛིན་འབད་ནི་དང་  སྒོ་སྒྲིག་ལུ་རྩ་སྒྲིག་འབད་བཞིནམ་ལས་ དེ་ལས་ འཇུག་སྤྱོད་འབདཝ་ཨིན། ཕན་ཐོགས་ཅིག་འདི་ ཁྱོད་ཀྱིས་བཟོ་རྣམ་བསྒྱུར་བཅོས་འབད་བའི་བསྒང་ བཟོ་རྣམ་འགན་སྤྲོད་ཡོད་པའི་ཡིག་ཆ་གི་ཆ་ཤས་ཚུ་ཆ་མཉམ་དུས་ཡུན་ཅིག་ཁར་ལེགས་བཅོས་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\00\00000005.xhp	0	help	par_id3147287				0	dz	མགྱོགས་ཐབས་ཀྱི་ལྡེ་མིག་keys \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>བརྡ་བཀོད་ \</caseinline\>\<defaultinline\>ཚད་འཛིན་\</defaultinline\>\</switchinline\>+ཨེ་ དང་དེ་ལས་གདམ་ཁ་བརྐྱབ་སྟེ་\<emph\>རྩ་སྒྲིག་ - སྔོན་སྒྲིག་རྩ་སྒྲིག་འབད་དོ་\</emph\> དང་བཅས་ཚིག་ཡིག་གེ་ར་སེལ་འཐུ་འབད་བཞིནམ་ལས་ ཁྱོད་རའི་ཡིག་ཆ་ལས་ཁྱོད་ཀྱིས་ཐད་ཀར་རྩ་སྒྲིག་རྩ་བསྐྲད་གཏང་ཚུགས།				2002-02-02 02:02:02
