helpcontent2	source\text\sbasic\shared\01030400.xhp	0	help	par_id3145637				0	dz	ཚད་གཞི་ཡང་ན་ཌའི་ལོག་ཡིག་ཆ་གཞན་ལུ་སྤོ་ནི་ལུ་ ཐོ་ཡིག་ནང་མཉམ་པའི་ཐོག་ལས་དངོས་པོ་ནང་ཨེབ་གཏང་འབད་ནི་དང་རེ་འདུན་གནས་ས་འདི་ལུ་འདྲུད་འབད། ཐད་སྙོམས་གྱལ་གྱིསའདྲུད་པའི་སྐབས་ད་ལྟོའི་དངོས་པོ་གི་དམིགས་གཏད་གནས་ས་འདི་བརྡ་སྟོནམ་ཨིན། \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>གདམ་ཁ་ \</caseinline\>\<defaultinline\>ཚད་འཛིན་\</defaultinline\>\</switchinline\> ལྡེ་མིག་སྤོ་བའི་ཚབ་དངོས་པོ་འདྲ་བཤུས་ལུ་འདྲུད་པའི་སྐབས་འཆང་།				2002-02-02 02:02:02
