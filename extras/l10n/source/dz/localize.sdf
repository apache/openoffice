helpcontent2	source\text\scalc\guide\address_auto.xhp	0	help	par_id3154512				0	dz	དཔེའི་ཤོག་ཁྲམ་ནང་ ཁྱོད་ཀྱིས་ ནང་ཐིག་ཁྱབ་ཚད་\<item type=\"literal\"\>བི་༣\</item\> ལས་ \<item type=\"literal\"\>བི་༥\</item\>ལུ་གཞི་བསྟུན་འབད་ནིའི་དོན་ལས་ མན་ངག་ནང་ ཡིག་རྒྱུན་ \<item type=\"literal\"\>ཀེར་ཐིག་དང་པ་'\</item\>འདི་ ལག་ལེན་འཐབ་བཏུབ་ ཡང་ན་ ནང་ཐིག་ཁྱབ་ཚད་  \<item type=\"literal\"\>སི་༢\</item\> ལས་ \<item type=\"literal\"\>སི་༥\</item\> གི་དོན་ལུ་  \<item type=\"literal\"\>'ཀེར་ཐིག་གཉིས་པ་'\</item\> འདི་ ལག་ལེན་འཐབ་བཏུབ། དེ་མ་ཚད་ཁྱོད་ཀྱིས་ ནང་ཐིག་ཁྱབ་ཚད་ \<item type=\"literal\"\>བི་༣\</item\> ལས་ \<item type=\"literal\"\>ཌི་༣\</item\> གི་དོན་ལུ་  \<item type=\"literal\"\>'གྲལ་ཐིག་དང་པ་'\</item\> འདི་ལག་ལེན་འཐབ་བཏུབ་ ཡང་ན་ ནང་ཐིག་ཁྱབ་ཚད་ \<item type=\"literal\"\>བི་༤\</item\> to \<item type=\"literal\"\>ཌི་༤\</item\> གི་དོན་ལུ་  \<item type=\"literal\"\>'གྲལ་ཐིག་གཉིས་པ་'\</item\> འདི་ལག་ལེན་འཐབ་བཏུབ།  ནང་ཐིག་མིང་ལག་ལེན་འཐབ་ཨིན་པའི་མན་ངག་ཅིག་གི་གྲུབ་འབྲས་འདི་ ༦༠༠ ཨིན། དཔེར་ན་  \<item type=\"literal\"\>དངུལ་བསྡོམས་('ཀེར་ཐིག་དང་པ་')\</item\> བཟུམ།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\guide\address_auto.xhp	0	help	par_id3149210				0	dz	ཁྱོད་ལུ་མིང་ཅིག་ རང་བཞིན་གྱིས་ ཀེལཀི་གིས་ངོས་འཛིན་འབད་དེ་དགོ་པ་ཅིན་ མིང་འདི་ཡི་གུ་ལས་འགོ་བཙུགས་དགོཔ་དང་ ཀ་ཁའི་ཨང་ཡིག་ཡིག་འབྲུ་གིས་ སྣ་སྡུད་འབད་དགོཔ་ཨིན། མན་ངག་ནང་ཁྱོད་རང་གིས་ མིང་དོ་བཀོད་འབད་བ་ཅིན་ མིང་ལུ་ འདྲེན་ཚིག་རྟགས་རྐྱང་པ་(')ཅིག་ མཉམ་སྦྲགས་འབད། འདྲེན་ཚིག་རྟགས་རྐྱང་པ་ཅིག་ མིང་ཅིག་ནང་འབྱུན་པ་ཅིན་ འདྲེན་ཚིག་རྟགས་ཀྱི་གདོང་ཁར་ རྒྱབ་ལོག་གཡོ་ཤད་ཅིག་ ཐོ་བཀོད་འབད་དགོ་ དཔེར་ན་ \<item type=\"literal\"\>'Harry\\'s Bar'.\</item\> བཟུམ།				2002-02-02 02:02:02
