helpcontent2	source\text\swriter\01\04040000.xhp	0	help	par_id3149806	2			0	dz	\<variable id=\"textmarkeein\"\>\<ahelp hid=\".uno:InsertBookmark\"\>འོད་རྟགས་ཀྱི་གནས་ས་དེ་ལུ་དེབ་རྟགས་བཙུགསཔ་ཨིན། དེ་ལས་ཁྱོད་ཀྱིས་ ཤུལ་ལས་རྟགས་བཀལ་ཏེ་ཡོད་མི་གནས་ཁོངས་དེ་ནང་ལུ་གང་མགྱོགས་མཆོངས་ནིའི་དོན་ལུ་ འགྲུལ་བསྐྱོདཔ་དེ་ལག་ལེན་འཐབ།\</ahelp\> ཨེཆ་ཊི་ཨེམ་ཨེལ་ ཡིག་ཆ་ཅིག་ནང་ལུ་ ཁྱོད་ཀྱིས་ཧའི་པར་ལིངཀི་ནང་ལས་མཆོངས་ཚུགས་པའི་ དེབ་རྟགས་ཚུ་ཨེན་ཀོར་ཚུ་ལུགཞི་བསྒྱུར་འབད་འབདཝ་ཨིན།\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04040000.xhp	0	help	par_id3153677	3			0	dz	དམིགས་བསལ་གྱི་དེབ་རྟགས་ཅིག་ལུ་མཆོངས་ནིའི་དོན་ལུ་ \<link href=\"text/swriter/01/02110000.xhp\" name=\"Navigator\"\>འགྲུལ་བསྐྱོདཔ་\</link\>དེ་ཁ་ཕྱེ་ནིའི་དོན་ལུ་ F5 དེ་ཨེབ། \<emph\> དེབ་རྟགས་ཐོ་བཀོད་ཀྱི་\</emph\>ཤུལ་ལུ་ཡོད་མི་ (+) བརྡ་མཚོན་དེ་ལུ་ཨེབ་གཏང་འབད་ཞིནམ་ལས་ དེབ་རྟགས་དེ་ལུ་ཐེངས་གཉིས་ཨེབ་གཏང་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04040000.xhp	0	help	par_id3151308				0	dz	\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>\</caseinline\>\<defaultinline\>ཡིག་ཆའི་སྒོ་སྒྲིག་གི་གཤམ་ལུ་ཡོད་མི་\<emph\>གནས་ཚད་ཕྲ་རིང་\</emph\> དེ་གི་ ཤོག་ལེབ་ཨང་ཡིག་ས་སྒོ་དེ་ལུ་ \<emph\>གཡས་ཀྱི་ཨེབ་གཏང་འབད་ཞིནམ་ལས་ \</emph\>དེ་ལས་ ཁྱོད་ཀྱིས་མཆོངས་དགོ་མནོ་མི་དེབ་རྟགས་དེ་གདམ་ཁ་རྐྱབས།\</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
