helpcontent2	source\text\shared\01\01110100.xhp	0	help	par_id3149177				0	dz	\<ahelp hid=\"HID_CTL_ORGANIZER_RIGHT\"\>གིས་  འཐོབ་ཚུགས་པའི་ཊེམ་པེལེཏི་གི་དབྱེ་བ་  ཡང་ན་  $[officename]ཡིག་སྣོད་ཁ་ཕྱེ་དེ་ཡོད་མི་ཚུ་  བཀྲམ་སྟོན་འབདཝ་ཨིན།  ཐོ་ཡིག་གི་ནང་དོན་འདི་བསྒྱུར་བཅོས་འབད་ནི་དོན་ལུ་  འོག་ལུ་ཡོད་པའི་སྒྲོམ་ནང་གི་  \<emph\>ཊེམ་པེལེཊིསི་\</emph\> ཡང་ན་ \<emph\>ཡིག་ཆ་ཚུ་\</emph\>སེལ་འཐུ་འབད།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01110100.xhp	0	help	par_id3154810				0	dz	\<ahelp hid=\"SFX2:LISTBOX:DLG_ORGANIZE:LB_RIGHT_TYP\"\>ལྟག་གི་ཐོ་ཡིག་ནང་ལུ་བཀྲམ་སྟོན་འབད་ཡོད་པའི་   ནང་དོན་འདི་བསྒྱུར་བཅོས་འབད་ནི་དོན་ལུ་   \<emph\>ཊེམ་པེལེཊིསི་\</emph\> ཡང་ན་ \<emph\>ཡིག་ཆ་ཚུ་\</emph\> སེལ་འཐུ་འབད།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01110100.xhp	0	help	par_id3149191				0	dz	ཊེམ་པེལེཏི་དབྱེ་རིམ་ཚུ་སྣོད་འཛིན་གོས་དཔར་ཚུ་གྱིས་ཚབ་བཙུགས་འབད་དེ་ཡོདཔ་ཨིན། དབྱེ་རིམ་དོན་ལུ་  ཊེམཔེལེཊི་ཡིག་སྣོད་ཚུ་སྟོན་ནི་དོན་ལུ་  སྣོད་འཛིན་འདི་གུ་ཨེབ་གཏང་ཐེང་གཉིས་ཨེབ་ད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01110100.xhp	0	help	par_id3159166				0	dz	ཡིག་སྣོད་ནང་ལུ་ལག་ལེན་འཐབ་ཡོད་པའི་  བཟོ་རྣམ་ཚུ་སྟོན་ནི་དོན་ལུ་  ཡིག་སྣོད་ཀྱི་མིང་ལུ་ཨེབ་གཏང་ཐེང་གཉིས་ཨེབ་གཏང་ནི་དང་  དེ་ལས་  \<emph\>བཟོ་རྣམ་\</emph\>ངོས་དཔར་གུ་ཨེབ་གཏང་ཐེང་གཉིས་ཨེབ་ད།				2002-02-02 02:02:02
