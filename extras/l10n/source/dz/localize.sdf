helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3153623				0	dz	ལྟག་ལུ་ཡོད་པའི་དཔེར་བརྗོད་ནང་(ཡར་བཤུད་སྒྲིལ་འབད་གནང་) ང་བཅས་ཀྱིས་ ཆ་ལག་ཚུ་ག་དེམ་ཅིག་གིས་ སློབ་གྲྭ་ནང་ལུ་མི་ཊར་ ༦༠༠ ལས་ལྷག་སྟེ་ལས་འགྲུལ་འབད་དགོསཔ་འདུག་ག་ཤེས་དགོ་མནོ་ཡི། གྲུབ་འབྲས་འདི་ ནང་ཐིག་ བི་ ༡༦ ནང་ལུ་ གསོག་འཇོག་འབད་ནི་ཨིན། བི་ ༡༦ ནང་ལུ་ མན་ངག་ =DCOUNT(ཨེ་ ༡ : ཨི་ ༡༠ ; ༠ ; ཨེ་ ༡༣ : ཨི་ ༡༤) བཙུགས།  \<emph\> ལས་འགན་ཝི་ཛརཌི་གིས་ \</emph\> ཁྱོད་ལུ་ཨིན་པུཊི་ཁྱབ་ཚད་ཚུ་ནང་གྲོགས་རམ་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3149142				0	dz	\<emph\> གནད་སྡུད་གཞི་རྟེན་ \</emph\> འ་ནི་གནད་དོན་ ཨེ་༡: ཨི་ ༡༠ ནང་ལུ་ འདི་བརྟག་ཞིབ་འབད་ནི་ཨིན་པའི་ མགོ་ཡིག་ཚུ་གྲངས་སུ་བཙུགས་ཏེ་གནད་སྡུད་ཀྱི་ཁྱབ་ཚད་ཨིན། འ་ནི་གནད་དོན་ནང་ལུ་: གནད་སྡུད་གཞི་རྟེན་ཧྲིལ་བུའི་ \<emph\> གནད་སྡུད་གཞི་རྟེན་ས་སྒོ་ \</emph\> གིས་འཚོལ་ཞིབ་ཁྱད་ཚད་དོན་ལུ་ཀེར་ཐིག་གསལ་བཀོད་འབདཝ་ཨིན། \<emph\> འཚོལ་ཞིབ་ཁྱད་ཚད་ \</emph\> འདི་ གནད་དོན་ ཨེ་༡༣ :ཨི་༡༤ ནང་ལུ་ ཁྱོད་ཀྱིས་འཚོལ་ཞིབ་ཚད་བཟུང་:བཙུགས་ཚུགསཔ་སའི་ཁྱབ་ཚད་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3145652				0	dz	རིམ་པ་གཉིས་པ་ནང་ཡོད་པའི་ཆ་ལག་ཚུ་སྐྱེ་ལོ་ ༧ ལས་ཡར་འབད་མི་ག་དེམ་ཅིག་འདུག་ག་ཤེས་ནིའི་དོན་ལུ་ ནང་ཐིག་ ཌི་ ༡༤ གི་ཐོ་བཀོད་ >༦༠༠ འདི་བཏོན་གཏང་སྟེ་ ནང་ཐིག་བི་ ༡༤ རིམ་པའི་འོག་ལུ་ "2" བཙུགས་ཏེ་ ནང་ཐིག་ སི་ ༡༤ ནང་ལུ་ > ༧ གཡས་ཁ་ཐུག་བཙུགས། གྲུབ་འབྲས་འདི་ ༢ ཨིན། རིམ་པ་གཉིས་པ་ནང་སྐྱེ་ལོ་ ༧ ལས་ཡར་བལྟ་འབད་མི་ཆ་ལག་གཉིས་འདུག ཁྱད་ཚད་གཉིས་ཆ་རང་གྲལ་ཐིག་གཅིག་ནང་འབད་ནི་དེ་གིས་ AND གིས་མཐུད་དེ་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060101.xhp	0	help	bm_id3156123				0	dz	\<bookmark_value\>ཌི་གྱངས་ཁ་རྐྱབས་ནི་ལས་འགན་\</bookmark_value\>\<bookmark_value\>དྲན་ཐོ་ཚུ་ ཀེལཀི་གནད་སྡུད་གཞི་རྟེན་ནང་གྱངས་ཁ་རྐྱབས་དོ་\</bookmark_value\>\<bookmark_value\>གྲལ་ཐིག་གྱངས་ཁ་རྐྱབས་དོ་ ཨང་གྲངས་ཡང་ན་ཀ་ཁ་ཨང་ཡིག་དང་གཅིག་ཁར་\</bookmark_value\>				2002-02-02 02:02:02
