helpcontent2	source\text\shared\02\19090000.xhp	0	help	par_id3156183				0	dz	\<ahelp hid=\".uno:SourceView\"\>ད་ལྟོའི་ཨེཅ་ཊི་ཨེམ་ཨེལ་ ཡིག་ཆའི་འབྱུང་ཁུངས་ཚིག་ཡིག་ བཀྲམ་སྟོན་འབད། ཡིག་ཆ་གསརཔ་གི་ཨེཆ་ཊི་ཨེམ་ཨེལ་ འབྱུང་ཁུངས་ སྟོན་ནི་ལུ་ དང་པ་ར་ ཡིག་ཆ་གསརཔ་འདི་ ཨེཆ་ཊི་ཨེམ་ཨེལ་ཡིག་ཆ་སྦེ་སྲུང་དགོཔ་ཨིན། \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\19090000.xhp	0	help	par_id3149760				0	dz	ཨེཆ་ཊི་ཨེམ་ཨེལ་ འབྱུང་ཁུངས་ཐབས་ལམ་ནང་ལུ་ ཁྱོད་ཀྱིས་ \<link href=\"text/shared/00/00000002.xhp#tags\" name=\"tags\"\>ཨེཆ་ཊི་ཨེམ་ཨེལ་གྱི་\</link\> ངོ་རྟགས་  \<link href=\"text/shared/00/00000002.xhp#html\" name=\"HTML\"\>HTML\</link\>དེ་སྟོན་ཞིམ་ལས་ཞུན་དག་འབད་ཚུགས། ཡིག་ཆ་དེ་ཚིག་ཡིག་གི་ཡིག་ཆ་སྟོངམ་ཅིག་སྦེ་སྲུང་བཞག་འབད། ཡིག་ཆ་དེ་ ཨེཆ་ཊི་ཨེམ་ཨེལ་སྦེ་མིང་བཏགས་ནིའི་དོན་ལུ་ ཨེཆ་ཊི་ཨེམ་ཨེལ་ ཡང་ན་ ཨེཆ་ཨཨཊི་ཨེམ་རྒྱ་བསྐྱེད་ཅིག་འགན་སྤྲོད་འབད།				2002-02-02 02:02:02
