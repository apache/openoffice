helpcontent2	source\text\swriter\01\04090001.xhp	0	help	par_id3156123				0	dz	ཡིག་སྣོད་ཀྱི་མིང་དང་ འགྲུལ་ལམ་ ཡང་ན་ ད་ལྟོའི་ཊེམ་པེལེཊི་དེ་གི་ཡིག་སྣོད་རྒྱ་བསྐྱེད་མེད་པའི་ཡིག་སྣོད་ཀྱི་མིང་ཚུ་བཙུགསཔ་ཨིན། ཁྱོད་ཀྱིས་ ད་ལྟོའི་ཊེམ་པེལེཊི་ནང་ལུ་ལག་ལེན་འཐབ་ཡོད་པའི་ "Category"གི་མིང་དང་"Style" རྩ་སྒྲིག་ཚུ་དང་བཙུགས་ཚུགསཔ་ཨིན། ཊེབ་པེལེཊི་ནང་ལུ་ལག་ལེན་འཐབ་ཡོད་པའི་ཊེམ་པེལེཊེ་དབྱེ་རིམ་ཚུ་དང་ བཟོ་རྣམ་ཚུ་སྟོན་ནིའི་དོན་ལུ་\<emph\>ཡིག་སྣོད-ཊེམ་པེའེཊི་དེ་གདམ་ཁ་རྐྱབས།-\</emph\>\<link href=\"text/shared/01/01110100.xhp\" name=\"Organize\"\>\<emph\>Organize\</emph\>\</link\>.				2002-02-02 02:02:02
