helpcontent2	source\text\shared\01\06050500.xhp	0	help	par_id3154758	94			0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>ད་ལྟོའི་གྲལ་ཐིག་མཐོ་ཚད་འདི་ཚུད་སྒྲིག་འབད་ནི་དོན་ལུ་  འགོ་ཚག་ཚུ་ཚད་བསྐྱར་བཟོ་འབད་ཡོད།   ཁྱོད་རང་དགོ་པ་ཅིན་  འགོ་ཚག་གི་དོན་ལུ་  ལག་ལེན་འཐབ་མི་ཡིག་གཟུགས་ཀྱི་ཚད་མ་འདྲཝ་ཅིག་ལག་ལེན་འཐབ་མི་   ཡིག་འབྲུ་བཟོ་རྣམ་ཅིག་ངེས་འཛིན་འབད་བཏུབ་ཨིན། \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
