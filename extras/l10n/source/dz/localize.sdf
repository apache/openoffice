helpcontent2	source\text\shared\01\05020400.xhp	0	help	par_id3150359				0	dz	\<ahelp hid=\"SW:LISTBOX:TP_CHAR_URL:LB_VISITED\"\>ཐོ་ཡིག་ལས་བལྟ་སྤྱོད་འབད་ཡོད་པའི་འབྲེལ་ལམ་དོན་ལུ་  རྩ་སྒྲིག་གི་བཟོ་རྣམ་ཅིག་སེལ་འཐུ་འབད།   ཐོ་ཡིག་དེ་གི་ནང་ལུ་  བཟོ་རྣམ་འདི་ལེགས་བཅོས་འབད་ནི་དང་ཁ་སྐོང་བརྐྱབ་ནི་དོན་ལུ་  ཌའི་ལོག་འདི་ཁ་བསྡམས་ནི་དང་   \<emph\>རྩ་སྒྲིག་འབད་དོ་\</emph\> ལག་ཆས་ཕྲ་རིང་གུ་ཡོད་པའི་  \<emph\>བཟོ་རྣམ་དང་རྩ་སྒྲིག་འབད་དོ་\</emph\>ངོས་དཔར་གུ་ཨེབ་གཏང་།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020400.xhp	0	help	hd_id3154365				0	dz	བལྟ་སྤྱོད་མ་འབད་བར་ཡོད་པའི་འབྲེལ་ལམ་ཚུ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020400.xhp	0	help	par_id3154216				0	dz	\<ahelp hid=\"SW:LISTBOX:TP_CHAR_URL:LB_NOT_VISITED\"\>ཐོ་ཡིག་ལས་  བལྟ་སྤྱོད་མ་འབད་བར་ཡོད་པའི་  འབྲེལ་ལམ་ཚུ་གི་དོན་ལུ་ལག་ལེན་འཐབ་ནི་ལུ་  རྩ་སྒྲིག་བཟོ་རྣམ་འདི་སེལ་འཐུ་འབད།  ཐོ་ཡིག་དེ་གི་ནང་ལུ་  བཟོ་རྣམ་འདི་ལེགས་བཅོས་འབད་ནི་ཡང་ན་  ཁ་སྐོང་བརྐྱབ་ནི་ལུ་  ཌའི་ལོག་འདི་ཁ་བསྡམས་ནི་དང་   \<emph\>རྩ་སྒྲིག་འབད་དོ་\</emph\>ལག་ཆས་ཕྲ་རིང་གུ་ཡོད་པའི་  \<emph\>བཟོ་རྣམ་དང་རྩ་སྒྲིག་འབད་དོ་\</emph\>ངོས་དཔར་འདི་ཨེབ་གཏང་།\</ahelp\>				2002-02-02 02:02:02
