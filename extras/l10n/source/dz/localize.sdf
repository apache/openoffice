helpcontent2	source\text\shared\01\06140500.xhp	0	help	par_idN1060E				0	dz	\<ahelp hid=\"705547787\"\>བྱུང་ལས་ཀྱི་སྡམ་ཐག་འདི་   ད་ལྟོ་གི་ཡིག་ཆ་ནང་ལུ་  ཡང་ན་ %PRODUCTNAME.གཉིས་ལས་  ག་སྟེ་ལུ་སྲུང་ནི་ཨིན་ན་འདི་དང་པ་སེལ་འཐུ་འབད།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06140500.xhp	0	help	par_id3153662				0	dz	ཡིག་ཆ་དང་བཅས་འབད་སྲུང་བཞག་ཡོད་པའི་མེཀ་རོ་འདི་  ཡིག་ཆ་འདི་ཁ་ཕྱེཝ་ད་རྐྱངམ་ཅིག་གཡོག་བཀོལ་བཏུབ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06140500.xhp	0	help	par_idN1061A				0	dz	\<ahelp hid=\"40000\"\>ཐོ་ཡིག་སྒྲོམ་སྦོམ་དེ་གིས་  བྱུང་ལས་ཚུ་དང་  འགན་སྤྲོད་འབད་ཡོད་པའི་མེཀ་རོསི་འདི་ཐོ་ཡིག་བརྐྱབ་ཨིན།   ཁྱོད་ཀྱིས་གནས་ཁོངས་འདི་ \<emph\>ནང་ན་སྲུང་\</emph\> ཐོ་ཡིག་སྒྲོམ་ནང་ལུ་སེལ་འཐུ་འབད་ཚར་བའི་ཤུལ་ལས་  བྱུང་ལས་འདི་  ཐོ་ཡིག་སྒྲོམ་སྦོམ་ནང་ལུ་ སེལ་འཐུ་འབད།   དེ་ལས་  \<emph\>མེཀ་རོ་འགན་སྤྲོད་འབད་\</emph\>ཨེབ་གཏང་འབད།\</ahelp\>				2002-02-02 02:02:02
