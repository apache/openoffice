helpcontent2	source\text\scalc\01\06060200.xhp	0	help	par_id3145172				0	dz	\<variable id=\"dokumenttext\"\>\<ahelp hid=\".uno:ToolProtectionDocument\"\> ཁྱོད་རའི་ཡིག་ཆའི་ཤོག་ལེབ་གཞི་བཀོད་དེ་ལེགས་བཅོས་འབད་ནི་ལས་ཉེན་སྐྱོབ་འབདཝ་ཨིན། ཤོག་ལེབ་ཚུ་བཏོན་གཏང་ བསྐྱར་མིང་བཏགས་ སྤོ་ཡང་ན་འདྲ་བཤུས་བརྐྱབ་བཙུགས་ནི་དེ་མི་སྲིད་པ་ཨིན། \</ahelp\>\</variable\> ཡིག་ཆ་ཉེན་སྐྱོབ་འབད་ཟེར་བའི་ཌའི་ལོག་དེ་ \<emph\> ལག་ཆས་ཚུ་ \</emph\> -ཡིག་ཆ་ཉེན་སྐྱོབ་འབད་- \<emph\> -ཡིག་ཆ་ཚུ་དང་གཅིག་ཁར་ - \</emph\> ཁ་ཕྱེ། གདམ་ཁ་དང་འཁྲིལ་ཏེ་ ཆོག་ཡིག་གཅིག་བཙུགས་བཞིནམ་ལས་ OK ཨེབ་གཏང་།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\06060200.xhp	0	help	par_id3153188				0	dz	ཉོན་སྐྱོབ་འབད་ཟེར་བའི་གདམ་ཁ་འདི་ལྕོགས་མིན་བཟོ་ཡོད་པ་ཅིན་  \<emph\> རྐྱངམ་ཅིག་ \</emph\> ཉེན་སྐྱོབ་འདབ་ཡོད་པའི་ཤོག་ཁྲམ་ཡིག་ཆ་ཚུའི་གཞི་བཀོད་འདི་བསྒྱུར་བཅོས་འབད་ཚུགསཔ་ཨིན། འོག་གི་ཚད་རིས་མཐའ་མཚམས་ལུ་ ཤོག་ཁྲམ་མཆོང་ལྡེ་ཚུའི་དོན་ལུ་ སྐབས་དོན་དཀར་ཆག་ཚུ་གུ་ལུ་ \<emph\> དཀར་ཆག་རྣམ་གྲངས་ \</emph\> ཤོག་ལེབ་ཚུ་ཆ་མཉམ་སེལ་འཐུ་འབད་ཟེར་མི་འདི་ ཤུགས་ལྡན་བཟོ་ཚུགསཔ་ཨིན། རྣམ་གྲངས་གཞན་མི་ཚུ་ཆ་མཉམ་རང་ ཤུགས་མེད་བཟོ་ཡོདཔ་ཨིན། ཉེན་སྐྱོབ་དེ་ རྩ་བསྐྲད་གཏང་ནིའི་དོན་ལུ་ བརྡ་བཀོད་  \<emph\> ལག་ཆས་ཚུ་ - ཡིག་ཆ་ཉེན་སྐྱོབ་འབད་ - ཡིག་ཆ་ཚུ་ \</emph\> ལོག་འབོ། ཆོག་ཡིག་ག་ཡང་ འགན་སྤྲོད་དེ་མེད་པ་ཅིན་ ཉེན་སྐྱོབ་འདི་ དེ་འཕྲལ་ལས་རང་རྩ་བསྐྲད་གཏང་ཡོདཔ་ཨིན། ཁྱོད་ལུ་ཆོག་ཡིག་གཅིག་འགན་སྤྲོད་དེ་ཡོད་པ་ཅིན་ \<emph\> ཁྱོད་ཀྱིས་ ཆོག་ཡིག་བཙུགས་དགོ་པའི་ \</emph\> ཤོག་ཁྲམ་ཉེན་སྐྱོབ་རྩ་བསྐྲད་གཏང་ཟེར་བའི་ཌའི་ལོག་ འབྱུངམ་ཨིན། དེ་ལས་རྐྱངམ་ཅིག་ ཁྱོད་ཀྱིས་ ཉེན་སྐྱོབ་དེ་ཤུགས་ཅན་ཡོདཔ་སྦེ་གསལ་བཀོད་འབད་དེ་ ཞིབ་དཔྱད་རྟགས་འདི་རྩ་བསྐྲད་གཏང་ཚུགསཔ་ཨིན། 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\06060200.xhp	0	help	par_id3145750	7			0	dz	ཉེན་སྐྱོབ་འབད་ཡོད་པའི་ཡིག་ཆ་དེ་ཚར་གཅིག་སྲུང་བཞག་བཞིནམ་ལས་ ལོག་སྟེ་རང་སྲུང་དགོ་པ་ཅིན་ \<emph\> ཡག་སྣོད་ - བཟུམ་སྦེ་སྲུང་ \</emph\> བརྡ་བཀོད་དཀར་ཆག་དང་བཅས་ཏེ་རྐྱངམ་ཅིག་སྲུང་བཏུབ་ཨིན།				2002-02-02 02:02:02
