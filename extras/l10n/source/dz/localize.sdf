helpcontent2	source\text\swriter\01\02110100.xhp	0	help	par_id3150045				0	dz	ཀེར་ཕྲང་སྦེ་ཡོད་མི་བཤུད་བསྒྲིལ་ཕྲ་རིང་ནང་ལུ་གནས་ཏེ་ཡོད་མི་ ངོས་དཔར་དེ་ལུ་ཨེབ་གཏང་འབད་བའི་ཐོག་ལས་ \<emph\>འགྲུལ་བསྐྱོདཔ་\</emph\>ལག་ཆས་ཕྲ་རིང་དེ་ཁ་ཕྱེ།				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02110100.xhp	0	help	par_id3153141				0	dz	\<ahelp hid=\"HID_NAVI_VS\"\> ཁྱོད་ཀྱིས་བརྡ་འཛོལ་འབད་ནི་གི་དངོས་པོའི་དབྱེ་བའི་དོན་ལུ་ངོས་དཔར་དེ་ཨེབ་གཏང་འབད། དེ་ལས་ "Previous Object" or "Next Object" མདའ་རྟགས་གང་རུང་ཅིག་ལུ་ཨེབ་གཏང་འབད། མདའ་རྟགས་ཀྱི་མིང་འདི་ཚུ་གིས་ ཁྱོད་ཀྱིས་སེལ་འཐུ་འབད་ཡོད་པའི་དངོས་པོའི་བརྡ་སྟོནམ་ཨིན། ཚིག་ཡིག་འོད་རྟགས་དེ་ ཁྱདོ་ཀྱིས་དངོས་པོ་ག་སེལ་འཐུ་འབད་ཡོད་མི་གུར་བཞག་སྟེ་ཡོདཔ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02110100.xhp	0	help	par_id3149968				0	dz	ཡིག་ཆ་གི་ནང་འཁོད་ འགྲུལ་བསྐྱོདཔ་འབད་ནི་ལུ་  ཁྱོད་རའི་དམིགས་བསལ་གྱི་དགའ་གདམ་དང་འཁྲིལ་ཏེ་ $[officename]འདི་རིམ་སྒྲིག་འབད་བཏུབ་ཨིན།  འ་ནཱི་འབད་ནི་ལུ\<link href=\"text/shared/01/06140000.xhp\" name=\"Tools - Configuration\"\>\<emph\>ལག་ཆས་ - རིམ་སྒྲིག་འབད་ནི་ཚུ་གདམ་ཁ་རྐྱབ་\</emph\>\</link\>   \<link href=\"text/shared/01/06140100.xhp\" name=\"menus\"\>དཀར་ཆག་གི་\</link\>, \<link href=\"text/shared/01/06140200.xhp\" name=\"keyboard input\"\>ལྡེ་སྒྲོམ་ཨིན་པའུཊི་\</link\>ཡང་ན་ ལག་ཆས་ཕྲ་རིང་ཚུ་གི་ནང་   "Navigate" མངའ་ཁོངས་ཀྱི་འོག་ལུ་ ཡིག་ཆ་གི་ནང་འཁོད་  འགྲུལ་བསྐྱོདཔ་ཀྱི་དོན་ལུ་ འདྲ་མིན་སྣ་ཚོགས་ཀྱི་ལས་འགན་ཚུ་ཡོདཔ་ཨིན།  འ་ནཱི་ལམ་བདའ་དེ་  ཁྱོད་ཀྱི་ཡིག་ཆ་ནང་ "To Next/Previous Index Tag" ལས་འགན་ཚུ་དང་གཅིག་ཁར་  ཟུར་ཐོ་ལུ་མཆོང་འགྱོ་བཏུབ་ཨིན། 				2002-02-02 02:02:02
