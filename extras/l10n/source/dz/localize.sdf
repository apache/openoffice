helpcontent2	source\text\shared\explorer\database\dabawiz02text.xhp	0	help	par_idN10553				0	dz	\<ahelp hid=\".\"\> ཚིག་ཡིག་རྩ་སྒྲིག་ནང་ གནད་སྡུད་གཞི་རྟེན་ནང་འདྲེན་དོན་ལུ་ སྒྲིག་སྟངས་འདི་གསལ་བཀོད་འབདཝ་ཨིན། \</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\dabawiz02text.xhp	0	help	par_idN10568				0	dz	ཚིག་ཡིག་རྩ་སྒྲིག་གནད་སྡུད་གཞི་རྟེན་ནང་ལུ་  ཐོ་འགོད་རེ་གིས་གྲལ་ཐིག་ཅིག་ཚང་མི་  ཨེ་ཨེསི་སི་ཨའི་ཡིག་སྣོད་རྩ་སྒྲིག་མ་འབད་མི་ནང་  གནད་སྡུད་འདི་གསོག་འཇོག་འབད་དེ་ཡོད།   གནད་སྡུད་ས་སྒོ་ཚུ་དབྱེ་བྱེད་ཀྱིས་བགོ་དེེ་ཡོདཔ་ཨིན།   གནད་སྡུད་ས་སྒོ་ནང་གི་ཚིག་ཡིག་འདི་  འདྲེན་ཚིག་རྟགས་ཀྱིས་བགོ་དེ་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\dabawiz02text.xhp	0	help	par_idN1056B				0	dz	ཚིག་ཡིག་ཡིག་སྣོད་ཚུ་ལུ་འདྲེན་ལམ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\dabawiz02text.xhp	0	help	par_idN1056F				0	dz	\<ahelp hid=\".\"\>འདྲེན་ལམ་འདི་ཚིག་ཡིག་ཡིག་སྣོད་ཡང་ན་ ཡིག་སྣོད་ཚུ་ལུ་བཙུགས།   ཁྱོད་ལུ་ ཚིག་ཡིག་ཡིག་སྣོད་  གཅིག་རྐྱངམ་ཅིག་དགོ་ནི་ཨིན་པ་ཅིན་  ཁྱོད་ཀྱིས་   ཡིག་སྣོད་མིང་གི་རྒྱ་བསྐྱེད་གང་རུང་ཅིག་ ལག་ལེན་འཐབ་བཏུབ།  ཁྱོད་ཀྱིས་ སྣོད་འཛིན་མིང་འདི་བཙུགས་པ་ཅིན་  སྣོད་འཛིན་དེའི་ནང་གི་ ཚིག་ཡིག་ཡིག་སྣོད་ཚུ་   ཚིག་ཡིག་གནད་སྡུད་གཞི་རྟེན་གྱི་  ཡིག་སྣོད་སྦེ་  ངོས་འཛིན་འབད་ནིའི་དོན་ལུ་  extension *.csvའདི་འོང་དགོ། \</ahelp\>				2002-02-02 02:02:02
