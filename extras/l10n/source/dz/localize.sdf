helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3148831	136			0	dz	\<ahelp hid=\"HID_PROP_TIMEMIN\" visibility=\"hidden\"\>གིས་  ལག་ལེན་པ་གིས་  ཐོ་བཀོད་འབད་བཏུབ་པའི་  ཆུ་ཚོད་ཉུང་མཐའ་འདི་གཏན་འབེབས་བཟོཝ་ཨིན།  \</ahelp\>གིས་  ལག་ལེན་པ་གིས་  ཐོ་བཀོད་འབད་བཏུབ་པའི་  ཆུ་ཚོད་ཉུང་མཐའ་འདི་གཏན་འབེབས་བཟོཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170101.xhp	0	help	hd_id3155746				0	dz	བཅུ་ཚག་འཁྲུལ་མེད།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3146096	138			0	dz	\<ahelp hid=\"HID_PROP_DECIMAL_ACCURACY\" visibility=\"hidden\"\>བཅུ་ཚག་ ས་ཚིགས་ཀྱི་གཡས་ཁ་ཐུག་ལུ་  བཀྲམ་སྟོན་འབད་ཡོད་པའི་ ཨང་ཡིག་ཚུ་གི་ ཨང་དེ་གཏན་འབེབས་བཟོཝ་ཨིན།\</ahelp\>ཨང་གྲངས་དང་ དངུལ་གྱི་ས་སྒོ་ཚུ་དང་གཅིག་ཁར་  ཁྱོད་ཀྱི་ བཅུ་ཚག་ ས་ཚིགས་གི་གཡས་ཁ་ཐུག་ལུ་  བཀྲམ་སྟོན་འབད་ཡོད་པའི་  ཨང་ཡིག་ཨང་དེ་  གཏན་འབེབས་བཟོ་བཏུབ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3149819	10			0	dz	\<ahelp hid=\"HID_PROP_NAME\" visibility=\"hidden\"\>On the \<emph\>རྒྱུ་དངོས་གུ་\</emph\>ཨེབ་ལྡེ་ཤོག་ལེབ་ཀྱིས་  ཚད་འཛིན་ས་སྒོ་གི་དོན་ལུ་  མིང་གསལ་བཀོད་འབདཝ་ཨིན།   \<emph\>རྣམ་པའི་རྒྱུ་དངོས་ཚུ་ \</emph\>ཨེབ་ལྡེ་ཤོག་ལེབ་གུ་  རྣམ་པའི་དོན་ལུ་མིང་འདི་གསལ་བཀོད་འབདཝ་ཨིན།  \</ahelp\>ཚད་འཛིན་ས་སྒོ་རེ་དང་རྣམ་པ་དེ་ཚུ་ལུ་  ངོས་འཛིན་འབད་བཏུབ་པའི་  \<emph\>མིང་ \</emph\> རྒྱུ་འདི་ཡོདཔ་ཨིན།  མིང་འདི་\<link href=\"text/shared/02/01170600.xhp\" name=\"Form Navigator\"\>རྣམ་པའི་འགྲུལ་བསྐྱོདཔ་\</link\> འབྱུང་ནི་དང་  མིང་འདི་ལག་ལེན་འཐབ་སྟེ་  ཚད་འཛིན་ས་སྒོ་འདི་  མེཀ་ཀོརོ་ཅིག་ལས་གཞི་བསྟུན་འབད་བཏུབ་ཨིན།  མིང་འདི་ཧེ་མ་ལས་  སྔོན་སྒྲིག་སྒྲིག་སྟངས་ཚུ་གི་ནང་ལུ་ ཐོ་བཀོད་འབད་ཡོད།  ཚད་འཛིན་ས་སྒོ་འདི་  ས་སྒོའི་ཁ་ཡིག་དང་ཨང་གྲངས་ཚུ་ལག་ལེན་འཐབ་སྟེ་བཟོ་ཡོད་པའི་མིང་ལས་ གསལ་བཀོད་འབད་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3153025				0	dz	ཁྱོད་མེཀ་ཀོརོསི་དང་ཅིག་ཁར་ལཱ་འབད་བ་ཅིན་  ཚད་འཛིན་གྱི་མིང་འདི་མཐུན་མོང་མ་ཡིན་པ་ཅིག་འོང་དགོཔ་འདི་ངེས་བདེན་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170101.xhp	0	help	bm_id3146325				0	dz	\<bookmark_value\>ཚད་འཛིན་འབདཝ་ཨིན་; སྡེ་ཚན་བཟོ་དོ་\</bookmark_value\>\<bookmark_value\>སྡེ་ཚན་བཟོ་དོ་; ཚད་འཛིན་འབད་དོ་\</bookmark_value\>\<bookmark_value\>རྣ་པ་ཚུ་;ཚད་འཛིན་ཚུ་སྡེ་ཚན་བཟོ་དོ།\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3146325				0	dz	རེ་ཌིའོ་གི་ཨེབ་རྟ་ཚུ་བཟུམ་མའི་  ལས་འགན་གྱིས་གཅིག་ཁར་ བང་མི་ ཚད་འཛིན་སོ་སོ་ཚུ་གི་ སྡེ་ཚན་བཟོ་ནི་ལུ་  མིང་དེ་ཡང་ལག་ལེན་འཐབ་སྟེ་ཡོདཔ་ཨིན། འདི་འབད་ནི་ལུ་  སྡེ་ཚན་གྱི་འཐུས་མི་ཆ་མཉམ་ལུ་  མིང་ཅོག་འཐདཔ་སྦེ་བྱིན: དབྱེར་མེད་མིང་དང་བཅས་པའི་  མིང་འདི་ཚུ་གིས་ སྡེ་ཚན་ཅིག་གཞི་སྒྲུབ་འབདཝ་ཨིན། སྡེ་ཚད་བཟོ་ཡོད་པའི་ ཚད་འཛིན་ཚུ་ སྡེ་ཚན་གྱི་སྒྲོམ་ལག་ལེན་འཐབ་ཐོག་ལས་\<link href=\"text/shared/02/01170000.xhp\" name=\"Group Box\"\>མཐོང་ཚུགསཔའི་ངོ་ཚབ་སྟོན་ཡོདཔ་ཨིན།\</link\>				2002-02-02 02:02:02
