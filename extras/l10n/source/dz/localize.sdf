helpcontent2	source\text\simpress\02\10120000.xhp	0	help	par_id3146124				0	dz	\<ahelp hid=\".uno:MeasureLine\"\>ལམ་སྟོན་པ་ཚུ་གིས་བཅད་མཚམས་བཟོ་ཡོད་པའི་རྒྱ་ཁྱོན་རིང་ཚད་བཀྲམ་སྟོན་འབད་མི་གི་གྲལ་ཐིག་འབྲིཝ་ཨིན།\</ahelp\> རྒྱ་ཁྱོན་གྲལ་ཐིག་རང་བཞིན་གྱིས་རྩིས་སྟོན་འབདཝ་ཨིནམ་དང་ཐིག་གི་རྒྱ་ཁྱོན་ཚུ་བཀྲམ་སྟོན་འབདཝ་ཨིན། རྒྱ་ཁྱོན་གྲལ་ཐིག་འབྲི་ནི་ལུ་ \<emph\>མདའ་རྟགས་ལག་ཆས་ཕྲ་རིང་ཁ་ཕྱེ་ཞིནམ་དང་\</emph\>རྒྱ་ཁྱོན་གྲལ་ཐིག་ངོས་དཔར་ཨེབ་གཏང་། \<emph\>ཁྱོད་ཀྱིས་གྲལ་ཐིག་འདི་ག་སྟེ་ལུ་འགོ་བཙུགས་ནི་ཨིན་ན་དང་Dimension Line\</emph\>རྒྱ་ཁྱོན་གྲལ་ཐིག་འབྲི་ནི་ལུ་འདྲུད་ནི་ལུ་དཔག་བྱེད་འདི་སྤོ་བཤུད་འབད། མཇུག་བསྡུཝ་ད་འཛིན་གྲོལ་འབད།				2002-02-02 02:02:02
helpcontent2	source\text\simpress\02\10120000.xhp	0	help	par_id3148407				0	dz	ཁྱོད་ལུ་རྒྱ་ཁྱོན་གྲལ་ཐིག་གི་རིང་ཚད་འདི་དངོས་པོའི་སྦོ་ལོགས་ཁ་གི་བཤུད་བཟུམ་སྦེ་གཅིག་པ་སྦེ་དགོ་ནི་ཨིན་པ་ཅིན་  \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>འདྲུདཔ་ད་ལུ་བརྡ་བཀོད་ \</caseinline\>\<defaultinline\>ཚད་འཛིན་ལྡེ་མིག་བུ་\</defaultinline\>\</switchinline\> འདི་བཀག་བཞག། རྒྱ་ཁྱོན་གྲལ་ཐིག་འདི་ཁུག་ཟུར་ ༤༥ ལུ་དམ་ནི་ལུ་ འདྲུདཔ་ད་ལུ་ སོར་ལྡེ་ལྡེ་མིག་བུ་འདི་བཀག་བཞག།				2002-02-02 02:02:02
helpcontent2	source\text\simpress\02\10120000.xhp	0	help	par_id3148986				0	dz	 %PRODUCTNAME ཌྲོ་ནང་ རྒྱ་ཁྱོན་གྲལ་ཐིག་འདི་ཨ་རྟག་རང་རྒྱ་ཁྱོན་གྲལ་ཐིག་ཟེར་མི་ \<link href=\"text/simpress/guide/layer_tipps.xhp\" name=\"layer\"\>བང་རིམ་གུ་\</link\> བཙུགསཔ་ཨིན། \<emph\>ཁྱོད་ཀྱིས་བང་རིམ་དེ་མཐོང་མ་ཚུགསཔ་ལུ་གཞི་སྒྲིག་འབད་བ་ཅིན་ \</emph\>ཁྱོད་ཀྱིས་ཁྱོད་ཀྱི་པར་རིས་ནང་རྒྱ་ཁྱོན་གྲལ་ཐིག་གང་རུང་མཐོང་མི་ཚུགས།				2002-02-02 02:02:02
