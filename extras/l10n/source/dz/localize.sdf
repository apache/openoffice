helpcontent2	source\text\shared\01\05030600.xhp	0	help	par_id3150358				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_BACKGROUND_MF_COL_TRANS\"\>༡༠༠%འདི་ མ་པ་ལས་དྭངས་གསལ་ཅན་དང་  ༠ %འདི་དྭངས་སྒྲིག་ཅན་ཨིན་པའི་གཞི་ཁྲམ་གཅིག་གི་  རྒྱབ་གཞི་ཚོས་གཞི་ཡང་ན་  ཚད་རིས་དོན་ལུ་  དྭངས་གསལ་ཅན་འདི་གཞི་སྒྲིག་འབད།  ཁྱོད་ཀྱིས་  རྒྱབ་གཞི་གི་དྭངས་གསལ་ཅན་འདི་ཡར་འཕར་འབདཝ་ད་  འོག་ཐིག་བཀོད་ཡོད་པའི་ཚིག་ཡིག་ཡང་ན་  དངོས་པོ་ཚུ་ གཞི་ཁྲམ་གྱི་རྒྱབ་གཞི་ལས་ མཐོང་ཚུགསཔ་ཨིན།\</ahelp\>\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
