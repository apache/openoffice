helpcontent2	source\text\shared\01\05020400.xhp	0	help	par_id3153332				0	dz	ཁྱོད་ཀྱིས་ ཧའི་པར་ལིངཀི་འདི་ཨེབ་གཏང་པའི་བསྒང་  ཁྱོད་ཀྱིས་ཁ་ཕྱེ་དགོ་པའི་  ཡིག་སྣོད་དོན་ལུ་  \<variable id=\"texturl\"\>\<ahelp hid=\"SW:EDIT:TP_CHAR_URL:ED_URL\"\>ཐོ་བཀོད་ \<link href=\"text/shared/00/00000002.xhp#url\" name=\"URL\"\>ཡུ་ཨར་ཨེལ་\</link\>འབད།  \</ahelp\> ཁྱོད་ཀྱིས་  དམིག་གཏད་ཀྱི་གཞི་ཁྲམ་འདི་དམིགས་བསལ་བཀོད་པ་ཅིན་  ཡིག་སྣོད་འདི་  ད་ལྟོའི་ཡིག་ཆ་ནང་འབད་རུང་  ཡང་ན་ གཞི་ཁྲམ་ནང་ལུ་ཁ་ཕྱེཝ་ཨིན། \</variable\>				2002-02-02 02:02:02
