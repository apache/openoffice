uui	source\cookiedg.src	0	string	STR_COOKIES_SEND_START				295	dz	%PRODUCTNAME གིས་ཡིག་ཆའི་${PATH}ཞུ་བ་འབདཝ་ད་གཏང་ནི་དོན་ལསདུ་ སར་བ'${HOST}'ར་གྱི་དོན་ལས་ཀུ་ཀིས་སྲུང་བཞག་ཡོH}.ཀུ་ཀིས་ཚུ་ནང་ལུ་ཡུ་ཨར་ཨེལ་སྡེ་ཚན་ལ་ལི་ཅིག་དང་འབྲེལ་བའི་བརྡ་དོན་ཡོད། དེ་ཚུ་སར་བར་ལ་ལུ་ཅིག་གིས་ %PRODUCTNAME ནང་གཏང་སྟེ་ དེ་ཚུ་ཡིག་ཆ་ལ་ལུ་ཅིག་འཛུལ་སྤྱོད་འབད་བའི་སྐབས་སྲུང་བཞགཔ་ཨིན། ག་དེམ་ཅིག་འབད་ %PRODUCTNAME ཡུ་ཨར་ཨེལ་དང་འཁྲིལཝ་ད་ སྔོན་མ་ལས་འབྱོར་ཡོད་པའི་ཀུ་ཀིས་ཅིག་གི་སྡེ་ཚན་དང་མཐུན་པའི་ཡིག་ཆ་ཅིག་མངོན་གསལ་འབད་བ་ཅིན་ %PRODUCTNAME བརྡ་དོདེ་ཚུ་སར་བར་ནང་གཏང་འོང་། t:\n\n འདི་གིས་སར་བར་ལུ་WWW.ལག་ལེན་དཔེར་ན་གློག་ཐོག་ཉོ་ཚོང་འཐབ་དོ་བཟུམ་མའི་གནས་ཚད་ཀྱི་རྗེས་ལམ་བཞག་ཚུགསབཟོཝ་ཨིན།\n\n e.\nགཤམ་འཁུད་ཀབ་ཀིས་ཚུ་གཞི་སྒྲིག་འབད་དགset:\n\n				2002-02-02 02:02:02
