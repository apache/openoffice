helpcontent2	source\text\sbasic\shared\03030102.xhp	0	help	par_id3153189				0	dz	ཁྱོད་ཀྱིས་འ་ནི་ལས་འགན་དེ་ཧྲིལ་ཨང་གནས་གོང་རྐྱང་པ་ནང་ སྤྱི་ཟླ་བཅུ་གཉིས་པ་ ༡ ༡༥༨༢ དང་ སྤྱི་ཟླ་ ༣༡ ༩༩༩༩ བར་ནང་འབྱུང་མི་ཚེས་གཞི་བསྒྱུར་འབད་ནི་ལུ་ལག་ལེན་འཐབ། ཁྱོད་ཀྱིས་འ་ནི་གནས་གོང་དེ་ཚེས་གཉིས་བར་ན་སོ་སོ་ཁྱད་པར་རྩིས་སྟོན་ནི་དོན་ལུ་ལག་ལེན་འཐབ་བཏུབ། ཚེས་སྒྲུབ་རྟགས་དེ་དང་ལེན་འབད་བཏུབ་པའི་ཁྱབ་ཚད་དེ་གི་ཕྱི་ཁ་ཡོད་པ་ཅིན་ $[officename] གཞི་རིམ་གྱིས་འཕྲིན་དོན་འཛོལ་བ་འབྱུངམ་ཨིན།				2002-02-02 02:02:02
