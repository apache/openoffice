helpcontent2	source\text\shared\02\02130000.xhp	0	help	par_id3150247				0	dz	\<ahelp hid=\".uno:DecrementIndent\"\>ད་ལྟོའི་དོན་མཚམས་འདི་གི་  གཡོན་འགོ་མཚམས་འདི་  མར་ཕབ་འབད་ནི་ལུ་\<emph\> འགོ་མཚམས་མར་ཕབ་ཀྱི་ \</emph\>ངོས་དཔར་ལུ་དང་ ཡང་ན་  ནང་ཐིག་གི་ནང་དོན་ལུ་ཨེབ་གཏང་འབད་ཞིནམ་ལས་  འདི་ ཧེ་མའི་གནས་ས་ལུ་གཞི་སྒྲིག་འབད།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\02130000.xhp	0	help	par_id3154186				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>ཧེ་མ་ལས་ཁྱོད་ཀྱི་  གཅིག་རུབ་ཀྱི་ཐོག་ལས་  སེལ་འཐུ་འབད་ཡོད་པའི་  དོན་མཚམས་  ལེ་ཤཱ་གཅིག་གི་དོན་ལུ་ འགོ་མཚམས་བཀལ་ནི་དེ་  ཡར་འཕར་འབད་ཡོད་པ་ཅིན་  འ་ནི་བརྡ་བཀོད་དེ་གིས་  སེལ་འཐུ་གྲུབ་ཡོད་པའི་  དོན་མཚམས་ཚུ་ཆ་མཉམ་་གྱི་དོན་ལུ་  འགོ་མཚམས་བཀལ་ནི་འདི་   མར་བབ་འབད་བཏུབ།  \</caseinline\>\<caseinline select=\"CALC\"\>ནང་ཐིག་གི་ ནང་དོན་འདི་ \<link href=\"text/shared/01/05340300.xhp\" name=\"Format - Cell - Alignment\"\>\<emph\>རྩ་སྒྲིག་-ནང་ཐིག་- ཕྲང་སྒྲིག་གི་འོག་ལུ་ཡོད་པའི་  ད་ལྟོའི་གནས་གོང་དང་གཅིག་ཁར་  ཁྱད་པར་ཞུགསཔ་ཨིན།\</emph\>\</link\>.\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
