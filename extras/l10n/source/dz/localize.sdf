helpcontent2	source\text\shared\01\06200000.xhp	0	help	par_id3153338				0	dz	\<ahelp hid=\"HID_HANGULDLG_BUTTON_CHANGEALL\"\>རྩ་སྒྲིག་གི་གདམ་ཁ་ཚུ་དང་འཁྲིལ་ཏེ་  བསམ་ཡོད་པའི་ཡིག་འབརུ་ཡང་ན་  མིང་ཚིག་འདི་དང་བཅས་  སེལ་འཐུ་འདི་ཚབ་བཙུགས་འབདཝ་ཨིན།  ཨ་རྟག་རང་སེལ་འཐུ་འདི་སྐྱོན་འཛིན་འབྱུང་ཡོདཔ་ད་  དེ་རང་བཞིན་གྱིས་ཚབ་མ་འབདཝ་ཨིན། \</ahelp\> ཤུལ་མའི་མིང་ཚིག་ཡང་ན་ཡིག་འབྲུ་འདི་གཞི་བསྒྱུར་གྱི་དོན་ལུ་  སེལ་འཐུ་འབད་དེ་ཡོད། ཚབ་མའི་ཚིག་ཡིག་གི་ཐོ་ཡིག་འདི་   ད་ལྟོའི་ $[officename] ལཱ་ཡུན་གྱི་དོན་ལུ་  ནུས་ཅན་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
