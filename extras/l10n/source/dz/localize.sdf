helpcontent2	source\text\swriter\01\04120222.xhp	0	help	par_id3149109				0	dz	\<ahelp hid=\"SW:LISTBOX:TP_TOX_ENTRY:LB_MAIN_ENTRY_STYLE\" visibility=\"visible\"\>རྩ་སྒྲིག་འབད་ནིའི་བཟོ་རྣམ་དེ་ ཐོ་འགོད་ངོ་མ་གི་དོན་ལུ་ ཀ་ཁའི་གོ་རིམ་དང་བསྟུན་ཏེ་ཡོད་པའི་ཟུར་ཐོའི་ནང་ལུ་གསལ་བཀོད་འབད། ཟུར་ཐོའི་ཐོ་འགོད་དེ་ ཐོ་འགོད་ངོ་མ་གི་ནང་ལུ་གཞི་བསྒྱུར་འབད་ནིའི་དོན་ལུ་ ཡིག་ཆའི་ནང་ལུ་ ཟུར་ཐོའི་ས་སྒོ་དེ་གི་གདོང་ཁ་ལུ་ཨེབ་གཏང་འབད་ཞིནམ་ལས་ དེ་ལས་ \<emph\>ཞུན་དག་\</emph\>\<emph/\>\<link href=\"text/swriter/01/04120100.xhp\" name=\"Index Entry\"\>\<emph\>ཟུར་ཐོའི་ཐོ་འགོད་དེ་སེལ་འཐུ་འབད།\</emph\>\</link\>.\</ahelp\> 				2002-02-02 02:02:02
