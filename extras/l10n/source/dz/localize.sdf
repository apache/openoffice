helpcontent2	source\text\shared\02\01170000.xhp	0	help	par_idN11B3D				0	dz	\<ahelp hid=\"SID_FM_NAVIGATIONBAR\"\>འགྲུལ་བསྐྱོད་ཕྲ་རིང་ཅིག་གསར་བསྐྲུན་འབདཝ་ཨིན།\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170000.xhp	0	help	par_idN11DB1				0	dz	འགྲུལ་བསྐྱོད་ཕྲ་རིང་འདི་གིས་ ཁྱོད་ལུ་ གནད་སྡུད་གཞི་རྟེན་ཅིག་གི་ དྲན་ཐོ་བརྒྱུད་དེ་དང་ ཡང་ན་གནད་སྡུད་གཞི་རྟེན་གྱི་འབྲི་ཤོག་ནང་ལུ་ སྤོ་བཤུད་འབད་བཅུགཔ་ཨིན། འ་ནི་འགྲུལ་བསྐྱོད་ཕྲ་རིང་གུར་གི་ཚད་འཛིན་\<link href=\"text/shared/main0213.xhp\"\>འདི་གིས་  $[officename]ནང་གི་སྔོན་སྒྲིག་འགྲུལ་བསྐྱོད་ཕྲ་རིང་གུར་ཡོད་པའི་ཚད་འཛིན་འདི་གིས་འབད་དོ་བཟུམ་སྦེ་རང་ \</link\>  ལཱ་འབདཝ་ཨིན།				2002-02-02 02:02:02
