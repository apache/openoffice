helpcontent2	source\text\swriter\guide\hyperlinks.xhp	0	help	par_id3155858				0	dz	ཁྱོད་ཀྱིས་འགྲུལ་བསྐྱོད་པ་ལག་ལེན་འཐབ་ཐོག་ ཁྱོད་རའི་ཡིག་ཆ་ནང་ལུ་ ཕན་ཚུན་གཞི་བསྟུན་ཅིག་ ཚད་བརྒལ་འབྲེལ་རྟགས་སྦེ་བཙུགས་བཏུབ། ཁྱོད་ཀྱིས་རྣམ་གྲངས་ཚུ་  གཞན་མི་\<item type=\"productname\"\>%PRODUCTNAME\</item\>ལས་ཡང་ཕན་ཚུན་གཞི་བསྟུན་འབད་བཏུབ། ཡིག་ཆ་འདི་  \<item type=\"productname\"\>%PRODUCTNAME\</item\>ནང་ཁ་ཁ་ཕྱེ་སྟེ་ཡོད་པའི་སྐབས་ ཁྱོད་ཀྱིས་ཚད་བརྒལ་འབྲེལ་རྟགས་འདི་ཨེབ་གཏང་པ་ཅིན་ ཁྱོད་ཕན་ཚུན་གཞི་བསྟུན་འབད་ཡོད་པའི་རྣམ་གྲངས་ལུ་འབགཔ་ཨིན།				2002-02-02 02:02:02
