helpcontent2	source\text\simpress\guide\rehearse_timings.xhp	0	help	par_id3150651	6			0	dz	བཤུད་མཐོང་སྣང་ཕྲ་རིང་ནང་ལུ་  \<emph\>མཐའ་སྦྱང་འབད་ནི་གི་དུས་འཛིན་\</emph\> ངོས་དཔར་ \<image id=\"img_id3156396\" src=\"res/commandimagelist/sc_rehearsetimings.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3156396\"\>ངོས་དཔར་\</alt\>\</image\>དང་བཅས་  སྟོན་ནི་འདི་འགོ་བཙུགས།  འོག་གི་སྒྱིད་ཁག་ནང་  ཁྱོད་ཀྱིས་བཤུད་དང་པ་དང་དུས་ཡུན་གཅིག་མཐོངམ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\simpress\guide\rehearse_timings.xhp	0	help	par_id3145590				0	dz	ཤུལ་མའི་བཤུད་ལུ་ཡར་བསྐྱོད་འབད་ནི་གི་དུས་ཚོད་རེནམ་ད་  དུས་འཛིན་འདི་གུ་ཨེབ་གཏང་འབད།   བཤུད་འདི་གི་དོན་ལུ་སྔོན་སྒྲིག་སྒྲིག་སྟངས་བཞག་ནི་ལུ་  བཤུད་འདི་ཨེབ་གཏང་འབད་ནི་  དེ་འབདཝ་ད་  དུས་འཛིན་འདི་མེན།  ཁྱོད་རའི་གསལ་སྟོན་ནང་བཤུད་ཆ་མཉམ་གྱི་དོན་ལུ་འཕྲོ་མཐུད་འབད།				2002-02-02 02:02:02
