helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	par_id3155390				0	dz	\<emph\>ཚིག་ཡིག་ལས་:\</emph\> ཡིག་རྒྱུན་གསལ་བརྗོད་གང་རུང་དེ་ཁྱོད་ཀྱིས་འདྲ་བཤུས་འབད་ནི་ཡིག་སྣོད་ཀྱི་མིང་དེ་གསལ་བཀོད་འབདཝ་ཨིན། གསལ་བརྗོད་དེ་ནང་ན་གདམ་ཁ་ཅན་འགྲུལ་ལམ་དང་དྲེན་འཕྲུལ་བརྡ་དོན་ཡོདཔ་ཨིན། ཁྱོད་དགོ་པ་ཅིན་ \<link href=\"text/sbasic/shared/00000002.xhp\" name=\"URL notation\"\>ཡུ་ཨར་ཨེལ་དབྱངས་རྟགས་ནང་\</link\> འགྲུལ་ལམ་ཅིག་བཙུགས་བཏུབ།				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	par_id3150669				0	dz	\<emph\>ཚིག་ཡིག་ལུ་:\</emph\> ཡིག་རྒྱུན་གསལ་བརྗོད་གང་རུང་འདི་ཁྱོད་ཀྱི་ཡིག་སྣོད་འབྱུང་ཁུངས་ག་སྟེ་འདྲ་བཤུས་འབད་ནི་ལུ་གསལ་བཀོད་འབདཝ་ཨིན། གསལ་བརྗོད་འདི་ནང་ན་འགྲོ་ཡུལ་འདྲེན་འཕྲུལ་ འགྲུལ་ལམ་ དང་ཡིག་སྣོད་མིང་་ཡང་ན་ཡུ་ཨར་ཨེལ་དབྱངས་རྟགས་ནང་འགྲུལ་ལམ་འདི་ཡོདཔ་ཨིན།				2002-02-02 02:02:02
