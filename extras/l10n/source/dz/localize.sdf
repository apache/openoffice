helpcontent2	source\text\simpress\guide\select_object.xhp	0	help	par_id3159238				0	dz	གཞན་མི་དངོས་པོ་ཚུ་གིས་ཁེབས་ཡོད་མི་དངོས་པོ་སེལ་འཐུ་འབད་ནི་ལུ་ \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>གདམ་ཁ་ \</caseinline\>\<defaultinline\>མཆོང་ལྡེ་\</defaultinline\>\</switchinline\> བཀག་བཞག་ཞིནམ་དང་ཁྱོད་ཀྱིས་འོག་ཐིག་འབད་ནིའི་དངོས་པོ་ལུ་མ་ལྷོད་ཚུན་ཚོད་དངོས་པོ་ཚུ་བརྒྱུད་དེ་ཨེབ་གཏང་། རིམ་ལོག་གོ་རིམ་ནང་དངོས་པོ་ཚུ་བརྒྱུད་དེ་བསྐྱར་འཁོར་འབད་ནི་ལུ་  \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>ཁྱོད་ཀྱིས་ཨེབ་གཏངམ་ད་གདམ་ཁ་ \</caseinline\>\<defaultinline\>མཆོང་ལྡེ་\</defaultinline\>\</switchinline\>+སོར་ལྡེ་བཀག་བཞག།				2002-02-02 02:02:02
helpcontent2	source\text\simpress\guide\select_object.xhp	0	help	par_id3150213				0	dz	ལྡེ་སྒྲོམ་ལག་ལེན་འཐབ་འདི་གཞན་མི་དངོས་པོ་གིས་ཁེབས་ཡོད་མི་དངོས་པོ་སེལ་འཐུ་འབད་ནི་ལུ་ བཤུད་གུའི་དངོས་པོ་ཚུ་བརྒྱུད་དེ་བསྐྱར་འཁོར་འབད་ནི་ལུ་མཆོང་ལྡེ་ཨེབ། རིམ་ལོག་གོ་རིམ་ནང་དངོས་པོ་ཚུ་ལས་བསྐྱར་འཁོར་འབད་ནི་ལུ་ སོར་ལྡེ་+མཆོང་ལྡེ་ཨེབ།				2002-02-02 02:02:02
