helpcontent2	source\text\shared\02\02140000.xhp	0	help	par_id3149798				0	dz	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>དོན་མཚམས་ལེ་ཤ་ཅིག་  སེལ་འཐུ་འབད་ཡོད་པ་ཅིན་  སེལ་འཐུ་འབད་ཡོད་པའི་  དོན་མཚམས་འདི་ཚུ་གི་འགོ་མཚམས་འདི་ཚུ་  ཡར་འཕར་འབད་ཡོདཔ་ཨིན།\</caseinline\>\<caseinline select=\"CALC\"\>ནང་ཐིག་གི་ནང་དོན་འདི་\<link href=\"text/shared/01/05340300.xhp\" name=\"Format - Cell - Alignment\"\>\<emph\>རྩ་སྒྲིག་-ནང་ཐིག་ཕྲང་སྒྲིག་གི་\</emph\>\</link\>འོག་ལུ་  ད་ལྟོའི་གནས་གོང་ལུ་  སོ་སོ་འགྱུརཝ་ཨིན།\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
