helpcontent2	source\text\shared\optionen\01010300.xhp	0	help	par_id3150439				0	dz	འོག་གི་འགྲུལ་ལམ་ཚུ་གི་ཐོ་ཡིག་ནང་  %PRODUCTNAME གཞི་བཙུག་འབད་ཡོད་པའི་སྣོད་ཐོའི་ནང་ལུ་ཡོད་མི་  རུབ་སྤྱོད་འབད་ཡོད་པའི་སྣོད་འཛིན་ཚུ་གི་དོན་ལུ་འགྲུལ་ལམ་ཚུ་མ་སྟོན་མས།  ལག་ལེན་པ་རེ་རེའི་དོན་ལུ་ལག་ལེན་གནས་སྡུད་འདི་  {user} སྣོད་ཐོའི་ནང་གསོག་འཇོག་འབད་དེ་ཡོད་   དེ་ཡང་   ལག་ལེན་པའི་\<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>ཁྱིམ་ \</caseinline\>\<defaultinline\>ཡིག་ཆ་ཚུ་དང་སྒྲིག་སྟངས་ཚུ་\</defaultinline\>\</switchinline\>སྣོད་ཐོ་ནང་གནས་ཏེ་ཡོད།				2002-02-02 02:02:02
