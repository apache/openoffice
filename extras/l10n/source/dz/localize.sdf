helpcontent2	source\text\shared\02\01170101.xhp	0	help	par_id3154360	88			0	dz	\<ahelp hid=\"HID_PROP_SPIN\" visibility=\"hidden\"\>ཆ་མཉམ་པའི་མདའ་རྟགས་ཀྱི་  ཨེབ་རྟ་ཚུ་ཁ་སྐོང་རྐྱབ་ཡོད་ས་ལུ་  "ཨིན་" གདམ་ཁ་འདི་གིས་  ཚད་འཛིན་གི་ས་སྒོ་དེ་  བསྒྱིར་རྟ་ནང་ལུ་གནས་སོར་འབདཝ་ཨིན། \</ahelp\>ཨང་གྲངས་ཀྱི་ས་སྒོ་དང་ དངུལ་གྱི་ས་སྒོ་ ཚེས་གྲངས་དང་ཆུ་ཚོད་ཀྱི་ས་སྒོ་འདི་ཚུ་  བསྒྱིར་རྟ་སྦེ་འབྲི་ཤོག་ནང་ལུ་ འགོ་བཙུགས་འབད་བཏུབ་ཨིན།				2002-02-02 02:02:02
