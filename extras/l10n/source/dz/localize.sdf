helpcontent2	source\text\scalc\01\04060102.xhp	0	help	par_idN10600				0	dz	ལས་འགན་ཚུའི་མིང་ _ADD དང་གཅིག་ཁར་མཇུག་བསྡུ་མི་ གྲུབ་འབྲས་ཚུ་ མཉམ་ཐོག་མའི་ཀོརོ་སོཕཊི་ ཨེགསི་སེལ་ལས་འགན་ཚུ་བཟུམ་སླར་ལོག་འབདཝ་ཨིན། རྒྱལ་སྤྱི་ཚད་ལྡན་ཚུ་གུ་གཞི་བཞག་སྟེ་ གྲུབ་འབྲས་ལེན་ནིའི་དོན་ལུ་ ལས་འགན་ཚུ་ _ADD toc མེདཔ་སྦེ་ལག་ལེན་འཐབ། དཔེ་འབད་བ་ཅིན་ WEEKNUM ལས་འགན་གྱིས་ རྒྱལ་སྤྱི་ཚད་ལྡན་ ཨའི་ཨེསི་ཨོ་ ༦༨༠༡ གུ་གཞི་བཞག་སྟེ་ གྲ་སྒྲིག་འབད་ཡོད་པའི་ཚེས་གྲངས་ཀྱི་ བདུན་ཕྲག་གི་གྱངས་ཁ་རྩིས་སྟོན་འབདཝ་ཨིནམ་དང་ WEEKNUM_ADD གིས་བདུན་ཕྲག་གྱངས་ཁ་གཅིག་པ་འདི་ མའི་ཀོརོ་སོཔཊི་ཨེགསི་སེལ་སྦེ་སླར་ལོག་འབདཝ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060102.xhp	0	help	par_id3150437				0	dz	$[officename] གིས་ནང་འཁོད་སྦེ་ ཚེས་གྲངས་/དུས་ཚོད་ ཨང་གྲངས་ཀྱི་གནས་གོང་སྦེ་ལེགས་སྐྱོང་འཐབ་ཨིན། ཁྱོད་ཀྱིས་ ཨང་བཏགས་ནི་རྩ་སྒྲིག་ "Number" འདི་ཚེས་གྲངས་ ཡང་ན་ དུས་ཚོད་གནས་གོང་ལུ་ལས་འགན་སྤྲོད་པ་ཅིན་ འདི་ཨང་ལུ་གཞི་བསྒྱུར་འབད་ཡོདཔ་ཨིན། དཔེ་འབད་བ་ཅིན་ ༠༡/༠༡/༢༠༠༠ ༡༢:༠༠ པི་ཨེམ་ འདི་ ༣༦༥༢༦་༥ ལུ་གཞི་བསྒྱུར་འབདཝ་ཨིན། བཅུ་ཚག་ས་ཚིགས་ལས་ཧག་མི་གནས་གོང་འདི་ཚེས་གྲངས་ལུ་མཉམ་ཐོག་འབད་ནི་དང་ བཅུ་ཚག་ས་ཚིགས་རྗེས་སུ་འཇུག་མི་གནས་གོང་འདི་ དུས་ཚོད་ལུ་མཉམ་ཐོག་འབདཝ་ཨིན། ཁྱོད་ཀྱིས་ འ་ནི་དབྱེ་བ་བཟུམ་མའི་ ཨང་གྲངས་ཀྱི་ཚེས་གྲངས་ ཡང་ན་ དུས་ཚོད་ཁྱད་ཚབ་བལྟ་དགོསཔ་མ་མནོ་བ་ཅིན་ ཨང་གྲངས་རྩ་སྒྲིག་(ཚེས་གྲངས་ ཡང་ན་ དུས་ཚོད་) རིམ་པ་དང་འཁྲུལ་ཏེ་བསྒྱུར་བཅོས་འབད། འ་ནི་འབད་ནི་དོན་ལུ་ ཚེས་གྲངས་ཡང་ན་དུས་ཚོད་གནས་གོང་ནང་ན་ཤོམ་ཏེ་ཡོད་པའི་ནང་ཐིག་གཅིག་སེལ་འཐུ་འབད་ཞིནམ་ དེའི་སྐབས་དོན་དཀར་ཆག་བོད་ དེ་ལས་  \<emph\> རྩ་སྒྲིག་ནང་ཐིག་ཚུ་ \</emph\> སེལ་འཐུ་འབད།  \<emph\> ཨང་གྲངས་ཚུ་ \</emph\> མཆོང་ལྡེ་ཤོག་ལེབ་ནང་ན་ ཨང་གྲངས་རྩ་སྒྲིག་ངེས་འཛིན་ནིའི་དོན་ལུ་ ལས་འགན་ཚུ་ཤོམ་ཏེ་ཡོད།				2002-02-02 02:02:02
