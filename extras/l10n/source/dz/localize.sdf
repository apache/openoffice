helpcontent2	source\text\shared\explorer\database\dabawiz01.xhp	0	help	par_idN10589				0	dz	\<ahelp hid=\".\"\>  གནད་སྡུད་གཞི་རྟེན་གསརཔ་ཅིག་གསར་བསྐྲུན་འབད་འབད་ནི་ལུ་སེལ་འཐུ་འབད། \</ahelp\> གདམ་ཁ་དེ་གིས་ སྔོན་སྒྲིག་སྒྲིག་སྟངས་ཚུ་དང་བཅས་  ཨེཆ་ཨེསི་ཀིའུ་ཨེལ་ གནད་སྡུད་གཞི་རྟེན་མ་འཕྲུལ་འདི་  ལག་ལེན་འཐབ་ཨིན།   ཝི་ཛརཌི་གི་  ཤོག་ལེབ་མཐའ་མཇུག་དེ་གིས་ ཤུལ་མམ་འབྱུངམ་ཨིན།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\dabawiz01.xhp	0	help	par_idN105F9				0	dz	གནས་དེ་ཡོད་པའི་ གནད་སྡུད་གཞི་རྟེན་གྱི་ཡིག་སྣོད་འདི་ཁ་ཕྱེ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\dabawiz01.xhp	0	help	par_idN105FD				0	dz	\<ahelp hid=\".\"\>འཕྲེལ་གྱི་ལག་ལེན་འཐབ་ཡོད་པའི་ཡིག་སྣོད་ཡང་ན་  ཡིག་སྣོད་སེལ་འཐུ་འབད་སའི་ཌའི་ལོག་གི་ ཐོ་ཡིག་ལས་  གནད་སྡུད་གཞི་རྟེན་ཡིག་སྣོད་ཅིག་སེལ་འཐུ་འབད་ནི་ལུ་ སེལ་འཐུ་འབད། \</ahelp\>				2002-02-02 02:02:02
