helpcontent2	source\text\shared\02\01140000.xhp	0	help	par_id3156383				0	dz	\<ahelp hid=\".uno:Pie\"\> ད་ལྟོའི་ཡིག་ཆ་ནང་གི་  མཐའ་འཁོར་གཉིས་ལྡན་གྲལ་ཐིག་ཚུ་དང་  སྒོང་དབྱིབས་ཀྱི་གཞུ་དབྱིབས་གིས་ངོས་འཛིན་འབད་ཡོད་པའི་  ལྟེམས་ལྟེམས་གང་ཡོད་པའི་དབྱིབས་ཅིག་འབྲིཝ་ཨིན།  སྒོང་་དབྱིབས་པ་ཡི་འབྲི་ནིའི་དོན་ལུ་  ཁྱོད་རང་དགོ་པའི་ཚད་ཚུན་ཚོད་ལུ་  སྒོང་དབྱིབས་འདི་འདྲུད་ནི་དང་  དེ་ལས་  མགོའི་མཐའ་འཁོར་གྲལ་ཐིག་འདི་  ངོས་འཛིན་འབད་ནི་དོན་ལུ་  ཨེབ་གཏང་ད།  མཐའ་འཁོར་གྲལ་ཐིག་གཉིས་པ་འདི་  ཁྱོད་རང་ག་སྟེ་ལུ་དགོཔ་ཨིན་ན་  དེ་ལུ་དཔག་བྱེད་འདི་སྤོ་བཤུད་འབད་དེ་ཨེབ་གཏང་།  ཁྱོད་ཀྱིས་སྒོང་དབྱིབས་ལུ་ཨེབ་མི་དགོ།  སྒོར་ཐིག་པ་ཡི་ཅིག་འབྲི་ནི་དོན་ལུ་  ཁྱོད་ཀྱིས་འདྲུདབཞག་འབདཝ་ད་  སོར་ལྡེ་འདི་བཟུང་བཞག་འབད། \</ahelp\>				2002-02-02 02:02:02
