helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3152918				0	dz	\<emph\>ཐིག་ཁྲམ་\</emph\> མངའ་ཁོངས་ནང་ གནད་སྡུད་གཞི་རྟེན་གྱི་ཐིག་ཁྲམ་སེལ་འཐུ་འབད་ནི་གི་དོན་ལུ་ ཁྱོད་ཀྱིས་ཚིག་ཡིག་ཐིག་ཁྲམ་ལུ་འཇུག་སྤྱོད་འབད་ནི་ཨིན་པའི་མདའ་རྟགས་ལྡེ་མིག་འདི་ ལག་ལེན་འཐབ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	hd_id3156042				0	dz	གནད་སྡུད་གཞི་རྟེན་གྱི་ཀེར་ཐིག་ཚུ།				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\12070100.xhp	0	help	par_id3152425	20			0	dz	\<ahelp hid=\"SW:LISTBOX:DLG_AP_INSERT_DB_SEL:LB_TBL_DB_COLUMN\"\> གནད་སྡུད་གཞི་རྟེན་གྱི་ཀེར་ཐིག་ཚུ་ ཚིག་ཡིག་ཐིག་ཁྲམ་ནང་བཙུག་ནི་ཨིན་པའི་གསལ་བཀོད་འབདཝ་ཨིན། \</ahelp\> \<emph\>ཐིག་ཁྲམ་ཀེར་ཐིག་(ཚུ་)\</emph\> ཐོ་ཡིག་སྒྲོམ་ནང་ལུ་ དང་ལེན་མ་འབད་བའི་གནད་སྡུད་གཞི་རྟེན་གྱི་ཐིག་ཁྲམ་ཀེར་ཐིག་ཚུ་ཆ་མཉམ་ར་ ནཱ་ལུ་ཐོ་ཡིག་བཀོད་དེ་ཡོད། ཐོ་བཀོད་ཚུ་ཀ་ཁའི་གོ་རིམ་བཞིན་དབྱེ་སེལ་འབད་ཡི། 				2002-02-02 02:02:02
