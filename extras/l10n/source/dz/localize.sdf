helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156361				0	dz	\<ahelp hid=\"HID_FUNC_DEZIMAL\"\> གྲ་སྒྲིག་འབད་ཡོད་པའི་གཞི་རྟེན་རཱ་ཌིགསི་ནང་ལུ་ \<link href=\"text/shared/00/00000005.xhp#zahlensystem\" name=\"number system\"\> ཨང་གྲངས་རིམ་ལུགས་ལས་ཡི་གུ་ཚུ་དང་བཅས་པའི་ \</link\>  ཚིག་ཡིག་དེ་ ཧྲིལ་ཨང་ཡོད་ཆ་ལུ་གཞི་བསྒྱུར་འབདཝ་ཨིན། \</ahelp\> རཱ་ཌིགསི་དེ་ ཁྱབ་ཚད་ ༢ ལས་༣༦ ནང་འཁོད་འོང་དགོཔ་ཨིན། བར་སྟོང་ཚུ་དང་ མཆོང་ལྡེ་ཚུ་ སྣང་མེད་སྦེ་བཞག་ཡོདཔ་ཨིན། \<emph\> ཚིག་ཡིག་ས་སྒོ་དེ་ \</emph\> གནས་སྟངས་དེ་ཞིབ་རྟོགས་ཅན་མེན།(-c)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3157994				0	dz	རཱ་ཌིགསི་དེ་ ༡༦ ཨིན་པ་ཅིན་ སྔོན་བསྐྱོད་ x ཡང་ན་ 0x ཡང་ན་ 0X དང་ མཇུག་བསྣོན་འབད་བའི་ h ཡང་ན་ H དེ་ བརྩི་མེདཔ་ཨིན། རཱ་ཌིགསི་ དེ་ ༢ ཨིན་པ་ཅིན་ མཇུག་བསྣོན་འབད་ཡོད་པའི་ b ཡང་ན་ B བརྩི་མེདཔ་ཨིན། ཡིག་འབྲུ་གཞན་མི་ཚུ་ འཛོལ་བ་བཟོ་བཏོན་འབད་བའི་ཨང་གྲངས་རིམ་ལུགས་ཁོངས་སུ་མི་བསྡུ་ནི་ཨིན། 				2002-02-02 02:02:02
