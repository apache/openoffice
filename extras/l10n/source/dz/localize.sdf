helpcontent2	source\text\shared\01\02240000.xhp	0	help	par_id3150838				0	dz	\<variable id=\"dokver\"\>\<ahelp hid=\".uno:CompareDocuments\"\>ད་ལྟོའི་ཡིག་ཆ་འདི་  ཁྱོད་ཀྱིས་སེལ་འཐུ་འབད་ཡོད་པའི་ཡིག་ཆ་དང་བཅས་ ག་བསྡུར་བརྐྱབ་ཨིན།  \</ahelp\>\</variable\>ཁ་ཕྱི་མི་ཌའི་ལོག་ནང་ལུ་  སེལ་འཐུ་འབད་ཡོད་པའི་ཡིག་ཆ་གི་ནང་དོན་འདི་ བཏོན་གཏང་ནི་སྦེ་རྟགས་བཀོད་ཡོདཔ་ཨིན།  ཁྱོད་རང་དགོ་པ་ཅིན་  སེལ་འཐུ་འབད་ཡོད་པའི་ཡིག་སྣོད་ཀྱི་ནང་དོན་ཚུ་  ད་ལྟོའི་ཡིག་ཆ་ནང་ལུ་  འབྲེལ་བ་ཡོད་པའི་བཏོན་གཏང་འཛུལ་ཞུགས་དང་  \<emph\>དང་ལེན་སྤངས་\</emph\>ཨེབ་གཏང་སྟེ་  དེ་ལས་  \<emph\>བཙུགས་\</emph\>ཨེབ་གཏང་ཐོག་ལས་བཙུགས་བཏུབ་ཨིན།				2002-02-02 02:02:02
