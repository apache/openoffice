helpcontent2	source\text\smath\01\06010100.xhp	0	help	par_id3154513				0	dz	\<ahelp hid=\"STARMATH_MODALDIALOG_RID_SYMDEFINEDIALOG\"\>བརྡ་མཚོན་ཚུ་བརྡ་མཚོན་གྱི་ཆ་ཚན་ཅིག་ལུ་ཁ་སྐོང་རྐྱབས་ནིའི་དོན་ལས་ བརྡ་མཚོན་ཆ་ཚན་ཚུ་ཞུན་དག་འབད་ནིའི་དོན་ལས་ ཡང་ན་ བརྡ་མཚོན་གྱི་དབྱངས་རྟགས་ཚུ་ལེགས་བཅོས་འབད་ནིའི་དོན་ལས་ འ་ནི་ཌའི་ལོག་སྒྲོམ་འདི་ལག་ལེན་འཐབ། \</ahelp\> ཁྱོད་ཀྱིས་ བརྡ་མཚོན་གྱི་ཆ་ཚན་གསརཔ་ཚུ་ངེས་འཛིན་འབད་ནི་ བརྡ་མཚོན་ཚུ་ལུ་མིང་ཚུ་འགན་སྤྲོད་འབད་ནི་ ཡང་ན་ ཡོད་བཞིན་པའི་བརྡ་མཚོན་གྱི་ཆ་ཚན་ཚུ་ལེགས་བཅོས་འབད་ནི་ ཚུ་ཡང་འབད་ཚུགས།				2002-02-02 02:02:02
