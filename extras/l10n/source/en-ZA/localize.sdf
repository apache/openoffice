helpcontent2	source\text\sbasic\shared\03080401.xhp	0	help	par_id3147288				0	en-ZA	iVar = 36				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080401.xhp	0	help	par_id3159254				0	en-ZA	Msgbox Sqr(iVar)				2002-02-02 02:02:02
