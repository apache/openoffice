helpcontent2	source\text\sbasic\shared\03100500.xhp	0	help	par_id3156423				0	en-ZA	Msgbox CDbl(1234.5678)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03100500.xhp	0	help	par_id3150869				0	en-ZA	Msgbox CInt(1234.5678)				2002-02-02 02:02:02
