helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105A2				0	en-ZA	\<ahelp hid=\".\"\>Appends the alias to the table name in SELECT statements.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105A5				0	en-ZA	Use Outer Join syntax '{OJ }'				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105A9				0	en-ZA	\<ahelp hid=\".\"\>Use escape sequences for outer joins. The syntax for this escape sequence is {oj outer-join}\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105BE				0	en-ZA	Example:				2002-02-02 02:02:02
helpcontent2	source\text\shared\explorer\database\dabaadvpropdat.xhp	0	help	par_idN105C1				0	en-ZA	select Article.* from {oj item LEFT OUTER JOIN orders ON item.no=orders.ANR}				2002-02-02 02:02:02
