helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	bm_id3150616				0	en-ZA	\<bookmark_value\>Exp function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	hd_id3150616				0	en-ZA	\<link href=\"text/sbasic/shared/03080201.xhp\" name=\"Exp Function [Runtime]\"\>Exp Function [Runtime]\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3155555				0	en-ZA	Returns the base of the natural logarithm (e = 2.718282) raised to a power.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	hd_id3150984				0	en-ZA	Syntax:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3145315				0	en-ZA	Exp (Number)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	hd_id3154347				0	en-ZA	Return value:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3149670				0	en-ZA	Double				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	hd_id3154760				0	en-ZA	Parameters:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3150793				0	en-ZA	\<emph\>Number:\</emph\> Any numeric expression that specifies the power that you want to raise "e" to (the base of natural logarithms). The power must be for both single-precision numbers less than or equal to 88.02969 and double-precision numbers less than or equal to 709.782712893, since $[officename] Basic returns an Overflow error for numbers exceeding these values.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	hd_id3156280				0	en-ZA	Example:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3153193				0	en-ZA	Sub ExampleLogExp				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3125864				0	en-ZA	Dim dValue as Double				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3145172				0	en-ZA	const b1=12.345e12				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3159254				0	en-ZA	const b2=1.345e34				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3147287				0	en-ZA	dValue=Exp( Log(b1)+Log(b2) )				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3161832				0	en-ZA	MsgBox "" & dValue & chr(13) & (b1*b2) ,0,"Multiplication by logarithm"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080201.xhp	0	help	par_id3151112				0	en-ZA	end sub				2002-02-02 02:02:02
