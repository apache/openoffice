helpcontent2	source\text\swriter\01\04070300.xhp	0	help	par_id3145784				0	en-ZA	\<ahelp hid=\"SW:METRICFIELD:TP_ENV_PRT:FLD_RIGHT\"\>Enter the amount to shift the print area to the right.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070300.xhp	0	help	hd_id3155921				0	en-ZA	Shift down				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070300.xhp	0	help	par_id3151383				0	en-ZA	\<ahelp hid=\"SW:METRICFIELD:TP_ENV_PRT:FLD_DOWN\"\>Enter the amount to shift the print area down.\</ahelp\>				2002-02-02 02:02:02
