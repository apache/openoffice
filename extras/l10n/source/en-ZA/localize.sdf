helpcontent2	source\text\sbasic\shared\03131900.xhp	0	help	par_id3154910				0	en-ZA	' calling Dialog2 in the application library Library1				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03131900.xhp	0	help	par_id3156424				0	en-ZA	oDlgDesc = GlobalScope.DialogLibraries.Library1.Dialog2				2002-02-02 02:02:02
