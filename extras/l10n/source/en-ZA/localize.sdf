helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	tit				0	en-ZA	Asian Layout				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	hd_id3156414				0	en-ZA	\<link href=\"text/shared/optionen/01150100.xhp\" name=\"Asian Layout\"\>Asian Layout\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	par_id3145136				0	en-ZA	Defines the typographic default settings for Asian text.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	bm_id3143268				0	en-ZA	\<bookmark_value\>kerning;Asian texts\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	hd_id3143268				0	en-ZA	Kerning				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	par_id3155535				0	en-ZA	Defines the default settings for kerning between individual characters.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	hd_id3147275				0	en-ZA	Western characters only				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	par_id3149398				0	en-ZA	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_ASIAN_LAYOUT_RB_CHAR_KERNING\"\>Specifies that kerning is only applied to western text.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	hd_id3148538				0	en-ZA	Western text and Asian punctuation				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	par_id3147336				0	en-ZA	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_ASIAN_LAYOUT_RB_CHAR_PUNCT\"\>Specifies that kerning is applied to both western text and Asian punctuation.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	hd_id3153088				0	en-ZA	Character spacing				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	par_id3145119				0	en-ZA	Defines the default settings for character spacing in Asian texts, cells, and drawing objects.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	hd_id3150669				0	en-ZA	No compression				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	par_id3150503				0	en-ZA	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_ASIAN_LAYOUT_RB_NO_COMP\"\>Specifies that no compression at all will occur.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	hd_id3155419				0	en-ZA	Compress only punctuation				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	par_id3145673				0	en-ZA	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_ASIAN_LAYOUT_RB_PUNCT_COMP\"\>Specifies that only the punctuation is compressed.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	hd_id3151245				0	en-ZA	Compress punctuation and Japanese Kana				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	par_id3154346				0	en-ZA	\<ahelp hid=\"SVX_RADIOBUTTON_RID_SVXPAGE_ASIAN_LAYOUT_RB_PUNCT_KANA_COMP\"\>Specifies that punctuation and Japanese Kana are compressed.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	hd_id3148552				0	en-ZA	First and last characters				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	par_id3149295				0	en-ZA	Defines the default settings for 'first' and 'last' characters. In the dialogue that appears when you choose \<emph\>Format -\</emph\>\<link href=\"text/shared/01/05020700.xhp\" name=\"Asian Typography\"\>\<emph\>Asian Typography\</emph\>\</link\>, you can specify whether the list of forbidden characters applies to those at the beginning or end of a line in a paragraph.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	hd_id3154071				0	en-ZA	Language				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	par_id3151210				0	en-ZA	\<ahelp hid=\"SVX_LISTBOX_RID_SVXPAGE_ASIAN_LAYOUT_LB_LANGUAGE\"\>Specifies the language for which you want to define first and last characters.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	hd_id3145606				0	en-ZA	Default				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	par_id3148920	22			0	en-ZA	\<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_ASIAN_LAYOUT_CB_STANDARD\"\>When you mark\<emph\> Default\</emph\>, the following two text boxes are filled with the default characters for the selected language:\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	hd_id3144761				0	en-ZA	Not at start of line:				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	par_id3156214				0	en-ZA	\<ahelp hid=\"SVX_EDIT_RID_SVXPAGE_ASIAN_LAYOUT_ED_START\"\>Specifies the characters that should not appear alone at the beginning of a line.\</ahelp\> If a character typed here is positioned at the beginning of a line after a line break, it is automatically moved to the end of the previous line. For example, an exclamation point at the end of a sentence never appears at the start of a line if it is part of the \<emph\>Not at start of line\</emph\> list.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	hd_id3154908				0	en-ZA	Not at end of line:				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01150100.xhp	0	help	par_id3153367	26			0	en-ZA	\<ahelp hid=\"SVX_EDIT_RID_SVXPAGE_ASIAN_LAYOUT_ED_END\"\>Specifies the characters that should not appear alone at the end of a line.\</ahelp\> If a character typed here is positioned at the end of a line due to a line break, it is automatically moved to the beginning of the next line. For example, a currency symbol that appears in front of an amount never appears at the end of a line if it is part of the\<emph\> Not at end of line\</emph\> list.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01110100.xhp	0	help	tit				0	en-ZA	Default colours				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01110100.xhp	0	help	bm_id3154751				0	en-ZA	\<bookmark_value\>charts; colours\</bookmark_value\>\<bookmark_value\>colours;charts\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01110100.xhp	0	help	hd_id3149760				0	en-ZA	\<link href=\"text/shared/optionen/01110100.xhp\" name=\"Default colors\"\>Default colours\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01110100.xhp	0	help	par_id3150713				0	en-ZA	Assigns colours to the data rows. The settings only apply for all newly created charts.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01110100.xhp	0	help	hd_id3154751				0	en-ZA	Chart colours				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01110100.xhp	0	help	par_id3145345				0	en-ZA	\<ahelp hid=\"SCH:LISTBOX:TP_DEF_COLOR:LB_CHART_COLOR_LIST\"\>Displays all the colours available for the data series.\</ahelp\> Select a data series to change its colour. Select the desired colour from the adjacent colour table.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01110100.xhp	0	help	hd_id3154823				0	en-ZA	Colour table				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01110100.xhp	0	help	par_id3149398				0	en-ZA	This table is used as a means of replacing the chart colours for the selected data rows. For example, if you selected data row 6 and then click on the colour green 8, the old colour of the data row is replaced by green 8. The name of the selected colour is shown below the colour table.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01110100.xhp	0	help	hd_id3147242				0	en-ZA	Default				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01110100.xhp	0	help	par_id3156347				0	en-ZA	\<ahelp hid=\"SCH:PUSHBUTTON:TP_DEF_COLOR:PB_RESET_TO_DEFAULT\"\>Restores the colour settings that were defined when the program was installed.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01014000.xhp	0	help	tit				0	en-ZA	Network Identity				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01014000.xhp	0	help	bm_id3153681				0	en-ZA	\<bookmark_value\>network identity options\</bookmark_value\>\<bookmark_value\>options; network identity\</bookmark_value\>\<bookmark_value\>single sign on options\</bookmark_value\>\<bookmark_value\>LDAP server; sign on options\</bookmark_value\>\<bookmark_value\>remote configurations\</bookmark_value\>\<bookmark_value\>Configuration Manager\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01014000.xhp	0	help	hd_id3153681				0	en-ZA	\<link href=\"text/shared/optionen/01014000.xhp\" name=\"Network Identity\"\>Network Identity\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01014000.xhp	0	help	par_id3153562				0	en-ZA	\<ahelp hid=\".\"\>Sets the options for a remote configuration access to your personal $[officename] settings stored on an LDAP server.\</ahelp\> To see this tab page and to use this feature, remote configuration must be active: You need an account on an LDAP server that is running and configured to store $[officename] user settings.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01014000.xhp	0	help	par_id3149797				0	en-ZA	Using remote configuration, you can start a copy of $[officename] on any computer in the network with your own user data and personal configuration.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01014000.xhp	0	help	hd_id3155388				0	en-ZA	Authentication Method				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01014000.xhp	0	help	par_id3147335				0	en-ZA	\<ahelp hid=\"SVX_LISTBOX_RID_SVXPAGE_SSO_LB_MECHANISM\"\>Choose your security mechanism for access to the LDAP server.\</ahelp\> Choices are Simple or Kerberos.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01014000.xhp	0	help	hd_id3153881				0	en-ZA	User name				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01014000.xhp	0	help	par_id3148943				0	en-ZA	\<ahelp hid=\"SVX_EDIT_RID_SVXPAGE_SSO_ED_USERNAME\"\>Using "simple" authentication method, you enter your user name on the LDAP server here.\</ahelp\> Using "Kerberos", you just see your user name, but cannot edit it.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01014000.xhp	0	help	hd_id3153061				0	en-ZA	Password				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01014000.xhp	0	help	par_id3156343				0	en-ZA	\<ahelp hid=\"SVX_EDIT_RID_SVXPAGE_SSO_ED_PASSWORD\"\>Using "simple" authentication method, enter your password for access to the LDAP server here.\</ahelp\> Using "Kerberos", this box is not active.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01014000.xhp	0	help	hd_id3146795				0	en-ZA	Save password				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01014000.xhp	0	help	par_id3150358				0	en-ZA	\<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_SSO_CB_PASSWORD\"\>Using "simple" authentication method, check this box to make your password persistent.\</ahelp\> If the password is persistent and the same user starts $[officename] later on, the user name and password will not be requested again. Using "Kerberos", this box is not active.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01014000.xhp	0	help	par_id3154939	12			0	en-ZA	The password will be stored encrypted in a file called .ssop in your \<switchinline select=\"sys\"\>\<caseinline select=\"UNIX\"\>home directory \</caseinline\>\<defaultinline\>"My Documents" folder\</defaultinline\>\</switchinline\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01060700.xhp	0	help	tit				0	en-ZA	Print				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01060700.xhp	0	help	hd_id3153311				0	en-ZA	\<link href=\"text/shared/optionen/01060700.xhp\" name=\"Print\"\>Print\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01060700.xhp	0	help	par_id3143267				0	en-ZA	\<ahelp hid=\"\"\>Determines the printer settings for spreadsheets.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01060700.xhp	0	help	par_id3155892				0	en-ZA	\<emph\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - %PRODUCTNAME Calc - Print\</emph\> defines the settings for all spreadsheets. To define settings for the current document only, choose \<emph\>File - Print\</emph\>, then click the \<emph\>Options\</emph\> button.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01060700.xhp	0	help	hd_id3153542				0	en-ZA	Pages				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01060700.xhp	0	help	hd_id3156155				0	en-ZA	Suppress output of empty pages				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01060700.xhp	0	help	par_id3158430				0	en-ZA	\<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_PRINT_BTN_SKIPEMPTYPAGES\"\>Specifies that empty pages that have no cell contents or draw objects are not printed.\</ahelp\> Cell attributes such as borders or background colours are not considered cell contents. Empty pages are not counted for page numbering.				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01060700.xhp	0	help	hd_id3150275				0	en-ZA	Sheets				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01060700.xhp	0	help	hd_id3149784				0	en-ZA	Print only selected sheets				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01060700.xhp	0	help	par_id3152349				0	en-ZA	\<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_PRINT_BTN_SELECTEDSHEETS\"\>Specifies that only contents from selected sheets are printed, even if you specify a wider range in the \<emph\>File - Print\</emph\> dialogue or in the \<emph\>Format - Print Ranges\</emph\> dialogue. Contents from sheets that are not selected will not be printed.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01060700.xhp	0	help	par_id3153349				0	en-ZA	To select multiple sheets, click on the sheet names on the bottom margin of the workspace while keeping the Ctrl key pressed.				2002-02-02 02:02:02
