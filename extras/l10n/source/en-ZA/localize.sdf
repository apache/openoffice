helpcontent2	source\text\swriter\01\02110000.xhp	0	help	hd_id3154424	51			0	en-ZA	Chapter Down				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02110000.xhp	0	help	par_id3154440				0	en-ZA	\<ahelp hid=\"HID_NAVI_TBX6\"\>Moves the selected heading, and the text below the heading, down one heading position in the Navigator and in the document. To move only the selected heading and not the text associated with the heading, hold down Ctrl, and then click this icon.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02110000.xhp	0	help	par_id3153768				0	en-ZA	\<image id=\"img_id3150828\" src=\"sw/imglst/sc20171.png\" width=\"0.2228in\" height=\"0.2228in\"\>\<alt id=\"alt_id3150828\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
