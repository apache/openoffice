helpcontent2	source\text\scalc\01\12090103.xhp	0	help	par_id3155506				0	en-ZA	\<ahelp hid=\"SC:COMBOBOX:RID_SCDLG_PIVOTFILTER:ED_VAL3\" visibility=\"visible\"\>Select the value that you want to compare to the selected field.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090103.xhp	0	help	hd_id3146980				0	en-ZA	\<link href=\"text/scalc/01/12090104.xhp\" name=\"More>>\"\>More>>\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	tit				0	en-ZA	Statistical Functions Part Five				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3147072				0	en-ZA	\<variable id=\"rz\"\>\<link href=\"text/scalc/01/04060185.xhp\" name=\"Statistical Functions Part Five\"\>Statistical Functions Part Five\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3155071				0	en-ZA	\<bookmark_value\>RANK function\</bookmark_value\>         \<bookmark_value\>numbers;determining ranks\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3155071				0	en-ZA	RANK				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153976				0	en-ZA	\<ahelp hid=\"HID_FUNC_RANG\"\>Returns the rank of a number in a sample.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3159206				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153250				0	en-ZA	RANK(Value; Data; Type)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154543	6			0	en-ZA	            \<emph\>Value\</emph\> is the value, whose rank is to be determined.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149130	7			0	en-ZA	            \<emph\>Data\</emph\> is the array or range of data in the sample.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150215	8			0	en-ZA	            \<emph\>Type\</emph\> (optional) is the sequence order.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id9305398				0	en-ZA	Type = 0 means descending from the last item of the array to the first (this is the default), 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id9996948				0	en-ZA	Type = 1 means ascending from the first item of the range to the last.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3143223				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3155919	10			0	en-ZA	            \<item type=\"input\"\>=RANK(A10;A1:A50)\</item\> returns the ranking of the value in A10 in value range A1:A50. If \<item type=\"literal\"\>Value\</item\> does not exist within the range an error message is displayed.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3153556				0	en-ZA	\<bookmark_value\>SKEW function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3153556				0	en-ZA	SKEW				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153485				0	en-ZA	\<ahelp hid=\"HID_FUNC_SCHIEFE\"\>Returns the skewness of a distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3154733				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3151191				0	en-ZA	SKEW(Number1; Number2; ...Number30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3155757	16			0	en-ZA	            \<emph\>Number1, Number2...Number30\</emph\> are numerical values or ranges.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3153297				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3145118	18			0	en-ZA	            \<item type=\"input\"\>=SKEW(A1:A50)\</item\> calculates the value of skew for the data referenced.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3149051				0	en-ZA	\<bookmark_value\>regression lines;FORECAST function\</bookmark_value\>         \<bookmark_value\>extrapolations\</bookmark_value\>         \<bookmark_value\>FORECAST function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3149051				0	en-ZA	FORECAST				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153290				0	en-ZA	\<ahelp hid=\"HID_FUNC_SCHAETZER\"\>Extrapolates future values based on existing x and y values.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3151343				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3147404				0	en-ZA	FORECAST(Value; DataY; DataX)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3148743	24			0	en-ZA	            \<emph\>Value\</emph\> is the x value, for which the y value on the linear regression is to be returned.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3146325	25			0	en-ZA	            \<emph\>DataY\</emph\> is the array or range of known y's.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150536	26			0	en-ZA	            \<emph\>DataX\</emph\> is the array or range of known x's.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3147416				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3157874	28			0	en-ZA	            \<item type=\"input\"\>=FORECAST(50;A1:A50;B1;B50)\</item\> returns the Y value expected for the X value of 50 if the X and Y values in both references are linked by a linear trend.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3149143				0	en-ZA	\<bookmark_value\>STDEV function\</bookmark_value\>         \<bookmark_value\>standard deviations in statistics;based on a sample\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3149143				0	en-ZA	STDEV				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3146888				0	en-ZA	\<ahelp hid=\"HID_FUNC_STABW\"\>Estimates the standard deviation based on a sample.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3146815				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149946	33			0	en-ZA	STDEV(Number1; Number2; ...Number30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3157904	34			0	en-ZA	            \<emph\>Number1, Number2, ... Number30\</emph\> are numerical values or ranges representing a sample based on an entire population.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3150650				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149434	36			0	en-ZA	            \<item type=\"input\"\>=STDEV(A1:A50)\</item\> returns the estimated standard deviation based on the data referenced.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3144745				0	en-ZA	\<bookmark_value\>STDEVA function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3144745				0	en-ZA	STDEVA				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3151234				0	en-ZA	\<ahelp hid=\"HID_FUNC_STABWA\"\>Calculates the standard deviation of an estimation based on a sample.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3148884				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3147422				0	en-ZA	STDEVA(Value1;Value2;...Value30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154547	190			0	en-ZA	            \<emph\>Value1, Value2, ...Value30\</emph\> are values or ranges representing a sample derived from an entire population. Text has the value 0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3155829				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3148581	192			0	en-ZA	            \<item type=\"input\"\>=STDEVA(A1:A50)\</item\> returns the estimated standard deviation based on the data referenced.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3149734				0	en-ZA	\<bookmark_value\>STDEVP function\</bookmark_value\>         \<bookmark_value\>standard deviations in statistics;based on a population\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3149734				0	en-ZA	STDEVP				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149187				0	en-ZA	\<ahelp hid=\"HID_FUNC_STABWN\"\>Calculates the standard deviation based on the entire population.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3154387				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154392				0	en-ZA	STDEVP(Number1;Number2;...Number30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3155261	42			0	en-ZA	            \<emph\>Number 1,Number 2,...Number 30\</emph\> are numerical values or ranges representing a sample based on an entire population.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3145591				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153933	44			0	en-ZA	            \<item type=\"input\"\>=STDEVP(A1:A50)\</item\> returns a standard deviation of the data referenced.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3154522				0	en-ZA	\<bookmark_value\>STDEVPA function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3154522				0	en-ZA	STDEVPA				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149549				0	en-ZA	\<ahelp hid=\"HID_FUNC_STABWNA\"\>Calculates the standard deviation based on the entire population.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3155950				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3146851				0	en-ZA	STDEVPA(Value1;Value2;...Value30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153109	198			0	en-ZA	            \<emph\>Value1,value2,...value30\</emph\> are values or ranges representing a sample derived from an entire population. Text has the value 0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3154506				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3145163	200			0	en-ZA	            \<item type=\"input\"\>=STDEVPA(A1:A50)\</item\> returns the standard deviation of the data referenced.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3155928				0	en-ZA	\<bookmark_value\>STANDARDIZE function\</bookmark_value\>         \<bookmark_value\>converting;random variables, into normalized values\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3155928				0	en-ZA	STANDARDIZE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149883				0	en-ZA	\<ahelp hid=\"HID_FUNC_STANDARDISIERUNG\"\>Converts a random variable to a normalized value.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3154330				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150132				0	en-ZA	STANDARDIZE(Number; Mean; StDev)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3159139	50			0	en-ZA	            \<emph\>Number\</emph\> is the value to be standardised.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3145241	51			0	en-ZA	            \<emph\>Mean\</emph\> is the arithmetic mean of the distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3148874	52			0	en-ZA	            \<emph\>StDev\</emph\> is the standard deviation of the distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3145351				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3156067	54			0	en-ZA	            \<item type=\"input\"\>=STANDARDIZE(11;10;1)\</item\> returns 1. The value 11 in a normal distribution with a mean of 10 and a standard deviation of 1 is as much above the mean of 10, as the value 1 is above the mean of the standard normal distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3157986				0	en-ZA	\<bookmark_value\>NORMSINV function\</bookmark_value\>         \<bookmark_value\>normal distribution;inverse of standard\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3157986				0	en-ZA	NORMSINV				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3151282				0	en-ZA	\<ahelp hid=\"HID_FUNC_STANDNORMINV\"\>Returns the inverse of the standard normal cumulative distribution.\</ahelp\>				2002-02-02 02:02:02
