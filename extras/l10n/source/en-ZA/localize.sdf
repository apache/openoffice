helpcontent2	source\text\swriter\01\04030000.xhp	0	help	tit				0	en-ZA	Footnote/Endnote				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	hd_id3145241				0	en-ZA	\<link href=\"text/swriter/01/04030000.xhp\" name=\"Insert Footnote\"\>Footnote/Endnote\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3147167	2			0	en-ZA	\<variable id=\"fussnoteein\"\>\<ahelp hid=\".uno:InsertFootnote\"\>Inserts a footnote or an endnote in the document. The anchor for the note is inserted at the current cursor position.\</ahelp\> You can choose between automatic numbering or a custom symbol. \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3154645	23			0	en-ZA	\<variable id=\"endnoten\"\>The following applies to both footnotes and endnotes. \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3151175	24			0	en-ZA	\<variable id=\"endnotetext\"\>Footnotes are inserted at the end of a page, and endnotes are inserted at the end of a document. \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	hd_id3154106				0	en-ZA	Numbering				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3149812				0	en-ZA	Select the type of numbering that you want to use for footnotes and endnotes.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	hd_id3154470				0	en-ZA	Automatic				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3153670	17			0	en-ZA	\<variable id=\"bearbeitenautomatisch\"\>\<ahelp hid=\"SW:RADIOBUTTON:DLG_INS_FOOTNOTE:RB_NUMBER_AUTO\"\>Automatically assigns consecutive numbers to the footnotes or endnotes that you insert.\</ahelp\> To change the settings for automatic numbering, choose \<link href=\"text/swriter/01/06080000.xhp\" name=\"Tools - Footnotes\"\>\<emph\>Tools - Footnotes/Endnotes\</emph\>\</link\>. \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	hd_id3152952				0	en-ZA	Character				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3155901	18			0	en-ZA	\<variable id=\"bearbeitenzeichen\"\>\<ahelp hid=\"SW:EDIT:DLG_INS_FOOTNOTE:ED_NUMBER_CHAR\"\>Choose this option to define a character or symbol for the current footnote.\</ahelp\> This can be either a letter or number. To assign a special character, click the button at the bottom. \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	hd_id3155185				0	en-ZA	...				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3153526				0	en-ZA	\<variable id=\"bearbeitensonderzeichen\"\>\<ahelp hid=\"SW:PUSHBUTTON:DLG_INS_FOOTNOTE:BT_NUMBER_CHAR\"\>Inserts a \<link href=\"text/shared/01/04100000.xhp\" name=\"special character \"\>special character \</link\> as a footnote or endnote anchor.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	hd_id3149493				0	en-ZA	Type				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3151256				0	en-ZA	Select whether to insert a footnote or an endnote. Endnote numbering is separate from the footnote numbering.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	hd_id3149104				0	en-ZA	Footnote				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3148981				0	en-ZA	\<ahelp hid=\"SW:RADIOBUTTON:DLG_INS_FOOTNOTE:RB_TYPE_FTN\"\>Inserts a footnote anchor at the current cursor position in the document, and adds a footnote to the bottom of the page.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	hd_id3153644				0	en-ZA	Endnote				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3152770				0	en-ZA	\<ahelp hid=\"SW:RADIOBUTTON:DLG_INS_FOOTNOTE:RB_TYPE_ENDNOTE\"\>Inserts an endnote anchor at the current cursor position in the document, and adds an endnote at the end of the document.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3155135				0	en-ZA	\<link href=\"text/swriter/guide/footnote_usage.xhp\" name=\"Tips for working with footnotes\"\>Tips for working with footnotes\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	tit				0	en-ZA	Edit Index Entry				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	hd_id3154567				0	en-ZA	Edit Index Entry				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3151314				0	en-ZA	\<variable id=\"verzeichniseintragtext\"\>\<ahelp hid=\".uno:IndexEntryDialog\"\>Edits the selected index entry. Click in front of or in the index entry, and then choose this command.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3155896				0	en-ZA	To insert an index entry, select a word in the document, and then choose \<link href=\"text/swriter/01/04120100.xhp\" name=\"Insert - Indexes and Tables - Entry\"\>\<emph\>Insert - Indexes and Tables - Entry\</emph\>\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	hd_id3159193				0	en-ZA	Selection				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3149486				0	en-ZA	Edits the selected index entry.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	hd_id3143272				0	en-ZA	Index				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3151251				0	en-ZA	\<ahelp hid=\"SW:LISTBOX:DLG_MULTMRK:LB_TOX\"\>Displays the type of index that the selected entry belongs to.\</ahelp\> You cannot change the index type of an index entry in this dialogue. Instead, you must delete the index entry from the document, and then insert it again in a different index type.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	hd_id3149107				0	en-ZA	Entry				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3149823	8			0	en-ZA	\<ahelp hid=\"SW:LISTBOX:DLG_MULTMRK:LB_TOX\"\>Edit the index entry if necessary. When you modify the index entry, the new text only appears in the index, and not at the index entry anchor in the document. \</ahelp\> For example, you can enter an index with comments such as "Basics, see also General".				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	hd_id3149036				0	en-ZA	1st key				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3153631				0	en-ZA	\<ahelp hid=\"SW:LISTBOX:DLG_MULTMRK:LB_TOX\"\>To create a multilevel index, type the name of the first level index entry, or select a name from the list. The current index entry is added below this name.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	hd_id3152773				0	en-ZA	2nd key				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3145758				0	en-ZA	\<ahelp hid=\"SW:LISTBOX:DLG_MULTMRK:LB_TOX\"\>Type the name of the second level index entry, or select a name from the list. The current index entry is added below this name.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	hd_id3155143				0	en-ZA	Level				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3149170				0	en-ZA	\<ahelp hid=\"SW:LISTBOX:DLG_MULTMRK:LB_TOX\"\>Changes the outline level of a table of contents entry.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	hd_id3145785				0	en-ZA	Delete				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3155919				0	en-ZA	\<ahelp hid=\"HID_INSERT_IDX_MRK_DELETE\"\>Deletes the selected entry from the index. The entry text in the document is not deleted.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	hd_id3151384				0	en-ZA	End arrow to left				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3155869				0	en-ZA	\<ahelp hid=\"HID_INSERT_IDX_MRK_PREV_SAME\"\>Jumps to the first index entry of the same type in the document.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3147420				0	en-ZA	\<image id=\"img_id3149551\" src=\"sd/res/imagelst/nv03.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3149551\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3150550				0	en-ZA	End arrow to left				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	hd_id3147736				0	en-ZA	End arrow to right				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3149829				0	en-ZA	\<ahelp hid=\"HID_INSERT_IDX_MRK_NEXT_SAME\"\>Jumps to the last index entry of the same type in the document.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3153298				0	en-ZA	\<image id=\"img_id3153309\" src=\"sd/res/imagelst/nv06.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3153309\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3156108				0	en-ZA	End arrow to right				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	hd_id3155080				0	en-ZA	Arrow to left				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3154327				0	en-ZA	\<ahelp hid=\"HID_INSERT_IDX_MRK_PREV\"\>Jumps to the previous index entry of the same type in the document.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3148785				0	en-ZA	\<image id=\"img_id3148791\" src=\"res/commandimagelist/sc_prevrecord.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3148791\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3153129				0	en-ZA	Left Arrow				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	hd_id3154617				0	en-ZA	Arrow to right				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3154633				0	en-ZA	\<ahelp hid=\"HID_INSERT_IDX_MRK_NEXT\"\>Jumps to the next index entry of the same type in the document.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3150677				0	en-ZA	\<image id=\"img_id3154020\" src=\"sd/res/imagelst/nv05.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3154020\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3149965				0	en-ZA	Right Arrow				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3155539				0	en-ZA	You can jump quickly to index entries with the \<link href=\"text/swriter/01/02110100.xhp\" name=\"Navigation Bar\"\>Navigation Bar\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	tit				0	en-ZA	Edit Concordance File				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	bm_id3148768				0	en-ZA	\<bookmark_value\>editing; concordance files\</bookmark_value\>\<bookmark_value\>concordance files; definition\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	hd_id3148768				0	en-ZA	Edit Concordance File				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3151180				0	en-ZA	\<ahelp hid=\"HID_DLG_CREATE_AUTOMARK\"\>Create or edit a list of words to include in an Alphabetical Index.\</ahelp\> A concordance file lists words that should be referenced in an alphabetical index, together with the page number(s) where they appear in the document.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id837427				0	en-ZA	You can use the Find All button on the Find & Replace dialogue to highlight all places where a word appears, then open the Insert Index Entry dialogue to add that word and places to the alphabetical index. However, if you need the same set of alphabetical indexes in multiple documents, the concordance file allows to enter every word just once, then use the list many times.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	hd_id3154645				0	en-ZA	To access the Edit Concordance File dialogue:				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3149292				0	en-ZA	Choose \<emph\>Insert - Indexes and Tables - Indexes and Tables - Index/Table\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3145420	21			0	en-ZA	In the \<emph\>Type \</emph\>box, select "Alphabetical Index".				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3154107	22			0	en-ZA	In the \<emph\>Options \</emph\>area, select the \<emph\>Concordance file\</emph\> check box.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3153668				0	en-ZA	Click the \<emph\>File\</emph\> button, and then choose \<emph\>New\</emph\> or \<emph\>Edit\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3154470	24			0	en-ZA	A concordance file contains the following fields: 				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3152953				0	en-ZA	"Search term" refers to the index entry that you want to mark in the document.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3155896				0	en-ZA	"Alternative entry" refers to the index entry that you want to appear in the index.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3154194				0	en-ZA	The 1st and 2nd Keys are parent index entries. The "Search term" or the "Alternative entry" appears as a subentry under the 1st and 2nd Keys.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3155184				0	en-ZA	"Match case" means that uppercase and lowercase letters are considered.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3143282				0	en-ZA	"Word only" searches for the term as a single word.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3147220				0	en-ZA	To enable the "Match case" or "Word only" options, click in the corresponding cell, and then select the tick box.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	hd_id3153629				0	en-ZA	To create a concordance file without the Edit Concordance File dialogue:				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3153644				0	en-ZA	Use the following format guidelines when you create a concordance file:				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3152770				0	en-ZA	Each entry in the concordance file is on a separate line.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3155142				0	en-ZA	Commented lines start with #.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3153354				0	en-ZA	Use the following format for the entries:				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3149172				0	en-ZA	Search term;Alternative entry;1st key;2nd key;Match case;Word only				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3156270				0	en-ZA	The entries "Match case" and "Word only" are interpreted as "No" or FALSE if they are empty or zero (0). All other contents are interpreted as "Yes" or TRUE.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	hd_id3145778				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3155907				0	en-ZA	For example, to include the word "Boston" in your alphabetical index under the "Cities" entry, enter the following line in the concordance file:				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3151370				0	en-ZA	Boston;Boston;Cities;;0;0 				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3151383				0	en-ZA	This also finds "Boston" if it is written in lowercase letters.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3155866				0	en-ZA	To include the "Beacon Hill" district in Boston under the "Cities" entry, enter the following line:				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3150116	18			0	en-ZA	Beacon Hill;Boston;Cities; 				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\03120000.xhp	0	help	tit				0	en-ZA	Web Layout				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\03120000.xhp	0	help	hd_id3145243				0	en-ZA	\<link href=\"text/swriter/01/03120000.xhp\" name=\"Web Layout\"\>Web Layout\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\03120000.xhp	0	help	par_id3154646				0	en-ZA	\<ahelp hid=\".uno:BrowseView\"\>Displays the document as seen in a Web browser.\</ahelp\> This is useful when you create HTML documents.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04200000.xhp	0	help	tit				0	en-ZA	Insert Script				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04200000.xhp	0	help	hd_id3147402				0	en-ZA	Insert Script				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04200000.xhp	0	help	par_id3155620				0	en-ZA	\<variable id=\"scripttext\"\>\<ahelp hid=\".uno:InsertScript\"\>Inserts a script at the current cursor position in an HTML or text document.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04200000.xhp	0	help	par_id3149880				0	en-ZA	An inserted script is indicated by a small green rectangle. If you do not see the rectangle, choose \<emph\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - %PRODUCTNAME Writer/Web - \<link href=\"text/shared/optionen/01040200.xhp\" name=\"View\"\>View\</link\>\</emph\>, and select the \<emph\>Comments\</emph\> check box. To edit a script, double-click the green rectangle.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04200000.xhp	0	help	par_id3150572				0	en-ZA	If your document contains more than one script, the \<emph\>Edit Script\</emph\> dialogue contains previous and next buttons to jump from script to script.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04200000.xhp	0	help	par_id0903200802541668				0	en-ZA	\<ahelp hid=\".\" visibility=\"hidden\"\>Jump to Previous Script.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04200000.xhp	0	help	par_id0903200802541770				0	en-ZA	\<ahelp hid=\".\" visibility=\"hidden\"\>Jump to Next Script.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04200000.xhp	0	help	hd_id3154644				0	en-ZA	Contents				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04200000.xhp	0	help	hd_id3149294				0	en-ZA	Script Type				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04200000.xhp	0	help	par_id3145413				0	en-ZA	\<ahelp hid=\"SW:EDIT:DLG_JAVAEDIT:ED_TYPE\"\>Enter the type of script that you want to insert.\</ahelp\> The script is identified in the HTML source code by the tag <SCRIPT LANGUAGE="JavaScript">.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04200000.xhp	0	help	hd_id3154097				0	en-ZA	URL				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04200000.xhp	0	help	par_id3149810	14			0	en-ZA	\<ahelp hid=\"SW:EDIT:DLG_JAVAEDIT:ED_URL\"\>Adds a link to a script file. Click the \<emph\>URL \</emph\>radio button, and then enter the link in the box. You can also click the browse button (\<emph\>...\</emph\>), locate the file, and then click \<emph\>Insert\</emph\>.\</ahelp\> The linked script file is identified in the HTML source code by the following tags:				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04200000.xhp	0	help	par_id3152963				0	en-ZA	<SCRIPT LANGUAGE="JavaScript" SRC="url">				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04200000.xhp	0	help	par_id3153678				0	en-ZA	/* ignore all text here */				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04200000.xhp	0	help	par_id3154574				0	en-ZA	</SCRIPT>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04200000.xhp	0	help	hd_id3155903				0	en-ZA	...				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04200000.xhp	0	help	par_id3154188				0	en-ZA	\<ahelp hid=\"SW:PUSHBUTTON:DLG_JAVAEDIT:PB_URL\"\>Locate the script file that you want to link to, and then click \<emph\>Insert\</emph\>.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04200000.xhp	0	help	hd_id3155184				0	en-ZA	Text				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04200000.xhp	0	help	par_id3143272				0	en-ZA	\<ahelp hid=\"SW:RADIOBUTTON:DLG_JAVAEDIT:RB_EDIT\"\>Enter the script code that you want to insert.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060300.xhp	0	help	tit				0	en-ZA	Picture				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060300.xhp	0	help	hd_id3154473				0	en-ZA	\<link href=\"text/swriter/01/05060300.xhp\" name=\"Graphics\"\>Picture\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060300.xhp	0	help	par_id3152961				0	en-ZA	\<ahelp hid=\"HID_GRF_EXT\"\>Specify the flip and the link options for the selected graphic.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060300.xhp	0	help	hd_id3154191				0	en-ZA	Flip				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060300.xhp	0	help	hd_id3155174				0	en-ZA	Vertically				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060300.xhp	0	help	par_id3149485				0	en-ZA	\<variable id=\"vertikaltext\"\>\<ahelp hid=\"SW:CHECKBOX:TP_GRF_EXT:CB_VERT\"\>Flips the selected graphic vertically.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060300.xhp	0	help	hd_id3154829				0	en-ZA	Horizontally				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060300.xhp	0	help	par_id3151261				0	en-ZA	\<variable id=\"horizontaltext\"\>\<ahelp hid=\"SW:CHECKBOX:TP_GRF_EXT:CB_HOR\"\>Flips the selected graphic horizontally.\</ahelp\>\</variable\>				2002-02-02 02:02:02
