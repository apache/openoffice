helpcontent2	source\text\sbasic\shared\03120311.xhp	0	help	par_id3155341				0	en-ZA	Trim( Text As String )				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120311.xhp	0	help	hd_id3155388				0	en-ZA	Return value:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120311.xhp	0	help	par_id3143228				0	en-ZA	String				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120311.xhp	0	help	hd_id3145609				0	en-ZA	Parameters:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120311.xhp	0	help	par_id3159414				0	en-ZA	\<emph\>Text:\</emph\> Any string expression.				2002-02-02 02:02:02
