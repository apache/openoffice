helpcontent2	source\text\sbasic\shared\03030201.xhp	0	help	par_id3156441				0	en-ZA	Print "The current hour is " & Hour( Now )				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03030201.xhp	0	help	par_id3153145				0	en-ZA	End Sub				2002-02-02 02:02:02
