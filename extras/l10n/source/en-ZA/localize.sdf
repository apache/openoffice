helpcontent2	source\text\sbasic\shared\03030205.xhp	0	help	par_id3155600				0	en-ZA	MsgBox dDate,64,"Time as a number"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03030205.xhp	0	help	par_id3153417				0	en-ZA	MsgBox sDate,64,"Formatted time"				2002-02-02 02:02:02
