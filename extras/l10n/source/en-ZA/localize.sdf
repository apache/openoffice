helpcontent2	source\text\scalc\01\12090103.xhp	0	help	par_id3147003				0	en-ZA	greater than				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090103.xhp	0	help	par_id3153270				0	en-ZA	<=				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090103.xhp	0	help	par_id3145257				0	en-ZA	less than or equal to				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12090103.xhp	0	help	par_id3145134				0	en-ZA	>=				2002-02-02 02:02:02
