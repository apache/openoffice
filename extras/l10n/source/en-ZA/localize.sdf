helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_id0123200902243466				0	en-ZA	\<ahelp hid=\".\"\>Select the colour for the overlining.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	hd_id3150400				0	en-ZA	Strikethrough				2002-02-02 02:02:02
