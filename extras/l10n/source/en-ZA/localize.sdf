helpcontent2	source\text\schart\01\04070000.xhp	0	help	tit				0	en-ZA	Grids				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\04070000.xhp	0	help	bm_id3147434				0	en-ZA	\<bookmark_value\>axes; inserting grids\</bookmark_value\>\<bookmark_value\>grids; inserting in charts\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\04070000.xhp	0	help	hd_id3147434				0	en-ZA	Grids				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\04070000.xhp	0	help	par_id3146974				0	en-ZA	\<variable id=\"gitter\"\>\<ahelp hid=\".\"\>You can divide the axes into sections by assigning gridlines to them. This allows you to get a better overview of the chart, especially if you are working with large charts.\</ahelp\>\</variable\> The Y axis major grid is activated by default.				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\04070000.xhp	0	help	hd_id3156286				0	en-ZA	Major grids				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\04070000.xhp	0	help	par_id3154511				0	en-ZA	Defines the axis to be set as the major grid.				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\04070000.xhp	0	help	hd_id3149400				0	en-ZA	X axis				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\04070000.xhp	0	help	par_id3150749				0	en-ZA	\<ahelp hid=\"SCH:CHECKBOX:DLG_GRID:CB_X_MAIN\"\>Adds gridlines to the X axis of the chart.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\04070000.xhp	0	help	par_id3154754				0	en-ZA	\<variable id=\"sytextxgitter\"\>\<ahelp hid=\".uno:ToggleGridHorizontal\"\>The \<emph\>Horizontal Grid On/Off\</emph\> icon on the \<emph\>Formatting\</emph\> bar toggles the visibility of the grid display for the X axis. Note: This only works if the \<emph\>Minor grid\</emph\> check boxes in \<emph\>Insert - Grids\</emph\> are cleared.\</ahelp\>\</variable\> Otherwise, the minor grid remains visible when the major grid is turned off.				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\04070000.xhp	0	help	hd_id3145228				0	en-ZA	Y axis				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\04070000.xhp	0	help	par_id3147004				0	en-ZA	\<ahelp hid=\"SCH:CHECKBOX:DLG_GRID:CB_Y_MAIN\"\>Adds gridlines to the Y axis of the chart.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\04070000.xhp	0	help	par_id3150344				0	en-ZA	\<variable id=\"sytextygitter\"\>\<ahelp hid=\".uno:ToggleGridVertical\"\>The \<emph\>Vertical Grid On/Off\</emph\> icon on the \<emph\>Formatting\</emph\> bar toggles the visibility of the grid display for the Y axis. Note: This only works if the X-axis \<emph\>Minor grid\</emph\> is not selected in \<emph\>Insert - Grids\</emph\>.\</ahelp\>\</variable\> Otherwise, the minor grid remains visible when the major grid is turned off.				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\04070000.xhp	0	help	hd_id3166430				0	en-ZA	Z axis				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\04070000.xhp	0	help	par_id3155378				0	en-ZA	\<ahelp hid=\"SCH:CHECKBOX:DLG_GRID:CB_Z_MAIN\"\>Adds gridlines to the Z axis of the chart.\</ahelp\> This option is only available if you're working with 3D charts.				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\04070000.xhp	0	help	hd_id3146978				0	en-ZA	Minor grids				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\04070000.xhp	0	help	par_id3156449				0	en-ZA	Use this area to assign a minor grid for each axis. Assigning minor grids to the axis reduces the distance between the major grids.				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\04070000.xhp	0	help	hd_id3153308				0	en-ZA	X axis				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\04070000.xhp	0	help	par_id3148704				0	en-ZA	\<ahelp hid=\"SCH:CHECKBOX:DLG_GRID:CB_X_HELP\"\>Adds gridlines that subdivide the X axis into smaller sections.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\04070000.xhp	0	help	hd_id3153917				0	en-ZA	Y axis				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\04070000.xhp	0	help	par_id3154536				0	en-ZA	\<ahelp hid=\"SCH:CHECKBOX:DLG_GRID:CB_Y_HELP\"\>Adds gridlines that subdivide the Y axis into smaller sections.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\04070000.xhp	0	help	hd_id3148607				0	en-ZA	Z axis				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\04070000.xhp	0	help	par_id3153247				0	en-ZA	\<ahelp hid=\"SCH:CHECKBOX:DLG_GRID:CB_Z_HELP\"\>Adds gridlines that subdivide the Z axis into smaller sections.\</ahelp\> This option is only available if you're working with 3D charts.				2002-02-02 02:02:02
