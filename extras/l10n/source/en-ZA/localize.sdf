helpcontent2	source\text\schart\01\type_stock.xhp	0	help	par_id6897183				0	en-ZA	2200				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\type_stock.xhp	0	help	par_id7003387				0	en-ZA	40				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\type_stock.xhp	0	help	par_id4897915				0	en-ZA	30				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\type_stock.xhp	0	help	par_id3105868				0	en-ZA	47				2002-02-02 02:02:02
helpcontent2	source\text\schart\01\type_stock.xhp	0	help	par_id3908810				0	en-ZA	35				2002-02-02 02:02:02
