helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3153061				0	en-ZA	Right (Text As String, n As Long)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	hd_id3145068				0	en-ZA	Return value:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3156344				0	en-ZA	String				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	hd_id3146795				0	en-ZA	Parameters:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3153526				0	en-ZA	\<emph\>Text:\</emph\> Any string expression that you want to return the rightmost characters of.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3151211				0	en-ZA	\<emph\>n:\</emph\> Numeric expression that defines the number of characters that you want to return. If \<emph\>n\</emph\> = 0, a zero-length string is returned. The maximum allowed value is 65535.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3158410				0	en-ZA	The following example converts a date in YYYY-MM-DD format to the US date format (MM/DD/YYYY).				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	hd_id3156212				0	en-ZA	Example:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3150869				0	en-ZA	Sub ExampleUSDate				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3153105				0	en-ZA	Dim sInput As String				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3154124				0	en-ZA	Dim sUS_date As String				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3159252				0	en-ZA	sInput = InputBox("Please input a date in the international format 'YYYY-MM-DD'")				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3149561				0	en-ZA	sUS_date = Mid(sInput, 6, 2)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3146984				0	en-ZA	sUS_date = sUS_date & "/"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3155308				0	en-ZA	sUS_date = sUS_date & Right(sInput, 2)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3153727				0	en-ZA	sUS_date = sUS_date & "/"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3145365				0	en-ZA	sUS_date = sUS_date & Left(sInput, 4)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3152940				0	en-ZA	MsgBox sUS_date				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3146120				0	en-ZA	End Sub				2002-02-02 02:02:02
