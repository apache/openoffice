readlicense_oo	docs\readme\readme.xrm	0	readmeitem	s2etfseg	s2etfseg			0	en-ZA	Pentium compatible PC (Pentium III or Athlon recommended)				2002-02-02 02:02:02
readlicense_oo	docs\readme\readme.xrm	0	readmeitem	s2ssdfe	s2ssdfe			0	en-ZA	256 MB RAM (512 MB RAM recommended)				2002-02-02 02:02:02
