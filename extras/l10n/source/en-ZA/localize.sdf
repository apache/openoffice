helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3153876				0	en-ZA	100				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3145251				0	en-ZA	120				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3149400				0	en-ZA	130				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3150328				0	en-ZA	350				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12080500.xhp	0	help	par_id3155443				0	en-ZA	100				2002-02-02 02:02:02
