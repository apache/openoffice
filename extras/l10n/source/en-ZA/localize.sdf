helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_id3149580				0	en-ZA	\<image id=\"img_id3148642\" src=\"res/sc06303.png\" width=\"0.222in\" height=\"0.222in\"\>\<alt id=\"alt_id3148642\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_id3154285				0	en-ZA	\<ahelp hid=\"HID_HELP_TOOLBOXITEM_START\"\>Moves to the \<emph\>first page\</emph\> of the current Help topic\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\05\00000110.xhp	0	help	par_id3149797				0	en-ZA	\<image id=\"img_id3155434\" src=\"res/commandimagelist/sc_print.png\" width=\"0.1665in\" height=\"0.1665in\"\>\<alt id=\"alt_id3155434\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
