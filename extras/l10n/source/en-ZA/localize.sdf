helpcontent2	source\text\swriter\01\04090003.xhp	0	help	par_id3149558				0	en-ZA	\<ahelp hid=\"SW_PUSHBUTTON_TP_FLD_FUNC_PB_LISTREMOVE\"\>Removes the selected item from the list.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04090003.xhp	0	help	hd_id3145126				0	en-ZA	Move Up				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04090003.xhp	0	help	par_id3155970				0	en-ZA	\<ahelp hid=\"SW_PUSHBUTTON_TP_FLD_FUNC_PB_LISTUP\"\>Moves the selected item up in the list.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04090003.xhp	0	help	hd_id3150549				0	en-ZA	Move Down				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04090003.xhp	0	help	par_id3156221				0	en-ZA	\<ahelp hid=\"SW_PUSHBUTTON_TP_FLD_FUNC_PB_LISTDOWN\"\>Moves the selected item down in the list.\</ahelp\>				2002-02-02 02:02:02
