helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3148552				0	en-ZA	\<emph\>Text:\</emph\> Any string expression that you want to return the leftmost characters from.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3149456				0	en-ZA	\<emph\>n:\</emph\> Numeric expression that specifies the number of characters that you want to return. If \<emph\>n\</emph\> = 0, a zero-length string is returned. The maximum allowed value is 65535.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3150791				0	en-ZA	The following example converts a date in YYYY.MM.DD format to MM/DD/YYYY format.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	hd_id3125863				0	en-ZA	Example:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3144761				0	en-ZA	Sub ExampleUSDate				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3153194				0	en-ZA	Dim sInput As String				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3154217				0	en-ZA	Dim sUS_date As String				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3150448				0	en-ZA	sInput = InputBox("Please input a date in the international format 'YYYY-MM-DD'")				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3149203				0	en-ZA	sUS_date = Mid(sInput, 6, 2)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3150439				0	en-ZA	sUS_date = sUS_date & "/"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3153770				0	en-ZA	sUS_date = sUS_date & Right(sInput, 2)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3161833				0	en-ZA	sUS_date = sUS_date & "/"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3147215				0	en-ZA	sUS_date = sUS_date & Left(sInput, 4)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3149666				0	en-ZA	MsgBox sUS_date				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120303.xhp	0	help	par_id3153138				0	en-ZA	End Sub				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	tit				0	en-ZA	FileCopy Statement [Runtime]				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	bm_id3154840				0	en-ZA	\<bookmark_value\>FileCopy statement\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	hd_id3154840				0	en-ZA	\<link href=\"text/sbasic/shared/03020406.xhp\" name=\"FileCopy Statement [Runtime]\"\>FileCopy Statement [Runtime]\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	par_id3149497				0	en-ZA	Copies a file.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	hd_id3147443				0	en-ZA	Syntax:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	par_id3146957				0	en-ZA	FileCopy TextFrom As String, TextTo As String				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	hd_id3153825				0	en-ZA	Parameters:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	par_id3155390				0	en-ZA	\<emph\>TextFrom:\</emph\> Any string expression that specifies the name of the file that you want to copy. The expression can contain optional path and drive information. If you want, you can enter a path in \<link href=\"text/sbasic/shared/00000002.xhp\" name=\"URL notation\"\>URL notation\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	par_id3150669				0	en-ZA	\<emph\>TextTo:\</emph\> Any string expression that specifies where you want to copy the source file to. The expression can contain the destination drive, the path, and file name, or the path in URL notation.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	par_id3150791				0	en-ZA	You can only use the FileCopy statement to copy files that are not opened.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	hd_id3125863				0	en-ZA	Example:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	par_id3150869				0	en-ZA	Sub ExampleFilecopy				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	par_id3154685				0	en-ZA	Filecopy "c:\\autoexec.bat", "c:\\Temp\\Autoexec.sav"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03020406.xhp	0	help	par_id3154123				0	en-ZA	end sub				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	tit				0	en-ZA	MsgBox Statement [Runtime]				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	bm_id1807916				0	en-ZA	\<bookmark_value\>MsgBox statement\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	hd_id3154927				0	en-ZA	\<link href=\"text/sbasic/shared/03010101.xhp\"\>MsgBox Statement [Runtime]\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3148947				0	en-ZA	Displays a dialogue box containing a message.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	hd_id3153897				0	en-ZA	Syntax:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3148664				0	en-ZA	MsgBox Text As String [,Type As Integer [,Dialogtitle As String]] (As Statement) or MsgBox (Text As String [,Type As Integer [,Dialogtitle As String]]) (As Function)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	hd_id3153361				0	en-ZA	Parameter:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3148798	6			0	en-ZA	\<emph\>Text\</emph\>: String expression displayed as a message in the dialogue box. Line breaks can be inserted with Chr$(13).				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3150769	7			0	en-ZA	\<emph\>DialogTitle\</emph\>: String expression displayed in the title bar of the dialogue. If omitted, the title bar displays the name of the respective application.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3147228	8			0	en-ZA	\<emph\>Type\</emph\>: Any integer expression that specifies the dialogue type, as well as the number and type of buttons to display, and the icon type. \<emph\>Type\</emph\> represents a combination of bit patterns, that is, a combination of elements can be defined by adding their respective values:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3161832				0	en-ZA	0 : Display OK button only.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3153726				0	en-ZA	1 : Display OK and Cancel buttons.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3149665				0	en-ZA	2 : Display Abort, Retry, and Ignore buttons.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3147318				0	en-ZA	3 : Display Yes, No and Cancel buttons.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3155412				0	en-ZA	4 : Display Yes and No buttons.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3146119				0	en-ZA	5 : Display Retry and Cancel buttons.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3159155				0	en-ZA	16 : Add the Stop icon to the dialogue.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3145366				0	en-ZA	32 : Add the Question icon to the dialogue.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3147350				0	en-ZA	48 : Add the Exclamation icon to the dialogue.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3149960				0	en-ZA	64 : Add the Information icon to the dialogue.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3154944				0	en-ZA	128 : First button in the dialogue as default button.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3155417				0	en-ZA	256 : Second button in the dialogue as default button.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3153878				0	en-ZA	512 : Third button in the dialogue as default button.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	hd_id3150715				0	en-ZA	Example:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3154511				0	en-ZA	Sub ExampleMsgBox				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3150327				0	en-ZA	Const sText1 = "An unexpected error occurred."				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3146912				0	en-ZA	Const sText2 = "The program execution will continue, however."				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3154757				0	en-ZA	Const sText3 = "Error"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03010101.xhp	0	help	par_id3155445				0	en-ZA	MsgBox(sText1 + Chr(13) + sText2,16,sText3)				2002-02-02 02:02:02
