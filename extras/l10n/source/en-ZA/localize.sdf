helpcontent2	source\text\shared\optionen\01050100.xhp	0	help	bm_id3147226				0	en-ZA	\<bookmark_value\>grids; defaults (Writer/Calc)\</bookmark_value\>         \<bookmark_value\>defaults; grids (Writer/Calc)\</bookmark_value\>         \<bookmark_value\>snap grid defaults (Writer/Calc)\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01050100.xhp	0	help	hd_id3147226				0	en-ZA	\<link href=\"text/shared/optionen/01050100.xhp\" name=\"Grid\"\>Grid\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01050100.xhp	0	help	par_id3147088				0	en-ZA	\<ahelp hid=\"HID_OPTIONS_GRID\"\>Specifies the settings for the configurable grid on your document pages. This grid helps you determine the exact position of your objects. You can also set this grid in line with the "magnetic" snap grid.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01050100.xhp	0	help	hd_id3153749				0	en-ZA	Grid				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01050100.xhp	0	help	hd_id3145382				0	en-ZA	Snap to grid				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01050100.xhp	0	help	hd_id3153824				0	en-ZA	Visible grid				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01050100.xhp	0	help	par_id3149516				0	en-ZA	\<variable id=\"rastersicht\"\>\<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_GRID_CBX_GRID_VISIBLE\"\>Specifies whether to display the grid.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01050100.xhp	0	help	hd_id3154684				0	en-ZA	Resolution				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01050100.xhp	0	help	hd_id3149203				0	en-ZA	Horizontal				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01050100.xhp	0	help	par_id3153104				0	en-ZA	\<ahelp hid=\"SVX_METRICFIELD_RID_SVXPAGE_GRID_MTR_FLD_DRAW_X\"\>Defines the unit of measure for the spacing between grid points on the X-axis.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01050100.xhp	0	help	hd_id3150447				0	en-ZA	Vertical				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01050100.xhp	0	help	par_id3148923				0	en-ZA	\<ahelp hid=\"SVX:METRICFIELD:RID_SVXPAGE_GRID:MTR_FLD_DRAW_Y\"\>Defines the grid points spacing in the desired unit of measurement on the Y-axis.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01050100.xhp	0	help	hd_id3147228				0	en-ZA	Subdivision				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01050100.xhp	0	help	hd_id3153368				0	en-ZA	Horizontal				2002-02-02 02:02:02
