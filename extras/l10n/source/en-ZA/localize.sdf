helpcontent2	source\text\swriter\01\06090000.xhp	0	help	hd_id5971251				0	en-ZA	The first ... rows				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06090000.xhp	0	help	par_id4136478				0	en-ZA	\<ahelp hid=\".\"\>Repeats the first n rows as a header.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06090000.xhp	0	help	hd_id3151315				0	en-ZA	Don't split table				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\06090000.xhp	0	help	par_id3147530				0	en-ZA	\<ahelp hid=\"SW:CHECKBOX:DLG_CONV_TEXT_TABLE:CB_DONT_SPLIT\"\>Does not divide the table across pages.\</ahelp\>				2002-02-02 02:02:02
