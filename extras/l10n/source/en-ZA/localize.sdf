helpcontent2	source\text\sbasic\shared\03090404.xhp	0	help	par_id3153363				0	en-ZA	Dim iVar As Integer				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090404.xhp	0	help	par_id3153727				0	en-ZA	iVar = Int((15 * Rnd) -2)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090404.xhp	0	help	par_id3150011				0	en-ZA	Select Case iVar				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090404.xhp	0	help	par_id3149481				0	en-ZA	Case 1 To 5				2002-02-02 02:02:02
