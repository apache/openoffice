helpcontent2	source\text\shared\02\14020000.xhp	0	help	par_id3155934				0	en-ZA	\<ahelp hid=\".uno:DBClearQuery\" visibility=\"visible\"\>Clears the query and removes all tables from the design window.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\14020000.xhp	0	help	par_id3154422				0	en-ZA	\<image src=\"res/commandimagelist/sc_dbclearquery.png\" id=\"img_id3149205\"\>\<alt id=\"alt_id3149205\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
