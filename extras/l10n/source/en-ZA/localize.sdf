helpcontent2	source\text\shared\fontwork_toolbar.xhp	0	help	par_idN105C5				0	en-ZA	\<ahelp hid=\".\"\>Opens the Fontwork Alignment window.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\fontwork_toolbar.xhp	0	help	par_idN105DC				0	en-ZA	\<ahelp hid=\".\"\>Click to apply the alignment to the selected Fontwork objects.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\fontwork_toolbar.xhp	0	help	par_idN105F3				0	en-ZA	Fontwork Character Spacing				2002-02-02 02:02:02
helpcontent2	source\text\shared\fontwork_toolbar.xhp	0	help	par_idN105F7				0	en-ZA	\<ahelp hid=\".\"\>Opens the Fontwork Character Spacing window.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\fontwork_toolbar.xhp	0	help	par_idN1060E				0	en-ZA	\<ahelp hid=\".\"\>Click to apply the character spacing to the selected Fontwork objects.\</ahelp\>				2002-02-02 02:02:02
