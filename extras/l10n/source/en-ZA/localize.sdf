helpcontent2	source\text\sbasic\shared\03104600.xhp	0	help	par_id3150669				0	en-ZA	EqualUnoObjects( oObj1, oObj2 )				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03104600.xhp	0	help	hd_id3150984				0	en-ZA	Return value:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03104600.xhp	0	help	par_id3154285				0	en-ZA	Bool				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03104600.xhp	0	help	hd_id3145315				0	en-ZA	Example:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03104600.xhp	0	help	par_id3156024				0	en-ZA	// Copy of objects -> same instance				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03104600.xhp	0	help	par_id3154923				0	en-ZA	oIntrospection = CreateUnoService( "com.sun.star.beans.Introspection" )				2002-02-02 02:02:02
