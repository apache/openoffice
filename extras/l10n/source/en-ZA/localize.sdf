helpcontent2	source\text\shared\01\02100100.xhp	0	help	hd_id3149511				0	en-ZA	Settings				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100100.xhp	0	help	par_id3152594				0	en-ZA	Define the criteria for determining if a word is similar to the search term.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100100.xhp	0	help	hd_id3153551				0	en-ZA	Exchange characters				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100100.xhp	0	help	par_id3152551				0	en-ZA	\<ahelp hid=\"SVX_NUMERICFIELD_RID_SVXDLG_SEARCHSIMILARITY_NF_OTHER\"\>Enter the number of characters in the search term that can be exchanged.\</ahelp\> For example, if you specify 2 exchanged characters, "black" and "crack" are considered similar.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100100.xhp	0	help	hd_id3147010				0	en-ZA	Add characters				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100100.xhp	0	help	par_id3109847				0	en-ZA	\<ahelp hid=\"SVX_NUMERICFIELD_RID_SVXDLG_SEARCHSIMILARITY_NF_LONGER\"\>Enter the maximum number of characters by which a word can exceed the number of characters in the search term.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100100.xhp	0	help	hd_id3166460				0	en-ZA	Remove characters				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100100.xhp	0	help	par_id3148685				0	en-ZA	\<ahelp hid=\"SVX_NUMERICFIELD_RID_SVXDLG_SEARCHSIMILARITY_NF_SHORTER\"\>Enter the number of characters by which a word can be shorter than the search term.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100100.xhp	0	help	hd_id3153700				0	en-ZA	Combine				2002-02-02 02:02:02
