helpcontent2	source\text\scalc\01\04060182.xhp	0	help	tit				0	en-ZA	Statistical Functions Part Two				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3154372				0	en-ZA	\<variable id=\"fh\"\>\<link href=\"text/scalc/01/04060182.xhp\" name=\"Statistical Functions Part Two\"\>Statistical Functions Part Two\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3145388				0	en-ZA	\<bookmark_value\>FINV function\</bookmark_value\>         \<bookmark_value\>inverse F probability distribution\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3145388				0	en-ZA	FINV				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155089				0	en-ZA	\<ahelp hid=\"HID_FUNC_FINV\"\>Returns the inverse of the F probability distribution.\</ahelp\> The F distribution is used for F tests in order to set the relation between two differing data sets.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3153816				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153068				0	en-ZA	FINV(Number; DegreesFreedom1; DegreesFreedom2)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146866	6			0	en-ZA	            \<emph\>Number\</emph\> is probability value for which the inverse F distribution is to be calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153914	7			0	en-ZA	            \<emph\>DegreesFreedom1\</emph\> is the number of degrees of freedom in the numerator of the F distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3148607	8			0	en-ZA	            \<emph\>DegreesFreedom2\</emph\> is the number of degrees of freedom in the denominator of the F distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3156021				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145073	10			0	en-ZA	            \<item type=\"input\"\>=FINV(0.5;5;10)\</item\> yields 0.93.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3150888				0	en-ZA	\<bookmark_value\>FISHER function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150888				0	en-ZA	FISHER				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155384				0	en-ZA	\<ahelp hid=\"HID_FUNC_FISHER\"\>Returns the Fisher transformation for x and creates a function close to a normal distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3149898				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3143220				0	en-ZA	FISHER(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3159228	16			0	en-ZA	            \<emph\>Number\</emph\> is the value to be transformed.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3154763				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3149383	18			0	en-ZA	            \<item type=\"input\"\>=FISHER(0.5)\</item\> yields 0.55.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3155758				0	en-ZA	\<bookmark_value\>FISHERINV function\</bookmark_value\>         \<bookmark_value\>inverse of Fisher transformation\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3155758				0	en-ZA	FISHERINV				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154734				0	en-ZA	\<ahelp hid=\"HID_FUNC_FISHERINV\"\>Returns the inverse of the Fisher transformation for x and creates a function close to a normal distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3155755				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146108				0	en-ZA	FISHERINV(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145115	24			0	en-ZA	            \<emph\>Number\</emph\> is the value that is to undergo reverse-transformation.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3155744				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150432	26			0	en-ZA	            \<item type=\"input\"\>=FISHERINV(0.5)\</item\> yields 0.46.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3151390				0	en-ZA	\<bookmark_value\>FTEST function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3151390				0	en-ZA	FTEST				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150534				0	en-ZA	\<ahelp hid=\"HID_FUNC_FTEST\"\>Returns the result of an F test.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3166466				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153024				0	en-ZA	FTEST(Data1; Data2)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150032	32			0	en-ZA	            \<emph\>Data1\</emph\> is the first record array.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153018	33			0	en-ZA	            \<emph\>Data2\</emph\> is the second record array.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3153123				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3159126	35			0	en-ZA	            \<item type=\"input\"\>=FTEST(A1:A30;B1:B12)\</item\> calculates whether the two data sets are different in their variance and returns the probability that both sets could have come from the same total population.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3150372				0	en-ZA	\<bookmark_value\>FDIST function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150372				0	en-ZA	FDIST				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3152981				0	en-ZA	\<ahelp hid=\"HID_FUNC_FVERT\"\>Calculates the values of an F distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150484				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145826				0	en-ZA	FDIST(Number; DegreesFreedom1; DegreesFreedom2)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150461	41			0	en-ZA	            \<emph\>Number\</emph\> is the value for which the F distribution is to be calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150029	42			0	en-ZA	            \<emph\>degreesFreedom1\</emph\> is the degrees of freedom in the numerator in the F distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146877	43			0	en-ZA	            \<emph\>degreesFreedom2\</emph\> is the degrees of freedom in the denominator in the F distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3147423				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150696	45			0	en-ZA	            \<item type=\"input\"\>=FDIST(0.8;8;12)\</item\> yields 0.61.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id0119200903223192				0	en-ZA	\<bookmark_value\>GAMMA function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id0119200903205393				0	en-ZA	GAMMA				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id0119200903205379				0	en-ZA	\<ahelp hid=\".\"\>Returns the Gamma function value.\</ahelp\> Note that GAMMAINV is not the inverse of GAMMA, but of GAMMADIST.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id0119200903271613				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id0119200903271614				0	en-ZA	            \<emph\>Number\</emph\> is the number for which the Gamma function value is to be calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3154841				0	en-ZA	\<bookmark_value\>GAMMAINV function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3154841				0	en-ZA	GAMMAINV				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153932				0	en-ZA	\<ahelp hid=\"HID_FUNC_GAMMAINV\"\>Returns the inverse of the Gamma cumulative distribution GAMMADIST.\</ahelp\> This function allows you to search for variables with different distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3149949				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155828				0	en-ZA	GAMMAINV(Number; Alpha; Beta)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145138	51			0	en-ZA	            \<emph\>Number\</emph\> is the probability value for which the inverse Gamma distribution is to be calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3152785	52			0	en-ZA	            \<emph\>Alpha\</emph\> is the parameter Alpha of the Gamma distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154561	53			0	en-ZA	            \<emph\>Beta\</emph\> is the parameter Beta of the Gamma distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3148734				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153331	55			0	en-ZA	            \<item type=\"input\"\>=GAMMAINV(0.8;1;1)\</item\> yields 1.61.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3154806				0	en-ZA	\<bookmark_value\>GAMMALN function\</bookmark_value\>         \<bookmark_value\>natural logarithm of Gamma function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3154806				0	en-ZA	GAMMALN				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3148572				0	en-ZA	\<ahelp hid=\"HID_FUNC_GAMMALN\"\>Returns the natural logarithm of the Gamma function: G(x).\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3152999				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153112				0	en-ZA	GAMMALN(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154502	61			0	en-ZA	            \<emph\>Number\</emph\> is the value for which the natural logarithm of the Gamma function is to be calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3153568				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153730	63			0	en-ZA	            \<item type=\"input\"\>=GAMMALN(2)\</item\> yields 0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3150132				0	en-ZA	\<bookmark_value\>GAMMADIST function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150132				0	en-ZA	GAMMADIST				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155931				0	en-ZA	\<ahelp hid=\"HID_FUNC_GAMMAVERT\"\>Returns the values of a Gamma distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id0119200903333675				0	en-ZA	The inverse function is GAMMAINV.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3147373				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155436				0	en-ZA	GAMMADIST(Number; Alpha; Beta; C)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150571	69			0	en-ZA	            \<emph\>Number\</emph\> is the value for which the Gamma distribution is to be calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145295	70			0	en-ZA	            \<emph\>Alpha\</emph\> is the parameter Alpha of the Gamma distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3151015	71			0	en-ZA	            \<emph\>Beta\</emph\> is the parameter Beta of the Gamma distribution				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3157972	72			0	en-ZA	            \<emph\>C\</emph\> (optional) = 0 or False calculates the density function \<emph\>C\</emph\> = 1 or True calculates the distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3149535				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3145354	74			0	en-ZA	            \<item type=\"input\"\>=GAMMADIST(2;1;1;1)\</item\> yields 0.86.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3150272				0	en-ZA	\<bookmark_value\>GAUSS function\</bookmark_value\>         \<bookmark_value\>normal distribution; standard\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150272				0	en-ZA	GAUSS				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3149030				0	en-ZA	\<ahelp hid=\"HID_FUNC_GAUSS\"\>Returns the standard normal cumulative distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id2059694				0	en-ZA	It is GAUSS(x)=NORMSDIST(x)-0.5				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3153551				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155368				0	en-ZA	GAUSS(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153228	80			0	en-ZA	            \<emph\>Number\</emph\> is the value for which the value of the standard normal distribution is to be calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150691				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154867	82			0	en-ZA	            \<item type=\"input\"\>=GAUSS(0.19)\</item\> = 0.08				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3148594	83			0	en-ZA	            \<item type=\"input\"\>=GAUSS(0.0375)\</item\> = 0.01				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3148425				0	en-ZA	\<bookmark_value\>GEOMEAN function\</bookmark_value\>         \<bookmark_value\>means;geometric\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3148425				0	en-ZA	GEOMEAN				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3156257				0	en-ZA	\<ahelp hid=\"HID_FUNC_GEOMITTEL\"\>Returns the geometric mean of a sample.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3147167				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153720				0	en-ZA	GEOMEAN(Number1; Number2; ...Number30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3152585	89			0	en-ZA	            \<emph\>Number1, Number2,...Number30\</emph\> are numeric arguments or ranges that represent a random sample.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3146146				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3149819	92			0	en-ZA	            \<item type=\"input\"\>=GEOMEAN(23;46;69)\</item\> = 41.79. The geometric mean value of this random sample is therefore 41.79.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3152966				0	en-ZA	\<bookmark_value\>TRIMMEAN function\</bookmark_value\>         \<bookmark_value\>means;of data set without margin data\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3152966				0	en-ZA	TRIMMEAN				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3149716				0	en-ZA	\<ahelp hid=\"HID_FUNC_GESTUTZTMITTEL\"\>Returns the mean of a data set without the Alpha percent of data at the margins.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3149281				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154821				0	en-ZA	TRIMMEAN(Data; Alpha)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155834	98			0	en-ZA	            \<emph\>Data\</emph\> is the array of data in the sample.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3156304	99			0	en-ZA	            \<emph\>Alpha\</emph\> is the percentage of the marginal data that will not be taken into consideration.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3151180				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3156130	101			0	en-ZA	            \<item type=\"input\"\>=TRIMMEAN(A1:A50; 0.1)\</item\> calculates the mean value of numbers in A1:A50, without taking into consideration the 5 percent of the values representing the highest values and the 5 percent of the values representing the lowest ones. The percentage numbers refer to the amount of the untrimmed mean value, not to the number of summands.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3153216				0	en-ZA	\<bookmark_value\>ZTEST function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3153216				0	en-ZA	ZTEST				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3150758				0	en-ZA	\<ahelp hid=\"HID_FUNC_GTEST\"\>Calculates the probability of observing a z-statistic greater than the one computed based on a sample.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150872				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153274				0	en-ZA	ZTEST(Data; mu; Sigma)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3156109	107			0	en-ZA	            \<emph\>Data\</emph\> is the given sample, drawn from a normally distributed population.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3149977	108			0	en-ZA	            \<emph\>mu\</emph\> is the known mean of the population.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154740	109			0	en-ZA	            \<emph\>Sigma\</emph\> (optional) is the known standard deviation of the population. If omitted, the standard deviation of the given sample is used.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id0305200911372999				0	en-ZA	See also the \<link href=\"http://wiki.services.openoffice.org/wiki/Documentation/How_Tos/Calc:_ZTEST_function\"\>Wiki page\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3153623				0	en-ZA	\<bookmark_value\>HARMEAN function\</bookmark_value\>         \<bookmark_value\>means;harmonic\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3153623				0	en-ZA	HARMEAN				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155102				0	en-ZA	\<ahelp hid=\"HID_FUNC_HARMITTEL\"\>Returns the harmonic mean of a data set.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3146900				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3149287				0	en-ZA	HARMEAN(Number1; Number2; ...Number30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154303	117			0	en-ZA	            \<emph\>Number1,Number2,...Number30\</emph\> are up to 30 values or ranges, that can be used to calculate the harmonic mean.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3159179				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146093	120			0	en-ZA	            \<item type=\"input\"\>=HARMEAN(23;46;69)\</item\> = 37.64. The harmonic mean of this random sample is thus 37.64				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	bm_id3152801				0	en-ZA	\<bookmark_value\>HYPGEOMDIST function\</bookmark_value\>         \<bookmark_value\>sampling without replacement\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3152801				0	en-ZA	HYPGEOMDIST				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3159341				0	en-ZA	\<ahelp hid=\"HID_FUNC_HYPGEOMVERT\"\>Returns the hypergeometric distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3154697				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3155388				0	en-ZA	HYPGEOMDIST(X; NSample; Successes; NPopulation)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154933	126			0	en-ZA	            \<emph\>X\</emph\> is the number of results achieved in the random sample.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3153106	127			0	en-ZA	            \<emph\>NSample\</emph\> is the size of the random sample.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3146992	128			0	en-ZA	            \<emph\>Successes\</emph\> is the number of possible results in the total population.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3148826	129			0	en-ZA	            \<emph\>NPopulation \</emph\>is the size of the total population.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	hd_id3150529				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060182.xhp	0	help	par_id3154904	131			0	en-ZA	            \<item type=\"input\"\>=HYPGEOMDIST(2;2;90;100)\</item\> yields 0.81. If 90 out of 100 pieces of buttered toast fall from the table and hit the floor with the buttered side first, then if 2 pieces of buttered toast are dropped from the table, the probability is 81%, that both will strike buttered side first.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\07090000.xhp	0	help	tit				0	en-ZA	Freeze				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\07090000.xhp	0	help	hd_id3150517				0	en-ZA	\<link href=\"text/scalc/01/07090000.xhp\" name=\"Freeze\"\>Freeze\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\07090000.xhp	0	help	par_id3156289				0	en-ZA	\<ahelp hid=\".uno:FreezePanes\" visibility=\"visible\"\>Divides the sheet at the top left corner of the active cell and the area to the top left is no longer scrollable.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	tit				0	en-ZA	YEARFRAC				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	bm_id3148735				0	en-ZA	\<bookmark_value\>YEARFRAC function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	hd_id3148735				0	en-ZA	\<variable id=\"yearfrac\"\>\<link href=\"text/scalc/01/func_yearfrac.xhp\"\>YEARFRAC\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3150899				0	en-ZA	\<ahelp hid=\"HID_AAI_FUNC_YEARFRAC\"\> The result is a number between 0 and 1, representing the fraction of a year between \<emph\>StartDate\</emph\> and \<emph\>EndDate\</emph\>.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	hd_id3155259				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3155823				0	en-ZA	YEARFRAC(StartDate; EndDate; Basis)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3145144				0	en-ZA	\<emph\>StartDate\</emph\> and \<emph\>EndDate\</emph\> are two date values.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3149954				0	en-ZA	\<emph\>Basis\</emph\> is chosen from a list of options and indicates how the year is to be calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_yearfrac.xhp	0	help	par_id3146847				0	en-ZA	Basis				2002-02-02 02:02:02
