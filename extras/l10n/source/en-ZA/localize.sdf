helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148539				0	en-ZA	UPPER("Text")				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148496	66			0	en-ZA	            \<emph\>Text\</emph\> refers to the lower case letters you want to convert to upper case.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148516				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146757	68			0	en-ZA	            \<item type=\"input\"\>=UPPER("Good Morning")\</item\> returns GOOD MORNING.				2002-02-02 02:02:02
