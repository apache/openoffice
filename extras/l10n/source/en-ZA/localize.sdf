helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3149002				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3151020				0	en-ZA	\<item type=\"input\"\>=DELTA(1;2)\</item\> returns 0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	bm_id3157971				0	en-ZA	\<bookmark_value\>DEC2BIN function\</bookmark_value\>\<bookmark_value\>converting;decimal numbers, into binary numbers\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3157971				0	en-ZA	DEC2BIN				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3153043				0	en-ZA	\<ahelp hid=\"HID_AAI_FUNC_DEC2BIN\"\> The result is the binary number for the decimal number entered between -512 and 511.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3145349				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3150569				0	en-ZA	DEC2BIN(Number; Places)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3148768				0	en-ZA	\<emph\>Number\</emph\> is a decimal number. If Number is negative, the function returns a binary number with 10 characters. The most significant bit is the sign bit, the other 9 bits return the value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3149537				0	en-ZA	\<emph\>Places\</emph\> means the number of places to be output.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3150265				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3150662				0	en-ZA	\<item type=\"input\"\>=DEC2BIN(100;8)\</item\> returns 01100100.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	bm_id3149388				0	en-ZA	\<bookmark_value\>DEC2HEX function\</bookmark_value\>\<bookmark_value\>converting;decimal numbers, into hexadecimal numbers\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3149388				0	en-ZA	DEC2HEX				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3149030				0	en-ZA	\<ahelp hid=\"HID_AAI_FUNC_DEC2HEX\"\>The result is the hexadecimal number for the decimal number entered.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3150691				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3147535				0	en-ZA	DEC2HEX(Number; Places)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3152820				0	en-ZA	\<emph\>Number\</emph\> is a decimal number. If Number is negative, the function returns a hexadecimal number with 10 characters (40 bits). The most significant bit is the sign bit, the other 39 bits return the value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3153221				0	en-ZA	\<emph\>Places\</emph\> means the number of places to be output.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3154869				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3150476				0	en-ZA	\<item type=\"input\"\>=DEC2HEX(100;4)\</item\> returns 0064.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	bm_id3154948				0	en-ZA	\<bookmark_value\>DEC2OCT function\</bookmark_value\>\<bookmark_value\>converting;decimal numbers, into octal numbers\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3154948				0	en-ZA	DEC2OCT				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3153920				0	en-ZA	\<ahelp hid=\"HID_AAI_FUNC_DEC2OCT\"\>The result is the octal number for the decimal number entered.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3153178				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3148427				0	en-ZA	DEC2OCT(Number; Places)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3155991				0	en-ZA	\<emph\>Number\</emph\> is a decimal number. If Number is negative, the function returns an octal number with 10 characters (30 bits). The most significant bit is the sign bit, the other 29 bits return the value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3152587				0	en-ZA	\<emph\>Places\</emph\> means the number of places to be output.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3147482				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3154317				0	en-ZA	\<item type=\"input\"\>=DEC2OCT(100;4)\</item\> returns 0144.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	bm_id3083446				0	en-ZA	\<bookmark_value\>ERF function\</bookmark_value\>\<bookmark_value\>Gaussian error integral\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3083446				0	en-ZA	ERF				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3150381				0	en-ZA	\<ahelp hid=\"HID_AAI_FUNC_ERF\"\>Returns values of the Gaussian error integral.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3152475				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3163824				0	en-ZA	ERF(LowerLimit; UpperLimit)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3149715				0	en-ZA	\<emph\>LowerLimit\</emph\> is the lower limit of the integral.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3156294				0	en-ZA	\<emph\>UpperLimit\</emph\> is optional. It is the upper limit of the integral. If this value is missing, the calculation takes places between 0 and the lower limit.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3154819				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3152974				0	en-ZA	\<item type=\"input\"\>=ERF(0;1)\</item\> returns 0.842701.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	bm_id3145082				0	en-ZA	\<bookmark_value\>ERFC function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3145082				0	en-ZA	ERFC				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3149453				0	en-ZA	\<ahelp hid=\"HID_AAI_FUNC_ERFC\"\>Returns complementary values of the Gaussian error integral between x and infinity.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3155839				0	en-ZA	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3153220				0	en-ZA	ERFC(LowerLimit)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3147620				0	en-ZA	\<emph\>LowerLimit\</emph\> is the lower limit of the integral				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	hd_id3146861				0	en-ZA	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	par_id3156102				0	en-ZA	\<item type=\"input\"\>=ERFC(1)\</item\> returns 0.157299.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060115.xhp	0	help	bm_id3152927				0	en-ZA	\<bookmark_value\>GESTEP function\</bookmark_value\>\<bookmark_value\>numbers;greater than or equal to\</bookmark_value\>				2002-02-02 02:02:02
