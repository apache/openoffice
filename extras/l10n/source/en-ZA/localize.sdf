helpcontent2	source\text\sbasic\shared\03120311.xhp	0	help	par_id3153525				0	en-ZA	Dim sText2 as String,sText as String,sOut as String				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120311.xhp	0	help	par_id3154908				0	en-ZA	sText2 = " <*Las Vegas*> "				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120311.xhp	0	help	par_id3144760				0	en-ZA	sOut = "'"+sText2 +"'"+ Chr(13)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120311.xhp	0	help	par_id3151383				0	en-ZA	sText = Ltrim(sText2) REM sText = "<*Las Vegas*> "				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120311.xhp	0	help	par_id3151044				0	en-ZA	sOut = sOut + "'"+sText +"'" + Chr(13)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120311.xhp	0	help	par_id3159149				0	en-ZA	sText = Rtrim(sText2) REM sText = " <*Las Vegas*>"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120311.xhp	0	help	par_id3150449				0	en-ZA	sOut = sOut +"'"+ sText +"'" + Chr(13)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120311.xhp	0	help	par_id3149562				0	en-ZA	sText = Trim(sText2) REM sText = "<*Las Vegas*>"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120311.xhp	0	help	par_id3161831				0	en-ZA	sOut = sOut +"'"+ sText +"'"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120311.xhp	0	help	par_id3146120				0	en-ZA	MsgBox sOut				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120311.xhp	0	help	par_id3145364				0	en-ZA	end sub				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	tit				0	en-ZA	While...Wend Statement[Runtime]				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	bm_id3150400				0	en-ZA	\<bookmark_value\>While;While...Wend loop\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	hd_id3150400				0	en-ZA	\<link href=\"text/sbasic/shared/03090203.xhp\" name=\"While...Wend Statement[Runtime]\"\>While...Wend Statement[Runtime]\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3151211	2			0	en-ZA	When a program encounters a While statement, it tests the condition. If the condition is False, the program continues directly following the Wend statement. If the condition is True, the loop is executed until the program finds Wend and then jumps back to the\<emph\> While \</emph\>statement. If the condition is still True, the loop is executed again.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3151041				0	en-ZA	Unlike the \<link href=\"text/sbasic/shared/03090201.xhp\" name=\"Do...Loop\"\>Do...Loop\</link\> statement, you cannot cancel a \<emph\>While...Wend\</emph\> loop with \<link href=\"text/sbasic/shared/03090412.xhp\" name=\"Exit\"\>Exit\</link\>. Never exit a While...Wend loop with \<link href=\"text/sbasic/shared/03090302.xhp\" name=\"GoTo\"\>GoTo\</link\>, since this can cause a run-time error.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3145172				0	en-ZA	A Do...Loop is more flexible than a While...Wend.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	hd_id3155133				0	en-ZA	Syntax:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3147288				0	en-ZA	While Condition [Statement] Wend				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	hd_id3153139				0	en-ZA	Example:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3159153				0	en-ZA	Sub ExampleWhileWend				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3151114				0	en-ZA	Dim stext As String				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3153143				0	en-ZA	Dim iRun As Integer				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3155306				0	en-ZA	sText ="This is a short text"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3154011				0	en-ZA	iRun = 1				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3147215				0	en-ZA	while iRun < Len(sText)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3147427				0	en-ZA	if Mid(sText,iRun,1 )<> " " then Mid( sText ,iRun, 1, Chr( 1 + Asc( Mid(sText,iRun,1 )) )				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3149665				0	en-ZA	iRun = iRun + 1				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3152939				0	en-ZA	Wend				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3153189				0	en-ZA	MsgBox sText,0,"Text encoded"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090203.xhp	0	help	par_id3145251				0	en-ZA	end sub				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	tit				0	en-ZA	Using Procedures and Functions				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	bm_id3149456				0	en-ZA	\<bookmark_value\>procedures\</bookmark_value\>\<bookmark_value\>functions;using\</bookmark_value\>\<bookmark_value\>variables;passing to procedures and functions\</bookmark_value\>\<bookmark_value\>parameters;for procedures and functions\</bookmark_value\>\<bookmark_value\>parameters;passing by reference or value\</bookmark_value\>\<bookmark_value\>variables;scope\</bookmark_value\>\<bookmark_value\>scope of variables\</bookmark_value\>\<bookmark_value\>GLOBAL variables\</bookmark_value\>\<bookmark_value\>PUBLIC variables\</bookmark_value\>\<bookmark_value\>PRIVATE variables\</bookmark_value\>\<bookmark_value\>functions;return value type\</bookmark_value\>\<bookmark_value\>return value type of functions\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	hd_id3149456				0	en-ZA	\<link href=\"text/sbasic/shared/01020300.xhp\"\>Using Procedures and Functions\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3150767				0	en-ZA	The following describes the basic use of procedures and functions in $[officename] Basic.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3151215				0	en-ZA	When you create a new module, $[officename] Basic automatically inserts a SUB called "Main". This default name has nothing to do with the order or the starting point of a $[officename] Basic project. You can also safely rename this SUB.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3154124				0	en-ZA	Procedures (SUBS) and functions (FUNCTIONS) help you maintaining a structured overview by separating a program into logical pieces.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3153193				0	en-ZA	One benefit of procedures and functions is that, once you have developed a program code containing task components, you can use this code in another project.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	hd_id3153770				0	en-ZA	Passing Variables to Procedures (SUB) and Functions (FUNCTION)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3155414				0	en-ZA	Variables can be passed to both procedures and functions. The SUB or FUNCTION must be declared to expect parameters:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3163710				0	en-ZA	SUB SubName(\<emph\>Parameter1 As Type, Parameter2 As Type,...\</emph\>)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3151114				0	en-ZA	Program code				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3146975				0	en-ZA	END SUB				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3152577				0	en-ZA	The SUB is called using the following syntax:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3159154				0	en-ZA	SubName(Value1, Value2,...)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3147124				0	en-ZA	The parameters passed to a SUB must fit to those specified in the SUB declaration.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3147397				0	en-ZA	The same process applies to FUNCTIONS. In addition, functions always return a function result. The result of a function is defined by assigning the return value to the function name:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3149412				0	en-ZA	FUNCTION FunctionName(Parameter1 As Type, Parameter2 As Type,...) As Type				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3156284				0	en-ZA	Program code				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3145799				0	en-ZA	\<emph\>FunctionName=Result\</emph\>				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3150716				0	en-ZA	End Function				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3153839				0	en-ZA	The FUNCTION is called using the following syntax:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3146914				0	en-ZA	Variable=FunctionName(Parameter1, Parameter2,...)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_idN107B3				0	en-ZA	You can also use the fully qualified name to call a procedure or function:\<br/\>\<item type=\"literal\"\>Library.Module.Macro()\</item\>\<br/\> For example, to call the Autotext macro from the Gimmicks library, use the following command:\<br/\>\<item type=\"literal\"\>Gimmicks.AutoText.Main()\</item\>				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	hd_id3156276				0	en-ZA	Passing Variables by Value or Reference				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3155765				0	en-ZA	Parameters can be passed to a SUB or a FUNCTION either by reference or by value. Unless otherwise specified, a parameter is always passed by reference. That means that a SUB or a FUNCTION gets the parameter and can read and modify its value.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3145640				0	en-ZA	If you want to pass a parameter by value insert the key word "ByVal" in front of the parameter when you call a SUB or FUNCTION, for example:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3150042				0	en-ZA	Result = Function(\<emph\>ByVal\</emph\> Parameter)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3149258				0	en-ZA	In this case, the original content of the parameter will not be modified by the FUNCTION since it only gets the value and not the parameter itself.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	hd_id3150982				0	en-ZA	Scope of Variables				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3149814				0	en-ZA	A variable defined within a SUB or FUNCTION, only remains valid until the procedure is exited. This is known as a "local" variable. In many cases, you need a variable to be valid in all procedures, in every module of all libraries, or after a SUB or FUNCTION is exited.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	hd_id3154186				0	en-ZA	Declaring Variables Outside a SUB or FUNCTION				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3150208				0	en-ZA	GLOBAL VarName As TYPENAME				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3145258				0	en-ZA	The variable is valid as long as the $[officename] session lasts.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3153198				0	en-ZA	PUBLIC VarName As TYPENAME				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3150088				0	en-ZA	The variable is valid in all modules.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3158212				0	en-ZA	PRIVATE VarName As TYPENAME				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3152994				0	en-ZA	The variable is only valid in this module.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3150886				0	en-ZA	DIM VarName As TYPENAME				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3150368				0	en-ZA	The variable is only valid in this module.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	hd_id5097506				0	en-ZA	Example for private variables				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id8738975				0	en-ZA	Enforce private variables to be private across modules by setting CompatibilityMode(true).				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id146488				0	en-ZA	REM ***** Module1 *****				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id2042298				0	en-ZA	Private myText As String				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id2969756				0	en-ZA	Sub initMyText				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id9475997				0	en-ZA	myText = "Hello"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id6933500				0	en-ZA	print "in module1 : ", myText				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id631733				0	en-ZA	End Sub				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id8234199				0	en-ZA	REM ***** Module2 *****				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id6969512				0	en-ZA	'Option Explicit				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id1196935				0	en-ZA	Sub demoBug				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id1423993				0	en-ZA	CompatibilityMode( true )				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id6308786				0	en-ZA	initMyText				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id4104129				0	en-ZA	' Now returns empty string				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id7906125				0	en-ZA	' (or rises error for Option Explicit)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id8055970				0	en-ZA	print "Now in module2 : ", myText				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id2806176				0	en-ZA	End Sub				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	hd_id3154368				0	en-ZA	Saving Variable Content after Exiting a SUB or FUNCTION				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3156288				0	en-ZA	STATIC VarName As TYPENAME				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\01020300.xhp	0	help	par_id3154486				0	en-ZA	The variable retains its value until the next time the FUNCTION or SUB is entered. The declaration must exist inside a SUB or a FUNCTION.				2002-02-02 02:02:02
