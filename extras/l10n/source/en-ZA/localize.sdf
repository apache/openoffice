helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3154965	48			0	en-ZA	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Register-true \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3146316	50			0	en-ZA	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Activate \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3156315	51			0	en-ZA	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<ahelp hid=\"SVX:CHECKBOX:RID_SVXPAGE_STD_PARAGRAPH:CB_REGISTER\"\>Aligns the baseline of each line of text to a vertical document grid, so that each line is the same height. To use this feature, you must first activate the \<emph\>Register-true \</emph\>option for the current page style. To do this, choose \<emph\>Format - Page\</emph\>, click on the \<emph\>Page \</emph\>tab, and then select the\<emph\> Register-true\</emph\> box in the\<emph\> Layout settings\</emph\> area.\</ahelp\>\</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id9267250				0	en-ZA	\<link href=\"text/swriter/guide/registertrue.xhp\" name=\"Writing Register-true\"\>Writing Register-true\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05080400.xhp	0	help	tit				0	en-ZA	Justify				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05080400.xhp	0	help	hd_id3152937				0	en-ZA	\<link href=\"text/shared/01/05080400.xhp\" name=\"Justify\"\>Justify\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05080400.xhp	0	help	par_id3146856				0	en-ZA	\<variable id=\"blocktext\"\>\<ahelp hid=\".uno:JustifyPara\"\>Aligns the selected paragraph(s) to the left and the right page margins. If you want, you can also specify the alignment options for the last line of a paragraph by choosing \<emph\>Format - Paragraph - Alignment\</emph\>.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05070100.xhp	0	help	tit				0	en-ZA	Align Left				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05070100.xhp	0	help	hd_id3147069				0	en-ZA	\<link href=\"text/shared/01/05070100.xhp\" name=\"Align Left\"\>Align Left\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05070100.xhp	0	help	par_id3160463				0	en-ZA	\<ahelp hid=\".uno:AlignLeft\"\>Aligns the left edges of the selected objects. If only one object is selected in Draw or Impress, the left edge of the object is aligned to the left page margin.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05070100.xhp	0	help	par_id3150146				0	en-ZA	Objects are aligned to the left edge of the leftmost object in the selection.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05070100.xhp	0	help	par_id3150445	3			0	en-ZA	\<variable id=\"mehrfachselektion\"\>To align the individual objects in a group, \<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>choose \<emph\>Format - Group - Edit Group\</emph\>\</caseinline\>\<defaultinline\>double-click\</defaultinline\>\</switchinline\> to enter the group, select the objects, right-click, and then choose an alignment option. \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	tit				0	en-ZA	Font Effects				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	bm_id3153514				0	en-ZA	\<bookmark_value\>fonts;effects\</bookmark_value\>         \<bookmark_value\>formatting; font effects\</bookmark_value\>         \<bookmark_value\>characters; font effects\</bookmark_value\>         \<bookmark_value\>text; font effects\</bookmark_value\>         \<bookmark_value\>effects; fonts\</bookmark_value\>         \<bookmark_value\>underlining; text\</bookmark_value\>         \<bookmark_value\>capital letters; font effects\</bookmark_value\>         \<bookmark_value\>lowercase letters; font effects\</bookmark_value\>         \<bookmark_value\>titles; font effects\</bookmark_value\>         \<bookmark_value\>small capitals\</bookmark_value\>         \<bookmark_value\>strikethrough; font effects\</bookmark_value\>         \<bookmark_value\>fonts; strikethrough\</bookmark_value\>         \<bookmark_value\>outlines; font effects\</bookmark_value\>         \<bookmark_value\>fonts; outlines\</bookmark_value\>         \<bookmark_value\>shadows; characters\</bookmark_value\>         \<bookmark_value\>fonts; shadows\</bookmark_value\>         \<bookmark_value\>fonts;colour ignored\</bookmark_value\>         \<bookmark_value\>ignored font colours\</bookmark_value\>         \<bookmark_value\>colours;ignored text colour\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	hd_id3153514				0	en-ZA	\<link href=\"text/shared/01/05020200.xhp\" name=\"Font Effects\"\>Font Effects\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_id3149205				0	en-ZA	\<ahelp hid=\"HID_SVXPAGE_CHAR_EFFECTS\"\>Specify the font effects that you want to use.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	hd_id3149482				0	en-ZA	Font Colour				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_id3146924				0	en-ZA	\<ahelp hid=\"SVX_LISTBOX_RID_SVXPAGE_CHAR_EFFECTS_LB_FONTCOLOR\"\>Sets the colour for the selected text. If you select\<emph\> Automatic\</emph\>, the text colour is set to black for light backgrounds and to white for dark backgrounds.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_idN10CC2				0	en-ZA	To change the colour of a text selection, select the text that you want to change, and click the \<emph\>Font Colour\</emph\> icon. To apply a different colour, click the arrow next to the \<emph\>Font Colour\</emph\> icon, and then select the colour that you want to use.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_idN10CC9				0	en-ZA	If you click the \<emph\>Font Colour\</emph\> icon before you select text, the paint can cursor appears. To change the colour of text, select the text with the paint can cursor. To change the colour of a single word, double-click in a word. To apply a different colour, click the arrow next to the \<emph\>Font Colour\</emph\> icon, and then select the colour that you want to use.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_idN10CD6				0	en-ZA	To undo the last change, right-click.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_idN10CDA				0	en-ZA	To exit the paint can mode, click once, or press the Escape key.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_id3150037				0	en-ZA	The text colour is ignored when printing, if the \<emph\>Print black\</emph\> check box is selected in \<link href=\"text/shared/optionen/01040400.xhp\" name=\"Writer - Print\"\>\<emph\>%PRODUCTNAME Writer - Print\</emph\>\</link\> in the Options dialogue box.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_id7613757				0	en-ZA	The text colour is ignored on screen, if the \<emph\>Use automatic font colour for screen display\</emph\> check box is selected in \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>\<emph\>%PRODUCTNAME - Preferences\</emph\>\</caseinline\>\<defaultinline\>\<emph\>Tools - Options\</emph\>\</defaultinline\>\</switchinline\>\<emph\> - \</emph\>\<link href=\"text/shared/optionen/01013000.xhp\"\>\<emph\>%PRODUCTNAME - Accessibility\</emph\>\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_id3144766				0	en-ZA	\<ahelp hid=\".uno:FontColor\" visibility=\"hidden\"\>\<variable id=\"textfarbe\"\>Click to apply the current font colour to the selected characters. You can also click here, and then drag a selection to change the text colour. Click the arrow next to the icon to open the Font colour toolbar.\</variable\>\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	hd_id3146137				0	en-ZA	Effects				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_id3150084				0	en-ZA	\<ahelp hid=\"SVX_LISTBOX_RID_SVXPAGE_CHAR_EFFECTS_LB_EFFECTS2\"\>Select the font effects that you want to apply.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	hd_id3149575				0	en-ZA	Effects				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_id3148944				0	en-ZA	The following capitalisation effects are available:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_id3155922				0	en-ZA	Without - no effect is applied				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_id3154280				0	en-ZA	Capitals - changes the selected lowercase characters to uppercase characters				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_id3148947				0	en-ZA	Lowercase - changes the selected uppercase characters to lower characters				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_id3149456				0	en-ZA	Title font - changes the first character of each selected word to an uppercase character				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_id3154937				0	en-ZA	Small capitals - changes the selected lowercase characters to uppercase characters, and then reduces their size				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	hd_id3154129				0	en-ZA	Relief				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_id3146974				0	en-ZA	\<ahelp hid=\"SVX_LISTBOX_RID_SVXPAGE_CHAR_EFFECTS_LB_RELIEF\"\>Select a relief effect to apply to the selected text. The embossed relief makes the characters appear as if they are raised above the page. The engraved relief makes the characters appear as if they are pressed into the page.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	hd_id3147287				0	en-ZA	Outline				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_id3159126				0	en-ZA	\<ahelp hid=\"SVX_TRISTATEBOX_RID_SVXPAGE_CHAR_EFFECTS_CB_OUTLINE\"\>Displays the outline of the selected characters. This effect does not work with every font.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	hd_id3163714				0	en-ZA	Shadow				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_id3150962				0	en-ZA	\<ahelp hid=\"SVX_TRISTATEBOX_RID_SVXPAGE_CHAR_EFFECTS_CB_SHADOW\"\>Adds a shadow that casts below and to the right of the selected characters.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	bm_id410168				0	en-ZA	\<bookmark_value\>blinking fonts\</bookmark_value\>      \<bookmark_value\>flashing fonts\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	hd_id3152941				0	en-ZA	Blinking				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_id3145662				0	en-ZA	\<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_CHAR_EFFECTS_CB_BLINKING\"\>Makes the selected characters blink. You cannot change the blink frequency.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_idN10B81				0	en-ZA	Hidden				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_idN10B85				0	en-ZA	\<ahelp hid=\"svx:TriStateBox:RID_SVXPAGE_CHAR_EFFECTS:CB_CHARHIDDEN\"\>Hides the selected characters.\</ahelp\> To display the hidden text, ensure that \<emph\>Non-printing Characters\</emph\> is selected in the \<emph\>View\</emph\> menu. You can also choose \<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>\<emph\>%PRODUCTNAME - Preferences\</emph\>\</caseinline\>\<defaultinline\>\<emph\>Tools - Options\</emph\>\</defaultinline\>\</switchinline\>\<emph\> - %PRODUCTNAME Writer - Formatting Aids\</emph\> and select \<emph\>Hidden text\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	par_id0123200902291084				0	en-ZA	\<ahelp hid=\".\" visibility=\"hidden\"\>\<emph\>Overlines or removes overlining from the selected text. If the cursor is not in a word, the new text that you enter is overlined.\</emph\>\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05020200.xhp	0	help	hd_id0123200902243376				0	en-ZA	Overlining				2002-02-02 02:02:02
