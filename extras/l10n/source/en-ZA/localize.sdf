helpcontent2	source\text\smath\01\05020000.xhp	0	help	hd_id3155371				0	en-ZA	Functions				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05020000.xhp	0	help	par_id3153923				0	en-ZA	\<ahelp hid=\"STARMATH:METRICFIELD:RID_FONTSIZEDIALOG:6\"\>Select the relative size for names and other function elements in a formula in proportion to the base size.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05020000.xhp	0	help	hd_id3147171				0	en-ZA	Operators				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05020000.xhp	0	help	par_id3083280				0	en-ZA	\<ahelp hid=\"STARMATH:METRICFIELD:RID_FONTSIZEDIALOG:7\"\>Select the relative size of the mathematical operators in a formula in proportion to the base size.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05020000.xhp	0	help	hd_id3154638				0	en-ZA	Limits				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05020000.xhp	0	help	par_id3151189				0	en-ZA	\<ahelp hid=\"STARMATH:METRICFIELD:RID_FONTSIZEDIALOG:8\"\>Select the relative size for the limits in a formula in proportion to the base size.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05020000.xhp	0	help	hd_id3156320				0	en-ZA	Default				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05020000.xhp	0	help	par_id3145206				0	en-ZA	\<ahelp hid=\"STARMATH:PUSHBUTTON:RID_FONTSIZEDIALOG:1\"\>Click this button to save your changes as a default for all new formulae.\</ahelp\> A security response appears before saving any changes.				2002-02-02 02:02:02
