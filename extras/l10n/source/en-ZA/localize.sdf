helpcontent2	source\text\shared\02\24010000.xhp	0	help	hd_id3144760				0	en-ZA	Solarization				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3159150				0	en-ZA	\<ahelp hid=\".uno:GraphicFilterSolarize\"\>Opens a dialog for defining solarisation. Solarisation refers to an effect that looks like what can happen when there is too much light during photo development. The colours become partly inverted.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3148453				0	en-ZA	\<image id=\"img_id3154329\" src=\"res/commandimagelist/sc_graphicfiltersolarize.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3154329\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3150439				0	en-ZA	Solarization				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	hd_id3145785				0	en-ZA	Parameters				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3147352				0	en-ZA	Specifies the degree and type of solarization.				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	hd_id3153370				0	en-ZA	Threshold Value				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3083443				0	en-ZA	\<ahelp hid=\"SVX_METRICFIELD_RID_SVX_GRFFILTER_DLG_SOLARIZE_DLG_FILTERSOLARIZE_MTR_THRESHOLD\"\>Specifies the degree of brightness, in percent, above which the pixels are to be solarised.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	hd_id3152596				0	en-ZA	Invert				2002-02-02 02:02:02
