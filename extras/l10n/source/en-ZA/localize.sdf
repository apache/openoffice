helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3154505				0	en-ZA	\<link href=\"text/swriter/02/10110000.xhp\" name=\"Print Options\"\>Print Options\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3148775				0	en-ZA	\<ahelp hid=\".uno:PreviewPrintOptions\" visibility=\"visible\"\>Opens a dialogue where settings for the printout of your document can be made.\</ahelp\> The pages are proportionally reduced in size. When printing multiple document pages on one printed page, the whole sheet of paper may not be printed on and a margin may remain.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3154567				0	en-ZA	The settings entered on the \<emph\>Print options\</emph\> dialogue will only be activated if you print out the document using the \<emph\>Print page view\</emph\> icon.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3143270				0	en-ZA	\<image src=\"res/commandimagelist/sc_printersetup.png\" id=\"img_id3143277\"\>\<alt id=\"alt_id3143277\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3149099				0	en-ZA	Print options page view				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3148975				0	en-ZA	Distribution				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3153634				0	en-ZA	Determines the number of rows and columns to print, as well as the print size. You can also choose to print several document pages on one printed page.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3152771				0	en-ZA	Rows				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3155141				0	en-ZA	\<ahelp hid=\"SW:NUMERICFIELD:DLG_PAGEPREVIEW_PRINTOPTIONS:NF_ROWS\" visibility=\"visible\"\>Defines the number of rows of pages (horizontally stacked document pages).\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3145780				0	en-ZA	Columns				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3155916				0	en-ZA	\<ahelp hid=\"SW:NUMERICFIELD:DLG_PAGEPREVIEW_PRINTOPTIONS:NF_COLS\" visibility=\"visible\"\>Defines the number of pages shown in columns (vertically tiled document pages).\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3150117				0	en-ZA	Margins				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3155859				0	en-ZA	The print margins can be determined in this area.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3150686				0	en-ZA	Left				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3147410				0	en-ZA	\<ahelp hid=\"SW:METRICFIELD:DLG_PAGEPREVIEW_PRINTOPTIONS:MF_LMARGIN\" visibility=\"visible\"\>Specifies the left margin width.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3149552				0	en-ZA	Top				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3150546				0	en-ZA	\<ahelp hid=\"SW:METRICFIELD:DLG_PAGEPREVIEW_PRINTOPTIONS:MF_TMARGIN\" visibility=\"visible\"\>Specifies the top margin height.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3147733				0	en-ZA	Right				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3147751				0	en-ZA	\<ahelp hid=\"SW:METRICFIELD:DLG_PAGEPREVIEW_PRINTOPTIONS:MF_RMARGIN\" visibility=\"visible\"\>Specifies the right margin width.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3149845				0	en-ZA	Bottom				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3148857				0	en-ZA	\<ahelp hid=\"SW:METRICFIELD:DLG_PAGEPREVIEW_PRINTOPTIONS:MF_BMARGIN\" visibility=\"visible\"\>Specifies the bottom margin height.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3150491				0	en-ZA	Spacing				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3156097				0	en-ZA	The spacing section is used to determine the horizontal and vertical distances between the reduced document pages on one page.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3156113				0	en-ZA	Horizontal				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3150100				0	en-ZA	\<ahelp hid=\"SW:METRICFIELD:DLG_PAGEPREVIEW_PRINTOPTIONS:MF_HMARGIN\" visibility=\"visible\"\>Determines the horizontal distance between document pages.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3153128				0	en-ZA	Vertical				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3149632				0	en-ZA	\<ahelp hid=\"SW:METRICFIELD:DLG_PAGEPREVIEW_PRINTOPTIONS:MF_VMARGIN\" visibility=\"visible\"\>Determines the vertical distance between document pages.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3149649				0	en-ZA	Format				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3154031				0	en-ZA	Determines what print format to use.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3149950				0	en-ZA	Landscape				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3149969				0	en-ZA	\<ahelp hid=\"SW:RADIOBUTTON:DLG_PAGEPREVIEW_PRINTOPTIONS:RB_LANDSCAPE\" visibility=\"visible\"\>Prints the page in landscape format.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3149611				0	en-ZA	Portrait				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3145094				0	en-ZA	\<ahelp hid=\"SW:RADIOBUTTON:DLG_PAGEPREVIEW_PRINTOPTIONS:RB_PORTRAIT\" visibility=\"visible\"\>Prints the page in portrait format.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	hd_id3145110				0	en-ZA	Default				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\10110000.xhp	0	help	par_id3149579				0	en-ZA	\<ahelp hid=\"SW:PUSHBUTTON:DLG_PAGEPREVIEW_PRINTOPTIONS:PB_STANDARD\" visibility=\"visible\"\>Specifies that the system will not use a fixed number of rows and columns when printing out the page view, but rather uses what was originally shown in the page view.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\18030700.xhp	0	help	tit				0	en-ZA	Author				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\18030700.xhp	0	help	hd_id3154505				0	en-ZA	\<link href=\"text/swriter/02/18030700.xhp\" name=\"Author\"\>Author\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\02\18030700.xhp	0	help	par_id3152896				0	en-ZA	\<ahelp hid=\".uno:InsertAuthorField\"\>Inserts the name of the person who created the document here as a field.\</ahelp\> The field applies the entry made under \<emph\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - Preferences\</caseinline\>\<defaultinline\>Tools - Options\</defaultinline\>\</switchinline\> - \<link href=\"text/shared/optionen/01010100.xhp\" name=\"$[officename] - User data\"\>$[officename] - User data\</link\>\</emph\>.				2002-02-02 02:02:02
