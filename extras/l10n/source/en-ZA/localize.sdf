helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	hd_id3154147	19			0	en-ZA	Yellow				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	par_id3155306	20			0	en-ZA	\<ahelp hid=\"SVTOOLS_METRICFIELD_DLG_COLOR_NUM_YELLOW\"\>Sets the Yellow colour value in the CMYK colour model.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	hd_id3150105	21			0	en-ZA	Key				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	par_id3146148	22			0	en-ZA	\<ahelp hid=\"SVTOOLS_METRICFIELD_DLG_COLOR_NUM_KEY\"\>Sets the Black colour value or key (black) in the CMYK colour model.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	hd_id3151114	23			0	en-ZA	Red				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	par_id3153726	24			0	en-ZA	\<ahelp hid=\"SVTOOLS:NUMERICFIELD:DLG_COLOR:NUM_RED\"\>Sets the Red colour value in the RGB colour model.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\optionen\01010501.xhp	0	help	hd_id3148618	25			0	en-ZA	Green				2002-02-02 02:02:02
