helpcontent2	source\text\shared\02\24010000.xhp	0	help	hd_id3150875				0	en-ZA	Aging				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3163712				0	en-ZA	\<ahelp hid=\".uno:GraphicFilterSepia\"\>All pixels are set to their grey values, and then the green and blue colour channels are reduced by the amount you specify. The red colour channel is not changed.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3153139				0	en-ZA	\<image id=\"img_id3159196\" src=\"res/commandimagelist/sc_graphicfiltersepia.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3159196\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3145365				0	en-ZA	Aging				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	hd_id3156443				0	en-ZA	Aging Degree				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3155411				0	en-ZA	\<ahelp hid=\"SVX_METRICFIELD_RID_SVX_GRFFILTER_DLG_SEPIA_DLG_FILTERSEPIA_MTR_SEPIA\"\>Defines the intensity of ageing, in percent. At 0% you see the grey values of all pixels. At 100% only the red colour channel remains.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	hd_id3146119				0	en-ZA	Posterize				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3147396				0	en-ZA	\<ahelp hid=\".uno:GraphicFilterPoster\"\>Opens a dialogue to determine the number of poster colours.\</ahelp\> This effect is based on the reduction of the number of colours. It makes photos look like paintings.				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\24010000.xhp	0	help	par_id3155851				0	en-ZA	\<image id=\"img_id3150658\" src=\"res/commandimagelist/sc_graphicfilterposter.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3150658\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
