helpcontent2	source\text\scalc\guide\format_value_userdef.xhp	0	help	par_id3147344				0	ja	10200000				20200411 15:09:53
helpcontent2	source\text\scalc\guide\format_value_userdef.xhp	0	help	par_id3147003				0	ja	10.2 Million				20200411 15:09:53
helpcontent2	source\text\scalc\guide\format_value_userdef.xhp	0	help	par_id3166426				0	ja	10.2 Million				20200411 15:09:53
