helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153373				0	ja	DURATION_ADD("Settlement"; "Maturity"; 利札; 利回り; 利息支払回数; 基準)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155397	406			0	ja	            \<emph\>受領日\</emph\> は、証券の購入日です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148558	407			0	ja	            \<emph\>満期日\</emph\> は、証券が満期になる (満了する) 日付です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153096	408			0	ja	            \<emph\>利札\</emph\> は、利札年利率 (名目利率) です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154594	409			0	ja	            \<emph\>利回り\</emph\> は、証券の年利回りです。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149906	410			0	ja	            \<emph\>利息支払回数\</emph\> は、年間の利息支払回数です。1、2、または 4 になります。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3146995				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148834				0	ja	証券を 2001 年 1 月 1 日に購入し、満期日は 2006 年 1 月 1 日です。名目利率は 8% です。利回りは 9.0% です。利息は半年に一度支払われます (年間の利息支払回数は 2 回)。1 日単位の未払い利息計算 (基準 3) を使用して、修正された期間を求めます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154902	413			0	ja	\<item type=\"input\"\>=DURATION_ADD("2001-01-01";"2006-01-01";0.08;0.09;2;3)\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3159147				0	ja	\<bookmark_value\>年純利率\</bookmark_value\>\<bookmark_value\>計算; 年純利率\</bookmark_value\>\<bookmark_value\>年純利率\</bookmark_value\>\<bookmark_value\>EFFECTIVE 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3159147				0	ja	 EFFECTIVE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154204				0	ja	\<ahelp hid=\"HID_FUNC_EFFEKTIV\"\>名目年利率に対する 1 年あたりの実効利率を計算します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145417				0	ja	名目年利が月々、四半期、またはその他の計算期間の終わりに支払われるのに対し、金利は通常期間内に先払いされるため、実効年利は金利支払いの回数と共に多くなります。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3150510				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148805				0	ja	EFFECTIVE(Nom; P)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149768	93			0	ja	            \<emph\>Nom\</emph\> は、名目利率です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149334	94			0	ja	            \<emph\>P\</emph\> は、1 年あたりの利子の支払い回数です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3154223				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3144499				0	ja	名目年利率が 9.75% で、複利計算期間が 4 に指定されている場合の実際の利率 (実効年利率) を求めます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150772	97			0	ja	            \<item type=\"input\"\>=EFFECTIVE(9.75%;4)\</item\> = 10.11%。したがって、実効年利率は 10.11% です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3147241				0	ja	\<bookmark_value\>実効利率\</bookmark_value\>\<bookmark_value\>EFFECT_ADD 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3147241				0	ja	EFFECT_ADD				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3147524				0	ja	\<ahelp hid=\"HID_AAI_FUNC_EFFECT\"\>指定された名目年利率と 1 年当たりの利息支払回数を元に、実効年利率を計算します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3155364				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155118				0	ja	EFFECT_ADD(名目年利率; NPerY)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148907	418			0	ja	            \<emph\>名目利率\</emph\> は、名目年利率です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154274	419			0	ja	            \<emph\>NPerY\</emph\> は、年間の利息支払回数です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3149156				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3158426				0	ja	名目利率 5.25%、四半期ごとの利息支払の場合の実効年利率を求めます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148927	422			0	ja	            \<item type=\"input\"\>=EFFECT_ADD(0.0525;4)\</item\> は、0.053543、または 5.3534% を返します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3149998				0	ja	\<bookmark_value\>計算; 算術的逓減償却\</bookmark_value\>\<bookmark_value\>算術的逓減償却\</bookmark_value\>\<bookmark_value\>逓減償却;算術的逓減\</bookmark_value\>\<bookmark_value\>DDB 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3149998				0	ja	DDB				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159190				0	ja	\<ahelp hid=\"HID_FUNC_GDA\"\>指定された期間の資産の減価償却費を倍率法で計算します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3152361				0	ja	この償却法を使うと、定額償却法とは対照的に、初期の償却費が高くなります。償却価額は償却期間ごとに減少します。この方法は通常、購入後に価値が急速に落ちる資産 (自動車やコンピュータなど) に使用します。この方法では、帳簿価格は決してゼロにならないので注意します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3156038				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3166452				0	ja	DDB(取得価額; 残存; 耐用年数; 期間; 係数)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153237	104			0	ja	            \<emph\>取得価額\</emph\> には、資産を購入した時点での価格を指定します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149787	105			0	ja	            \<emph\>残存価額\</emph\> には、耐用年数が終了した時点での資産の価格を指定します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3152945	106			0	ja	            \<emph\>寿命\</emph\>は資産がどれくらい長い期間 (たとえば年または月)使用されるかの値です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149736	107			0	ja	            \<emph\>期間\</emph\> は、値が計算される期間のことです。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150243	108			0	ja	            \<emph\>率\</emph\>  (オプション) には、減価償却率を指定します。何も入力しなかった場合は 2 を指定したとみなされます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3159274				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3152882				0	ja	購入価格 7,500,000 円の情報処理装置を 5 年間毎月減価償却するとします。残存価格は 100 円、率は 2 とします。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154106	111			0	ja	            \<item type=\"input\"\>=DDB(75000;1;60;12;2)\</item\> = 1,721.81 通貨単位。したがって、購入後の 1 か月間の二倍減価償却費は、1,721.81 通貨単位になります。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3149962				0	ja	\<bookmark_value\>計算; 幾何学的逓減償却\</bookmark_value\>\<bookmark_value\>幾何学的逓減償却\</bookmark_value\>\<bookmark_value\>逓減償却;幾何学的逓減\</bookmark_value\>\<bookmark_value\>DB 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3149962				0	ja	DB				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148989				0	ja	\<ahelp hid=\"HID_FUNC_GDA2\"\>二倍定率法を使用して、特定の期における資産の減価償却費を返します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156213				0	ja	この償却法を使用すると、償却の初期に償却費が高くなります。償却価額は、償却期間ごとに、取得価格からすでに差し引かれた償却費の分減少します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3149807				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153349				0	ja	DB(取得価額; 残存; 耐用年数; 期間; 月)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148462	118			0	ja	            \<emph\>取得価額\</emph\> は、資産を購入した時点での価格です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148658	119			0	ja	            \<emph\>残存価額\</emph\> は、減価償却後の資産の価格です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145371	120			0	ja	            \<emph\>耐用年数\</emph\> は、資産を償却する期間を定義します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154608	121			0	ja	            \<emph\>期間\</emph\> は、各期間の長さです。長さは償却期間と同じ単位で指定する必要があります。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150829	122			0	ja	            \<emph\>月\</emph\>  (オプション) は、減価償却の最初の年の月数を意味します。省略すると、12 を指定したとみなされます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3151130				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3156147				0	ja	購入価格 2,500,000 円の情報処理装置を 3 年間減価償却します。耐用年数経過後の残存価額は 100,000 円、1 期間は 30 日とします。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149513	125			0	ja	            \<item type=\"input\"\>=DB(25000;1000;36;1;6)\</item\> = 1,075.00 通貨単位				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159242				0	ja	この情報処理装置の定率減価償却費は、107,500 円になります。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3153948				0	ja	\<bookmark_value\>IRR 関数\</bookmark_value\>\<bookmark_value\>計算;内部収益率、定期支払い\</bookmark_value\>\<bookmark_value\>内部収益率;定期支払い\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3153948				0	ja	IRR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3143282				0	ja	\<ahelp hid=\"HID_FUNC_IKV\"\>投資に対する内部利益率を計算します。\</ahelp\>これらの値は一定期間のキャッシュフロー値を表し、少なくとも 1 つの値が負 (支払) であり、かつ、少なくとも 1 つの値が正 (収入) である必要があります。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3150599				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3155427				0	ja	IRR(値; 推定値)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3144758	132			0	ja	            \<emph\>値\</emph\> は値を含む配列です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149233	133			0	ja	            \<emph\>推定値\</emph\> (オプション) は推定値です。内部的な利益率を計算するときには、反復方法が使用されます。ほんの数個しか値を提供できない場合、この反復を有効にするには、初期推定値を指定する必要があります。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3151258				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150630				0	ja	セル内容が A1=\<item type=\"input\"\>-10000\</item\>、A2=\<item type=\"input\"\>3500\</item\>、A3=\<item type=\"input\"\>7600\</item\>、および A4=\<item type=\"input\"\>1000\</item\> とすると、式 \<item type=\"input\"\>=IRR(A1:A4)\</item\> の結果は 11.33% です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	bm_id3151012				0	ja	\<bookmark_value\>計算; 元金均等返済時の利息\</bookmark_value\>\<bookmark_value\>元金均等返済時の利息\</bookmark_value\>\<bookmark_value\>ISPMT 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3151012				0	ja	ISPMT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148693				0	ja	\<ahelp hid=\"HID_FUNC_ISPMT\"\>利率が一定の分割払いにおける金利を計算します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3154661				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146070				0	ja	ISPMT(利率; 期間; 合計期間; 投資)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3148672	318			0	ja	            \<emph\>利率\</emph\> は期間の利率を指定します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3145777	319			0	ja	            \<emph\>期間\</emph\> は金利支払額を求めるための分割払いの回数です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3153678	320			0	ja	            \<emph\>合計期間\</emph\> は、支払い期間の合計です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3159390	321			0	ja	            \<emph\>投資額\</emph\> は現在の投資額です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	hd_id3156162				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3149558				0	ja	年利 12% の 2 年ローンで \\120000 を支払う場合、最初の 1 年半にどれだけ金利を支払うかを計算します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3150949	324			0	ja	            \<item type=\"input\"\>=ISPMT(1%;18;24;120000)\</item\> = -300 通貨単位。1.5 年後の月利は、300 通貨単位です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3146812				0	ja	\<link href=\"text/scalc/01/04060119.xhp\" name=\"財務関数 2 へ\"\>財務関数 2 へ\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060103.xhp	0	help	par_id3154411				0	ja	\<link href=\"text/scalc/01/04060118.xhp\" name=\"財務関数 3 へ\"\>財務関数 3 へ\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	tit				0	ja	名前を付ける				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	hd_id3156330				0	ja	名前を付ける				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	par_id3154366				0	ja	\<variable id=\"namenfestlegentext\"\>\<ahelp hid=\".uno:DefineName\"\>選択した範囲の名前を指定するダイアログを開きます。\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	par_id3154123	31			0	ja	マウスを使って範囲を定義するか、入力フィールド \<emph\>位置\</emph\> に参照を入力します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	par_id3155131				0	ja	数式バーの \<emph\>シート範囲\</emph\> リストボックスには、範囲が定義されている名前のリストが表示されます。このリストボックスで名前をクリックすると、表計算ドキュメント内の対応する参照が強調表示されます。ここには、数式または数式の一部に付けた名前は表示されません。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	hd_id3151118				0	ja	名前				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	par_id3163712				0	ja	\<ahelp hid=\"SC:COMBOBOX:RID_SCDLG_NAMES:ED_NAME\"\>参照を定義する範囲の名前を入力します。この下にあるテキストフィールドには、表計算ドキュメント内ですでに定義されている範囲の名前のリストが表示されます。\</ahelp\>リスト上の名前をクリックすると、ドキュメント内の対応する参照が青いフレームで表示されます。同じ範囲の名前に複数のセル範囲が属する場合、異なるフレームの色で表示されます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	hd_id3153728				0	ja	割り当て				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	par_id3147435				0	ja	\<ahelp hid=\"SC:EDIT:RID_SCDLG_NAMES:ED_ASSIGN\"\>ここには、選択された範囲の参照が絶対値で示されます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	par_id3146986				0	ja	範囲参照を入力する場合は、カーソルをこの入力ボックスに置いた上で、該当する範囲をシートで選択して指定します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	hd_id3154729				0	ja	詳細				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	par_id3149958	14			0	ja	\<ahelp hid=\"SC:MOREBUTTON:RID_SCDLG_NAMES:BTN_MORE\"\>参照の \<emph\>範囲の種類\</emph\> (オプション) を指定します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	hd_id3147394				0	ja	範囲の種類				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	par_id3155416				0	ja	ここでは、選択中の範囲に種類を指定します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	hd_id3150716				0	ja	印刷範囲				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	par_id3150751				0	ja	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_NAMES:BTN_PRINTAREA\"\>選択した範囲を印刷範囲として定義します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	hd_id3153764				0	ja	フィルタ				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	par_id3155766				0	ja	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_NAMES:BTN_CRITERIA\"\>選択した範囲を\<link href=\"text/scalc/01/12040300.xhp\" name=\"特殊フィルタ\"\>特殊フィルタ\</link\>で使用することを定義します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	hd_id3159267				0	ja	繰り返す列				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	par_id3149565				0	ja	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_NAMES:BTN_COLHEADER\"\>選択した範囲を繰り返す列として定義します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	hd_id3153966				0	ja	繰り返す行				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	par_id3150300				0	ja	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_NAMES:BTN_ROWHEADER\"\>選択した範囲を繰り返す行として定義します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	hd_id3155112				0	ja	追加/変更				20200411 15:09:53
helpcontent2	source\text\scalc\01\04070100.xhp	0	help	par_id3159236				0	ja	\<ahelp hid=\"SC:PUSHBUTTON:RID_SCDLG_NAMES:BTN_ADD\"\>定義した名前をリストに追加するには、\<emph\>追加\</emph\> ボタンをクリックします。リストから選択した既存の名前に別の名前を付けるには、\<emph\>変更\</emph\> ボタンをクリックします。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	tit				0	ja	統計関数 1				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3146320				0	ja	\<variable id=\"ae\"\>\<link href=\"text/scalc/01/04060181.xhp\"\>統計関数 1\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	bm_id3145632				0	ja	\<bookmark_value\>INTERCEPT 関数\</bookmark_value\>\<bookmark_value\>交点\</bookmark_value\>\<bookmark_value\>交差\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3145632				0	ja	INTERCEPT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3146887				0	ja	\<ahelp hid=\"HID_FUNC_ACHSENABSCHNITT\"\>既知の x 値と y 値を使用し、線が y 値と交わるポイントを返します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3150374				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3149718				0	ja	INTERCEPT(データ Y; データ X)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3149947	6			0	ja	            \<emph\>データ Y\</emph\> は、観察またはデータの依存集合です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3147412	7			0	ja	            \<emph\>データ X\</emph\> は、観察またはデータの独立集合です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3152983				0	ja	ここには、名前、行列、または数値が入った参照を使用する必要があります。数値を直接入力することも可能です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3157906				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3148728				0	ja	サンプルの表を利用して切片を求めます。Y の値はセル範囲 D3:D9 に、X の値はセル範囲 C3:C9 に入力されています。関数は次のようになります:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3149013	11			0	ja	            \<item type=\"input\"\>=INTERCEPT(D3:D9;C3:C9)\</item\> = 2.15。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	bm_id3148437				0	ja	\<bookmark_value\>COUNT 関数\</bookmark_value\>\<bookmark_value\>数値;カウントする\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3148437				0	ja	COUNT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3150700				0	ja	\<ahelp hid=\"HID_FUNC_ANZAHL\"\>引数のリストの中にある数値データの個数を返します。\</ahelp\>テキストのデータは無視されます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3153930				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3148585				0	ja	COUNT(値 1; 値 2; ... 値 30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3155827	17			0	ja	            \<emph\>値 1; 値 2, ...\</emph\> は、数えられる値を表す 1 から 30 の値または範囲です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3149254				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3149953				0	ja	値 1 から 4 フィールドの入力 2, 4, 6, eight が数えられます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3154558	20			0	ja	            \<item type=\"input\"\>=COUNT(2;4;6;"eight")\</item\> = 3。したがって、数値のカウントは 3 です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	bm_id3149729				0	ja	\<bookmark_value\>COUNTA 関数\</bookmark_value\>\<bookmark_value\>エントリ数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3149729				0	ja	COUNTA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3150142				0	ja	\<ahelp hid=\"HID_FUNC_ANZAHL2\"\>引数のリストにある値の個数をカウントします。\</ahelp\>長さが 0 である空の文字列が含まれる場合であっても、テキスト項目もカウントされます。引数が行列または参照である場合、行列または参照内の空のセルは無視されます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3148573				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3153111				0	ja	COUNTA(値 1; 値 2; ... 値 30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3150001	26			0	ja	            \<emph\>値 1; 値 2, ...\</emph\> は、数えられる値を表す 1 から 30 の引数です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3150334				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3154508				0	ja	値 1 から 4 フィールドの入力 2, 4, 6, eight が数えられます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3158000	29			0	ja	            \<item type=\"input\"\>=COUNTA(2;4;6;"eight")\</item\> = 4。したがって、値のカウントは 4 です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	bm_id3150267				0	ja	\<bookmark_value\>B 関数\</bookmark_value\>\<bookmark_value\>二項分布の試行が成功する確率\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3150267				0	ja	B				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3156061				0	ja	\<ahelp hid=\"HID_FUNC_B\"\>二項分布でサンプルの確率を返します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3150659				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3148392				0	ja	B(試行回数; SP; T1; T2)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3149002	35			0	ja	            \<emph\>試行回数\</emph\> は、試行する回数です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3148875	36			0	ja	            \<emph\>確率\</emph\> は、1 回の試行が成功する確率です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3145352	37			0	ja	            \<emph\>T1\</emph\> は、試行が成功する回数の下限を定義します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3149538	38			0	ja	            \<emph\>T2\</emph\> (オプション) は、試行回数の上限を定義します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3148768				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3154633				0	ja	1 つのサイコロを10回投げて、6 が 2 回出る確率を求めます。6 (または任意の数) が出る確率は 6 分の 1 なので、数式は次のようになります:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3149393	41			0	ja	            \<item type=\"input\"\>=B(10;1/6;2)\</item\> は、29% という確率を返します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	bm_id3158416				0	ja	\<bookmark_value\>RSQ 関数\</bookmark_value\>\<bookmark_value\>決定係数\</bookmark_value\>\<bookmark_value\>回帰分析\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3158416				0	ja	RSQ				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3154949				0	ja	\<ahelp hid=\"HID_FUNC_BESTIMMTHEITSMASS\"\>指定した値から、ピアソンの積率相関係数の 2 乗を返します。\</ahelp\>RSQ (決定係数とも呼ばれる) は調整の正確さを表す測定であり、回帰分析を行うためにも使用されます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3152820				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3155822				0	ja	RSQ(データ Y; データ X)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3150470	47			0	ja	            \<emph\>データ Y\</emph\> は、データポイントの行列または範囲です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3153181	48			0	ja	            \<emph\>データ X\</emph\> は、データポイントの行列または範囲です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	hd_id3156258				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	par_id3155991	50			0	ja	            \<item type=\"input\"\>=RSQ(A1:A20;B1:B20)\</item\> は、列 A と B の両方のデータセットの相関係数を計算します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060181.xhp	0	help	bm_id3145620				0	ja	\<bookmark_value\>BETAINV 関数\</bookmark_value\>\<bookmark_value\>累積確率密度関数;逆関数\</bookmark_value\>				20200411 15:09:53
