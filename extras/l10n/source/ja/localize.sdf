helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3147519				0	ja	スーパースクリプト左				20200411 15:09:53
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3147531				0	ja	\<ahelp hid=\"HID_SMA_LSUPX\"\>スーパースクリプト左をプレースホルダ付きで挿入します。\</ahelp\>\<emph\>コマンド\</emph\> ウィンドウに直接入力する場合は \<emph\><?>lsup{<?>}\</emph\> とします。				20200411 15:09:53
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_idN100C4				0	ja	\<image id=\"img_id3149691\" src=\"starmath/res/co21918.png\" width=\"8.47mm\" height=\"8.47mm\"\>\<alt id=\"alt_id3149691\" xml-lang=\"ja-JP\"\>マーク\</alt\>\</image\>				20200411 15:09:53
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3146931				0	ja	スーパースクリプト上				20200411 15:09:53
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3159195				0	ja	\<ahelp hid=\"HID_SMA_CSUPX\"\>スーパースクリプトを直接プレースホルダの上に挿入します。\</ahelp\>\<emph\>コマンド\</emph\> ウィンドウに直接入力する場合は \<emph\><?>csup<?>\</emph\> と入力します。				20200411 15:09:53
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_idN100FF				0	ja	\<image id=\"img_id3149097\" src=\"starmath/res/co21908.png\" width=\"8.47mm\" height=\"8.47mm\"\>\<alt id=\"alt_id3149097\" xml-lang=\"ja-JP\"\>マーク\</alt\>\</image\>				20200411 15:09:53
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3151249				0	ja	スーパースクリプト右				20200411 15:09:53
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3151262				0	ja	\<ahelp hid=\"HID_SMA_RSUPX\"\>スーパースクリプト右をプレースホルダ付きで挿入します。\</ahelp\>\<emph\>コマンド\</emph\> ウィンドウに直接入力する場合は \<emph\><?>^{<?>}\</emph\>、\<emph\>rsup\</emph\>、または \<emph\>sup\</emph\> とします。				20200411 15:09:53
