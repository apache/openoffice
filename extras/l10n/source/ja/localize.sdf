helpcontent2	source\text\shared\autopi\01100500.xhp	0	help	tit				0	ja	レポートウィザード - レポートの作成				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01100500.xhp	0	help	hd_id3156211				0	ja	\<link href=\"text/shared/autopi/01100500.xhp\" name=\"レポートウィザード - レポートの作成\"\>レポートウィザード - レポートの作成\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01100500.xhp	0	help	par_id3159224				0	ja	\<ahelp hid=\".\"\>レポートは、スタティックかダイナミックの形式で作成できます。 ダイナミックなレポートを開くと、レポートは現在のデータ内容を表示します。 スタティックなレポートを開くと、常に、スタティックなレポート作成時の同じデータが表示されます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01100500.xhp	0	help	hd_id3145669				0	ja	レポート名				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01100500.xhp	0	help	par_id3156136				0	ja	\<ahelp hid=\"HID_DLGREPORT_4_TITLE\"\>各ページのタイトル行に印刷されるタイトルを指定します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01100500.xhp	0	help	hd_id3157910				0	ja	スタティックなレポート				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01100500.xhp	0	help	par_id3149580				0	ja	\<ahelp hid=\"HID_DLGREPORT_5_OPTSTATDOCUMENT\"\>レポートを、スタティックなレポートとして保存します。 スタティックなレポートを開くと、常にレポート作成時のデータが表示されます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01100500.xhp	0	help	hd_id3154751				0	ja	自動レポート				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01100500.xhp	0	help	par_id3155805				0	ja	\<ahelp hid=\"HID_DLGREPORT_5_OPTDYNTEMPLATE\"\>レポートを、テンプレートとして保存します。 レポートテンプレートを開くと、現在のデータ内容を反映した新規ドキュメントが表示されます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01100500.xhp	0	help	hd_id3148538				0	ja	レポートテンプレートの編集を続ける				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01100500.xhp	0	help	par_id3163802				0	ja	\<ahelp hid=\"HID_DLGREPORT_5_OPTEDITTEMPLATE\"\>\<emph\>作成\</emph\> をクリックすると、テンプレートを保存して、編集画面を開きます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01100500.xhp	0	help	hd_id3153127				0	ja	レポートテンプレートをすぐ使用する				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01100500.xhp	0	help	par_id3156194				0	ja	\<ahelp hid=\"HID_DLGREPORT_5_OPTUSETEMPLATE\"\>\<emph\>作成\</emph\> をクリックすると、テンプレートが保存されます。続いて、そのテンプレートをベースとする新しいレポートドキュメントが開かれます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01110600.xhp	0	help	tit				0	ja	HTML エクスポート 6 ページ目				20200411 15:09:53
