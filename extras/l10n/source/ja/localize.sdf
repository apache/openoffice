helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165856				0	ja	AVERAGE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165883				0	ja	2				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165906				0	ja	COUNT				20200411 15:09:53
