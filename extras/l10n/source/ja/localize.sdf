helpcontent2	source\text\shared\01\05040400.xhp	0	help	par_id3150439				0	ja	\<ahelp hid=\"HID_SC_FOOTER_EDIT\"\>\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>\<link href=\"text/scalc/01/02120000.xhp\" name=\"フッターテキストを追加または編集\"\>フッターテキストを追加または編集\</link\>\</caseinline\>\</switchinline\>\</ahelp\>				20200411 15:09:53
