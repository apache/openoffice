helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3154068				0	ja	D7 = HH:MM AM/PM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060104.xhp	0	help	par_id3150286				0	ja	D8 = HH:MM:SS				20200411 15:09:53
