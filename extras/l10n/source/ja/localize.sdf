helpcontent2	source\text\shared\01\06150000.xhp	0	help	par_id3159086				0	ja	\<ahelp hid=\"HID_XML_FILTER_CLOSE\"\>ダイアログが閉じます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05100700.xhp	0	help	tit				0	ja	下揃え				20200411 15:09:53
helpcontent2	source\text\shared\01\05100700.xhp	0	help	hd_id3150249				0	ja	\<link href=\"text/shared/01/05100700.xhp\" name=\"下揃え\"\>下揃え\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05100700.xhp	0	help	par_id3154764				0	ja	\<ahelp hid=\".uno:CellVertBottom\"\>セルの内容をセルの下端に揃えます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05100700.xhp	0	help	par_id3149201				0	ja	\<variable id=\"zelleunten\"\>セルのメニューで\<emph\>セル → 下揃え\</emph\>を選択します。\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	tit				0	ja	フッター				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	hd_id3155620				0	ja	\<link href=\"text/shared/01/05040400.xhp\" name=\"フッター\"\>フッター\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	par_id3156553				0	ja	\<ahelp hid=\"HID_FORMAT_FOOTER\"\>現在のページスタイルにフッターが追加されます。フッターとは、下側のページ余白にある領域であり、テキストや図を追加することができます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	par_id3145136				0	ja	必要であれば、フッターの外枠線を表示させたり、背景を塗りつぶすこともできます。				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	par_id3155339	31			0	ja	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>現在のページスタイルにフッターを追加するには、\<emph\>フッターを付ける\</emph\> を選択してから、\<emph\>OK\</emph\> をクリックします。 \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	par_id3147209				0	ja	フッター段落の枠は、フッターの左右にあるページ余白へ広げることができます。				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	par_id3150976				0	ja	ドキュメントテキストからヘッダーや、フッターにカーソルをすばやく移動するには、\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>Command\</caseinline\>\<defaultinline\>Ctrl\</defaultinline\>\</switchinline\>+(Page Up) または (Page Down) を押します。同じキーをもう一度押すと、テキストカーソルがドキュメントテキスト内に 戻されます。				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	hd_id3150504				0	ja	フッター				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	par_id3149235				0	ja	フッターの属性を設定します。				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	hd_id3154380				0	ja	フッターを付ける				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	par_id3153348				0	ja	\<ahelp hid=\"SVX:CHECKBOX:RID_SVXPAGE_FOOTER:CB_TURNON\"\>現在のページスタイルにフッターが追加されます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	hd_id3145087				0	ja	左右ページ同じ内容				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	par_id3149575	21			0	ja	\<ahelp hid=\"SVX:CHECKBOX:RID_SVXPAGE_FOOTER:CB_SHARED\"\>偶数ページと奇数ページが同じ内容を共有します。\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>偶数ページと奇数ページに別々のフッターを割り当てるには、このオプションをオフにして、\<emph\>編集\</emph\> をクリックします。 \</caseinline\>\</switchinline\>\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	hd_id3147264				0	ja	左余白				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	par_id3156434				0	ja	\<ahelp hid=\"SVX:METRICFIELD:RID_SVXPAGE_FOOTER:ED_LMARGIN\"\>ページの左端とフッターの左端との間に残す空白の量を入力します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	hd_id3154073				0	ja	右余白				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	par_id3154224				0	ja	\<ahelp hid=\"SVX:METRICFIELD:RID_SVXPAGE_FOOTER:ED_RMARGIN\"\>ページの右端とフッターの右端との間に残す空白の量を入力します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	hd_id3154140				0	ja	間隔				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	par_id3154908				0	ja	\<ahelp hid=\"SVX:METRICFIELD:RID_SVXPAGE_FOOTER:ED_DIST\"\>ドキュメントテキストの下端とフッターの上端との間に保つ間隔を指定します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	hd_id3158409				0	ja	間隔自動調整				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	par_id3144760	35			0	ja	\<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_FOOTER_CB_DYNSPACING\"\>\<emph\>間隔\</emph\> の設定が上書きされ、フッターとドキュメントテキストの間の領域にフッターはみ出させることができるようになります。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	hd_id3154821				0	ja	高さ				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	par_id3125865				0	ja	\<ahelp hid=\"SVX:METRICFIELD:RID_SVXPAGE_FOOTER:ED_HEIGHT\"\>フッター用の高さを入力します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	hd_id3150742				0	ja	高さ自動調整				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	par_id3145744				0	ja	\<ahelp hid=\"SVX:CHECKBOX:RID_SVXPAGE_FOOTER:CB_HEIGHT_DYN\"\>入力した内容に応じて、フッターの高さが自動調節されます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	hd_id3149807				0	ja	詳細				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	par_id3145421				0	ja	\<ahelp hid=\"SVX:PUSHBUTTON:RID_SVXPAGE_FOOTER:BTN_EXTRAS\"\>フッターの枠線、背景色、および背景パターンを指定します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05040400.xhp	0	help	hd_id3157892	26			0	ja	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>編集 \</caseinline\>\</switchinline\>				20200411 15:09:53
