helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145634				0	ja	CHAR(数値)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155906	205			0	ja	            \<emph\>数値\</emph\> は、文字のコード値を表す 1 から 255 の数値です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152982				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149890	208			0	ja	            \<item type=\"input\"\>=CHAR(100)\</item\> は、文字 d を返します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id0907200910283297				0	ja	="abc" & CHAR(10) & "def" 文字列に改行文字を挿入します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149009				0	ja	\<bookmark_value\>CLEAN 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149009				0	ja	CLEAN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150482				0	ja	\<ahelp hid=\"HID_FUNC_SAEUBERN\"\>文字列から印刷されない文字を削除します。\</ahelp\>				20200411 15:09:53
