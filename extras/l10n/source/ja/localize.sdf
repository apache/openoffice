helpcontent2	source\text\swriter\01\05090100.xhp	0	help	hd_id3149881				0	ja	表の名前				20200411 15:09:53
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3145244				0	ja	\<ahelp hid=\"SW:EDIT:TP_FORMAT_TABLE:ED_NAME\"\>表の内部名を入力します。分かりやすい内部名を表に指定しておくと、ナビゲータで表を見分ける際に便利です。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	hd_id3150567				0	ja	幅				20200411 15:09:53
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3149026				0	ja	\<ahelp hid=\"SW:METRICFIELD:TP_FORMAT_TABLE:ED_WIDTH\"\>表の幅を入力します。\</ahelp\>\<emph\>配置\</emph\> エリアで \<emph\>自動\</emph\> オプションを選択している場合、このチェックボックスは使用できません。				20200411 15:09:53
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	hd_id3154644				0	ja	パーセント表示				20200411 15:09:53
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3151183				0	ja	\<ahelp hid=\"SW:CHECKBOX:TP_FORMAT_TABLE:CB_REL_WIDTH\"\>表の幅を、ページ幅に対するパーセント比で表示させます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	hd_id3151168				0	ja	配置				20200411 15:09:53
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3145412				0	ja	選択した表の配置オプションを選択します。				20200411 15:09:53
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	hd_id3147511				0	ja	自動				20200411 15:09:53
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3154108				0	ja	\<ahelp hid=\"SW:RADIOBUTTON:TP_FORMAT_TABLE:RB_FULL\"\>表の横幅をページの左枠から右枠までに広げます。\</ahelp\>この設定は、HTML 形式ドキュメントを作成する際に適しています。				20200411 15:09:53
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	hd_id3149807				0	ja	左				20200411 15:09:53
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3153540				0	ja	\<ahelp hid=\"SW:RADIOBUTTON:TP_FORMAT_TABLE:RB_LEFT\"\>表の左端をページの左枠に揃えます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	hd_id3151311				0	ja	左から				20200411 15:09:53
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	par_id3153672	37			0	ja	\<ahelp hid=\"SW:RADIOBUTTON:TP_FORMAT_TABLE:RB_FROM_LEFT\"\>\<emph\>間隔\</emph\> エリアの \<emph\>左\</emph\> スピンボックスで指定した分だけ、表の左端をインデントさせます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05090100.xhp	0	help	hd_id3150982				0	ja	右				20200411 15:09:53
