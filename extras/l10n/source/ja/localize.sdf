helpcontent2	source\text\shared\01\packagemanager.xhp	0	help	par_idN1061B				0	ja	UNO コンポーネント (コンパイル済みソフトウェアモジュール)				20200411 15:09:53
helpcontent2	source\text\shared\01\packagemanager.xhp	0	help	par_idN1061F				0	ja	設定データ (メニューコマンド用)				20200411 15:09:53
