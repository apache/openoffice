helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146098				0	ja	\<emph\>値 1; 値 2;...値 30\</emph\> は値または範囲です。テキストの値は 0 です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148743				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147401				0	ja	\<item type=\"input\"\>=MINA(1;"Text";20)\</item\> は、0 を返します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147295				0	ja	\<item type=\"input\"\>=MINA(A1:B100)\</item\> は、リスト内の最小値を返します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3166465				0	ja	\<bookmark_value\>AVEDEV 関数\</bookmark_value\>\<bookmark_value\>平均;統計関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3166465				0	ja	AVEDEV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150373				0	ja	\<ahelp hid=\"HID_FUNC_MITTELABW\"\>データポイントの平均値から、絶対偏差の平均を返します。\</ahelp\>データグループの分散が求められます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150038				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145636				0	ja	AVEDEV(数値 1; 数値 2; ...数値 30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3157871				0	ja	\<emph\>数値 1, 数値 2,...数値 30\</emph\> は、標本を表す値または範囲です。各数値は、参照に置き換えることもできます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149725				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153122				0	ja	\<item type=\"input\"\>=AVEDEV(A1:A50)\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3145824				0	ja	\<bookmark_value\>AVERAGE 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3145824				0	ja	AVERAGE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150482				0	ja	\<ahelp hid=\"HID_FUNC_MITTELWERT\"\>引数の平均値を返します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3146943				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154679				0	ja	AVERAGE(数値 1; 数値 2; ...数値 30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150741				0	ja	\<emph\>数値 1; 数値 2;...数値 30\</emph\> は数値または範囲です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153039				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151232				0	ja	\<item type=\"input\"\>=AVERAGE(A1:A50)\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148754				0	ja	\<bookmark_value\>AVERAGEA 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148754				0	ja	AVERAGEA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145138				0	ja	\<ahelp hid=\"HID_FUNC_MITTELWERTA\"\>データの算術平均値を返します。文字列データは 0 とみなされます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153326				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149734				0	ja	AVERAGEA(値 1; 値 2; ... 値 30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155260				0	ja	\<emph\>値 1; 値 2;...値 30\</emph\> は値または範囲です。テキストの値は 0 です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149504				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150864				0	ja	\<item type=\"input\"\>=AVERAGEA(A1:A50)\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148754K1				0	ja	\<bookmark_value\>AVERAGEIF 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148754K1				0	ja	AVERAGEIF				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145138K1				0	ja	\<ahelp hid=\"HID_FUNC_MITTELWERTB\"\>判定基準に合致する範囲に含まれるセルの値の平均値を計算します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153326K1				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149734K1				0	ja	AVERAGEIF( 参照 R ; 判定基準 C [ ; 参照 A ] )				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155260K1				0	ja	参照 A が省略された場合、判定基準 C が合致する参照範囲 R のセルの値の平均値を計算します。参照 A が与えられた場合、参照 A の左上のセルおよび参照 R の次元、形状、サイズを適用して構築された範囲のセルの値の平均値を計算します。参照の引数として定数は許可しません。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145139K1				0	ja	範囲 R のセルが判定基準 C に一つも合致しなければ、エラーが返ります。範囲の数値の平均値が計算されなければ、エラーが返ります。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149504K1				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150864K1				0	ja	\<item type=\"input\"\>=AVERAGEIF(A1:A50;">"0)\</item\>は A1:A50 範囲中のすべての正の値の平均値を返します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148754K2				0	ja	\<bookmark_value\>AVERAGEIFS 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148754K2				0	ja	AVERAGEIFS				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145138K2				0	ja	\<ahelp hid=\"HID_FUNC_MITTELWERTC\"\>複数の範囲の複数条件に合致するセルの値の平均値を計算します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153326K2				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149734K2				0	ja	AVERAGEIFS( 参照 A ; 参照 R1 ; 判定基準 C1 [ ; 参照 R2 ; 判定基準 C2 ]... )				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155260K2				0	ja	参照範囲 R1 中の判定基準 C1、参照範囲 R2 中の判定基準 C2、以下同様に合致する参照範囲 A のセルの値の平均値を計算します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145139K2				0	ja	すべての参照範囲は同じ次数、サイズでなければエラーを返します。論理的 AND が各々の範囲の各々の配列結果に適用されます。参照範囲 A のセルは、判定基準マッチの結果が各々の配列で同じ位置だった場合にのみ評価されます。結果中に平均を計算できる数値が無かった場合、エラーが返ります。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149504K2				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150864K2				0	ja	\<item type=\"input\"\>=AVERAGEIFS(A1:A50;B1:B25;">"0)\</item\> は B1 から B25 セル範囲のすべてのセルが 0 より大きい場合、A1:A50 の平均値を返します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153933				0	ja	\<bookmark_value\>MODE 関数\</bookmark_value\>\<bookmark_value\>最頻値\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153933				0	ja	MODE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153085				0	ja	\<ahelp hid=\"HID_FUNC_MODALWERT\"\>データセット内の最頻値を返します。\</ahelp\>頻度が同じ値が複数ある場合は、その中の最小値を返します。数値がすべて異なる場合には、エラー値を返します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153003				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155950				0	ja	MODE(数値 1; 数値 2; ...数値 30)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150337				0	ja	\<emph\>数値 1; 数値 2;...数値 30\</emph\> は数値または範囲です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153571				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153733				0	ja	\<item type=\"input\"\>=MODE(A1:A50)\</item\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3149879				0	ja	\<bookmark_value\>NEGBINOMDIST 関数\</bookmark_value\>\<bookmark_value\>負の二項分布\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149879				0	ja	NEGBINOMDIST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155437				0	ja	\<ahelp hid=\"HID_FUNC_NEGBINOMVERT\"\>負の二項分布の値を返します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3145351				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150935				0	ja	NEGBINOMDIST(失敗数;成功数;成功率)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153044				0	ja	\<emph\>失敗数\</emph\> は、試行が失敗する回数です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151018				0	ja	\<emph\>成功数\</emph\> は、試行が成功する回数です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148878				0	ja	\<emph\>成功率\</emph\> は、1 回の試行が成功する確率です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149539				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148770				0	ja	\<item type=\"input\"\>=NEGBINOMDIST(1;1;0.5)\</item\> は、0.25 を返します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3155516				0	ja	\<bookmark_value\>NORMINV 関数\</bookmark_value\>\<bookmark_value\>正規分布;逆数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155516				0	ja	NORMINV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154634				0	ja	\<ahelp hid=\"HID_FUNC_NORMINV\"\>正規累積分布のパーセント点を返します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153227				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147534				0	ja	NORMINV(数値;平均値;標準偏差)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154950				0	ja	\<emph\>数値\</emph\>は、逆正規分布を決定するのに使われる確率値です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150690				0	ja	\<emph\>平均値\</emph\> は、正規分布の平均値です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148594				0	ja	\<emph\>標準偏差\</emph\> は、正規分布の標準偏差を表します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155822				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153921				0	ja	\<item type=\"input\"\>=NORMINV(0.9;63;5)\</item\> は、69.41 を返します。平均的な卵が標準偏差 5 で 63 グラムの場合、卵が 69.41g より重くない確率は 90% です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153722				0	ja	\<bookmark_value\>NORMDIST 関数\</bookmark_value\>\<bookmark_value\>密度関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153722				0	ja	NORMDIST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150386				0	ja	\<ahelp hid=\"HID_FUNC_NORMVERT\"\>密度関数または正規分布を返します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3083282				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150613				0	ja	NORMDIST(数値; 平均値; 標準偏差; C)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149820				0	ja	\<emph\>数値\</emph\> は、正規分布が計算される値です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146063				0	ja	\<emph\>平均\</emph\> は、分布の平均値です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156295				0	ja	\<emph\>標準偏差\</emph\> は、分布の標準偏差です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145080				0	ja	\<emph\>関数形式\</emph\>に 0 を指定すると密度関数、\<emph\>関数形式\</emph\>に 1 を指定すると分布を計算します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152972				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149283				0	ja	\<item type=\"input\"\>=NORMDIST(70;63;5;0)\</item\> は、0.03 を返します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149448				0	ja	\<item type=\"input\"\>=NORMDIST(70;63;5;1)\</item\> は、0.92 を返します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3152934				0	ja	\<bookmark_value\>PEARSON 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152934				0	ja	PEARSON				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153216				0	ja	\<ahelp hid=\"HID_FUNC_PEARSON\"\>ピアソンの積率相関係数を返します。 \</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147081				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156133				0	ja	PEARSON(データ 1; データ 2)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151272				0	ja	\<emph\>データ 1\</emph\> は、最初のデータセットの行列を表します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153279				0	ja	\<emph\>データ 2\</emph\> は、2 番目のデータセットの行列を表します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147567				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151187				0	ja	\<item type=\"input\"\>=PEARSON(A1:A30;B1:B30)\</item\> は、両方のデータセットのピアソン相関係数を返します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3152806				0	ja	\<bookmark_value\>PHI 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152806				0	ja	PHI				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150254				0	ja	\<ahelp hid=\"HID_FUNC_PHI\"\>標準正規分布の確率を返します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154748				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149976				0	ja	PHI(数値)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156108				0	ja	\<emph\>数値\</emph\> は、それに基づいて標準正規分布が計算される値です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153621				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155849				0	ja	\<item type=\"input\"\>=PHI(2.25)\</item\> = 0.03				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3143236				0	ja	\<item type=\"input\"\>=PHI(-2.25)\</item\> = 0.03				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149286				0	ja	\<item type=\"input\"\>=PHI(0)\</item\> = 0.4				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153985				0	ja	\<bookmark_value\>POISSON 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153985				0	ja	POISSON				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154298				0	ja	\<ahelp hid=\"HID_FUNC_POISSON\"\>ポアソン分布を返します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3159183				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146093				0	ja	POISSON(数値;平均値;関数形式)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147253				0	ja	\<emph\>数値\</emph\> は、ポアソン分布を計算する値です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151177				0	ja	\<emph\>平均値\</emph\> は、ポアソン定数、つまりポアソン分布の中央値です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149200				0	ja	\<emph\>C\</emph\> (オプション) = 0 もしくは False は密度関数を計算します。\<emph\>C\</emph\> = 1 もしくは True は分布を計算します。省略されると、他のプログラムや古いバージョンの %PRODUCTNAME ともっともよい互換性を保つために、ドキュメントを保存するときにデフォルト値 True が挿入されます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3159347				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150113				0	ja	\<item type=\"input\"\>=POISSON(60;50;1)\</item\> は、0.93 を返します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153100				0	ja	\<bookmark_value\>PERCENTILE 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153100				0	ja	PERCENTILE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154940				0	ja	\<ahelp hid=\"HID_FUNC_QUANTIL\"\>行列内のデータ値のアルファ百分率を返します。\</ahelp\>百分率は、データ系列の最小値 (Alpha=0) から最大値 (alpha=1) までのデータ系列のスケール値を返します。\<item type=\"literal\"\>Alpha\</item\> = 25% の場合、百分率は最初の四分位数を意味します。\<item type=\"literal\"\>Alpha\</item\> = 50% は MEDIAN です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150531				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148813				0	ja	PERCENTILE(データ;α)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153054				0	ja	\<emph\>データ\</emph\> は、データが入力されているセル範囲です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154212				0	ja	\<emph\>α\</emph\> は、0 から 1 の間にある百分位の数です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154290				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159147				0	ja	\<item type=\"input\"\>=PERCENTILE(A1:A50;0.1)\</item\> は、A1:A50 のデータスケール全体の 10% に等しいデータセットの値を表します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148807				0	ja	\<bookmark_value\>PERCENTRANK 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148807				0	ja	PERCENTRANK				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153573				0	ja	\<ahelp hid=\"HID_FUNC_QUANTILSRANG\"\>データ範囲の中で、測定値の相対順位を返します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147512				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147238				0	ja	PERCENTRANK(データ;数値)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154266				0	ja	\<emph\>データ\</emph\> は、標本データの行列です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148475				0	ja	\<emph\>数値\</emph\> は、相対順位が決定される値です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155364				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149163				0	ja	\<item type=\"input\"\>=PERCENTRANK(A1:A50;50)\</item\> は、A1:A50 のすべての値の範囲全体の値 50 の相対順位を返します。50 が範囲全体の外にある場合は、エラーメッセージが表示されます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3166442				0	ja	\<bookmark_value\>QUARTILE 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3166442				0	ja	QUARTILE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146958				0	ja	\<ahelp hid=\"HID_FUNC_QUARTILE\"\>データグループの四分位数を返します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152942				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153684				0	ja	QUARTILE(データ;タイプ)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153387				0	ja	\<emph\>データ\</emph\> は、標本データの行列です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155589				0	ja	\<emph\>タイプ\</emph\> には、第何番の四分位数を返すかを指定します。0 を指定すると最小値 (MIN) 、1 を指定すると第一四分位数 (25% 目の値) 、2 を指定すると中央値 (MEDIAN) 、3 を指定すると第三四分位数 (75% 目の値) 、4 を指定すると最大値 (MAX) を返します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149103				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159276				0	ja	\<item type=\"input\"\>=QUARTILE(A1:A50;2)\</item\> は、スケールの 50% が範囲 A1:A50 の最小値から最大値に対応する値を返します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	tit				0	ja	ハイフネーション				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	bm_id3159399				0	ja	\<bookmark_value\>表計算ドキュメントの自動ハイフネーション\</bookmark_value\>\<bookmark_value\>ハイフネーション; 表計算ドキュメントでの\</bookmark_value\>\<bookmark_value\>表計算ドキュメントでの分綴\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	hd_id3159399				0	ja	ハイフネーション				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3145068	2			0	ja	\<variable id=\"silben\"\>\<ahelp hid=\".uno:Hyphenate\"\>\<emph\>ハイフネーション\</emph\> コマンドは、$[officename] Calc におけるハイフネーションの設定を行うダイアログを呼び出します。\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3154366				0	ja	$[officename] Calc でハイフネーションを有効にできるのは、\<link href=\"text/shared/01/05340300.xhp\" name=\"行の区切り\"\>行の区切り\</link\>機能を有効にしているときだけです。				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	hd_id3153192				0	ja	選択したセルをハイフネーションする				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3150868				0	ja	ハイフネーションを行うセルを選択します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3150440				0	ja	メニュー \<emph\>「ツール」 → 「言語」 → 「ハイフネーション」\</emph\> を選択します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3156441				0	ja	ダイアログ \<emph\>セルの書式設定\</emph\> が開いて、\<emph\>配置\</emph\> 見出しページが開きます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3149260				0	ja	「\<emph\>テキストを自動的に折り返す\</emph\>」および「\<emph\>ハイフネーションを行う\</emph\>」チェックボックスをオンにします。				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	hd_id3153094				0	ja	図形描画オブジェクトでハイフネーションする				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3148577				0	ja	図形描画オブジェクトを選択します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3156285				0	ja	メニュー \<emph\>「ツール」 → 「言語」 → 「ハイフネーション」\</emph\> を選択します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\06020000.xhp	0	help	par_id3147394				0	ja	コマンドを選択するたびに、図形描画オブジェクトのハイフネーションのオン、オフが切り替わります。オンの場合、コマンドにチェック印が付きます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	tit				0	ja	NOW				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	bm_id3150521				0	ja	\<bookmark_value\>NOW 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	hd_id3150521				0	ja	\<variable id=\"now\"\>\<link href=\"text/scalc/01/func_now.xhp\"\>NOW\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	par_id3148829				0	ja	\<ahelp hid=\"HID_FUNC_JETZT\"\>コンピュータのシステム日付と時刻が返されます。\</ahelp\>この値は、ドキュメントを再計算したとき、またはセル値が変更されたときに更新されます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	hd_id3146988				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	par_id3154897				0	ja	NOW()				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	par_id4598529				0	ja	NOW は引数のない関数です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	hd_id3154205				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_now.xhp	0	help	par_id3150774				0	ja	\<item type=\"input\"\>=NOW()-A1\</item\> は、A1 の日付と現在の差を返します。数値として結果を書式設定します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	tit				0	ja	TIMEVALUE 				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	bm_id3146755				0	ja	\<bookmark_value\>TIMEVALUE 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	hd_id3146755				0	ja	\<variable id=\"timevalue\"\>\<link href=\"text/scalc/01/func_timevalue.xhp\"\>TIMEVALUE\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3148502				0	ja	\<ahelp hid=\"HID_FUNC_ZEITWERT\"\>TIMEVALUE は、引用符で囲まれた文字列から内部時刻番号を返します。これは、使用可能な時刻入力形式を示す場合もあります。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3150794				0	ja	十進数で表示されるシリアル値は、$[officename] が日付の換算に使用する日付システムの値です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id011920090347118				0	ja	もし、テキスト文字列が年、月、日を含んでいるなら、TIMEVALUE関数は変換の端数部分を返すだけです。				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	hd_id3150810				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3150823				0	ja	TIMEVALUE("テキスト")				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3152556	165			0	ja	         \<emph\>文字列\</emph\> は有効な日付書式であり、引用符で囲む必要があります。				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	hd_id3146815				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3146829	167			0	ja	         \<item type=\"input\"\>=TIMEVALUE("4PM")\</item\> は、0.67 を返します。HH:MM:SS 時間書式を使用する場合は、16:00:00 を返却します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_timevalue.xhp	0	help	par_id3153632	168			0	ja	         \<item type=\"input\"\>=TIMEVALUE("24:00")\</item\> は、1 を返します。HH:MM:SS 時間書式を使用する場合は、値は 00:00:00 です。				20200411 15:09:53
