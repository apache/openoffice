helpcontent2	source\text\shared\01\06140200.xhp	0	help	hd_id3149095				0	ja	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Writer\</caseinline\>\<caseinline select=\"CALC\"\>Calc\</caseinline\>\<caseinline select=\"IMPRESS\"\>Impress\</caseinline\>\<caseinline select=\"DRAW\"\>Draw\</caseinline\>\<caseinline select=\"MATH\"\>Math \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06140200.xhp	0	help	par_id3155892				0	ja	\<ahelp hid=\"SFX2_RADIOBUTTON_TP_CONFIG_ACCEL_RB_MODULE\"\>現在の $[officename] アプリケーションで使用されるショートカットキーを表示します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06140200.xhp	0	help	hd_id3149398				0	ja	ショートカットキー				20200411 15:09:53
helpcontent2	source\text\shared\01\06140200.xhp	0	help	par_id3149811				0	ja	\<ahelp hid=\"HID_ACCELCONFIG_LISTBOX\"\>ショートカットキーと、その割り当てコマンドを表示します。\<emph\>機能\</emph\> リストで選択したコマンドに、ショートカットキーを割り当てるか変更をするには、リスト中のショートカットをクリックして \<emph\>変更\</emph\> をクリックします。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06140200.xhp	0	help	hd_id3157909				0	ja	機能				20200411 15:09:53
helpcontent2	source\text\shared\01\06140200.xhp	0	help	par_id3155388				0	ja	ショートカットキー割り当てる機能の範囲および $[officename] の機能をリスト表示します。				20200411 15:09:53
helpcontent2	source\text\shared\01\06140200.xhp	0	help	hd_id3155321				0	ja	フィールド				20200411 15:09:53
helpcontent2	source\text\shared\01\06140200.xhp	0	help	par_id3149166				0	ja	\<ahelp hid=\"HID_CONFIGGROUP_ACC_LISTBOX\"\>使用可能な機能の範囲を一覧表示します。スタイルにショートカットキーを割り当てるには、「スタイル」カテゴリを開きます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06140200.xhp	0	help	hd_id3154380				0	ja	機能				20200411 15:09:53
helpcontent2	source\text\shared\01\06140200.xhp	0	help	par_id3159148				0	ja	\<ahelp hid=\"HID_CONFIGFUNCTION_ACC_LISTBOX\"\>ショートカットキーを割り当てる機能を選択して、\<emph\>ショートカットキー\</emph\> リストにあるキーの組み合せをクリックし、\<emph\>変更\</emph\> をクリックします。選択した機能にすでにショートカットキーが割り当てられている場合は、該当するキーが \<emph\>キー\</emph\> リストに表示されます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06140200.xhp	0	help	hd_id3153332				0	ja	キー				20200411 15:09:53
helpcontent2	source\text\shared\01\06140200.xhp	0	help	par_id3150084				0	ja	\<ahelp hid=\"SFX2:LISTBOX:TP_CONFIG_ACCEL:BOX_ACC_KEY\"\>選択した機能に割り当てられているショートカットキーが表示されます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06140200.xhp	0	help	hd_id3150772				0	ja	変更				20200411 15:09:53
helpcontent2	source\text\shared\01\06140200.xhp	0	help	par_id3152909				0	ja	\<ahelp hid=\"SFX2:PUSHBUTTON:TP_CONFIG_ACCEL:BTN_ACC_CHANGE\"\>\<emph\>ショートカットキー\</emph\> リストで選択したキーの組み合わせを、\<emph\>機能\</emph\> リストで選択したコマンドに割り当てます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06140200.xhp	0	help	par_id7730033				0	ja	\<ahelp hid=\".\"\>確認メッセージを表示せず、選択した要素 (複数可) を削除します。\</ahelp\>				20200411 15:09:53
