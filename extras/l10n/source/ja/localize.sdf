helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165956				0	ja	COUNTA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3165983				0	ja	4				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166006				0	ja	MAX				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166033				0	ja	5				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3166056				0	ja	MIN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143316				0	ja	6				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143339				0	ja	PRODUCT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143366				0	ja	7				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143389				0	ja	STDEV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143416				0	ja	8				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143439				0	ja	STDEVP				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143466				0	ja	9				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143489				0	ja	SUM				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143516				0	ja	10				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143539				0	ja	VAR				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060106.xhp	0	help	par_id3143566				0	ja	11				20200411 15:09:53
