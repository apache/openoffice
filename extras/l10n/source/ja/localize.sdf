helpcontent2	source\text\shared\00\00000007.xhp	0	help	par_id3152823	4			0	ja	\<variable id=\"werkzeugleiste\"\>ツールバー上のアイコン: \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000007.xhp	0	help	par_id3152352	5			0	ja	\<variable id=\"textobjektleiste\"\>書式設定バー上のアイコン: \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000007.xhp	0	help	par_id3151370	7			0	ja	\<variable id=\"objektleiste\"\>書式設定バー上のアイコン: \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000007.xhp	0	help	par_id3149748	9			0	ja	\<variable id=\"diaobjektleiste\"\>スライドビューバー上のアイコン: \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000007.xhp	0	help	par_id3156553				0	ja	\<variable id=\"symbolleistenneu\"\>この概要では、$[officename] のデフォルトツールバー構成について説明します。\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000007.xhp	0	help	par_id3153551				0	ja	アジア諸言語のサポート				20200411 15:09:53
helpcontent2	source\text\shared\00\00000007.xhp	0	help	par_id3156326				0	ja	このコマンドを使うためには\<emph\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - 設定\</caseinline\>\<defaultinline\>ツール → オプション\</defaultinline\>\</switchinline\> →　言語設定 → 言語\</emph\> でアジア圏言語サポートを有効にしておく必要があります。				20200411 15:09:53
helpcontent2	source\text\shared\00\00000450.xhp	0	help	tit				0	ja	データベース				20200411 15:09:53
helpcontent2	source\text\shared\00\00000450.xhp	0	help	hd_id3154689				0	ja	データベース				20200411 15:09:53
helpcontent2	source\text\shared\00\00000450.xhp	0	help	par_id3152876				0	ja	\<variable id=\"DBTab\"\>\<emph\>ツール → データソース → テーブル\</emph\> を選択 \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000450.xhp	0	help	par_id3153244				0	ja	\<variable id=\"DBAbfragen\"\>\<emph\>ツール → データソース → クエリー\</emph\> を選択 \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000450.xhp	0	help	par_id3147294				0	ja	\<variable id=\"Typ\"\>「データベースファイル」ウィンドウで、\<emph\>「編集」 → 「データベース」 → 「プロパティー」 → 「詳細設定」\</emph\> タブを選択します。\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000450.xhp	0	help	par_id3159411				0	ja	\<variable id=\"Datenquelle\"\>ODBC またはアドレス帳タイプのデータベースファイルウィンドウで、編集 → データベース → 接続の種類を選択します。 \</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000450.xhp	0	help	par_id3149119				0	ja	\<variable id=\"Verzeichnis\"\>ウィザードなどで使われるパス選択ボタン、または\<emph\>\<switchinline select=\"sys\"\>\<caseinline select=\"MAC\"\>%PRODUCTNAME - 設定\</caseinline\>\<defaultinline\>ツール → オプション\</defaultinline\>\</switchinline\> → $[officename] → パス\</emph\> で設定するエントリーに対するパス \<emph\>編集\</emph\> ボタン\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\00\00000450.xhp	0	help	par_id3154497				0	ja	\<variable id=\"ODBC\"\>ODBC タイプのデータベースファイルウィンドウで、「編集」 → 「データベース」 → 「接続タイプ」を選択します。 \</variable\>				20200411 15:09:53
