helpcontent2	source\text\shared\01\01100300.xhp	0	help	par_id3155934				0	ja	\<ahelp hid=\"HID_DOCINFOUSER\"\>ユーザー定義情報のフィールドをドキュメントに割り当てることができます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01100300.xhp	0	help	hd_id3151234				0	ja	プロパティー				20200411 15:09:53
helpcontent2	source\text\shared\01\01100300.xhp	0	help	par_id3152551				0	ja	\<ahelp hid=\"SFX2:EDIT:TP_DOCINFOUSER:ED_INFO4\"\>ユーザー定義の内容を入力してください。各行の名前、タイプ、内容は変更することが出来ます。また、行は追加・削除することができます。項目はメタデータとして別のファイル形式でエクスポートされます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\01100300.xhp	0	help	hd_id0811200812071796				0	ja	追加				20200411 15:09:53
helpcontent2	source\text\shared\01\01100300.xhp	0	help	par_id0811200812071785				0	ja	\<ahelp hid=\".\"\>クリックして新しい行をプロパティー一覧に追加します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	tit				0	ja	テキスト				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	bm_id3146856				0	ja	\<bookmark_value\>テキスト; テキスト/図形描画オブジェクト\</bookmark_value\>\<bookmark_value\>図形描画オブジェクト; 内部テキスト\</bookmark_value\>\<bookmark_value\>枠; 枠に合ったテキスト\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	hd_id3146856				0	ja	\<link href=\"text/shared/01/05220000.xhp\" name=\"テキスト\"\>テキスト\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	par_id3150279				0	ja	\<ahelp hid=\"HID_PAGE_TEXTATTR\"\>選択した図形描画オブジェクトまたはテキストオブジェクト内のテキストにレイアウト属性およびアンカー属性を設定します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	par_id3154794				0	ja	テキストは、図形描画オブジェクトまたはテキストオブジェクトの外端を基準に配置されます。				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	hd_id3149031				0	ja	テキスト				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	hd_id3150445				0	ja	テキストに幅を合わせる				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	par_id3145629				0	ja	\<ahelp hid=\"SVX_TRISTATEBOX_RID_SVXPAGE_TEXTATTR_TSB_AUTOGROW_WIDTH\"\>オブジェクトがテキストよりも小さい場合、図形描画オブジェクトまたはテキストオブジェクトの幅に合うようにテキストのサイズを変更します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	hd_id3149511				0	ja	テキストに高さを合わせる				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	par_id3149640				0	ja	\<ahelp hid=\"SVX_TRISTATEBOX_RID_SVXPAGE_TEXTATTR_TSB_AUTOGROW_HEIGHT\"\>オブジェクトがテキストより小さい場合に、オブジェクトの高さをテキストの高さに合うように拡張します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	hd_id3152867				0	ja	枠に合わせる				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	par_id3147834				0	ja	\<ahelp hid=\"SVX_TRISTATEBOX_RID_SVXPAGE_TEXTATTR_TSB_FIT_TO_SIZE\"\>図形描画オブジェクトまたはテキストオブジェクトの範囲全体に合うようにテキストのサイズを変更します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	hd_id3155892				0	ja	輪郭に合わせる				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	par_id3153577				0	ja	\<ahelp hid=\"SVX_TRISTATEBOX_RID_SVXPAGE_TEXTATTR_TSB_CONTOUR\"\>選択した図形描画オブジェクトの輪郭線にテキストの流れを合わせます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	par_idN10705				0	ja	形に合ったワードラップ				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	par_idN10709				0	ja	\<ahelp hid=\".\"\>カスタムシェイプに適合するように、カスタムシェイプをダブルクリックした後に入力したテキストを折り返します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	par_idN10720				0	ja	テキストが合うように形をリサイズ				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	par_idN10724				0	ja	\<ahelp hid=\".\"\>カスタムシェイプをダブルクリックしたあとで、シェイプのサイズを入力したテキストに合うように変更します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05220000.xhp	0	help	hd_id3154288				0	ja	枠からの間隔				20200411 15:09:53
