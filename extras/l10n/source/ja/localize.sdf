helpcontent2	source\text\swriter\01\05040800.xhp	0	help	bm_id3150760				0	ja	\<bookmark_value\>日本語レイアウトの文字の罫線\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05040800.xhp	0	help	hd_id3150760				0	ja	\<link href=\"text/swriter/01/05040800.xhp\" name=\"行数と文字数\"\>行数と文字数\</link\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05040800.xhp	0	help	par_id3151171				0	ja	\<ahelp hid=\".\"\>現在のページスタイルに文字の罫線を追加します。 このオプションは、\<emph\>ツール → オプション → 言語設定 → 言語\</emph\> でアジア諸言語のサポートが有効な場合のみ使用できます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05040800.xhp	0	help	hd_id3154101				0	ja	グリッド線				20200411 15:09:53
helpcontent2	source\text\swriter\01\05040800.xhp	0	help	par_id3149805				0	ja	\<ahelp hid=\"SW_RADIOBUTTON_TP_TEXTGRID_PAGE_RB_CHARSGRID\"\>現在のページスタイルに対して、行や文字に使用する文字の罫線の追加や削除を行います。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05040800.xhp	0	help	hd_id3153537				0	ja	行数と文字数の設定				20200411 15:09:53
helpcontent2	source\text\swriter\01\05040800.xhp	0	help	hd_id3154478				0	ja	ページ単位の行数				20200411 15:09:53
helpcontent2	source\text\swriter\01\05040800.xhp	0	help	par_id3151308				0	ja	\<ahelp hid=\"SW_NUMERICFIELD_TP_TEXTGRID_PAGE_NF_LINESPERPAGE\"\>1 ページ中に収める行数 (最大) を指定します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05040800.xhp	0	help	hd_id3152957				0	ja	行単位の文字数				20200411 15:09:53
helpcontent2	source\text\swriter\01\05040800.xhp	0	help	par_id3153674				0	ja	\<ahelp hid=\"SW_NUMERICFIELD_TP_TEXTGRID_PAGE_NF_CHARSPERLINE\"\>1 行中に収める文字数 (最大) を指定します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05040800.xhp	0	help	hd_id3149684				0	ja	1 文字の最大サイズ				20200411 15:09:53
helpcontent2	source\text\swriter\01\05040800.xhp	0	help	par_id3154193				0	ja	\<ahelp hid=\"SW_METRICFIELD_TP_TEXTGRID_PAGE_MF_TEXTSIZE\"\>文字サイズとしての最大値を指定します。入力する数値が大きいほど、1 行中の文字数が少なくなります。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05040800.xhp	0	help	hd_id3155182				0	ja	ルビ文字の最大サイズ				20200411 15:09:53
helpcontent2	source\text\swriter\01\05040800.xhp	0	help	par_id3143283				0	ja	\<ahelp hid=\"SW_METRICFIELD_TP_TEXTGRID_PAGE_MF_RUBYSIZE\"\>ルビ用テキストの表示フォントサイズを指定します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05040800.xhp	0	help	hd_id3149496				0	ja	ルビを対象文字の下または左に表示				20200411 15:09:53
helpcontent2	source\text\swriter\01\05040800.xhp	0	help	par_id3149816				0	ja	\<ahelp hid=\"SW_CHECKBOX_TP_TEXTGRID_PAGE_CB_RUBYBELOW\"\>ルビ用テキストを、対象文字列の左側または下側に表示します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\05040800.xhp	0	help	hd_id3149100				0	ja	罫線の表示				20200411 15:09:53
