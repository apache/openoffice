helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3154965	48			0	ja	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>印刷見当 \</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	hd_id3146316	50			0	ja	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>合わせる\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id3156315	51			0	ja	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\<ahelp hid=\"SVX:CHECKBOX:RID_SVXPAGE_STD_PARAGRAPH:CB_REGISTER\"\>すべての行でテキストのベースラインを垂直ドキュメントグリッドに一致させて、各行を同じ高さに揃えます。この機能を使用する場合は、あらかじめ現在のページスタイルで \<emph\>印刷見当\</emph\> オプションをオンにしておく必要があります。この設定を行うには、\<emph\>書式 → ページ\</emph\> を選択し、\<emph\>ページ\</emph\> タブを選択し、\<emph\>レイアウト設定\</emph\> エリアにある \<emph\>印刷見当を合わせる\</emph\> ボックスをオンにします\</ahelp\>\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05030100.xhp	0	help	par_id9267250				0	ja	\<link href=\"text/swriter/guide/registertrue.xhp\" name=\"印刷見当の作成\"\>印刷見当の作成\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05340500.xhp	0	help	tit				0	ja	列を非表示				20200411 15:09:53
helpcontent2	source\text\shared\01\05340500.xhp	0	help	hd_id3148882				0	ja	\<link href=\"text/shared/01/05340500.xhp\" name=\"フィールドを非表示\"\>フィールドを非表示\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\01\05340500.xhp	0	help	par_id3155620				0	ja	\<ahelp hid=\".\"\>選択した列を非表示にします。非表示の列を表示するには、いずれかの列のヘッダーを右クリックし、\<emph\>列を表示する\</emph\> を選択します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	tit				0	ja	中国語の変換				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	bm_id49745				0	ja	\<bookmark_value\>中国語の書記法\</bookmark_value\>\<bookmark_value\>簡体字中国語; 繁体字中国語への変換\</bookmark_value\>\<bookmark_value\>繁体字中国語; 簡体字中国語への変換\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10547				0	ja	\<link href=\"text/shared/01/06010600.xhp\"\>中国語変換\</link\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10557				0	ja	\<ahelp hid=\".\"\>選択した中国語のテキストの書記法 (簡体字または繁体字) を変換します。テキストを選択していない場合、ドキュメント全体が変換されます。\</ahelp\>このコマンドは、\<emph\>ツール → オプション → 言語設定 → 言語\</emph\> でアジア言語サポートを有効にしている場合にのみ使用可能です。				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10572				0	ja	変換方向				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10576				0	ja	\<ahelp hid=\".\"\>変換方向を選択します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10579				0	ja	繁体字中国語から簡体字中国語へ				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1057D				0	ja	\<ahelp hid=\".\"\>繁体字中国語のテキスト文字を簡体字中国語のテキスト文字に変換します。選択したテキストを変換するには、\<emph\>OK\</emph\> をクリックします。テキストを選択していない場合、ドキュメント全体が変換されます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10580				0	ja	簡体字中国語から繁体字中国語へ				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10584				0	ja	\<ahelp hid=\".\"\>簡体字中国語のテキスト文字を繁体字中国語のテキスト文字に変換します。選択したテキストを変換するには、\<emph\>OK\</emph\> をクリックします。テキストを選択していない場合、ドキュメント全体が変換されます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1058E				0	ja	共通の用語				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10592				0	ja	\<ahelp hid=\".\"\>共通用語とは、中国語の繁体字と簡体字で、意味は同じだが異なる文字で表記する用語のことです。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10595				0	ja	共通の用語を変換				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN10599				0	ja	\<ahelp hid=\".\"\>共通用語のリストに複数の文字がある単語を変換します。リストの走査が完了した後、残りのテキストは 1 文字ごとに変換されます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN1059C				0	ja	用語の編集				20200411 15:09:53
helpcontent2	source\text\shared\01\06010600.xhp	0	help	par_idN105A0				0	ja	\<ahelp hid=\".\"\>変換用語のリストを編集できる \<link href=\"text/shared/01/06010601.xhp\"\>辞書の編集\</link\> ダイアログを開きます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	tit				0	ja	コメント				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	hd_id3083278				0	ja	コメント				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	par_id3148983				0	ja	\<variable id=\"kommentartext\"\>\<ahelp hid=\"HID_REDLINING_EDIT\"\>記録した変更にコメントを付けます。\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	par_id3155391	3			0	ja	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>変更されたテキスト内にカーソルがあるとき \</caseinline\>\<caseinline select=\"CALC\"\>変更されたセルが選択されているとき\</caseinline\>\</switchinline\>、または \<emph\>変更の承認または却下\</emph\> ダイアログ内でコメントを付けることができます。				20200411 15:09:53
helpcontent2	source\text\shared\01\02230300.xhp	0	help	par_id3156426	5			0	ja	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>変更記録のあるセルにマウスポインタを合わせると、シート内に吹き出しとしてコメントが表示されます。また、\<link href=\"text/shared/01/02230400.xhp\" name=\"変更の承認または却下\"\>\<emph\>変更の承認または却下\</emph\>\</link\> ダイアログのリスト内でも、変更を含むセルに付けられたコメントを見ることができます。\</caseinline\>\</switchinline\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	tit				0	ja	正規表現リスト				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	bm_id3146765				0	ja	\<bookmark_value\>正規表現; リストの\</bookmark_value\>\<bookmark_value\>リスト; 正規表現\</bookmark_value\>\<bookmark_value\>置換; タブストップ (正規表現)\</bookmark_value\>\<bookmark_value\>タブストップ; 正規表現\</bookmark_value\>\<bookmark_value\>連結, アンパサンドシンボルを参照\</bookmark_value\>\<bookmark_value\>アンパサンドシンボル, 演算子を参照\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	hd_id3146765				0	ja	\<variable id=\"02100001\"\>\<link href=\"text/shared/01/02100001.xhp\"\>正規表現のリスト\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149741				0	ja	記号				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155577				0	ja	作用と用途				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id6600543				0	ja	すべての文字				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9824518.00000001				0	ja	他に指定のない場合、所定の文字列を表します。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152427				0	ja	.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149031				0	ja	改行と改段落以外のすべての単一文字を表します。たとえば、検索語として「sh.rt」を指定すると、「shirt」と「short」の両方が戻されます。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154682				0	ja	^				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155351				0	ja	検索語句が段落の先頭にある場合にのみ検索されます。段落の先頭にある特殊オブジェクト (空のフィードや文字にアンカーされた枠) は無視されます。たとえば、「^Peter」です。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3159194				0	ja	$				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152542				0	ja	検索語句が段落の末尾にある場合にのみ検索されます。段落の末尾にある特殊なオブジェクト (空のフィールドや文字にアンカーされた枠) は無視されます。たとえば、「Peter$」などです。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156414				0	ja	*				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155555				0	ja	「*」の前の文字が 0 個以上の語句が検索されます。例えば「Ab*c」では、「Ac」、「Abc」、「Abbc」、「Abbbc」などが検索されます。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147399				0	ja	+				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3157958				0	ja	「+」記号の前の文字が 1 個以上の語句が検索されます。たとえば、「AX.+4」とすると「AX 4」は検索されますが「AX4」は検索されません。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145313				0	ja	段落内で可能な限り長いテキストが常に検索されます。段落にテキスト「AX 4 AX4」が含まれている場合、先頭の A から末尾の 4 までが検索されます。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3143267				0	ja	?				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153684				0	ja	｢?｣ の直前にある文字が0回または1回出現することを示します。たとえば ｢テキ?ト｣ と指定すると ｢テスト｣ と ｢テキスト｣ が検索されます。｢x(ab|c)?y｣ と指定すると ｢xaby｣ や ｢xcy｣ が検索されます。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3166410				0	ja	\\				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147209				0	ja	正規表現ではなく、通常の文字として「\\」の後ろに続く特殊文字を検索します (\\n、 \\t、 \\>、 \\< の組み合わせは除きます)。たとえば「tree\\.」は、「tree.」を検索します。「treed」あるいは「trees」などは検索できません。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152945				0	ja	\\n				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153700				0	ja	Shift + Enter キーで挿入された手動の改行を表します。改行を段落区切りに変更するには、\<emph\>検索する文字列\</emph\> ボックスと \<emph\>置換語の文字列\</emph\> ボックスに \<emph\>\\n\</emph\> と入力して、検索と置換を実行します。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9262672				0	ja	\<emph\>検索対象\</emph\> テキストボックスの \\n は、Shift + Enter キーの組み合わせで挿入された改行を表します。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id2366100				0	ja	\<emph\>置換内容\</emph\> テキストボックスの \\n は、Enter または Return キーで入力できる改段落を表します。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153258				0	ja	\\t				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3157809				0	ja	タブ文字を表します。この式は、\<emph\>置換後の文字列\</emph\> ボックスでも使用できます。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150670				0	ja	\\b				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153666				0	ja	単語の境界にマッチします。例えば、"\\bbook" は "bookmark" を検索しますが、"checkbook" を検索しません。一方で、"book\\b" は "checkbook" を検索しますが、"bookmark" を検索しません。分解された単語の "book" はどちらの検索文字列でも検索されます。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149576				0	ja	^$				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3151245				0	ja	空の段落が検索されます。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148550				0	ja	^.				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3159413				0	ja	段落の最初の文字が検索されます。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147282				0	ja	& または $0				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153961				0	ja	置換を行う場合には、\<emph\>検索する文字列\</emph\> ボックスの検索条件で検索された文字列を \<emph\>置換後の文字列\</emph\> ボックスの語に追加します。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149650				0	ja	たとえば \<emph\>検索する文字列\</emph\> ボックスに「window」と入力し、\<emph\>置換後の文字列\</emph\> ボックスに「&frame」と入力した場合、単語「window」が「windowframe」に置き換えられます。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150543				0	ja	また、\<emph\>置換後の文字列\</emph\> ボックスに「&」を入力すると、検索条件によって検索される文字列の \<emph\>属性\</emph\> や \<emph\>書式\</emph\> を変更できます。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145419				0	ja	[abc123]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154630				0	ja	かっこで囲まれた文字の 1 つを表します。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156293				0	ja	[a-e]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149167				0	ja	a と e の間の文字を表します。両端の文字、この例では a と e を含みます。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id100520090232005				0	ja	文字の順序は文字コードの番号順です。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155994				0	ja	[a-eh-x]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148676				0	ja	a ～ e と h ～ x 間の文字を表します。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145318				0	ja	[^a-s]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153351				0	ja	a から s までに含まれないすべての文字を表します。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156543				0	ja	\\xXXXX				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153768				0	ja	4 桁の 16 進数コード (XXXX) で指定する特殊文字を表します。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3159252				0	ja	この特殊文字のコードは、使用されているフォントに応じて異なります。メニュー \<emph\>挿入 → 記号と特殊文字\</emph\> を選択することにより、この文字コードを表示できます。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153951				0	ja	|				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154985				0	ja	「|」より前の条件で検索して、その後に「|」より後の条件で検索します。例えば、「これ | それ」は「これ」と「それ」を検索します。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147376				0	ja	{2}				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150103				0	ja	開きかっこの左側にある文字の発生回数を指定します。例えば「tre{2}」を指定すると、「tree」が検索されます。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3151289				0	ja	{1,2}				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147317				0	ja	開きかっこの前にある文字の繰りかえしの最小回数と最大回数を指定します。たとえば、「tre{1,2}」と指定すると、「tre」、および「tree」が検索されます。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id4870754				0	ja	{1,}				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id843836				0	ja	左角括弧の前にある文字の繰りかえしの最小回数を指定します。たとえば、「tre{2,}」と指定すると、「tree」、「treee」、および「treeeee」が検索されます。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148616				0	ja	( )				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id2701803				0	ja	\<emph\>検索テキスト\</emph\>ボックスで:				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153573				0	ja	かっこ内の文字を参照対象として定義します。すると、現在の式で最初の参照対象を「\\1」、第 2 の参照対象を「\\2」、以降同様にして参照することができます。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156061				0	ja	たとえば、テキストに 13487889 という数字が含まれている場合に、「(8)7\\1\\1」という正規表現で検索すると、「8788」が検索されます。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id2367931				0	ja	() で囲んで語句をグループ化できます。たとえば、「a(bc)?d」では「ad」または「abcd」が検索されます。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9200109				0	ja	\<emph\>「置換後の文字列」\</emph\> ボックス:				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id5766472				0	ja	参照を置き換えるには、\\ (バックスラッシュ) ではなく $ (ドル記号) を使用します。 見つかった文字列全体を置き換えるには $0 を使用します。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154790				0	ja	[:alpha:]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147397				0	ja	アルファベット文字を表します。[:alpha:]+ を使用して見つけます。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152885				0	ja	[:digit:]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150010				0	ja	数字を表します。[:digit:]+ を使用して見つけます。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153743				0	ja	[:alnum:]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153281				0	ja	英数文字 ([:alpha:] と [:digit:]) を表します。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153726				0	ja	[:space:]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150961				0	ja	空白文字です (その他の空白類文字ではありません)。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150486				0	ja	[:print:]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150872				0	ja	印刷可能文字を表します。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155854				0	ja	[:cntrl:]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152576				0	ja	編集記号を表します。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149958				0	ja	[:lower:]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145730				0	ja	\<emph\>オプション\</emph\> の \<emph\>大文字と小文字を区別\</emph\> がオンになっていると、小文字を検索します。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148455				0	ja	[:upper:]				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150092	231			0	ja	\<emph\>オプション\</emph\> で \<emph\>大小文字を区別する\</emph\> がオンになっている場合には、大文字を表します。               				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	hd_id5311441				0	ja	例				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id956834773				0	ja	e([:digit:])?    -- この検索文字列では 'e' に続くゼロ個もしくは一つの数字を検索します。現在、[:digit:] のような名前のついたクラスはカッコで括る必要があります。				20200411 15:09:53
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id952368773				0	ja	^([:digit:])$    -- 一つの数字のみの行もしくはセルを検索します。				20200411 15:09:53
