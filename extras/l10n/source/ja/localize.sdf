helpcontent2	source\text\scalc\01\12090200.xhp	0	help	par_id3150400				0	ja	ピボットテーブルを含む Excel の表計算ドキュメントをインポートした後には、その表をクリックしてから、\<emph\>データ → ピボットテーブル → 更新\</emph\> で行ないます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	tit				0	ja	WEEKNUM_ADD 				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	bm_id3166443				0	ja	\<bookmark_value\>WEEKNUM_ADD\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	hd_id3166443				0	ja	\<variable id=\"weeknumadd\"\>\<link href=\"text/scalc/01/func_weeknumadd.xhp\"\>WEEKNUM_ADD\</link\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	par_id3152945				0	ja	\<ahelp hid=\"HID_AAI_FUNC_WEEKNUM\"\>結果は、ある日付の暦週の番号を示します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	par_idN105DD				0	ja	WEEKNUM_ADD 関数は、Microsoft Excel と全く同じように週番号を計算するよう設計されています。ISO 8601 の週番号が必要である場合は、\<link href=\"text/scalc/01/func_weeknum.xhp\"\>WEEKNUM\</link\> 関数を使用するか、WW 書式設定コードを使用して日付セルを書式設定します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	hd_id3153745				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	par_id3153685				0	ja	WEEKNUM_ADD(日付; 戻り値のタイプ)				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	par_id3159277				0	ja	\<emph\>日付\</emph\> は、暦週内の日付です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	par_id3154098				0	ja	\<emph\>戻り値のタイプ\</emph\> は、日曜から始まる週は 1 で、月曜から始まる週は 2 です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	hd_id3152886				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	par_id3149973				0	ja	2001年12月24日がその年の何週目にあたるかを求めます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\func_weeknumadd.xhp	0	help	par_id3149914				0	ja	\<item type=\"input\"\>=WEEKNUM_ADD(24.12.2001;1)\</item\> は、52 を返します。				20200411 15:09:53
