helpcontent2	source\text\scalc\01\12080600.xhp	0	help	hd_id3148947				0	ja	\<link href=\"text/scalc/01/12080600.xhp\" name=\"削除\"\>削除\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\12080600.xhp	0	help	par_id3149656				0	ja	\<ahelp hid=\".uno:ClearOutline\" visibility=\"visible\"\>選択したセル範囲のアウトラインを解除します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\03100000.xhp	0	help	tit				0	ja	改ページプレビュー				20200411 15:09:53
helpcontent2	source\text\scalc\01\03100000.xhp	0	help	hd_id3151384				0	ja	\<link href=\"text/scalc/01/03100000.xhp\" name=\"改ページプレビュー\"\>改ページプレビュー\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\03100000.xhp	0	help	par_id3150792				0	ja	\<ahelp hid=\".uno:PagebreakMode\"\>シートの改ページと印刷範囲を表示します。このモードをオフにするには、\<emph\>表示 → 標準\</emph\> を選択します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\03100000.xhp	0	help	par_id3153877				0	ja	改ページプレビューのコンテキストメニューには、ページ分割の編集に欠かせない次の機能が用意されています:				20200411 15:09:53
helpcontent2	source\text\scalc\01\03100000.xhp	0	help	hd_id3154731				0	ja	すべての任意改ページの削除				20200411 15:09:53
helpcontent2	source\text\scalc\01\03100000.xhp	0	help	par_id3149400				0	ja	\<ahelp hid=\".uno:DeleteAllBreaks\"\>現在のシートにあるすべての任意設定の改ページが削除されます。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\03100000.xhp	0	help	hd_id3155067				0	ja	印刷範囲の追加				20200411 15:09:53
helpcontent2	source\text\scalc\01\03100000.xhp	0	help	par_id3155764				0	ja	選択したセルを既存の選択範囲に追加します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	tit				0	ja	テキスト関数				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3145389				0	ja	\<bookmark_value\>セル内のテキスト; 関数\</bookmark_value\>\<bookmark_value\>関数; テキスト関数\</bookmark_value\>\<bookmark_value\>関数ウィザード; テキスト\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3145389				0	ja	テキスト関数				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3152986				0	ja	\<variable id=\"texttext\"\>このセクションには、\<emph\>テキスト\</emph\> 関数の説明が含まれています。\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149384				0	ja	\<bookmark_value\>ARABIC 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149384				0	ja	ARABIC				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153558				0	ja	\<ahelp hid=\"HID_FUNC_ARABISCH\"\>ローマ数字を表す文字列をアラビア数字に変換します。0 から 3999 までの数が有効です。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153011				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155523				0	ja	ARABIC("テキスト")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151193	243			0	ja	            \<emph\>文字列\</emph\> はローマ数字を表す文字列です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155758				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154621	245			0	ja	            \<item type=\"input\"\>=ARABIC("MXIV")\</item\> は、1014 を返します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147553	246			0	ja	            \<item type=\"input\"\>=ARABIC("MMII")\</item\> は、2002 を返します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id8796349				0	ja	\<bookmark_value\>ASC 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id7723929				0	ja	ASC				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id8455153				0	ja	\<ahelp hid=\".\"\>ASC 関数は、ASCII およびカタカナ文字を全角から半角に変換します。テキスト文字列を返します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id9912411				0	ja	規約については\<link href=\"https://wiki.openoffice.org/wiki/Calc/Features/JIS_and_ASC_functions\"\>JIS と ASC 表計算関数\</link\>を参照してください。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id9204992				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id1993774				0	ja	ASC("テキスト")				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id2949919				0	ja	            \<emph\>テキスト\</emph\> は、変換される文字を含むテキストです。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id2355113				0	ja	JIS 関数も参照。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id9323709				0	ja	\<bookmark_value\>BAHTTEXT 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id6695455				0	ja	BAHTTEXT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id354014				0	ja	数値を、タイの通貨名を含むタイ語のテキストに変換します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id9942014				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id8780785				0	ja	BAHTTEXT(数値)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id1539353				0	ja	            \<emph\>数値\</emph\> は任意の数字です。数値の整数部に「バーツ」が追加され、数値の小数部に「サタン」が追加されます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id9694814				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3289284				0	ja	            \<item type=\"input\"\>=BAHTTEXT(12.65)\</item\> は、「12 バーツ 65 サタン」を意味するタイ文字の文字列を返します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3153072				0	ja	\<bookmark_value\>BASE 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153072				0	ja	BASE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153289				0	ja	\<ahelp visibility=\"visible\" hid=\"HID_FUNC_BASIS\"\>指定の基数で正の整数を\<link href=\"text/shared/00/00000005.xhp#zahlensystem\" name=\"記数法\"\>記数法\</link\>のテキストに変換します。\</ahelp\>0～9 の数字と A～Z のアルファベット文字が使用されます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146097				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155743				0	ja	BASE(数値; 基数; [最小長さ])				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151339	217			0	ja	            \<emph\>数値\</emph\> は、変換される正の整数です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3159262	218			0	ja	            \<emph\>Radix\</emph\> は、記数法の底を示します。これは、2 から 36 の任意の正の整数の場合があります。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148746	219			0	ja	            \<emph\>最小長さ\</emph\> (オプション) は、作成された文字列の最小長さを決定します。指定した最小長さより短い結果には、左にゼロが追加されます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146323				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3156399				0	ja	\<bookmark_value\>10 進法; 変換する\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156399	221			0	ja	            \<item type=\"input\"\>=BASE(17;10;4)\</item\> は、10 進数の 0017 を返します。				20200411 15:09:53
