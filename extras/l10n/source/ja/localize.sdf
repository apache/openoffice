helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3148656	148			0	ja	            \<emph\>カウント 1\</emph\> は、オブジェクトの合計です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150826	149			0	ja	            \<emph\>カウント 2\</emph\> は、各順列のオブジェクト数です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3153351				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150424	151			0	ja	            \<item type=\"input\"\>=PERMUT(6;3)\</item\> は、120 を返します。6 枚のトランプのうち 3 枚のトランプを連続して選択する組み合わせは、120 とおりあります。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3143276				0	ja	\<bookmark_value\>PERMUTATIONA 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3143276				0	ja	PERMUTATIONA				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3144759				0	ja	\<ahelp hid=\"HID_FUNC_VARIATIONEN2\"\>指定した数のオブジェクトについて、重複順列の数を返します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3145598				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149298				0	ja	PERMUTATIONA(カウント 1; カウント 2)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3156139	157			0	ja	            \<emph\>カウント 1\</emph\> は、オブジェクトの合計です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149519	158			0	ja	            \<emph\>カウント 2\</emph\> は、各順列のオブジェクト数です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3151382				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153949				0	ja	11個の要素の中から 2 個の要素を選ぶ場合の重複順列の総数を求めます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3149233	161			0	ja	            \<item type=\"input\"\>=PERMUTATIONA(11;2)\</item\> は、121 を返します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3150622	162			0	ja	            \<item type=\"input\"\>=PERMUTATIONA(6;3)\</item\> は、216 を返します。次のトランプを引く前に各トランプを戻す場合、6 枚のトランプのうち 3 枚のトランプを連続して選択する組み合わせは、216 とおりあります。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3152952				0	ja	\<bookmark_value\>PROB 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3152952				0	ja	PROB				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154110				0	ja	\<ahelp hid=\"HID_FUNC_WAHRSCHBEREICH\"\>ある範囲の値が 2 つの限界内にある確率密度を返します。\</ahelp\>\<item type=\"literal\"\>End\</item\> 値がない場合、この関数は、データ値が \<item type=\"literal\"\>Start\</item\> の値と等しいという原則に基づいて確率密度を計算します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3146810				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3147330				0	ja	PROB(Data; Probability; Start; End)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154573	168			0	ja	            \<emph\>データ\</emph\> は、行列または標本データの範囲です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3156334	169			0	ja	            \<emph\>確率\</emph\> とは、対応する確率の行列もしくは範囲です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3151107	170			0	ja	            \<emph\>下限\</emph\> は、対象となる確率変数の下限です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153694	171			0	ja	            \<emph\>上限\</emph\> (オプション) は、対象となる確率変数の上限です。このパラメータを指定しない場合は、\<emph\>下限\</emph\> の確率変数に対応する確率を返します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3147574				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3153666	173			0	ja	            \<item type=\"input\"\>=PROB(A1:A50;B1:B50;50;60)\</item\> は、A1:A50 の範囲内の値が 50 から 60 の制限内でもある確率を返します。A1:A50 の範囲内のすべての値が、B1:B50 の範囲内にある確率を持っています。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	bm_id3150941				0	ja	\<bookmark_value\>WEIBULL 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3150941				0	ja	WEIBULL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154916				0	ja	\<ahelp hid=\"HID_FUNC_WEIBULL\"\>ワイブル分布の値を返します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id0305200911372767				0	ja	ワイブル分散は連続確率分布で、パラメータ α > 0 (shape)、β > 0 (scale) を持ちます。 				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id0305200911372777				0	ja	C が 1 なら、WIBULL は確率密度関数を計算します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id0305200911372743				0	ja	C が 1 なら、WEIBULL は累積分散関数を計算します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3159393				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154478				0	ja	WEIBULL(数値;α;β;関数形式)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3151317	179			0	ja	            \<emph\>数値\</emph\> は、ワイブル分布の算出に用いられる値です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3158436	180			0	ja	            \<emph\>α\</emph\> は、ワイブル分布の α パラメータです。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154668	181			0	ja	            \<emph\>β\</emph\> は、ワイブル分布の β パラメータです。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3154825	182			0	ja	            \<emph\>関数形式\</emph\> は関数の種類です。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	hd_id3153794				0	ja	例				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id3146077	184			0	ja	            \<item type=\"input\"\>=WEIBULL(2;1;1;1)\</item\> は、0.86 を返します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060185.xhp	0	help	par_id0305200911372899				0	ja	\<link href=\"https://wiki.openoffice.org/wiki/Documentation/How_Tos/Calc:_WEIBULL_function\"\>Wiki ページ\</link\>を参照してください。				20200411 15:09:53
