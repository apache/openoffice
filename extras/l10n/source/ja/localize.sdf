helpcontent2	source\text\scalc\01\04060107.xhp	0	help	bm_id1596728				0	ja	\<bookmark_value\>LOGEST 関数\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3146009				0	ja	LOGEST				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3146037				0	ja	\<ahelp hid=\"HID_FUNC_RKP\"\>この関数は、入力され、調整されたデータを指数回帰曲積 (y=b*m^x) として計算します。\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	hd_id3146056				0	ja	構文				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163123				0	ja	LOGEST(データ Y; データ X; 関数タイプ; 統計)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163137				0	ja	\<emph\>データ Y\</emph\> は、Y データ行列を表します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163155				0	ja	\<emph\>データ X\</emph\> (オプション) は、X データ行列を表します。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163174				0	ja	\<emph\>関数タイプ\</emph\> (オプション)。関数タイプ = 0 の場合は、y = m^x という形式の関数が計算されます。その他の場合は、y = b*m^x という関数が計算されます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_id3163196				0	ja	\<emph\>統計値\</emph\> (オプション)。統計値=0 であれば、回帰係数のみが計算されます。				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060107.xhp	0	help	par_idN118F7				0	ja	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				20200411 15:09:53
