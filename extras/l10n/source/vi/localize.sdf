helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154558				0	vi	0 hay thiếu				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3145596				0	vi	Định dạng số từ kiểu dáng ô « Mặc định »				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3152785				0	vi	1				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154380				0	vi	Dữ liệu lúc nào cũng được đọc theo định dạng tiêu chuẩn cho tiếng Anh Mỹ				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150279				0	vi	2				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153775				0	vi	Dữ liệu được lấy dạng văn bản; không chuyển đổi sang số				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3149546				0	vi	Thí dụ				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148734	36			0	vi	\<item type=\"input\"\>=DDE("soffice";"c:\\office\\document\\data1.sxc";"trang1.A1")\</item\> thì đọc nội dung của ô A1 trên Trang 1 của bảng tính \<item type=\"productname\"\>%PRODUCTNAME\</item\> Calc « data1.sxc ».				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153081	37			0	vi	\<item type=\"input\"\>=DDE("soffice";"c:\\office\\document\\motto.sxw";"Tôn chỉ của hôm nay")\</item\> thì trả về một tôn chỉ trong ô chứa công thức này. Trước tiên, bạn cần phải nhập một dòng vào tài liệu « motto.sxw » chứa câu nói đã muốn, sau đó xác định nó làm dòng đầu của một phần tên \<item type=\"literal\"\>Tôn chỉ của Hôm nay\</item\> (trong \<item type=\"productname\"\>%PRODUCTNAME\</item\> Writer dưới \<emph\>Chèn > Phần\</emph\>). Nếu tôn chỉ được sửa đổi (và lưu lại) trong tài liệu \<item type=\"productname\"\>%PRODUCTNAME\</item\> Writer, tôn chỉ được cập nhật trong tất cả các ô \<item type=\"productname\"\>%PRODUCTNAME\</item\> Calc trong đó liên kết DDE này được xác định.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3153114				0	vi	\<bookmark_value\>hàm ERRORTYPE\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153114				0	vi	ERRORTYPE				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148568				0	vi	\<ahelp hid=\"HID_FUNC_FEHLERTYP\"\>Trả về số tương ứng với một \<link href=\"text/scalc/05/02140000.xhp\" name=\"giá trị lỗi\"\>giá trị lỗi\</link\> xảy ra trong một ô khác.\</ahelp\> Với sự giúp của số này, bạn có thể tạo một thông điệp lỗi.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149877				0	vi	\<emph\>Thanh Trạng thái\</emph\> hiển thị mã lỗi đã xác định sẵn từ \<item type=\"productname\"\>%PRODUCTNAME\</item\> nếu bạn nhấn vào ô chứa lỗi.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3154327				0	vi	Cú pháp				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3151322				0	vi	ERRORTYPE(Tham_chiếu)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150132	43			0	vi	\<emph\>Tham_chiếu\</emph\> chứa địa chỉ cua ô trong đó lỗi xảy ra.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3145248				0	vi	Thí dụ				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3146904				0	vi	Nếu ô A1 hiển thị « Err:518 », hàm \<item type=\"input\"\>=ERRORTYPE(A1)\</item\> trả về số 518.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3151221				0	vi	\<bookmark_value\>hàm INDEX\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3151221				0	vi	INDEX				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150268				0	vi	\<ahelp hid=\"HID_FUNC_INDEX\"\>Hàm INDEX trả về một phạm vi phụ, được xác định theo số thứ tự hàng/cột, hay một chỉ số phạm vi còn tùy chọn. Phụ thuộc vào ngữ cảnh, hàm INDEX trả về một tham chiếu hay nội dung.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3156063				0	vi	Cú pháp				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3149007				0	vi	INDEX(Tham_chiếu; Hàng; Cột; Phạm_vi)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3153260	51			0	vi	\<emph\>Tham_chiếu\</emph\> là một tham chiếu, được nhập hoặc một cách trực tiếp hoặc bằng cách ghi rõ một tên phạm vi. Nếu tham chiếu chứa nhiều phạm vi, bạn cần phải đặt tên của tham chiếu hay phạm vi giữa dấu ngoặc đơn.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3145302	52			0	vi	\<emph\>Hàng\</emph\> (tùy chọn) đại diện chỉ số hàng của phạm vi tham chiếu, cho đó cần trả về một giá trị. Trong trường hợp 0 (không có hàng cụ thể), trả về tất cả các hàng đã tham chiếu.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3154628	53			0	vi	\<emph\>Cột\</emph\> (tùy chọn) đại diện chỉ số cột của phạm vi tham chiếu, cho đó cần trả về một giá trị. Trong trường hợp 0 (không có cột cụ thể), trả về tất cả các cột đã tham chiếu.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3155514	54			0	vi	\<emph\>Phạm_vi\</emph\> (tùy chọn) đại diện chỉ số của phạm vi phụ, nế tham chiếu đện một phạm vi đa mục.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3145264				0	vi	Thí dụ				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3159112	56			0	vi	\<item type=\"input\"\>=INDEX(Prices;4;1)\</item\> trả về giá trị từ hàng 4, cột 1 của phạm vi cơ sở dữ liệu được xác định dưới \<emph\>Dữ liệu > Xác định\</emph\> như là \<emph\>Giá\</emph\> (Prices).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3150691	57			0	vi	\<item type=\"input\"\>=INDEX(SumX;4;1)\</item\> trả về giá trị từ phạm vi \<emph\>SumX\</emph\> trong hàng 4, cột 1 như được xác định dưới \<emph\>Chèn > Tên > Xác định\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id4109012				0	vi	\<item type=\"input\"\>=INDEX(A1:B6;1)\</item\> trả về một tham chiếu đến hàng đầu tiên của khối A1:B6.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id9272133				0	vi	\<item type=\"input\"\>=INDEX(A1:B6;0;1)\</item\> trả về một tham chiếu đến cột đầu tiên của khối A1:B6.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3158419	58			0	vi	\<item type=\"input\"\>=INDEX((multi);4;1)\</item\> ngụ ý giá trị được chứa trong hàng 4, cột 1 của phạm vi (đa mục), tên của đó bạn đã đặt dưới \<emph\>Chèn > Tên > Đặt\</emph\> như là \<emph\>đa\</emph\> (multi). Phạm vi đa mục có thể chứa vài phạm vi hình chữ nhật khác nhau, mỗi phạm vi có một hàng 4, cột 1. Sau đó, nếu bạn muốn gọi khối thứ hai của phạm vi đa mục này, gõ số \<item type=\"input\"\>2\</item\> làm tham số \<emph\>phạm vi\</emph\>.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3148595	59			0	vi	\<item type=\"input\"\>=INDEX(A1:B6;1;1)\</item\> ngụ ý giá trị ở góc trên, bên trái của phạm vi A1:B6.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id9960020				0	vi	\<item type=\"input\"\>=INDEX((multi);0;0;2)\</item\> trả về một tham chiếu đến phạm vi thứ hai của phạm vi đa mục.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	bm_id3153181				0	vi	\<bookmark_value\>hàm INDIRECT\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	hd_id3153181				0	vi	INDIRECT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060109.xhp	0	help	par_id3147169				0	vi	\<ahelp hid=\"HID_FUNC_INDIREKT\"\>Trả về \<emph\>tham chiếu\</emph\> được một chuỗi văn bản ghi rõ.\</ahelp\> Hàm này cũng có thể được dùng để trả về vùng của một chuỗi tương ứng.				20200411 15:09:53
