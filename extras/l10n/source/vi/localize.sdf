helpcontent2	source\text\shared\explorer\database\tablewizard03.xhp	0	help	par_idN10579				0	vi	\<ahelp hid=\".\"\>Bật tùy chọn này để tự động chèn một giá trị và tăng/giảm dần giá trị của trường đó cho mỗi bản ghi mới. Cơ sở dữ liệu phải hỗ trợ chức năng tự động tăng/giảm dần để dùng tính năng \<emph\>Tự động giá trị\</emph\> này.\</ahelp\>				20200411 15:09:53
