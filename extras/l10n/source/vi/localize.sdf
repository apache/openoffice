helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3149402				0	vi	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_RIGHT\"\>Tạo một chuỗi chạy từ trái sang phải trong phạm vi ô đã chọn, dùng độ tăng giảm đã định, cho tới khi đạt giá trị cuối.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	hd_id3146972				0	vi	Lên				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140600.xhp	0	help	par_id3153711				0	vi	\<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_TOP\"\>Tạo một chuỗi hướng lên trên trong phạm vi ô đã chọn, dùng độ tăng giảm đã cho, tới khi đạt đến giá trị cuối.\</ahelp\>				20200411 15:09:53
