helpcontent2	source\text\shared\explorer\database\password.xhp	0	help	par_idN10587				0	vi	\<ahelp hid=\".\"\>Bật tùy chọn này để sử dụng cùng một tên người dùng và mật khẩu, không cần thấy hộp thoại nữa, khi bạn kết nối lại tới cùng một nguồn dữ liệu trong phiên %PRODUCTNAME đang chạy.\</ahelp\>				20200411 15:09:53
