helpcontent2	source\text\shared\02\01170000.xhp	0	help	par_id3145115				0	vi	\<ahelp hid=\".uno:CurrencyField\"\>Tạo một trường tiền tệ.\</ahelp\>Nếu biểu mẫu được liên kết đến cơ sở dữ liệu, các giá trị tiền tệ có thể bắt nguồn từ cơ sở dữ liệu.				20200411 15:09:53
helpcontent2	source\text\shared\02\01170000.xhp	0	help	hd_id3148825				0	vi	Trường mẫu				20200411 15:09:53
