helpcontent2	source\text\shared\02\24020000.xhp	0	help	par_id3150255				0	vi	\<ahelp hid=\".uno:GrafMode\"\>Liệt kê các thuộc tính xem cho đối tượng đồ họa đã chọn. Đối tượng nhúng hay đã liên kết trong tập tin hiện thời sẽ không thay đổi, chỉ ô xem của đối tượng.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\02\24020000.xhp	0	help	par_id3150275				0	vi	\<image id=\"img_id3154515\" src=\"res/helpimg/zellvor.png\" width=\"1.528in\" height=\"0.292in\" localize=\"true\"\>\<alt id=\"alt_id3154515\"\>Cell Styles\</alt\>\</image\>				20200411 15:09:53
