helpcontent2	source\text\scalc\01\solver.xhp	0	help	par_id9210486				0	vi	\<ahelp hid=\".\"\>Mở hộp thoại \<emph\>Giải phương trình\</emph\>. Một dụng cụ giải giúp bạn giải phương trình có nhiều biến không rõ, dùng phương pháp tìm mục đích.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver.xhp	0	help	par_id8538773				0	vi	\<ahelp hid=\".\" visibility=\"hidden\"\>Nhập hay nhấn vào tham chiếu ô của ô đích. Trường này nhận địa chỉ của ô có giá trị cần tối ưu hoá.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver.xhp	0	help	par_id7564012				0	vi	\<ahelp hid=\".\" visibility=\"hidden\"\>Thử giải phương trình  đại diện giá trị tối đa của ô đích.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver.xhp	0	help	par_id1186254				0	vi	\<ahelp hid=\".\" visibility=\"hidden\"\>Thử giải phương trình đại diện giá trị tối thiểu của ô đích.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver.xhp	0	help	par_id7432477				0	vi	\<ahelp hid=\".\" visibility=\"hidden\"\>Thử giải phương trình để gần như một giá trị đã cho của ô đích.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver.xhp	0	help	par_id7141026				0	vi	\<ahelp hid=\".\" visibility=\"hidden\"\>Nhập giá trị hay một tham chiếu ô.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver.xhp	0	help	par_id8531449				0	vi	\<ahelp hid=\".\" visibility=\"hidden\"\>Nhập phạm vi ô có thể thay đổi.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver.xhp	0	help	par_id9183935				0	vi	\<ahelp hid=\".\" visibility=\"hidden\"\>Nhập một tham chiếu ô.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver.xhp	0	help	par_id946684				0	vi	\<ahelp hid=\".\" visibility=\"hidden\"\>Chọn một toán tử trong danh sách.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver.xhp	0	help	par_id9607226				0	vi	\<ahelp hid=\".\" visibility=\"hidden\"\>Nhập giá trị hay một tham chiếu ô.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver.xhp	0	help	par_id1939451				0	vi	\<ahelp hid=\".\" visibility=\"hidden\"\>Nhấn vào để thu nhỏ hay phục hồi hộp thoại. Bạn có thể nhấn vào hay lựa chọn ô trên trang tính. Bạn cũng có thể tự nhập một tham chiếu vào hộp nhập vào.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver.xhp	0	help	par_id9038972				0	vi	\<ahelp hid=\".\" visibility=\"hidden\"\>Nhấn vào để gỡ bỏ hàng khỏi danh sách. Bất cứ hàng nào nằm bên dưới hàng này thì đi lên.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver.xhp	0	help	par_id2423780				0	vi	\<ahelp hid=\".\" visibility=\"hidden\"\>Mở hộp thoại \<emph\>Tùy chọn\</emph\>.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver.xhp	0	help	par_id2569658				0	vi	\<ahelp hid=\".\" visibility=\"hidden\"\>Nhấn vào để giải phương trình tùy theo thiết lập hiện thời. Thiết lập hộp thoại được giữ lại đến khi bạn đóng tài liệu hiện tại.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver.xhp	0	help	par_id5474410				0	vi	Để giải phương trình bằng dụng cụ Giải phương trình				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver.xhp	0	help	par_id2216559				0	vi	Mục đích của tiến trình giải phương trình là tìm những giá trị biến đổi của một phương trình mà đưa đến một giá trị đã tối ưu hoá trong \<emph\>ô đích\</emph\>, cũng được gọi như là « mục tiêu ». Bạn có thể chọn nếu giá trị trong ô đích nên là giá trị tối đa, giá trị tối thiểu, hay gần như một giá trị đã cho.				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver.xhp	0	help	par_id7869502				0	vi	Những giá trị biến đổi đầu tiên được chèn vào một phạm vi ô hình chữ nhật được bạn nhập vào hộp \<emph\>Bằng cách thay đổi các ô\</emph\>. 				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver.xhp	0	help	par_id9852900				0	vi	Bạn có khả năng định nghĩa một dãy các điều kiện hạn chế mà đặt ràng buộc cho một số nào đó. Chẳng hạn, bạn có thể đặt ràng buộc ằng một của những biến hay ô không thể lớn hơn một biến khác, hay không phải lớn hơn một giá trị đã cho. Bạn cũng có thể xác định ràng buộc rằng một hay nhiều biến phải là số nguyên (giá trị không có phần thập phân), hay giá trị nhị phân (chỉ cho phép là 0 hay 1).				20200411 15:09:53
helpcontent2	source\text\scalc\01\solver.xhp	0	help	par_id5323953				0	vi	Cơ chế giải mặc định chỉ hỗ trợ phương trình tuyến tính.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140400.xhp	0	help	tit				0	vi	Trái				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140400.xhp	0	help	hd_id3153896				0	vi	\<link href=\"text/scalc/01/02140400.xhp\" name=\"Trái\"\>Trái\</link\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140400.xhp	0	help	par_id3150793				0	vi	\<ahelp hid=\".uno:FillLeft\" visibility=\"visible\"\>Điền nội dung các ô ngoài cùng bên phải vào các ô khác trong cùng phạm vi.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02140400.xhp	0	help	par_id3156280				0	vi	Nếu phạm vi được chọn chỉ có 1 hàng, nội dung của ô ngoài cùng bên phải sẽ được chép sang các ô khác. Nếu có nhiều hàng, các ô ngoài cùng bên phải sẽ được chép sang các ô bên trái chúng.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02180000.xhp	0	help	tit				0	vi	Di chuyển hay sao chép một bảng				20200411 15:09:53
helpcontent2	source\text\scalc\01\02180000.xhp	0	help	bm_id3153360				0	vi	\<bookmark_value\>bảng tính; di chuyển\</bookmark_value\>\<bookmark_value\>bảng tính; sao chép\</bookmark_value\>\<bookmark_value\>di chuyển; bảng tính\</bookmark_value\>\<bookmark_value\>sao chép; bảng tính\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02180000.xhp	0	help	hd_id3153360				0	vi	Di chuyển hay sao chép một bảng				20200411 15:09:53
helpcontent2	source\text\scalc\01\02180000.xhp	0	help	par_id3154686				0	vi	\<variable id=\"tabelleverschiebenkopierentext\"\>\<ahelp hid=\".uno:Move\"\>Di chuyển hoặc chép một bảng tới vị trí khác trong tài liệu hoặc sang một tài liệu khác.\</ahelp\>\</variable\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\02180000.xhp	0	help	par_id2282479				0	vi	Khi bạn chép và dán các ô có \<link href=\"text/scalc/01/04060102.xhp\"\>giá trị ngày tháng\</link\> giữa các bảng tính khác nhau, cả 2 tài liệu bảng tính phải được đặt cùng 1 ngày tháng gốc. Nếu ngày tháng gốc khác đi, ngày tháng hiển thị trên 2 bảng tính sẽ khác nhau!				20200411 15:09:53
helpcontent2	source\text\scalc\01\02180000.xhp	0	help	hd_id3163710				0	vi	Vào tài liệu				20200411 15:09:53
helpcontent2	source\text\scalc\01\02180000.xhp	0	help	par_id3148645				0	vi	\<ahelp hid=\"SC:LISTBOX:RID_SCDLG_MOVETAB:LB_DEST\"\>Hiện nơi cần chuyển hoặc chép bảng hiện thời sang.\</ahelp\> Chọn \<emph\>Tài liệu mới\</emph\> nếu bạn muốn tạo một tài liệu mới để chuyển hoặc chép bảng tính sang đó.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02180000.xhp	0	help	hd_id3154012				0	vi	Chèn phía trước				20200411 15:09:53
helpcontent2	source\text\scalc\01\02180000.xhp	0	help	par_id3145366				0	vi	\<ahelp hid=\"SC:LISTBOX:RID_SCDLG_MOVETAB:LB_INSERT\"\>Bảng hiện thời được di chuyển hoặc sao chép tới trước bảng đã chọn.\</ahelp\> Tuỳ chọn \<emph\>di chuyển đến vị trí cuối\</emph\> sẽ đặt bảng hiện tại ở cuối.				20200411 15:09:53
helpcontent2	source\text\scalc\01\02180000.xhp	0	help	hd_id3153726				0	vi	Chép				20200411 15:09:53
helpcontent2	source\text\scalc\01\02180000.xhp	0	help	par_id3144764				0	vi	\<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_MOVETAB:BTN_COPY\"\>Chỉ định bảng cần được chép. Nếu bỏ dấu kiểm của tuỳ chọn này, bảng sẽ được di chuyển thay vì sao chép lại.\</ahelp\> Đây là tuỳ chọn mặc định.				20200411 15:09:53
helpcontent2	source\text\scalc\01\12040100.xhp	0	help	tit				0	vi	Tự động lọc				20200411 15:09:53
