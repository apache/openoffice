helpcontent2	source\text\schart\01\04070000.xhp	0	help	par_id3146974				0	vi	\<variable id=\"gitter\"\>\<ahelp hid=\".\"\>You can divide the axes into sections by assigning gridlines to them. This allows you to get a better overview of the chart, especially if you are working with large charts.\</ahelp\>\</variable\> The Y axis major grid is activated by default.				20200411 15:09:53
helpcontent2	source\text\schart\01\04070000.xhp	0	help	hd_id3156286				0	vi	Lưới chính				20200411 15:09:53
helpcontent2	source\text\schart\01\04070000.xhp	0	help	par_id3154511				0	vi	Xác định trục cần đặt thành lưới chính.				20200411 15:09:53
helpcontent2	source\text\schart\01\04070000.xhp	0	help	hd_id3149400				0	vi	Trục X				20200411 15:09:53
helpcontent2	source\text\schart\01\04070000.xhp	0	help	par_id3150749				0	vi	\<ahelp hid=\"SCH:CHECKBOX:DLG_GRID:CB_X_MAIN\"\>Thêm các đường lưới vào trục X của đồ thị.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\schart\01\04070000.xhp	0	help	par_id3154754				0	vi	\<variable id=\"sytextxgitter\"\>\<ahelp hid=\".uno:ToggleGridHorizontal\"\>Biểu tượng \<emph\>Hiện/ẩn lưới nằm ngang\</emph\> trên thanh \<emph\>Định dạng\</emph\> sẽ hiển thị hay ẩn lưới trên trục X. Ghi chú : nó chỉ hoạt động được nếu không có dấu trong những hộp chọn \<emph\>Lưới phụ\</emph\> trong hộp thoại \<emph\>Chèn > Lưới\</emph\>.\</ahelp\>\</variable\> Không thì lưới phụ còn lại hiển thị khi lưới chính được tắt.				20200411 15:09:53
