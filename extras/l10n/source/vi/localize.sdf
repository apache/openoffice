helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153102				0	vi	\<emph\>Thanh_toán\</emph\> là ngày tháng đã mua chứng khoán.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150530				0	vi	\<emph\>Đến_hạn\</emph\> là ngày tháng vào đó chứng khoán hết hạn dùng.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149903				0	vi	\<emph\>Cấp\</emph\> là ngày tháng đã cấp chứng khoán đó.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148828				0	vi	\<emph\>Tỷ_lệ\</emph\> là lãi suất của chứng khoán vào ngày cấp.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146993				0	vi	\<emph\>Lợi\</emph\> là tổng lợi tức hàng năm của chứng khoán.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3150507				0	vi	Ví dụ				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154289				0	vi	Ngày thanh toán là 1999-02-15; ngày đến hạn là 1999-04-13; ngày cấp là 1998-11-11. Lãi suất là 6,1%; lợi tức là 6,1%; cơ bản: 30/360 = 0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154905				0	vi	Giá được tính như theo đây:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3158409				0	vi	=PRICEMAT("1999-02-15";"1999-04-13";"1998-11-11"; 0.061; 0.061;0) trả về 99,98449888.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3148448				0	vi	\<bookmark_value\>tính; khoảng thời gian\</bookmark_value\>\<bookmark_value\>khoảng thời gian;tính\</bookmark_value\>\<bookmark_value\>hàm DURATION\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3148448				0	vi	DURATION				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153056				0	vi	\<ahelp hid=\"HID_FUNC_LAUFZEIT\"\>Tính số các thời kỳ cần thiết để một đầu tư tới giá trị đã muốn.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3145421				0	vi	Cú pháp				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148933				0	vi	DURATION(Tỷ_lệ; PV; FV)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148801				0	vi	\<emph\>Tỷ lệ\</emph\> là một hằng số. Lãi suất sẽ được tính cho toàn bộ khoảng thời gian. Lãi suất từng kỳ được tính bằng cách chia lãi suất cho khoảng thời gian đã tính. Lãi suất nội tại cho một số tiền trả hằng năm nên được nhập vào dưới dạng Tỷ_lệ/12.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147239				0	vi	\<emph\>PV\</emph\> là giá trị hiện tại. Giá trị tiền mặt là số tiền mặt cọc hay giá trị tiền mặt hiện tại của một tiền trợ cấp bằng hiện vật. Tiền cọc phải được nhập dưới dạng một giá trị dương: không thể là 0 hay <0.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147515				0	vi	\<emph\>FV\</emph\> là giá trị mong đợi. Giá trị tương lai thì quyết định giá trị đã muốn (tương lai) của tiền cọc.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153579				0	vi	Ví dụ				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148480				0	vi	Khi có lãi suất 4,75%, giá trị tiền mặt 25.000 đơn vị tiền tệ và giá trị tương lai 1.000.000 đơn vị tiền tệ, trả về khoảng thời gian 79,49 thời kỳ trả tiền. Số tiền từng kỳ là thương của giá trị tương lai và khoảng thời gian, trong trường hợp này 1.000.000/79,49=12.850,20.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3148912				0	vi	\<bookmark_value\>tính;khấu hao số cộng\</bookmark_value\>\<bookmark_value\>khấu hao;số cộng\</bookmark_value\>\<bookmark_value\>khấu hao số cộng\</bookmark_value\>\<bookmark_value\>khấu hao theo đường thẳng\</bookmark_value\>\<bookmark_value\>hàm SLN\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3148912				0	vi	SLN				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149154	291			0	vi	\<ahelp hid=\"HID_FUNC_LIA\"\>Trả về khấu hao theo đường thẳng của một tài sản trong một thời kỳ.\</ahelp\>Số tiền khấu hao không thay đổi trong thời kỳ khấu hao.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153240				0	vi	Cú pháp				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3166456				0	vi	SLN(Giá; Cứu; Tuổi)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3146955				0	vi	\<emph\>Giá\</emph\> là giá đầu tiên của một tài sản.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149796				0	vi	\<emph\>Cứu\</emph\> là giá trị của một tài sản khi kết thúc thời kỳ khấu hao.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3166444				0	vi	\<emph\>Tuổi\</emph\> là thời kỳ khấu hao xác định số các thời kỳ trong tiến trình khấu hao tài sản.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3155579				0	vi	Ví dụ				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154098				0	vi	Thiết bị văn phòng có giá đầu tiên 50.000 đơn vị tiền tệ sẽ bị khấu hao trong 7 năm. Giá trị ở kết thúc tiến trình khấu hao sẽ là 3.500 đơn vị tiền tệ.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153390				0	vi	\<item type=\"input\"\>=SLN(50000;3,500;84)\</item\> = 553.57 đơn vị tiền tệ. Khấu hao hàng tháng định kỳ của thiết bị văn phòng là 553,57 đơn vị tiền tệ.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3153739				0	vi	\<bookmark_value\>hàm MDURATION\</bookmark_value\>\<bookmark_value\>khoảng thời gian Macauley\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153739				0	vi	MDURATION				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149923				0	vi	\<ahelp hid=\"HID_AAI_FUNC_MDURATION\"\>Tính thời lượng Macauley đã sửa đổi của một chứng khoán lãi suất cố định, theo năm.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149964				0	vi	Cú pháp				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148987				0	vi	MDURATION(Thanh_toán; Đến_hạn; Phiếu; Lợi; Tần_số; Cơ_bản)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148619				0	vi	\<emph\>Thanh_toán\</emph\> là ngày tháng đã mua chứng khoán.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149805				0	vi	\<emph\>Đến_hạn\</emph\> là ngày tháng vào đó chứng khoán hết hạn dùng.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154338				0	vi	\<emph\>Phiếu\</emph\> là lãi xuất danh nghĩa hàng năm (lãi suất trái phiếu).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148466				0	vi	\<emph\>Lợi\</emph\> là tổng lợi tức hàng năm của chứng khoán.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149423				0	vi	\<emph\>Tần_số\</emph\> là số lần trả tiền lãi trong mỗi năm (1, 2 hoặc 4).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154602				0	vi	Ví dụ				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3148652				0	vi	Một chứng khoán được mua vào ngày 2001-00-01; ngày đến hạn thanh toán là 2006-01-01. Lãi suất danh nghĩa là 8%. Lợi tức là 9,0%. Tiền lãi được trả mỗi nửa năm (tần số là 2). Dùng phép tính tiền lãi kết toán hàng ngày (cơ bản 3), thời lượng đã sửa đổi là bao lâu?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145378				0	vi	=MDURATION("2001-01-01"; "2006-01-01"; 0.08; 0.09; 2; 3) trả về 4,02 năm.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3149242				0	vi	\<bookmark_value\>tính;giá trị hiện tại ròng\</bookmark_value\>\<bookmark_value\>giá trị hiện tại ròng\</bookmark_value\>\<bookmark_value\>hàm NPV\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149242				0	vi	NPV				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3145308				0	vi	\<ahelp hid=\"HID_FUNC_NBW\"\>Trả về giá trị hiện tại của một đầu tư dựa vào một chuỗi luồng tiền định kỳ và một tỷ lệ chiết khấu. Để tính giá trị hiện tại ròng, hãy trừ giá của dự án (luồng tiền đầu tiên vào giờ số không) từ giá trị đã trả về.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149937				0	vi	Cú pháp				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153321				0	vi	NPV(Tỷ_lệ; Giá_trị1; Giá_trị2; ...)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150630				0	vi	\<emph\>Tỷ_lệ\</emph\> là suất chiết khấu trong một thời kỳ.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3150427				0	vi	\<emph\>Giá_trị1;...\</emph\> là đến 30 giá tị đại diện tiền cọc hay tiền rút.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3153538				0	vi	Ví dụ				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154800				0	vi	What is the net present value of periodic payments of 10, 20 and 30 currency units with a discount rate of 8.75%. At time zero the costs were paid as -40 currency units.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3143270				0	vi	\<item type=\"input\"\>=NPV(8.75%;10;20;30)\</item\> = 49,43 đơn vị tiền tệ. Giá trị hiện tại ròng là giá trị đã trả về trừ giá đầu tiên 40 đơn vị tiền tệ, thì hiệu là 9,43 đơn vị tiền tệ.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3149484				0	vi	\<bookmark_value\>tính;lãi suất danh nghĩa\</bookmark_value\>\<bookmark_value\>lãi suất danh nghĩa\</bookmark_value\>\<bookmark_value\>hàm NOMINAL\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3149484				0	vi	NOMINAL				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149596				0	vi	\<ahelp hid=\"HID_FUNC_NOMINAL\"\>Tính lãi suất danh nghĩa hàng năm, tùy theo lãi suất hiệu dụng và số các thời kỳ kép mỗi năm.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3151252				0	vi	Cú pháp				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3152769				0	vi	NOMINAL(Suất_hiệu; NPerY)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147521				0	vi	\<emph\>Suất_hiệu\</emph\> là lãi suất hiệu dụng.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156334				0	vi	\<emph\>NPerY\</emph\> là số các sự trả tiền lãi định kỳ trong mỗi năm.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154473				0	vi	Ví dụ				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147091				0	vi	Có lãi suất hiệu dụng 13,5% và trả 12 lần trong một năm thì có bao nhiêu tiền lãi danh nghĩa?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154831				0	vi	\<item type=\"input\"\>=NOMINAL(13.5%;12)\</item\> = 12,73%. Lãi suất danh nghĩa mỗi năm là 12,73%.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3155123				0	vi	\<bookmark_value\>hàm NOMINAL_ADD\</bookmark_value\>				20200411 15:09:53
