helpcontent2	source\text\shared\optionen\01130100.xhp	0	help	par_id0523200811475733				0	vi	\<ahelp hid=\".\"\>Mã VBA (Visual Basic for Applications) sẽ được nạp sẵn sàng thực hiện. Nếu tùy chọn này không được hiệu lực, mã VBA sẽ bị ghi chú tắt để xem nhưng không chạy.\</ahelp\>				20200411 15:09:53
