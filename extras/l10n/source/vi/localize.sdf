helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3151052				0	vi	\<ahelp hid=\"HID_FUNC_ZINS\"\>Trả về lãi suất cố định trong mỗi thời kỳ của một tiền trợ cấp hàng năm.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3154272				0	vi	Cú pháp				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3158423				0	vi	RATE(NPer; Pmt; PV; FV; Kiểu; Đoán)				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148910				0	vi	\<emph\>NPer\</emph\> là tổng số thời kỳ, trong chúng trả tiền (thời kỳ trả tiền).				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3148925				0	vi	\<emph\>Pmt\</emph\> là số tiền cố định (tiền trợ cấp hàng năm) được trả mỗi thời kỳ.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3149160				0	vi	\<emph\>PV\</emph\> là giá trị tiền mặt trong dãy các sự trả tiền.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3166456				0	vi	\<emph\>FV\</emph\> (tùy chọn) là giá trị tương lai được tới ở kết thúc các sự trả tiền định kỳ.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3153243				0	vi	\<emph\>Kiểu\</emph\> (tùy chọn) là ngày hết hạn của sự trả tiền định kỳ, hoặc ở đầu hoặc cuối của một thời kỳ.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3146949				0	vi	\<emph\>Đoán\</emph\> (tùy chọn) quyết định giá trị xấp xỉ của tiền lãi khi tính lặp lại.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_idN10E2A				0	vi	\<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	hd_id3149791				0	vi	Thí dụ				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3150706				0	vi	Lãi suất cố định trong 3 thời kỳ là gì nếu 10 đơn vị tiền tệ được trả đều và giá trị tiền mặt hiện tại là 900 đơn vị tiền tệ?				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	par_id3155586				0	vi	\<item type=\"input\"\>=RATE(3;10;900)\</item\> = -121% Lãi suất thì là 121%.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060118.xhp	0	help	bm_id3149106				0	vi	\<bookmark_value\>hàm INTRATE\</bookmark_value\>				20200411 15:09:53
