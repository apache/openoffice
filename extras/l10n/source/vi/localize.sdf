helpcontent2	source\text\swriter\01\02110000.xhp	0	help	par_id3155828				0	vi	\<ahelp hid=\"HID_NAVI_TBX4\"\>Đặt các tùy chọn kéo và thả để chèn mục từ \<emph\>Bộ điều hướng\</emph\> vào tài liệu, chẳng hạn, dạng siêu liên kết. Nhấn vào biểu tượng này, sau đó bật tùy chọn thích hợp.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\swriter\01\02110000.xhp	0	help	par_id3155120				0	vi	\<image id=\"img_id3155126\" src=\"res/commandimagelist/sc_chainframes.png\" width=\"0.2228in\" height=\"0.2228in\"\>\<alt id=\"alt_id3155126\"\>Icon\</alt\>\</image\>				20200411 15:09:53
