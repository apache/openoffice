helpcontent2	source\text\shared\optionen\01030300.xhp	0	help	par_id1909848				0	vi	\<ahelp hid=\".\"\>Bật tùy chọn này thì %PRODUCTNAME sẽ cất giữ bảo mật tất cả các mật khẩu bạn dùng để truy cập đến tập tin nằm trên máy phục vụ Web. Bạn cũng có thể lấy các mật khẩu từ danh sách này, một khi nhập mật khẩu chủ.\</ahelp\>				20200411 15:09:53
