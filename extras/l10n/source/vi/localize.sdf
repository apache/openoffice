helpcontent2	source\text\shared\autopi\01020300.xhp	0	help	par_idN105E2				0	vi	\<ahelp hid=\".\"\>Chèn vào tài liệu bộ giữ chỗ cho địa chỉ trên mẫu điện thư. Lúc sau trong tài liệu điện thư, nhấn vào bộ giữ chỗ để nhập dữ liệu thật.\</ahelp\>				20200411 15:09:53
helpcontent2	source\text\shared\autopi\01020300.xhp	0	help	par_idN105E5				0	vi	Địa chỉ trả về mới				20200411 15:09:53
