helpcontent2	source\text\shared\explorer\database\rep_main.xhp	0	help	par_id0409200922242612				0	vi	\<ahelp hid=\".\" visibility=\"hidden\"\>Thu nhỏ đoạn đã chọn để  loại bỏ khoảng trống ở đỉnh và đáy.\</ahelp\>				20200411 15:09:53
