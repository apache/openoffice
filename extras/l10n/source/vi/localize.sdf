helpcontent2	source\text\shared\autopi\01090600.xhp	0	help	par_idN105C5				0	vi	\<ahelp hid=\".\"\>Lưu biểu mẫu, sau đó mở nó dạng tài liệu biểu mẫu để nhập và hiển thị dữ liệu.\</ahelp\>				20200411 15:09:53
