helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3159179				0	vi	\<emph\>Thanh_toán\</emph\> là ngày tháng đã mua chứng khoán.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3154304				0	vi	\<emph\>Đến_hạn\</emph\> là ngày tháng vào đó chứng khoán hết hạn dùng.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3156014				0	vi	\<emph\>Hạ_giá\</emph\> là phần trăm giảm giá của chứng khoán.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3147489				0	vi	\<emph\>Trả_hết\</emph\> là giá trị trả hết của chứng khoán cho mỗi 100 đơn vị tiền tệ mệnh giá.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3152794				0	vi	Ví dụ				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3149198				0	vi	Một chứng khoán được mua vào ngày 1999-02-15; ngày đến hạn là 1999-03-01. Giảm giá theo 5,25%. Giá trị trả hết là 100. Khi tính trên cơ bản 2, giá bị giảm như theo đây:				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3151178				0	vi	=PRICEDISC("1999-02-15"; "1999-03-01"; 0.0525; 100; 2) trả về 99,79583.				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	bm_id3154693				0	vi	\<bookmark_value\>hàm PRICEMAT\</bookmark_value\>\<bookmark_value\>giá;chứng khoán trả tiền lãi\</bookmark_value\>				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	hd_id3154693				0	vi	PRICEMAT				20200411 15:09:53
helpcontent2	source\text\scalc\01\04060119.xhp	0	help	par_id3153906				0	vi	\<ahelp hid=\"HID_AAI_FUNC_PRICEMAT\"\>Tính giá mỗi 100 đơn vị tiền tệ mệnh giá của một chứng khoán, mà trả tiền lãi vào ngày đến hạn.\</ahelp\>				20200411 15:09:53
