helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3152986				0	bs	\<variable id=\"texttext\"\>This section contains descriptions of the \<emph\>Text\</emph\> functions. \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149384				0	bs	\<bookmark_value\>ARABIC function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149384				0	bs	ARABIC				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153558				0	bs	\<ahelp hid=\"HID_FUNC_ARABISCH\"\>Calculates the value of a Roman number. The value range must be between 0 and 3999.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153011				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155523				0	bs	ARABIC (Text)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151193	243			0	bs	\<emph\>Text\</emph\> is the text that represents a Roman number.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155758				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154621	245			0	bs	Arabic("MXIV") returns 1014				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147553	246			0	bs	Arabic("MMII") returns 2002				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3153072				0	bs	\<bookmark_value\>BASE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153072				0	bs	BASE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153289				0	bs	\<ahelp hid=\"HID_FUNC_BASIS\"\>Converts a positive integer to a specified base into a text from the \<link href=\"text/shared/00/00000005.xhp#zahlensystem\" name=\"numbering system\"\>numbering system\</link\>.\</ahelp\> The digits 0-9 and the letters A-Z are used.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146097				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155743				0	bs	BASE(Number; Radix; [Minimum length])				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151339	217			0	bs	\<emph\>number\</emph\> is the positive integer to be converted.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3159262	218			0	bs	\<emph\>radix\</emph\> indicates the base of the number system. It may be any positive integer between 2 and 36.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148746	219			0	bs	\<emph\>Minimum length\</emph\> (optional) determines the minimum length of the character sequence that has been created. If the text is shorter than the indicated minimum length, zeros are added to the left of the string.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146323				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3156399				0	bs	\<bookmark_value\>decimal system; converting to\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156399	221			0	bs	BASE(17;10;4) returns 0017 in the decimal system.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3157871				0	bs	\<bookmark_value\>binary system; converting to\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3157871	222			0	bs	BASE(17;2) returns 10001 in the binary system.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3145226				0	bs	\<bookmark_value\>hexadecimal system; converting to\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145226	223			0	bs	BASE(255;16;4) returns 00FF in the hexadecimal system.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149321				0	bs	\<bookmark_value\>CHAR function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149321				0	bs	CHAR				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149150				0	bs	\<ahelp hid=\"HID_FUNC_ZEICHEN\"\>Converts a number into a character according to the current code table.\</ahelp\> The number can be a two-digit or three-digit integer number.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149945				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145634				0	bs	CHAR(number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155906	205			0	bs	\<emph\>number\</emph\> is a number between 1 and 255 representing the code value for the character.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152982				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149890	208			0	bs	CHAR(100) returns the character "d".				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149009				0	bs	\<bookmark_value\>CLEAN function\</bookmark_value\>				2002-02-02 02:02:02
