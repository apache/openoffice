helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3155901	18			0	bs	\<variable id=\"bearbeitenzeichen\"\>\<ahelp hid=\"SW:EDIT:DLG_INS_FOOTNOTE:ED_NUMBER_CHAR\"\>Choose this option to define a character or symbol for the current footnote.\</ahelp\> This can be either a letter or number. To assign a special character, click the button at the bottom.\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04030000.xhp	0	help	par_id3153526				0	bs	\<variable id=\"bearbeitensonderzeichen\"\>\<ahelp hid=\"SW:PUSHBUTTON:DLG_INS_FOOTNOTE:BT_NUMBER_CHAR\"\>Inserts a \<link href=\"text/shared/01/04100000.xhp\" name=\"special character \"\>special character \</link\> as a footnote or endnote anchor.\</ahelp\>\</variable\>				2002-02-02 02:02:02
