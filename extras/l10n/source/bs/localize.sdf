helpcontent2	source\text\shared\autopi\startup.xhp	0	help	par_idN10562				0	bs	Welcome				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\startup.xhp	0	help	par_idN10566				0	bs	\<ahelp hid=\".\"\>The Start-up Wizard helps you to specify the user settings for %PRODUCTNAME. This wizard only runs once.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\startup.xhp	0	help	par_idN10575				0	bs	License				2002-02-02 02:02:02
helpcontent2	source\text\shared\autopi\startup.xhp	0	help	par_idN10579				0	bs	\<ahelp hid=\".\"\>Read and accept the license text. You need to scroll to the end of the license text before you can continue.\</ahelp\>				2002-02-02 02:02:02
