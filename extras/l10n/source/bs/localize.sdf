helpcontent2	source\text\scalc\01\func_year.xhp	0	help	par_id3156013				0	bs	\<emph\>Number\</emph\> shows the internal date value for which the year is to be returned.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_year.xhp	0	help	hd_id3152797				0	bs	Examples				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_year.xhp	0	help	par_id3145668				0	bs	Year(1) returns 1899				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_year.xhp	0	help	par_id3151168				0	bs	YEAR(2) returns 1900				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_year.xhp	0	help	par_id3150115				0	bs	YEAR(33333.33) returns 1991				2002-02-02 02:02:02
