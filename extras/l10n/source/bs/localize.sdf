helpcontent2	source\text\shared\02\09070000.xhp	0	help	par_id3149234				0	bs	\<ahelp hid=\"HID_ICCDIALOG_RESET_BTN\"\>Resets the entries in the dialog to their original state.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170902.xhp	0	help	tit				0	bs	Combo/List Box Wizard: Field Selection				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170902.xhp	0	help	hd_id3153323				0	bs	\<link href=\"text/shared/02/01170902.xhp\" name=\"Combo/List Box Wizard: Field Selection\"\>Combo/List Box Wizard: Field Selection\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170902.xhp	0	help	par_id3154228				0	bs	Select the data field specified in the table on previous page, whose contents should be displayed in the list or combo box.				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170902.xhp	0	help	hd_id3153894				0	bs	Available Fields				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170902.xhp	0	help	par_id3093440				0	bs	\<ahelp hid=\"DBP_LISTBOX_RID_PAGE_LCW_CONTENTSELECTION_FIELD_LB_SELECTFIELD\"\>Displays all table fields chosen on the previous Wizard page.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170902.xhp	0	help	hd_id3145669				0	bs	Display Field				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170902.xhp	0	help	par_id3145136				0	bs	\<ahelp hid=\"DBP_EDIT_RID_PAGE_LCW_CONTENTSELECTION_FIELD_ET_DISPLAYEDFIELD\"\>Specifies the field whose data are to be shown in the combo or list boxes.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\01170902.xhp	0	help	par_id3145345				0	bs	The field name given here appears in the \<link href=\"text/shared/02/01170102.xhp\" name=\"Control properties\"\>Control properties\</link\> as an element of an SQL statement in the \<emph\>List Contents\</emph\> field.				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\03130000.xhp	0	help	tit				0	bs	Borders				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\03130000.xhp	0	help	hd_id3143284				0	bs	\<link href=\"text/shared/02/03130000.xhp\" name=\"Borders\"\>Borders\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\03130000.xhp	0	help	par_id3153255				0	bs	\<ahelp hid=\".uno:SetBorderStyle\"\>Click the \<emph\>Borders\</emph\> icon to open the \<emph\>Borders\</emph\> toolbar, where you can modify the border of a sheet area or an object.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\03130000.xhp	0	help	par_id3147261				0	bs	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>\</caseinline\>\<defaultinline\>This object can be the border of a text frame, a graphic or a table. The icon will only be visible if a graphic, table, object or frame has been selected.\</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\03130000.xhp	0	help	par_id3147226	6			0	bs	\<switchinline select=\"appl\"\>\<caseinline select=\"CALC\"\>To apply a particular type of border to a single cell, position the cursor in the cell, open the \<emph\>Border\</emph\> toolbar and select a border. \</caseinline\>\<defaultinline\>Whenever you insert graphics or tables, they already have a complete border. To remove that border, select the graphic object or the entire table and click the "no border" icon on the \<emph\>Border\</emph\> toolbar.\</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\03130000.xhp	0	help	par_id3147576				0	bs	\<image id=\"img_id3149095\" src=\"res/commandimagelist/sc_setborderstyle.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3149095\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\03130000.xhp	0	help	par_id3152780				0	bs	Borders				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\03130000.xhp	0	help	par_id3148990				0	bs	Further information can be found in the Help in \<link href=\"text/shared/01/05030500.xhp\" name=\"Borders\"\>\<emph\>Borders\</emph\>\</link\>. You can also find information on how to \<link href=\"text/shared/guide/border_table.xhp\" name=\"format a text table\"\>format a text table\</link\> with the \<emph\>Borders\</emph\> icon.				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\05020000.xhp	0	help	tit				0	bs	Arrow Style				2002-02-02 02:02:02
