helpcontent2	source\text\shared\02\09070000.xhp	0	help	par_id3154927				0	bs	\<image id=\"img_id3093440\" src=\"res/commandimagelist/sc_hyperlinkdialog.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3093440\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
