helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3154511				0	bs	\<bookmark_value\>MAX function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154511				0	bs	MAX				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153709				0	bs	\<ahelp hid=\"HID_FUNC_MAX\"\>Returns the maximum value in a list of arguments.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154256				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147340				0	bs	MAX(Number 1; Number 2; ...Number 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149568	6			0	bs	\<emph\>Number 1; Number 2;...Number 30\</emph\> are numerical values or ranges. 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153963				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147343				0	bs	=MAX(A1;A2;A3;50;100;200) returns the largest value from the list.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148485				0	bs	=MAX(A1:B100) returns the largest value from the list.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3166426				0	bs	\<bookmark_value\>MAXA function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3166426				0	bs	MAXA				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150363				0	bs	\<ahelp hid=\"HID_FUNC_MAXA\"\>Returns the maximum value in a list of arguments. In opposite to MAX, here you can enter text. The value of the text is 0.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150516				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3166431				0	bs	MAXA(Value 1; Value 2; ... Value 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150202				0	bs	\<emph\>Value 1; Value 2;...Value 30\</emph\> are values or ranges. Text has the value of 0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3156290				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156446				0	bs	=MAXA(A1;A2;A3;50;100;200;"Text") returns the largest value from the list.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149404				0	bs	=MAXA(A1:B100) returns the largest value from the list.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153820				0	bs	\<bookmark_value\>MEDIAN function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153820				0	bs	MEDIAN				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151241				0	bs	\<ahelp hid=\"HID_FUNC_MEDIAN\"\>Returns the median of a set of numbers. In a set containing an uneven number of values, the median will be the number in the middle of the set and in a set containing an even number of values, it will be the mean of the two values in the middle of the set.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148871				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155264				0	bs	MEDIAN(Number 1; Number 2; ...Number 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150109				0	bs	\<emph\>Number 1; Number 2;...Number 30\</emph\> are values or ranges, which represent a sample. Each number can also be replaced by a reference.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3144506				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145078				0	bs	for an odd number: =MEDIAN(1; 5; 9; 20; 21) returns 9 as the median value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149126				0	bs	for an even number: =MEDIAN(1; 5; 9; 20) returns the average of the two middle values 5 and 9, thus 7.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3154541				0	bs	\<bookmark_value\>MIN function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154541				0	bs	MIN				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3143222				0	bs	\<ahelp hid=\"HID_FUNC_MIN\"\>Returns the minimum value in a list of arguments.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154651				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146964				0	bs	MIN(Number 1; Number 2; ...Number 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153486				0	bs	\<emph\>Number 1; Number 2;...Number 30\</emph\> are numerical values or ranges.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155523				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154734				0	bs	=MIN(A1:B100) returns the smallest value in the list.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3147504				0	bs	\<bookmark_value\>MINA function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147504				0	bs	MINA				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147249				0	bs	\<ahelp hid=\"HID_FUNC_MINA\"\>Returns the minimum value in a list of arguments. Here you can also enter text. The value of the text is 0.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150435				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153336				0	bs	MINA(Value 1; Value 2; ... Value 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146098				0	bs	\<emph\>Value 1; Value 2;...Value 30\</emph\> are values or ranges. Text has the value of 0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148743				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147401				0	bs	=MINA(1; "Text"; 20) returns 0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147295				0	bs	=MINA(A1:B100) returns the smallest value in the list.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3166465				0	bs	\<bookmark_value\>AVEDEV function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3166465				0	bs	AVEDEV				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150373				0	bs	\<ahelp hid=\"HID_FUNC_MITTELABW\"\>Returns the average of the absolute deviations of data points from their mean.\</ahelp\> Displays the diffusion in a data set.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150038				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145636				0	bs	AVEDEV(Number 1; Number 2; ...Number 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3157871				0	bs	\<emph\>Number 1, Number 2,...Number 30\</emph\> are values or ranges that represent a sample. Each number can also be replaced by a reference.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149725				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153122				0	bs	=AVEDEV(A1:A50)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3145824				0	bs	\<bookmark_value\>AVERAGE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3145824				0	bs	AVERAGE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150482				0	bs	\<ahelp hid=\"HID_FUNC_MITTELWERT\"\>Returns the average of the arguments.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3146943				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154679				0	bs	AVERAGE(Number 1; Number 2; ...Number 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150741				0	bs	\<emph\>Number 1; Number 2;...Number 30\</emph\> are numerical values or ranges.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153039				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151232				0	bs	=AVERAGE(A1:A50)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148754				0	bs	\<bookmark_value\>AVERAGEA function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148754				0	bs	AVERAGEA				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145138				0	bs	\<ahelp hid=\"HID_FUNC_MITTELWERTA\"\>Returns the average of the arguments. The value of a text is 0.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153326				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149734				0	bs	AVERAGEA(Value 1; Value 2; ... Value 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155260				0	bs	\<emph\>Value 1; Value 2;...Value 30\</emph\> are values or ranges. Text has the value of 0.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149504				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150864				0	bs	=AVERAGEA(A1:A50)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153933				0	bs	\<bookmark_value\>MODE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153933				0	bs	MODE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153085				0	bs	\<ahelp hid=\"HID_FUNC_MODALWERT\"\>Returns the most common value in a data set.\</ahelp\> If there are several values with the same frequency, it returns the smallest value. An error occurs when a value doesn't appear twice.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153003				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155950				0	bs	MODE(Number 1; Number 2; ...Number 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150337				0	bs	\<emph\>Number 1; Number 2;...Number 30\</emph\> are numerical values or ranges.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153571				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153733				0	bs	=MODE(A1:A50)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3149879				0	bs	\<bookmark_value\>NEGBINOMDIST function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149879				0	bs	NEGBINOMDIST				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155437				0	bs	\<ahelp hid=\"HID_FUNC_NEGBINOMVERT\"\>Returns the negative binomial distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3145351				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150935				0	bs	NEGBINOMDIST(X; R; SP)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153044				0	bs	\<emph\>X\</emph\> represents the value returned for unsuccessful tests.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151018				0	bs	\<emph\>R\</emph\> represents the value returned for successful tests.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148878				0	bs	\<emph\>SP\</emph\> is the probability of the success of an attempt.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149539				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148770				0	bs	=NEGBINOMDIST(1; 1; 0.5) returns 0.25.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3155516				0	bs	\<bookmark_value\>NORMINV function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155516				0	bs	NORMINV				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154634				0	bs	\<ahelp hid=\"HID_FUNC_NORMINV\"\>Returns the inverse of the normal cumulative distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153227				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147534				0	bs	NORMINV(Number; Mean; STDEV)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154950				0	bs	\<emph\>Number\</emph\> represents the probability value used to determine the inverse normal distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150690				0	bs	\<emph\>Mean\</emph\> represents the mean value in the normal distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148594				0	bs	\<emph\>STDEV\</emph\> represents the standard deviation of the normal distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155822				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153921				0	bs	=NORMINV(0.9; 63; 5) returns 69.41. If the average egg weighs 63 grams with a standard deviation of 5, then there will be 90% probability that the egg will not be heavier than 69.41g grams.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153722				0	bs	\<bookmark_value\>NORMDIST function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153722				0	bs	NORMDIST				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150386				0	bs	\<ahelp hid=\"HID_FUNC_NORMVERT\"\>Returns the standard normal cumulative distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3083282				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150613				0	bs	NORMDIST(Number; Mean; STDEV; C)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149820				0	bs	\<emph\>Number\</emph\> is the value of the distribution based on which the normal distribution is to be calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146063				0	bs	\<emph\>Mean\</emph\> is the mean value of the distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156295				0	bs	\<emph\>STDEV\</emph\> is the standard deviation of the distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3145080				0	bs	\<emph\>C\</emph\> = 0 calculates the density function; \<emph\>C\</emph\> = 1 calculates the distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152972				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149283				0	bs	=NORMDIST(70; 63; 5; 0) returns 0.03.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149448				0	bs	=NORMDIST(70; 63; 5; 1) returns 0.92.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3152934				0	bs	\<bookmark_value\>PEARSON function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152934				0	bs	PEARSON				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153216				0	bs	\<ahelp hid=\"HID_FUNC_PEARSON\"\>Returns the Pearson product moment correlation coefficient r.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147081				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156133				0	bs	PEARSON(Data_1; Data_2)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151272				0	bs	\<emph\>Data_1\</emph\> represents the array of the first data set.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153279				0	bs	\<emph\>Data_2\</emph\> represents the array of the second data set.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147567				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151187				0	bs	=PEARSON(A1:A30; B1:B30) returns the Pearson correlation coefficient of both data sets.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3152806				0	bs	\<bookmark_value\>PHI function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152806				0	bs	PHI				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150254				0	bs	\<ahelp hid=\"HID_FUNC_PHI\"\>Returns the values of the distribution function for a standard normal distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154748				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149976				0	bs	PHI(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3156108				0	bs	\<emph\>Number\</emph\> represents the value based on which the standard normal distribution is calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153621				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155849				0	bs	PHI(2.25) = 0.03				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3143236				0	bs	PHI(-2.25) = 0.03				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149286				0	bs	PHI(0) = 0.4				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153985				0	bs	\<bookmark_value\>POISSON function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153985				0	bs	POISSON				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154298				0	bs	\<ahelp hid=\"HID_FUNC_POISSON\"\>Returns the Poisson distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3159183				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146093				0	bs	POISSON(Number; Mean; C)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147253				0	bs	\<emph\>Number\</emph\> represents the value based on which the Poisson distribution is calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3151177				0	bs	\<emph\>Mean\</emph\> represents the middle value of the Poisson distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149200				0	bs	\<emph\>C\</emph\> = 0 calculates the density function; \<emph\>C\</emph\> = 1 calculates the distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3159347				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3150113				0	bs	=POISSON(60;50;1) returns 0.93.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3153100				0	bs	\<bookmark_value\>PERCENTILE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3153100				0	bs	PERCENTILE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154940				0	bs	\<ahelp hid=\"HID_FUNC_QUANTIL\"\>Returns the alpha-percentile of data values in an array.\</ahelp\> A percentile returns the scale value for a data series which goes from the smallest (Alpha=0) to the largest value (alpha=1) of a data series. For \<emph\>Alpha\</emph\> = 25%, the percentile means the first quartile; \<emph\>Alpha\</emph\> = 50% is the MEDIAN.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3150531				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148813				0	bs	PERCENTILE(Data;Alpha)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153054				0	bs	\<emph\>Data\</emph\> represents the array of data.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154212				0	bs	\<emph\>Alpha\</emph\> represents the percentage of the scale between 0 and 1.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3154290				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159147				0	bs	=PERCENTILE(A1:A50; 0.1) represents the value in the data set, which equals 10% of the total data scale in A1:A50.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3148807				0	bs	\<bookmark_value\>PERCENTRANK function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3148807				0	bs	PERCENTRANK				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153573				0	bs	\<ahelp hid=\"HID_FUNC_QUANTILSRANG\"\>Returns the percentage rank of a value in a sample.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3147512				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3147238				0	bs	PERCENTRANK(Data; Value)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3154266				0	bs	\<emph\>Data\</emph\> represents the array of data in the sample.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3148475				0	bs	\<emph\>Value\</emph\> represents the value whose percentile rank must be determined.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3155364				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3149163				0	bs	=PERCENTRANK(A1:A50; 50) returns the percentage rank of the value 50 from the total range of all values found in A1:A50. If 50 falls outside the total range, an error message will appear.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	bm_id3166442				0	bs	\<bookmark_value\>QUARTILE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3166442				0	bs	QUARTILE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3146958				0	bs	\<ahelp hid=\"HID_FUNC_QUARTILE\"\>Returns the quartile of a data set.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3152942				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153684				0	bs	QUARTILE(Data; Type)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3153387				0	bs	\<emph\>Data\</emph\> represents the array of data in the sample.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3155589				0	bs	\<emph\>Type\</emph\> represents the type of quartile. (0 = MIN, 1 = 25%, 2 = 50% (MEDIAN), 3 = 75% and 4 = MAX.)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	hd_id3149103				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060184.xhp	0	help	par_id3159276				0	bs	=QUARTILE(A1:A50; 2) returns the value of which 25% of the scale corresponds to the lowest to highest values in the range A1:A50.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	tit				0	bs	Error Alert				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3153821				0	bs	\<link href=\"text/scalc/01/12120300.xhp\" name=\"Error Alert\"\>Error Alert\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3153379				0	bs	\<ahelp hid=\"SC:TABPAGE:TP_VALIDATION_ERROR\"\>Define the error message that is displayed when invalid data is entered in a cell.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3154138				0	bs	You can also start a macro with an error message. A sample macro is provided at the end of this page.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3156280				0	bs	Show error message when invalid values are entered.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3146984	5			0	bs	In both cases, if you select "Stop", the invalid entry is deleted and the previous value is reentered in the cell. The same applies if you close the "Warning" and "Information" dialogs by clicking the \<emph\>Cancel \</emph\>button. If you close the dialogs with the \<emph\>OK\</emph\> button, the invalid entry is not deleted.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3152460				0	bs	Contents				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3148646				0	bs	Action				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3151115				0	bs	\<ahelp hid=\"SC:LISTBOX:TP_VALIDATION_ERROR:LB_ACTION\"\>Select the action that you want to occur when invalid data is entered in a cell.\</ahelp\> The "Stop" action rejects the invalid entry and displays a dialog that you have to close by clicking \<emph\>OK\</emph\>. The "Warning" and "Information" actions display a dialog that can be closed by clicking \<emph\>OK\</emph\> or \<emph\>Cancel\</emph\>. The invalid entry is only rejected when you click \<emph\>Cancel\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3156441				0	bs	Browse				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3153160				0	bs	\<ahelp hid=\"SC:PUSHBUTTON:TP_VALIDATION_ERROR:BTN_SEARCH\"\>Opens the \<link href=\"text/shared/01/06130000.xhp\" name=\"Macro\"\>Macro\</link\> dialog where you can select the macro that is executed when invalid data is entered in a cell. The macro is executed after the error message is displayed.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3153876				0	bs	Title				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3149410				0	bs	\<ahelp hid=\"SC:EDIT:TP_VALIDATION_ERROR:EDT_TITLE\"\>Enter the title of the macro or the error message that you want to display when invalid data is entered in a cell.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	hd_id3154510				0	bs	Error message				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\12120300.xhp	0	help	par_id3149122				0	bs	\<ahelp hid=\"SC:MULTILINEEDIT:TP_VALIDATION_ERROR:EDT_ERROR\"\>Enter the message that you want to display when invalid data is entered in a cell.\</ahelp\>				2002-02-02 02:02:02
