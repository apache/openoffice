helpcontent2	source\text\swriter\01\04120222.xhp	0	help	tit				0	bs	Entries (alphabetical index)				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120222.xhp	0	help	hd_id3147506				0	bs	\<link href=\"text/swriter/01/04120222.xhp\" name=\"Entries (alphabetical index)\"\>Entries (alphabetical index)\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120222.xhp	0	help	par_id3154100	2			0	bs	\<variable id=\"eintraege\"\>Specify the format of the alphabetical index entries.\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120222.xhp	0	help	par_id3153532				0	bs	Level "S" refers to the single letter headings that divide the index entries alphabetically. To enable these headings, select the \<emph\>Alphabetical delimiter\</emph\> check box in the \<emph\>Format\</emph\> area.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120222.xhp	0	help	hd_id3152957				0	bs	Chapter Info				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120222.xhp	0	help	par_id3154573	5			0	bs	\<ahelp visibility=\"visible\" hid=\"SW:PUSHBUTTON:TP_TOX_ENTRY:PB_CHAPTERINFO\"\>Inserts chapter information, such as the chapter heading and number. Select the information that you want to display in the \<emph\>Chapter entry \</emph\>box.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120222.xhp	0	help	hd_id3149692				0	bs	Chapter entry				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120222.xhp	0	help	par_id3155174				0	bs	\<ahelp hid=\"SW:LISTBOX:TP_TOX_ENTRY:LB_CHAPTERENTRY\" visibility=\"visible\"\>Select the chapter information that you want to include in the index entry.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120222.xhp	0	help	hd_id3149493				0	bs	Character Style for main entries				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120222.xhp	0	help	par_id3149109				0	bs	\<ahelp hid=\"SW:LISTBOX:TP_TOX_ENTRY:LB_MAIN_ENTRY_STYLE\" visibility=\"visible\"\>Specify the formatting style for the main entries in the alphabetical index. To convert an index entry into a main entry, click in front of the index field in the document and then choose \<emph\>Edit - \</emph\>\<emph/\>\<link href=\"text/swriter/01/04120100.xhp\" name=\"Index Entry\"\>\<emph\>Index Entry\</emph\>\</link\>.\</ahelp\> 				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120222.xhp	0	help	hd_id3148977				0	bs	Alphabetical delimiter				2002-02-02 02:02:02
