helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3156076				0	bs	TIME("0;0;0") returns 00:00:00				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_time.xhp	0	help	par_id3156090				0	bs	TIME("4;20;4") returns 04:20:04				2002-02-02 02:02:02
