helpcontent2	source\text\swriter\01\04070300.xhp	0	help	par_id3148968				0	bs	\<ahelp hid=\"ITM_VER_CNTR\"\>Feeds the envelope vertically from the center of the printer tray.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070300.xhp	0	help	hd_id3153633				0	bs	Vertical right				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070300.xhp	0	help	par_id3149037				0	bs	\<ahelp hid=\"ITM_VER_RGHT\"\>Feeds the envelope vertically from the right edge of the printer tray.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070300.xhp	0	help	hd_id3152773				0	bs	Print from top				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070300.xhp	0	help	par_id3145763				0	bs	\<ahelp hid=\"SW:RADIOBUTTON:TP_ENV_PRT:BTN_TOP\"\>Feeds the envelope with the print side face up in the printer tray.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070300.xhp	0	help	hd_id3155146				0	bs	Print from bottom				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070300.xhp	0	help	par_id3149178				0	bs	\<ahelp hid=\"SW:RADIOBUTTON:TP_ENV_PRT:BTN_BOTTOM\"\>Feeds the envelope with the print side face down in the printer tray.\</ahelp\>				2002-02-02 02:02:02
