helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3150699				0	bs	\<ahelp hid=\"HID_SMA_CSUBX\"\>Inserts a subscript directly under a placeholder.\</ahelp\> You can also type \<emph\><?>csub<?>\</emph\> directly in the \<emph\>Commands\</emph\> window.				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_idN10226				0	bs	\<image id=\"img_id3145265\" src=\"starmath/res/co21904.png\" width=\"0.3335inch\" height=\"0.3335inch\"\>\<alt id=\"alt_id3145265\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3145136				0	bs	Subscript right				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3146913				0	bs	\<ahelp hid=\"HID_SMA_RSUBX\"\>Inserts a subscript to the right of a placeholder.\</ahelp\> You can also type \<emph\><?>_{<?>}\</emph\> in the \<emph\>Commands\</emph\> window, and the subscript dash can be replaced by \<emph\>rsub\</emph\> or \<emph\>sub\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_idN10265				0	bs	\<image id=\"img_id3149220\" src=\"starmath/res/co21906.png\" width=\"0.3335inch\" height=\"0.3335inch\"\>\<alt id=\"alt_id3149220\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3147116				0	bs	Vertical stack (3 elements)				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3146332				0	bs	\<ahelp hid=\"HID_SMA_STACK\"\>Inserts a vertical stack with three placeholders.\</ahelp\> You can also type \<emph\>stack {<?>#<?>#<?>}\</emph\> in the \<emph\>Commands\</emph\> window.				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_idN102A0				0	bs	\<image id=\"img_id3149848\" src=\"starmath/res/co21902.png\" width=\"0.3335inch\" height=\"0.3335inch\"\>\<alt id=\"alt_id3149848\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3155572				0	bs	Small gap				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3147056				0	bs	\<ahelp hid=\"HID_SMA_SBLANK\"\>Inserts a small gap between a placeholder and the next element.\</ahelp\> You can also type \<emph\>`\</emph\> directly in the Commands window. The command must appear to the left or right of a symbol, variable, number or complete command.				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_idN102DC				0	bs	\<image id=\"img_id3154094\" src=\"starmath/res/co21909.png\" width=\"0.3335inch\" height=\"0.3335inch\"\>\<alt id=\"alt_id3154094\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
