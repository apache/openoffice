helpcontent2	source\text\swriter\01\02110000.xhp	0	help	par_id3153768				0	bs	\<image id=\"img_id3150828\" src=\"sw/imglst/sc20171.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3150828\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
