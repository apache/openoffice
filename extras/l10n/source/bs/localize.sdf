helpcontent2	source\text\scalc\01\func_day.xhp	0	help	bm_id3147317				0	bs	\<bookmark_value\>DAY function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	hd_id3147317				0	bs	\<variable id=\"day\"\>\<link href=\"text/scalc/01/func_day.xhp\"\>DAY\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3147584				0	bs	\<ahelp hid=\"HID_FUNC_TAG\"\>Returns the day of given date value.\</ahelp\> The day is returned as an integer between 1 and 31. You can also enter a negative date/time value.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	hd_id3150487				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3149430				0	bs	DAY(Number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3149443				0	bs	\<emph\>Number\</emph\>, as a time value, is a decimal, for which the day is to be returned.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	hd_id3163809	111			0	bs	Examples 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3151200				0	bs	DAY(1) returns 31 (since $[officename] starts counting at zero from December 30, 1899)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3154130				0	bs	DAY(NOW()) returns the current day.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\func_day.xhp	0	help	par_id3159190				0	bs	DAY(C4) returns 5 if the contents of C4 = 8/5/1901.				2002-02-02 02:02:02
