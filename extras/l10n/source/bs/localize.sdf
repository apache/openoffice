helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3149064				0	bs	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Create table \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3146119				0	bs	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Creates a table when you press Enter after typing a series of hyphens (-) or tabs separated by plus signs, that is, +------+---+. Plus signs indicate column dividers, while hyphens and tabs indicate the width of a column. \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3147219				0	bs	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>+-----------------+---------------+------+ \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3153334				0	bs	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Apply Styles \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3147396				0	bs	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Automatically replaces the "Default" paragraph style with the Heading 1 to Heading 8 paragraph styles. To apply the Heading 1 paragraph style, type the text that you want to use as a heading (without a period), and then press Enter twice. To apply a sub-heading, press Tab one or more times, type the text (without a period), and then press Enter. \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3151075				0	bs	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Remove blank paragraphs \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3145728				0	bs	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Removes empty paragraphs from the current document when you choose \<emph\>Format - AutoFormat - Apply\</emph\>. \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3152375				0	bs	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Replace Custom Styles \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3156299				0	bs	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Replaces the custom paragraph styles in the current document with the "Default", the "Text Body", or the "Text Body Indent" paragraph style. \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3147045				0	bs	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Replace bullets with \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3150420				0	bs	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Converts paragraphs that start with a hyphen (-), a plus sign (+), or an asterisk (*) directly followed by a space or a tab, to bulleted lists. This option only works on paragraphs that are formatted with the "Default", "Text Body", or "Text Body Indent" paragraph styles. To change the bullet style that is used, select this option, and then click \<emph\>Edit\</emph\>. \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3151019				0	bs	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Combine single line paragraphs if length greater than ... \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	par_id3154162				0	bs	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Combines consecutive single-line paragraphs into a single paragraph. This option only works on paragraphs that use the "Default" paragraph style. If a paragraph is longer than the specified length value, the paragraph is combined with the next paragraph. To enter a different length value, select the option, and then click \<link href=\"text/swriter/01/05150104.xhp\"\>\<emph\>Edit\</emph\>\</link\>. \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\06040100.xhp	0	help	hd_id3144749				0	bs	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>Edit \</caseinline\>\</switchinline\>				2002-02-02 02:02:02
