helpcontent2	source\text\swriter\01\05060900.xhp	0	help	par_id3149708				0	bs	\<ahelp hid=\"HID_FRM_ADD\"\>Specifies properties for the selected object, graphic or frame.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	hd_id3151183				0	bs	Name				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	par_id3147568				0	bs	Specifies the name of the selected item, and associated links.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	hd_id3151178				0	bs	Name				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	par_id3147510				0	bs	\<ahelp hid=\"SW:EDIT:TP_FRM_ADD:ED_NAME\"\>Enter a name for the selected item.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	par_id3154565				0	bs	Assign an object, graphic or frame a meaningful name, so that you can quickly locate it afterwards in long documents.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	hd_id3153674				0	bs	Alternative text (floating frames, graphics, and objects only)				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	par_id3150977				0	bs	\<ahelp hid=\"SW:EDIT:TP_FRM_ADD:ED_ALT_NAME\"\>Enter the text to display in a web browser when the selected item is unavailable. Alternate text is also used to assist people with disabilities.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	hd_id3155903				0	bs	Previous link				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	par_id3154192				0	bs	\<ahelp hid=\"SW_LISTBOX_TP_FRM_ADD_LB_PREV\"\>Displays the item (object, graphic, or frame) that comes before the current item in a linked sequence. To add or change the previous link, select a name from the list. If you are linking frames, the current frame and the target frame must be empty.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	hd_id3159198				0	bs	Next link				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	par_id3149485				0	bs	\<ahelp hid=\"SW_LISTBOX_TP_FRM_ADD_LB_NEXT\"\>Displays the item (object, graphic, or frame) that comes after the current item in a linked sequence. To add or change the next link, select a name from the list. If you are a linking frames, the target frame must be empty.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	hd_id3143280				0	bs	Protect				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	par_id3154834				0	bs	Specifies protection options for the selected item.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	hd_id3149820				0	bs	Protect Contents				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	par_id3149105				0	bs	\<ahelp hid=\"SW:CHECKBOX:TP_FRM_ADD:CB_PROTECT_CONTENT\"\>Prevents changes to the contents of the selected item.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	par_id3147099				0	bs	You can still copy the contents of the selected item.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	hd_id3148979				0	bs	Protect Position				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	par_id3147225				0	bs	\<ahelp hid=\"SW:CHECKBOX:TP_FRM_ADD:CB_PROTECT_FRAME\"\>Locks the position of the selected item in the current document.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	hd_id3153629				0	bs	Protect Size				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	par_id3147576				0	bs	\<ahelp hid=\"SW:CHECKBOX:TP_FRM_ADD:CB_PROTECT_SIZE\"\>Locks the size of the selected item.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	hd_id3152770				0	bs	Properties				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	par_id3155137				0	bs	Specifies print and text options for the selected item.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	hd_id3153345				0	bs	Editable in read-only document (frames only)				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	par_id3149167				0	bs	\<ahelp hid=\"SW:CHECKBOX:TP_FRM_ADD:CB_EDIT_IN_READONLY\"\>Allows you to edit the contents of a frame in a document that is read-only (write-protected).\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	hd_id3156269				0	bs	Print				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	par_id3151028				0	bs	\<ahelp hid=\"SW:CHECKBOX:TP_FRM_ADD:CB_PRINT_FRAME\"\>Includes the selected item when you print the document.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	hd_id3145776				0	bs	Text flow				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	par_id3151374	32			0	bs	\<ahelp hid=\"SW_LISTBOX_TP_FRM_ADD_LB_TEXTFLOW\"\>Specifies the preferred text flow direction in a frame. To use the default text flow settings for the page, select \<emph\>Use superordinate object settings \</emph\>from the list.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060900.xhp	0	help	par_id3150689				0	bs	\<link href=\"text/shared/01/05040200.xhp\" name=\"Text direction\"\>Text direction\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	tit				0	bs	Edit Fields				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	hd_id3150493				0	bs	Edit Fields				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	par_id3151184				0	bs	\<variable id=\"feldbefehltext\"\>\<ahelp hid=\".uno:FieldDialog\"\>Opens a dialog where you can edit the properties of a field. Click in front of a field, and then choose this command.\</ahelp\> In the dialog, you can use the arrow buttons to move to the previous or the next field. \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	par_id3151168				0	bs	You can also double-click a field in your document to open the field for editing.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	par_id3153668				0	bs	To change the view between field names and field contents in your document, choose \<emph\>View - Fields\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	par_id3149106	59			0	bs	If you select a \<link href=\"text/shared/00/00000005.xhp#dde\" name=\"DDE\"\>DDE\</link\> link in your document, and then choose \<emph\>Edit - Fields, \</emph\>the \<link href=\"text/shared/01/02180000.xhp\" name=\"Edit Links\"\>\<emph\>Edit Links\</emph\>\</link\> dialog opens.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	par_id3149036				0	bs	If you click in front of a "sender" type field, and then choose \<emph\>Edit - Fields\</emph\>, the \<link href=\"text/shared/optionen/01010100.xhp\" name=\"User data\"\>\<emph\>User data\</emph\>\</link\> dialog opens.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	hd_id3145765				0	bs	Type				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	par_id3155142				0	bs	Lists the type of field that you are editing.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	par_id3151371				0	bs	The following dialog elements are only visible when the corresponding field type is selected.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	hd_id3150687				0	bs	Select				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	par_id3150700				0	bs	Lists the field options, for example, "fixed". If you want, you can click another option for the selected field type.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	hd_id3155854				0	bs	Format				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	par_id3147409				0	bs	\<ahelp hid=\"SW:LISTBOX:TP_FLD_DOK:LB_DOKNUMFORMAT\"\>Select the format for the contents of the field. For date, time, and user-defined fields, you can also click "Additional formats" in the list, and then choose a different format.\</ahelp\> The formats that are available depend on the type of field that you are editing.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	hd_id3149556				0	bs	Offset				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	par_id3145256				0	bs	Displays the offset for the selected field type, for example, for "Next Page," "Page Numbers" or "Previous Page". If you want, you can enter a new offset value.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	hd_id3145269				0	bs	Level				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	par_id3150559				0	bs	Change the defined values and outline levels for the "Chapter" field type.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	hd_id3147744				0	bs	Name				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	par_id3149834				0	bs	Displays the name of a field variable. If you want, you can enter a new name.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	hd_id3148844				0	bs	Value				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	par_id3148857				0	bs	Displays the current value of the field variable. If you want, you can enter a new value.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	hd_id3153306				0	bs	Condition				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	par_id3156124				0	bs	Displays the condition that must be met for the field to be activated. If you want, you can enter a new \<link href=\"text/swriter/01/04090200.xhp\" name=\"condition\"\>condition\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	hd_id3156103				0	bs	Then, Else				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02140000.xhp	0	help	par_id3155073				0	bs	Change the field contents that are displayed depending on whether the field condition is met or not.				2002-02-02 02:02:02
