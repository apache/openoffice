helpcontent2	source\text\swriter\01\04070300.xhp	0	help	hd_id3155921				0	bs	Shift down				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070300.xhp	0	help	par_id3151383				0	bs	\<ahelp hid=\"SW:METRICFIELD:TP_ENV_PRT:FLD_DOWN\"\>Enter the amount to shift the print area down.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070300.xhp	0	help	hd_id3150123				0	bs	Current printer				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070300.xhp	0	help	par_id3150696				0	bs	Displays the name of the current printer.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070300.xhp	0	help	hd_id3155862				0	bs	Setup				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070300.xhp	0	help	par_id3147418				0	bs	\<ahelp hid=\"SW:PUSHBUTTON:TP_ENV_PRT:BTN_PRTSETUP\"\>Opens the Print Setup dialog where you can define additional printer settings, such as paper format and orientation.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02170000.xhp	0	help	tit				0	bs	Edit Sections				2002-02-02 02:02:02
