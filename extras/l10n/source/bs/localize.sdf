helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	hd_id3153311				0	bs	\<link href=\"text/sbasic/shared/03120307.xhp\" name=\"Right Function [Runtime]\"\>Right Function [Runtime]\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3150984				0	bs	Returns the rightmost "n" characters of a string expression.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3149763				0	bs	See also: \<link href=\"text/sbasic/shared/03120303.xhp\" name=\"Left Function\"\>Left Function\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	hd_id3145315				0	bs	Syntax:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3153061				0	bs	Right (Text As String, n As Long)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	hd_id3145068				0	bs	Return value:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3156344				0	bs	String				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	hd_id3146795				0	bs	Parameters:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3153526				0	bs	\<emph\>Text:\</emph\> Any string expression that you want to return the rightmost characters of.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3151211				0	bs	\<emph\>n:\</emph\> Numeric expression that defines the number of characters that you want to return. If \<emph\>n\</emph\> = 0, a zero-length string is returned. The maximum allowed value is 65535.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3158410				0	bs	The following example converts a date in YYYY-MM-DD format to the US date format (MM/DD/YYYY).				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	hd_id3156212				0	bs	Example:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3150869				0	bs	Sub ExampleUSDate				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3153105				0	bs	Dim sInput As String				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3154124				0	bs	Dim sUS_date As String				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3159252				0	bs	sInput = InputBox("Please input a date in the international format 'YYYY-MM-DD'")				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3149561				0	bs	sUS_date = Mid(sInput, 6, 2)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3146984				0	bs	sUS_date = sUS_date & "/"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3155308				0	bs	sUS_date = sUS_date & Right(sInput, 2)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3153727				0	bs	sUS_date = sUS_date & "/"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3145365				0	bs	sUS_date = sUS_date & Left(sInput, 4)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3152940				0	bs	MsgBox sUS_date				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03120307.xhp	0	help	par_id3146120				0	bs	End Sub				2002-02-02 02:02:02
