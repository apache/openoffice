helpcontent2	source\text\shared\01\01110100.xhp	0	help	par_id3155432				0	bs	\<ahelp hid=\"HID_ORGANIZE_STDTEMPLATE_DEL\"\>Select a $[officename] document type to reset the default template to the original template.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01110100.xhp	0	help	hd_id3159196				0	bs	Address Book				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01110100.xhp	0	help	par_id3154472				0	bs	Edit the field assignments and the data source for the address book.				2002-02-02 02:02:02
