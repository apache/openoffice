helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3153544				0	bs	Name				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060101.xhp	0	help	par_id3158414				0	bs	Grade				2002-02-02 02:02:02
