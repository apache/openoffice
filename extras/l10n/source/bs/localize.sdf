helpcontent2	source\text\shared\02\18030000.xhp	0	help	hd_id3155599				0	bs	\<link href=\"text/shared/02/18030000.xhp\" name=\"AutoSpellcheck On/Off\"\>AutoSpellcheck On/Off\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\02\18030000.xhp	0	help	par_id3150040				0	bs	\<image src=\"res/commandimagelist/sc_spellonline.png\" id=\"img_id3150808\"\>\<alt id=\"alt_id3150808\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
