helpcontent2	source\text\swriter\01\04070300.xhp	0	help	par_id3153531				0	bs	\<ahelp hid=\"HID_ENV_PRT\"\>Set the print options for the envelope.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070300.xhp	0	help	par_id3152960				0	bs	Consult the documentation that came with your printer for setting up the printer for envelopes. Depending on the printer model, envelopes may have to be placed left, right, in the middle, and either face up or face down.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070300.xhp	0	help	hd_id3153665				0	bs	Horizontal left				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070300.xhp	0	help	par_id3154564				0	bs	\<ahelp hid=\"ITM_HOR_LEFT\"\>Feeds the envelope horizontally from the left edge of the printer tray.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070300.xhp	0	help	hd_id3155898				0	bs	Horizontal center				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070300.xhp	0	help	par_id3149694				0	bs	\<ahelp hid=\"ITM_HOR_CNTR\"\>Feeds the envelope horizontally from the center of the printer tray.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070300.xhp	0	help	hd_id3155174				0	bs	Horizontal right				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070300.xhp	0	help	par_id3143273				0	bs	\<ahelp hid=\"ITM_HOR_RGHT\"\>Feeds the envelope horizontally from the right edge of the printer tray.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070300.xhp	0	help	hd_id3149488				0	bs	Vertical left				2002-02-02 02:02:02
