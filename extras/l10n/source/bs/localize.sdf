helpcontent2	source\text\swriter\01\04070100.xhp	0	help	par_id3147172				0	bs	\<ahelp hid=\"HID_ENV_ENV\" visibility=\"visible\"\>Enter the delivery and return addresses for the envelope. You can also insert address fields from a database, for example from the Addresses database.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070100.xhp	0	help	hd_id3149295				0	bs	Addressee				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070100.xhp	0	help	par_id3145415	4			0	bs	\<ahelp hid=\"SW:MULTILINEEDIT:TP_ENV_ENV:EDT_ADDR\" visibility=\"visible\"\>Enter the delivery address.\</ahelp\> You can also click in this box, and select a database, a table, and field, and then click the arrow button to insert the field in the address. If you want, you can apply  formatting, such as bold and underline, to the address text.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070100.xhp	0	help	hd_id3154102				0	bs	Sender				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070100.xhp	0	help	par_id3153527	6			0	bs	\<ahelp visibility=\"visible\" hid=\"SW:MULTILINEEDIT:TP_ENV_ENV:EDT_SEND\"\>Includes a return address on the envelope. Select the \<emph\>Sender \</emph\>check box, and then enter the return  address.\</ahelp\> $[officename] automatically inserts your user data in the \<emph\>Sender \</emph\>box, but you can also enter the data that you want.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04070100.xhp	0	help	hd_id3154571				0	bs	Database				2002-02-02 02:02:02
