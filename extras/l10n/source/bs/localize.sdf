helpcontent2	source\text\shared\01\01110100.xhp	0	help	par_id3153104				0	bs	\<ahelp hid=\"HID_ORGANIZE_COPY_TO\"\>Exports the selected template.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01110100.xhp	0	help	hd_id3150651				0	bs	Print				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01110100.xhp	0	help	par_id3154946				0	bs	\<ahelp hid=\"HID_ORGANIZE_PRINT\"\>Prints the name and properties of the styles that are used in the file.\</ahelp\>				2002-02-02 02:02:02
