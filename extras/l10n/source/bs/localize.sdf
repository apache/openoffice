helpcontent2	source\text\swriter\01\04060000.xhp	0	help	hd_id3147173				0	bs	\<link href=\"text/swriter/01/04060000.xhp\" name=\"Caption\"\>Caption\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04060000.xhp	0	help	par_id3149288	2			0	bs	\<variable id=\"beschrifttext\"\>\<ahelp hid=\"HID_DLG_CAPTION\"\>Adds a numbered caption to a selected graphic, table, frame, text frame, or drawing object.\</ahelp\> You can also access this command by right-clicking the item that you want to add the caption to. \</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04060000.xhp	0	help	hd_id3154098				0	bs	Properties				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04060000.xhp	0	help	par_id3149804				0	bs	Set the caption options for the current selection.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04060000.xhp	0	help	hd_id3153533				0	bs	Category				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04060000.xhp	0	help	par_id3154574	6			0	bs	\<ahelp hid=\"SW:COMBOBOX:DLG_CAPTION:BOX_CATEGORY\"\>Select the caption category, or type a name to create a new category. The category text appears before the caption number in the caption label. Each predefined caption category is formatted with a paragraph style of the same name. \</ahelp\> For example, the "Illustration" caption category is formatted with the "Illustration" paragraph style.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04060000.xhp	0	help	hd_id3153675				0	bs	Numbering				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04060000.xhp	0	help	par_id3152962				0	bs	\<ahelp hid=\"SW:LISTBOX:DLG_CAPTION:BOX_FORMAT\"\>Select the type of numbering that you want to use in the caption.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04060000.xhp	0	help	hd_id3155893				0	bs	Caption				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04060000.xhp	0	help	par_id3149688				0	bs	\<ahelp hid=\"SW:EDIT:DLG_CAPTION:EDT_TEXT\"\>Type the text that you want to appear after the caption number.\</ahelp\> For example, if you want to label your objects as "Object 1: Text", type a colon (:), a space, and then the text.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04060000.xhp	0	help	par_idN1068A				0	bs	Separator				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04060000.xhp	0	help	par_idN10690				0	bs	\<ahelp hid=\".\"\>Enter optional text characters to appear between the number and the caption text.\</ahelp\>				2002-02-02 02:02:02
