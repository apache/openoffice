helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3151251				0	bs	\<ahelp hid=\"SW:LISTBOX:DLG_MULTMRK:LB_TOX\"\>Displays the type of index that the selected entry belongs to.\</ahelp\> You cannot change the index type of an index entry in this dialog. Instead, you must delete the index entry from the document, and then insert it again in a different index type.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	hd_id3149107				0	bs	Entry				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3149823	8			0	bs	\<ahelp hid=\"SW:LISTBOX:DLG_MULTMRK:LB_TOX\"\>Edit the index entry if necessary. When you modify the index entry, the new text only appears in the index, and not at the index entry anchor in the document. \</ahelp\> For example, you can enter an index with comments such as "Basics, see also General".				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	hd_id3149036				0	bs	1st key				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3153631				0	bs	\<ahelp hid=\"SW:LISTBOX:DLG_MULTMRK:LB_TOX\"\>To create a multilevel index, type the name of the first level index entry, or select a name from the list. The current index entry is added below this name.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	hd_id3152773				0	bs	2nd key				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3145758				0	bs	\<ahelp hid=\"SW:LISTBOX:DLG_MULTMRK:LB_TOX\"\>Type the name of the second level index entry, or select a name from the list. The current index entry is added below this name.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	hd_id3155143				0	bs	Level				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3149170				0	bs	\<ahelp hid=\"SW:LISTBOX:DLG_MULTMRK:LB_TOX\"\>Changes the outline level of a table of contents entry.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	hd_id3145785				0	bs	Delete				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3155919				0	bs	\<ahelp hid=\"HID_INSERT_IDX_MRK_DELETE\"\>Deletes the selected entry from the index. The entry text in the document is not deleted.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	hd_id3151384				0	bs	End arrow to left				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3155869				0	bs	\<ahelp hid=\"HID_INSERT_IDX_MRK_PREV_SAME\"\>Jumps to the first index entry of the same type in the document.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3147420				0	bs	\<image id=\"img_id3149551\" src=\"sd/res/imagelst/nv03.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3149551\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3150550				0	bs	End arrow to left				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	hd_id3147736				0	bs	End arrow to right				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3149829				0	bs	\<ahelp hid=\"HID_INSERT_IDX_MRK_NEXT_SAME\"\>Jumps to the last index entry of the same type in the document.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3153298				0	bs	\<image id=\"img_id3153309\" src=\"sd/res/imagelst/nv06.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3153309\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3156108				0	bs	End arrow to right				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	hd_id3155080				0	bs	Arrow to left				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3154327				0	bs	\<ahelp hid=\"HID_INSERT_IDX_MRK_PREV\"\>Jumps to the previous index entry of the same type in the document.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3148785				0	bs	\<image id=\"img_id3148791\" src=\"res/commandimagelist/sc_prevrecord.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3148791\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3153129				0	bs	Left Arrow				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	hd_id3154617				0	bs	Arrow to right				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3154633				0	bs	\<ahelp hid=\"HID_INSERT_IDX_MRK_NEXT\"\>Jumps to the next index entry of the same type in the document.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3150677				0	bs	\<image id=\"img_id3154020\" src=\"sd/res/imagelst/nv05.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3154020\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3149965				0	bs	Right Arrow				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\02160000.xhp	0	help	par_id3155539				0	bs	You can jump quickly to index entries with the \<link href=\"text/swriter/01/02110100.xhp\" name=\"Navigation Bar\"\>Navigation Bar\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	tit				0	bs	Edit Concordance File				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	bm_id3148768				0	bs	\<bookmark_value\>editing; concordance files\</bookmark_value\>\<bookmark_value\>concordance files; definition\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	hd_id3148768				0	bs	Edit Concordance File				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3151180				0	bs	\<ahelp hid=\"HID_DLG_CREATE_AUTOMARK\"\>Create or edit a list of words to include in an Alphabetical Index.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	hd_id3154645				0	bs	To access the Edit Concordance File dialog:				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3149292				0	bs	Choose \<emph\>Insert - Indexes and Tables - Indexes and Tables - Index/Table\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3145420	21			0	bs	In the \<emph\>Type \</emph\>box, select "Alphabetical Index".				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3154107	22			0	bs	In the \<emph\>Options \</emph\>area, select the \<emph\>Concordance file\</emph\> check box.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3153668				0	bs	Click the \<emph\>File\</emph\> button, and then choose \<emph\>New\</emph\> or \<emph\>Edit\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3154470	24			0	bs	A concordance file contains the following fields: 				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3152953				0	bs	"Search term" refers to the index entry that you want to mark in the document.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3155896				0	bs	"Alternative entry" refers to the index entry that you want to appear in the index.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3154194				0	bs	The 1st and 2nd Keys are parent index entries. The "Search term" or the "Alternative entry" appears as a subentry under the 1st and 2nd Keys.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3155184				0	bs	"Match case" means that uppercase and lowercase letters are considered.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3143282				0	bs	"Word only" searches for the term as a single word.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3147220				0	bs	To enable the "Match case" or "Word only" options, click in the corresponding cell, and then select the check box.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	hd_id3153629				0	bs	To create a concordance file without the Edit Concordance File dialog:				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3153644				0	bs	Use the following format guidelines when you create a concordance file:				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3152770				0	bs	Each entry in the concordance file is on a separate line.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3155142				0	bs	Commented lines start with #.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3153354				0	bs	Use the following format for the entries:				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3149172				0	bs	Search term;Alternative entry;1st key;2nd key;Match case;Word only				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3156270				0	bs	The entries "Match case" and "Word only" are interpreted as "No" or FALSE if they are empty or zero (0). All other contents are interpreted as "Yes" or TRUE.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	hd_id3145778				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3155907				0	bs	For example, to include the word "Boston" in your alphabetical index under the "Cities" entry, enter the following line in the concordance file:				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3151370				0	bs	Boston;Boston;Cities;;0;0 				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3151383				0	bs	This also finds "Boston" if it is written in lowercase letters.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3155866				0	bs	To include the "Beacon Hill" district in Boston under the "Cities" entry, enter the following line:				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04120250.xhp	0	help	par_id3150116	18			0	bs	Beacon Hill;Boston;Cities; 				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\03120000.xhp	0	help	tit				0	bs	Online Layout				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\03120000.xhp	0	help	hd_id3145243				0	bs	\<link href=\"text/swriter/01/03120000.xhp\" name=\"Online Layout\"\>Web Layout\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\03120000.xhp	0	help	par_id3154646				0	bs	\<ahelp hid=\".uno:BrowseView\"\>Displays the document as seen in a Web browser.\</ahelp\> This is useful when you create HTML documents.				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04200000.xhp	0	help	tit				0	bs	Insert Script				2002-02-02 02:02:02
