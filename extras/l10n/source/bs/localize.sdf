helpcontent2	source\text\sbasic\shared\03030108.xhp	0	help	hd_id3154367				0	bs	Return value:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03030108.xhp	0	help	par_id3156212				0	bs	Internal date number				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03030108.xhp	0	help	hd_id3125864				0	bs	Parameters:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03030108.xhp	0	help	par_id3154685				0	bs	\<emph\>String:\</emph\> A string that contains a date in ISO format. The year may have two or four digits.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03030108.xhp	0	help	hd_id3150439				0	bs	Example:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03030108.xhp	0	help	par_id3147318				0	bs	dateval = CDateFromIso("20021231")				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03030108.xhp	0	help	par_id3146921				0	bs	returns 12/31/2002 in the date format of your system				2002-02-02 02:02:02
