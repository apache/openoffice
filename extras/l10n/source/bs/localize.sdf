helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3154272				0	bs	Sub ContListener_elementRemoved( oEvent )				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3153947				0	bs	MsgBox "elementRemoved"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3146914				0	bs	MsgBox oEvent.Dbg_Properties				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3150749				0	bs	End Sub				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3145642				0	bs	Sub ContListener_elementReplaced( oEvent )				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3148915				0	bs	MsgBox "elementReplaced"				2002-02-02 02:02:02
