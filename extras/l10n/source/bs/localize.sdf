helpcontent2	source\text\shared\guide\macro_recording.xhp	0	help	hd_id3093440				0	bs	\<variable id=\"macro_recording\"\>\<link href=\"text/shared/guide/macro_recording.xhp\" name=\"Recording a Macro\"\>Recording a Macro\</link\>\</variable\>				2002-02-02 02:02:02
