helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_id3147326				0	bs	\<ahelp hid=\"HID_SMA_BINOMXY\"\>Inserts a vertical stack (binomial) with two placeholders.\</ahelp\> You can also type \<emph\>binom<?><?>\</emph\> directly in the \<emph\>Commands\</emph\> window.				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\03090700.xhp	0	help	par_idN10179				0	bs	\<image id=\"img_id3154390\" src=\"starmath/res/co21901.png\" width=\"0.2228inch\" height=\"0.2228inch\"\>\<alt id=\"alt_id3154390\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
