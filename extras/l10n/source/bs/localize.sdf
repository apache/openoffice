helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN1055C				0	bs	Always include country/region				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN10560				0	bs	\<ahelp hid=\".\"\>Includes country or regional information in the address block.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN10563				0	bs	Only include country/region if it is not:				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN10567				0	bs	\<ahelp hid=\".\"\>Only includes country or regional information in the address block if the value differs from the value that you enter in the text box.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN10651				0	bs	\<ahelp hid=\".\"\>Enter the country/region string that shall not be printed.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN1056A				0	bs	New				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN1056E				0	bs	\<ahelp hid=\".\"\>Opens the \<link href=\"text/swriter/01/mm_newaddblo.xhp\"\>New Address Block\</link\> dialog where you can define a new address block layout.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\mm_seladdblo.xhp	0	help	par_idN1057F				0	bs	Edit				2002-02-02 02:02:02
