helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155623				0	bs	=LOGINV(0.05; 0; 1) returns 0.19.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	bm_id3158417				0	bs	\<bookmark_value\>LOGNORMDIST function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3158417				0	bs	LOGNORMDIST				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154953				0	bs	\<ahelp hid=\"HID_FUNC_LOGNORMVERT\"\>Returns the cumulative lognormal distribution.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3150474				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3150686				0	bs	LOGNORMDIST(Number; Mean; STDEV)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3154871				0	bs	\<emph\>Number\</emph\> is the probability value for which the standard logarithmic distribution is to be calculated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155820				0	bs	\<emph\>Mean\</emph\> is the mean value of the standard logarithmic distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3155991				0	bs	\<emph\>STDEV\</emph\> is the standard deviation of the standard logarithmic distribution.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	hd_id3153178				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060183.xhp	0	help	par_id3149778				0	bs	=LOGNORMDIST(0.1; 0; 1) returns 0.01.				2002-02-02 02:02:02
