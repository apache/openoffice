helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156074	60			0	bs	TRIM("   hello") returns "hello".				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3145178				0	bs	\<bookmark_value\>UPPER function\</bookmark_value\>				2002-02-02 02:02:02
