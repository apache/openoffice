helpcontent2	source\text\scalc\01\04060116.xhp	0	help	bm_id3154959				0	bs	\<bookmark_value\>IMABS function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3154959				0	bs	IMABS				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3149895				0	bs	\<ahelp hid=\"HID_AAI_FUNC_IMABS\"\>The result is the absolute value of a complex number.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	hd_id3155382				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060116.xhp	0	help	par_id3151302				0	bs	IMABS(Complex number)				2002-02-02 02:02:02
