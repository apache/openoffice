helpcontent2	source\text\swriter\01\05060300.xhp	0	help	par_id3152961				0	bs	\<ahelp hid=\"HID_GRF_EXT\"\>Specify the flip and the link options for the selected graphic.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060300.xhp	0	help	hd_id3154191				0	bs	Flip				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060300.xhp	0	help	hd_id3155174				0	bs	Vertically				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060300.xhp	0	help	par_id3149485				0	bs	\<variable id=\"vertikaltext\"\>\<ahelp hid=\"SW:CHECKBOX:TP_GRF_EXT:CB_VERT\"\>Flips the selected graphic vertically.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060300.xhp	0	help	hd_id3154829				0	bs	Horizontally				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060300.xhp	0	help	par_id3151261				0	bs	\<variable id=\"horizontaltext\"\>\<ahelp hid=\"SW:CHECKBOX:TP_GRF_EXT:CB_HOR\"\>Flips the selected graphic horizontally.\</ahelp\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060300.xhp	0	help	hd_id3147101				0	bs	On all pages				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060300.xhp	0	help	par_id3147212				0	bs	\<ahelp hid=\"SW_RADIOBUTTON_TP_GRF_EXT_RB_MIRROR_ALL_PAGES\"\>Flips the selected graphic horizontally on all pages.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060300.xhp	0	help	hd_id3153632				0	bs	On left pages				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060300.xhp	0	help	par_id3149037				0	bs	\<ahelp hid=\"SW_RADIOBUTTON_TP_GRF_EXT_RB_MIRROR_LEFT_PAGES\"\>Flips the selected graphic horizontally only on even pages.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060300.xhp	0	help	hd_id3147580				0	bs	On right pages				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060300.xhp	0	help	par_id3152775				0	bs	\<ahelp hid=\"SW_RADIOBUTTON_TP_GRF_EXT_RB_MIRROR_RIGHT_PAGES\"\>Flips the selected graphic horizontally only on odd pages.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\05060300.xhp	0	help	hd_id3153349				0	bs	Link				2002-02-02 02:02:02
