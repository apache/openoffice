helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3146334				0	bs	$[officename] Tag				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3149846				0	bs	Description (fixed content)				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3148863				0	bs	<SDFIELD TYPE=DOCINFO SUBTYPE=COMMENT SDFIXED>Description</SDFIELD>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3151083				0	bs	Creation date				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3153298				0	bs	<SDFIELD TYPE=DOCINFO SUBTYPE=CREATE FORMAT=DATE SDNUM="1031;1031;QQ YY">1. Quarter 98</SDFIELD>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3150175				0	bs	Creation time (fixed content)				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3156134				0	bs	<SDFIELD TYPE=DOCINFO SUBTYPE=CREATE FORMAT=TIME SDVAL="0" SDNUM="1031;1031;HH:MM:SS AM/PM" SDFIXED>03:58:35 PM</SDFIELD>				2002-02-02 02:02:02
helpcontent2	source\text\swriter\01\04090007.xhp	0	help	par_id3155077				0	bs	Modification date				2002-02-02 02:02:02
