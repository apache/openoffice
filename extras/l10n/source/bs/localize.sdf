helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147377				0	bs	TEXT(Number; Format)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147389	162			0	bs	\<emph\>Number\</emph\> is the numerical value to be converted.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156167	163			0	bs	\<emph\>Format\</emph\> is the text which defines the format. Use decimal and thousands separators according to the language set in the cell format.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3151039				0	bs	\<bookmark_value\>TRIM function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3151039				0	bs	TRIM				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3157888				0	bs	\<ahelp hid=\"HID_FUNC_GLAETTEN\"\>Removes spaces that are in front of a string, or aligns cell contents to the left.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152913				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151349				0	bs	TRIM(Text)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151362	58			0	bs	\<emph\>text\</emph\> refers to text in which leading spaces are removed, or to the cell in which the contents will be left-aligned.				2002-02-02 02:02:02
