helpcontent2	source\text\sbasic\shared\03130500.xhp	0	help	par_id3154479				0	bs	 Shell("c:\\windows\\calc.exe",2)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03130500.xhp	0	help	par_id3153709				0	bs	end sub				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090405.xhp	0	help	tit				0	bs	FreeLibrary Function [Runtime]				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090405.xhp	0	help	bm_id3143270				0	bs	\<bookmark_value\>FreeLibrary function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090405.xhp	0	help	hd_id3143270				0	bs	\<link href=\"text/sbasic/shared/03090405.xhp\" name=\"FreeLibrary Function [Runtime]\"\>FreeLibrary Function [Runtime]\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090405.xhp	0	help	par_id3147559				0	bs	Releases DLLs that were loaded by a Declare statement. A released DLL is automatically reloaded if one of its functions is called. See also: \<link href=\"text/sbasic/shared/03090403.xhp\" name=\"Declare\"\>Declare\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090405.xhp	0	help	hd_id3148550				0	bs	Syntax:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090405.xhp	0	help	par_id3153361				0	bs	FreeLibrary (LibName As String)				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090405.xhp	0	help	hd_id3153380				0	bs	Parameters:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090405.xhp	0	help	par_id3154138				0	bs	\<emph\>LibName:\</emph\> String expression that specifies the name of the DLL.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090405.xhp	0	help	par_id3146923				0	bs	FreeLibrary can only release DLLs that are loaded during Basic runtime.				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090405.xhp	0	help	hd_id3153363				0	bs	Example:				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03090405.xhp	0	help	par_id3155855				0	bs	Declare Sub MyMessageBeep Lib "user32.dll" Alias "MessageBeep" ( long )				2002-02-02 02:02:02
