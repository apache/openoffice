helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149188				0	bs	CODE(Text)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154383	7			0	bs	\<emph\>Text\</emph\> is the text for which the code of the first character is to be found.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3154394				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3159209	9			0	bs	CODE("Hieronymus") returns 72, CODE("hieroglyphic") returns 104.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150280				0	bs	The code used here does not refer to ASCII, but to the code table currently loaded.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149688				0	bs	\<bookmark_value\>CONCATENATE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149688				0	bs	CONCATENATE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154524				0	bs	\<ahelp hid=\"HID_FUNC_VERKETTEN\"\>Combines several text strings into one string.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149542				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155954				0	bs	CONCATENATE(Text 1;...;Text 30)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146847	171			0	bs	\<emph\>Text 1; text 2; ...\</emph\> represent up to 30 text passages which are to be combined into one string.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153110				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150008	173			0	bs	CONCATENATE("Good ";"Morning ";"Mrs. ";"Doe") returns \<emph\>Good Morning Mrs. Doe\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3145166				0	bs	\<bookmark_value\>DECIMAL function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3145166				0	bs	DECIMAL				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156361				0	bs	\<ahelp hid=\"HID_FUNC_DEZIMAL\"\>Converts text with characters from a \<link href=\"text/shared/00/00000005.xhp#zahlensystem\" name=\"number system\"\>number system\</link\> to a positive integer in the base radix given.\</ahelp\> The radix must be in the range 2 to 36. Spaces and tabs are ignored. The\<emph\> text\</emph\> field is not case-sensitive.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3157994				0	bs	If the radix is 16, a leading x or X or 0x or 0X, and an appended h or H, is disregarded. If the radix is 2, an appended b or B is disregarded. Other characters that do not belong to the number system generate an error.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150014				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154328				0	bs	DECIMAL(Text; Radix)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150128	230			0	bs	\<emph\>text\</emph\> is the text to be converted. To differentiate between a hexadecimal number, such as A1 and the reference to cell A1, you must place the number in quotation marks, for example, "A1" or "FACE".				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145241	231			0	bs	\<emph\>radix\</emph\> indicates the base of the number system. It may be any positive integer between 2 and 36.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3156062				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145355	233			0	bs	DECIMAL("17";10) returns 17.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155622	234			0	bs	DECIMAL("FACE";16) returns 64206.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151015	235			0	bs	DECIMAL("0101";2) returns 5.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3148402				0	bs	\<bookmark_value\>DOLLAR function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148402				0	bs	DOLLAR				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153049	12			0	bs	\<ahelp hid=\"HID_FUNC_DM\"\>Converts a number to an amount in the currency format, rounded to a specified decimal place.\</ahelp\> In the \<emph\>value\</emph\> field enter the number to be converted to currency. Optionally, you may enter the number of decimal places in the \<emph\>decimals\</emph\> field. If no value is specified, all numbers in currency format will be displayed with two decimal places. 				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151280				0	bs	You set the currency format in your system settings.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150569				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154188				0	bs	DOLLAR(value; decimals)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145299	15			0	bs	\<emph\>value\</emph\> is a number, a reference to a cell containing a number, or a formula which returns a number.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145629	16			0	bs	\<emph\>decimals\</emph\> is the optional number of decimal places.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149030				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153546	18			0	bs	DOLLAR(255) returns $255.00.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154635	19			0	bs	DOLLAR(367.456;2) returns $367.46. Use the decimal separator that corresponds to the \<link href=\"text/shared/optionen/01140000.xhp\" name=\"current locale setting\"\>current locale setting\</link\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3150685				0	bs	\<bookmark_value\>EXACT function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150685				0	bs	EXACT				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3158413				0	bs	\<ahelp hid=\"HID_FUNC_IDENTISCH\"\>Compares two text strings and returns TRUE if they are identical.\</ahelp\> This function is case-sensitive.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152817				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148594				0	bs	EXACT(text_1;text_2)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153224	82			0	bs	\<emph\>text_1\</emph\> refers to the first text to compare.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148637	83			0	bs	\<emph\>text_2\</emph\> is the second text to compare.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149777				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156263	85			0	bs	EXACT("Sun microsystems";"Sun Microsystems") returns FALSE.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3152589				0	bs	\<bookmark_value\>FIND function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152589				0	bs	FIND				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146149				0	bs	\<ahelp hid=\"HID_FUNC_FINDEN\"\>Looks for a string of text within another string.\</ahelp\> You can also define where to begin the search. The search term can be a number or any string of characters. The search is case-sensitive.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3083284				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3083452				0	bs	FIND(find_text; text; position)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150608	48			0	bs	\<emph\>find_text\</emph\> refers to the text to be found.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3152374	49			0	bs	\<emph\>text\</emph\> is the text where the search takes place.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3152475	50			0	bs	\<emph\>position\</emph\> (optional) is the position in the text from which the search starts.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3154812				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156375	52			0	bs	FIND(76;998877665544) returns 6.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149268				0	bs	\<bookmark_value\>FIXED function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149268				0	bs	FIXED				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155833				0	bs	\<ahelp hid=\"HID_FUNC_FEST\"\>Specifies that a number be displayed with a fixed number of decimal places and with or without a thousands separator. This function can be used to apply a uniform format to a column of numbers.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152470				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147567				0	bs	FIXED(Number; decimals; no thousands separators)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151272	38			0	bs	\<emph\>Number\</emph\> refers to the number to be formatted.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156322	39			0	bs	\<emph\>Decimals\</emph\> refers to the number of decimal places to be displayed.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150877	40			0	bs	\<emph\>No thousands separators\</emph\> (optional) determines whether the thousands separator is used. If the parameter is a number not equal to 0, the thousands separator is suppressed. If the parameter is equal to 0 or if it is missing altogether, the thousands separators of your \<link href=\"text/shared/optionen/01140000.xhp\" name=\"current locale setting\"\>current locale setting\</link\> are displayed.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149040				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145208	42			0	bs	FIXED(1234567.89;3) returns 1,234,567.890. FIXED(1234567.89;3;1) returns 1234567.890.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3147083				0	bs	\<bookmark_value\>LEFT function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3147083				0	bs	LEFT				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153622				0	bs	\<ahelp hid=\"HID_FUNC_LINKS\"\>Returns the first character or characters in a text string.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3156116				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146786				0	bs	LEFT(text; number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147274	99			0	bs	\<emph\>text\</emph\> is the text where the initial partial words are to be determined.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153152	100			0	bs	\<emph\>Number\</emph\> (optional) specifies the number of characters for the start text. If this parameter is not defined, one character is returned.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150260				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149141	102			0	bs	LEFT("output";3) returns \<emph\>out\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3156110				0	bs	\<bookmark_value\>LEN function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3156110				0	bs	LEN				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150147				0	bs	\<ahelp hid=\"HID_FUNC_LAENGE\"\>Returns the length of a string including spaces.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155108				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154063				0	bs	LEN(text)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146894	108			0	bs	\<emph\>text\</emph\> is the text whose length is to be determined.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153884				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156008	110			0	bs	LEN("Good Afternoon") returns \<emph\>14\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154300	111			0	bs	LEN(12345.67) returns \<emph\>8\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3153983				0	bs	\<bookmark_value\>LOWER function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153983				0	bs	LOWER				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3152791				0	bs	\<ahelp hid=\"HID_FUNC_KLEIN\"\>Converts all uppercase letters in a text string to lowercase.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3155902				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150121				0	bs	LOWER(text)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153910	91			0	bs	\<emph\>text\</emph\> refers to the text to be converted.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3159343				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155329	93			0	bs	LOWER("Sun") returns sun.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3154589				0	bs	\<bookmark_value\>MID function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3154589				0	bs	MID				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154938				0	bs	\<ahelp hid=\"HID_FUNC_TEIL\"\>Returns a text segment of a character string. The parameters specify the starting position and the number of characters.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148829				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150526				0	bs	MID(text; start; number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148820	152			0	bs	\<emph\>text\</emph\> is the text containing the characters to extract.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150774	153			0	bs	\<emph\>start\</emph\> is the position of the first character in the text to extract.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153063	154			0	bs	\<emph\>number\</emph\> specifies the number of characters in the part of the text.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150509				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3158407	156			0	bs	MID("Sun Microsystems";5;5) returns \<emph\>Micro\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3159143				0	bs	\<bookmark_value\>PROPER function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3159143				0	bs	PROPER				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149768				0	bs	\<ahelp hid=\"HID_FUNC_GROSS2\"\>Capitalizes the first letter in all words of a text string.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153573				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154260				0	bs	PROPER(text)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147509	74			0	bs	\<emph\>text\</emph\> refers to the text to be converted.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3147529				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155364	76			0	bs	PROPER("sun microsystems") returns Sun Microsystems.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149171				0	bs	\<bookmark_value\>REPLACE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149171				0	bs	REPLACE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148925				0	bs	\<ahelp hid=\"HID_FUNC_ERSETZEN\"\>Replaces part of a text string with a different text string.\</ahelp\> This function can be used to replace both characters and numbers (which are automatically converted to text). The result of the function is always displayed as text. If you intend to perform further calculations with a number which has been replaced by text, you will need to convert it back to a number using the \<link href=\"text/scalc/01/04060110.xhp\" name=\"VALUE\"\>VALUE\</link\> function.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3158426				0	bs	Any text containing numbers must be enclosed in quotation marks if you do not want it to be interpreted as a number and automatically converted to text.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149159				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147286				0	bs	REPLACE(text; position; length; new text)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149797	27			0	bs	\<emph\>Text\</emph\> refers to text of which a part will be replaced.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3166451	28			0	bs	\<emph\>position\</emph\> refers to the position within the text where the replacement will begin.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156040	29			0	bs	\<emph\>length\</emph\> is the number of characters in \<emph\>text\</emph\> to be replaced.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3159188	30			0	bs	\<emph\>new text\</emph\> refers to the text which replaces \<emph\>text\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3146958				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154096	32			0	bs	REPLACE("1234567";1;1;"444") returns "444234567". One character at position 1 is replaced by the complete \<emph\>new text\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149741				0	bs	\<bookmark_value\>REPT function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149741				0	bs	REPT				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153748				0	bs	\<ahelp hid=\"HID_FUNC_WIEDERHOLEN\"\>Repeats a character string by the given \<emph\>number\</emph\> of copies.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152884				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150494				0	bs	REPT(text; number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154859	197			0	bs	\<emph\>text\</emph\> is the text to be repeated.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150638	198			0	bs	\<emph\>number\</emph\> is the number of repetitions.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149922				0	bs	The result can be a maximum of 255 characters.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3156213				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148626	200			0	bs	REPT("Good morning"; 2) returns \<emph\>Good morningGood morning\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3149805				0	bs	\<bookmark_value\>RIGHT function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149805				0	bs	RIGHT				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145375				0	bs	\<ahelp hid=\"HID_FUNC_RECHTS\"\>Defines the last character or characters in a text string.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150837				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154344				0	bs	RIGHT(text; number)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149426	117			0	bs	\<emph\>text\</emph\> is the text of which the right part is to be determined.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153350	118			0	bs	\<emph\>number\</emph\> (optional) is the number of characters from the right part of the text.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3148661				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151132	120			0	bs	RIGHT("Sun";2) returns \<emph\>un\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3153534				0	bs	\<bookmark_value\>ROMAN function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3153534				0	bs	ROMAN				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151256				0	bs	\<ahelp hid=\"HID_FUNC_ROEMISCH\"\>Converts a number into a Roman numeral. The value range must be between 0 and 3999, the modes can be integers from 0 to 4.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3149299				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150593				0	bs	ROMAN(Number; Mode)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156139	252			0	bs	\<emph\>Number\</emph\> is the number that is to be converted into a Roman numeral.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153318	253			0	bs	\<emph\>Mode\</emph\> (optional) indicates the degree of simplification. The higher the value, the greater is the simplification of the Roman number.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3145306				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3151371	255			0	bs	ROMAN(999) returns CMXCIX				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153938	256			0	bs	ROMAN(999;0) returns CMXCIX				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148412	257			0	bs	ROMAN (999;1) returns LMVLIV				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3155421	258			0	bs	ROMAN(999;2) returns XMIX				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149235	259			0	bs	ROMAN(999;3) returns VMIV				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150624	260			0	bs	ROMAN(999;4) returns IM				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3151005				0	bs	\<bookmark_value\>SEARCH function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3151005				0	bs	SEARCH				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3148692				0	bs	\<ahelp hid=\"HID_FUNC_SUCHEN\"\>Returns the position of a text segment within a character string.\</ahelp\> You can set the start of the search as an option. The search text can be a number or any sequence of characters. The search is not case-sensitive.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3152964				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154671				0	bs	SEARCH(find_text; text; position)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3146080	126			0	bs	\<emph\>find_text\</emph\> is the text to be searched for.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154111	127			0	bs	\<emph\>text\</emph\> is the text where the search will take place.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3149559	128			0	bs	\<emph\>position\</emph\> (optional) is the position in the text where the search is to start.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3147322				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154564	130			0	bs	SEARCH(54;998877665544) returns 10.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3154830				0	bs	\<bookmark_value\>SUBSTITUTE function\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3154830				0	bs	SUBSTITUTE				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153698				0	bs	\<ahelp hid=\"HID_FUNC_WECHSELN\"\>Substitutes new text for old text in a string.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150994				0	bs	Syntax				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3147582				0	bs	SUBSTITUTE(text; search_text; new text; occurrence)				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3153675	178			0	bs	\<emph\>text\</emph\> is the text in which text segments are to be exchanged.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3156155	179			0	bs	\<emph\>search_text \</emph\>is the text segment that is to be replaced (a number of times).				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3145779	180			0	bs	\<emph\>new text\</emph\> is the text that is to replace the text segment.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150348	181			0	bs	\<emph\>occurrence\</emph\> (optional) indicates how many occurrences of the search text are to be replaced. If this parameter is missing the search text is replaced throughout.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	hd_id3150946				0	bs	Example				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3150412	183			0	bs	SUBSTITUTE("123123123"; "3"; "abc") returns \<emph\>12abc12abc12abc\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	par_id3154915	238			0	bs	SUBSTITUTE("123123123"; "3"; "abc"; 2) returns \<emph\>12312abc123\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\scalc\01\04060110.xhp	0	help	bm_id3148977				0	bs	\<bookmark_value\>T function\</bookmark_value\>				2002-02-02 02:02:02
