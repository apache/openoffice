helpcontent2	source\text\swriter\01\02110000.xhp	0	help	par_id3153268				0	bs	\<image id=\"img_id3153275\" src=\"sw/imglst/sc20174.png\" width=\"0.222inch\" height=\"0.222inch\"\>\<alt id=\"alt_id3153275\"\>Icon\</alt\>\</image\>				2002-02-02 02:02:02
