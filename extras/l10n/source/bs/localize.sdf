helpcontent2	source\text\smath\01\05040000.xhp	0	help	hd_id3148730				0	bs	Alignment				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05040000.xhp	0	help	par_id3152999				0	bs	\<variable id=\"ausrichtungtext\"\>\<ahelp hid=\"SID_ALIGN\" visibility=\"visible\"\>You can define the alignment of multi-line formulas as well as formulas with several elements in one line.\</ahelp\> Create multi-line formulas by entering a \<emph\>NEWLINE\</emph\> command in the \<emph\>Commands\</emph\> window.\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05040000.xhp	0	help	hd_id3153737				0	bs	Horizontal				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05040000.xhp	0	help	par_id3148388				0	bs	Specifies the type of horizontal alignment for multi-line formulas.				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05040000.xhp	0	help	hd_id3148768				0	bs	Left				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05040000.xhp	0	help	par_id3150566				0	bs	\<ahelp hid=\"STARMATH:RADIOBUTTON:RID_ALIGNDIALOG:1\" visibility=\"visible\"\>Aligns the selected elements of a formula to the left.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05040000.xhp	0	help	par_id3149709	21			0	bs	Text is always aligned left. 				2002-02-02 02:02:02
helpcontent2	source\text\smath\01\05040000.xhp	0	help	hd_id3154646				0	bs	Centered				2002-02-02 02:02:02
