helpcontent2	source\text\shared\01\01110100.xhp	0	help	par_id3156005	33			0	bs	\<ahelp hid=\"SFX2:PUSHBUTTON:DLG_ORGANIZE:BTN_FILES\"\>Locate a file that you want to add to the document list, and then click\<emph\> Open\</emph\>.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01110100.xhp	0	help	par_id3153095				0	bs	\<link href=\"text/shared/01/01140000.xhp\" name=\"Printer setup\"\>Printer setup\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01110100.xhp	0	help	par_id3150012				0	bs	\<link href=\"text/shared/01/01110101.xhp\" name=\"Templates: Address Book Assignment\"\>Templates: Address Book Assignment\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	tit				0	bs	List of Regular Expressions				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	bm_id3146765				0	bs	\<bookmark_value\>regular expressions; list of\</bookmark_value\>\<bookmark_value\>lists;regular expressions\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	hd_id3146765				0	bs	\<variable id=\"02100001\"\>\<link href=\"text/shared/01/02100001.xhp\"\>List of Regular Expressions\</link\>\</variable\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149741				0	bs	Character				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155577				0	bs	Result/Use				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id6600543				0	bs	Any character				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id9824518.00000001				0	bs	Represents any single character unless otherwise specified.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152427				0	bs	.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149031				0	bs	Represents any single character except for a line break or paragraph break. For example, the search term "sh.rt" returns both "shirt" and "short".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154682				0	bs	^				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155351				0	bs	Only finds the search term if the term is at the beginning of a paragraph. Special objects such as empty fields or character-anchored frames, at the beginning of a paragraph are ignored. Example: "^Peter".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3159194				0	bs	$				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152542				0	bs	Only finds the search term if the term appears at the end of a paragraph. Special objects such as empty fields or character-anchored frames at the end of a paragraph are ignored. Example: "Peter$".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156414				0	bs	*				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155555				0	bs	Finds zero or more of the characters in front of the "*". For example, "Ab*c" finds "Ac", "Abc", "Abbc", "Abbbc", and so on.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147399				0	bs	+				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3157958				0	bs	Finds one or more of the characters in front of the "+". For example, "AX.+4" finds "AXx4", but not "AX4".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145313				0	bs	The longest possible string that matches this search pattern in a paragraph is always found. If the paragraph contains the string "AX 4 AX4", the entire passage is highlighted.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3143267				0	bs	?				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153684				0	bs	Finds zero or one of the characters in front of the "?". For example, "Texts?" finds "Text" and "Texts" and "x(ab|c)?y" finds "xy", "xaby", or "xcy".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3166410				0	bs	\\				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147209				0	bs	Search interprets the special character that follows the "\\" as a normal character and not as a regular expression (except for the combinations \\n, \\t, \\>, and \\<). For example, "tree\\." finds "tree.", not "treed" or "trees".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152945				0	bs	\\n				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153700				0	bs	Represents a line break that was inserted with the Shift+Enter key combination. To change a line break into a paragraph break, enter \<emph\>\\n\</emph\> in the \<emph\>Search for\</emph\> and \<emph\>Replace with\</emph\> boxes, and then perform a search and replace.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153258				0	bs	\\t				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3157809				0	bs	Represents a tab. You can also use this expression in the \<emph\>Replace with\</emph\> box.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3146775	33			0	bs	\\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148644	34			0	bs	Only finds the search term if it appears at the end of a word. For example, "book\\>" finds "checkbook", but not "bookmark".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150670				0	bs	\\<				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153666				0	bs	Only finds the search term if it appears at the beginning of a word. For example, "\\<book" finds "bookmark", but not "checkbook".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149576				0	bs	^$				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3151245				0	bs	Finds an empty paragraph.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148550				0	bs	^.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3159413				0	bs	Finds the first character of a paragraph.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147282				0	bs	&				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153961				0	bs	Adds the string that was found by the search criteria in the \<emph\>Search for\</emph\> box to the term in the \<emph\>Replace with\</emph\> box when you make a replacement.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149650				0	bs	For example, if you enter "window" in the \<emph\>Search for\</emph\> box and "&frame" in the \<emph\>Replace with\</emph\> box, the word "window" is replaced with "windowframe".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150543				0	bs	You can also enter an "&" in the \<emph\>Replace with\</emph\> box to modify the \<emph\>Attributes\</emph\> or the \<emph\>Format\</emph\> of the string found by the search criteria.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145419				0	bs	[abc123]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154630				0	bs	Represents one of the characters that are between the brackets.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156293				0	bs	[a-e]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149167				0	bs	Represents any of the characters that are between a and e.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155994				0	bs	[a-eh-x]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148676				0	bs	Represents any of the characters that are between a-e and h-x.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145318				0	bs	[^a-s]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153351				0	bs	Represents any character that is not between a and s.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156543				0	bs	\\xXXXX				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153768				0	bs	Represents a special character based on its four-digit hexadecimal code (XXXX).				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3159252				0	bs	The code for the special character depends on the font used. You can view the codes by choosing \<emph\>Insert - Special Character\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153951				0	bs	|				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154985				0	bs	Finds the terms that occur before or after the "|". For example, "this|that" finds "this" and "that".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147376				0	bs	{2}				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150103				0	bs	Defines the number of times that the character in front of the opening bracket occurs. For example, "tre{2}" finds "tree".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3151289				0	bs	{1,2}				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147317				0	bs	Defines the number of times that the character in front of the opening bracket can occur. For example, "tre{1,2}" finds both "tree" and "treated".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id4870754				0	bs	{1,}				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id843836				0	bs	Defines the minimum number of times that the character in front of the opening bracket can occur. For example, "tre{2,}" finds "tree", "treee", and "treeeee".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148616				0	bs	( )				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153573				0	bs	Defines the characters inside the parentheses as a reference. You can then refer to the first reference in the current expression with "\\1", to the second reference with "\\2", and so on.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3156061				0	bs	For example, if your text contains the number 13487889 and you search using the regular expression (8)7\\1\\1, "8788" is found.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id2367931				0	bs	You can also use () to group terms, for example, "a(bc)?d" finds "ad" or "abcd".				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3154790				0	bs	[:alpha:]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3147397				0	bs	Represents an alphabetic character.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152885				0	bs	[:digit:]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150010				0	bs	Represents a decimal digit.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153743				0	bs	[:alnum:]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153281				0	bs	Represents an alphanumeric character ([:alpha:] and [:digit:]).				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3153726				0	bs	[:space:]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150961				0	bs	Represents a white space character such as space.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150486				0	bs	[:print:]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150872				0	bs	Represents a printable character.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3155854				0	bs	[:cntrl:]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3152576				0	bs	Represents a nonprinting character.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3149958				0	bs	[:lower:]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3145730				0	bs	Represents a lowercase character if \<emph\>Match case\</emph\> is selected in \<emph\>Options\</emph\>.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3148455				0	bs	[:upper:]				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\02100001.xhp	0	help	par_id3150092	231			0	bs	Represents an uppercase character if \<emph\>Match case\</emph\> is selected in \<emph\>Options.\</emph\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05190000.xhp	0	help	tit				0	bs	Name				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05190000.xhp	0	help	bm_id3147366				0	bs	\<bookmark_value\>objects; naming\</bookmark_value\>\<bookmark_value\>groups;naming\</bookmark_value\>\<bookmark_value\>names; for groups of objects\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05190000.xhp	0	help	hd_id3147366				0	bs	Name				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05190000.xhp	0	help	par_id3147588				0	bs	\<variable id=\"name\"\>\<ahelp hid=\".uno:RenameObject\"\>Assigns a name to the selected object, so that you can quickly find the object in the Navigator.\</ahelp\>\</variable\> Drawing objects must be grouped to get a name.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05190000.xhp	0	help	par_id3155364				0	bs	\<switchinline select=\"appl\"\>\<caseinline select=\"WRITER\"\>\</caseinline\>\<defaultinline\>The name is also displayed in the Status Bar when you select the object.\</defaultinline\>\</switchinline\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05190000.xhp	0	help	hd_id3156027				0	bs	Name				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\05190000.xhp	0	help	par_id3152924				0	bs	\<ahelp hid=\"HID_SD_NAMEDIALOG_OBJECT\"\>Enter a name for the selected object.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	bm_id3149955				0	bs	\<bookmark_value\>version numbers of documents\</bookmark_value\>\<bookmark_value\>documents; version numbers\</bookmark_value\>\<bookmark_value\>files; version numbers\</bookmark_value\>\<bookmark_value\>editing time of documents\</bookmark_value\>\<bookmark_value\>documents; editing time\</bookmark_value\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3148668				0	bs	\<link href=\"text/shared/01/01100200.xhp\" name=\"General\"\>General\</link\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3154863				0	bs	\<ahelp hid=\"HID_DOCINFODOC\"\>Contains basic information about the current file.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3149999				0	bs	File				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3153114				0	bs	\<ahelp hid=\"SFX2:EDIT:TP_DOCINFODOC:ED_FILE_NAME\"\>Displays the file name.\</ahelp\>				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3156136				0	bs	Type:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3155552				0	bs	Displays the file type for the current document.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3145314				0	bs	Location:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3150506				0	bs	Displays the path and the name of the directory where the file is stored.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3155892				0	bs	Size:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3153311				0	bs	Displays the size of the current document in bytes.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3149178				0	bs	Created:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3153748				0	bs	Displays the date and time and author when the file was first saved.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	hd_id3149182				0	bs	Modified:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_id3150355				0	bs	Displays the date and time and author when the file was last saved in a $[officename] file format.				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_idN106C5				0	bs	Digitally signed:				2002-02-02 02:02:02
helpcontent2	source\text\shared\01\01100200.xhp	0	help	par_idN106C9				0	bs	Displays the date and the time when the file was last signed as well as the name of the author who signed the document.				2002-02-02 02:02:02
