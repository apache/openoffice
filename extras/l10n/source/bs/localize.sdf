helpcontent2	source\text\sbasic\shared\03080202.xhp	0	help	par_id3148616				0	bs	a=Exp( Log(b1)+Log(b2) )				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03080202.xhp	0	help	par_id3149262				0	bs	MsgBox "" & a & chr(13) & (b1*b2) ,0,"Multiplication by logarithm function"				2002-02-02 02:02:02
