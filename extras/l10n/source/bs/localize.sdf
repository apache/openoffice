helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3154098				0	bs	MsgBox "elementInserted"				2002-02-02 02:02:02
helpcontent2	source\text\sbasic\shared\03132000.xhp	0	help	par_id3155601				0	bs	MsgBox oEvent.Dbg_Properties				2002-02-02 02:02:02
