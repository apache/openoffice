# .bazelrc

try-import %workspace%/user.bazelrc

# Use bzlmod
common --enable_bzlmod
common --check_direct_dependencies=off

# Materialize the runfiles symlink tree on Windows (default-off there). Required
# for tests that resolve files at runtime via %TEST_SRCDIR% (e.g. JNI tests that
# put native libs on java.library.path). Staged gtest tests are unaffected.
build --enable_runfiles

# Compile all Java to the Java 8 baseline (class file version 52). AOO's Java
# baseline is 8; the runtime JRE (and the 32-bit JVM the JNI bridge tests host)
# is Java 8, so jars must load there. Without this, rules_java's bundled JDK emits
# class 55 (Java 11), which a Java 8 JRE rejects with UnsupportedClassVersionError.
build --java_language_version=8

common --registry="file:///%workspace%/ext_libraries"
common --registry=https://bcr.bazel.build

# ----------------------------- Target platform -----------------------------
# win7-x64 (VS2019 toolset + Windows 10 SDK, Windows 7 SP1 and later) is the
# only target and the default: a plain `bazel build` is that build.  The config
# pins --platforms + --platform_suffix (its own bazel-out tree) +
# --symlink_prefix, so a further config can be added beside it without either
# clobbering the other.  Thin alias only: the SEMANTICS (target Windows floor,
# and any deps/defines that vary by it) live in the
# //build/constraints:win_version constraint carried by the platform, NOT here.
#
# The winXP-x86 (default until then) and winXP-x64 configs, both VC9 / VS2008,
# were retired 2026-11-01.  Their bazel-winXP-* output trees are no longer
# written; delete them by hand to reclaim the disk.
build --config=win7-x64

build:win7-x64 --platforms=//build/platforms:win7-x64
build:win7-x64 --platform_suffix=win7-x64
build:win7-x64 --symlink_prefix=bazel-win7-x64-

# ── --config=timelog — AOO's own startup/exception tracing ───────────────────
# sal/inc/rtl/logfile.hxx gates every RTL_LOGFILE_CONTEXT/_TRACE macro behind
# TIMELOG; without it they all compile to ((void)0), and desktop's Desktop::Main
# is densely instrumented with exactly those.  rtl_logfile itself is NOT gated —
# it reads the RTL_LOGFILE bootstrap variable at runtime — so only the call sites
# need switching on, and that is a pure compiler define, no source change.
#
# Orthogonal to the platform configs above: combine it with any of them, e.g.
#   bazel build --config=timelog //main/staging:install
#   soffice.exe -env:RTL_LOGFILE=C:/temp/oo -env:UserInstallation=...
# writes C:\temp\oo_<pid>.log — logfile.cxx appends "_<pid>.log" unless the value
# ends in ".nopid", in which case it is used verbatim.  Without --config=timelog
# the same env var still works but yields only the handful of
# RTL_LOGFILE_PRODUCT_* points, which is enough to tell how far startup got.
#
# CRASH-vs-CLEAN-EXIT TEST, free with any of the above: the final line
# "closing log file at <n>" is written by LoggerGuard::~LoggerGuard(), a STATIC
# DESTRUCTOR.  Those run on normal CRT teardown and are skipped by _exit(),
# which is what desktop's FatalError() calls.  So a log ending in that line
# exited cleanly; a log that just stops was killed.
#
# NOTE the suffix/prefix below come LAST and therefore win over the platform
# config's, which is deliberate: a traced build gets its own output tree instead
# of invalidating the normal one.
build:timelog --copt=/DTIMELOG
build:timelog --platform_suffix=timelog
build:timelog --symlink_prefix=bazel-timelog-
